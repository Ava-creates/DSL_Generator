{"timestamp": "2025-10-28T15:49:57.848735", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # Action indices as defined by CraftLab.action_specs\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Reset environment and obtain the underlying state objects\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid                     # (W, H, n_kinds)\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that\n      moves the agent from ``start`` to ``goal`` using a Manhattan walk.\n      No obstacle checking is performed.\"\"\"\n      actions = []\n      y, x = start\n      gy, gx = goal\n      dy, dx = gy - y, gx - x\n\n      if dy > 0:\n          actions += [DOWN] * dy\n      elif dy < 0:\n          actions += [UP] * (-dy)\n\n      if dx > 0:\n          actions += [RIGHT] * dx\n      elif dx < 0:\n          actions += [LEFT] * (-dx)\n\n      return actions\n\n  def find_nearest(cell_kind, from_pos):\n      \"\"\"Find the nearest cell containing ``cell_kind`` (primitive or workshop).\n      Returns the coordinate (y, x) or ``None`` if not found.\"\"\"\n      locations = np.argwhere(grid[:, :, cell_kind] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest_idx = np.argmin(dists)\n      return tuple(locations[nearest_idx])\n\n  # ------------------------------------------------------------------\n  # Determine the goal index for 'arrow' and the required primitives.\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed = world.cookbook.primitives_for(arrow_idx)   # {primitive_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the required number of times.\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive not found \u2013 abort early.\n              return actions\n\n          ty, tx = target\n\n          # Choose a free adjacent cell (prefer one that lets us face the primitive).\n          adj = None\n          neighbours = [(ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)]\n          for ny, nx in neighbours:\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)\n                  if not occupied:\n                      adj = (ny, nx)\n                      break\n          if adj is None:\n              # No free neighbour \u2013 fallback to the primitive cell itself.\n              adj = target\n\n          # Move to the adjacent cell.\n          actions += manhattan_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Turn to face the primitive (use a movement action that will be blocked).\n          dy, dx = ty - cur_pos[0], tx - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick up the primitive.\n          actions.append(USE)\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          actions += manhattan_path(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # Trigger crafting at the current location.\n  actions.append(USE)\n\n  return actions", "env_interactions": 27, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T15:49:58.969149", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # Action indices as defined by CraftLab.action_specs\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Reset environment to obtain a fresh state\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid                     # (W, H, n_kinds)\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that\n      moves the agent from ``start`` to ``goal`` using a simple Manhattan walk.\"\"\"\n      actions = []\n      y, x = start\n      gy, gx = goal\n      dy, dx = gy - y, gx - x\n\n      if dy > 0:\n          actions += [DOWN] * dy\n      elif dy < 0:\n          actions += [UP] * (-dy)\n\n      if dx > 0:\n          actions += [RIGHT] * dx\n      elif dx < 0:\n          actions += [LEFT] * (-dx)\n\n      return actions\n\n  def find_nearest(cell_kind, from_pos):\n      \"\"\"Find the nearest cell containing ``cell_kind`` (primitive or workshop).\"\"\"\n      locations = np.argwhere(grid[:, :, cell_kind] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest_idx = np.argmin(dists)\n      return tuple(locations[nearest_idx])\n\n  # ------------------------------------------------------------------\n  # Determine goal index and required primitives\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # primitive not found \u2013 abort early\n              return actions\n\n          ty, tx = target\n\n          # Choose a free adjacent cell (if any) to stand on before using\n          adj = None\n          neighbours = [(ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)]\n          for ny, nx in neighbours:\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)\n                  if not occupied:\n                      adj = (ny, nx)\n                      break\n          if adj is None:\n              adj = target  # fallback: stand on the primitive cell itself\n\n          # Move to the adjacent cell\n          actions += manhattan_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive\n          dy, dx = ty - cur_pos[0], tx - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick it up\n          actions.append(USE)\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          actions += manhattan_path(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # Trigger crafting\n  actions.append(USE)\n\n  return actions", "env_interactions": 27, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T15:50:20.767313", "function_name": "make_arrow", "function_body": "  # Reset environment and obtain initial state\n  env.reset()\n  state = env._current_state\n\n  # Identify goal and required primitives\n  goal_idx = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal_idx)          # {primitive_idx: count}\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n\n  # Action name \u2192 integer mapping\n  act_map = env.action_specs()\n\n  # Cardinal movement deltas for BFS navigation\n  move_delta = {\n      \"UP\":    (-1, 0),\n      \"DOWN\":  (1, 0),\n      \"LEFT\":  (0, -1),\n      \"RIGHT\": (0, 1),\n  }\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of action names moving the agent\n  # from `start` to a cell that is adjacent (including diagonal) to any\n  # cell in `targets`.  Returns None if no path exists.\n  # ------------------------------------------------------------------\n  def bfs_to_adjacent(start, targets, grid):\n      from collections import deque\n      W, H = grid.shape[:2]\n      visited = set()\n      q = deque()\n      q.append((start, []))\n      visited.add(start)\n\n      target_set = set(targets)\n\n      while q:\n          pos, path = q.popleft()\n\n          # Check adjacency to any target cell\n          for tx, ty in target_set:\n              if abs(pos[0] - tx) <= 1 and abs(pos[1] - ty) <= 1:\n                  return path\n\n          # Expand neighbours\n          for act, (dx, dy) in move_delta.items():\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H:\n                  # Cell must be free (no entity present)\n                  if grid[nx, ny].sum() == 0 and (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [act]))\n      return None\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitive items\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          state = env._current_state\n          grid = state.grid\n          pos = state.pos\n\n          # Locate all cells containing the required primitive\n          prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not prim_cells:\n              # Primitive not present; abort collection loop\n              break\n\n          # Find a path to the nearest primitive (adjacent cell)\n          path = bfs_to_adjacent(pos, prim_cells, grid)\n          if path is None:\n              # No reachable primitive; abort\n              break\n\n          # Execute movement actions\n          for act_name in path:\n              actions.append(act_map[act_name])\n              env.step(act_map[act_name])\n\n          # Use action to pick up the primitive\n          actions.append(act_map[\"USE\"])\n          env.step(act_map[\"USE\"])\n\n  # ------------------------------------------------------------------\n  # 2) Move to the workshop (if required) and craft the goal item\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      state = env._current_state\n      grid = state.grid\n      pos = state.pos\n\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n      if workshop_cells:\n          path = bfs_to_adjacent(pos, workshop_cells, grid)\n          if path:\n              for act_name in path:\n                  actions.append(act_map[act_name])\n                  env.step(act_map[act_name])\n\n          # Use action at the workshop to craft the item\n          actions.append(act_map[\"USE\"])\n          env.step(act_map[\"USE\"])\n\n  # Return the compiled action sequence\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T15:50:21.886578", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n\n  # Goal index and recipe information\n  goal_idx = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal_idx)          # {primitive_idx: count}\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n\n  # Action mapping (e.g. {'DOWN':0, 'UP':1, ...})\n  act_map = env.action_specs()\n\n  # Movement deltas for the four cardinal actions\n  move_delta = {\n      \"UP\":    (-1, 0),\n      \"DOWN\":  ( 1, 0),\n      \"LEFT\":  ( 0,-1),\n      \"RIGHT\": ( 0, 1),\n  }\n\n  actions = []\n\n  # Helper: BFS that returns a list of action names moving the agent from `start`\n  # to a cell that is *adjacent* (including diagonally) to any cell in `targets`.\n  def bfs_to_adjacent(start, targets, grid):\n      from collections import deque\n      W, H = grid.shape[:2]\n      visited = set()\n      q = deque()\n      q.append((start, []))\n      visited.add(start)\n\n      target_set = set(targets)\n\n      while q:\n          pos, path = q.popleft()\n\n          # Check adjacency to any target cell\n          for tx, ty in target_set:\n              if abs(pos[0] - tx) <= 1 and abs(pos[1] - ty) <= 1:\n                  return path\n\n          # Expand neighbours\n          for act, (dx, dy) in move_delta.items():\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H:\n                  # cell must be empty (no entity present)\n                  if grid[nx, ny].sum() == 0 and (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [act]))\n      return None  # no path found\n\n  # ----------------------------------------------------------------------\n  # 1) Collect all required primitive items\n  # ----------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          # Refresh current state information\n          state = env._current_state\n          grid = state.grid\n          pos = state.pos\n\n          # Locate all cells that currently contain the needed primitive\n          prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not prim_cells:\n              # Primitive not present \u2013 cannot continue; break early\n              break\n\n          # Plan a path to the nearest primitive (adjacent cell)\n          path = bfs_to_adjacent(pos, prim_cells, grid)\n          if path is None:\n              break  # no reachable primitive\n\n          # Execute movement actions\n          for act_name in path:\n              actions.append(act_map[act_name])\n              env.step(act_map[act_name])\n\n          # Use action to pick up the primitive\n          actions.append(act_map[\"USE\"])\n          env.step(act_map[\"USE\"])\n\n  # ----------------------------------------------------------------------\n  # 2) Move to the workshop (if any) and craft the goal item\n  # ----------------------------------------------------------------------\n  if workshop_kind is not None:\n      # Refresh state after collecting primitives\n      state = env._current_state\n      grid = state.grid\n      pos = state.pos\n\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n      if workshop_cells:\n          path = bfs_to_adjacent(pos, workshop_cells, grid)\n          if path:\n              for act_name in path:\n                  actions.append(act_map[act_name])\n                  env.step(act_map[act_name])\n\n          # Use action at the workshop to craft the item\n          actions.append(act_map[\"USE\"])\n          env.step(act_map[\"USE\"])\n\n  # Return the complete action sequence\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T15:50:48.692296", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n\n  goal_idx = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal_idx)          # {primitive_idx: count}\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n\n  act_map = env.action_specs()          # e.g. {'DOWN':0, 'UP':1, ...}\n  move_delta = {\n      \"UP\":    (-1, 0),\n      \"DOWN\":  ( 1, 0),\n      \"LEFT\":  ( 0,-1),\n      \"RIGHT\": ( 0, 1),\n  }\n\n  actions = []\n  from collections import deque\n\n  def bfs_to_adjacent(start, targets, grid):\n      \"\"\"Return a list of action names moving from `start` to a cell adjacent\n      (including diagonally) to any cell in `targets`. Returns None if unreachable.\"\"\"\n      W, H = grid.shape[:2]\n      visited = set([start])\n      q = deque([(start, [])])\n      target_set = set(targets)\n\n      while q:\n          pos, path = q.popleft()\n\n          # adjacency check\n          for tx, ty in target_set:\n              if abs(pos[0] - tx) <= 1 and abs(pos[1] - ty) <= 1:\n                  return path\n\n          # expand neighbours\n          for act, (dx, dy) in move_delta.items():\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H:\n                  # cell must be empty (no entity present)\n                  if grid[nx, ny].sum() == 0 and (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [act]))\n      return None\n\n  # ----------------------------------------------------------------------\n  # 1) Collect all required primitive items\n  # ----------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          state = env._current_state\n          grid = state.grid\n          pos = state.pos\n\n          prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not prim_cells:\n              continue\n\n          path = bfs_to_adjacent(pos, prim_cells, grid)\n          if path is None:\n              continue\n\n          for act_name in path:\n              a = act_map[act_name]\n              actions.append(a)\n              env.step(a)\n\n          # pick up the primitive\n          actions.append(act_map[\"USE\"])\n          env.step(act_map[\"USE\"])\n\n  # ----------------------------------------------------------------------\n  # 2) Move to the workshop (if any) and craft the goal item\n  # ----------------------------------------------------------------------\n  if workshop_kind is not None:\n      state = env._current_state\n      grid = state.grid\n      pos = state.pos\n\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n      if workshop_cells:\n          path = bfs_to_adjacent(pos, workshop_cells, grid)\n          if path:\n              for act_name in path:\n                  a = act_map[act_name]\n                  actions.append(a)\n                  env.step(a)\n\n          # craft at the workshop\n          actions.append(act_map[\"USE\"])\n          env.step(act_map[\"USE\"])\n\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T15:50:49.810852", "function_name": "make_arrow", "function_body": "  # Reset the environment to a fresh start\n  env.reset()\n  # Current state after reset\n  state = env._current_state\n\n  # Goal item index and its recipe information\n  goal_idx = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal_idx)          # {primitive_idx: count}\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n\n  # Mapping from action name to integer index used by the environment\n  act_map = env.action_specs()\n\n  # Cardinal movement deltas for each movement action name\n  move_delta = {\n      \"UP\":    (-1, 0),\n      \"DOWN\":  ( 1, 0),\n      \"LEFT\":  ( 0,-1),\n      \"RIGHT\": ( 0, 1),\n  }\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of action names moving the agent\n  # from `start` to a cell that is adjacent (including diagonally)\n  # to any cell in `targets`.  Only empty cells may be traversed.\n  # ------------------------------------------------------------------\n  def bfs_to_adjacent(start, targets, grid):\n      from collections import deque\n      W, H = grid.shape[:2]\n      visited = np.full((W, H), False, dtype=bool)\n      q = deque()\n      q.append((start, []))\n      visited[start] = True\n      target_set = set(targets)\n\n      while q:\n          pos, path = q.popleft()\n\n          # If we are adjacent (Chebyshev distance <= 1) to any target, stop\n          for tx, ty in target_set:\n              if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:\n                  return path\n\n          # Expand neighbours\n          for act, (dx, dy) in move_delta.items():\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  # cell must be empty (no entity present)\n                  if grid[nx, ny].sum() == 0:\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [act]))\n      return None  # No reachable adjacent cell\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # 1) Collect required primitive items\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          # Refresh state information (grid, position)\n          state = env._current_state\n          grid = state.grid\n          pos = state.pos\n\n          # Locate all cells that currently contain the needed primitive\n          prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not prim_cells:\n              # Primitive not present \u2013 abort collection loop\n              break\n\n          # Plan a path to the nearest primitive (adjacent cell)\n          path = bfs_to_adjacent(pos, prim_cells, grid)\n          if path is None:\n              # Unable to reach the primitive \u2013 abort\n              break\n\n          # Execute movement actions\n          for act_name in path:\n              actions.append(act_map[act_name])\n              env.step(act_map[act_name])\n\n          # Use action to pick up the primitive\n          actions.append(act_map[\"USE\"])\n          env.step(act_map[\"USE\"])\n\n  # ------------------------------------------------------------------\n  # 2) Move to the workshop (if any) and craft the goal item\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      # Refresh state after collecting primitives\n      state = env._current_state\n      grid = state.grid\n      pos = state.pos\n\n      # Locate workshop cells of the required kind\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n      if workshop_cells:\n          # Plan a path to the workshop (adjacent cell)\n          path = bfs_to_adjacent(pos, workshop_cells, grid)\n          if path:\n              for act_name in path:\n                  actions.append(act_map[act_name])\n                  env.step(act_map[act_name])\n\n          # Use action at the workshop to craft the item\n          actions.append(act_map[\"USE\"])\n          env.step(act_map[\"USE\"])\n\n  # Return the complete action sequence (list of integer action IDs)\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T15:51:12.469292", "function_name": "make_arrow", "function_body": "  # Helper: map direction vectors to action indices (assumes standard ordering)\n  DIR2ACT = {\n      (0, 1): 0,   # DOWN\n      (0, -1): 1,  # UP\n      (-1, 0): 2,  # LEFT\n      (1, 0): 3,   # RIGHT\n  }\n  ACT2DIR = {v: k for k, v in DIR2ACT.items()}\n\n  # ----------------------------------------------------------------------\n  # BFS: find actions to reach a cell adjacent (Manhattan distance 1) to any\n  # target cell while avoiding non\u2011grabbable obstacles.\n  # ----------------------------------------------------------------------\n  from collections import deque\n  import numpy as np\n\n  def bfs_to_adjacent(start, targets, grid):\n      \"\"\"Return list of actions moving from ``start`` to a position adjacent\n      to any cell in ``targets``. ``grid`` is (W, H, K); a cell is blocked if\n      any non\u2011grabbable kind is present.\"\"\"\n      W, H = grid.shape[:2]\n      # blocked if any non\u2011grabbable kind has a positive count in that cell\n      blocked = np.zeros((W, H), dtype=bool)\n      for idx in env.world.non_grabbable_indices:\n          blocked |= grid[:, :, idx] > 0\n\n      sx, sy = start\n      # Already adjacent?\n      for tx, ty in targets:\n          if abs(sx - tx) + abs(sy - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((sx, sy, []))\n      visited = np.full((W, H), False, dtype=bool)\n      visited[sx, sy] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR2ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if blocked[nx, ny]:\n                      continue\n                  npath = path + [act]\n                  # Check adjacency to any target\n                  for tx, ty in targets:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return npath\n                  visited[nx, ny] = True\n                  q.append((nx, ny, npath))\n      # No reachable adjacency\n      return []\n\n  # ----------------------------------------------------------------------\n  # Main planning logic\n  # ----------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()            # local mutable copy\n  pos = tuple(state.pos)              # (x, y)\n\n  # Goal index (environment task stores it in env.task.goal)\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      raise ValueError(\"Goal index not found in environment task.\")\n\n  # Primitive requirements for the goal (including intermediate items)\n  needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  plan = []\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives (including intermediates).\n  # ------------------------------------------------------------------\n  for kind_idx, cnt_needed in needed.items():\n      while cnt_needed > 0:\n          # Locate all cells that currently contain this kind\n          cells = np.argwhere(grid[:, :, kind_idx] > 0)\n          if cells.size == 0:\n              # No more of this primitive on the map \u2013 abort planning.\n              return plan\n\n          # Find path to nearest reachable primitive (adjacent)\n          path = bfs_to_adjacent(pos, cells.tolist(), grid)\n          plan.extend(path)\n\n          # Simulate movement to update position\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Use action to pick up the primitive\n          plan.append(4)   # USE\n          # Identify which primitive cell we are now adjacent to\n          adj_cell = None\n          for cx, cy in cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  adj_cell = (cx, cy)\n                  break\n          if adj_cell is None:\n              # Should not happen; break to avoid infinite loop.\n              break\n\n          # Update local grid copy (remove one instance) and decrement need\n          grid[adj_cell[0], adj_cell[1], kind_idx] -= 1\n          cnt_needed -= 1\n\n  # ------------------------------------------------------------------\n  # 2. Move to the appropriate workshop and craft the goal item.\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (could be a string name)\n      if isinstance(workshop_key, str):\n          workshop_idx = env.world.cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          path = bfs_to_adjacent(pos, workshop_cells.tolist(), grid)\n          plan.extend(path)\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          # Craft by using the workshop\n          plan.append(4)   # USE\n\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T15:51:13.585712", "function_name": "make_arrow", "function_body": "  # Helper to map movement delta to action index (matches CraftLab spec)\n  DIR_TO_ACT = {\n      (0, 1): 0,   # DOWN\n      (0, -1): 1,  # UP\n      (-1, 0): 2,  # LEFT\n      (1, 0): 3,   # RIGHT\n  }\n  ACT_TO_DIR = {v: k for k, v in DIR_TO_ACT.items()}\n\n  # ------------------------------------------------------------------\n  # BFS returning actions to reach a cell adjacent to any target cell.\n  # ------------------------------------------------------------------\n  from collections import deque\n  import numpy as np\n\n  def bfs(start_pos, target_cells, grid, block_set):\n      \"\"\"Return list of actions moving from ``start_pos`` to a position\n      adjacent (Manhattan distance 1) to any cell in ``target_cells``.\n      ``grid`` shape (W, H, K). Cells containing any index in ``block_set``\n      are considered blocked.\n      \"\"\"\n      W, H = grid.shape[:2]\n      # pre\u2011compute blocked boolean map\n      blocked = np.zeros((W, H), dtype=bool)\n      for b in block_set:\n          blocked |= grid[:, :, b] > 0\n\n      sx, sy = start_pos\n      # already adjacent?\n      for tx, ty in target_cells:\n          if abs(sx - tx) + abs(sy - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((sx, sy, []))\n      visited = np.full((W, H), False, dtype=bool)\n      visited[sx, sy] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR_TO_ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if blocked[nx, ny]:\n                      continue\n                  npath = path + [act]\n                  # check adjacency to any target\n                  for tx, ty in target_cells:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return npath\n                  visited[nx, ny] = True\n                  q.append((nx, ny, npath))\n      return []  # no reachable adjacency\n\n  # ------------------------------------------------------------------\n  # Initialise environment and extract task information.\n  # ------------------------------------------------------------------\n  obs = env.reset()\n  state = env._current_state\n  grid = state.grid.copy()\n  pos = tuple(state.pos)                     # (x, y)\n\n  # Goal index from the task definition.\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      raise ValueError(\"Goal index not found in environment task.\")\n\n  # Primitive requirements for the goal (only primitives, counts).\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  block_set = env.world.non_grabbable_indices\n\n  plan = []\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives.\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      while needed_cnt > 0:\n          # Locate remaining instances of this primitive.\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # No more of this primitive on the map \u2013 abort planning.\n              return plan\n\n          # Compute path to the nearest reachable primitive (adjacent).\n          path = bfs(pos, prim_cells.tolist(), grid, block_set)\n          plan.extend(path)\n\n          # Simulate movement to update ``pos``.\n          for a in path:\n              dx, dy = ACT_TO_DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Use action to pick up the primitive.\n          plan.append(4)   # USE\n          # Identify which primitive cell we are now adjacent to.\n          adj_cell = None\n          for cx, cy in prim_cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  adj_cell = (cx, cy)\n                  break\n          if adj_cell is None:\n              # Unexpected \u2013 break to avoid infinite loop.\n              break\n\n          # Update local grid copy (remove one instance) and decrement need.\n          grid[adj_cell[0], adj_cell[1], prim_idx] -= 1\n          needed_cnt -= 1\n\n  # ------------------------------------------------------------------\n  # 2. Move to the appropriate workshop and craft the goal item.\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get('_at') or recipe.get('_key')\n  if workshop_key is not None:\n      # Resolve workshop index (may be string name or int).\n      if isinstance(workshop_key, str):\n          workshop_idx = env.world.cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          path = bfs(pos, workshop_cells.tolist(), grid, block_set)\n          plan.extend(path)\n          for a in path:\n              dx, dy = ACT_TO_DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          # Craft by using the workshop.\n          plan.append(4)   # USE\n\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T15:51:37.294136", "function_name": "make_arrow", "function_body": "  # Reset environment and obtain current state and world objects\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid                     # (W, H, n_kinds)\n\n  # Action indices (consistent with CraftLab.action_specs)\n  specs = env.action_specs()\n  DOWN = specs[\"DOWN\"]\n  UP = specs[\"UP\"]\n  LEFT = specs[\"LEFT\"]\n  RIGHT = specs[\"RIGHT\"]\n  USE = specs[\"USE\"]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that\n      moves the agent from ``start`` to ``goal`` using a simple Manhattan walk.\"\"\"\n      actions = []\n      y, x = start\n      gy, gx = goal\n      dy, dx = gy - y, gx - x\n\n      if dy > 0:\n          actions += [DOWN] * dy\n      elif dy < 0:\n          actions += [UP] * (-dy)\n\n      if dx > 0:\n          actions += [RIGHT] * dx\n      elif dx < 0:\n          actions += [LEFT] * (-dx)\n\n      return actions\n\n  def find_nearest(cell_kind, from_pos):\n      \"\"\"Find the nearest cell containing ``cell_kind`` (primitive or workshop).\"\"\"\n      locations = np.argwhere(grid[:, :, cell_kind] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest_idx = np.argmin(dists)\n      return tuple(locations[nearest_idx])\n\n  # ------------------------------------------------------------------\n  # Determine the goal index for 'arrow' and the required primitives.\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  needed = world.cookbook.primitives_for(arrow_idx)   # {primitive_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the required number of times.\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive not found \u2013 abort early.\n              return actions\n\n          ty, tx = target\n\n          # Choose a free adjacent cell (if any) to stand on before using.\n          adj = None\n          neighbours = [(ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)]\n          for ny, nx in neighbours:\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)\n                  if not occupied:\n                      adj = (ny, nx)\n                      break\n          if adj is None:\n              adj = target  # fallback: stand on the primitive cell itself\n\n          # Move to the adjacent cell.\n          actions += manhattan_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (move one step towards it; will be blocked if adjacent).\n          dy, dx = ty - cur_pos[0], tx - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick up the primitive.\n          actions.append(USE)\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          actions += manhattan_path(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # Trigger crafting at the current location.\n  actions.append(USE)\n\n  return actions", "env_interactions": 27, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T15:51:38.407492", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # Action indices as defined by CraftLab.action_specs\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Reset environment to start fresh and fetch underlying objects\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid                     # (W, H, n_kinds)\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return list of movement actions from start to goal (ignores obstacles).\"\"\"\n      actions = []\n      y, x = start\n      gy, gx = goal\n      dy, dx = gy - y, gx - x\n      if dy > 0:\n          actions += [DOWN] * dy\n      elif dy < 0:\n          actions += [UP] * (-dy)\n      if dx > 0:\n          actions += [RIGHT] * dx\n      elif dx < 0:\n          actions += [LEFT] * (-dx)\n      return actions\n\n  def find_nearest(kind, from_pos):\n      \"\"\"Find nearest cell containing `kind`. Returns (y,x) or None.\"\"\"\n      locs = np.argwhere(grid[:, :, kind] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      return tuple(locs[dists.argmin()])\n\n  # ------------------------------------------------------------------\n  # Determine goal index and required primitives\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the needed number of times\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # primitive not present \u2013 abort early\n              return actions\n\n          ty, tx = target\n\n          # Choose a free adjacent cell to stand on before using\n          adj = None\n          for ny, nx in ((ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)):\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)\n                  if not occupied:\n                      adj = (ny, nx)\n                      break\n          if adj is None:\n              # fallback: stand on the primitive cell itself\n              adj = (ty, tx)\n\n          # Move to the adjacent cell\n          actions += manhattan_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (the direction that would move into it)\n          dy, dx = ty - cur_pos[0], tx - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick up the primitive\n          actions.append(USE)\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if recipe specifies one) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          actions += manhattan_path(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # Trigger crafting\n  actions.append(USE)\n\n  return actions", "env_interactions": 27, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T15:51:59.192182", "function_name": "make_arrow", "function_body": "  # ------------------------------------------------------------------\n  # initialise environment and obtain useful references\n  # ------------------------------------------------------------------\n  env.reset()\n  state = env._current_state          # current CraftState\n  world = env.world\n\n  # ------------------------------------------------------------------\n  # action constants (as defined in CraftLab)\n  # ------------------------------------------------------------------\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # helper: find the nearest cell (Manhattan distance) containing a kind\n  # ------------------------------------------------------------------\n  def _find_nearest(grid, kind_idx, start_pos):\n      h, w, _ = grid.shape\n      best = None\n      best_dist = None\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  d = abs(i - start_pos[0]) + abs(j - start_pos[1])\n                  if best_dist is None or d < best_dist:\n                      best_dist = d\n                      best = (i, j)\n      return best\n\n  # ------------------------------------------------------------------\n  # helper: locate any cell containing a given kind (used for workshops)\n  # ------------------------------------------------------------------\n  def _find_any(grid, kind_idx):\n      h, w, _ = grid.shape\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  return (i, j)\n      return None\n\n  # ------------------------------------------------------------------\n  # helper: generate a Manhattan path (list of actions) from src to dst\n  # ------------------------------------------------------------------\n  def _path(src, dst):\n      actions = []\n      r, c = src\n      tr, tc = dst\n      while r != tr:\n          if r < tr:\n              actions.append(DOWN)\n              r += 1\n          else:\n              actions.append(UP)\n              r -= 1\n      while c != tc:\n          if c < tc:\n              actions.append(RIGHT)\n              c += 1\n          else:\n              actions.append(LEFT)\n              c -= 1\n      return actions\n\n  # ------------------------------------------------------------------\n  # identify the goal item (arrow)\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:          # arrow not defined in the recipe file\n      return []\n\n  # ------------------------------------------------------------------\n  # compute primitive requirements for a single arrow\n  # ------------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}\n  action_seq = []\n\n  # ------------------------------------------------------------------\n  # collect each required primitive (respecting required counts)\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in primitive_needs.items():\n      for _ in range(cnt):\n          target = _find_nearest(state.grid, prim_idx, state.pos)\n          if target is None:            # primitive missing \u2013 abort early\n              return action_seq\n          # move to the primitive location\n          for a in _path(state.pos, target):\n              reward, done, obs = env.step(a)\n              state = env._current_state\n              action_seq.append(a)\n              if done:\n                  return action_seq\n          # pick it up\n          reward, done, obs = env.step(USE)\n          state = env._current_state\n          action_seq.append(USE)\n          if done:\n              return action_seq\n\n  # ------------------------------------------------------------------\n  # if the recipe specifies a workshop, go there before crafting\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\", None)\n\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = _find_any(state.grid, workshop_idx)\n      if workshop_pos is not None:\n          for a in _path(state.pos, workshop_pos):\n              reward, done, obs = env.step(a)\n              state = env._current_state\n              action_seq.append(a)\n              if done:\n                  return action_seq\n\n  # ------------------------------------------------------------------\n  # final craft action (USE) at current location (workshop or open ground)\n  # ------------------------------------------------------------------\n  reward, done, obs = env.step(USE)\n  action_seq.append(USE)\n\n  return action_seq", "env_interactions": 21, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T15:52:00.302362", "function_name": "make_arrow", "function_body": "  # ------------------------------------------------------------------\n  # constants for actions\n  # ------------------------------------------------------------------\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # helper: find the nearest cell (Manhattan) that contains a given kind\n  # ------------------------------------------------------------------\n  def _find_nearest(grid, kind_idx, start_pos):\n      h, w, _ = grid.shape\n      best = None\n      best_dist = None\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  d = abs(i - start_pos[0]) + abs(j - start_pos[1])\n                  if best_dist is None or d < best_dist:\n                      best_dist = d\n                      best = (i, j)\n      return best\n\n  # ------------------------------------------------------------------\n  # helper: locate any cell containing a given kind (used for workshops)\n  # ------------------------------------------------------------------\n  def _find_any(grid, kind_idx):\n      h, w, _ = grid.shape\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  return (i, j)\n      return None\n\n  # ------------------------------------------------------------------\n  # helper: produce a Manhattan path (list of actions) from src to dst\n  # ------------------------------------------------------------------\n  def _path(src, dst):\n      actions = []\n      r, c = src\n      tr, tc = dst\n      while r != tr:\n          if r < tr:\n              actions.append(DOWN)\n              r += 1\n          else:\n              actions.append(UP)\n              r -= 1\n      while c != tc:\n          if c < tc:\n              actions.append(RIGHT)\n              c += 1\n          else:\n              actions.append(LEFT)\n              c -= 1\n      return actions\n\n  # ------------------------------------------------------------------\n  # initialise episode\n  # ------------------------------------------------------------------\n  env.reset()\n  state = env._current_state          # current CraftState\n  world = env.world\n\n  # ------------------------------------------------------------------\n  # identify the goal item (arrow)\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:                   # arrow not defined in this world\n      return []\n\n  # ------------------------------------------------------------------\n  # primitives required for a single arrow\n  # ------------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}\n  action_seq = []\n\n  # ------------------------------------------------------------------\n  # collect each required primitive (respecting required counts)\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in primitive_needs.items():\n      for _ in range(cnt):\n          target = _find_nearest(state.grid, prim_idx, state.pos)\n          if target is None:            # primitive missing \u2013 cannot proceed\n              return action_seq\n          # move to the primitive location\n          for a in _path(state.pos, target):\n              reward, done, obs = env.step(a)\n              state = env._current_state\n              action_seq.append(a)\n              if done:\n                  return action_seq\n          # pick it up\n          reward, done, obs = env.step(USE)\n          state = env._current_state\n          action_seq.append(USE)\n          if done:\n              return action_seq\n\n  # ------------------------------------------------------------------\n  # if the recipe specifies a workshop, go there and craft\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\", None)\n\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = _find_any(state.grid, workshop_idx)\n      if workshop_pos is not None:\n          for a in _path(state.pos, workshop_pos):\n              reward, done, obs = env.step(a)\n              state = env._current_state\n              action_seq.append(a)\n              if done:\n                  return action_seq\n          # craft at the workshop\n          reward, done, obs = env.step(USE)\n          state = env._current_state\n          action_seq.append(USE)\n\n  return action_seq", "env_interactions": 21, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T15:52:27.601081", "function_name": "make_arrow", "function_body": "", "env_interactions": 0, "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-10-28T15:52:28.709844", "function_name": "make_arrow", "function_body": "  DIR2ACT = {\n      (0, 1): 0,   # DOWN\n      (0, -1): 1,  # UP\n      (-1, 0): 2,  # LEFT\n      (1, 0): 3,   # RIGHT\n  }\n  ACT2DIR = {v: k for k, v in DIR2ACT.items()}\n\n  # ----------------------------------------------------------------------\n  # BFS: find a sequence of actions that moves the agent to a cell adjacent\n  # (Manhattan distance 1) to any target cell while avoiding non\u2011grabbable\n  # obstacles.\n  # ----------------------------------------------------------------------\n  from collections import deque\n  import numpy as np\n\n  def bfs_to_adjacent(start, targets, grid):\n      \"\"\"Return a list of actions that brings the agent from ``start`` to a\n      position adjacent to any cell in ``targets``. ``grid`` has shape\n      (W, H, K). A cell is considered blocked if any non\u2011grabbable kind has\n      a positive count in that cell.\"\"\"\n      W, H = grid.shape[:2]\n      # Determine blocked cells (any non\u2011grabbable entity present)\n      blocked = np.zeros((W, H), dtype=bool)\n      for idx in env.world.non_grabbable_indices:\n          blocked |= grid[:, :, idx] > 0\n\n      sx, sy = start\n      # Already adjacent to a target?\n      for tx, ty in targets:\n          if abs(sx - tx) + abs(sy - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((sx, sy, []))\n      visited = np.full((W, H), False, dtype=bool)\n      visited[sx, sy] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR2ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if blocked[nx, ny]:\n                      continue\n                  npath = path + [act]\n                  # Check adjacency to any target cell\n                  for tx, ty in targets:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return npath\n                  visited[nx, ny] = True\n                  q.append((nx, ny, npath))\n      # No reachable adjacency\n      return []\n\n  # ----------------------------------------------------------------------\n  # Main planning logic\n  # ----------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()            # mutable copy for simulation\n  pos = tuple(state.pos)              # (x, y)\n\n  # Goal index is stored in the task object (env.task.goal)\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      raise ValueError(\"Goal index not found in environment task.\")\n\n  # Determine primitive (and intermediate) requirements for the goal.\n  needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  plan = []\n\n  # --------------------------------------------------------------\n  # 1. Collect all required primitives (including intermediates)\n  # --------------------------------------------------------------\n  for kind_idx, cnt_needed in needed.items():\n      while cnt_needed > 0:\n          # Locate all cells currently containing this kind\n          cells = np.argwhere(grid[:, :, kind_idx] > 0)\n          if cells.size == 0:\n              # Primitive not present on the map \u2013 abort planning.\n              return plan\n\n          # Find a path to the nearest reachable primitive (adjacent)\n          path = bfs_to_adjacent(pos, cells.tolist(), grid)\n          plan.extend(path)\n\n          # Simulate movement to update the agent's position\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Use action to pick up the primitive\n          plan.append(4)   # USE\n\n          # Identify which primitive cell we are now adjacent to\n          adj_cell = None\n          for cx, cy in cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  adj_cell = (cx, cy)\n                  break\n          if adj_cell is None:\n              # Unexpected situation; break to avoid infinite loop.\n              break\n\n          # Update local grid copy (remove one instance) and decrement need\n          grid[adj_cell[0], adj_cell[1], kind_idx] -= 1\n          cnt_needed -= 1\n\n  # --------------------------------------------------------------\n  # 2. Move to the appropriate workshop and craft the goal item.\n  # --------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (could be a string name or already an int)\n      if isinstance(workshop_key, str):\n          workshop_idx = env.world.cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          path = bfs_to_adjacent(pos, workshop_cells.tolist(), grid)\n          plan.extend(path)\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          # Craft by using the workshop\n          plan.append(4)   # USE\n\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
