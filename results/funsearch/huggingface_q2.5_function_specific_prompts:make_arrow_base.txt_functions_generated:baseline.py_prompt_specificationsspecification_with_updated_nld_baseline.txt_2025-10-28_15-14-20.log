{"timestamp": "2025-10-28T23:50:13.714255", "function_name": "make_arrow", "function_body": "  import collections, numpy as np\n\n  # standard action IDs\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # BFS returning a list of actions that moves from `start` to a cell\n  # adjacent (Manhattan distance == 1) to any position in `targets`.\n  # `occ` is a 2\u2011D bool array where True means the cell is blocked.\n  # ------------------------------------------------------------------\n  def _bfs_adj(start, targets, occ):\n      w, h = occ.shape\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # check adjacency\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n          # expand neighbours\n          for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occ[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # unreachable \u2013 return empty list\n      return []\n\n  # ------------------------------------------------------------------\n  # Retrieve the underlying CraftWorld and its Cookbook.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      state_obj = getattr(env, \"_current_state\", None)\n      if state_obj is not None:\n          world = getattr(state_obj, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"CraftWorld instance not found in the environment.\")\n  cookbook = world.cookbook\n\n  # ------------------------------------------------------------------\n  # Goal: craft an 'arrow'.\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # Primitive requirements for ONE arrow.\n  primitives_needed = cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n\n  # ------------------------------------------------------------------\n  # Ensure a fresh episode.\n  # ------------------------------------------------------------------\n  if not hasattr(env, \"_current_state\") or env._current_state is None:\n      env.reset()\n  state = env._current_state\n\n  pos = tuple(state.pos)                 # (x, y)\n  grid = state.grid                       # (W, H, n_kinds)\n  occupied = np.any(grid > 0, axis=2)    # True where any entity blocks\n\n  actions = []            # final action sequence\n  collected = set()       # cells already harvested\n\n  # ------------------------------------------------------------------\n  # Collect required primitives (greedy nearest\u2011first).\n  # ------------------------------------------------------------------\n  for prim_idx, need in primitives_needed.items():\n      # current locations of this primitive\n      locs = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # sort by Manhattan distance from current position\n      locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      got = 0\n      for loc in locs:\n          if got >= need:\n              break\n          if loc in collected:\n              continue\n          # move adjacent to the primitive\n          path = _bfs_adj(pos, [loc], occupied)\n          actions.extend(path)\n          # update position according to path\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # pick it up\n          actions.append(USE)\n          occupied[loc[0], loc[1]] = False   # cell becomes free\n          collected.add(loc)\n          got += 1\n\n  # ------------------------------------------------------------------\n  # Go to the workshop (if required) and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # resolve workshop index (may be name or integer)\n      workshop_idx = (cookbook.index[workshop_key]\n                      if isinstance(workshop_key, str) else workshop_key)\n      ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if not ws_cells:\n          raise RuntimeError(f\"No workshop of type '{workshop_key}' present.\")\n      # choose nearest workshop\n      ws_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      target_ws = ws_cells[0]\n      path = _bfs_adj(pos, [target_ws], occupied)\n      actions.extend(path)\n      for act in path:\n          if act == RIGHT:\n              pos = (pos[0] + 1, pos[1])\n          elif act == LEFT:\n              pos = (pos[0] - 1, pos[1])\n          elif act == DOWN:\n              pos = (pos[0], pos[1] + 1)\n          elif act == UP:\n              pos = (pos[0], pos[1] - 1)\n      # craft\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T23:50:14.837981", "function_name": "make_arrow", "function_body": "  import collections\n  import numpy as np\n\n  # Action indices (standard CraftWorld actions)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving from `start` to a\n  # position adjacent (Manhattan distance = 1) to any cell in `targets`.\n  # The search treats any occupied cell (grid[...,k] > 0 for any k) as\n  # blocked.  If `start` is already adjacent, an empty list is returned.\n  # ------------------------------------------------------------------\n  def _bfs_to_adjacent(start, targets, occ):\n      w, h = occ.shape\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # adjacency check\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n          # expand neighbours\n          for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occ[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # no reachable adjacency \u2013 return empty list\n      return []\n\n  # ------------------------------------------------------------------\n  # Helper: update a position tuple given an action.\n  # ------------------------------------------------------------------\n  def _apply_path(pos, path):\n      x, y = pos\n      for act in path:\n          if act == RIGHT:\n              x += 1\n          elif act == LEFT:\n              x -= 1\n          elif act == DOWN:\n              y += 1\n          elif act == UP:\n              y -= 1\n      return (x, y)\n\n  # ------------------------------------------------------------------\n  # Locate the underlying CraftWorld and its cookbook.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Some wrappers expose the world via the internal state.\n      state_obj = getattr(env, \"_current_state\", None)\n      if state_obj is not None:\n          world = getattr(state_obj, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"Unable to locate CraftWorld instance in the environment.\")\n  cookbook = world.cookbook\n\n  # ------------------------------------------------------------------\n  # Goal: craft an 'arrow'.\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # Primitive requirements for one arrow.\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n\n  # ------------------------------------------------------------------\n  # Ensure we start from a fresh episode.\n  # ------------------------------------------------------------------\n  if not hasattr(env, \"_current_state\") or env._current_state is None:\n      env.reset()\n  state = env._current_state\n\n  pos = tuple(state.pos)            # (x, y)\n  grid = state.grid                  # (W, H, n_kinds)\n\n  # Occupancy map: True where any entity blocks movement.\n  occupied = np.any(grid > 0, axis=2)\n\n  actions = []                       # final action list\n  collected_cells = set()            # primitives already taken\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first).\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      # Current locations of this primitive.\n      locs = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # Sort by Manhattan distance from current position.\n      locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      gathered = 0\n      for loc in locs:\n          if gathered >= needed:\n              break\n          if loc in collected_cells:\n              continue\n          # Path to a cell adjacent to the primitive.\n          path = _bfs_to_adjacent(pos, [loc], occupied)\n          actions.extend(path)\n          pos = _apply_path(pos, path)\n\n          # Pick up the primitive.\n          actions.append(USE)\n\n          # Update occupancy and bookkeeping.\n          occupied[loc[0], loc[1]] = False\n          collected_cells.add(loc)\n          gathered += 1\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (could be a name or an int).\n      workshop_idx = (\n          cookbook.index[workshop_key]\n          if isinstance(workshop_key, str) else workshop_key\n      )\n      workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if not workshop_cells:\n          raise RuntimeError(f\"No workshop of type '{workshop_key}' found in the scenario.\")\n      # Choose the nearest workshop.\n      workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      target_ws = workshop_cells[0]\n\n      path = _bfs_to_adjacent(pos, [target_ws], occupied)\n      actions.extend(path)\n      pos = _apply_path(pos, path)\n\n      # Craft the arrow.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T23:50:40.336498", "function_name": "make_arrow", "function_body": "  # Resolve the world and scenario objects from the wrapper env\n  scenario = getattr(env, \"scenario\", None) or getattr(env, \"world\", None) or env\n  world = getattr(scenario, \"world\", None) or getattr(env, \"world\", None)\n  if world is None:\n      return []\n\n  # Index of the goal item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Obtain the initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_key(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      # Position, direction, inventory contents and the whole grid layout\n      return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())\n\n  visited = {_state_key(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  # Safety limits\n  MAX_PLAN_LEN = 500          # max number of actions to explore\n  n_actions = getattr(world, \"n_actions\", 5)   # usually 4 moves + USE\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state, cur_actions = node.state, node.actions\n\n      # Goal test: have at least one arrow in the inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return cur_actions\n\n      if len(cur_actions) >= MAX_PLAN_LEN:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          key = _state_key(nxt_state)\n          if key not in visited:\n              visited.add(key)\n              frontier.append(Node(nxt_state, cur_actions + [a]))\n\n  # No plan found within the search budget\n  return []", "env_interactions": 20, "island_id": 1, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:50:56.066082", "function_name": "make_arrow", "function_body": "  # Retrieve the scenario and world objects from the environment\n  scenario = getattr(env, \"scenario\", None) or getattr(env, \"world\", None) or env\n  world = getattr(scenario, \"world\", None) or getattr(env, \"world\", None)\n  if world is None:\n      return []\n\n  # Get the index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Obtain the initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_key(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      # Use position, direction, inventory tuple, and a hash of the grid\n      return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())\n\n  # BFS initialization\n  visited = {_state_key(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_PLAN_LEN = 500                     # safety cutoff for search depth\n  n_actions = getattr(world, \"n_actions\", 5)   # typically 4 moves + USE\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state, cur_actions = node.state, node.actions\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return cur_actions\n\n      # Prune overly long trajectories\n      if len(cur_actions) >= MAX_PLAN_LEN:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          key = _state_key(nxt_state)\n          if key not in visited:\n              visited.add(key)\n              frontier.append(Node(nxt_state, cur_actions + [a]))\n\n  # No plan found within the search budget\n  return []", "env_interactions": 20, "island_id": 1, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:51:21.695144", "function_name": "make_arrow", "function_body": "  # Resolve scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  # A compact hashable representation of a state for visited checking\n  def _state_key(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_key(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 800                     # safety bound on plan length\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state, cur_actions = node.state, node.actions\n\n      # Goal test: have at least one arrow in the inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return cur_actions\n\n      if len(cur_actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          key = _state_key(nxt_state)\n          if key not in visited:\n              visited.add(key)\n              frontier.append(Node(nxt_state, cur_actions + [a]))\n\n  # No plan found within the step limit\n  return []", "env_interactions": 20, "island_id": 1, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:51:37.460369", "function_name": "make_arrow", "function_body": "  # Resolve the underlying scenario and world objects\n  scenario = getattr(env, \"scenario\", None) or getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", None) or getattr(env, \"world\", None)\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  # Helper to create a hashable key for a state (position, direction, inventory, grid)\n  def _state_key(st):\n      return (st.pos,\n              st.dir,\n              tuple(st.inventory.tolist()),\n              st.grid.tobytes())\n\n  visited = {_state_key(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 800          # safety bound on plan length\n  n_actions = getattr(world, \"n_actions\", 5)   # typically 5 (4 moves + USE)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state, cur_actions = node.state, node.actions\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return cur_actions\n\n      # Do not expand beyond the step limit\n      if len(cur_actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          key = _state_key(nxt_state)\n          if key not in visited:\n              visited.add(key)\n              frontier.append(Node(nxt_state, cur_actions + [a]))\n\n  # No plan found within the limits\n  return []", "env_interactions": 20, "island_id": 1, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:52:03.954251", "function_name": "make_arrow", "function_body": "  # Resolve scenario and world objects\n  scenario = getattr(env, \"scenario\", None) or env\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state from which we will plan\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  # BFS utilities\n  from collections import deque, namedtuple\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_key(st):\n      \"\"\"Hashable representation of a CraftState.\"\"\"\n      # inventory: tuple of ints; grid: raw bytes; position & direction are scalars\n      return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())\n\n  visited = {_state_key(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_PLAN_LEN = 800                     # safety cutoff for plan length\n  n_actions = getattr(world, \"n_actions\", 5)   # typically 5 (4 moves + USE)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long trajectories\n      if len(node.actions) >= MAX_PLAN_LEN:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          key = _state_key(nxt_state)\n          if key not in visited:\n              visited.add(key)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within the search budget\n  return []", "env_interactions": 20, "island_id": 1, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:52:05.070312", "function_name": "make_arrow", "function_body": "", "env_interactions": 0, "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-10-28T23:52:28.568045", "function_name": "make_arrow", "function_body": "  # Action constants\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  # Mapping from action to delta (dx, dy)\n  _DELTA = {\n      DOWN: (0, 1),\n      UP: (0, -1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving the agent from\n  # `start` to a cell adjacent (Manhattan distance 1) to any of the\n  # positions in `targets`. Cells with any non\u2011zero entry in any channel\n  # are considered blocked.\n  # ------------------------------------------------------------------\n  from collections import deque\n  import numpy as np\n\n  def _bfs_path(start, targets, cur_grid):\n      w, h, _ = cur_grid.shape\n      occupied = np.any(cur_grid > 0, axis=2)  # True where something blocks movement\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # If we are already adjacent to any target, stop.\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n          # Expand neighbours.\n          for act, (dx, dy) in _DELTA.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # No reachable adjacent cell.\n      return []\n\n  # ------------------------------------------------------------------\n  # Retrieve the underlying CraftWorld and its cookbook.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Some wrappers expose the world via the current state.\n      state_wrapper = getattr(env, \"_current_state\", None)\n      if state_wrapper is not None:\n          world = getattr(state_wrapper, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"Unable to locate CraftWorld instance inside the environment.\")\n\n  cookbook = world.cookbook\n\n  # ------------------------------------------------------------------\n  # Goal: hard\u2011coded to the item named \"arrow\".\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  if goal_name not in cookbook.index.contents:\n      raise ValueError(f\"Goal '{goal_name}' not found in the cookbook.\")\n  goal_idx = cookbook.index[goal_name]\n\n  # Primitive requirements for one arrow.\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Ensure we have a fresh state to read the grid/position.\n  # ------------------------------------------------------------------\n  if not hasattr(env, \"_current_state\") or env._current_state is None:\n      env.reset()\n  state = env._current_state\n\n  pos = tuple(state.pos)          # (x, y)\n  grid = state.grid.copy()        # mutable copy for planning\n\n  actions = []\n  harvested = set()               # cells already used for collection\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first).\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      # All locations containing this primitive.\n      locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # Sort by Manhattan distance from current position.\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      collected = 0\n      for loc in locations:\n          if collected >= needed:\n              break\n          if loc in harvested:\n              continue\n          # Plan path to a cell adjacent to the primitive.\n          path = _bfs_path(pos, [loc], grid)\n          actions.extend(path)\n          # Simulate movement.\n          for act in path:\n              dx, dy = _DELTA[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n          # Pick up the primitive.\n          actions.append(USE)\n          harvested.add(loc)\n          collected += 1\n          # Remove the primitive from the planning grid.\n          grid[loc[0], loc[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (could be a string name or an integer).\n      if isinstance(workshop_key, str):\n          workshop_idx = cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n      # Locate workshop cells.\n      workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if workshop_cells:\n          # Choose the nearest workshop.\n          workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = workshop_cells[0]\n          path = _bfs_path(pos, [target_ws], grid)\n          actions.extend(path)\n          for act in path:\n              dx, dy = _DELTA[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(USE)   # craft at the workshop\n      else:\n          # No visible workshop \u2013 attempt to craft at current location.\n          actions.append(USE)\n  else:\n      # No specific workshop required.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T23:52:29.704562", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  _DELTA = {\n      DOWN: (0, 1),\n      UP: (0, -1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  # ------------------------------------------------------------------\n  # BFS that returns a list of actions moving from `start` to a cell\n  # adjacent (Manhattan distance 1) to any of `targets`. Cells where any\n  # channel is non\u2011zero are considered blocked.\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  def _bfs_path(start, targets, grid):\n      w, h, _ = grid.shape\n      occupied = np.any(grid > 0, axis=2)\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # Adjacent to a target?\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n          # Expand neighbours\n          for act, (dx, dy) in _DELTA.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # No reachable adjacent cell\n      return []\n\n  # ------------------------------------------------------------------\n  # Locate the underlying CraftWorld and its cookbook.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      state_wrapper = getattr(env, \"_current_state\", None)\n      if state_wrapper is not None:\n          world = getattr(state_wrapper, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"CraftWorld instance not found in the environment.\")\n\n  cookbook = world.cookbook\n\n  # Goal is hard\u2011coded to \"arrow\"\n  goal_name = \"arrow\"\n  if goal_name not in cookbook.index.contents:\n      raise ValueError(f\"Goal '{goal_name}' not present in cookbook.\")\n  goal_idx = cookbook.index[goal_name]\n\n  # Primitive requirements for one arrow\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Ensure we have a fresh state to read grid/position.\n  # ------------------------------------------------------------------\n  if not hasattr(env, \"_current_state\") or env._current_state is None:\n      env.reset()\n  state = env._current_state\n\n  pos = tuple(state.pos)               # (x, y)\n  grid = state.grid.copy()             # mutable copy for planning\n\n  actions = []\n  harvested = set()                    # cells already used for collection\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (nearest\u2011first greedy).\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      # All locations containing this primitive\n      locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # Sort by Manhattan distance from current position\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      collected = 0\n      for loc in locations:\n          if collected >= needed:\n              break\n          if loc in harvested:\n              continue\n          # Plan path to a cell adjacent to the primitive\n          path = _bfs_path(pos, [loc], grid)\n          actions.extend(path)\n          # Simulate movement\n          for act in path:\n              dx, dy = _DELTA[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n          # Pick up the primitive\n          actions.append(USE)\n          harvested.add(loc)\n          collected += 1\n          # Remove the primitive from the planning grid\n          grid[loc[0], loc[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (string name or integer)\n      if isinstance(workshop_key, str):\n          workshop_idx = cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n      # Locate workshop cells\n      workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if workshop_cells:\n          # Choose nearest workshop\n          workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = workshop_cells[0]\n          path = _bfs_path(pos, [target_ws], grid)\n          actions.extend(path)\n          for act in path:\n              dx, dy = _DELTA[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(USE)   # craft at workshop\n      else:\n          # No visible workshop; attempt to craft at current location\n          actions.append(USE)\n  else:\n      # No specific workshop required\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T23:52:55.620892", "function_name": "make_arrow", "function_body": "  # Retrieve the underlying scenario and world objects (handle possible wrappers)\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Find the index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Obtain the initial state for this episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  # Bread\u2011first search planner over CraftState space\n  from collections import deque\n\n  def _state_key(st):\n      \"\"\"Hashable representation of a CraftState.\"\"\"\n      return (st.pos, st.dir, st.inventory.tobytes(), st.grid.tobytes())\n\n  visited = {_state_key(init_state)}\n  frontier = deque([(init_state, [])])\n\n  MAX_PLAN_LEN = 300  # safety cutoff to avoid infinite search\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      cur_state, cur_actions = frontier.popleft()\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return cur_actions\n\n      # Prune overly long plans\n      if len(cur_actions) >= MAX_PLAN_LEN:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          key = _state_key(nxt_state)\n          if key not in visited:\n              visited.add(key)\n              frontier.append((nxt_state, cur_actions + [a]))\n\n  # No plan found within limits\n  return []", "env_interactions": 20, "island_id": 8, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:53:10.388277", "function_name": "make_arrow", "function_body": "  # Obtain the underlying scenario and world objects (handle possible wrappers)\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initialise the starting state of the episode\n  try:\n      start_state = scenario.init()\n  except Exception:\n      return []\n\n  # Helper to create a hashable representation of a CraftState\n  def _state_key(st):\n      return (st.pos, st.dir, st.inventory.tobytes(), st.grid.tobytes())\n\n  from collections import deque\n\n  # Bread\u2011first search over the state space\n  frontier = deque([(start_state, [])])\n  visited = {_state_key(start_state)}\n\n  MAX_STEPS = 300                     # safety cutoff for plan length\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      cur_state, cur_actions = frontier.popleft()\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return cur_actions\n\n      if len(cur_actions) >= MAX_STEPS:\n          continue\n\n      # Expand neighbours\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          key = _state_key(nxt_state)\n          if key not in visited:\n              visited.add(key)\n              frontier.append((nxt_state, cur_actions + [a]))\n\n  # No plan found within the depth limit\n  return []", "env_interactions": 20, "island_id": 8, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:53:36.889257", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Retrieve scenario and world objects from the provided environment.\n  # ----------------------------------------------------------------------\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # ----------------------------------------------------------------------\n  # Identify the index of the target item \"arrow\".\n  # ----------------------------------------------------------------------\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # ----------------------------------------------------------------------\n  # Initialise the starting CraftState.\n  # ----------------------------------------------------------------------\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  # ----------------------------------------------------------------------\n  # Bread\u2011first search over the state space to find a sequence of actions\n  # that yields at least one \"arrow\" in the inventory.\n  # ----------------------------------------------------------------------\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      \"\"\"Create a compact, hashable representation of a CraftState.\"\"\"\n      # Position and direction are small integers.\n      # Inventory and grid are large arrays \u2013 use their raw bytes.\n      return (st.pos, st.dir, st.inventory.tobytes(), st.grid.tobytes())\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 400                     # reasonable depth limit\n  n_actions = getattr(world, \"n_actions\", 5)   # usually 5 (4 moves + USE)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory.\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Do not expand beyond the depth limit.\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions.\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within the search budget.\n  return []", "env_interactions": 20, "island_id": 7, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:53:52.795341", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # initialise the starting state\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      \"\"\"Hash a CraftState for visited\u2011set checking.\"\"\"\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 400                     # hard limit to keep search tractable\n  n_actions = getattr(world, \"n_actions\", 5)   # usually 5 (4 moves + USE)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand neighbours\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within the depth limit\n  return []", "env_interactions": 20, "island_id": 7, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:54:23.616320", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _hash_state(st):\n      # Unique hash for a state: position, direction, inventory, and full grid layout\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = set()\n  frontier = deque([Node(init_state, [])])\n  visited.add(_hash_state(init_state))\n\n  max_steps = 400          # safety limit on plan length\n  max_nodes = 200000       # safety limit on total expanded nodes\n  nodes_expanded = 0\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state, cur_actions = node.state, node.actions\n\n      # Goal test: have an arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return cur_actions\n\n      # Prune overly long or overly large searches\n      if len(cur_actions) >= max_steps or nodes_expanded >= max_nodes:\n          continue\n\n      nodes_expanded += 1\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _hash_state(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, cur_actions + [a]))\n\n  # No plan found within limits\n  return []", "env_interactions": 20, "island_id": 3, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:54:39.369106", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Find the index for the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Obtain the initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _hash_state(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = set()\n  frontier = deque([Node(init_state, [])])\n  visited.add(_hash_state(init_state))\n\n  max_steps = 300          # safety cap on plan length\n  max_nodes = 150000       # safety cap on explored nodes\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  nodes_expanded = 0\n  while frontier:\n      node = frontier.popleft()\n      cur_state, cur_actions = node.state, node.actions\n\n      # Goal test: have an arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return cur_actions\n\n      # Prune overly long plans or excessive search\n      if len(cur_actions) >= max_steps:\n          continue\n      if nodes_expanded >= max_nodes:\n          break\n      nodes_expanded += 1\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _hash_state(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, cur_actions + [a]))\n\n  # No feasible plan found within limits\n  return []", "env_interactions": 20, "island_id": 3, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:54:59.412925", "function_name": "make_arrow", "function_body": "  # standard action ids\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving the agent from `start`\n  # to a cell adjacent (Manhattan distance 1) to any cell in `targets`.\n  # ------------------------------------------------------------------\n  def _bfs_adj(start, targets, occ):\n      w, h = occ.shape\n      q = collections.deque([(start[0], start[1], [])])\n      visited = {start}\n      target_set = set(targets)\n      while q:\n          x, y, path = q.popleft()\n          # adjacency check\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n          for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occ[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      return []  # unreachable\n\n  # ------------------------------------------------------------------\n  # Locate the world and its cookbook\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      st = getattr(env, \"_current_state\", None)\n      if st is not None:\n          world = getattr(st, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"CraftWorld instance not found in env.\")\n  cookbook = world.cookbook\n\n  # ------------------------------------------------------------------\n  # Goal: arrow\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # Primitive requirements for a single arrow\n  needed = cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n\n  # ------------------------------------------------------------------\n  # Ensure we have a fresh episode and obtain the current state\n  # ------------------------------------------------------------------\n  if not hasattr(env, \"_current_state\") or env._current_state is None:\n      env.reset()\n  state = env._current_state\n\n  pos = tuple(state.pos)                     # (x, y)\n  grid = state.grid                           # (W, H, n_kinds)\n  occupied = np.any(grid > 0, axis=2)        # True where blocked\n\n  actions = []\n  used_cells = set()                         # primitives already collected\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest first)\n  # ------------------------------------------------------------------\n  for prim_idx, qty in needed.items():\n      locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      have = 0\n      for loc in locations:\n          if have >= qty:\n              break\n          if loc in used_cells:\n              continue\n          # move adjacent to the primitive\n          path = _bfs_adj(pos, [loc], occupied)\n          actions.extend(path)\n          # update position according to the path taken\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # pick up the primitive\n          actions.append(USE)\n          occupied[loc[0], loc[1]] = False   # cell becomes free\n          used_cells.add(loc)\n          have += 1\n\n  # ------------------------------------------------------------------\n  # Craft at the required workshop (if any)\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      ws_idx = (cookbook.index[workshop_key]\n                if isinstance(workshop_key, str) else workshop_key)\n      ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, ws_idx] > 0)]\n      if not ws_cells:\n          raise RuntimeError(f\"Workshop '{workshop_key}' not found.\")\n      ws_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      target_ws = ws_cells[0]\n      path = _bfs_adj(pos, [target_ws], occupied)\n      actions.extend(path)\n      for act in path:\n          if act == RIGHT:\n              pos = (pos[0] + 1, pos[1])\n          elif act == LEFT:\n              pos = (pos[0] - 1, pos[1])\n          elif act == DOWN:\n              pos = (pos[0], pos[1] + 1)\n          elif act == UP:\n              pos = (pos[0], pos[1] - 1)\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T23:55:00.596785", "function_name": "make_arrow", "function_body": "  # standard action ids\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving the agent from `start`\n  # to a cell adjacent (Manhattan distance = 1) to any cell in `targets`.\n  # The search avoids any occupied cell (grid[...,kind] > 0 for any kind).\n  # ------------------------------------------------------------------\n  def _bfs_adjacent(start, targets):\n      w, h, _ = grid.shape\n      occupied = np.any(grid > 0, axis=2)          # True where blocked\n      q = collections.deque([(start[0], start[1], [])])\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # adjacency test\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n          # explore neighbours\n          for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # unreachable \u2013 return empty list\n      return []\n\n  # ------------------------------------------------------------------\n  # Locate world and cookbook\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # some wrappers store world inside the current state\n      state_wrapper = getattr(env, \"_current_state\", None)\n      if state_wrapper is not None:\n          world = getattr(state_wrapper, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"CraftWorld instance not found in env.\")\n  cookbook = world.cookbook\n\n  # ------------------------------------------------------------------\n  # Goal: arrow\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # primitive requirements for one arrow\n  needed = cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n\n  # ------------------------------------------------------------------\n  # Ensure we have a fresh episode and fetch current state\n  # ------------------------------------------------------------------\n  if not hasattr(env, \"_current_state\") or env._current_state is None:\n      env.reset()\n  state = env._current_state\n\n  pos = tuple(state.pos)                        # (x, y)\n  grid = state.grid                              # (W, H, n_kinds)\n\n  actions = []\n  used_cells = set()                             # primitives already collected\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest first)\n  # ------------------------------------------------------------------\n  for prim_idx, qty in needed.items():\n      # locate all cells containing this primitive\n      locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # sort by Manhattan distance from current position\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      have = 0\n      for loc in locations:\n          if have >= qty:\n              break\n          if loc in used_cells:\n              continue\n          # move adjacent to the primitive\n          path = _bfs_adjacent(pos, [loc])\n          actions.extend(path)\n          # update agent position following the path\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # pick up the primitive\n          actions.append(USE)\n          used_cells.add(loc)\n          have += 1\n\n  # ------------------------------------------------------------------\n  # Go to the appropriate workshop (if recipe specifies) and craft\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # resolve workshop index (may be a string name)\n      ws_idx = cookbook.index[workshop_key] if isinstance(workshop_key, str) else workshop_key\n      ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, ws_idx] > 0)]\n      if not ws_cells:\n          raise RuntimeError(f\"No workshop '{workshop_key}' found in the grid.\")\n      # choose nearest workshop\n      ws_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      target_ws = ws_cells[0]\n      path = _bfs_adjacent(pos, [target_ws])\n      actions.extend(path)\n      for act in path:\n          if act == RIGHT:\n              pos = (pos[0] + 1, pos[1])\n          elif act == LEFT:\n              pos = (pos[0] - 1, pos[1])\n          elif act == DOWN:\n              pos = (pos[0], pos[1] + 1)\n          elif act == UP:\n              pos = (pos[0], pos[1] - 1)\n      # craft at the workshop\n      actions.append(USE)\n\n  return actions", "env_interactions": 21, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T23:55:36.210002", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # target index 'arrow'\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # initial state\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 1500\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  return []", "env_interactions": 20, "island_id": 2, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:55:37.347025", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # make_arrow_v2: A* planner that uses recipe information to guide search\n  # ----------------------------------------------------------------------\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # --------------------------------------------------------------\n  # Identify the target item (\"arrow\") and its recipe information\n  # --------------------------------------------------------------\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Primitive requirements for a single arrow (primitive \u2192 count)\n  needed_prim = world.cookbook.primitives_for(target_idx)  # dict[int, int]\n\n  # Workshop index where the arrow must be crafted (if any)\n  recipe = world.cookbook.recipes.get(target_idx, {})\n  workshop_idx = recipe.get(\"_at\", None)\n\n  # --------------------------------------------------------------\n  # Initial state\n  # --------------------------------------------------------------\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  # --------------------------------------------------------------\n  # Helper utilities\n  # --------------------------------------------------------------\n  import heapq\n  from collections import namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\", \"g\"])\n\n  def _state_hash(st):\n      \"\"\"Hashable representation of a CraftState.\"\"\"\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  def _missing_primitives(st):\n      \"\"\"Return a dict primitive_idx \u2192 missing count for the current state.\"\"\"\n      miss = {}\n      for p_idx, need_cnt in needed_prim.items():\n          have = int(st.inventory[p_idx])\n          if have < need_cnt:\n              miss[p_idx] = need_cnt - have\n      return miss\n\n  def _manhattan(p1, p2):\n      return abs(p1[0] - p2[0]) + abs(p1[1] - p2[1])\n\n  def _heuristic(st):\n      \"\"\"\n      Estimate remaining steps:\n      - distance to the closest needed primitive (if any missing)\n      - otherwise distance to the nearest workshop for the final craft\n      \"\"\"\n      miss = _missing_primitives(st)\n      if miss:\n          # compute minimal Manhattan distance to any cell that currently holds a needed primitive\n          min_dist = None\n          for p_idx in miss:\n              # positions where this primitive is present (>0)\n              pos_arr = np.argwhere(st.grid[:, :, p_idx] > 0)\n              if pos_arr.size == 0:\n                  continue\n              dists = np.abs(pos_arr - np.array(st.pos)).sum(axis=1)\n              cur_min = int(dists.min())\n              if (min_dist is None) or (cur_min < min_dist):\n                  min_dist = cur_min\n          # If no cells contain the needed primitive (maybe already picked up), fallback to 0\n          return min_dist if min_dist is not None else 0\n      else:\n          # All primitives gathered; need to reach the workshop to craft the arrow\n          if workshop_idx is None:\n              return 0\n          pos_arr = np.argwhere(st.grid[:, :, workshop_idx] > 0)\n          if pos_arr.size == 0:\n              return 0\n          dists = np.abs(pos_arr - np.array(st.pos)).sum(axis=1)\n          return int(dists.min())\n\n  # --------------------------------------------------------------\n  # A* search\n  # --------------------------------------------------------------\n  n_actions = getattr(world, \"n_actions\", 5)\n  MAX_STEPS = 2000  # safety cap on plan length\n\n  start_node = Node(state=init_state, actions=[], g=0)\n  start_f = start_node.g + _heuristic(start_node.state)\n\n  frontier = [(start_f, start_node)]\n  heapq.heapify(frontier)\n\n  visited = {_state_hash(init_state)}\n\n  while frontier:\n      _, cur = heapq.heappop(frontier)\n      cur_state = cur.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return cur.actions\n\n      # Prune overly long trajectories\n      if cur.g >= MAX_STEPS:\n          continue\n\n      # Expand actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          hsh = _state_hash(nxt_state)\n          if hsh in visited:\n              continue\n          visited.add(hsh)\n          g2 = cur.g + 1\n          f2 = g2 + _heuristic(nxt_state)\n          nxt_node = Node(state=nxt_state, actions=cur.actions + [a], g=g2)\n          heapq.heappush(frontier, (f2, nxt_node))\n\n  # No feasible plan found within limits\n  return []", "env_interactions": 0, "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-10-28T23:56:05.727707", "function_name": "make_arrow", "function_body": "  # Resolve scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      # Hash includes position, direction, inventory contents and the whole grid layout\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 2000                     # safety bound on plan length\n  n_actions = getattr(world, \"n_actions\", 5)  # typically 5 actions (0\u20114)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long candidate plans\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No feasible plan found within limits\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:56:21.655861", "function_name": "make_arrow", "function_body": "  # Get scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 1500                     # safety bound on plan length\n  n_actions = getattr(world, \"n_actions\", 5)  # typically 5 actions (0\u20114)\n\n  # Prefer the USE action (index 4) before movement actions\n  action_order = [4] + [a for a in range(n_actions) if a != 4]\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long candidate plans\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand actions in the chosen order\n      for a in action_order:\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No feasible plan found within limits\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:56:51.239987", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the goal item \"arrow\" in the cookbook.\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initialise the starting state.\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      \"\"\"Hashable representation of a CraftState.\"\"\"\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 800                     # Upper bound on plan length.\n  n_actions = getattr(world, \"n_actions\", 5)   # Number of possible actions.\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory.\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long trajectories.\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions.\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within the search budget.\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:57:06.931374", "function_name": "make_arrow", "function_body": "  # Resolve the scenario and world objects.\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\" in the cookbook.\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initialise the starting state of the episode.\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  # BFS frontier and visited set.\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 800                     # Upper bound on plan length.\n  n_actions = getattr(world, \"n_actions\", 5)   # Number of possible actions.\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory.\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long trajectories.\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions.\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within the search budget.\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:57:39.294901", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_key(st):\n      return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())\n\n  visited = {_state_key(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 500\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          key = _state_key(nxt_state)\n          if key not in visited:\n              visited.add(key)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  return []", "env_interactions": 20, "island_id": 1, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:57:55.004031", "function_name": "make_arrow", "function_body": "  # Resolve scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_key(st):\n      \"\"\"Hashable representation of a CraftState.\"\"\"\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  # BFS frontier\n  visited = {_state_key(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  # Limits\n  MAX_PLAN_LENGTH = 800          # maximum actions examined in a plan\n  n_actions = getattr(world, \"n_actions\", 5)  # usually 5 (4 moves + USE)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have an arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long action sequences\n      if len(node.actions) >= MAX_PLAN_LENGTH:\n          continue\n\n      # Expand actions (try USE first as it often triggers crafting/pickup)\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key not in visited:\n              visited.add(key)\n              frontier.append(Node(next_state, node.actions + [a]))\n\n  # No plan found within limits\n  return []", "env_interactions": 20, "island_id": 1, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:58:23.077611", "function_name": "make_arrow", "function_body": "  # Resolve scenario and world objects from the provided environment\n  scenario = getattr(env, \"scenario\", None)\n  if scenario is None:\n      # In some wrappers the env itself may be the scenario\n      scenario = env\n  world = getattr(scenario, \"world\", None)\n  if world is None:\n      world = getattr(env, \"world\", None)\n  if world is None:\n      return []\n\n  # Identify the index of the target item (\"arrow\")\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initialise the starting CraftState\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  # Helper to produce a hashable representation of a state\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  # Bread\u2011first search over the state space to find a feasible plan\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n  frontier = deque([Node(init_state, [])])\n  visited = {_state_hash(init_state)}\n\n  # Depth limit to keep the search tractable\n  MAX_STEPS = 250\n\n  # Number of possible actions (default 5: DOWN, UP, LEFT, RIGHT, USE)\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state, cur_actions = node.state, node.actions\n\n      # Goal test: does inventory contain at least one arrow?\n      if cur_state.satisfies(\"\", target_idx):\n          return cur_actions\n\n      if len(cur_actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, cur_actions + [a]))\n\n  # No plan found within the depth limit\n  return []", "env_interactions": 20, "island_id": 3, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:58:37.929577", "function_name": "make_arrow", "function_body": "  # Resolve scenario and world objects, handling possible wrappers\n  scenario = getattr(env, \"scenario\", None)\n  if scenario is None:\n      scenario = env\n  world = getattr(scenario, \"world\", None)\n  if world is None:\n      world = getattr(env, \"world\", None)\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initialise the starting CraftState\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_key(st):\n      # Combine position, direction, inventory and grid into a hashable key\n      return (\n          st.pos,\n          st.dir,\n          st.inventory.tobytes(),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_key(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 300  # depth limit to keep search tractable\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state, cur_actions = node.state, node.actions\n\n      # Goal test: does inventory contain at least one arrow?\n      if cur_state.satisfies(\"\", target_idx):\n          return cur_actions\n\n      if len(cur_actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key not in visited:\n              visited.add(key)\n              frontier.append(Node(next_state, cur_actions + [a]))\n\n  # No plan found within the depth limit\n  return []", "env_interactions": 20, "island_id": 3, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:59:13.568941", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action constants (match CraftWorld's definition)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: move a position according to an action (assumes movement is legal)\n  # ------------------------------------------------------------------\n  def _move(pos, act):\n      x, y = pos\n      if act == RIGHT:\n          return (x + 1, y)\n      if act == LEFT:\n          return (x - 1, y)\n      if act == DOWN:\n          return (x, y + 1)\n      if act == UP:\n          return (x, y - 1)\n      return pos\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that finds a path (list of actions) from start to any cell\n  # that is orthogonally adjacent to one of the target cells.\n  # ------------------------------------------------------------------\n  def _bfs_adjacent(start, targets, occupied):\n      w, h = occupied.shape\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # check adjacency to any target\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path, (x, y)\n          # expand neighbours\n          for act, (dx, dy) in ((RIGHT, (1, 0)), (LEFT, (-1, 0)),\n                                (DOWN, (0, 1)), (UP, (0, -1))):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and not occupied[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # no reachable adjacent cell\n      return [], start\n\n  # ------------------------------------------------------------------\n  # Retrieve the underlying CraftWorld and Cookbook objects from the env\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # CraftLab wraps the state; try to fetch from there\n      cur_state = getattr(env, \"_current_state\", None)\n      if cur_state is not None:\n          world = getattr(cur_state, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"Could not locate CraftWorld instance in the environment.\")\n  cookbook = world.cookbook\n\n  # ------------------------------------------------------------------\n  # Ensure the environment has been reset and obtain the current state\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  # ------------------------------------------------------------------\n  # Basic situation information\n  # ------------------------------------------------------------------\n  pos = tuple(state.pos)          # (x, y)\n  direction = int(state.dir)      # current facing direction\n  grid = state.grid                # (W, H, n_kinds)\n\n  # Work on a mutable copy so we can mark collected primitives as empty\n  mutable_grid = np.copy(grid)\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Goal: craft an \"arrow\"\n  # ------------------------------------------------------------------\n  goal_idx = cookbook.index[\"arrow\"]\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      gathered = 0\n      while gathered < needed_cnt:\n          # locate remaining instances of this primitive\n          locs = [tuple(p) for p in np.argwhere(mutable_grid[:, :, prim_idx] > 0)]\n          if not locs:\n              # no more of this primitive on the map \u2013 abort\n              break\n\n          # choose the closest one (Manhattan distance)\n          locs.sort(key=lambda lc: abs(lc[0] - pos[0]) + abs(lc[1] - pos[1]))\n          target = locs[0]\n\n          # cells occupied by any entity (including the target)\n          occupied = np.any(mutable_grid > 0, axis=2)\n\n          # find path to a free cell adjacent to the target\n          path, new_pos = _bfs_adjacent(pos, [target], occupied)\n          actions.extend(path)\n\n          # simulate movement to keep pos/direction up\u2011to\u2011date\n          for act in path:\n              pos = _move(pos, act)\n              direction = act\n\n          # determine direction needed to face the target\n          tx, ty = target\n          needed_dir = None\n          if tx > pos[0]:\n              needed_dir = RIGHT\n          elif tx < pos[0]:\n              needed_dir = LEFT\n          elif ty > pos[1]:\n              needed_dir = DOWN\n          elif ty < pos[1]:\n              needed_dir = UP\n\n          # turn if necessary\n          if needed_dir is not None and direction != needed_dir:\n              actions.append(needed_dir)\n              direction = needed_dir\n\n          # pick up the primitive\n          actions.append(USE)\n          gathered += 1\n\n          # mark the primitive as collected\n          mutable_grid[tx, ty, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # resolve workshop index (could be a string name)\n      workshop_idx = (cookbook.index[workshop_key]\n                      if isinstance(workshop_key, str)\n                      else workshop_key)\n\n      # locate workshop cells (they are static, use original grid)\n      ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if ws_cells:\n          ws_cells.sort(key=lambda lc: abs(lc[0] - pos[0]) + abs(lc[1] - pos[1]))\n          ws_target = ws_cells[0]\n\n          occupied = np.any(mutable_grid > 0, axis=2)\n          path, new_pos = _bfs_adjacent(pos, [ws_target], occupied)\n          actions.extend(path)\n\n          for act in path:\n              pos = _move(pos, act)\n              direction = act\n\n          # ensure we are facing the workshop before using\n          wx, wy = ws_target\n          needed_dir = None\n          if wx > pos[0]:\n              needed_dir = RIGHT\n          elif wx < pos[0]:\n              needed_dir = LEFT\n          elif wy > pos[1]:\n              needed_dir = DOWN\n          elif wy < pos[1]:\n              needed_dir = UP\n\n          if needed_dir is not None and direction != needed_dir:\n              actions.append(needed_dir)\n              direction = needed_dir\n\n          # craft the arrow\n          actions.append(USE)\n\n  # ------------------------------------------------------------------\n  # Return the compiled action sequence\n  # ------------------------------------------------------------------\n  return actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T23:59:14.741258", "function_name": "make_arrow", "function_body": "  # Action constants (match CraftWorld's definition)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions leading from `start` to a\n  # cell adjacent (Manhattan distance \u2264 1) to any of `targets`.  The search\n  # avoids cells that are occupied in `grid` (any non\u2011zero kind blocks\n  # movement).  Returns (actions, final_position).\n  # ------------------------------------------------------------------\n  def _bfs_path(start, targets, grid):\n      width, height, _ = grid.shape\n      occupied = np.any(grid > 0, axis=2)          # blocked cells\n      from collections import deque\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # If we are adjacent (or on) a target, stop.\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) <= 1:\n                  return path, (x, y)\n          # Expand neighbours.\n          for dx, dy, act in [(1, 0, RIGHT), (-1, 0, LEFT),\n                              (0, 1, DOWN), (0, -1, UP)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # No reachable path.\n      return [], start\n\n  # ------------------------------------------------------------------\n  # Retrieve the underlying CraftWorld and its Cookbook.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Some wrappers (e.g., CraftLab) expose the world via the current state.\n      cur_state = getattr(env, \"_current_state\", None)\n      if cur_state is not None:\n          world = getattr(cur_state, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"Unable to locate CraftWorld instance in env\")\n  cookbook = world.cookbook\n\n  # ------------------------------------------------------------------\n  # Ensure we have a fresh state (reset if necessary).\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  # Current position, direction and mutable copy of the grid.\n  pos = tuple(state.pos)          # (x, y)\n  mutable_grid = state.grid.copy()  # (W, H, n_kinds)\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Goal: craft an \"arrow\".\n  # ------------------------------------------------------------------\n  goal_idx = cookbook.index[\"arrow\"]\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive.\n  # ------------------------------------------------------------------\n  for prim_idx, required_cnt in primitives_needed.items():\n      collected = 0\n      while collected < required_cnt:\n          # Locate remaining instances of this primitive.\n          locations = [tuple(p) for p in np.argwhere(mutable_grid[:, :, prim_idx] > 0)]\n          if not locations:\n              # No more of this primitive on the map \u2013 break out.\n              break\n          # Choose the closest instance (Manhattan distance).\n          locations.sort(key=lambda loc: abs(loc[0] - pos[0]) + abs(loc[1] - pos[1]))\n          target = locations[0]\n\n          # Find a path to a free cell adjacent to the target.\n          path, new_pos = _bfs_path(pos, [target], mutable_grid)\n          actions.extend(path)\n\n          # Simulate movement to keep `pos` up\u2011to\u2011date.\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n\n          # Pick up the primitive.\n          actions.append(USE)\n          collected += 1\n\n          # Mark the cell as empty for subsequent path\u2011finding.\n          mutable_grid[target[0], target[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (may be a string name).\n      workshop_idx = cookbook.index[workshop_key] if isinstance(workshop_key, str) else workshop_key\n      # Locate workshop cells (they are static in the original grid).\n      workshop_cells = [tuple(p) for p in np.argwhere(state.grid[:, :, workshop_idx] > 0)]\n      if workshop_cells:\n          # Choose the nearest workshop.\n          workshop_cells.sort(key=lambda loc: abs(loc[0] - pos[0]) + abs(loc[1] - pos[1]))\n          ws_target = workshop_cells[0]\n\n          # Path to a free cell adjacent to the workshop.\n          path, new_pos = _bfs_path(pos, [ws_target], mutable_grid)\n          actions.extend(path)\n\n          # Update position after moving.\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n\n          # Use the workshop to craft the arrow.\n          actions.append(USE)\n\n  # ------------------------------------------------------------------\n  # Return the assembled action sequence.\n  # ------------------------------------------------------------------\n  return actions", "env_interactions": 21, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T23:59:39.722084", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initialise the starting CraftState\n  try:\n      start_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      # Combine position, direction, inventory and grid layout into a hashable key\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(start_state)}\n  frontier = deque([Node(start_state, [])])\n\n  MAX_STEPS = 300\n  n_actions = getattr(world, \"n_actions\", 5)  # typical actions: 0\u20114\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: does the inventory contain an arrow?\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Depth limit\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand neighbours\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within the depth limit\n  return []", "env_interactions": 20, "island_id": 7, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:59:55.471879", "function_name": "make_arrow", "function_body": "  # Resolve scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Determine the index for the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initialise the starting state of the episode\n  try:\n      start_state = scenario.init()\n  except Exception:\n      return []\n\n  # Helper to create a hashable representation of a state\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  # Bread\u2011first search over the state space\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n  visited = {_state_hash(start_state)}\n  frontier = deque([Node(start_state, [])])\n\n  # Search parameters\n  MAX_STEPS = 400                     # generous depth limit\n  n_actions = getattr(world, \"n_actions\", 5)   # default action count\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: does the inventory contain at least one arrow?\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Depth pruning\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # If no plan found within limits, return empty list\n  return []", "env_interactions": 20, "island_id": 7, "scores": {"3": 2.9}}
{"timestamp": "2025-10-29T00:00:27.064936", "function_name": "make_arrow", "function_body": "  # constants\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  MOVE_DELTAS = {DOWN: (0, 1), UP: (0, -1), LEFT: (-1, 0), RIGHT: (1, 0)}\n\n  # helper: BFS to a cell adjacent to any target cell\n  from collections import deque\n  def _bfs_adjacent(start, targets, occupied):\n      w, h = occupied.shape\n      target_set = set(targets)\n      # already adjacent?\n      for tx, ty in target_set:\n          if abs(start[0] - tx) + abs(start[1] - ty) == 1:\n              return []\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      while q:\n          x, y, path = q.popleft()\n          for act, (dx, dy) in MOVE_DELTAS.items():\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < w and 0 <= ny < h):\n                  continue\n              if (nx, ny) in visited or occupied[nx, ny]:\n                  continue\n              new_path = path + [act]\n              # check adjacency to any target\n              for tx, ty in target_set:\n                  if abs(nx - tx) + abs(ny - ty) == 1:\n                      return new_path\n              visited.add((nx, ny))\n              q.append((nx, ny, new_path))\n      return []  # unreachable\n\n  # ------------------------------------------------------------------\n  # obtain world, state, cookbook\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # env is a CraftLab wrapper\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n      world = state.world\n  else:\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n\n  cookbook = world.cookbook\n  goal_idx = cookbook.index[\"arrow\"]\n  primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n  if not primitives_needed:\n      # arrow itself is primitive; just use current cell\n      return [USE]\n\n  grid = state.grid                # (W, H, n_kinds)\n  pos = tuple(state.pos)           # (x, y)\n  occupied = np.any(grid > 0, axis=2)   # True where any entity exists\n\n  actions = []\n  harvested = set()   # locations already collected\n\n  # ------------------------------------------------------------------\n  # collect required primitives (greedy nearest first)\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      collected = 0\n      while collected < needed:\n          # find remaining instances of this primitive\n          candidates = [\n              tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)\n              if tuple(p) not in harvested\n          ]\n          if not candidates:\n              # nothing left \u2013 give up\n              break\n          # choose closest\n          candidates.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          target = candidates[0]\n\n          # move adjacent to target\n          path = _bfs_adjacent(pos, [target], occupied)\n          actions.extend(path)\n          for a in path:\n              dx, dy = MOVE_DELTAS[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # pick up\n          actions.append(USE)\n          harvested.add(target)\n          collected += 1\n          occupied[target] = False\n\n  # ------------------------------------------------------------------\n  # craft at required workshop (if any)\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # resolve index (could be string)\n      workshop_idx = (\n          cookbook.index[workshop_key]\n          if isinstance(workshop_key, str) else workshop_key\n      )\n      workshop_cells = [\n          tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)\n      ]\n      if workshop_cells:\n          workshop_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          ws_target = workshop_cells[0]\n          path = _bfs_adjacent(pos, [ws_target], occupied)\n          actions.extend(path)\n          for a in path:\n              dx, dy = MOVE_DELTAS[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(USE)   # craft\n      else:\n          # no workshop found, just try to craft in place\n          actions.append(USE)\n  else:\n      # no specific workshop required\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-10-29T00:00:28.216830", "function_name": "make_arrow", "function_body": "  # Action constants and move deltas\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  MOVE_DELTAS = {\n      DOWN: (0, 1),\n      UP: (0, -1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  import numpy as np\n  from collections import deque\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving the agent from\n  # `start` to a cell adjacent (Manhattan distance = 1) to any cell in\n  # `targets`.  Cells occupied by any entity are treated as blocked.\n  # ------------------------------------------------------------------\n  def _bfs_adjacent(start, targets, occupied):\n      w, h = occupied.shape\n      target_set = set(targets)\n\n      # Already adjacent?\n      for tx, ty in target_set:\n          if abs(start[0] - tx) + abs(start[1] - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n\n      while q:\n          x, y, path = q.popleft()\n          for act, (dx, dy) in MOVE_DELTAS.items():\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < w and 0 <= ny < h):\n                  continue\n              if (nx, ny) in visited or occupied[nx, ny]:\n                  continue\n              new_path = path + [act]\n              for tx, ty in target_set:\n                  if abs(nx - tx) + abs(ny - ty) == 1:\n                      return new_path\n              visited.add((nx, ny))\n              q.append((nx, ny, new_path))\n      return []  # unreachable\n\n  # ------------------------------------------------------------------\n  # Retrieve world, state and cookbook from the environment.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n      world = state.world\n  else:\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n\n  cookbook = world.cookbook\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # ------------------------------------------------------------------\n  # Primitive requirements for a single arrow.\n  # ------------------------------------------------------------------\n  primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n  if not primitives_needed:\n      # Arrow itself is a primitive \u2013 just use current cell.\n      return [USE]\n\n  # ------------------------------------------------------------------\n  # Current grid, agent position and occupancy mask.\n  # ------------------------------------------------------------------\n  grid = state.grid                     # (W, H, n_kinds)\n  pos = tuple(state.pos)                # (x, y)\n  occupied = np.any(grid > 0, axis=2)   # True where any entity exists\n\n  actions = []\n  harvested = set()                     # locations already collected from\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first).\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      gathered = 0\n      while gathered < needed_cnt:\n          # Locate remaining instances of this primitive.\n          candidates = [\n              tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)\n              if tuple(p) not in harvested\n          ]\n          if not candidates:\n              # No more of this primitive on the map \u2013 abort early.\n              break\n\n          # Choose the closest candidate (Manhattan distance).\n          candidates.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          target = candidates[0]\n\n          # Plan path to a cell adjacent to the primitive.\n          path = _bfs_adjacent(pos, [target], occupied)\n          actions.extend(path)\n\n          # Simulate movement.\n          for a in path:\n              dx, dy = MOVE_DELTAS[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Pick up the primitive.\n          actions.append(USE)\n          harvested.add(target)\n          gathered += 1\n\n          # Update occupancy mask (cell becomes empty after pickup).\n          occupied[target] = False\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (may be a name string).\n      workshop_idx = (\n          cookbook.index[workshop_key]\n          if isinstance(workshop_key, str) else workshop_key\n      )\n      # Find all workshop cells of the required type.\n      workshop_cells = [\n          tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)\n      ]\n      if workshop_cells:\n          # Move to the nearest workshop.\n          workshop_cells.sort(\n              key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1])\n          )\n          ws_target = workshop_cells[0]\n          path = _bfs_adjacent(pos, [ws_target], occupied)\n          actions.extend(path)\n          for a in path:\n              dx, dy = MOVE_DELTAS[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(USE)  # craft at workshop\n      else:\n          # No workshop found \u2013 fallback to using current cell.\n          actions.append(USE)\n  else:\n      # No specific workshop required.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-10-29T00:00:50.459218", "function_name": "make_arrow", "function_body": "  # Action constants (match CraftWorld default ordering)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  MOVE_DELTAS = {\n      DOWN: (0, 1),\n      UP: (0, -1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving the agent from\n  # `start` to a cell adjacent (Manhattan distance = 1) to any cell in\n  # `targets`.  Cells occupied by any entity are treated as blocked.\n  # ------------------------------------------------------------------\n  def _bfs_adjacent(start, targets, occupied):\n      width, height = occupied.shape\n      target_set = set(targets)\n\n      # Already adjacent?\n      for tx, ty in target_set:\n          if abs(start[0] - tx) + abs(start[1] - ty) == 1:\n              return []\n\n      from collections import deque\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n\n      while q:\n          x, y, path = q.popleft()\n          for act, (dx, dy) in MOVE_DELTAS.items():\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              if occupied[nx, ny]:\n                  continue\n              visited.add((nx, ny))\n              new_path = path + [act]\n              for tx, ty in target_set:\n                  if abs(nx - tx) + abs(ny - ty) == 1:\n                      return new_path\n              q.append((nx, ny, new_path))\n      return []  # unreachable\n\n  # ------------------------------------------------------------------\n  # Retrieve world, state and cookbook from the environment.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n      world = state.world\n  else:\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n\n  cookbook = world.cookbook\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # ------------------------------------------------------------------\n  # Determine primitive requirements for one arrow.\n  # ------------------------------------------------------------------\n  primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n  if not primitives_needed:\n      # Arrow is a primitive; just use current cell.\n      return [USE]\n\n  # ------------------------------------------------------------------\n  # Current grid, position and occupancy mask.\n  # ------------------------------------------------------------------\n  grid = state.grid                     # (W, H, n_kinds)\n  pos = tuple(state.pos)                # (x, y)\n  occupied = np.any(grid > 0, axis=2)   # True where any entity exists\n\n  actions = []\n  harvested = set()                     # locations already collected from\n\n  # ------------------------------------------------------------------\n  # Adjust for primitives already present in inventory.\n  # ------------------------------------------------------------------\n  inv = state.inventory\n  for prim_idx, need in list(primitives_needed.items()):\n      have = int(inv[prim_idx]) if inv is not None else 0\n      if have >= need:\n          primitives_needed.pop(prim_idx)\n      else:\n          primitives_needed[prim_idx] = need - have\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (nearest\u2011first).\n  # ------------------------------------------------------------------\n  for prim_idx, need_cnt in primitives_needed.items():\n      gathered = 0\n      while gathered < need_cnt:\n          # Locate remaining instances of this primitive not yet harvested.\n          candidates = [\n              tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)\n              if tuple(p) not in harvested\n          ]\n          if not candidates:\n              # No more of this primitive on the map; abort early.\n              break\n\n          # Choose the closest candidate (Manhattan distance).\n          candidates.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          target = candidates[0]\n\n          # Plan path to a cell adjacent to the primitive.\n          path = _bfs_adjacent(pos, [target], occupied)\n          actions.extend(path)\n\n          # Simulate movement.\n          for a in path:\n              dx, dy = MOVE_DELTAS[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Pick up the primitive.\n          actions.append(USE)\n          harvested.add(target)\n          gathered += 1\n\n          # Update occupancy mask (cell becomes empty after pickup).\n          occupied[target] = False\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (may be a name string or int).\n      workshop_idx = (\n          cookbook.index[workshop_key]\n          if isinstance(workshop_key, str) else workshop_key\n      )\n      # Find all workshop cells of the required type.\n      workshop_cells = [\n          tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)\n      ]\n      if workshop_cells:\n          # Move to the nearest workshop.\n          workshop_cells.sort(\n              key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1])\n          )\n          ws_target = workshop_cells[0]\n          path = _bfs_adjacent(pos, [ws_target], occupied)\n          actions.extend(path)\n          for a in path:\n              dx, dy = MOVE_DELTAS[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(USE)  # craft at workshop\n      else:\n          # No workshop found \u2013 fallback to using current cell.\n          actions.append(USE)\n  else:\n      # No specific workshop required.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-10-29T00:00:51.610625", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Action identifiers \u2013 match the default CraftWorld ordering.\n  # ----------------------------------------------------------------------\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  MOVE_DELTAS = {\n      DOWN: (0, 1),\n      UP: (0, -1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving the agent from\n  # `start` to a cell adjacent (Manhattan distance = 1) to any cell in\n  # `targets`.  Any occupied cell is treated as blocked.\n  # ----------------------------------------------------------------------\n  def _bfs_adjacent(start, targets, occupied):\n      from collections import deque\n\n      width, height = occupied.shape\n      target_set = set(targets)\n\n      # Already adjacent?\n      for tx, ty in target_set:\n          if abs(start[0] - tx) + abs(start[1] - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n\n      while q:\n          x, y, path = q.popleft()\n          for act, (dx, dy) in MOVE_DELTAS.items():\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              if occupied[nx, ny]:\n                  continue\n              visited.add((nx, ny))\n              new_path = path + [act]\n              # Check adjacency after this move\n              for tx, ty in target_set:\n                  if abs(nx - tx) + abs(ny - ty) == 1:\n                      return new_path\n              q.append((nx, ny, new_path))\n      # No reachable adjacent cell\n      return []\n\n  # ----------------------------------------------------------------------\n  # Retrieve world and current state from the environment.\n  # ----------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n      world = state.world\n  else:\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n\n  cookbook = world.cookbook\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # ----------------------------------------------------------------------\n  # Primitive requirements for a single arrow.\n  # ----------------------------------------------------------------------\n  primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n  if not primitives_needed:\n      # Arrow itself is a primitive \u2013 just use the current cell.\n      return [USE]\n\n  # ----------------------------------------------------------------------\n  # Current grid, position and occupancy mask.\n  # ----------------------------------------------------------------------\n  grid = state.grid                     # (W, H, n_kinds)\n  pos = tuple(state.pos)                # (x, y)\n  occupied = np.any(grid > 0, axis=2)   # True where any entity exists\n\n  actions = []\n  harvested = set()                     # Locations already collected from\n\n  # ----------------------------------------------------------------------\n  # Account for primitives already present in the inventory.\n  # ----------------------------------------------------------------------\n  inv = state.inventory\n  for prim_idx, need in list(primitives_needed.items()):\n      have = int(inv[prim_idx]) if inv is not None else 0\n      if have >= need:\n          primitives_needed.pop(prim_idx)\n      else:\n          primitives_needed[prim_idx] = need - have\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first).\n  # ----------------------------------------------------------------------\n  for prim_idx, need_cnt in primitives_needed.items():\n      gathered = 0\n      while gathered < need_cnt:\n          # Find all remaining instances of this primitive not yet harvested.\n          candidates = [\n              tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)\n              if tuple(p) not in harvested\n          ]\n          if not candidates:\n              # No more of this primitive on the map \u2013 stop trying.\n              break\n\n          # Choose the closest candidate (Manhattan distance).\n          candidates.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          target = candidates[0]\n\n          # Plan a path to a cell adjacent to the primitive.\n          path = _bfs_adjacent(pos, [target], occupied)\n          actions.extend(path)\n\n          # Simulate movement to keep `pos` up\u2011to\u2011date.\n          for a in path:\n              dx, dy = MOVE_DELTAS[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Pick up the primitive.\n          actions.append(USE)\n          harvested.add(target)\n          gathered += 1\n\n          # Update occupancy: the cell becomes empty after pickup.\n          occupied[target] = False\n\n  # ----------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any).\n  # ----------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (may be a name string or integer).\n      workshop_idx = (\n          cookbook.index[workshop_key]\n          if isinstance(workshop_key, str) else workshop_key\n      )\n      # Locate all workshop cells of the required type.\n      workshop_cells = [\n          tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)\n      ]\n      if workshop_cells:\n          # Move to the nearest workshop.\n          workshop_cells.sort(\n              key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1])\n          )\n          ws_target = workshop_cells[0]\n          path = _bfs_adjacent(pos, [ws_target], occupied)\n          actions.extend(path)\n          for a in path:\n              dx, dy = MOVE_DELTAS[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(USE)  # craft at workshop\n      else:\n          # No workshop found \u2013 fallback to using current cell.\n          actions.append(USE)\n  else:\n      # No specific workshop required.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 0, "scores": {"3": 0.5}}
