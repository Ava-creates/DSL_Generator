{"timestamp": "2025-10-28T15:17:46.057739", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # Action indices as defined in the environment\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Helper to move from one cell to another using Manhattan moves\n  def _move(cur, target, act_list):\n      x, y = cur\n      tx, ty = target\n      # move in x direction\n      while x < tx:\n          act_list.append(RIGHT)\n          x += 1\n      while x > tx:\n          act_list.append(LEFT)\n          x -= 1\n      # move in y direction\n      while y < ty:\n          act_list.append(DOWN)\n          y += 1\n      while y > ty:\n          act_list.append(UP)\n          y -= 1\n      return (x, y)\n\n  # Access world and current state\n  world = env.world\n  state = env._current_state\n\n  # Identify the index of the goal item (arrow)\n  try:\n      goal_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      # fallback to the goal stored in the task, if available\n      goal_idx = getattr(getattr(env, \"task\", None), \"goal\", None)\n      if goal_idx is None:\n          raise RuntimeError(\"Could not determine goal index for arrow.\")\n\n  # Determine which primitive resources are needed for the arrow\n  primitive_requirements = world.cookbook.primitives_for(goal_idx)\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # Collect each required primitive\n  for prim_idx, needed in primitive_requirements.items():\n      # Find at least one cell that contains this primitive\n      locations = np.argwhere(state.grid[:, :, prim_idx] > 0)\n      if locations.size == 0:\n          # Primitive not present \u2013 cannot craft, skip\n          continue\n      target = tuple(locations[0])\n      cur_pos = _move(cur_pos, target, actions)\n      # Pick up the required amount (use action once per unit)\n      for _ in range(needed):\n          actions.append(USE)\n\n  # Finally move to the workshop where the arrow can be crafted\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_key\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.get(workshop_name)\n      if workshop_idx is not None:\n          ws_locs = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n          if ws_locs.size > 0:\n              workshop_pos = tuple(ws_locs[0])\n              cur_pos = _move(cur_pos, workshop_pos, actions)\n              actions.append(USE)  # craft the arrow\n\n  return actions", "env_interactions": 20, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T15:17:47.173231", "function_name": "make_arrow", "function_body": "  # Reset the environment to start a new episode\n  env.reset()\n  actions = []\n\n  # Determine a reasonable step limit (fallback to 1000 if not defined)\n  max_steps = getattr(env, \"max_steps\", 1000)\n\n  # Main loop: keep acting until the task is completed or we hit the step limit\n  while len(actions) < max_steps:\n      # First try the USE action (index 4) which handles both collection and crafting\n      actions.append(4)  # USE\n      reward, done, _ = env.step(4)\n      if done:\n          break\n\n      # Obtain the current state to decide a simple exploration move\n      state = env._current_state\n      x, y = state.pos\n      width, height = state.grid.shape[0], state.grid.shape[1]\n\n      # Simple deterministic movement: head towards the centre of the map\n      # Choose horizontal direction\n      if x < width // 2:\n          move = 3  # RIGHT\n      else:\n          move = 2  # LEFT\n\n      actions.append(move)\n      reward, done, _ = env.step(move)\n      if done:\n          break\n\n      # Choose vertical direction on the next iteration\n      # (alternating moves helps cover the area without getting stuck)\n      if y < height // 2:\n          move = 0  # DOWN\n      else:\n          move = 1  # UP\n\n      actions.append(move)\n      reward, done, _ = env.step(move)\n      if done:\n          break\n\n  return actions", "env_interactions": 0, "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-10-28T15:18:19.743402", "function_name": "make_arrow", "function_body": "  # Locate scenario and world objects\n  try:\n      scenario = env.scenario\n  except Exception:\n      scenario = getattr(env, \"scenario\", None)\n  if scenario is None:\n      # In some wrappers the env itself may be the scenario\n      scenario = env\n  world = getattr(scenario, \"world\", None)\n  if world is None:\n      world = getattr(env, \"world\", None)\n\n  # Identify the index of the target item (\"arrow\")\n  try:\n      arrow_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initialise the starting CraftState\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  # Bread\u2011first search over state space to find a plan\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      # Combine position, direction, inventory and grid layout into a hashable key\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = set()\n  frontier = deque()\n  frontier.append(Node(init_state, []))\n  visited.add(_state_hash(init_state))\n\n  # Limit search depth to avoid infinite loops\n  MAX_STEPS = 200\n\n  # Number of possible actions (standard: 0\u20114)\n  try:\n      n_actions = world.n_actions\n  except Exception:\n      n_actions = 5\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test\n      if cur_state.satisfies(\"\", arrow_idx):\n          return node.actions\n\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand neighbours\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # If no plan found within the depth limit, return an empty list\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
