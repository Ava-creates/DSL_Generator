{"timestamp": "2025-10-28T20:16:51.714768", "function_name": "make_arrow", "function_body": "  # Reset environment and fetch current state and world information\n  env.reset()\n  state = env._current_state          # CraftState instance\n  world = env.world                    # CraftWorld instance\n  grid = state.grid.copy()             # (WIDTH, HEIGHT, n_kinds)\n\n  # Action indices from the environment's spec\n  specs = env.action_specs()\n  DOWN = specs[\"DOWN\"]\n  UP = specs[\"UP\"]\n  LEFT = specs[\"LEFT\"]\n  RIGHT = specs[\"RIGHT\"]\n  USE = specs[\"USE\"]\n\n  # Directions with corresponding action indices\n  DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]\n\n  def in_bounds(y, x):\n      \"\"\"Check if (y, x) lies within the grid bounds.\"\"\"\n      return 0 <= y < grid.shape[0] and 0 <= x < grid.shape[1]\n\n  def is_blocked(y, x):\n      \"\"\"A cell is blocked if any kind occupies it.\"\"\"\n      return grid[y, x].any()\n\n  def bfs_path(start, goal):\n      \"\"\"Bread\u2011first search returning a list of actions from start to goal.\n      Both start and goal are (y, x) tuples. Goal must be a free cell.\"\"\"\n      if start == goal:\n          return []\n      from collections import deque\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          y, x = q.popleft()\n          if (y, x) == goal:\n              # reconstruct actions\n              rev = []\n              cur = goal\n              while cur != start:\n                  py, px = parent[cur]\n                  if cur[0] == py + 1:\n                      rev.append(DOWN)\n                  elif cur[0] == py - 1:\n                      rev.append(UP)\n                  elif cur[1] == px + 1:\n                      rev.append(RIGHT)\n                  elif cur[1] == px - 1:\n                      rev.append(LEFT)\n                  cur = (py, px)\n              return list(reversed(rev))\n          for dy, dx, _ in DIRS:\n              ny, nx = y + dy, x + dx\n              if not in_bounds(ny, nx):\n                  continue\n              if (ny, nx) in visited:\n                  continue\n              if is_blocked(ny, nx):\n                  continue\n              visited.add((ny, nx))\n              parent[(ny, nx)] = (y, x)\n              q.append((ny, nx))\n      # No path found \u2013 return empty list\n      return []\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Return coordinates of the nearest cell containing the given kind.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[dists.argmin()]\n      return tuple(nearest)\n\n  def adjacent_free(cell, avoid=set()):\n      \"\"\"Find a free orthogonal neighbor of `cell` not in `avoid`.\"\"\"\n      y, x = cell\n      for dy, dx, _ in DIRS:\n          ny, nx = y + dy, x + dx\n          if not in_bounds(ny, nx):\n              continue\n          if (ny, nx) in avoid:\n              continue\n          if not is_blocked(ny, nx):\n              return (ny, nx)\n      return None\n\n  # ------------------------------------------------------------------\n  # Determine the goal (arrow) index and its primitive requirements.\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  needed = world.cookbook.primitives_for(arrow_idx)   # {primitive_idx: count}\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  workshop_idx = None\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n\n  actions = []\n  cur_pos = state.pos                # current agent position (y, x)\n  collected_cells = set()            # remember cells we have already cleared\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the needed number of times.\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive not present \u2013 abort early.\n              return actions\n          # Choose a free adjacent cell to stand on before using.\n          adj = adjacent_free(target, avoid=collected_cells)\n          if adj is None:\n              # No free neighbor; fall back to standing on the primitive cell\n              # (only possible if the cell itself becomes free after previous pickups).\n              adj = target\n              if is_blocked(*adj):\n                  return actions\n          # Move to the adjacent cell.\n          actions += bfs_path(cur_pos, adj)\n          cur_pos = adj\n          # Face the primitive (direction change without movement).\n          dy = target[0] - cur_pos[0]\n          dx = target[1] - cur_pos[1]\n          if dy > 0:\n              actions.append(DOWN)\n          elif dy < 0:\n              actions.append(UP)\n          elif dx > 0:\n              actions.append(RIGHT)\n          elif dx < 0:\n              actions.append(LEFT)\n          # Pick up the primitive.\n          actions.append(USE)\n          # Update grid to reflect that the primitive has been collected.\n          grid[target[0], target[1], prim_idx] = 0\n          collected_cells.add(target)\n\n  # ------------------------------------------------------------------\n  # Move to the appropriate workshop (if any) and craft the arrow.\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          ws_adj = adjacent_free(ws_cell, avoid=collected_cells)\n          if ws_adj is None:\n              ws_adj = ws_cell\n              if is_blocked(*ws_adj):\n                  # Cannot reach workshop; abort.\n                  return actions\n          actions += bfs_path(cur_pos, ws_adj)\n          cur_pos = ws_adj\n          # Face the workshop cell.\n          dy = ws_cell[0] - cur_pos[0]\n          dx = ws_cell[1] - cur_pos[1]\n          if dy > 0:\n              actions.append(DOWN)\n          elif dy < 0:\n              actions.append(UP)\n          elif dx > 0:\n              actions.append(RIGHT)\n          elif dx < 0:\n              actions.append(LEFT)\n\n  # Finally, trigger the crafting action.\n  actions.append(USE)\n\n  return actions", "env_interactions": 37, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T20:16:52.851996", "function_name": "make_arrow", "function_body": "  # Reset environment and get initial state information\n  env.reset()\n  state = env._current_state          # CraftState instance\n  world = env.world                    # CraftWorld instance\n  grid = state.grid.copy()             # Working copy for planning\n\n  # Action indices from the environment specification\n  specs = env.action_specs()\n  DOWN = specs[\"DOWN\"]\n  UP = specs[\"UP\"]\n  LEFT = specs[\"LEFT\"]\n  RIGHT = specs[\"RIGHT\"]\n  USE = specs[\"USE\"]\n\n  # ------------------------------------------------------------------\n  # Helper functions\n  # ------------------------------------------------------------------\n  height, width, _ = grid.shape\n\n  def in_bounds(y, x):\n      return 0 <= y < height and 0 <= x < width\n\n  def is_blocked(y, x):\n      \"\"\"A cell is blocked if any entity occupies it.\"\"\"\n      return grid[y, x].any()\n\n  # Directions with corresponding action indices\n  DIRS = [\n      (1, 0, DOWN),   # down\n      (-1, 0, UP),    # up\n      (0, -1, LEFT),  # left\n      (0, 1, RIGHT),  # right\n  ]\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that\n      moves the agent from start to goal avoiding blocked cells.\"\"\"\n      if start == goal:\n          return []\n      from collections import deque\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          y, x = q.popleft()\n          if (y, x) == goal:\n              # reconstruct path\n              rev = []\n              cur = goal\n              while cur != start:\n                  py, px = parent[cur]\n                  for dy, dx, act in DIRS:\n                      if cur[0] == py + dy and cur[1] == px + dx:\n                          rev.append(act)\n                          break\n                  cur = (py, px)\n              return list(reversed(rev))\n          for dy, dx, act in DIRS:\n              ny, nx = y + dy, x + dx\n              if not in_bounds(ny, nx):\n                  continue\n              if (ny, nx) in visited:\n                  continue\n              if is_blocked(ny, nx):\n                  continue\n              visited.add((ny, nx))\n              parent[(ny, nx)] = (y, x)\n              q.append((ny, nx))\n      # No path found \u2013 return empty list (caller may handle)\n      return []\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Locate the nearest cell containing the given kind.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[dists.argmin()]\n      return tuple(nearest)\n\n  def adjacent_free(cell, avoid=set()):\n      \"\"\"Return a free (non\u2011blocked) cell adjacent to `cell`.\n      `avoid` is a set of positions that should not be used (e.g., already\n      collected primitive locations).\"\"\"\n      y, x = cell\n      for dy, dx, _ in DIRS:\n          ny, nx = y + dy, x + dx\n          if not in_bounds(ny, nx):\n              continue\n          if (ny, nx) in avoid:\n              continue\n          if not is_blocked(ny, nx):\n              return (ny, nx)\n      return None\n\n  # ------------------------------------------------------------------\n  # Determine goal index and required primitives\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  needed_prims = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  workshop_idx = None\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n\n  actions = []\n  cur_pos = state.pos\n  collected_positions = set()   # to avoid standing on a just\u2011collected cell\n\n  # ------------------------------------------------------------------\n  # Collect all required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, qty in needed_prims.items():\n      for _ in range(qty):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive missing \u2013 abort planning\n              return actions\n          # Choose a free adjacent cell to stand on\n          adj = adjacent_free(target, avoid=collected_positions)\n          if adj is None:\n              # No free adjacent cell; fall back to standing on the cell itself\n              adj = target\n          # Move to the chosen adjacent cell\n          actions += bfs_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the target cell (move action that will be blocked)\n          dy = target[0] - cur_pos[0]\n          dx = target[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update planning grid: primitive removed\n          grid[target[0], target[1], prim_idx] = 0\n          collected_positions.add(target)\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          ws_adj = adjacent_free(ws_cell, avoid=collected_positions)\n          if ws_adj is None:\n              ws_adj = ws_cell  # fallback: stand on the workshop cell\n          actions += bfs_path(cur_pos, ws_adj)\n          cur_pos = ws_adj\n\n          # Face the workshop cell\n          dy = ws_cell[0] - cur_pos[0]\n          dx = ws_cell[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n  # Trigger crafting\n  actions.append(USE)\n\n  return actions", "env_interactions": 37, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T20:17:21.094290", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action indices as defined by CraftLab\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Reset environment and fetch current state/world\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()             # mutable copy for bookkeeping\n\n  # Goal information\n  goal_name = 'arrow'\n  goal_idx = world.cookbook.index.index(goal_name)\n  needed = world.cookbook.primitives_for(goal_idx)   # {primitive_idx: count}\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  non_grab = list(world.non_grabbable_indices)\n\n  def is_blocked(pos):\n      \"\"\"True if a cell contains any non\u2011grabbable entity.\"\"\"\n      y, x = pos\n      return np.any(grid[y, x, non_grab] > 0)\n\n  def bfs(start, goal):\n      \"\"\"Shortest walkable path from start to goal avoiding blocked cells.\"\"\"\n      if start == goal:\n          return []\n      h, w = grid.shape[:2]\n      q = deque([start])\n      prev = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          y, x = cur\n          for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):\n              if 0 <= ny < h and 0 <= nx < w:\n                  nxt = (ny, nx)\n                  if nxt not in prev and not is_blocked(nxt):\n                      prev[nxt] = cur\n                      q.append(nxt)\n      else:\n          return []          # no path found\n\n      # Reconstruct path (excluding start, including goal)\n      path = []\n      cur = goal\n      while cur != start:\n          path.append(cur)\n          cur = prev[cur]\n      path.reverse()\n      return path\n\n  def path_to_actions(path):\n      \"\"\"Convert a list of positions into movement actions.\"\"\"\n      acts = []\n      for (y1, x1), (y2, x2) in zip(path, path[1:]):\n          if y2 == y1 + 1:\n              acts.append(DOWN)\n          elif y2 == y1 - 1:\n              acts.append(UP)\n          elif x2 == x1 + 1:\n              acts.append(RIGHT)\n          elif x2 == x1 - 1:\n              acts.append(LEFT)\n      return acts\n\n  def nearest(kind, from_pos):\n      \"\"\"Find the nearest cell containing the given kind.\"\"\"\n      locs = np.argwhere(grid[:, :, kind] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      return tuple(locs[dists.argmin()])\n\n  def free_adjacent(target):\n      \"\"\"Return a walkable neighbour of target (preferring N,S,W,E).\"\"\"\n      y, x = target\n      for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not is_blocked((ny, nx)):\n                  return (ny, nx)\n      return target   # fallback (assumed walkable for collection)\n\n  # ------------------------------------------------------------------\n  # Build the action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  cur = state.pos   # current agent position (y, x)\n\n  # Collect each required primitive the needed number of times\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          prim_loc = nearest(prim_idx, cur)\n          if prim_loc is None:\n              return actions   # primitive missing \u2013 abort early\n\n          # Move to a free cell adjacent to the primitive\n          stand_pos = free_adjacent(prim_loc)\n          path = bfs(cur, stand_pos)\n          actions.extend(path_to_actions([cur] + path))\n          cur = stand_pos\n\n          # Step onto the primitive itself\n          path = bfs(cur, prim_loc)\n          actions.extend(path_to_actions([cur] + path))\n          cur = prim_loc\n\n          # Pick it up\n          actions.append(USE)\n\n          # Update local grid copy\n          grid[prim_loc[0], prim_loc[1], prim_idx] = 0\n\n  # Move to the appropriate workshop (if the recipe specifies one)\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      ws_idx = world.cookbook.index.index(workshop_name)\n      ws_loc = nearest(ws_idx, cur)\n      if ws_loc is not None:\n          path = bfs(cur, ws_loc)\n          actions.extend(path_to_actions([cur] + path))\n          cur = ws_loc\n\n  # Final USE to craft the arrow\n  actions.append(USE)\n  return actions", "env_interactions": 23, "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T20:17:22.248652", "function_name": "make_arrow", "function_body": "  # Action indices as defined in CraftLab.action_specs\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Reset environment and fetch current state/world\n  env.reset()\n  state = env._current_state          # CraftState instance\n  world = env.world                    # CraftWorld instance\n  grid = state.grid.copy()             # mutable copy for local bookkeeping\n\n  # Identify the goal item (\"arrow\") and the primitives required to craft it\n  arrow_idx = world.cookbook.index.index('arrow')\n  required = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  non_grab = list(world.non_grabbable_indices)\n\n  def is_blocked(pos):\n      \"\"\"Return True if the cell at ``pos`` contains any non\u2011grabbable entity.\"\"\"\n      y, x = pos\n      return np.any(grid[y, x, non_grab] > 0)\n\n  def bfs_path(start, goal):\n      \"\"\"\n      Find a shortest walkable path from ``start`` to ``goal`` avoiding\n      non\u2011grabbable cells. Returns a list of positions (excluding ``start``,\n      including ``goal``). If no path exists, returns an empty list.\n      \"\"\"\n      if start == goal:\n          return []\n      h, w = grid.shape[:2]\n      queue = collections.deque([start])\n      visited = {start: None}\n      while queue:\n          cur = queue.popleft()\n          if cur == goal:\n              break\n          y, x = cur\n          for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):\n              if 0 <= ny < h and 0 <= nx < w:\n                  nxt = (ny, nx)\n                  if nxt not in visited and not is_blocked(nxt):\n                      visited[nxt] = cur\n                      queue.append(nxt)\n      else:\n          return []  # no path found\n\n      # Reconstruct path backwards from goal to start\n      path = []\n      cur = goal\n      while cur != start:\n          path.append(cur)\n          cur = visited[cur]\n      path.reverse()\n      return path\n\n  def path_to_actions(path):\n      \"\"\"Convert a list of positions into a list of movement actions.\"\"\"\n      actions = []\n      for (y1, x1), (y2, x2) in zip(path, path[1:]):\n          if y2 == y1 + 1:\n              actions.append(DOWN)\n          elif y2 == y1 - 1:\n              actions.append(UP)\n          elif x2 == x1 + 1:\n              actions.append(RIGHT)\n          elif x2 == x1 - 1:\n              actions.append(LEFT)\n      return actions\n\n  def nearest_cell(kind, from_pos):\n      \"\"\"Find the nearest cell containing ``kind`` (primitive or workshop).\"\"\"\n      locs = np.argwhere(grid[:, :, kind] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      return tuple(locs[dists.argmin()])\n\n  def free_adjacent(target):\n      \"\"\"\n      Return a walkable neighbour of ``target`` that is not occupied by a\n      non\u2011grabbable entity. Preference order: N, S, W, E. If none found,\n      return the target itself (assumed walkable for collection purposes).\n      \"\"\"\n      y, x = target\n      for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not is_blocked((ny, nx)):\n                  return (ny, nx)\n      return target\n\n  # ------------------------------------------------------------------\n  # Build the action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  cur = state.pos  # current agent position (y, x)\n\n  # Collect each required primitive the needed number of times\n  for prim_idx, count in required.items():\n      for _ in range(count):\n          prim_loc = nearest_cell(prim_idx, cur)\n          if prim_loc is None:\n              # Primitive not found \u2013 abort early\n              return actions\n\n          # Move to a free cell adjacent to the primitive\n          stand_pos = free_adjacent(prim_loc)\n          path = bfs_path(cur, stand_pos)\n          if not path and cur != stand_pos:\n              # No viable path \u2013 abort\n              return actions\n          actions.extend(path_to_actions([cur] + path))\n          cur = stand_pos\n\n          # Step onto the primitive cell itself\n          path = bfs_path(cur, prim_loc)\n          if not path and cur != prim_loc:\n              return actions\n          actions.extend(path_to_actions([cur] + path))\n          cur = prim_loc\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update local copy of the grid to reflect collection\n          grid[prim_loc[0], prim_loc[1], prim_idx] = 0\n\n  # Move to the appropriate workshop (if the recipe specifies one)\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      ws_idx = world.cookbook.index.index(workshop_name)\n      ws_loc = nearest_cell(ws_idx, cur)\n      if ws_loc is not None:\n          path = bfs_path(cur, ws_loc)\n          if path:\n              actions.extend(path_to_actions([cur] + path))\n              cur = ws_loc\n\n  # Final USE to craft the arrow\n  actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T20:17:47.767138", "function_name": "make_arrow", "function_body": "  # Resolve scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Obtain the initial CraftState for this episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      # Grid can be large; use its raw bytes together with position,\n      # direction and inventory to uniquely identify a state.\n      return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())\n\n  visited = set()\n  frontier = deque([Node(init_state, [])])\n  visited.add(_state_hash(init_state))\n\n  MAX_STEPS = 500          # safety bound to keep search tractable\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: does the inventory contain at least one arrow?\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long paths\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible primitive actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within limits\n  return []", "env_interactions": 20, "island_id": 2, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T20:18:03.433086", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # target item index for \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = set()\n  frontier = deque([Node(init_state, [])])\n  visited.add(_state_hash(init_state))\n\n  MAX_STEPS = 500                # limit to keep search tractable\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune long trajectories\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible primitive actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within limits\n  return []", "env_interactions": 20, "island_id": 2, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T20:18:29.247530", "function_name": "make_arrow", "function_body": "  # Resolve scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Obtain the initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  # Helper that uniquely identifies a state for visited\u2011set purposes\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = set()\n  frontier = deque([Node(init_state, [])])\n  visited.add(_state_hash(init_state))\n\n  # Upper bound on plan length \u2013 enough for most maps but prevents infinite search\n  MAX_PLAN_LEN = 1500\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: does inventory contain at least one arrow?\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Do not expand overly long trajectories\n      if len(node.actions) >= MAX_PLAN_LEN:\n          continue\n\n      # Expand all possible actions from the current state\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No solution found within the search budget\n  return []", "env_interactions": 20, "island_id": 2, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T20:18:44.924496", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = set()\n  frontier = deque([Node(init_state, [])])\n  visited.add(_state_hash(init_state))\n\n  MAX_STEPS = 800\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  return []", "env_interactions": 20, "island_id": 2, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T20:19:13.398030", "function_name": "make_arrow", "function_body": "  # Reset environment and fetch useful objects\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid                    # (WIDTH, HEIGHT, n_kinds)\n\n  # Action indices (as defined in CraftWorld)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  ACTIONS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def is_free(y, x):\n      \"\"\"Return True if the cell (y,x) does not contain any non\u2011grabbable entity.\"\"\"\n      if not (0 <= y < grid.shape[0] and 0 <= x < grid.shape[1]):\n          return False\n      return not np.any(grid[y, x, list(world.non_grabbable_indices)] > 0)\n\n  def free_adjacent(cell):\n      \"\"\"Return a free orthogonal neighbour of `cell` (or None if none).\"\"\"\n      y, x = cell\n      for dy, dx, _ in ACTIONS:\n          ny, nx = y + dy, x + dx\n          if is_free(ny, nx):\n              return (ny, nx)\n      return None\n\n  def bfs_path(start, goal):\n      \"\"\"Shortest path (list of actions) from start to goal avoiding non\u2011grabbable cells.\"\"\"\n      if start == goal:\n          return []\n      from collections import deque\n      queue = deque([start])\n      visited = {start: None}\n      while queue:\n          cur = queue.popleft()\n          if cur == goal:\n              break\n          cy, cx = cur\n          for dy, dx, act in ACTIONS:\n              ny, nx = cy + dy, cx + dx\n              if not is_free(ny, nx):\n                  continue\n              nxt = (ny, nx)\n              if nxt not in visited:\n                  visited[nxt] = (cur, act)\n                  queue.append(nxt)\n      else:\n          # No path found\n          return []\n\n      # reconstruct actions\n      path_actions = []\n      node = goal\n      while visited[node] is not None:\n          prev, act = visited[node]\n          path_actions.append(act)\n          node = prev\n      path_actions.reverse()\n      return path_actions\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Locate the nearest cell containing the given kind index.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return tuple(nearest)\n\n  def direction_action(src, dst):\n      \"\"\"Return the action that would make the agent at src face dst (one step).\"\"\"\n      dy, dx = dst[0] - src[0], dst[1] - src[1]\n      if dy == 1:\n          return DOWN\n      if dy == -1:\n          return UP\n      if dx == 1:\n          return RIGHT\n      if dx == -1:\n          return LEFT\n      return None\n\n  # ------------------------------------------------------------------\n  # Determine goal index and required primitives\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = world.cookbook.index.index(goal_name)\n  needed = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the needed number of times\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive not present \u2013 abort early.\n              return actions\n\n          # Choose a free adjacent cell to stand on (prefer one, else stay on target)\n          adj = free_adjacent(target) or target\n\n          # Move to the chosen cell\n          actions += bfs_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (optional turn)\n          turn = direction_action(cur_pos, target)\n          if turn is not None:\n              actions.append(turn)\n\n          # Pick up the primitive\n          actions.append(USE)\n\n  # ------------------------------------------------------------------\n  # Move to the workshop (if recipe specifies one) and craft the goal\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      ws_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(ws_idx, cur_pos)\n      if ws_cell is not None:\n          # Stand on a free neighbour of the workshop\n          ws_adj = free_adjacent(ws_cell) or ws_cell\n          actions += bfs_path(cur_pos, ws_adj)\n          cur_pos = ws_adj\n\n  # Final USE to trigger crafting of the arrow\n  actions.append(USE)\n\n  return actions", "env_interactions": 24, "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T20:19:14.683922", "function_name": "make_arrow", "function_body": "  # Reset environment and fetch current state/world information\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid                     # (WIDTH, HEIGHT, n_kinds)\n\n  # Action constants (as defined in CraftWorld)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def is_blocked(pos):\n      \"\"\"Return True if a non\u2011grabbable entity occupies the cell.\"\"\"\n      y, x = pos\n      return np.any(grid[y, x, list(world.non_grabbable_indices)] > 0)\n\n  def bfs_path(start, goal):\n      \"\"\"Find a shortest path (list of positions) from start to goal\n      avoiding blocked cells. Returns None if no path exists.\"\"\"\n      if start == goal:\n          return [start]\n      H, W = grid.shape[:2]\n      visited = np.full((H, W), False, dtype=bool)\n      prev = dict()\n      q = collections.deque()\n      q.append(start)\n      visited[start] = True\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          y, x = cur\n          for dy, dx in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < H and 0 <= nx < W and not visited[ny, nx] and not is_blocked((ny, nx)):\n                  visited[ny, nx] = True\n                  prev[(ny, nx)] = cur\n                  q.append((ny, nx))\n      else:\n          return None  # goal not reached\n\n      # reconstruct path\n      path = [goal]\n      while path[-1] != start:\n          path.append(prev[path[-1]])\n      path.reverse()\n      return path\n\n  def path_to_actions(path):\n      \"\"\"Convert a list of positions (including start) to action indices.\"\"\"\n      actions = []\n      for (y0, x0), (y1, x1) in zip(path, path[1:]):\n          if y1 == y0 + 1:\n              actions.append(DOWN)\n          elif y1 == y0 - 1:\n              actions.append(UP)\n          elif x1 == x0 + 1:\n              actions.append(RIGHT)\n          elif x1 == x0 - 1:\n              actions.append(LEFT)\n      return actions\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Locate the nearest cell containing the given kind index.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return tuple(nearest)\n\n  def free_adjacent(cell):\n      \"\"\"Return a free orthogonal neighbour of `cell`, or None.\"\"\"\n      y, x = cell\n      for ny, nx in [(y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)]:\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1] and not is_blocked((ny, nx)):\n              return (ny, nx)\n      return None\n\n  def face_towards(src, dst):\n      \"\"\"Append a single movement action that makes the agent at src face dst.\"\"\"\n      sy, sx = src\n      dy, dx = dst[0] - sy, dst[1] - sx\n      if dy == 1:\n          return DOWN\n      if dy == -1:\n          return UP\n      if dx == 1:\n          return RIGHT\n      if dx == -1:\n          return LEFT\n      return None\n\n  # ------------------------------------------------------------------\n  # Determine goal index and required primitives\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = world.cookbook.index.index(goal_name)\n  needed = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  actions = []\n  cur_pos = state.pos\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the needed number of times\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive missing \u2013 abort early.\n              return actions\n\n          # Choose a free adjacent cell to stand on; if none, stand on the primitive cell itself.\n          stand = free_adjacent(target) or target\n\n          # Compute path to the standing cell.\n          path = bfs_path(cur_pos, stand)\n          if path is None:\n              # No viable path \u2013 abort.\n              return actions\n          actions += path_to_actions(path)\n          cur_pos = stand\n\n          # Face the primitive (optional but helps USE)\n          turn = face_towards(cur_pos, target)\n          if turn is not None:\n              actions.append(turn)\n\n          # Pick up the primitive.\n          actions.append(USE)\n\n  # ------------------------------------------------------------------\n  # Move to the workshop (if any) and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      ws_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(ws_idx, cur_pos)\n      if ws_cell is not None:\n          path = bfs_path(cur_pos, ws_cell)\n          if path is not None:\n              actions += path_to_actions(path)\n              cur_pos = ws_cell\n\n  # Final USE to trigger crafting.\n  actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T20:19:46.754388", "function_name": "make_arrow", "function_body": "  import collections\n  from collections import deque, namedtuple\n\n  # Retrieve scenario and world objects from the environment\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  # Helper to create a hashable representation of a CraftState\n  def _hash_state(st):\n      # Position, direction, inventory tuple, and grid bytes\n      return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  visited = set()\n  frontier = deque([Node(init_state, [])])\n  visited.add(_hash_state(init_state))\n\n  MAX_STEPS = 300  # safety bound to keep search tractable\n  n_actions = getattr(world, \"n_actions\", 5)  # usually 5 (4 moves + USE)\n\n  # Order actions so that USE (typically the last action) is tried first\n  ordered_actions = list(range(n_actions - 1, -1, -1))\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Depth limit\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand possible actions\n      for a in ordered_actions:\n          if a >= n_actions:\n              continue\n          _, next_state = cur_state.step(a)\n          key = _hash_state(next_state)\n          if key not in visited:\n              visited.add(key)\n              frontier.append(Node(next_state, node.actions + [a]))\n\n  # No plan found within limits\n  return []", "env_interactions": 20, "island_id": 1, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T20:20:02.539916", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _hash_state(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      # Position, direction, inventory contents, and full grid bytes.\n      return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())\n\n  visited = set()\n  frontier = deque([Node(init_state, [])])\n  visited.add(_hash_state(init_state))\n\n  MAX_STEPS = 300                     # safety bound to keep search tractable\n  n_actions = getattr(world, \"n_actions\", 5)   # default to 5 (including USE)\n\n  # Prefer the USE action (usually last index) before movement actions.\n  ordered_actions = list(range(n_actions - 1, -1, -1))\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory.\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Depth limit.\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand neighbours.\n      for a in ordered_actions:\n          if a >= n_actions:\n              continue\n          _, nxt_state = cur_state.step(a)\n          key = _hash_state(nxt_state)\n          if key not in visited:\n              visited.add(key)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within the search limits.\n  return []", "env_interactions": 20, "island_id": 1, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T20:20:32.606581", "function_name": "make_arrow", "function_body": "  # Resolve scenario and world objects\n  scenario = getattr(env, \"scenario\", None) or env\n  world = getattr(scenario, \"world\", None) or getattr(env, \"world\", None)\n  if world is None:\n      return []\n\n  # Identify the index of the goal item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initialise the starting state\n  try:\n      start_state = scenario.init()\n  except Exception:\n      return []\n\n  # Helper to create a hashable representation of a state for visited set\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  from collections import deque, namedtuple\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  visited = {_state_hash(start_state)}\n  frontier = deque([Node(start_state, [])])\n\n  # Search parameters\n  MAX_STEPS = 400                     # safety bound on plan length\n  n_actions = getattr(world, \"n_actions\", 5)   # typical action space size\n\n  # Prefer using the \"USE\" action (usually index 4) before moving\n  if n_actions > 4:\n      action_order = [4] + [i for i in range(n_actions) if i != 4]\n  else:\n      action_order = list(range(n_actions))\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long sequences\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand actions in the chosen order\n      for a in action_order:\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # If no plan found within the budget, return empty list\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
