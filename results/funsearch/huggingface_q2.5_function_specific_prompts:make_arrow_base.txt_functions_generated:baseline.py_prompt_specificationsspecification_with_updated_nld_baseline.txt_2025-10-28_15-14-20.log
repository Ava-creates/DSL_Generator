{"timestamp": "2025-10-28T17:58:04.885425", "function_name": "make_arrow", "function_body": "  import collections, numpy as np\n\n  # Action indices as defined by the environment\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving the agent from\n  # `start` to any cell in `targets`.  Cells that contain any entity are\n  # treated as blocked (except the target cells themselves).\n  # ------------------------------------------------------------------\n  def _bfs_path(start, targets, occupied):\n      w, h = occupied.shape\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          if (x, y) in target_set:\n              return path\n          for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  # allow stepping onto a target even if it is currently occupied\n                  if not occupied[nx, ny] or (nx, ny) in target_set:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # No path found \u2013 return empty list (the caller will fail later)\n      return []\n\n  # ------------------------------------------------------------------\n  # Identify world, cookbook and the hard\u2011coded goal \"arrow\".\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Some wrappers keep the world inside the current state.\n      state_tmp = getattr(env, \"_current_state\", None)\n      if state_tmp is not None:\n          world = state_tmp.world\n  cookbook = world.cookbook\n  goal_idx = cookbook.index[\"arrow\"]\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Ensure we have a current state (reset if necessary) and fetch grid.\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n  pos = tuple(state.pos)                # (x, y)\n  grid = state.grid.copy()              # mutable copy of the world grid\n  occupied = np.any(grid, axis=2)       # bool mask of occupied cells\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive, greedily taking the nearest one\n  # that is still available.\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      gathered = 0\n      while gathered < needed:\n          # Locations that still contain this primitive.\n          locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n          if not locations:\n              raise RuntimeError(f\"Not enough of primitive {prim_idx} to craft arrow\")\n          # Choose the nearest location.\n          locations.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          target = locations[0]\n\n          # Move to the target cell.\n          path = _bfs_path(pos, [target], occupied)\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n\n          # Pick up the primitive.\n          actions.append(USE)\n          # Simulate the pickup in our local copy.\n          grid[target[0], target[1], prim_idx] = 0\n          occupied[target[0], target[1]] = False\n          gathered += 1\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its designated workshop (if any).  If the\n  # recipe does not specify a workshop we simply issue a USE action\n  # at the current location.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      ws_idx = (cookbook.index[workshop_key]\n                if isinstance(workshop_key, str) else workshop_key)\n      ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, ws_idx] > 0)]\n      if ws_cells:\n          ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          ws_target = ws_cells[0]\n          path = _bfs_path(pos, [ws_target], occupied)\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          actions.append(USE)\n      else:\n          # No workshop cell found \u2013 fall back to using current position.\n          actions.append(USE)\n  else:\n      # Recipe does not require a specific workshop.\n      actions.append(USE)\n\n  return actions", "env_interactions": 24, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:58:34.469550", "function_name": "make_arrow", "function_body": "  # Reset the environment and fetch the underlying state/world objects.\n  env.reset()\n  state = env._current_state          # CraftState instance\n  world = env.world                    # CraftWorld instance\n  # Work on a mutable copy of the grid so we can mark primitives as collected.\n  grid = state.grid.copy()             # shape (WIDTH, HEIGHT, n_kinds)\n\n  # Action indices as defined by CraftLab.action_specs.\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def in_bounds(y, x):\n      return 0 <= y < grid.shape[0] and 0 <= x < grid.shape[1]\n\n  def is_blocked(y, x):\n      \"\"\"A cell is blocked if any entity (including workshops, obstacles, etc.) occupies it.\"\"\"\n      return np.any(grid[y, x])\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that moves the\n      agent from ``start`` to ``goal`` while avoiding blocked cells.\n      If no path is found, returns an empty list.\"\"\"\n      if start == goal:\n          return []\n      from collections import deque\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          y, x = q.popleft()\n          if (y, x) == goal:\n              # reconstruct actions\n              rev_actions = []\n              cur = goal\n              while cur != start:\n                  py, px = parent[cur]\n                  if cur[0] == py + 1:\n                      rev_actions.append(DOWN)\n                  elif cur[0] == py - 1:\n                      rev_actions.append(UP)\n                  elif cur[1] == px + 1:\n                      rev_actions.append(RIGHT)\n                  elif cur[1] == px - 1:\n                      rev_actions.append(LEFT)\n                  cur = (py, px)\n              return list(reversed(rev_actions))\n          for dy, dx, _ in DIRS:\n              ny, nx = y + dy, x + dx\n              if not in_bounds(ny, nx):\n                  continue\n              if (ny, nx) in visited:\n                  continue\n              if is_blocked(ny, nx):\n                  continue\n              visited.add((ny, nx))\n              parent[(ny, nx)] = (y, x)\n              q.append((ny, nx))\n      # No path found.\n      return []\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Locate the closest cell containing ``kind_idx`` (primitive or workshop).\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return tuple(nearest)\n\n  def adjacent_free(cell, avoid=set()):\n      \"\"\"Return a free neighbouring cell (y, x) to ``cell`` that is not in ``avoid``.\"\"\"\n      y, x = cell\n      for dy, dx, _ in DIRS:\n          ny, nx = y + dy, x + dx\n          if not in_bounds(ny, nx):\n              continue\n          if (ny, nx) in avoid:\n              continue\n          if not is_blocked(ny, nx):\n              return (ny, nx)\n      return None\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow) and its required primitives.\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed = world.cookbook.primitives_for(arrow_idx)          # {primitive_idx: count}\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = None\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n\n  actions = []\n  cur_pos = state.pos                                         # (y, x)\n  collected = set()                                           # cells from which primitives have been taken\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the needed number of times.\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive not present \u2013 abort early.\n              return actions\n\n          # Choose a free adjacent cell to stand on while picking up.\n          adj = adjacent_free(target, avoid=collected)\n          if adj is None:\n              # No free neighbour; cannot safely collect \u2013 abort.\n              return actions\n\n          # Move to the adjacent cell.\n          actions += bfs_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (add a blocked movement action to set direction).\n          dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick up the primitive.\n          actions.append(USE)\n\n          # Update internal grid representation: primitive disappears.\n          grid[target[0], target[1], prim_idx] = 0\n          collected.add(target)\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow.\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          ws_adj = adjacent_free(ws_cell, avoid=collected)\n          if ws_adj is None:\n              # If no free neighbour, we cannot reach the workshop safely.\n              return actions\n          actions += bfs_path(cur_pos, ws_adj)\n          cur_pos = ws_adj\n\n          # Face the workshop (optional blocked move to set direction).\n          dy, dx = ws_cell[0] - cur_pos[0], ws_cell[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n  # Trigger crafting at the current location.\n  actions.append(USE)\n\n  return actions", "env_interactions": 37, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T17:58:35.638439", "function_name": "make_arrow", "function_body": "  # Reset environment and fetch core objects\n  env.reset()\n  state = env._current_state          # CraftState instance\n  world = env.world                    # CraftWorld instance\n  # Work on a mutable copy of the grid to track collected items\n  grid = state.grid.copy()             # (WIDTH, HEIGHT, n_kinds)\n\n  # Action indices (consistent with CraftLab.action_specs)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def in_bounds(y, x):\n      return 0 <= y < grid.shape[0] and 0 <= x < grid.shape[1]\n\n  def is_blocked(y, x):\n      \"\"\"A cell is blocked if any entity occupies it.\"\"\"\n      return np.any(grid[y, x])\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) from start to goal,\n      avoiding blocked cells. Returns empty list if no path found.\"\"\"\n      if start == goal:\n          return []\n      from collections import deque\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          y, x = q.popleft()\n          if (y, x) == goal:\n              # Reconstruct actions\n              rev_actions = []\n              cur = goal\n              while cur != start:\n                  py, px = parent[cur]\n                  if cur[0] == py + 1:\n                      rev_actions.append(DOWN)\n                  elif cur[0] == py - 1:\n                      rev_actions.append(UP)\n                  elif cur[1] == px + 1:\n                      rev_actions.append(RIGHT)\n                  elif cur[1] == px - 1:\n                      rev_actions.append(LEFT)\n                  cur = (py, px)\n              return list(reversed(rev_actions))\n          for dy, dx, act in DIRS:\n              ny, nx = y + dy, x + dx\n              if not in_bounds(ny, nx):\n                  continue\n              if (ny, nx) in visited:\n                  continue\n              if is_blocked(ny, nx):\n                  continue\n              visited.add((ny, nx))\n              parent[(ny, nx)] = (y, x)\n              q.append((ny, nx))\n      # No path found\n      return []\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Locate the closest cell containing ``kind_idx`` (primitive or workshop).\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return tuple(nearest)\n\n  def adjacent_free(cell, avoid=set()):\n      \"\"\"Return a free neighbouring cell (y, x) to ``cell`` that is not in ``avoid``.\"\"\"\n      y, x = cell\n      for dy, dx, _ in DIRS:\n          ny, nx = y + dy, x + dx\n          if not in_bounds(ny, nx):\n              continue\n          if (ny, nx) in avoid:\n              continue\n          if not is_blocked(ny, nx):\n              return (ny, nx)\n      return None\n\n  # ------------------------------------------------------------------\n  # Identify goal (arrow) and its required primitives\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed = world.cookbook.primitives_for(arrow_idx)   # {primitive_idx: count}\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = None\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n\n  actions = []\n  cur_pos = state.pos                     # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the required number of times\n  # ------------------------------------------------------------------\n  collected_cells = set()\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive missing; abort early\n              return actions\n\n          # Choose a free adjacent cell to stand on while picking up\n          adj = adjacent_free(target, avoid=collected_cells)\n          if adj is None:\n              # No free neighbour; abort\n              return actions\n\n          # Move to the adjacent cell\n          actions += bfs_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (blocked move to set direction)\n          dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update internal grid and record that this cell has been taken\n          grid[target[0], target[1], prim_idx] = 0\n          collected_cells.add(target)\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          # Prefer a free neighbour of the workshop\n          ws_adj = adjacent_free(ws_cell, avoid=collected_cells)\n          if ws_adj is None:\n              # Fall back to standing directly on the workshop cell\n              ws_adj = ws_cell\n          actions += bfs_path(cur_pos, ws_adj)\n          cur_pos = ws_adj\n\n          # Face the workshop (optional blocked move)\n          dy, dx = ws_cell[0] - cur_pos[0], ws_cell[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n  # Trigger crafting\n  actions.append(USE)\n\n  return actions", "env_interactions": 37, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T17:59:08.463014", "function_name": "make_arrow", "function_body": "  # Reset the environment and obtain useful references\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()             # mutable copy for planning\n\n  # Action constants from the environment\n  specs = env.action_specs()\n  DOWN = specs[\"DOWN\"]\n  UP = specs[\"UP\"]\n  LEFT = specs[\"LEFT\"]\n  RIGHT = specs[\"RIGHT\"]\n  USE = specs[\"USE\"]\n\n  # Mapping from movement vector to action id\n  DIRS = {\n      (1, 0): DOWN,\n      (-1, 0): UP,\n      (0, -1): LEFT,\n      (0, 1): RIGHT,\n  }\n\n  from collections import deque\n  import numpy as np\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of movement actions from start to goal avoiding non\u2011grabbable cells.\"\"\"\n      if start == goal:\n          return []\n\n      W, H = grid.shape[0], grid.shape[1]\n      blocked_kinds = list(world.non_grabbable_indices)\n\n      visited = np.full((W, H), False, dtype=bool)\n      prev = {}  # (y,x) -> (prev_y, prev_x, action)\n\n      q = deque()\n      q.append(start)\n      visited[start] = True\n\n      while q:\n          y, x = q.popleft()\n          for (dy, dx), act in DIRS.items():\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < W and 0 <= nx < H and not visited[ny, nx]:\n                  # cell is blocked if any non\u2011grabbable entity occupies it\n                  if blocked_kinds and np.any(grid[ny, nx, blocked_kinds] > 0):\n                      continue\n                  visited[ny, nx] = True\n                  prev[(ny, nx)] = (y, x, act)\n                  if (ny, nx) == goal:\n                      # reconstruct path\n                      actions = []\n                      cur = (ny, nx)\n                      while cur != start:\n                          py, px, a = prev[cur]\n                          actions.append(a)\n                          cur = (py, px)\n                      actions.reverse()\n                      return actions\n                  q.append((ny, nx))\n      # No path found\n      return []\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Locate the nearest cell that currently contains an entity of kind_idx.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return (int(nearest[0]), int(nearest[1]))\n\n  # --------------------------------------------------------------\n  # Determine the index of the target item and its primitive needs\n  # --------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  primitive_reqs = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  workshop_idx = None\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # --------------------------------------------------------------\n  # Collect required primitives\n  # --------------------------------------------------------------\n  for prim_idx, needed in primitive_reqs.items():\n      for _ in range(needed):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # primitive not present; abort early\n              return actions\n\n          # Move to the primitive cell\n          actions += bfs_path(cur_pos, target)\n          cur_pos = target\n\n          # Pick it up\n          actions.append(USE)\n\n          # Update planning grid so we don't try to collect the same instance again\n          grid[target[0], target[1], prim_idx] = 0\n\n  # --------------------------------------------------------------\n  # Go to workshop (if required) and craft the arrow\n  # --------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          actions += bfs_path(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # Final USE to trigger crafting at current location (or at workshop)\n  actions.append(USE)\n\n  return actions", "env_interactions": 19, "island_id": 7, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T17:59:09.647890", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n  grid = state.grid\n\n  # Action indices\n  specs = env.action_specs()\n  DOWN = specs[\"DOWN\"]\n  UP = specs[\"UP\"]\n  LEFT = specs[\"LEFT\"]\n  RIGHT = specs[\"RIGHT\"]\n  USE = specs[\"USE\"]\n\n  from collections import deque\n  import numpy as np\n\n  # Map movement deltas to actions\n  MOVE_MAP = {\n      (1, 0): DOWN,\n      (-1, 0): UP,\n      (0, -1): LEFT,\n      (0, 1): RIGHT,\n  }\n\n  def bfs_path(start, goal):\n      \"\"\"Return list of movement actions from start to goal avoiding blocked cells.\"\"\"\n      if start == goal:\n          return []\n      W, H = grid.shape[0], grid.shape[1]\n      blocked_kinds = list(world.non_grabbable_indices)\n\n      visited = np.full((W, H), False, dtype=bool)\n      prev = {}  # (y,x) -> (prev_y, prev_x, action)\n\n      q = deque()\n      q.append(start)\n      visited[start] = True\n\n      while q:\n          y, x = q.popleft()\n          for (dy, dx), act in MOVE_MAP.items():\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < W and 0 <= nx < H and not visited[ny, nx]:\n                  # cell is free if none of the blocked kinds are present\n                  if not np.any(grid[ny, nx, blocked_kinds] > 0):\n                      visited[ny, nx] = True\n                      prev[(ny, nx)] = (y, x, act)\n                      if (ny, nx) == goal:\n                          # reconstruct path\n                          actions = []\n                          cur = (ny, nx)\n                          while cur != start:\n                              py, px, a = prev[cur]\n                              actions.append(a)\n                              cur = (py, px)\n                          actions.reverse()\n                          return actions\n                      q.append((ny, nx))\n      return []  # no path found\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Locate nearest cell containing kind_idx.\"\"\"\n      locs = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      nearest = locs[np.argmin(dists)]\n      return (int(nearest[0]), int(nearest[1]))\n\n  # Identify arrow and its recipe\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  primitive_req = world.cookbook.primitives_for(arrow_idx)  # {prim_idx: count}\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  actions = []\n  cur_pos = state.pos\n\n  # Collect required primitives\n  for prim_idx, cnt in primitive_req.items():\n      for _ in range(cnt):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              return actions  # cannot find required primitive\n          actions.extend(bfs_path(cur_pos, target))\n          cur_pos = target\n          actions.append(USE)\n\n  # Move to workshop if needed and craft\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          actions.extend(bfs_path(cur_pos, ws_cell))\n          cur_pos = ws_cell\n\n  actions.append(USE)\n  return actions", "env_interactions": 19, "island_id": 7, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T17:59:39.077923", "function_name": "make_arrow", "function_body": "  # Action indices\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Determine current position (use live state if available)\n  # ------------------------------------------------------------------\n  if hasattr(env, \"_current_state\") and env._current_state is not None:\n      cur_pos = list(env._current_state.pos)          # [x, y]\n  else:\n      cur_pos = list(env.scenario.init_pos)           # [x, y]\n\n  # Work on a mutable copy of the static grid to keep track of taken items\n  grid = env.scenario.init_grid.copy()\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def _move_to(pos, target, seq):\n      \"\"\"Append actions moving from `pos` (list) to `target` (list).\"\"\"\n      while pos[0] != target[0] or pos[1] != target[1]:\n          if pos[0] < target[0]:\n              seq.append(RIGHT)\n              pos[0] += 1\n          elif pos[0] > target[0]:\n              seq.append(LEFT)\n              pos[0] -= 1\n          elif pos[1] < target[1]:\n              seq.append(DOWN)\n              pos[1] += 1\n          elif pos[1] > target[1]:\n              seq.append(UP)\n              pos[1] -= 1\n\n  def _nearest_kind(kind_idx, cur, g):\n      \"\"\"Return coordinates [x, y] of the nearest cell containing `kind_idx`.\"\"\"\n      ys, xs = np.where(g[:, :, kind_idx] > 0)\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - cur[0]) + np.abs(ys - cur[1])\n      best = int(np.argmin(dists))\n      return [int(xs[best]), int(ys[best])]\n\n  # ------------------------------------------------------------------\n  # 1. Gather all primitive resources required for the final goal.\n  # ------------------------------------------------------------------\n  goal_idx = env.task.goal\n  primitive_needs = env.world.cookbook.primitives_for(goal_idx).copy()\n\n  # If the goal itself is a primitive, we also need to pick it up.\n  if goal_idx in env.world.cookbook.primitives:\n      primitive_needs[goal_idx] = primitive_needs.get(goal_idx, 0) + 1\n\n  for prim_kind, count in primitive_needs.items():\n      for _ in range(count):\n          target = _nearest_kind(prim_kind, cur_pos, grid)\n          if target is None:\n              # Primitive not found; abort planning.\n              return actions\n          _move_to(cur_pos, target, actions)\n          actions.append(USE)                         # pick up primitive\n          grid[target[1], target[0], prim_kind] = 0   # mark cell as empty\n\n  # ------------------------------------------------------------------\n  # 2. Determine crafting order for intermediate items (post\u2011order).\n  # ------------------------------------------------------------------\n  recipes = env.world.cookbook.recipes\n  primitives_set = env.world.cookbook.primitives\n\n  craft_order = []\n  visited = set()\n\n  def _dfs(item):\n      if item in visited:\n          return\n      visited.add(item)\n      rec = recipes.get(item, {})\n      for ing, cnt in rec.items():\n          if ing == \"_at\":\n              continue\n          if ing not in primitives_set:\n              _dfs(ing)\n      craft_order.append(item)\n\n  _dfs(goal_idx)\n\n  # ------------------------------------------------------------------\n  # 3. Execute crafting steps at required workshops.\n  # ------------------------------------------------------------------\n  for item in craft_order:\n      # Primitives are already in inventory; skip them.\n      if item in primitives_set:\n          continue\n      rec = recipes.get(item, {})\n      workshop_kind = rec.get(\"_at\")\n      if workshop_kind is None:\n          continue\n      workshop_pos = _nearest_kind(workshop_kind, cur_pos, grid)\n      if workshop_pos is None:\n          # No workshop found; abort further planning.\n          return actions\n      _move_to(cur_pos, workshop_pos, actions)\n      actions.append(USE)  # craft the item at the workshop\n\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:59:40.193599", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def _move_to(pos, target, seq):\n      \"\"\"Append actions that move the agent from `pos` to `target`.\"\"\"\n      while pos[0] != target[0] or pos[1] != target[1]:\n          if pos[0] < target[0]:\n              seq.append(RIGHT)\n              pos[0] += 1\n          elif pos[0] > target[0]:\n              seq.append(LEFT)\n              pos[0] -= 1\n          elif pos[1] < target[1]:\n              seq.append(DOWN)\n              pos[1] += 1\n          elif pos[1] > target[1]:\n              seq.append(UP)\n              pos[1] -= 1\n\n  def _nearest_kind(kind_idx, cur, g):\n      \"\"\"Return coordinates [x, y] of the nearest cell containing `kind_idx`.\"\"\"\n      ys, xs = np.where(g[:, :, kind_idx] > 0)\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - cur[0]) + np.abs(ys - cur[1])\n      best = int(np.argmin(dists))\n      return [int(xs[best]), int(ys[best])]\n\n  # ------------------------------------------------------------------\n  # Determine current position.\n  # ------------------------------------------------------------------\n  if hasattr(env, \"_current_state\") and env._current_state is not None:\n      cur_pos = list(env._current_state.pos)          # [x, y]\n  else:\n      cur_pos = list(env.scenario.init_pos)           # [x, y]\n\n  # Copy of the static grid so we can mark items as taken.\n  grid = env.scenario.init_grid.copy()\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # 1. Collect all primitive resources required for the goal.\n  # ------------------------------------------------------------------\n  goal_idx = env.task.goal\n  needed_prims = env.world.cookbook.primitives_for(goal_idx).copy()\n\n  # If the goal itself is a primitive, we also need to pick it up.\n  if goal_idx in env.world.cookbook.primitives:\n      needed_prims[goal_idx] = needed_prims.get(goal_idx, 0) + 1\n\n  for kind_idx, count in needed_prims.items():\n      for _ in range(count):\n          target = _nearest_kind(kind_idx, cur_pos, grid)\n          if target is None:\n              # Primitive not found \u2013 abort planning.\n              return actions\n          _move_to(cur_pos, target, actions)\n          actions.append(USE)                         # pick up the item\n          grid[target[1], target[0], kind_idx] = 0    # mark as taken\n\n  # ------------------------------------------------------------------\n  # 2. Move to the required workshop (if any) and craft the goal item.\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      workshop_pos = _nearest_kind(workshop_kind, cur_pos, grid)\n      if workshop_pos is not None:\n          _move_to(cur_pos, workshop_pos, actions)\n          actions.append(USE)                         # craft at workshop\n\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:00:11.297557", "function_name": "make_arrow", "function_body": "  spec = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      spec[\"DOWN\"], spec[\"UP\"], spec[\"LEFT\"], spec[\"RIGHT\"], spec[\"USE\"]\n  )\n\n  goal = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal)  # {prim_idx: count}\n\n  state = env._current_state\n  pos = tuple(state.pos)               # (x, y)\n  grid = state.grid.copy()              # occupancy tensor\n  inventory = state.inventory.copy()    # current inventory\n  actions = []\n\n  from collections import deque\n\n  def bfs(start, target):\n      \"\"\"Return a list of movement actions from start to target, or None.\"\"\"\n      w, h = grid.shape[:2]\n\n      # Cells that cannot be entered: any non\u2011grabbable entity present\n      non_grab = list(env.world.non_grabbable_indices)\n      if non_grab:\n          blocked = np.any(grid[:, :, non_grab] > 0, axis=2)\n      else:\n          blocked = np.zeros((w, h), dtype=bool)\n\n      # Allow stepping on the target even if it would otherwise be blocked\n      blocked[target[0], target[1]] = False\n\n      q = deque([start])\n      parent = {start: None}\n      action_to = {}\n\n      dirs = [\n          (DOWN, (1, 0)),\n          (UP, (-1, 0)),\n          (RIGHT, (0, 1)),\n          (LEFT, (0, -1)),\n      ]\n\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          x, y = cur\n          for act, (dx, dy) in dirs:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and not blocked[nx, ny]:\n                  nxt = (nx, ny)\n                  if nxt not in parent:\n                      parent[nxt] = cur\n                      action_to[nxt] = act\n                      q.append(nxt)\n\n      if target not in parent:\n          return None\n\n      # Reconstruct actions\n      path = []\n      cur = target\n      while cur != start:\n          path.append(action_to[cur])\n          cur = parent[cur]\n      path.reverse()\n      return path\n\n  def move_to(target):\n      \"\"\"Move the simulated agent to *target*, updating pos and actions.\"\"\"\n      nonlocal pos\n      if pos == target:\n          return\n      path = bfs(pos, target)\n      if path is None:\n          # Fallback: simple Manhattan moves (ignores obstacles)\n          dx, dy = target[0] - pos[0], target[1] - pos[1]\n          path = []\n          while dx > 0:\n              path.append(DOWN)\n              dx -= 1\n          while dx < 0:\n              path.append(UP)\n              dx += 1\n          while dy > 0:\n              path.append(RIGHT)\n              dy -= 1\n          while dy < 0:\n              path.append(LEFT)\n              dy += 1\n      actions.extend(path)\n      pos = target\n\n  # --------------------------------------------------------------------- #\n  # Collect required primitives (taking inventory into account)\n  # --------------------------------------------------------------------- #\n  for prim_idx, req_cnt in needed.items():\n      have = int(inventory[prim_idx])\n      need = max(0, req_cnt - have)\n\n      for _ in range(need):\n          # Locate remaining instances of the primitive\n          locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not locations:\n              # No more instances on the map; stop trying for this primitive\n              break\n\n          # Choose the nearest instance (Manhattan distance)\n          target = min(\n              locations,\n              key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),\n          )\n\n          # Move to it and pick it up\n          move_to(target)\n          actions.append(USE)  # pick up\n\n          # Update simulated world state\n          grid[target[0], target[1], prim_idx] = 0\n          inventory[prim_idx] += 1\n\n  # --------------------------------------------------------------------- #\n  # Move to the appropriate workshop (if any) and craft the goal item.\n  # --------------------------------------------------------------------- #\n  recipe = env.world.cookbook.recipes.get(goal, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      ws_locs = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))\n      if ws_locs:\n          # Choose nearest workshop\n          target_ws = min(\n              ws_locs,\n              key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),\n          )\n          move_to(target_ws)\n          actions.append(USE)  # craft at workshop\n\n  return actions", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:00:12.435041", "function_name": "make_arrow", "function_body": "  import numpy as np\n  import collections\n\n  # --------------------------------------------------------------------- #\n  # Action indices\n  # --------------------------------------------------------------------- #\n  spec = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      spec[\"DOWN\"], spec[\"UP\"], spec[\"LEFT\"], spec[\"RIGHT\"], spec[\"USE\"]\n  )\n\n  # --------------------------------------------------------------------- #\n  # Goal and required primitive counts\n  # --------------------------------------------------------------------- #\n  goal = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal)  # {prim_idx: count}\n\n  # --------------------------------------------------------------------- #\n  # Current state snapshot\n  # --------------------------------------------------------------------- #\n  state = env._current_state\n  pos = tuple(state.pos)                 # (x, y)\n  grid = state.grid.copy()                # occupancy tensor (W, H, n_kinds)\n  inventory = state.inventory.copy()\n  actions = []\n\n  # --------------------------------------------------------------------- #\n  # Helper: BFS path finder returning a list of movement actions.\n  # --------------------------------------------------------------------- #\n  def bfs(start, target):\n      \"\"\"Return list of movement actions from start to target, or None.\"\"\"\n      width, height = grid.shape[:2]\n\n      # Cells occupied by non\u2011grabbable entities cannot be entered.\n      non_grab = list(env.world.non_grabbable_indices)\n      if non_grab:\n          blocked = np.any(grid[:, :, non_grab] > 0, axis=2)\n      else:\n          blocked = np.zeros((width, height), dtype=bool)\n\n      # The target cell is allowed even if it is otherwise blocked\n      blocked[target[0], target[1]] = False\n\n      q = collections.deque([start])\n      came_from = {start: None}\n      action_to = {}\n\n      # (action, (dx, dy))\n      dirs = [\n          (DOWN, (1, 0)),\n          (UP, (-1, 0)),\n          (RIGHT, (0, 1)),\n          (LEFT, (0, -1)),\n      ]\n\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          x, y = cur\n          for act, (dx, dy) in dirs:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height and not blocked[nx, ny]:\n                  nxt = (nx, ny)\n                  if nxt not in came_from:\n                      came_from[nxt] = cur\n                      action_to[nxt] = act\n                      q.append(nxt)\n\n      if target not in came_from:\n          return None\n\n      # Reconstruct the action list\n      path = []\n      cur = target\n      while cur != start:\n          path.append(action_to[cur])\n          cur = came_from[cur]\n      path.reverse()\n      return path\n\n  # --------------------------------------------------------------------- #\n  # Determine which primitives are still missing (inventory may already hold some)\n  # --------------------------------------------------------------------- #\n  missing = {}\n  for prim_idx, cnt in needed.items():\n      have = int(inventory[prim_idx]) if prim_idx < len(inventory) else 0\n      if cnt > have:\n          missing[prim_idx] = cnt - have\n\n  # --------------------------------------------------------------------- #\n  # Collect each missing primitive\n  # --------------------------------------------------------------------- #\n  for prim_idx, count in missing.items():\n      for _ in range(count):\n          # Locate all remaining instances of this primitive on the grid\n          locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not locations:\n              # Primitive not found \u2013 give up on this item\n              break\n\n          # Choose the nearest instance (Manhattan distance)\n          target = min(\n              locations,\n              key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),\n          )\n\n          # Plan a path to the target\n          path = bfs(pos, target)\n          if path is None:\n              # Fallback: simple Manhattan moves (ignores obstacles)\n              dx, dy = target[0] - pos[0], target[1] - pos[1]\n              path = []\n              while dx > 0:\n                  path.append(DOWN)\n                  dx -= 1\n              while dx < 0:\n                  path.append(UP)\n                  dx += 1\n              while dy > 0:\n                  path.append(RIGHT)\n                  dy -= 1\n              while dy < 0:\n                  path.append(LEFT)\n                  dy += 1\n\n          # Execute movement and pick\u2011up\n          actions.extend(path)\n          actions.append(USE)\n\n          # Update simulated state\n          pos = target\n          grid[pos[0], pos[1], prim_idx] = 0\n          # (inventory update not required for planning)\n\n  # --------------------------------------------------------------------- #\n  # Move to the workshop (if the recipe specifies one) and craft the goal\n  # --------------------------------------------------------------------- #\n  recipe = env.world.cookbook.recipes.get(goal, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      ws_locations = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))\n      if ws_locations:\n          # Choose nearest workshop\n          target_ws = min(\n              ws_locations,\n              key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),\n          )\n          path = bfs(pos, target_ws)\n          if path is None:\n              # Manhattan fallback\n              dx, dy = target_ws[0] - pos[0], target_ws[1] - pos[1]\n              path = []\n              while dx > 0:\n                  path.append(DOWN)\n                  dx -= 1\n              while dx < 0:\n                  path.append(UP)\n                  dx += 1\n              while dy > 0:\n                  path.append(RIGHT)\n                  dy -= 1\n              while dy < 0:\n                  path.append(LEFT)\n                  dy += 1\n          actions.extend(path)\n          actions.append(USE)  # craft at the workshop\n\n  return actions", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:00:35.475681", "function_name": "make_arrow", "function_body": "  # Reset environment and obtain initial references\n  env.reset()\n  state = env._current_state\n  world = env.world\n\n  # Action constants as defined by CraftLab\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ----------------------------------------------------------------------\n  # Helper utilities\n  # ----------------------------------------------------------------------\n  def _manhattan_path(src, dst):\n      \"\"\"Return a list of actions that moves from src to dst using a simple\n      Manhattan walk (first vertical, then horizontal).\"\"\"\n      actions = []\n      r, c = src\n      tr, tc = dst\n      while r != tr:\n          if r < tr:\n              actions.append(DOWN)\n              r += 1\n          else:\n              actions.append(UP)\n              r -= 1\n      while c != tc:\n          if c < tc:\n              actions.append(RIGHT)\n              c += 1\n          else:\n              actions.append(LEFT)\n              c -= 1\n      return actions\n\n  def _nearest(grid, kind_idx, start):\n      \"\"\"Find the Manhattan\u2011closest cell containing the given kind.\"\"\"\n      h, w, _ = grid.shape\n      best = None\n      best_dist = None\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  d = abs(i - start[0]) + abs(j - start[1])\n                  if best_dist is None or d < best_dist:\n                      best_dist = d\n                      best = (i, j)\n      return best\n\n  def _any(grid, kind_idx):\n      \"\"\"Return any cell that contains the given kind (used for workshops).\"\"\"\n      h, w, _ = grid.shape\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  return (i, j)\n      return None\n\n  # ----------------------------------------------------------------------\n  # Identify the goal (arrow) and its recipe\n  # ----------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:\n      # Arrow not defined in the cookbook \u2013 nothing to do.\n      return []\n\n  # Primitive requirements for a single arrow\n  needed = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}\n  action_seq = []\n\n  # ----------------------------------------------------------------------\n  # Collect all required primitives (respecting multiplicities)\n  # ----------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          target = _nearest(state.grid, prim_idx, state.pos)\n          if target is None:\n              # Primitive missing from the map \u2013 abort early.\n              return action_seq\n\n          # Move to the primitive location.\n          for a in _manhattan_path(state.pos, target):\n              _, _, _ = env.step(a)\n              state = env._current_state\n              action_seq.append(a)\n\n          # Pick it up.\n          _, _, _ = env.step(USE)\n          state = env._current_state\n          action_seq.append(USE)\n\n  # ----------------------------------------------------------------------\n  # If the recipe requires a specific workshop, go there before crafting.\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = _any(state.grid, workshop_idx)\n      if workshop_pos is not None:\n          for a in _manhattan_path(state.pos, workshop_pos):\n              _, _, _ = env.step(a)\n              state = env._current_state\n              action_seq.append(a)\n\n  # ----------------------------------------------------------------------\n  # Final craft action (USE) at the current location (workshop or open ground)\n  # ----------------------------------------------------------------------\n  _, _, _ = env.step(USE)\n  action_seq.append(USE)\n\n  return action_seq", "env_interactions": 21, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:00:36.601088", "function_name": "make_arrow", "function_body": "  # Reset the environment and obtain the initial state.\n  env.reset()\n  state = env._current_state\n  world = env.world\n\n  # Action indices as defined by CraftLab.\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ----------------------------------------------------------------------\n  # Helper: Manhattan\u2011distance path (list of actions) from src to dst.\n  # ----------------------------------------------------------------------\n  def _manhattan_path(src, dst):\n      actions = []\n      r, c = src\n      tr, tc = dst\n      while r != tr:\n          if r < tr:\n              actions.append(DOWN)\n              r += 1\n          else:\n              actions.append(UP)\n              r -= 1\n      while c != tc:\n          if c < tc:\n              actions.append(RIGHT)\n              c += 1\n          else:\n              actions.append(LEFT)\n              c -= 1\n      return actions\n\n  # ----------------------------------------------------------------------\n  # Helper: Find the nearest cell (Manhattan distance) containing a kind.\n  # ----------------------------------------------------------------------\n  def _nearest_cell(grid, kind_idx, start):\n      h, w, _ = grid.shape\n      best = None\n      best_dist = None\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  d = abs(i - start[0]) + abs(j - start[1])\n                  if best_dist is None or d < best_dist:\n                      best_dist = d\n                      best = (i, j)\n      return best\n\n  # ----------------------------------------------------------------------\n  # Helper: Return any cell containing a given kind (used for workshops).\n  # ----------------------------------------------------------------------\n  def _any_cell(grid, kind_idx):\n      h, w, _ = grid.shape\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  return (i, j)\n      return None\n\n  # ----------------------------------------------------------------------\n  # Identify the index for the goal item (\"arrow\").\n  # ----------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:          # Arrow not defined in the recipe set.\n      return []\n\n  # ----------------------------------------------------------------------\n  # Determine primitive requirements for a single arrow.\n  # ----------------------------------------------------------------------\n  required = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}\n  plan = []\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive the necessary number of times.\n  # ----------------------------------------------------------------------\n  for prim_idx, count in required.items():\n      for _ in range(count):\n          target = _nearest_cell(state.grid, prim_idx, state.pos)\n          if target is None:\n              # Primitive missing from the world \u2013 abort early.\n              return plan\n          for a in _manhattan_path(state.pos, target):\n              _, _, _ = env.step(a)\n              state = env._current_state\n              plan.append(a)\n          # Pick up the primitive.\n          _, _, _ = env.step(USE)\n          state = env._current_state\n          plan.append(USE)\n\n  # ----------------------------------------------------------------------\n  # If the recipe specifies a workshop, move to it before crafting.\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = _any_cell(state.grid, workshop_idx)\n      if workshop_pos is not None:\n          for a in _manhattan_path(state.pos, workshop_pos):\n              _, _, _ = env.step(a)\n              state = env._current_state\n              plan.append(a)\n\n  # ----------------------------------------------------------------------\n  # Final craft action (USE) at the current location (workshop or open ground).\n  # ----------------------------------------------------------------------\n  _, _, _ = env.step(USE)\n  plan.append(USE)\n\n  return plan", "env_interactions": 21, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:01:05.024565", "function_name": "make_arrow", "function_body": "  # Reset environment and extract useful objects\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()             # mutable copy of the grid\n\n  # Action indices as defined by CraftLab\n  specs = env.action_specs()\n  DOWN = specs[\"DOWN\"]\n  UP = specs[\"UP\"]\n  LEFT = specs[\"LEFT\"]\n  RIGHT = specs[\"RIGHT\"]\n  USE = specs[\"USE\"]\n  DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]\n\n  H, W = grid.shape[:2]\n  non_grabbable = set(world.non_grabbable_indices)\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def in_bounds(y, x):\n      return 0 <= y < H and 0 <= x < W\n\n  def is_blocked(y, x):\n      \"\"\"A cell is blocked if any entity occupies it.\"\"\"\n      return np.any(grid[y, x, :])\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) from start to goal\n      while avoiding blocked cells. If no path exists, returns an empty list.\"\"\"\n      if start == goal:\n          return []\n      from collections import deque\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          y, x = q.popleft()\n          if (y, x) == goal:\n              # reconstruct actions\n              rev = []\n              cur = goal\n              while cur != start:\n                  py, px = parent[cur]\n                  if cur[0] == py + 1:\n                      rev.append(DOWN)\n                  elif cur[0] == py - 1:\n                      rev.append(UP)\n                  elif cur[1] == px + 1:\n                      rev.append(RIGHT)\n                  elif cur[1] == px - 1:\n                      rev.append(LEFT)\n                  cur = (py, px)\n              return list(reversed(rev))\n          for dy, dx, act in DIRS:\n              ny, nx = y + dy, x + dx\n              if not in_bounds(ny, nx):\n                  continue\n              if (ny, nx) in visited:\n                  continue\n              if is_blocked(ny, nx):\n                  continue\n              visited.add((ny, nx))\n              parent[(ny, nx)] = (y, x)\n              q.append((ny, nx))\n      return []  # no path found\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Locate the closest cell containing *kind_idx*.\"\"\"\n      locs = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      nearest = locs[np.argmin(dists)]\n      return tuple(nearest)\n\n  def adjacent_free(cell):\n      \"\"\"Return a free neighbour of *cell* (or None if none exists).\"\"\"\n      y, x = cell\n      for dy, dx, _ in DIRS:\n          ny, nx = y + dy, x + dx\n          if not in_bounds(ny, nx):\n              continue\n          if not is_blocked(ny, nx):\n              return (ny, nx)\n      return None\n\n  # ------------------------------------------------------------------\n  # Determine goal (arrow) and its recipe\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  needed_prims = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  workshop_idx = None\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect all required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed_prims.items():\n      for _ in range(cnt):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive not found \u2013 abort early.\n              return actions\n\n          # Choose a free adjacent cell to stand on while picking up.\n          adj = adjacent_free(target)\n          if adj is None:\n              # No free neighbour; we will stand on the primitive cell itself.\n              adj = target\n\n          # Move to the chosen adjacent cell.\n          actions += bfs_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (add a movement in the direction of the primitive).\n          dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick up the primitive.\n          actions.append(USE)\n\n          # Update internal grid to reflect removal of the primitive.\n          grid[target[0], target[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Move to the workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          # Prefer a free neighbour of the workshop.\n          ws_adj = adjacent_free(ws_cell)\n          if ws_adj is None:\n              ws_adj = ws_cell  # fallback to standing directly on it (rare)\n          actions += bfs_path(cur_pos, ws_adj)\n          cur_pos = ws_adj\n\n          # Face the workshop.\n          dy, dx = ws_cell[0] - cur_pos[0], ws_cell[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n  # Finally, issue the USE action to craft the arrow.\n  actions.append(USE)\n\n  return actions", "env_interactions": 37, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T18:01:06.184429", "function_name": "make_arrow", "function_body": "  # reset environment and fetch current state/world\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()             # mutable copy of the grid\n\n  # ------------------------------------------------------------------\n  # Action indices (as defined by CraftLab)\n  # ------------------------------------------------------------------\n  specs = env.action_specs()\n  DOWN = specs[\"DOWN\"]\n  UP = specs[\"UP\"]\n  LEFT = specs[\"LEFT\"]\n  RIGHT = specs[\"RIGHT\"]\n  USE = specs[\"USE\"]\n  DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  H, W = grid.shape[:2]\n\n  def in_bounds(y, x):\n      return 0 <= y < H and 0 <= x < W\n\n  def is_blocked(y, x):\n      \"\"\"A cell is blocked if any entity occupies it.\"\"\"\n      return np.any(grid[y, x])\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of movement actions from start to goal avoiding blocked cells.\"\"\"\n      if start == goal:\n          return []\n      from collections import deque\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          y, x = q.popleft()\n          if (y, x) == goal:\n              # reconstruct actions\n              rev = []\n              cur = goal\n              while cur != start:\n                  py, px = parent[cur]\n                  if cur[0] == py + 1:\n                      rev.append(DOWN)\n                  elif cur[0] == py - 1:\n                      rev.append(UP)\n                  elif cur[1] == px + 1:\n                      rev.append(RIGHT)\n                  elif cur[1] == px - 1:\n                      rev.append(LEFT)\n                  cur = (py, px)\n              return list(reversed(rev))\n          for dy, dx, act in DIRS:\n              ny, nx = y + dy, x + dx\n              if not in_bounds(ny, nx):\n                  continue\n              if (ny, nx) in visited:\n                  continue\n              if is_blocked(ny, nx):\n                  continue\n              visited.add((ny, nx))\n              parent[(ny, nx)] = (y, x)\n              q.append((ny, nx))\n      # No path found \u2013 return empty list (will likely cause failure later)\n      return []\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Locate the closest cell containing *kind_idx*.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return tuple(nearest)\n\n  def adjacent_free(cell):\n      \"\"\"Return a free neighbour of *cell* (or None).\"\"\"\n      y, x = cell\n      for dy, dx, _ in DIRS:\n          ny, nx = y + dy, x + dx\n          if not in_bounds(ny, nx):\n              continue\n          if not is_blocked(ny, nx):\n              return (ny, nx)\n      return None\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow) and its recipe\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  needed = world.cookbook.primitives_for(arrow_idx)   # {primitive_idx: count}\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  workshop_idx = None\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive not present \u2013 abort early.\n              return actions\n\n          # Choose a free neighbouring cell to stand on while picking up.\n          adj = adjacent_free(target)\n          if adj is None:\n              # No free neighbour; cannot pick up this primitive.\n              return actions\n\n          # Move to the adjacent cell.\n          actions += bfs_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (issue a blocked move in the correct direction).\n          dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick up the primitive.\n          actions.append(USE)\n\n          # Update internal grid representation (primitive disappears).\n          grid[target[0], target[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is None:\n          return actions\n      ws_adj = adjacent_free(ws_cell)\n      if ws_adj is None:\n          # No free neighbour; try standing directly on the workshop cell.\n          ws_adj = ws_cell\n      actions += bfs_path(cur_pos, ws_adj)\n      cur_pos = ws_adj\n\n      # Optionally face the workshop (blocked move).\n      dy, dx = ws_cell[0] - cur_pos[0], ws_cell[1] - cur_pos[1]\n      if dy == 1:\n          actions.append(DOWN)\n      elif dy == -1:\n          actions.append(UP)\n      elif dx == 1:\n          actions.append(RIGHT)\n      elif dx == -1:\n          actions.append(LEFT)\n\n  # Trigger crafting.\n  actions.append(USE)\n\n  return actions", "env_interactions": 37, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T18:01:25.754848", "function_name": "make_arrow", "function_body": "  # Action indices: DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n  ACTION_USE = 4\n\n  def bfs(start, targets, blocked):\n      \"\"\"Bread\u2011first search returning a list of action indices that reaches any cell in *targets*.\"\"\"\n      w, h = grid.shape[:2]\n      q = collections.deque([(start, [])])\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in targets:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not blocked[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []  # unreachable in well\u2011formed scenarios\n\n  def go_to_kind(kind_idx, times):\n      \"\"\"Move to a cell containing *kind_idx* and press USE *times*.\"\"\"\n      nonlocal pos, actions\n      for _ in range(times):\n          cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, kind_idx] > 0}\n          path = bfs(pos, cells, blocked)\n          actions.extend(path)\n          for a in path:\n              dx, dy = DIRS[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # 1) Extract recipe information for the goal item \"arrow\"\n  # ------------------------------------------------------------------\n  world = env.world\n  cookbook = world.cookbook\n  target_idx = cookbook.index[\"arrow\"]\n\n  primitive_needs = {}          # primitive kind \u2192 total count required\n  craft_sequence = []           # (item_idx, count) in order of crafting\n\n  def resolve(item_idx, mult):\n      \"\"\"Recursively collect primitive requirements and schedule crafts.\"\"\"\n      rec = cookbook.recipes.get(item_idx)\n      if rec is None:  # primitive (no recipe entry)\n          primitive_needs[item_idx] = primitive_needs.get(item_idx, 0) + mult\n          return\n      for ing, cnt in rec.items():\n          if isinstance(ing, int):          # ignore special keys like \"_at\"\n              resolve(ing, cnt * mult)\n      craft_sequence.append((item_idx, mult))\n\n  resolve(target_idx, 1)\n\n  # ------------------------------------------------------------------\n  # 2) Static environment data\n  # ------------------------------------------------------------------\n  grid = env._current_state.grid\n  w, h, _ = grid.shape\n  blocked = np.zeros((w, h), dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # ------------------------------------------------------------------\n  # 3) Build the action list\n  # ------------------------------------------------------------------\n  actions = []\n  pos = tuple(env._current_state.pos)\n\n  # 3a) Gather all required primitive resources\n  for kind_idx, cnt in primitive_needs.items():\n      go_to_kind(kind_idx, cnt)\n\n  # 3b) Perform the crafting steps at their respective workshops\n  for item_idx, cnt in craft_sequence:\n      rec = cookbook.recipes[item_idx]\n      wk_key = rec.get(\"_at\", rec.get(\"_key\"))\n      wk_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]\n\n      wk_cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, wk_idx] > 0}\n      path = bfs(pos, wk_cells, blocked)\n      actions.extend(path)\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n\n      actions.extend([ACTION_USE] * cnt)\n\n  return actions", "env_interactions": 20, "island_id": 6, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T18:01:26.884569", "function_name": "make_arrow", "function_body": "  # Directions: DOWN, UP, LEFT, RIGHT\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n  ACTION_USE = 4\n\n  # ------------------------------------------------------------------\n  # Helper: breadth\u2011first search returning a list of action indices that\n  # reaches any cell in `targets` while avoiding cells marked in `blocked`.\n  # ------------------------------------------------------------------\n  def bfs(start, targets, blocked):\n      w, h = grid.shape[:2]\n      q = collections.deque([(start, [])])\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in targets:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not blocked[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      # No reachable target \u2013 should not happen in valid scenarios\n      return []\n\n  # ------------------------------------------------------------------\n  # Helper: move to a cell containing `kind_idx` and perform the USE\n  # action `count` times (collecting primitives or using a workshop).\n  # ------------------------------------------------------------------\n  def go_to_kind(kind_idx, count):\n      nonlocal pos, actions\n      for _ in range(count):\n          cells = {(x, y) for x in range(w) for y in range(h)\n                   if grid[x, y, kind_idx] > 0}\n          path = bfs(pos, cells, blocked)\n          actions.extend(path)\n          for a in path:\n              dx, dy = DIRS[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # 1) Gather recipe information for the target item \"arrow\"\n  # ------------------------------------------------------------------\n  world = env.world\n  cookbook = world.cookbook\n  arrow_idx = cookbook.index[\"arrow\"]\n\n  needed_prims = {}          # primitive kind -> total count required\n  craft_steps = []           # ordered list of (item_idx, count) to craft\n\n  def resolve(item_idx, mult):\n      \"\"\"Recursively collect primitive requirements and schedule crafting.\"\"\"\n      rec = cookbook.recipes.get(item_idx)\n      if rec is None:                     # primitive (no recipe entry)\n          needed_prims[item_idx] = needed_prims.get(item_idx, 0) + mult\n          return\n      # Resolve ingredient items first (ignore special keys like \"_at\" or \"_key\")\n      for ing, cnt in rec.items():\n          if isinstance(ing, int):\n              resolve(ing, cnt * mult)\n      # Schedule this item to be crafted after its ingredients are ready\n      craft_steps.append((item_idx, mult))\n\n  resolve(arrow_idx, 1)\n\n  # ------------------------------------------------------------------\n  # 2) Static environment data: grid, blocked cells, dimensions\n  # ------------------------------------------------------------------\n  grid = env._current_state.grid\n  w, h, _ = grid.shape\n  blocked = np.zeros((w, h), dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # ------------------------------------------------------------------\n  # 3) Build the action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  pos = tuple(env._current_state.pos)\n\n  # 3a) Collect all required primitive resources\n  for kind_idx, cnt in needed_prims.items():\n      go_to_kind(kind_idx, cnt)\n\n  # 3b) Perform crafting steps at the appropriate workshops\n  for item_idx, cnt in craft_steps:\n      rec = cookbook.recipes[item_idx]\n      wk_key = rec.get(\"_at\", rec.get(\"_key\"))\n      wk_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]\n\n      # Locate any workshop cell of the required type\n      wk_cells = {(x, y) for x in range(w) for y in range(h)\n                  if grid[x, y, wk_idx] > 0}\n      path = bfs(pos, wk_cells, blocked)\n      actions.extend(path)\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n\n      # Use the workshop the necessary number of times to craft the item\n      actions.extend([ACTION_USE] * cnt)\n\n  return actions", "env_interactions": 20, "island_id": 6, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T18:01:45.881221", "function_name": "make_arrow", "function_body": "  # Mapping from direction vectors to action indices (DOWN,UP,LEFT,RIGHT)\n  DIR2ACT = {(0, 1): 0, (0, -1): 1, (-1, 0): 2, (1, 0): 3}\n  ACT2DIR = {v: k for k, v in DIR2ACT.items()}\n\n  from collections import deque\n  import numpy as np\n\n  def bfs_to_adjacent(start, targets, grid):\n      \"\"\"Return a list of actions that moves from ``start`` to a cell\n      adjacent to any of ``targets`` while avoiding non\u2011grabbable obstacles.\"\"\"\n      W, H = grid.shape[:2]\n\n      # Cells are blocked if they contain any non\u2011grabbable entity.\n      blocked = np.zeros((W, H), dtype=bool)\n      for idx in env.world.non_grabbable_indices:\n          blocked |= grid[:, :, idx] > 0\n\n      sx, sy = start\n      # Already adjacent to a target?\n      for tx, ty in targets:\n          if abs(sx - tx) + abs(sy - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((sx, sy, []))\n      visited = np.full((W, H), False, dtype=bool)\n      visited[sx, sy] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR2ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if blocked[nx, ny]:\n                      continue\n                  npath = path + [act]\n                  # Check adjacency to any target cell.\n                  for tx, ty in targets:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return npath\n                  visited[nx, ny] = True\n                  q.append((nx, ny, npath))\n      # No reachable adjacency.\n      return []\n\n  # ------------------------------------------------------------------\n  # Begin planning.\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()          # mutable copy of the world grid\n  pos = tuple(state.pos)            # (x, y)\n\n  # Goal item index (could be stored directly or as part of a struct)\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      raise ValueError(\"Goal index not found in env.task\")\n\n  # Determine all primitive (or intermediate) items required for the goal.\n  needed = env.world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n  plan = []\n\n  # --------------------------------------------------------------\n  # 1. Collect required primitives / intermediate items.\n  # --------------------------------------------------------------\n  for kind_idx, required_cnt in needed.items():\n      while required_cnt > 0:\n          # Locate cells that currently hold this kind.\n          cells = np.argwhere(grid[:, :, kind_idx] > 0)\n          if cells.size == 0:\n              # No more of this primitive in the world \u2013 abort planning.\n              return plan\n\n          # Move adjacent to the nearest such cell.\n          path = bfs_to_adjacent(pos, cells.tolist(), grid)\n          plan.extend(path)\n\n          # Simulate movement to keep ``pos`` up\u2011to\u2011date.\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Use action to pick up the primitive.\n          plan.append(4)   # USE\n\n          # Identify which cell we are now adjacent to.\n          adj_cell = None\n          for cx, cy in cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  adj_cell = (cx, cy)\n                  break\n          if adj_cell is None:\n              # Unexpected situation; break to avoid infinite loop.\n              break\n\n          # Update local grid copy to reflect the pickup.\n          grid[adj_cell[0], adj_cell[1], kind_idx] -= 1\n          required_cnt -= 1\n\n  # --------------------------------------------------------------\n  # 2. Move to the required workshop (if any) and craft the goal.\n  # --------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (name string or integer).\n      if isinstance(workshop_key, str):\n          workshop_idx = env.world.cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          path = bfs_to_adjacent(pos, workshop_cells.tolist(), grid)\n          plan.extend(path)\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          # Craft by using the workshop.\n          plan.append(4)   # USE\n\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:01:47.037332", "function_name": "make_arrow", "function_body": "  # Mapping from direction vectors to action indices.\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n  DIR2ACT = {\n      (0, 1): ACTION_DOWN,   # y+ (down)\n      (0, -1): ACTION_UP,    # y- (up)\n      (-1, 0): ACTION_LEFT,  # x- (left)\n      (1, 0): ACTION_RIGHT,  # x+ (right)\n  }\n  ACT2DIR = {v: k for k, v in DIR2ACT.items()}\n\n  from collections import deque\n  import numpy as np\n\n  def bfs_to_adjacent(start, targets, grid):\n      \"\"\"Return a list of actions moving from ``start`` to a cell adjacent\n      to any cell in ``targets`` while avoiding non\u2011grabbable obstacles.\n\n      ``grid`` has shape (W, H, K). Cells are blocked if they contain any\n      entity whose index is in ``env.world.non_grabbable_indices``.\n      \"\"\"\n      W, H = grid.shape[:2]\n\n      # Build blocked mask.\n      blocked = np.zeros((W, H), dtype=bool)\n      for idx in env.world.non_grabbable_indices:\n          blocked |= grid[:, :, idx] > 0\n\n      sx, sy = start\n      # Already adjacent?\n      for tx, ty in targets:\n          if abs(sx - tx) + abs(sy - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((sx, sy, []))\n      visited = np.full((W, H), False, dtype=bool)\n      visited[sx, sy] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR2ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if blocked[nx, ny]:\n                      continue\n                  npath = path + [act]\n                  # Check adjacency to any target.\n                  for tx, ty in targets:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return npath\n                  visited[nx, ny] = True\n                  q.append((nx, ny, npath))\n      # No reachable adjacency.\n      return []\n\n  # ------------------------------------------------------------------\n  # Begin planning.\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()          # mutable copy of the world grid\n  pos = tuple(state.pos)            # (x, y)\n\n  # Goal index may be stored directly or inside a struct.\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      raise ValueError(\"Goal index not found in env.task\")\n\n  # --------------------------------------------------------------\n  # 1. Collect required primitive items.\n  # --------------------------------------------------------------\n  needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  plan = []\n\n  for kind_idx, remaining in needed.items():\n      while remaining > 0:\n          # Locate cells that currently contain this kind.\n          cells = np.argwhere(grid[:, :, kind_idx] > 0)\n          if cells.size == 0:\n              # No more of this primitive on the map \u2013 abort planning.\n              return plan\n\n          # Move adjacent to the nearest such cell.\n          path = bfs_to_adjacent(pos, cells.tolist(), grid)\n          plan.extend(path)\n\n          # Simulate movement.\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Pick up the primitive.\n          plan.append(ACTION_USE)\n\n          # Identify which cell we are now adjacent to.\n          adj_cell = None\n          for cx, cy in cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  adj_cell = (cx, cy)\n                  break\n          if adj_cell is None:\n              # Unexpected situation; break to avoid infinite loop.\n              break\n\n          # Update the local grid copy and decrement remaining count.\n          grid[adj_cell[0], adj_cell[1], kind_idx] -= 1\n          remaining -= 1\n\n  # --------------------------------------------------------------\n  # 2. Move to the workshop (if required) and craft the goal item.\n  # --------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (name string or integer).\n      if isinstance(workshop_key, str):\n          workshop_idx = env.world.cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          path = bfs_to_adjacent(pos, workshop_cells.tolist(), grid)\n          plan.extend(path)\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          # Use the workshop to craft.\n          plan.append(ACTION_USE)\n\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:02:04.524261", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # helper: locate the nearest cell (Manhattan) containing a given kind\n  # ------------------------------------------------------------------\n  def _find_nearest(grid, kind_idx, start_pos):\n      h, w, _ = grid.shape\n      best = None\n      best_dist = None\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  d = abs(i - start_pos[0]) + abs(j - start_pos[1])\n                  if best_dist is None or d < best_dist:\n                      best_dist = d\n                      best = (i, j)\n      return best\n\n  # ------------------------------------------------------------------\n  # helper: locate any cell containing a given kind (e.g., workshop)\n  # ------------------------------------------------------------------\n  def _find_any(grid, kind_idx):\n      h, w, _ = grid.shape\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  return (i, j)\n      return None\n\n  # ------------------------------------------------------------------\n  # helper: generate a simple Manhattan path (list of actions)\n  # ------------------------------------------------------------------\n  def _path(src, dst):\n      actions = []\n      r, c = src\n      tr, tc = dst\n      while r != tr:\n          if r < tr:\n              actions.append(DOWN)\n              r += 1\n          else:\n              actions.append(UP)\n              r -= 1\n      while c != tc:\n          if c < tc:\n              actions.append(RIGHT)\n              c += 1\n          else:\n              actions.append(LEFT)\n              c -= 1\n      return actions\n\n  # ------------------------------------------------------------------\n  # initialise episode\n  # ------------------------------------------------------------------\n  env.reset()\n  state = env._current_state          # current CraftState\n  world = env.world\n\n  # ------------------------------------------------------------------\n  # identify the goal item (arrow)\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:                   # unknown goal\n      return []\n\n  # ------------------------------------------------------------------\n  # primitive requirements for a single arrow\n  # ------------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}\n  action_seq = []\n\n  # ------------------------------------------------------------------\n  # collect each required primitive (respecting required counts)\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in primitive_needs.items():\n      for _ in range(cnt):\n          target = _find_nearest(state.grid, prim_idx, state.pos)\n          if target is None:            # primitive missing \u2013 abort\n              return action_seq\n          # move to the primitive location\n          for a in _path(state.pos, target):\n              reward, done, obs = env.step(a)\n              state = env._current_state\n              action_seq.append(a)\n              if done:\n                  return action_seq\n          # pick it up\n          reward, done, obs = env.step(USE)\n          state = env._current_state\n          action_seq.append(USE)\n          if done:\n              return action_seq\n\n  # ------------------------------------------------------------------\n  # if a workshop is required, go there and craft\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\", None)\n\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = _find_any(state.grid, workshop_idx)\n      if workshop_pos is not None:\n          for a in _path(state.pos, workshop_pos):\n              reward, done, obs = env.step(a)\n              state = env._current_state\n              action_seq.append(a)\n              if done:\n                  return action_seq\n          # craft at the workshop\n          reward, done, obs = env.step(USE)\n          state = env._current_state\n          action_seq.append(USE)\n\n  return action_seq", "env_interactions": 21, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:02:05.664396", "function_name": "make_arrow", "function_body": "  # ------------------------------------------------------------------\n  # helpers\n  # ------------------------------------------------------------------\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  ACTIONS = {(1, 0): DOWN, (-1, 0): UP, (0, 1): RIGHT, (0, -1): LEFT}\n\n  def _nearest(grid, kind, pos):\n      \"\"\"Manhattan nearest cell containing *kind*.\"\"\"\n      h, w, _ = grid.shape\n      best, best_d = None, None\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind] > 0:\n                  d = abs(i - pos[0]) + abs(j - pos[1])\n                  if best_d is None or d < best_d:\n                      best, best_d = (i, j), d\n      return best\n\n  def _any(grid, kind):\n      \"\"\"First cell containing *kind* (used for workshops).\"\"\"\n      h, w, _ = grid.shape\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind] > 0:\n                  return (i, j)\n      return None\n\n  def _manhattan_path(src, dst):\n      \"\"\"Straight\u2011line Manhattan actions from src to dst.\"\"\"\n      actions = []\n      r, c = src\n      tr, tc = dst\n      while r != tr:\n          if r < tr:\n              actions.append(DOWN); r += 1\n          else:\n              actions.append(UP);   r -= 1\n      while c != tc:\n          if c < tc:\n              actions.append(RIGHT); c += 1\n          else:\n              actions.append(LEFT);  c -= 1\n      return actions\n\n  # ------------------------------------------------------------------\n  # initialise episode\n  # ------------------------------------------------------------------\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world\n\n  # ------------------------------------------------------------------\n  # goal identification (arrow)\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:          # arrow not defined in this world\n      return []\n\n  # ------------------------------------------------------------------\n  # primitive requirements for ONE arrow\n  # ------------------------------------------------------------------\n  needs = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}\n  plan = []\n\n  # ------------------------------------------------------------------\n  # collect required primitives\n  # ------------------------------------------------------------------\n  for kind, cnt in needs.items():\n      for _ in range(cnt):\n          tgt = _nearest(state.grid, kind, state.pos)\n          if tgt is None:                     # missing primitive \u2013 abort\n              return plan\n          # move to the primitive cell\n          for a in _manhattan_path(state.pos, tgt):\n              reward, done, obs = env.step(a)\n              state = env._current_state\n              plan.append(a)\n              if done:\n                  return plan\n          # pick it up\n          reward, done, obs = env.step(USE)\n          state = env._current_state\n          plan.append(USE)\n          if done:\n              return plan\n\n  # ------------------------------------------------------------------\n  # if a workshop is required, go there and craft\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      wk_idx = world.cookbook.index.index(workshop_name)\n      wk_pos = _any(state.grid, wk_idx)\n      if wk_pos is not None:\n          for a in _manhattan_path(state.pos, wk_pos):\n              reward, done, obs = env.step(a)\n              state = env._current_state\n              plan.append(a)\n              if done:\n                  return plan\n          # craft / use at the workshop\n          reward, done, obs = env.step(USE)\n          state = env._current_state\n          plan.append(USE)\n\n  return plan", "env_interactions": 21, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:02:33.733466", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action indices as defined by CraftLab\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n  DIR2ACT = {(0, 1): ACTION_DOWN,\n             (0, -1): ACTION_UP,\n             (-1, 0): ACTION_LEFT,\n             (1, 0): ACTION_RIGHT}\n  ACT2DIR = {v: k for k, v in DIR2ACT.items()}\n\n  def bfs_adjacent(start, targets, occupied):\n      \"\"\"Return a list of actions moving from ``start`` to a cell adjacent to any\n      target while avoiding cells marked as occupied (bool array).\"\"\"\n      W, H = occupied.shape\n\n      # Already adjacent?\n      for tx, ty in targets:\n          if abs(start[0] - tx) + abs(start[1] - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = np.zeros((W, H), dtype=bool)\n      visited[start[0], start[1]] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR2ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny] and not occupied[nx, ny]:\n                  new_path = path + [act]\n                  # Check adjacency to any target.\n                  for tx, ty in targets:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return new_path\n                  visited[nx, ny] = True\n                  q.append((nx, ny, new_path))\n      return []  # unreachable\n\n  # ------------------------------------------------------------------\n  # Extract current world information\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()               # mutable copy of the grid\n  pos = tuple(state.pos)                 # (x, y)\n\n  # Goal index stored in the task\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      return []\n\n  # Primitive (and intermediate) requirements for the goal.\n  needed = env.world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n  plan = []\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives.\n  # ------------------------------------------------------------------\n  for kind_idx, needed_cnt in needed.items():\n      while needed_cnt > 0:\n          # Locate cells that still contain this primitive.\n          cells = np.argwhere(grid[:, :, kind_idx] > 0)\n          if cells.size == 0:\n              # Primitive not available \u2013 abort planning.\n              return plan\n\n          # Cells occupied by any entity block movement.\n          occupied = np.any(grid > 0, axis=2)\n\n          # Find a path to a position adjacent to one of the primitive cells.\n          path = bfs_adjacent(pos, cells.tolist(), occupied)\n          plan.extend(path)\n\n          # Simulate movement to keep `pos` up\u2011to\u2011date.\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Pick up the primitive.\n          plan.append(ACTION_USE)\n\n          # Identify which primitive cell we are now adjacent to.\n          adj_cell = None\n          for cx, cy in cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  adj_cell = (cx, cy)\n                  break\n          if adj_cell is None:\n              # Safety break to avoid infinite loop.\n              break\n\n          # Update local grid copy and decrement remaining count.\n          grid[adj_cell[0], adj_cell[1], kind_idx] -= 1\n          needed_cnt -= 1\n\n  # ------------------------------------------------------------------\n  # 2. Move to the workshop (if required) and craft the goal item.\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\") or recipe.get(\"_key\")\n  if workshop_key is not None:\n      # Resolve workshop index (could be a name or integer).\n      if isinstance(workshop_key, str):\n          workshop_idx = env.world.cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          occupied = np.any(grid > 0, axis=2)\n          path = bfs_adjacent(pos, workshop_cells.tolist(), occupied)\n          plan.extend(path)\n\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Craft by using the workshop.\n          plan.append(ACTION_USE)\n\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:02:34.847623", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action indices used by CraftLab\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n  DIR_TO_ACT = {(0, 1): ACTION_DOWN,\n                (0, -1): ACTION_UP,\n                (-1, 0): ACTION_LEFT,\n                (1, 0): ACTION_RIGHT}\n  ACT_TO_DIR = {v: k for k, v in DIR_TO_ACT.items()}\n\n  def bfs_adjacent(start, targets, grid, block_set):\n      \"\"\"Return a list of actions moving from ``start`` to a cell adjacent\n      to any target while avoiding cells that contain any kind in ``block_set``.\"\"\"\n      W, H = grid.shape[:2]\n\n      # Fast check: already adjacent?\n      for tx, ty in targets:\n          if abs(start[0] - tx) + abs(start[1] - ty) == 1:\n              return []\n\n      # Pre\u2011compute blocked boolean map\n      blocked = np.zeros((W, H), dtype=bool)\n      for b in block_set:\n          blocked |= grid[:, :, b] > 0\n\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = np.zeros((W, H), dtype=bool)\n      visited[start[0], start[1]] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR_TO_ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if blocked[nx, ny]:\n                      continue\n                  new_path = path + [act]\n                  # Check adjacency to any target from the new cell\n                  for tx, ty in targets:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return new_path\n                  visited[nx, ny] = True\n                  q.append((nx, ny, new_path))\n      # Unreachable\n      return []\n\n  # ------------------------------------------------------------------\n  # Extract current world information\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()               # mutable copy\n  pos = tuple(state.pos)                 # (x, y)\n\n  # Goal index stored in the task (CraftLab uses env.task.goal)\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      raise ValueError(\"Goal index not found in env.task\")\n\n  # Primitive requirements for the goal (primitive kind \u2192 count)\n  needed = env.world.cookbook.primitives_for(goal_idx)\n\n  # Indices of entities that cannot be walked through\n  block_set = env.world.non_grabbable_indices\n\n  plan = []\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives\n  # ------------------------------------------------------------------\n  for kind_idx, cnt in needed.items():\n      while cnt > 0:\n          # Locate remaining cells that still contain this primitive\n          cells = np.argwhere(grid[:, :, kind_idx] > 0)\n          if cells.size == 0:\n              # Primitive not available \u2013 abort planning\n              return plan\n\n          # Find a path to a position adjacent to one of the primitive cells\n          path = bfs_adjacent(pos, cells.tolist(), grid, block_set)\n          plan.extend(path)\n\n          # Simulate movement to keep ``pos`` up\u2011to\u2011date\n          for a in path:\n              dx, dy = ACT_TO_DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Use action to pick up the primitive\n          plan.append(ACTION_USE)\n\n          # Determine which primitive cell we are now adjacent to\n          adj = None\n          for cx, cy in cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  adj = (cx, cy)\n                  break\n          if adj is None:\n              # Unexpected situation \u2013 break to avoid infinite loop\n              break\n\n          # Update local grid copy and decrement required count\n          grid[adj[0], adj[1], kind_idx] -= 1\n          cnt -= 1\n\n  # ------------------------------------------------------------------\n  # 2. Move to the appropriate workshop and craft the goal item\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\") or recipe.get(\"_key\")\n  if workshop_key is not None:\n      # Resolve workshop index (name or integer)\n      if isinstance(workshop_key, str):\n          workshop_idx = env.world.cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          path = bfs_adjacent(pos, workshop_cells.tolist(), grid, block_set)\n          plan.extend(path)\n\n          for a in path:\n              dx, dy = ACT_TO_DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Use action to craft at the workshop\n          plan.append(ACTION_USE)\n\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:03:01.032617", "function_name": "make_arrow", "function_body": "  # reset environment to get fresh state\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()             # mutable copy of the grid\n\n  # action indices\n  specs = env.action_specs()\n  DOWN = specs[\"DOWN\"]\n  UP = specs[\"UP\"]\n  LEFT = specs[\"LEFT\"]\n  RIGHT = specs[\"RIGHT\"]\n  USE = specs[\"USE\"]\n  DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def in_bounds(y, x):\n      return 0 <= y < grid.shape[0] and 0 <= x < grid.shape[1]\n\n  def is_blocked(y, x):\n      \"\"\"A cell is blocked if any kind occupies it.\"\"\"\n      return grid[y, x].any()\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that moves\n      the agent from ``start`` to ``goal`` while avoiding blocked cells.\"\"\"\n      if start == goal:\n          return []\n      from collections import deque\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          y, x = q.popleft()\n          if (y, x) == goal:\n              # reconstruct actions\n              rev = []\n              cur = goal\n              while cur != start:\n                  py, px = parent[cur]\n                  if cur[0] == py + 1:\n                      rev.append(DOWN)\n                  elif cur[0] == py - 1:\n                      rev.append(UP)\n                  elif cur[1] == px + 1:\n                      rev.append(RIGHT)\n                  elif cur[1] == px - 1:\n                      rev.append(LEFT)\n                  cur = (py, px)\n              return list(reversed(rev))\n          for dy, dx, act in DIRS:\n              ny, nx = y + dy, x + dx\n              if not in_bounds(ny, nx):\n                  continue\n              if (ny, nx) in visited:\n                  continue\n              if is_blocked(ny, nx):\n                  continue\n              visited.add((ny, nx))\n              parent[(ny, nx)] = (y, x)\n              q.append((ny, nx))\n      # no path found \u2013 return empty (will likely fail later)\n      return []\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Locate the closest cell containing ``kind_idx``.\"\"\"\n      locs = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      nearest = locs[dists.argmin()]\n      return tuple(nearest)\n\n  def adjacent_free(cell, avoid=set()):\n      \"\"\"Return a free neighbour (y, x) of ``cell`` not in ``avoid``.\"\"\"\n      y, x = cell\n      for dy, dx, _ in DIRS:\n          ny, nx = y + dy, x + dx\n          if not in_bounds(ny, nx):\n              continue\n          if (ny, nx) in avoid:\n              continue\n          if not is_blocked(ny, nx):\n              return (ny, nx)\n      return None\n\n  # ------------------------------------------------------------------\n  # Identify goal (arrow) and its required primitives\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = None\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n\n  actions = []\n  cur_pos = state.pos                     # (y, x)\n  collected_cells = set()                # primitives already taken\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the necessary number of times\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # primitive missing \u2013 abort early\n              return actions\n\n          # choose a free adjacent cell to stand on while picking up\n          adj = adjacent_free(target, avoid=collected_cells)\n          if adj is None:\n              # fallback: stand directly on the primitive cell\n              adj = target\n\n          # move to adjacent cell\n          actions += bfs_path(cur_pos, adj)\n          cur_pos = adj\n\n          # face the primitive (a blocked move updates direction)\n          dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # pick up the primitive\n          actions.append(USE)\n\n          # update internal grid copy\n          grid[target[0], target[1], prim_idx] = 0\n          collected_cells.add(target)\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          ws_adj = adjacent_free(ws_cell, avoid=collected_cells)\n          if ws_adj is None:\n              ws_adj = ws_cell  # stand directly on workshop if needed\n          actions += bfs_path(cur_pos, ws_adj)\n          cur_pos = ws_adj\n\n          # face the workshop (optional)\n          dy, dx = ws_cell[0] - cur_pos[0], ws_cell[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n  # trigger crafting\n  actions.append(USE)\n\n  return actions", "env_interactions": 37, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T18:03:02.168992", "function_name": "make_arrow", "function_body": "  # Reset environment and get current state/world\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world\n  # Make a mutable copy of the grid to keep track of collected items\n  grid = state.grid.copy()\n\n  # Action indices from the environment spec\n  specs = env.action_specs()\n  DOWN = specs[\"DOWN\"]\n  UP = specs[\"UP\"]\n  LEFT = specs[\"LEFT\"]\n  RIGHT = specs[\"RIGHT\"]\n  USE = specs[\"USE\"]\n\n  # Direction vectors paired with their action codes\n  DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def in_bounds(y, x):\n      return 0 <= y < grid.shape[0] and 0 <= x < grid.shape[1]\n\n  def is_blocked(y, x):\n      \"\"\"A cell is blocked if any entity occupies it.\"\"\"\n      return grid[y, x].any()\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that moves\n      the agent from ``start`` to ``goal`` while avoiding blocked cells.\"\"\"\n      if start == goal:\n          return []\n      from collections import deque\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          y, x = q.popleft()\n          if (y, x) == goal:\n              # reconstruct actions\n              rev = []\n              cur = goal\n              while cur != start:\n                  py, px = parent[cur]\n                  if cur[0] == py + 1:\n                      rev.append(DOWN)\n                  elif cur[0] == py - 1:\n                      rev.append(UP)\n                  elif cur[1] == px + 1:\n                      rev.append(RIGHT)\n                  elif cur[1] == px - 1:\n                      rev.append(LEFT)\n                  cur = (py, px)\n              return list(reversed(rev))\n          for dy, dx, act in DIRS:\n              ny, nx = y + dy, x + dx\n              if not in_bounds(ny, nx):\n                  continue\n              if (ny, nx) in visited:\n                  continue\n              if is_blocked(ny, nx):\n                  continue\n              visited.add((ny, nx))\n              parent[(ny, nx)] = (y, x)\n              q.append((ny, nx))\n      # No path found \u2013 return empty (will likely cause failure later)\n      return []\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Locate the closest cell containing ``kind_idx`` (primitive or workshop).\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[dists.argmin()]\n      return tuple(nearest)\n\n  def adjacent_free(cell, avoid=set()):\n      \"\"\"Return a free neighbouring cell (y, x) to ``cell`` that is not in ``avoid``.\"\"\"\n      y, x = cell\n      for dy, dx, _ in DIRS:\n          ny, nx = y + dy, x + dx\n          if not in_bounds(ny, nx):\n              continue\n          if (ny, nx) in avoid:\n              continue\n          if not is_blocked(ny, nx):\n              return (ny, nx)\n      return None\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow) and its required primitives\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed = world.cookbook.primitives_for(arrow_idx)   # {primitive_idx: count}\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = None\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n\n  actions = []\n  cur_pos = state.pos                     # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive\n  # ------------------------------------------------------------------\n  collected_cells = set()   # to avoid re\u2011using the same primitive cell\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive not present \u2013 abort early\n              return actions\n\n          # Choose a free adjacent cell to stand on while picking up\n          adj = adjacent_free(target, avoid=collected_cells)\n          if adj is None:\n              # If no free neighbour, fall back to standing on the primitive cell itself\n              adj = target\n\n          # Move to the adjacent (or same) cell\n          actions += bfs_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (add a move in that direction; it will be blocked)\n          dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update internal grid representation: primitive disappears\n          grid[target[0], target[1], prim_idx] = 0\n          collected_cells.add(target)\n\n  # ------------------------------------------------------------------\n  # Move to the workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          # Prefer a free neighbour of the workshop\n          ws_adj = adjacent_free(ws_cell, avoid=collected_cells)\n          if ws_adj is None:\n              # If none, stand directly on the workshop cell\n              ws_adj = ws_cell\n          actions += bfs_path(cur_pos, ws_adj)\n          cur_pos = ws_adj\n\n          # Face the workshop (optional \u2013 a blocked move to set direction)\n          dy, dx = ws_cell[0] - cur_pos[0], ws_cell[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n  # Trigger crafting at the current location\n  actions.append(USE)\n\n  return actions", "env_interactions": 37, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T18:03:23.408330", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  actions = []\n  spec = env.action_specs()\n  DOWN = spec['DOWN']\n  UP = spec['UP']\n  LEFT = spec['LEFT']\n  RIGHT = spec['RIGHT']\n  USE = spec['USE']\n\n  goal = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal)  # {primitive_idx: count}\n  state = env._current_state\n  pos = tuple(state.pos)\n\n  def _move(cur, tgt):\n      \"\"\"Manhattan moves from cur (x,y) to tgt (x,y).\"\"\"\n      moves = []\n      x, y = cur\n      tx, ty = tgt\n      while x < tx:\n          moves.append(DOWN)\n          x += 1\n      while x > tx:\n          moves.append(UP)\n          x -= 1\n      while y < ty:\n          moves.append(RIGHT)\n          y += 1\n      while y > ty:\n          moves.append(LEFT)\n          y -= 1\n      return moves\n\n  # Collect all required primitives\n  for prim_idx, cnt in needed.items():\n      # find all cells that currently contain this primitive\n      locations = list(zip(*np.where(state.grid[:, :, prim_idx] > 0)))\n      for _ in range(cnt):\n          if not locations:\n              break\n          target = locations.pop(0)\n          actions.extend(_move(pos, target))\n          pos = target\n          actions.append(USE)\n\n  # Move to the workshop (if the recipe specifies one) and craft\n  recipe = env.world.cookbook.recipes.get(goal, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      ws_locs = list(zip(*np.where(state.grid[:, :, workshop_idx] > 0)))\n      if ws_locs:\n          target = ws_locs[0]\n          actions.extend(_move(pos, target))\n          pos = target\n          actions.append(USE)\n\n  return actions", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:03:24.590566", "function_name": "make_arrow", "function_body": "  # Get action indices\n  spec = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      spec['DOWN'],\n      spec['UP'],\n      spec['LEFT'],\n      spec['RIGHT'],\n      spec['USE'],\n  )\n\n  # Goal item index\n  goal_idx = env.task.goal\n\n  # Primitive requirements for the goal\n  needed = env.world.cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n\n  # Current state snapshot (used for locating entities)\n  state = env._current_state\n  pos = tuple(state.pos)  # (x, y)\n\n  actions = []\n\n  def _move(cur, tgt):\n      \"\"\"Generate Manhattan moves from cur to tgt.\"\"\"\n      moves = []\n      x, y = cur\n      tx, ty = tgt\n      while x < tx:\n          moves.append(DOWN)\n          x += 1\n      while x > tx:\n          moves.append(UP)\n          x -= 1\n      while y < ty:\n          moves.append(RIGHT)\n          y += 1\n      while y > ty:\n          moves.append(LEFT)\n          y -= 1\n      return moves\n\n  def _nearest(cur, locs):\n      \"\"\"Return the nearest location to cur and remove it from locs.\"\"\"\n      if not locs:\n          return None\n      best = None\n      best_dist = None\n      for i, (lx, ly) in enumerate(locs):\n          d = abs(lx - cur[0]) + abs(ly - cur[1])\n          if best_dist is None or d < best_dist:\n              best_dist = d\n              best = i\n      return locs.pop(best)\n\n  # ---- Collect each required primitive ----\n  for prim_idx, count in needed.items():\n      # Find all cells currently containing this primitive\n      prim_locs = list(zip(*np.where(state.grid[:, :, prim_idx] > 0)))\n      for _ in range(count):\n          if not prim_locs:\n              # No more instances; abort early\n              break\n          target = _nearest(pos, prim_locs)\n          # Move to the primitive\n          actions.extend(_move(pos, target))\n          pos = target\n          # Pick it up\n          actions.append(USE)\n\n  # ---- Go to the appropriate workshop and craft ----\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      ws_locs = list(zip(*np.where(state.grid[:, :, workshop_idx] > 0)))\n      if ws_locs:\n          target_ws = _nearest(pos, ws_locs)\n          actions.extend(_move(pos, target_ws))\n          pos = target_ws\n          actions.append(USE)  # craft at the workshop\n\n  return actions", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:04:04.451217", "function_name": "make_arrow", "function_body": "  import collections, numpy as np\n\n  # ------------------------------------------------------------------ #\n  # Action indices\n  # ------------------------------------------------------------------ #\n  spec = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      spec[\"DOWN\"], spec[\"UP\"], spec[\"LEFT\"], spec[\"RIGHT\"], spec[\"USE\"]\n  )\n\n  # ------------------------------------------------------------------ #\n  # Current state and goal information\n  # ------------------------------------------------------------------ #\n  state = env._current_state\n  pos = tuple(state.pos)                     # agent position (x, y)\n  goal = env.task.goal                       # index of desired item\n  needed = env.world.cookbook.primitives_for(goal)  # {prim_idx: count}\n\n  # ------------------------------------------------------------------ #\n  # Grid copy for simulation (primitives will be removed as we pick them)\n  # ------------------------------------------------------------------ #\n  grid = state.grid.copy()\n  width, height = grid.shape[:2]\n\n  # ------------------------------------------------------------------ #\n  # Cells that permanently block movement (non\u2011grabbable entities)\n  # ------------------------------------------------------------------ #\n  non_grab = list(env.world.non_grabbable_indices)\n  if non_grab:\n      base_blocked = np.any(grid[:, :, non_grab] > 0, axis=2)\n  else:\n      base_blocked = np.zeros((width, height), dtype=bool)\n\n  # ------------------------------------------------------------------ #\n  # Helper: BFS returning a list of actions from start to target.\n  # allow_target_block=True lets us step onto a cell occupied by a\n  # primitive or workshop.\n  # ------------------------------------------------------------------ #\n  def bfs_path(start, target, allow_target_block=False):\n      blocked = base_blocked.copy()\n      if allow_target_block:\n          blocked[target[0], target[1]] = False\n\n      q = collections.deque([start])\n      came_from = {start: None}\n      action_from = {}\n\n      moves = [\n          (DOWN, (1, 0)),\n          (UP, (-1, 0)),\n          (RIGHT, (0, 1)),\n          (LEFT, (0, -1)),\n      ]\n\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          x, y = cur\n          for a, (dx, dy) in moves:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height and not blocked[nx, ny]:\n                  nxt = (nx, ny)\n                  if nxt not in came_from:\n                      came_from[nxt] = cur\n                      action_from[nxt] = a\n                      q.append(nxt)\n\n      if target not in came_from:\n          return None\n\n      # Reconstruct path\n      path = []\n      cur = target\n      while cur != start:\n          path.append(action_from[cur])\n          cur = came_from[cur]\n      path.reverse()\n      return path\n\n  # ------------------------------------------------------------------ #\n  # Simple Manhattan fallback when BFS fails.\n  # ------------------------------------------------------------------ #\n  def manhattan_path(start, target):\n      moves = []\n      x, y = start\n      tx, ty = target\n      while x < tx:\n          moves.append(DOWN)\n          x += 1\n      while x > tx:\n          moves.append(UP)\n          x -= 1\n      while y < ty:\n          moves.append(RIGHT)\n          y += 1\n      while y > ty:\n          moves.append(LEFT)\n          y -= 1\n      return moves\n\n  actions = []\n\n  # ------------------------------------------------------------------ #\n  # 1) Collect required primitives (may need several copies)\n  # ------------------------------------------------------------------ #\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not locations:\n              # No more copies left; abort collection for this primitive\n              break\n          # Choose the nearest instance (Manhattan distance)\n          target = min(\n              locations,\n              key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),\n          )\n          path = bfs_path(pos, target, allow_target_block=True)\n          if path is None:\n              path = manhattan_path(pos, target)\n          actions.extend(path)\n          actions.append(USE)                     # pick up primitive\n          # Update simulated position and grid\n          pos = target\n          grid[pos[0], pos[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------ #\n  # 2) If the goal itself is a primitive (no recipe), just pick it up\n  # ------------------------------------------------------------------ #\n  if not needed:\n      primitive_locs = list(zip(*np.where(grid[:, :, goal] > 0)))\n      if primitive_locs:\n          target = min(\n              primitive_locs,\n              key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),\n          )\n          path = bfs_path(pos, target, allow_target_block=True)\n          if path is None:\n              path = manhattan_path(pos, target)\n          actions.extend(path)\n          actions.append(USE)\n          return actions\n\n  # ------------------------------------------------------------------ #\n  # 3) Move to the workshop (if any) and craft the final item\n  # ------------------------------------------------------------------ #\n  recipe = env.world.cookbook.recipes.get(goal, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      ws_locations = list(zip(*np.where(state.grid[:, :, workshop_idx] > 0)))\n      if ws_locations:\n          target_ws = min(\n              ws_locations,\n              key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),\n          )\n          path = bfs_path(pos, target_ws, allow_target_block=True)\n          if path is None:\n              path = manhattan_path(pos, target_ws)\n          actions.extend(path)\n          actions.append(USE)                     # craft at workshop\n  else:\n      # No specific workshop required \u2013 just use at current location\n      actions.append(USE)\n\n  return actions", "env_interactions": 1, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:04:05.603511", "function_name": "make_arrow", "function_body": "  spec = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      spec[\"DOWN\"], spec[\"UP\"], spec[\"LEFT\"], spec[\"RIGHT\"], spec[\"USE\"]\n  )\n\n  state = env._current_state\n  pos = tuple(state.pos)                     # current agent position\n  goal = env.task.goal                        # index of desired item\n  needed = env.world.cookbook.primitives_for(goal)  # {prim_idx: count}\n\n  # copy of the grid to simulate removals after picking up primitives\n  grid = state.grid.copy()\n  width, height = grid.shape[:2]\n\n  # static blocked cells (non\u2011grabbable entities such as water, stone, etc.)\n  non_grab = list(env.world.non_grabbable_indices)\n  if non_grab:\n      base_blocked = np.any(grid[:, :, non_grab] > 0, axis=2)\n  else:\n      base_blocked = np.zeros((width, height), dtype=bool)\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions from start to target.\n  # If allow_target_block=True the target cell may be occupied (primitive or workshop)\n  # ----------------------------------------------------------------------\n  def bfs_path(start, target, allow_target_block=False):\n      blocked = base_blocked.copy()\n      if allow_target_block:\n          blocked[target[0], target[1]] = False\n      q = collections.deque([start])\n      came_from = {start: None}\n      action_from = {}\n      moves = [\n          (DOWN, (1, 0)),\n          (UP, (-1, 0)),\n          (RIGHT, (0, 1)),\n          (LEFT, (0, -1)),\n      ]\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          x, y = cur\n          for a, (dx, dy) in moves:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height and not blocked[nx, ny]:\n                  nxt = (nx, ny)\n                  if nxt not in came_from:\n                      came_from[nxt] = cur\n                      action_from[nxt] = a\n                      q.append(nxt)\n      if target not in came_from:\n          return None\n      # reconstruct path\n      path = []\n      cur = target\n      while cur != start:\n          path.append(action_from[cur])\n          cur = came_from[cur]\n      path.reverse()\n      return path\n\n  # ----------------------------------------------------------------------\n  # Helper: simple Manhattan path (fallback when BFS fails)\n  # ----------------------------------------------------------------------\n  def manhattan_path(start, target):\n      moves = []\n      x, y = start\n      tx, ty = target\n      while x < tx:\n          moves.append(DOWN)\n          x += 1\n      while x > tx:\n          moves.append(UP)\n          x -= 1\n      while y < ty:\n          moves.append(RIGHT)\n          y += 1\n      while y > ty:\n          moves.append(LEFT)\n          y -= 1\n      return moves\n\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # 1) Collect required primitives (if any)\n  # ----------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          # locate remaining instances of this primitive in the simulated grid\n          locs = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not locs:\n              # No more instances; break (should not happen in a solvable scenario)\n              break\n          # choose the closest instance by Manhattan distance\n          target = min(locs, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n          path = bfs_path(pos, target, allow_target_block=True)\n          if path is None:\n              path = manhattan_path(pos, target)\n          actions.extend(path)\n          actions.append(USE)                     # pick up the primitive\n          # update simulated state\n          pos = target\n          grid[pos[0], pos[1], prim_idx] = 0      # remove primitive from grid\n\n  # ----------------------------------------------------------------------\n  # 2) If the goal itself is a primitive (no recipe), just pick it up\n  # ----------------------------------------------------------------------\n  if not needed:\n      # goal is a primitive; find one instance and collect it\n      locs = list(zip(*np.where(grid[:, :, goal] > 0)))\n      if locs:\n          target = min(locs, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n          path = bfs_path(pos, target, allow_target_block=True)\n          if path is None:\n              path = manhattan_path(pos, target)\n          actions.extend(path)\n          actions.append(USE)\n          return actions\n\n  # ----------------------------------------------------------------------\n  # 3) Move to the appropriate workshop (if any) and craft the goal item\n  # ----------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      ws_locs = list(zip(*np.where(state.grid[:, :, workshop_idx] > 0)))\n      if ws_locs:\n          target_ws = min(\n              ws_locs,\n              key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),\n          )\n          path = bfs_path(pos, target_ws, allow_target_block=True)\n          if path is None:\n              path = manhattan_path(pos, target_ws)\n          actions.extend(path)\n          actions.append(USE)   # craft at the workshop\n  else:\n      # No specific workshop \u2013 just use at current location\n      actions.append(USE)\n\n  return actions", "env_interactions": 1, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:04:22.247514", "function_name": "make_arrow", "function_body": "  # Action indices (consistent with CraftWorld)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Determine current agent position (live state if available)\n  # ------------------------------------------------------------------\n  if hasattr(env, \"_current_state\") and env._current_state is not None:\n      cur_pos = list(env._current_state.pos)      # [x, y]\n  else:\n      cur_pos = list(env.scenario.init_pos)       # [x, y]\n\n  # Copy of the static grid so we can mark items as taken\n  grid = env.scenario.init_grid.copy()\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper: move from cur_pos to target, appending actions to seq\n  # ------------------------------------------------------------------\n  def _move_to(pos, target, seq):\n      \"\"\"Append actions that move the agent from `pos` to `target`.\"\"\"\n      while pos[0] != target[0] or pos[1] != target[1]:\n          if pos[0] < target[0]:\n              seq.append(RIGHT)\n              pos[0] += 1\n          elif pos[0] > target[0]:\n              seq.append(LEFT)\n              pos[0] -= 1\n          elif pos[1] < target[1]:\n              seq.append(DOWN)\n              pos[1] += 1\n          elif pos[1] > target[1]:\n              seq.append(UP)\n              pos[1] -= 1\n\n  # ------------------------------------------------------------------\n  # Helper: locate nearest cell (x, y) that contains the given kind index\n  # ------------------------------------------------------------------\n  def _nearest_kind(kind_idx, cur, g):\n      \"\"\"Return [x, y] of the nearest cell with `kind_idx`, or None.\"\"\"\n      ys, xs = np.where(g[:, :, kind_idx] > 0)\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - cur[0]) + np.abs(ys - cur[1])\n      best = int(np.argmin(dists))\n      return [int(xs[best]), int(ys[best])]\n\n  # ------------------------------------------------------------------\n  # 1. Gather all primitive resources required for the goal item\n  # ------------------------------------------------------------------\n  goal_idx = env.task.goal  # integer index of the target item\n  primitive_needs = env.world.cookbook.primitives_for(goal_idx).copy()\n\n  # If the goal itself is a primitive, we must also pick it up.\n  if goal_idx in env.world.cookbook.primitives:\n      primitive_needs[goal_idx] = primitive_needs.get(goal_idx, 0) + 1\n\n  for kind_idx, count in primitive_needs.items():\n      for _ in range(count):\n          target = _nearest_kind(kind_idx, cur_pos, grid)\n          if target is None:\n              # Required primitive not present; abort planning.\n              return actions\n          _move_to(cur_pos, target, actions)\n          actions.append(USE)  # pick up the primitive\n          # Mark the item as taken in our copy of the grid.\n          grid[target[1], target[0], kind_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 2. If the recipe specifies a workshop, go there and craft the item\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      workshop_pos = _nearest_kind(workshop_kind, cur_pos, grid)\n      if workshop_pos is not None:\n          _move_to(cur_pos, workshop_pos, actions)\n          actions.append(USE)  # craft at the workshop\n\n  # ------------------------------------------------------------------\n  # Return the planned sequence of actions\n  # ------------------------------------------------------------------\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:04:23.360948", "function_name": "make_arrow", "function_body": "  # Action indices\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Determine current position (live state if available, else start pos)\n  # ------------------------------------------------------------------\n  if hasattr(env, \"_current_state\") and env._current_state is not None:\n      cur_pos = list(env._current_state.pos)          # [x, y]\n  else:\n      cur_pos = list(env.scenario.init_pos)           # [x, y]\n\n  # Work on a mutable copy of the static grid to track taken items\n  grid = env.scenario.init_grid.copy()\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def _move_to(pos, target, seq):\n      \"\"\"Append moves that bring `pos` (list [x, y]) to `target` (list [x, y]).\"\"\"\n      while pos[0] != target[0] or pos[1] != target[1]:\n          if pos[0] < target[0]:\n              seq.append(RIGHT)\n              pos[0] += 1\n          elif pos[0] > target[0]:\n              seq.append(LEFT)\n              pos[0] -= 1\n          elif pos[1] < target[1]:\n              seq.append(DOWN)\n              pos[1] += 1\n          elif pos[1] > target[1]:\n              seq.append(UP)\n              pos[1] -= 1\n\n  def _nearest_kind(kind_idx, cur, g):\n      \"\"\"Return coordinates [x, y] of the nearest cell containing `kind_idx`.\"\"\"\n      ys, xs = np.where(g[:, :, kind_idx] > 0)\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - cur[0]) + np.abs(ys - cur[1])\n      best = int(np.argmin(dists))\n      return [int(xs[best]), int(ys[best])]\n\n  # ------------------------------------------------------------------\n  # 1. Collect all primitive resources required for the goal item\n  # ------------------------------------------------------------------\n  goal_idx = env.task.goal                                 # integer index of target\n  primitive_requirements = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n\n  for prim_kind, count in primitive_requirements.items():\n      for _ in range(count):\n          target = _nearest_kind(prim_kind, cur_pos, grid)\n          if target is None:\n              # Primitive missing \u2013 abort planning; return what we have so far\n              return actions\n          _move_to(cur_pos, target, actions)\n          actions.append(USE)                               # pick up primitive\n          grid[target[1], target[0], prim_kind] = 0         # mark cell as empty\n\n  # ------------------------------------------------------------------\n  # 2. If the recipe specifies a workshop, move there and craft the item\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      workshop_pos = _nearest_kind(workshop_kind, cur_pos, grid)\n      if workshop_pos is not None:\n          _move_to(cur_pos, workshop_pos, actions)\n          actions.append(USE)                               # craft at workshop\n\n  # ------------------------------------------------------------------\n  # Return the complete planned action sequence\n  # ------------------------------------------------------------------\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:04:56.219882", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Helper: BFS that returns a list of movement actions (DOWN/UP/LEFT/RIGHT)\n  #         which ends with the agent standing next to *target_kind* and\n  #         facing it, ready for a USE action.\n  # ----------------------------------------------------------------------\n  # Direction order matches the action constants used by CraftWorld:\n  #   0: DOWN, 1: UP, 2: LEFT, 3: RIGHT\n  deltas = [(1, 0), (-1, 0), (0, -1), (0, 1)]\n\n  def _bfs_to_target(state, target_kind):\n      grid = state.grid\n      h, w, _ = grid.shape\n      non_grab = env.world.non_grabbable_indices\n\n      def in_bounds(r, c):\n          return 0 <= r < h and 0 <= c < w\n\n      def walkable(r, c):\n          if not in_bounds(r, c):\n              return False\n          # a cell is blocked only by non\u2011grabbable entities\n          return not np.any(grid[r, c, list(non_grab)])\n\n      from collections import deque\n      q = deque()\n      start_r, start_c = state.pos\n      start_dir = state.dir\n      q.append((start_r, start_c, start_dir, []))\n      visited = {(start_r, start_c, start_dir)}\n\n      while q:\n          r, c, d, acts = q.popleft()\n          dr, dc = deltas[d]\n          fr, fc = r + dr, c + dc\n          if in_bounds(fr, fc) and grid[fr, fc, target_kind] > 0:\n              return acts\n          for a in range(4):\n              nr, nc = r + deltas[a][0], c + deltas[a][1]\n              if not walkable(nr, nc):\n                  continue\n              if (nr, nc, a) in visited:\n                  continue\n              visited.add((nr, nc, a))\n              q.append((nr, nc, a, acts + [a]))\n      # target not reachable\n      return []\n\n  # ----------------------------------------------------------------------\n  # Main planning logic\n  # ----------------------------------------------------------------------\n  actions = []\n  cur_state = env._current_state\n  world = env.world\n  goal_idx = env.task.goal\n\n  # Primitive requirements for the goal (e.g., arrow)\n  primitive_needs = world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n\n  # Determine workshop (if the recipe specifies one)\n  workshop_kind = None\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  if isinstance(recipe, dict):\n      workshop_name = recipe.get('_at')\n      if workshop_name is not None:\n          workshop_kind = world.cookbook.index.index(workshop_name)\n\n  # --------------------------------------------------------------\n  # Collect each required primitive the necessary number of times\n  # --------------------------------------------------------------\n  for prim_kind, count in primitive_needs.items():\n      for _ in range(count):\n          path = _bfs_to_target(cur_state, prim_kind)\n          # If BFS failed, abort early \u2013 whatever actions we have are returned\n          if path is None:\n              return actions\n          actions.extend(path)\n          # Apply movement actions to keep cur_state in sync\n          for a in path:\n              _, cur_state = cur_state.step(a)\n          # Use to pick up the primitive\n          actions.append(4)          # USE\n          _, cur_state = cur_state.step(4)\n\n  # --------------------------------------------------------------\n  # Move to the workshop (if any) and craft the goal item\n  # --------------------------------------------------------------\n  if workshop_kind is not None:\n      path = _bfs_to_target(cur_state, workshop_kind)\n      actions.extend(path)\n      for a in path:\n          _, cur_state = cur_state.step(a)\n      actions.append(4)              # USE to craft at the workshop\n      _, cur_state = cur_state.step(4)\n  else:\n      # No specific workshop \u2013 try crafting in place\n      actions.append(4)              # USE\n      _, cur_state = cur_state.step(4)\n\n  return actions", "env_interactions": 1, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:04:57.340288", "function_name": "make_arrow", "function_body": "  # Reset environment and get initial mutable state\n  env.reset()\n  cur_state = env._current_state          # CraftState\n  world = env.world\n\n  # ------------------------------------------------------------------\n  # Identify the index of the goal item \"arrow\"\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:   # not defined\n      return []\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a sequence of actions (0\u20114) moving the\n  # agent so that the cell directly in front contains `target_kind`.\n  # ------------------------------------------------------------------\n  def _bfs_to_target(state, target_kind):\n      grid = state.grid\n      W, H = grid.shape[:2]          # width, height\n      # direction deltas matching action indices\n      deltas = {\n          0: (0, 1),   # DOWN\n          1: (0, -1),  # UP\n          2: (-1, 0),  # LEFT\n          3: (1, 0),   # RIGHT\n      }\n      non_grab = env.world.non_grabbable_indices\n\n      def in_bounds(x, y):\n          return 0 <= x < W and 0 <= y < H\n\n      def walkable(x, y):\n          if not in_bounds(x, y):\n              return False\n          # cell must be completely empty (no entities of any kind)\n          return not np.any(grid[x, y, :])\n\n      start_pos = state.pos\n      start_dir = state.dir\n      from collections import deque\n      queue = deque()\n      queue.append((start_pos[0], start_pos[1], start_dir, []))\n      visited = {(start_pos[0], start_pos[1], start_dir)}\n\n      while queue:\n          x, y, d, acts = queue.popleft()\n          # Check if the cell directly ahead contains the target\n          dx, dy = deltas[d]\n          fx, fy = x + dx, y + dy\n          if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:\n              return acts\n          # Expand possible movement actions (0\u20113)\n          for a in (0, 1, 2, 3):\n              ndx, ndy = deltas[a]\n              nx, ny = x + ndx, y + ndy\n              if not walkable(nx, ny):\n                  continue\n              if (nx, ny, a) in visited:\n                  continue\n              visited.add((nx, ny, a))\n              queue.append((nx, ny, a, acts + [a]))\n      # No reachable target\n      return []\n\n  # ------------------------------------------------------------------\n  # Determine primitive requirements for a single arrow\n  # ------------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the necessary number of times\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in primitive_needs.items():\n      for _ in range(cnt):\n          move_actions = _bfs_to_target(cur_state, prim_idx)\n          if not move_actions and not cur_state.next_to(prim_idx):\n              # Unable to reach the primitive \u2013 abort early\n              return actions\n          actions.extend(move_actions)\n          actions.append(4)                     # USE to pick up\n          # Apply actions to keep cur_state in sync\n          for a in move_actions + [4]:\n              _, cur_state = cur_state.step(a)\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any)\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      # workshop_name is a string; get its index\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      move_actions = _bfs_to_target(cur_state, workshop_idx)\n      if move_actions:\n          actions.extend(move_actions)\n          actions.append(4)                     # USE to craft\n          for a in move_actions + [4]:\n              _, cur_state = cur_state.step(a)\n  else:\n      # No specific workshop \u2013 just attempt crafting in place\n      actions.append(4)                         # USE to craft\n      _, cur_state = cur_state.step(4)\n\n  return actions", "env_interactions": 26, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T18:05:22.249771", "function_name": "make_arrow", "function_body": "  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]  # DOWN, UP, LEFT, RIGHT\n\n  def bfs(start, targets, blocked):\n      \"\"\"Bread\u2011first search returning a list of action indices that reaches any target cell.\"\"\"\n      w, h = grid.shape[:2]\n      q = collections.deque([(start, [])])\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in targets:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not blocked[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []  # Should never happen for a solvable scenario\n\n  def go_to_and_use(kind_idx, count):\n      \"\"\"Move to cells containing `kind_idx` and USE them `count` times.\"\"\"\n      nonlocal pos, actions\n      for _ in range(count):\n          cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, kind_idx] > 0}\n          path = bfs(pos, cells, blocked)\n          actions.extend(path)\n          for a in path:\n              dx, dy = DIRS[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(4)  # USE action\n\n  # ------------------------------------------------------------------\n  # Gather recipe information for the target item \"arrow\"\n  # ------------------------------------------------------------------\n  world = env.world\n  cookbook = world.cookbook\n  arrow_idx = cookbook.index[\"arrow\"]\n\n  needed_prims = {}          # primitive kind -> total count needed\n  craft_steps = []           # ordered list of (item_idx, count)\n\n  def resolve(item_idx, mult):\n      \"\"\"Recursively collect primitive requirements and schedule crafting steps.\"\"\"\n      rec = cookbook.recipes.get(item_idx)\n      if rec is None:                     # primitive (no recipe entry)\n          needed_prims[item_idx] = needed_prims.get(item_idx, 0) + mult\n          return\n      # Resolve ingredient requirements first\n      for ing, cnt in rec.items():\n          if isinstance(ing, int):\n              resolve(ing, cnt * mult)\n      # Then schedule crafting of this item\n      craft_steps.append((item_idx, mult))\n\n  resolve(arrow_idx, 1)\n\n  # ------------------------------------------------------------------\n  # Static data: grid, blocked cells, dimensions\n  # ------------------------------------------------------------------\n  grid = env._current_state.grid\n  w, h, _ = grid.shape\n  blocked = np.zeros((w, h), dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # ------------------------------------------------------------------\n  # Build the final action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  pos = tuple(env._current_state.pos)\n\n  # 1) Collect all required primitive resources\n  for kind_idx, cnt in needed_prims.items():\n      go_to_and_use(kind_idx, cnt)\n\n  # 2) Perform crafting steps at the appropriate workshops\n  for item_idx, cnt in craft_steps:\n      rec = cookbook.recipes[item_idx]\n      wk_key = rec.get(\"_at\", rec.get(\"_key\"))\n      wk_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]\n\n      wk_cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, wk_idx] > 0}\n      path = bfs(pos, wk_cells, blocked)\n      actions.extend(path)\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n\n      actions.extend([4] * cnt)   # USE at workshop the required number of times\n\n  return actions", "env_interactions": 20, "island_id": 6, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T18:05:23.351398", "function_name": "make_arrow", "function_body": "  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]", "env_interactions": 0, "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-10-28T18:06:03.591073", "function_name": "make_arrow", "function_body": "  # ------------------------------------------------------------------\n  # Action constants (matching CraftWorld definitions)\n  # ------------------------------------------------------------------\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: move position according to an action (assumes move succeeds)\n  # ------------------------------------------------------------------\n  def _move(pos, act):\n      x, y = pos\n      if act == RIGHT:\n          return (x + 1, y)\n      if act == LEFT:\n          return (x - 1, y)\n      if act == DOWN:\n          return (x, y + 1)\n      if act == UP:\n          return (x, y - 1)\n      return pos\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions leading to a cell\n  # adjacent to any target location (target cells may be occupied).\n  # Also returns the final adjacent position.\n  # ------------------------------------------------------------------\n  def _bfs_adjacent(start, targets, occupied):\n      from collections import deque\n      w, h = occupied.shape\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # check adjacency to any target\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path, (x, y)\n          # explore neighbours\n          for act, (dx, dy) in ((RIGHT, (1, 0)), (LEFT, (-1, 0)),\n                                (DOWN, (0, 1)), (UP, (0, -1))):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and not occupied[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # no reachable adjacent cell\n      return [], start\n\n  # ------------------------------------------------------------------\n  # Retrieve world and cookbook objects\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Some wrappers expose the world via the current state\n      world = getattr(env, \"_current_state\", None).world\n  cookbook = world.cookbook\n\n  # ------------------------------------------------------------------\n  # Goal: make an \"arrow\"\n  # ------------------------------------------------------------------\n  goal_idx = cookbook.index[\"arrow\"]\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Ensure we have a current state (reset if necessary)\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  pos = tuple(state.pos)          # (x, y)\n  direction = int(state.dir)      # current facing direction\n  grid = state.grid               # (W, H, n_kinds)\n\n  # We'll work on a mutable copy of the grid to reflect collected items\n  mutable_grid = np.copy(grid)\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Collect all required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      gathered = 0\n      while gathered < needed_cnt:\n          # locate remaining instances of this primitive\n          locations = [tuple(p) for p in np.argwhere(mutable_grid[:, :, prim_idx] > 0)]\n          if not locations:\n              # no more primitives of this type \u2013 break to avoid infinite loop\n              break\n          # pick the closest one\n          locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target = locations[0]\n\n          # occupied cells for path\u2011finding (ignore the target itself \u2013 it is blocked)\n          occupied = np.any(mutable_grid > 0, axis=2)\n\n          # find path to a free cell adjacent to the target\n          path, pos = _bfs_adjacent(pos, [target], occupied)\n          actions.extend(path)\n\n          # update position following the path\n          for act in path:\n              pos = _move(pos, act)\n              direction = act\n\n          # determine which direction we must face to interact with the target\n          tx, ty = target\n          needed_dir = None\n          if tx > pos[0]:\n              needed_dir = RIGHT\n          elif tx < pos[0]:\n              needed_dir = LEFT\n          elif ty > pos[1]:\n              needed_dir = DOWN\n          elif ty < pos[1]:\n              needed_dir = UP\n\n          # adjust facing direction if necessary (a single turn action suffices)\n          if needed_dir is not None and direction != needed_dir:\n              actions.append(needed_dir)\n              direction = needed_dir\n\n          # pick up the primitive\n          actions.append(USE)\n          gathered += 1\n\n          # mark the cell as empty in our mutable copy\n          mutable_grid[tx, ty, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if the recipe specifies one) and craft\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # resolve workshop index (may be a string name)\n      workshop_idx = (cookbook.index[workshop_key]\n                      if isinstance(workshop_key, str)\n                      else workshop_key)\n\n      # locate workshop cells (they are not consumable, so we keep the original grid)\n      workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if workshop_cells:\n          workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          ws_target = workshop_cells[0]\n\n          occupied = np.any(mutable_grid > 0, axis=2)\n          path, pos = _bfs_adjacent(pos, [ws_target], occupied)\n          actions.extend(path)\n\n          for act in path:\n              pos = _move(pos, act)\n              direction = act\n\n          # face the workshop\n          wx, wy = ws_target\n          needed_dir = None\n          if wx > pos[0]:\n              needed_dir = RIGHT\n          elif wx < pos[0]:\n              needed_dir = LEFT\n          elif wy > pos[1]:\n              needed_dir = DOWN\n          elif wy < pos[1]:\n              needed_dir = UP\n\n          if needed_dir is not None and direction != needed_dir:\n              actions.append(needed_dir)\n              direction = needed_dir\n\n          # craft the arrow\n          actions.append(USE)\n\n  # ------------------------------------------------------------------\n  # Return the complete action list\n  # ------------------------------------------------------------------\n  return actions", "env_interactions": 15, "island_id": 4, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T18:06:04.763632", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Basic movement helper: returns new position and updates direction.\n  # ----------------------------------------------------------------------\n  def _step(pos, direction, act):\n      x, y = pos\n      # movement vectors\n      if act == 0:   # DOWN\n          dx, dy = 0, 1\n      elif act == 1:  # UP\n          dx, dy = 0, -1\n      elif act == 2:  # LEFT\n          dx, dy = -1, 0\n      elif act == 3:  # RIGHT\n          dx, dy = 1, 0\n      else:  # USE does not change position\n          return pos, act\n      nx, ny = x + dx, y + dy\n      # check bounds and blockage\n      if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and not occupied[nx, ny]:\n          return (nx, ny), act\n      else:\n          # cannot move, but direction still becomes act\n          return pos, act\n\n  # ----------------------------------------------------------------------\n  # BFS that returns a list of actions moving the agent to a cell that is\n  # orthogonally adjacent to any of the target positions.\n  # ----------------------------------------------------------------------\n  def _bfs_adj(start, targets):\n      w, h, _ = grid.shape\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n      while q:\n          x, y, path = q.popleft()\n          # if adjacent to a target, stop\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path, (x, y)\n          # explore neighbours\n          for act, (dx, dy) in ((0, (0, 1)), (1, (0, -1)), (2, (-1, 0)), (3, (1, 0))):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and not occupied[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # fallback: stay where we are\n      return [], start\n\n  # ----------------------------------------------------------------------\n  # Retrieve world, cookbook and goal information.\n  # ----------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      world = getattr(env, \"_current_state\", None).world\n  cookbook = world.cookbook\n  goal_idx = cookbook.index[\"arrow\"]\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ----------------------------------------------------------------------\n  # Ensure we have a current state (reset if needed) and extract data.\n  # ----------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n  pos = tuple(state.pos)\n  direction = int(state.dir)\n  grid = state.grid\n  occupied = np.any(grid > 0, axis=2)\n\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive.\n  # ----------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      # locate all cells containing this primitive\n      prim_cells = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # sort by Manhattan distance from current position\n      prim_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n      collected = 0\n      for cell in prim_cells:\n          if collected >= needed:\n              break\n          # move adjacent to the primitive\n          path, pos = _bfs_adj(pos, [cell])\n          actions.extend(path)\n          for act in path:\n              pos, direction = _step(pos, direction, act)\n\n          # determine direction needed to face the primitive\n          dx = cell[0] - pos[0]\n          dy = cell[1] - pos[1]\n          needed_dir = None\n          if dx == 1:\n              needed_dir = 3          # RIGHT\n          elif dx == -1:\n              needed_dir = 2          # LEFT\n          elif dy == 1:\n              needed_dir = 0          # DOWN\n          elif dy == -1:\n              needed_dir = 1          # UP\n\n          if needed_dir is not None and direction != needed_dir:\n              # turn by attempting a move in the desired direction;\n              # if the cell ahead is blocked the position stays but direction changes\n              actions.append(needed_dir)\n              pos, direction = _step(pos, direction, needed_dir)\n\n          # pick up the primitive\n          actions.append(4)  # USE\n          collected += 1\n\n  # ----------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any).\n  # ----------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      workshop_idx = cookbook.index[workshop_key] if isinstance(workshop_key, str) else workshop_key\n      workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if workshop_cells:\n          workshop_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          target_ws = workshop_cells[0]\n          path, pos = _bfs_adj(pos, [target_ws])\n          actions.extend(path)\n          for act in path:\n              pos, direction = _step(pos, direction, act)\n\n          # face the workshop\n          dx = target_ws[0] - pos[0]\n          dy = target_ws[1] - pos[1]\n          needed_dir = None\n          if dx == 1:\n              needed_dir = 3\n          elif dx == -1:\n              needed_dir = 2\n          elif dy == 1:\n              needed_dir = 0\n          elif dy == -1:\n              needed_dir = 1\n          if needed_dir is not None and direction != needed_dir:\n              actions.append(needed_dir)\n              pos, direction = _step(pos, direction, needed_dir)\n\n          # craft using the workshop\n          actions.append(4)  # USE\n\n  return actions", "env_interactions": 28, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:06:23.402353", "function_name": "make_arrow", "function_body": "  env.reset()\n  cur_state = env._current_state          # CraftState\n  world = env.world\n\n  # --------------------------------------------------------------\n  # Identify the index of the goal item \"arrow\"\n  # --------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:   # not defined in this world\n      return []\n\n  # --------------------------------------------------------------\n  # Helper: BFS that returns a list of movement actions (0\u20113) that\n  # brings the agent to a position where the cell directly in front\n  # contains `target_kind`. Returns [] if unreachable.\n  # --------------------------------------------------------------\n  def _bfs_to_target(state, target_kind):\n      grid = state.grid\n      W, H = grid.shape[:2]\n\n      # direction deltas matching action indices\n      deltas = {\n          0: (0, 1),   # DOWN\n          1: (0, -1),  # UP\n          2: (-1, 0),  # LEFT\n          3: (1, 0),   # RIGHT\n      }\n\n      def in_bounds(x, y):\n          return 0 <= x < W and 0 <= y < H\n\n      def walkable(x, y):\n          if not in_bounds(x, y):\n              return False\n          # a cell is walkable if it contains no entities at all\n          return not np.any(grid[x, y, :])\n\n      start_pos = state.pos\n      start_dir = state.dir\n      from collections import deque\n      queue = deque()\n      queue.append((start_pos[0], start_pos[1], start_dir, []))\n      visited = {(start_pos[0], start_pos[1], start_dir)}\n\n      while queue:\n          x, y, d, acts = queue.popleft()\n          # Check whether the cell directly ahead holds the target\n          dx, dy = deltas[d]\n          fx, fy = x + dx, y + dy\n          if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:\n              return acts\n\n          # Explore movement actions (0\u20113)\n          for a in (0, 1, 2, 3):\n              ndx, ndy = deltas[a]\n              nx, ny = x + ndx, y + ndy\n              if not walkable(nx, ny):\n                  continue\n              if (nx, ny, a) in visited:\n                  continue\n              visited.add((nx, ny, a))\n              queue.append((nx, ny, a, acts + [a]))\n\n      # Unreachable\n      return []\n\n  # --------------------------------------------------------------\n  # Determine primitive requirements for a single arrow\n  # --------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}\n  actions = []\n\n  # --------------------------------------------------------------\n  # Collect each required primitive the necessary number of times\n  # --------------------------------------------------------------\n  for prim_idx, count in primitive_needs.items():\n      for _ in range(count):\n          move_actions = _bfs_to_target(cur_state, prim_idx)\n          # If BFS failed but we are already adjacent, we can still pick up\n          if not move_actions and not cur_state.next_to(prim_idx):\n              # cannot reach this primitive \u2013 abort early\n              return actions\n          actions.extend(move_actions)\n          actions.append(4)                     # USE to pick up\n          # Apply actions to keep cur_state in sync\n          for a in move_actions + [4]:\n              _, cur_state = cur_state.step(a)\n\n  # --------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any)\n  # --------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      move_actions = _bfs_to_target(cur_state, workshop_idx)\n      actions.extend(move_actions)\n      actions.append(4)                     # USE to craft\n      for a in move_actions + [4]:\n          _, cur_state = cur_state.step(a)\n  else:\n      # No specific workshop \u2013 just attempt crafting in place\n      actions.append(4)                     # USE to craft\n      _, cur_state = cur_state.step(4)\n\n  return actions", "env_interactions": 26, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T18:06:24.524992", "function_name": "make_arrow", "function_body": "  # Reset environment and obtain the initial state\n  env.reset()\n  cur_state = env._current_state          # CraftState\n  world = env.world\n\n  # --------------------------------------------------------------\n  # Identify the index of the goal item \"arrow\"\n  # --------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:   # not defined in the recipe set\n      return []\n\n  # --------------------------------------------------------------\n  # Helper: BFS that returns a list of movement actions (0\u20113) that\n  # moves the agent so that the cell directly in front contains\n  # `target_kind`.  The returned actions also leave the agent facing\n  # that cell.\n  # --------------------------------------------------------------\n  def _bfs_to_target(state, target_kind):\n      grid = state.grid\n      W, H = grid.shape[:2]\n\n      # direction deltas matching action indices\n      deltas = {\n          0: (0, 1),   # DOWN\n          1: (0, -1),  # UP\n          2: (-1, 0),  # LEFT\n          3: (1, 0),   # RIGHT\n      }\n\n      def in_bounds(x, y):\n          return 0 <= x < W and 0 <= y < H\n\n      def walkable(x, y):\n          if not in_bounds(x, y):\n              return False\n          # a cell is walkable if it contains no entities of any kind\n          return not np.any(grid[x, y, :])\n\n      start_x, start_y = state.pos\n      start_dir = state.dir\n\n      from collections import deque\n      queue = deque()\n      queue.append((start_x, start_y, start_dir, []))\n      visited = {(start_x, start_y, start_dir)}\n\n      while queue:\n          x, y, d, acts = queue.popleft()\n          dx, dy = deltas[d]\n          fx, fy = x + dx, y + dy\n          if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:\n              return acts\n          for a in (0, 1, 2, 3):\n              ndx, ndy = deltas[a]\n              nx, ny = x + ndx, y + ndy\n              if not walkable(nx, ny):\n                  continue\n              if (nx, ny, a) in visited:\n                  continue\n              visited.add((nx, ny, a))\n              queue.append((nx, ny, a, acts + [a]))\n      # Target not reachable\n      return []\n\n  # --------------------------------------------------------------\n  # Determine which primitive resources are needed for one arrow\n  # --------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}\n  actions = []\n\n  # --------------------------------------------------------------\n  # Collect each required primitive the necessary number of times\n  # --------------------------------------------------------------\n  for prim_idx, cnt in primitive_needs.items():\n      for _ in range(cnt):\n          # If we are already adjacent to the primitive, no movement needed\n          if not cur_state.next_to(prim_idx):\n              move_actions = _bfs_to_target(cur_state, prim_idx)\n              if not move_actions:\n                  # Unable to reach this primitive; abort early\n                  return actions\n              actions.extend(move_actions)\n              for a in move_actions:\n                  _, cur_state = cur_state.step(a)\n          # Use action (index 4) to pick up the primitive\n          actions.append(4)\n          _, cur_state = cur_state.step(4)\n\n  # --------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any)\n  # --------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      if not cur_state.next_to(workshop_idx):\n          move_actions = _bfs_to_target(cur_state, workshop_idx)\n          if move_actions:\n              actions.extend(move_actions)\n              for a in move_actions:\n                  _, cur_state = cur_state.step(a)\n      actions.append(4)                 # USE to craft at the workshop\n      _, cur_state = cur_state.step(4)\n  else:\n      # No specific workshop \u2013 just attempt crafting in place\n      actions.append(4)                 # USE to craft\n      _, cur_state = cur_state.step(4)\n\n  return actions", "env_interactions": 21, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:06:53.103738", "function_name": "make_arrow", "function_body": "  # Action indices\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  moves = [((0, 1), DOWN),   # down  (y+1)\n           ((0, -1), UP),    # up    (y-1)\n           ((-1, 0), LEFT),  # left  (x-1)\n           ((1, 0), RIGHT)]  # right (x+1)\n\n  def bfs_path(start, goal, grid):\n      \"\"\"Return a list of actions moving from start to goal using BFS.\n      Cells with any non\u2011zero kind are treated as blocked, except the goal\n      cell itself (which may hold the target item).\"\"\"\n      w, h = grid.shape[0], grid.shape[1]\n      from collections import deque\n      q = deque([tuple(start)])\n      prev = {tuple(start): (None, None)}          # pos -> (prev_pos, action)\n\n      while q:\n          x, y = q.popleft()\n          if (x, y) == tuple(goal):\n              break\n          for (dx, dy), act in moves:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < w and 0 <= ny < h):\n                  continue\n              if (nx, ny) in prev:\n                  continue\n              # allow stepping onto the goal cell even if occupied\n              if (nx, ny) != tuple(goal) and grid[nx, ny].sum() != 0:\n                  continue\n              prev[(nx, ny)] = ((x, y), act)\n              q.append((nx, ny))\n\n      if tuple(goal) not in prev:\n          return []   # unreachable\n\n      # reconstruct path\n      path = []\n      cur = tuple(goal)\n      while prev[cur][0] is not None:\n          cur, act = prev[cur]\n          path.append(act)\n      path.reverse()\n      return path\n\n  def nearest_kind(kind_idx, cur_pos, grid):\n      \"\"\"Find the nearest cell containing the requested kind (Manhattan).\"\"\"\n      xs, ys = np.where(grid[:, :, kind_idx] > 0)   # x\u2011cols, y\u2011rows\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])\n      best = int(np.argmin(dists))\n      return [int(xs[best]), int(ys[best])]\n\n  # ------------------------------------------------------------------\n  # Determine current position (live state if available)\n  # ------------------------------------------------------------------\n  if hasattr(env, \"_current_state\") and env._current_state is not None:\n      cur_pos = list(env._current_state.pos)\n  else:\n      cur_pos = list(env.scenario.init_pos)\n\n  # Copy of the static grid so we can mark items as taken\n  grid = env.scenario.init_grid.copy()\n\n  actions = []\n  goal_idx = env.task.goal\n\n  # ------------------------------------------------------------------\n  # 1. Gather all primitive resources required for the goal\n  # ------------------------------------------------------------------\n  primitive_requirements = env.world.cookbook.primitives_for(goal_idx).copy()\n\n  # If the goal itself is a primitive, we need to pick it up as well\n  if goal_idx in env.world.cookbook.primitives:\n      primitive_requirements[goal_idx] = primitive_requirements.get(goal_idx, 0) + 1\n\n  for prim_kind, needed in primitive_requirements.items():\n      for _ in range(needed):\n          target = nearest_kind(prim_kind, cur_pos, grid)\n          if target is None:\n              # Primitive not found \u2013 abort planning\n              return actions\n          actions.extend(bfs_path(cur_pos, target, grid))\n          actions.append(USE)                     # pick up primitive\n          # Remove the primitive from our planning grid\n          grid[target[0], target[1], prim_kind] = 0\n          cur_pos = target\n\n  # ------------------------------------------------------------------\n  # 2. Move to the appropriate workshop (if any) and craft the goal item\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      workshop_pos = nearest_kind(workshop_kind, cur_pos, grid)\n      if workshop_pos is not None:\n          actions.extend(bfs_path(cur_pos, workshop_pos, grid))\n          actions.append(USE)   # perform crafting at the workshop\n          cur_pos = workshop_pos\n\n  # Return the complete action sequence\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:06:54.207327", "function_name": "make_arrow", "function_body": "", "env_interactions": 0, "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-10-28T18:07:32.192398", "function_name": "make_arrow", "function_body": "  import collections\n  import numpy as np\n\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Helper: BFS returns a list of actions that moves the agent from `start`\n  # to a cell adjacent (Manhattan distance 1) to any cell in `targets`.\n  def _bfs_path(start, targets, grid):\n      w, h, _ = grid.shape\n      occupied = np.any(grid > 0, axis=2)          # True where any entity exists\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # Check if we are adjacent to a target (or on it)\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n              if (x, y) == (tx, ty):\n                  return path\n          # Explore neighbours\n          for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # No reachable position\n      return []\n\n  # ------------------------------------------------------------------\n  # Retrieve world, cookbook and goal information (goal = \"arrow\")\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      state_tmp = getattr(env, \"_current_state\", None)\n      if state_tmp is not None:\n          world = state_tmp.world\n  cookbook = world.cookbook\n\n  goal_idx = cookbook.index[\"arrow\"]\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Ensure we have a current state (reset if needed)\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  pos = tuple(state.pos)          # (x, y)\n  grid = state.grid.copy()        # mutable copy for occupancy queries\n\n  actions = []\n  harvested = set()               # cells already used for collection\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      # Locate all cells containing this primitive\n      locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # Greedy nearest\u2011first ordering\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      collected = 0\n      for loc in locations:\n          if collected >= needed:\n              break\n          if loc in harvested:\n              continue\n          # Move adjacent to the primitive\n          path = _bfs_path(pos, [loc], grid)\n          actions.extend(path)\n          # Simulate movement to keep `pos` up\u2011to\u2011date\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Pick up the primitive\n          actions.append(USE)\n          harvested.add(loc)\n          collected += 1\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its workshop (if the recipe specifies one)\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (string name or integer)\n      ws_idx = (cookbook.index[workshop_key]\n                if isinstance(workshop_key, str) else workshop_key)\n      # Find workshop cells\n      ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, ws_idx] > 0)]\n      if ws_cells:\n          ws_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = ws_cells[0]\n          # Move adjacent to the workshop\n          path = _bfs_path(pos, [target_ws], grid)\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Craft using the workshop\n          actions.append(USE)\n\n  return actions", "env_interactions": 21, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T18:07:33.300924", "function_name": "make_arrow", "function_body": "  import collections\n  import numpy as np\n\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  def _bfs(start, targets, occ):\n      w, h = occ.shape\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n      while q:\n          x, y, path = q.popleft()\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n          for dx, dy, act in ((0, 1, DOWN), (0, -1, UP), (-1, 0, LEFT), (1, 0, RIGHT)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occ[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      return []  # unreachable\n\n  # Retrieve world and cookbook\n  world = getattr(env, \"world\", None)\n  if world is None:\n      tmp = getattr(env, \"_current_state\", None)\n      if tmp is not None:\n          world = tmp.world\n  if world is None:\n      raise RuntimeError(\"World object not found in environment\")\n  cookbook = world.cookbook\n\n  # Goal is hard\u2011coded to \"arrow\"\n  goal_idx = cookbook.index[\"arrow\"]\n  needed_prims = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # Ensure we have a current state\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  pos = tuple(state.pos)          # (x, y)\n  grid = state.grid               # (W, H, n_kinds)\n  occ = np.any(grid > 0, axis=2).copy()   # occupied cells mask\n\n  actions = []\n  used_cells = set()\n\n  # Collect each required primitive\n  for prim_idx, count in needed_prims.items():\n      locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      collected = 0\n      for loc in locations:\n          if collected >= count:\n              break\n          if loc in used_cells:\n              continue\n          path = _bfs(pos, [loc], occ)\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          actions.append(USE)\n          occ[loc[0], loc[1]] = False\n          used_cells.add(loc)\n          collected += 1\n\n  # Craft at the required workshop, if any\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      ws_idx = cookbook.index[workshop_key] if isinstance(workshop_key, str) else workshop_key\n      ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, ws_idx] > 0)]\n      if ws_cells:\n          ws_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = ws_cells[0]\n          path = _bfs(pos, [target_ws], occ)\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T18:08:01.982374", "function_name": "make_arrow", "function_body": "  env.reset()\n  cur_state = env._current_state          # CraftState\n  world = env.world\n\n  # --------------------------------------------------------------\n  # Identify the index of the goal item \"arrow\"\n  # --------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:   # not defined in this world\n      return []\n\n  # --------------------------------------------------------------\n  # Helper: BFS that returns a list of movement actions (0\u20113) that\n  # brings the agent to a position where the cell directly in front\n  # contains `target_kind`. Returns [] if unreachable.\n  # --------------------------------------------------------------\n  def _bfs_to_target(state, target_kind):\n      grid = state.grid\n      W, H = grid.shape[:2]\n\n      # direction deltas matching action indices\n      deltas = {\n          0: (0, 1),   # DOWN\n          1: (0, -1),  # UP\n          2: (-1, 0),  # LEFT\n          3: (1, 0),   # RIGHT\n      }\n\n      def in_bounds(x, y):\n          return 0 <= x < W and 0 <= y < H\n\n      def walkable(x, y):\n          if not in_bounds(x, y):\n              return False\n          # a cell is walkable if it contains no entities at all\n          return not np.any(grid[x, y, :])\n\n      start_pos = state.pos\n      start_dir = state.dir\n      from collections import deque\n      queue = deque()\n      queue.append((start_pos[0], start_pos[1], start_dir, []))\n      visited = {(start_pos[0], start_pos[1], start_dir)}\n\n      while queue:\n          x, y, d, acts = queue.popleft()\n          # Check whether the cell directly ahead holds the target\n          dx, dy = deltas[d]\n          fx, fy = x + dx, y + dy\n          if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:\n              return acts\n\n          # Explore movement actions (0\u20113)\n          for a in (0, 1, 2, 3):\n              ndx, ndy = deltas[a]\n              nx, ny = x + ndx, y + ndy\n              if not walkable(nx, ny):\n                  continue\n              if (nx, ny, a) in visited:\n                  continue\n              visited.add((nx, ny, a))\n              queue.append((nx, ny, a, acts + [a]))\n\n      # Unreachable\n      return []\n\n  # --------------------------------------------------------------\n  # Determine primitive requirements for a single arrow\n  # --------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}\n  actions = []\n\n  # --------------------------------------------------------------\n  # Collect each required primitive the necessary number of times\n  # --------------------------------------------------------------\n  for prim_idx, count in primitive_needs.items():\n      for _ in range(count):\n          move_actions = _bfs_to_target(cur_state, prim_idx)\n          # If BFS failed but we are already adjacent, we can still pick up\n          if not move_actions and not cur_state.next_to(prim_idx):\n              # cannot reach this primitive \u2013 abort early\n              return actions\n          actions.extend(move_actions)\n          actions.append(4)                     # USE to pick up\n          # Apply actions to keep cur_state in sync\n          for a in move_actions + [4]:\n              _, cur_state = cur_state.step(a)\n\n  # --------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any)\n  # --------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      move_actions = _bfs_to_target(cur_state, workshop_idx)\n      actions.extend(move_actions)\n      actions.append(4)                     # USE to craft\n      for a in move_actions + [4]:\n          _, cur_state = cur_state.step(a)\n  else:\n      # No specific workshop \u2013 just attempt crafting in place\n      actions.append(4)                     # USE to craft\n      _, cur_state = cur_state.step(4)\n\n  return actions", "env_interactions": 26, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T18:08:03.102653", "function_name": "make_arrow", "function_body": "  env.reset()\n  cur_state = env._current_state\n  world = env.world\n\n  # Index of the goal item \"arrow\"\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:\n      return []\n\n  # Direction deltas matching action indices (DOWN, UP, LEFT, RIGHT)\n  deltas = {0: (0, 1), 1: (0, -1), 2: (-1, 0), 3: (1, 0)}\n\n  def walkable(grid, x, y):\n      W, H = grid.shape[:2]\n      if not (0 <= x < W and 0 <= y < H):\n          return False\n      # a cell is walkable if it contains no entities at all\n      return not np.any(grid[x, y, :])\n\n  from collections import deque\n\n  def bfs_to_target(state, target_kind):\n      \"\"\"Return a list of movement actions (0\u20113) that ends with the agent\n      facing a cell containing `target_kind`. Empty list means already facing\n      the target or unreachable.\"\"\"\n      grid = state.grid\n      W, H = grid.shape[:2]\n      start_x, start_y = state.pos\n      start_dir = state.dir\n      queue = deque()\n      queue.append((start_x, start_y, start_dir, []))\n      visited = {(start_x, start_y, start_dir)}\n      while queue:\n          x, y, d, acts = queue.popleft()\n          dx, dy = deltas[d]\n          fx, fy = x + dx, y + dy\n          if 0 <= fx < W and 0 <= fy < H and grid[fx, fy, target_kind] > 0:\n              return acts\n          for a in (0, 1, 2, 3):\n              ndx, ndy = deltas[a]\n              nx, ny = x + ndx, y + ndy\n              if not walkable(grid, nx, ny):\n                  continue\n              if (nx, ny, a) in visited:\n                  continue\n              visited.add((nx, ny, a))\n              queue.append((nx, ny, a, acts + [a]))\n      return []\n\n  def target_ahead(state, kind):\n      \"\"\"True if the cell directly in front of the agent contains `kind`.\"\"\"\n      x, y = state.pos\n      d = state.dir\n      dx, dy = deltas[d]\n      fx, fy = x + dx, y + dy\n      W, H = state.grid.shape[:2]\n      return (0 <= fx < W and 0 <= fy < H and state.grid[fx, fy, kind] > 0)\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Collect all primitive resources required for one arrow\n  # ------------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(arrow_idx)  # {kind_idx: count}\n  for prim_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          move_seq = bfs_to_target(cur_state, prim_idx)\n          if not move_seq and not target_ahead(cur_state, prim_idx):\n              # Cannot reach this primitive; abort planning\n              return actions\n          actions.extend(move_seq)\n          actions.append(4)  # USE to pick up\n          for a in move_seq + [4]:\n              _, cur_state = cur_state.step(a)\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any)\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      move_seq = bfs_to_target(cur_state, workshop_idx)\n      if not move_seq and not target_ahead(cur_state, workshop_idx):\n          # Workshop unreachable \u2013 still try a USE (will fail harmlessly)\n          actions.append(4)\n          _, cur_state = cur_state.step(4)\n      else:\n          actions.extend(move_seq)\n          actions.append(4)  # USE to craft\n          for a in move_seq + [4]:\n              _, cur_state = cur_state.step(a)\n  else:\n      # No specific workshop; craft in place\n      actions.append(4)\n      _, cur_state = cur_state.step(4)\n\n  return actions", "env_interactions": 26, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T18:08:39.762708", "function_name": "make_arrow", "function_body": "  # ------------------------------------------------------------------\n  # Reset environment and fetch core objects\n  # ------------------------------------------------------------------\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()             # mutable copy of the grid\n\n  # ------------------------------------------------------------------\n  # Action indices (as defined by CraftLab.action_specs)\n  # ------------------------------------------------------------------\n  specs = env.action_specs()\n  DOWN = specs[\"DOWN\"]\n  UP = specs[\"UP\"]\n  LEFT = specs[\"LEFT\"]\n  RIGHT = specs[\"RIGHT\"]\n  USE = specs[\"USE\"]\n  DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  import collections\n  import numpy as np\n\n  H, W = grid.shape[:2]\n\n  def in_bounds(y, x):\n      return 0 <= y < H and 0 <= x < W\n\n  def is_blocked(y, x):\n      \"\"\"A cell is blocked if any entity occupies it.\"\"\"\n      return np.any(grid[y, x])\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) from start to goal,\n      avoiding blocked cells.\"\"\"\n      if start == goal:\n          return []\n      q = collections.deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          y, x = q.popleft()\n          if (y, x) == goal:\n              # reconstruct actions\n              rev = []\n              cur = goal\n              while cur != start:\n                  py, px = parent[cur]\n                  if cur[0] == py + 1:\n                      rev.append(DOWN)\n                  elif cur[0] == py - 1:\n                      rev.append(UP)\n                  elif cur[1] == px + 1:\n                      rev.append(RIGHT)\n                  elif cur[1] == px - 1:\n                      rev.append(LEFT)\n                  cur = (py, px)\n              return list(reversed(rev))\n          for dy, dx, act in DIRS:\n              ny, nx = y + dy, x + dx\n              if not in_bounds(ny, nx):\n                  continue\n              if (ny, nx) in visited:\n                  continue\n              if is_blocked(ny, nx):\n                  continue\n              visited.add((ny, nx))\n              parent[(ny, nx)] = (y, x)\n              q.append((ny, nx))\n      # No path found \u2013 return empty list (will likely cause failure later)\n      return []\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Locate the closest cell containing *kind_idx*.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return tuple(nearest)\n\n  def adjacent_free(cell, avoid=set()):\n      \"\"\"Return a free neighbour of *cell* that is not in *avoid*.\"\"\"\n      y, x = cell\n      for dy, dx, _ in DIRS:\n          ny, nx = y + dy, x + dx\n          if not in_bounds(ny, nx):\n              continue\n          if (ny, nx) in avoid:\n              continue\n          if not is_blocked(ny, nx):\n              return (ny, nx)\n      return None\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow) and its recipe\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  needed = world.cookbook.primitives_for(arrow_idx)   # {primitive_idx: count}\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  workshop_idx = None\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect required primitives\n  # ------------------------------------------------------------------\n  harvested = set()   # remember cells we already took from\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive missing \u2013 abort early\n              return actions\n\n          # Choose a free neighbouring cell to stand on while picking up\n          adj = adjacent_free(target, avoid=harvested)\n          if adj is None:\n              # No free neighbour; cannot pick up this primitive\n              return actions\n\n          # Move to the adjacent cell\n          actions += bfs_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (issue a blocked move in that direction)\n          dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update internal grid representation\n          grid[target[0], target[1], prim_idx] = 0\n          harvested.add(target)\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          ws_adj = adjacent_free(ws_cell, avoid=harvested)\n          if ws_adj is None:\n              # No free neighbour; stand on the workshop cell itself if possible\n              ws_adj = ws_cell if not is_blocked(*ws_cell) else cur_pos\n          actions += bfs_path(cur_pos, ws_adj)\n          cur_pos = ws_adj\n\n          # Face the workshop (blocked move)\n          dy, dx = ws_cell[0] - cur_pos[0], ws_cell[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n  # ------------------------------------------------------------------\n  # Trigger crafting\n  # ------------------------------------------------------------------\n  actions.append(USE)\n\n  return actions", "env_interactions": 37, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T18:08:40.890722", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()             # mutable copy of the grid\n\n  # ------------------------------------------------------------------\n  # Action indices (as defined by CraftLab)\n  # ------------------------------------------------------------------\n  specs = env.action_specs()\n  DOWN = specs[\"DOWN\"]\n  UP = specs[\"UP\"]\n  LEFT = specs[\"LEFT\"]\n  RIGHT = specs[\"RIGHT\"]\n  USE = specs[\"USE\"]\n  DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  H, W = grid.shape[:2]\n\n  def in_bounds(y, x):\n      return 0 <= y < H and 0 <= x < W\n\n  def is_blocked(y, x):\n      \"\"\"A cell is blocked if any entity occupies it.\"\"\"\n      return np.any(grid[y, x])\n\n  def bfs_path(start, goal):\n      \"\"\"Return list of movement actions from start to goal avoiding blocked cells.\"\"\"\n      if start == goal:\n          return []\n      from collections import deque\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          y, x = q.popleft()\n          if (y, x) == goal:\n              # reconstruct actions\n              rev = []\n              cur = goal\n              while cur != start:\n                  py, px = parent[cur]\n                  if cur[0] == py + 1:\n                      rev.append(DOWN)\n                  elif cur[0] == py - 1:\n                      rev.append(UP)\n                  elif cur[1] == px + 1:\n                      rev.append(RIGHT)\n                  else:\n                      rev.append(LEFT)\n                  cur = (py, px)\n              return list(reversed(rev))\n          for dy, dx, act in DIRS:\n              ny, nx = y + dy, x + dx\n              if not in_bounds(ny, nx):\n                  continue\n              if (ny, nx) in visited:\n                  continue\n              if is_blocked(ny, nx):\n                  continue\n              visited.add((ny, nx))\n              parent[(ny, nx)] = (y, x)\n              q.append((ny, nx))\n      # No path found\n      return []\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Return coordinates of the closest cell containing kind_idx, or None.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return tuple(nearest)\n\n  def adjacent_free(cell, avoid=set()):\n      \"\"\"Return a free neighbour of cell not in avoid, or None.\"\"\"\n      y, x = cell\n      for dy, dx, _ in DIRS:\n          ny, nx = y + dy, x + dx\n          if not in_bounds(ny, nx):\n              continue\n          if (ny, nx) in avoid:\n              continue\n          if not is_blocked(ny, nx):\n              return (ny, nx)\n      return None\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow) and its recipe\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  needed = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  workshop_idx = None\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n  harvested = set()\n\n  # ------------------------------------------------------------------\n  # Collect all required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive missing \u2013 give up.\n              return actions\n\n          adj = adjacent_free(target, avoid=harvested)\n          if adj is None:\n              # No free neighbour to stand on.\n              return actions\n\n          # Move to the adjacent cell.\n          actions += bfs_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (issue a blocked move in that direction).\n          dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick it up.\n          actions.append(USE)\n\n          # Update internal grid and record the harvested location.\n          grid[target[0], target[1], prim_idx] = 0\n          harvested.add(target)\n\n  # ------------------------------------------------------------------\n  # Go to the workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is None:\n          return actions\n      ws_adj = adjacent_free(ws_cell, avoid=harvested)\n      if ws_adj is None:\n          ws_adj = cur_pos  # stay where we are; still try to USE\n      actions += bfs_path(cur_pos, ws_adj)\n      cur_pos = ws_adj\n\n      dy, dx = ws_cell[0] - cur_pos[0], ws_cell[1] - cur_pos[1]\n      if dy == 1:\n          actions.append(DOWN)\n      elif dy == -1:\n          actions.append(UP)\n      elif dx == 1:\n          actions.append(RIGHT)\n      elif dx == -1:\n          actions.append(LEFT)\n\n  # Trigger crafting.\n  actions.append(USE)\n\n  return actions", "env_interactions": 37, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T18:08:57.465833", "function_name": "make_arrow", "function_body": "", "env_interactions": 0, "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-10-28T18:09:13.131563", "function_name": "make_arrow", "function_body": "  # Retrieve scenario and world objects\n  scenario = getattr(env, \"scenario\", None) or getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", None) or getattr(env, \"world\", None)\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  # Helper to create a hashable representation of a CraftState\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 500                     # safety bound on plan length\n  n_actions = getattr(world, \"n_actions\", 5)  # default action space size\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long candidate plans\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No feasible plan found within the limits\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T18:09:37.440968", "function_name": "make_arrow", "function_body": "  # Directions corresponding to action indices: 0\u2011DOWN, 1\u2011UP, 2\u2011LEFT, 3\u2011RIGHT, 4\u2011USE\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n\n  # ----------------------------------------------------------------------\n  # Helper: breadth\u2011first search returning a list of action indices that\n  # reaches the nearest cell belonging to `targets`.\n  # ----------------------------------------------------------------------\n  def bfs(start, targets, blocked):\n      w, h = grid.shape[:2]\n      q = collections.deque([(start, [])])\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in targets:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not blocked[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      # In a solvable scenario this should never happen\n      return []\n\n  # ----------------------------------------------------------------------\n  # Helper: move to a cell containing `kind_idx` and perform `cnt` USEs.\n  # ----------------------------------------------------------------------\n  def acquire(kind_idx, cnt):\n      nonlocal pos, actions\n      for _ in range(cnt):\n          # locate any cell that currently holds the desired primitive\n          cells = {(x, y) for x in range(w) for y in range(h)\n                   if grid[x, y, kind_idx] > 0}\n          path = bfs(pos, cells, blocked)\n          actions.extend(path)\n          for a in path:\n              dx, dy = DIRS[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(4)   # USE to pick up the primitive\n\n  # ----------------------------------------------------------------------\n  # Gather world / recipe information\n  # ----------------------------------------------------------------------\n  world = env.world\n  cookbook = world.cookbook\n  arrow_idx = cookbook.index[\"arrow\"]\n\n  # ----------------------------------------------------------------------\n  # Resolve full crafting plan:\n  #   needed_prims  -> primitive index \u2192 total count required\n  #   craft_steps   -> list of (item_idx, count) in post\u2011order (ingredients first)\n  # ----------------------------------------------------------------------\n  needed_prims = {}\n  craft_steps = []\n\n  def resolve(item_idx, mul):\n      rec = cookbook.recipes.get(item_idx)\n      if rec is None:\n          # Primitive (no recipe)\n          needed_prims[item_idx] = needed_prims.get(item_idx, 0) + mul\n          return\n      # Resolve ingredients first (ignore special keys like \"_at\"/\"_key\")\n      for ing, cnt in rec.items():\n          if isinstance(ing, int):\n              resolve(ing, cnt * mul)\n      # Schedule crafting of this item after its ingredients\n      craft_steps.append((item_idx, mul))\n\n  resolve(arrow_idx, 1)\n\n  # ----------------------------------------------------------------------\n  # Prepare static data: grid, blocked cells, dimensions\n  # ----------------------------------------------------------------------\n  grid = env._current_state.grid\n  w, h, _ = grid.shape\n  blocked = np.zeros((w, h), dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # ----------------------------------------------------------------------\n  # Build the action sequence\n  # ----------------------------------------------------------------------\n  actions = []\n  pos = tuple(env._current_state.pos)   # current (x, y)\n\n  # 1) Collect all required primitive resources\n  for kind_idx, cnt in needed_prims.items():\n      acquire(kind_idx, cnt)\n\n  # 2) Perform crafting steps at the appropriate workshops\n  for item_idx, cnt in craft_steps:\n      rec = cookbook.recipes[item_idx]\n      wk_key = rec.get(\"_at\", rec.get(\"_key\"))\n      wk_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]\n\n      wk_cells = {(x, y) for x in range(w) for y in range(h)\n                  if grid[x, y, wk_idx] > 0}\n      path = bfs(pos, wk_cells, blocked)\n      actions.extend(path)\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n\n      actions.extend([4] * cnt)   # USE at workshop to craft\n\n  return actions", "env_interactions": 20, "island_id": 6, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T18:09:38.593355", "function_name": "make_arrow", "function_body": "  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n\n  # ------------------------------------------------------------------\n  # Helper: breadth\u2011first search returning a list of action indices\n  # ------------------------------------------------------------------\n  def bfs(start, targets, blocked):\n      w, h = grid.shape[:2]\n      from collections import deque\n      q = deque([(start, [])])\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in targets:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not blocked[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []  # should never happen for solvable tasks\n\n  # ------------------------------------------------------------------\n  # Helper: move to a cell containing `kind_idx` and USE it `cnt` times\n  # ------------------------------------------------------------------\n  def acquire(kind_idx, cnt):\n      nonlocal pos, actions\n      for _ in range(cnt):\n          cells = {(x, y) for x in range(w) for y in range(h)\n                   if grid[x, y, kind_idx] > 0}\n          path = bfs(pos, cells, blocked)\n          actions.extend(path)\n          for a in path:\n              dx, dy = DIRS[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(4)   # USE action\n\n  # ------------------------------------------------------------------\n  # Gather world / recipe information\n  # ------------------------------------------------------------------\n  world = env.world\n  cookbook = world.cookbook\n  arrow_idx = cookbook.index[\"arrow\"]\n\n  # ------------------------------------------------------------------\n  # Resolve full crafting plan: primitives needed + ordered craft steps\n  # ------------------------------------------------------------------\n  needed_prims = {}          # primitive idx \u2192 total count required\n  craft_steps = []           # list of (item_idx, count) in post\u2011order\n\n  def resolve(item_idx, multiplier):\n      rec = cookbook.recipes.get(item_idx)\n      if rec is None:                     # primitive (no recipe)\n          needed_prims[item_idx] = needed_prims.get(item_idx, 0) + multiplier\n          return\n      # Resolve ingredients first (ignore special keys)\n      for ing, cnt in rec.items():\n          if isinstance(ing, int):\n              resolve(ing, cnt * multiplier)\n      # Schedule crafting of this item after its ingredients\n      craft_steps.append((item_idx, multiplier))\n\n  resolve(arrow_idx, 1)\n\n  # ------------------------------------------------------------------\n  # Prepare static data: grid, blocked cells, dimensions\n  # ------------------------------------------------------------------\n  grid = env._current_state.grid\n  w, h, _ = grid.shape\n  blocked = np.zeros((w, h), dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # ------------------------------------------------------------------\n  # Build the action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  pos = tuple(env._current_state.pos)\n\n  # 1) Collect all required primitive resources\n  for kind_idx, count in needed_prims.items():\n      acquire(kind_idx, count)\n\n  # 2) Perform crafting steps at the appropriate workshops\n  for item_idx, count in craft_steps:\n      rec = cookbook.recipes[item_idx]\n      wk_key = rec.get(\"_at\", rec.get(\"_key\"))\n      wk_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]\n\n      workshop_cells = {(x, y) for x in range(w) for y in range(h)\n                        if grid[x, y, wk_idx] > 0}\n      path = bfs(pos, workshop_cells, blocked)\n      actions.extend(path)\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n\n      actions.extend([4] * count)   # USE at workshop to craft\n\n  return actions", "env_interactions": 20, "island_id": 6, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T18:09:57.089176", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Helper functions\n  # ----------------------------------------------------------------------\n  def _bfs_path(start, goal, grid):\n      \"\"\"Return a list of actions to move from start to goal using BFS.\n      start/goal are [x, y] lists. Cells with any non\u2011zero kind are considered\n      blocked, except the goal cell itself.\n      \"\"\"\n      width, height = grid.shape[0], grid.shape[1]\n      moves = [\n          ((0, 1), 0),   # DOWN\n          ((0, -1), 1),  # UP\n          ((-1, 0), 2),  # LEFT\n          ((1, 0), 3),   # RIGHT\n      ]\n      from collections import deque\n      q = deque()\n      q.append(tuple(start))\n      visited = {tuple(start): (None, None)}  # pos -> (prev_pos, action)\n\n      while q:\n          x, y = q.popleft()\n          if [x, y] == goal:\n              break\n          for (dx, dy), act in moves:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              # allow stepping onto the goal even if occupied\n              if (nx, ny) != tuple(goal) and grid[nx, ny].sum() != 0:\n                  continue\n              visited[(nx, ny)] = ((x, y), act)\n              q.append((nx, ny))\n\n      if tuple(goal) not in visited:\n          return []  # no path found\n\n      # reconstruct path\n      path = []\n      cur = tuple(goal)\n      while visited[cur][0] is not None:\n          prev, act = visited[cur]\n          path.append(act)\n          cur = prev\n      path.reverse()\n      return path\n\n  def _nearest_kind(kind_idx, cur_pos, grid):\n      \"\"\"Find the nearest cell containing the given kind (Manhattan distance).\"\"\"\n      ys, xs = np.where(grid[:, :, kind_idx] > 0)\n      if len(xs) == 0:\n          return None\n      dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])\n      best = int(np.argmin(dists))\n      return [int(xs[best]), int(ys[best])]\n\n  # ----------------------------------------------------------------------\n  # Planning\n  # ----------------------------------------------------------------------\n  actions = []\n  USE = 4\n\n  # Determine current position: use live state if available, else init pos\n  if hasattr(env, \"_current_state\") and env._current_state is not None:\n      cur_pos = list(env._current_state.pos)\n  else:\n      cur_pos = list(env.scenario.init_pos)\n\n  # Work on a mutable copy of the static grid to simulate item removal\n  grid = env.scenario.init_grid.copy()\n\n  # Goal item index\n  goal_idx = env.task.goal\n\n  # ----------------------------------------------------------------------\n  # 1. Gather required primitives\n  # ----------------------------------------------------------------------\n  primitive_reqs = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  for prim_kind, count in primitive_reqs.items():\n      for _ in range(count):\n          tgt = _nearest_kind(prim_kind, cur_pos, grid)\n          if tgt is None:\n              # Primitive not found \u2013 abort planning\n              return actions\n          actions.extend(_bfs_path(cur_pos, tgt, grid))\n          actions.append(USE)  # pick up primitive\n          grid[tgt[0], tgt[1], prim_kind] = 0\n          cur_pos = tgt\n\n  # ----------------------------------------------------------------------\n  # 2. Move to workshop and craft the goal\n  # ----------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      workshop_pos = _nearest_kind(workshop_kind, cur_pos, grid)\n      if workshop_pos is not None:\n          actions.extend(_bfs_path(cur_pos, workshop_pos, grid))\n          actions.append(USE)  # craft at workshop\n          cur_pos = workshop_pos\n\n  # Return the complete action list\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:09:58.218087", "function_name": "make_arrow", "function_body": "  # Action indices (consistent with CraftLab)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: BFS path finder on the static grid (ignores inventory)\n  # ------------------------------------------------------------------\n  def _bfs_path(start, goal, grid):\n      \"\"\"Return a list of actions moving from start to goal.\n\n      start / goal : [x, y] coordinates (list or tuple)\n      grid : static occupancy grid (WIDTH, HEIGHT, n_kinds)\n      Cells with any non\u2011zero kind are treated as blocked,\n      except the goal cell itself which may be occupied.\n      \"\"\"\n      width, height = grid.shape[0], grid.shape[1]\n      moves = [\n          ((0, 1), DOWN),   # down  (+y)\n          ((0, -1), UP),    # up    (-y)\n          ((-1, 0), LEFT),  # left  (-x)\n          ((1, 0), RIGHT),  # right (+x)\n      ]\n\n      from collections import deque\n      q = deque()\n      q.append(tuple(start))\n      visited = {tuple(start): (None, None)}   # pos -> (prev_pos, action)\n\n      while q:\n          x, y = q.popleft()\n          if [x, y] == goal:\n              break\n          for (dx, dy), act in moves:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              # Allow stepping onto the goal even if occupied\n              if (nx, ny) != tuple(goal) and grid[nx, ny].sum() != 0:\n                  continue\n              visited[(nx, ny)] = ((x, y), act)\n              q.append((nx, ny))\n\n      # Reconstruct path\n      if tuple(goal) not in visited:\n          return []   # No path found\n      path = []\n      cur = tuple(goal)\n      while visited[cur][0] is not None:\n          prev, act = visited[cur]\n          path.append(act)\n          cur = prev\n      path.reverse()\n      return path\n\n  # ------------------------------------------------------------------\n  # Helper: locate nearest cell containing a given kind (Manhattan distance)\n  # ------------------------------------------------------------------\n  def _nearest_kind(kind_idx, cur_pos, grid):\n      \"\"\"Return [x, y] of the closest cell that has at least one of kind_idx.\"\"\"\n      ys, xs = np.where(grid[:, :, kind_idx] > 0)\n      if len(xs) == 0:\n          return None\n      dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])\n      best = int(np.argmin(dists))\n      return [int(xs[best]), int(ys[best])]\n\n  # ------------------------------------------------------------------\n  # Planning start\n  # ------------------------------------------------------------------\n  actions = []\n\n  # Current position: use live state if available, else initial position\n  if hasattr(env, \"_current_state\") and env._current_state is not None:\n      cur_pos = list(env._current_state.pos)\n  else:\n      cur_pos = list(env.scenario.init_pos)\n\n  # Work on a mutable copy of the static grid to mark collected items\n  grid = env.scenario.init_grid.copy()\n\n  # Goal item index\n  goal_idx = env.task.goal\n\n  # ------------------------------------------------------------------\n  # 1. Gather all primitive resources required for the goal\n  # ------------------------------------------------------------------\n  primitive_reqs = env.world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n  for prim_kind, count in primitive_reqs.items():\n      for _ in range(count):\n          target = _nearest_kind(prim_kind, cur_pos, grid)\n          if target is None:\n              # Primitive not found \u2013 abort planning\n              return actions\n          actions.extend(_bfs_path(cur_pos, target, grid))\n          actions.append(USE)                     # pick up the primitive\n          # Update simulated world: remove the primitive from the grid\n          grid[target[0], target[1], prim_kind] = 0\n          cur_pos = target\n\n  # ------------------------------------------------------------------\n  # 2. Move to the appropriate workshop (if any) and craft the item\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      workshop_pos = _nearest_kind(workshop_kind, cur_pos, grid)\n      if workshop_pos is not None:\n          actions.extend(_bfs_path(cur_pos, workshop_pos, grid))\n          actions.append(USE)                     # craft at the workshop\n          cur_pos = workshop_pos\n  else:\n      # No specific workshop \u2013 simply use the item at current location\n      actions.append(USE)\n\n  return actions", "env_interactions": 1, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:10:19.795612", "function_name": "make_arrow", "function_body": "  # Reset environment and fetch initial state and world configuration\n  env.reset()\n  cur_state = env._current_state          # CraftState\n  world = env.world\n\n  # --------------------------------------------------------------\n  # Identify the index of the goal item \"arrow\"\n  # --------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:   # item not defined in this world\n      return []\n\n  # --------------------------------------------------------------\n  # Helper: BFS that returns a list of movement actions (0\u20113) that\n  # brings the agent to a position where the cell directly in front\n  # contains `target_kind`. Returns [] if already adjacent/facing,\n  # or None if unreachable.\n  # --------------------------------------------------------------\n  def _bfs_to_target(state, target_kind):\n      grid = state.grid\n      W, H = grid.shape[:2]\n\n      # Mapping from action index to (dx, dy) movement\n      deltas = {\n          0: (0, 1),   # DOWN\n          1: (0, -1),  # UP\n          2: (-1, 0),  # LEFT\n          3: (1, 0),   # RIGHT\n      }\n\n      def in_bounds(x, y):\n          return 0 <= x < W and 0 <= y < H\n\n      def walkable(x, y):\n          if not in_bounds(x, y):\n              return False\n          # a cell is walkable if it contains no entities at all\n          return not np.any(grid[x, y, :])\n\n      start_x, start_y = state.pos\n      start_dir = state.dir\n      from collections import deque\n      queue = deque()\n      queue.append((start_x, start_y, start_dir, []))\n      visited = {(start_x, start_y, start_dir)}\n\n      while queue:\n          x, y, d, actions = queue.popleft()\n          # Check the cell directly in front of the agent\n          dx, dy = deltas[d]\n          fx, fy = x + dx, y + dy\n          if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:\n              return actions\n\n          # Expand with the four movement actions (which also set direction)\n          for a in (0, 1, 2, 3):\n              ndx, ndy = deltas[a]\n              nx, ny = x + ndx, y + ndy\n              if not walkable(nx, ny):\n                  continue\n              if (nx, ny, a) in visited:\n                  continue\n              visited.add((nx, ny, a))\n              queue.append((nx, ny, a, actions + [a]))\n\n      # Unreachable\n      return None\n\n  # --------------------------------------------------------------\n  # Determine which primitives are required to craft one arrow.\n  # If the recipe is empty, the arrow itself is a primitive that must\n  # be collected directly.\n  # --------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}\n  # If no primitives are needed, treat the arrow itself as the target to pick up\n  if not primitive_needs:\n      primitive_needs = {arrow_idx: 1}\n\n  actions = []\n\n  # --------------------------------------------------------------\n  # Collect each required primitive the necessary number of times.\n  # --------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          move_seq = _bfs_to_target(cur_state, prim_idx)\n          if move_seq is None:\n              # Cannot reach the required primitive \u2013 abort early.\n              return actions\n          actions.extend(move_seq)\n          actions.append(4)   # USE to pick up / interact\n\n          # Apply the actions to keep cur_state in sync.\n          for a in move_seq + [4]:\n              _, cur_state = cur_state.step(a)\n\n  # --------------------------------------------------------------\n  # Craft the arrow at its designated workshop (if any).\n  # --------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      move_seq = _bfs_to_target(cur_state, workshop_idx)\n      if move_seq is None:\n          # Workshop unreachable \u2013 abort.\n          return actions\n      actions.extend(move_seq)\n      actions.append(4)   # USE to craft\n      for a in move_seq + [4]:\n          _, cur_state = cur_state.step(a)\n  else:\n      # No specific workshop \u2013 just try to craft in place.\n      actions.append(4)   # USE to craft\n      _, cur_state = cur_state.step(4)\n\n  return actions", "env_interactions": 26, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T18:10:20.919903", "function_name": "make_arrow", "function_body": "  # Reset environment and get initial state/world\n  env.reset()\n  cur_state = env._current_state          # CraftState\n  world = env.world\n\n  # --------------------------------------------------------------\n  # Identify the index of the goal item \"arrow\"\n  # --------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:   # arrow not defined in this world\n      return []\n\n  # --------------------------------------------------------------\n  # Helper: BFS that returns a list of movement actions (0\u20113) that\n  # brings the agent to a position where the cell directly in front\n  # contains `target_kind`. Returns [] if unreachable.\n  # --------------------------------------------------------------\n  def _bfs_to_target(state, target_kind):\n      grid = state.grid\n      W, H = grid.shape[:2]\n\n      # direction deltas matching action indices\n      deltas = {\n          0: (0, 1),   # DOWN\n          1: (0, -1),  # UP\n          2: (-1, 0),  # LEFT\n          3: (1, 0),   # RIGHT\n      }\n\n      def in_bounds(x, y):\n          return 0 <= x < W and 0 <= y < H\n\n      def walkable(x, y):\n          if not in_bounds(x, y):\n              return False\n          # a cell is walkable if it contains no entities at all\n          return not np.any(grid[x, y, :])\n\n      start_x, start_y = state.pos\n      start_dir = state.dir\n      from collections import deque\n      queue = deque()\n      queue.append((start_x, start_y, start_dir, []))\n      visited = {(start_x, start_y, start_dir)}\n\n      while queue:\n          x, y, d, acts = queue.popleft()\n          # Is the target directly ahead?\n          dx, dy = deltas[d]\n          fx, fy = x + dx, y + dy\n          if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:\n              return acts\n\n          # Explore movement actions (0\u20113)\n          for a in (0, 1, 2, 3):\n              ndx, ndy = deltas[a]\n              nx, ny = x + ndx, y + ndy\n              if not walkable(nx, ny):\n                  continue\n              if (nx, ny, a) in visited:\n                  continue\n              visited.add((nx, ny, a))\n              queue.append((nx, ny, a, acts + [a]))\n\n      # Unreachable\n      return []\n\n  # --------------------------------------------------------------\n  # Determine primitive requirements for a single arrow\n  # --------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}\n  actions = []\n\n  # --------------------------------------------------------------\n  # Collect each required primitive the necessary number of times\n  # --------------------------------------------------------------\n  for prim_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          move_actions = _bfs_to_target(cur_state, prim_idx)\n          # If BFS failed but we are already adjacent, we can still pick up\n          if not move_actions and not cur_state.next_to(prim_idx):\n              # cannot reach this primitive \u2013 abort early\n              return actions\n          actions.extend(move_actions)\n          actions.append(4)                     # USE to pick up\n          # Apply actions to keep cur_state in sync\n          for a in move_actions + [4]:\n              _, cur_state = cur_state.step(a)\n\n  # --------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any)\n  # --------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      move_actions = _bfs_to_target(cur_state, workshop_idx)\n      actions.extend(move_actions)\n      actions.append(4)                     # USE to craft\n      for a in move_actions + [4]:\n          _, cur_state = cur_state.step(a)\n  else:\n      # No specific workshop \u2013 just attempt crafting in place\n      actions.append(4)                     # USE to craft\n      _, cur_state = cur_state.step(4)\n\n  return actions", "env_interactions": 26, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T18:10:45.281980", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Mapping between direction vectors and action indices\n  DIR2ACT = {(0, 1): 0, (0, -1): 1, (-1, 0): 2, (1, 0): 3}\n  ACT2DIR = {v: k for k, v in DIR2ACT.items()}\n\n  def bfs_adjacent(start, targets, grid):\n      \"\"\"Return a list of actions that brings the agent next to any target cell.\"\"\"\n      W, H = grid.shape[:2]\n      blocked = np.any(grid > 0, axis=2)  # any non\u2011empty cell is an obstacle\n      sx, sy = start\n      # Already adjacent?\n      for tx, ty in targets:\n          if abs(sx - tx) + abs(sy - ty) == 1:\n              return []\n      q = deque()\n      q.append((sx, sy, []))\n      visited = np.full((W, H), False, dtype=bool)\n      visited[sx, sy] = True\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR2ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if blocked[nx, ny]:\n                      continue\n                  npath = path + [act]\n                  for tx, ty in targets:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return npath\n                  visited[nx, ny] = True\n                  q.append((nx, ny, npath))\n      return []  # no reachable target\n\n  # ----------------------------------------------------------------------\n  # Gather current state information\n  # ----------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n\n  # Goal index is stored in the task object (namedtuple Task(goal, steps))\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      raise ValueError(\"Goal not found in the environment task.\")\n\n  # ----------------------------------------------------------------------\n  # Determine which primitive resources are required for the goal\n  # ----------------------------------------------------------------------\n  needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  plan = []\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive\n  # ----------------------------------------------------------------------\n  for kind_idx, cnt in needed.items():\n      while cnt > 0:\n          # Locate all cells that currently contain this primitive\n          cells = np.argwhere(grid[:, :, kind_idx] > 0)\n          if cells.size == 0:\n              # No more of this primitive on the map \u2013 abort early\n              return plan\n          # Find a path to the nearest cell (any cell works)\n          path = bfs_adjacent(pos, cells.tolist(), grid)\n          plan.extend(path)\n          # Update position according to the path taken\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          # Perform the USE action to pick up the primitive\n          plan.append(4)  # USE\n          # Identify which cell we are now adjacent to and decrement it\n          adj_cell = None\n          for cx, cy in cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  adj_cell = (cx, cy)\n                  break\n          if adj_cell is None:\n              # Something went wrong; stop planning\n              return plan\n          grid[adj_cell[0], adj_cell[1], kind_idx] -= 1\n          cnt -= 1\n\n  # ----------------------------------------------------------------------\n  # If the recipe requires a specific workshop, move there and USE\n  # ----------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (might be a string name)\n      if isinstance(workshop_key, str):\n          workshop_idx = env.world.cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          path = bfs_adjacent(pos, workshop_cells.tolist(), grid)\n          plan.extend(path)\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          plan.append(4)  # USE at the workshop\n\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:10:46.401616", "function_name": "make_arrow", "function_body": "  DIR2ACT = {(0, 1): 0, (0, -1): 1, (-1, 0): 2, (1, 0): 3}\n  ACT2DIR = {v: k for k, v in DIR2ACT.items()}\n  from collections import deque\n  import numpy as np\n\n  def bfs_adjacent(start, targets, grid):\n      \"\"\"Return a list of actions that moves the agent from *start* to a cell\n      adjacent to any of *targets* while avoiding blocked cells.\"\"\"\n      W, H = grid.shape[:2]\n      blocked = np.any(grid > 0, axis=2)          # any occupied cell blocks movement\n      sx, sy = start\n\n      # already adjacent?\n      for tx, ty in targets:\n          if abs(sx - tx) + abs(sy - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((sx, sy, []))\n      visited = np.zeros((W, H), dtype=bool)\n      visited[sx, sy] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR2ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if blocked[nx, ny]:\n                      continue\n                  npath = path + [act]\n                  for tx, ty in targets:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return npath\n                  visited[nx, ny] = True\n                  q.append((nx, ny, npath))\n      return []   # no reachable target\n\n  state = env._current_state\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      raise ValueError(\"Goal index not found in env.task\")\n\n  needed = env.world.cookbook.primitives_for(goal_idx)\n  plan = []\n\n  # Collect each required primitive\n  for kind_idx, count in needed.items():\n      while count > 0:\n          cells = np.argwhere(grid[:, :, kind_idx] > 0)\n          if cells.size == 0:\n              return plan  # cannot find required primitive, abort early\n          path = bfs_adjacent(pos, cells.tolist(), grid)\n          plan.extend(path)\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          plan.append(4)   # USE to pick up\n          # identify which primitive cell we are adjacent to\n          adj = None\n          for cx, cy in cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  adj = (cx, cy)\n                  break\n          if adj is None:\n              break\n          grid[adj[0], adj[1], kind_idx] -= 1\n          count -= 1\n\n  # Move to the appropriate workshop and craft the goal item\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      if isinstance(workshop_key, str):\n          workshop_idx = env.world.cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          path = bfs_adjacent(pos, workshop_cells.tolist(), grid)\n          plan.extend(path)\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          plan.append(4)   # USE to craft\n\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:11:30.394218", "function_name": "make_arrow", "function_body": "  spec = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      spec[\"DOWN\"],\n      spec[\"UP\"],\n      spec[\"LEFT\"],\n      spec[\"RIGHT\"],\n      spec[\"USE\"],\n  )\n\n  goal_idx = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n  state = env._current_state\n  pos = tuple(state.pos)  # current agent position\n  grid = state.grid.copy()\n  width, height = grid.shape[:2]\n\n  # cells occupied by non\u2011grabbable entities (e.g., water, stone)\n  non_grab = list(env.world.non_grabbable_indices)\n  base_blocked = (\n      np.any(grid[:, :, non_grab] > 0, axis=2) if non_grab else np.zeros((width, height), dtype=bool)\n  )\n\n  # ----------------------------------------------------------------------\n  # BFS pathfinder that avoids blocked cells.  If allow_target=True the\n  # target cell may be occupied (primitive or workshop).\n  # ----------------------------------------------------------------------\n  def bfs_path(start, target, allow_target=False):\n      blocked = base_blocked.copy()\n      if allow_target:\n          blocked[target[0], target[1]] = False\n      q = collections.deque([start])\n      came_from = {start: None}\n      action_from = {}\n      moves = [\n          (DOWN, (1, 0)),\n          (UP, (-1, 0)),\n          (RIGHT, (0, 1)),\n          (LEFT, (0, -1)),\n      ]\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          x, y = cur\n          for a, (dx, dy) in moves:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height and not blocked[nx, ny]:\n                  nxt = (nx, ny)\n                  if nxt not in came_from:\n                      came_from[nxt] = cur\n                      action_from[nxt] = a\n                      q.append(nxt)\n      if target not in came_from:\n          return None\n      # reconstruct actions\n      path = []\n      cur = target\n      while cur != start:\n          path.append(action_from[cur])\n          cur = came_from[cur]\n      path.reverse()\n      return path\n\n  # ----------------------------------------------------------------------\n  # Simple Manhattan moves (fallback when BFS fails).\n  # ----------------------------------------------------------------------\n  def manhattan_path(start, target):\n      moves = []\n      x, y = start\n      tx, ty = target\n      while x < tx:\n          moves.append(DOWN)\n          x += 1\n      while x > tx:\n          moves.append(UP)\n          x -= 1\n      while y < ty:\n          moves.append(RIGHT)\n          y += 1\n      while y > ty:\n          moves.append(LEFT)\n          y -= 1\n      return moves\n\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # 1) Collect each required primitive.\n  # ----------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          prim_locs = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not prim_locs:\n              # No more instances \u2013 abort early (should not happen in solvable tasks)\n              break\n          # Pick the closest instance (Manhattan distance)\n          target = min(prim_locs, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n          path = bfs_path(pos, target, allow_target=True)\n          if path is None:\n              path = manhattan_path(pos, target)\n          actions.extend(path)\n          actions.append(USE)  # pick up the primitive\n          pos = target\n          grid[pos[0], pos[1], prim_idx] = 0  # remove from simulated grid\n\n  # ----------------------------------------------------------------------\n  # 2) If the goal itself is a primitive (no recipe), just collect it.\n  # ----------------------------------------------------------------------\n  if not needed:\n      prim_locs = list(zip(*np.where(grid[:, :, goal_idx] > 0)))\n      if prim_locs:\n          target = min(prim_locs, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n          path = bfs_path(pos, target, allow_target=True)\n          if path is None:\n              path = manhattan_path(pos, target)\n          actions.extend(path)\n          actions.append(USE)\n          return actions\n\n  # ----------------------------------------------------------------------\n  # 3) Move to the appropriate workshop and craft the goal item.\n  # ----------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      ws_locs = list(zip(*np.where(state.grid[:, :, workshop_idx] > 0)))\n      if ws_locs:\n          target_ws = min(ws_locs, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n          path = bfs_path(pos, target_ws, allow_target=True)\n          if path is None:\n              path = manhattan_path(pos, target_ws)\n          actions.extend(path)\n          actions.append(USE)  # craft at the workshop\n  else:\n      # No specific workshop required \u2013 just use at current location.\n      actions.append(USE)\n\n  return actions", "env_interactions": 1, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:11:31.551657", "function_name": "make_arrow", "function_body": "  spec = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      spec[\"DOWN\"], spec[\"UP\"], spec[\"LEFT\"], spec[\"RIGHT\"], spec[\"USE\"]\n  )\n\n  state = env._current_state\n  pos = tuple(state.pos)                     # current agent position\n  goal = env.task.goal                       # index of desired item\n  needed = env.world.cookbook.primitives_for(goal)  # {prim_idx: count}\n\n  # copy of the grid to simulate removals after picking up primitives\n  grid = state.grid.copy()\n  width, height = grid.shape[:2]\n\n  # static blocked cells (non\u2011grabbable entities such as water, stone, etc.)\n  non_grab = list(env.world.non_grabbable_indices)\n  if non_grab:\n      blocked_base = np.any(grid[:, :, non_grab] > 0, axis=2)\n  else:\n      blocked_base = np.zeros((width, height), dtype=bool)\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions from start to target.\n  # If allow_target_block=True the target cell may be occupied (primitive or workshop)\n  # ----------------------------------------------------------------------\n  moves = [\n      (DOWN, (1, 0)),\n      (UP, (-1, 0)),\n      (RIGHT, (0, 1)),\n      (LEFT, (0, -1)),\n  ]\n\n  def bfs(start, target, allow_target_block=False):\n      blocked = blocked_base.copy()\n      if allow_target_block:\n          blocked[target[0], target[1]] = False\n      q = collections.deque([start])\n      came_from = {start: None}\n      action_from = {}\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          x, y = cur\n          for a, (dx, dy) in moves:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height and not blocked[nx, ny]:\n                  nxt = (nx, ny)\n                  if nxt not in came_from:\n                      came_from[nxt] = cur\n                      action_from[nxt] = a\n                      q.append(nxt)\n      if target not in came_from:\n          return None\n      # reconstruct path\n      path = []\n      cur = target\n      while cur != start:\n          path.append(action_from[cur])\n          cur = came_from[cur]\n      path.reverse()\n      return path\n\n  # ----------------------------------------------------------------------\n  # Helper: simple Manhattan path (fallback when BFS fails)\n  # ----------------------------------------------------------------------\n  def manhattan_path(start, target):\n      moves_seq = []\n      x, y = start\n      tx, ty = target\n      while x < tx:\n          moves_seq.append(DOWN)\n          x += 1\n      while x > tx:\n          moves_seq.append(UP)\n          x -= 1\n      while y < ty:\n          moves_seq.append(RIGHT)\n          y += 1\n      while y > ty:\n          moves_seq.append(LEFT)\n          y -= 1\n      return moves_seq\n\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # 1) Collect required primitives (if any)\n  # ----------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          locs = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not locs:\n              break  # no more instances\n          # choose the closest instance by Manhattan distance\n          target = min(locs, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n          path = bfs(pos, target, allow_target_block=True)\n          if path is None:\n              path = manhattan_path(pos, target)\n          actions.extend(path)\n          actions.append(USE)                     # pick up the primitive\n          # update simulated state\n          pos = target\n          grid[pos[0], pos[1], prim_idx] = 0      # remove primitive from grid\n\n  # ----------------------------------------------------------------------\n  # 2) If the goal itself is a primitive (no recipe), just pick it up\n  # ----------------------------------------------------------------------\n  if not needed:\n      locs = list(zip(*np.where(grid[:, :, goal] > 0)))\n      if locs:\n          target = min(locs, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n          path = bfs(pos, target, allow_target_block=True)\n          if path is None:\n              path = manhattan_path(pos, target)\n          actions.extend(path)\n          actions.append(USE)\n          return actions\n\n  # ----------------------------------------------------------------------\n  # 3) Move to the appropriate workshop (if any) and craft the goal item\n  # ----------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      ws_locs = list(zip(*np.where(state.grid[:, :, workshop_idx] > 0)))\n      if ws_locs:\n          target_ws = min(\n              ws_locs,\n              key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),\n          )\n          path = bfs(pos, target_ws, allow_target_block=True)\n          if path is None:\n              path = manhattan_path(pos, target_ws)\n          actions.extend(path)\n          actions.append(USE)   # craft at the workshop\n  else:\n      # No specific workshop \u2013 just use at current location\n      actions.append(USE)\n\n  return actions", "env_interactions": 1, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:11:51.143465", "function_name": "make_arrow", "function_body": "  # Action constants\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  actions = []\n\n  # Determine the agent's current position (use internal state if available)\n  if hasattr(env, \"_current_state\"):\n      cur_pos = list(env._current_state.pos)\n  else:\n      cur_pos = list(env.scenario.init_pos)\n\n  # Work on a mutable copy of the initial grid so we can mark collected items\n  grid = env.scenario.init_grid.copy()\n\n  # Index of the goal item (arrow)\n  goal_idx = env.task.goal\n\n  # ------------------------------------------------------------------\n  # Helper functions\n  # ------------------------------------------------------------------\n  def _move_to(pos, tgt):\n      \"\"\"Append actions that move the agent from `pos` to `tgt` (both [x, y]).\"\"\"\n      while pos[0] != tgt[0] or pos[1] != tgt[1]:\n          if pos[0] < tgt[0]:\n              actions.append(RIGHT)\n              pos[0] += 1\n          elif pos[0] > tgt[0]:\n              actions.append(LEFT)\n              pos[0] -= 1\n          elif pos[1] < tgt[1]:\n              actions.append(DOWN)\n              pos[1] += 1\n          elif pos[1] > tgt[1]:\n              actions.append(UP)\n              pos[1] -= 1\n\n  def _nearest_kind(kind_idx):\n      \"\"\"Return the [x, y] coordinate of the nearest cell containing `kind_idx`, or None.\"\"\"\n      ys, xs = np.where(grid[:, :, kind_idx] > 0)\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])\n      best = int(np.argmin(dists))\n      return [int(xs[best]), int(ys[best])]\n\n  # ------------------------------------------------------------------\n  # 1. Collect all primitive resources required for the arrow\n  # ------------------------------------------------------------------\n  primitive_reqs = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  for prim_kind, count in primitive_reqs.items():\n      for _ in range(count):\n          target = _nearest_kind(prim_kind)\n          if target is None:\n              # Primitive not found \u2013 abort planning early\n              return actions\n          _move_to(cur_pos, target)\n          actions.append(USE)  # pick up the primitive\n          # Mark the primitive as taken in our local copy of the grid\n          grid[target[1], target[0], prim_kind] = 0\n\n  # ------------------------------------------------------------------\n  # 2. Move to the appropriate workshop (if any) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      workshop_pos = _nearest_kind(workshop_kind)\n      if workshop_pos is not None:\n          _move_to(cur_pos, workshop_pos)\n          actions.append(USE)  # craft at the workshop\n\n  # Return the complete action sequence\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:11:52.266141", "function_name": "make_arrow", "function_body": "  # Action indices\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Helper to move from current position `pos` to target `tgt`,\n  # appending the corresponding actions to `seq`.\n  def _move_to(pos, tgt, seq):\n      while pos[0] != tgt[0] or pos[1] != tgt[1]:\n          if pos[0] < tgt[0]:\n              seq.append(RIGHT)\n              pos[0] += 1\n          elif pos[0] > tgt[0]:\n              seq.append(LEFT)\n              pos[0] -= 1\n          elif pos[1] < tgt[1]:\n              seq.append(DOWN)\n              pos[1] += 1\n          else:  # pos[1] > tgt[1]\n              seq.append(UP)\n              pos[1] -= 1\n\n  # Helper to locate the nearest cell containing a given kind.\n  def _nearest_kind(kind_idx, cur_pos, grid):\n      ys, xs = np.where(grid[:, :, kind_idx] > 0)\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])\n      best = int(np.argmin(dists))\n      return [int(xs[best]), int(ys[best])]\n\n  # ------------------------------------------------------------------\n  # Begin planning\n  # ------------------------------------------------------------------\n  actions = []\n\n  # Determine current position (use internal state if present)\n  if hasattr(env, \"_current_state\"):\n      cur_pos = list(env._current_state.pos)\n  else:\n      cur_pos = list(env.scenario.init_pos)\n\n  # Work on a mutable copy of the grid to keep track of collected items\n  grid = env.scenario.init_grid.copy()\n\n  # Index of the goal item\n  goal_idx = env.task.goal\n\n  # ------------------------------------------------------------------\n  # 1. Collect all primitive resources required for the goal\n  # ------------------------------------------------------------------\n  primitive_reqs = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  for prim_kind, count in primitive_reqs.items():\n      for _ in range(count):\n          target = _nearest_kind(prim_kind, cur_pos, grid)\n          if target is None:\n              # Primitive not found \u2013 abort planning\n              return actions\n          _move_to(cur_pos, target, actions)\n          actions.append(USE)  # pick up primitive\n          # Mark the primitive as collected in our grid copy\n          grid[target[1], target[0], prim_kind] = 0\n\n  # ------------------------------------------------------------------\n  # 2. Move to the appropriate workshop (if any) and craft the item\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      workshop_pos = _nearest_kind(workshop_kind, cur_pos, grid)\n      if workshop_pos is not None:\n          _move_to(cur_pos, workshop_pos, actions)\n          actions.append(USE)  # craft at the workshop\n\n  # Return the planned sequence of actions\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:12:19.289829", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Retrieve the scenario and world objects from the provided environment.\n  # ----------------------------------------------------------------------\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # ----------------------------------------------------------------------\n  # Identify the integer index of the target item \"arrow\" using the\n  # cookbook's Index mapping. If the name is not present we cannot plan.\n  # ----------------------------------------------------------------------\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # ----------------------------------------------------------------------\n  # Obtain the initial CraftState for the episode.  This represents the\n  # starting grid, agent position, direction and empty inventory.\n  # ----------------------------------------------------------------------\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  # ----------------------------------------------------------------------\n  # Helper structures for breadth\u2011first search (BFS) over the state space.\n  # ----------------------------------------------------------------------\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      # Position, direction, inventory contents and the full grid layout.\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  # ----------------------------------------------------------------------\n  # Planning parameters.\n  # ----------------------------------------------------------------------\n  MAX_STEPS = 800                     # safety bound on plan length\n  n_actions = getattr(world, \"n_actions\", 5)   # default: 0\u20114 (move+use)\n\n  # ----------------------------------------------------------------------\n  # Breadth\u2011first search loop.\n  # ----------------------------------------------------------------------\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: does the inventory contain at least one arrow?\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long candidate plans.\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions from the current state.\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # ----------------------------------------------------------------------\n  # No plan found within the allowed search budget.\n  # ----------------------------------------------------------------------\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T18:12:34.959940", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Helper to safely extract scenario and world objects from the env wrapper\n  # ----------------------------------------------------------------------\n  scenario = getattr(env, \"scenario\", None) or env\n  world = getattr(scenario, \"world\", None) or getattr(env, \"world\", None)\n  if world is None:\n      return []\n\n  # ----------------------------------------------------------------------\n  # Identify the index of the target item \"arrow\"\n  # ----------------------------------------------------------------------\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # ----------------------------------------------------------------------\n  # Obtain the initial state of the episode\n  # ----------------------------------------------------------------------\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  # ----------------------------------------------------------------------\n  # Create a hashable representation of a state for the visited set.\n  # We include position, direction, inventory and the full grid layout.\n  # ----------------------------------------------------------------------\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  # ----------------------------------------------------------------------\n  # Planning parameters\n  # ----------------------------------------------------------------------\n  MAX_PLAN_LENGTH = 800               # safety bound on plan length\n  n_actions = getattr(world, \"n_actions\", 5)   # default: 0\u20114 (UP,DOWN,LEFT,RIGHT,USE)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test \u2013 inventory contains at least one arrow\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long trajectories\n      if len(node.actions) >= MAX_PLAN_LENGTH:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within the limits \u2013 return empty action list\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T18:12:58.781765", "function_name": "make_arrow", "function_body": "  # Resolve scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Starting state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      # Hash includes position, direction, inventory contents and full grid layout\n      return (\n          st.pos,\n          st.dir,\n          st.inventory.tobytes(),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 300                      # safety bound on plan length\n  n_actions = getattr(world, \"n_actions\", 5)   # default to 5 actions (0\u20114)\n\n  while frontier:\n      node = frontier.popleft()\n      cur = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur.satisfies(\"\", target_idx):\n          return node.actions\n\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible primitive actions\n      for a in range(n_actions):\n          _, nxt = cur.step(a)\n          h = _state_hash(nxt)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt, node.actions + [a]))\n\n  # No feasible plan found within limits\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T18:13:14.373853", "function_name": "make_arrow", "function_body": "  # Resolve scenario and world objects (robust to different wrappers)\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the goal item \"arrow\"\n  try:\n      goal_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  # BFS structures\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_PLAN_LENGTH = 400            # safety bound\n  n_actions = getattr(world, \"n_actions\", 5)   # default action count\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: inventory contains at least one arrow\n      if cur_state.satisfies(\"\", goal_idx):\n          return node.actions\n\n      # Prune overly long plans\n      if len(node.actions) >= MAX_PLAN_LENGTH:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within limits\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T18:13:37.596215", "function_name": "make_arrow", "function_body": "  # Reset the environment and initialise useful structures\n  env.reset()\n  actions: list[int] = []\n  act_map = env.action_specs()                     # e.g. {\"UP\":0, \"DOWN\":1, ...}\n  move_delta = {\n      \"UP\":    (-1, 0),\n      \"DOWN\":  (1, 0),\n      \"LEFT\":  (0, -1),\n      \"RIGHT\": (0, 1),\n  }\n\n  from collections import deque\n  import numpy as np\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of action names moving the agent\n  # from `start` to a cell that is adjacent (Chebyshev distance \u2264 1)\n  # to any cell in `targets`.  Walks only through empty cells.\n  # ------------------------------------------------------------------\n  def bfs_to_adjacent(start: tuple[int, int],\n                      targets: list[tuple[int, int]],\n                      grid: np.ndarray) -> list[str] | None:\n      W, H = grid.shape[:2]\n      visited = np.full((W, H), False, dtype=bool)\n      q = deque()\n      q.append((start, []))\n      visited[start] = True\n      target_set = set(targets)\n\n      while q:\n          pos, path = q.popleft()\n          # adjacency test (including diagonals)\n          for tx, ty in target_set:\n              if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:\n                  return path\n          # expand neighbours\n          for act_name, (dx, dy) in move_delta.items():\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  # walk only through empty cells (no entity present)\n                  if grid[nx, ny].sum() == 0:\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [act_name]))\n      return None  # no reachable adjacent cell\n\n  # ------------------------------------------------------------------\n  # Identify goal and required primitives\n  # ------------------------------------------------------------------\n  goal_idx = env.task.goal\n  needed_prims = env.world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n\n  # ------------------------------------------------------------------\n  # 1) Collect each required primitive the required number of times\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed_prims.items():\n      for _ in range(count):\n          state = env._current_state\n          grid = state.grid\n          pos = state.pos\n\n          # locate all cells currently holding the primitive\n          prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not prim_cells:\n              # primitive not present \u2013 cannot collect further\n              continue\n\n          # plan a path to an adjacent cell of a reachable primitive\n          path = bfs_to_adjacent(pos, prim_cells, grid)\n          if path is None:\n              # unreachable \u2013 skip this instance\n              continue\n\n          # execute movement actions\n          for act_name in path:\n              act_id = act_map[act_name]\n              actions.append(act_id)\n              env.step(act_id)\n\n          # pick up the primitive (USE)\n          use_id = act_map[\"USE\"]\n          actions.append(use_id)\n          env.step(use_id)\n\n  # ------------------------------------------------------------------\n  # 2) Move to the workshop (if any) and craft the goal item\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      state = env._current_state\n      grid = state.grid\n      pos = state.pos\n\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n      if workshop_cells:\n          path = bfs_to_adjacent(pos, workshop_cells, grid)\n          if path:\n              for act_name in path:\n                  act_id = act_map[act_name]\n                  actions.append(act_id)\n                  env.step(act_id)\n\n          # craft the item with USE at the workshop\n          use_id = act_map[\"USE\"]\n          actions.append(use_id)\n          env.step(use_id)\n\n  # Return the complete action sequence\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:13:38.710914", "function_name": "make_arrow", "function_body": "  # Reset the environment and initialise helpers\n  env.reset()\n  actions: list[int] = []\n  act_map = env.action_specs()          # e.g. {\"UP\":0, \"DOWN\":1, ...}\n  move_delta = {\n      \"UP\":    (-1, 0),\n      \"DOWN\":  (1, 0),\n      \"LEFT\":  (0, -1),\n      \"RIGHT\": (0, 1),\n  }\n\n  from collections import deque\n  import numpy as np\n\n  # ------------------------------------------------------------------\n  # BFS that returns a list of action *names* moving the agent from\n  # `start` to a cell that is adjacent (Chebyshev distance \u2264 1) to any\n  # cell in `targets`.  Walks only through empty cells.\n  # ------------------------------------------------------------------\n  def bfs_to_adjacent(start: tuple[int, int],\n                      targets: list[tuple[int, int]],\n                      grid: np.ndarray) -> list[str] | None:\n      W, H = grid.shape[:2]\n      visited = np.full((W, H), False, dtype=bool)\n      q = deque()\n      q.append((start, []))\n      visited[start] = True\n      target_set = set(targets)\n\n      while q:\n          pos, path = q.popleft()\n          # Check adjacency to any target cell\n          for tx, ty in target_set:\n              if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:\n                  return path\n          # Expand neighbours\n          for act_name, (dx, dy) in move_delta.items():\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  # Only walk through empty cells (no entity present)\n                  if grid[nx, ny].sum() == 0:\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [act_name]))\n      return None  # No reachable adjacent cell found\n\n  # ------------------------------------------------------------------\n  # Identify the goal and the primitives required to craft it\n  # ------------------------------------------------------------------\n  goal_idx = env.task.goal\n  needed_prims = env.world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n\n  # ------------------------------------------------------------------\n  # 1) Collect each required primitive the required number of times\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed_prims.items():\n      for _ in range(count):\n          state = env._current_state\n          grid = state.grid\n          pos = state.pos\n\n          # Locate all cells currently holding the primitive\n          prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not prim_cells:\n              # Primitive absent \u2013 cannot collect further\n              continue\n\n          # Plan a path to an adjacent cell of the nearest reachable primitive\n          path = bfs_to_adjacent(pos, prim_cells, grid)\n          if path is None:\n              # Unreachable primitive \u2013 skip this instance\n              continue\n\n          # Execute the movement actions\n          for act_name in path:\n              act_id = act_map[act_name]\n              actions.append(act_id)\n              env.step(act_id)\n\n          # Pick up the primitive (USE)\n          use_id = act_map[\"USE\"]\n          actions.append(use_id)\n          env.step(use_id)\n\n  # ------------------------------------------------------------------\n  # 2) Move to the appropriate workshop (if any) and craft the goal item\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      state = env._current_state\n      grid = state.grid\n      pos = state.pos\n\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n      if workshop_cells:\n          path = bfs_to_adjacent(pos, workshop_cells, grid)\n          if path:\n              for act_name in path:\n                  act_id = act_map[act_name]\n                  actions.append(act_id)\n                  env.step(act_id)\n\n          # Craft the item with USE at the workshop\n          use_id = act_map[\"USE\"]\n          actions.append(use_id)\n          env.step(use_id)\n\n  # Return the accumulated action sequence\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:13:56.731619", "function_name": "make_arrow", "function_body": "  # Reset environment and obtain current state and world information\n  env.reset()\n  state = env._current_state          # CraftState instance\n  world = env.world                    # CraftWorld instance\n  grid = state.grid                     # (WIDTH, HEIGHT, n_kinds)\n\n  # Action indices as defined by CraftLab.action_specs()\n  specs = env.action_specs()\n  DOWN = specs[\"DOWN\"]\n  UP = specs[\"UP\"]\n  LEFT = specs[\"LEFT\"]\n  RIGHT = specs[\"RIGHT\"]\n  USE = specs[\"USE\"]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  import numpy as np\n  from collections import deque\n\n  # Mapping from direction vectors to action indices\n  DIRS = {\n      (1, 0): DOWN,\n      (-1, 0): UP,\n      (0, -1): LEFT,\n      (0, 1): RIGHT,\n  }\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that moves\n      the agent from ``start`` to ``goal`` while avoiding non\u2011grabbable cells.\n      If no path is found, returns an empty list.\"\"\"\n      if start == goal:\n          return []\n      W, H = grid.shape[0], grid.shape[1]\n      blocked = list(world.non_grabbable_indices)\n\n      visited = np.full((W, H), False, dtype=bool)\n      prev = {}  # (y, x) -> (prev_y, prev_x, action)\n\n      q = deque()\n      q.append(start)\n      visited[start] = True\n\n      while q:\n          y, x = q.popleft()\n          for (dy, dx), act in DIRS.items():\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < W and 0 <= nx < H and not visited[ny, nx]:\n                  # Cell is free if none of the blocked kinds are present\n                  if not np.any(grid[ny, nx, blocked] > 0):\n                      visited[ny, nx] = True\n                      prev[(ny, nx)] = (y, x, act)\n                      if (ny, nx) == goal:\n                          # Reconstruct path\n                          actions = []\n                          cur = (ny, nx)\n                          while cur != start:\n                              py, px, a = prev[cur]\n                              actions.append(a)\n                              cur = (py, px)\n                          actions.reverse()\n                          return actions\n                      q.append((ny, nx))\n      # No path found\n      return []\n\n  def find_nearest(cell_kind, from_pos):\n      \"\"\"Find the nearest cell containing ``cell_kind`` (primitive or workshop)\n      using Manhattan distance. Returns coordinates (y, x) or None.\"\"\"\n      locations = np.argwhere(grid[:, :, cell_kind] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest_idx = np.argmin(dists)\n      return tuple(locations[nearest_idx])\n\n  # ------------------------------------------------------------------\n  # Determine goal index and required primitives\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  needed = world.cookbook.primitives_for(arrow_idx)   # {primitive_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the necessary number of times\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive not present; abort early.\n              return actions\n\n          # Move to the primitive cell (standing on it is sufficient for USE)\n          move_actions = bfs_path(cur_pos, target)\n          actions.extend(move_actions)\n          cur_pos = target\n\n          # Pick up the primitive\n          actions.append(USE)\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if the recipe specifies one) and craft\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          actions.extend(bfs_path(cur_pos, ws_cell))\n          cur_pos = ws_cell\n\n  # Trigger crafting at the current location\n  actions.append(USE)\n\n  return actions", "env_interactions": 19, "island_id": 7, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T18:13:57.848404", "function_name": "make_arrow", "function_body": "  # Reset the environment and fetch useful references\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid                     # (W, H, n_kinds)\n\n  # Action indices (consistent with CraftLab.action_specs)\n  specs = env.action_specs()\n  DOWN = specs[\"DOWN\"]\n  UP = specs[\"UP\"]\n  LEFT = specs[\"LEFT\"]\n  RIGHT = specs[\"RIGHT\"]\n  USE = specs[\"USE\"]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  from collections import deque\n  import numpy as np\n\n  # Mapping of movement vectors to action indices\n  DIRS = {\n      (1, 0): DOWN,\n      (-1, 0): UP,\n      (0, -1): LEFT,\n      (0, 1): RIGHT,\n  }\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that\n      moves the agent from ``start`` to ``goal`` while avoiding cells that\n      contain any non\u2011grabbable entity. If no path exists, return [].\n      \"\"\"\n      if start == goal:\n          return []\n\n      W, H = grid.shape[0], grid.shape[1]\n      blocked_kinds = list(world.non_grabbable_indices)\n\n      visited = np.full((W, H), False, dtype=bool)\n      prev = {}  # (y, x) -> (prev_y, prev_x, action)\n\n      q = deque()\n      q.append(start)\n      visited[start] = True\n\n      while q:\n          y, x = q.popleft()\n          for (dy, dx), act in DIRS.items():\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < W and 0 <= nx < H and not visited[ny, nx]:\n                  # Cell is free if none of the blocked kinds are present\n                  if not np.any(grid[ny, nx, blocked_kinds] > 0):\n                      visited[ny, nx] = True\n                      prev[(ny, nx)] = (y, x, act)\n                      if (ny, nx) == goal:\n                          # Reconstruct path\n                          actions = []\n                          cur = (ny, nx)\n                          while cur != start:\n                              py, px, a = prev[cur]\n                              actions.append(a)\n                              cur = (py, px)\n                          actions.reverse()\n                          return actions\n                      q.append((ny, nx))\n      # No path found\n      return []\n\n  def find_nearest(cell_kind, from_pos):\n      \"\"\"Find the nearest cell containing ``cell_kind`` (primitive or workshop)\n      using Manhattan distance. Returns coordinates (y, x) or None if absent.\"\"\"\n      locations = np.argwhere(grid[:, :, cell_kind] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest_idx = np.argmin(dists)\n      return tuple(locations[nearest_idx])\n\n  # ------------------------------------------------------------------\n  # Determine the goal index and required primitives\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  needed = world.cookbook.primitives_for(arrow_idx)   # {primitive_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the necessary number of times\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive not present \u2013 abort early.\n              return actions\n\n          # Move to the primitive cell (standing on it is sufficient for USE)\n          move_actions = bfs_path(cur_pos, target)\n          actions.extend(move_actions)\n          cur_pos = target\n\n          # Pick up the primitive\n          actions.append(USE)\n\n  # ------------------------------------------------------------------\n  # Move to the workshop required by the recipe (if any) and craft\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          actions.extend(bfs_path(cur_pos, ws_cell))\n          cur_pos = ws_cell\n\n  # Trigger crafting at the current location\n  actions.append(USE)\n\n  return actions", "env_interactions": 19, "island_id": 7, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T18:14:47.724553", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Setup world, cookbook and target index\n  # ----------------------------------------------------------------------\n  world = env.world\n  cookbook = world.cookbook\n  try:\n    target_idx = cookbook.index[\"arrow\"]\n  except Exception:\n    return []  # arrow not defined in this world\n\n  # ----------------------------------------------------------------------\n  # Resolve recipe: collect primitive requirements and crafting order\n  # ----------------------------------------------------------------------\n  needed_prims = {}          # primitive kind \u2192 total count needed\n  craft_steps = []           # list of (item_idx, count) in order\n\n  def resolve(item_idx, mult):\n    \"\"\"Recursively gather primitive counts and schedule crafting steps.\"\"\"\n    rec = cookbook.recipes.get(item_idx)\n    if rec is None:  # primitive (no recipe)\n      needed_prims[item_idx] = needed_prims.get(item_idx, 0) + mult\n      return\n    # Resolve ingredients first\n    for ing, cnt in rec.items():\n      if isinstance(ing, int):\n        resolve(ing, cnt * mult)\n    # After ingredients, schedule this item to be crafted\n    craft_steps.append((item_idx, mult))\n\n  resolve(target_idx, 1)\n\n  # ----------------------------------------------------------------------\n  # Extract current grid, position and build static blocked map\n  # ----------------------------------------------------------------------\n  grid = env._current_state.grid.copy()          # mutable copy for planning\n  w, h, _ = grid.shape\n  pos = tuple(env._current_state.pos)\n\n  blocked = np.zeros((w, h), dtype=bool)\n  for idx in world.non_grabbable_indices:\n    blocked |= grid[:, :, idx] > 0\n\n  # Directions: action index \u2192 (dx, dy)\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]  # DOWN, UP, LEFT, RIGHT\n\n  # ----------------------------------------------------------------------\n  # Bread\u2011first search returning a list of actions to the nearest target cell\n  # ----------------------------------------------------------------------\n  def bfs(start, targets):\n    q = collections.deque([(start, [])])\n    visited = {start}\n    while q:\n      (x, y), path = q.popleft()\n      if (x, y) in targets:\n        return path\n      for a, (dx, dy) in enumerate(DIRS):\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n          if not blocked[nx, ny]:\n            visited.add((nx, ny))\n            q.append(((nx, ny), path + [a]))\n    return []  # no path (should not happen in solvable scenarios)\n\n  # ----------------------------------------------------------------------\n  # Helpers to move along a path and update current position\n  # ----------------------------------------------------------------------\n  actions = []\n\n  def move_along(path):\n    nonlocal pos\n    for a in path:\n      dx, dy = DIRS[a]\n      pos = (pos[0] + dx, pos[1] + dy)\n      actions.append(a)\n\n  # ----------------------------------------------------------------------\n  # 1) Collect all required primitive resources\n  # ----------------------------------------------------------------------\n  for kind_idx, cnt in needed_prims.items():\n    for _ in range(cnt):\n      # Locate cells that currently hold the required primitive\n      cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, kind_idx] > 0}\n      if not cells:\n        # Primitive not present; skip (environment may already have it)\n        continue\n      if pos in cells:\n        # Already on a cell with the item\n        actions.append(4)          # USE\n        grid[pos[0], pos[1], kind_idx] = max(0, grid[pos[0], pos[1], kind_idx] - 1)\n        continue\n      path = bfs(pos, cells)\n      move_along(path)\n      actions.append(4)            # USE\n      # Simulate picking up the item\n      grid[pos[0], pos[1], kind_idx] = max(0, grid[pos[0], pos[1], kind_idx] - 1)\n\n  # ----------------------------------------------------------------------\n  # 2) Perform crafting steps at the appropriate workshops\n  # ----------------------------------------------------------------------\n  for item_idx, cnt in craft_steps:\n    rec = cookbook.recipes[item_idx]\n    wk_key = rec.get(\"_at\", rec.get(\"_key\"))\n    wk_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]\n\n    # Locate workshop cells of the required type\n    wk_cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, wk_idx] > 0}\n    if not wk_cells:\n      continue  # no workshop found; skip (should not happen)\n\n    if pos not in wk_cells:\n      path = bfs(pos, wk_cells)\n      move_along(path)\n\n    # Use the workshop the required number of times\n    actions.extend([4] * cnt)   # USE\n\n  return actions", "env_interactions": 20, "island_id": 6, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T18:14:48.839787", "function_name": "make_arrow", "function_body": "  import collections\n  import numpy as np\n\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]  # actions 0\u20113: down, up, left, right\n\n  def bfs(start, targets, blocked):\n      w, h = grid.shape[:2]\n      q = collections.deque([(start, [])])\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in targets:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not blocked[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []  # no path found (should not happen)\n\n  def go_to_and_use(kind_idx, count):\n      nonlocal pos, actions\n      for _ in range(count):\n          cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, kind_idx] > 0}\n          path = bfs(pos, cells, blocked)\n          actions.extend(path)\n          for a in path:\n              dx, dy = DIRS[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(4)  # USE action\n\n  # ------------------------------------------------------------------\n  # Gather recipe information for the target item \"arrow\"\n  # ------------------------------------------------------------------\n  world = env.world\n  cookbook = world.cookbook\n  arrow_idx = cookbook.index[\"arrow\"]\n\n  needed_prims = {}      # primitive kind -> total count required\n  craft_steps = []       # list of (item_idx, count) in order\n\n  def resolve(item_idx, mult):\n      \"\"\"Recursively collect primitive requirements and schedule crafting.\"\"\"\n      rec = cookbook.recipes.get(item_idx)\n      if rec is None:\n          needed_prims[item_idx] = needed_prims.get(item_idx, 0) + mult\n          return\n      for ing, cnt in rec.items():\n          if isinstance(ing, int):\n              resolve(ing, cnt * mult)\n      craft_steps.append((item_idx, mult))\n\n  resolve(arrow_idx, 1)\n\n  # ------------------------------------------------------------------\n  # Prepare static data: grid, blocked cells, dimensions\n  # ------------------------------------------------------------------\n  grid = env._current_state.grid\n  w, h, _ = grid.shape\n  blocked = np.zeros((w, h), dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # ------------------------------------------------------------------\n  # Build the action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  pos = tuple(env._current_state.pos)\n\n  # 1) Collect all primitive resources needed\n  for kind_idx, cnt in needed_prims.items():\n      go_to_and_use(kind_idx, cnt)\n\n  # 2) Perform crafting steps at the appropriate workshops\n  for item_idx, cnt in craft_steps:\n      rec = cookbook.recipes[item_idx]\n      wk_key = rec.get(\"_at\") or rec.get(\"_key\")\n      wk_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]\n\n      wk_cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, wk_idx] > 0}\n      path = bfs(pos, wk_cells, blocked)\n      actions.extend(path)\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n\n      actions.extend([4] * cnt)   # USE action repeated for each craft\n\n  return actions", "env_interactions": 20, "island_id": 6, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T18:15:13.158814", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action IDs as defined by CraftLab\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n  DIR_TO_ACT = {\n      (0, 1): ACTION_DOWN,   # y+ (down)\n      (0, -1): ACTION_UP,    # y- (up)\n      (-1, 0): ACTION_LEFT,  # x- (left)\n      (1, 0): ACTION_RIGHT,  # x+ (right)\n  }\n  ACT_TO_DIR = {v: k for k, v in DIR_TO_ACT.items()}\n\n  def bfs_adjacent(start, targets, grid):\n      \"\"\"\n      Bread\u2011first search returning a list of actions that moves the agent\n      from ``start`` to a cell adjacent (Manhattan distance 1) to any cell\n      in ``targets`` while avoiding non\u2011grabbable obstacles.\n      \"\"\"\n      W, H = grid.shape[:2]\n\n      # Cells occupied by any non\u2011grabbable entity block movement.\n      blocked = np.zeros((W, H), dtype=bool)\n      for idx in env.world.non_grabbable_indices:\n          blocked |= grid[:, :, idx] > 0\n\n      sx, sy = start\n\n      # Already adjacent?\n      for tx, ty in targets:\n          if abs(sx - tx) + abs(sy - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((sx, sy, []))\n      visited = np.full((W, H), False, dtype=bool)\n      visited[sx, sy] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR_TO_ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if blocked[nx, ny]:\n                      continue\n                  npath = path + [act]\n                  for tx, ty in targets:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return npath\n                  visited[nx, ny] = True\n                  q.append((nx, ny, npath))\n      return []  # no reachable adjacency\n\n  # ------------------------------------------------------------------\n  # Initialise mutable copies of the current state\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()\n  pos = tuple(state.pos)  # (x, y)\n\n  # Goal index (may be stored directly or inside a Struct)\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      raise ValueError(\"Goal index not found in env.task\")\n\n  # ------------------------------------------------------------------\n  # Determine required primitives (recursively expanded)\n  # ------------------------------------------------------------------\n  needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  # If the goal itself is a primitive (no recipe), we need to collect it.\n  if not needed and goal_idx in env.world.cookbook.primitives:\n      needed = {goal_idx: 1}\n\n  plan = []\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives\n  # ------------------------------------------------------------------\n  for kind_idx, cnt in needed.items():\n      while cnt > 0:\n          cells = np.argwhere(grid[:, :, kind_idx] > 0)\n          if cells.size == 0:\n              # Primitive not present in the world \u2013 abort planning.\n              return plan\n\n          path = bfs_adjacent(pos, cells.tolist(), grid)\n          plan.extend(path)\n\n          # Simulate movement\n          for a in path:\n              dx, dy = ACT_TO_DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Use action to pick up the primitive\n          plan.append(ACTION_USE)\n\n          # Find which cell we are now adjacent to\n          adj_cell = None\n          for cx, cy in cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  adj_cell = (cx, cy)\n                  break\n          if adj_cell is None:\n              # Should not happen; break to avoid infinite loop.\n              break\n\n          # Update simulated grid and decrement needed count\n          grid[adj_cell[0], adj_cell[1], kind_idx] -= 1\n          cnt -= 1\n\n  # ------------------------------------------------------------------\n  # 2. Move to the appropriate workshop (if any) and craft the goal\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\") or recipe.get(\"_key\")\n  if workshop_key is not None:\n      if isinstance(workshop_key, str):\n          workshop_idx = env.world.cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          path = bfs_adjacent(pos, workshop_cells.tolist(), grid)\n          plan.extend(path)\n\n          for a in path:\n              dx, dy = ACT_TO_DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Craft by using the workshop\n          plan.append(ACTION_USE)\n\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:15:14.268884", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ------------------------------------------------------------------\n  # Action / direction helpers (as defined by CraftLab)\n  # ------------------------------------------------------------------\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n  DIR_TO_ACT = {\n      (0, 1): ACTION_DOWN,    # y+ (down)\n      (0, -1): ACTION_UP,     # y- (up)\n      (-1, 0): ACTION_LEFT,   # x- (left)\n      (1, 0): ACTION_RIGHT,   # x+ (right)\n  }\n  ACT_TO_DIR = {v: k for k, v in DIR_TO_ACT.items()}\n\n  # ------------------------------------------------------------------\n  # Bread\u2011first search returning a list of actions that moves the agent\n  # from ``start`` to a cell adjacent to any cell in ``targets``.\n  # ------------------------------------------------------------------\n  def bfs(start, targets, grid):\n      \"\"\"\n      Parameters\n      ----------\n      start : tuple (x, y)\n          Current agent position.\n      targets : list of (x, y)\n          Cells we want to become adjacent to.\n      grid : np.ndarray (W, H, K)\n          Current world grid. Any non\u2011zero entry in the last axis counts as\n          an obstacle for movement.\n\n      Returns\n      -------\n      list[int]\n          Sequence of action indices that brings the agent adjacent to a\n          target cell. May be empty if already adjacent or if no path exists.\n      \"\"\"\n      W, H = grid.shape[:2]\n\n      # Any occupied cell blocks movement.\n      blocked = np.any(grid > 0, axis=2)\n\n      sx, sy = start\n\n      # Quick check: already adjacent?\n      for tx, ty in targets:\n          if abs(sx - tx) + abs(sy - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((sx, sy, []))\n      visited = np.full((W, H), False, dtype=bool)\n      visited[sx, sy] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR_TO_ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if blocked[nx, ny]:\n                      continue\n                  npath = path + [act]\n                  # Check adjacency to any target.\n                  for tx, ty in targets:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return npath\n                  visited[nx, ny] = True\n                  q.append((nx, ny, npath))\n      # No reachable adjacency.\n      return []\n\n  # ------------------------------------------------------------------\n  # Main planning logic\n  # ------------------------------------------------------------------\n  # Current state (the environment holds a CraftLab wrapper around a CraftState).\n  state = env._current_state\n  grid = state.grid.copy()               # mutable copy of the world grid\n  pos = tuple(state.pos)                 # (x, y)\n\n  # Goal item index (the task stores a ``goal`` attribute \u2013 may be an int or a struct).\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      raise ValueError(\"Goal not found in env.task\")\n\n  # ------------------------------------------------------------------\n  # 1. Determine which primitive resources are needed to craft the goal.\n  # ------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  plan = []  # final list of actions to return\n\n  # ------------------------------------------------------------------\n  # 2. Collect each primitive the required number of times.\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      while needed > 0:\n          # Locate all cells that currently contain this primitive.\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # Primitive not present \u2013 cannot continue planning.\n              return plan\n\n          # Find a path to the nearest primitive (adjacent cell).\n          path = bfs(pos, prim_cells.tolist(), grid)\n          plan.extend(path)\n\n          # Simulate the movement so that ``pos`` stays in sync.\n          for a in path:\n              dx, dy = ACT_TO_DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Use (collect) the primitive.\n          plan.append(ACTION_USE)\n\n          # Determine which primitive cell we are now adjacent to.\n          adj_cell = None\n          for cx, cy in prim_cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  adj_cell = (cx, cy)\n                  break\n          if adj_cell is None:\n              # Unexpected situation; break to avoid infinite loop.\n              break\n\n          # Update our local grid copy (remove one instance) and decrement counter.\n          grid[adj_cell[0], adj_cell[1], prim_idx] -= 1\n          needed -= 1\n\n  # ------------------------------------------------------------------\n  # 3. Move to the appropriate workshop (if any) and craft the goal.\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\") or recipe.get(\"_key\")\n  if workshop_key is not None:\n      # Resolve workshop index (could be name or integer).\n      if isinstance(workshop_key, str):\n          workshop_idx = env.world.cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          path = bfs(pos, workshop_cells.tolist(), grid)\n          plan.extend(path)\n\n          # Simulate final movement.\n          for a in path:\n              dx, dy = ACT_TO_DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Craft by using the workshop.\n          plan.append(ACTION_USE)\n\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:15:38.241613", "function_name": "make_arrow", "function_body": "  # Reset environment and fetch core objects\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()             # mutable copy for planning\n\n  # Action indices (may be overridden by env.action_specs)\n  specs = env.action_specs()\n  DOWN = specs.get(\"DOWN\", 0)\n  UP = specs.get(\"UP\", 1)\n  LEFT = specs.get(\"LEFT\", 2)\n  RIGHT = specs.get(\"RIGHT\", 3)\n  USE = specs.get(\"USE\", 4)\n\n  # Directions as (dy, dx, action)\n  DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def in_bounds(y, x):\n      return 0 <= y < grid.shape[0] and 0 <= x < grid.shape[1]\n\n  def cell_blocked(y, x):\n      \"\"\"A cell is blocked if any entity occupies it.\"\"\"\n      return np.any(grid[y, x, :])\n\n  from collections import deque\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of movement actions to go from start to goal.\"\"\"\n      if start == goal:\n          return []\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          y, x = q.popleft()\n          if (y, x) == goal:\n              # reconstruct path\n              rev = []\n              cur = goal\n              while cur != start:\n                  py, px = parent[cur]\n                  if cur[0] == py + 1:\n                      rev.append(DOWN)\n                  elif cur[0] == py - 1:\n                      rev.append(UP)\n                  elif cur[1] == px + 1:\n                      rev.append(RIGHT)\n                  elif cur[1] == px - 1:\n                      rev.append(LEFT)\n                  cur = (py, px)\n              return list(reversed(rev))\n          for dy, dx, act in DIRS:\n              ny, nx = y + dy, x + dx\n              if not in_bounds(ny, nx):\n                  continue\n              if (ny, nx) in visited:\n                  continue\n              if cell_blocked(ny, nx):\n                  continue\n              visited.add((ny, nx))\n              parent[(ny, nx)] = (y, x)\n              q.append((ny, nx))\n      # No path found\n      return []\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Locate the closest cell containing the given kind index.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return tuple(nearest)\n\n  def adjacent_free(cell, avoid=set()):\n      \"\"\"Return a free neighbour of `cell` not in `avoid`.\"\"\"\n      y, x = cell\n      for dy, dx, _ in DIRS:\n          ny, nx = y + dy, x + dx\n          if not in_bounds(ny, nx):\n              continue\n          if (ny, nx) in avoid:\n              continue\n          if not cell_blocked(ny, nx):\n              return (ny, nx)\n      return None\n\n  def face_towards(src, dst):\n      \"\"\"Return a single movement action that makes src face dst.\"\"\"\n      dy, dx = dst[0] - src[0], dst[1] - src[1]\n      if dy == 1:\n          return DOWN\n      if dy == -1:\n          return UP\n      if dx == 1:\n          return RIGHT\n      if dx == -1:\n          return LEFT\n      return None\n\n  # ------------------------------------------------------------------\n  # Determine goal index and required primitives\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed = world.cookbook.primitives_for(arrow_idx)          # {prim_idx: count}\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = world.cookbook.index.index(workshop_name) if workshop_name else None\n\n  actions = []\n  cur_pos = state.pos               # (y, x)\n  collected = set()                 # cells already harvested\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the needed number of times\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive not present; abort early.\n              return actions\n\n          # Choose a free adjacent cell to stand on while picking up.\n          adj = adjacent_free(target, avoid=collected)\n          if adj is None:\n              # No free neighbour; stand on the primitive cell itself.\n              adj = target\n\n          # Move to the chosen adjacent cell.\n          actions += bfs_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive and pick it up.\n          face_act = face_towards(cur_pos, target)\n          if face_act is not None:\n              actions.append(face_act)\n          actions.append(USE)\n\n          # Update internal grid copy and record the harvested cell.\n          grid[target[0], target[1], prim_idx] = 0\n          collected.add(target)\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          ws_adj = adjacent_free(ws_cell, avoid=collected)\n          if ws_adj is None:\n              ws_adj = ws_cell\n          actions += bfs_path(cur_pos, ws_adj)\n          cur_pos = ws_adj\n\n          # Face the workshop before using.\n          face_act = face_towards(cur_pos, ws_cell)\n          if face_act is not None:\n              actions.append(face_act)\n\n  # Final USE to trigger crafting (or to craft directly if no workshop).\n  actions.append(USE)\n\n  return actions", "env_interactions": 37, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T18:15:39.395555", "function_name": "make_arrow", "function_body": "  # Reset environment and fetch core objects\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()             # mutable copy of the grid\n\n  # Action indices (may differ across environments)\n  specs = env.action_specs()\n  DOWN = specs.get(\"DOWN\", 0)\n  UP = specs.get(\"UP\", 1)\n  LEFT = specs.get(\"LEFT\", 2)\n  RIGHT = specs.get(\"RIGHT\", 3)\n  USE = specs.get(\"USE\", 4)\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]\n\n  def in_bounds(y, x):\n      return 0 <= y < grid.shape[0] and 0 <= x < grid.shape[1]\n\n  def cell_blocked(y, x):\n      \"\"\"A cell is blocked if any entity occupies it.\"\"\"\n      return grid[y, x].any()\n\n  from collections import deque\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of movement actions from start to goal avoiding blocked cells.\"\"\"\n      if start == goal:\n          return []\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          y, x = q.popleft()\n          if (y, x) == goal:\n              # reconstruct path\n              rev = []\n              cur = goal\n              while cur != start:\n                  py, px = parent[cur]\n                  if cur[0] == py + 1:\n                      rev.append(DOWN)\n                  elif cur[0] == py - 1:\n                      rev.append(UP)\n                  elif cur[1] == px + 1:\n                      rev.append(RIGHT)\n                  elif cur[1] == px - 1:\n                      rev.append(LEFT)\n                  cur = (py, px)\n              return list(reversed(rev))\n          for dy, dx, act in DIRS:\n              ny, nx = y + dy, x + dx\n              if not in_bounds(ny, nx):\n                  continue\n              if (ny, nx) in visited:\n                  continue\n              if cell_blocked(ny, nx):\n                  continue\n              visited.add((ny, nx))\n              parent[(ny, nx)] = (y, x)\n              q.append((ny, nx))\n      # No path found\n      return []\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Locate the closest cell containing the given kind index.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return tuple(nearest)\n\n  def adjacent_free(cell, avoid=set()):\n      \"\"\"Return a free neighbour of ``cell`` that is not in ``avoid``.\"\"\"\n      y, x = cell\n      for dy, dx, _ in DIRS:\n          ny, nx = y + dy, x + dx\n          if not in_bounds(ny, nx):\n              continue\n          if (ny, nx) in avoid:\n              continue\n          if not cell_blocked(ny, nx):\n              return (ny, nx)\n      return None\n\n  def face_towards(src, dst):\n      \"\"\"Return a single movement action that makes src face dst.\"\"\"\n      dy, dx = dst[0] - src[0], dst[1] - src[1]\n      if dy == 1:\n          return DOWN\n      if dy == -1:\n          return UP\n      if dx == 1:\n          return RIGHT\n      if dx == -1:\n          return LEFT\n      return None\n\n  # ------------------------------------------------------------------\n  # Determine goal index for 'arrow' and its crafting requirements\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed = world.cookbook.primitives_for(arrow_idx)          # {primitive_idx: count}\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = world.cookbook.index.index(workshop_name) if workshop_name else None\n\n  actions = []\n  cur_pos = state.pos               # (y, x)\n  harvested = set()                 # remember which cells we already collected from\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the necessary number of times\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive missing \u2013 abort early.\n              return actions\n\n          # Choose a free adjacent cell to stand on while picking up.\n          adj = adjacent_free(target, avoid=harvested)\n          if adj is None:\n              # No free neighbour; fall back to standing on the primitive cell.\n              adj = target\n\n          # Move to the chosen adjacent cell.\n          actions += bfs_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive and pick it up.\n          face_act = face_towards(cur_pos, target)\n          if face_act is not None:\n              actions.append(face_act)\n          actions.append(USE)\n\n          # Update internal grid copy so future searches ignore this cell.\n          grid[target[0], target[1], prim_idx] = 0\n          harvested.add(target)\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          ws_adj = adjacent_free(ws_cell, avoid=harvested)\n          if ws_adj is None:\n              ws_adj = cur_pos\n          actions += bfs_path(cur_pos, ws_adj)\n          cur_pos = ws_adj\n\n          # Face the workshop before using.\n          face_act = face_towards(cur_pos, ws_cell)\n          if face_act is not None:\n              actions.append(face_act)\n\n  # Final USE to trigger crafting (or to craft directly if no workshop).\n  actions.append(USE)\n\n  return actions", "env_interactions": 37, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T18:16:28.925264", "function_name": "make_arrow", "function_body": "  spec = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      spec[\"DOWN\"], spec[\"UP\"], spec[\"LEFT\"], spec[\"RIGHT\"], spec[\"USE\"]\n  )\n\n  goal_idx = env.task.goal\n  required = env.world.cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n\n  state = env._current_state\n  pos = tuple(state.pos)               # current (x, y)\n  grid = state.grid.copy()              # mutable copy for simulation\n  actions = []                           # accumulated actions\n\n  # -----------------------------------------------------------------\n  # Helper: BFS pathfinder that avoids non\u2011grabbable entities.\n  # Returns a list of actions moving from start \u2192 target.\n  # -----------------------------------------------------------------\n  def bfs(start, target):\n      width, height = grid.shape[:2]\n\n      non_grab = list(env.world.non_grabbable_indices)\n      if non_grab:\n          blocked = np.any(grid[:, :, non_grab] > 0, axis=2)\n      else:\n          blocked = np.zeros((width, height), dtype=bool)\n\n      # Allow stepping onto the target cell even if it is blocked.\n      blocked[target[0], target[1]] = False\n\n      q = collections.deque([start])\n      parent = {start: None}\n      act_to = {}\n\n      dirs = [\n          (DOWN, (1, 0)),\n          (UP, (-1, 0)),\n          (RIGHT, (0, 1)),\n          (LEFT, (0, -1)),\n      ]\n\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          x, y = cur\n          for act, (dx, dy) in dirs:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height and not blocked[nx, ny]:\n                  nxt = (nx, ny)\n                  if nxt not in parent:\n                      parent[nxt] = cur\n                      act_to[nxt] = act\n                      q.append(nxt)\n\n      if target not in parent:\n          return None\n\n      # Reconstruct action sequence.\n      seq = []\n      cur = target\n      while cur != start:\n          seq.append(act_to[cur])\n          cur = parent[cur]\n      seq.reverse()\n      return seq\n\n  # -----------------------------------------------------------------\n  # Simple Manhattan fallback (ignores obstacles).\n  # -----------------------------------------------------------------\n  def manhattan_path(start, target):\n      seq = []\n      dx = target[0] - start[0]\n      dy = target[1] - start[1]\n      while dx > 0:\n          seq.append(DOWN)\n          dx -= 1\n      while dx < 0:\n          seq.append(UP)\n          dx += 1\n      while dy > 0:\n          seq.append(RIGHT)\n          dy -= 1\n      while dy < 0:\n          seq.append(LEFT)\n          dy += 1\n      return seq\n\n  # -----------------------------------------------------------------\n  # Collect each required primitive the needed number of times.\n  # -----------------------------------------------------------------\n  for prim_idx, cnt in required.items():\n      for _ in range(cnt):\n          locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not locations:\n              # Primitive not present on the map \u2013 assume already in inventory.\n              continue\n\n          # Choose the nearest instance (Manhattan distance).\n          target = min(\n              locations,\n              key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),\n          )\n\n          path = bfs(pos, target)\n          if path is None:\n              path = manhattan_path(pos, target)\n\n          actions.extend(path)\n          actions.append(USE)          # pick up\n\n          # Update simulated state.\n          pos = target\n          grid[pos[0], pos[1], prim_idx] = 0\n\n  # -----------------------------------------------------------------\n  # Move to the appropriate workshop (if any) and craft the goal.\n  # -----------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      ws_locs = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))\n      if ws_locs:\n          target_ws = min(\n              ws_locs,\n              key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),\n          )\n          path = bfs(pos, target_ws)\n          if path is None:\n              path = manhattan_path(pos, target_ws)\n          actions.extend(path)\n          actions.append(USE)          # craft at workshop\n\n  return actions", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:16:30.038475", "function_name": "make_arrow", "function_body": "  spec = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      spec[\"DOWN\"],\n      spec[\"UP\"],\n      spec[\"LEFT\"],\n      spec[\"RIGHT\"],\n      spec[\"USE\"],\n  )\n\n  goal = env.task.goal\n  required = env.world.cookbook.primitives_for(goal)  # {prim_idx: count}\n\n  state = env._current_state\n  pos = tuple(state.pos)               # (x, y)\n  grid = state.grid.copy()              # mutable copy of the grid\n  actions = []                           # accumulated action list\n\n  # -----------------------------------------------------------------\n  # Helper: BFS pathfinder that avoids non\u2011grabbable entities.\n  # Allows stepping onto the target even if it would otherwise be blocked.\n  # -----------------------------------------------------------------\n  def bfs(start, target):\n      width, height = grid.shape[:2]\n\n      # Cells occupied by any non\u2011grabbable entity are blocked.\n      non_grab = list(env.world.non_grabbable_indices)\n      if non_grab:\n          blocked = np.any(grid[:, :, non_grab] > 0, axis=2)\n      else:\n          blocked = np.zeros((width, height), dtype=bool)\n\n      # Permit moving onto the target cell (e.g., a workshop or primitive).\n      blocked[target[0], target[1]] = False\n\n      q = collections.deque([start])\n      parent = {start: None}\n      act_to = {}\n\n      dirs = [\n          (DOWN, (1, 0)),\n          (UP, (-1, 0)),\n          (RIGHT, (0, 1)),\n          (LEFT, (0, -1)),\n      ]\n\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          x, y = cur\n          for act, (dx, dy) in dirs:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height and not blocked[nx, ny]:\n                  nxt = (nx, ny)\n                  if nxt not in parent:\n                      parent[nxt] = cur\n                      act_to[nxt] = act\n                      q.append(nxt)\n\n      if target not in parent:\n          return None\n\n      # Reconstruct the action sequence from start to target.\n      seq = []\n      cur = target\n      while cur != start:\n          seq.append(act_to[cur])\n          cur = parent[cur]\n      seq.reverse()\n      return seq\n\n  # -----------------------------------------------------------------\n  # Collect each required primitive the necessary number of times.\n  # -----------------------------------------------------------------\n  for prim_idx, count in required.items():\n      for _ in range(count):\n          # Find all cells that currently contain this primitive.\n          locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not locations:\n              # No more instances; assume they are already in inventory.\n              break\n\n          # Choose the nearest instance (Manhattan distance).\n          target = min(\n              locations,\n              key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),\n          )\n\n          # Plan a path to the primitive.\n          path = bfs(pos, target)\n          if path is None:\n              # Fallback to simple Manhattan moves if BFS fails.\n              dx, dy = target[0] - pos[0], target[1] - pos[1]\n              path = []\n              while dx > 0:\n                  path.append(DOWN)\n                  dx -= 1\n              while dx < 0:\n                  path.append(UP)\n                  dx += 1\n              while dy > 0:\n                  path.append(RIGHT)\n                  dy -= 1\n              while dy < 0:\n                  path.append(LEFT)\n                  dy += 1\n\n          # Execute movement and pickup.\n          actions.extend(path)\n          actions.append(USE)\n\n          # Update simulated position and grid.\n          pos = target\n          grid[pos[0], pos[1], prim_idx] = 0\n\n  # -----------------------------------------------------------------\n  # Move to the appropriate workshop (if any) and craft the goal item.\n  # -----------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))\n      if workshop_cells:\n          target_ws = min(\n              workshop_cells,\n              key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),\n          )\n          path = bfs(pos, target_ws)\n          if path is None:\n              dx, dy = target_ws[0] - pos[0], target_ws[1] - pos[1]\n              path = []\n              while dx > 0:\n                  path.append(DOWN)\n                  dx -= 1\n              while dx < 0:\n                  path.append(UP)\n                  dx += 1\n              while dy > 0:\n                  path.append(RIGHT)\n                  dy -= 1\n              while dy < 0:\n                  path.append(LEFT)\n                  dy += 1\n          actions.extend(path)\n          actions.append(USE)  # craft at the workshop\n\n  return actions", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:16:47.878410", "function_name": "make_arrow", "function_body": "  # Reset environment and get initial state/world\n  env.reset()\n  cur_state = env._current_state          # CraftState\n  world = env.world\n\n  # --------------------------------------------------------------\n  # Identify the index of the goal item \"arrow\"\n  # --------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:   # arrow not defined in this world\n      return []\n\n  # --------------------------------------------------------------\n  # Helper: BFS that returns a list of movement actions (0\u20113) that\n  # brings the agent to a position where the cell directly in front\n  # contains `target_kind`. Returns [] if unreachable.\n  # --------------------------------------------------------------\n  def _bfs_to_target(state, target_kind):\n      grid = state.grid\n      W, H = grid.shape[:2]\n\n      # direction deltas matching action indices\n      deltas = {\n          0: (0, 1),   # DOWN\n          1: (0, -1),  # UP\n          2: (-1, 0),  # LEFT\n          3: (1, 0),   # RIGHT\n      }\n\n      def in_bounds(x, y):\n          return 0 <= x < W and 0 <= y < H\n\n      def walkable(x, y):\n          if not in_bounds(x, y):\n              return False\n          # a cell is walkable if it contains no entities at all\n          return not np.any(grid[x, y, :])\n\n      start_x, start_y = state.pos\n      start_dir = state.dir\n      from collections import deque\n      queue = deque()\n      queue.append((start_x, start_y, start_dir, []))\n      visited = {(start_x, start_y, start_dir)}\n\n      while queue:\n          x, y, d, acts = queue.popleft()\n          # Is the target directly ahead?\n          dx, dy = deltas[d]\n          fx, fy = x + dx, y + dy\n          if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:\n              return acts\n\n          # Explore movement actions (0\u20113)\n          for a in (0, 1, 2, 3):\n              ndx, ndy = deltas[a]\n              nx, ny = x + ndx, y + ndy\n              if not walkable(nx, ny):\n                  continue\n              if (nx, ny, a) in visited:\n                  continue\n              visited.add((nx, ny, a))\n              queue.append((nx, ny, a, acts + [a]))\n\n      # Unreachable\n      return []\n\n  # --------------------------------------------------------------\n  # Determine primitive requirements for a single arrow\n  # --------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}\n  actions = []\n\n  # --------------------------------------------------------------\n  # Collect each required primitive the necessary number of times\n  # --------------------------------------------------------------\n  for prim_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          move_actions = _bfs_to_target(cur_state, prim_idx)\n          # If BFS failed but we are already adjacent, we can still pick up\n          if not move_actions and not cur_state.next_to(prim_idx):\n              # cannot reach this primitive \u2013 abort early\n              return actions\n          actions.extend(move_actions)\n          actions.append(4)                     # USE to pick up\n          # Apply actions to keep cur_state in sync\n          for a in move_actions + [4]:\n              _, cur_state = cur_state.step(a)\n\n  # --------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any)\n  # --------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      move_actions = _bfs_to_target(cur_state, workshop_idx)\n      actions.extend(move_actions)\n      actions.append(4)                     # USE to craft\n      for a in move_actions + [4]:\n          _, cur_state = cur_state.step(a)\n  else:\n      # No specific workshop \u2013 just attempt crafting in place\n      actions.append(4)                     # USE to craft\n      _, cur_state = cur_state.step(4)\n\n  return actions", "env_interactions": 26, "island_id": 9, "scores": {"3": 0.5}}
