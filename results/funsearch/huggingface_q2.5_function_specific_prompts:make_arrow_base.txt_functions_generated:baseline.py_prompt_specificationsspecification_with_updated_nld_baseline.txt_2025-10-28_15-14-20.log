{"timestamp": "2025-10-28T23:18:46.408909", "function_name": "make_arrow", "function_body": "  # Obtain the scenario and world objects (handle possible wrappers)\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initialise the starting state\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  # Bread\u2011first search over state space to find a plan\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      # Hash based on position, direction, inventory and grid layout\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 300  # depth limit to keep search tractable\n  n_actions = getattr(world, \"n_actions\", 5)  # usually 5 (4 moves + USE)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand neighbours\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within the depth limit\n  return []", "env_interactions": 20, "island_id": 7, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:19:12.806876", "function_name": "make_arrow", "function_body": "  # Resolve scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = set()\n  frontier = deque([Node(init_state, [])])\n  visited.add(_state_hash(init_state))\n\n  MAX_STEPS = 500                     # safety bound on plan length\n  n_actions = getattr(world, \"n_actions\", 5)   # usually 5 (4 moves + USE)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Do not expand nodes that already exceed the length limit\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Explore all possible actions\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          h = _state_hash(next_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(next_state, node.actions + [a]))\n\n  # No plan found within the limits\n  return []", "env_interactions": 20, "island_id": 2, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:19:28.720871", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = set()\n  frontier = deque([Node(init_state, [])])\n  visited.add(_state_hash(init_state))\n\n  MAX_STEPS = 500\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          h = _state_hash(next_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(next_state, node.actions + [a]))\n\n  return []", "env_interactions": 20, "island_id": 2, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:19:59.776393", "function_name": "make_arrow", "function_body": "  # Resolve the scenario and world objects from the environment wrapper\n  scenario = getattr(env, \"scenario\", None)\n  if scenario is None:\n      # In some wrappers the env itself may act as the scenario\n      scenario = env\n  world = getattr(scenario, \"world\", None) or getattr(env, \"world\", None)\n  if world is None:\n      return []\n\n  # Identify the index of the target item (\"arrow\")\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initialise the starting CraftState\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  # Bread\u2011first search over the state space to find a sequence of actions that yields an arrow\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      # Hash based on position, direction, inventory contents and the full grid layout\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = set()\n  frontier = deque([Node(init_state, [])])\n  visited.add(_state_hash(init_state))\n\n  # Prevent unbounded search\n  MAX_STEPS = 500\n\n  # Number of possible actions (standard: 0\u20114 for DOWN,UP,LEFT,RIGHT,USE)\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: does the inventory contain at least one arrow?\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Depth limit\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand neighbours\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within the step limit\n  return []", "env_interactions": 20, "island_id": 8, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:20:15.505772", "function_name": "make_arrow", "function_body": "  import collections\n  from collections import deque, namedtuple\n\n  # ------------------------------------------------------------------\n  # Get scenario and world objects (handle a few possible wrapper layouts)\n  # ------------------------------------------------------------------\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # ------------------------------------------------------------------\n  # Identify the index of the target item (\"arrow\")\n  # ------------------------------------------------------------------\n  try:\n      arrow_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # ------------------------------------------------------------------\n  # Initialise the starting CraftState for the episode\n  # ------------------------------------------------------------------\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  # ------------------------------------------------------------------\n  # Bread\u2011first search over the state space to find a plan\n  # ------------------------------------------------------------------\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = set()\n  frontier = deque([Node(init_state, [])])\n  visited.add(_state_hash(init_state))\n\n  MAX_STEPS = 300                     # safety cutoff for plan length\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state, cur_actions = node.state, node.actions\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", arrow_idx):\n          return cur_actions\n\n      if len(cur_actions) >= MAX_STEPS:\n          continue\n\n      # Expand neighbours\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, cur_actions + [a]))\n\n  # No plan found within the depth limit\n  return []", "env_interactions": 20, "island_id": 8, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:20:41.751005", "function_name": "make_arrow", "function_body": "  import collections\n  import numpy as np\n\n  # Action indices (standard CraftWorld actions)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving from `start` to a\n  # position adjacent (Manhattan distance = 1) to any cell in `targets`.\n  # The search treats any occupied cell (grid[...,k] > 0 for any k) as\n  # blocked.  If `start` is already adjacent, an empty list is returned.\n  # ------------------------------------------------------------------\n  def _bfs_to_adjacent(start, targets, occ):\n      w, h = occ.shape\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # adjacency check\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n          # expand neighbours\n          for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occ[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # no reachable adjacency \u2013 return empty list\n      return []\n\n  # ------------------------------------------------------------------\n  # Locate the underlying CraftWorld and its cookbook.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Some wrappers expose the world via the internal state.\n      state_obj = getattr(env, \"_current_state\", None)\n      if state_obj is not None:\n          world = getattr(state_obj, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"Unable to locate CraftWorld instance in the environment.\")\n  cookbook = world.cookbook\n\n  # ------------------------------------------------------------------\n  # Goal: craft an 'arrow'.\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # Determine primitive requirements for a single arrow.\n  primitives_needed = cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n\n  # ------------------------------------------------------------------\n  # Ensure we start from a fresh episode.\n  # ------------------------------------------------------------------\n  if not hasattr(env, \"_current_state\") or env._current_state is None:\n      env.reset()\n  state = env._current_state\n\n  pos = tuple(state.pos)          # (x, y)\n  grid = state.grid                # (W, H, n_kinds)\n\n  # Occupancy map: True where any entity blocks movement.\n  occupied = np.any(grid > 0, axis=2)\n\n  actions = []                     # final action list\n  used_cells = set()               # primitives already collected\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first).\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      # Find all current locations of this primitive.\n      locs = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # Sort by Manhattan distance from current position.\n      locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      gathered = 0\n      for loc in locs:\n          if gathered >= needed:\n              break\n          if loc in used_cells:\n              continue\n          # Path to a cell adjacent to the primitive.\n          path = _bfs_to_adjacent(pos, [loc], occupied)\n          actions.extend(path)\n          # Update `pos` according to the actions taken.\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Use action to pick up the primitive.\n          actions.append(USE)\n          # After collection the cell becomes empty \u2013 update occupancy.\n          occupied[loc[0], loc[1]] = False\n          used_cells.add(loc)\n          gathered += 1\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if the recipe specifies one) and craft.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (could be name or int).\n      workshop_idx = (\n          cookbook.index[workshop_key]\n          if isinstance(workshop_key, str) else workshop_key\n      )\n      workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if not workshop_cells:\n          raise RuntimeError(f\"No workshop of type '{workshop_key}' found in the scenario.\")\n      # Choose the nearest workshop.\n      workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      target_ws = workshop_cells[0]\n      path = _bfs_to_adjacent(pos, [target_ws], occupied)\n      actions.extend(path)\n      for act in path:\n          if act == RIGHT:\n              pos = (pos[0] + 1, pos[1])\n          elif act == LEFT:\n              pos = (pos[0] - 1, pos[1])\n          elif act == DOWN:\n              pos = (pos[0], pos[1] + 1)\n          elif act == UP:\n              pos = (pos[0], pos[1] - 1)\n      # Use action to craft the arrow.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T23:20:42.930380", "function_name": "make_arrow", "function_body": "  # action identifiers\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS that avoids any occupied cell and returns a list of actions\n  # moving from `start` to a position adjacent to any cell in `targets`.\n  # ----------------------------------------------------------------------\n  def _bfs_to_adjacent(start, targets):\n      w, h, _ = grid.shape\n      occupied = np.any(grid > 0, axis=2)          # True where something blocks movement\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # adjacency check\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n          # expand neighbours\n          for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # unreachable \u2013 return empty list\n      return []\n\n  # ----------------------------------------------------------------------\n  # Locate the world / cookbook inside the environment wrapper\n  # ----------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # some wrappers expose the world via the internal state\n      state_obj = getattr(env, \"_current_state\", None)\n      if state_obj is not None:\n          world = state_obj.world\n  if world is None:\n      raise RuntimeError(\"CraftWorld instance not found in the environment.\")\n  cookbook = world.cookbook\n\n  # ----------------------------------------------------------------------\n  # Goal is the item named \"arrow\"\n  # ----------------------------------------------------------------------\n  goal_name = \"arrow\"\n  if goal_name not in cookbook.index.contents:\n      raise ValueError(f\"Goal '{goal_name}' not present in recipe index.\")\n  goal_idx = cookbook.index[goal_name]\n\n  # primitives required for a single arrow\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n\n  # ----------------------------------------------------------------------\n  # Ensure we start from a fresh reset state\n  # ----------------------------------------------------------------------\n  if not hasattr(env, \"_current_state\") or env._current_state is None:\n      env.reset()\n  state = env._current_state\n\n  pos = tuple(state.pos)          # current (x, y)\n  grid = state.grid                # (W, H, n_kinds)\n\n  actions = []                     # final action sequence\n  used_cells = set()               # primitives already harvested\n\n  # ----------------------------------------------------------------------\n  # Gather each required primitive (nearest\u2011first greedy)\n  # ----------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      # locate all cells currently containing this primitive\n      cells = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # sort by Manhattan distance from current position\n      cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n      collected = 0\n      for cell in cells:\n          if collected >= needed:\n              break\n          if cell in used_cells:\n              continue\n          # move adjacent to the primitive\n          path = _bfs_to_adjacent(pos, [cell])\n          actions.extend(path)\n          # update our notion of position\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # pick it up\n          actions.append(USE)\n          used_cells.add(cell)\n          collected += 1\n\n  # ----------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any)\n  # ----------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # resolve workshop index (may be name or already an int)\n      workshop_idx = (\n          cookbook.index[workshop_key]\n          if isinstance(workshop_key, str) else workshop_key\n      )\n      # locate all workshop cells of this type\n      ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if ws_cells:\n          ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          target_ws = ws_cells[0]\n          path = _bfs_to_adjacent(pos, [target_ws])\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          actions.append(USE)\n\n  return actions", "env_interactions": 21, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T23:21:20.279126", "function_name": "make_arrow", "function_body": "  import collections, numpy as np\n\n  # Action indices matching CraftWorld definitions\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # BFS that returns a sequence of actions moving the agent to a cell\n  # orthogonally adjacent to any target cell (stops as soon as adjacency\n  # is achieved).  It walks only on currently empty cells.\n  # ------------------------------------------------------------------\n  def _bfs_adjacent(start, targets, occupied):\n      w, h = occupied.shape\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n      while q:\n          x, y, path = q.popleft()\n          # adjacency test\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n          # expand neighbours\n          for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      return []  # unreachable (should not happen in valid maps)\n\n  # ------------------------------------------------------------------\n  # Apply a list of actions to a position, returning the resulting coord.\n  # ------------------------------------------------------------------\n  def _apply(pos, actions):\n      x, y = pos\n      for a in actions:\n          if a == RIGHT:\n              x += 1\n          elif a == LEFT:\n              x -= 1\n          elif a == DOWN:\n              y += 1\n          elif a == UP:\n              y -= 1\n      return (x, y)\n\n  # ------------------------------------------------------------------\n  # Locate the underlying CraftWorld and its Cookbook.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      cur_state = getattr(env, \"_current_state\", None)\n      if cur_state is not None:\n          world = getattr(cur_state, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"CraftWorld instance not found in the environment.\")\n  cookbook = world.cookbook\n\n  # ------------------------------------------------------------------\n  # Ensure we have a current state (reset if the wrapper hasn't done so).\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  # ------------------------------------------------------------------\n  # Goal setup.\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  if goal_name not in cookbook.index.contents:\n      raise ValueError(f\"Goal '{goal_name}' not defined in the recipe file.\")\n  goal_idx = cookbook.index[goal_name]\n\n  # Primitive requirements for the goal (primitive index -> count).\n  primitives_needed = cookbook.primitives_for(goal_idx)\n\n  # ------------------------------------------------------------------\n  # Planning state.\n  # ------------------------------------------------------------------\n  pos = tuple(state.pos)                 # current (x, y)\n  grid = state.grid.copy()               # (W, H, n_kinds)\n  occupied = np.any(grid, axis=2)        # bool mask of occupied cells\n  plan_actions = []                      # final action list\n  harvested = set()                      # cells already collected from\n\n  # ------------------------------------------------------------------\n  # 1) Collect each required primitive.\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      # locate all cells containing this primitive\n      cells = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # greedy order by Manhattan distance from current position\n      cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n      collected = 0\n      for cell in cells:\n          if collected >= needed_cnt:\n              break\n          if cell in harvested:\n              continue\n          # move to a cell adjacent to the primitive\n          path = _bfs_adjacent(pos, [cell], occupied)\n          plan_actions.extend(path)\n          pos = _apply(pos, path)\n\n          # pick it up\n          plan_actions.append(USE)\n\n          # update planning structures: primitive disappears, cell becomes free\n          grid[cell[0], cell[1], prim_idx] = 0\n          occupied = np.any(grid, axis=2)\n          harvested.add(cell)\n          collected += 1\n\n  # ------------------------------------------------------------------\n  # 2) Move to the required workshop (if any) and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      ws_idx = (cookbook.index[workshop_key]\n                if isinstance(workshop_key, str) else int(workshop_key))\n      ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, ws_idx] > 0)]\n      if ws_cells:\n          ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          target_ws = ws_cells[0]\n          path = _bfs_adjacent(pos, [target_ws], occupied)\n          plan_actions.extend(path)\n          pos = _apply(pos, path)\n          plan_actions.append(USE)          # craft at the workshop\n      else:\n          # workshop not visible \u2013 attempt crafting at current location\n          plan_actions.append(USE)\n  else:\n      # No specific workshop required; craft wherever we are.\n      plan_actions.append(USE)\n\n  return plan_actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T23:21:21.426715", "function_name": "make_arrow", "function_body": "  import collections, numpy as np\n\n  # Action indices as defined in CraftWorld\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  def _bfs_adjacent(start, targets, blocked):\n      \"\"\"Breadth\u2011first search that stops when we are orthogonally adjacent\n      to any cell in *targets*. Returns a list of actions to reach such a\n      position (empty list if already adjacent).\"\"\"\n      w, h = blocked.shape\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n      while q:\n          x, y, path = q.popleft()\n          # check adjacency\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n          # expand neighbours\n          for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not blocked[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # No reachable adjacent cell \u2013 return empty list (should not happen)\n      return []\n\n  def _apply(pos, actions):\n      \"\"\"Return the new position after executing *actions* from *pos*.\"\"\"\n      x, y = pos\n      for a in actions:\n          if a == RIGHT:\n              x += 1\n          elif a == LEFT:\n              x -= 1\n          elif a == DOWN:\n              y += 1\n          elif a == UP:\n              y -= 1\n      return (x, y)\n\n  # ------------------------------------------------------------------\n  # Locate the world and its cookbook inside the provided env object.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Some wrappers expose the underlying state directly.\n      cur_state = getattr(env, \"_current_state\", None)\n      if cur_state is not None:\n          world = getattr(cur_state, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"CraftWorld instance not found in the environment.\")\n  cookbook = world.cookbook\n\n  # ------------------------------------------------------------------\n  # Ensure we have a current state (reset if necessary).\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  # ------------------------------------------------------------------\n  # Goal information.\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  if goal_name not in cookbook.index.contents:\n      raise ValueError(f\"Goal '{goal_name}' not defined in the recipe file.\")\n  goal_idx = cookbook.index[goal_name]\n\n  # Primitive requirements for the goal (primitive_index -> count).\n  primitives_needed = cookbook.primitives_for(goal_idx)\n\n  # ------------------------------------------------------------------\n  # Planning structures.\n  # ------------------------------------------------------------------\n  pos = tuple(state.pos)                     # current (x, y)\n  grid = state.grid.copy()                   # (W, H, n_kinds)\n  blocked = np.any(grid, axis=2)             # occupied mask (bool)\n\n  plan_actions = []                          # final action list\n  harvested = set()                          # cells already collected from\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitives.\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      # locate all cells that currently contain this primitive\n      cells = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # sort by Manhattan distance from the current position (greedy)\n      cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n      collected = 0\n      for cell in cells:\n          if collected >= needed_cnt:\n              break\n          if cell in harvested:\n              continue\n          # move adjacent to the primitive\n          path = _bfs_adjacent(pos, [cell], blocked)\n          plan_actions.extend(path)\n          pos = _apply(pos, path)\n\n          # pick it up\n          plan_actions.append(USE)\n\n          # update planning structures: primitive disappears, cell becomes free\n          grid[cell[0], cell[1], prim_idx] = 0\n          blocked = np.any(grid, axis=2)\n          harvested.add(cell)\n          collected += 1\n\n  # ------------------------------------------------------------------\n  # 2) Move to the workshop (if required) and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # workshop may be given as a string name or directly as an index\n      ws_idx = (cookbook.index[workshop_key]\n                if isinstance(workshop_key, str) else int(workshop_key))\n      ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, ws_idx] > 0)]\n      if ws_cells:\n          ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          target_ws = ws_cells[0]\n          path = _bfs_adjacent(pos, [target_ws], blocked)\n          plan_actions.extend(path)\n          pos = _apply(pos, path)\n          plan_actions.append(USE)          # craft at the workshop\n      else:\n          # workshop not visible \u2013 attempt crafting at current location\n          plan_actions.append(USE)\n  else:\n      # No specific workshop required; craft wherever we are.\n      plan_actions.append(USE)\n\n  return plan_actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T23:21:46.015020", "function_name": "make_arrow", "function_body": "  # Resolve world and target index\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Starting state\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _hash(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = set()\n  frontier = deque([Node(init_state, [])])\n  visited.add(_hash(init_state))\n\n  MAX_STEPS = 2000                     # safety cap on plan length\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  # Prefer USE (action 4) before movement to speed up crafting when possible\n  action_order = [4, 0, 1, 2, 3] if n_actions > 4 else list(range(n_actions))\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal reached?\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long trajectories\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand successors\n      for a in action_order:\n          _, nxt_state = cur_state.step(a)   # reward is irrelevant here\n          h = _hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # If we exit the loop no plan was found within the limits\n  return []", "env_interactions": 20, "island_id": 2, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:22:02.008616", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # target item index\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # initial state\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = set()\n  frontier = deque([Node(init_state, [])])\n  visited.add(_state_hash(init_state))\n\n  MAX_STEPS = 2000\n  n_actions = getattr(world, \"n_actions\", 5)\n  # Prefer USE (usually index 4) before movement actions\n  action_order = [4, 0, 1, 2, 3] if n_actions > 4 else list(range(n_actions))\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      for a in action_order:\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  return []", "env_interactions": 20, "island_id": 2, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:22:32.774220", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS that avoids any occupied cell and returns a list of actions\n  # moving from `start` to a position adjacent to any cell in `targets`.\n  # ----------------------------------------------------------------------\n  def _bfs_to_adjacent(start, targets):\n      w, h, _ = grid.shape\n      occupied = np.any(grid > 0, axis=2)          # True where something blocks movement\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # adjacency check\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n          # expand neighbours\n          for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # unreachable \u2013 return empty list\n      return []\n\n  # ----------------------------------------------------------------------\n  # Locate the world / cookbook inside the environment wrapper\n  # ----------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # some wrappers expose the world via the internal state\n      state_obj = getattr(env, \"_current_state\", None)\n      if state_obj is not None:\n          world = getattr(state_obj, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"CraftWorld instance not found in the environment.\")\n  cookbook = world.cookbook\n\n  # ----------------------------------------------------------------------\n  # Goal is the item named \"arrow\"\n  # ----------------------------------------------------------------------\n  goal_name = \"arrow\"\n  if goal_name not in cookbook.index.contents:\n      raise ValueError(f\"Goal '{goal_name}' not present in recipe index.\")\n  goal_idx = cookbook.index[goal_name]\n\n  # primitives required for a single arrow\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n\n  # ----------------------------------------------------------------------\n  # Ensure we start from a fresh reset state\n  # ----------------------------------------------------------------------\n  if not hasattr(env, \"_current_state\") or env._current_state is None:\n      env.reset()\n  state = env._current_state\n\n  pos = tuple(state.pos)          # current (x, y)\n  grid = state.grid                # (W, H, n_kinds)\n\n  actions = []                     # final action sequence\n  used_cells = set()               # primitives already harvested\n\n  # ----------------------------------------------------------------------\n  # Gather each required primitive (nearest\u2011first greedy)\n  # ----------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      # locate all cells currently containing this primitive\n      cells = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # sort by Manhattan distance from current position\n      cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n      collected = 0\n      for cell in cells:\n          if collected >= needed:\n              break\n          if cell in used_cells:\n              continue\n          # move adjacent to the primitive\n          path = _bfs_to_adjacent(pos, [cell])\n          actions.extend(path)\n          # update our notion of position\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # pick it up\n          actions.append(USE)\n          used_cells.add(cell)\n          collected += 1\n\n  # ----------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any)\n  # ----------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # resolve workshop index (may be name or already an int)\n      workshop_idx = (\n          cookbook.index[workshop_key]\n          if isinstance(workshop_key, str) else workshop_key\n      )\n      # locate all workshop cells of this type\n      ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if ws_cells:\n          ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          target_ws = ws_cells[0]\n          path = _bfs_to_adjacent(pos, [target_ws])\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          actions.append(USE)\n\n  return actions", "env_interactions": 21, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T23:22:33.912075", "function_name": "make_arrow", "function_body": "  import collections, numpy as np\n\n  # ----------------------------------------------------------------------\n  # Action constants (standard CraftWorld actions)\n  # ----------------------------------------------------------------------\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS returning a list of actions that brings the agent from\n  # `start` to a cell adjacent (Manhattan distance = 1) to any of the\n  # target cells.  Occupied cells (any non\u2011zero entry in the grid) are\n  # treated as walls.\n  # ----------------------------------------------------------------------\n  def _bfs_to_adjacent(start, targets, occ):\n      w, h = occ.shape\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # check adjacency\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n          # expand neighbours\n          for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occ[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # unreachable \u2013 return empty list\n      return []\n\n  # ----------------------------------------------------------------------\n  # Locate the underlying CraftWorld and its cookbook.\n  # ----------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      state_obj = getattr(env, \"_current_state\", None)\n      if state_obj is not None:\n          world = getattr(state_obj, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"Could not find CraftWorld instance inside env.\")\n  cookbook = world.cookbook\n\n  # ----------------------------------------------------------------------\n  # Goal: craft an 'arrow'.\n  # ----------------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # Primitive requirements for a single arrow.\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n\n  # ----------------------------------------------------------------------\n  # Ensure we start from a fresh episode.\n  # ----------------------------------------------------------------------\n  if not hasattr(env, \"_current_state\") or env._current_state is None:\n      env.reset()\n  state = env._current_state\n\n  pos = tuple(state.pos)                 # (x, y)\n  grid = state.grid                       # (W, H, n_kinds)\n\n  # Occupancy map: True where any entity blocks movement.\n  occupied = np.any(grid > 0, axis=2)\n\n  actions = []            # final action sequence\n  collected_cells = set() # primitives already harvested\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first).\n  # ----------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      # locate all cells that currently contain this primitive\n      cells = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # sort by Manhattan distance from current position\n      cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n      gathered = 0\n      for cell in cells:\n          if gathered >= needed:\n              break\n          if cell in collected_cells:\n              continue\n          # move adjacent to the primitive\n          path = _bfs_to_adjacent(pos, [cell], occupied)\n          actions.extend(path)\n          # update our notion of position\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # pick up the primitive\n          actions.append(USE)\n          # after collection the cell may become empty \u2013 update occupancy\n          if grid[cell[0], cell[1], prim_idx] == 1:\n              occupied[cell[0], cell[1]] = False\n          collected_cells.add(cell)\n          gathered += 1\n\n  # ----------------------------------------------------------------------\n  # Move to the required workshop (if the recipe specifies one) and craft.\n  # ----------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (could be a name or already an int)\n      workshop_idx = (\n          cookbook.index[workshop_key]\n          if isinstance(workshop_key, str) else workshop_key\n      )\n      ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if not ws_cells:\n          raise RuntimeError(f\"No workshop of type '{workshop_key}' found.\")\n      # choose nearest workshop\n      ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n      target_ws = ws_cells[0]\n      path = _bfs_to_adjacent(pos, [target_ws], occupied)\n      actions.extend(path)\n      for act in path:\n          if act == RIGHT:\n              pos = (pos[0] + 1, pos[1])\n          elif act == LEFT:\n              pos = (pos[0] - 1, pos[1])\n          elif act == DOWN:\n              pos = (pos[0], pos[1] + 1)\n          elif act == UP:\n              pos = (pos[0], pos[1] - 1)\n      # craft the arrow\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T23:22:56.188886", "function_name": "make_arrow", "function_body": "  # Action constants and movement deltas\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  MOVE_DELTAS = {\n      DOWN: (0, 1),\n      UP: (0, -1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving the agent from\n  # `start` to a cell adjacent (Manhattan distance = 1) to any cell in\n  # `targets`.  Cells occupied by any entity are considered blocked,\n  # except the target cells themselves (we only need to stand next to\n  # them).\n  # ------------------------------------------------------------------\n  def _bfs_adjacent(start, targets, occupied):\n      w, h = occupied.shape\n      target_set = set(targets)\n\n      # Already adjacent?\n      for tx, ty in target_set:\n          if abs(start[0] - tx) + abs(start[1] - ty) == 1:\n              return []\n\n      from collections import deque\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n\n      while q:\n          x, y, path = q.popleft()\n          for act, (dx, dy) in MOVE_DELTAS.items():\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < w and 0 <= ny < h):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              if occupied[nx, ny]:\n                  continue\n              new_path = path + [act]\n\n              # Check adjacency after this move\n              for tx, ty in target_set:\n                  if abs(nx - tx) + abs(ny - ty) == 1:\n                      return new_path\n\n              visited.add((nx, ny))\n              q.append((nx, ny, new_path))\n      # Unreachable \u2013 return empty list (caller will handle failure)\n      return []\n\n  # ------------------------------------------------------------------\n  # Extract world / state / cookbook from the environment.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Likely a CraftLab wrapper.\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n      world = state.world\n  else:\n      # Raw CraftWorld / scenario.\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n\n  cookbook = world.cookbook\n  goal_idx = cookbook.index[\"arrow\"]\n\n  # ------------------------------------------------------------------\n  # Determine primitive requirements for a single arrow.\n  # ------------------------------------------------------------------\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n  if not primitives_needed:\n      # Arrow is a primitive \u2013 just use the current cell.\n      return [USE]\n\n  # ------------------------------------------------------------------\n  # Current grid, agent position and occupancy mask.\n  # ------------------------------------------------------------------\n  grid = state.grid                     # shape (W, H, n_kinds)\n  pos = tuple(state.pos)                # (x, y)\n  occupied = np.any(grid > 0, axis=2)   # True where any entity exists\n\n  actions = []\n  harvested = set()                     # locations already collected from\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first).\n  # ------------------------------------------------------------------\n  for prim_idx, required_cnt in primitives_needed.items():\n      gathered = 0\n      while gathered < required_cnt:\n          # Find all remaining instances of this primitive.\n          prim_locs = [\n              tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)\n              if tuple(p) not in harvested\n          ]\n          if not prim_locs:\n              # No more of this primitive on the map \u2013 abort early.\n              break\n\n          # Choose the closest primitive (Manhattan distance).\n          prim_locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target = prim_locs[0]\n\n          # Plan path to a cell adjacent to the primitive.\n          path = _bfs_adjacent(pos, [target], occupied)\n          actions.extend(path)\n\n          # Simulate movement.\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Pick up the primitive.\n          actions.append(USE)\n          harvested.add(target)\n          gathered += 1\n\n          # Update occupancy: the primitive cell becomes empty.\n          occupied[target] = False\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (may be a name string).\n      workshop_idx = (\n          cookbook.index[workshop_key]\n          if isinstance(workshop_key, str) else workshop_key\n      )\n      # Locate workshop cells of the required type.\n      workshop_cells = [\n          tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)\n      ]\n      if workshop_cells:\n          # Move to the nearest workshop.\n          workshop_cells.sort(\n              key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1])\n          )\n          ws_target = workshop_cells[0]\n          path = _bfs_adjacent(pos, [ws_target], occupied)\n          actions.extend(path)\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(USE)  # craft at workshop\n      else:\n          # No workshop found \u2013 just use current cell.\n          actions.append(USE)\n  else:\n      # No specific workshop required.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T23:22:57.343239", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  MOVE_DELTAS = {\n      DOWN: (0, 1),\n      UP: (0, -1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving the agent from `start`\n  # to a cell that is *adjacent* (Manhattan distance = 1) to any cell in\n  # `targets`.  Cells occupied by any entity are treated as blocked.\n  # ----------------------------------------------------------------------\n  def _bfs_adjacent(start, targets, occupied):\n      w, h = occupied.shape\n      target_set = set(targets)\n\n      # Already adjacent?\n      for tx, ty in target_set:\n          if abs(start[0] - tx) + abs(start[1] - ty) == 1:\n              return []\n\n      from collections import deque\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n\n      while q:\n          x, y, path = q.popleft()\n          for act, (dx, dy) in MOVE_DELTAS.items():\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < w and 0 <= ny < h):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              if occupied[nx, ny]:\n                  continue\n              new_path = path + [act]\n              # Check adjacency after this move\n              for tx, ty in target_set:\n                  if abs(nx - tx) + abs(ny - ty) == 1:\n                      return new_path\n              visited.add((nx, ny))\n              q.append((nx, ny, new_path))\n      # Unreachable \u2013 return empty list (caller will handle failure)\n      return []\n\n  # ----------------------------------------------------------------------\n  # Extract world / state / cookbook from the environment.\n  # ----------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Most likely a CraftLab wrapper.\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n      world = state.world\n  else:\n      # Raw CraftWorld / scenario.\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n\n  cookbook = world.cookbook\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # ----------------------------------------------------------------------\n  # Determine primitive requirements for a single arrow.\n  # ----------------------------------------------------------------------\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n  if not primitives_needed:\n      # Arrow is already a primitive \u2013 just use the current cell.\n      return [USE]\n\n  # ----------------------------------------------------------------------\n  # Current grid, agent position and occupancy mask.\n  # ----------------------------------------------------------------------\n  grid = state.grid                     # shape (W, H, n_kinds)\n  pos = tuple(state.pos)                # (x, y)\n  occupied = np.any(grid > 0, axis=2)   # True where any entity exists\n\n  actions = []\n  harvested = set()                     # cells already collected from\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first).\n  # ----------------------------------------------------------------------\n  for prim_idx, need_cnt in primitives_needed.items():\n      gathered = 0\n      while gathered < need_cnt:\n          # Locate all remaining instances of this primitive.\n          prim_cells = [\n              tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)\n              if tuple(p) not in harvested\n          ]\n          if not prim_cells:\n              # No more of this primitive on the map \u2013 abort early.\n              break\n\n          # Choose the closest primitive (Manhattan distance).\n          prim_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          target = prim_cells[0]\n\n          # Plan a path to a cell adjacent to the primitive.\n          path = _bfs_adjacent(pos, [target], occupied)\n          actions.extend(path)\n\n          # Simulate movement to update `pos`.\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Pick up the primitive.\n          actions.append(USE)\n          harvested.add(target)\n          gathered += 1\n\n          # Update occupancy: the primitive cell becomes empty.\n          occupied[target] = False\n\n  # ----------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any).\n  # ----------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (may be a name string).\n      workshop_idx = (\n          cookbook.index[workshop_key]\n          if isinstance(workshop_key, str) else workshop_key\n      )\n      # Find all workshop cells of this type.\n      ws_cells = [\n          tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)\n      ]\n      if ws_cells:\n          ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          ws_target = ws_cells[0]\n          # Move adjacent to the workshop.\n          path = _bfs_adjacent(pos, [ws_target], occupied)\n          actions.extend(path)\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(USE)   # craft\n      else:\n          # No workshop present \u2013 fall back to using current cell.\n          actions.append(USE)\n  else:\n      # No specific workshop required.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T23:23:13.919304", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that finds a shortest sequence of movement actions that\n  # brings the agent from `start` to a cell adjacent to any position in\n  # `targets`.  Cells that contain any entity (grid[...,k] > 0) are\n  # considered blocked, except the target cell itself (we only need to be\n  # next to it).\n  # ------------------------------------------------------------------\n  def _bfs_path(start, targets):\n      width, height, _ = grid.shape\n      occupied = np.any(grid > 0, axis=2)          # True where something exists\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # Adjacent (Manhattan distance 1) to any target?\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n              if (x, y) == (tx, ty):\n                  return path\n          # Explore 4\u2011connected neighbours\n          for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n                  # We may step onto empty cells only\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # No path found \u2013 return empty list (will cause failure later)\n      return []\n\n  # ------------------------------------------------------------------\n  # Identify world, cookbook and the goal (hard\u2011coded to \"arrow\")\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Some wrappers keep the world inside the current state object\n      state_obj = getattr(env, \"_current_state\", None)\n      if state_obj is not None:\n          world = state_obj.world\n  if world is None:\n      raise RuntimeError(\"Cannot locate CraftWorld instance in the environment.\")\n\n  cookbook = world.cookbook\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # Primitive requirements for a single arrow\n  primitives_needed = cookbook.primitives_for(goal_idx)\n\n  # ------------------------------------------------------------------\n  # Obtain the current state (reset if the env hasn't been started)\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  pos = tuple(state.pos)          # (x, y)\n  grid = state.grid                # (W, H, n_kinds)\n\n  actions = []\n  harvested = set()                # locations already used for collection\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first)\n  # ------------------------------------------------------------------\n  for prim_idx, cnt_needed in primitives_needed.items():\n      # All cells that currently contain this primitive\n      locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # Sort by Manhattan distance from current position\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      gathered = 0\n      for loc in locations:\n          if gathered >= cnt_needed:\n              break\n          if loc in harvested:\n              continue\n          # Move adjacent to the primitive\n          path = _bfs_path(pos, [loc])\n          actions.extend(path)\n          # Update our simulated position following the path\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Pick it up\n          actions.append(USE)\n          harvested.add(loc)\n          gathered += 1\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its designated workshop (if any)\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (could be a name or already an int)\n      if isinstance(workshop_key, str):\n          workshop_idx = cookbook.index[workshop_key]\n      else:\n          workshop_idx = workshop_key\n      # Locate all cells of that workshop type\n      workshop_locs = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if workshop_locs:\n          # Choose the nearest workshop\n          workshop_locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = workshop_locs[0]\n          # Move adjacent to the workshop\n          path = _bfs_path(pos, [target_ws])\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Craft using the USE action\n          actions.append(USE)\n\n  return actions", "env_interactions": 21, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T23:23:15.041215", "function_name": "make_arrow", "function_body": "  # Determine which version of the arrow\u2011making policy to use.\n  # Environments may expose a `version` attribute (or similar) that\n  # indicates which implementation should be employed.  If the\n  # attribute is missing we default to version\u202f0.\n  version = getattr(env, \"version\", getattr(env, \"level\", 0))\n\n  # Dispatch to the appropriate helper.\n  if version == 0:\n      return make_arrow_v0(env)\n  elif version == 1:\n      return make_arrow_v1(env)\n  else:\n      # Unknown version \u2013 fall back to the simplest implementation.\n      return make_arrow_v0(env)", "env_interactions": 0, "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-10-28T23:23:44.555306", "function_name": "make_arrow", "function_body": "  # Retrieve scenario and world objects\n  scenario = getattr(env, \"scenario\", None) or env\n  world = getattr(scenario, \"world\", None) or getattr(env, \"world\", None)\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Obtain the initial CraftState\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  # Create a hashable representation of a state for the visited set\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 2000                      # safety bound on plan length\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  # Prefer the USE action (usually index 4) before movement actions\n  action_order = [4] + [a for a in range(n_actions) if a != 4]\n\n  while frontier:\n      node = frontier.popleft()\n      state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long candidate plans\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand successors\n      for a in action_order:\n          _, nxt_state = state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within limits\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:23:45.684211", "function_name": "make_arrow", "function_body": "  # Resolve scenario and world objects\n  scenario = getattr(env, \"scenario\", None) or env\n  world = getattr(scenario, \"world\", None) or getattr(env, \"world\", None)\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Primitive requirements for one arrow (may be empty if arrow is primitive)\n  try:\n      primitive_req = world.cookbook.primitives_for(target_idx)  # dict {kind_idx: count}\n  except Exception:\n      primitive_req = {}\n\n  # Initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  # Helper: hashable representation of a CraftState for visited checking\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  # Heuristic: underestimate of remaining steps \u2013 sum of missing primitive counts\n  def _heuristic(st):\n      missing = 0\n      inv = st.inventory\n      for kind, need in primitive_req.items():\n          have = inv[kind] if kind < len(inv) else 0\n          if have < need:\n              missing += need - have\n      return missing\n\n  import heapq\n  Node = (0, 0, init_state, [])  # (f = g+h, g, state, actions)\n  frontier = [Node]\n  heapq.heapify(frontier)\n  visited = {_state_hash(init_state)}\n\n  MAX_EXPANSIONS = 50000          # safety bound to avoid infinite loops\n  expansions = 0\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      f, g, state, actions = heapq.heappop(frontier)\n\n      # Goal test\n      if state.satisfies(\"\", target_idx):\n          return actions\n\n      if expansions >= MAX_EXPANSIONS:\n          break\n      expansions += 1\n\n      # Expand possible actions\n      for a in range(n_actions):\n          _, nxt = state.step(a)\n          hsh = _state_hash(nxt)\n          if hsh in visited:\n              continue\n          visited.add(hsh)\n          g_next = g + 1\n          f_next = g_next + _heuristic(nxt)\n          heapq.heappush(frontier, (f_next, g_next, nxt, actions + [a]))\n\n  # If we exit the loop without finding a plan, return empty list\n  return []", "env_interactions": 0, "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-10-28T23:24:11.856918", "function_name": "make_arrow", "function_body": "  # Extract scenario and world objects, handling possible wrappers\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Resolve the internal index for the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Obtain the initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  # Create a hashable representation of a state for visited\u2011set checking\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_PLAN_LEN = 800                     # safety bound on plan length\n  n_actions = getattr(world, \"n_actions\", 5)  # default actions: 0\u20114\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long plans\n      if len(node.actions) >= MAX_PLAN_LEN:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          h = _state_hash(next_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(next_state, node.actions + [a]))\n\n  # No plan found within limits\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:24:27.614536", "function_name": "make_arrow", "function_body": "  # Get scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the goal item \u201carrow\u201d\n  try:\n      goal_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  # Hashable representation of a state for visited\u2011set checking\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_PLAN_LEN = 500                     # safety bound on plan length\n  n_actions = getattr(world, \"n_actions\", 5)   # typical actions: 0\u20114\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", goal_idx):\n          return node.actions\n\n      # Prune overly long plans\n      if len(node.actions) >= MAX_PLAN_LEN:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within the limits\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:24:55.935529", "function_name": "make_arrow", "function_body": "  # Obtain the scenario and world objects (handle possible wrappers)\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initialise the starting state\n  try:\n      start_state = scenario.init()\n  except Exception:\n      return []\n\n  # Bread\u2011first search over state space to find a plan\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      # Position, direction, inventory, and full grid uniquely identify a state\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(start_state)}\n  frontier = deque([Node(start_state, [])])\n\n  # Search limits\n  MAX_STEPS = 300\n  n_actions = getattr(world, \"n_actions\", 5)  # typical actions: 0\u20114\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: does the inventory contain the arrow?\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Depth limit\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand neighbours\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within the depth limit\n  return []", "env_interactions": 20, "island_id": 7, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:25:11.866331", "function_name": "make_arrow", "function_body": "  # Resolve scenario and world objects (handles different wrappers)\n  scenario = getattr(env, \"scenario\", None) or env\n  world = getattr(scenario, \"world\", None) or getattr(env, \"world\", None)\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      arrow_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      # Position, direction, inventory (as tuple) and grid bytes\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  # ------------------------------------------------------------------\n  # BFS search configuration\n  # ------------------------------------------------------------------\n  visited = set()\n  frontier = deque()\n  frontier.append(Node(init_state, []))\n  visited.add(_state_hash(init_state))\n\n  MAX_STEPS = 300                     # safety bound on plan length\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  # Optionally compute primitive requirements (used only for pruning)\n  try:\n      primitive_req = world.cookbook.primitives_for(arrow_idx)\n  except Exception:\n      primitive_req = {}\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", arrow_idx):\n          return node.actions\n\n      # Depth limit\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand neighbours\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h in visited:\n              continue\n\n          # Simple pruning: if we already collected more primitives than needed,\n          # and we have no crafted items that could be useful, skip.\n          if primitive_req:\n              inv = nxt_state.inventory\n              over = False\n              for prim_idx, needed in primitive_req.items():\n                  if inv[prim_idx] > needed:\n                      over = True\n                      break\n              if over:\n                  # allow if we also have the arrow (handled above) or other\n                  # non\u2011primitive items that might be intermediate; we keep it simple\n                  pass\n\n          visited.add(h)\n          frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within limits\n  return []", "env_interactions": 20, "island_id": 7, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:25:39.767646", "function_name": "make_arrow", "function_body": "  # Retrieve scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Identify the index of the target item (\"arrow\")\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Obtain the initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  # Simple breadth\u2011first search over the state space\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _hash_state(st):\n      # Unique identifier for a state: position, direction, inventory, and grid layout\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = set()\n  frontier = deque([Node(init_state, [])])\n  visited.add(_hash_state(init_state))\n\n  max_steps = 400                      # safety cap to avoid infinite search\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state, cur_actions = node.state, node.actions\n\n      # Goal test: arrow present in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return cur_actions\n\n      # Prune overly long plans\n      if len(cur_actions) >= max_steps:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _hash_state(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, cur_actions + [a]))\n\n  # No feasible plan found within the limit\n  return []", "env_interactions": 20, "island_id": 3, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:25:55.518321", "function_name": "make_arrow", "function_body": "  # Retrieve scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _hash_state(st):\n      # Unique hash based on position, direction, inventory, and grid layout\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = set()\n  frontier = deque([Node(init_state, [])])\n  visited.add(_hash_state(init_state))\n\n  max_steps = 400  # safety limit for plan length\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state, cur_actions = node.state, node.actions\n\n      # Goal check: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return cur_actions\n\n      # Prune overly long plans\n      if len(cur_actions) >= max_steps:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _hash_state(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, cur_actions + [a]))\n\n  # No feasible plan found within limits\n  return []", "env_interactions": 20, "island_id": 3, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:26:24.100795", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_key(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_key(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_PLAN_LEN = 500                     # safety cutoff for search depth\n  n_actions = getattr(world, \"n_actions\", 5)   # usually 4 moves + USE\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state, cur_actions = node.state, node.actions\n\n      if cur_state.satisfies(\"\", target_idx):\n          return cur_actions\n\n      if len(cur_actions) >= MAX_PLAN_LEN:\n          continue\n\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          key = _state_key(nxt_state)\n          if key not in visited:\n              visited.add(key)\n              frontier.append(Node(nxt_state, cur_actions + [a]))\n\n  return []", "env_interactions": 20, "island_id": 1, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:26:39.873316", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_key(st):\n      # Hashable representation of a CraftState\n      return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())\n\n  visited = {_state_key(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_PLAN_LEN = 500  # safety cutoff for search depth\n  n_actions = getattr(world, \"n_actions\", 5)  # usually 4 moves + USE\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state, cur_actions = node.state, node.actions\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return cur_actions\n\n      # Prune overly long trajectories\n      if len(cur_actions) >= MAX_PLAN_LEN:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          key = _state_key(nxt_state)\n          if key not in visited:\n              visited.add(key)\n              frontier.append(Node(nxt_state, cur_actions + [a]))\n\n  # No plan found within the search budget\n  return []", "env_interactions": 20, "island_id": 1, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:27:08.704071", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that finds a shortest sequence of movement actions from\n  # `start` to a cell adjacent to any of the `targets`.  The agent may\n  # only step on empty cells (no entity present in any kind layer).\n  # ------------------------------------------------------------------\n  def _bfs_path(start, targets):\n      width, height, _ = grid.shape\n      occupied = np.any(grid > 0, axis=2)          # True where any kind exists\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # If we are adjacent (Manhattan distance 1) to any target, stop\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n              if (x, y) == (tx, ty):\n                  return path\n          # Explore 4\u2011connected neighbours\n          for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:          # can only walk on empty cells\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # No path found \u2013 return empty list (will cause failure later)\n      return []\n\n  # ------------------------------------------------------------------\n  # Locate the CraftWorld and its cookbook.  The environment may be a\n  # raw CraftLab object or a wrapper that stores the world inside the\n  # current state.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      state_obj = getattr(env, \"_current_state\", None)\n      if state_obj is not None:\n          world = getattr(state_obj, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"Unable to locate CraftWorld instance in the environment.\")\n\n  cookbook = world.cookbook\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # Primitive requirements for a single arrow (primitive index -> count)\n  primitives_needed = cookbook.primitives_for(goal_idx)\n\n  # ------------------------------------------------------------------\n  # Ensure we have a current state (reset if the environment hasn't started)\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  pos = tuple(state.pos)          # current (x, y) position\n  grid = state.grid                # (W, H, n_kinds) occupancy matrix\n\n  actions = []\n  harvested = set()                # keep track of already collected cells\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first)\n  # ------------------------------------------------------------------\n  for prim_idx, cnt_needed in primitives_needed.items():\n      # Find all cells currently containing this primitive\n      locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # Order by Manhattan distance from current position\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      gathered = 0\n      for loc in locations:\n          if gathered >= cnt_needed:\n              break\n          if loc in harvested:\n              continue\n          # Move adjacent to the primitive\n          path = _bfs_path(pos, [loc])\n          actions.extend(path)\n          # Simulate movement to update our notion of position\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Pick up the primitive\n          actions.append(USE)\n          harvested.add(loc)\n          gathered += 1\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its designated workshop (if any)\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (could be a name string)\n      workshop_idx = cookbook.index[workshop_key] if isinstance(workshop_key, str) else workshop_key\n      # Locate all workshop cells of this type\n      workshop_locs = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if workshop_locs:\n          # Choose the nearest workshop\n          workshop_locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = workshop_locs[0]\n          # Move adjacent to the workshop\n          path = _bfs_path(pos, [target_ws])\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Craft using USE action\n          actions.append(USE)\n\n  return actions", "env_interactions": 21, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T23:27:09.977804", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Ensure the environment has a current state\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  # Locate the world and cookbook objects\n  world = getattr(env, \"world\", None)\n  if world is None:\n      world = getattr(state, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"Cannot find CraftWorld instance in the environment.\")\n\n  cookbook = world.cookbook\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # Primitive requirements for one arrow\n  primitives_needed = cookbook.primitives_for(goal_idx)\n\n  grid = state.grid\n  pos = tuple(state.pos)\n\n  actions = []\n  harvested = set()\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of movement actions bringing the\n  # agent from `start` to a cell adjacent to any of `targets`.\n  # ------------------------------------------------------------------\n  def _bfs_path(start, targets):\n      w, h, _ = grid.shape\n      occupied = np.any(grid > 0, axis=2)\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # Adjacent to a target?\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n              if (x, y) == (tx, ty):\n                  return path\n          # Explore 4\u2011connected neighbours\n          for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      return []\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first)\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      collected = 0\n      for loc in locations:\n          if collected >= needed:\n              break\n          if loc in harvested:\n              continue\n          path = _bfs_path(pos, [loc])\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          actions.append(USE)\n          harvested.add(loc)\n          collected += 1\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its designated workshop (if any)\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      if isinstance(workshop_key, str):\n          workshop_idx = cookbook.index[workshop_key]\n      else:\n          workshop_idx = workshop_key\n      workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if workshop_cells:\n          workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = workshop_cells[0]\n          path = _bfs_path(pos, [target_ws])\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          actions.append(USE)\n\n  return actions", "env_interactions": 21, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T23:27:37.783283", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # index of the goal item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _hash(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_PLAN_LEN = 3000            # safety limit for search depth\n  n_actions = getattr(world, \"n_actions\", 5)   # typically 4 moves + USE\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      if len(node.actions) >= MAX_PLAN_LEN:\n          continue\n\n      # Expand neighbours\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within limits\n  return []", "env_interactions": 20, "island_id": 2, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:27:53.472410", "function_name": "make_arrow", "function_body": "  # Retrieve scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Identify the index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initialise the starting state from the scenario\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  # BFS search over state space to find a sequence of actions that yields an arrow\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_PLAN_LEN = 5000                # safety bound on plan length\n  n_actions = getattr(world, \"n_actions\", 5)   # typically 4 moves + USE\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long plans\n      if len(node.actions) >= MAX_PLAN_LEN:\n          continue\n\n      # Expand neighbours by applying each possible action\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within the limits\n  return []", "env_interactions": 20, "island_id": 2, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:28:18.704499", "function_name": "make_arrow", "function_body": "  # ------------------------------------------------------------\n  # Setup: retrieve world, cookbook, goal index, and current state\n  # ------------------------------------------------------------\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # locate the CraftWorld instance inside the environment\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # some wrappers keep the world inside the current state object\n      cur_state = getattr(env, \"_current_state\", None)\n      if cur_state is not None:\n          world = getattr(cur_state, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"Cannot find CraftWorld instance in the environment.\")\n\n  cookbook = world.cookbook\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # primitive requirements for a single arrow\n  primitives_needed = cookbook.primitives_for(goal_idx)\n\n  # obtain the current state (reset if needed)\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  pos = tuple(state.pos)          # (x, y)\n  grid = state.grid                # (W, H, n_kinds)\n  # make a mutable copy that we will update as we \u201cpick up\u201d items\n  mutable_grid = grid.copy()\n\n  actions = []                     # final action sequence\n  # ------------------------------------------------------------\n  # Helper: BFS that returns a list of movement actions moving the\n  # agent from `start` to a cell adjacent to any target in `targets`.\n  # It treats any non\u2011empty cell in `mutable_grid` as blocked.\n  # ------------------------------------------------------------\n  def _bfs_path(start, targets):\n      width, height, _ = mutable_grid.shape\n      occupied = np.any(mutable_grid > 0, axis=2)\n\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # check adjacency to any target\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n              if (x, y) == (tx, ty):\n                  return path\n          # explore neighbours\n          for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # no path found \u2013 return empty list (will cause later failure)\n      return []\n\n  # ------------------------------------------------------------\n  # Collect required primitives (greedy nearest\u2011first)\n  # ------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      gathered = 0\n      while gathered < needed_cnt:\n          # locate remaining instances of this primitive\n          locations = [tuple(p) for p in np.argwhere(mutable_grid[:, :, prim_idx] > 0)]\n          if not locations:\n              # cannot find enough primitives \u2013 abort early\n              break\n          # sort by Manhattan distance from current position\n          locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_loc = locations[0]\n\n          # move adjacent to the primitive\n          path = _bfs_path(pos, [target_loc])\n          actions.extend(path)\n          # update simulated position\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n\n          # pick it up\n          actions.append(USE)\n          # remove the primitive from the mutable grid\n          mutable_grid[target_loc[0], target_loc[1], prim_idx] = 0\n          gathered += 1\n\n  # ------------------------------------------------------------\n  # Craft the arrow at its designated workshop (if any)\n  # ------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # resolve workshop index (may be a string name)\n      workshop_idx = cookbook.index[workshop_key] if isinstance(workshop_key, str) else workshop_key\n      # locate workshop cells\n      workshop_locs = [tuple(p) for p in np.argwhere(mutable_grid[:, :, workshop_idx] > 0)]\n      if workshop_locs:\n          workshop_locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = workshop_locs[0]\n          path = _bfs_path(pos, [target_ws])\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          actions.append(USE)\n  else:\n      # no specific workshop \u2013 just use the craft action at current location\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T23:28:19.872501", "function_name": "make_arrow", "function_body": "  # Action indices\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of movement actions taking the agent\n  # from `start` to a cell adjacent to any of `targets`.  The agent may\n  # only step on empty cells (no entity present in any kind channel).\n  # ------------------------------------------------------------------\n  def _bfs_path(start, targets):\n      w, h, _ = grid.shape\n      occupied = np.any(grid > 0, axis=2)          # True where something exists\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # Check adjacency to any target\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n              if (x, y) == (tx, ty):\n                  return path\n          # Expand 4\u2011connected neighbours\n          for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:          # can only walk on empty cells\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # No reachable target \u2013 return empty list (will cause failure later)\n      return []\n\n  # ------------------------------------------------------------------\n  # Locate the CraftWorld instance and the recipe index for \"arrow\"\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Some wrappers keep the world inside the current state object\n      state_obj = getattr(env, \"_current_state\", None)\n      if state_obj is not None:\n          world = getattr(state_obj, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"Unable to find CraftWorld instance in the environment.\")\n  cookbook = world.cookbook\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # Primitive requirements for a single arrow\n  primitives_needed = cookbook.primitives_for(goal_idx)\n\n  # ------------------------------------------------------------------\n  # Ensure we have a current state (reset if the environment hasn't started)\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  pos = tuple(state.pos)          # (x, y) coordinates\n  grid = state.grid                # (W, H, n_kinds)\n\n  actions = []\n  harvested = set()                # cells already used for collection\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first)\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      # Current locations of this primitive on the grid\n      locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # Order by Manhattan distance from current position\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      gathered = 0\n      for loc in locations:\n          if gathered >= needed_cnt:\n              break\n          if loc in harvested:\n              continue\n          # Move adjacent to the primitive\n          path = _bfs_path(pos, [loc])\n          actions.extend(path)\n          # Simulate moving the agent\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Pick it up\n          actions.append(USE)\n          harvested.add(loc)\n          gathered += 1\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its designated workshop (if any)\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (may be a name or already an int)\n      workshop_idx = cookbook.index[workshop_key] if isinstance(workshop_key, str) else workshop_key\n      # Locate workshop cells\n      workshop_locs = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if workshop_locs:\n          # Choose nearest workshop\n          workshop_locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = workshop_locs[0]\n          # Move adjacent to the workshop\n          path = _bfs_path(pos, [target_ws])\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Craft using USE\n          actions.append(USE)\n\n  return actions", "env_interactions": 21, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T23:28:36.572351", "function_name": "make_arrow", "function_body": "  # Retrieve the world and ensure we have access to the cookbook\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Target item index for \u201carrow\u201d\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Starting state of the episode\n  try:\n      start_state = scenario.init()\n  except Exception:\n      return []\n\n  # Primitive requirements for a single arrow (may be empty if arrow is primitive)\n  primitive_reqs = world.cookbook.primitives_for(target_idx)\n\n  # Workshop kind required for crafting the arrow (if any)\n  workshop_idx = None\n  recipe = world.cookbook.recipes.get(target_idx, {})\n  if \"_at\" in recipe:\n      workshop_idx = recipe[\"_at\"]\n\n  # Helper: Manhattan distance between two points\n  def manhattan(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  # Helper: find the nearest cell (Manhattan) that contains a given kind\n  def nearest_distance(state, kind_idx):\n      positions = np.argwhere(state.grid[:, :, kind_idx] > 0)\n      if positions.size == 0:\n          return None\n      dists = np.abs(positions - np.array(state.pos)).sum(axis=1)\n      return int(dists.min())\n\n  # Heuristic for A*:\n  #   - If we still need primitives, distance to the closest needed primitive.\n  #   - Otherwise, distance to the workshop (if known).\n  def heuristic(state):\n      # Check missing primitives\n      missing = []\n      for pid, cnt in primitive_reqs.items():\n          if state.inventory[pid] < cnt:\n              missing.append(pid)\n      if missing:\n          dists = [nearest_distance(state, pid) for pid in missing]\n          dists = [d for d in dists if d is not None]\n          return min(dists) if dists else 0\n      # All primitives satisfied \u2013 head to workshop if needed\n      if workshop_idx is not None:\n          d = nearest_distance(state, workshop_idx)\n          return d if d is not None else 0\n      return 0\n\n  from collections import deque, namedtuple\n  import heapq\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\", \"g\"])\n\n  def state_hash(st):\n      # Unique identifier for a state (position, direction, inventory, grid)\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {state_hash(start_state)}\n  # priority queue: (f = g + h, g, Node)\n  frontier = []\n  start_h = heuristic(start_state)\n  heapq.heappush(frontier, (start_h, 0, Node(start_state, [], 0)))\n\n  MAX_STEPS = 500\n  n_actions = getattr(world, \"n_actions\", 5)  # typical actions: 0\u20114\n\n  while frontier:\n      _, g, node = heapq.heappop(frontier)\n      cur_state = node.state\n\n      # Goal check\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      if g >= MAX_STEPS:\n          continue\n\n      # Expand possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = state_hash(nxt_state)\n          if h in visited:\n              continue\n          visited.add(h)\n          new_actions = node.actions + [a]\n          new_g = g + 1\n          f = new_g + heuristic(nxt_state)\n          heapq.heappush(frontier, (f, new_g, Node(nxt_state, new_actions, new_g)))\n\n  # If we exhaust the search without finding a plan, return empty list\n  return []", "env_interactions": 0, "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-10-28T23:28:52.323314", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initialise the starting state\n  try:\n      start_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      # Unique hash for a state: position, direction, inventory, and grid layout\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(start_state)}\n  frontier = deque([Node(start_state, [])])\n\n  # Search limits\n  MAX_STEPS = 500\n  n_actions = getattr(world, \"n_actions\", 5)  # typical actions: 0\u20114\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: does the inventory contain the arrow?\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Depth limit\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand neighbours\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within the depth limit\n  return []", "env_interactions": 20, "island_id": 7, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:29:26.610611", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Action identifiers (standard CraftWorld actions)\n  # ----------------------------------------------------------------------\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving from `start` to a cell\n  # adjacent (Manhattan distance = 1) to any cell in `targets`.  Occupied\n  # cells (any non\u2011zero entry in the grid) are treated as walls.\n  # ----------------------------------------------------------------------\n  def _bfs_to_adjacent(start, targets, occ):\n      w, h = occ.shape\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # adjacency test\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n          # expand neighbours\n          for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occ[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # unreachable \u2013 return empty list\n      return []\n\n  # ----------------------------------------------------------------------\n  # Locate the underlying CraftWorld instance and its cookbook.\n  # ----------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Some wrappers expose the world via the internal state.\n      state_obj = getattr(env, \"_current_state\", None)\n      if state_obj is not None:\n          world = getattr(state_obj, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"Could not locate CraftWorld instance inside env.\")\n  cookbook = world.cookbook\n\n  # ----------------------------------------------------------------------\n  # Goal: craft an 'arrow'.\n  # ----------------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # Required primitive counts for a single arrow.\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n\n  # ----------------------------------------------------------------------\n  # Ensure we start from a fresh episode.\n  # ----------------------------------------------------------------------\n  if not hasattr(env, \"_current_state\") or env._current_state is None:\n      env.reset()\n  state = env._current_state\n\n  # Current position, grid and occupancy map.\n  pos = tuple(state.pos)                     # (x, y)\n  grid = state.grid                           # (W, H, n_kinds)\n  occupied = np.any(grid > 0, axis=2)         # True where movement is blocked\n\n  actions = []            # final action sequence\n  collected_cells = set() # primitives already harvested\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first).\n  # ----------------------------------------------------------------------\n  for prim_idx, need in primitives_needed.items():\n      # Locate all cells that currently contain this primitive.\n      cells = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # Sort by Manhattan distance from our current position.\n      cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n      gathered = 0\n      for cell in cells:\n          if gathered >= need:\n              break\n          if cell in collected_cells:\n              continue\n          # Move adjacent to the primitive.\n          path = _bfs_to_adjacent(pos, [cell], occupied)\n          actions.extend(path)\n          # Update our notion of position.\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Pick up the primitive.\n          actions.append(USE)\n          # After collection the cell becomes empty \u2013 update occupancy.\n          occupied[cell[0], cell[1]] = False\n          collected_cells.add(cell)\n          gathered += 1\n\n  # ----------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow.\n  # ----------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (could be a string name or already an int).\n      workshop_idx = (\n          cookbook.index[workshop_key]\n          if isinstance(workshop_key, str) else workshop_key\n      )\n      ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if not ws_cells:\n          raise RuntimeError(f\"No workshop of type '{workshop_key}' found.\")\n      # Choose the nearest workshop.\n      ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n      target_ws = ws_cells[0]\n      path = _bfs_to_adjacent(pos, [target_ws], occupied)\n      actions.extend(path)\n      for act in path:\n          if act == RIGHT:\n              pos = (pos[0] + 1, pos[1])\n          elif act == LEFT:\n              pos = (pos[0] - 1, pos[1])\n          elif act == DOWN:\n              pos = (pos[0], pos[1] + 1)\n          elif act == UP:\n              pos = (pos[0], pos[1] - 1)\n      # Craft the arrow.\n      actions.append(USE)\n  else:\n      # No specific workshop \u2013 just use the craft action at current location.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T23:29:27.766927", "function_name": "make_arrow", "function_body": "  import collections\n  import numpy as np\n\n  # Action indices (standard CraftWorld actions)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  def _bfs_to_adjacent(start, targets, occ):\n      \"\"\"Return a list of actions moving from `start` to a cell adjacent\n      (Manhattan distance = 1) to any cell in `targets`. Cells where\n      `occ` is True are treated as walls.\"\"\"\n      w, h = occ.shape\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # adjacency check\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n          # explore neighbours\n          for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occ[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # No reachable adjacency\n      return []\n\n  # ------------------------------------------------------------------\n  # Locate the underlying CraftWorld and its cookbook.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      state_obj = getattr(env, \"_current_state\", None)\n      if state_obj is not None:\n          world = getattr(state_obj, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"Could not locate CraftWorld instance inside the environment.\")\n  cookbook = world.cookbook\n\n  # ------------------------------------------------------------------\n  # Goal: craft an 'arrow'.\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # Primitive requirements for a single arrow.\n  primitives_needed = cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n\n  # ------------------------------------------------------------------\n  # Ensure we start from a fresh episode.\n  # ------------------------------------------------------------------\n  if not hasattr(env, \"_current_state\") or env._current_state is None:\n      env.reset()\n  state = env._current_state\n\n  pos = tuple(state.pos)          # (x, y)\n  grid = state.grid                # (W, H, n_kinds)\n\n  # Occupancy map: True where any entity blocks movement.\n  occupied = np.any(grid > 0, axis=2)\n\n  actions = []                     # final action sequence\n  collected = set()                # cells already harvested\n\n  # ------------------------------------------------------------------\n  # Collect required primitives (nearest\u2011first greedy).\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      # All cells currently containing this primitive.\n      cells = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # Sort by Manhattan distance from current position.\n      cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n      gathered = 0\n      for cell in cells:\n          if gathered >= needed:\n              break\n          if cell in collected:\n              continue\n          # Move adjacent to the primitive.\n          path = _bfs_to_adjacent(pos, [cell], occupied)\n          actions.extend(path)\n          # Update position according to the path taken.\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Pick up the primitive.\n          actions.append(USE)\n          # After collection the cell becomes empty \u2013 update occupancy.\n          occupied[cell[0], cell[1]] = False\n          collected.add(cell)\n          gathered += 1\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (may be a name or already an int).\n      workshop_idx = (\n          cookbook.index[workshop_key]\n          if isinstance(workshop_key, str) else workshop_key\n      )\n      ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if not ws_cells:\n          raise RuntimeError(f\"No workshop of type '{workshop_key}' found.\")\n      # Choose the nearest workshop.\n      ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n      target_ws = ws_cells[0]\n      path = _bfs_to_adjacent(pos, [target_ws], occupied)\n      actions.extend(path)\n      for act in path:\n          if act == RIGHT:\n              pos = (pos[0] + 1, pos[1])\n          elif act == LEFT:\n              pos = (pos[0] - 1, pos[1])\n          elif act == DOWN:\n              pos = (pos[0], pos[1] + 1)\n          elif act == UP:\n              pos = (pos[0], pos[1] - 1)\n      # Craft the arrow.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T23:29:56.253928", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  try:\n      start_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_key(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_key(start_state)}\n  frontier = deque([Node(start_state, [])])\n\n  MAX_PLAN_LENGTH = 800\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state, cur_actions = node.state, node.actions\n\n      if cur_state.satisfies(\"\", target_idx):\n          return cur_actions\n\n      if len(cur_actions) >= MAX_PLAN_LENGTH:\n          continue\n\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          key = _state_key(nxt_state)\n          if key not in visited:\n              visited.add(key)\n              frontier.append(Node(nxt_state, cur_actions + [a]))\n\n  return []", "env_interactions": 20, "island_id": 1, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:30:11.958357", "function_name": "make_arrow", "function_body": "  # Retrieve scenario and world objects from the environment\n  scenario = getattr(env, \"scenario\", None) or env\n  world = getattr(scenario, \"world\", None) or getattr(env, \"world\", None)\n  if world is None:\n      return []\n\n  # Identify the index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Obtain the initial state for planning\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_key(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      # Combine position, direction, inventory tuple, and grid bytes\n      return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())\n\n  visited = {_state_key(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_PLAN_LENGTH = 500                     # safety cap on plan length\n  n_actions = getattr(world, \"n_actions\", 5)   # usually 5 (4 moves + USE)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state, cur_actions = node.state, node.actions\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return cur_actions\n\n      # Prune overly long trajectories\n      if len(cur_actions) >= MAX_PLAN_LENGTH:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key not in visited:\n              visited.add(key)\n              frontier.append(Node(next_state, cur_actions + [a]))\n\n  # No plan found within the search limits\n  return []", "env_interactions": 20, "island_id": 1, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:30:34.050156", "function_name": "make_arrow", "function_body": "", "env_interactions": 0, "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-10-28T23:30:35.209611", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Action identifiers \u2013 must match the ordering used in CraftWorld.\n  # ----------------------------------------------------------------------\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  MOVE_DELTAS = {DOWN: (0, 1), UP: (0, -1), LEFT: (-1, 0), RIGHT: (1, 0)}\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving the agent from `src`\n  # to a cell that is *adjacent* (Manhattan distance = 1) to any cell in\n  # `targets`.  Cells where `blocked` is True are treated as obstacles.\n  # ----------------------------------------------------------------------\n  from collections import deque\n\n  def _bfs_adjacent(src, targets, blocked):\n      w, h = blocked.shape\n      target_set = set(targets)\n\n      # Already adjacent?\n      for tx, ty in target_set:\n          if abs(src[0] - tx) + abs(src[1] - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((src[0], src[1], []))\n      visited = {src}\n      while q:\n          x, y, path = q.popleft()\n          for act, (dx, dy) in MOVE_DELTAS.items():\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < w and 0 <= ny < h):\n                  continue\n              if blocked[nx, ny] or (nx, ny) in visited:\n                  continue\n              new_path = path + [act]\n              for tx, ty in target_set:\n                  if abs(nx - tx) + abs(ny - ty) == 1:\n                      return new_path\n              visited.add((nx, ny))\n              q.append((nx, ny, new_path))\n      return []  # unreachable\n\n  # ----------------------------------------------------------------------\n  # Retrieve the world and current state from the environment.\n  # ----------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n      world = state.world\n  else:\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n\n  cookbook = world.cookbook\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # ----------------------------------------------------------------------\n  # Determine primitive ingredients needed for a single arrow.\n  # ----------------------------------------------------------------------\n  needed_prims = cookbook.primitives_for(goal_idx)           # {prim_idx: count}\n  if not needed_prims:                                        # arrow itself is primitive\n      return [USE]\n\n  # ----------------------------------------------------------------------\n  # Current grid, agent position and occupancy mask.\n  # ----------------------------------------------------------------------\n  grid = state.grid                                          # (W, H, n_kinds)\n  pos = tuple(state.pos)                                     # (x, y)\n  occupied = np.any(grid > 0, axis=2)                        # True where any entity exists\n\n  actions = []\n  harvested = set()                                          # cells already collected from\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first).\n  # ----------------------------------------------------------------------\n  for prim_idx, count_needed in needed_prims.items():\n      collected = 0\n      while collected < count_needed:\n          # Locate all remaining cells containing this primitive.\n          cand = [\n              tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)\n              if tuple(p) not in harvested\n          ]\n          if not cand:\n              break  # no more of this primitive on the map\n\n          # Choose the closest one (Manhattan distance).\n          cand.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          target = cand[0]\n\n          # Plan path to a cell adjacent to the primitive.\n          path = _bfs_adjacent(pos, [target], occupied)\n          actions.extend(path)\n\n          # Simulate movement.\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Pick up the primitive.\n          actions.append(USE)\n          harvested.add(target)\n          collected += 1\n\n          # Update occupancy \u2013 the cell becomes empty after pickup.\n          occupied[target] = False\n\n  # ----------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow.\n  # ----------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (may be a name string).\n      workshop_idx = (\n          cookbook.index[workshop_key]\n          if isinstance(workshop_key, str) else workshop_key\n      )\n      ws_cells = [\n          tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)\n      ]\n      if ws_cells:\n          ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          ws_target = ws_cells[0]\n          path = _bfs_adjacent(pos, [ws_target], occupied)\n          actions.extend(path)\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(USE)          # craft at workshop\n      else:\n          actions.append(USE)          # fallback: try to craft in place\n  else:\n      actions.append(USE)              # no specific workshop required\n\n  return actions", "env_interactions": 23, "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T23:30:55.627552", "function_name": "make_arrow", "function_body": "  # Action IDs (must match CraftWorld ordering)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  MOVE_DELTAS = {DOWN: (0, 1), UP: (0, -1), LEFT: (-1, 0), RIGHT: (1, 0)}\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving the agent from\n  # `start` to a cell adjacent to any cell in `targets`.  Cells that\n  # contain any entity are considered blocked, except the target cells\n  # themselves (we only need to stand next to them).  If already\n  # adjacent, returns an empty list.\n  # ------------------------------------------------------------------\n  def _bfs_adjacent(start, targets, occupied):\n      from collections import deque\n      w, h = occupied.shape\n      target_set = set(targets)\n\n      # Already adjacent?\n      for tx, ty in target_set:\n          if abs(start[0] - tx) + abs(start[1] - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      while q:\n          x, y, path = q.popleft()\n          for act, (dx, dy) in MOVE_DELTAS.items():\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < w and 0 <= ny < h):\n                  continue\n              if (nx, ny) in visited or occupied[nx, ny]:\n                  continue\n              new_path = path + [act]\n              for tx, ty in target_set:\n                  if abs(nx - tx) + abs(ny - ty) == 1:\n                      return new_path\n              visited.add((nx, ny))\n              q.append((nx, ny, new_path))\n      return []  # unreachable\n\n  # ------------------------------------------------------------------\n  # Retrieve the current world, state and cookbook objects from the\n  # environment (works for both raw CraftWorld and CraftLab wrappers).\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Likely a CraftLab instance.\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n      world = state.world\n  else:\n      # CraftWorld / CraftScenario instance.\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n\n  cookbook = world.cookbook\n  goal_idx = cookbook.index[\"arrow\"]\n\n  # ------------------------------------------------------------------\n  # Determine which primitive resources are required for a single arrow.\n  # ------------------------------------------------------------------\n  primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n  if not primitives_needed:\n      # Arrow is a primitive itself \u2013 just use the current cell.\n      return [USE]\n\n  # ------------------------------------------------------------------\n  # Current grid, agent position and occupancy mask.\n  # ------------------------------------------------------------------\n  import numpy as np\n  grid = state.grid                     # (W, H, n_kinds)\n  pos = tuple(state.pos)                # (x, y)\n  occupied = np.any(grid > 0, axis=2)   # True where any entity exists\n\n  actions = []\n  harvested = set()                     # cells already collected from\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first).\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      gathered = 0\n      while gathered < needed_cnt:\n          # Locate all cells containing this primitive and not yet harvested.\n          cells = [\n              tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)\n              if tuple(p) not in harvested\n          ]\n          if not cells:\n              # No more of this primitive on the map \u2013 abort early.\n              break\n\n          # Choose the closest cell (Manhattan distance).\n          cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          target = cells[0]\n\n          # Plan a path to a cell adjacent to the target.\n          path = _bfs_adjacent(pos, [target], occupied)\n          actions.extend(path)\n\n          # Simulate movement to keep `pos` up\u2011to\u2011date.\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Pick up the primitive.\n          actions.append(USE)\n          harvested.add(target)\n          gathered += 1\n\n          # Update occupancy mask \u2013 the cell becomes empty after pickup.\n          occupied[target] = False\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (string name or already an int).\n      workshop_idx = (\n          cookbook.index[workshop_key]\n          if isinstance(workshop_key, str) else workshop_key\n      )\n      ws_cells = [\n          tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)\n      ]\n      if ws_cells:\n          # Move to the nearest workshop.\n          ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          ws_target = ws_cells[0]\n          path = _bfs_adjacent(pos, [ws_target], occupied)\n          actions.extend(path)\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(USE)   # craft at workshop\n      else:\n          # No visible workshop \u2013 attempt to craft in place.\n          actions.append(USE)\n  else:\n      # No specific workshop required.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T23:30:56.763179", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  MOVE_DELTAS = {DOWN: (0, 1), UP: (0, -1), LEFT: (-1, 0), RIGHT: (1, 0)}\n\n  def _bfs_adjacent(start, targets, occupied):\n      \"\"\"Return actions moving from `start` to a cell adjacent to any of `targets`.\"\"\"\n      w, h = occupied.shape\n      target_set = set(targets)\n\n      # already adjacent?\n      for tx, ty in target_set:\n          if abs(start[0] - tx) + abs(start[1] - ty) == 1:\n              return []\n\n      from collections import deque\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      while q:\n          x, y, path = q.popleft()\n          for act, (dx, dy) in MOVE_DELTAS.items():\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < w and 0 <= ny < h):\n                  continue\n              if (nx, ny) in visited or occupied[nx, ny]:\n                  continue\n              new_path = path + [act]\n              for tx, ty in target_set:\n                  if abs(nx - tx) + abs(ny - ty) == 1:\n                      return new_path\n              visited.add((nx, ny))\n              q.append((nx, ny, new_path))\n      return []  # unreachable\n\n  # ------------------------------------------------------------------\n  # Retrieve world, state and cookbook objects from the environment.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Probably a CraftLab wrapper.\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n      world = state.world\n  else:\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n\n  cookbook = world.cookbook\n  goal_idx = cookbook.index[\"arrow\"]\n\n  # ------------------------------------------------------------------\n  # Determine primitive requirements for a single arrow.\n  # ------------------------------------------------------------------\n  primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n  if not primitives_needed:\n      # Arrow itself is primitive \u2013 just use current cell.\n      return [USE]\n\n  # ------------------------------------------------------------------\n  # Current grid, position and occupancy mask.\n  # ------------------------------------------------------------------\n  grid = state.grid                     # (W, H, n_kinds)\n  pos = tuple(state.pos)                # (x, y)\n  occupied = np.any(grid > 0, axis=2)   # True where any entity occupies the cell\n\n  actions = []\n  harvested = set()                     # cells already collected from\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first).\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      gathered = 0\n      while gathered < needed_cnt:\n          # Find all remaining cells containing this primitive.\n          prim_cells = [\n              tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)\n              if tuple(p) not in harvested\n          ]\n          if not prim_cells:\n              break  # no more of this primitive available\n\n          # Choose the closest primitive (Manhattan distance).\n          prim_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          target = prim_cells[0]\n\n          # Plan a path to a cell adjacent to the primitive.\n          path = _bfs_adjacent(pos, [target], occupied)\n          actions.extend(path)\n\n          # Simulate movement.\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Pick up the primitive.\n          actions.append(USE)\n          harvested.add(target)\n          gathered += 1\n\n          # Update occupancy mask \u2013 the cell becomes empty after pickup.\n          occupied[target] = False\n\n  # ------------------------------------------------------------------\n  # Move to required workshop (if any) and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (string name or already an int).\n      workshop_idx = (\n          cookbook.index[workshop_key]\n          if isinstance(workshop_key, str) else workshop_key\n      )\n      workshop_cells = [\n          tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)\n      ]\n      if workshop_cells:\n          workshop_cells.sort(\n              key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1])\n          )\n          ws_target = workshop_cells[0]\n          path = _bfs_adjacent(pos, [ws_target], occupied)\n          actions.extend(path)\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(USE)   # craft at workshop\n      else:\n          # No workshop found \u2013 attempt crafting in place.\n          actions.append(USE)\n  else:\n      # No workshop required.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T23:31:26.034738", "function_name": "make_arrow", "function_body": "  # Get scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initialise starting state\n  try:\n      start_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      # combine position, direction, inventory tuple and grid bytes\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(start_state)}\n  frontier = deque([Node(start_state, [])])\n\n  MAX_STEPS = 300\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  # Optional primitive requirement map for simple pruning\n  try:\n      primitive_req = world.cookbook.primitives_for(target_idx)\n  except Exception:\n      primitive_req = {}\n\n  while frontier:\n      node = frontier.popleft()\n      state = node.state\n\n      # Goal test\n      if state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Depth limit\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand\n      for a in range(n_actions):\n          _, nxt = state.step(a)\n          h = _state_hash(nxt)\n          if h in visited:\n              continue\n\n          # Simple pruning: if we already have more of any primitive than needed\n          if primitive_req:\n              inv = nxt.inventory\n              over = False\n              for prim_idx, need in primitive_req.items():\n                  if inv[prim_idx] > need:\n                      over = True\n                      break\n              if over:\n                  # allow if we also already have the target (checked above)\n                  # otherwise discard this branch\n                  continue\n\n          visited.add(h)\n          frontier.append(Node(nxt, node.actions + [a]))\n\n  # No plan found\n  return []", "env_interactions": 21, "island_id": 7, "scores": {"3": 1.8}}
{"timestamp": "2025-10-28T23:31:45.879344", "function_name": "make_arrow", "function_body": "  # Retrieve the scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Identify the index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initialise the starting state of the episode\n  try:\n      start_state = scenario.init()\n  except Exception:\n      return []\n\n  # Helper: create a hashable representation of a state for visited tracking\n  def _state_hash(st):\n      # Position, direction, inventory (as tuple), and full grid bytes uniquely identify a state\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  # Prepare BFS structures\n  from collections import deque, namedtuple\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n  visited = {_state_hash(start_state)}\n  frontier = deque([Node(start_state, [])])\n\n  # Search limits\n  MAX_STEPS = 300          # safety bound on plan length\n  n_actions = getattr(world, \"n_actions\", 5)   # typical actions: 0\u20114 (DOWN,UP,LEFT,RIGHT,USE)\n\n  # Optional: primitive requirements for pruning\n  try:\n      primitive_req = world.cookbook.primitives_for(target_idx)\n  except Exception:\n      primitive_req = {}\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: check if the arrow is in the inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Depth limit\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h in visited:\n              continue\n\n          # Simple pruning: if we have collected more of any required primitive\n          # than needed and we do not already possess the target, discard the node.\n          if primitive_req:\n              inv = nxt_state.inventory\n              over = False\n              for prim_idx, needed in primitive_req.items():\n                  if inv[prim_idx] > needed:\n                      over = True\n                      break\n              if over and not nxt_state.satisfies(\"\", target_idx):\n                  # allow if we also have intermediate crafted items that might be useful\n                  # (conservatively, we keep the node if any non\u2011primitive count > 0)\n                  non_prim = any(\n                      inv[i] > 0 and i not in primitive_req\n                      for i in range(len(inv))\n                  )\n                  if not non_prim:\n                      continue\n\n          visited.add(h)\n          frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # If no plan found within limits, return an empty list\n  return []", "env_interactions": 21, "island_id": 7, "scores": {"3": 1.8}}
{"timestamp": "2025-10-28T23:32:13.626455", "function_name": "make_arrow", "function_body": "  # Retrieve the scenario and world objects (the env may be wrapped)\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the item we want to craft (\u201carrow\u201d)\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initialise the starting CraftState\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      # Hash based on position, direction, inventory and full grid layout\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  # Limit the depth of the search to keep it tractable\n  MAX_STEPS = 500\n  n_actions = getattr(world, \"n_actions\", 5)  # usually 5 (4 moves + USE)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand neighbours by trying every possible action\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within the depth limit\n  return []", "env_interactions": 20, "island_id": 7, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:32:29.291489", "function_name": "make_arrow", "function_body": "  # Resolve the scenario and world objects, handling possible wrappers\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Find the index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initialise the starting CraftState\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  # Bread\u2011first search over the state space to obtain a plan\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 400                     # depth limit to keep search tractable\n  n_actions = getattr(world, \"n_actions\", 5)   # typically 5 (4 moves + USE)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand neighbours\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within the depth limit\n  return []", "env_interactions": 20, "island_id": 7, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:32:49.768443", "function_name": "make_arrow", "function_body": "  import numpy as np, collections\n\n  # standard action ids\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # helper: BFS returning actions to reach a cell adjacent to any target\n  # ------------------------------------------------------------------\n  def _bfs_adj(start, targets, occ):\n      w, h = occ.shape\n      q = collections.deque([(start[0], start[1], [])])\n      visited = {start}\n      target_set = set(targets)\n      while q:\n          x, y, path = q.popleft()\n          # adjacency test\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n          for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occ[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      return []  # unreachable\n\n  # ------------------------------------------------------------------\n  # locate world and cookbook\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      st = getattr(env, \"_current_state\", None)\n      if st is not None:\n          world = getattr(st, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"CraftWorld instance not found in env.\")\n  cookbook = world.cookbook\n\n  # ------------------------------------------------------------------\n  # goal = arrow\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # primitive requirements for one arrow\n  needed = cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n\n  # ------------------------------------------------------------------\n  # ensure fresh episode and fetch current state\n  # ------------------------------------------------------------------\n  if not hasattr(env, \"_current_state\") or env._current_state is None:\n      env.reset()\n  state = env._current_state\n\n  pos = tuple(state.pos)                     # (x, y)\n  grid = state.grid                           # (W, H, n_kinds)\n  occupied = np.any(grid > 0, axis=2)        # True where blocked\n\n  actions = []\n  collected = set()                          # cells already used\n\n  # ------------------------------------------------------------------\n  # collect required primitives (greedy nearest first)\n  # ------------------------------------------------------------------\n  for prim_idx, qty in needed.items():\n      # locate all instances of this primitive\n      locs = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # sort by Manhattan distance from current pos\n      locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      have = 0\n      for loc in locs:\n          if have >= qty:\n              break\n          if loc in collected:\n              continue\n          # move adjacent to primitive\n          path = _bfs_adj(pos, [loc], occupied)\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # pick it up\n          actions.append(USE)\n          occupied[loc[0], loc[1]] = False\n          collected.add(loc)\n          have += 1\n\n  # ------------------------------------------------------------------\n  # go to workshop (if recipe specifies) and craft\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # resolve index (may be name string)\n      ws_idx = cookbook.index[workshop_key] if isinstance(workshop_key, str) else workshop_key\n      ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, ws_idx] > 0)]\n      if not ws_cells:\n          raise RuntimeError(f\"No workshop '{workshop_key}' found.\")\n      ws_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      target_ws = ws_cells[0]\n      path = _bfs_adj(pos, [target_ws], occupied)\n      actions.extend(path)\n      for act in path:\n          if act == RIGHT:\n              pos = (pos[0] + 1, pos[1])\n          elif act == LEFT:\n              pos = (pos[0] - 1, pos[1])\n          elif act == DOWN:\n              pos = (pos[0], pos[1] + 1)\n          elif act == UP:\n              pos = (pos[0], pos[1] - 1)\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 9, "scores": {"3": 0.5}}
