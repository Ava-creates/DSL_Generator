{"timestamp": "2025-10-28T23:02:39.496274", "function_name": "make_arrow", "function_body": "  import collections\n  import numpy as np\n\n  # ----------------------------------------------------------------------\n  # Action constants \u2013 match default CraftWorld ordering.\n  # ----------------------------------------------------------------------\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  MOVE_DELTAS = {\n      DOWN: (0, 1),\n      UP: (0, -1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving the agent from `start`\n  # to a cell that is *adjacent* (Manhattan distance = 1) to any cell in\n  # `targets`.  Cells that contain any entity are treated as blocked.\n  # ----------------------------------------------------------------------\n  def _bfs_adjacent(start, targets, occupied):\n      width, height = occupied.shape\n      target_set = set(targets)\n\n      # Already adjacent?\n      for tx, ty in target_set:\n          if abs(start[0] - tx) + abs(start[1] - ty) == 1:\n              return []\n\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n\n      while q:\n          x, y, path = q.popleft()\n          for act, (dx, dy) in MOVE_DELTAS.items():\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              if occupied[nx, ny]:\n                  continue\n              visited.add((nx, ny))\n              new_path = path + [act]\n              for tx, ty in target_set:\n                  if abs(nx - tx) + abs(ny - ty) == 1:\n                      return new_path\n              q.append((nx, ny, new_path))\n      return []  # unreachable\n\n  # ----------------------------------------------------------------------\n  # Obtain world, state and cookbook from the environment.\n  # ----------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n      world = state.world\n  else:\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n\n  cookbook = world.cookbook\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # ----------------------------------------------------------------------\n  # Primitive requirements for a single arrow.\n  # ----------------------------------------------------------------------\n  primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n  if not primitives_needed:\n      # Arrow is a primitive \u2013 just use (no movement needed).\n      return [USE]\n\n  # ----------------------------------------------------------------------\n  # Current grid, position and occupancy mask.\n  # ----------------------------------------------------------------------\n  grid = state.grid                     # (W, H, n_kinds)\n  pos = tuple(state.pos)                # (x, y)\n  occupied = np.any(grid > 0, axis=2)   # True where any entity exists\n\n  actions = []\n  harvested = set()                     # locations already collected from\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first).\n  # ----------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      gathered = 0\n      while gathered < needed_cnt:\n          # Find all cells holding this primitive that haven't been used.\n          prim_locs = [\n              tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)\n              if tuple(p) not in harvested\n          ]\n          if not prim_locs:\n              # No more of this primitive on the map \u2013 abort early.\n              break\n\n          # Choose the closest primitive (Manhattan distance).\n          prim_locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target = prim_locs[0]\n\n          # Plan path to a cell adjacent to the primitive.\n          path = _bfs_adjacent(pos, [target], occupied)\n          actions.extend(path)\n\n          # Update simulated position.\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Pick up the primitive.\n          actions.append(USE)\n          harvested.add(target)\n          gathered += 1\n\n          # Cell becomes empty \u2013 update occupancy mask.\n          occupied[target] = False\n\n  # ----------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any).\n  # ----------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (may be a string name).\n      workshop_idx = (\n          cookbook.index[workshop_key]\n          if isinstance(workshop_key, str) else workshop_key\n      )\n      # Locate all workshop cells of the required type.\n      workshop_cells = [\n          tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)\n      ]\n      if workshop_cells:\n          # Move to the nearest workshop.\n          workshop_cells.sort(\n              key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1])\n          )\n          ws_target = workshop_cells[0]\n          path = _bfs_adjacent(pos, [ws_target], occupied)\n          actions.extend(path)\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(USE)  # craft\n      else:\n          # No workshop found \u2013 fall back to using current cell.\n          actions.append(USE)\n  else:\n      # No specific workshop required.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T23:02:40.653192", "function_name": "make_arrow", "function_body": "  import collections\n  import numpy as np\n\n  # ----------------------------------------------------------------------\n  # Action constants \u2013 must match CraftWorld ordering.\n  # ----------------------------------------------------------------------\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  MOVE_DELTAS = {\n      DOWN: (0, 1),\n      UP: (0, -1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving the agent from `start`\n  # to a cell that is adjacent (Manhattan distance = 1) to any cell in\n  # `targets`.  Cells occupied by any entity are treated as blocked.\n  # ----------------------------------------------------------------------\n  def _bfs_adjacent(start, targets, occupied):\n      width, height = occupied.shape\n      target_set = set(targets)\n\n      # Already adjacent?\n      for tx, ty in target_set:\n          if abs(start[0] - tx) + abs(start[1] - ty) == 1:\n              return []\n\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n\n      while q:\n          x, y, path = q.popleft()\n          for act, (dx, dy) in MOVE_DELTAS.items():\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              if (nx, ny) in visited or occupied[nx, ny]:\n                  continue\n              new_path = path + [act]\n              # Check adjacency to any target.\n              for tx, ty in target_set:\n                  if abs(nx - tx) + abs(ny - ty) == 1:\n                      return new_path\n              visited.add((nx, ny))\n              q.append((nx, ny, new_path))\n      return []  # unreachable\n\n  # ----------------------------------------------------------------------\n  # Extract world, state and cookbook from the environment.\n  # ----------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Likely a CraftLab wrapper.\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n      world = state.world\n  else:\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n\n  cookbook = world.cookbook\n  goal_idx = cookbook.index[\"arrow\"]\n\n  # ----------------------------------------------------------------------\n  # Determine primitive requirements for a single arrow.\n  # ----------------------------------------------------------------------\n  primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n  if not primitives_needed:\n      # Arrow itself is a primitive \u2013 just use current cell.\n      return [USE]\n\n  # ----------------------------------------------------------------------\n  # Current grid, agent position and occupancy mask.\n  # ----------------------------------------------------------------------\n  grid = state.grid                     # (W, H, n_kinds)\n  pos = tuple(state.pos)                # (x, y)\n  occupied = np.any(grid > 0, axis=2)   # True where any entity exists\n\n  actions = []\n  harvested = set()                     # cells already collected from\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first).\n  # ----------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      gathered = 0\n      while gathered < needed_cnt:\n          # Locate all cells containing this primitive that haven't been used.\n          prim_cells = [\n              tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)\n              if tuple(p) not in harvested\n          ]\n          if not prim_cells:\n              # No more of this primitive on the map \u2013 stop early.\n              break\n\n          # Choose the closest primitive (Manhattan distance).\n          prim_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          target = prim_cells[0]\n\n          # Plan path to a cell adjacent to the primitive.\n          path = _bfs_adjacent(pos, [target], occupied)\n          actions.extend(path)\n\n          # Simulate movement to keep `pos` up\u2011to\u2011date.\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Pick up the primitive.\n          actions.append(USE)\n          harvested.add(target)\n          gathered += 1\n\n          # Update occupancy mask: cell becomes empty after pickup.\n          occupied[target] = False\n\n  # ----------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow.\n  # ----------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (string name or integer).\n      workshop_idx = (\n          cookbook.index[workshop_key]\n          if isinstance(workshop_key, str) else workshop_key\n      )\n      workshop_cells = [\n          tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)\n      ]\n      if workshop_cells:\n          # Move to the nearest workshop.\n          workshop_cells.sort(\n              key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1])\n          )\n          ws_target = workshop_cells[0]\n          path = _bfs_adjacent(pos, [ws_target], occupied)\n          actions.extend(path)\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(USE)  # craft at workshop\n      else:\n          # No visible workshop \u2013 use current cell.\n          actions.append(USE)\n  else:\n      # No specific workshop required.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T23:03:08.978096", "function_name": "make_arrow", "function_body": "", "env_interactions": 0, "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-10-28T23:03:10.178999", "function_name": "make_arrow", "function_body": "  # Initialise environment and obtain current state/world\n  env.reset()\n  state = env._current_state          # CraftState instance\n  world = env.world                    # CraftWorld instance\n  grid = state.grid.copy()             # mutable copy for planning\n\n  # Action identifiers (as defined in CraftLab.action_specs)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # --------------------------------------------------------------\n  # Helper utilities\n  # --------------------------------------------------------------\n  non_grab = list(world.non_grabbable_indices)\n\n  def is_blocked(pos):\n      \"\"\"Return True if a non\u2011grabbable entity occupies ``pos``.\"\"\"\n      y, x = pos\n      return np.any(grid[y, x, non_grab] > 0)\n\n  def heuristic(a, b):\n      \"\"\"Manhattan distance \u2013 admissible heuristic for A*.\"\"\"\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal):\n      \"\"\"Return a list of positions from start to goal (inclusive).\"\"\"\n      if start == goal:\n          return [start]\n      h, w = grid.shape[:2]\n      open_set = {start}\n      came_from = {}\n      g_score = {start: 0}\n      f_score = {start: heuristic(start, goal)}\n      while open_set:\n          current = min(open_set, key=lambda p: f_score.get(p, np.inf))\n          if current == goal:\n              # reconstruct path\n              path = [current]\n              while current in came_from:\n                  current = came_from[current]\n                  path.append(current)\n              path.reverse()\n              return path\n          open_set.remove(current)\n          y, x = current\n          for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):\n              if 0 <= ny < h and 0 <= nx < w:\n                  neighbor = (ny, nx)\n                  if is_blocked(neighbor):\n                      continue\n                  tentative_g = g_score[current] + 1\n                  if tentative_g < g_score.get(neighbor, np.inf):\n                      came_from[neighbor] = current\n                      g_score[neighbor] = tentative_g\n                      f_score[neighbor] = tentative_g + heuristic(neighbor, goal)\n                      open_set.add(neighbor)\n      # unreachable\n      return []\n\n  def path_to_actions(path):\n      \"\"\"Translate a list of positions into movement actions.\"\"\"\n      acts = []\n      for (y1, x1), (y2, x2) in zip(path, path[1:]):\n          if y2 == y1 + 1:\n              acts.append(DOWN)\n          elif y2 == y1 - 1:\n              acts.append(UP)\n          elif x2 == x1 + 1:\n              acts.append(RIGHT)\n          elif x2 == x1 - 1:\n              acts.append(LEFT)\n      return acts\n\n  def nearest_cell(kind, from_pos):\n      \"\"\"Find the closest cell containing ``kind`` (Manhattan distance).\"\"\"\n      locs = np.argwhere(grid[:, :, kind] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      return tuple(locs[dists.argmin()])\n\n  def free_adjacent(target):\n      \"\"\"Return a walkable neighbour of ``target`` (N, S, W, E order).\"\"\"\n      y, x = target\n      for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not is_blocked((ny, nx)):\n                  return (ny, nx)\n      return target  # fallback (may be blocked)\n\n  # --------------------------------------------------------------\n  # Build the action sequence\n  # --------------------------------------------------------------\n  actions = []\n  cur_pos = tuple(state.pos)   # current (y, x)\n\n  # Goal item and its primitive requirements\n  goal_idx = world.cookbook.index.index('arrow')\n  required = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # Collect each required primitive the needed number of times\n  for prim_idx, cnt in required.items():\n      for _ in range(cnt):\n          prim_loc = nearest_cell(prim_idx, cur_pos)\n          if prim_loc is None:\n              # Primitive not present \u2013 abort early\n              return actions\n\n          # Move to a free cell adjacent to the primitive\n          stand_pos = free_adjacent(prim_loc)\n          path = a_star(cur_pos, stand_pos)\n          if not path:\n              return actions\n          actions.extend(path_to_actions(path))\n          cur_pos = stand_pos\n\n          # Move onto the primitive cell itself\n          path = a_star(cur_pos, prim_loc)\n          if not path:\n              return actions\n          actions.extend(path_to_actions(path))\n          cur_pos = prim_loc\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update planning grid \u2013 primitive has been collected\n          grid[prim_loc[0], prim_loc[1], prim_idx] = 0\n\n  # If the recipe specifies a workshop, travel there before crafting\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      ws_idx = world.cookbook.index.index(workshop_name)\n      ws_loc = nearest_cell(ws_idx, cur_pos)\n      if ws_loc is not None:\n          path = a_star(cur_pos, ws_loc)\n          if path:\n              actions.extend(path_to_actions(path))\n              cur_pos = ws_loc\n\n  # Final USE to craft the arrow\n  actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T23:03:37.276725", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_key(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_key(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_PLAN_LENGTH = 500\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      if len(node.actions) >= MAX_PLAN_LENGTH:\n          continue\n\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key not in visited:\n              visited.add(key)\n              frontier.append(Node(next_state, node.actions + [a]))\n\n  return []", "env_interactions": 20, "island_id": 1, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:03:52.931695", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", None) or env\n  world = getattr(scenario, \"world\", None) or getattr(env, \"world\", None)\n  if world is None:\n      return []\n\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_key(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_key(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_PLAN_LENGTH = 500\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      if len(node.actions) >= MAX_PLAN_LENGTH:\n          continue\n\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key not in visited:\n              visited.add(key)\n              frontier.append(Node(next_state, node.actions + [a]))\n\n  return []", "env_interactions": 20, "island_id": 1, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:04:12.567049", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  # index of the target item \"arrow\"\n  target_idx = cookbook.index[\"arrow\"]\n\n  # local mutable copies of environment state\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n  width, height, _ = grid.shape\n  actions: list[int] = []\n\n  from collections import deque\n\n  def bfs(start: tuple[int, int], goals: set[tuple[int, int]]) -> list[int] | None:\n      \"\"\"Return a shortest sequence of movement actions from *start* to any cell in *goals*.\"\"\"\n      q = deque([(start, [])])\n      visited = {start}\n      while q:\n          cur, path = q.popleft()\n          if cur in goals:\n              return path\n          x, y = cur\n          for dx, dy, act in [(0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)]:  # DOWN,UP,LEFT,RIGHT\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              nxt = (nx, ny)\n              if nxt in visited:\n                  continue\n              # Allow stepping onto a goal cell even if it is occupied\n              if np.any(grid[nx, ny, :]) and nxt not in goals:\n                  continue\n              visited.add(nxt)\n              q.append((nxt, path + [act]))\n      return None\n\n  def move_along(path: list[int]) -> None:\n      \"\"\"Update *pos* while following *path*.\"\"\"\n      nonlocal pos\n      for a in path:\n          if a == 0:   # DOWN\n              pos = (pos[0], pos[1] + 1)\n          elif a == 1: # UP\n              pos = (pos[0], pos[1] - 1)\n          elif a == 2: # LEFT\n              pos = (pos[0] - 1, pos[1])\n          elif a == 3: # RIGHT\n              pos = (pos[0] + 1, pos[1])\n\n  # ----------------------------------------------------------------------\n  # Primitive collection\n  def collect_primitive(kind_idx: int, amount: int) -> None:\n      \"\"\"Collect *amount* of primitive *kind_idx* from the grid.\"\"\"\n      nonlocal actions, grid, inventory, pos\n      while amount > 0:\n          # locate all cells still containing the primitive\n          cells = [(x, y) for x in range(width) for y in range(height) if grid[x, y, kind_idx] > 0]\n          if not cells:\n              break  # should not happen for solvable tasks\n          # find a reachable primitive (first reachable is fine)\n          chosen_path = None\n          chosen_cell = None\n          for cell in cells:\n              p = bfs(pos, {cell})\n              if p is not None:\n                  chosen_path, chosen_cell = p, cell\n                  break\n          if chosen_path is None:\n              break  # cannot reach any remaining primitive\n          actions.extend(chosen_path)\n          move_along(chosen_path)\n          # pick it up\n          actions.append(4)  # USE\n          grid[chosen_cell[0], chosen_cell[1], kind_idx] = 0\n          inventory[kind_idx] += 1\n          amount -= 1\n\n  # ----------------------------------------------------------------------\n  # Recursive crafting helper\n  recipes = cookbook.recipes\n  primitives = cookbook.primitives\n\n  def ensure_item(item_idx: int, needed: int) -> None:\n      \"\"\"Make sure *inventory[item_idx]* >= *needed* by collecting/crafting as needed.\"\"\"\n      nonlocal actions, grid, inventory, pos\n      while inventory[item_idx] < needed:\n          # Primitive: just collect directly\n          if item_idx in primitives:\n              collect_primitive(item_idx, needed - inventory[item_idx])\n              continue\n\n          # Otherwise craft using its recipe\n          recipe = recipes.get(item_idx, {})\n          # First ensure all ingredients are available\n          for ing_idx, cnt in list(recipe.items()):\n              if ing_idx == \"_at\":\n                  continue\n              if inventory[ing_idx] < cnt:\n                  ensure_item(ing_idx, cnt)\n\n          # Move to required workshop if the recipe specifies one\n          workshop = recipe.get(\"_at\")\n          if workshop is not None:\n              ws_idx = workshop if isinstance(workshop, int) else cookbook.index[workshop]\n              ws_cells = [(x, y) for x in range(width) for y in range(height) if grid[x, y, ws_idx] > 0]\n              if ws_cells:\n                  path = bfs(pos, {ws_cells[0]})\n                  if path:\n                      actions.extend(path)\n                      move_along(path)\n\n          # Perform the crafting action\n          actions.append(4)  # USE\n          # Update simulated inventory\n          for ing_idx, cnt in recipe.items():\n              if ing_idx == \"_at\":\n                  continue\n              inventory[ing_idx] -= cnt\n          inventory[item_idx] += 1\n\n  # ----------------------------------------------------------------------\n  # Build the target arrow\n  ensure_item(target_idx, 1)\n\n  return actions", "env_interactions": 41, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T23:04:13.733180", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  # target item\n  target_name = \"arrow\"\n  target_idx = cookbook.index[target_name]\n\n  # local copies of the environment state\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n  width, height, _ = grid.shape\n  actions = []\n\n  from collections import deque\n\n  def bfs(start, goals):\n      \"\"\"Return a shortest list of actions from start to any cell in *goals*.\"\"\"\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          cur, path = q.popleft()\n          if cur in goals:\n              return path\n          x, y = cur\n          for dx, dy, act in [(0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)]:  # DOWN,UP,LEFT,RIGHT\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              nxt = (nx, ny)\n              if nxt in visited:\n                  continue\n              # allow stepping onto a goal cell even if occupied\n              if np.any(grid[nx, ny, :]) and nxt not in goals:\n                  continue\n              visited.add(nxt)\n              q.append((nxt, path + [act]))\n      return None\n\n  def move_along(path):\n      \"\"\"Update *pos* following a list of actions.\"\"\"\n      nonlocal pos\n      for a in path:\n          if a == 0:   # DOWN\n              pos = (pos[0], pos[1] + 1)\n          elif a == 1: # UP\n              pos = (pos[0], pos[1] - 1)\n          elif a == 2: # LEFT\n              pos = (pos[0] - 1, pos[1])\n          elif a == 3: # RIGHT\n              pos = (pos[0] + 1, pos[1])\n\n  # ----------------------------------------------------------------------\n  # Primitive collection\n  def collect_primitive(prim_idx, amount):\n      \"\"\"Collect *amount* of primitive *prim_idx* from the grid.\"\"\"\n      nonlocal actions, grid, inventory, pos\n      while amount > 0:\n          # locate all cells that still contain the primitive\n          locations = [(x, y) for x in range(width) for y in range(height)\n                       if grid[x, y, prim_idx] > 0]\n          if not locations:\n              break  # nothing left on the map\n          # find the nearest reachable location\n          best_path = None\n          best_loc = None\n          for loc in locations:\n              path = bfs(pos, {loc})\n              if path is not None:\n                  best_path = path\n                  best_loc = loc\n                  break\n          if best_path is None:\n              break  # unreachable\n          actions.extend(best_path)\n          move_along(best_path)\n          # pick up the primitive\n          actions.append(4)  # USE\n          grid[best_loc[0], best_loc[1], prim_idx] = 0\n          inventory[prim_idx] += 1\n          amount -= 1\n\n  # ----------------------------------------------------------------------\n  # Recursive crafting helper\n  recipes = cookbook.recipes\n  primitives_set = cookbook.primitives\n\n  def ensure_item(item_idx, needed):\n      \"\"\"Guarantee that *inventory[item_idx]* >= *needed*.\"\"\"\n      nonlocal actions, grid, inventory, pos\n      while inventory[item_idx] < needed:\n          # Primitives are collected directly\n          if item_idx in primitives_set:\n              collect_primitive(item_idx, needed - inventory[item_idx])\n              continue\n\n          # Otherwise craft using its recipe\n          recipe = recipes.get(item_idx, {})\n          # First make sure all ingredients are present\n          for ing_idx, cnt in list(recipe.items()):\n              if ing_idx == \"_at\":\n                  continue\n              if inventory[ing_idx] < cnt:\n                  ensure_item(ing_idx, cnt)\n\n          # Move to the required workshop, if any\n          workshop = recipe.get(\"_at\")\n          if workshop is not None:\n              ws_idx = workshop if isinstance(workshop, int) else cookbook.index[workshop]\n              ws_cells = [(x, y) for x in range(width) for y in range(height)\n                          if grid[x, y, ws_idx] > 0]\n              if ws_cells:\n                  # pick the closest workshop cell\n                  path = bfs(pos, set(ws_cells))\n                  if path:\n                      actions.extend(path)\n                      move_along(path)\n\n          # Perform the crafting action\n          actions.append(4)   # USE\n          # Update simulated inventory\n          for ing_idx, cnt in recipe.items():\n              if ing_idx == \"_at\":\n                  continue\n              inventory[ing_idx] -= cnt\n          inventory[item_idx] += 1\n\n  # ----------------------------------------------------------------------\n  # Build the arrow\n  ensure_item(target_idx, 1)\n\n  return actions", "env_interactions": 41, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T23:04:52.485991", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world", "env_interactions": 0, "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-10-28T23:04:53.641279", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n\n  # Index of the goal item \"arrow\"\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:\n      return []\n\n  # Mapping from action index to (dx, dy)\n  deltas = {0: (0, 1), 1: (0, -1), 2: (-1, 0), 3: (1, 0)}\n\n  def in_bounds(x, y, W, H):\n      return 0 <= x < W and 0 <= y < H\n\n  def walkable(grid, x, y):\n      \"\"\"A cell is walkable if it is inside the grid and contains no entities.\"\"\"\n      W, H = grid.shape[:2]\n      if not in_bounds(x, y, W, H):\n          return False\n      return not np.any(grid[x, y, :])\n\n  from collections import deque\n\n  def bfs_to_target(cur_state, target_kind):\n      \"\"\"\n      Bread\u2011first search that returns a list of movement actions (0\u20113) which\n      ends with the agent facing a cell that contains `target_kind`.\n      Returns [] if already facing the target, or None if the target cannot\n      be reached.\n      \"\"\"\n      grid = cur_state.grid\n      W, H = grid.shape[:2]\n      sx, sy = cur_state.pos\n      sdir = cur_state.dir\n\n      # Already facing the target?\n      dx, dy = deltas[sdir]\n      fx, fy = sx + dx, sy + dy\n      if in_bounds(fx, fy, W, H) and grid[fx, fy, target_kind] > 0:\n          return []\n\n      q = deque()\n      q.append((sx, sy, sdir, []))\n      visited = {(sx, sy, sdir)}\n\n      while q:\n          x, y, d, actions = q.popleft()\n          dx, dy = deltas[d]\n          fx, fy = x + dx, y + dy\n          if in_bounds(fx, fy, W, H) and grid[fx, fy, target_kind] > 0:\n              return actions\n          for a in (0, 1, 2, 3):\n              ndx, ndy = deltas[a]\n              nx, ny = x + ndx, y + ndy\n              if not walkable(grid, nx, ny):\n                  continue\n              if (nx, ny, a) in visited:\n                  continue\n              visited.add((nx, ny, a))\n              q.append((nx, ny, a, actions + [a]))\n      return None\n\n  plan = []\n\n  # ------------------------------------------------------------------\n  # 1. Collect all primitive resources required for a single arrow.\n  # ------------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(arrow_idx)\n  if not primitive_needs:          # arrow itself is a primitive resource\n      primitive_needs = {arrow_idx: 1}\n\n  for kind_idx, required_cnt in primitive_needs.items():\n      for _ in range(required_cnt):\n          move_seq = bfs_to_target(state, kind_idx)\n          if move_seq is None:    # unreachable primitive \u2013 abort planning\n              return plan\n          plan.extend(move_seq)\n          plan.append(4)           # USE to pick up\n          for a in move_seq + [4]:\n              _, state = state.step(a)\n\n  # ------------------------------------------------------------------\n  # 2. Move to the required workshop (if any) and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      move_seq = bfs_to_target(state, workshop_idx)\n      if move_seq is None:        # unreachable workshop \u2013 abort\n          return plan\n      plan.extend(move_seq)\n      plan.append(4)               # USE to craft\n      for a in move_seq + [4]:\n          _, state = state.step(a)\n  else:\n      # No dedicated workshop \u2013 craft in place.\n      plan.append(4)\n      _, state = state.step(4)\n\n  return plan", "env_interactions": 26, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T23:05:23.484769", "function_name": "make_arrow", "function_body": "  import numpy as np\n  import collections\n\n  # Action indices as defined in CraftWorld.\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  def bfs_path(start, targets, occ):\n      \"\"\"Return a list of actions moving from start to a cell adjacent to any target.\"\"\"\n      w, h = occ.shape\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n      while q:\n          x, y, path = q.popleft()\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n          for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occ[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      return []\n\n  def apply_path(pos, path):\n      \"\"\"Return new position after applying a sequence of actions.\"\"\"\n      x, y = pos\n      for act in path:\n          if act == RIGHT:\n              x += 1\n          elif act == LEFT:\n              x -= 1\n          elif act == DOWN:\n              y += 1\n          elif act == UP:\n              y -= 1\n      return (x, y)\n\n  # ------------------------------------------------------------------\n  # Locate world and cookbook.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      state_wrapper = getattr(env, \"_current_state\", None)\n      if state_wrapper is not None:\n          world = getattr(state_wrapper, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"Cannot locate CraftWorld instance in the environment.\")\n  cookbook = world.cookbook\n\n  # Goal item name.\n  goal_name = \"arrow\"\n  if goal_name not in cookbook.index.contents:\n      raise ValueError(f\"Goal '{goal_name}' not found in cookbook.\")\n  goal_idx = cookbook.index[goal_name]\n\n  # Primitive requirements for the goal.\n  primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Ensure we have a fresh state.\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  pos = tuple(state.pos)\n  grid = state.grid.copy()          # planning copy of the grid\n  occ = np.any(grid > 0, axis=2)    # occupied cells mask\n\n  actions = []\n  harvested = set()                 # locations already collected\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest first).\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      collected = 0\n      while collected < needed:\n          # Find all remaining locations of this primitive.\n          candidates = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)\n                        if tuple(p) not in harvested]\n          if not candidates:\n              # No more of this primitive on the map \u2013 cannot complete.\n              break\n          # Choose the closest candidate.\n          candidates.sort(key=lambda loc: abs(loc[0] - pos[0]) + abs(loc[1] - pos[1]))\n          target = candidates[0]\n\n          # Move adjacent to the target.\n          path = bfs_path(pos, [target], occ)\n          actions.extend(path)\n          pos = apply_path(pos, path)\n\n          # Pick up the primitive.\n          actions.append(USE)\n          # Update planning structures.\n          occ[target[0], target[1]] = False\n          grid[target[0], target[1], prim_idx] = 0\n          harvested.add(target)\n          collected += 1\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index.\n      ws_idx = (cookbook.index[workshop_key]\n                if isinstance(workshop_key, str)\n                else int(workshop_key))\n      # Locate workshop cells.\n      ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, ws_idx] > 0)]\n      if ws_cells:\n          ws_cells.sort(key=lambda loc: abs(loc[0] - pos[0]) + abs(loc[1] - pos[1]))\n          ws_target = ws_cells[0]\n          path = bfs_path(pos, [ws_target], occ)\n          actions.extend(path)\n          pos = apply_path(pos, path)\n          actions.append(USE)   # craft at workshop\n      else:\n          # No workshop found; just attempt to use (may fail but keeps interface simple).\n          actions.append(USE)\n  else:\n      # No workshop required; just use to craft.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T23:05:24.639884", "function_name": "make_arrow", "function_body": "  import collections, numpy as np\n\n  # Action indices as defined in CraftWorld.\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  def bfs_path(start, targets, occ):\n      \"\"\"Return a list of actions moving from start to a cell adjacent to any target.\"\"\"\n      w, h = occ.shape\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n      while q:\n          x, y, path = q.popleft()\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n          for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occ[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      return []\n\n  def apply_action(pos, act):\n      \"\"\"Update position according to an action.\"\"\"\n      x, y = pos\n      if act == RIGHT:\n          return (x + 1, y)\n      if act == LEFT:\n          return (x - 1, y)\n      if act == DOWN:\n          return (x, y + 1)\n      if act == UP:\n          return (x, y - 1)\n      return pos\n\n  # ------------------------------------------------------------------\n  # Locate the world and its cookbook.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      wrapper_state = getattr(env, \"_current_state\", None)\n      if wrapper_state is not None:\n          world = getattr(wrapper_state, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"World object not found in the environment\")\n  cookbook = world.cookbook\n\n  # Goal item (hard\u2011coded to 'arrow')\n  goal_name = \"arrow\"\n  if goal_name not in cookbook.index.contents:\n      raise ValueError(f\"Goal '{goal_name}' not present in the recipe index\")\n  goal_idx = cookbook.index[goal_name]\n\n  # Primitive requirements for the goal.\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Ensure we have a current state; reset if necessary.\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  pos = tuple(state.pos)                # agent position (x, y)\n  grid = state.grid.copy()              # planning copy of the grid\n  occ = np.any(grid > 0, axis=2)       # occupied\u2011cell mask (bool)\n\n  actions = []\n  harvested = set()                     # cells already collected\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (nearest\u2011first greedy).\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      collected = 0\n      while collected < needed:\n          candidates = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)\n                        if tuple(p) not in harvested]\n          if not candidates:\n              break  # no more of this primitive left on the map\n          candidates.sort(key=lambda loc: abs(loc[0] - pos[0]) + abs(loc[1] - pos[1]))\n          target = candidates[0]\n\n          path = bfs_path(pos, [target], occ)\n          actions.extend(path)\n          for act in path:\n              pos = apply_action(pos, act)\n\n          actions.append(USE)                     # pick up the primitive\n          occ[target[0], target[1]] = False\n          grid[target[0], target[1], prim_idx] = 0\n          harvested.add(target)\n          collected += 1\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      ws_idx = (cookbook.index[workshop_key]\n                if isinstance(workshop_key, str)\n                else int(workshop_key))\n      ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, ws_idx] > 0)]\n      if ws_cells:\n          ws_cells.sort(key=lambda loc: abs(loc[0] - pos[0]) + abs(loc[1] - pos[1]))\n          ws_target = ws_cells[0]\n          path = bfs_path(pos, [ws_target], occ)\n          actions.extend(path)\n          for act in path:\n              pos = apply_action(pos, act)\n          actions.append(USE)                     # craft at the workshop\n      else:\n          actions.append(USE)                     # fallback: try crafting anyway\n  else:\n      actions.append(USE)                         # no workshop required\n\n  return actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T23:06:03.868299", "function_name": "make_arrow", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants (same as in the environment)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving the agent from\n  # `start` to a cell adjacent (Manhattan distance \u2264 1) to any cell in\n  # `targets`. Cells that have any non\u2011zero kind are treated as obstacles.\n  # ------------------------------------------------------------------\n  def _bfs_path(start, targets, grid):\n      w, h, _ = grid.shape\n      occupied = np.any(grid > 0, axis=2)          # blocked cells\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # Check adjacency to any target cell\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) <= 1:\n                  return path\n          # Explore neighbours\n          for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # No reachable position (should not happen in well\u2011formed scenarios)\n      return []\n\n  # ------------------------------------------------------------------\n  # Locate the CraftWorld and its Cookbook inside the environment.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Some wrappers expose the world via the current state.\n      state_wrapper = getattr(env, \"_current_state\", None)\n      if state_wrapper is not None:\n          world = getattr(state_wrapper, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"CraftWorld instance not found in the environment.\")\n  cookbook = world.cookbook\n\n  # ------------------------------------------------------------------\n  # Ensure we have a current state (reset if necessary).\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  # ------------------------------------------------------------------\n  # Goal is the item named \"arrow\".\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # Primitive requirements for one arrow.\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Planning variables.\n  # ------------------------------------------------------------------\n  pos = tuple(state.pos)          # (x, y)\n  cur_grid = state.grid.copy()    # mutable copy for planning\n  actions = []                    # final action sequence\n  harvested = set()               # cells already collected from\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive.\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      # All cells currently containing this primitive.\n      locs = [tuple(p) for p in np.argwhere(cur_grid[:, :, prim_idx] > 0)]\n      # Greedy order by distance from current position.\n      locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      gathered = 0\n      for loc in locs:\n          if gathered >= needed:\n              break\n          if loc in harvested:\n              continue\n          # Move adjacent to the primitive.\n          path = _bfs_path(pos, [loc], cur_grid)\n          actions.extend(path)\n          # Update simulated position.\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Pick it up.\n          actions.append(USE)\n          # Remove the primitive from the planning grid.\n          cur_grid[loc[0], loc[1], prim_idx] = 0\n          harvested.add(loc)\n          gathered += 1\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (string name or already int).\n      ws_idx = (cookbook.index[workshop_key]\n                if isinstance(workshop_key, str) else workshop_key)\n      # Locate workshop cells.\n      ws_cells = [tuple(p) for p in np.argwhere(cur_grid[:, :, ws_idx] > 0)]\n      if ws_cells:\n          ws_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = ws_cells[0]\n          # Move adjacent to the workshop.\n          path = _bfs_path(pos, [target_ws], cur_grid)\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Use the workshop to craft the arrow.\n          actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T23:06:05.007914", "function_name": "make_arrow", "function_body": "", "env_interactions": 0, "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-10-28T23:06:34.872276", "function_name": "make_arrow", "function_body": "  # Resolve scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Find the index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initialise the starting state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  # Simple BFS over (state, action_sequence) pairs\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = set()\n  frontier = deque([Node(init_state, [])])\n  visited.add(_state_hash(init_state))\n\n  # Safety limits\n  MAX_STEPS = 3000\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  # Prefer the USE action (typically index 4) before movement actions\n  use_idx = 4 if n_actions > 4 else None\n  if use_idx is not None:\n      action_order = [use_idx] + [i for i in range(n_actions) if i != use_idx]\n  else:\n      action_order = list(range(n_actions))\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long trajectories\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand successors\n      for a in action_order:\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within the search budget\n  return []", "env_interactions": 20, "island_id": 2, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:06:53.090671", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # make_arrow_vn \u2013 BFS planner that uses the recipe to focus on needed items\n  # ----------------------------------------------------------------------\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # index of the goal item \u201carrow\u201d\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # starting state\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      \"\"\"Hashable representation of a CraftState for visited\u2011set checks.\"\"\"\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  # primitives (and counts) required to craft one arrow\n  needed_prims = set(world.cookbook.primitives_for(target_idx).keys())\n\n  visited = set()\n  frontier = deque([Node(init_state, [])])\n  visited.add(_state_hash(init_state))\n\n  MAX_STEPS = 2000                     # safety cap\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur = node.state\n\n      # Goal test\n      if cur.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long trajectories\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # ------------------------------------------------------------------\n      # Action ordering \u2013 try USE first if a needed primitive or a\n      # relevant workshop is adjacent, otherwise explore movement actions.\n      # ------------------------------------------------------------------\n      actions = []\n      # check adjacency for any needed primitive or any workshop (any recipe)\n      for kind in needed_prims:\n          if cur.next_to(kind):\n              actions.append(world.n_actions - 1 if n_actions > 4 else 4)  # USE\n              break\n      # also try USE when next to any workshop (any recipe output)\n      if not actions:\n          for out_idx in world.cookbook.recipes:\n              if cur.next_to(out_idx):\n                  actions.append(world.n_actions - 1 if n_actions > 4 else 4)\n                  break\n\n      # if no immediate USE, just add it as a later option\n      if world.n_actions > 4 and 4 not in actions:\n          actions.append(4)   # USE\n\n      # add movement actions (order: DOWN, UP, LEFT, RIGHT if present)\n      for a in range(n_actions):\n          if a != 4:          # exclude USE (already added)\n              actions.append(a)\n\n      # expand successors\n      for a in actions:\n          _, nxt = cur.step(a)\n          h = _state_hash(nxt)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt, node.actions + [a]))\n\n  # No plan found within limits\n  return []", "env_interactions": 20, "island_id": 2, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:07:10.799816", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  try:\n      start_state = scenario.init()\n  except Exception:\n      return []\n\n  # Primitive requirements for a single arrow\n  required = world.cookbook.primitives_for(target_idx)\n\n  import heapq\n\n  def state_key(st):\n      \"\"\"Hashable representation of a state for visited checking.\"\"\"\n      return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())\n\n  def heuristic(st):\n      \"\"\"Estimate of remaining steps: missing primitives + one craft action.\"\"\"\n      if st.satisfies(\"\", target_idx):\n          return 0\n      miss = 0\n      inv = st.inventory\n      for kind, cnt in required.items():\n          have = inv[kind] if kind < len(inv) else 0\n          if have < cnt:\n              miss += cnt - have\n      # at least one USE action needed to craft\n      return miss + 1\n\n  start_key = state_key(start_state)\n  visited = {start_key: 0}\n  frontier = [(heuristic(start_state), 0, start_state, [])]  # (f, g, state, actions)\n\n  n_actions = getattr(world, \"n_actions\", 5)\n  MAX_STEPS = 800\n\n  while frontier:\n      f, g, cur_state, cur_actions = heapq.heappop(frontier)\n\n      if cur_state.satisfies(\"\", target_idx):\n          return cur_actions\n\n      if g >= MAX_STEPS:\n          continue\n\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          key = state_key(nxt_state)\n          ng = g + 1\n          if key not in visited or ng < visited[key]:\n              visited[key] = ng\n              nf = ng + heuristic(nxt_state)\n              heapq.heappush(frontier, (nf, ng, nxt_state, cur_actions + [a]))\n\n  # No plan found within limits\n  return []", "env_interactions": 0, "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-10-28T23:07:26.514986", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  try:\n      start_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_key(st):\n      # Compact hash of a state for visitation checking\n      return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())\n\n  frontier = deque([Node(start_state, [])])\n  visited = {_state_key(start_state)}\n  MAX_PLAN_LEN = 600                     # safety bound on plan length\n  n_actions = getattr(world, \"n_actions\", 5)   # typically 5 (4 moves + USE)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state, cur_actions = node.state, node.actions\n\n      # Goal test: have an arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return cur_actions\n\n      if len(cur_actions) >= MAX_PLAN_LEN:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          key = _state_key(nxt_state)\n          if key not in visited:\n              visited.add(key)\n              frontier.append(Node(nxt_state, cur_actions + [a]))\n\n  # No plan found within the allowed budget\n  return []", "env_interactions": 20, "island_id": 1, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:07:52.368518", "function_name": "make_arrow", "function_body": "  # Reset environment and get current state/world\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()             # mutable copy for internal planning\n\n  # Action indices (use the environment's specifications)\n  specs = env.action_specs()\n  DOWN = specs[\"DOWN\"]\n  UP = specs[\"UP\"]\n  LEFT = specs[\"LEFT\"]\n  RIGHT = specs[\"RIGHT\"]\n  USE = specs[\"USE\"]\n  DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  H, W = grid.shape[:2]\n\n  def in_bounds(y, x):\n      return 0 <= y < H and 0 <= x < W\n\n  def blocked(y, x):\n      \"\"\"A cell is blocked if any entity occupies it.\"\"\"\n      return np.any(grid[y, x, :])\n\n  def bfs_path(start, goal):\n      \"\"\"Return a shortest list of movement actions from start to goal avoiding blocked cells.\"\"\"\n      if start == goal:\n          return []\n      from collections import deque\n      q = deque([start])\n      visited = np.full((H, W), False, dtype=bool)\n      visited[start] = True\n      parent = {}\n      while q:\n          y, x = q.popleft()\n          if (y, x) == goal:\n              # reconstruct actions\n              rev = []\n              cur = goal\n              while cur != start:\n                  py, px = parent[cur]\n                  if cur[0] == py + 1:\n                      rev.append(DOWN)\n                  elif cur[0] == py - 1:\n                      rev.append(UP)\n                  elif cur[1] == px + 1:\n                      rev.append(RIGHT)\n                  elif cur[1] == px - 1:\n                      rev.append(LEFT)\n                  cur = (py, px)\n              return list(reversed(rev))\n          for dy, dx, act in DIRS:\n              ny, nx = y + dy, x + dx\n              if not in_bounds(ny, nx):\n                  continue\n              if visited[ny, nx]:\n                  continue\n              if blocked(ny, nx):\n                  continue\n              visited[ny, nx] = True\n              parent[(ny, nx)] = (y, x)\n              q.append((ny, nx))\n      # No path found\n      return []\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Locate the nearest cell that contains the given kind index.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[dists.argmin()]\n      return tuple(nearest)\n\n  def free_adjacent(cell, forbidden=set()):\n      \"\"\"Return a free neighbour of `cell` not in `forbidden`; None if none exists.\"\"\"\n      y, x = cell\n      for dy, dx, _ in DIRS:\n          ny, nx = y + dy, x + dx\n          if not in_bounds(ny, nx):\n              continue\n          if (ny, nx) in forbidden:\n              continue\n          if not blocked(ny, nx):\n              return (ny, nx)\n      return None\n\n  def face_action(src, dst):\n      \"\"\"Return a single movement action that makes the agent face dst from src.\"\"\"\n      dy, dx = dst[0] - src[0], dst[1] - src[1]\n      if dy == 1:\n          return DOWN\n      if dy == -1:\n          return UP\n      if dx == 1:\n          return RIGHT\n      if dx == -1:\n          return LEFT\n      return None\n\n  # ------------------------------------------------------------------\n  # Determine the goal (arrow) and its recipe\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  needed = world.cookbook.primitives_for(arrow_idx)   # dict {prim_idx: count}\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  workshop_idx = world.cookbook.index.index(workshop_name) if workshop_name else None\n\n  actions = []\n  cur_pos = state.pos               # (y, x)\n  taken_cells = set()               # cells from which primitives have been collected\n\n  # ------------------------------------------------------------------\n  # Collect all required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive missing \u2013 abort early\n              return actions\n\n          # Choose a free adjacent cell to stand on while picking up\n          stand = free_adjacent(target, forbidden=taken_cells)\n          if stand is None:\n              # No free neighbour; fallback to standing on the primitive cell itself\n              stand = target\n\n          # Move to the chosen standing cell\n          actions += bfs_path(cur_pos, stand)\n          cur_pos = stand\n\n          # Face the primitive (optional blocked move)\n          fa = face_action(cur_pos, target)\n          if fa is not None:\n              actions.append(fa)\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update internal grid model and mark cell as taken\n          grid[target[0], target[1], prim_idx] = 0\n          taken_cells.add(target)\n\n  # ------------------------------------------------------------------\n  # Move to the workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          ws_adj = free_adjacent(ws_cell, forbidden=taken_cells)\n          if ws_adj is None:\n              ws_adj = cur_pos\n          actions += bfs_path(cur_pos, ws_adj)\n          cur_pos = ws_adj\n\n          # Face the workshop before using\n          fa = face_action(cur_pos, ws_cell)\n          if fa is not None:\n              actions.append(fa)\n\n  # Final USE triggers crafting (or does nothing if no workshop needed)\n  actions.append(USE)\n\n  return actions", "env_interactions": 37, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T23:07:53.546961", "function_name": "make_arrow", "function_body": "  # Reset environment and extract current state information\n  env.reset()\n  state = env._current_state          # CraftState instance\n  world = env.world                    # CraftWorld instance\n  grid = state.grid.copy()             # mutable copy for planning\n\n  # Action indices from the environment specification\n  specs = env.action_specs()\n  DOWN = specs[\"DOWN\"]\n  UP = specs[\"UP\"]\n  LEFT = specs[\"LEFT\"]\n  RIGHT = specs[\"RIGHT\"]\n  USE = specs[\"USE\"]\n\n  # Direction helpers\n  DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]\n\n  # ------------------------------------------------------------------\n  # Helper functions\n  # ------------------------------------------------------------------\n  H, W = grid.shape[:2]\n\n  def in_bounds(y, x):\n      return 0 <= y < H and 0 <= x < W\n\n  def is_blocked(y, x):\n      \"\"\"A cell is blocked if any kind occupies it.\"\"\"\n      return np.any(grid[y, x, :])\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of movement actions from start to goal avoiding blocked cells.\"\"\"\n      if start == goal:\n          return []\n      from collections import deque\n      q = deque([start])\n      visited = np.full((H, W), False, dtype=bool)\n      visited[start] = True\n      parent = {}\n      while q:\n          y, x = q.popleft()\n          if (y, x) == goal:\n              # reconstruct action list\n              rev = []\n              cur = goal\n              while cur != start:\n                  py, px = parent[cur]\n                  if cur[0] == py + 1:\n                      rev.append(DOWN)\n                  elif cur[0] == py - 1:\n                      rev.append(UP)\n                  elif cur[1] == px + 1:\n                      rev.append(RIGHT)\n                  elif cur[1] == px - 1:\n                      rev.append(LEFT)\n                  cur = (py, px)\n              return list(reversed(rev))\n          for dy, dx, act in DIRS:\n              ny, nx = y + dy, x + dx\n              if not in_bounds(ny, nx):\n                  continue\n              if visited[ny, nx]:\n                  continue\n              if is_blocked(ny, nx):\n                  continue\n              visited[ny, nx] = True\n              parent[(ny, nx)] = (y, x)\n              q.append((ny, nx))\n      # No path found\n      return []\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Locate the closest cell containing the given kind index.\"\"\"\n      locs = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      nearest = locs[dists.argmin()]\n      return tuple(nearest)\n\n  def adjacent_free(cell, avoid=set()):\n      \"\"\"Return a free neighbour of `cell` not in `avoid`; None if none exist.\"\"\"\n      y, x = cell\n      for dy, dx, _ in DIRS:\n          ny, nx = y + dy, x + dx\n          if not in_bounds(ny, nx):\n              continue\n          if (ny, nx) in avoid:\n              continue\n          if not is_blocked(ny, nx):\n              return (ny, nx)\n      return None\n\n  def face_action(src, dst):\n      \"\"\"Return a single action that makes the agent face dst from src.\"\"\"\n      dy, dx = dst[0] - src[0], dst[1] - src[1]\n      if dy == 1:\n          return DOWN\n      if dy == -1:\n          return UP\n      if dx == 1:\n          return RIGHT\n      if dx == -1:\n          return LEFT\n      return None\n\n  # ------------------------------------------------------------------\n  # Determine goal (arrow) and its recipe\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  needed = world.cookbook.primitives_for(arrow_idx)          # {prim_idx: count}\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  workshop_idx = world.cookbook.index.index(workshop_name) if workshop_name else None\n\n  actions = []\n  cur_pos = state.pos            # (y, x)\n  taken_cells = set()            # primitives already collected\n\n  # ------------------------------------------------------------------\n  # Collect all required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Missing primitive; abort early\n              return actions\n\n          stand = adjacent_free(target, avoid=taken_cells)\n          if stand is None:\n              # No free neighbour; stand on the primitive cell itself\n              stand = target\n\n          # Move to standing position\n          actions += bfs_path(cur_pos, stand)\n          cur_pos = stand\n\n          # Face the primitive (optional blocked move) then pick up\n          fa = face_action(cur_pos, target)\n          if fa is not None:\n              actions.append(fa)\n          actions.append(USE)\n\n          # Update internal grid model and mark cell as taken\n          grid[target[0], target[1], prim_idx] = 0\n          taken_cells.add(target)\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          ws_adj = adjacent_free(ws_cell, avoid=taken_cells)\n          if ws_adj is None:\n              ws_adj = ws_cell\n          actions += bfs_path(cur_pos, ws_adj)\n          cur_pos = ws_adj\n\n          # Face the workshop before using\n          fa = face_action(cur_pos, ws_cell)\n          if fa is not None:\n              actions.append(fa)\n\n  # Final USE triggers crafting (or does nothing if no workshop needed)\n  actions.append(USE)\n\n  return actions", "env_interactions": 37, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T23:08:29.826705", "function_name": "make_arrow", "function_body": "  # reset environment and get handles\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = np.copy(state.grid)          # mutable copy of the grid\n\n  # action constants (as defined in CraftWorld)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def is_blocked(pos):\n      \"\"\"Return True if any entity occupies the cell at `pos`.\"\"\"\n      y, x = pos\n      return np.any(grid[y, x, :] > 0)\n\n  def bfs_path(start, goal):\n      \"\"\"Shortest path from start to goal avoiding blocked cells.\n      Returns a list of positions (including start and goal) or None.\"\"\"\n      if start == goal:\n          return [start]\n      H, W = grid.shape[:2]\n      visited = np.full((H, W), False, dtype=bool)\n      prev = {}\n      q = collections.deque([start])\n      visited[start] = True\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          y, x = cur\n          for dy, dx in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < H and 0 <= nx < W and not visited[ny, nx] and not is_blocked((ny, nx)):\n                  visited[ny, nx] = True\n                  prev[(ny, nx)] = cur\n                  q.append((ny, nx))\n      else:\n          return None  # unreachable\n\n      # reconstruct path\n      path = [goal]\n      while path[-1] != start:\n          path.append(prev[path[-1]])\n      path.reverse()\n      return path\n\n  def path_to_actions(path):\n      \"\"\"Convert a list of positions to a list of movement actions.\"\"\"\n      acts = []\n      for (y0, x0), (y1, x1) in zip(path, path[1:]):\n          if y1 == y0 + 1:\n              acts.append(DOWN)\n          elif y1 == y0 - 1:\n              acts.append(UP)\n          elif x1 == x0 + 1:\n              acts.append(RIGHT)\n          elif x1 == x0 - 1:\n              acts.append(LEFT)\n      return acts\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Find the nearest cell that currently contains `kind_idx`.\"\"\"\n      locs = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      nearest = locs[np.argmin(dists)]\n      return tuple(nearest)\n\n  def free_adjacent(cell):\n      \"\"\"Return a free orthogonal neighbour of `cell` (or None).\"\"\"\n      y, x = cell\n      for ny, nx in [(y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)]:\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1] and not is_blocked((ny, nx)):\n              return (ny, nx)\n      return None\n\n  def face_towards(src, dst):\n      \"\"\"Return a single movement action that makes `src` face `dst`.\"\"\"\n      sy, sx = src\n      dy, dx = dst[0] - sy, dst[1] - sx\n      if dy == 1:\n          return DOWN\n      if dy == -1:\n          return UP\n      if dx == 1:\n          return RIGHT\n      if dx == -1:\n          return LEFT\n      return None\n\n  # ------------------------------------------------------------------\n  # Determine goal index and required primitives\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = world.cookbook.index.index(goal_name)\n  needed = world.cookbook.primitives_for(goal_idx)   # {primitive_idx: count}\n\n  actions = []\n  cur_pos = state.pos\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the necessary number of times\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive not present \u2013 abort early\n              return actions\n\n          stand = free_adjacent(target) or target\n          path = bfs_path(cur_pos, stand)\n          if path is None:\n              return actions\n          actions += path_to_actions(path)\n          cur_pos = stand\n\n          turn = face_towards(cur_pos, target)\n          if turn is not None:\n              actions.append(turn)\n\n          actions.append(USE)   # pick up the primitive\n\n          # update internal grid copy\n          grid[target[0], target[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Move to the workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      ws_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(ws_idx, cur_pos)\n      if ws_cell is not None:\n          path = bfs_path(cur_pos, ws_cell)\n          if path is not None:\n              actions += path_to_actions(path)\n              cur_pos = ws_cell\n\n  # final USE triggers crafting\n  actions.append(USE)\n\n  return actions", "env_interactions": 29, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T23:08:30.980926", "function_name": "make_arrow", "function_body": "  # Reset environment and fetch current state/world\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = np.copy(state.grid)           # (WIDTH, HEIGHT, n_kinds)\n\n  # Action constants (as defined in CraftWorld)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def is_walkable(pos):\n      \"\"\"Return True if the agent can occupy `pos` (i.e., not blocked by any\n      non\u2011workshop entity).\"\"\"\n      y, x = pos\n      # Any kind present at the cell?\n      present = np.where(grid[y, x, :] > 0)[0]\n      if present.size == 0:\n          return True\n      # If every present kind is a workshop, the cell is walkable.\n      for k in present:\n          if k not in world.workshop_indices:\n              return False\n      return True\n\n  def bfs_path(start, goal):\n      \"\"\"Breadth\u2011first search returning a list of positions from `start`\n      to `goal` (inclusive). Returns None if no path exists.\"\"\"\n      if start == goal:\n          return [start]\n      H, W = grid.shape[:2]\n      visited = np.full((H, W), False, dtype=bool)\n      prev = {}\n      q = collections.deque()\n      q.append(start)\n      visited[start] = True\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          y, x = cur\n          for dy, dx in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < H and 0 <= nx < W and not visited[ny, nx]:\n                  if is_walkable((ny, nx)):\n                      visited[ny, nx] = True\n                      prev[(ny, nx)] = cur\n                      q.append((ny, nx))\n      else:\n          return None  # goal not reached\n\n      # reconstruct path\n      path = [goal]\n      while path[-1] != start:\n          path.append(prev[path[-1]])\n      path.reverse()\n      return path\n\n  def path_to_actions(path):\n      \"\"\"Convert a list of positions (including start) to a list of action\n      indices that move the agent along the path.\"\"\"\n      acts = []\n      for (y0, x0), (y1, x1) in zip(path, path[1:]):\n          if y1 == y0 + 1:\n              acts.append(DOWN)\n          elif y1 == y0 - 1:\n              acts.append(UP)\n          elif x1 == x0 + 1:\n              acts.append(RIGHT)\n          elif x1 == x0 - 1:\n              acts.append(LEFT)\n      return acts\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Return coordinates of the nearest cell containing `kind_idx`.\"\"\"\n      locs = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      nearest = locs[np.argmin(dists)]\n      return tuple(nearest)\n\n  def free_adjacent(cell):\n      \"\"\"Return a walkable orthogonal neighbour of `cell`. If none exists,\n      return None.\"\"\"\n      y, x = cell\n      for ny, nx in [(y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)]:\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if is_walkable((ny, nx)):\n                  return (ny, nx)\n      return None\n\n  def direction_to(src, dst):\n      \"\"\"Return the action that makes the agent at `src` face `dst`\n      (one step away).\"\"\"\n      sy, sx = src\n      dy, dx = dst[0] - sy, dst[1] - sx\n      if dy == 1:\n          return DOWN\n      if dy == -1:\n          return UP\n      if dx == 1:\n          return RIGHT\n      if dx == -1:\n          return LEFT\n      return None\n\n  # ------------------------------------------------------------------\n  # Determine goal index and required primitives\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = world.cookbook.index.index(goal_name)\n  needed = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  actions = []\n  cur_pos = state.pos\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the needed number of times\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive missing \u2013 abort early.\n              return actions\n\n          # Choose a free adjacent cell to stand on.\n          stand = free_adjacent(target)\n          if stand is None:\n              # No free neighbour; cannot pick up this primitive.\n              return actions\n\n          # Move to the standing cell.\n          path = bfs_path(cur_pos, stand)\n          if path is None:\n              return actions\n          actions += path_to_actions(path)\n          cur_pos = stand\n\n          # Face the primitive and pick it up.\n          turn = direction_to(cur_pos, target)\n          if turn is not None:\n              actions.append(turn)\n          actions.append(USE)\n\n          # Update internal grid copy to reflect collection.\n          grid[target[0], target[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      ws_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(ws_idx, cur_pos)\n      if ws_cell is not None:\n          path = bfs_path(cur_pos, ws_cell)\n          if path is not None:\n              actions += path_to_actions(path)\n              cur_pos = ws_cell\n\n  # Final USE to trigger crafting\n  actions.append(USE)\n\n  return actions", "env_interactions": 29, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T23:08:48.336272", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Retrieve world and target index\n  # ----------------------------------------------------------------------\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # ----------------------------------------------------------------------\n  # Initial state\n  # ----------------------------------------------------------------------\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  # ----------------------------------------------------------------------\n  # Helper utilities\n  # ----------------------------------------------------------------------\n  from collections import namedtuple\n  import heapq\n\n  Node = namedtuple(\"Node\", [\"f\", \"g\", \"state\", \"actions\"])\n\n  def _state_hash(st):\n      \"\"\"Hashable representation of a CraftState.\"\"\"\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  def _heuristic(st):\n      \"\"\"\n      Simple admissible heuristic: total missing count of primitive\n      resources that are directly required for the target item.\n      \"\"\"\n      need = world.cookbook.primitives_for(target_idx)\n      missing = 0\n      for p_idx, cnt in need.items():\n          have = int(st.inventory[p_idx])\n          if have < cnt:\n              missing += cnt - have\n      return missing\n\n  # ----------------------------------------------------------------------\n  # Search (A* style)\n  # ----------------------------------------------------------------------\n  visited = {_state_hash(init_state)}\n  start_node = Node(f=_heuristic(init_state), g=0, state=init_state, actions=[])\n  frontier = [start_node]                     # heap queue\n\n  MAX_EXPANSIONS = 8000                       # safety bound\n  expansions = 0\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = heapq.heappop(frontier)\n      cur_state = node.state\n      expansions += 1\n      if expansions > MAX_EXPANSIONS:\n          break\n\n      # Goal test\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Expand possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          hsh = _state_hash(nxt_state)\n          if hsh in visited:\n              continue\n          visited.add(hsh)\n\n          g2 = node.g + 1\n          f2 = g2 + _heuristic(nxt_state)\n          heapq.heappush(frontier, Node(f=f2, g=g2, state=nxt_state,\n                                       actions=node.actions + [a]))\n\n  # If we exit the loop without a plan, return an empty list.\n  return []", "env_interactions": 0, "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-10-28T23:09:04.231009", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Retrieve the world and target item index\n  # ----------------------------------------------------------------------\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # ----------------------------------------------------------------------\n  # Get the initial state of the episode\n  # ----------------------------------------------------------------------\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  # ----------------------------------------------------------------------\n  # Helper: hash a CraftState for fast visited\u2011set lookup\n  # ----------------------------------------------------------------------\n  def _state_hash(st):\n      # Position, direction, inventory (as a tuple) and the whole grid\n      # (converted to bytes for immutability)\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  # ----------------------------------------------------------------------\n  # BFS over the state space\n  # ----------------------------------------------------------------------\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  visited = set()\n  visited.add(_state_hash(init_state))\n\n  frontier = deque([Node(init_state, [])])\n\n  # Limit search depth to keep computation tractable\n  MAX_STEPS = 2000\n\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  # Prefer the USE action (index 4) before movement actions.\n  if n_actions > 4:\n      action_order = [4, 0, 1, 2, 3]\n  else:\n      action_order = list(range(n_actions))\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long trajectories\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand neighbours\n      for a in action_order:\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within the step limit\n  return []", "env_interactions": 20, "island_id": 2, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:09:34.678069", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action identifiers \u2013 must match the ordering used in CraftWorld.\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  MOVE_DELTAS = {DOWN: (0, 1), UP: (0, -1), LEFT: (-1, 0), RIGHT: (1, 0)}\n\n  def _bfs_adjacent(start, targets, occupied):\n      \"\"\"\n      Return a list of actions that moves from ``start`` to a cell\n      adjacent (Manhattan distance = 1) to any cell in ``targets``.\n      Cells where ``occupied`` is True are treated as blocked.\n      \"\"\"\n      w, h = occupied.shape\n      target_set = set(targets)\n\n      # Already adjacent?\n      for tx, ty in target_set:\n          if abs(start[0] - tx) + abs(start[1] - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      while q:\n          x, y, path = q.popleft()\n          for act, (dx, dy) in MOVE_DELTAS.items():\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < w and 0 <= ny < h):\n                  continue\n              if (nx, ny) in visited or occupied[nx, ny]:\n                  continue\n              new_path = path + [act]\n              for tx, ty in target_set:\n                  if abs(nx - tx) + abs(ny - ty) == 1:\n                      return new_path\n              visited.add((nx, ny))\n              q.append((nx, ny, new_path))\n      return []  # unreachable\n\n  # ------------------------------------------------------------------\n  # Retrieve world and current state from the environment.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n      world = state.world\n  else:\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n\n  cookbook = world.cookbook\n  goal_idx = cookbook.index[\"arrow\"]\n\n  # Primitive requirements for a single arrow.\n  primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n  if not primitives_needed:\n      return [USE]  # arrow itself is a primitive\n\n  # Current grid, position and occupancy mask.\n  grid = state.grid                     # (W, H, n_kinds)\n  pos = tuple(state.pos)                # (x, y)\n  occupied = np.any(grid > 0, axis=2)   # True where any entity occupies the cell\n\n  actions = []\n  harvested = set()                     # cells already collected from\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first).\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      gathered = 0\n      while gathered < needed_cnt:\n          candidates = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)\n                        if tuple(p) not in harvested]\n          if not candidates:\n              break  # no more of this primitive available\n          candidates.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          target = candidates[0]\n\n          path = _bfs_adjacent(pos, [target], occupied)\n          actions.extend(path)\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          actions.append(USE)\n          harvested.add(target)\n          gathered += 1\n          occupied[target] = False  # cell becomes empty after pickup\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      workshop_idx = (cookbook.index[workshop_key]\n                      if isinstance(workshop_key, str) else workshop_key)\n      ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if ws_cells:\n          ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          ws_target = ws_cells[0]\n          path = _bfs_adjacent(pos, [ws_target], occupied)\n          actions.extend(path)\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(USE)\n      else:\n          actions.append(USE)  # fallback: try to use current cell\n  else:\n      actions.append(USE)      # no specific workshop required\n\n  return actions", "env_interactions": 23, "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T23:09:35.847214", "function_name": "make_arrow", "function_body": "  # Action constants (must match CraftWorld ordering)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  MOVE_DELTAS = {DOWN: (0, 1), UP: (0, -1), LEFT: (-1, 0), RIGHT: (1, 0)}\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving from `start` to a\n  # cell adjacent (Manhattan distance 1) to any location in `targets`.\n  # It treats any non\u2011empty cell as blocked (except the target cells\n  # themselves, which we only need to get next to).\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  def _bfs_adjacent(start, targets, occupied):\n      \"\"\"Return actions to reach a cell adjacent to one of `targets`.\"\"\"\n      w, h = occupied.shape\n      target_set = set(targets)\n\n      # Already adjacent?\n      for tx, ty in target_set:\n          if abs(start[0] - tx) + abs(start[1] - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      while q:\n          x, y, path = q.popleft()\n          for act, (dx, dy) in MOVE_DELTAS.items():\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < w and 0 <= ny < h):\n                  continue\n              if (nx, ny) in visited or occupied[nx, ny]:\n                  continue\n              new_path = path + [act]\n              # Check adjacency after the move\n              for tx, ty in target_set:\n                  if abs(nx - tx) + abs(ny - ty) == 1:\n                      return new_path\n              visited.add((nx, ny))\n              q.append((nx, ny, new_path))\n      return []  # no reachable adjacent cell\n\n  # ------------------------------------------------------------------\n  # Retrieve world and current state from the environment (handles\n  # both CraftWorld / CraftScenario and CraftLab wrappers).\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  state = getattr(env, \"_current_state\", None)\n\n  if world is None or state is None:\n      # Assume env is a CraftLab\u2011like wrapper.\n      env.reset()\n      state = env._current_state\n      world = state.world\n\n  cookbook = world.cookbook\n  goal_idx = cookbook.index[\"arrow\"]\n\n  # ------------------------------------------------------------------\n  # Determine primitive requirements for a single arrow.\n  # ------------------------------------------------------------------\n  primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n  if not primitives_needed:\n      return []  # arrow is a primitive itself\n\n  # ------------------------------------------------------------------\n  # Current grid, position and occupancy mask.\n  # ------------------------------------------------------------------\n  grid = state.grid                     # (W, H, n_kinds)\n  pos = tuple(state.pos)                # (x, y)\n  occupied = np.any(grid > 0, axis=2)   # True where any entity occupies the cell\n\n  actions = []\n  harvested = set()                     # cells already collected from\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first).\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      collected = 0\n      while collected < needed_cnt:\n          # Locate all remaining cells that contain this primitive.\n          candidates = [\n              tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)\n              if tuple(p) not in harvested\n          ]\n          if not candidates:\n              break  # no more of this primitive on the map\n\n          # Choose the closest candidate (Manhattan distance).\n          candidates.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          target = candidates[0]\n\n          # Plan a path to a cell adjacent to the target.\n          path = _bfs_adjacent(pos, [target], occupied)\n          actions.extend(path)\n\n          # Simulate movement to keep `pos` up\u2011to\u2011date.\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Pick up the primitive.\n          actions.append(USE)\n          harvested.add(target)\n          collected += 1\n\n          # Update occupancy \u2013 the target cell becomes empty after pickup.\n          occupied[target] = False\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (string name or integer).\n      workshop_idx = (\n          cookbook.index[workshop_key]\n          if isinstance(workshop_key, str)\n          else workshop_key\n      )\n      # Locate all workshop cells of the required type.\n      workshop_cells = [\n          tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)\n      ]\n      if workshop_cells:\n          workshop_cells.sort(\n              key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1])\n          )\n          ws_target = workshop_cells[0]\n          path = _bfs_adjacent(pos, [ws_target], occupied)\n          actions.extend(path)\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(USE)\n      else:\n          # No visible workshop \u2013 attempt to craft in place.\n          actions.append(USE)\n  else:\n      # No specific workshop required; just use to craft.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T23:10:00.530792", "function_name": "make_arrow", "function_body": "  import numpy as np\n  import collections\n\n  # Action indices (consistent with CraftWorld defaults)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  MOVE_DELTAS = {\n      DOWN: (0, 1),\n      UP: (0, -1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  def _bfs_adjacent(start, targets, occupied):\n      \"\"\"Return a list of actions that moves from ``start`` to a cell\n      adjacent (Manhattan distance 1) to any cell in ``targets`` while\n      avoiding occupied cells.\n      \"\"\"\n      width, height = occupied.shape\n      target_set = set(targets)\n\n      # If already adjacent, no movement needed.\n      for tx, ty in target_set:\n          if abs(start[0] - tx) + abs(start[1] - ty) == 1:\n              return []\n\n      queue = collections.deque()\n      queue.append((start[0], start[1], []))\n      visited = {start}\n\n      while queue:\n          x, y, path = queue.popleft()\n          for act, (dx, dy) in MOVE_DELTAS.items():\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              if occupied[nx, ny]:\n                  continue\n              visited.add((nx, ny))\n              new_path = path + [act]\n              # Check adjacency to any target.\n              for tx, ty in target_set:\n                  if abs(nx - tx) + abs(ny - ty) == 1:\n                      return new_path\n              queue.append((nx, ny, new_path))\n      # If no reachable adjacent cell, return empty list.\n      return []\n\n  # ------------------------------------------------------------------\n  # Retrieve the underlying world and current state from the (possibly\n  # wrapped) environment.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # env might be a CraftLab wrapper.\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n      world = state.world\n  else:\n      # env is likely a raw CraftWorld.\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n\n  cookbook = world.cookbook\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # ------------------------------------------------------------------\n  # Determine primitive requirements for a single arrow.\n  # ------------------------------------------------------------------\n  primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n  need_collection = bool(primitives_needed)\n\n  # ------------------------------------------------------------------\n  # Initial grid, position and occupancy mask.\n  # ------------------------------------------------------------------\n  grid = state.grid                     # (W, H, n_kinds)\n  pos = tuple(state.pos)                # (x, y)\n  occupied = np.any(grid > 0, axis=2)   # True where any entity exists\n\n  actions = []\n  harvested = set()                     # Cells already collected from\n\n  # ------------------------------------------------------------------\n  # Collect required primitives (greedy nearest\u2011first).\n  # ------------------------------------------------------------------\n  if need_collection:\n      for prim_idx, needed_cnt in primitives_needed.items():\n          gathered = 0\n          while gathered < needed_cnt:\n              # Find all cells that still contain this primitive.\n              candidates = [\n                  tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)\n                  if tuple(p) not in harvested\n              ]\n              if not candidates:\n                  # No more of this primitive left on the map.\n                  break\n\n              # Choose the closest candidate (Manhattan distance).\n              candidates.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n              target = candidates[0]\n\n              # Plan a path to a cell adjacent to the target.\n              path = _bfs_adjacent(pos, [target], occupied)\n              actions.extend(path)\n\n              # Simulate movement to update ``pos``.\n              for a in path:\n                  dx, dy = MOVE_DELTAS[a]\n                  pos = (pos[0] + dx, pos[1] + dy)\n\n              # Use (pick up) the primitive.\n              actions.append(USE)\n              harvested.add(target)\n              gathered += 1\n\n              # Update occupancy: the cell becomes empty after pickup.\n              occupied[target] = False\n              grid[:, :, prim_idx][target] = 0\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (string name or integer).\n      workshop_idx = (\n          cookbook.index[workshop_key]\n          if isinstance(workshop_key, str) else workshop_key\n      )\n      workshop_cells = [\n          tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)\n      ]\n      if workshop_cells:\n          # Choose nearest workshop.\n          workshop_cells.sort(\n              key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1])\n          )\n          ws_target = workshop_cells[0]\n          path = _bfs_adjacent(pos, [ws_target], occupied)\n          actions.extend(path)\n          for a in path:\n              dx, dy = MOVE_DELTAS[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(USE)  # craft at workshop\n      else:\n          # No workshop found; attempt to craft at current location.\n          actions.append(USE)\n  else:\n      # No specific workshop required.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T23:10:01.705794", "function_name": "make_arrow", "function_body": "  import collections\n  import numpy as np\n\n  # ------------------------------------------------------------------\n  # Action constants (match CraftWorld defaults)\n  # ------------------------------------------------------------------\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  MOVE_DELTAS = {\n      DOWN: (0, 1),\n      UP: (0, -1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that stops when we reach a cell adjacent to any target\n  # ------------------------------------------------------------------\n  def _bfs_adjacent(start, targets, occupied):\n      \"\"\"Return a list of actions moving from `start` to a cell adjacent to any\n      coordinate in `targets`.  `occupied` is a 2\u2011D bool array where True means\n      the cell cannot be entered.\"\"\"\n      width, height = occupied.shape\n      target_set = set(targets)\n\n      # If already adjacent, no movement needed.\n      for tx, ty in target_set:\n          if abs(start[0] - tx) + abs(start[1] - ty) == 1:\n              return []\n\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n\n      while q:\n          x, y, path = q.popleft()\n          for act, (dx, dy) in MOVE_DELTAS.items():\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              if occupied[nx, ny]:\n                  continue\n              visited.add((nx, ny))\n              new_path = path + [act]\n              for tx, ty in target_set:\n                  if abs(nx - tx) + abs(ny - ty) == 1:\n                      return new_path\n              q.append((nx, ny, new_path))\n      # No reachable adjacent cell (should not happen in well\u2011formed maps)\n      return []\n\n  # ------------------------------------------------------------------\n  # Retrieve the underlying world and current state from the env.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Likely a CraftLab wrapper.\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n      world = state.world\n  else:\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n\n  cookbook = world.cookbook\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # ------------------------------------------------------------------\n  # Determine which primitive items are needed for a single arrow.\n  # ------------------------------------------------------------------\n  primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n  need_collection = bool(primitives_needed)\n\n  # ------------------------------------------------------------------\n  # Snapshot of the current grid, position and occupancy mask.\n  # ------------------------------------------------------------------\n  grid = state.grid                     # (W, H, n_kinds)\n  pos = tuple(state.pos)                # (x, y)\n  occupied = np.any(grid > 0, axis=2)   # True where any entity exists\n\n  actions = []\n  harvested = set()                     # Cells already collected from\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first).\n  # ------------------------------------------------------------------\n  if need_collection:\n      for prim_idx, required_cnt in primitives_needed.items():\n          gathered = 0\n          while gathered < required_cnt:\n              # Find all remaining cells containing this primitive.\n              candidates = [\n                  tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)\n                  if tuple(p) not in harvested\n              ]\n              if not candidates:\n                  # No more instances left on the map \u2013 give up early.\n                  break\n\n              # Choose the closest candidate (Manhattan distance).\n              candidates.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n              target = candidates[0]\n\n              # Plan a path to a cell adjacent to the target.\n              path = _bfs_adjacent(pos, [target], occupied)\n              actions.extend(path)\n\n              # Simulate the movement to update `pos`.\n              for act in path:\n                  dx, dy = MOVE_DELTAS[act]\n                  pos = (pos[0] + dx, pos[1] + dy)\n\n              # Pick up the primitive.\n              actions.append(USE)\n              harvested.add(target)\n              gathered += 1\n\n              # Update occupancy \u2013 the cell becomes empty after collection.\n              occupied[target] = False\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (may be a string name or already an int).\n      workshop_idx = (\n          cookbook.index[workshop_key]\n          if isinstance(workshop_key, str) else workshop_key\n      )\n      workshop_cells = [\n          tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)\n      ]\n      if workshop_cells:\n          # Pick the nearest workshop.\n          workshop_cells.sort(\n              key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1])\n          )\n          ws_target = workshop_cells[0]\n          path = _bfs_adjacent(pos, [ws_target], occupied)\n          actions.extend(path)\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(USE)  # craft at workshop\n      else:\n          # No workshop present \u2013 just attempt to use current cell.\n          actions.append(USE)\n  else:\n      # No specific workshop required.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T23:10:29.067436", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = set()\n  start_node = Node(init_state, [])\n  visited.add(_state_hash(init_state))\n  frontier = deque([start_node])\n\n  MAX_STEPS = 2500\n  n_actions = getattr(world, \"n_actions\", 5)\n  # Prefer USE action (index 4) before movement actions\n  action_order = [4] + [i for i in range(n_actions) if i != 4]\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      for a in action_order:\n          _, next_state = cur_state.step(a)\n          h = _state_hash(next_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(next_state, node.actions + [a]))\n\n  return []", "env_interactions": 20, "island_id": 2, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:10:44.896442", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = set()\n  frontier = deque([Node(init_state, [])])\n  visited.add(_state_hash(init_state))\n\n  MAX_STEPS = 2000\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  # Prefer the USE action (commonly index 4) before movement actions\n  use_idx = None\n  for i in range(n_actions):\n      if i == 4:  # assume USE action is at index 4\n          use_idx = i\n          break\n  action_order = ([use_idx] if use_idx is not None else []) + [i for i in range(n_actions) if i != use_idx]\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      for a in action_order:\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  return []", "env_interactions": 20, "island_id": 2, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:11:11.192142", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action IDs as defined in CraftLab\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # --------------------------------------------------------------\n  # Initialise environment and obtain useful handles\n  # --------------------------------------------------------------\n  env.reset()\n  state = env._current_state          # CraftState instance\n  world = env.world                    # CraftWorld instance\n  grid = state.grid.copy()             # mutable copy for planning\n\n  # --------------------------------------------------------------\n  # Helper utilities\n  # --------------------------------------------------------------\n  non_grab = list(world.non_grabbable_indices)\n\n  def is_blocked(pos):\n      \"\"\"Return True if a non\u2011grabbable entity occupies ``pos``.\"\"\"\n      y, x = pos\n      return np.any(grid[y, x, non_grab] > 0)\n\n  def bfs_path(start, goal):\n      \"\"\"Return the shortest 4\u2011connected walkable path from start to goal.\"\"\"\n      if start == goal:\n          return [start]\n      h, w = grid.shape[:2]\n      q = deque([start])\n      prev = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          y, x = cur\n          for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):\n              if 0 <= ny < h and 0 <= nx < w:\n                  nxt = (ny, nx)\n                  if nxt not in prev and not is_blocked(nxt):\n                      prev[nxt] = cur\n                      q.append(nxt)\n      else:\n          return []  # unreachable\n\n      # reconstruct path\n      path = []\n      cur = goal\n      while cur is not None:\n          path.append(cur)\n          cur = prev[cur]\n      path.reverse()\n      return path\n\n  def path_to_actions(path):\n      \"\"\"Translate a list of positions into movement actions.\"\"\"\n      acts = []\n      for (y1, x1), (y2, x2) in zip(path, path[1:]):\n          if y2 == y1 + 1:\n              acts.append(DOWN)\n          elif y2 == y1 - 1:\n              acts.append(UP)\n          elif x2 == x1 + 1:\n              acts.append(RIGHT)\n          elif x2 == x1 - 1:\n              acts.append(LEFT)\n      return acts\n\n  def nearest_cell(kind, from_pos):\n      \"\"\"Find the nearest cell containing the given kind (Manhattan distance).\"\"\"\n      locs = np.argwhere(grid[:, :, kind] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      return tuple(locs[dists.argmin()])\n\n  def free_adjacent(target):\n      \"\"\"Return a walkable neighbour of ``target`` (preferring N, S, W, E).\"\"\"\n      y, x = target\n      for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not is_blocked((ny, nx)):\n                  return (ny, nx)\n      return target  # fallback (should rarely happen)\n\n  # --------------------------------------------------------------\n  # Build the action sequence\n  # --------------------------------------------------------------\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # Goal item and its primitive requirements\n  goal_idx = world.cookbook.index.index('arrow')\n  required = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # Collect each required primitive the needed number of times\n  for prim_idx, cnt in required.items():\n      for _ in range(cnt):\n          prim_loc = nearest_cell(prim_idx, cur_pos)\n          if prim_loc is None:\n              # Primitive missing \u2013 abort early\n              return actions\n\n          # Move to a free cell adjacent to the primitive\n          stand = free_adjacent(prim_loc)\n          path = bfs_path(cur_pos, stand)\n          if not path:\n              return actions\n          actions.extend(path_to_actions(path))\n          cur_pos = stand\n\n          # Step onto the primitive cell itself (if not blocked)\n          if not is_blocked(prim_loc):\n              path = bfs_path(cur_pos, prim_loc)\n              if not path:\n                  return actions\n              actions.extend(path_to_actions(path))\n              cur_pos = prim_loc\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update planning grid to reflect removal\n          grid[prim_loc[0], prim_loc[1], prim_idx] = 0\n\n  # If the recipe specifies a workshop, go there before crafting\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      ws_idx = world.cookbook.index.index(workshop_name)\n      ws_loc = nearest_cell(ws_idx, cur_pos)\n      if ws_loc is not None:\n          path = bfs_path(cur_pos, ws_loc)\n          if path:\n              actions.extend(path_to_actions(path))\n              cur_pos = ws_loc\n\n  # Final USE to craft the arrow\n  actions.append(USE)\n\n  # Return the compiled action list\n  return actions", "env_interactions": 23, "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T23:11:12.352705", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action IDs as defined in CraftLab\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Initialise environment and obtain handles\n  # ------------------------------------------------------------------\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()             # mutable copy for planning\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  non_grabbable = list(world.non_grabbable_indices)\n\n  def is_blocked(pos):\n      \"\"\"Return True if a non\u2011grabbable entity occupies ``pos``.\"\"\"\n      y, x = pos\n      return np.any(grid[y, x, non_grabbable] > 0)\n\n  def bfs_path(start, goal):\n      \"\"\"Shortest 4\u2011connected walkable path from ``start`` to ``goal`` (inclusive).\"\"\"\n      if start == goal:\n          return [start]\n      h, w = grid.shape[:2]\n      q = deque([start])\n      prev = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          y, x = cur\n          for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):\n              if 0 <= ny < h and 0 <= nx < w:\n                  nxt = (ny, nx)\n                  if nxt not in prev and not is_blocked(nxt):\n                      prev[nxt] = cur\n                      q.append(nxt)\n      else:\n          return []  # unreachable\n\n      # reconstruct path\n      path = []\n      cur = goal\n      while cur is not None:\n          path.append(cur)\n          cur = prev[cur]\n      path.reverse()\n      return path\n\n  def path_to_actions(path):\n      \"\"\"Translate a list of positions into movement actions.\"\"\"\n      acts = []\n      for (y1, x1), (y2, x2) in zip(path, path[1:]):\n          if y2 == y1 + 1:\n              acts.append(DOWN)\n          elif y2 == y1 - 1:\n              acts.append(UP)\n          elif x2 == x1 + 1:\n              acts.append(RIGHT)\n          elif x2 == x1 - 1:\n              acts.append(LEFT)\n      return acts\n\n  def nearest_cell(kind, from_pos):\n      \"\"\"Return the Manhattan\u2011closest cell that contains ``kind``.\"\"\"\n      locs = np.argwhere(grid[:, :, kind] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      return tuple(locs[dists.argmin()])\n\n  def free_adjacent(target):\n      \"\"\"Return a walkable neighbour of ``target`` (preferring N, S, W, E).\"\"\"\n      y, x = target\n      for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not is_blocked((ny, nx)):\n                  return (ny, nx)\n      return target  # fallback (should be rare)\n\n  # ------------------------------------------------------------------\n  # Build the action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # Goal index and its primitive requirements\n  goal_idx = world.cookbook.index.index('arrow')\n  required = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # Collect each required primitive the needed number of times\n  for prim_idx, cnt in required.items():\n      for _ in range(cnt):\n          prim_loc = nearest_cell(prim_idx, cur_pos)\n          if prim_loc is None:\n              # Primitive missing \u2013 abort early\n              return actions\n\n          # Move to a free cell adjacent to the primitive\n          stand = free_adjacent(prim_loc)\n          path = bfs_path(cur_pos, stand)\n          if not path:\n              return actions\n          actions.extend(path_to_actions(path))\n          cur_pos = stand\n\n          # Step onto the primitive cell itself (if not blocked)\n          if not is_blocked(prim_loc):\n              path = bfs_path(cur_pos, prim_loc)\n              if not path:\n                  return actions\n              actions.extend(path_to_actions(path))\n              cur_pos = prim_loc\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update planning grid to reflect removal of the primitive\n          grid[prim_loc[0], prim_loc[1], prim_idx] = 0\n\n  # If the recipe specifies a workshop, go there before crafting\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      ws_idx = world.cookbook.index.index(workshop_name)\n      ws_loc = nearest_cell(ws_idx, cur_pos)\n      if ws_loc is not None:\n          path = bfs_path(cur_pos, ws_loc)\n          if path:\n              actions.extend(path_to_actions(path))\n              cur_pos = ws_loc\n\n  # Final USE to craft the arrow\n  actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T23:11:39.187873", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_key(st):\n      \"\"\"Hashable representation of a CraftState.\"\"\"\n      return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())\n\n  visited = {_state_key(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_PLAN_LEN = 500  # safety cutoff\n  n_actions = getattr(world, \"n_actions\", 5)  # typically 5 (4 moves + USE)\n\n  while frontier:\n      node = frontier.popleft()\n      cur = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long trajectories\n      if len(node.actions) >= MAX_PLAN_LEN:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt = cur.step(a)\n          key = _state_key(nxt)\n          if key not in visited:\n              visited.add(key)\n              frontier.append(Node(nxt, node.actions + [a]))\n\n  # No plan found within the search budget\n  return []", "env_interactions": 20, "island_id": 1, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:11:54.882994", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_key(st):\n      # Hashable representation: position, direction, inventory tuple, and grid bytes\n      return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())\n\n  visited = {_state_key(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_PLAN_LEN = 500  # safety cutoff to avoid infinite search\n  n_actions = getattr(world, \"n_actions\", 5)  # typically 5 (4 moves + USE)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long trajectories\n      if len(node.actions) >= MAX_PLAN_LEN:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key not in visited:\n              visited.add(key)\n              frontier.append(Node(next_state, node.actions + [a]))\n\n  # No plan found within the search budget\n  return []", "env_interactions": 20, "island_id": 1, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:12:15.889093", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  # target item index for \"arrow\"\n  target_idx = cookbook.index[\"arrow\"]\n\n  # local mutable copies of grid, position, inventory\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n  width, height, _ = grid.shape\n  actions: list[int] = []\n\n  from collections import deque\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of movement actions (DOWN,UP,LEFT,RIGHT)\n  # from start to any cell in *goals*.  Cells occupied by any entity are\n  # treated as blocked unless the cell itself is a goal.\n  def bfs(start: tuple[int, int], goals: set[tuple[int, int]]) -> list[int] | None:\n      q = deque([(start, [])])\n      visited = {start}\n      while q:\n          cur, path = q.popleft()\n          if cur in goals:\n              return path\n          x, y = cur\n          for dx, dy, act in ((0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)):\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              nxt = (nx, ny)\n              if nxt in visited:\n                  continue\n              # allow stepping onto a goal even if occupied\n              if np.any(grid[nx, ny, :]) and nxt not in goals:\n                  continue\n              visited.add(nxt)\n              q.append((nxt, path + [act]))\n      return None\n\n  # ------------------------------------------------------------------\n  # Update simulated position according to a list of movement actions.\n  def apply_path(path: list[int]) -> None:\n      nonlocal pos\n      for a in path:\n          if a == 0:      # DOWN\n              pos = (pos[0], pos[1] + 1)\n          elif a == 1:    # UP\n              pos = (pos[0], pos[1] - 1)\n          elif a == 2:    # LEFT\n              pos = (pos[0] - 1, pos[1])\n          elif a == 3:    # RIGHT\n              pos = (pos[0] + 1, pos[1])\n\n  # ------------------------------------------------------------------\n  # Primitive collection routine.\n  def collect_primitive(kind_idx: int, needed: int) -> None:\n      nonlocal actions, grid, inventory, pos\n      while needed > 0:\n          # locate all cells that still contain this primitive\n          cells = [(x, y) for x in range(width) for y in range(height)\n                   if grid[x, y, kind_idx] > 0]\n          if not cells:\n              raise RuntimeError(f\"Primitive {kind_idx} not found on map\")\n          # pick the first reachable primitive (could be optimized)\n          chosen_path = None\n          chosen_cell = None\n          for cell in cells:\n              p = bfs(pos, {cell})\n              if p is not None:\n                  chosen_path, chosen_cell = p, cell\n                  break\n          if chosen_path is None:\n              raise RuntimeError(\"No reachable primitive found\")\n          actions.extend(chosen_path)\n          apply_path(chosen_path)\n          # USE to pick up\n          actions.append(4)\n          grid[chosen_cell[0], chosen_cell[1], kind_idx] = 0\n          inventory[kind_idx] += 1\n          needed -= 1\n\n  # ------------------------------------------------------------------\n  # Recursive crafting helper ensuring *item_idx* is present in at least *cnt* units.\n  recipes = cookbook.recipes\n  primitives_set = cookbook.primitives\n\n  def ensure_item(item_idx: int, cnt: int) -> None:\n      nonlocal actions, grid, inventory, pos\n      while inventory[item_idx] < cnt:\n          if item_idx in primitives_set:\n              # Primitive: just collect the missing amount\n              collect_primitive(item_idx, cnt - inventory[item_idx])\n              continue\n\n          recipe = recipes.get(item_idx, {})\n          # Satisfy all ingredient requirements first\n          for ing_idx, need in list(recipe.items()):\n              if ing_idx == \"_at\":\n                  continue\n              if inventory[ing_idx] < need:\n                  ensure_item(ing_idx, need)\n\n          # Move to required workshop if the recipe specifies one\n          workshop = recipe.get(\"_at\")\n          if workshop is not None:\n              ws_idx = workshop if isinstance(workshop, int) else cookbook.index[workshop]\n              ws_cells = [(x, y) for x in range(width) for y in range(height)\n                          if grid[x, y, ws_idx] > 0]\n              if not ws_cells:\n                  raise RuntimeError(f\"Workshop {workshop} not found on map\")\n              path = bfs(pos, {ws_cells[0]})\n              if path is None:\n                  raise RuntimeError(\"Cannot reach required workshop\")\n              actions.extend(path)\n              apply_path(path)\n\n          # Perform the craft action\n          actions.append(4)  # USE\n          for ing_idx, need in recipe.items():\n              if ing_idx == \"_at\":\n                  continue\n              inventory[ing_idx] -= need\n          inventory[item_idx] += 1\n\n  # ------------------------------------------------------------------\n  # Build the target arrow\n  ensure_item(target_idx, 1)\n\n  return actions", "env_interactions": 41, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T23:12:17.062510", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  # index of the goal item (arrow)\n  target_idx = cookbook.index[\"arrow\"]\n\n  # mutable copies of the world state for planning\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n  width, height, _ = grid.shape\n  actions: list[int] = []\n\n  from collections import deque\n\n  def bfs(start: tuple[int, int],\n          goals: set[tuple[int, int]]) -> list[int] | None:\n      \"\"\"Shortest path (as list of action ids) from start to any goal cell.\"\"\"\n      q = deque([(start, [])])\n      visited = {start}\n      while q:\n          cur, path = q.popleft()\n          if cur in goals:\n              return path\n          x, y = cur\n          for dx, dy, act in ((0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)):\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              nxt = (nx, ny)\n              if nxt in visited:\n                  continue\n              # can step onto a goal even if occupied\n              if np.any(grid[nx, ny, :]) and nxt not in goals:\n                  continue\n              visited.add(nxt)\n              q.append((nxt, path + [act]))\n      return None\n\n  def move_along(path: list[int]) -> None:\n      \"\"\"Update simulated position after following a list of actions.\"\"\"\n      nonlocal pos\n      for a in path:\n          if a == 0:   # DOWN\n              pos = (pos[0], pos[1] + 1)\n          elif a == 1: # UP\n              pos = (pos[0], pos[1] - 1)\n          elif a == 2: # LEFT\n              pos = (pos[0] - 1, pos[1])\n          elif a == 3: # RIGHT\n              pos = (pos[0] + 1, pos[1])\n\n  # ------------------------------------------------------------------\n  # Primitive collection\n  def collect_primitive(kind_idx: int, needed: int) -> None:\n      \"\"\"Collect `needed` units of a primitive from the grid.\"\"\"\n      nonlocal actions, grid, inventory, pos\n      while needed > 0:\n          # locate cells still containing the primitive\n          locations = [(x, y) for x in range(width) for y in range(height)\n                       if grid[x, y, kind_idx] > 0]\n          if not locations:\n              raise RuntimeError(f\"Primitive {kind_idx} missing from map\")\n          # pick first reachable location (any will do for correctness)\n          chosen_path = None\n          chosen_loc = None\n          for loc in locations:\n              p = bfs(pos, {loc})\n              if p is not None:\n                  chosen_path, chosen_loc = p, loc\n                  break\n          if chosen_path is None:\n              raise RuntimeError(\"No reachable primitive found\")\n          actions.extend(chosen_path)\n          move_along(chosen_path)\n          actions.append(4)                     # USE to pick up\n          grid[chosen_loc[0], chosen_loc[1], kind_idx] = 0\n          inventory[kind_idx] += 1\n          needed -= 1\n\n  # ------------------------------------------------------------------\n  # Recursive crafting helper\n  recipes = cookbook.recipes\n  primitives = cookbook.primitives\n\n  def ensure_item(item_idx: int, amount: int) -> None:\n      \"\"\"Guarantee that `inventory[item_idx] >= amount` by collecting/crafting.\"\"\"\n      nonlocal actions, grid, inventory, pos\n      while inventory[item_idx] < amount:\n          if item_idx in primitives:\n              # primitive: just collect the missing amount\n              collect_primitive(item_idx, amount - inventory[item_idx])\n              continue\n\n          # obtain recipe (may be empty)\n          recipe = recipes.get(item_idx, {})\n          # first satisfy all ingredient requirements\n          for ing_idx, cnt in list(recipe.items()):\n              if ing_idx == \"_at\":\n                  continue\n              if inventory[ing_idx] < cnt:\n                  ensure_item(ing_idx, cnt)\n\n          # move to required workshop, if any\n          workshop = recipe.get(\"_at\")\n          if workshop is not None:\n              ws_idx = workshop if isinstance(workshop, int) else cookbook.index[workshop]\n              ws_cells = [(x, y) for x in range(width) for y in range(height)\n                          if grid[x, y, ws_idx] > 0]\n              if not ws_cells:\n                  raise RuntimeError(f\"Workshop {workshop} not present on the map\")\n              p = bfs(pos, {ws_cells[0]})\n              if p is None:\n                  raise RuntimeError(\"Cannot reach required workshop\")\n              actions.extend(p)\n              move_along(p)\n\n          # perform the craft action\n          actions.append(4)  # USE\n          for ing_idx, cnt in recipe.items():\n              if ing_idx == \"_at\":\n                  continue\n              inventory[ing_idx] -= cnt\n          inventory[item_idx] += 1\n\n  # ------------------------------------------------------------------\n  # Build the target arrow\n  ensure_item(target_idx, 1)\n\n  return actions", "env_interactions": 41, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T23:12:39.573960", "function_name": "make_arrow", "function_body": "", "env_interactions": 0, "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-10-28T23:12:40.762611", "function_name": "make_arrow", "function_body": "  # Reset environment and get initial state information\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  # Work on a mutable copy of the grid so we can mark items as collected\n  grid = np.copy(state.grid)\n\n  # Action indices as defined in CraftWorld\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that walk\n      from ``start`` to ``goal`` using a simple Manhattan route.\"\"\"\n      y, x = start\n      gy, gx = goal\n      dy, dx = gy - y, gx - x\n      actions = []\n      if dy > 0:\n          actions += [DOWN] * dy\n      elif dy < 0:\n          actions += [UP] * (-dy)\n      if dx > 0:\n          actions += [RIGHT] * dx\n      elif dx < 0:\n          actions += [LEFT] * (-dx)\n      return actions\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Find the nearest cell containing ``kind_idx``. Returns (y, x) or None.\"\"\"\n      locs = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      nearest = locs[np.argmin(dists)]\n      return tuple(nearest)\n\n  def free_adjacent(cell):\n      \"\"\"Return a free orthogonal neighbour of ``cell`` (y, x) if any,\n      otherwise return the cell itself.\"\"\"\n      y, x = cell\n      h, w = grid.shape[:2]\n      for ny, nx in [(y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)]:\n          if 0 <= ny < h and 0 <= nx < w:\n              occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)\n              if not occupied:\n                  return (ny, nx)\n      return cell\n\n  # ------------------------------------------------------------------\n  # Determine required primitives for the 'arrow' item\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each primitive the required number of times\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive missing; abort planning.\n              return actions\n\n          # Choose a free adjacent cell to stand on before using.\n          stand = free_adjacent(target)\n\n          # Move to the chosen location.\n          actions += manhattan_path(cur_pos, stand)\n          cur_pos = stand\n\n          # Face the primitive (by moving one step towards it if possible).\n          dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n              cur_pos = (cur_pos[0] + 1, cur_pos[1])\n          elif dy == -1:\n              actions.append(UP)\n              cur_pos = (cur_pos[0] - 1, cur_pos[1])\n          elif dx == 1:\n              actions.append(RIGHT)\n              cur_pos = (cur_pos[0], cur_pos[1] + 1)\n          elif dx == -1:\n              actions.append(LEFT)\n              cur_pos = (cur_pos[0], cur_pos[1] - 1)\n          # If already on the target cell, direction does not change.\n\n          # Pick up the primitive.\n          actions.append(USE)\n\n          # Mark the primitive as collected in our planning grid.\n          grid[target[0], target[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          actions += manhattan_path(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # Final USE to trigger crafting of the arrow.\n  actions.append(USE)\n\n  return actions", "env_interactions": 26, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T23:12:57.030853", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Retrieve world and target information\n  # ----------------------------------------------------------------------\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  # ----------------------------------------------------------------------\n  # Primitive requirements for the goal (used for heuristic)\n  # ----------------------------------------------------------------------\n  needed_prims = world.cookbook.primitives_for(target_idx)  # dict {prim_idx: count}\n  needed_prim_idxs = set(needed_prims.keys())\n\n  # ----------------------------------------------------------------------\n  # Helper: hash a state for visited\u2011set bookkeeping\n  # ----------------------------------------------------------------------\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  # ----------------------------------------------------------------------\n  # Heuristic: estimate remaining distance to collect missing primitives\n  # ----------------------------------------------------------------------\n  import numpy as np\n\n  def _heuristic(st):\n      # count missing primitives\n      missing = {\n          idx: needed_prims[idx] - int(st.inventory[idx])\n          for idx in needed_prim_idxs\n          if needed_prims[idx] > int(st.inventory[idx])\n      }\n      if not missing:\n          return 0\n\n      pos_r, pos_c = st.pos\n      # for each missing primitive, find the closest cell that currently holds it\n      total = 0\n      for idx, need in missing.items():\n          # cells where the primitive exists (grid slice > 0)\n          locs = np.argwhere(st.grid[:, :, idx] > 0)\n          if locs.size == 0:\n              # no visible instance \u2013 give a large penalty\n              total += 10 * need\n              continue\n          # Manhattan distance to the nearest such cell\n          d = min(abs(r - pos_r) + abs(c - pos_c) for r, c in locs)\n          total += d * need\n      return total\n\n  # ----------------------------------------------------------------------\n  # A* search over deterministic state transitions\n  # ----------------------------------------------------------------------\n  import heapq\n  from collections import namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\", \"cost\"])\n\n  start_node = Node(state=init_state, actions=[], cost=0)\n  start_f = _heuristic(init_state)\n\n  frontier = [(start_f, 0, start_node)]  # (priority, tie\u2011breaker, node)\n  visited = {_state_hash(init_state)}\n\n  MAX_PLAN_LENGTH = 600                     # safety bound\n  n_actions = getattr(world, \"n_actions\", 5)  # default action space size\n\n  while frontier:\n      _, _, cur_node = heapq.heappop(frontier)\n      cur_state = cur_node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return cur_node.actions\n\n      # Prune overly long plans\n      if len(cur_node.actions) >= MAX_PLAN_LENGTH:\n          continue\n\n      # Expand neighbours\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h in visited:\n              continue\n          visited.add(h)\n          new_cost = cur_node.cost + 1\n          priority = new_cost + _heuristic(nxt_state)\n          nxt_node = Node(state=nxt_state,\n                          actions=cur_node.actions + [a],\n                          cost=new_cost)\n          heapq.heappush(frontier, (priority, new_cost, nxt_node))\n\n  # No feasible plan found within the search budget\n  return []", "env_interactions": 0, "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-10-28T23:13:12.693411", "function_name": "make_arrow", "function_body": "  # Retrieve scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Obtain the initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  # ------------------------------------------------------------------\n  # Breadth\u2011first search over deterministic state transitions.\n  # The search stops when an inventory containing at least one arrow is\n  # reached or when a safety limit on plan length is exceeded.\n  # ------------------------------------------------------------------\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      \"\"\"Hash a CraftState for visited\u2011set tracking.\"\"\"\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_PLAN_LENGTH = 800                     # safety bound\n  n_actions = getattr(world, \"n_actions\", 5)  # default action space size\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long trajectories\n      if len(node.actions) >= MAX_PLAN_LENGTH:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within the search budget\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:13:37.945817", "function_name": "make_arrow", "function_body": "  # Retrieve the scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Obtain the initial state for the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      \"\"\"\n      Produce a hashable representation of a CraftState.\n      Includes position, direction, inventory and the full grid.\n      \"\"\"\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  # BFS frontier\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  # Limits\n  MAX_PLAN_LEN = 3000\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long trajectories\n      if len(node.actions) >= MAX_PLAN_LEN:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within the search budget\n  return []", "env_interactions": 20, "island_id": 2, "scores": {"3": 2.9}}
