{"timestamp": "2025-10-28T16:10:08.334939", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # Helper: simple Manhattan move actions (0=DOWN,1=UP,2=LEFT,3=RIGHT,4=USE)\n  def _move_actions(src, dst):\n      actions = []\n      x, y = src\n      tx, ty = dst\n      while x < tx:\n          actions.append(0)  # DOWN\n          x += 1\n      while x > tx:\n          actions.append(1)  # UP\n          x -= 1\n      while y < ty:\n          actions.append(3)  # RIGHT\n          y += 1\n      while y > ty:\n          actions.append(2)  # LEFT\n          y -= 1\n      return actions\n\n  # Grab references to world and cookbook\n  world = env.world\n  cookbook = world.cookbook\n  idx = cookbook.index\n\n  # Identify the goal item \"arrow\"\n  try:\n      arrow_idx = idx[\"arrow\"]\n  except Exception:\n      # If the name is not exactly \"arrow\", try lower\u2011case lookup\n      arrow_idx = idx.get(\"arrow\", None)\n      if arrow_idx is None:\n          raise ValueError(\"Arrow recipe not found in cookbook.\")\n\n  # Determine primitive requirements for one arrow\n  primitives_needed = cookbook.primitives_for(arrow_idx)  # {prim_idx: count}\n\n  # Initial grid layout (static obstacles and item placements)\n  grid = env.scenario.init_grid\n  width, height = grid.shape[:2]\n\n  # Starting position of the agent\n  pos = tuple(env.scenario.init_pos)  # (x, y)\n\n  actions_plan = []\n\n  # ----------------------------------------------------------------------\n  # 1. Collect each required primitive the needed number of times.\n  # ----------------------------------------------------------------------\n  for prim_idx, cnt in primitives_needed.items():\n      for _ in range(cnt):\n          # Locate any cell that currently holds this primitive.\n          locations = np.argwhere(grid[:, :, prim_idx] > 0)\n          if locations.size == 0:\n              raise RuntimeError(f\"Required primitive {idx.get(prim_idx, prim_idx)} not found on map.\")\n          target = tuple(locations[0])  # (x, y)\n\n          # Find a free neighbouring cell to stand on before using.\n          neigh = None\n          for dx, dy, act in [(-1, 0, 0), (1, 0, 1), (0, -1, 2), (0, 1, 3)]:\n              nx, ny = target[0] + dx, target[1] + dy\n              if 0 <= nx < width and 0 <= ny < height:\n                  if grid[nx, ny, :].sum() == 0:  # empty cell\n                      neigh = (nx, ny)\n                      break\n          if neigh is None:\n              # Fallback: stand on the target cell itself (may be allowed).\n              neigh = target\n\n          # Move to the chosen neighbour.\n          actions_plan.extend(_move_actions(pos, neigh))\n          pos = neigh\n\n          # Face the target (the last move direction already points towards it)\n          # and issue USE action to pick up.\n          actions_plan.append(4)  # USE\n\n          # Update the static grid to reflect that the primitive has been taken.\n          # This prevents re\u2011using the same cell for subsequent pickups.\n          grid[target[0], target[1], prim_idx] = 0\n\n  # ----------------------------------------------------------------------\n  # 2. Move to the workshop where the arrow can be crafted and craft it.\n  # ----------------------------------------------------------------------\n  recipe = cookbook.recipes.get(arrow_idx, {})\n  workshop_idx = recipe.get(\"_at\", None)\n  if workshop_idx is None:\n      raise RuntimeError(\"Arrow recipe does not specify a workshop location.\")\n\n  # Locate a workshop cell.\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      raise RuntimeError(\"No workshop of required type found on map.\")\n  workshop = tuple(workshop_cells[0])\n\n  # Choose a free neighbour of the workshop.\n  workshop_neigh = None\n  for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n      nx, ny = workshop[0] + dx, workshop[1] + dy\n      if 0 <= nx < width and 0 <= ny < height:\n          if grid[nx, ny, :].sum() == 0:\n              workshop_neigh = (nx, ny)\n              break\n  if workshop_neigh is None:\n      # If surrounded, just go to the workshop cell itself.\n      workshop_neigh = workshop\n\n  # Move to the neighbour and use.\n  actions_plan.extend(_move_actions(pos, workshop_neigh))\n  pos = workshop_neigh\n  actions_plan.append(4)  # USE to craft the arrow\n\n  return actions_plan", "env_interactions": 0, "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-10-28T16:10:09.450629", "function_name": "make_arrow", "function_body": "  # Reset the environment to start a new episode and obtain the initial observation.\n  obs = env.reset()\n\n  # Prepare a list to record the actions taken.\n  actions = []\n\n  # Determine the set of possible action indices from the environment's action specifications.\n  # The action specs dict maps action names (e.g., \"DOWN\", \"UP\", ...) to integer indices.\n  action_space = list(env.action_specs().values())\n\n  # Define a safety cap on the number of steps to avoid infinite loops in case something goes wrong.\n  max_steps = 2000\n\n  for _ in range(max_steps):\n      # If the environment provides an internal done check, use it to break early.\n      if hasattr(env, \"_is_done\") and env._is_done():\n          break\n\n      # Sample a random action from the available action space.\n      # This simple stochastic policy will eventually stumble upon a successful\n      # sequence (given enough steps) because the environment does not penalize\n      # random exploration and the task is achievable within a bounded number of steps.\n      action = int(np.random.choice(action_space))\n\n      # Record the chosen action.\n      actions.append(action)\n\n      # Execute the action in the environment.\n      # env.step returns (reward, done, observation). We only need the `done` flag here.\n      _, done, _ = env.step(action)\n\n      # If the episode has finished (goal achieved or max steps reached), exit the loop.\n      if done:\n          break\n\n  # Return the sequence of actions that led (or attempted) to completing the task.\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-10-28T16:10:40.282242", "function_name": "make_arrow", "function_body": "  # Action constants (consistent with CraftLab)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ----------------------------------------------------------------------\n  # Helper functions\n  # ----------------------------------------------------------------------\n  def _bfs_path(start, goal, grid):\n      \"\"\"Return a list of actions to move from start to goal using BFS.\n      start/goal are [x, y] lists.  Cells with any non\u2011zero kind are\n      considered blocked, except the goal cell itself.\n      \"\"\"\n      width, height = grid.shape[0], grid.shape[1]\n      # direction vectors paired with action indices\n      moves = [\n          ((0, 1), DOWN),   # down  : +y\n          ((0, -1), UP),    # up    : -y\n          ((-1, 0), LEFT),  # left  : -x\n          ((1, 0), RIGHT),  # right : +x\n      ]\n\n      from collections import deque\n      q = deque()\n      q.append(tuple(start))\n      visited = {tuple(start): (None, None)}  # pos -> (prev_pos, action)\n\n      while q:\n          x, y = q.popleft()\n          if [x, y] == goal:\n              break\n          for (dx, dy), act in moves:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              # allow stepping onto the goal even if occupied\n              if (nx, ny) != tuple(goal):\n                  if grid[nx, ny].sum() != 0:\n                      continue\n              visited[(nx, ny)] = ((x, y), act)\n              q.append((nx, ny))\n\n      # reconstruct path\n      if tuple(goal) not in visited:\n          return []  # no path found\n      path = []\n      cur = tuple(goal)\n      while visited[cur][0] is not None:\n          prev, act = visited[cur]\n          path.append(act)\n          cur = prev\n      path.reverse()\n      return path\n\n  def _nearest_kind(kind_idx, cur_pos, grid):\n      \"\"\"Find the nearest cell (Manhattan) containing the given kind.\"\"\"\n      ys, xs = np.where(grid[:, :, kind_idx] > 0)\n      if len(xs) == 0:\n          return None\n      dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])\n      best = int(np.argmin(dists))\n      return [int(xs[best]), int(ys[best])]\n\n  # ----------------------------------------------------------------------\n  # Begin planning\n  # ----------------------------------------------------------------------\n  actions = []\n\n  # Current position (use the live state if available, else the init pos)\n  if hasattr(env, \"_current_state\") and env._current_state is not None:\n      cur_pos = list(env._current_state.pos)\n  else:\n      cur_pos = list(env.scenario.init_pos)\n\n  # Work on a mutable copy of the static grid so we can \u201cremove\u201d taken items\n  grid = env.scenario.init_grid.copy()\n\n  # Goal item index\n  goal_idx = env.task.goal\n\n  # ----------------------------------------------------------------------\n  # 1. Collect required primitive resources\n  # ----------------------------------------------------------------------\n  primitive_reqs = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  for prim_kind, count in primitive_reqs.items():\n      for _ in range(count):\n          tgt = _nearest_kind(prim_kind, cur_pos, grid)\n          if tgt is None:\n              # No more of this primitive \u2013 abort planning\n              return actions\n          # Move to the primitive cell\n          actions.extend(_bfs_path(cur_pos, tgt, grid))\n          # Pick it up\n          actions.append(USE)\n          # Update simulated state\n          grid[tgt[0], tgt[1], prim_kind] = 0\n          cur_pos = tgt\n\n  # ----------------------------------------------------------------------\n  # 2. Move to workshop and craft the goal item\n  # ----------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      workshop_pos = _nearest_kind(workshop_kind, cur_pos, grid)\n      if workshop_pos is not None:\n          actions.extend(_bfs_path(cur_pos, workshop_pos, grid))\n          actions.append(USE)  # craft at the workshop\n          cur_pos = workshop_pos\n\n  # Return the planned action sequence\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:10:41.399066", "function_name": "make_arrow", "function_body": "  # Action constants\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ----------------------------------------------------------------------\n  # Helper utilities\n  # ----------------------------------------------------------------------\n  def _move_to(pos, target, seq):\n      \"\"\"Append actions to `seq` that move `pos` (mutable [x, y]) to `target`.\"\"\"\n      while pos[0] != target[0] or pos[1] != target[1]:\n          if pos[0] < target[0]:\n              seq.append(RIGHT)\n              pos[0] += 1\n          elif pos[0] > target[0]:\n              seq.append(LEFT)\n              pos[0] -= 1\n          elif pos[1] < target[1]:\n              seq.append(DOWN)\n              pos[1] += 1\n          elif pos[1] > target[1]:\n              seq.append(UP)\n              pos[1] -= 1\n\n  def _nearest_kind(kind_idx, cur_pos, grid):\n      \"\"\"Return the (x, y) of the nearest cell containing `kind_idx`.\"\"\"\n      ys, xs = np.where(grid[:, :, kind_idx] > 0)\n      if len(xs) == 0:\n          return None\n      dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])\n      best = int(np.argmin(dists))\n      return [int(xs[best]), int(ys[best])]\n\n  # ----------------------------------------------------------------------\n  # Initialise planning state\n  # ----------------------------------------------------------------------\n  actions = []\n\n  # Current position \u2013 use the environment's actual state if available,\n  # otherwise fall back to the scenario's initial position.\n  if hasattr(env, \"_current_state\"):\n      cur_pos = list(env._current_state.pos)\n  else:\n      cur_pos = list(env.scenario.init_pos)\n\n  # Work on a copy of the static grid so we can mark collected items.\n  grid = env.scenario.init_grid.copy()\n\n  # Goal item index (the recipe we ultimately want to craft)\n  goal_idx = env.task.goal\n\n  # ----------------------------------------------------------------------\n  # 1. Collect all primitive resources required for the goal\n  # ----------------------------------------------------------------------\n  primitive_needs = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  for kind_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          target = _nearest_kind(kind_idx, cur_pos, grid)\n          if target is None:\n              # No more of this primitive available \u2013 abort planning.\n              return actions\n          _move_to(cur_pos, target, actions)\n          actions.append(USE)          # pick up the primitive\n          # Mark the primitive as taken in our local copy of the grid.\n          grid[target[1], target[0], kind_idx] = 0\n\n  # ----------------------------------------------------------------------\n  # 2. Move to the appropriate workshop (if any) and craft the goal item\n  # ----------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      workshop_pos = _nearest_kind(workshop_kind, cur_pos, grid)\n      if workshop_pos is not None:\n          _move_to(cur_pos, workshop_pos, actions)\n          actions.append(USE)          # craft at the workshop\n\n  # ----------------------------------------------------------------------\n  # Return the complete action sequence\n  # ----------------------------------------------------------------------\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:11:16.120627", "function_name": "make_arrow", "function_body": "  import numpy as np\n  import collections\n\n  # ----------------------------------------------------------------------\n  # Helper utilities\n  # ----------------------------------------------------------------------\n  # direction mapping: 0=DOWN, 1=UP, 2=LEFT, 3=RIGHT, 4=USE\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n\n  def bfs(start, targets, blocked):\n      \"\"\"Bread\u2011first search returning a list of direction indices from start to any target.\"\"\"\n      w, h = blocked.shape\n      q = collections.deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in targets:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not blocked[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      # if we fall out, return empty path (should not happen in well\u2011formed tasks)\n      return []\n\n  # ----------------------------------------------------------------------\n  # Access world / recipe information\n  # ----------------------------------------------------------------------\n  world = env.world\n  cookbook = world.cookbook\n  arrow_idx = cookbook.index[\"arrow\"]\n  arrow_recipe = cookbook.recipes[arrow_idx]\n\n  # ----------------------------------------------------------------------\n  # Determine full set of required items (including intermediates)\n  # ----------------------------------------------------------------------\n  needed_counts = {}\n\n  def accumulate(item_idx, qty):\n      \"\"\"Recursively add required quantities for item_idx.\"\"\"\n      needed_counts[item_idx] = needed_counts.get(item_idx, 0) + qty\n      # if the item has a recipe, recurse on its ingredients\n      recipe = cookbook.recipes.get(item_idx)\n      if recipe:\n          for ing_idx, ing_qty in recipe.items():\n              if isinstance(ing_idx, int):          # ignore the special \"_at\"/\"_key\"\n                  accumulate(ing_idx, ing_qty * qty)\n\n  accumulate(arrow_idx, 1)\n\n  # ----------------------------------------------------------------------\n  # Split into primitives and craftable items, and compute a topological order\n  # ----------------------------------------------------------------------\n  primitive_set = cookbook.primitives\n  craftable_items = [i for i in needed_counts if i not in primitive_set]\n\n  order = []          # items will appear after all their ingredients\n  visited = set()\n\n  def dfs(item_idx):\n      if item_idx in visited:\n          return\n      visited.add(item_idx)\n      recipe = cookbook.recipes.get(item_idx)\n      if recipe:\n          for ing_idx in recipe:\n              if isinstance(ing_idx, int):\n                  dfs(ing_idx)\n      order.append(item_idx)\n\n  for item in craftable_items:\n      dfs(item)\n\n  # ----------------------------------------------------------------------\n  # Prepare grid information (blocked cells)\n  # ----------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid\n  w, h, _ = grid.shape\n\n  blocked = np.zeros((w, h), dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # ----------------------------------------------------------------------\n  # Action sequence construction\n  # ----------------------------------------------------------------------\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # Helper: move to nearest cell containing a specific kind\n  def move_to_kind(kind_idx, count):\n      nonlocal cur_pos, actions\n      for _ in range(count):\n          # locate all cells that still contain the kind\n          cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, kind_idx] > 0}\n          path = bfs(cur_pos, cells, blocked)\n          actions.extend(path)\n          for a in path:\n              dx, dy = DIRS[a]\n              cur_pos = (cur_pos[0] + dx, cur_pos[1] + dy)\n          # pick up the item\n          actions.append(4)   # USE\n\n  # ----------------------------------------------------------------------\n  # 1) Collect all primitive resources\n  # ----------------------------------------------------------------------\n  for prim_idx in primitive_set:\n      cnt = needed_counts.get(prim_idx, 0)\n      if cnt > 0:\n          move_to_kind(prim_idx, cnt)\n\n  # ----------------------------------------------------------------------\n  # 2) Craft items in topological order (including the final arrow)\n  # ----------------------------------------------------------------------\n  for item_idx in order:\n      cnt = needed_counts.get(item_idx, 0)\n      if cnt == 0:\n          continue\n      # locate workshop for this item\n      recipe = cookbook.recipes.get(item_idx, {})\n      workshop_key = recipe.get(\"_at\", recipe.get(\"_key\"))\n      if workshop_key is None:\n          continue  # should not happen\n      workshop_idx = workshop_key if isinstance(workshop_key, int) else cookbook.index[workshop_key]\n\n      workshop_cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, workshop_idx] > 0}\n      path = bfs(cur_pos, workshop_cells, blocked)\n      actions.extend(path)\n      for a in path:\n          dx, dy = DIRS[a]\n          cur_pos = (cur_pos[0] + dx, cur_pos[1] + dy)\n\n      # use the workshop the required number of times\n      actions.extend([4] * cnt)   # USE repeatedly\n\n  return actions", "env_interactions": 23, "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:11:17.246684", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Helper functions -------------------------------------------------------\n  # ----------------------------------------------------------------------\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]  # DOWN, UP, LEFT, RIGHT\n\n  def bfs(start, goal_cells, blocked):\n      \"\"\"Return a list of direction indices to reach any cell in goal_cells.\"\"\"\n      w, h = start_grid.shape[:2]\n      q = collections.deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in goal_cells:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not blocked[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []  # unreachable (should not happen)\n\n  def move_to_kind(kind_idx, count):\n      \"\"\"Move to the nearest cell containing `kind_idx` and USE it `count` times.\"\"\"\n      nonlocal cur_pos, actions\n      for _ in range(count):\n          # locate all cells that currently contain the required kind\n          cells = {(x, y) for x in range(w) for y in range(h)\n                   if start_grid[x, y, kind_idx] > 0}\n          path = bfs(cur_pos, cells, blocked_mask)\n          actions.extend(path)\n          # update position\n          for a in path:\n              dx, dy = DIRS[a]\n              cur_pos = (cur_pos[0] + dx, cur_pos[1] + dy)\n          actions.append(4)  # USE to pick up\n\n  # ----------------------------------------------------------------------\n  # Gather world / recipe information --------------------------------------\n  # ----------------------------------------------------------------------\n  world = env.world\n  cookbook = world.cookbook\n  arrow_idx = cookbook.index[\"arrow\"]\n  arrow_recipe = cookbook.recipes[arrow_idx]\n\n  # ----------------------------------------------------------------------\n  # Determine full crafting plan (primitives + intermediate crafts) -------\n  # ----------------------------------------------------------------------\n  needed_primitives = {}          # primitive_kind -> total count required\n  craft_plan = []                 # list of (item_idx, count) in order to craft\n\n  def resolve(item_idx, mult):\n      \"\"\"Recursively collect primitive needs and schedule crafts.\"\"\"\n      rec = cookbook.recipes.get(item_idx)\n      if rec is None:  # primitive (no recipe)\n          needed_primitives[item_idx] = needed_primitives.get(item_idx, 0) + mult\n          return\n      # first resolve all ingredient items\n      for ing, cnt in rec.items():\n          if isinstance(ing, int):          # ignore _at / _key entries\n              resolve(ing, cnt * mult)\n      # then schedule this item to be crafted\n      craft_plan.append((item_idx, mult))\n\n  resolve(arrow_idx, 1)\n\n  # ----------------------------------------------------------------------\n  # Prepare grid and blocked\u2011cell mask ------------------------------------\n  # ----------------------------------------------------------------------\n  start_grid = env._current_state.grid\n  w, h, _ = start_grid.shape\n  blocked_mask = np.zeros((w, h), dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked_mask |= start_grid[:, :, idx] > 0\n\n  # ----------------------------------------------------------------------\n  # Build the action sequence ---------------------------------------------\n  # ----------------------------------------------------------------------\n  actions = []\n  cur_pos = tuple(env._current_state.pos)\n\n  # 1) Collect all needed primitive resources\n  for kind_idx, cnt in needed_primitives.items():\n      move_to_kind(kind_idx, cnt)\n\n  # 2) Execute crafting steps in the order produced by `resolve`\n  for item_idx, cnt in craft_plan:\n      rec = cookbook.recipes[item_idx]\n      wk_key = rec.get(\"_at\", rec.get(\"_key\"))\n      wk_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]\n\n      # locate any workshop cell of the required type\n      wk_cells = {(x, y) for x in range(w) for y in range(h)\n                  if start_grid[x, y, wk_idx] > 0}\n      path = bfs(cur_pos, wk_cells, blocked_mask)\n      actions.extend(path)\n      for a in path:\n          dx, dy = DIRS[a]\n          cur_pos = (cur_pos[0] + dx, cur_pos[1] + dy)\n\n      # use the workshop the required number of times\n      actions.extend([4] * cnt)   # USE\n\n  return actions", "env_interactions": 20, "island_id": 6, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T16:11:42.954580", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  goal_idx = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal_idx)\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n  act_map = env.action_specs()\n  move_delta = {\n      \"UP\": (-1, 0),\n      \"DOWN\": (1, 0),\n      \"LEFT\": (0, -1),\n      \"RIGHT\": (0, 1),\n  }\n  actions = []\n  def bfs_to_adjacent(start, targets, grid):\n      from collections import deque\n      W, H = grid.shape[:2]\n      visited = set()\n      q = deque()\n      q.append((start, []))\n      visited.add(start)\n      target_set = set(targets)\n      while q:\n          pos, path = q.popleft()\n          for tx, ty in target_set:\n              if abs(pos[0] - tx) <= 1 and abs(pos[1] - ty) <= 1:\n                  return path\n          for act, (dx, dy) in move_delta.items():\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H:\n                  if grid[nx, ny].sum() == 0 and (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [act]))\n      return None\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          state = env._current_state\n          grid = state.grid\n          pos = state.pos\n          prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not prim_cells:\n              break\n          path = bfs_to_adjacent(pos, prim_cells, grid)\n          if path is None:\n              break\n          for act_name in path:\n              act_id = act_map[act_name]\n              actions.append(act_id)\n              env.step(act_id)\n          use_id = act_map[\"USE\"]\n          actions.append(use_id)\n          env.step(use_id)\n  if workshop_kind is not None:\n      state = env._current_state\n      grid = state.grid\n      pos = state.pos\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n      if workshop_cells:\n          path = bfs_to_adjacent(pos, workshop_cells, grid)\n          if path:\n              for act_name in path:\n                  act_id = act_map[act_name]\n                  actions.append(act_id)\n                  env.step(act_id)\n          use_id = act_map[\"USE\"]\n          actions.append(use_id)\n          env.step(use_id)\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": 0.0}}
