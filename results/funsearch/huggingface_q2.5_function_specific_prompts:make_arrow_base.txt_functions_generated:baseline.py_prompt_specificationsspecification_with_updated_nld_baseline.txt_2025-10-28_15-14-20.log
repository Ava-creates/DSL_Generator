{"timestamp": "2025-10-28T19:31:30.879534", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ----------------------------------------------------------------------\n  # Action mapping\n  # ----------------------------------------------------------------------\n  spec = env.action_specs()\n  DOWN = spec.get(\"DOWN\", 0)\n  UP = spec.get(\"UP\", 1)\n  LEFT = spec.get(\"LEFT\", 2)\n  RIGHT = spec.get(\"RIGHT\", 3)\n  USE = spec.get(\"USE\", 4)\n\n  # ----------------------------------------------------------------------\n  # Shortcuts to world / state\n  # ----------------------------------------------------------------------\n  world = env.world\n  state = env._current_state\n  grid = state.grid.copy()                     # (W, H, K)\n  width, height, n_kinds = grid.shape\n  pos = tuple(state.pos)                       # current agent position\n  inventory = state.inventory.copy()\n\n  # ----------------------------------------------------------------------\n  # Goal identification\n  # ----------------------------------------------------------------------\n  target_name = \"arrow\"\n  target_idx = world.cookbook.index.get(target_name)\n  if target_idx is None:\n      raise RuntimeError(\"Goal 'arrow' not found in cookbook.\")\n\n  # ----------------------------------------------------------------------\n  # Handy references\n  # ----------------------------------------------------------------------\n  recipes = world.cookbook.recipes\n  primitives = world.cookbook.primitives\n\n  # ----------------------------------------------------------------------\n  # Utility functions\n  # ----------------------------------------------------------------------\n  def bfs(start, goals):\n      \"\"\"Bread\u2011first search returning a list of movement actions from *start*\n      to any cell in *goals*. Cells occupied by any entity are treated as\n      blocked, except the goal cells themselves.\"\"\"\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          cur, path = q.popleft()\n          if cur in goals:\n              return path\n          x, y = cur\n          for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),\n                               (-1, 0, LEFT), (1, 0, RIGHT)]:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              nxt = (nx, ny)\n              if nxt in visited:\n                  continue\n              # blocked unless it is a goal cell\n              if np.any(grid[nx, ny, :]) and nxt not in goals:\n                  continue\n              visited.add(nxt)\n              q.append((nxt, path + [act]))\n      return None\n\n  def move_along(path):\n      \"\"\"Update *pos* following a sequence of movement actions.\"\"\"\n      nonlocal pos\n      for a in path:\n          if a == DOWN:\n              pos = (pos[0], pos[1] + 1)\n          elif a == UP:\n              pos = (pos[0], pos[1] - 1)\n          elif a == LEFT:\n              pos = (pos[0] - 1, pos[1])\n          elif a == RIGHT:\n              pos = (pos[0] + 1, pos[1])\n\n  def collect_primitive(kind_idx, needed):\n      \"\"\"Collect *needed* units of a primitive item from the grid.\"\"\"\n      nonlocal actions, grid, inventory, pos\n      while needed > 0:\n          # locate cells that still contain the primitive\n          locations = [(x, y) for x in range(width) for y in range(height)\n                       if grid[x, y, kind_idx] > 0]\n          if not locations:\n              raise RuntimeError(\"Required primitive not present on map.\")\n          # find a reachable cell (first one found)\n          path = None\n          target = None\n          for loc in locations:\n              path = bfs(pos, {loc})\n              if path is not None:\n                  target = loc\n                  break\n          if path is None:\n              raise RuntimeError(\"Primitive is unreachable.\")\n          # move to the cell\n          actions.extend(path)\n          move_along(path)\n          # pick up as many as we can / need\n          available = int(grid[target[0], target[1], kind_idx])\n          take = min(available, needed)\n          actions.extend([USE] * take)\n          # update simulated world state\n          grid[target[0], target[1], kind_idx] -= take\n          inventory[kind_idx] += take\n          needed -= take\n\n  def ensure(item_idx, amount):\n      \"\"\"Guarantee that *inventory[item_idx]* >= *amount*.\"\"\"\n      nonlocal actions, grid, inventory, pos\n      while inventory[item_idx] < amount:\n          # Primitive => just collect\n          if item_idx in primitives:\n              collect_primitive(item_idx, amount - inventory[item_idx])\n              continue\n\n          # Otherwise we need to craft using its recipe\n          recipe = recipes.get(item_idx, {})\n          # First, obtain all ingredient quantities\n          for ing_idx, cnt in list(recipe.items()):\n              if ing_idx in (\"_at\", \"_key\"):\n                  continue\n              if inventory[ing_idx] < cnt:\n                  ensure(ing_idx, cnt)\n\n          # Move to required workshop if the recipe specifies one\n          workshop_key = recipe.get(\"_at\") or recipe.get(\"_key\")\n          if workshop_key is not None:\n              ws_idx = workshop_key if isinstance(workshop_key, int) else world.cookbook.index.get(workshop_key)\n              ws_cells = [(x, y) for x in range(width) for y in range(height)\n                          if grid[x, y, ws_idx] > 0]\n              if not ws_cells:\n                  raise RuntimeError(\"Required workshop not present on map.\")\n              # choose the first reachable workshop cell\n              ws_path = bfs(pos, {ws_cells[0]})\n              if ws_path is None:\n                  # try others if first is blocked\n                  for cell in ws_cells[1:]:\n                      ws_path = bfs(pos, {cell})\n                      if ws_path is not None:\n                          break\n              if ws_path is None:\n                  raise RuntimeError(\"Workshop is unreachable.\")\n              actions.extend(ws_path)\n              move_along(ws_path)\n\n          # Perform the crafting action\n          actions.append(USE)\n          # Update simulated inventory according to the recipe\n          for ing_idx, cnt in recipe.items():\n              if ing_idx in (\"_at\", \"_key\"):\n                  continue\n              inventory[ing_idx] -= cnt\n          inventory[item_idx] += 1\n\n  # ----------------------------------------------------------------------\n  # Build the plan\n  # ----------------------------------------------------------------------\n  actions = []\n  ensure(target_idx, 1)\n\n  # Return the complete action sequence\n  return actions", "env_interactions": 0, "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-10-28T19:31:56.973486", "function_name": "make_arrow", "function_body": "  # Locate the scenario and world objects (they may be attributes of env or env itself)\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Identify the index corresponding to the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initialise the starting state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = set()\n  frontier = deque([Node(init_state, [])])\n  visited.add(_state_hash(init_state))\n\n  MAX_STEPS = 400               # safety cap to keep search tractable\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long trajectories\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          h = _state_hash(next_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(next_state, node.actions + [a]))\n\n  # No plan found within the search budget\n  return []", "env_interactions": 20, "island_id": 2, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T19:32:12.744733", "function_name": "make_arrow", "function_body": "  # Resolve scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  # Helper to hash a state (position, direction, inventory, grid layout)\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = set()\n  frontier = deque()\n  frontier.append(Node(init_state, []))\n  visited.add(_state_hash(init_state))\n\n  MAX_STEPS = 500\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal reached?\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Stop expanding overly long plans\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within limits\n  return []", "env_interactions": 20, "island_id": 2, "scores": {"3": 2.9}}
