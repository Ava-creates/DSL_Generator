{"timestamp": "2025-10-28T22:33:21.423518", "function_name": "make_arrow", "function_body": "  # Reset the environment and obtain the underlying objects\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()             # (W, H, n_kinds)\n\n  # ------------------------------------------------------------------\n  # Action indices\n  # ------------------------------------------------------------------\n  specs = env.action_specs()\n  DOWN = specs[\"DOWN\"]\n  UP = specs[\"UP\"]\n  LEFT = specs[\"LEFT\"]\n  RIGHT = specs[\"RIGHT\"]\n  USE = specs[\"USE\"]\n\n  # ------------------------------------------------------------------\n  # Helper functions\n  # ------------------------------------------------------------------\n  non_grabbable = list(world.non_grabbable_indices)\n\n  from collections import deque\n\n  def bfs(start, goal):\n      \"\"\"Return a list of movement actions from start to goal while avoiding\n      cells that contain any non\u2011grabbable entity.\"\"\"\n      H, W = grid.shape[:2]\n      visited = np.zeros((H, W), dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start] = True\n      while q:\n          y, x = q.popleft()\n          if (y, x) == goal:\n              # reconstruct path\n              actions = []\n              cur = goal\n              while cur != start:\n                  py, px = prev[cur]\n                  dy, dx = cur[0] - py, cur[1] - px\n                  if dy == 1:\n                      actions.append(DOWN)\n                  elif dy == -1:\n                      actions.append(UP)\n                  elif dx == 1:\n                      actions.append(RIGHT)\n                  elif dx == -1:\n                      actions.append(LEFT)\n                  cur = (py, px)\n              actions.reverse()\n              return actions\n          for dy, dx, act in ((1, 0, DOWN), (-1, 0, UP), (0, 1, RIGHT), (0, -1, LEFT)):\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < H and 0 <= nx < W and not visited[ny, nx]:\n                  # block movement if any non\u2011grabbable entity occupies the cell\n                  if np.any(grid[ny, nx, non_grabbable] > 0):\n                      continue\n                  visited[ny, nx] = True\n                  prev[(ny, nx)] = (y, x)\n                  q.append((ny, nx))\n      return []  # no path found\n\n  def nearest(kind, from_pos):\n      \"\"\"Return coordinates of the nearest cell containing the given kind.\"\"\"\n      locs = np.argwhere(grid[:, :, kind] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      return tuple(locs[dists.argmin()])\n\n  # ------------------------------------------------------------------\n  # Determine goal index for 'arrow' and required primitives\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  needed = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the necessary number of times\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = nearest(prim_idx, cur_pos)\n          if target is None:\n              # primitive not present \u2013 abort early\n              return actions\n          ty, tx = target\n\n          # Choose a free adjacent cell to stand on (prefer one that lets us face the primitive)\n          adj = None\n          for ny, nx in ((ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)):\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  if not grid[ny, nx].any():   # completely empty cell\n                      adj = (ny, nx)\n                      break\n          if adj is None:\n              # fall back to the primitive cell itself\n              adj = (ty, tx)\n\n          # Move to the chosen adjacent cell\n          actions += bfs(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (add one movement action that will be blocked)\n          dy, dx = ty - cur_pos[0], tx - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update internal grid representation to reflect that the primitive has been collected\n          grid[ty, tx, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if the recipe specifies one) and craft\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          actions += bfs(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # Trigger crafting at the current location\n  actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T22:33:52.889641", "function_name": "make_arrow", "function_body": "  # constants\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  MOVE_DELTAS = {\n      DOWN: (0, 1),\n      UP: (0, -1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving the agent from\n  # `start` to a cell adjacent (Manhattan distance = 1) to any cell in\n  # `targets`.  Cells occupied by any entity are treated as blocked,\n  # except the target cells themselves (we only need to stand next to\n  # them).  If already adjacent, returns empty list.\n  # ------------------------------------------------------------------\n  def _bfs_adjacent(start, targets, occupied):\n      width, height = occupied.shape\n      target_set = set(targets)\n\n      # already adjacent?\n      for tx, ty in target_set:\n          if abs(start[0] - tx) + abs(start[1] - ty) == 1:\n              return []\n\n      from collections import deque\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n\n      while q:\n          x, y, path = q.popleft()\n          for act, (dx, dy) in MOVE_DELTAS.items():\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              if occupied[nx, ny]:\n                  continue\n              visited.add((nx, ny))\n              new_path = path + [act]\n              # check adjacency to any target\n              for tx, ty in target_set:\n                  if abs(nx - tx) + abs(ny - ty) == 1:\n                      return new_path\n              q.append((nx, ny, new_path))\n      # unreachable\n      return []\n\n  # ------------------------------------------------------------------\n  # Retrieve world, state and cookbook objects from the environment.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # env is likely a CraftLab wrapper.\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n      world = state.world\n  else:\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n\n  cookbook = world.cookbook\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # ------------------------------------------------------------------\n  # Determine which primitive resources are required for a single arrow.\n  # ------------------------------------------------------------------\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n  if not primitives_needed:\n      # Arrow itself is a primitive \u2013 just use current cell.\n      return [USE]\n\n  # ------------------------------------------------------------------\n  # Current grid, position and occupancy mask.\n  # ------------------------------------------------------------------\n  grid = state.grid                       # (W, H, n_kinds)\n  pos = tuple(state.pos)                  # (x, y)\n  occupied = np.any(grid > 0, axis=2)     # True where any entity exists\n\n  actions = []\n  harvested = set()                       # cells already collected from\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first).\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      gathered = 0\n      while gathered < needed_cnt:\n          # Find all remaining cells containing this primitive.\n          prim_cells = [\n              tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)\n              if tuple(p) not in harvested\n          ]\n          if not prim_cells:\n              # No more of this primitive on the map \u2013 abort early.\n              break\n\n          # Choose the closest primitive (Manhattan distance).\n          prim_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          target = prim_cells[0]\n\n          # Plan a path to a cell adjacent to the primitive.\n          path = _bfs_adjacent(pos, [target], occupied)\n          actions.extend(path)\n\n          # Simulate movement.\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Pick up the primitive.\n          actions.append(USE)\n          harvested.add(target)\n          gathered += 1\n\n          # Update occupancy mask \u2013 the cell becomes empty after pickup.\n          occupied[target] = False\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (could be a name or an integer).\n      workshop_idx = (\n          cookbook.index[workshop_key]\n          if isinstance(workshop_key, str) else workshop_key\n      )\n      # Locate workshop cells.\n      workshop_cells = [\n          tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)\n      ]\n      if workshop_cells:\n          # Move to the nearest workshop.\n          workshop_cells.sort(\n              key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1])\n          )\n          ws_target = workshop_cells[0]\n          path = _bfs_adjacent(pos, [ws_target], occupied)\n          actions.extend(path)\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(USE)   # craft at workshop\n      else:\n          # No workshop of required type found \u2013 try to craft in place.\n          actions.append(USE)\n  else:\n      # No specific workshop required.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T22:33:54.034917", "function_name": "make_arrow", "function_body": "  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving the agent from\n  # `start` to a cell adjacent (Manhattan distance = 1) to any cell in\n  # `targets`.  Cells occupied by any entity are treated as blocked,\n  # except the target cells themselves (we only need to stand next to\n  # them to interact).\n  # ------------------------------------------------------------------\n  def _bfs_adjacent(start, targets, occupied):\n      width, height = occupied.shape\n      target_set = set(targets)\n\n      # Already adjacent?\n      for tx, ty in target_set:\n          if abs(start[0] - tx) + abs(start[1] - ty) == 1:\n              return []\n\n      from collections import deque\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n\n      while q:\n          x, y, path = q.popleft()\n          for act, (dx, dy) in MOVE_DELTAS.items():\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              if occupied[nx, ny]:\n                  continue\n              visited.add((nx, ny))\n              new_path = path + [act]\n              for tx, ty in target_set:\n                  if abs(nx - tx) + abs(ny - ty) == 1:\n                      return new_path\n              q.append((nx, ny, new_path))\n      return []  # No reachable adjacent cell.\n\n  # ------------------------------------------------------------------\n  # Retrieve world / state objects from the environment (handle possible\n  # wrappers).  If the environment has not been reset yet we do it here.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n      world = state.world\n  else:\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n\n  cookbook = world.cookbook\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # ------------------------------------------------------------------\n  # Determine primitive requirements for a single arrow.\n  # ------------------------------------------------------------------\n  primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n  if not primitives_needed:\n      # Arrow is itself a primitive \u2013 just use the current cell.\n      return [USE]\n\n  # ------------------------------------------------------------------\n  # Current grid, agent position and occupancy mask.\n  # ------------------------------------------------------------------\n  grid = state.grid                     # (W, H, n_kinds)\n  pos = tuple(state.pos)                # (x, y)\n  occupied = np.any(grid > 0, axis=2)   # True where any entity exists\n\n  actions = []\n  harvested = set()                     # Cells already collected from.\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first).\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      gathered = 0\n      while gathered < needed_cnt:\n          # Locate all remaining instances of the primitive.\n          prim_cells = [\n              tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)\n              if tuple(p) not in harvested\n          ]\n          if not prim_cells:\n              # No more of this primitive on the map \u2013 stop trying.\n              break\n\n          # Choose the closest primitive (Manhattan distance).\n          prim_cells.sort(\n              key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1])\n          )\n          target = prim_cells[0]\n\n          # Plan a path to a cell adjacent to the primitive.\n          path = _bfs_adjacent(pos, [target], occupied)\n          actions.extend(path)\n\n          # Simulate movement to update `pos`.\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Pick up the primitive.\n          actions.append(USE)\n          harvested.add(target)\n          gathered += 1\n\n          # Update occupancy mask \u2013 the cell becomes empty after pickup.\n          occupied[target] = False\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (may be a string name or an integer).\n      workshop_idx = (\n          cookbook.index[workshop_key]\n          if isinstance(workshop_key, str) else workshop_key\n      )\n      # Find all workshop cells of the required type.\n      workshop_cells = [\n          tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)\n      ]\n      if workshop_cells:\n          # Move to the nearest workshop.\n          workshop_cells.sort(\n              key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1])\n          )\n          ws_target = workshop_cells[0]\n          path = _bfs_adjacent(pos, [ws_target], occupied)\n          actions.extend(path)\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(USE)  # craft at workshop\n      else:\n          # No workshop found \u2013 attempt to craft in place.\n          actions.append(USE)\n  else:\n      # No specific workshop required.\n      actions.append(USE)\n\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-10-28T22:34:17.044588", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n  target_name = \"arrow\"\n  target_idx = cookbook.index[target_name]\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n  width, height, _ = grid.shape\n  actions = []\n\n  from collections import deque\n  import numpy as np\n\n  def bfs(start, goals):\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          cur, path = q.popleft()\n          if cur in goals:\n              return path\n          x, y = cur\n          for dx, dy, act in ((0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)):\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              nxt = (nx, ny)\n              if nxt in visited:\n                  continue\n              if np.any(grid[nx, ny, :]) and nxt not in goals:\n                  continue\n              visited.add(nxt)\n              q.append((nxt, path + [act]))\n      return None\n\n  def move_along(path):\n      nonlocal pos\n      for a in path:\n          if a == 0:   # DOWN\n              pos = (pos[0], pos[1] + 1)\n          elif a == 1: # UP\n              pos = (pos[0], pos[1] - 1)\n          elif a == 2: # LEFT\n              pos = (pos[0] - 1, pos[1])\n          elif a == 3: # RIGHT\n              pos = (pos[0] + 1, pos[1])\n\n  def collect_primitive(prim_idx, needed):\n      nonlocal actions, grid, inventory, pos\n      while needed > 0:\n          locations = [(x, y) for x in range(width) for y in range(height)\n                       if grid[x, y, prim_idx] > 0]\n          if not locations:\n              break\n          path = None\n          target_loc = None\n          for loc in locations:\n              cand = bfs(pos, {loc})\n              if cand is not None:\n                  path = cand\n                  target_loc = loc\n                  break\n          if path is None:\n              break\n          actions.extend(path)\n          move_along(path)\n          actions.append(4)  # USE\n          grid[target_loc[0], target_loc[1], prim_idx] = 0\n          inventory[prim_idx] += 1\n          needed -= 1\n\n  recipes = cookbook.recipes\n  primitives_set = cookbook.primitives\n\n  def ensure_item(item_idx, amount):\n      nonlocal actions, grid, inventory, pos\n      while inventory[item_idx] < amount:\n          if item_idx in primitives_set:\n              collect_primitive(item_idx, amount - inventory[item_idx])\n              continue\n\n          recipe = recipes.get(item_idx, {})\n          # ensure ingredients\n          for ing_idx, cnt in list(recipe.items()):\n              if ing_idx == \"_at\":\n                  continue\n              if inventory[ing_idx] < cnt:\n                  ensure_item(ing_idx, cnt)\n\n          # move to workshop if needed\n          workshop = recipe.get(\"_at\")\n          if workshop is not None:\n              ws_idx = workshop if isinstance(workshop, int) else cookbook.index[workshop]\n              ws_cells = [(x, y) for x in range(width) for y in range(height)\n                          if grid[x, y, ws_idx] > 0]\n              if ws_cells:\n                  path = bfs(pos, {ws_cells[0]})\n                  if path:\n                      actions.extend(path)\n                      move_along(path)\n\n          # craft\n          actions.append(4)  # USE\n          for ing_idx, cnt in recipe.items():\n              if ing_idx == \"_at\":\n                  continue\n              inventory[ing_idx] -= cnt\n          inventory[item_idx] += 1\n\n  ensure_item(target_idx, 1)\n  return actions", "env_interactions": 41, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T22:34:18.196915", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # current state and world information\n  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  target_name = \"arrow\"\n  target_idx = cookbook.index[target_name]\n\n  # mutable copies of the world state for planning\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n  width, height, _ = grid.shape\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper: shortest path (as list of actions) from start to any goal cell\n  # ------------------------------------------------------------------\n  def bfs(start, goal_cells):\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          cur, path = q.popleft()\n          if cur in goal_cells:\n              return path\n          x, y = cur\n          for dx, dy, act in ((0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)):\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              nxt = (nx, ny)\n              if nxt in visited:\n                  continue\n              # can step onto a goal cell even if occupied\n              if np.any(grid[nx, ny, :]) and nxt not in goal_cells:\n                  continue\n              visited.add(nxt)\n              q.append((nxt, path + [act]))\n      return None\n\n  # ------------------------------------------------------------------\n  # Helper: update simulated position according to a path of actions\n  # ------------------------------------------------------------------\n  def move_along(path):\n      nonlocal pos\n      for a in path:\n          if a == 0:   # DOWN\n              pos = (pos[0], pos[1] + 1)\n          elif a == 1: # UP\n              pos = (pos[0], pos[1] - 1)\n          elif a == 2: # LEFT\n              pos = (pos[0] - 1, pos[1])\n          elif a == 3: # RIGHT\n              pos = (pos[0] + 1, pos[1])\n\n  # ------------------------------------------------------------------\n  # Primitive collection\n  # ------------------------------------------------------------------\n  def collect_primitive(prim_idx, needed):\n      nonlocal actions, grid, inventory, pos\n      while needed > 0:\n          # locate all cells that still contain the primitive\n          locations = [(x, y) for x in range(width) for y in range(height)\n                       if grid[x, y, prim_idx] > 0]\n          if not locations:\n              break  # nothing left on the map\n          # pick the first reachable primitive (could be optimized)\n          path = None\n          target = None\n          for loc in locations:\n              cand = bfs(pos, {loc})\n              if cand is not None:\n                  path, target = cand, loc\n                  break\n          if path is None:\n              break  # unreachable\n          actions.extend(path)\n          move_along(path)\n          actions.append(4)                     # USE to pick up\n          grid[target[0], target[1], prim_idx] = 0\n          inventory[prim_idx] += 1\n          needed -= 1\n\n  # ------------------------------------------------------------------\n  # Recursive crafting helper\n  # ------------------------------------------------------------------\n  recipes = cookbook.recipes\n  primitives = cookbook.primitives\n\n  def ensure_item(item_idx, amount):\n      nonlocal actions, grid, inventory, pos\n      while inventory[item_idx] < amount:\n          if item_idx in primitives:\n              # primitive: just collect the missing amount\n              collect_primitive(item_idx, amount - inventory[item_idx])\n              continue\n\n          # need to craft the item\n          recipe = recipes.get(item_idx, {})\n          # first make sure all ingredients are available\n          for ing_idx, cnt in list(recipe.items()):\n              if ing_idx == \"_at\":\n                  continue\n              if inventory[ing_idx] < cnt:\n                  ensure_item(ing_idx, cnt)\n\n          # move to the required workshop (if any)\n          workshop = recipe.get(\"_at\")\n          if workshop is not None:\n              ws_idx = workshop if isinstance(workshop, int) else cookbook.index[workshop]\n              ws_cells = [(x, y) for x in range(width) for y in range(height)\n                          if grid[x, y, ws_idx] > 0]\n              if ws_cells:\n                  path = bfs(pos, {ws_cells[0]})\n                  if path:\n                      actions.extend(path)\n                      move_along(path)\n\n          # perform the craft\n          actions.append(4)                     # USE to craft\n          for ing_idx, cnt in recipe.items():\n              if ing_idx == \"_at\":\n                  continue\n              inventory[ing_idx] -= cnt\n          inventory[item_idx] += 1\n\n  # ------------------------------------------------------------------\n  # Build the target arrow\n  # ------------------------------------------------------------------\n  ensure_item(target_idx, 1)\n\n  return actions", "env_interactions": 41, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T22:34:44.557824", "function_name": "make_arrow", "function_body": "  import numpy as np\n  import collections\n\n  # Action indices (match CraftWorld defaults)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  MOVE_DELTAS = {\n      DOWN: (0, 1),\n      UP: (0, -1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  def _bfs_adjacent(start, targets, occupied):\n      \"\"\"Return a list of actions that brings the agent from *start* to a\n      cell adjacent (Manhattan distance == 1) to any cell in *targets*.\n      *occupied* is a bool array where True means the cell cannot be stepped\n      on.  If the start position is already adjacent, an empty list is\n      returned.  If no reachable adjacent cell exists, an empty list is also\n      returned.\"\"\"\n      width, height = occupied.shape\n      target_set = set(targets)\n\n      # Already adjacent?\n      for tx, ty in target_set:\n          if abs(start[0] - tx) + abs(start[1] - ty) == 1:\n              return []\n\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n\n      while q:\n          x, y, path = q.popleft()\n          for act, (dx, dy) in MOVE_DELTAS.items():\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              if occupied[nx, ny]:\n                  continue\n              visited.add((nx, ny))\n              new_path = path + [act]\n              # Check if this new position is adjacent to any target.\n              for tx, ty in target_set:\n                  if abs(nx - tx) + abs(ny - ty) == 1:\n                      return new_path\n              q.append((nx, ny, new_path))\n      return []\n\n  # ----------------------------------------------------------------------\n  # Obtain the underlying world and the current state from the env wrapper.\n  # ----------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # env may be a CraftLab wrapper; try to fetch the state first.\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n      world = state.world\n  else:\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n\n  cookbook = world.cookbook\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # ----------------------------------------------------------------------\n  # Determine which primitive resources are needed for a single arrow.\n  # ----------------------------------------------------------------------\n  primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n  # If the recipe contains no primitives (arrow itself is primitive) we\n  # simply need to use the workshop (or just USE if none required).\n  if not primitives_needed:\n      primitives_needed = {}\n\n  # ----------------------------------------------------------------------\n  # Current grid, agent position and occupancy mask.\n  # ----------------------------------------------------------------------\n  grid = state.grid                     # (W, H, n_kinds)\n  pos = tuple(state.pos)                # (x, y)\n  occupied = np.any(grid > 0, axis=2)   # True where any entity exists\n\n  actions = []\n  harvested_cells = set()               # remember cells we already collected from\n\n  # ----------------------------------------------------------------------\n  # Collect all required primitives (greedy nearest\u2011first).\n  # ----------------------------------------------------------------------\n  for prim_idx, required_cnt in primitives_needed.items():\n      collected = 0\n      while collected < required_cnt:\n          # Find all cells that still contain this primitive and have not been harvested.\n          prim_cells = [\n              tuple(coord) for coord in np.argwhere(grid[:, :, prim_idx] > 0)\n              if tuple(coord) not in harvested_cells\n          ]\n          if not prim_cells:\n              # No more of this primitive on the map; break out.\n              break\n\n          # Choose the closest cell (Manhattan distance).\n          prim_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          target = prim_cells[0]\n\n          # Plan a path to a cell adjacent to the primitive.\n          path = _bfs_adjacent(pos, [target], occupied)\n          actions.extend(path)\n\n          # Simulate movement to update the current position.\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Pick up the primitive.\n          actions.append(USE)\n          harvested_cells.add(target)\n          collected += 1\n\n          # Update occupancy: the primitive cell becomes empty after pickup.\n          occupied[target] = False\n          grid[:, :, prim_idx][target] = 0\n\n  # ----------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow.\n  # ----------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (string name or integer id).\n      workshop_idx = cookbook.index[workshop_key] if isinstance(workshop_key, str) else workshop_key\n      workshop_cells = [tuple(c) for c in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if workshop_cells:\n          workshop_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          ws_target = workshop_cells[0]\n          path = _bfs_adjacent(pos, [ws_target], occupied)\n          actions.extend(path)\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(USE)   # craft at the workshop\n      else:\n          # No workshop tile found; attempt to craft at current location.\n          actions.append(USE)\n  else:\n      # No specific workshop required.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T22:34:45.716757", "function_name": "make_arrow", "function_body": "  import numpy as np\n  import collections\n\n  # Action indices (match CraftWorld defaults)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  MOVE_DELTAS = {\n      DOWN: (0, 1),\n      UP: (0, -1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  def _bfs_adjacent(start, targets, occupied):\n      \"\"\"Return a list of actions that moves from ``start`` to a cell adjacent\n      to any cell in ``targets`` while avoiding occupied cells.\n\n      Parameters\n      ----------\n      start: tuple[int, int]\n          (x, y) start position.\n      targets: list[tuple[int, int]]\n          Positions we want to become adjacent to.\n      occupied: np.ndarray[bool]\n          2\u2011D mask where True means the cell cannot be entered.\n\n      Returns\n      -------\n      list[int]\n          Sequence of actions (DOWN/UP/LEFT/RIGHT) that reaches an adjacent\n          cell, or an empty list if already adjacent / unreachable.\n      \"\"\"\n      w, h = occupied.shape\n      target_set = set(targets)\n\n      # Already adjacent?\n      for tx, ty in target_set:\n          if abs(start[0] - tx) + abs(start[1] - ty) == 1:\n              return []\n\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n\n      while q:\n          x, y, path = q.popleft()\n          for act, (dx, dy) in MOVE_DELTAS.items():\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < w and 0 <= ny < h):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              if occupied[nx, ny]:\n                  continue\n              visited.add((nx, ny))\n              new_path = path + [act]\n              # Check adjacency after this move\n              for tx, ty in target_set:\n                  if abs(nx - tx) + abs(ny - ty) == 1:\n                      return new_path\n              q.append((nx, ny, new_path))\n      return []  # unreachable\n\n  # ----------------------------------------------------------------------\n  # Retrieve world and current state (handle possible wrappers)\n  # ----------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Try to get it from the internal state wrapper.\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n      world = state.world\n  else:\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n\n  cookbook = world.cookbook\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # ----------------------------------------------------------------------\n  # Determine primitive requirements for a single arrow\n  # ----------------------------------------------------------------------\n  primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n  # If the recipe has no primitive components, just attempt to craft.\n  if not primitives_needed:\n      primitives_needed = {}\n\n  # ----------------------------------------------------------------------\n  # Current grid, position and occupancy mask\n  # ----------------------------------------------------------------------\n  grid = state.grid                     # shape (W, H, n_kinds)\n  pos = tuple(state.pos)                # (x, y)\n  occupied = np.any(grid > 0, axis=2)   # True where any entity exists\n\n  actions = []\n  harvested = set()                     # cells already collected from\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first)\n  # ----------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      gathered = 0\n      while gathered < needed_cnt:\n          # Find all cells that still contain this primitive and are not yet harvested\n          prim_cells = [\n              tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)\n              if tuple(p) not in harvested\n          ]\n          if not prim_cells:\n              # No more of this primitive on the map \u2013 break out\n              break\n\n          # Choose the nearest primitive (Manhattan distance)\n          prim_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          target = prim_cells[0]\n\n          # Plan a path to a cell adjacent to the primitive\n          path = _bfs_adjacent(pos, [target], occupied)\n          actions.extend(path)\n\n          # Simulate movement to update current position\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Pick up the primitive (USE while facing it)\n          actions.append(USE)\n          harvested.add(target)\n          gathered += 1\n\n          # Update occupancy: the primitive layer disappears; if no other layer,\n          # the cell becomes free for future navigation.\n          occupied[target] = np.any(grid[target[0], target[1], :] > 0) and not (\n              grid[target[0], target[1], prim_idx] == 0\n          )\n          grid[target[0], target[1], prim_idx] = 0\n\n  # ----------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any)\n  # ----------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (string name or integer id)\n      workshop_idx = (\n          cookbook.index[workshop_key]\n          if isinstance(workshop_key, str)\n          else workshop_key\n      )\n      workshop_cells = [\n          tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)\n      ]\n      if workshop_cells:\n          # Move to the nearest workshop\n          workshop_cells.sort(\n              key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1])\n          )\n          ws_target = workshop_cells[0]\n          path = _bfs_adjacent(pos, [ws_target], occupied)\n          actions.extend(path)\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(USE)\n      else:\n          # No workshop found \u2013 just use current location\n          actions.append(USE)\n  else:\n      # No specific workshop required \u2013 use current location\n      actions.append(USE)\n\n  return actions", "env_interactions": 21, "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T22:35:06.921234", "function_name": "make_arrow", "function_body": "  # reset environment and get initial references\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world\n\n  # --------------------------------------------------------------\n  # Identify the index of the goal item \"arrow\"\n  # --------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:   # arrow not defined in this world\n      return []\n\n  actions = []\n\n  # --------------------------------------------------------------\n  # Helper: BFS that returns a list of movement actions (0\u20113) that\n  # brings the agent to a position where the cell directly in front\n  # contains `target_kind`. Returns None if target unreachable.\n  # --------------------------------------------------------------\n  deltas = {0: (0, 1),   # DOWN\n            1: (0, -1),  # UP\n            2: (-1, 0),  # LEFT\n            3: (1, 0)}   # RIGHT\n\n  def _bfs_to_target(cur_state, target_kind):\n      grid = cur_state.grid\n      W, H = grid.shape[:2]\n\n      def in_bounds(x, y):\n          return 0 <= x < W and 0 <= y < H\n\n      def walkable(x, y):\n          return in_bounds(x, y) and not np.any(grid[x, y, :])\n\n      sx, sy = cur_state.pos\n      sdir = cur_state.dir\n\n      from collections import deque\n      q = deque()\n      q.append((sx, sy, sdir, []))\n      visited = {(sx, sy, sdir)}\n\n      while q:\n          x, y, d, act_seq = q.popleft()\n          dx, dy = deltas[d]\n          fx, fy = x + dx, y + dy\n          if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:\n              return act_seq\n\n          for a in (0, 1, 2, 3):\n              ndx, ndy = deltas[a]\n              nx, ny = x + ndx, y + ndy\n              if not walkable(nx, ny):\n                  continue\n              if (nx, ny, a) in visited:\n                  continue\n              visited.add((nx, ny, a))\n              q.append((nx, ny, a, act_seq + [a]))\n      return None\n\n  # --------------------------------------------------------------\n  # Recursive collector: ensures one unit of `item_idx` ends up in\n  # the inventory (or on the ground ready to be picked up). Handles\n  # both primitive gathering and crafting of intermediate items.\n  # --------------------------------------------------------------\n  primitives_set = world.cookbook.primitives\n\n  def _ensure_item(item_idx):\n      \"\"\"Collect or craft a single unit of `item_idx`.\"\"\"\n      # If we already have it in inventory, nothing to do.\n      if state.inventory[item_idx] > 0:\n          return\n\n      # Primitive items are directly pick\u2011upable from the world.\n      if item_idx in primitives_set:\n          move_seq = _bfs_to_target(state, item_idx)\n          if move_seq is None:\n              raise RuntimeError(f\"Cannot reach primitive {item_idx}\")\n          actions.extend(move_seq)\n          actions.append(4)  # USE to pick up\n          for a in move_seq + [4]:\n              _, new_state = state.step(a)\n              nonlocal state\n              state = new_state\n          return\n\n      # Otherwise we need to craft it using its recipe.\n      recipe = world.cookbook.recipes.get(item_idx, {})\n      # Gather all required ingredients first.\n      for ing_idx, cnt in recipe.items():\n          if ing_idx == \"_at\":\n              continue\n          for _ in range(cnt):\n              _ensure_item(ing_idx)\n\n      # Move to the appropriate workshop (if any) and craft.\n      workshop_name = recipe.get('_at')\n      if workshop_name is not None:\n          wk_idx = world.cookbook.index.index(workshop_name)\n          move_seq = _bfs_to_target(state, wk_idx)\n          if move_seq is None:\n              raise RuntimeError(f\"Cannot reach workshop {workshop_name}\")\n          actions.extend(move_seq)\n          actions.append(4)  # USE to craft\n          for a in move_seq + [4]:\n              _, new_state = state.step(a)\n              nonlocal state\n              state = new_state\n      else:\n          # No specific workshop; just use the current cell.\n          actions.append(4)\n          _, new_state = state.step(4)\n          nonlocal state\n          state = new_state\n\n  # --------------------------------------------------------------\n  # Ensure we have (and thus craft) one arrow.\n  # --------------------------------------------------------------\n  try:\n      _ensure_item(arrow_idx)\n  except RuntimeError:\n      # Planning failed \u2013 return whatever actions have been built so far.\n      return actions\n\n  return actions", "env_interactions": 0, "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-10-28T22:35:08.270227", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state          # current CraftState\n  world = env.world\n\n  # Index of the goal item \"arrow\"\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:                   # arrow not defined in this world\n      return []\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of movement actions (0\u20113) that brings\n  # the agent to a cell whose *front* contains `target_kind`. Returns\n  # None if the target cannot be reached.\n  # ------------------------------------------------------------------\n  deltas = {0: (0, 1),   # DOWN\n            1: (0, -1),  # UP\n            2: (-1, 0),  # LEFT\n            3: (1, 0)}   # RIGHT\n\n  def _bfs_to_target(cur_state, target_kind):\n      grid = cur_state.grid\n      W, H = grid.shape[:2]\n\n      def in_bounds(x, y):\n          return 0 <= x < W and 0 <= y < H\n\n      def walkable(x, y):\n          return in_bounds(x, y) and not np.any(grid[x, y, :])\n\n      sx, sy = cur_state.pos\n      sdir = cur_state.dir\n\n      from collections import deque\n      q = deque()\n      q.append((sx, sy, sdir, []))\n      visited = {(sx, sy, sdir)}\n\n      while q:\n          x, y, d, actions = q.popleft()\n          dx, dy = deltas[d]\n          fx, fy = x + dx, y + dy\n          if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:\n              return actions\n\n          for a in (0, 1, 2, 3):\n              ndx, ndy = deltas[a]\n              nx, ny = x + ndx, y + ndy\n              if not walkable(nx, ny):\n                  continue\n              if (nx, ny, a) in visited:\n                  continue\n              visited.add((nx, ny, a))\n              q.append((nx, ny, a, actions + [a]))\n      return None\n\n  # ------------------------------------------------------------------\n  # Determine primitive requirements for a single arrow.\n  # ------------------------------------------------------------------\n  needed = world.cookbook.primitives_for(arrow_idx)\n  if not needed:                         # arrow itself is primitive\n      needed = {arrow_idx: 1}\n\n  plan = []\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the required number of times.\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          move_seq = _bfs_to_target(state, prim_idx)\n          if move_seq is None:          # unreachable primitive \u2192 abort planning\n              return plan\n          plan.extend(move_seq)\n          plan.append(4)                # USE to pick up\n          for a in move_seq + [4]:\n              _, state = state.step(a)\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its designated workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      move_seq = _bfs_to_target(state, workshop_idx)\n      if move_seq is None:              # unreachable workshop \u2192 abort\n          return plan\n      plan.extend(move_seq)\n      plan.append(4)                    # USE to craft\n      for a in move_seq + [4]:\n          _, state = state.step(a)\n  else:\n      plan.append(4)                    # USE to craft in place\n      _, state = state.step(4)\n\n  return plan", "env_interactions": 26, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T22:35:37.717594", "function_name": "make_arrow", "function_body": "  import collections, numpy as np\n\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  def _bfs_adjacent(start, targets, blocked):\n      w, h = blocked.shape\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n      while q:\n          x, y, path = q.popleft()\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n          for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not blocked[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      return []\n\n  def _apply(pos, actions):\n      x, y = pos\n      for a in actions:\n          if a == RIGHT:\n              x += 1\n          elif a == LEFT:\n              x -= 1\n          elif a == DOWN:\n              y += 1\n          elif a == UP:\n              y -= 1\n      return (x, y)\n\n  # locate world and cookbook\n  world = getattr(env, \"world\", None)\n  if world is None:\n      cur_state = getattr(env, \"_current_state\", None)\n      if cur_state is not None:\n          world = getattr(cur_state, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"CraftWorld instance not found in the environment.\")\n  cookbook = world.cookbook\n\n  # ensure we have a current state; reset if needed\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  goal_name = \"arrow\"\n  if goal_name not in cookbook.index.contents:\n      raise ValueError(f\"Goal '{goal_name}' not defined in the recipe file.\")\n  goal_idx = cookbook.index[goal_name]\n\n  # primitive requirements for the goal\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  pos = tuple(state.pos)               # (x, y)\n  grid = state.grid.copy()             # (W, H, n_kinds)\n  blocked = np.any(grid, axis=2)       # occupied mask (bool)\n\n  plan_actions = []\n  harvested = set()\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive.\n  # ------------------------------------------------------------------\n  for prim_idx, need_cnt in primitives_needed.items():\n      cells = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n      collected = 0\n      for cell in cells:\n          if collected >= need_cnt:\n              break\n          if cell in harvested:\n              continue\n          path = _bfs_adjacent(pos, [cell], blocked)\n          plan_actions.extend(path)\n          pos = _apply(pos, path)\n\n          plan_actions.append(USE)\n\n          grid[cell[0], cell[1], prim_idx] = 0\n          blocked = np.any(grid, axis=2)\n          harvested.add(cell)\n          collected += 1\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its designated workshop (if any)\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      ws_idx = (cookbook.index[workshop_key]\n                if isinstance(workshop_key, str) else int(workshop_key))\n      ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, ws_idx] > 0)]\n      if ws_cells:\n          ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          target_ws = ws_cells[0]\n          path = _bfs_adjacent(pos, [target_ws], blocked)\n          plan_actions.extend(path)\n          pos = _apply(pos, path)\n          plan_actions.append(USE)\n      else:\n          plan_actions.append(USE)\n  else:\n      plan_actions.append(USE)\n\n  return plan_actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T22:35:38.940477", "function_name": "make_arrow", "function_body": "  import collections, numpy as np\n\n  # Action constants (match CraftWorld definitions)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that stops when we are orthogonally adjacent to any target.\n  # Returns a list of actions to reach such a cell (empty list if already adjacent).\n  # ------------------------------------------------------------------\n  def _bfs_adjacent(start, targets, occ):\n      w, h = occ.shape\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n      while q:\n          x, y, path = q.popleft()\n          # if we are orthogonally adjacent to a target cell, stop\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n          # explore neighbours\n          for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occ[nx, ny]:          # can walk only on empty cells\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      return []  # no reachable adjacent cell (should not happen in valid maps)\n\n  # ------------------------------------------------------------------\n  # Helper: apply a sequence of actions to a position.\n  # ------------------------------------------------------------------\n  def _apply(pos, actions):\n      x, y = pos\n      for a in actions:\n          if a == RIGHT:\n              x += 1\n          elif a == LEFT:\n              x -= 1\n          elif a == DOWN:\n              y += 1\n          elif a == UP:\n              y -= 1\n      return (x, y)\n\n  # ------------------------------------------------------------------\n  # Locate the world and its cookbook inside the provided env object.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # some wrappers expose the state directly\n      cur_state = getattr(env, \"_current_state\", None)\n      if cur_state is not None:\n          world = getattr(cur_state, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"CraftWorld instance not found in the environment.\")\n  cookbook = world.cookbook\n\n  # ------------------------------------------------------------------\n  # Ensure we have a current state (reset if necessary).\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  # ------------------------------------------------------------------\n  # Goal information.\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  if goal_name not in cookbook.index.contents:\n      raise ValueError(f\"Goal '{goal_name}' not defined in the recipe file.\")\n  goal_idx = cookbook.index[goal_name]\n\n  # Primitive requirements for the goal (primitive_index -> count).\n  primitives_needed = cookbook.primitives_for(goal_idx)\n\n  # ------------------------------------------------------------------\n  # Planning structures.\n  # ------------------------------------------------------------------\n  pos = tuple(state.pos)                     # current (x, y)\n  grid = state.grid.copy()                   # (W, H, n_kinds)\n  occ = np.any(grid, axis=2)                 # occupied mask (bool)\n\n  plan_actions = []                          # final action list\n  harvested = set()                          # cells already collected from\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitives.\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      # locate all cells that currently contain this primitive\n      cells = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # sort by Manhattan distance from the current position (greedy)\n      cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n      collected = 0\n      for cell in cells:\n          if collected >= needed_cnt:\n              break\n          if cell in harvested:\n              continue\n          # move adjacent to the primitive\n          path = _bfs_adjacent(pos, [cell], occ)\n          plan_actions.extend(path)\n          pos = _apply(pos, path)\n\n          # pick it up\n          plan_actions.append(USE)\n\n          # update planning structures: primitive disappears, cell becomes free\n          grid[cell[0], cell[1], prim_idx] = 0\n          occ = np.any(grid, axis=2)\n          harvested.add(cell)\n          collected += 1\n\n  # ------------------------------------------------------------------\n  # 2) Move to the workshop (if required) and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # workshop may be given as a string name or directly as an index\n      ws_idx = (cookbook.index[workshop_key]\n                if isinstance(workshop_key, str) else int(workshop_key))\n      ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, ws_idx] > 0)]\n      if ws_cells:\n          ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          target_ws = ws_cells[0]\n          path = _bfs_adjacent(pos, [target_ws], occ)\n          plan_actions.extend(path)\n          pos = _apply(pos, path)\n          plan_actions.append(USE)          # craft at the workshop\n      else:\n          # workshop not visible \u2013 attempt crafting at current location\n          plan_actions.append(USE)\n  else:\n      # No specific workshop required; craft wherever we are.\n      plan_actions.append(USE)\n\n  return plan_actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T22:36:04.976685", "function_name": "make_arrow", "function_body": "  # Retrieve scenario and world objects (handles both raw env and wrapped envs)\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the desired output item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Starting state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      # Position, direction, inventory tuple, and grid bytes uniquely identify a state\n      return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  # Upper bound on plan length to keep the search tractable\n  MAX_PLAN_LEN = 2000\n  # Number of possible actions (defaults to 5 if not present)\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long trajectories\n      if len(node.actions) >= MAX_PLAN_LEN:\n          continue\n\n      # Expand all actions from the current state\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No solution found within the search budget\n  return []", "env_interactions": 20, "island_id": 2, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T22:36:20.645658", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n  from collections import deque, namedtuple\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n  def _state_hash(st):\n      return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n  MAX_PLAN_LEN = 2000\n  n_actions = getattr(world, \"n_actions\", 5)\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n      if len(node.actions) >= MAX_PLAN_LEN:\n          continue\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n  return []", "env_interactions": 20, "island_id": 2, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T22:36:58.711306", "function_name": "make_arrow", "function_body": "  import numpy as np\n  import collections\n\n  # Action IDs (as defined in CraftLab.action_specs)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Initialise environment and obtain current world information\n  # ------------------------------------------------------------------\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = np.copy(state.grid)           # mutable copy of the grid\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def is_free(pos, cur_grid):\n      \"\"\"Return True if the cell at ``pos`` has no entities (including\n      primitives and non\u2011grabbable objects).\"\"\"\n      y, x = pos\n      return not np.any(cur_grid[y, x, :] > 0)\n\n  def is_blocked(pos, cur_grid):\n      \"\"\"Return True if the cell contains any non\u2011grabbable entity.\"\"\"\n      y, x = pos\n      return np.any(cur_grid[y, x, list(world.non_grabbable_indices)] > 0)\n\n  def bfs_path(start, goal, cur_grid):\n      \"\"\"Shortest path from ``start`` to ``goal`` avoiding blocked cells.\n      Returns a list of movement actions (DOWN/UP/LEFT/RIGHT).\"\"\"\n      if start == goal:\n          return []\n      h, w = cur_grid.shape[:2]\n      q = collections.deque([start])\n      prev = {start: None}\n      while q:\n          y, x = q.popleft()\n          for dy, dx, act in ((1, 0, DOWN), (-1, 0, UP),\n                              (0, 1, RIGHT), (0, -1, LEFT)):\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < h and 0 <= nx < w and not is_blocked((ny, nx), cur_grid):\n                  if (ny, nx) not in prev:\n                      prev[(ny, nx)] = (y, x, act)\n                      if (ny, nx) == goal:\n                          # Reconstruct actions\n                          actions_rev = []\n                          cur = (ny, nx)\n                          while prev[cur] is not None:\n                              py, px, a = prev[cur]\n                              actions_rev.append(a)\n                              cur = (py, px)\n                          actions_rev.reverse()\n                          return actions_rev\n                      q.append((ny, nx))\n      # No path found \u2013 return empty list (will likely fail later)\n      return []\n\n  def find_nearest(kind_idx, from_pos, cur_grid):\n      \"\"\"Find coordinates of the nearest cell containing ``kind_idx``.\"\"\"\n      locs = np.argwhere(cur_grid[:, :, kind_idx] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      nearest = locs[np.argmin(dists)]\n      return tuple(nearest)\n\n  def choose_adjacent(target, cur_grid):\n      \"\"\"Choose a free cell adjacent to ``target`` to stand on.\n      Returns (adjacent_pos, facing_action) where ``facing_action`` is the\n      action that will make the agent face the target after a dummy turn.\"\"\"\n      ty, tx = target\n      h, w = cur_grid.shape[:2]\n      # Candidate neighbours with the action that would face the target\n      candidates = [\n          ((ty - 1, tx), DOWN),   # stand above, need to face DOWN\n          ((ty + 1, tx), UP),     # stand below, need to face UP\n          ((ty, tx - 1), RIGHT),  # stand left, need to face RIGHT\n          ((ty, tx + 1), LEFT)    # stand right, need to face LEFT\n      ]\n      for (ny, nx), face_act in candidates:\n          if 0 <= ny < h and 0 <= nx < w and is_free((ny, nx), cur_grid):\n              # Check that we can perform a dummy turn: the cell opposite to the target\n              # (i.e., one step further away) must be free so we can step away\n              # and back to set direction without colliding.\n              opp = {\n                  DOWN: (ny + 1, nx),\n                  UP: (ny - 1, nx),\n                  RIGHT: (ny, nx + 1),\n                  LEFT: (ny, nx - 1)\n              }[face_act]\n              oy, ox = opp\n              if 0 <= oy < h and 0 <= ox < w and is_free((oy, ox), cur_grid):\n                  return (ny, nx), face_act\n      # Fallback: any free neighbour without dummy\u2011turn guarantee\n      for (ny, nx), face_act in candidates:\n          if 0 <= ny < h and 0 <= nx < w and is_free((ny, nx), cur_grid):\n              return (ny, nx), face_act\n      # If no free neighbour, return None (should not happen for reachable items)\n      return None, None\n\n  # ------------------------------------------------------------------\n  # Identify the recipe for ``arrow`` and the required primitives\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed_prims = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = world.cookbook.index.index(workshop_name) if workshop_name else None\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the needed number of times\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed_prims.items():\n      for _ in range(cnt):\n          target = find_nearest(prim_idx, cur_pos, grid)\n          if target is None:\n              # Primitive missing \u2013 abort planning.\n              return actions\n\n          # Choose a free adjacent cell to stand on and a facing action.\n          adj, face_act = choose_adjacent(target, grid)\n          if adj is None:\n              # No accessible adjacent cell \u2013 abort.\n              return actions\n\n          # Move to the adjacent cell.\n          actions += bfs_path(cur_pos, adj, grid)\n          cur_pos = adj\n\n          # Perform a dummy turn: step away opposite direction then back.\n          # This guarantees the final direction faces the target.\n          # Determine the opposite direction of ``face_act``.\n          opposite = {DOWN: UP, UP: DOWN, LEFT: RIGHT, RIGHT: LEFT}[face_act]\n          # Compute the cell one step opposite from current position.\n          dy_op, dx_op = {\n              DOWN: (-1, 0), UP: (1, 0),\n              LEFT: (0, 1), RIGHT: (0, -1)\n          }[face_act]\n          opp_cell = (cur_pos[0] + dy_op, cur_pos[1] + dx_op)\n          # Verify the opposite cell is free (it should be, as checked earlier).\n          if is_free(opp_cell, grid):\n              actions.append(opposite)          # move away\n              actions.append(face_act)          # move back, now facing target\n              cur_pos = adj  # back to original adjacent cell\n          else:\n              # If we cannot step away, just issue the facing action\n              # (may move onto the primitive cell but we accept it).\n              actions.append(face_act)\n              # Update position if we actually moved onto a free cell.\n              dy_f, dx_f = {\n                  DOWN: (1, 0), UP: (-1, 0),\n                  LEFT: (0, -1), RIGHT: (0, 1)\n              }[face_act]\n              new_pos = (cur_pos[0] + dy_f, cur_pos[1] + dx_f)\n              if 0 <= new_pos[0] < grid.shape[0] and 0 <= new_pos[1] < grid.shape[1] and is_free(new_pos, grid):\n                  cur_pos = new_pos\n\n          # Use action to pick up the primitive.\n          actions.append(USE)\n\n          # Update local grid copy: remove the collected primitive.\n          grid[target[0], target[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_cell = find_nearest(workshop_idx, cur_pos, grid)\n      if ws_cell is not None:\n          actions += bfs_path(cur_pos, ws_cell, grid)\n          cur_pos = ws_cell\n\n  # Final USE action to trigger crafting at the workshop (or anywhere if no workshop)\n  actions.append(USE)\n\n  return actions", "env_interactions": 25, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T22:36:59.868157", "function_name": "make_arrow", "function_body": "  # Reset environment and get initial state information\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  # Work on a mutable copy of the grid so we can update it after pickups\n  grid = np.copy(state.grid)\n\n  # Action identifiers (as defined in CraftLab.action_specs)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def is_blocked(y, x):\n      \"\"\"Return True if cell (y, x) contains any entity (including primitives).\"\"\"\n      return np.any(grid[y, x, :] > 0)\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) for the shortest\n      path from start to goal avoiding blocked cells. Empty list if no path.\"\"\"\n      if start == goal:\n          return []\n      h, w = grid.shape[:2]\n      q = collections.deque([start])\n      prev = {start: None}\n      while q:\n          y, x = q.popleft()\n          for dy, dx, act in ((1, 0, DOWN), (-1, 0, UP),\n                              (0, 1, RIGHT), (0, -1, LEFT)):\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < h and 0 <= nx < w and not is_blocked(ny, nx):\n                  if (ny, nx) not in prev:\n                      prev[(ny, nx)] = (y, x, act)\n                      if (ny, nx) == goal:\n                          # reconstruct actions\n                          actions = []\n                          cur = (ny, nx)\n                          while prev[cur] is not None:\n                              py, px, a = prev[cur]\n                              actions.append(a)\n                              cur = (py, px)\n                          actions.reverse()\n                          return actions\n                      q.append((ny, nx))\n      return []  # no path found\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Locate the nearest cell containing the given kind index.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return tuple(nearest)\n\n  # ------------------------------------------------------------------\n  # Determine which primitives are needed for an ``arrow``\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the required number of times\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive missing \u2013 abort planning.\n              return actions\n          ty, tx = target\n\n          # Choose a free adjacent cell to stand on before using.\n          adj = None\n          adj_facing = None\n          for ny, nx, facing in (\n              (ty - 1, tx, DOWN),   # stand above, face down\n              (ty + 1, tx, UP),     # stand below, face up\n              (ty, tx - 1, RIGHT),  # stand left, face right\n              (ty, tx + 1, LEFT)    # stand right, face left\n          ):\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1] and not is_blocked(ny, nx):\n                  adj = (ny, nx)\n                  adj_facing = facing\n                  break\n\n          if adj is None:\n              # No free neighbour \u2013 stand on the primitive cell itself.\n              adj = (ty, tx)\n              adj_facing = None\n\n          # Move to the chosen adjacent cell.\n          actions += bfs_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Adjust facing direction if a preferred orientation exists.\n          if adj_facing is not None:\n              actions.append(adj_facing)\n\n          # Pick up the primitive.\n          actions.append(USE)\n\n          # Update local grid copy: remove the collected primitive.\n          grid[ty, tx, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Move to the appropriate workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      ws_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(ws_idx, cur_pos)\n      if ws_cell is not None:\n          actions += bfs_path(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # Final USE to trigger crafting.\n  actions.append(USE)\n\n  return actions", "env_interactions": 29, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T22:37:24.043512", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n\n  # Index of the goal item \"arrow\"\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:\n      return []\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  deltas = {\n      0: (0, 1),   # DOWN\n      1: (0, -1),  # UP\n      2: (-1, 0),  # LEFT\n      3: (1, 0),   # RIGHT\n  }\n\n  def walkable(grid, x, y):\n      \"\"\"Return True if (x, y) is inside the grid and contains no entities.\"\"\"\n      W, H = grid.shape[:2]\n      if not (0 <= x < W and 0 <= y < H):\n          return False\n      return not np.any(grid[x, y, :])\n\n  from collections import deque\n\n  def bfs_to_target(cur_state, target_kind):\n      \"\"\"\n      Bread\u2011first search that returns a list of movement actions (0\u20113)\n      ending with the agent facing a cell that contains `target_kind`.\n      Returns [] if already facing the target or if unreachable.\n      \"\"\"\n      grid = cur_state.grid\n      W, H = grid.shape[:2]\n      sx, sy = cur_state.pos\n      sdir = cur_state.dir\n      queue = deque()\n      queue.append((sx, sy, sdir, []))\n      visited = {(sx, sy, sdir)}\n\n      while queue:\n          x, y, d, acts = queue.popleft()\n          dx, dy = deltas[d]\n          fx, fy = x + dx, y + dy\n          if 0 <= fx < W and 0 <= fy < H and grid[fx, fy, target_kind] > 0:\n              return acts\n          for a in (0, 1, 2, 3):\n              ndx, ndy = deltas[a]\n              nx, ny = x + ndx, y + ndy\n              if not walkable(grid, nx, ny):\n                  continue\n              if (nx, ny, a) in visited:\n                  continue\n              visited.add((nx, ny, a))\n              queue.append((nx, ny, a, acts + [a]))\n      return []\n\n  def target_ahead(cur_state, kind):\n      \"\"\"True if the cell directly in front of the agent contains `kind`.\"\"\"\n      x, y = cur_state.pos\n      d = cur_state.dir\n      dx, dy = deltas[d]\n      fx, fy = x + dx, y + dy\n      W, H = cur_state.grid.shape[:2]\n      return (0 <= fx < W and 0 <= fy < H and cur_state.grid[fx, fy, kind] > 0)\n\n  # ------------------------------------------------------------------\n  # Planning\n  # ------------------------------------------------------------------\n  actions = []\n\n  # 1) Gather all primitive resources needed for a single arrow\n  primitive_needs = world.cookbook.primitives_for(arrow_idx)  # {kind_idx: count}\n  for prim_idx, cnt in primitive_needs.items():\n      for _ in range(cnt):\n          move_seq = bfs_to_target(state, prim_idx)\n          if not move_seq and not target_ahead(state, prim_idx):\n              # Primitive unreachable \u2013 abort planning\n              return actions\n          actions.extend(move_seq)\n          actions.append(4)  # USE to pick up / interact\n          # Simulate actions to keep internal state up\u2011to\u2011date\n          for a in move_seq + [4]:\n              _, state = state.step(a)\n\n  # 2) Craft the arrow at its required workshop (if any)\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      move_seq = bfs_to_target(state, workshop_idx)\n      if not move_seq and not target_ahead(state, workshop_idx):\n          # Workshop unreachable \u2013 still attempt a USE (harmless)\n          actions.append(4)\n          _, state = state.step(4)\n      else:\n          actions.extend(move_seq)\n          actions.append(4)  # USE to craft\n          for a in move_seq + [4]:\n              _, state = state.step(a)\n  else:\n      # No dedicated workshop \u2013 craft in place\n      actions.append(4)\n      _, state = state.step(4)\n\n  return actions", "env_interactions": 26, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T22:37:25.197636", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n\n  # Index of the goal item \"arrow\"\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:\n      return []\n\n  # Action \u2192 (dx, dy) mapping (DOWN,UP,LEFT,RIGHT)\n  deltas = {0: (0, 1), 1: (0, -1), 2: (-1, 0), 3: (1, 0)}\n\n  def walkable(grid, x, y):\n      \"\"\"Return True if (x,y) is inside the grid and has no entities.\"\"\"\n      W, H = grid.shape[:2]\n      if not (0 <= x < W and 0 <= y < H):\n          return False\n      return not np.any(grid[x, y, :])\n\n  from collections import deque\n\n  def bfs_to_target(state, target_kind):\n      \"\"\"\n      Bread\u2011first search that returns a list of movement actions (0\u20113)\n      ending with the agent facing a cell containing `target_kind`.\n      Returns [] if already facing the target or if unreachable.\n      \"\"\"\n      grid = state.grid\n      W, H = grid.shape[:2]\n      sx, sy = state.pos\n      sdir = state.dir\n      queue = deque()\n      queue.append((sx, sy, sdir, []))\n      visited = {(sx, sy, sdir)}\n\n      while queue:\n          x, y, d, acts = queue.popleft()\n          dx, dy = deltas[d]\n          fx, fy = x + dx, y + dy\n          if 0 <= fx < W and 0 <= fy < H and grid[fx, fy, target_kind] > 0:\n              return acts\n          for a in (0, 1, 2, 3):\n              ndx, ndy = deltas[a]\n              nx, ny = x + ndx, y + ndy\n              if not walkable(grid, nx, ny):\n                  continue\n              if (nx, ny, a) in visited:\n                  continue\n              visited.add((nx, ny, a))\n              queue.append((nx, ny, a, acts + [a]))\n      return []\n\n  def target_ahead(state, kind):\n      \"\"\"True if the cell directly in front of the agent contains `kind`.\"\"\"\n      x, y = state.pos\n      d = state.dir\n      dx, dy = deltas[d]\n      fx, fy = x + dx, y + dy\n      W, H = state.grid.shape[:2]\n      return (0 <= fx < W and 0 <= fy < H and state.grid[fx, fy, kind] > 0)\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # 1) Gather all primitive resources needed for a single arrow.\n  # ------------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(arrow_idx)\n  if not primitive_needs:\n      primitive_needs = {arrow_idx: 1}   # arrow itself is a primitive\n\n  for prim_idx, cnt in primitive_needs.items():\n      for _ in range(cnt):\n          move_seq = bfs_to_target(state, prim_idx)\n          if not move_seq and not target_ahead(state, prim_idx):\n              # Primitive unreachable \u2013 abort planning.\n              return actions\n          actions.extend(move_seq)\n          actions.append(4)  # USE to pick up / interact\n          for a in move_seq + [4]:\n              _, state = state.step(a)\n\n  # ------------------------------------------------------------------\n  # 2) Craft the arrow at its workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      move_seq = bfs_to_target(state, workshop_idx)\n      if not move_seq and not target_ahead(state, workshop_idx):\n          # Workshop unreachable \u2013 still try a USE (harmless failure).\n          actions.append(4)\n          _, state = state.step(4)\n      else:\n          actions.extend(move_seq)\n          actions.append(4)  # USE to craft\n          for a in move_seq + [4]:\n              _, state = state.step(a)\n  else:\n      # No dedicated workshop \u2013 craft in place.\n      actions.append(4)\n      _, state = state.step(4)\n\n  return actions", "env_interactions": 26, "island_id": 9, "scores": {"3": 0.5}}
