{"timestamp": "2025-10-28T20:58:46.522472", "function_name": "make_arrow", "function_body": "  import numpy as np\n  import collections\n\n  # Action identifiers \u2013 match the default CraftWorld ordering.\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  MOVE_DELTAS = {\n      DOWN: (0, 1),\n      UP: (0, -1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  def _bfs_adjacent(start, targets, occupied):\n      \"\"\"Return a list of actions moving from `start` to a cell adjacent to any target.\"\"\"\n      width, height = occupied.shape\n      target_set = set(targets)\n\n      # Already adjacent?\n      for tx, ty in target_set:\n          if abs(start[0] - tx) + abs(start[1] - ty) == 1:\n              return []\n\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n\n      while q:\n          x, y, path = q.popleft()\n          for act, (dx, dy) in MOVE_DELTAS.items():\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              if occupied[nx, ny]:\n                  continue\n              visited.add((nx, ny))\n              new_path = path + [act]\n              for tx, ty in target_set:\n                  if abs(nx - tx) + abs(ny - ty) == 1:\n                      return new_path\n              q.append((nx, ny, new_path))\n      return []  # No reachable adjacent cell\n\n  # ----------------------------------------------------------------------\n  # Retrieve world / state objects from the environment.\n  # ----------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n      world = state.world\n  else:\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n\n  cookbook = world.cookbook\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # ----------------------------------------------------------------------\n  # Determine primitive requirements for a single arrow.\n  # ----------------------------------------------------------------------\n  primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n  if not primitives_needed:\n      return []\n\n  # ----------------------------------------------------------------------\n  # Current grid, position and occupancy mask.\n  # ----------------------------------------------------------------------\n  grid = state.grid                     # (W, H, n_kinds)\n  pos = tuple(state.pos)                # (x, y)\n  occupied = np.any(grid > 0, axis=2)   # True where any entity exists\n\n  actions = []\n  harvested = set()                     # Cells already collected from\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first).\n  # ----------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      gathered = 0\n      while gathered < needed_cnt:\n          # Locate all cells that currently contain this primitive.\n          prim_locs = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n          prim_locs = [loc for loc in prim_locs if loc not in harvested]\n          if not prim_locs:\n              break  # cannot find more of this primitive\n\n          # Choose the nearest one (Manhattan distance).\n          prim_locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target = prim_locs[0]\n\n          # Plan a path to a cell adjacent to the primitive.\n          path = _bfs_adjacent(pos, [target], occupied)\n          actions.extend(path)\n\n          # Simulate movement.\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Pick up the primitive.\n          actions.append(USE)\n          harvested.add(target)\n          gathered += 1\n\n          # Update occupancy mask (the cell becomes empty after pickup).\n          occupied[target] = False\n\n  # ----------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any).\n  # ----------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index.\n      if isinstance(workshop_key, str):\n          workshop_idx = cookbook.index[workshop_key]\n      else:\n          workshop_idx = workshop_key\n      # Find workshop locations.\n      ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if ws_cells:\n          ws_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          ws_target = ws_cells[0]\n          path = _bfs_adjacent(pos, [ws_target], occupied)\n          actions.extend(path)\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(USE)\n      else:\n          # No workshop found; attempt to use current location.\n          actions.append(USE)\n  else:\n      # No specific workshop required.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T20:58:47.672775", "function_name": "make_arrow", "function_body": "  import numpy as np\n  import collections\n\n  # ----------------------------------------------------------------------\n  # Action identifiers (match CraftWorld defaults)\n  # ----------------------------------------------------------------------\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  MOVE_DELTAS = {\n      DOWN: (0, 1),\n      UP: (0, -1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS returning a list of actions that moves the agent from\n  # `start` to a cell adjacent (Manhattan distance = 1) to any cell in\n  # `targets`.  Cells occupied by any entity are treated as blocked.\n  # ----------------------------------------------------------------------\n  def _bfs_adjacent(start, targets, occupied):\n      width, height = occupied.shape\n      target_set = set(targets)\n\n      # Already adjacent?\n      for tx, ty in target_set:\n          if abs(start[0] - tx) + abs(start[1] - ty) == 1:\n              return []\n\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n\n      while q:\n          x, y, path = q.popleft()\n          for act, (dx, dy) in MOVE_DELTAS.items():\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              if occupied[nx, ny]:\n                  continue\n              visited.add((nx, ny))\n              new_path = path + [act]\n              for tx, ty in target_set:\n                  if abs(nx - tx) + abs(ny - ty) == 1:\n                      return new_path\n              q.append((nx, ny, new_path))\n      return []  # unreachable\n\n  # ----------------------------------------------------------------------\n  # Retrieve world / state objects from the environment (handle wrappers)\n  # ----------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n      world = state.world\n  else:\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n\n  cookbook = world.cookbook\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # ----------------------------------------------------------------------\n  # Determine primitive requirements for a single arrow\n  # ----------------------------------------------------------------------\n  primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n  if not primitives_needed:\n      # Arrow itself is a primitive \u2013 nothing to collect or craft\n      return []\n\n  # ----------------------------------------------------------------------\n  # Current grid, position and occupancy mask\n  # ----------------------------------------------------------------------\n  grid = state.grid                     # (W, H, n_kinds)\n  pos = tuple(state.pos)                # (x, y)\n  occupied = np.any(grid > 0, axis=2)   # True where any entity exists\n\n  actions = []\n  harvested = set()                     # cells already collected from\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first)\n  # ----------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      gathered = 0\n      while gathered < needed_cnt:\n          # Locate all cells that currently contain this primitive\n          prim_cells = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n          prim_cells = [c for c in prim_cells if c not in harvested]\n          if not prim_cells:\n              # No more of this primitive on the map \u2013 give up on this type\n              break\n\n          # Choose the nearest primitive (Manhattan distance)\n          prim_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          target = prim_cells[0]\n\n          # Plan a path to a cell adjacent to the primitive\n          path = _bfs_adjacent(pos, [target], occupied)\n          actions.extend(path)\n\n          # Simulate movement to update position\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Pick up the primitive\n          actions.append(USE)\n          harvested.add(target)\n          gathered += 1\n\n          # Update occupancy mask (cell becomes empty after pickup)\n          occupied[target] = False\n\n  # ----------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any)\n  # ----------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (could be a name or an integer)\n      workshop_idx = (\n          cookbook.index[workshop_key]\n          if isinstance(workshop_key, str)\n          else workshop_key\n      )\n      ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if ws_cells:\n          ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          ws_target = ws_cells[0]\n          path = _bfs_adjacent(pos, [ws_target], occupied)\n          actions.extend(path)\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(USE)\n      else:\n          # No workshop found \u2013 attempt to use current cell\n          actions.append(USE)\n  else:\n      # No specific workshop required\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T20:59:16.486322", "function_name": "make_arrow", "function_body": "  import numpy as np\n  import collections\n\n  # Action indices used by CraftWorld\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving the agent from\n  # `start` to a cell adjacent (Manhattan distance == 1) to any of\n  # `targets`.  Cells with any non\u2011zero kind are treated as obstacles.\n  # ------------------------------------------------------------------\n  def _bfs_path(start, targets, grid):\n      w, h, _ = grid.shape\n      occupied = np.any(grid > 0, axis=2)          # blocked cells\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # Stop when adjacent to a target.\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n          # Expand 4\u2011connected neighbours.\n          for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # No reachable path.\n      return []\n\n  # ------------------------------------------------------------------\n  # Locate the underlying CraftWorld and its cookbook.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Some wrappers expose the world via the current state.\n      state_tmp = getattr(env, \"_current_state\", None)\n      if state_tmp is not None:\n          world = state_tmp.world\n  if world is None:\n      raise RuntimeError(\"Unable to locate CraftWorld instance from the environment.\")\n\n  cookbook = world.cookbook\n\n  # Goal is hard\u2011coded to \"arrow\".\n  goal_idx = cookbook.index[\"arrow\"]\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Ensure we have a fresh state (reset if necessary).\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  # Current position and a mutable copy of the grid for planning.\n  pos = tuple(state.pos)                # (x, y)\n  cur_grid = state.grid.copy()          # (W, H, n_kinds)\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (nearest\u2011first, handling counts).\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      while needed > 0:\n          # Find all cells that currently hold this primitive.\n          locations = [tuple(p) for p in np.argwhere(cur_grid[:, :, prim_idx] > 0)]\n          if not locations:\n              # No more instances on the map \u2013 cannot satisfy requirement.\n              break\n          # Choose the closest one.\n          locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_loc = locations[0]\n\n          # Move adjacent to the primitive.\n          path = _bfs_path(pos, [target_loc], cur_grid)\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n\n          # Pick up as many as needed from this cell.\n          while needed > 0 and cur_grid[target_loc[0], target_loc[1], prim_idx] > 0:\n              actions.append(USE)\n              cur_grid[target_loc[0], target_loc[1], prim_idx] -= 1\n              needed -= 1\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (may be a name or already an int).\n      workshop_idx = (cookbook.index[workshop_key]\n                      if isinstance(workshop_key, str)\n                      else int(workshop_key))\n      # Find all workshop cells.\n      workshop_cells = [tuple(p) for p in np.argwhere(cur_grid[:, :, workshop_idx] > 0)]\n      if workshop_cells:\n          workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = workshop_cells[0]\n          # Move adjacent to the workshop.\n          path = _bfs_path(pos, [target_ws], cur_grid)\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n  # Use (craft) at the current location.\n  actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T20:59:17.624389", "function_name": "make_arrow", "function_body": "  # Action indices used by CraftWorld\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving the agent from\n  # `start` to a cell adjacent (Manhattan distance \u2264 1) to any coordinate\n  # in `targets`. Cells that contain any non\u2011zero entity are treated as\n  # obstacles.\n  # ------------------------------------------------------------------\n  def _bfs_path(start, targets, grid):\n      w, h, _ = grid.shape\n      occupied = np.any(grid > 0, axis=2)      # blocked cells\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # Stop when we are adjacent to a target.\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) <= 1:\n                  return path\n          # Expand 4\u2011connected neighbours.\n          for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # No reachable path.\n      return []\n\n  # ------------------------------------------------------------------\n  # Locate the underlying CraftWorld instance and its cookbook.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Some wrappers expose the world via the current state.\n      state_tmp = getattr(env, \"_current_state\", None)\n      if state_tmp is not None:\n          world = state_tmp.world\n  if world is None:\n      raise RuntimeError(\"Unable to locate CraftWorld instance from the environment.\")\n\n  cookbook = world.cookbook\n\n  # Goal is hard\u2011coded to \"arrow\".\n  goal_idx = cookbook.index[\"arrow\"]\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Ensure we have a fresh state (reset if necessary).\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  # Current position and a mutable copy of the grid for planning.\n  pos = tuple(state.pos)                # (x, y)\n  cur_grid = state.grid.copy()          # (W, H, n_kinds)\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (nearest\u2011first, handling counts).\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      while needed > 0:\n          # Locate all cells that currently hold this primitive.\n          locations = [tuple(p) for p in np.argwhere(cur_grid[:, :, prim_idx] > 0)]\n          if not locations:\n              # No more instances on the map \u2013 cannot satisfy requirement.\n              break\n          # Choose the closest one (Manhattan distance).\n          locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_loc = locations[0]\n\n          # Move adjacent to the primitive.\n          path = _bfs_path(pos, [target_loc], cur_grid)\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n\n          # Pick up as many as needed from this cell.\n          while needed > 0 and cur_grid[target_loc[0], target_loc[1], prim_idx] > 0:\n              actions.append(USE)\n              cur_grid[target_loc[0], target_loc[1], prim_idx] -= 1\n              needed -= 1\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (may be a name or already an int).\n      workshop_idx = (cookbook.index[workshop_key]\n                      if isinstance(workshop_key, str)\n                      else int(workshop_key))\n      # Find all workshop cells.\n      workshop_cells = [tuple(p) for p in np.argwhere(cur_grid[:, :, workshop_idx] > 0)]\n      if workshop_cells:\n          workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = workshop_cells[0]\n          # Move adjacent to the workshop.\n          path = _bfs_path(pos, [target_ws], cur_grid)\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n  # Use (craft) at the current location.\n  actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T20:59:51.920869", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action identifiers \u2013 must match CraftWorld ordering.\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  MOVE_DELTAS = {DOWN: (0, 1), UP: (0, -1), LEFT: (-1, 0), RIGHT: (1, 0)}\n\n  def _bfs_adjacent(start, targets, occupied):\n      \"\"\"Return a list of actions moving from `start` to a cell adjacent to any `targets`.\"\"\"\n      w, h = occupied.shape\n      target_set = set(targets)\n\n      # Already adjacent?\n      for tx, ty in target_set:\n          if abs(start[0] - tx) + abs(start[1] - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      while q:\n          x, y, path = q.popleft()\n          for act, (dx, dy) in MOVE_DELTAS.items():\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < w and 0 <= ny < h):\n                  continue\n              if (nx, ny) in visited or occupied[nx, ny]:\n                  continue\n              new_path = path + [act]\n              for tx, ty in target_set:\n                  if abs(nx - tx) + abs(ny - ty) == 1:\n                      return new_path\n              visited.add((nx, ny))\n              q.append((nx, ny, new_path))\n      return []  # unreachable\n\n  # ------------------------------------------------------------------\n  # Retrieve current state / world objects from the environment.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # env is likely a CraftLab \u2013 state stored in _current_state.\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n      world = state.world\n  else:\n      # env is a CraftWorld / CraftScenario \u2013 ensure we have a state.\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n\n  cookbook = world.cookbook\n  goal_idx = cookbook.index[\"arrow\"]\n\n  # ------------------------------------------------------------------\n  # Determine primitive requirements for a single arrow.\n  # ------------------------------------------------------------------\n  primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n  if not primitives_needed:\n      return []\n\n  # ------------------------------------------------------------------\n  # Current grid, agent position and occupancy mask.\n  # ------------------------------------------------------------------\n  grid = state.grid                     # (W, H, n_kinds)\n  pos = tuple(state.pos)                # (x, y)\n  occupied = np.any(grid > 0, axis=2)   # True where any entity occupies the cell\n\n  actions = []\n  harvested = set()                     # cells already collected from\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first).\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      gathered = 0\n      while gathered < needed_cnt:\n          # Locate all cells containing this primitive and not yet harvested.\n          cells = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)\n                   if tuple(p) not in harvested]\n          if not cells:\n              break  # no more of this primitive available\n\n          # Choose the closest cell (Manhattan distance).\n          cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          target = cells[0]\n\n          # Plan a path to a cell adjacent to the target.\n          path = _bfs_adjacent(pos, [target], occupied)\n          actions.extend(path)\n\n          # Simulate movement to keep `pos` up\u2011to\u2011date.\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Pick up the primitive.\n          actions.append(USE)\n          harvested.add(target)\n          gathered += 1\n\n          # Update occupancy mask \u2013 the cell becomes empty after pickup.\n          occupied[target] = False\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (string name or already an int).\n      workshop_idx = cookbook.index[workshop_key] if isinstance(workshop_key, str) else workshop_key\n      ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if ws_cells:\n          ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          ws_target = ws_cells[0]\n          path = _bfs_adjacent(pos, [ws_target], occupied)\n          actions.extend(path)\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(USE)\n      else:\n          # No workshop visible \u2013 try to use current cell.\n          actions.append(USE)\n  else:\n      # No specific workshop required.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T20:59:53.092228", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  MOVE_DELTAS = {DOWN: (0, 1), UP: (0, -1), LEFT: (-1, 0), RIGHT: (1, 0)}\n\n  def _bfs_adjacent(start, targets, occupied):\n      w, h = occupied.shape\n      target_set = set(targets)\n      for tx, ty in target_set:\n          if abs(start[0] - tx) + abs(start[1] - ty) == 1:\n              return []\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      while q:\n          x, y, path = q.popleft()\n          for act, (dx, dy) in MOVE_DELTAS.items():\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < w and 0 <= ny < h):\n                  continue\n              if (nx, ny) in visited or occupied[nx, ny]:\n                  continue\n              new_path = path + [act]\n              for tx, ty in target_set:\n                  if abs(nx - tx) + abs(ny - ty) == 1:\n                      return new_path\n              visited.add((nx, ny))\n              q.append((nx, ny, new_path))\n      return []\n\n  world = getattr(env, \"world\", None)\n  if world is None:\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n      world = state.world\n  else:\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n\n  cookbook = world.cookbook\n  goal_idx = cookbook.index[\"arrow\"]\n  primitives_needed = cookbook.primitives_for(goal_idx)\n  if not primitives_needed:\n      return []\n\n  grid = state.grid\n  pos = tuple(state.pos)\n  occupied = np.any(grid > 0, axis=2)\n\n  actions = []\n  harvested = set()\n\n  for prim_idx, needed_cnt in primitives_needed.items():\n      gathered = 0\n      while gathered < needed_cnt:\n          cells = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0) if tuple(p) not in harvested]\n          if not cells:\n              break\n          cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          target = cells[0]\n          path = _bfs_adjacent(pos, [target], occupied)\n          actions.extend(path)\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(USE)\n          harvested.add(target)\n          gathered += 1\n          occupied[target] = False\n\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      workshop_idx = cookbook.index[workshop_key] if isinstance(workshop_key, str) else workshop_key\n      ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if ws_cells:\n          ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          ws_target = ws_cells[0]\n          path = _bfs_adjacent(pos, [ws_target], occupied)\n          actions.extend(path)\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(USE)\n      else:\n          actions.append(USE)\n  else:\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T21:00:11.765357", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  # target item\n  target_name = \"arrow\"\n  target_idx = cookbook.index[target_name]\n\n  # copies of mutable state\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n  width, height, _ = grid.shape\n  actions = []\n\n  from collections import deque\n\n  def bfs(start, goals):\n      \"\"\"Shortest path (list of actions) from start to any goal cell.\"\"\"\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          cur, path = q.popleft()\n          if cur in goals:\n              return path\n          x, y = cur\n          for dx, dy, act in [(0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)]:  # DOWN,UP,LEFT,RIGHT\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              nxt = (nx, ny)\n              if nxt in visited:\n                  continue\n              # treat occupied cells as obstacles unless they are a goal\n              if np.any(grid[nx, ny, :]) and nxt not in goals:\n                  continue\n              visited.add(nxt)\n              q.append((nxt, path + [act]))\n      return None\n\n  def move_along(path):\n      \"\"\"Update pos according to a list of movement actions.\"\"\"\n      nonlocal pos\n      for a in path:\n          if a == 0:   # DOWN\n              pos = (pos[0], pos[1] + 1)\n          elif a == 1: # UP\n              pos = (pos[0], pos[1] - 1)\n          elif a == 2: # LEFT\n              pos = (pos[0] - 1, pos[1])\n          elif a == 3: # RIGHT\n              pos = (pos[0] + 1, pos[1])\n\n  def collect_primitive(prim_idx, amount):\n      \"\"\"Collect `amount` units of primitive `prim_idx` from the grid.\"\"\"\n      nonlocal actions, grid, inventory, pos\n      while amount > 0:\n          locations = [(x, y) for x in range(width) for y in range(height)\n                       if grid[x, y, prim_idx] > 0]\n          if not locations:\n              break  # none left\n          path = None\n          target = None\n          for loc in locations:\n              cand = bfs(pos, {loc})\n              if cand is not None:\n                  path, target = cand, loc\n                  break\n          if path is None:\n              break  # unreachable\n          actions.extend(path)\n          move_along(path)\n          actions.append(4)          # USE to pick up\n          grid[target[0], target[1], prim_idx] = 0\n          inventory[prim_idx] += 1\n          amount -= 1\n\n  recipes = cookbook.recipes\n  primitives_set = cookbook.primitives\n\n  def ensure_item(item_idx, need):\n      \"\"\"Make sure inventory[item_idx] >= need by collecting/crafting.\"\"\"\n      nonlocal actions, grid, inventory, pos\n      while inventory[item_idx] < need:\n          if item_idx in primitives_set:\n              collect_primitive(item_idx, need - inventory[item_idx])\n              continue\n\n          recipe = recipes.get(item_idx, {})\n          # first satisfy all ingredient requirements\n          for ing_idx, cnt in list(recipe.items()):\n              if ing_idx == \"_at\":\n                  continue\n              if inventory[ing_idx] < cnt:\n                  ensure_item(ing_idx, cnt)\n\n          # move to workshop if required\n          workshop = recipe.get(\"_at\")\n          if workshop is not None:\n              ws_idx = workshop if isinstance(workshop, int) else cookbook.index[workshop]\n              ws_cells = [(x, y) for x in range(width) for y in range(height)\n                          if grid[x, y, ws_idx] > 0]\n              if ws_cells:\n                  path = bfs(pos, {ws_cells[0]})\n                  if path:\n                      actions.extend(path)\n                      move_along(path)\n\n          # craft the item\n          actions.append(4)  # USE at workshop or current cell\n          for ing_idx, cnt in recipe.items():\n              if ing_idx == \"_at\":\n                  continue\n              inventory[ing_idx] -= cnt\n          inventory[item_idx] += 1\n\n  # Build the arrow\n  ensure_item(target_idx, 1)\n\n  return actions", "env_interactions": 41, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T21:00:12.941633", "function_name": "make_arrow", "function_body": "  # --------------------------------------------------------------\n  # Basic references\n  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  # target item (arrow)\n  target_idx = cookbook.index[\"arrow\"]\n\n  # local copies of mutable state\n  grid = state.grid.copy()\n  pos = tuple(state.pos)                 # (x, y)\n  inventory = state.inventory.copy()\n  width, height, _ = grid.shape\n  actions = []                            # final action sequence\n\n  # --------------------------------------------------------------\n  # Utility: BFS on the grid returning a list of movement actions\n  from collections import deque\n\n  def bfs(start, goals):\n      \"\"\"Shortest path (as action indices) from *start* to any cell in *goals*.\n      Cells that contain any entity are treated as blocked, unless the cell\n      itself is a goal cell.\"\"\"\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          cur, path = q.popleft()\n          if cur in goals:\n              return path\n          x, y = cur\n          for dx, dy, act in [(0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)]:   # DOWN,UP,LEFT,RIGHT\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              nxt = (nx, ny)\n              if nxt in visited:\n                  continue\n              # block if occupied (any non\u2011zero kind) unless it is a goal cell\n              if np.any(grid[nx, ny, :]) and nxt not in goals:\n                  continue\n              visited.add(nxt)\n              q.append((nxt, path + [act]))\n      return None\n\n  def apply_path(path):\n      \"\"\"Update *pos* according to a movement *path*.\"\"\"\n      nonlocal pos\n      for a in path:\n          if a == 0:   # DOWN\n              pos = (pos[0], pos[1] + 1)\n          elif a == 1: # UP\n              pos = (pos[0], pos[1] - 1)\n          elif a == 2: # LEFT\n              pos = (pos[0] - 1, pos[1])\n          elif a == 3: # RIGHT\n              pos = (pos[0] + 1, pos[1])\n\n  # --------------------------------------------------------------\n  # Primitive collection\n  def collect_primitive(kind_idx, amount):\n      \"\"\"Collect *amount* units of primitive *kind_idx* from the grid.\"\"\"\n      nonlocal actions, grid, inventory, pos\n      while amount > 0:\n          # locate all remaining cells containing the primitive\n          cells = [(x, y) for x in range(width) for y in range(height)\n                   if grid[x, y, kind_idx] > 0]\n          if not cells:\n              break          # nothing left \u2013 should not happen for solvable tasks\n          # find the nearest reachable cell\n          path = None\n          target = None\n          for c in cells:\n              cand = bfs(pos, {c})\n              if cand is not None:\n                  path, target = cand, c\n                  break\n          if path is None:\n              break          # cannot reach any remaining primitive\n          actions.extend(path)\n          apply_path(path)\n          # pick it up\n          actions.append(4)   # USE\n          grid[target[0], target[1], kind_idx] = 0\n          inventory[kind_idx] += 1\n          amount -= 1\n\n  # --------------------------------------------------------------\n  # Recursive crafting helper\n  recipes = cookbook.recipes\n  primitives = cookbook.primitives\n\n  def ensure_item(item_idx, needed):\n      \"\"\"Make sure *inventory[item_idx]* >= *needed* (collect/craft).\"\"\"\n      nonlocal actions, grid, inventory, pos\n      while inventory[item_idx] < needed:\n          if item_idx in primitives:\n              # primitive \u2013 just collect the missing amount\n              collect_primitive(item_idx, needed - inventory[item_idx])\n              continue\n\n          # otherwise we need to craft the item\n          recipe = recipes.get(item_idx, {})\n          # first, guarantee all ingredients are present\n          for ing_idx, cnt in list(recipe.items()):\n              if ing_idx == \"_at\":\n                  continue\n              if inventory[ing_idx] < cnt:\n                  ensure_item(ing_idx, cnt)\n\n          # move to the required workshop (if any)\n          workshop = recipe.get(\"_at\")\n          if workshop is not None:\n              ws_idx = workshop if isinstance(workshop, int) else cookbook.index[workshop]\n              ws_cells = [(x, y) for x in range(width) for y in range(height)\n                          if grid[x, y, ws_idx] > 0]\n              if ws_cells:\n                  path = bfs(pos, {ws_cells[0]})\n                  if path:\n                      actions.extend(path)\n                      apply_path(path)\n\n          # perform the crafting action\n          actions.append(4)   # USE\n          for ing_idx, cnt in recipe.items():\n              if ing_idx == \"_at\":\n                  continue\n              inventory[ing_idx] -= cnt\n          inventory[item_idx] += 1\n\n  # --------------------------------------------------------------\n  # Build the target arrow\n  ensure_item(target_idx, 1)\n\n  return actions", "env_interactions": 41, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T21:00:40.658103", "function_name": "make_arrow", "function_body": "  env.reset()\n  cur_state = env._current_state\n  world = env.world\n\n  # Index of the goal item \"arrow\"\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:\n      return []\n\n  # Direction deltas matching action indices (DOWN, UP, LEFT, RIGHT)\n  deltas = {0: (0, 1), 1: (0, -1), 2: (-1, 0), 3: (1, 0)}\n\n  def walkable(grid, x, y):\n      W, H = grid.shape[:2]\n      if not (0 <= x < W and 0 <= y < H):\n          return False\n      # a cell is walkable if it contains no entities at all\n      return not np.any(grid[x, y, :])\n\n  from collections import deque\n\n  def bfs_to_target(state, target_kind):\n      \"\"\"Return a list of movement actions (0\u20113) that ends with the agent\n      facing a cell containing `target_kind`. Returns None if unreachable.\"\"\"\n      grid = state.grid\n      W, H = grid.shape[:2]\n      sx, sy = state.pos\n      sdir = state.dir\n      queue = deque()\n      queue.append((sx, sy, sdir, []))\n      visited = {(sx, sy, sdir)}\n      while queue:\n          x, y, d, acts = queue.popleft()\n          dx, dy = deltas[d]\n          fx, fy = x + dx, y + dy\n          if 0 <= fx < W and 0 <= fy < H and grid[fx, fy, target_kind] > 0:\n              return acts\n          for a in (0, 1, 2, 3):\n              ndx, ndy = deltas[a]\n              nx, ny = x + ndx, y + ndy\n              if not walkable(grid, nx, ny):\n                  continue\n              if (nx, ny, a) in visited:\n                  continue\n              visited.add((nx, ny, a))\n              queue.append((nx, ny, a, acts + [a]))\n      return None\n\n  # ------------------------------------------------------------------\n  # Collect all primitive resources required for one arrow\n  # ------------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(arrow_idx)  # {kind_idx: count}\n  if not primitive_needs:\n      # Arrow itself is a primitive\n      primitive_needs = {arrow_idx: 1}\n\n  actions = []\n\n  for prim_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          move_seq = bfs_to_target(cur_state, prim_idx)\n          if move_seq is None:\n              # Cannot reach this primitive; abort planning\n              return actions\n          actions.extend(move_seq)\n          actions.append(4)  # USE to pick up\n          for a in move_seq + [4]:\n              _, cur_state = cur_state.step(a)\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any)\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      move_seq = bfs_to_target(cur_state, workshop_idx)\n      if move_seq is None:\n          # Workshop unreachable \u2013 still try a USE (will fail harmlessly)\n          actions.append(4)\n          _, cur_state = cur_state.step(4)\n      else:\n          actions.extend(move_seq)\n          actions.append(4)  # USE to craft\n          for a in move_seq + [4]:\n              _, cur_state = cur_state.step(a)\n  else:\n      # No specific workshop; craft in place\n      actions.append(4)\n      _, cur_state = cur_state.step(4)\n\n  return actions", "env_interactions": 26, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T21:00:41.823130", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Reset the environment and fetch the current state/world.\n  env.reset()\n  state = env._current_state\n  world = env.world\n\n  # Index of the goal item \"arrow\". 0 means not found.\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:\n      return []\n\n  # Action \u2192 (dx, dy) mapping for the four movement actions.\n  deltas = {0: (0, 1), 1: (0, -1), 2: (-1, 0), 3: (1, 0)}\n\n  def walkable(grid, x, y):\n      \"\"\"Return True if (x, y) is inside the map and contains no entities.\"\"\"\n      W, H = grid.shape[:2]\n      if not (0 <= x < W and 0 <= y < H):\n          return False\n      return not np.any(grid[x, y, :])\n\n  def bfs_to_target(cur_state, target_kind):\n      \"\"\"\n      Bread\u2011first search for a sequence of movement actions (0\u20113) that ends\n      with the agent facing a cell containing `target_kind`.  Returns None\n      if no such sequence exists.\n      \"\"\"\n      grid = cur_state.grid\n      W, H = grid.shape[:2]\n      sx, sy = cur_state.pos\n      sdir = cur_state.dir\n      q = deque()\n      q.append((sx, sy, sdir, []))\n      visited = {(sx, sy, sdir)}\n\n      while q:\n          x, y, d, seq = q.popleft()\n          dx, dy = deltas[d]\n          fx, fy = x + dx, y + dy\n          if 0 <= fx < W and 0 <= fy < H and grid[fx, fy, target_kind] > 0:\n              return seq\n          for a in (0, 1, 2, 3):\n              ndx, ndy = deltas[a]\n              nx, ny = x + ndx, y + ndy\n              if not walkable(grid, nx, ny):\n                  continue\n              if (nx, ny, a) in visited:\n                  continue\n              visited.add((nx, ny, a))\n              q.append((nx, ny, a, seq + [a]))\n      return None\n\n  # ------------------------------------------------------------------\n  # Determine which primitive resources are needed for one arrow.\n  # ------------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(arrow_idx)\n  if not primitive_needs:\n      # Arrow itself may be a primitive (no recipe).\n      primitive_needs = {arrow_idx: 1}\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the necessary number of times.\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          move_seq = bfs_to_target(state, prim_idx)\n          if move_seq is None:\n              # Primitive unreachable \u2013 abort planning.\n              return actions\n          actions.extend(move_seq)\n          actions.append(4)  # USE to pick up / interact\n          for a in move_seq + [4]:\n              _, state = state.step(a)\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its designated workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      move_seq = bfs_to_target(state, workshop_idx)\n      if move_seq is None:\n          # Workshop unreachable \u2013 abort planning.\n          return actions\n      actions.extend(move_seq)\n      actions.append(4)  # USE to craft\n      for a in move_seq + [4]:\n          _, state = state.step(a)\n  else:\n      # No specific workshop; craft in place.\n      actions.append(4)\n      _, state = state.step(4)\n\n  return actions", "env_interactions": 26, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T21:01:07.775087", "function_name": "make_arrow", "function_body": "  # Reset the environment and fetch the current state/world.\n  env.reset()\n  state = env._current_state          # CraftState instance\n  world = env.world                    # CraftWorld instance\n  grid = state.grid.copy()             # mutable copy for local bookkeeping\n\n  # Identify the goal item (\"arrow\") and the primitives required to craft it.\n  arrow_idx = world.cookbook.index.index('arrow')\n  required = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  import collections\n\n  non_grab = list(world.non_grabbable_indices)\n\n  def is_blocked(pos):\n      \"\"\"True if ``pos`` contains any non\u2011grabbable entity.\"\"\"\n      y, x = pos\n      return np.any(grid[y, x, non_grab] > 0)\n\n  def bfs_path(start, goal):\n      \"\"\"Shortest walkable path from ``start`` to ``goal`` avoiding blocked cells.\n      Returns a list of positions (excluding ``start``, including ``goal``).\"\"\"\n      if start == goal:\n          return []\n      h, w = grid.shape[:2]\n      q = collections.deque([start])\n      prev = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          y, x = cur\n          for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):\n              if 0 <= ny < h and 0 <= nx < w:\n                  nxt = (ny, nx)\n                  if nxt not in prev and not is_blocked(nxt):\n                      prev[nxt] = cur\n                      q.append(nxt)\n      else:\n          return []  # no path found\n\n      # reconstruct path\n      path = []\n      cur = goal\n      while cur != start:\n          path.append(cur)\n          cur = prev[cur]\n      path.reverse()\n      return path\n\n  def path_to_actions(path):\n      \"\"\"Convert a list of positions into movement actions.\"\"\"\n      actions = []\n      for (y1, x1), (y2, x2) in zip(path, path[1:]):\n          if y2 == y1 + 1:\n              actions.append(DOWN)\n          elif y2 == y1 - 1:\n              actions.append(UP)\n          elif x2 == x1 + 1:\n              actions.append(RIGHT)\n          elif x2 == x1 - 1:\n              actions.append(LEFT)\n      return actions\n\n  def nearest_cell(kind, from_pos):\n      \"\"\"Find the nearest cell containing ``kind`` (primitive or workshop).\"\"\"\n      locs = np.argwhere(grid[:, :, kind] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      return tuple(locs[dists.argmin()])\n\n  def free_adjacent(target):\n      \"\"\"Return a walkable neighbour of ``target`` (preferring N,S,W,E).\"\"\"\n      ty, tx = target\n      for ny, nx in ((ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)):\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1] and not is_blocked((ny, nx)):\n              return (ny, nx)\n      return target  # fallback (may be blocked but used as last resort)\n\n  # ------------------------------------------------------------------\n  # Build the action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  cur = state.pos  # current agent position (y, x)\n\n  # Collect each required primitive the needed number of times.\n  for prim_idx, count in required.items():\n      for _ in range(count):\n          prim_loc = nearest_cell(prim_idx, cur)\n          if prim_loc is None:\n              # Primitive not found \u2013 abort early.\n              return actions\n\n          # Move to a free cell adjacent to the primitive.\n          stand_pos = free_adjacent(prim_loc)\n          path = bfs_path(cur, stand_pos)\n          if not path and cur != stand_pos:\n              return actions\n          actions.extend(path_to_actions([cur] + path))\n          cur = stand_pos\n\n          # Step onto the primitive cell itself.\n          path = bfs_path(cur, prim_loc)\n          if not path and cur != prim_loc:\n              return actions\n          actions.extend(path_to_actions([cur] + path))\n          cur = prim_loc\n\n          # Pick up the primitive.\n          actions.append(USE)\n\n          # Update local grid copy to reflect that the primitive has been taken.\n          grid[prim_loc[0], prim_loc[1], prim_idx] = 0\n\n  # Move to the workshop required by the recipe (if any).\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      ws_idx = world.cookbook.index.index(workshop_name)\n      ws_loc = nearest_cell(ws_idx, cur)\n      if ws_loc is not None:\n          path = bfs_path(cur, ws_loc)\n          if path:\n              actions.extend(path_to_actions([cur] + path))\n              cur = ws_loc\n\n  # Final USE to craft the arrow.\n  actions.append(USE)\n\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-10-28T21:01:08.928414", "function_name": "make_arrow", "function_body": "  # Action indices as defined by CraftLab.action_specs\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Reset environment and obtain the current state and world objects\n  env.reset()\n  state = env._current_state          # CraftState instance\n  world = env.world                    # CraftWorld instance\n  grid = state.grid.copy()             # mutable copy for bookkeeping\n\n  # Identify the goal item (\"arrow\") and its primitive requirements\n  arrow_idx = world.cookbook.index.index('arrow')\n  required = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  non_grab = list(world.non_grabbable_indices)\n\n  def is_blocked(pos):\n      \"\"\"Return True if the cell at ``pos`` contains any non\u2011grabbable entity.\"\"\"\n      y, x = pos\n      return np.any(grid[y, x, non_grab] > 0)\n\n  def bfs_path(start, goal):\n      \"\"\"\n      Find a shortest walkable path from ``start`` to ``goal`` avoiding\n      non\u2011grabbable cells. Returns a list of positions (excluding ``start``,\n      including ``goal``). If no path exists, returns an empty list.\n      \"\"\"\n      if start == goal:\n          return []\n      h, w = grid.shape[:2]\n      queue = collections.deque([start])\n      visited = {start: None}\n      while queue:\n          cur = queue.popleft()\n          if cur == goal:\n              break\n          y, x = cur\n          for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):\n              if 0 <= ny < h and 0 <= nx < w:\n                  nxt = (ny, nx)\n                  if nxt not in visited and not is_blocked(nxt):\n                      visited[nxt] = cur\n                      queue.append(nxt)\n      else:\n          return []  # no path found\n\n      # Reconstruct path backwards from goal to start\n      path = []\n      cur = goal\n      while cur != start:\n          path.append(cur)\n          cur = visited[cur]\n      path.reverse()\n      return path\n\n  def path_to_actions(path):\n      \"\"\"Convert a list of positions into a list of movement actions.\"\"\"\n      actions = []\n      for (y1, x1), (y2, x2) in zip(path, path[1:]):\n          if y2 == y1 + 1:\n              actions.append(DOWN)\n          elif y2 == y1 - 1:\n              actions.append(UP)\n          elif x2 == x1 + 1:\n              actions.append(RIGHT)\n          elif x2 == x1 - 1:\n              actions.append(LEFT)\n      return actions\n\n  def nearest_cell(kind, from_pos):\n      \"\"\"Find the nearest cell containing ``kind`` (primitive or workshop).\"\"\"\n      locs = np.argwhere(grid[:, :, kind] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      return tuple(locs[dists.argmin()])\n\n  def free_adjacent(target):\n      \"\"\"\n      Return a walkable neighbour of ``target`` that is not occupied by a\n      non\u2011grabbable entity. Preference order: N, S, W, E. If none found,\n      return the target itself (assumed walkable for collection purposes).\n      \"\"\"\n      y, x = target\n      for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not is_blocked((ny, nx)):\n                  return (ny, nx)\n      return target\n\n  # ------------------------------------------------------------------\n  # Build the action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  cur = state.pos  # current agent position (y, x)\n\n  # Collect each required primitive the needed number of times\n  for prim_idx, count in required.items():\n      for _ in range(count):\n          prim_loc = nearest_cell(prim_idx, cur)\n          if prim_loc is None:\n              # Primitive not found \u2013 abort early\n              return actions\n\n          # Move to a free cell adjacent to the primitive\n          stand_pos = free_adjacent(prim_loc)\n          path = bfs_path(cur, stand_pos)\n          if not path and cur != stand_pos:\n              return actions\n          actions.extend(path_to_actions([cur] + path))\n          cur = stand_pos\n\n          # Step onto the primitive cell itself\n          path = bfs_path(cur, prim_loc)\n          if not path and cur != prim_loc:\n              return actions\n          actions.extend(path_to_actions([cur] + path))\n          cur = prim_loc\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update local copy of the grid to reflect collection\n          grid[prim_loc[0], prim_loc[1], prim_idx] = 0\n\n  # Move to the appropriate workshop (if the recipe specifies one)\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      ws_idx = world.cookbook.index.index(workshop_name)\n      ws_loc = nearest_cell(ws_idx, cur)\n      if ws_loc is not None:\n          # Prefer a free adjacent cell if the workshop cell itself is blocked\n          target = ws_loc if not is_blocked(ws_loc) else free_adjacent(ws_loc)\n          path = bfs_path(cur, target)\n          if path:\n              actions.extend(path_to_actions([cur] + path))\n              cur = target\n\n  # Final USE to craft the arrow\n  actions.append(USE)\n\n  return actions", "env_interactions": 25, "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T21:01:35.518205", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = set()\n  frontier = deque([Node(init_state, [])])\n  visited.add(_state_hash(init_state))\n\n  MAX_STEPS = 2000  # safety limit for plan length\n  n_actions = getattr(world, \"n_actions\", 5)\n  # Prefer the USE action (index 4) before movement actions.\n  action_order = [4, 0, 1, 2, 3] if n_actions > 4 else list(range(n_actions))\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory.\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long trajectories.\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand successors.\n      for a in action_order:\n          _, nxt_state = cur_state.step(a)  # reward is always 0.0 here\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No feasible plan found within the limits.\n  return []", "env_interactions": 20, "island_id": 2, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T21:01:51.318347", "function_name": "make_arrow", "function_body": "  # Resolve world and target item index\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = set()\n  frontier = deque([Node(init_state, [])])\n  visited.add(_state_hash(init_state))\n\n  MAX_STEPS = 2000                       # safety cap on plan length\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  # Prefer the USE action (index 4) before movement actions\n  action_order = [4, 0, 1, 2, 3] if n_actions > 4 else list(range(n_actions))\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long trajectories\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand successors\n      for a in action_order:\n          _, nxt_state = cur_state.step(a)   # reward is always 0.0\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within limits\n  return []", "env_interactions": 20, "island_id": 2, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T21:02:21.129836", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  target_name = \"arrow\"\n  target_idx = cookbook.index[target_name]\n\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n  width, height, _ = grid.shape\n  actions = []\n\n  def bfs(start, goals):\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          cur, path = q.popleft()\n          if cur in goals:\n              return path\n          x, y = cur\n          for dx, dy, act in ((0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)):\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              nxt = (nx, ny)\n              if nxt in visited:\n                  continue\n              if np.any(grid[nx, ny, :]) and nxt not in goals:\n                  continue\n              visited.add(nxt)\n              q.append((nxt, path + [act]))\n      return None\n\n  def move_along(path):\n      nonlocal pos\n      for a in path:\n          if a == 0:      # DOWN\n              pos = (pos[0], pos[1] + 1)\n          elif a == 1:    # UP\n              pos = (pos[0], pos[1] - 1)\n          elif a == 2:    # LEFT\n              pos = (pos[0] - 1, pos[1])\n          elif a == 3:    # RIGHT\n              pos = (pos[0] + 1, pos[1])\n\n  def collect_primitive(kind_idx, needed):\n      nonlocal actions, grid, inventory, pos\n      while needed > 0:\n          locations = [(x, y) for x in range(width) for y in range(height)\n                       if grid[x, y, kind_idx] > 0]\n          if not locations:\n              break\n          path = None\n          target_loc = None\n          for loc in locations:\n              cand = bfs(pos, {loc})\n              if cand is not None:\n                  path = cand\n                  target_loc = loc\n                  break\n          if path is None:\n              break\n          actions.extend(path)\n          move_along(path)\n          actions.append(4)                     # USE\n          grid[target_loc[0], target_loc[1], kind_idx] = 0\n          inventory[kind_idx] += 1\n          needed -= 1\n\n  recipes = cookbook.recipes\n  primitives_set = cookbook.primitives\n\n  def ensure_item(item_idx, amount):\n      nonlocal actions, grid, inventory, pos\n      while inventory[item_idx] < amount:\n          if item_idx in primitives_set:\n              collect_primitive(item_idx, amount - inventory[item_idx])\n              continue\n\n          recipe = recipes.get(item_idx, {})\n          for ing_idx, cnt in list(recipe.items()):\n              if ing_idx == \"_at\":\n                  continue\n              if inventory[ing_idx] < cnt:\n                  ensure_item(ing_idx, cnt)\n\n          workshop = recipe.get(\"_at\")\n          if workshop is not None:\n              ws_idx = workshop if isinstance(workshop, int) else cookbook.index[workshop]\n              ws_cells = [(x, y) for x in range(width) for y in range(height)\n                          if grid[x, y, ws_idx] > 0]\n              if ws_cells:\n                  path = bfs(pos, {ws_cells[0]})\n                  if path:\n                      actions.extend(path)\n                      move_along(path)\n\n          actions.append(4)                     # USE (craft)\n          for ing_idx, cnt in recipe.items():\n              if ing_idx == \"_at\":\n                  continue\n              inventory[ing_idx] -= cnt\n          inventory[item_idx] += 1\n\n  ensure_item(target_idx, 1)\n  return actions", "env_interactions": 41, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T21:02:22.287667", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  # ------------------------------------------------------------------\n  # Identify target item (arrow)\n  target_name = \"arrow\"\n  target_idx = cookbook.index[target_name]\n\n  # Local mutable copies of the environment state\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n  width, height, _ = grid.shape\n  actions = []\n\n  from collections import deque\n\n  # ------------------------------------------------------------------\n  # BFS path finder: returns list of movement actions to reach any goal cell\n  def bfs(start, goals):\n      \"\"\"Find shortest path (as action list) from start to any cell in goals.\"\"\"\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          cur, path = q.popleft()\n          if cur in goals:\n              return path\n          x, y = cur\n          for dx, dy, act in ((0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)):  # DOWN,UP,LEFT,RIGHT\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              nxt = (nx, ny)\n              if nxt in visited:\n                  continue\n              # treat any occupied cell as blocked unless it's a goal cell\n              if np.any(grid[nx, ny, :]) and nxt not in goals:\n                  continue\n              visited.add(nxt)\n              q.append((nxt, path + [act]))\n      return None\n\n  # ------------------------------------------------------------------\n  # Update simulated position according to movement actions\n  def move_along(path):\n      nonlocal pos\n      for a in path:\n          if a == 0:   # DOWN\n              pos = (pos[0], pos[1] + 1)\n          elif a == 1: # UP\n              pos = (pos[0], pos[1] - 1)\n          elif a == 2: # LEFT\n              pos = (pos[0] - 1, pos[1])\n          elif a == 3: # RIGHT\n              pos = (pos[0] + 1, pos[1])\n\n  # ------------------------------------------------------------------\n  # Primitive collection routine\n  def collect_primitive(kind_idx, needed):\n      \"\"\"Collect *needed* units of primitive *kind_idx* from the grid.\"\"\"\n      nonlocal actions, grid, inventory, pos\n      while needed > 0:\n          # locate all remaining cells containing the primitive\n          locations = [(x, y) for x in range(width) for y in range(height)\n                       if grid[x, y, kind_idx] > 0]\n          if not locations:\n              break  # no more of this primitive available\n          # find first reachable primitive cell\n          chosen_path = None\n          chosen_loc = None\n          for loc in locations:\n              p = bfs(pos, {loc})\n              if p is not None:\n                  chosen_path = p\n                  chosen_loc = loc\n                  break\n          if chosen_path is None:\n              break  # cannot reach any remaining primitive\n          # move to it and pick up\n          actions.extend(chosen_path)\n          move_along(chosen_path)\n          actions.append(4)                     # USE\n          grid[chosen_loc[0], chosen_loc[1], kind_idx] = 0\n          inventory[kind_idx] += 1\n          needed -= 1\n\n  # ------------------------------------------------------------------\n  # Recursive crafting helper\n  recipes = cookbook.recipes\n  primitive_set = cookbook.primitives\n\n  def ensure_item(item_idx, amount):\n      \"\"\"Guarantee that inventory[item_idx] >= amount by collecting/crafting.\"\"\"\n      nonlocal actions, grid, inventory, pos\n      while inventory[item_idx] < amount:\n          if item_idx in primitive_set:\n              # primitive: collect the missing amount\n              collect_primitive(item_idx, amount - inventory[item_idx])\n              continue\n\n          # need to craft the item using its recipe\n          recipe = recipes.get(item_idx, {})\n          # first ensure all ingredient quantities are present\n          for ing_idx, cnt in list(recipe.items()):\n              if ing_idx == \"_at\":\n                  continue\n              if inventory[ing_idx] < cnt:\n                  ensure_item(ing_idx, cnt)\n\n          # move to the required workshop, if any\n          workshop = recipe.get(\"_at\")\n          if workshop is not None:\n              ws_idx = workshop if isinstance(workshop, int) else cookbook.index[workshop]\n              ws_cells = [(x, y) for x in range(width) for y in range(height)\n                          if grid[x, y, ws_idx] > 0]\n              if ws_cells:\n                  path = bfs(pos, {ws_cells[0]})\n                  if path:\n                      actions.extend(path)\n                      move_along(path)\n\n          # perform the craft action\n          actions.append(4)                     # USE\n          for ing_idx, cnt in recipe.items():\n              if ing_idx == \"_at\":\n                  continue\n              inventory[ing_idx] -= cnt\n          inventory[item_idx] += 1\n\n  # ------------------------------------------------------------------\n  # Build the target arrow\n  ensure_item(target_idx, 1)\n\n  return actions", "env_interactions": 41, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T21:02:49.341250", "function_name": "make_arrow", "function_body": "  # Retrieve scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      # Hash based on position, direction, inventory and grid layout\n      return (\n          st.pos,\n          st.dir,\n          st.inventory.tobytes(),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_PLAN_LENGTH = 500                     # safety bound\n  n_actions = getattr(world, \"n_actions\", 5)  # default action count\n\n  while frontier:\n      node = frontier.popleft()\n      state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long partial plans\n      if len(node.actions) >= MAX_PLAN_LENGTH:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt = state.step(a)\n          h = _state_hash(nxt)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt, node.actions + [a]))\n\n  # No feasible plan found within limits\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T21:03:04.089140", "function_name": "make_arrow", "function_body": "  # Retrieve scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Obtain the initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      # Hash includes position, direction, inventory contents and grid layout\n      return (\n          st.pos,\n          st.dir,\n          st.inventory.tobytes(),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 400                     # safety limit on plan length\n  n_actions = getattr(world, \"n_actions\", 5)  # default to 5 actions (0\u20114)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long partial plans\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          h = _state_hash(next_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(next_state, node.actions + [a]))\n\n  # No feasible plan found within limits\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
