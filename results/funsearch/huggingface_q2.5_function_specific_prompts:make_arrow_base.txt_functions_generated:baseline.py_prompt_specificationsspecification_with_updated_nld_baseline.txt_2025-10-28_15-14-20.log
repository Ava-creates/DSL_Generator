{"timestamp": "2025-10-28T15:39:55.269499", "function_name": "make_arrow", "function_body": "  # Retrieve scenario and world objects\n  scenario = getattr(env, \"scenario\", None) or env\n  world = getattr(scenario, \"world\", None) or getattr(env, \"world\", None)\n\n  # Find the index of the target item \u201carrow\u201d\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Obtain the initial state of the episode\n  try:\n      start_state = scenario.init()\n  except Exception:\n      return []\n\n  # Helper to create a hashable representation of a state for visited checking\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  from collections import deque, namedtuple\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  visited = {_state_hash(start_state)}\n  frontier = deque([Node(start_state, [])])\n\n  # Limits to keep the search tractable\n  MAX_STEPS = 400                     # maximum length of a plan\n  n_actions = getattr(world, \"n_actions\", 5)   # default action space size\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: arrow present in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long trajectories\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          h = _state_hash(next_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(next_state, node.actions + [a]))\n\n  # No plan found within the search budget\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T15:40:11.017798", "function_name": "make_arrow", "function_body": "  # Obtain scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  # Hash function for visited states (position, direction, inventory, grid)\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 300                         # safety bound on plan length\n  n_actions = getattr(world, \"n_actions\", 5)  # default action count (0\u20114)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long plans\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          h = _state_hash(next_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(next_state, node.actions + [a]))\n\n  # No plan found within limits\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T15:40:53.850803", "function_name": "make_arrow", "function_body": "  # reset environment and get initial state\n  env.reset()\n  state = env._current_state\n  world = env.world\n\n  # action constants (as defined in CraftLab)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # helpers -------------------------------------------------------------\n  def _bfs_path(grid, start, goal):\n      \"\"\"Return list of actions to move from start to goal avoiding blocked cells.\n      Goal cell may be non\u2011empty (e.g., contains the target item).\"\"\"\n      h, w, _ = grid.shape\n      from collections import deque\n      visited = set()\n      queue = deque()\n      queue.append((start, []))\n      visited.add(start)\n      # movement vectors\n      moves = [(DOWN, (1, 0)), (UP, (-1, 0)), (LEFT, (0, -1)), (RIGHT, (0, 1))]\n      while queue:\n          (r, c), path = queue.popleft()\n          if (r, c) == goal:\n              return path\n          for act, (dr, dc) in moves:\n              nr, nc = r + dr, c + dc\n              if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in visited:\n                  # allow stepping on the goal even if it is occupied\n                  if (nr, nc) == goal or np.all(grid[nr, nc, :] == 0):\n                      visited.add((nr, nc))\n                      queue.append(((nr, nc), path + [act]))\n      # no path found\n      return None\n\n  def _nearest_of_kind(grid, kind_idx, start):\n      \"\"\"BFS search for the closest cell containing kind_idx.\"\"\"\n      h, w, _ = grid.shape\n      from collections import deque\n      visited = set()\n      queue = deque()\n      queue.append((start, []))\n      visited.add(start)\n      moves = [(DOWN, (1, 0)), (UP, (-1, 0)), (LEFT, (0, -1)), (RIGHT, (0, 1))]\n      while queue:\n          (r, c), path = queue.popleft()\n          if grid[r, c, kind_idx] > 0:\n              return (r, c), path\n          for act, (dr, dc) in moves:\n              nr, nc = r + dr, c + dc\n              if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in visited:\n                  # can walk through empty cells only\n                  if np.all(grid[nr, nc, :] == 0):\n                      visited.add((nr, nc))\n                      queue.append(((nr, nc), path + [act]))\n      return None, None\n\n  # --------------------------------------------------------------------\n  # Identify goal index (arrow)\n  # --------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:\n      # arrow not defined in this world\n      return []\n\n  # --------------------------------------------------------------------\n  # Primitive requirements for a single arrow (expanded)\n  # --------------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}\n  action_seq = []\n\n  # --------------------------------------------------------------------\n  # Collect each required primitive (respecting required count)\n  # --------------------------------------------------------------------\n  for prim_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          target, path_to_target = _nearest_of_kind(state.grid, prim_idx, state.pos)\n          if target is None:\n              # cannot find required primitive \u2013 abort\n              return action_seq\n          # follow the path\n          for a in path_to_target:\n              reward, done, obs = env.step(a)\n              state = env._current_state\n              action_seq.append(a)\n              if done:\n                  return action_seq\n          # pick up the primitive (USE)\n          reward, done, obs = env.step(USE)\n          state = env._current_state\n          action_seq.append(USE)\n          if done:\n              return action_seq\n\n  # --------------------------------------------------------------------\n  # Move to the appropriate workshop (if any) and craft the arrow\n  # --------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\", None)\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      # locate nearest workshop\n      workshop_pos, path_to_ws = _nearest_of_kind(state.grid, workshop_idx, state.pos)\n      if workshop_pos is not None:\n          for a in path_to_ws:\n              reward, done, obs = env.step(a)\n              state = env._current_state\n              action_seq.append(a)\n              if done:\n                  return action_seq\n          # craft at the workshop\n          reward, done, obs = env.step(USE)\n          state = env._current_state\n          action_seq.append(USE)\n\n  # --------------------------------------------------------------------\n  # Return the complete action list\n  # --------------------------------------------------------------------\n  return action_seq", "env_interactions": 0, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T15:40:54.972347", "function_name": "make_arrow", "function_body": "  import collections\n\n  # Action indices (assumed standard mapping)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # helpers\n  # ------------------------------------------------------------------\n  def _is_blocked(grid, pos):\n      i, j = pos\n      for idx in env.world.non_grabbable_indices:\n          if grid[i, j, idx] > 0:\n              return True\n      return False\n\n  def _neighbors(pos):\n      i, j = pos\n      h, w, _ = env._current_state.grid.shape\n      for action, (di, dj) in ((UP, (-1, 0)), (DOWN, (1, 0)),\n                               (LEFT, (0, -1)), (RIGHT, (0, 1))):\n          ni, nj = i + di, j + dj\n          if 0 <= ni < h and 0 <= nj < w:\n              yield (ni, nj), action\n\n  def _bfs_to_kind(grid, kind_idx, start):\n      \"\"\"Return list of actions to reach a cell containing kind_idx.\"\"\"\n      if grid[start[0], start[1], kind_idx] > 0:\n          return []\n      visited = set()\n      q = collections.deque()\n      q.append((start, []))\n      visited.add(start)\n      while q:\n          pos, acts = q.popleft()\n          for (npos, act) in _neighbors(pos):\n              if npos in visited:\n                  continue\n              if _is_blocked(grid, npos):\n                  continue\n              if grid[npos[0], npos[1], kind_idx] > 0:\n                  return acts + [act]\n              visited.add(npos)\n              q.append((npos, acts + [act]))\n      return None\n\n  # ------------------------------------------------------------------\n  # initialise episode\n  # ------------------------------------------------------------------\n  env.reset()\n  state = env._current_state\n  world = env.world\n\n  # ------------------------------------------------------------------\n  # locate goal (arrow)\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:\n      return []\n\n  # ------------------------------------------------------------------\n  # primitives needed for one arrow\n  # ------------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(arrow_idx)\n  actions = []\n\n  # ------------------------------------------------------------------\n  # collect required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in primitive_needs.items():\n      for _ in range(cnt):\n          path = _bfs_to_kind(state.grid, prim_idx, state.pos)\n          if path is None:\n              return actions\n          for a in path:\n              _, _, _ = env.step(a)\n              state = env._current_state\n              actions.append(a)\n          # pick up the primitive\n          _, _, _ = env.step(USE)\n          state = env._current_state\n          actions.append(USE)\n\n  # ------------------------------------------------------------------\n  # craft at the appropriate workshop (if any)\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\", None)\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      path = _bfs_to_kind(state.grid, workshop_idx, state.pos)\n      if path is not None:\n          for a in path:\n              _, _, _ = env.step(a)\n              state = env._current_state\n              actions.append(a)\n          # craft the arrow\n          _, _, _ = env.step(USE)\n          state = env._current_state\n          actions.append(USE)\n\n  return actions", "env_interactions": 13, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T15:46:35.859631", "function_name": "make_arrow", "function_body": "  # Get mapping from action names to indices\n  action_map = env.action_specs()\n\n  # Identify the index for the target item \"arrow\"\n  arrow_idx = env.world.cookbook.index[\"arrow\"]\n\n  # Determine primitive requirements for one arrow\n  needed_primitives = env.world.cookbook.primitives_for(arrow_idx).copy()\n\n  # Helper: find the nearest cell containing a given kind (primitive or workshop)\n  def _find_nearest(kind_idx):\n      grid_layer = env._current_state.grid[:, :, kind_idx]\n      positions = np.argwhere(grid_layer > 0)\n      if positions.size == 0:\n          return None\n      cur_pos = np.array(env._current_state.pos)\n      dists = np.sum(np.abs(positions - cur_pos), axis=1)\n      nearest = positions[dists.argmin()]\n      return tuple(nearest)\n\n  # Helper: move the agent from its current location to a target location\n  def _move_to(target):\n      # We directly issue movement actions and also step the environment\n      # so that subsequent calls see the updated position.\n      cur = list(env._current_state.pos)\n      ty, tx = target\n      while cur[0] < ty:\n          env.step(action_map[\"DOWN\"])\n          cur[0] += 1\n      while cur[0] > ty:\n          env.step(action_map[\"UP\"])\n          cur[0] -= 1\n      while cur[1] < tx:\n          env.step(action_map[\"RIGHT\"])\n          cur[1] += 1\n      while cur[1] > tx:\n          env.step(action_map[\"LEFT\"])\n          cur[1] -= 1\n\n  actions = []\n\n  # Collect each required primitive\n  for prim_idx, needed_cnt in needed_primitives.items():\n      while env._current_state.inventory[prim_idx] < needed_cnt:\n          prim_pos = _find_nearest(prim_idx)\n          if prim_pos is None:\n              # No more of this primitive on the map; break to avoid infinite loop\n              break\n          _move_to(prim_pos)\n          # Use action to pick up the primitive\n          env.step(action_map[\"USE\"])\n          actions.append(action_map[\"USE\"])\n\n  # Move to the appropriate workshop (if any) and craft the arrow\n  workshop_idx = env.world.cookbook.recipes[arrow_idx].get(\"_at\")\n  if workshop_idx is not None:\n      workshop_pos = _find_nearest(workshop_idx)\n      if workshop_pos is not None:\n          _move_to(workshop_pos)\n\n  # Final USE to craft the arrow\n  env.step(action_map[\"USE\"])\n  actions.append(action_map[\"USE\"])\n\n  return actions", "env_interactions": 0, "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-10-28T15:46:37.151773", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Get the current state (assumes env is a CraftLab instance that has been reset)\n  if hasattr(env, \"_current_state\") and env._current_state is not None:\n      cur_state = env._current_state\n  else:\n      # Fallback: create a fresh state from the scenario\n      cur_state = env.scenario.init()\n\n  world = env.world\n  cookbook = world.cookbook\n\n  # ------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------\n  # movement deltas and corresponding action indices (as defined in CraftLab)\n  MOVES = [\n      (0, 1, 0),   # DOWN  -> action 0\n      (0, -1, 1),  # UP    -> action 1\n      (-1, 0, 2),  # LEFT  -> action 2\n      (1, 0, 3),   # RIGHT -> action 3\n  ]\n\n  def is_free(x, y, grid):\n      \"\"\"A cell is free if no entity occupies it.\"\"\"\n      return not grid[x, y, :].any()\n\n  def bfs(start, target_set, grid):\n      \"\"\"Bread\u2011first search returning a list of actions to reach any cell in target_set.\"\"\"\n      w, h, _ = grid.shape\n      visited = set()\n      q = deque()\n      q.append((start, []))\n      visited.add(start)\n      while q:\n          (cx, cy), path = q.popleft()\n          if (cx, cy) in target_set:\n              return path\n          for dx, dy, act in MOVES:\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if is_free(nx, ny, grid):\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [act]))\n      return None\n\n  def find_positions(kind_idx, grid):\n      xs, ys = np.where(grid[:, :, kind_idx] > 0)\n      return list(zip(xs, ys))\n\n  # ------------------------------------------------------------\n  # Determine goal index for the arrow\n  # ------------------------------------------------------------\n  goal_name = \"arrow\"\n  if goal_name not in cookbook.index.contents:\n      # unknown goal \u2013 return empty plan\n      return []\n  goal_idx = cookbook.index[goal_name]\n\n  # ------------------------------------------------------------\n  # Gather required primitive items\n  # ------------------------------------------------------------\n  primitive_requirements = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n  plan_actions = []\n  # work on a copy of the grid so that we can \u201cremove\u201d collected items locally\n  grid = cur_state.grid.copy()\n  cur_pos = tuple(cur_state.pos)\n\n  for prim_idx, needed in primitive_requirements.items():\n      # find all locations of this primitive in the current grid\n      prim_locs = find_positions(prim_idx, grid)\n      for _ in range(needed):\n          # locate the nearest reachable primitive\n          best_path = None\n          best_prim_loc = None\n          for (tx, ty) in prim_locs:\n              # candidate standing cells (free neighbours of the primitive)\n              neighbour_cells = set()\n              for dx, dy, _ in MOVES:\n                  nx, ny = tx + dx, ty + dy\n                  if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and is_free(nx, ny, grid):\n                      neighbour_cells.add((nx, ny))\n              if not neighbour_cells:\n                  continue\n              path = bfs(cur_pos, neighbour_cells, grid)\n              if path is not None and (best_path is None or len(path) < len(best_path)):\n                  best_path = path\n                  best_prim_loc = (tx, ty)\n          if best_path is None:\n              # cannot reach any remaining instance \u2013 abort planning\n              return plan_actions\n          # move to the chosen neighbour (the last step of the path points toward the primitive)\n          plan_actions.extend(best_path)\n          # use action to pick up the primitive\n          plan_actions.append(4)  # USE\n          # update simulated position\n          cx, cy = cur_pos\n          for act in best_path:\n              dx, dy, _ = next(m for m in MOVES if m[2] == act)\n              cx += dx\n              cy += dy\n          cur_pos = (cx, cy)\n          # locally remove the primitive from the grid (as if it were collected)\n          px, py = best_prim_loc\n          grid[px, py, prim_idx] = 0\n          # also remove this location from future searches\n          prim_locs = [loc for loc in prim_locs if loc != best_prim_loc]\n\n  # ------------------------------------------------------------\n  # Go to the workshop for the arrow and craft it\n  # ------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n  if workshop_kind is not None:\n      workshop_cells = find_positions(workshop_kind, grid)\n      best_path = None\n      for (wx, wy) in workshop_cells:\n          neighbour_cells = set()\n          for dx, dy, _ in MOVES:\n              nx, ny = wx + dx, wy + dy\n              if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and is_free(nx, ny, grid):\n                  neighbour_cells.add((nx, ny))\n          if not neighbour_cells:\n              continue\n          path = bfs(cur_pos, neighbour_cells, grid)\n          if path is not None and (best_path is None or len(path) < len(best_path)):\n              best_path = path\n      if best_path is not None:\n          plan_actions.extend(best_path)\n          plan_actions.append(4)  # USE to craft the arrow at the workshop\n\n  return plan_actions", "env_interactions": 0, "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-10-28T15:46:55.110718", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # --------------------------------------------------------------\n  # Helper: Manhattan path from src to dst as a list of actions\n  # --------------------------------------------------------------\n  def _path(src, dst):\n      actions = []\n      r, c = src\n      tr, tc = dst\n      while r != tr:\n          if r < tr:\n              actions.append(DOWN)\n              r += 1\n          else:\n              actions.append(UP)\n              r -= 1\n      while c != tc:\n          if c < tc:\n              actions.append(RIGHT)\n              c += 1\n          else:\n              actions.append(LEFT)\n              c -= 1\n      return actions\n\n  # --------------------------------------------------------------\n  # Helper: locate nearest cell containing a given kind (Manhattan)\n  # --------------------------------------------------------------\n  def _nearest(grid, kind_idx, start):\n      h, w, _ = grid.shape\n      best = None\n      best_dist = None\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  d = abs(i - start[0]) + abs(j - start[1])\n                  if best_dist is None or d < best_dist:\n                      best_dist = d\n                      best = (i, j)\n      return best\n\n  # --------------------------------------------------------------\n  # Helper: locate any cell containing a given kind (used for workshops)\n  # --------------------------------------------------------------\n  def _any(grid, kind_idx):\n      h, w, _ = grid.shape\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  return (i, j)\n      return None\n\n  # --------------------------------------------------------------\n  # Initialise episode\n  # --------------------------------------------------------------\n  env.reset()\n  state = env._current_state\n  world = env.world\n\n  # --------------------------------------------------------------\n  # Identify goal index for \"arrow\"\n  # --------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:          # not defined\n      return []\n\n  # --------------------------------------------------------------\n  # Determine primitive requirements for a single arrow\n  # --------------------------------------------------------------\n  needed_prims = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}\n  action_seq = []\n\n  # --------------------------------------------------------------\n  # Collect required primitives (respecting counts)\n  # --------------------------------------------------------------\n  for prim_idx, cnt in needed_prims.items():\n      for _ in range(cnt):\n          target = _nearest(state.grid, prim_idx, state.pos)\n          if target is None:\n              # primitive not present on map \u2013 abort early\n              return action_seq\n          # Move to the primitive cell\n          for a in _path(state.pos, target):\n              reward, done, obs = env.step(a)\n              state = env._current_state\n              action_seq.append(a)\n              if done:\n                  return action_seq\n          # Pick up the primitive\n          reward, done, obs = env.step(USE)\n          state = env._current_state\n          action_seq.append(USE)\n          if done:\n              return action_seq\n\n  # --------------------------------------------------------------\n  # If the recipe specifies a workshop, move there and craft\n  # --------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\", None)\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = _any(state.grid, workshop_idx)\n      if workshop_pos is not None:\n          for a in _path(state.pos, workshop_pos):\n              reward, done, obs = env.step(a)\n              state = env._current_state\n              action_seq.append(a)\n              if done:\n                  return action_seq\n          # Craft at the workshop\n          reward, done, obs = env.step(USE)\n          state = env._current_state\n          action_seq.append(USE)\n\n  return action_seq", "env_interactions": 21, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T15:46:56.230892", "function_name": "make_arrow", "function_body": "  # constants for actions\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # helper: locate the nearest cell (Manhattan) containing a given kind\n  # ------------------------------------------------------------------\n  def _find_nearest(grid, kind_idx, start_pos):\n      h, w, _ = grid.shape\n      best = None\n      best_dist = None\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  d = abs(i - start_pos[0]) + abs(j - start_pos[1])\n                  if best_dist is None or d < best_dist:\n                      best_dist = d\n                      best = (i, j)\n      return best\n\n  # ------------------------------------------------------------------\n  # helper: locate any cell containing a given kind (used for workshops)\n  # ------------------------------------------------------------------\n  def _find_any(grid, kind_idx):\n      h, w, _ = grid.shape\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  return (i, j)\n      return None\n\n  # ------------------------------------------------------------------\n  # helper: produce a Manhattan path (list of actions) from src to dst\n  # ------------------------------------------------------------------\n  def _path(src, dst):\n      actions = []\n      r, c = src\n      tr, tc = dst\n      while r != tr:\n          if r < tr:\n              actions.append(DOWN)\n              r += 1\n          else:\n              actions.append(UP)\n              r -= 1\n      while c != tc:\n          if c < tc:\n              actions.append(RIGHT)\n              c += 1\n          else:\n              actions.append(LEFT)\n              c -= 1\n      return actions\n\n  # ------------------------------------------------------------------\n  # initialise episode\n  # ------------------------------------------------------------------\n  env.reset()\n  state = env._current_state          # current CraftState\n  world = env.world\n\n  # ------------------------------------------------------------------\n  # identify the goal item (arrow)\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:                   # arrow not defined\n      return []\n\n  # ------------------------------------------------------------------\n  # get primitive requirements for a single arrow\n  # ------------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}\n  action_seq = []\n\n  # ------------------------------------------------------------------\n  # collect each required primitive (respecting required counts)\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in primitive_needs.items():\n      for _ in range(cnt):\n          target = _find_nearest(state.grid, prim_idx, state.pos)\n          if target is None:            # primitive missing \u2013 cannot proceed\n              return action_seq\n          # move to the primitive location\n          for a in _path(state.pos, target):\n              reward, done, obs = env.step(a)\n              state = env._current_state\n              action_seq.append(a)\n              if done:\n                  return action_seq\n          # pick it up\n          reward, done, obs = env.step(USE)\n          state = env._current_state\n          action_seq.append(USE)\n          if done:\n              return action_seq\n\n  # ------------------------------------------------------------------\n  # if the recipe specifies a workshop, go there and craft\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\", None)\n\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = _find_any(state.grid, workshop_idx)\n      if workshop_pos is not None:\n          for a in _path(state.pos, workshop_pos):\n              reward, done, obs = env.step(a)\n              state = env._current_state\n              action_seq.append(a)\n              if done:\n                  return action_seq\n          # craft at the workshop\n          reward, done, obs = env.step(USE)\n          state = env._current_state\n          action_seq.append(USE)\n\n  return action_seq", "env_interactions": 21, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T15:47:20.137761", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ----------------------------------------------------------------------\n  # Action / direction helpers\n  # ----------------------------------------------------------------------\n  # Action indices as defined by CraftLab.\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n  # Mapping movement vectors (dx, dy) \u2192 action index.\n  DIR2ACT = {\n      (0, 1): ACTION_DOWN,   # y+ (down)\n      (0, -1): ACTION_UP,    # y- (up)\n      (-1, 0): ACTION_LEFT,  # x- (left)\n      (1, 0): ACTION_RIGHT,  # x+ (right)\n  }\n  # Reverse mapping for updating simulated position.\n  ACT2DIR = {v: k for k, v in DIR2ACT.items()}\n\n  # ----------------------------------------------------------------------\n  # Bread\u2011first search returning a list of actions that moves the agent\n  # from ``start`` to a cell adjacent to any cell in ``targets``.\n  # ----------------------------------------------------------------------\n  def bfs(start, targets, grid):\n      \"\"\"\n      Parameters\n      ----------\n      start : tuple (x, y)\n          Current agent position.\n      targets : list of (x, y)\n          Cells we want to become adjacent to.\n      grid : np.ndarray (H, W, K)\n          Current world grid. Any non\u2011zero entry in the last axis counts as\n          an obstacle for movement.\n\n      Returns\n      -------\n      list[int]\n          Sequence of action indices that brings the agent adjacent to a\n          target cell. May be empty if already adjacent or if no path exists.\n      \"\"\"\n      H, W = grid.shape[:2]\n      # Cells occupied by any entity are blocked.\n      blocked = np.any(grid > 0, axis=2)\n\n      sx, sy = start\n      # Quick check: already adjacent?\n      for tx, ty in targets:\n          if abs(sx - tx) + abs(sy - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((sx, sy, []))\n      visited = np.full((H, W), False, dtype=bool)\n      visited[sy, sx] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR2ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[ny, nx]:\n                  if blocked[ny, nx]:\n                      continue\n                  npath = path + [act]\n                  # Check adjacency to any target.\n                  for tx, ty in targets:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return npath\n                  visited[ny, nx] = True\n                  q.append((nx, ny, npath))\n      # No reachable adjacency.\n      return []\n\n  # ----------------------------------------------------------------------\n  # Main planning logic\n  # ----------------------------------------------------------------------\n  # Current state (the environment holds a CraftLab wrapper around a CraftState).\n  state = env._current_state\n  grid = state.grid.copy()               # mutable copy of the world grid\n  pos = tuple(state.pos)                 # (x, y)\n\n  # Goal item index (the task stores a ``goal`` attribute \u2013 may be an int or a struct).\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      raise ValueError(\"Goal not found in env.task\")\n\n  # ------------------------------------------------------------------\n  # 1. Determine which primitive resources are needed to craft the goal.\n  # ------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  plan = []  # final list of actions to return\n\n  # ------------------------------------------------------------------\n  # 2. Collect each primitive the required number of times.\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      while needed > 0:\n          # Locate all cells that currently contain this primitive.\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # Primitive not present \u2013 cannot continue planning.\n              return plan\n\n          # Find a path to the nearest primitive (adjacent cell).\n          path = bfs(pos, prim_cells.tolist(), grid)\n          plan.extend(path)\n\n          # Simulate the movement so that ``pos`` stays in sync.\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Use (collect) the primitive.\n          plan.append(ACTION_USE)\n\n          # Determine which primitive cell we are now adjacent to.\n          adj_cell = None\n          for cx, cy in prim_cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  adj_cell = (cx, cy)\n                  break\n          if adj_cell is None:\n              # Unexpected situation; break to avoid infinite loop.\n              break\n\n          # Update our local grid copy (remove one instance) and decrement counter.\n          grid[adj_cell[1], adj_cell[0], prim_idx] -= 1\n          needed -= 1\n\n  # ------------------------------------------------------------------\n  # 3. Move to the appropriate workshop (if any) and craft the goal.\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (could be name or integer).\n      if isinstance(workshop_key, str):\n          workshop_idx = env.world.cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          path = bfs(pos, workshop_cells.tolist(), grid)\n          plan.extend(path)\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          # Craft (use) at the workshop.\n          plan.append(ACTION_USE)\n\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T15:47:21.257141", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS to a cell adjacent to any target cell\n  # ----------------------------------------------------------------------\n  DIR2ACT = {\n      (0, 1): 0,   # DOWN\n      (0, -1): 1,  # UP\n      (-1, 0): 2,  # LEFT\n      (1, 0): 3,   # RIGHT\n  }\n  ACT2DIR = {v: k for k, v in DIR2ACT.items()}\n\n  def bfs(start, targets, grid):\n      \"\"\"Return a list of actions moving from ``start`` to a position\n      adjacent (Manhattan distance 1) to any cell in ``targets``.\n      ``grid`` is (H, W, K); any non\u2011zero entry in the last axis is\n      considered blocked for movement.\n      \"\"\"\n      H, W = grid.shape[:2]\n      blocked = np.any(grid > 0, axis=2)\n\n      sx, sy = start\n      # Already adjacent?\n      for tx, ty in targets:\n          if abs(sx - tx) + abs(sy - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((sx, sy, []))\n      visited = np.full((H, W), False, dtype=bool)\n      visited[sy, sx] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR2ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[ny, nx]:\n                  if blocked[ny, nx]:\n                      continue\n                  npath = path + [act]\n                  for tx, ty in targets:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return npath\n                  visited[ny, nx] = True\n                  q.append((nx, ny, npath))\n      # No reachable adjacency.\n      return []\n\n  # ----------------------------------------------------------------------\n  # Main planning logic\n  # ----------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()\n  pos = tuple(state.pos)          # (x, y)\n\n  # Goal index from the task.\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      raise ValueError(\"Goal index not found in environment task.\")\n\n  # Primitive requirements for the goal (flattened to primitives only).\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  plan = []\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives.\n  # ------------------------------------------------------------------\n  for prim_idx, count_needed in primitives_needed.items():\n      while count_needed > 0:\n          # Locate cells that still contain this primitive.\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # No more of this primitive on the map \u2013 abort planning.\n              return plan\n\n          # Find a path to the nearest reachable primitive (adjacent).\n          path = bfs(pos, prim_cells.tolist(), grid)\n          plan.extend(path)\n\n          # Simulate movement to update ``pos``.\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Perform USE to pick up the primitive.\n          plan.append(4)   # USE action\n\n          # Identify which primitive cell we are now adjacent to.\n          adj_cell = None\n          for cx, cy in prim_cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  adj_cell = (cx, cy)\n                  break\n          if adj_cell is None:\n              # Should not happen; break to avoid infinite loop.\n              break\n\n          # Update local grid copy (remove one instance) and decrement need.\n          grid[adj_cell[1], adj_cell[0], prim_idx] -= 1\n          count_needed -= 1\n\n  # ------------------------------------------------------------------\n  # 2. Move to the appropriate workshop and craft the goal item.\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (could be string name or int).\n      if isinstance(workshop_key, str):\n          workshop_idx = env.world.cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          path = bfs(pos, workshop_cells.tolist(), grid)\n          plan.extend(path)\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          # Craft by using the workshop.\n          plan.append(4)   # USE action\n\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T15:47:54.074481", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Generic planner for the \"make arrow\" task.\n  # Returns a list of action indices that (approximately) collect the\n  # required primitives and then attempts to craft the arrow.\n  # ----------------------------------------------------------------------\n  import numpy as np\n\n  # Action indices as defined by CraftLab.action_specs\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Reset the environment to get a fresh state.\n  # The reset call returns an observation dict; the underlying state is\n  # stored inside the env instance as ``_current_state``.\n  env.reset()\n  state = env._current_state          # type: CraftState\n  world = env.world                    # type: CraftWorld\n  grid = state.grid                     # (W, H, n_kinds)\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that\n      moves the agent from ``start`` to ``goal`` using a simple\n      Manhattan walk.  The function does NOT check for obstacles \u2013 it\n      is a best\u2011effort path that works in most open maps.\"\"\"\n      actions = []\n      y, x = start\n      gy, gx = goal\n      dy, dx = gy - y, gx - x\n\n      if dy > 0:\n          actions += [DOWN] * dy\n      elif dy < 0:\n          actions += [UP] * (-dy)\n\n      if dx > 0:\n          actions += [RIGHT] * dx\n      elif dx < 0:\n          actions += [LEFT] * (-dx)\n\n      return actions\n\n  def find_nearest(cell_kind, from_pos):\n      \"\"\"Find the nearest cell that contains ``cell_kind`` (primitive)\n      using a simple linear scan.  Returns the cell coordinate (y, x)\n      or ``None`` if not found.\"\"\"\n      locations = np.argwhere(grid[:, :, cell_kind] > 0)\n      if locations.size == 0:\n          return None\n      # Manhattan distance to each candidate\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest_idx = np.argmin(dists)\n      return tuple(locations[nearest_idx])\n\n  # ------------------------------------------------------------------\n  # Determine the index of the goal item (\"arrow\") and the primitives\n  # required to craft it.\n  # ------------------------------------------------------------------\n  # ``world.cookbook.index`` maps names \u2192 integer IDs.\n  arrow_idx = world.cookbook.index.index('arrow')\n  # ``primitives_for`` returns a dict {primitive_idx: count}\n  needed = world.cookbook.primitives_for(arrow_idx)\n\n  # ------------------------------------------------------------------\n  # Build the action sequence.\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # Collect each required primitive the required number of times.\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target_cell = find_nearest(prim_idx, cur_pos)\n          if target_cell is None:\n              # Primitive not found \u2013 give up early.\n              return actions\n\n          # Choose an adjacent cell that is inside the map bounds.\n          # Prefer the cell that is directly next to the primitive in the\n          # direction we will approach from.\n          ty, tx = target_cell\n          # Try the four neighbours in a fixed order.\n          neighbours = [\n              (ty - 1, tx),  # above (face DOWN)\n              (ty + 1, tx),  # below (face UP)\n              (ty, tx - 1),  # left  (face RIGHT)\n              (ty, tx + 1),  # right (face LEFT)\n          ]\n          adj = None\n          for n in neighbours:\n              ny, nx = n\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  # A cell is considered free if no non\u2011grabbable entity occupies it.\n                  # ``world.non_grabbable_indices`` holds those kinds.\n                  occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)\n                  if not occupied:\n                      adj = (ny, nx)\n                      break\n          if adj is None:\n              # If no free neighbour, just move onto the primitive cell itself.\n              adj = target_cell\n\n          # Move to the adjacent cell.\n          actions += manhattan_path(cur_pos, adj)\n          cur_pos = adj\n\n          # After arriving, ensure we are facing the primitive.\n          # Determine required facing direction.\n          dy, dx = ty - cur_pos[0], tx - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)   # face down towards primitive\n          elif dy == -1:\n              actions.append(UP)     # face up\n          elif dx == 1:\n              actions.append(RIGHT)  # face right\n          elif dx == -1:\n              actions.append(LEFT)   # face left\n          else:\n              # Already on the same cell; just use without turning.\n              pass\n\n          # Use action to pick up the primitive.\n          actions.append(USE)\n\n  # ------------------------------------------------------------------\n  # Finally, attempt to craft the arrow.\n  # The recipe typically specifies a workshop via the special key \"_at\".\n  # We look it up and move to the nearest workshop of that type (if any).\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      # Find nearest workshop cell.\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          actions += manhattan_path(cur_pos, ws_cell)\n          cur_pos = ws_cell\n  # Use action to trigger crafting at the current location.\n  actions.append(USE)\n\n  return actions", "env_interactions": 27, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T15:47:55.192847", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Helper functions used inside the body\n  # ----------------------------------------------------------------------\n  def _bfs_path(grid, start, target):\n      \"\"\"Return a list of movement actions (0\u20113) that brings the agent from\n      ``start`` to a cell adjacent to ``target`` while avoiding blocked cells.\n      The grid is a (W, H, K) array; a cell is blocked if any kind is present.\n      \"\"\"\n      from collections import deque\n\n      W, H, _ = grid.shape\n      # Directions: 0\u2011DOWN, 1\u2011UP, 2\u2011LEFT, 3\u2011RIGHT\n      moves = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n\n      # Check adjacency\n      def adjacent(p, q):\n          return abs(p[0] - q[0]) + abs(p[1] - q[1]) == 1\n\n      # BFS over empty cells\n      visited = np.full((W, H), False, dtype=bool)\n      prev = dict()               # (x, y) -> (prev_pos, action)\n\n      q = deque()\n      q.append(start)\n      visited[start] = True\n\n      while q:\n          cur = q.popleft()\n          if adjacent(cur, target):\n              # reconstruct path\n              path = []\n              while cur != start:\n                  cur, act = prev[cur]\n                  path.append(act)\n              return list(reversed(path))\n\n          for a, (dx, dy) in enumerate(moves):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < W and 0 <= ny < H:\n                  if not visited[nx, ny]:\n                      # a cell is traversable iff it is completely empty\n                      if not grid[nx, ny].any():\n                          visited[nx, ny] = True\n                          prev[(nx, ny)] = (cur, a)\n                          q.append((nx, ny))\n      # No path found \u2013 return empty list (caller will treat as failure)\n      return []\n\n  # ----------------------------------------------------------------------\n  # Begin actual planning\n  # ----------------------------------------------------------------------\n  # reset the environment to a fresh state and obtain the initial observation\n  env.reset()\n  obs = env.observations()\n  state = env._current_state           # internal CraftState (accessible here)\n\n  world = state.world                  # CraftWorld instance\n  goal_idx = env.task.goal             # integer index of the desired item\n\n  # ------------------------------------------------------------------\n  # Determine which primitives are required and the workshop where\n  # the final crafting must happen.\n  # ------------------------------------------------------------------\n  # full recipe dict (ingredients + optional \"_at\")\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\", None)\n\n  # map primitive indices to required counts\n  primitives_needed = {\n      k: v for k, v in recipe.items() if k != \"_at\"\n  }\n\n  # Resolve workshop index (if any)\n  workshop_idx = None\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n\n  actions = []          # final action sequence to be returned\n\n  # ------------------------------------------------------------------\n  # Helper to collect a single primitive until we have enough copies.\n  # ------------------------------------------------------------------\n  def _collect_primitive(kind, needed):\n      nonlocal actions, state\n\n      while state.inventory[kind] < needed:\n          # locate any cell that currently contains the primitive\n          locations = np.argwhere(state.grid[:, :, kind] > 0)\n          if locations.size == 0:\n              # nothing left on the map \u2013 break to avoid infinite loop\n              break\n          # pick the closest location (Manhattan distance) to current pos\n          dists = np.abs(locations[:, 0] - state.pos[0]) + \\\n                  np.abs(locations[:, 1] - state.pos[1])\n          target = tuple(locations[dists.argmin()])\n\n          # compute movement actions to get adjacent to the primitive\n          move_seq = _bfs_path(state.grid, state.pos, target)\n          for a in move_seq:\n              reward, new_state = state.step(a)\n              actions.append(a)\n              state = new_state\n\n          # now we are adjacent \u2013 use action 4 to pick it up\n          reward, new_state = state.step(4)   # USE\n          actions.append(4)\n          state = new_state\n\n  # ------------------------------------------------------------------\n  # Collect all required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in primitives_needed.items():\n      _collect_primitive(prim_idx, cnt)\n\n  # ------------------------------------------------------------------\n  # If a workshop is needed, move there and issue a USE action to craft.\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      # locate any workshop cell of the required type\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          dists = np.abs(workshop_cells[:, 0] - state.pos[0]) + \\\n                  np.abs(workshop_cells[:, 1] - state.pos[1])\n          w_target = tuple(workshop_cells[dists.argmin()])\n\n          move_seq = _bfs_path(state.grid, state.pos, w_target)\n          for a in move_seq:\n              reward, new_state = state.step(a)\n              actions.append(a)\n              state = new_state\n\n          # final USE to craft the goal item\n          reward, new_state = state.step(4)   # USE\n          actions.append(4)\n          state = new_state\n\n  # Return the compiled action list\n  return actions", "env_interactions": 0, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T15:48:24.102995", "function_name": "make_arrow", "function_body": "  # Retrieve the scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 400                     # safety bound on plan length\n  n_actions = getattr(world, \"n_actions\", 5)  # default to 5 actions (0\u20114)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long plans\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          h = _state_hash(next_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(next_state, node.actions + [a]))\n\n  # No plan found within limits\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T15:48:39.700859", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # target item index\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # initial state\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      # hash includes position, direction, inventory, and full grid layout\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 400                         # safety bound on plan length\n  n_actions = getattr(world, \"n_actions\", 5)  # default action count (0\u20114)\n\n  # primitive requirements for the goal (used only for possible heuristics)\n  needed_prims = world.cookbook.primitives_for(target_idx)\n  needed_prim_idxs = set(needed_prims.keys())\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long plans\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within limits\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
