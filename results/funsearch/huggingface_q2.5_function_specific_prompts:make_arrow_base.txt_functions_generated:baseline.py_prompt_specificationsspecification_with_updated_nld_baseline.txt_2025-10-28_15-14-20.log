{"timestamp": "2025-10-28T23:48:08.190159", "function_name": "make_arrow", "function_body": "  # Retrieve the underlying scenario and world objects (handle possible wrappers)\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Obtain the initial CraftState for this episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  # Bread\u2011first search over CraftState space to find a plan\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _hash_state(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      # Use bytes representation for inventory and grid to keep it compact\n      return (st.pos, st.dir, st.inventory.tobytes(), st.grid.tobytes())\n\n  visited = set()\n  frontier = deque([Node(init_state, [])])\n  visited.add(_hash_state(init_state))\n\n  MAX_PLAN_LEN = 300          # safety cutoff to avoid infinite search\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state, cur_actions = node.state, node.actions\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return cur_actions\n\n      # Prune overly long plans\n      if len(cur_actions) >= MAX_PLAN_LEN:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _hash_state(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, cur_actions + [a]))\n\n  # No plan found within limits\n  return []", "env_interactions": 20, "island_id": 8, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:48:23.015325", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Resolve the underlying scenario and world objects (the env may be wrapped)\n  # ----------------------------------------------------------------------\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # ----------------------------------------------------------------------\n  # Identify the index of the target item \"arrow\"\n  # ----------------------------------------------------------------------\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # ----------------------------------------------------------------------\n  # Get the initial state for this episode\n  # ----------------------------------------------------------------------\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  # ----------------------------------------------------------------------\n  # Bread\u2011first search over the CraftState space\n  # ----------------------------------------------------------------------\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      # inventory and grid are numpy arrays \u2013 use bytes for fast hashing\n      return (st.pos, st.dir, st.inventory.tobytes(), st.grid.tobytes())\n\n  visited = set()\n  frontier = deque([Node(init_state, [])])\n  visited.add(_state_hash(init_state))\n\n  # safety limits\n  MAX_PLAN_LEN = 400\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state, cur_actions = node.state, node.actions\n\n      # Goal test: we have at least one arrow in the inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return cur_actions\n\n      # Prune overly long plans\n      if len(cur_actions) >= MAX_PLAN_LEN:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, cur_actions + [a]))\n\n  # No plan found within the limits \u2013 return empty plan\n  return []", "env_interactions": 20, "island_id": 8, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:48:49.529305", "function_name": "make_arrow", "function_body": "  import collections, numpy as np\n\n  # Action indices as defined in CraftWorld.\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  def _bfs_adjacent(start, targets, blocked):\n      \"\"\"Return a list of actions that moves from start to a cell adjacent to any target.\"\"\"\n      w, h = blocked.shape\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n      while q:\n          x, y, path = q.popleft()\n          # Stop when we are orthogonally adjacent to a target.\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n          for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not blocked[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      return []\n\n  def _apply(pos, actions):\n      \"\"\"Apply a list of actions to a position and return the new position.\"\"\"\n      x, y = pos\n      for a in actions:\n          if a == RIGHT:\n              x += 1\n          elif a == LEFT:\n              x -= 1\n          elif a == DOWN:\n              y += 1\n          elif a == UP:\n              y -= 1\n      return (x, y)\n\n  # ------------------------------------------------------------------\n  # Locate the world and cookbook objects inside the environment.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      cur_state = getattr(env, \"_current_state\", None)\n      if cur_state is not None:\n          world = getattr(cur_state, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"Cannot locate CraftWorld instance in the provided environment.\")\n  cookbook = world.cookbook\n\n  # ------------------------------------------------------------------\n  # Ensure we have a current state; reset the environment if needed.\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  # Goal item name (hard\u2011coded to arrow).\n  goal_name = \"arrow\"\n  if goal_name not in cookbook.index.contents:\n      raise ValueError(f\"Goal '{goal_name}' not found in the recipe file.\")\n  goal_idx = cookbook.index[goal_name]\n\n  # Primitives required to craft the goal.\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Planning structures.\n  # ------------------------------------------------------------------\n  pos = tuple(state.pos)                 # (x, y)\n  grid = state.grid.copy()               # (W, H, n_kinds)\n  blocked = np.any(grid, axis=2)         # bool mask of occupied cells\n  plan_actions = []                      # final action list\n  harvested = set()                      # cells already collected from\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive.\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      # Locate all cells that currently contain this primitive.\n      cells = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # Sort by Manhattan distance from current position to reduce travel.\n      cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n      collected = 0\n      for cell in cells:\n          if collected >= needed_cnt:\n              break\n          if cell in harvested:\n              continue\n          # Move adjacent to the primitive.\n          path = _bfs_adjacent(pos, [cell], blocked)\n          plan_actions.extend(path)\n          pos = _apply(pos, path)\n\n          # Pick it up.\n          plan_actions.append(USE)\n\n          # Update planning structures: cell is now empty.\n          grid[cell[0], cell[1], prim_idx] = 0\n          blocked = np.any(grid, axis=2)\n          harvested.add(cell)\n          collected += 1\n\n  # ------------------------------------------------------------------\n  # Craft the goal at its designated workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (may be a string name or already an int).\n      ws_idx = (cookbook.index[workshop_key]\n                if isinstance(workshop_key, str) else int(workshop_key))\n      ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, ws_idx] > 0)]\n      if ws_cells:\n          # Choose the nearest workshop.\n          ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          target_ws = ws_cells[0]\n          path = _bfs_adjacent(pos, [target_ws], blocked)\n          plan_actions.extend(path)\n          pos = _apply(pos, path)\n          plan_actions.append(USE)\n      else:\n          # No visible workshop; try crafting in place.\n          plan_actions.append(USE)\n  else:\n      # No specific workshop required; just attempt to craft.\n      plan_actions.append(USE)\n\n  return plan_actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T23:48:50.664133", "function_name": "make_arrow", "function_body": "  import collections\n  import numpy as np\n\n  # Action indices as defined in CraftWorld.\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving the agent from\n  # ``start`` to a cell orthogonally adjacent to any cell in ``targets``.\n  # ``blocked`` is a 2\u2011D boolean mask where True means the cell cannot be\n  # entered (e.g., occupied by terrain or an object).\n  # ------------------------------------------------------------------\n  def _bfs_adjacent(start, targets, blocked):\n      w, h = blocked.shape\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # Stop when we are orthogonally adjacent to a target cell.\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n          # Expand neighbours.\n          for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not blocked[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # No path found \u2013 return empty list.\n      return []\n\n  # ------------------------------------------------------------------\n  # Helper: apply a sequence of actions to a position.\n  # ------------------------------------------------------------------\n  def _apply(pos, actions):\n      x, y = pos\n      for a in actions:\n          if a == RIGHT:\n              x += 1\n          elif a == LEFT:\n              x -= 1\n          elif a == DOWN:\n              y += 1\n          elif a == UP:\n              y -= 1\n      return (x, y)\n\n  # ------------------------------------------------------------------\n  # Locate the world and cookbook objects inside the environment.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Some wrappers expose the world through the current state.\n      cur_state = getattr(env, \"_current_state\", None)\n      if cur_state is not None:\n          world = getattr(cur_state, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"Cannot locate CraftWorld instance in the provided environment.\")\n  cookbook = world.cookbook\n\n  # ------------------------------------------------------------------\n  # Ensure we have a current state; reset the environment if needed.\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  # Goal item name is hard\u2011coded to \"arrow\".\n  goal_name = \"arrow\"\n  if goal_name not in cookbook.index.contents:\n      raise ValueError(f\"Goal '{goal_name}' not found in the recipe file.\")\n  goal_idx = cookbook.index[goal_name]\n\n  # Primitives required to craft the goal (dict {prim_idx: count}).\n  primitives_needed = cookbook.primitives_for(goal_idx)\n\n  # ------------------------------------------------------------------\n  # Planning structures.\n  # ------------------------------------------------------------------\n  pos = tuple(state.pos)                     # current (x, y)\n  grid = state.grid.copy()                   # (W, H, n_kinds)\n  blocked = np.any(grid, axis=2)             # bool mask of occupied cells\n  plan_actions = []                          # final action list\n  harvested = set()                          # cells already collected from\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive.\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      # Locate all cells that currently contain this primitive.\n      cells = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # Sort by Manhattan distance from current position to reduce travel.\n      cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n      collected = 0\n      for cell in cells:\n          if collected >= needed_cnt:\n              break\n          if cell in harvested:\n              continue\n          # Move to a cell adjacent to the primitive.\n          path = _bfs_adjacent(pos, [cell], blocked)\n          plan_actions.extend(path)\n          pos = _apply(pos, path)\n\n          # Pick up the primitive.\n          plan_actions.append(USE)\n\n          # Update planning structures: the cell is now empty.\n          grid[cell[0], cell[1], prim_idx] = 0\n          blocked = np.any(grid, axis=2)\n          harvested.add(cell)\n          collected += 1\n\n  # ------------------------------------------------------------------\n  # Craft the goal at its designated workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (may be a string name or already an int).\n      ws_idx = (cookbook.index[workshop_key]\n                if isinstance(workshop_key, str) else int(workshop_key))\n      ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, ws_idx] > 0)]\n      if ws_cells:\n          # Choose the nearest workshop.\n          ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          target_ws = ws_cells[0]\n          path = _bfs_adjacent(pos, [target_ws], blocked)\n          plan_actions.extend(path)\n          pos = _apply(pos, path)\n          plan_actions.append(USE)\n      else:\n          # No visible workshop; attempt to craft at current location.\n          plan_actions.append(USE)\n  else:\n      # No specific workshop required \u2013 craft in place.\n      plan_actions.append(USE)\n\n  return plan_actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T23:49:23.053283", "function_name": "make_arrow", "function_body": "  # Ensure the environment is reset and obtain the current state\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  # Locate the world and cookbook objects\n  world = getattr(env, \"world\", None) or getattr(state, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"CraftWorld instance not found in the environment.\")\n  cookbook = world.cookbook\n\n  # Goal definition\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # Primitive requirements for one arrow\n  primitives_needed = cookbook.primitives_for(goal_idx)\n\n  # Work on a mutable copy of the grid to simulate pickups\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n\n  # Action constants\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  DIRS = [(0, 1, DOWN), (0, -1, UP), (-1, 0, LEFT), (1, 0, RIGHT)]\n\n  # ------------------------------------------------------------------\n  # Helper: BFS returning a list of movement actions that bring the\n  # agent from `start` to a cell adjacent to any of `targets`.\n  # ------------------------------------------------------------------\n  def _bfs_path(start, targets):\n      w, h, _ = grid.shape\n      occupied = np.any(grid > 0, axis=2)          # True where any entity exists\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # Check if current cell is target or adjacent to any target\n          for tx, ty in target_set:\n              if (x, y) == (tx, ty) or abs(x - tx) + abs(y - ty) == 1:\n                  return path\n          # Expand neighbours\n          for dx, dy, act in DIRS:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      return []   # Unreachable\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first)\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      collected = 0\n      while collected < needed_cnt:\n          # Find remaining locations of this primitive\n          locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n          if not locations:\n              break   # No more of this primitive; will fail later if needed\n          # Choose the nearest location (Manhattan distance)\n          locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_loc = locations[0]\n\n          # Move adjacent to the primitive\n          path = _bfs_path(pos, [target_loc])\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n\n          # Pick it up\n          actions.append(USE)\n          grid[target_loc[0], target_loc[1], prim_idx] = 0\n          collected += 1\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its designated workshop (if any)\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      workshop_idx = cookbook.index[workshop_key] if isinstance(workshop_key, str) else workshop_key\n      workshop_locs = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if workshop_locs:\n          workshop_locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = workshop_locs[0]\n          path = _bfs_path(pos, [target_ws])\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          actions.append(USE)\n  else:\n      # No specific workshop; attempt crafting at current position\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T23:49:24.171189", "function_name": "make_arrow", "function_body": "  # Ensure we have a current state; reset if necessary\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  # Locate the CraftWorld and its cookbook\n  world = getattr(env, \"world\", None)\n  if world is None:\n      world = getattr(state, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"CraftWorld instance not found in the environment.\")\n\n  cookbook = world.cookbook\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # Primitive requirements for a single arrow\n  primitives_needed = cookbook.primitives_for(goal_idx)\n\n  # Current position and grid\n  pos = tuple(state.pos)          # (x, y)\n  grid = state.grid                # (W, H, n_kinds)\n\n  actions = []\n  harvested = set()                # cells already used for collection\n\n  # ------------------------------------------------------------------\n  # Helper: BFS returning a list of movement actions that brings the\n  # agent from `start` to a cell adjacent to any of `targets`.\n  # The agent may step only on empty cells (no entity in any channel).\n  # ------------------------------------------------------------------\n  def _bfs_path(start, targets):\n      w, h, _ = grid.shape\n      occupied = np.any(grid > 0, axis=2)        # True where something exists\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # Check adjacency (including standing on the target)\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1 or (x, y) == (tx, ty):\n                  return path\n          # Expand neighbours\n          for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:      # can walk only on empty cells\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # No reachable target\n      return []\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first)\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      # Find all locations of this primitive on the current grid\n      locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # Sort by Manhattan distance from current position\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      gathered = 0\n      for loc in locations:\n          if gathered >= needed_cnt:\n              break\n          if loc in harvested:\n              continue\n          # Move adjacent to the primitive\n          path = _bfs_path(pos, [loc])\n          actions.extend(path)\n          # Simulate the movement to keep `pos` up\u2011to\u2011date\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Collect the primitive\n          actions.append(USE)\n          harvested.add(loc)\n          gathered += 1\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its designated workshop (if any)\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (may be a name or already an int)\n      workshop_idx = (cookbook.index[workshop_key]\n                      if isinstance(workshop_key, str) else workshop_key)\n      # Locate workshop cells on the grid\n      workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if workshop_cells:\n          # Choose the nearest workshop\n          workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = workshop_cells[0]\n          # Move adjacent to the workshop\n          path = _bfs_path(pos, [target_ws])\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Perform the crafting action\n          actions.append(USE)\n\n  return actions", "env_interactions": 0, "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-10-28T23:49:52.305384", "function_name": "make_arrow", "function_body": "  import collections, numpy as np\n\n  # Action indices (consistent with CraftWorld)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving from start to the\n  # nearest cell adjacent to any goal cell, avoiding occupied squares.\n  # ----------------------------------------------------------------------\n  def _bfs(start, goals, occ):\n      \"\"\"Return action list to reach a cell adjacent to a goal.\n\n      Args:\n          start: (x, y) tuple of current position.\n          goals: iterable of (x, y) goal positions.\n          occ: 2\u2011D bool array where True == blocked.\n\n      Returns:\n          List[int] of actions (may be empty if already adjacent).\n      \"\"\"\n      w, h = occ.shape\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      goal_set = set(goals)\n\n      # If already adjacent to a goal, no movement needed.\n      for gx, gy in goal_set:\n          if abs(start[0] - gx) + abs(start[1] - gy) == 1:\n              return []\n\n      while q:\n          x, y, path = q.popleft()\n          # Check adjacency to any goal\n          for gx, gy in goal_set:\n              if abs(x - gx) + abs(y - gy) == 1:\n                  return path\n          # Explore neighbours\n          for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occ[nx, ny]:          # free cell\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # No path found \u2013 return empty list (will likely fail later)\n      return []\n\n  # ----------------------------------------------------------------------\n  # Extract world, cookbook and current state\n  # ----------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # env may be a CraftWorld directly\n      world = env\n  cookbook = world.cookbook\n\n  # Ensure we have a current CraftState; reset if necessary\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  # Goal information\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # Current position and static grid\n  pos = tuple(state.pos)\n  grid = state.grid.copy()               # (W, H, n_kinds)\n  occupied = np.any(grid > 0, axis=2)    # True where any entity exists\n\n  actions = []\n  harvested = set()                      # cells already collected\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest first)\n  # ----------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      # Locate all cells that currently contain this primitive\n      prim_cells = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # Sort by Manhattan distance from current position\n      prim_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n      gathered = 0\n      for cell in prim_cells:\n          if gathered >= needed_cnt:\n              break\n          if cell in harvested:\n              continue\n          # Path to a square adjacent to the primitive cell\n          path = _bfs(pos, [cell], occupied)\n          actions.extend(path)\n          # Update position following the path\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Use action to pick up the primitive\n          actions.append(USE)\n          # Mark the cell as empty for subsequent navigation\n          grid[cell[0], cell[1], prim_idx] = 0\n          occupied[cell[0], cell[1]] = False\n          harvested.add(cell)\n          gathered += 1\n\n  # ----------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow\n  # ----------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (could be a name string)\n      workshop_idx = (cookbook.index[workshop_key]\n                      if isinstance(workshop_key, str)\n                      else workshop_key)\n      # Find all workshop cells\n      ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if ws_cells:\n          # Choose the nearest workshop\n          ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          target_ws = ws_cells[0]\n          path = _bfs(pos, [target_ws], occupied)\n          actions.extend(path)\n          # Update position\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Use action to craft at the workshop\n          actions.append(USE)\n\n  # Return the complete action sequence\n  return actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
