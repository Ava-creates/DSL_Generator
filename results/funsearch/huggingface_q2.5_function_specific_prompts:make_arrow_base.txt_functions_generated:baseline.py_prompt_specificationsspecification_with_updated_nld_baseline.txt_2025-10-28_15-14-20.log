{"timestamp": "2025-10-28T18:57:26.609319", "function_name": "make_arrow", "function_body": "  # Action indices as defined by CraftLab.action_specs\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Reset the environment and fetch the underlying objects\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid                     # (W, H, n_kinds)\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def delta_to_action(dy, dx):\n      \"\"\"Convert a (dy,dx) movement into the corresponding action index.\"\"\"\n      if dy == 1:\n          return DOWN\n      if dy == -1:\n          return UP\n      if dx == 1:\n          return RIGHT\n      if dx == -1:\n          return LEFT\n      raise ValueError(\"Invalid delta for action\")\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of actions that moves from start to goal while\n      avoiding non\u2011grabbable obstacles. Goal cell itself may be occupied\n      (e.g., a workshop) \u2013 it is allowed.\"\"\"\n      from collections import deque\n\n      W, H, _ = grid.shape\n      blocked_set = set(world.non_grabbable_indices)\n\n      def is_blocked(y, x):\n          # a cell is blocked if any non\u2011grabbable entity occupies it\n          return np.any(grid[y, x, list(blocked_set)] > 0)\n\n      queue = deque()\n      queue.append(start)\n      visited = {start: None}\n      while queue:\n          cur = queue.popleft()\n          if cur == goal:\n              break\n          y, x = cur\n          for dy, dx, act in [(1, 0, DOWN), (-1, 0, UP), (0, 1, RIGHT), (0, -1, LEFT)]:\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < W and 0 <= nx < H and (ny, nx) not in visited:\n                  # Allow stepping onto the goal even if it is blocked\n                  if (ny, nx) != goal and is_blocked(ny, nx):\n                      continue\n                  visited[(ny, nx)] = (cur, act)\n                  queue.append((ny, nx))\n      else:\n          # No path found\n          return []\n\n      # Reconstruct actions\n      actions = []\n      cur = goal\n      while visited[cur] is not None:\n          prev, act = visited[cur]\n          actions.append(act)\n          cur = prev\n      actions.reverse()\n      return actions\n\n  def find_nearest(cell_kind, from_pos):\n      \"\"\"Locate the nearest cell containing `cell_kind`.\"\"\"\n      locations = np.argwhere(grid[:, :, cell_kind] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest_idx = np.argmin(dists)\n      return tuple(locations[nearest_idx])\n\n  # ------------------------------------------------------------------\n  # Determine the goal index for 'arrow' and its primitive requirements\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed_prims = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect all required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed_prims.items():\n      for _ in range(count):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive not found \u2013 abort early\n              return actions\n\n          ty, tx = target\n\n          # Choose a free neighbour of the primitive to stand on\n          adj_candidates = [(ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)]\n          adj = None\n          for ny, nx in adj_candidates:\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)\n                  if not occupied:\n                      adj = (ny, nx)\n                      break\n          if adj is None:\n              # Fallback: stand directly on the primitive cell itself\n              adj = target\n\n          # Move to the chosen adjacent cell\n          actions += bfs_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (perform a move action towards it; direction changes even if blocked)\n          dy, dx = ty - cur_pos[0], tx - cur_pos[1]\n          actions.append(delta_to_action(dy, dx))\n\n          # Pick up the primitive\n          actions.append(USE)\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          actions += bfs_path(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # Trigger crafting at the current location\n  actions.append(USE)\n\n  return actions", "env_interactions": 27, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T18:57:50.562551", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Helper mappings between directions and action indices (as defined in CraftLab)\n  # ----------------------------------------------------------------------\n  DIR_TO_ACT = {\n      (0, 1): 0,   # DOWN\n      (0, -1): 1,  # UP\n      (-1, 0): 2,  # LEFT\n      (1, 0): 3,   # RIGHT\n  }\n  ACT_TO_DIR = {v: k for k, v in DIR_TO_ACT.items()}\n\n  # ----------------------------------------------------------------------\n  # Bread\u2011first search that returns a list of actions moving the agent from\n  # ``start`` to a cell that is Manhattan\u2011adjacent to any cell in ``targets``.\n  # Cells occupied by any *non\u2011grabbable* entity are considered blocked.\n  # ----------------------------------------------------------------------\n  from collections import deque\n  import numpy as np\n\n  def bfs_to_adjacent(start, targets, grid):\n      \"\"\"Return a list of actions that brings the agent adjacent to a target.\"\"\"\n      W, H = grid.shape[:2]\n\n      # Build a blocked mask: any cell containing a non\u2011grabbable entity blocks movement.\n      blocked = np.zeros((W, H), dtype=bool)\n      for idx in env.world.non_grabbable_indices:\n          blocked |= grid[:, :, idx] > 0\n\n      sx, sy = start\n\n      # If already adjacent, no movement needed.\n      for tx, ty in targets:\n          if abs(sx - tx) + abs(sy - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((sx, sy, []))\n      visited = np.full((W, H), False, dtype=bool)\n      visited[sx, sy] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR_TO_ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if blocked[nx, ny]:\n                      continue\n                  npath = path + [act]\n                  # Check adjacency to any target.\n                  for tx, ty in targets:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return npath\n                  visited[nx, ny] = True\n                  q.append((nx, ny, npath))\n      # No reachable adjacency.\n      return []\n\n  # ----------------------------------------------------------------------\n  # Extract current state information.\n  # ----------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()               # mutable copy for planning\n  pos = tuple(state.pos)                 # (x, y)\n\n  # Goal index is stored in the task object.\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      raise ValueError(\"Goal index not found in the environment's task.\")\n\n  # Primitive requirements for the goal (primitive kind \u2192 count).\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)\n\n  plan = []  # List of action indices to be returned.\n\n  # ----------------------------------------------------------------------\n  # 1. Collect all required primitive resources.\n  # ----------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      while needed_cnt > 0:\n          # Locate all cells that currently contain this primitive.\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # No more of this primitive on the map \u2013 abort planning.\n              return plan\n\n          # Find a path to the nearest reachable primitive (adjacent).\n          path = bfs_to_adjacent(pos, prim_cells.tolist(), grid)\n          plan.extend(path)\n\n          # Simulate movement.\n          for a in path:\n              dx, dy = ACT_TO_DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Use action to pick up the primitive.\n          plan.append(4)   # USE\n\n          # Identify which primitive cell we are now adjacent to.\n          adj_cell = None\n          for cx, cy in prim_cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  adj_cell = (cx, cy)\n                  break\n          if adj_cell is None:\n              # Unexpected situation; break to avoid infinite loop.\n              break\n\n          # Update simulated grid copy (remove one instance) and decrement counter.\n          grid[adj_cell[0], adj_cell[1], prim_idx] -= 1\n          needed_cnt -= 1\n\n  # ----------------------------------------------------------------------\n  # 2. Move to the appropriate workshop (if any) and craft the goal.\n  # ----------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\") or recipe.get(\"_key\")\n  if workshop_key is not None:\n      # Resolve workshop index (string name or integer).\n      if isinstance(workshop_key, str):\n          workshop_idx = env.world.cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n\n      # Locate workshop cells on the current grid.\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          path = bfs_to_adjacent(pos, workshop_cells.tolist(), grid)\n          plan.extend(path)\n\n          # Simulate movement to the workshop.\n          for a in path:\n              dx, dy = ACT_TO_DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Craft the item by using the workshop.\n          plan.append(4)   # USE\n\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:57:51.678330", "function_name": "make_arrow", "function_body": "  \"\"\"Plan a sequence of actions that makes an ``arrow`` in the given environment.\n\n  The planner extracts the primitive requirements for the goal from the\n  cookbook, walks to each needed primitive, picks it up (USE), then walks to\n  the appropriate workshop (if any) and crafts the item (USE again).  The\n  returned list can be fed directly to the environment via ``step`` calls.\n  \"\"\"\n  import numpy as np\n  from collections import deque\n\n  # ------------------------------------------------------------------\n  # Helpers for movement \u2194 action conversion.\n  # ------------------------------------------------------------------\n  DIR_TO_ACT = {\n      (0, 1): 0,   # DOWN\n      (0, -1): 1,  # UP\n      (-1, 0): 2,  # LEFT\n      (1, 0): 3,   # RIGHT\n  }\n  ACT_TO_DIR = {v: k for k, v in DIR_TO_ACT.items()}\n\n  # ------------------------------------------------------------------\n  # Bread\u2011first search that returns a list of actions moving the agent\n  # from ``start`` to a cell that is Manhattan\u2011adjacent to any cell in\n  # ``targets``.  Any occupied cell (including primitives) is treated as\n  # blocked for movement.\n  # ------------------------------------------------------------------\n  def bfs_to_adjacent(start, targets, grid):\n      \"\"\"Return a list of actions to reach a neighbour of one of ``targets``.\"\"\"\n      W, H = grid.shape[:2]\n\n      # A cell is blocked if *any* kind is present there.\n      blocked = np.any(grid, axis=2)\n\n      sx, sy = start\n\n      # Already adjacent to a target?\n      for tx, ty in targets:\n          if abs(sx - tx) + abs(sy - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((sx, sy, []))\n      visited = np.full((W, H), False, dtype=bool)\n      visited[sx, sy] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR_TO_ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if blocked[nx, ny]:\n                      continue\n                  npath = path + [act]\n                  # Check adjacency to any target.\n                  for tx, ty in targets:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return npath\n                  visited[nx, ny] = True\n                  q.append((nx, ny, npath))\n      # No reachable adjacency.\n      return []\n\n  # ------------------------------------------------------------------\n  # Extract current state information.\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()          # mutable copy for planning simulation\n  pos = tuple(state.pos)            # (x, y)\n\n  # Goal index is stored in the task (a Task namedtuple).\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      raise ValueError(\"Goal index not found in environment task.\")\n\n  # ------------------------------------------------------------------\n  # Determine which primitive resources are required for the goal.\n  # ------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  plan = []  # final list of action indices\n\n  # ------------------------------------------------------------------\n  # 1. Collect each required primitive.\n  # ------------------------------------------------------------------\n  for prim_idx, required_cnt in primitives_needed.items():\n      while required_cnt > 0:\n          # Locate all cells that currently contain this primitive.\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # Primitive not present on the map \u2013 abort planning.\n              return plan\n\n          # Find a path to the nearest reachable primitive (adjacent).\n          path = bfs_to_adjacent(pos, prim_cells.tolist(), grid)\n          plan.extend(path)\n\n          # Simulate the movement.\n          for a in path:\n              dx, dy = ACT_TO_DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Use action to pick up the primitive.\n          plan.append(4)   # USE\n\n          # Identify which primitive cell we are now adjacent to.\n          adj_cell = None\n          for cx, cy in prim_cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  adj_cell = (cx, cy)\n                  break\n          if adj_cell is None:\n              # Unexpected situation \u2013 stop to avoid an infinite loop.\n              break\n\n          # Update simulated grid (remove one instance) and decrement count.\n          grid[adj_cell[0], adj_cell[1], prim_idx] -= 1\n          required_cnt -= 1\n\n  # ------------------------------------------------------------------\n  # 2. Move to the appropriate workshop (if any) and craft the goal.\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\") or recipe.get(\"_key\")\n  if workshop_key is not None:\n      # Resolve workshop kind index (string name or integer).\n      if isinstance(workshop_key, str):\n          workshop_idx = env.world.cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n\n      # Locate workshop cells on the current grid.\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          path = bfs_to_adjacent(pos, workshop_cells.tolist(), grid)\n          plan.extend(path)\n\n          # Simulate movement to the workshop.\n          for a in path:\n              dx, dy = ACT_TO_DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Craft the item by using the workshop.\n          plan.append(4)   # USE\n\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:58:11.432897", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  ...\n  return actions", "env_interactions": 0, "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-10-28T18:58:12.559236", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  # target item\n  target_name = \"arrow\"\n  target_idx = cookbook.index[target_name]\n\n  # local copies of the environment state\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n  width, height, _ = grid.shape\n  actions = []\n\n  from collections import deque\n\n  def bfs(start, goals):\n      \"\"\"Return a shortest list of actions from start to any cell in *goals*.\"\"\"\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          cur, path = q.popleft()\n          if cur in goals:\n              return path\n          x, y = cur\n          for dx, dy, act in [(0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)]:  # DOWN,UP,LEFT,RIGHT\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              nxt = (nx, ny)\n              if nxt in visited:\n                  continue\n              # allow stepping onto a goal cell even if occupied\n              if np.any(grid[nx, ny, :]) and nxt not in goals:\n                  continue\n              visited.add(nxt)\n              q.append((nxt, path + [act]))\n      return None\n\n  def move_along(path):\n      \"\"\"Update *pos* following a list of actions.\"\"\"\n      nonlocal pos\n      for a in path:\n          if a == 0:   # DOWN\n              pos = (pos[0], pos[1] + 1)\n          elif a == 1: # UP\n              pos = (pos[0], pos[1] - 1)\n          elif a == 2: # LEFT\n              pos = (pos[0] - 1, pos[1])\n          elif a == 3: # RIGHT\n              pos = (pos[0] + 1, pos[1])\n\n  # ----------------------------------------------------------------------\n  # Primitive collection\n  def collect_primitive(prim_idx, amount):\n      \"\"\"Collect *amount* of primitive *prim_idx* from the grid.\"\"\"\n      nonlocal actions, grid, inventory, pos\n      while amount > 0:\n          # locate all cells that still contain the primitive\n          locations = [(x, y) for x in range(width) for y in range(height)\n                       if grid[x, y, prim_idx] > 0]\n          if not locations:\n              break  # nothing left on the map\n          # find the nearest reachable location\n          best_path = None\n          best_loc = None\n          for loc in locations:\n              path = bfs(pos, {loc})\n              if path is not None:\n                  best_path = path\n                  best_loc = loc\n                  break\n          if best_path is None:\n              break  # unreachable\n          actions.extend(best_path)\n          move_along(best_path)\n          # pick up the primitive\n          actions.append(4)  # USE\n          grid[best_loc[0], best_loc[1], prim_idx] = 0\n          inventory[prim_idx] += 1\n          amount -= 1\n\n  # ----------------------------------------------------------------------\n  # Recursive crafting helper\n  recipes = cookbook.recipes\n  primitives_set = cookbook.primitives\n\n  def ensure_item(item_idx, needed):\n      \"\"\"Guarantee that *inventory[item_idx]* >= *needed*.\"\"\"\n      nonlocal actions, grid, inventory, pos\n      while inventory[item_idx] < needed:\n          # Primitives are collected directly\n          if item_idx in primitives_set:\n              collect_primitive(item_idx, needed - inventory[item_idx])\n              continue\n\n          # Otherwise craft using its recipe\n          recipe = recipes.get(item_idx, {})\n          # First make sure all ingredients are present\n          for ing_idx, cnt in list(recipe.items()):\n              if ing_idx == \"_at\":\n                  continue\n              if inventory[ing_idx] < cnt:\n                  ensure_item(ing_idx, cnt)\n\n          # Move to the required workshop, if any\n          workshop = recipe.get(\"_at\")\n          if workshop is not None:\n              ws_idx = workshop if isinstance(workshop, int) else cookbook.index[workshop]\n              ws_cells = [(x, y) for x in range(width) for y in range(height)\n                          if grid[x, y, ws_idx] > 0]\n              if ws_cells:\n                  # pick the closest workshop cell\n                  path = bfs(pos, set(ws_cells))\n                  if path:\n                      actions.extend(path)\n                      move_along(path)\n\n          # Perform the crafting action\n          actions.append(4)   # USE\n          # Update simulated inventory\n          for ing_idx, cnt in recipe.items():\n              if ing_idx == \"_at\":\n                  continue\n              inventory[ing_idx] -= cnt\n          inventory[item_idx] += 1\n\n  # ----------------------------------------------------------------------\n  # Build the arrow\n  ensure_item(target_idx, 1)\n\n  return actions", "env_interactions": 41, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T18:58:34.338132", "function_name": "make_arrow", "function_body": "  # Reset environment and initialise structures\n  env.reset()\n  actions = []\n  act_map = env.action_specs()                     # e.g. {\"UP\":0, \"DOWN\":1, ...}\n  goal_idx = env.task.goal\n  needed_prims = env.world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n\n  # Movement deltas for BFS\n  move_delta = {\n      \"UP\":    (-1, 0),\n      \"DOWN\":  (1, 0),\n      \"LEFT\":  (0, -1),\n      \"RIGHT\": (0, 1),\n  }\n\n  # ------------------------------------------------------------------\n  # Helper: BFS returning a list of action names that moves the agent\n  # from `start` to a cell adjacent (Chebyshev distance \u2264 1) to any\n  # target cell in `targets`.  Only empty cells may be traversed.\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  def bfs_to_adjacent(start, targets, grid):\n      \"\"\"Return list of action names to reach a cell adjacent to any target.\"\"\"\n      W, H = grid.shape[:2]\n      visited = set()\n      q = deque()\n      q.append((start, []))\n      visited.add(start)\n      target_set = set(targets)\n\n      while q:\n          pos, path = q.popleft()\n          # Check adjacency to any target\n          for tx, ty in target_set:\n              if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:\n                  return path\n          # Expand neighbours\n          for act_name, (dx, dy) in move_delta.items():\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in visited:\n                  if grid[nx, ny].sum() == 0:          # only walk through empty cells\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [act_name]))\n      return None  # unreachable\n\n  # ------------------------------------------------------------------\n  # 1) Gather all required primitive items\n  # ------------------------------------------------------------------\n  while True:\n      state = env._current_state\n      inventory = state.inventory\n      # Stop when we have enough of each primitive\n      if all(inventory[p_idx] >= cnt for p_idx, cnt in needed_prims.items()):\n          break\n\n      # Find a primitive we are still missing\n      missing_idx = None\n      for p_idx, cnt in needed_prims.items():\n          if inventory[p_idx] < cnt:\n              missing_idx = p_idx\n              break\n      if missing_idx is None:\n          break  # safety\n\n      # Locate cells containing the missing primitive\n      prim_cells = list(zip(*np.where(state.grid[:, :, missing_idx] > 0)))\n      if not prim_cells:\n          raise RuntimeError(f\"Primitive {missing_idx} not found in the world.\")\n\n      # Plan a path to an adjacent cell of one of those primitives\n      path = bfs_to_adjacent(state.pos, prim_cells, state.grid)\n      if path is None:\n          raise RuntimeError(f\"Primitive {missing_idx} is unreachable from position {state.pos}.\")\n\n      # Execute movement actions\n      for act_name in path:\n          aid = act_map[act_name]\n          actions.append(aid)\n          env.step(aid)\n\n      # Pick up the primitive\n      use_aid = act_map[\"USE\"]\n      actions.append(use_aid)\n      env.step(use_aid)\n\n  # ------------------------------------------------------------------\n  # 2) Move to the required workshop (if any) and craft the goal item\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      state = env._current_state\n      workshop_cells = list(zip(*np.where(state.grid[:, :, workshop_kind] > 0)))\n      if not workshop_cells:\n          raise RuntimeError(\"Required workshop not present in the world.\")\n      path = bfs_to_adjacent(state.pos, workshop_cells, state.grid)\n      if path is None:\n          raise RuntimeError(\"Workshop is unreachable from current position.\")\n      for act_name in path:\n          aid = act_map[act_name]\n          actions.append(aid)\n          env.step(aid)\n\n  # Final USE to craft (or to pick up if no workshop needed)\n  final_use = act_map[\"USE\"]\n  actions.append(final_use)\n  env.step(final_use)\n\n  return actions", "env_interactions": 1, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:58:35.457220", "function_name": "make_arrow", "function_body": "  env.reset()\n  actions = []\n  act_map = env.action_specs()\n  goal_idx = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal_idx)\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get('_at', None)\n\n  move_delta = {\n      \"UP\": (-1, 0),\n      \"DOWN\": (1, 0),\n      \"LEFT\": (0, -1),\n      \"RIGHT\": (0, 1),\n  }\n\n  from collections import deque\n\n  def bfs_to_adjacent(start, targets, grid):\n      \"\"\"Return a list of action names to reach a cell adjacent to any target.\"\"\"\n      W, H = grid.shape[:2]\n      visited = set()\n      q = deque()\n      q.append((start, []))\n      visited.add(start)\n      target_set = set(targets)\n\n      while q:\n          pos, path = q.popleft()\n          # Check adjacency to any target\n          for tx, ty in target_set:\n              if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:\n                  return path\n          # Expand neighbours\n          for act_name, (dx, dy) in move_delta.items():\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in visited:\n                  # Walk only through empty cells\n                  if grid[nx, ny].sum() == 0:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [act_name]))\n      return None\n\n  # ----------------------------------------------------------------------\n  # 1) Collect required primitive items\n  # ----------------------------------------------------------------------\n  while True:\n      state = env._current_state\n      inventory = state.inventory\n      if all(inventory[p_idx] >= cnt for p_idx, cnt in needed.items()):\n          break\n\n      # Find a primitive we still need\n      missing_idx = None\n      for p_idx, cnt in needed.items():\n          if inventory[p_idx] < cnt:\n              missing_idx = p_idx\n              break\n      if missing_idx is None:\n          break  # Should not happen\n\n      # Locate cells containing this primitive\n      prim_cells = list(zip(*np.where(state.grid[:, :, missing_idx] > 0)))\n      if not prim_cells:\n          raise RuntimeError(f\"Primitive {missing_idx} not found on the map.\")\n\n      # Plan path to an adjacent cell of the primitive\n      path = bfs_to_adjacent(state.pos, prim_cells, state.grid)\n      if path is None:\n          raise RuntimeError(f\"Primitive {missing_idx} is unreachable from position {state.pos}.\")\n\n      # Execute movement actions\n      for act_name in path:\n          aid = act_map[act_name]\n          actions.append(aid)\n          env.step(aid)\n\n      # Pick up the primitive\n      use_id = act_map[\"USE\"]\n      actions.append(use_id)\n      env.step(use_id)\n\n  # ----------------------------------------------------------------------\n  # 2) Move to workshop (if required) and craft the goal item\n  # ----------------------------------------------------------------------\n  if workshop_kind is not None:\n      state = env._current_state\n      workshop_cells = list(zip(*np.where(state.grid[:, :, workshop_kind] > 0)))\n      if not workshop_cells:\n          raise RuntimeError(\"Required workshop not found on the map.\")\n\n      path = bfs_to_adjacent(state.pos, workshop_cells, state.grid)\n      if path is None:\n          raise RuntimeError(\"Workshop is unreachable from current position.\")\n\n      for act_name in path:\n          aid = act_map[act_name]\n          actions.append(aid)\n          env.step(aid)\n\n  # Final USE to craft (or to pick up if no workshop needed)\n  final_use = act_map[\"USE\"]\n  actions.append(final_use)\n  env.step(final_use)\n\n  return actions", "env_interactions": 1, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:59:06.531913", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action indices as defined by CraftLab\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n  DIR2ACT = {(0, 1): ACTION_DOWN,\n             (0, -1): ACTION_UP,\n             (-1, 0): ACTION_LEFT,\n             (1, 0): ACTION_RIGHT}\n  ACT2DIR = {v: k for k, v in DIR2ACT.items()}\n\n  def bfs_to_adjacent(start, targets, occupied):\n      \"\"\"Return a list of actions that moves from ``start`` to a cell adjacent\n      to any cell in ``targets`` while avoiding cells where ``occupied`` is True.\n      If already adjacent, returns an empty list.\"\"\"\n      W, H = occupied.shape\n      # Already adjacent?\n      for tx, ty in targets:\n          if abs(start[0] - tx) + abs(start[1] - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = np.zeros((W, H), dtype=bool)\n      visited[start[0], start[1]] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR2ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny] and not occupied[nx, ny]:\n                  new_path = path + [act]\n                  # Check adjacency from the new cell\n                  for tx, ty in targets:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return new_path\n                  visited[nx, ny] = True\n                  q.append((nx, ny, new_path))\n      # No reachable adjacent cell\n      return []\n\n  # ------------------------------------------------------------------\n  # Extract current world information\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()               # mutable copy of the grid\n  pos = tuple(state.pos)                 # (x, y)\n\n  # Goal index stored in the task (may be an int or a string name)\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      # Nothing to do\n      return []\n\n  # If the goal is a name, resolve it via the world index\n  if isinstance(goal_idx, str):\n      goal_idx = env.world.cookbook.index[goal_idx]\n\n  # Primitive (and intermediate) requirements for the goal.\n  needed = env.world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n  plan = []\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives.\n  # ------------------------------------------------------------------\n  for kind_idx, count in needed.items():\n      while count > 0:\n          # Locate cells that still contain this primitive.\n          cells = np.argwhere(grid[:, :, kind_idx] > 0)\n          if cells.size == 0:\n              # Primitive not available \u2013 abort planning.\n              return plan\n\n          # Cells occupied by any entity block movement.\n          occupied = np.any(grid > 0, axis=2)\n\n          # Find a path to a position adjacent to one of the primitive cells.\n          path = bfs_to_adjacent(pos, cells.tolist(), occupied)\n          plan.extend(path)\n\n          # Simulate movement to keep ``pos`` up\u2011to\u2011date.\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Pick up the primitive.\n          plan.append(ACTION_USE)\n\n          # Identify which primitive cell we are now adjacent to.\n          adj_cell = None\n          for cx, cy in cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  adj_cell = (cx, cy)\n                  break\n          if adj_cell is None:\n              # Safety break to avoid infinite loop.\n              break\n\n          # Update local grid copy and decrement remaining count.\n          grid[adj_cell[0], adj_cell[1], kind_idx] -= 1\n          count -= 1\n\n  # ------------------------------------------------------------------\n  # 2. Move to the workshop (if required) and craft the goal item.\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (could be a name or integer).\n      if isinstance(workshop_key, str):\n          workshop_idx = env.world.cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          occupied = np.any(grid > 0, axis=2)\n          path = bfs_to_adjacent(pos, workshop_cells.tolist(), occupied)\n          plan.extend(path)\n\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Craft by using the workshop.\n          plan.append(ACTION_USE)\n\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:59:07.633481", "function_name": "make_arrow", "function_body": "", "env_interactions": 0, "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-10-28T18:59:35.492979", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:\n      return []\n\n  # BFS to get movement actions to be adjacent with target in front\n  def bfs_to_target(cur_state, target_kind):\n      grid = cur_state.grid\n      W, H = grid.shape[:2]\n      deltas = {0:(0,1), 1:(0,-1), 2:(-1,0), 3:(1,0)}  # DOWN,UP,LEFT,RIGHT\n\n      def in_bounds(x,y):\n          return 0 <= x < W and 0 <= y < H\n      def walkable(x,y):\n          return in_bounds(x,y) and not np.any(grid[x,y,:])\n\n      sx, sy = cur_state.pos\n      sd = cur_state.dir\n      from collections import deque\n      q = deque()\n      q.append((sx,sy,sd,[]))\n      visited = {(sx,sy,sd)}\n      while q:\n          x,y,d,acts = q.popleft()\n          dx,dy = deltas[d]\n          fx,fy = x+dx, y+dy\n          if in_bounds(fx,fy) and grid[fx,fy,target_kind] > 0:\n              return acts\n          for a in (0,1,2,3):\n              ndx,ndy = deltas[a]\n              nx,ny = x+ndx, y+ndy\n              if not walkable(nx,ny):\n                  continue\n              if (nx,ny,a) in visited:\n                  continue\n              visited.add((nx,ny,a))\n              q.append((nx,ny,a,acts+[a]))\n      return []\n\n  actions = []\n  primitive_needs = world.cookbook.primitives_for(arrow_idx)  # dict kind->count\n\n  for kind, cnt in primitive_needs.items():\n      for _ in range(cnt):\n          move_seq = bfs_to_target(state, kind)\n          if not move_seq and not state.next_to(kind):\n              return actions\n          actions.extend(move_seq)\n          actions.append(4)  # USE\n          for a in move_seq + [4]:\n              _, state = state.step(a)\n\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      wk_idx = world.cookbook.index.index(workshop_name)\n      move_seq = bfs_to_target(state, wk_idx)\n      actions.extend(move_seq)\n      actions.append(4)\n      for a in move_seq + [4]:\n          _, state = state.step(a)\n  else:\n      actions.append(4)\n      _, state = state.step(4)\n\n  return actions", "env_interactions": 26, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T18:59:36.608657", "function_name": "make_arrow", "function_body": "  env.reset()\n  cur_state = env._current_state\n  world = env.world\n\n  # Index of the goal item \"arrow\"\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:\n      return []\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of movement actions (0\u20113) which\n  # bring the agent to a position where the cell directly in front\n  # contains `target_kind`. Returns [] if the target cannot be reached.\n  # ------------------------------------------------------------------\n  def _bfs_to_target(state, target_kind):\n      grid = state.grid\n      W, H = grid.shape[:2]\n\n      # action \u2192 (dx, dy)\n      deltas = {\n          0: (0, 1),   # DOWN\n          1: (0, -1),  # UP\n          2: (-1, 0),  # LEFT\n          3: (1, 0),   # RIGHT\n      }\n\n      def _in_bounds(x, y):\n          return 0 <= x < W and 0 <= y < H\n\n      def _walkable(x, y):\n          if not _in_bounds(x, y):\n              return False\n          # a cell is walkable if it contains no entities at all\n          return not np.any(grid[x, y, :])\n\n      from collections import deque\n      q = deque()\n      sx, sy = state.pos\n      sd = state.dir\n      q.append((sx, sy, sd, []))\n      visited = {(sx, sy, sd)}\n\n      while q:\n          x, y, d, acts = q.popleft()\n          dx, dy = deltas[d]\n          fx, fy = x + dx, y + dy\n          if _in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:\n              return acts\n\n          for a in (0, 1, 2, 3):\n              ndx, ndy = deltas[a]\n              nx, ny = x + ndx, y + ndy\n              if not _walkable(nx, ny):\n                  continue\n              if (nx, ny, a) in visited:\n                  continue\n              visited.add((nx, ny, a))\n              q.append((nx, ny, a, acts + [a]))\n\n      return []\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Gather all primitive resources required for a single arrow.\n  # ------------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}\n  for prim_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          move_actions = _bfs_to_target(cur_state, prim_idx)\n          if not move_actions and not cur_state.next_to(prim_idx):\n              # Target unreachable \u2013 abort early.\n              return actions\n          actions.extend(move_actions)\n          actions.append(4)                     # USE to pick up\n          for a in move_actions + [4]:\n              _, cur_state = cur_state.step(a)\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      move_actions = _bfs_to_target(cur_state, workshop_idx)\n      actions.extend(move_actions)\n      actions.append(4)                     # USE to craft\n      for a in move_actions + [4]:\n          _, cur_state = cur_state.step(a)\n  else:\n      actions.append(4)                     # USE to craft in place\n      _, cur_state = cur_state.step(4)\n\n  return actions", "env_interactions": 26, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T19:00:14.365254", "function_name": "make_arrow", "function_body": "  # Action indices (standard CraftWorld)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  def bfs_actions(start, targets, grid):\n      \"\"\"Return a list of actions moving from *start* to a cell adjacent to any\n      coordinate in *targets* while avoiding occupied cells.\"\"\"\n      w, h, _ = grid.shape\n      occupied = np.any(grid > 0, axis=2)\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n      while q:\n          x, y, path = q.popleft()\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) <= 1:\n                  return path\n          for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      return []\n\n  # ------------------------------------------------------------------\n  # Obtain world, cookbook and a fresh state.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      tmp = getattr(env, \"_current_state\", None)\n      if tmp is not None:\n          world = tmp.world\n  if world is None:\n      raise RuntimeError(\"World object not found in the environment.\")\n  cookbook = world.cookbook\n\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  # ------------------------------------------------------------------\n  # Goal is the hard\u2011coded item \u201carrow\u201d.\n  # ------------------------------------------------------------------\n  goal_idx = cookbook.index[\"arrow\"]\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  pos = tuple(state.pos)                # (x, y)\n  grid = state.grid.copy()              # mutable copy for planning\n  actions = []\n  harvested = set()\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive, nearest\u2011first.\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      collected = 0\n      while collected < needed:\n          candidates = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)\n                        if tuple(p) not in harvested]\n          if not candidates:\n              break\n          candidates.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target = candidates[0]\n\n          path = bfs_actions(pos, [target], grid)\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n\n          actions.append(USE)\n          grid[target[0], target[1], prim_idx] = 0\n          harvested.add(target)\n          collected += 1\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its workshop (if the recipe specifies one).\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      workshop_idx = (cookbook.index[workshop_key]\n                      if isinstance(workshop_key, str)\n                      else workshop_key)\n      ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if ws_cells:\n          ws_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          ws_target = ws_cells[0]\n          path = bfs_actions(pos, [ws_target], grid)\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T19:00:15.487673", "function_name": "make_arrow", "function_body": "  # Action indices (standard in CraftWorld)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving the agent from\n  # `start` to a cell adjacent (Manhattan distance \u2264 1) to any coordinate\n  # in `targets`. Cells that contain any non\u2011zero kind are considered\n  # obstacles.\n  # ------------------------------------------------------------------\n  def _bfs_path(start, targets, grid):\n      w, h, _ = grid.shape\n      occupied = np.any(grid > 0, axis=2)          # blocked cells\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # Stop if we are already adjacent to a target.\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) <= 1:\n                  return path\n          # Explore neighbours.\n          for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # Unreachable \u2013 return empty list.\n      return []\n\n  # ------------------------------------------------------------------\n  # Retrieve world, cookbook and ensure we have a fresh state.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Some wrappers expose the world via the current state.\n      tmp_state = getattr(env, \"_current_state\", None)\n      if tmp_state is not None:\n          world = tmp_state.world\n  if world is None:\n      raise RuntimeError(\"World object not found in the environment.\")\n\n  cookbook = world.cookbook\n\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  # ------------------------------------------------------------------\n  # Goal is hard\u2011coded to \"arrow\".\n  # ------------------------------------------------------------------\n  goal_idx = cookbook.index[\"arrow\"]\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # Current position and a mutable copy of the grid for planning.\n  pos = tuple(state.pos)                # (x, y)\n  cur_grid = state.grid.copy()          # (W, H, n_kinds)\n\n  actions = []\n  harvested = set()                     # cells already collected from\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive, nearest\u2011first.\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      # All cells currently containing this primitive.\n      locations = [tuple(p) for p in np.argwhere(cur_grid[:, :, prim_idx] > 0)]\n      # Order by Manhattan distance from current position.\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      collected = 0\n      for loc in locations:\n          if collected >= needed:\n              break\n          if loc in harvested:\n              continue\n          # Move adjacent to the primitive.\n          path = _bfs_path(pos, [loc], cur_grid)\n          actions.extend(path)\n          # Update internal position tracker.\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Pick up the primitive.\n          actions.append(USE)\n          # Remove the primitive from the grid (so it no longer blocks).\n          cur_grid[loc[0], loc[1], prim_idx] = 0\n          harvested.add(loc)\n          collected += 1\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (could be a name string or already an int).\n      workshop_idx = (cookbook.index[workshop_key]\n                      if isinstance(workshop_key, str)\n                      else workshop_key)\n      # Find all workshop cells currently present.\n      workshop_cells = [tuple(p) for p in np.argwhere(cur_grid[:, :, workshop_idx] > 0)]\n      if workshop_cells:\n          # Choose the nearest workshop.\n          workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = workshop_cells[0]\n          # Move adjacent to the workshop.\n          path = _bfs_path(pos, [target_ws], cur_grid)\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Use the workshop to craft the arrow.\n          actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T19:00:42.859603", "function_name": "make_arrow", "function_body": "  # Retrieve the scenario and world objects from the environment\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \u201carrow\u201d (may raise if not present)\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Obtain the initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  import collections\n\n  Node = collections.namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = collections.deque([Node(init_state, [])])\n\n  MAX_STEPS = 500                     # safety bound on plan length\n  n_actions = getattr(world, \"n_actions\", 5)  # default to 5 actions (0\u20114)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in the inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long plans\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          h = _state_hash(next_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(next_state, node.actions + [a]))\n\n  # No feasible plan found within limits\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
