{"timestamp": "2025-10-28T18:36:01.594013", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  env.reset()\n  state = env._current_state\n  world = env.world\n\n  # index of the goal item \"arrow\"\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:\n      return []\n\n  # primitive requirements for one arrow; treat arrow itself as primitive if no recipe\n  primitive_needs = world.cookbook.primitives_for(arrow_idx)\n  if not primitive_needs:\n      primitive_needs = {arrow_idx: 1}\n\n  actions = []\n\n  # movement deltas for actions DOWN=0, UP=1, LEFT=2, RIGHT=3\n  deltas = {0: (0, 1), 1: (0, -1), 2: (-1, 0), 3: (1, 0)}\n\n  def bfs_to_target(cur_state, target_kind):\n      \"\"\"Return a list of movement actions that ends with the agent facing a cell\n      containing `target_kind`. Returns None if unreachable.\"\"\"\n      grid = cur_state.grid\n      W, H = grid.shape[:2]\n\n      def in_bounds(x, y):\n          return 0 <= x < W and 0 <= y < H\n\n      def walkable(x, y):\n          return in_bounds(x, y) and not np.any(grid[x, y, :])\n\n      q = deque()\n      sx, sy = cur_state.pos\n      sd = cur_state.dir\n      q.append((sx, sy, sd, []))\n      visited = {(sx, sy, sd)}\n\n      while q:\n          x, y, d, seq = q.popleft()\n          dx, dy = deltas[d]\n          fx, fy = x + dx, y + dy\n          if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:\n              return seq\n          for a in (0, 1, 2, 3):\n              ndx, ndy = deltas[a]\n              nx, ny = x + ndx, y + ndy\n              if not walkable(nx, ny):\n                  continue\n              if (nx, ny, a) in visited:\n                  continue\n              visited.add((nx, ny, a))\n              q.append((nx, ny, a, seq + [a]))\n      return None\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the necessary number of times.\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          move_seq = bfs_to_target(state, prim_idx)\n          if move_seq is None:\n              # cannot reach the required primitive; abort early\n              return actions\n          actions.extend(move_seq)\n          actions.append(4)  # USE to pick up / interact\n          for a in move_seq + [4]:\n              _, state = state.step(a)\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its designated workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      move_seq = bfs_to_target(state, workshop_idx)\n      if move_seq is None:\n          return actions\n      actions.extend(move_seq)\n      actions.append(4)  # USE to craft\n      for a in move_seq + [4]:\n          _, state = state.step(a)\n  else:\n      # No specific workshop; craft in place\n      actions.append(4)\n      _, state = state.step(4)\n\n  return actions", "env_interactions": 26, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T18:36:29.340014", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n\n  # index of the goal item \"arrow\"\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:\n      return []\n\n  # primitive requirements for one arrow (flattened)\n  primitive_needs = world.cookbook.primitives_for(arrow_idx)\n  # if no recipe (arrow is primitive), we just need to craft/pick it directly\n  if not primitive_needs:\n      primitive_needs = {}\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # BFS that returns a list of movement actions (0\u20113) that brings the\n  # agent to a position where the cell directly in front contains\n  # `target_kind`. Returns [] if unreachable.\n  # ------------------------------------------------------------------\n  def _bfs_to_target(st, target_kind):\n      grid = st.grid\n      W, H = grid.shape[:2]\n\n      # direction \u2192 (dx, dy) matching action indices\n      deltas = {\n          0: (0, 1),   # DOWN\n          1: (0, -1),  # UP\n          2: (-1, 0),  # LEFT\n          3: (1, 0),   # RIGHT\n      }\n\n      def in_bounds(x, y):\n          return 0 <= x < W and 0 <= y < H\n\n      def walkable(x, y):\n          return in_bounds(x, y) and not np.any(grid[x, y, :])\n\n      start_x, start_y = st.pos\n      start_dir = st.dir\n      from collections import deque\n      q = deque()\n      q.append((start_x, start_y, start_dir, []))\n      visited = {(start_x, start_y, start_dir)}\n\n      while q:\n          x, y, d, seq = q.popleft()\n          dx, dy = deltas[d]\n          fx, fy = x + dx, y + dy\n          if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:\n              return seq\n\n          for a in (0, 1, 2, 3):\n              ndx, ndy = deltas[a]\n              nx, ny = x + ndx, y + ndy\n              if not walkable(nx, ny):\n                  continue\n              if (nx, ny, a) in visited:\n                  continue\n              visited.add((nx, ny, a))\n              q.append((nx, ny, a, seq + [a]))\n\n      return []\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the required number of times.\n  # ------------------------------------------------------------------\n  for prim_idx, count in primitive_needs.items():\n      for _ in range(count):\n          # If we are already next to the primitive we can use immediately\n          if not state.next_to(prim_idx):\n              move_seq = _bfs_to_target(state, prim_idx)\n              if not move_seq:\n                  # cannot reach this primitive \u2013 abort early\n                  return actions\n              actions.extend(move_seq)\n              for a in move_seq:\n                  _, state = state.step(a)\n\n          # Use action (4) to pick up / interact\n          actions.append(4)\n          _, state = state.step(4)\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its designated workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      if not state.next_to(workshop_idx):\n          move_seq = _bfs_to_target(state, workshop_idx)\n          if not move_seq:\n              return actions\n          actions.extend(move_seq)\n          for a in move_seq:\n              _, state = state.step(a)\n      actions.append(4)  # USE to craft\n      _, state = state.step(4)\n  else:\n      # No specific workshop \u2013 just try to craft in place\n      actions.append(4)\n      _, state = state.step(4)\n\n  return actions", "env_interactions": 21, "island_id": 9, "scores": {"3": 0.0}}
