{"timestamp": "2025-10-28T15:18:50.059015", "function_name": "make_arrow", "function_body": "  # Reset the environment to obtain the initial observation.\n  obs = env.reset()\n\n  # Access world and cookbook objects.\n  world = env.world\n  cookbook = world.cookbook\n\n  # Determine the goal item name from the task description.\n  task_name = obs.get(\"task_name\", \"\")\n  if \"[\" in task_name and \"]\" in task_name:\n      goal_name = task_name.split(\"[\")[1].split(\"]\")[0]\n  else:\n      goal_name = task_name\n\n  # Resolve the goal index using the cookbook's name\u2192index mapping.\n  goal_idx = cookbook.index[goal_name]\n\n  # Primitive requirements for the goal (primitive_index \u2192 count).\n  primitives_needed = cookbook.primitives_for(goal_idx)\n\n  # Retrieve the recipe for the goal to find the required workshop.\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  workshop_idx = None\n  if workshop_name is not None:\n      workshop_idx = cookbook.index[workshop_name]\n\n  # Helper to locate all positions of a given kind in the global grid.\n  def get_positions(kind):\n      grid = obs[\"features_dict\"][\"features_global\"]\n      xs, ys = np.where(grid[:, :, kind] == 1)\n      return list(zip(xs.tolist(), ys.tolist()))\n\n  # Current agent position (convert normalized coordinates to grid indices).\n  pos_norm = obs[\"features_dict\"][\"pos\"]\n  width, height = obs[\"features_dict\"][\"features_global\"].shape[:2]\n  cur_pos = (\n      int(round(pos_norm[0] * (width - 1))),\n      int(round(pos_norm[1] * (height - 1))),\n  )\n\n  actions = []\n\n  # Simple Manhattan movement helper (updates cur_pos).\n  def move_to(target):\n      nonlocal cur_pos, actions\n      tx, ty = target\n      while cur_pos[0] < tx:\n          actions.append(3)  # RIGHT\n          cur_pos = (cur_pos[0] + 1, cur_pos[1])\n      while cur_pos[0] > tx:\n          actions.append(2)  # LEFT\n          cur_pos = (cur_pos[0] - 1, cur_pos[1])\n      while cur_pos[1] < ty:\n          actions.append(0)  # DOWN\n          cur_pos = (cur_pos[0], cur_pos[1] + 1)\n      while cur_pos[1] > ty:\n          actions.append(1)  # UP\n          cur_pos = (cur_pos[0], cur_pos[1] - 1)\n\n  # Collect each required primitive.\n  for prim_idx, needed in primitives_needed.items():\n      positions = get_positions(prim_idx)\n      # Use the first `needed` instances found.\n      for i in range(min(needed, len(positions))):\n          px, py = positions[i]\n\n          # Choose a neighbouring cell to stand on (prefer left, then right, then up, then down).\n          if px > 0:\n              adj = (px - 1, py)\n          elif px < width - 1:\n              adj = (px + 1, py)\n          elif py > 0:\n              adj = (px, py - 1)\n          else:\n              adj = (px, py + 1)\n\n          move_to(adj)\n          actions.append(4)  # USE to pick up the primitive.\n\n  # Move to the appropriate workshop and craft the goal item.\n  if workshop_idx is not None:\n      wk_positions = get_positions(workshop_idx)\n      if wk_positions:\n          wx, wy = wk_positions[0]\n          # Stand next to the workshop (prefer left side if possible).\n          if wx > 0:\n              adj_w = (wx - 1, wy)\n          else:\n              adj_w = (wx + 1, wy)\n          move_to(adj_w)\n          actions.append(4)  # USE to craft the item.\n\n  return actions", "env_interactions": 23, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T15:19:32.322604", "function_name": "make_arrow", "function_body": "  # Reset the environment to a fresh start\n  env.reset()\n\n  # Action mapping provided by the environment\n  act_map = env.action_specs()\n  DOWN = act_map[\"DOWN\"]\n  UP = act_map[\"UP\"]\n  LEFT = act_map[\"LEFT\"]\n  RIGHT = act_map[\"RIGHT\"]\n  USE = act_map[\"USE\"]\n\n  # Goal information (arrow)\n  goal_name = \"arrow\"\n  goal_idx = env.world.cookbook.index[goal_name]\n\n  # Primitive requirements for the goal\n  primitive_reqs = env.world.cookbook.primitives_for(goal_idx)\n\n  # Workshop location for the goal (if any)\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  workshop_idx = (\n      env.world.cookbook.index[workshop_name] if workshop_name is not None else None\n  )\n\n  # Helper: locate the nearest cell containing a given kind index\n  def _nearest_position(kind_idx):\n      grid = env._current_state.grid[:, :, kind_idx]\n      positions = np.argwhere(grid > 0)\n      if positions.size == 0:\n          return None\n      cur = np.array(env._current_state.pos)\n      dists = np.sum(np.abs(positions - cur), axis=1)\n      return tuple(positions[dists.argmin()])\n\n  # Helper: generate a simple Manhattan\u2011distance path (right/left then down/up)\n  def _path_to(start, target):\n      actions = []\n      x, y = start\n      tx, ty = target\n      while x != tx:\n          if x < tx:\n              actions.append(RIGHT)\n              x += 1\n          else:\n              actions.append(LEFT)\n              x -= 1\n      while y != ty:\n          if y < ty:\n              actions.append(DOWN)\n              y += 1\n          else:\n              actions.append(UP)\n              y -= 1\n      return actions\n\n  actions = []\n  max_total_steps = 2000  # safety guard\n  steps_taken = 0\n\n  while steps_taken < max_total_steps:\n      # Goal satisfied?\n      if env._current_state.satisfies(\"\", goal_idx):\n          break\n\n      inventory = env._current_state.inventory\n\n      # ------------------------------------------------------------------\n      # 1) If we already have all required primitives, go to the workshop\n      # ------------------------------------------------------------------\n      have_all = all(inventory[p] >= cnt for p, cnt in primitive_reqs.items())\n      if have_all and workshop_idx is not None:\n          target_pos = _nearest_position(workshop_idx)\n          if target_pos is None:\n              break  # no workshop found \u2013 abort\n          if tuple(env._current_state.pos) != target_pos:\n              # move towards the workshop\n              for a in _path_to(env._current_state.pos, target_pos):\n                  actions.append(a)\n                  env.step(a)\n                  steps_taken += 1\n              continue\n          else:\n              # at workshop \u2013 craft the item\n              actions.append(USE)\n              env.step(USE)\n              steps_taken += 1\n              continue\n\n      # ---------------------------------------------------------------\n      # 2) Otherwise, collect a missing primitive (pick the first lacking)\n      # ---------------------------------------------------------------\n      lacking = [(p, cnt - inventory[p]) for p, cnt in primitive_reqs.items() if inventory[p] < cnt]\n      if not lacking:\n          # nothing to collect (should not happen)\n          break\n      need_idx, _ = lacking[0]\n      target_pos = _nearest_position(need_idx)\n      if target_pos is None:\n          break  # primitive not present \u2013 abort\n      if tuple(env._current_state.pos) != target_pos:\n          # move towards the primitive\n          for a in _path_to(env._current_state.pos, target_pos):\n              actions.append(a)\n              env.step(a)\n              steps_taken += 1\n          continue\n      else:\n          # at primitive location \u2013 pick it up\n          actions.append(USE)\n          env.step(USE)\n          steps_taken += 1\n          continue\n\n  return actions", "env_interactions": 0, "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-10-28T15:19:33.439448", "function_name": "make_arrow", "function_body": "  actions = []\n  # Access the world and its cookbook\n  world = env.world\n  cookbook = world.cookbook\n  idx = cookbook.index\n\n  # Goal item name\n  goal_name = \"arrow\"\n  if goal_name not in idx.contents:\n      return actions\n  goal_idx = idx[goal_name]\n\n  # Primitive requirements for one arrow (transitive)\n  needed = cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n\n  # Current state (assumes env has been reset)\n  state = env._current_state\n  grid = state.grid\n  cur_pos = state.pos  # (x, y)\n\n  # Helper to move to an absolute coordinate using Manhattan moves\n  def _move_to(target):\n      nonlocal cur_pos, actions\n      tx, ty = target\n      while cur_pos[0] < tx:\n          actions.append(env.RIGHT)\n          cur_pos = (cur_pos[0] + 1, cur_pos[1])\n      while cur_pos[0] > tx:\n          actions.append(env.LEFT)\n          cur_pos = (cur_pos[0] - 1, cur_pos[1])\n      while cur_pos[1] < ty:\n          actions.append(env.DOWN)\n          cur_pos = (cur_pos[0], cur_pos[1] + 1)\n      while cur_pos[1] > ty:\n          actions.append(env.UP)\n          cur_pos = (cur_pos[0], cur_pos[1] - 1)\n\n  # Collect each required primitive from any available location\n  for kind_idx, needed_cnt in needed.items():\n      # Find all cells that currently contain this kind\n      locations = list(zip(*np.where(grid[:, :, kind_idx] > 0)))\n      collected = 0\n      for loc in locations:\n          if collected >= needed_cnt:\n              break\n          _move_to(loc)          # go to the primitive cell\n          actions.append(env.USE)  # pick it up\n          collected += 1\n      # If we could not find enough instances, just continue (the plan may fail later)\n\n  # Finally go to the workshop that can craft the arrow and use it\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      # workshop may be stored as a name (string) or directly as an index\n      if isinstance(workshop_name, str):\n          workshop_idx = idx[workshop_name]\n      else:\n          workshop_idx = workshop_name\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))\n      if workshop_cells:\n          _move_to(workshop_cells[0])\n          actions.append(env.USE)  # craft the arrow\n\n  return actions", "env_interactions": 0, "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-10-28T15:20:16.818081", "function_name": "make_arrow", "function_body": "  # Reset the environment to start a fresh episode\n  obs = env.reset()\n  # Action mapping (e.g., {'DOWN': 0, 'UP': 1, ...})\n  act_map = env.action_specs()\n  # Shortcut references\n  world = env.scenario.world\n  cookbook = world.cookbook\n  # Goal: make an arrow\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n  # Primitive requirements for one arrow\n  required = cookbook.primitives_for(goal_idx)          # {prim_idx: count}\n  actions = []\n  max_steps = 2000                                      # safety cap\n\n  for _ in range(max_steps):\n      state = env._current_state\n      # Goal reached?\n      if state.satisfies(\"\", goal_idx):\n          break\n\n      # Determine which primitives are still missing\n      need = {}\n      for prim_idx, cnt in required.items():\n          have = int(state.inventory[prim_idx])\n          if have < cnt:\n              need[prim_idx] = cnt - have\n\n      if need:\n          # --- Collect a needed primitive ---------------------------------\n          prim_idx = next(iter(need))                   # pick any missing primitive\n          # Locate all cells that contain this primitive\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:                      # nothing to collect \u2192 abort\n              break\n          # Choose the closest one (Manhattan distance)\n          cur_pos = np.array(state.pos)\n          dists = np.abs(prim_cells - cur_pos).sum(axis=1)\n          target_cell = prim_cells[dists.argmin()]\n\n          # Find a free neighbouring cell to stand on\n          adj = None\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = target_cell[0] + dx, target_cell[1] + dy\n              if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                  if state.grid[nx, ny, :].sum() == 0:   # empty\n                      adj = (nx, ny)\n                      break\n          if adj is None:                               # fallback: stay where we are\n              adj = tuple(state.pos)\n\n          # Simple greedy path planning (ignores obstacles)\n          path = []\n          cx, cy = state.pos\n          tx, ty = adj\n          while cx < tx:\n              path.append(act_map[\"RIGHT\"])\n              cx += 1\n          while cx > tx:\n              path.append(act_map[\"LEFT\"])\n              cx -= 1\n          while cy < ty:\n              path.append(act_map[\"DOWN\"])\n              cy += 1\n          while cy > ty:\n              path.append(act_map[\"UP\"])\n              cy -= 1\n\n          # Execute movement actions\n          for a in path:\n              actions.append(a)\n              _, done, _ = env.step(a)\n              if done:\n                  break\n\n          # Pick up the primitive\n          actions.append(act_map[\"USE\"])\n          _, done, _ = env.step(act_map[\"USE\"])\n          if done:\n              break\n      else:\n          # --- All primitives gathered, go to the workshop and craft -----\n          recipe = cookbook.recipes[goal_idx]\n          workshop_name = recipe[\"_at\"]\n          workshop_idx = cookbook.index[workshop_name]\n\n          # Locate a workshop cell\n          ws_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n          if ws_cells.size == 0:\n              break\n          ws_cell = ws_cells[0]\n\n          # Find a free neighbour to stand on\n          adj = None\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = ws_cell[0] + dx, ws_cell[1] + dy\n              if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                  if state.grid[nx, ny, :].sum() == 0:\n                      adj = (nx, ny)\n                      break\n          if adj is None:\n              adj = tuple(state.pos)\n\n          # Greedy move to the adjacent cell\n          path = []\n          cx, cy = state.pos\n          tx, ty = adj\n          while cx < tx:\n              path.append(act_map[\"RIGHT\"])\n              cx += 1\n          while cx > tx:\n              path.append(act_map[\"LEFT\"])\n              cx -= 1\n          while cy < ty:\n              path.append(act_map[\"DOWN\"])\n              cy += 1\n          while cy > ty:\n              path.append(act_map[\"UP\"])\n              cy -= 1\n\n          for a in path:\n              actions.append(a)\n              _, done, _ = env.step(a)\n              if done:\n                  break\n\n          # Craft the arrow\n          actions.append(act_map[\"USE\"])\n          _, done, _ = env.step(act_map[\"USE\"])\n          if done:\n              break\n\n  return actions", "env_interactions": 0, "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-10-28T15:20:17.917065", "function_name": "make_arrow", "function_body": "", "env_interactions": 0, "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-10-28T15:20:43.367743", "function_name": "make_arrow", "function_body": "  # Resolve scenario and world objects, handling possible wrappers\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n\n  # Target item index for \"arrow\"\n  try:\n      arrow_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  # BFS structures\n  from collections import deque, namedtuple\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      # Hash based on position, direction, inventory and grid layout\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = { _state_hash(init_state) }\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 200                     # safety depth limit\n  n_actions = getattr(world, \"n_actions\", 5)  # default to 5 actions (0\u20114)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", arrow_idx):\n          return node.actions\n\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within limits\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T15:20:59.020272", "function_name": "make_arrow", "function_body": "  # Resolve the underlying scenario and world objects.\n  scenario = getattr(env, \"scenario\", None)\n  if scenario is None:\n      # In some wrappers the environment itself may be the scenario.\n      scenario = env\n  world = getattr(scenario, \"world\", None)\n  if world is None:\n      world = getattr(env, \"world\", None)\n\n  # Identify the integer index that corresponds to the target item \"arrow\".\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      # If the index cannot be resolved we cannot construct a plan.\n      return []\n\n  # Initialise the starting state of the episode.\n  try:\n      start_state = scenario.init()\n  except Exception:\n      return []\n\n  # ------------------------------------------------------------------\n  # Bread\u2011first search over the deterministic state transition graph.\n  # ------------------------------------------------------------------\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      # Position, direction, inventory tuple, and a bytes view of the grid.\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = set()\n  frontier = deque()\n  frontier.append(Node(start_state, []))\n  visited.add(_state_hash(start_state))\n\n  # Safety limits to keep the search tractable.\n  MAX_STEPS = 400          # maximum plan length we are willing to explore\n  MAX_VISITED = 200_000    # cap on the number of explored states\n\n  # Number of possible actions (standard actions are 0\u20114).\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier and len(visited) < MAX_VISITED:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test \u2013 we succeed as soon as the inventory contains an arrow.\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long partial plans.\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all legal actions from the current state.\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          h = _state_hash(next_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(next_state, node.actions + [a]))\n\n  # If we exit the loop without finding a solution we return an empty plan.\n  return []", "env_interactions": 0, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T15:21:34.878647", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # helper mappings between actions and movement vectors\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n  DIR_TO_VEC = {\n      ACTION_DOWN: (0, 1),\n      ACTION_UP:   (0, -1),\n      ACTION_LEFT: (-1, 0),\n      ACTION_RIGHT:(1, 0),\n  }\n  VEC_TO_DIR = {v: k for k, v in DIR_TO_VEC.items()}\n\n  def bfs(start, targets, free_mask):\n      \"\"\"Simple BFS returning a list of actions to reach any cell in *targets*.\"\"\"\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = set()\n      visited.add((start[0], start[1]))\n      while q:\n          x, y, path = q.popleft()\n          if (x, y) in targets:\n              return path\n          for a, (dx, dy) in DIR_TO_VEC.items():\n              nx, ny = x + dx, y + dy\n              if (0 <= nx < free_mask.shape[0] and\n                  0 <= ny < free_mask.shape[1] and\n                  free_mask[nx, ny] and\n                  (nx, ny) not in visited):\n                  visited.add((nx, ny))\n                  q.append((nx, ny, path + [a]))\n      # no path found \u2013 return empty list (will likely fail later)\n      return []\n\n  def move_to(state, dest):\n      \"\"\"Return actions to move from current position to *dest* (empty cell).\"\"\"\n      # free cells are those with no entities at all\n      free_mask = np.all(state.grid == 0, axis=2)\n      start = state.pos\n      actions = bfs(start, {dest}, free_mask)\n      return actions\n\n  def approach_and_use(state, target_pos):\n      \"\"\"\n      Generate actions to stand on a free cell adjacent to *target_pos*\n      and face the target, then USE.\n      \"\"\"\n      # choose an adjacent free cell (prefer the one with a clear approach)\n      adj_candidates = []\n      for dx, dy in DIR_TO_VEC.values():\n          ax, ay = target_pos[0] - dx, target_pos[1] - dy  # cell opposite the target\n          if (0 <= ax < state.grid.shape[0] and\n              0 <= ay < state.grid.shape[1] and\n              np.all(state.grid[ax, ay] == 0)):\n              adj_candidates.append(((ax, ay), (dx, dy)))  # also store direction to target\n\n      if not adj_candidates:\n          # fallback: any free neighbour\n          for dx, dy in DIR_TO_VEC.values():\n              ax, ay = target_pos[0] + dx, target_pos[1] + dy\n              if (0 <= ax < state.grid.shape[0] and\n                  0 <= ay < state.grid.shape[1] and\n                  np.all(state.grid[ax, ay] == 0)):\n                  adj_candidates.append(((ax, ay), (-dx, -dy)))  # direction opposite\n      # pick the first candidate\n      (adj_cell, dir_vec) = adj_candidates[0]\n\n      actions = move_to(state, adj_cell)\n\n      # after moving, ensure we are facing the target.\n      # The direction we need is the vector from adj_cell to target_pos.\n      needed_dir = VEC_TO_DIR[dir_vec]\n      # check current direction; if not correct, perform a small turn maneuver\n      cur_dir = state.dir\n      if cur_dir != needed_dir:\n          # try to step one cell opposite to needed_dir (if free) and step back\n          back_vec = (-dir_vec[0], -dir_vec[1])\n          back_cell = (adj_cell[0] + back_vec[0], adj_cell[1] + back_vec[1])\n          if (0 <= back_cell[0] < state.grid.shape[0] and\n              0 <= back_cell[1] < state.grid.shape[1] and\n              np.all(state.grid[back_cell[0], back_cell[1]] == 0)):\n              actions.append(VEC_TO_DIR[back_vec])   # move away\n              actions.append(needed_dir)            # move back, now facing target\n          else:\n              # as a last resort just move in any direction then back\n              for a in (ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT):\n                  if a != needed_dir:\n                      actions.append(a)\n                      actions.append(needed_dir)\n                      break\n\n      actions.append(ACTION_USE)   # interact with the target\n      return actions\n\n  # ----------------------------------------------------------------------\n  # Begin main logic of make_arrow_vn\n  # ----------------------------------------------------------------------\n  # reset environment and obtain initial state\n  env.reset()\n  state = env._current_state\n\n  # lookup indices\n  arrow_idx = state.world.cookbook.index['arrow']\n  recipe = state.world.cookbook.recipes[arrow_idx]\n\n  # ------------------------------------------------------------------\n  # 1) collect all required primitive resources\n  # ------------------------------------------------------------------\n  plan_actions = []\n  for prim_idx, count in state.world.cookbook.primitives_for(arrow_idx).items():\n      for _ in range(count):\n          # locate a remaining instance of this primitive\n          prim_positions = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_positions.size == 0:\n              raise RuntimeError(\"Required primitive not found in the grid.\")\n          prim_pos = tuple(prim_positions[0])  # (x, y)\n\n          # generate actions to collect it\n          act_seq = approach_and_use(state, prim_pos)\n          for a in act_seq:\n              reward, done, obs = env.step(a)\n              state = env._current_state\n              plan_actions.append(a)\n              if done:\n                  return plan_actions\n\n  # ------------------------------------------------------------------\n  # 2) move to the workshop for the arrow and craft it\n  # ------------------------------------------------------------------\n  workshop_name = recipe['_at']          # e.g. \"crafting_table\"\n  workshop_idx = state.world.cookbook.index[workshop_name]\n  workshop_positions = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_positions.size == 0:\n      raise RuntimeError(\"Workshop for arrow not found.\")\n  workshop_pos = tuple(workshop_positions[0])\n\n  # actions to reach workshop and use it\n  act_seq = approach_and_use(state, workshop_pos)\n  for a in act_seq:\n      reward, done, obs = env.step(a)\n      state = env._current_state\n      plan_actions.append(a)\n      if done:\n          return plan_actions\n\n  # after crafting, the goal should be satisfied; return the accumulated plan\n  return plan_actions", "env_interactions": 0, "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-10-28T15:21:35.997295", "function_name": "make_arrow", "function_body": "  # Ensure the environment is in a fresh state.\n  try:\n      env.reset()\n  except Exception:\n      # If reset is not available, ignore \u2013 the env may already be ready.\n      pass\n\n  # Determine the integer code for the USE action (craft / interact).\n  action_map = env.action_specs()\n  use_action = action_map.get(\"USE\", 4)  # default to 4 if not found\n\n  # Use a safe upper bound on the number of steps; many environments expose\n  # a max_steps attribute, otherwise fall back to a reasonable constant.\n  max_steps = getattr(env, \"max_steps\", 200)\n\n  actions = []\n  for _ in range(max_steps):\n      # Stop early if the task is already completed.\n      if hasattr(env, \"_is_done\") and env._is_done():\n          break\n      # Try to interact (collect / craft) at the current location.\n      actions.append(use_action)\n      env.step(use_action)\n\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-10-28T15:21:49.975349", "function_name": "make_arrow", "function_body": "  # Retrieve scenario and world objects (they may be attributes of the wrapper)\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      arrow_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  # ------------------------------------------------------------------\n  # Bread\u2011first search over (state, action\u2011list) pairs\n  # ------------------------------------------------------------------\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      # Position, direction, inventory (as tuple), and grid layout (bytes)\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = set()\n  visited.add(_state_hash(init_state))\n\n  frontier = deque([Node(init_state, [])])\n\n  # Safety limits\n  MAX_STEPS = 250          # maximum length of a returned plan\n  MAX_NODES = 20000        # cap on explored nodes to avoid blow\u2011up\n\n  n_actions = getattr(world, \"n_actions\", 5)   # default actions: 0\u20114\n\n  explored = 0\n\n  while frontier and explored < MAX_NODES:\n      node = frontier.popleft()\n      cur_state = node.state\n      explored += 1\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", arrow_idx):\n          return node.actions\n\n      # Prune overly long plans\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # If we exit the loop without finding a solution, return empty list\n  return []", "env_interactions": 0, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T15:22:05.554764", "function_name": "make_arrow", "function_body": "  # Retrieve the scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  # Bread\u2011first search over state space\n  from collections import deque, namedtuple\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      # Hash based on position, direction, inventory and full grid layout\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 200                     # safety depth limit\n  n_actions = getattr(world, \"n_actions\", 5)  # default to 5 actions (0\u20114)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within limits\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T15:22:21.318882", "function_name": "make_arrow", "function_body": "  # Simple placeholder implementation: no actions are taken.\n  # This satisfies the interface requirements and can be expanded later.\n  return []", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T15:22:22.432124", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # ------------------------------------------------------------------\n  # Helper: Manhattan distance move towards a target cell.\n  # ------------------------------------------------------------------\n  def _move_towards(pos, target):\n      \"\"\"Return an action index that moves one step from pos toward target.\n\n      Action indices (as used by CraftWorld):\n          0 = DOWN  (increase x)\n          1 = UP    (decrease x)\n          2 = LEFT  (decrease y)\n          3 = RIGHT (increase y)\n      \"\"\"\n      x, y = pos\n      tx, ty = target\n      if x < tx:\n          return 0          # DOWN\n      if x > tx:\n          return 1          # UP\n      if y < ty:\n          return 3          # RIGHT\n      if y > ty:\n          return 2          # LEFT\n      return None           # already there\n\n  # ------------------------------------------------------------------\n  # Helper: find the nearest cell (Manhattan) that satisfies a predicate.\n  # ------------------------------------------------------------------\n  def _nearest_cell(state, predicate):\n      \"\"\"Search the whole grid for the cell closest (Manhattan) to the agent\n      that satisfies `predicate(cell_coords)`. Returns None if not found.\"\"\"\n      h, w = state.grid.shape[:2]          # (WIDTH, HEIGHT)\n      pos = state.pos\n      best = None\n      best_dist = None\n      for ix in range(h):\n          for iy in range(w):\n              if predicate((ix, iy)):\n                  d = abs(ix - pos[0]) + abs(iy - pos[1])\n                  if best_dist is None or d < best_dist:\n                      best_dist = d\n                      best = (ix, iy)\n      return best\n\n  # ------------------------------------------------------------------\n  # Initialise / reset the environment.\n  # ------------------------------------------------------------------\n  obs = env.reset()                       # start a fresh episode\n  world = env.world                       # CraftWorld instance\n  idx = world.cookbook.index\n  arrow_idx = idx[\"arrow\"]                # integer id for the goal item\n\n  # Primitive requirements for a single arrow (dict {prim_idx: count})\n  needed_prims = world.cookbook.primitives_for(arrow_idx)\n\n  actions = []                            # list of actions to return\n\n  # ------------------------------------------------------------------\n  # Main loop \u2013 keep acting until the environment reports done.\n  # ------------------------------------------------------------------\n  while not env._is_done():\n      state = env._current_state           # current CraftState\n\n      # ------------------------------------------------------------------\n      # Determine which primitives are still missing.\n      # ------------------------------------------------------------------\n      missing = {}\n      for p_idx, req_cnt in needed_prims.items():\n          have = int(state.inventory[p_idx])\n          if have < req_cnt:\n              missing[p_idx] = req_cnt - have\n\n      # ------------------------------------------------------------------\n      # If we already have everything, head to the workshop that can craft\n      # the arrow and use the crafting action.\n      # ------------------------------------------------------------------\n      if not missing:\n          # Recipe dict contains an \"_at\" entry pointing to the workshop kind.\n          workshop_kind = world.cookbook.recipes[arrow_idx][\"_at\"]\n          # Locate nearest workshop cell.\n          target = _nearest_cell(\n              state,\n              lambda c: state.grid[c][workshop_kind] > 0\n          )\n          # If we are already on the workshop, press USE to craft.\n          if state.pos == target:\n              actions.append(4)            # USE\n              _, _ = env.step(4)\n              continue\n      else:\n          # ----------------------------------------------------------------\n          # We still need some primitive \u2013 pick one (arbitrary) and go collect.\n          # ----------------------------------------------------------------\n          prim_needed = next(iter(missing))\n          target = _nearest_cell(\n              state,\n              lambda c: state.grid[c][prim_needed] > 0\n          )\n          # If we are already on the primitive, press USE to pick it up.\n          if state.pos == target:\n              actions.append(4)            # USE\n              _, _ = env.step(4)\n              continue\n\n      # ------------------------------------------------------------------\n      # Move one step towards the selected target cell.\n      # ------------------------------------------------------------------\n      if target is not None and state.pos != target:\n          act = _move_towards(state.pos, target)\n          if act is not None:\n              actions.append(act)\n              _, _ = env.step(act)\n              continue\n\n      # ------------------------------------------------------------------\n      # Fallback: if we cannot find a target (should not happen), just break.\n      # ------------------------------------------------------------------\n      break\n\n  # Return the complete action sequence that achieved the goal.\n  return actions", "env_interactions": 0, "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-10-28T15:23:12.663407", "function_name": "make_arrow", "function_body": "  # Reset the environment to obtain the initial state.\n  env.reset()\n  # Access the underlying world and indexing utilities.\n  world = env.world\n  idx = world.cookbook.index\n\n  # Identify the goal item (\"arrow\") and its recipe.\n  try:\n      arrow_id = idx[\"arrow\"]\n  except Exception:\n      # If the name is not directly indexed, fall back to a safe default.\n      return []\n\n  recipe = world.cookbook.recipes.get(arrow_id, {})\n  workshop_kind = recipe.get(\"_at\", None)\n\n  # Determine which primitive resources are required and in what quantities.\n  needed_prims = world.cookbook.primitives_for(arrow_id)  # {prim_id: count}\n  if not needed_prims:\n      return []\n\n  # Helper: translate a Manhattan displacement into a list of actions.\n  # Action mapping follows CraftLab.action_specs: DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n  def manhattan_path(start, goal):\n      sx, sy = start\n      gx, gy = goal\n      path = []\n      dx = gx - sx\n      dy = gy - sy\n      # Move in x direction first.\n      while dx > 0:\n          path.append(3)  # RIGHT\n          dx -= 1\n      while dx < 0:\n          path.append(2)  # LEFT\n          dx += 1\n      # Then move in y direction.\n      while dy > 0:\n          path.append(0)  # DOWN\n          dy -= 1\n      while dy < 0:\n          path.append(1)  # UP\n          dy += 1\n      return path\n\n  # Retrieve the current state object (CraftState) from the environment.\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      # If the environment does not expose the state directly, we cannot proceed.\n      return []\n  pos = state.pos  # (x, y) tuple\n  grid = state.grid  # shape: (WIDTH, HEIGHT, n_kinds)\n\n  # Locate all cells that contain the required primitive kinds.\n  prim_positions = {pid: [] for pid in needed_prims}\n  width, height, _ = grid.shape\n  for x in range(width):\n      for y in range(height):\n          cell_vec = grid[x, y]\n          # Find which kind(s) are present in this cell.\n          present_kinds = np.where(cell_vec > 0)[0]\n          for kind in present_kinds:\n              if kind in prim_positions:\n                  prim_positions[kind].append((x, y))\n\n  actions = []\n\n  # Collect each required primitive the necessary number of times.\n  for pid, cnt in needed_prims.items():\n      # Sort available positions by distance from the current location.\n      available = sorted(prim_positions.get(pid, []),\n                         key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n      for _ in range(cnt):\n          if not available:\n              # No more locations for this primitive; abort early.\n              return actions\n          target = available.pop(0)\n          # Move to the target cell.\n          actions.extend(manhattan_path(pos, target))\n          # Use the item (collect it). In CraftWorld the USE action works when\n          # the agent is on the same cell as the item.\n          actions.append(4)  # USE\n          pos = target\n\n  # After gathering primitives, travel to the appropriate workshop (if any) and craft.\n  if workshop_kind is not None:\n      workshop_pos = None\n      for x in range(width):\n          for y in range(height):\n              if grid[x, y, workshop_kind] > 0:\n                  workshop_pos = (x, y)\n                  break\n          if workshop_pos:\n              break\n      if workshop_pos:\n          actions.extend(manhattan_path(pos, workshop_pos))\n          actions.append(4)  # USE to trigger crafting at the workshop\n\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-10-28T15:28:12.692626", "function_name": "make_arrow", "function_body": "  # Initialise the environment and obtain useful references\n  env.reset()\n  state = env._current_state\n  action_map = env.action_specs()                # name \u2192 int\n  world = env.world\n  # Index of the goal item \u201carrow\u201d\n  arrow_idx = world.cookbook.index[\"arrow\"]\n  # Primitive requirements (expanded recursively)\n  needed_prims = world.cookbook.primitives_for(arrow_idx)\n\n  # Helper to move the agent to a target cell using Manhattan moves\n  def _move_to(target):\n      \"\"\"Move current agent to *target* (x, y) and record actions.\"\"\"\n      nonlocal state\n      while state.pos[0] != target[0]:\n          if target[0] > state.pos[0]:\n              act = action_map[\"RIGHT\"]\n          else:\n              act = action_map[\"LEFT\"]\n          actions.append(act)\n          env.step(act)\n          state = env._current_state\n      while state.pos[1] != target[1]:\n          if target[1] > state.pos[1]:\n              act = action_map[\"DOWN\"]\n          else:\n              act = action_map[\"UP\"]\n          actions.append(act)\n          env.step(act)\n          state = env._current_state\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitive resources\n  # ------------------------------------------------------------------\n  dir_vec = {\n      \"UP\":    (0, -1),\n      \"DOWN\":  (0, 1),\n      \"LEFT\":  (-1, 0),\n      \"RIGHT\": (1, 0),\n  }\n\n  for prim_idx, count in needed_prims.items():\n      for _ in range(count):\n          # locate all remaining instances of the primitive\n          prim_pos = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_pos.size == 0:\n              raise RuntimeError(\"Required primitive not found in the grid.\")\n          # pick the closest one (Manhattan distance)\n          dists = np.abs(prim_pos[:, 0] - state.pos[0]) + np.abs(prim_pos[:, 1] - state.pos[1])\n          target = prim_pos[dists.argmin()]\n          # Choose a side to approach from \u2013 we want to step onto the cell\n          # that is opposite the direction we will finally face.\n          approach = None\n          approach_dir = None\n          for dname, (dx, dy) in dir_vec.items():\n              cand = (target[0] - dx, target[1] - dy)\n              if (0 <= cand[0] < state.grid.shape[0] and\n                      0 <= cand[1] < state.grid.shape[1] and\n                      state.grid[cand[0], cand[1], :].sum() == 0):\n                  approach = cand\n                  approach_dir = dname\n                  break\n          # Fallback \u2013 any adjacent cell (even if occupied)\n          if approach is None:\n              for dname, (dx, dy) in dir_vec.items():\n                  cand = (target[0] - dx, target[1] - dy)\n                  if 0 <= cand[0] < state.grid.shape[0] and 0 <= cand[1] < state.grid.shape[1]:\n                      approach = cand\n                      approach_dir = dname\n                      break\n          # Move to the chosen adjacent cell\n          _move_to(approach)\n          # The last move we performed set the direction correctly,\n          # so a single USE will pick up the primitive.\n          actions.append(action_map[\"USE\"])\n          env.step(action_map[\"USE\"])\n          state = env._current_state\n\n  # ------------------------------------------------------------------\n  # 2. Move to the appropriate workshop and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes[arrow_idx]\n  # The workshop index is stored under the special key \u201c_at\u201d (or \u201c_key\u201d as a fallback)\n  workshop_idx = recipe.get(\"_at\", recipe.get(\"_key\"))\n  if workshop_idx is None:\n      raise RuntimeError(\"Workshop information for arrow not found in recipe.\")\n\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      raise RuntimeError(\"No workshop of required type present in the grid.\")\n  dists = np.abs(workshop_cells[:, 0] - state.pos[0]) + np.abs(workshop_cells[:, 1] - state.pos[1])\n  ws_target = workshop_cells[dists.argmin()]\n\n  # Find an adjacent free cell to stand on before using the workshop\n  ws_adj = None\n  for dname, (dx, dy) in dir_vec.items():\n      cand = (ws_target[0] - dx, ws_target[1] - dy)\n      if (0 <= cand[0] < state.grid.shape[0] and\n              0 <= cand[1] < state.grid.shape[1] and\n              state.grid[cand[0], cand[1], :].sum() == 0):\n          ws_adj = cand\n          break\n  if ws_adj is None:\n      # As a last resort pick any neighbour (might be occupied)\n      ws_adj = (max(ws_target[0] - 1, 0), ws_target[1])\n\n  # Move next to the workshop\n  _move_to(ws_adj)\n\n  # Use the workshop to craft the arrow\n  actions.append(action_map[\"USE\"])\n  env.step(action_map[\"USE\"])\n  state = env._current_state\n\n  # Return the full action list\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-10-28T15:28:48.392404", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Helper: map direction constants to movement deltas\n  DIRS = {\n      env.DOWN: (0, 1),\n      env.UP:   (0, -1),\n      env.LEFT: (-1, 0),\n      env.RIGHT:(1, 0),\n  }\n\n  def bfs_path(start, goal, blocked):\n      \"\"\"Return list of direction actions to move from start to goal avoiding blocked cells.\"\"\"\n      w, h = blocked.shape\n      visited = np.full((w, h), False, dtype=bool)\n      q = deque()\n      q.append((start, []))\n      visited[start] = True\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for a, (dx, dy) in DIRS.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny] and not blocked[nx, ny]:\n                  visited[nx, ny] = True\n                  q.append(((nx, ny), path + [a]))\n      raise RuntimeError(\"No path found\")\n\n  # ------------------------------------------------------------------\n  # 1. Identify goal (arrow) and required primitives\n  # ------------------------------------------------------------------\n  state = env._current_state\n  world = state.world\n  cb = world.cookbook\n\n  arrow_idx = cb.index[\"arrow\"]\n  # primitive requirements for one arrow\n  prim_req = cb.primitives_for(arrow_idx).copy()   # {prim_idx: count}\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # 2. Collect each required primitive\n  # ------------------------------------------------------------------\n  while any(cnt > 0 for cnt in prim_req.values()):\n      # recompute blocked cells (any non\u2011zero in any channel)\n      blocked = np.any(state.grid > 0, axis=2)\n\n      # find a primitive we still need\n      needed_idx = None\n      for k, v in prim_req.items():\n          if v > 0:\n              needed_idx = k\n              break\n      # locate all cells containing that primitive\n      prim_cells = np.argwhere(state.grid[:, :, needed_idx] > 0)\n      if prim_cells.size == 0:\n          raise RuntimeError(\"Required primitive not present in the world\")\n\n      # pick the first occurrence\n      px, py = prim_cells[0]\n\n      # find a free neighbour of that cell to stand on\n      neighbour = None\n      for dx, dy in DIRS.values():\n          nx, ny = px + dx, py + dy\n          if (0 <= nx < blocked.shape[0] and 0 <= ny < blocked.shape[1]\n                  and not blocked[nx, ny]):\n              neighbour = (nx, ny)\n              break\n      if neighbour is None:\n          raise RuntimeError(\"No free neighbour to reach primitive\")\n\n      # plan path to the neighbour\n      path = bfs_path(state.pos, neighbour, blocked)\n      for a in path:\n          reward, new_state = env.step(a)\n          state = new_state\n          actions.append(a)\n\n      # now we are adjacent and facing the primitive (last move direction points to it)\n      # perform USE to pick it up\n      reward, new_state = env.step(env.USE)\n      state = new_state\n      actions.append(env.USE)\n\n      # update bookkeeping\n      prim_req[needed_idx] -= 1\n\n  # ------------------------------------------------------------------\n  # 3. Craft the arrow at its workshop\n  # ------------------------------------------------------------------\n  # workshop index is stored under the special key \"_at\" in the recipe\n  wk_idx = cb.recipes[arrow_idx][\"_at\"]\n  wk_cells = np.argwhere(state.grid[:, :, wk_idx] > 0)\n  if wk_cells.size == 0:\n      raise RuntimeError(\"No workshop for arrow found\")\n  wx, wy = wk_cells[0]\n\n  # find free neighbour of the workshop\n  blocked = np.any(state.grid > 0, axis=2)\n  wk_neighbour = None\n  for dx, dy in DIRS.values():\n      nx, ny = wx + dx, wy + dy\n      if (0 <= nx < blocked.shape[0] and 0 <= ny < blocked.shape[1]\n              and not blocked[nx, ny]):\n          wk_neighbour = (nx, ny)\n          break\n  if wk_neighbour is None:\n      raise RuntimeError(\"No free neighbour to reach workshop\")\n\n  # move to that neighbour\n  path = bfs_path(state.pos, wk_neighbour, blocked)\n  for a in path:\n      reward, new_state = env.step(a)\n      state = new_state\n      actions.append(a)\n\n  # use the workshop to craft the arrow\n  reward, new_state = env.step(env.USE)\n  state = new_state\n  actions.append(env.USE)\n\n  # return the complete action list\n  return actions", "env_interactions": 0, "island_id": 2, "scores": {"3": -1}}
