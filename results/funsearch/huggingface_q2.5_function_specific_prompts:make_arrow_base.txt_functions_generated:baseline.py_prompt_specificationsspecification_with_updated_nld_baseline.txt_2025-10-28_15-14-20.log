{"timestamp": "2025-10-28T18:33:08.756286", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action indices used by CraftLab\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n  DIR_TO_ACT = {(0, 1): ACTION_DOWN,\n                (0, -1): ACTION_UP,\n                (-1, 0): ACTION_LEFT,\n                (1, 0): ACTION_RIGHT}\n  ACT_TO_DIR = {v: k for k, v in DIR_TO_ACT.items()}\n\n  def bfs_adjacent(start, targets, grid, block_set):\n      \"\"\"Return a list of actions moving from ``start`` to a cell adjacent\n      to any target while avoiding cells that contain any kind in ``block_set``.\"\"\"\n      W, H = grid.shape[:2]\n\n      # Fast check: already adjacent?\n      for tx, ty in targets:\n          if abs(start[0] - tx) + abs(start[1] - ty) == 1:\n              return []\n\n      # Build blocked map\n      blocked = np.zeros((W, H), dtype=bool)\n      for b in block_set:\n          blocked |= grid[:, :, b] > 0\n\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = np.zeros((W, H), dtype=bool)\n      visited[start[0], start[1]] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR_TO_ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if blocked[nx, ny]:\n                      continue\n                  new_path = path + [act]\n                  # Check adjacency to any target from the new cell\n                  for tx, ty in targets:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return new_path\n                  visited[nx, ny] = True\n                  q.append((nx, ny, new_path))\n      # Unreachable\n      return []\n\n  # ------------------------------------------------------------------\n  # Extract current world information\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()               # mutable copy of the world grid\n  pos = tuple(state.pos)                 # (x, y) agent position\n\n  # Goal index stored in the task (CraftLab uses env.task.goal)\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      raise ValueError(\"Goal index not found in env.task\")\n\n  # Primitive requirements for the goal (primitive kind \u2192 count)\n  needed = env.world.cookbook.primitives_for(goal_idx)\n\n  # Indices of entities that cannot be walked through\n  block_set = env.world.non_grabbable_indices\n\n  plan = []\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives\n  # ------------------------------------------------------------------\n  for kind_idx, cnt in needed.items():\n      while cnt > 0:\n          # Locate remaining cells that still contain this primitive\n          cells = np.argwhere(grid[:, :, kind_idx] > 0)\n          if cells.size == 0:\n              # Primitive not available \u2013 abort planning\n              return plan\n\n          # Find a path to a position adjacent to one of the primitive cells\n          path = bfs_adjacent(pos, cells.tolist(), grid, block_set)\n          plan.extend(path)\n\n          # Simulate movement to keep ``pos`` up\u2011to\u2011date\n          for a in path:\n              dx, dy = ACT_TO_DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Use action to pick up the primitive\n          plan.append(ACTION_USE)\n\n          # Determine which primitive cell we are now adjacent to\n          adj = None\n          for cx, cy in cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  adj = (cx, cy)\n                  break\n          if adj is None:\n              # Unexpected situation \u2013 break to avoid infinite loop\n              break\n\n          # Update local grid copy and decrement required count\n          grid[adj[0], adj[1], kind_idx] -= 1\n          cnt -= 1\n\n  # ------------------------------------------------------------------\n  # 2. Move to the appropriate workshop and craft the goal item\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\") or recipe.get(\"_key\")\n  if workshop_key is not None:\n      # Resolve workshop index (name or integer)\n      if isinstance(workshop_key, str):\n          workshop_idx = env.world.cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          path = bfs_adjacent(pos, workshop_cells.tolist(), grid, block_set)\n          plan.extend(path)\n\n          for a in path:\n              dx, dy = ACT_TO_DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Use action to craft at the workshop\n          plan.append(ACTION_USE)\n\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:33:27.912217", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Helper utilities\n  # ----------------------------------------------------------------------\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]          # DOWN,UP,LEFT,RIGHT\n  ACTION_USE = 4\n\n  def bfs(start, targets, blocked):\n      \"\"\"Return a list of action indices that moves from start to any cell in targets.\"\"\"\n      w, h = grid.shape[:2]\n      q = collections.deque([(start, [])])\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in targets:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not blocked[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      # No reachable target \u2013 return empty list (should not happen in valid scenarios)\n      return []\n\n  def move_to(target_cells):\n      \"\"\"Move from current position to the nearest cell in target_cells, updating pos and actions.\"\"\"\n      nonlocal pos, actions\n      path = bfs(pos, target_cells, blocked)\n      actions.extend(path)\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n\n  def collect(kind_idx, amount):\n      \"\"\"Collect `amount` items of the given kind by moving onto them and using.\"\"\"\n      nonlocal pos, actions\n      for _ in range(amount):\n          cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, kind_idx] > 0}\n          move_to(cells)\n          actions.append(ACTION_USE)   # pick up the item\n\n  # ----------------------------------------------------------------------\n  # Resolve recipe for the goal (arrow)\n  # ----------------------------------------------------------------------\n  world = env.world\n  cookbook = world.cookbook\n  arrow_idx = cookbook.index[\"arrow\"]\n\n  # primitive requirements and ordered crafting steps\n  needed_prims = {}          # primitive kind \u2192 total count\n  craft_steps = []           # list of (item_idx, count) in topological order\n\n  def resolve(item_idx, mult):\n      \"\"\"Recursively accumulate primitive needs and schedule crafting steps.\"\"\"\n      rec = cookbook.recipes.get(item_idx)\n      if rec is None:                     # primitive (no recipe)\n          needed_prims[item_idx] = needed_prims.get(item_idx, 0) + mult\n          return\n      # first resolve all ingredient items (ignore special keys)\n      for ing, cnt in rec.items():\n          if isinstance(ing, int):\n              resolve(ing, cnt * mult)\n      # then schedule this item to be crafted\n      craft_steps.append((item_idx, mult))\n\n  resolve(arrow_idx, 1)\n\n  # ----------------------------------------------------------------------\n  # Static environment data\n  # ----------------------------------------------------------------------\n  grid = env._current_state.grid\n  w, h, _ = grid.shape\n  # cells that cannot be stepped onto (non\u2011grabbable entities)\n  blocked = np.zeros((w, h), dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # ----------------------------------------------------------------------\n  # Build the action sequence\n  # ----------------------------------------------------------------------\n  actions = []\n  pos = tuple(env._current_state.pos)\n\n  # 1) Gather all primitive resources needed\n  for kind_idx, cnt in needed_prims.items():\n      collect(kind_idx, cnt)\n\n  # 2) Perform crafting steps at the appropriate workshops\n  for item_idx, cnt in craft_steps:\n      rec = cookbook.recipes[item_idx]\n      wk_name = rec.get(\"_at\", rec.get(\"_key\"))\n      wk_idx = wk_name if isinstance(wk_name, int) else cookbook.index[wk_name]\n\n      # locate workshop cells\n      wk_cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, wk_idx] > 0}\n      move_to(wk_cells)\n\n      # use the workshop the required number of times\n      actions.extend([ACTION_USE] * cnt)\n\n  return actions", "env_interactions": 20, "island_id": 6, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T18:33:29.026420", "function_name": "make_arrow", "function_body": "  import collections\n  import numpy as np\n\n  # ------------------------------------------------------------------\n  # Helper functions\n  # ------------------------------------------------------------------\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]  # DOWN, UP, LEFT, RIGHT\n\n  def bfs(start, targets, blocked):\n      \"\"\"Return a list of action indices that moves from start to any cell in targets.\"\"\"\n      w, h = grid.shape[:2]\n      q = collections.deque([(start, [])])\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in targets:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not blocked[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []  # should not happen in a solvable scenario\n\n  def go_to_kind(kind_idx, count):\n      \"\"\"Move to a cell containing `kind_idx` and USE it `count` times.\"\"\"\n      nonlocal pos, actions\n      for _ in range(count):\n          cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, kind_idx] > 0}\n          path = bfs(pos, cells, blocked)\n          actions.extend(path)\n          for a in path:\n              dx, dy = DIRS[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(4)  # USE\n\n  # ------------------------------------------------------------------\n  # Gather recipe information for the target item (arrow)\n  # ------------------------------------------------------------------\n  world = env.world\n  cookbook = world.cookbook\n  arrow_idx = cookbook.index[\"arrow\"]\n\n  needed_prims = {}          # primitive kind -> total count required\n  craft_steps = []           # ordered list of (item_idx, count) to craft\n\n  def resolve(item_idx, multiplier):\n      \"\"\"Recursively collect primitive requirements and schedule crafting steps.\"\"\"\n      rec = cookbook.recipes.get(item_idx)\n      if rec is None:  # primitive (no recipe)\n          needed_prims[item_idx] = needed_prims.get(item_idx, 0) + multiplier\n          return\n      # Resolve ingredients first (ignore special keys like \"_at\" or \"_key\")\n      for ing, cnt in rec.items():\n          if isinstance(ing, int):\n              resolve(ing, cnt * multiplier)\n      # Schedule this item to be crafted after its ingredients are ready\n      craft_steps.append((item_idx, multiplier))\n\n  resolve(arrow_idx, 1)\n\n  # ------------------------------------------------------------------\n  # Static environment data\n  # ------------------------------------------------------------------\n  grid = env._current_state.grid\n  w, h, _ = grid.shape\n  pos = tuple(env._current_state.pos)\n  actions = []\n\n  # Cells that cannot be walked through (non\u2011grabbable entities)\n  blocked = np.zeros((w, h), dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitive resources\n  # ------------------------------------------------------------------\n  for kind_idx, cnt in needed_prims.items():\n      go_to_kind(kind_idx, cnt)\n\n  # ------------------------------------------------------------------\n  # 2) Perform crafting steps at their respective workshops\n  # ------------------------------------------------------------------\n  for item_idx, cnt in craft_steps:\n      rec = cookbook.recipes[item_idx]\n      wk_key = rec.get(\"_at\", rec.get(\"_key\"))\n      wk_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]\n\n      wk_cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, wk_idx] > 0}\n      path = bfs(pos, wk_cells, blocked)\n      actions.extend(path)\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n\n      actions.extend([4] * cnt)   # USE at workshop the required number of times\n\n  return actions", "env_interactions": 20, "island_id": 6, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T18:34:01.345991", "function_name": "make_arrow", "function_body": "  spec = env.action_specs()\n  DOWN = spec['DOWN']\n  UP = spec['UP']\n  LEFT = spec['LEFT']\n  RIGHT = spec['RIGHT']\n  USE = spec['USE']\n  actions = []\n  goal = env.task.goal\n  cookbook = env.world.cookbook\n\n  # Determine which primitives are needed (handle case where goal itself is primitive)\n  required = cookbook.primitives_for(goal).copy()\n  if not required and goal in cookbook.primitives:\n      required = {goal: 1}\n\n  state = env._current_state\n  pos = tuple(state.pos)                     # current (x, y)\n  grid = state.grid.copy()                   # mutable copy of the world grid\n  inventory = state.inventory.copy()         # mutable copy of inventory\n  width, height = grid.shape[:2]\n\n  # -----------------------------------------------------------------\n  # BFS pathfinder avoiding non\u2011grabbable entities.\n  # -----------------------------------------------------------------\n  def bfs(start, target):\n      nonlocal grid\n      blocked = np.zeros((width, height), dtype=bool)\n      non_grab = list(env.world.non_grabbable_indices)\n      if non_grab:\n          blocked = np.any(grid[:, :, non_grab] > 0, axis=2)\n      # allow stepping onto the target even if it would otherwise be blocked\n      blocked[target[0], target[1]] = False\n\n      q = collections.deque([start])\n      parent = {start: None}\n      act_to = {}\n\n      dirs = [\n          (DOWN, (1, 0)),\n          (UP, (-1, 0)),\n          (RIGHT, (0, 1)),\n          (LEFT, (0, -1)),\n      ]\n\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          x, y = cur\n          for act, (dx, dy) in dirs:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height and not blocked[nx, ny]:\n                  nxt = (nx, ny)\n                  if nxt not in parent:\n                      parent[nxt] = cur\n                      act_to[nxt] = act\n                      q.append(nxt)\n\n      if target not in parent:\n          return None\n\n      seq = []\n      cur = target\n      while cur != start:\n          seq.append(act_to[cur])\n          cur = parent[cur]\n      seq.reverse()\n      return seq\n\n  # -----------------------------------------------------------------\n  # Simple Manhattan fallback (ignores obstacles).\n  # -----------------------------------------------------------------\n  def manhattan_path(start, target):\n      seq = []\n      dx = target[0] - start[0]\n      dy = target[1] - start[1]\n      while dx > 0:\n          seq.append(DOWN)\n          dx -= 1\n      while dx < 0:\n          seq.append(UP)\n          dx += 1\n      while dy > 0:\n          seq.append(RIGHT)\n          dy -= 1\n      while dy < 0:\n          seq.append(LEFT)\n          dy += 1\n      return seq\n\n  # -----------------------------------------------------------------\n  # Helper to move to a location, updating position and action list.\n  # -----------------------------------------------------------------\n  def move_to(tgt):\n      nonlocal pos\n      if pos == tgt:\n          return\n      path = bfs(pos, tgt)\n      if path is None:\n          path = manhattan_path(pos, tgt)\n      actions.extend(path)\n      pos = tgt\n\n  # -----------------------------------------------------------------\n  # Collect each required primitive the necessary number of times.\n  # -----------------------------------------------------------------\n  for prim_idx, need_cnt in required.items():\n      have = int(inventory[prim_idx])\n      to_collect = max(0, need_cnt - have)\n\n      for _ in range(to_collect):\n          locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not locations:\n              # No more instances of this primitive on the map.\n              break\n\n          # Choose the nearest instance (Manhattan distance).\n          target = min(\n              locations,\n              key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),\n          )\n\n          move_to(target)\n          actions.append(USE)                     # pick up the primitive\n\n          # Update simulated world state.\n          grid[target[0], target[1], prim_idx] = 0\n          inventory[prim_idx] += 1\n\n  # -----------------------------------------------------------------\n  # Move to the appropriate workshop (if any) and craft the goal.\n  # -----------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      ws_idx = cookbook.index[workshop_name]\n      ws_locations = list(zip(*np.where(grid[:, :, ws_idx] > 0)))\n      if ws_locations:\n          target_ws = min(\n              ws_locations,\n              key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),\n          )\n          move_to(target_ws)\n          actions.append(USE)                     # craft at workshop\n  else:\n      # No specific workshop required; just use the craft action here.\n      actions.append(USE)\n\n  return actions", "env_interactions": 1, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:34:02.460058", "function_name": "make_arrow", "function_body": "  spec = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      spec[\"DOWN\"], spec[\"UP\"], spec[\"LEFT\"], spec[\"RIGHT\"], spec[\"USE\"]\n  )\n\n  goal = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal)  # {kind_idx: count}\n\n  state = env._current_state\n  pos = tuple(state.pos)\n  grid = state.grid.copy()\n  inventory = state.inventory.copy()\n  actions = []\n\n  def bfs(start, target):\n      w, h = grid.shape[:2]\n      non_grab = list(env.world.non_grabbable_indices)\n      if non_grab:\n          blocked = np.any(grid[:, :, non_grab] > 0, axis=2)\n      else:\n          blocked = np.zeros((w, h), dtype=bool)\n      blocked[target[0], target[1]] = False\n\n      q = collections.deque([start])\n      parent = {start: None}\n      act_to = {}\n\n      dirs = [\n          (DOWN, (1, 0)),\n          (UP, (-1, 0)),\n          (RIGHT, (0, 1)),\n          (LEFT, (0, -1)),\n      ]\n\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          x, y = cur\n          for act, (dx, dy) in dirs:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and not blocked[nx, ny]:\n                  nxt = (nx, ny)\n                  if nxt not in parent:\n                      parent[nxt] = cur\n                      act_to[nxt] = act\n                      q.append(nxt)\n\n      if target not in parent:\n          return None\n\n      seq = []\n      cur = target\n      while cur != start:\n          seq.append(act_to[cur])\n          cur = parent[cur]\n      seq.reverse()\n      return seq\n\n  def manhattan_path(start, target):\n      seq = []\n      dx = target[0] - start[0]\n      dy = target[1] - start[1]\n      while dx > 0:\n          seq.append(DOWN)\n          dx -= 1\n      while dx < 0:\n          seq.append(UP)\n          dx += 1\n      while dy > 0:\n          seq.append(RIGHT)\n          dy -= 1\n      while dy < 0:\n          seq.append(LEFT)\n          dy += 1\n      return seq\n\n  def move_to(tgt):\n      nonlocal pos\n      if pos == tgt:\n          return\n      path = bfs(pos, tgt)\n      if path is None:\n          path = manhattan_path(pos, tgt)\n      actions.extend(path)\n      pos = tgt\n\n  # Collect required primitives\n  for kind, cnt_needed in needed.items():\n      have = int(inventory[kind])\n      to_collect = max(0, cnt_needed - have)\n      for _ in range(to_collect):\n          locations = list(zip(*np.where(grid[:, :, kind] > 0)))\n          if not locations:\n              break\n          target = min(\n              locations,\n              key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),\n          )\n          move_to(target)\n          actions.append(USE)\n          grid[target[0], target[1], kind] = 0\n          inventory[kind] += 1\n\n  # Move to workshop (if required) and craft the goal item\n  recipe = env.world.cookbook.recipes.get(goal, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      ws_idx = env.world.cookbook.index[workshop_name]\n      ws_locs = list(zip(*np.where(grid[:, :, ws_idx] > 0)))\n      if ws_locs:\n          target_ws = min(\n              ws_locs,\n              key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),\n          )\n          move_to(target_ws)\n\n  actions.append(USE)\n  return actions", "env_interactions": 1, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:34:28.961275", "function_name": "make_arrow", "function_body": "  actions = []\n  spec = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      spec[\"DOWN\"],\n      spec[\"UP\"],\n      spec[\"LEFT\"],\n      spec[\"RIGHT\"],\n      spec[\"USE\"],\n  )\n\n  goal = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal)  # {prim_idx: count}\n  state = env._current_state\n  grid = state.grid.copy()\n  pos = tuple(state.pos)  # (x, y)\n\n  def _move(cur, tgt):\n      \"\"\"Return a list of actions moving Manhattan\u2011style from cur to tgt.\"\"\"\n      moves = []\n      x, y = cur\n      tx, ty = tgt\n      while x < tx:\n          moves.append(DOWN)\n          x += 1\n      while x > tx:\n          moves.append(UP)\n          x -= 1\n      while y < ty:\n          moves.append(RIGHT)\n          y += 1\n      while y > ty:\n          moves.append(LEFT)\n          y -= 1\n      return moves\n\n  # ----------------------------------------------------------------------\n  # 1) Collect required primitives\n  # ----------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          # locate remaining instances of this primitive\n          locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not locations:\n              # primitive not present any more; abort early\n              break\n          # pick nearest instance (Manhattan distance)\n          target = min(\n              locations,\n              key=lambda loc: abs(loc[0] - pos[0]) + abs(loc[1] - pos[1]),\n          )\n          actions.extend(_move(pos, target))\n          pos = target\n          actions.append(USE)          # pick up the primitive\n          grid[pos[0], pos[1], prim_idx] = 0   # remove from our copy\n\n  # ----------------------------------------------------------------------\n  # 2) Go to workshop (if any) and craft the goal item\n  # ----------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      ws_locations = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))\n      if ws_locations:\n          target = min(\n              ws_locations,\n              key=lambda loc: abs(loc[0] - pos[0]) + abs(loc[1] - pos[1]),\n          )\n          actions.extend(_move(pos, target))\n          pos = target\n          actions.append(USE)   # craft at the workshop\n  else:\n      # No specific workshop \u2013 just use the current cell to craft\n      actions.append(USE)\n\n  return actions", "env_interactions": 1, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:34:30.065733", "function_name": "make_arrow", "function_body": "  actions = []\n  spec = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      spec[\"DOWN\"],\n      spec[\"UP\"],\n      spec[\"LEFT\"],\n      spec[\"RIGHT\"],\n      spec[\"USE\"],\n  )\n\n  goal = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal)  # {prim_idx: count}\n  state = env._current_state\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n\n  # indices of entities that block movement (trees, water, etc.)\n  non_grab = env.world.non_grabbable_indices\n  width, height = grid.shape[0], grid.shape[1]\n\n  # ------------------------------------------------------------------\n  # helper: shortest Manhattan\u2011style path avoiding non\u2011grabbable cells\n  # ------------------------------------------------------------------\n  def bfs(start, target):\n      \"\"\"Return a list of actions moving from start to target.\"\"\"\n      if start == target:\n          return []\n      from collections import deque\n\n      q = deque([start])\n      parent = {start: None}  # maps position -> (prev_pos, action)\n      while q:\n          x, y = q.popleft()\n          if (x, y) == target:\n              break\n          for act, (dx, dy) in (\n              (DOWN, (1, 0)),\n              (UP, (-1, 0)),\n              (RIGHT, (0, 1)),\n              (LEFT, (0, -1)),\n          ):\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              # check for blocking entities\n              blocked = False\n              for idx in non_grab:\n                  if grid[nx, ny, idx] > 0:\n                      blocked = True\n                      break\n              if blocked:\n                  continue\n              if (nx, ny) not in parent:\n                  parent[(nx, ny)] = ((x, y), act)\n                  q.append((nx, ny))\n      else:\n          # no path found \u2013 return empty list (will likely fail later)\n          return []\n\n      # reconstruct actions\n      actions_path = []\n      cur = target\n      while cur != start:\n          prev, act = parent[cur]\n          actions_path.append(act)\n          cur = prev\n      actions_path.reverse()\n      return actions_path\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitive items\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          # locate remaining instances of this primitive\n          locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not locations:\n              # nothing left \u2013 break early\n              break\n          # choose the nearest one (Manhattan distance)\n          target = min(\n              locations,\n              key=lambda loc: abs(loc[0] - pos[0]) + abs(loc[1] - pos[1]),\n          )\n          actions.extend(bfs(pos, target))\n          pos = target\n          actions.append(USE)  # pick up the primitive\n          # remove it from our copy of the grid\n          grid[pos[0], pos[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 2) Go to the appropriate workshop and craft the goal item\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      ws_locations = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))\n      if ws_locations:\n          target = min(\n              ws_locations,\n              key=lambda loc: abs(loc[0] - pos[0]) + abs(loc[1] - pos[1]),\n          )\n          actions.extend(bfs(pos, target))\n          pos = target\n          actions.append(USE)  # craft at the workshop\n\n  return actions", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:34:49.445949", "function_name": "make_arrow", "function_body": "  # Reset environment and fetch core objects\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid                    # (WIDTH, HEIGHT, n_kinds)\n\n  # ------------------------------------------------------------------\n  # Action indices (as defined by CraftLab.action_specs)\n  # ------------------------------------------------------------------\n  specs = env.action_specs()\n  DOWN = specs[\"DOWN\"]\n  UP = specs[\"UP\"]\n  LEFT = specs[\"LEFT\"]\n  RIGHT = specs[\"RIGHT\"]\n  USE = specs[\"USE\"]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  from collections import deque\n  import numpy as np\n\n  # movement delta \u2192 action\n  MOVE_DELTAS = {\n      (1, 0): DOWN,\n      (-1, 0): UP,\n      (0, -1): LEFT,\n      (0, 1): RIGHT,\n  }\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of movement actions that brings the agent from\n      ``start`` (y, x) to ``goal`` while avoiding non\u2011grabbable obstacles.\"\"\"\n      if start == goal:\n          return []\n      H, W = grid.shape[:2]\n      blocked = list(world.non_grabbable_indices)\n\n      visited = np.full((H, W), False, dtype=bool)\n      prev = {}                     # (y,x) \u2192 (prev_y, prev_x, action)\n      q = deque([start])\n      visited[start] = True\n\n      while q:\n          y, x = q.popleft()\n          for (dy, dx), act in MOVE_DELTAS.items():\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < H and 0 <= nx < W and not visited[ny, nx]:\n                  if np.any(grid[ny, nx, blocked] > 0):\n                      continue          # cell occupied by a non\u2011grabbable entity\n                  visited[ny, nx] = True\n                  prev[(ny, nx)] = (y, x, act)\n                  if (ny, nx) == goal:\n                      # reconstruct path\n                      actions = []\n                      cur = (ny, nx)\n                      while cur != start:\n                          py, px, a = prev[cur]\n                          actions.append(a)\n                          cur = (py, px)\n                      actions.reverse()\n                      return actions\n                  q.append((ny, nx))\n      # No path found \u2013 return empty list (should not happen for valid tasks)\n      return []\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Locate the nearest cell containing ``kind_idx`` (primitive or workshop).\"\"\"\n      locs = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      nearest = locs[np.argmin(dists)]\n      return (int(nearest[0]), int(nearest[1]))\n\n  # ------------------------------------------------------------------\n  # Determine goal index for 'arrow' and required primitives\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  primitive_requirements = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\")   # may be None\n\n  actions = []\n  cur_pos = state.pos   # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the needed number of times\n  # ------------------------------------------------------------------\n  for prim_idx, count in primitive_requirements.items():\n      for _ in range(count):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive not present \u2013 abort early\n              return actions\n          # Move to the primitive cell\n          actions += bfs_path(cur_pos, target)\n          cur_pos = target\n          # Pick it up\n          actions.append(USE)\n\n  # ------------------------------------------------------------------\n  # Move to the workshop (if any) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          actions += bfs_path(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # Final USE to trigger crafting at the current location\n  actions.append(USE)\n\n  return actions", "env_interactions": 19, "island_id": 7, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T18:34:50.568969", "function_name": "make_arrow", "function_body": "  # Reset environment and fetch core objects\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid                     # (WIDTH, HEIGHT, n_kinds)\n\n  # Action indices (dynamic, as defined by the environment)\n  specs = env.action_specs()\n  DOWN = specs[\"DOWN\"]\n  UP = specs[\"UP\"]\n  LEFT = specs[\"LEFT\"]\n  RIGHT = specs[\"RIGHT\"]\n  USE = specs[\"USE\"]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  from collections import deque\n  import numpy as np\n\n  # Directions mapped to actions\n  DIRS = [\n      (1, 0, DOWN),   # down\n      (-1, 0, UP),    # up\n      (0, 1, RIGHT),  # right\n      (0, -1, LEFT),  # left\n  ]\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that moves\n      the agent from ``start`` to ``goal`` while avoiding non\u2011grabbable\n      obstacles. ``start`` and ``goal`` are (y, x) tuples.\"\"\"\n      H, W = grid.shape[:2]\n      visited = np.full((H, W), False, dtype=bool)\n      prev = {}                     # (y,x) -> (prev_y, prev_x, action)\n      q = deque([start])\n      visited[start] = True\n\n      while q:\n          y, x = q.popleft()\n          if (y, x) == goal:\n              # reconstruct path\n              actions = []\n              cur = (y, x)\n              while cur != start:\n                  py, px, act = prev[cur]\n                  actions.append(act)\n                  cur = (py, px)\n              actions.reverse()\n              return actions\n\n          for dy, dx, act in DIRS:\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < H and 0 <= nx < W and not visited[ny, nx]:\n                  # cell is blocked if any non\u2011grabbable entity occupies it\n                  if np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0):\n                      continue\n                  visited[ny, nx] = True\n                  prev[(ny, nx)] = (y, x, act)\n                  q.append((ny, nx))\n      # No path found \u2013 return empty list (should not happen for valid tasks)\n      return []\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Return the coordinates (y, x) of the nearest cell that contains\n      ``kind_idx``. If none exists, return None.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return (int(nearest[0]), int(nearest[1]))\n\n  # ------------------------------------------------------------------\n  # Determine goal index for 'arrow' and required primitives\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed = world.cookbook.primitives_for(arrow_idx)   # {primitive_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the appropriate number of times\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive not present \u2013 abort early\n              return actions\n\n          # Move to a free cell adjacent to the primitive (if possible)\n          ty, tx = target\n          adj = None\n          for dy, dx, _ in DIRS:\n              ny, nx = ty + dy, tx + dx\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)\n                  if not occupied:\n                      adj = (ny, nx)\n                      break\n          if adj is None:\n              # No free neighbour; stand on the primitive cell itself\n              adj = target\n\n          # Move to chosen adjacent cell\n          actions += bfs_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (issue a movement that will be blocked)\n          dy, dx = ty - cur_pos[0], tx - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick up the primitive\n          actions.append(USE)\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          actions += bfs_path(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # Trigger crafting at the current location\n  actions.append(USE)\n\n  return actions", "env_interactions": 21, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:35:22.360093", "function_name": "make_arrow", "function_body": "  # Action indices\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  _MOVES = [\n      ((0, 1), DOWN),   # down  (y+1)\n      ((0, -1), UP),    # up    (y-1)\n      ((-1, 0), LEFT),  # left  (x-1)\n      ((1, 0), RIGHT),  # right (x+1)\n  ]\n\n  def _bfs_path(start, goal, grid):\n      \"\"\"Return a list of actions that moves from start to goal using BFS.\n      Cells that contain any non\u2011zero kind are treated as blocked,\n      except the goal cell itself (which may hold the target item).\"\"\"\n      w, h = grid.shape[0], grid.shape[1]          # width (x), height (y)\n      from collections import deque\n      q = deque([tuple(start)])\n      prev = {tuple(start): (None, None)}          # pos -> (prev_pos, action)\n\n      while q:\n          x, y = q.popleft()\n          if [x, y] == goal:\n              break\n          for (dx, dy), act in _MOVES:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < w and 0 <= ny < h):\n                  continue\n              if (nx, ny) in prev:\n                  continue\n              # allow stepping onto the goal cell even if occupied\n              if (nx, ny) != tuple(goal) and grid[nx, ny].sum() != 0:\n                  continue\n              prev[(nx, ny)] = ((x, y), act)\n              q.append((nx, ny))\n\n      if tuple(goal) not in prev:\n          return []   # unreachable\n\n      # reconstruct path\n      path = []\n      cur = tuple(goal)\n      while prev[cur][0] is not None:\n          cur, act = prev[cur]\n          path.append(act)\n      path.reverse()\n      return path\n\n  def _nearest_kind(kind_idx, cur_pos, grid):\n      \"\"\"Return [x, y] of the nearest cell containing kind_idx, or None.\"\"\"\n      ys, xs = np.where(grid[:, :, kind_idx] > 0)   # y\u2011rows, x\u2011cols\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])\n      best = int(np.argmin(dists))\n      return [int(xs[best]), int(ys[best])]\n\n  # ------------------------------------------------------------------\n  # Initialise planning state\n  # ------------------------------------------------------------------\n  actions = []\n\n  # Current position (list so we can modify in\u2011place)\n  if hasattr(env, \"_current_state\") and env._current_state is not None:\n      cur_pos = list(env._current_state.pos)\n  else:\n      cur_pos = list(env.scenario.init_pos)\n\n  # Working copy of the grid \u2013 we will zero out primitives once taken\n  grid = env.scenario.init_grid.copy()\n\n  # Goal item index\n  goal_idx = env.task.goal\n\n  cookbook = env.world.cookbook\n  primitives_set = cookbook.primitives\n  recipes = cookbook.recipes\n  init_grid = env.scenario.init_grid   # for locating static workshops\n\n  # ------------------------------------------------------------------\n  # Recursive planning function\n  # ------------------------------------------------------------------\n  def _ensure_item(item_idx):\n      \"\"\"Plan actions guaranteeing one unit of `item_idx` in the inventory.\"\"\"\n      # Primitive \u2013 just collect it from the world\n      if item_idx in primitives_set:\n          target = _nearest_kind(item_idx, cur_pos, grid)\n          if target is None:\n              return False\n          # move to primitive\n          actions.extend(_bfs_path(cur_pos, target, grid))\n          actions.append(USE)               # pick up\n          # mark cell as empty for later planning\n          grid[target[1], target[0], item_idx] = 0\n          cur_pos[0], cur_pos[1] = target[0], target[1]\n          return True\n\n      # Non\u2011primitive \u2013 need to craft using its recipe\n      recipe = recipes.get(item_idx)\n      if recipe is None:\n          return False\n\n      # First obtain all ingredients\n      for ingr_idx, cnt in recipe.items():\n          if ingr_idx == \"_at\":\n              continue\n          for _ in range(cnt):\n              if not _ensure_item(ingr_idx):\n                  return False\n\n      # Then go to the required workshop (if any) and craft\n      workshop_kind = recipe.get(\"_at\")\n      if workshop_kind is not None:\n          ws_target = _nearest_kind(workshop_kind, cur_pos, init_grid)\n          if ws_target is None:\n              return False\n          actions.extend(_bfs_path(cur_pos, ws_target, grid))\n          actions.append(USE)               # craft at workshop\n          cur_pos[0], cur_pos[1] = ws_target[0], ws_target[1]\n      else:\n          # No workshop specified \u2013 just use (should rarely happen)\n          actions.append(USE)\n      return True\n\n  # ------------------------------------------------------------------\n  # Start planning for the final goal\n  # ------------------------------------------------------------------\n  _ensure_item(goal_idx)\n\n  # Return the complete action sequence\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:35:23.472981", "function_name": "make_arrow", "function_body": "  # ------------------------------------------------------------------\n  # Constants and helper utilities\n  # ------------------------------------------------------------------\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  _MOVES = [((0, 1), DOWN), ((0, -1), UP), ((-1, 0), LEFT), ((1, 0), RIGHT)]\n\n  def _bfs_path(start, goal, grid):\n      \"\"\"Return a list of actions that moves from ``start`` to ``goal`` using BFS.\n      Cells that contain any non\u2011zero kind are treated as blocked, except the\n      goal cell itself (which may be occupied by the target item).\"\"\"\n      w, h = grid.shape[0], grid.shape[1]          # width (x), height (y)\n      from collections import deque\n      q = deque([tuple(start)])\n      prev = {tuple(start): (None, None)}          # pos -> (prev_pos, action)\n\n      while q:\n          x, y = q.popleft()\n          if [x, y] == goal:\n              break\n          for (dx, dy), act in _MOVES:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < w and 0 <= ny < h):\n                  continue\n              if (nx, ny) in prev:\n                  continue\n              # allow stepping onto the goal cell even if occupied\n              if (nx, ny) != tuple(goal) and grid[nx, ny].sum() != 0:\n                  continue\n              prev[(nx, ny)] = ((x, y), act)\n              q.append((nx, ny))\n\n      if tuple(goal) not in prev:\n          return []   # unreachable\n\n      # reconstruct path\n      path = []\n      cur = tuple(goal)\n      while prev[cur][0] is not None:\n          cur, act = prev[cur]\n          path.append(act)\n      path.reverse()\n      return path\n\n  def _nearest_kind(kind_idx, cur_pos, search_grid):\n      \"\"\"Return the [x, y] coordinate of the nearest cell that contains ``kind_idx``.\n      If none exists, return ``None``.\"\"\"\n      ys, xs = np.where(search_grid[:, :, kind_idx] > 0)   # y\u2011rows, x\u2011cols\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])\n      best = int(np.argmin(dists))\n      return [int(xs[best]), int(ys[best])]\n\n  # ------------------------------------------------------------------\n  # Initialise planning state\n  # ------------------------------------------------------------------\n  actions = []\n\n  # Current position (list so it can be mutated in\u2011place)\n  if hasattr(env, \"_current_state\") and env._current_state is not None:\n      cur_pos = list(env._current_state.pos)\n  else:\n      cur_pos = list(env.scenario.init_pos)\n\n  # Working copy of the grid \u2013 we will zero out primitives once taken.\n  planning_grid = env.scenario.init_grid.copy()\n\n  goal_idx = env.task.goal\n  cookbook = env.world.cookbook\n  primitives_set = cookbook.primitives\n  recipes = cookbook.recipes\n  static_grid = env.scenario.init_grid   # used for locating fixed workshops\n\n  # ------------------------------------------------------------------\n  # Recursive planner that ensures one unit of ``item_idx`` ends up in inventory\n  # ------------------------------------------------------------------\n  def _obtain(item_idx):\n      \"\"\"Plan actions that guarantee one unit of ``item_idx`` in the inventory.\"\"\"\n      # ---- Primitive -------------------------------------------------\n      if item_idx in primitives_set:\n          target = _nearest_kind(item_idx, cur_pos, planning_grid)\n          if target is None:\n              return False\n          actions.extend(_bfs_path(cur_pos, target, planning_grid))\n          actions.append(USE)                     # pick up primitive\n          planning_grid[target[1], target[0], item_idx] = 0   # remove it\n          cur_pos[0], cur_pos[1] = target[0], target[1]\n          return True\n\n      # ---- Crafted item ---------------------------------------------\n      recipe = recipes.get(item_idx)\n      if recipe is None:\n          return False\n\n      # First collect all ingredients (respecting required counts)\n      for ingr_idx, cnt in recipe.items():\n          if ingr_idx == \"_at\":\n              continue\n          for _ in range(cnt):\n              if not _obtain(ingr_idx):\n                  return False\n\n      # Then go to the required workshop (if any) and craft\n      workshop_kind = recipe.get(\"_at\")\n      if workshop_kind is not None:\n          ws_target = _nearest_kind(workshop_kind, cur_pos, static_grid)\n          if ws_target is None:\n              return False\n          actions.extend(_bfs_path(cur_pos, ws_target, planning_grid))\n          actions.append(USE)                     # craft at workshop\n          cur_pos[0], cur_pos[1] = ws_target[0], ws_target[1]\n      else:\n          # No workshop specified \u2013 simply use (should rarely happen)\n          actions.append(USE)\n      return True\n\n  # ------------------------------------------------------------------\n  # Start planning for the final goal\n  # ------------------------------------------------------------------\n  _obtain(goal_idx)\n\n  # Return the full action sequence\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": 0.0}}
