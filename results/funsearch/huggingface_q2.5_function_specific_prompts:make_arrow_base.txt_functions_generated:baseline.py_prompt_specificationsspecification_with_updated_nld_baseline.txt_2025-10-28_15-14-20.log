{"timestamp": "2025-10-28T18:47:44.396634", "function_name": "make_arrow", "function_body": "  import collections, numpy as np\n\n  # Action indices (assumed standard in CraftWorld)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: BFS returning a list of actions that moves the agent from\n  # `start` (x, y) to a cell adjacent (Manhattan distance \u2264 1) to any\n  # position in `targets`. Cells with any non\u2011zero kind are treated as\n  # obstacles.\n  # ------------------------------------------------------------------\n  def _bfs(start, targets, occupied):\n      w, h = occupied.shape\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # Stop if we are already adjacent to a target.\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) <= 1:\n                  return path\n          # Expand neighbours.\n          for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # Unreachable \u2013 return empty list.\n      return []\n\n  # ------------------------------------------------------------------\n  # Locate world and cookbook objects.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Some wrappers expose the world via the current state.\n      state_tmp = getattr(env, \"_current_state\", None)\n      if state_tmp is not None:\n          world = state_tmp.world\n  if world is None:\n      raise RuntimeError(\"World object not found in the environment.\")\n\n  cookbook = world.cookbook\n\n  # Ensure we have a current state (reset if necessary).\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  # ------------------------------------------------------------------\n  # Goal is hard\u2011coded to \"arrow\".\n  # ------------------------------------------------------------------\n  goal_idx = cookbook.index[\"arrow\"]\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # Current position and a mutable copy of the grid.\n  pos = tuple(state.pos)                # (x, y)\n  cur_grid = state.grid.copy()          # (W, H, n_kinds)\n\n  actions = []\n  harvested = set()                     # cells already collected from\n\n  # Helper to compute occupied map (any non\u2011empty cell).\n  def occupied_map(g):\n      return np.any(g > 0, axis=2)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive.\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      # All cells currently containing this primitive.\n      locations = [tuple(p) for p in np.argwhere(cur_grid[:, :, prim_idx] > 0)]\n      # Order by Manhattan distance from current position.\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      collected = 0\n      for loc in locations:\n          if collected >= needed:\n              break\n          if loc in harvested:\n              continue\n          # Move adjacent to the primitive.\n          occ = occupied_map(cur_grid)\n          path = _bfs(pos, [loc], occ)\n          actions.extend(path)\n          # Update internal position tracker.\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Pick up the primitive.\n          actions.append(USE)\n          # Clear the cell for future navigation.\n          cur_grid[loc[0], loc[1], prim_idx] = 0\n          harvested.add(loc)\n          collected += 1\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (may be a name or already an int).\n      workshop_idx = (cookbook.index[workshop_key]\n                      if isinstance(workshop_key, str)\n                      else workshop_key)\n      # Find all workshop cells currently present.\n      workshop_cells = [tuple(p) for p in np.argwhere(cur_grid[:, :, workshop_idx] > 0)]\n      if workshop_cells:\n          # Choose the nearest workshop.\n          workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = workshop_cells[0]\n          # Move adjacent to the workshop.\n          occ = occupied_map(cur_grid)\n          path = _bfs(pos, [target_ws], occ)\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Use the workshop to craft the arrow.\n          actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T18:48:19.721630", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def _move_to(pos, target, seq):\n      \"\"\"Append moves that bring mutable ``pos`` (list [x, y]) to ``target``.\"\"\"\n      while pos[0] != target[0] or pos[1] != target[1]:\n          if pos[0] < target[0]:\n              seq.append(RIGHT)\n              pos[0] += 1\n          elif pos[0] > target[0]:\n              seq.append(LEFT)\n              pos[0] -= 1\n          elif pos[1] < target[1]:\n              seq.append(DOWN)\n              pos[1] += 1\n          elif pos[1] > target[1]:\n              seq.append(UP)\n              pos[1] -= 1\n\n  def _nearest_kind(kind_idx, cur_pos):\n      \"\"\"Return the (x, y) of the nearest cell containing ``kind_idx``.\"\"\"\n      ys, xs = np.where(grid[:, :, kind_idx] > 0)\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])\n      best = int(np.argmin(dists))\n      return [int(xs[best]), int(ys[best])]\n\n  # ------------------------------------------------------------------\n  # Initialise mutable state\n  # ------------------------------------------------------------------\n  # Starting position\n  if hasattr(env, \"_current_state\") and env._current_state is not None:\n      cur_pos = list(env._current_state.pos)\n  else:\n      cur_pos = list(env.scenario.init_pos)\n\n  # Static grid copy \u2013 we will clear primitives once they are picked up.\n  grid = env.scenario.init_grid.copy()\n\n  # Inventory tracker (counts of each kind we have already collected/crafted)\n  inventory = {}\n\n  # Action sequence to be returned\n  actions = []\n\n  # Goal item index\n  goal_idx = env.task.goal\n\n  # ------------------------------------------------------------------\n  # Core recursive planner\n  # ------------------------------------------------------------------\n  def _ensure(item_idx, needed):\n      \"\"\"Make sure ``inventory[item_idx]`` >= ``needed`` by collecting/crafting.\"\"\"\n      have = inventory.get(item_idx, 0)\n      while have < needed:\n          # Primitive case \u2013 just pick it up from the world.\n          if item_idx in env.world.cookbook.primitives:\n              target = _nearest_kind(item_idx, cur_pos)\n              if target is None:\n                  # Primitive not available; abort planning.\n                  return False\n              _move_to(cur_pos, target, actions)\n              actions.append(USE)                     # pick up\n              grid[target[1], target[0], item_idx] = 0  # remove from static view\n              inventory[item_idx] = inventory.get(item_idx, 0) + 1\n              have += 1\n          else:\n              # Crafted item \u2013 first ensure all its ingredients.\n              recipe = env.world.cookbook.recipes.get(item_idx, {})\n              # Gather ingredients (ignore the special \"_at\" key).\n              for ing_idx, cnt in recipe.items():\n                  if ing_idx == \"_at\":\n                      continue\n                  if not _ensure(ing_idx, cnt):\n                      return False\n              # Move to the required workshop (if any) and craft.\n              workshop_idx = recipe.get(\"_at\")\n              if workshop_idx is not None:\n                  w_target = _nearest_kind(workshop_idx, cur_pos)\n                  if w_target is None:\n                      # No workshop found; abort.\n                      return False\n                  _move_to(cur_pos, w_target, actions)\n              actions.append(USE)                     # perform crafting\n              # Update inventory: consume ingredients, add the crafted item.\n              for ing_idx, cnt in recipe.items():\n                  if ing_idx == \"_at\":\n                      continue\n                  inventory[ing_idx] = inventory.get(ing_idx, 0) - cnt\n              inventory[item_idx] = inventory.get(item_idx, 0) + 1\n              have += 1\n      return True\n\n  # ------------------------------------------------------------------\n  # Execute the plan for the final goal.\n  # ------------------------------------------------------------------\n  _ensure(goal_idx, 1)\n\n  return actions", "env_interactions": 1, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:48:20.835050", "function_name": "make_arrow", "function_body": "  # Action indices\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def _move_to(pos, target, seq):\n      \"\"\"Append moves to bring mutable list ``pos`` (x, y) to ``target``.\"\"\"\n      while pos[0] != target[0] or pos[1] != target[1]:\n          if pos[0] < target[0]:\n              seq.append(RIGHT)\n              pos[0] += 1\n          elif pos[0] > target[0]:\n              seq.append(LEFT)\n              pos[0] -= 1\n          elif pos[1] < target[1]:\n              seq.append(DOWN)\n              pos[1] += 1\n          elif pos[1] > target[1]:\n              seq.append(UP)\n              pos[1] -= 1\n\n  def _nearest_kind(kind_idx, cur_pos, grid):\n      \"\"\"Return [x, y] of the nearest cell containing ``kind_idx``.\"\"\"\n      ys, xs = np.where(grid[:, :, kind_idx] > 0)\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])\n      best = int(np.argmin(dists))\n      return [int(xs[best]), int(ys[best])]\n\n  # ------------------------------------------------------------------\n  # Initialise mutable state\n  # ------------------------------------------------------------------\n  if hasattr(env, \"_current_state\") and env._current_state is not None:\n      cur_pos = list(env._current_state.pos)\n  else:\n      cur_pos = list(env.scenario.init_pos)\n\n  # static grid copy \u2013 we clear cells as we pick up items\n  grid = env.scenario.init_grid.copy()\n\n  # inventory tracking (item index -> count)\n  inventory = collections.defaultdict(int)\n\n  actions = []\n  goal_idx = env.task.goal\n  cookbook = env.world.cookbook\n\n  # ------------------------------------------------------------------\n  # Core recursive planner\n  # ------------------------------------------------------------------\n  def _ensure(item_idx, needed):\n      \"\"\"Make sure ``inventory[item_idx]`` reaches at least ``needed``.\"\"\"\n      while inventory[item_idx] < needed:\n          # Primitive \u2013 just pick it up\n          if item_idx in cookbook.primitives:\n              target = _nearest_kind(item_idx, cur_pos, grid)\n              if target is None:\n                  # cannot find required primitive \u2013 abort planning\n                  return False\n              _move_to(cur_pos, target, actions)\n              actions.append(USE)                     # pick up\n              grid[target[1], target[0], item_idx] = 0\n              inventory[item_idx] += 1\n              continue\n\n          # Non\u2011primitive \u2013 need to craft according to its recipe\n          recipe = cookbook.recipes.get(item_idx, {})\n          # First, ensure all ingredients are available\n          for ing_idx, ing_cnt in recipe.items():\n              if ing_idx == \"_at\":\n                  continue\n              total_needed = ing_cnt\n              if not _ensure(ing_idx, total_needed):\n                  return False\n              inventory[ing_idx] -= total_needed\n\n          # Move to the required workshop (if any)\n          workshop_kind = recipe.get(\"_at\")\n          if workshop_kind is not None:\n              workshop_pos = _nearest_kind(workshop_kind, cur_pos, grid)\n              if workshop_pos is None:\n                  # No workshop found \u2013 cannot craft\n                  return False\n              _move_to(cur_pos, workshop_pos, actions)\n\n          # Craft the item\n          actions.append(USE)\n          inventory[item_idx] += 1\n      return True\n\n  # ------------------------------------------------------------------\n  # Plan to obtain the goal item\n  # ------------------------------------------------------------------\n  _ensure(goal_idx, 1)\n\n  return actions", "env_interactions": 1, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:48:40.521307", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Helper utilities\n  # ----------------------------------------------------------------------\n  import collections\n  import numpy as np\n\n  # Action indices as defined in the environment\n  # 0 = DOWN, 1 = UP, 2 = LEFT, 3 = RIGHT, 4 = USE\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n\n  def bfs(start, targets, blocked):\n      \"\"\"Return a list of actions that moves from start to any cell in targets.\"\"\"\n      w, h = blocked.shape\n      q = collections.deque([(start, [])])\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in targets:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not blocked[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      # Should never happen for solvable tasks\n      return []\n\n  def go_to_and_use(kind_idx, count):\n      \"\"\"Move to cells containing `kind_idx` and USE them `count` times.\"\"\"\n      nonlocal pos, actions, grid, w, h, blocked\n      for _ in range(count):\n          # locate all cells that currently hold the required kind\n          cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, kind_idx] > 0}\n          path = bfs(pos, cells, blocked)\n          actions.extend(path)\n          for a in path:\n              dx, dy = DIRS[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(4)  # USE action\n          # after picking up the primitive the cell becomes empty;\n          # primitives are grabbable, so `blocked` does not need to be updated\n\n  # ----------------------------------------------------------------------\n  # Gather recipe information for the target item \"arrow\"\n  # ----------------------------------------------------------------------\n  world = env.world\n  cookbook = world.cookbook\n  arrow_idx = cookbook.index[\"arrow\"]\n\n  needed_prims = {}          # primitive kind -> total count required\n  craft_steps = []           # list of (item_idx, count) in correct order\n\n  def resolve(item_idx, mult):\n      \"\"\"Recursively collect primitive needs and schedule crafting steps.\"\"\"\n      rec = cookbook.recipes.get(item_idx)\n      if rec is None:\n          # No recipe \u2192 primitive resource\n          needed_prims[item_idx] = needed_prims.get(item_idx, 0) + mult\n          return\n      # Resolve ingredients first (ignore special keys)\n      for ing, cnt in rec.items():\n          if isinstance(ing, int):\n              resolve(ing, cnt * mult)\n      # Schedule this item to be crafted after its ingredients\n      craft_steps.append((item_idx, mult))\n\n  resolve(arrow_idx, 1)\n\n  # ----------------------------------------------------------------------\n  # Static environment data\n  # ----------------------------------------------------------------------\n  grid = env._current_state.grid\n  w, h, _ = grid.shape\n  blocked = np.zeros((w, h), dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # ----------------------------------------------------------------------\n  # Build the action sequence\n  # ----------------------------------------------------------------------\n  actions = []\n  pos = tuple(env._current_state.pos)\n\n  # 1) Collect all required primitive resources\n  for kind_idx, cnt in needed_prims.items():\n      go_to_and_use(kind_idx, cnt)\n\n  # 2) Perform crafting steps at the appropriate workshops\n  for item_idx, cnt in craft_steps:\n      rec = cookbook.recipes[item_idx]\n      # workshop identifier may be stored under \"_at\" or \"_key\"\n      wk_key = rec.get(\"_at\", rec.get(\"_key\"))\n      if isinstance(wk_key, int):\n          wk_idx = wk_key\n      else:\n          wk_idx = cookbook.index[wk_key]\n\n      wk_cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, wk_idx] > 0}\n      path = bfs(pos, wk_cells, blocked)\n      actions.extend(path)\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n\n      # Use the workshop the required number of times\n      actions.extend([4] * cnt)\n\n  return actions", "env_interactions": 20, "island_id": 6, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T18:48:41.644028", "function_name": "make_arrow", "function_body": "  import collections, numpy as np\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS path planning (returns list of action indices)\n  # ----------------------------------------------------------------------\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]  # DOWN,UP,LEFT,RIGHT as in env\n  def bfs(start, targets, blocked):\n      w, h = blocked.shape\n      q = collections.deque([(start, [])])\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in targets:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not blocked[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []  # should not happen for solvable tasks\n\n  # ----------------------------------------------------------------------\n  # Move to a cell containing a given kind and USE it `cnt` times\n  # ----------------------------------------------------------------------\n  def go_to_and_use(kind_idx, cnt, grid, blocked, pos, actions):\n      w, h, _ = grid.shape\n      for _ in range(cnt):\n          cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, kind_idx] > 0}\n          path = bfs(pos, cells, blocked)\n          actions.extend(path)\n          for a in path:\n              dx, dy = DIRS[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(4)          # USE\n      return pos\n\n  # ----------------------------------------------------------------------\n  # Gather recipe information for the target item \"arrow\"\n  # ----------------------------------------------------------------------\n  world = env.world\n  cookbook = world.cookbook\n  arrow_idx = cookbook.index[\"arrow\"]\n\n  needed_prims = {}          # primitive kind -> total count needed\n  craft_steps = []           # list of (item_idx, count) in crafting order\n\n  def resolve(item_idx, mult):\n      rec = cookbook.recipes.get(item_idx)\n      if rec is None:                     # primitive (no recipe)\n          needed_prims[item_idx] = needed_prims.get(item_idx, 0) + mult\n          return\n      # first resolve ingredients (ignore special keys)\n      for ing, cnt in rec.items():\n          if isinstance(ing, int):\n              resolve(ing, cnt * mult)\n      # then schedule this item to be crafted\n      craft_steps.append((item_idx, mult))\n\n  resolve(arrow_idx, 1)\n\n  # ----------------------------------------------------------------------\n  # Static environment data\n  # ----------------------------------------------------------------------\n  grid = env._current_state.grid\n  w, h, _ = grid.shape\n  blocked = np.zeros((w, h), dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # ----------------------------------------------------------------------\n  # Build the action sequence\n  # ----------------------------------------------------------------------\n  actions = []\n  pos = tuple(env._current_state.pos)\n\n  # 1) Collect all required primitive resources\n  for kind_idx, cnt in needed_prims.items():\n      pos = go_to_and_use(kind_idx, cnt, grid, blocked, pos, actions)\n\n  # 2) Perform crafting steps at the appropriate workshops\n  for item_idx, cnt in craft_steps:\n      rec = cookbook.recipes[item_idx]\n      wk_key = rec.get(\"_at\", rec.get(\"_key\"))\n      if isinstance(wk_key, int):\n          wk_idx = wk_key\n      else:\n          wk_idx = cookbook.index[wk_key]\n\n      wk_cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, wk_idx] > 0}\n      path = bfs(pos, wk_cells, blocked)\n      actions.extend(path)\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n\n      actions.extend([4] * cnt)   # USE workshop the required number of times\n\n  return actions", "env_interactions": 20, "island_id": 6, "scores": {"3": 0.2}}
