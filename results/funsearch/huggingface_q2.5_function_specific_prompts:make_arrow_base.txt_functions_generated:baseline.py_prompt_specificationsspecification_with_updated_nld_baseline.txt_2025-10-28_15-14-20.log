{"timestamp": "2025-10-28T23:14:03.700286", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  target_idx = cookbook.index[\"arrow\"]\n\n  # mutable copies for planning\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n  width, height, _ = grid.shape\n  actions = []\n\n  from collections import deque\n\n  def bfs(start, goals):\n      \"\"\"Shortest path of actions (0=DOWN,1=UP,2=LEFT,3=RIGHT) to any goal cell.\"\"\"\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          cur, path = q.popleft()\n          if cur in goals:\n              return path\n          x, y = cur\n          for dx, dy, act in ((0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)):\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              nxt = (nx, ny)\n              if nxt in visited:\n                  continue\n              # treat any occupied cell as blocked unless it is a goal\n              if np.any(grid[nx, ny, :]) and nxt not in goals:\n                  continue\n              visited.add(nxt)\n              q.append((nxt, path + [act]))\n      return None\n\n  def move_along(path):\n      \"\"\"Update simulated position according to a list of movement actions.\"\"\"\n      nonlocal pos\n      for a in path:\n          if a == 0:   # DOWN\n              pos = (pos[0], pos[1] + 1)\n          elif a == 1: # UP\n              pos = (pos[0], pos[1] - 1)\n          elif a == 2: # LEFT\n              pos = (pos[0] - 1, pos[1])\n          elif a == 3: # RIGHT\n              pos = (pos[0] + 1, pos[1])\n\n  def collect_primitive(kind_idx, amount):\n      \"\"\"Collect `amount` units of the primitive `kind_idx` from the grid.\"\"\"\n      nonlocal actions, grid, inventory, pos\n      while amount > 0:\n          # locate all cells that still contain the primitive\n          cells = [(x, y) for x in range(width) for y in range(height)\n                   if grid[x, y, kind_idx] > 0]\n          if not cells:\n              raise RuntimeError(\"Not enough primitive items on the map\")\n          # find a reachable cell\n          path = None\n          target = None\n          for cell in cells:\n              p = bfs(pos, {cell})\n              if p is not None:\n                  path, target = p, cell\n                  break\n          if path is None:\n              raise RuntimeError(\"Primitive is unreachable\")\n          actions.extend(path)\n          move_along(path)\n          actions.append(4)  # USE to pick up\n          grid[target[0], target[1], kind_idx] = 0\n          inventory[kind_idx] += 1\n          amount -= 1\n\n  recipes = cookbook.recipes\n  primitives_set = cookbook.primitives\n\n  def ensure_item(item_idx, needed):\n      \"\"\"Make sure inventory[item_idx] >= needed by collecting/crafting.\"\"\"\n      nonlocal actions, grid, inventory, pos\n      while inventory[item_idx] < needed:\n          if item_idx in primitives_set:\n              collect_primitive(item_idx, needed - inventory[item_idx])\n              continue\n\n          recipe = recipes.get(item_idx, {})\n          # first satisfy ingredient requirements\n          for ing_idx, cnt in list(recipe.items()):\n              if ing_idx == \"_at\":\n                  continue\n              if inventory[ing_idx] < cnt:\n                  ensure_item(ing_idx, cnt)\n\n          # move to required workshop, if any\n          workshop = recipe.get(\"_at\")\n          if workshop is not None:\n              ws_idx = workshop if isinstance(workshop, int) else cookbook.index[workshop]\n              ws_cells = [(x, y) for x in range(width) for y in range(height)\n                          if grid[x, y, ws_idx] > 0]\n              if ws_cells:\n                  p = bfs(pos, {ws_cells[0]})\n                  if p is not None:\n                      actions.extend(p)\n                      move_along(p)\n\n          # perform crafting action\n          actions.append(4)  # USE\n          for ing_idx, cnt in recipe.items():\n              if ing_idx == \"_at\":\n                  continue\n              inventory[ing_idx] -= cnt\n          inventory[item_idx] += 1\n\n  ensure_item(target_idx, 1)\n\n  return actions", "env_interactions": 41, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T23:14:04.872298", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  # target item index (arrow)\n  target_idx = cookbook.index[\"arrow\"]\n\n  # mutable copies of the world state for planning\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n  width, height, _ = grid.shape\n  actions = []\n\n  from collections import deque\n\n  def bfs(start, goals):\n      \"\"\"Shortest path (as list of actions) from start to any cell in goals.\n      Cells containing any entity are treated as obstacles unless they are a goal.\"\"\"\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          cur, path = q.popleft()\n          if cur in goals:\n              return path\n          x, y = cur\n          for dx, dy, act in ((0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)):\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              nxt = (nx, ny)\n              if nxt in visited:\n                  continue\n              # blocked if any kind occupies the cell and it's not a goal\n              if np.any(grid[nx, ny, :]) and nxt not in goals:\n                  continue\n              visited.add(nxt)\n              q.append((nxt, path + [act]))\n      return None\n\n  def move_along(path):\n      \"\"\"Update simulated position according to a list of movement actions.\"\"\"\n      nonlocal pos\n      for a in path:\n          if a == 0:   # DOWN\n              pos = (pos[0], pos[1] + 1)\n          elif a == 1: # UP\n              pos = (pos[0], pos[1] - 1)\n          elif a == 2: # LEFT\n              pos = (pos[0] - 1, pos[1])\n          elif a == 3: # RIGHT\n              pos = (pos[0] + 1, pos[1])\n\n  def collect_primitive(kind_idx, needed):\n      \"\"\"Collect `needed` units of primitive `kind_idx` from the grid.\"\"\"\n      nonlocal actions, grid, inventory, pos\n      while needed > 0:\n          # locate all cells still containing the primitive\n          locations = [(x, y) for x in range(width) for y in range(height)\n                       if grid[x, y, kind_idx] > 0]\n          if not locations:\n              raise RuntimeError(f\"Not enough primitive {kind_idx} on the map\")\n          # find the first reachable location (could be improved to nearest)\n          chosen_path = None\n          chosen_loc = None\n          for loc in locations:\n              p = bfs(pos, {loc})\n              if p is not None:\n                  chosen_path, chosen_loc = p, loc\n                  break\n          if chosen_path is None:\n              raise RuntimeError(\"Primitive unreachable\")\n          actions.extend(chosen_path)\n          move_along(chosen_path)\n          actions.append(4)  # USE to pick up\n          grid[chosen_loc[0], chosen_loc[1], kind_idx] = 0\n          inventory[kind_idx] += 1\n          needed -= 1\n\n  recipes = cookbook.recipes\n  primitives_set = cookbook.primitives\n\n  def ensure_item(item_idx, amount):\n      \"\"\"Make sure inventory[item_idx] >= amount by collecting/crafting as needed.\"\"\"\n      nonlocal actions, grid, inventory, pos\n      while inventory[item_idx] < amount:\n          if item_idx in primitives_set:\n              # primitive: just collect the missing amount\n              collect_primitive(item_idx, amount - inventory[item_idx])\n              continue\n\n          recipe = recipes.get(item_idx, {})\n          # first, obtain all required ingredients\n          for ing_idx, cnt in list(recipe.items()):\n              if ing_idx == \"_at\":\n                  continue\n              if inventory[ing_idx] < cnt:\n                  ensure_item(ing_idx, cnt)\n\n          # move to the required workshop, if any\n          workshop = recipe.get(\"_at\")\n          if workshop is not None:\n              ws_idx = workshop if isinstance(workshop, int) else cookbook.index[workshop]\n              ws_cells = [(x, y) for x in range(width) for y in range(height)\n                          if grid[x, y, ws_idx] > 0]\n              if not ws_cells:\n                  raise RuntimeError(\"Required workshop missing from the map\")\n              path_to_ws = bfs(pos, {ws_cells[0]})\n              if path_to_ws is None:\n                  raise RuntimeError(\"Workshop unreachable\")\n              actions.extend(path_to_ws)\n              move_along(path_to_ws)\n\n          # perform the crafting action\n          actions.append(4)  # USE\n          for ing_idx, cnt in recipe.items():\n              if ing_idx == \"_at\":\n                  continue\n              inventory[ing_idx] -= cnt\n          inventory[item_idx] += 1\n\n  # Build the target arrow\n  ensure_item(target_idx, 1)\n\n  return actions", "env_interactions": 41, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T23:14:33.229020", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = set()\n  frontier = deque([Node(init_state, [])])\n  visited.add(_state_hash(init_state))\n\n  MAX_PLAN_LENGTH = 2000\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      if len(node.actions) >= MAX_PLAN_LENGTH:\n          continue\n\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          h = _state_hash(next_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(next_state, node.actions + [a]))\n\n  return []", "env_interactions": 20, "island_id": 2, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:14:49.159602", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state for the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = set()\n  frontier = deque([Node(init_state, [])])\n  visited.add(_state_hash(init_state))\n\n  # Upper bound on plan length \u2013 large enough for most maps but prevents runaway search\n  MAX_PLAN_LEN = 3000\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: arrow present in inventory?\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long trajectories\n      if len(node.actions) >= MAX_PLAN_LEN:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within the limits\n  return []", "env_interactions": 20, "island_id": 2, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:15:14.761702", "function_name": "make_arrow", "function_body": "  # Constants for actions\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  # Mapping from movement actions to coordinate changes (x=row, y=col)\n  MOVE_DELTAS = {\n      DOWN: (1, 0),\n      UP: (-1, 0),\n      LEFT: (0, -1),\n      RIGHT: (0, 1),\n  }\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of movement actions moving the agent\n  # from `start` to a cell adjacent (Manhattan distance 1) to any of the\n  # `targets`. Cells occupied by any entity are treated as blocked.\n  # ------------------------------------------------------------------\n  def _bfs_path(start, targets):\n      width, height, _ = grid.shape\n      occupied = np.any(grid > 0, axis=2)          # True where any kind is present\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # Check adjacency to any target\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n          # Explore neighbours\n          for act, (dx, dy) in MOVE_DELTAS.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:        # can step only on empty cells\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # No path found \u2013 return empty list (will likely fail later)\n      return []\n\n  # ------------------------------------------------------------------\n  # Retrieve world and cookbook information\n  # ------------------------------------------------------------------\n  # `env` may be a CraftLab wrapper; the underlying world is stored in\n  # `env.world` or inside the current state.\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Try to fetch from the hidden current state\n      state_candidate = getattr(env, \"_current_state\", None)\n      if state_candidate is not None:\n          world = getattr(state_candidate, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"Could not locate CraftWorld instance in the environment.\")\n\n  cookbook = world.cookbook\n\n  # ------------------------------------------------------------------\n  # Goal: make an arrow\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # Determine primitive requirements for a single arrow\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Ensure we have a fresh state (reset if necessary)\n  # ------------------------------------------------------------------\n  if not hasattr(env, \"_current_state\") or env._current_state is None:\n      # Reset returns an observation dict; the state is stored internally\n      env.reset()\n  state = env._current_state\n\n  pos = tuple(state.pos)          # (x, y) current position\n  grid = state.grid                # (W, H, n_kinds)\n\n  actions = []                     # final action sequence\n  harvested = set()                # primitive cells already collected\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first)\n  # ------------------------------------------------------------------\n  for prim_idx, needed_qty in primitives_needed.items():\n      # Locate all cells currently containing this primitive\n      locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # Sort by Manhattan distance from current position\n      locations.sort(key=lambda loc: abs(loc[0] - pos[0]) + abs(loc[1] - pos[1]))\n      collected = 0\n      for loc in locations:\n          if collected >= needed_qty:\n              break\n          if loc in harvested:\n              continue\n          # Move adjacent to the primitive location\n          path = _bfs_path(pos, [loc])\n          actions.extend(path)\n          # Update agent position according to the path taken\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n          # Use action to pick up the primitive (assumes facing the target)\n          actions.append(USE)\n          harvested.add(loc)\n          collected += 1\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at the appropriate workshop (if required)\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (could be name or already int)\n      if isinstance(workshop_key, str):\n          workshop_idx = cookbook.index[workshop_key]\n      else:\n          workshop_idx = workshop_key\n      # Find all workshop cells of the required type\n      workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if workshop_cells:\n          # Choose the nearest workshop\n          workshop_cells.sort(key=lambda w: abs(w[0] - pos[0]) + abs(w[1] - pos[1]))\n          target_ws = workshop_cells[0]\n          # Move adjacent to the workshop\n          path = _bfs_path(pos, [target_ws])\n          actions.extend(path)\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n          # Use action to craft at the workshop\n          actions.append(USE)\n\n  # Return the compiled list of action indices\n  return actions", "env_interactions": 21, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T23:15:15.913770", "function_name": "make_arrow", "function_body": "  # Action constants\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ----------------------------------------------------------------------\n  # Helper: 4\u2011connected BFS that avoids any occupied cell.\n  # Returns a list of actions moving from `start` to a position adjacent to\n  # any cell in `targets`.  If `start` is already adjacent, returns [].\n  # ----------------------------------------------------------------------\n  def _bfs_to_adjacent(start, targets):\n      w, h, _ = grid.shape\n      occupied = np.any(grid > 0, axis=2)          # True where something blocks movement\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # Check adjacency (Manhattan distance 1)\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n              if (x, y) == (tx, ty):\n                  return path\n\n          for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # No reachable adjacency \u2013 return empty list (caller may handle)\n      return []\n\n  # ----------------------------------------------------------------------\n  # Retrieve world and cookbook information\n  # ----------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Some wrappers expose the world via the current state\n      state_obj = getattr(env, \"_current_state\", None)\n      if state_obj is not None:\n          world = state_obj.world\n  if world is None:\n      raise RuntimeError(\"Cannot locate CraftWorld instance inside env.\")\n  cookbook = world.cookbook\n\n  # ----------------------------------------------------------------------\n  # Goal: hard\u2011coded to the primitive name \"arrow\"\n  # ----------------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # Primitive counts needed for a single arrow\n  primitives_needed = cookbook.primitives_for(goal_idx)   # dict {kind_idx: count}\n\n  # ----------------------------------------------------------------------\n  # Ensure we have a fresh state; reset if necessary\n  # ----------------------------------------------------------------------\n  if not hasattr(env, \"_current_state\") or env._current_state is None:\n      env.reset()\n  state = env._current_state\n\n  pos = tuple(state.pos)          # (x, y)\n  grid = state.grid                # (W, H, n_kinds)\n\n  actions = []                     # final action list\n  harvested = set()                # cells already used for collection\n\n  # ----------------------------------------------------------------------\n  # Collect required primitives (greedy nearest\u2011first)\n  # ----------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      # Locate all cells currently holding this primitive\n      locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # Sort by Manhattan distance from current position\n      locations.sort(key=lambda loc: abs(loc[0] - pos[0]) + abs(loc[1] - pos[1]))\n      gathered = 0\n      for loc in locations:\n          if gathered >= needed:\n              break\n          if loc in harvested:\n              continue\n          # Move adjacent to the primitive location\n          path = _bfs_to_adjacent(pos, [loc])\n          actions.extend(path)\n          # Update internal position tracking\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Perform USE to pick up the primitive (must be facing it)\n          actions.append(USE)\n          harvested.add(loc)\n          gathered += 1\n\n  # ----------------------------------------------------------------------\n  # Craft the target at its required workshop (if any)\n  # ----------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (name \u2192 int) if needed\n      workshop_idx = (\n          cookbook.index[workshop_key]\n          if isinstance(workshop_key, str) else workshop_key\n      )\n      # Find all workshop cells of this type\n      workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if workshop_cells:\n          # Choose the nearest workshop\n          workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = workshop_cells[0]\n          # Move adjacent to the workshop\n          path = _bfs_to_adjacent(pos, [target_ws])\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Use to craft\n          actions.append(USE)\n\n  return actions", "env_interactions": 21, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T23:15:38.883046", "function_name": "make_arrow", "function_body": "  # Action identifiers \u2013 must match CraftWorld ordering.\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  MOVE_DELTAS = {DOWN: (0, 1), UP: (0, -1), LEFT: (-1, 0), RIGHT: (1, 0)}\n\n  # ------------------------------------------------------------------\n  # Helper: BFS returning a list of actions that brings the agent from\n  # `start` to a cell adjacent (Manhattan distance = 1) to any cell in\n  # `targets`.  Cells where any entity is present are treated as blocked.\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  def _bfs_adjacent(start, targets, occupied):\n      w, h = occupied.shape\n      target_set = set(targets)\n\n      # Already adjacent?\n      for tx, ty in target_set:\n          if abs(start[0] - tx) + abs(start[1] - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n\n      while q:\n          x, y, path = q.popleft()\n          for act, (dx, dy) in MOVE_DELTAS.items():\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < w and 0 <= ny < h):\n                  continue\n              if (nx, ny) in visited or occupied[nx, ny]:\n                  continue\n              new_path = path + [act]\n              # Check adjacency to any target\n              for tx, ty in target_set:\n                  if abs(nx - tx) + abs(ny - ty) == 1:\n                      return new_path\n              visited.add((nx, ny))\n              q.append((nx, ny, new_path))\n      return []  # unreachable\n\n  # ------------------------------------------------------------------\n  # Retrieve world, current state and cookbook from the environment.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # env is likely a CraftLab \u2013 state stored in _current_state.\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n      world = state.world\n  else:\n      # env is a CraftWorld / CraftScenario \u2013 ensure we have a state.\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n\n  cookbook = world.cookbook\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # ------------------------------------------------------------------\n  # Determine primitive resources needed for a single arrow.\n  # ------------------------------------------------------------------\n  primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n  if not primitives_needed:\n      # Arrow itself is a primitive \u2013 just use the current cell.\n      return [USE]\n\n  # ------------------------------------------------------------------\n  # Current grid, agent position and occupancy mask.\n  # ------------------------------------------------------------------\n  grid = state.grid                     # (W, H, n_kinds)\n  pos = tuple(state.pos)                # (x, y)\n  occupied = np.any(grid > 0, axis=2)   # True where any entity exists\n\n  actions = []\n  harvested = set()                     # locations already collected from\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first).\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      gathered = 0\n      while gathered < needed_cnt:\n          # Find all remaining instances of this primitive.\n          prim_locs = [\n              tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)\n              if tuple(p) not in harvested\n          ]\n          if not prim_locs:\n              # No more of this primitive on the map \u2013 abort early.\n              break\n\n          # Choose the closest primitive (Manhattan distance).\n          prim_locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target = prim_locs[0]\n\n          # Plan path to a cell adjacent to the primitive.\n          path = _bfs_adjacent(pos, [target], occupied)\n          actions.extend(path)\n\n          # Simulate movement.\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Pick up the primitive.\n          actions.append(USE)\n          harvested.add(target)\n          gathered += 1\n\n          # Update occupancy (the primitive cell becomes empty).\n          occupied[target] = False\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (may be a name string).\n      workshop_idx = (\n          cookbook.index[workshop_key]\n          if isinstance(workshop_key, str) else workshop_key\n      )\n      # Locate workshop cells of the required type.\n      workshop_cells = [\n          tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)\n      ]\n      if workshop_cells:\n          # Move to the nearest workshop.\n          workshop_cells.sort(\n              key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1])\n          )\n          ws_target = workshop_cells[0]\n          path = _bfs_adjacent(pos, [ws_target], occupied)\n          actions.extend(path)\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(USE)  # craft at workshop\n      else:\n          # No workshop found \u2013 fall back to using current cell.\n          actions.append(USE)\n  else:\n      # No specific workshop required.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T23:15:40.074770", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ------------------------------------------------------------------\n  # Action identifiers \u2013 must match CraftWorld ordering.\n  # ------------------------------------------------------------------\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  MOVE_DELTAS = {DOWN: (0, 1), UP: (0, -1), LEFT: (-1, 0), RIGHT: (1, 0)}\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving the agent from\n  # `start` to a cell *adjacent* (Manhattan distance = 1) to any cell\n  # in `targets`.  Cells where any entity is present are treated as blocked.\n  # ------------------------------------------------------------------\n  def _bfs_adjacent(start, targets, occupied):\n      w, h = occupied.shape\n      target_set = set(targets)\n\n      # Already adjacent?\n      for tx, ty in target_set:\n          if abs(start[0] - tx) + abs(start[1] - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      while q:\n          x, y, path = q.popleft()\n          for act, (dx, dy) in MOVE_DELTAS.items():\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < w and 0 <= ny < h):\n                  continue\n              if (nx, ny) in visited or occupied[nx, ny]:\n                  continue\n              new_path = path + [act]\n              # Check adjacency to any target\n              for tx, ty in target_set:\n                  if abs(nx - tx) + abs(ny - ty) == 1:\n                      return new_path\n              visited.add((nx, ny))\n              q.append((nx, ny, new_path))\n      return []  # unreachable\n\n  # ------------------------------------------------------------------\n  # Retrieve world, current state and cookbook from the environment.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # env is likely a CraftLab \u2013 state stored in _current_state.\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n      world = state.world\n  else:\n      # env is a CraftWorld / CraftScenario \u2013 ensure we have a state.\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n\n  cookbook = world.cookbook\n  goal_idx = cookbook.index[\"arrow\"]\n\n  # ------------------------------------------------------------------\n  # Determine primitive resources needed for a single arrow.\n  # ------------------------------------------------------------------\n  primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n  if not primitives_needed:\n      # Arrow itself is primitive \u2013 just use the current cell.\n      return [USE]\n\n  # ------------------------------------------------------------------\n  # Current grid, agent position and occupancy mask.\n  # ------------------------------------------------------------------\n  grid = state.grid                     # (W, H, n_kinds)\n  pos = tuple(state.pos)                # (x, y)\n  occupied = np.any(grid > 0, axis=2)   # True where any entity exists\n\n  actions = []\n  harvested = set()                     # cells already collected from\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first).\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      gathered = 0\n      while gathered < needed_cnt:\n          # Locate all cells containing this primitive and not yet harvested.\n          cells = [\n              tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)\n              if tuple(p) not in harvested\n          ]\n          if not cells:\n              # No more of this primitive available \u2013 abort early.\n              break\n\n          # Choose the closest cell (Manhattan distance).\n          cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          target = cells[0]\n\n          # Plan a path to a cell adjacent to the target.\n          path = _bfs_adjacent(pos, [target], occupied)\n          actions.extend(path)\n\n          # Simulate movement to keep `pos` up\u2011to\u2011date.\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Pick up the primitive.\n          actions.append(USE)\n          harvested.add(target)\n          gathered += 1\n\n          # Update occupancy mask \u2013 the cell becomes empty after pickup.\n          occupied[target] = False\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any) and finish.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (string name or already an int).\n      workshop_idx = (\n          cookbook.index[workshop_key] if isinstance(workshop_key, str) else workshop_key\n      )\n      ws_cells = [\n          tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)\n      ]\n      if ws_cells:\n          # Choose nearest workshop.\n          ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          ws_target = ws_cells[0]\n          path = _bfs_adjacent(pos, [ws_target], occupied)\n          actions.extend(path)\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(USE)  # craft at workshop\n      else:\n          # No visible workshop \u2013 attempt to craft at current location.\n          actions.append(USE)\n  else:\n      # No specific workshop required \u2013 craft wherever we are.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T23:16:11.486667", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Helper: obtain the underlying scenario and world objects\n  # ----------------------------------------------------------------------\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # ----------------------------------------------------------------------\n  # Identify the numeric index of the target item \"arrow\"\n  # ----------------------------------------------------------------------\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:          # recipe might not contain an arrow\n      return []\n\n  # ----------------------------------------------------------------------\n  # Initialise the start state (CraftState) from the scenario\n  # ----------------------------------------------------------------------\n  try:\n      start_state = scenario.init()\n  except Exception:\n      return []\n\n  # ----------------------------------------------------------------------\n  # BFS over (state, action_sequence) pairs\n  # ----------------------------------------------------------------------\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _hash_state(st):\n      \"\"\"Create a compact, hash\u2011able representation of a CraftState.\"\"\"\n      # Position + direction + inventory tuple + immutable grid bytes\n      return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())\n\n  visited = {_hash_state(start_state)}\n  frontier = deque([Node(start_state, [])])\n\n  # safety limits \u2013 avoid infinite search in pathological maps\n  MAX_STEPS = 2000\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      cur_node = frontier.popleft()\n      cur_state = cur_node.state\n\n      # Goal test: do we already have an arrow?\n      if cur_state.satisfies(\"\", target_idx):\n          return cur_node.actions\n\n      # Depth limit\n      if len(cur_node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible primitive actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _hash_state(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, cur_node.actions + [a]))\n\n  # No plan found within the allowed budget\n  return []", "env_interactions": 20, "island_id": 2, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:16:12.631478", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # make_arrow_vn: A* planner that uses recipe information as a heuristic.\n  # Returns a list of action indices that achieve at least one \"arrow\".\n  # ----------------------------------------------------------------------\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # target item index\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # initial state\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  import heapq\n  from collections import namedtuple\n\n  Node = namedtuple(\"Node\", [\"g\", \"f\", \"state\", \"actions\"])\n\n  def _state_hash(st):\n      \"\"\"Hashable representation of a CraftState.\"\"\"\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  # heuristic: number of missing primitive units required for the goal\n  # (simple admissible heuristic)\n  primitive_requirements = world.cookbook.primitives_for(target_idx)\n\n  def _heuristic(st):\n      if st.inventory[target_idx] > 0:\n          return 0\n      missing = 0\n      inv = st.inventory\n      for prim_idx, need_cnt in primitive_requirements.items():\n          have = inv[prim_idx] if prim_idx < len(inv) else 0\n          if have < need_cnt:\n              missing += need_cnt - have\n      return missing\n\n  start_h = _heuristic(init_state)\n  start_node = Node(g=0, f=start_h, state=init_state, actions=[])\n  frontier = [(start_node.f, start_node)]  # heap of (priority, node)\n  visited = {_state_hash(init_state)}\n\n  MAX_PLAN_LEN = 2500\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      _, node = heapq.heappop(frontier)\n      cur_state = node.state\n\n      # Goal test\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Length pruning\n      if node.g >= MAX_PLAN_LEN:\n          continue\n\n      # Expand successors\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          hsh = _state_hash(nxt_state)\n          if hsh in visited:\n              continue\n          visited.add(hsh)\n          g_next = node.g + 1\n          h_next = _heuristic(nxt_state)\n          f_next = g_next + h_next\n          heapq.heappush(frontier, (f_next, Node(g=g_next, f=f_next,\n                                                 state=nxt_state,\n                                                 actions=node.actions + [a])))\n\n  # No plan found within limits\n  return []", "env_interactions": 0, "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-10-28T23:16:36.689218", "function_name": "make_arrow", "function_body": "  # Resolve scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state for planning\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_key(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      # Position, direction, inventory (as bytes), and grid (as bytes)\n      return (\n          st.pos,\n          st.dir,\n          st.inventory.tobytes(),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_key(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_PLAN_LEN = 500                     # safety bound on search depth\n  n_actions = getattr(world, \"n_actions\", 5)   # default: 4 moves + USE\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long trajectories\n      if len(node.actions) >= MAX_PLAN_LEN:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          key = _state_key(nxt_state)\n          if key not in visited:\n              visited.add(key)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No feasible plan found within limits\n  return []", "env_interactions": 20, "island_id": 1, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:16:52.383636", "function_name": "make_arrow", "function_body": "  # Retrieve scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item (\"arrow\") in the recipe book\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_key(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_key(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_PLAN_LEN = 400                       # safety bound on plan length\n  n_actions = getattr(world, \"n_actions\", 5)  # default: 4 moves + USE\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long trajectories\n      if len(node.actions) >= MAX_PLAN_LEN:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key not in visited:\n              visited.add(key)\n              frontier.append(Node(next_state, node.actions + [a]))\n\n  # No feasible plan found within the search budget\n  return []", "env_interactions": 20, "island_id": 1, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:17:18.155167", "function_name": "make_arrow", "function_body": "  # Resolve scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Target item index\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  # BFS search\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _hash_state(st):\n      # Position, direction, inventory, and grid layout form a unique hash\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = set()\n  frontier = deque([Node(init_state, [])])\n  visited.add(_hash_state(init_state))\n\n  max_steps = 300  # safety cap\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state, cur_actions = node.state, node.actions\n\n      # Goal test\n      if cur_state.satisfies(\"\", target_idx):\n          return cur_actions\n\n      if len(cur_actions) >= max_steps:\n          continue\n\n      # Expand neighbours\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _hash_state(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, cur_actions + [a]))\n\n  # No plan found within limits\n  return []", "env_interactions": 20, "island_id": 3, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:17:33.895210", "function_name": "make_arrow", "function_body": "  # Retrieve scenario and world objects (handle possible wrappers)\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initialise the starting state\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  # Bread\u2011first search for a sequence of actions that yields the target\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_key(st):\n      # Combine position, direction, inventory and grid layout into a hashable key\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_key(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 300                     # depth limit to keep search tractable\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state, cur_actions = node.state, node.actions\n\n      # Goal test: does inventory contain at least one arrow?\n      if cur_state.satisfies(\"\", target_idx):\n          return cur_actions\n\n      if len(cur_actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key not in visited:\n              visited.add(key)\n              frontier.append(Node(next_state, cur_actions + [a]))\n\n  # No plan found within the depth limit\n  return []", "env_interactions": 20, "island_id": 3, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:18:13.778719", "function_name": "make_arrow", "function_body": "  import collections\n  import numpy as np\n\n  # Action indices (as defined in the environment)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving the agent from `start`\n  # to a cell adjacent (Manhattan distance \u2264 1) to any cell in `targets`.\n  # `blocked` is a boolean mask where True means the cell cannot be entered.\n  # ----------------------------------------------------------------------\n  def _bfs_path(start, targets, blocked):\n      w, h = blocked.shape\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # Stop if we are adjacent (or on) any target cell.\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) <= 1:\n                  return path\n          # Expand 4\u2011connected neighbours.\n          for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not blocked[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # No reachable position \u2013 return empty list (will cause failure later).\n      return []\n\n  # ----------------------------------------------------------------------\n  # Locate the underlying CraftWorld instance.\n  # ----------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Some wrappers keep the world inside the current state.\n      state_tmp = getattr(env, \"_current_state\", None)\n      if state_tmp is not None:\n          world = getattr(state_tmp, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"Cannot locate CraftWorld instance in the environment.\")\n\n  cookbook = world.cookbook\n\n  # ----------------------------------------------------------------------\n  # Goal is fixed to the item named \"arrow\".\n  # ----------------------------------------------------------------------\n  if \"arrow\" not in cookbook.index.contents:\n      raise ValueError(\"Goal item 'arrow' not defined in the recipe file.\")\n  goal_idx = cookbook.index[\"arrow\"]\n  primitive_requirements = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ----------------------------------------------------------------------\n  # Ensure we have a current state (reset if necessary).\n  # ----------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      if hasattr(env, \"reset\"):\n          env.reset()\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          raise RuntimeError(\"Environment does not expose a current state after reset.\")\n\n  pos = tuple(state.pos)                # (x, y)\n  grid = state.grid.copy()              # mutable copy of the world grid\n  blocked = np.any(grid > 0, axis=2)    # True = occupied / non\u2011walkable\n\n  actions = []\n  harvested = set()                     # cells already used for collection\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive, nearest\u2011first.\n  # ----------------------------------------------------------------------\n  for prim_idx, needed in primitive_requirements.items():\n      # All cells currently holding this primitive.\n      locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # Sort by Manhattan distance from current position.\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      collected = 0\n      for loc in locations:\n          if collected >= needed:\n              break\n          if loc in harvested:\n              continue\n          # Move adjacent to the primitive cell.\n          path = _bfs_path(pos, [loc], blocked)\n          actions.extend(path)\n          # Update internal position.\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Pick up the primitive.\n          actions.append(USE)\n          # Mark the cell as empty for future navigation.\n          grid[loc[0], loc[1], prim_idx] = 0\n          blocked[loc[0], loc[1]] = False\n          harvested.add(loc)\n          collected += 1\n\n  # ----------------------------------------------------------------------\n  # Craft the arrow at its designated workshop (if any).\n  # ----------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (string name or int).\n      workshop_idx = (cookbook.index[workshop_key]\n                      if isinstance(workshop_key, str)\n                      else int(workshop_key))\n      # Locate workshop cells currently present.\n      workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if workshop_cells:\n          # Choose nearest workshop.\n          workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = workshop_cells[0]\n          path = _bfs_path(pos, [target_ws], blocked)\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          actions.append(USE)\n      else:\n          # No visible workshop \u2013 just use at current location.\n          actions.append(USE)\n  else:\n      # No specific workshop required.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T23:18:14.940230", "function_name": "make_arrow", "function_body": "  # Action indices\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: BFS returning a list of actions that moves the agent from\n  # `start` to a cell adjacent (Manhattan distance == 1) to any cell in\n  # `targets`. `occupied` is a boolean mask where True means the cell\n  # cannot be entered.\n  # ------------------------------------------------------------------\n  def _bfs_path(start, targets, occupied):\n      w, h = occupied.shape\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # Stop if we are adjacent to any target cell.\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n          # Expand neighbours.\n          for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # No reachable position.\n      return []\n\n  # ------------------------------------------------------------------\n  # Locate the underlying CraftWorld instance.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      state_tmp = getattr(env, \"_current_state\", None)\n      if state_tmp is not None:\n          world = getattr(state_tmp, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"Cannot locate CraftWorld instance in the environment.\")\n\n  cookbook = world.cookbook\n\n  # ------------------------------------------------------------------\n  # Goal is the item named \"arrow\".\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  if goal_name not in cookbook.index.contents:\n      raise ValueError(f\"Goal item '{goal_name}' not defined in the recipe file.\")\n  goal_idx = cookbook.index[goal_name]\n  primitive_requirements = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Ensure we have a current state (reset if necessary).\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      if hasattr(env, \"reset\"):\n          env.reset()\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          raise RuntimeError(\"Environment does not expose a current state after reset.\")\n\n  pos = tuple(state.pos)                # (x, y)\n  grid = state.grid.copy()              # mutable copy of the world grid\n  occupied = np.any(grid > 0, axis=2)   # True = blocked cell\n\n  actions = []\n  harvested = set()                     # cells already used for collection\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first).\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitive_requirements.items():\n      locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      collected = 0\n      for loc in locations:\n          if collected >= needed:\n              break\n          if loc in harvested:\n              continue\n          path = _bfs_path(pos, [loc], occupied)\n          actions.extend(path)\n          # Update simulated position.\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Pick up the primitive.\n          actions.append(USE)\n          # Mark cell as empty for future navigation.\n          grid[loc[0], loc[1], prim_idx] = 0\n          occupied[loc[0], loc[1]] = False\n          harvested.add(loc)\n          collected += 1\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its designated workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      workshop_idx = (cookbook.index[workshop_key]\n                      if isinstance(workshop_key, str)\n                      else int(workshop_key))\n      workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if workshop_cells:\n          workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = workshop_cells[0]\n          path = _bfs_path(pos, [target_ws], occupied)\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          actions.append(USE)\n      else:\n          # No visible workshop; attempt to craft in place.\n          actions.append(USE)\n  else:\n      # No specific workshop required.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
