{"timestamp": "2025-10-23T03:33:03.320049", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n\n  # Action indices\n  act = env.action_specs()\n  DOWN = act[\"DOWN\"]\n  UP = act[\"UP\"]\n  LEFT = act[\"LEFT\"]\n  RIGHT = act[\"RIGHT\"]\n  USE = act[\"USE\"]\n\n  # Index of the primitive \u201cstick\u201d\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # Locate all cells that contain a stick\n  stick_cells = np.argwhere(state.grid[:, :, stick_idx] > 0)\n  if stick_cells.size == 0:\n      # No stick present \u2013 nothing to do\n      return []\n\n  # Breadth\u2011first search for the nearest reachable stick,\n  # avoiding non\u2011grabbable entities.\n  width, height = state.grid.shape[:2]\n  non_grabbable = world.non_grabbable_indices\n\n  def traversable(p):\n      x, y = p\n      if not (0 <= x < width and 0 <= y < height):\n          return False\n      for idx in non_grabbable:\n          if state.grid[x, y, idx] > 0:\n              return False\n      return True\n\n  start = tuple(state.pos)\n  target_set = {tuple(cell) for cell in stick_cells}\n  queue = collections.deque([start])\n  visited = {start: None}\n  goal = None\n\n  while queue:\n      cur = queue.popleft()\n      if cur in target_set:\n          goal = cur\n          break\n      x, y = cur\n      for nx, ny, act_code in [(x + 1, y, DOWN),\n                               (x - 1, y, UP),\n                               (x, y + 1, RIGHT),\n                               (x, y - 1, LEFT)]:\n          nxt = (nx, ny)\n          if nxt not in visited and traversable(nxt):\n              visited[nxt] = (cur, act_code)\n              queue.append(nxt)\n\n  if goal is None:\n      # No reachable stick found\n      return []\n\n  # Reconstruct the action sequence from start to the goal cell\n  actions = []\n  cur = goal\n  while visited[cur] is not None:\n      prev, act_code = visited[cur]\n      actions.append(act_code)\n      cur = prev\n  actions.reverse()\n\n  # Pick up the stick\n  actions.append(USE)\n  return actions", "env_interactions": 0, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:33:04.579828", "function_name": "make_arrow", "function_body": "  # --- setup -----------------------------------------------------------------\n  state = env._current_state\n  world = env.world\n  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act[\"DOWN\"], act[\"UP\"], act[\"LEFT\"], act[\"RIGHT\"], act[\"USE\"]\n  )\n  width, height = state.grid.shape[:2]\n  non_grabbable = world.non_grabbable_indices\n\n  # --- helper: BFS path -------------------------------------------------------\n  def bfs_path(start, target_set):\n      \"\"\"Return list of actions to reach any cell in target_set, or [] if none.\"\"\"\n      queue = collections.deque([start])\n      visited = {start: None}          # maps pos -> (prev_pos, action_to_here)\n      while queue:\n          cur = queue.popleft()\n          if cur in target_set:\n              # reconstruct actions\n              actions = []\n              while visited[cur] is not None:\n                  prev, a = visited[cur]\n                  actions.append(a)\n                  cur = prev\n              actions.reverse()\n              return actions\n          x, y = cur\n          for nx, ny, a in [(x + 1, y, DOWN), (x - 1, y, UP),\n                            (x, y + 1, RIGHT), (x, y - 1, LEFT)]:\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              # cell must be free of non\u2011grabbable entities\n              blocked = any(state.grid[nx, ny, idx] > 0 for idx in non_grabbable)\n              if blocked:\n                  continue\n              nxt = (nx, ny)\n              if nxt not in visited:\n                  visited[nxt] = (cur, a)\n                  queue.append(nxt)\n      return []   # no reachable target\n\n  # --- identify stick ---------------------------------------------------------\n  stick_idx = world.cookbook.index[\"stick\"]\n  is_primitive = stick_idx in world.cookbook.primitives\n\n  # -------------------------------------------------------------------------\n  # 1) Primitive stick: just go pick one up\n  # -------------------------------------------------------------------------\n  if is_primitive:\n      stick_cells = np.argwhere(state.grid[:, :, stick_idx] > 0)\n      if stick_cells.size == 0:\n          return []          # no stick on map\n      target_set = {tuple(cell) for cell in stick_cells}\n      actions = bfs_path(tuple(state.pos), target_set)\n      actions.append(USE)    # pick it up\n      return actions\n\n  # -------------------------------------------------------------------------\n  # 2) Crafted stick: follow its recipe\n  # -------------------------------------------------------------------------\n  recipe = world.cookbook.recipes[stick_idx]\n  workshop_idx = recipe[\"_at\"]\n  ingredients = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  actions_total = []\n\n  # ---- collect each ingredient (assume they are primitives or already present) ----\n  for ing_idx, needed in ingredients.items():\n      for _ in range(needed):\n          # locate any remaining cell containing this ingredient\n          cells = np.argwhere(state.grid[:, :, ing_idx] > 0)\n          if cells.size == 0:\n              return []      # missing ingredient on map\n          target_set = {tuple(cell) for cell in cells}\n          actions = bfs_path(tuple(state.pos), target_set)\n          actions_total.extend(actions)\n          actions_total.append(USE)   # pick up one unit\n          # update simulated position for subsequent searches\n          # (we mimic the effect of moving without actually stepping the env)\n          # compute new position after actions\n          cur = list(state.pos)\n          for a in actions:\n              if a == DOWN:   cur[0] += 1\n              elif a == UP:   cur[0] -= 1\n              elif a == RIGHT:cur[1] += 1\n              elif a == LEFT: cur[1] -= 1\n          state.pos = tuple(cur)   # temporary update for path planning\n\n  # ---- move to a workshop that can craft the stick ----\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      return []          # no workshop on map\n  target_set = {tuple(cell) for cell in workshop_cells}\n  actions = bfs_path(tuple(state.pos), target_set)\n  actions_total.extend(actions)\n  actions_total.append(USE)   # craft the stick\n\n  return actions_total", "env_interactions": 0, "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-10-23T03:33:20.173868", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  goal_idx = env.task.goal\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # -----------------------------------------------------------------\n  # Helper utilities\n  # -----------------------------------------------------------------\n  def find_positions(kind):\n      \"\"\"Return list of (x, y) cells containing the given kind.\"\"\"\n      locs = np.argwhere(state.grid[:, :, kind] > 0)\n      return [tuple(p) for p in locs]\n\n  def nearest(pos, kind):\n      \"\"\"Manhattan\u2011closest cell of the requested kind.\"\"\"\n      positions = find_positions(kind)\n      if not positions:\n          return None\n      return min(positions, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n\n  def moves_to(src, dst):\n      \"\"\"Sequence of movement actions (DOWN=0, UP=1, LEFT=2, RIGHT=3)\n      that walks from src to dst using a simple Manhattan path.\"\"\"\n      sx, sy = src\n      dx, dy = dst\n      seq = []\n      while sx < dx:\n          seq.append(0)   # DOWN\n          sx += 1\n      while sx > dx:\n          seq.append(1)   # UP\n          sx -= 1\n      while sy < dy:\n          seq.append(3)   # RIGHT\n          sy += 1\n      while sy > dy:\n          seq.append(2)   # LEFT\n          sy -= 1\n      return seq\n\n  # -----------------------------------------------------------------\n  # 1) Primitive goal \u2013 just collect it.\n  # -----------------------------------------------------------------\n  if not env.world.cookbook.primitives_for(goal_idx):\n      target = nearest(cur_pos, goal_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)   # USE to pick up the primitive\n      return actions\n\n  # -----------------------------------------------------------------\n  # 2) Gather required primitive ingredients.\n  # -----------------------------------------------------------------\n  needed_prims = env.world.cookbook.primitives_for(goal_idx)\n  for prim_idx, count in needed_prims.items():\n      for _ in range(count):\n          target = nearest(cur_pos, prim_idx)\n          if target is None:\n              # Primitive not present \u2013 skip (will cause failure later)\n              continue\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n          actions.append(4)   # USE to pick up primitive\n\n  # -----------------------------------------------------------------\n  # 3) Move to workshop (if any) and craft the stick.\n  # -----------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  if isinstance(recipe, dict):\n      workshop_idx = recipe.get('_at')\n      if workshop_idx is None:\n          # Fallback: look for any string key that maps to a workshop index\n          for k, v in recipe.items():\n              if isinstance(k, str) and k != '_at':\n                  workshop_idx = v\n                  break\n\n  if workshop_idx is not None:\n      target = nearest(cur_pos, workshop_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)   # USE at workshop to craft the stick\n  else:\n      # No explicit workshop \u2013 attempt to craft at current location.\n      actions.append(4)\n\n  return actions", "env_interactions": 1, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:33:21.438544", "function_name": "make_arrow", "function_body": "  # Reset environment and fetch initial state\n  env.reset()\n  state = env._current_state\n  goal_idx = env.task.goal\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # -----------------------------------------------------------------\n  # Helper utilities\n  # -----------------------------------------------------------------\n  def find_positions(kind):\n      \"\"\"Return list of (x, y) cells containing the given kind.\"\"\"\n      locs = np.argwhere(state.grid[:, :, kind] > 0)\n      return [tuple(p) for p in locs]\n\n  def nearest(pos, kind):\n      \"\"\"Manhattan\u2011closest cell of the requested kind.\"\"\"\n      positions = find_positions(kind)\n      if not positions:\n          return None\n      return min(positions, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n\n  def moves_to(src, dst):\n      \"\"\"Sequence of movement actions (DOWN=0, UP=1, LEFT=2, RIGHT=3)\n      that walks from src to dst using a simple Manhattan path.\"\"\"\n      sx, sy = src\n      dx, dy = dst\n      seq = []\n      while sx < dx:\n          seq.append(0)   # DOWN\n          sx += 1\n      while sx > dx:\n          seq.append(1)   # UP\n          sx -= 1\n      while sy < dy:\n          seq.append(3)   # RIGHT\n          sy += 1\n      while sy > dy:\n          seq.append(2)   # LEFT\n          sy -= 1\n      return seq\n\n  # -----------------------------------------------------------------\n  # 1) Primitive goal \u2013 just collect it.\n  # -----------------------------------------------------------------\n  if not env.world.cookbook.primitives_for(goal_idx):\n      target = nearest(cur_pos, goal_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)   # USE to pick up the primitive\n      return actions\n\n  # -----------------------------------------------------------------\n  # 2) Gather required primitive ingredients.\n  # -----------------------------------------------------------------\n  needed_prims = env.world.cookbook.primitives_for(goal_idx)\n  for prim_idx, count in needed_prims.items():\n      for _ in range(count):\n          target = nearest(cur_pos, prim_idx)\n          if target is None:\n              # Primitive not present \u2013 skip (will cause failure later if impossible)\n              continue\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n          actions.append(4)   # USE to pick up the primitive\n\n  # -----------------------------------------------------------------\n  # 3) Move to workshop (if any) and craft the stick.\n  # -----------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  if isinstance(recipe, dict):\n      workshop_idx = recipe.get('_at')\n      if workshop_idx is None:\n          # Fallback: look for any string key that maps to a workshop index\n          for k, v in recipe.items():\n              if isinstance(k, str) and k != '_at':\n                  workshop_idx = v\n                  break\n\n  if workshop_idx is not None:\n      target = nearest(cur_pos, workshop_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)   # USE at workshop to craft the stick\n  else:\n      # No explicit workshop \u2013 attempt to craft at current location.\n      actions.append(4)\n\n  return actions", "env_interactions": 1, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:33:52.693026", "function_name": "make_arrow", "function_body": "  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act.get(\"DOWN\", 0),\n      act.get(\"UP\", 1),\n      act.get(\"LEFT\", 2),\n      act.get(\"RIGHT\", 3),\n      act.get(\"USE\", 4),\n  )\n\n  # current state snapshot\n  state = env._current_state\n  grid = state.grid.copy()                     # (W, H, n_kinds)\n  cur_pos = tuple(state.pos)                   # (x, y)\n\n  # locate the index for \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n      if stick_idx is None:\n          return []   # stick not present in index\n\n  # obtain recipe: primitive requirements and optional workshop\n  recipe = env.world.cookbook.primitives_for(stick_idx)   # dict {kind_idx: count}\n  primitive_needs = {k: v for k, v in recipe.items() if isinstance(k, int)}\n  workshop_idx = None\n  for k, v in recipe.items():\n      if not isinstance(k, int):\n          workshop_idx = v if isinstance(v, int) else None\n          break\n\n  # if stick itself is a primitive (no recipe), we need to pick it up directly\n  if not primitive_needs:\n      primitive_needs = {stick_idx: 1}\n      workshop_idx = None\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # helper: locate nearest cell that contains at least one of the given kind\n  def find_closest(kind_idx, cur):\n      positions = np.argwhere(grid[:, :, kind_idx] > 0)\n      if positions.shape[0] == 0:\n          return None\n      dists = np.sum(np.abs(positions - np.array(cur)), axis=1)\n      nearest = positions[np.argmin(dists)]\n      return tuple(nearest.tolist())\n\n  # helper: greedy Manhattan path from cur to target (returns actions + final pos)\n  def path_to(cur, target):\n      x, y = cur\n      tx, ty = target\n      path = []\n      while (x, y) != (tx, ty):\n          if x < tx:\n              path.append(RIGHT)\n              x += 1\n          elif x > tx:\n              path.append(LEFT)\n              x -= 1\n          elif y < ty:\n              path.append(DOWN)\n              y += 1\n          elif y > ty:\n              path.append(UP)\n              y -= 1\n      return path, (x, y)\n  # ------------------------------------------------------------------\n\n  # collect each required primitive (or the stick itself if primitive)\n  for kind_idx, needed in primitive_needs.items():\n      while needed > 0:\n          target = find_closest(kind_idx, cur_pos)\n          if target is None:\n              # required item not present \u2013 abort planning\n              return actions\n          move_actions, cur_pos = path_to(cur_pos, target)\n          actions.extend(move_actions)\n          actions.append(USE)   # pick up the item\n          # update local grid copy to reflect consumption\n          grid[target[0], target[1], kind_idx] = max(\n              0, grid[target[0], target[1], kind_idx] - 1\n          )\n          needed -= 1\n\n  # if crafting requires a workshop, go there and use it\n  if workshop_idx is not None:\n      ws_target = find_closest(workshop_idx, cur_pos)\n      if ws_target is not None:\n          move_actions, cur_pos = path_to(cur_pos, ws_target)\n          actions.extend(move_actions)\n          actions.append(USE)   # craft at the workshop\n\n  return actions", "env_interactions": 2, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:33:54.027548", "function_name": "make_arrow", "function_body": "  # Retrieve action indices\n  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act.get(\"DOWN\", 0),\n      act.get(\"UP\", 1),\n      act.get(\"LEFT\", 2),\n      act.get(\"RIGHT\", 3),\n      act.get(\"USE\", 4),\n  )\n\n  # Snapshot of the current state\n  state = env._current_state\n  grid = state.grid.copy()                     # (W, H, n_kinds)\n  cur_pos = tuple(state.pos)                   # (x, y)\n\n  # Locate the index for \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n      if stick_idx is None:\n          return []   # stick not present in index\n\n  # Obtain the recipe: primitive requirements and optional workshop\n  recipe = env.world.cookbook.primitives_for(stick_idx)   # dict {kind_idx: count}\n  primitive_needs = {k: v for k, v in recipe.items() if isinstance(k, int)}\n  workshop_idx = None\n  for k, v in recipe.items():\n      if not isinstance(k, int):\n          workshop_idx = v if isinstance(v, int) else None\n          break\n\n  actions = []\n\n  # Helper: locate nearest cell containing at least one of the given kind\n  def find_closest(kind_idx, cur):\n      positions = np.argwhere(grid[:, :, kind_idx] > 0)\n      if positions.shape[0] == 0:\n          return None\n      dists = np.sum(np.abs(positions - np.array(cur)), axis=1)\n      nearest = positions[np.argmin(dists)]\n      return tuple(nearest.tolist())\n\n  # Helper: greedy Manhattan path from cur to target (returns actions + final pos)\n  def path_to(cur, target):\n      x, y = cur\n      tx, ty = target\n      path = []\n      while (x, y) != (tx, ty):\n          if x < tx:\n              path.append(RIGHT)\n              x += 1\n          elif x > tx:\n              path.append(LEFT)\n              x -= 1\n          elif y < ty:\n              path.append(DOWN)\n              y += 1\n          elif y > ty:\n              path.append(UP)\n              y -= 1\n      return path, (x, y)\n\n  # Collect each required primitive\n  for kind_idx, needed in primitive_needs.items():\n      while needed > 0:\n          target = find_closest(kind_idx, cur_pos)\n          if target is None:\n              # Primitive not present \u2013 abort planning\n              return actions\n          move_actions, cur_pos = path_to(cur_pos, target)\n          actions.extend(move_actions)\n          actions.append(USE)   # pick up primitive\n          # Update local grid copy to reflect that we consumed one item\n          grid[target[0], target[1], kind_idx] = max(\n              0, grid[target[0], target[1], kind_idx] - 1\n          )\n          needed -= 1\n\n  # If crafting requires a workshop, go there and use it\n  if workshop_idx is not None:\n      ws_target = find_closest(workshop_idx, cur_pos)\n      if ws_target is not None:\n          move_actions, cur_pos = path_to(cur_pos, ws_target)\n          actions.extend(move_actions)\n          actions.append(USE)   # craft at the workshop\n\n  return actions", "env_interactions": 2, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:34:13.170709", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Locate the CraftWorld instance inside the provided environment\n  # ----------------------------------------------------------------------\n  if hasattr(env, \"world\"):\n      world = env.world\n  elif hasattr(env, \"scenario\"):\n      world = env.scenario.world\n  else:\n      raise AttributeError(\"Cannot find CraftWorld instance in the given env.\")\n\n  # ----------------------------------------------------------------------\n  # Identify the goal (stick) and its recipe\n  # ----------------------------------------------------------------------\n  goal_name = \"stick\"\n  goal_idx = world.cookbook.index.index(goal_name)\n\n  # Primitives required to craft a stick: {primitive_idx: count}\n  required = world.cookbook.primitives_for(goal_idx)\n\n  # ----------------------------------------------------------------------\n  # Obtain the current state for planning (position + grid)\n  # ----------------------------------------------------------------------\n  if hasattr(env, \"_current_state\"):\n      state = env._current_state\n  else:\n      state = env.scenario.init()\n\n  cur_pos = tuple(state.pos)          # (row, col)\n  grid = state.grid.copy()            # (H, W, n_kinds)\n\n  # ----------------------------------------------------------------------\n  # Helper utilities\n  # ----------------------------------------------------------------------\n  _ACTION_DELTAS = {\n      0: (1, 0),   # DOWN\n      1: (-1, 0),  # UP\n      2: (0, -1),  # LEFT\n      3: (0, 1),   # RIGHT\n  }\n\n  def _move_actions(start, goal):\n      \"\"\"Manhattan path actions from start (row,col) to goal (row,col).\"\"\"\n      y, x = start\n      gy, gx = goal\n      acts = []\n      while y < gy:\n          acts.append(0)  # DOWN\n          y += 1\n      while y > gy:\n          acts.append(1)  # UP\n          y -= 1\n      while x < gx:\n          acts.append(3)  # RIGHT\n          x += 1\n      while x > gx:\n          acts.append(2)  # LEFT\n          x -= 1\n      return acts\n\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive the necessary number of times\n  # ----------------------------------------------------------------------\n  for prim_idx, cnt in required.items():\n      for _ in range(cnt):\n          # Find a cell that currently holds the primitive\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(\n                  f\"Primitive '{world.cookbook.index.get(prim_idx)}' not found on the grid.\"\n              )\n          py, px = prim_cells[0]\n\n          # Find an empty neighbour from which we can face the primitive\n          target = None\n          for dy, dx in _ACTION_DELTAS.values():\n              ny, nx = py - dy, px - dx\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  if not grid[ny, nx, :].any():\n                      target = (ny, nx)\n                      break\n          if target is None:\n              raise RuntimeError(\"No reachable empty neighbour around required primitive.\")\n\n          # Move to that neighbour\n          actions.extend(_move_actions(cur_pos, target))\n          cur_pos = target\n\n          # Use the primitive (agent faces it)\n          actions.append(4)   # USE\n\n          # Update planning grid: primitive has been collected\n          grid[py, px, prim_idx] = 0\n\n  # ----------------------------------------------------------------------\n  # Move to the workshop (if the recipe specifies one) and craft the stick\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_cells.size == 0:\n          raise RuntimeError(f\"Workshop '{workshop_name}' not found on the grid.\")\n      wy, wx = ws_cells[0]\n\n      # Find an empty neighbour to face the workshop\n      target = None\n      for dy, dx in _ACTION_DELTAS.values():\n          ny, nx = wy - dy, wx - dx\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not grid[ny, nx, :].any():\n                  target = (ny, nx)\n                  break\n      if target is None:\n          raise RuntimeError(\"No reachable empty neighbour around workshop.\")\n\n      actions.extend(_move_actions(cur_pos, target))\n      cur_pos = target\n\n  # Final USE to actually craft the stick (whether we moved to a workshop or not)\n  actions.append(4)   # USE\n\n  return actions", "env_interactions": 5, "island_id": 7, "scores": {"3": 0.0}}
