not None:\n          w_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n          if w_locs.size:\n              _move_to(w_locs[0].tolist())\n              actions.append(4)   # USE to craft at the workshop\n\n  return actions", "env_interactions": 4, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:46:00.425131", "function_name": "make_arrow", "function_body": "  actions = []\n  state = env._current_state\n  grid = state.grid\n  world = env.world\n  cb = world.cookbook\n\n  # index of the target item \"stick\"\n  try:\n      goal_idx = cb.index[\"stick\"]\n  except Exception:\n      return actions\n\n  # primitive requirements for the stick (empty if stick is primitive)\n  needed_prims = cb.primitives_for(goal_idx)\n\n  # current mutable position of the agent\n  pos = list(state.pos)\n\n  # helper to move the agent to a target cell using Manhattan steps\n  def _move_to(target):\n      nonlocal pos, actions\n      tx, ty = target\n      # move in x direction (RIGHT=3, LEFT=2)\n      while pos[0] < tx:\n          actions.append(3)   # RIGHT\n          pos[0] += 1\n      while pos[0] > tx:\n          actions.append(2)   # LEFT\n          pos[0] -= 1\n      # move in y direction (DOWN=0, UP=1)\n      while pos[1] < ty:\n          actions.append(0)   # DOWN\n          pos[1] += 1\n      while pos[1] > ty:\n          actions.append(1)   # UP\n          pos[1] -= 1\n\n  # If stick itself is a primitive, just collect it directly\n  if not needed_prims:\n      locs = np.argwhere(grid[:, :, goal_idx] > 0)\n      if locs.size:\n          _move_to(locs[0].tolist())\n          actions.append(4)   # USE to pick up the stick\n      return actions\n\n  # Collect each required primitive\n  for prim_idx, count in needed_prims.items():\n      locs = np.argwhere(grid[:, :, prim_idx] > 0)\n      if not locs.size:\n          continue  # primitive not present; skip\n      _move_to(locs[0].tolist())\n      for _ in range(count):\n          actions.append(4)   # USE to pick up the primitive\n\n  # Move to the workshop (if the recipe specifies one) and craft the stick\n  recipe = cb.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      try:\n          workshop_idx = cb.index[workshop_name]\n      except Exception:\n          workshop_idx = None\n      if workshop_idx is not None:\n          w_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n          if w_locs.size:\n              _move_to(w_locs[0].tolist())\n              actions.append(4)   # USE to craft at the workshop\n\n  return actions", "env_interactions": 4, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:46:01.739092", "function_name": "make_arrow", "function_body": "  actions = []\n  state = env._current_state\n  grid = state.grid\n  world = env.world\n  cb = world.cookbook\n\n  # target item index\n  try:\n      goal_idx = cb.index[\"stick\"]\n  except Exception:\n      return actions\n\n  # primitive requirements (empty if stick is primitive)\n  needed_prims = cb.primitives_for(goal_idx)\n\n  # mutable copy of agent position\n  pos = list(state.pos)\n\n  # helper to move agent via Manhattan steps\n  def _move_to(target):\n      nonlocal pos, actions\n      tx, ty = target\n      while pos[0] < tx:\n          actions.append(3)   # RIGHT\n          pos[0] += 1\n      while pos[0] > tx:\n          actions.append(2)   # LEFT\n          pos[0] -= 1\n      while pos[1] < ty:\n          actions.append(0)   # DOWN\n          pos[1] += 1\n      while pos[1] > ty:\n          actions.append(1)   # UP\n          pos[1] -= 1\n\n  # If stick itself is a primitive, just pick it up.\n  if not needed_prims:\n      locs = np.argwhere(grid[:, :, goal_idx] > 0)\n      if locs.size:\n          _move_to(locs[0].tolist())\n          actions.append(4)   # USE to pick up stick\n      return actions\n\n  # Collect each required primitive.\n  for prim_idx, count in needed_prims.items():\n      locs = np.argwhere(grid[:, :, prim_idx] > 0)\n      if not locs.size:\n          continue\n      _move_to(locs[0].tolist())\n      for _ in range(count):\n          actions.append(4)   # USE to pick up primitive\n\n  # Move to the workshop (if recipe specifies one) and craft stick.\n  recipe = cb.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = cb.index.get(workshop_name)\n      if workshop_idx is not None:\n          w_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n          if w_locs.size:\n              _move_to(w_locs[0].tolist())\n              actions.append(4)   # USE to craft at workshop\n\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-10-23T03:46:17.504852", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  goal_idx = env.task.goal\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  def find_positions(kind):\n      \"\"\"Return list of (x, y) where grid has at least one of kind.\"\"\"\n      locs = np.argwhere(state.grid[:, :, kind] > 0)\n      return [tuple(p) for p in locs]\n\n  def nearest(pos, kind):\n      \"\"\"Nearest position of given kind by Manhattan distance.\"\"\"\n      positions = find_positions(kind)\n      if not positions:\n          return None\n      return min(positions, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n\n  def moves_to(src, dst):\n      \"\"\"Sequence of movement actions from src to dst (DOWN=0, UP=1, LEFT=2, RIGHT=3).\"\"\"\n      sx, sy = src\n      dx, dy = dst\n      seq = []\n      while sx < dx:\n          seq.append(0)   # DOWN\n          sx += 1\n      while sx > dx:\n          seq.append(1)   # UP\n          sx -= 1\n      while sy < dy:\n          seq.append(3)   # RIGHT\n          sy += 1\n      while sy > dy:\n          seq.append(2)   # LEFT\n          sy -= 1\n      return seq\n\n  # -----------------------------------------------------------------\n  # 1) If the goal is a primitive (no recipe), just go to it and pick it up.\n  # -----------------------------------------------------------------\n  if not env.world.cookbook.primitives_for(goal_idx):\n      target = nearest(cur_pos, goal_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)   # USE\n      return actions\n\n  # -----------------------------------------------------------------\n  # 2) Collect required primitive ingredients.\n  # -----------------------------------------------------------------\n  needed_prims = env.world.cookbook.primitives_for(goal_idx)\n  for prim_idx, count in needed_prims.items():\n      for _ in range(count):\n          target = nearest(cur_pos, prim_idx)\n          if target is None:\n              continue\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n          actions.append(4)   # USE to collect\n\n  # -----------------------------------------------------------------\n  # 3) Move to the appropriate workshop (if any) and craft the item.\n  # -----------------------------------------------------------------\n  workshop_idx = None\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  for key, val in recipe.items():\n      if isinstance(key, str):\n          workshop_idx = val\n          break\n\n  if workshop_idx is not None:\n      target = nearest(cur_pos, workshop_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)   # USE to craft\n\n  return actions", "env_interactions": 1, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:46:18.866197", "function_name": "make_arrow", "function_body": "  # Reset environment and get initial state\n  env.reset()\n  state = env._current_state\n  goal_idx = env.task.goal\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # --------------------------------------------------------------\n  # Helper utilities\n  # --------------------------------------------------------------\n  def find_positions(kind):\n      \"\"\"Return a list of (x, y) where the grid contains at least one of kind.\"\"\"\n      locs = np.argwhere(state.grid[:, :, kind] > 0)\n      return [tuple(p) for p in locs]\n\n  def nearest(pos, kind):\n      \"\"\"Find the Manhattan\u2011closest cell containing the given kind.\"\"\"\n      positions = find_positions(kind)\n      if not positions:\n          return None\n      return min(positions, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n\n  def moves_to(src, dst):\n      \"\"\"Generate a list of movement actions (DOWN=0, UP=1, LEFT=2, RIGHT=3)\n      that travel from src to dst using a simple Manhattan path.\"\"\"\n      sx, sy = src\n      dx, dy = dst\n      seq = []\n      while sx < dx:\n          seq.append(0)   # DOWN\n          sx += 1\n      while sx > dx:\n          seq.append(1)   # UP\n          sx -= 1\n      while sy < dy:\n          seq.append(3)   # RIGHT\n          sy += 1\n      while sy > dy:\n          seq.append(2)   # LEFT\n          sy -= 1\n      return seq\n\n  # --------------------------------------------------------------\n  # 1) If the goal is a primitive (no recipe), just go to it and pick it up.\n  # --------------------------------------------------------------\n  if not env.world.cookbook.primitives_for(goal_idx):\n      target = nearest(cur_pos, goal_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)   # USE\n      return actions\n\n  # --------------------------------------------------------------\n  # 2) Collect required primitive ingredients.\n  # --------------------------------------------------------------\n  needed_prims = env.world.cookbook.primitives_for(goal_idx)\n  for prim_idx, count in needed_prims.items():\n      for _ in range(count):\n          target = nearest(cur_pos, prim_idx)\n          if target is None:\n              # Primitive not found in the current grid \u2013 skip.\n              continue\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n          actions.append(4)   # USE to collect the primitive\n\n  # --------------------------------------------------------------\n  # 3) Move to the appropriate workshop (if any) and craft the item.\n  # --------------------------------------------------------------\n  workshop_idx = None\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  for key, val in recipe.items():\n      if isinstance(key, str):\n          workshop_idx = val\n          break\n\n  if workshop_idx is not None:\n      target = nearest(cur_pos, workshop_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)   # USE to craft at the workshop\n\n  return actions", "env_interactions": 1, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:46:37.814462", "function_name": "make_arrow", "function_body": "  def _move_to(cur_pos, target, seq):\n      x, y = cur_pos\n      tx, ty = target\n      while x < tx:\n          seq.append(3)  # RIGHT\n          x += 1\n      while x > tx:\n          seq.append(2)  # LEFT\n          x -= 1\n      while y < ty:\n          seq.append(0)  # DOWN\n          y += 1\n      while y > ty:\n          seq.append(1)  # UP\n          y -= 1\n      return (x, y)\n\n  # Gather current state information.\n  state = env._current_state\n  grid = state.grid.copy()\n  cur_pos = state.pos\n  goal_idx = env.task.goal\n\n  # Retrieve the recipe for the goal (stick).\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get('_at', None)\n  ingredients = {k: v for k, v in recipe.items() if k != '_at'}\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # 1) Collect required ingredients (if any).\n  # ------------------------------------------------------------------\n  for ing_kind, count in ingredients.items():\n      for _ in range(count):\n          locs = np.argwhere(grid[:, :, ing_kind] > 0)\n          if locs.size == 0:\n              # Ingredient missing; abort early.\n              return actions\n          dists = np.abs(locs[:, 0] - cur_pos[0]) + np.abs(locs[:, 1] - cur_pos[1])\n          best = int(np.argmin(dists))\n          target = tuple(locs[best].tolist())\n          cur_pos = _move_to(cur_pos, target, actions)\n          actions.append(4)                     # USE to pick up\n          grid[target[0], target[1], ing_kind] = 0\n\n  # ------------------------------------------------------------------\n  # 2) If the goal is a primitive (no recipe) just pick it up.\n  # ------------------------------------------------------------------\n  if not ingredients and workshop_kind is None:\n      locs = np.argwhere(grid[:, :, goal_idx] > 0)\n      if locs.size > 0:\n          dists = np.abs(locs[:, 0] - cur_pos[0]) + np.abs(locs[:, 1] - cur_pos[1])\n          best = int(np.argmin(dists))\n          target = tuple(locs[best].tolist())\n          cur_pos = _move_to(cur_pos, target, actions)\n          actions.append(4)                     # USE to pick up\n      return actions\n\n  # ------------------------------------------------------------------\n  # 3) Move to the required workshop (if any) and craft the stick.\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      ws_locs = np.argwhere(grid[:, :, workshop_kind] > 0)\n      if ws_locs.size > 0:\n          dists = np.abs(ws_locs[:, 0] - cur_pos[0]) + np.abs(ws_locs[:, 1] - cur_pos[1])\n          best = int(np.argmin(dists))\n          workshop_loc = tuple(ws_locs[best].tolist())\n          cur_pos = _move_to(cur_pos, workshop_loc, actions)\n          actions.append(4)                     # USE to craft at workshop\n\n  return actions", "env_interactions": 0, "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:46:39.071408", "function_name": "make_arrow", "function_body": "  def _move_to(cur_pos, target, seq):\n      x, y = cur_pos\n      tx, ty = target\n      while x < tx:\n          seq.append(3)  # RIGHT\n          x += 1\n      while x > tx:\n          seq.append(2)  # LEFT\n          x -= 1\n      while y < ty:\n          seq.append(0)  # DOWN\n          y += 1\n      while y > ty:\n          seq.append(1)  # UP\n          y -= 1\n      return (x, y)\n\n  state = env._current_state\n  grid = state.grid.copy()\n  cur_pos = state.pos\n  goal_idx = env.task.goal\n\n  # Retrieve recipe for the target item (stick)\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n  ingredients = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  actions = []\n\n  # Collect required ingredients\n  for ing_kind, count in ingredients.items():\n      for _ in range(count):\n          locs = np.argwhere(grid[:, :, ing_kind] > 0)\n          if locs.size == 0:\n              # Ingredient not found; abort early.\n              return actions\n          dists = np.abs(locs[:, 0] - cur_pos[0]) + np.abs(locs[:, 1] - cur_pos[1])\n          best = int(np.argmin(dists))\n          target = tuple(locs[best].tolist())\n          cur_pos = _move_to(cur_pos, target, actions)\n          actions.append(4)                     # USE to pick up\n          grid[target[0], target[1], ing_kind] = 0\n\n  # If the goal is a primitive (no recipe) just pick it up.\n  if not ingredients and workshop_kind is None:\n      locs = np.argwhere(grid[:, :, goal_idx] > 0)\n      if locs.size > 0:\n          dists = np.abs(locs[:, 0] - cur_pos[0]) + np.abs(locs[:, 1] - cur_pos[1])\n          best = int(np.argmin(dists))\n          target = tuple(locs[best].tolist())\n          cur_pos = _move_to(cur_pos, target, actions)\n          actions.append(4)                     # USE to pick up\n      return actions\n\n  # Move to the required workshop (if any) and craft the goal.\n  if workshop_kind is not None:\n      ws_locs = np.argwhere(grid[:, :, workshop_kind] > 0)\n      if ws_locs.size > 0:\n          dists = np.abs(ws_locs[:, 0] - cur_pos[0]) + np.abs(ws_locs[:, 1] - cur_pos[1])\n          best = int(np.argmin(dists))\n          workshop_loc = tuple(ws_locs[best].tolist())\n          cur_pos = _move_to(cur_pos, workshop_loc, actions)\n          actions.append(4)                     # USE to craft at workshop\n\n  return actions", "env_interactions": 0, "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:47:11.147261", "function_name": "make_arrow", "function_body": "  # Access current state and cookbook\n  state = env._current_state\n  cookbook = env.world.cookbook\n  stick_idx = cookbook.index['stick']\n\n  # If we already have a stick, nothing to do\n  if state.inventory[stick_idx] > 0:\n      return []\n\n  # Helper: move from cur_pos to target (x, y) using action indices\n  def _move(cur_pos, target):\n      actions = []\n      x, y = cur_pos\n      tx, ty = target\n      while x < tx:\n          actions.append(3)   # RIGHT\n          x += 1\n      while x > tx:\n          actions.append(2)   # LEFT\n          x -= 1\n      while y < ty:\n          actions.append(0)   # DOWN\n          y += 1\n      while y > ty:\n          actions.append(1)   # UP\n          y -= 1\n      return actions, (x, y)\n\n  # Helper: locate any cell containing the given kind index\n  def _find_any(kind_idx):\n      cells = np.argwhere(state.grid[:, :, kind_idx] > 0)\n      return tuple(cells[0]) if cells.size > 0 else None\n\n  actions = []\n  cur_pos = state.pos\n  inventory = state.inventory.copy()\n\n  # ------------------------------------------------------------------\n  # Case 1: stick is a primitive that can be collected directly\n  # ------------------------------------------------------------------\n  if stick_idx in cookbook.primitives:\n      target = _find_any(stick_idx)\n      if target is None:\n          return []  # No stick primitive present on the map\n      moves, cur_pos = _move(cur_pos, target)\n      actions.extend(moves)\n      actions.append(4)   # USE to pick up the stick\n      return actions\n\n  # ------------------------------------------------------------------\n  # Case 2: stick must be crafted from a recipe\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(stick_idx, {})\n  if not recipe:\n      return []  # No known way to obtain a stick\n\n  workshop_name = recipe.get('_at')\n  workshop_idx = cookbook.index[workshop_name] if workshop_name is not None else None\n\n  # Gather all required ingredients (ignore the special \"_at\" key)\n  for ing_key, cnt in recipe.items():\n      if ing_key == '_at':\n          continue\n      ing_idx = ing_key if isinstance(ing_key, int) else cookbook.index[ing_key]\n      for _ in range(cnt):\n          # Keep picking up until we have enough of this ingredient\n          while inventory[ing_idx] < 1:\n              target = _find_any(ing_idx)\n              if target is None:\n                  return actions  # Missing ingredient on the map; abort\n              moves, cur_pos = _move(cur_pos, target)\n              actions.extend(moves)\n              actions.append(4)   # USE to pick up the ingredient\n              inventory[ing_idx] += 1\n\n  # If a specific workshop is required, move there\n  if workshop_idx is not None:\n      ws_target = _find_any(workshop_idx)\n      if ws_target is None:\n          return actions  # No workshop found; abort\n      moves, cur_pos = _move(cur_pos, ws_target)\n      actions.extend(moves)\n\n  # Finally, craft the stick at the current location (or workshop)\n  actions.append(4)   # USE to craft\n\n  return actions", "env_interactions": 4, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:47:12.421193", "function_name": "make_arrow", "function_body": "  # Access current state and cookbook\n  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  # Index for the stick item\n  stick_idx = cookbook.index['stick']\n\n  # If we already have a stick in inventory, nothing to do.\n  if state.inventory[stick_idx] > 0:\n      return []\n\n  # Helper to generate movement actions from current position to a target cell.\n  def _move_to(cur_pos, target, action_list):\n      x, y = cur_pos\n      tx, ty = target\n      # Horizontal moves (x coordinate)\n      while x < tx:\n          action_list.append(3)   # RIGHT\n          x += 1\n      while x > tx:\n          action_list.append(2)   # LEFT\n          x -= 1\n      # Vertical moves (y coordinate)\n      while y < ty:\n          action_list.append(0)   # DOWN\n          y += 1\n      while y > ty:\n          action_list.append(1)   # UP\n          y -= 1\n      return (x, y)\n\n  # Helper to locate any cell that currently contains the given kind index.\n  def _find_any(grid, kind_idx):\n      cells = np.argwhere(grid[:, :, kind_idx] > 0)\n      return tuple(cells[0]) if cells.size > 0 else None\n\n  actions = []\n  cur_pos = state.pos\n  # Work on a local copy of the grid so we can \u201cconsume\u201d items we plan to pick up.\n  grid = state.grid.copy()\n  inventory = state.inventory.copy()\n\n  # ----------------------------------------------------------------------\n  # Case 1: stick is a primitive that can be collected directly.\n  # ----------------------------------------------------------------------\n  if stick_idx in cookbook.primitives:\n      target = _find_any(grid, stick_idx)\n      if target is None:\n          # No stick primitive present on the map.\n          return []\n      cur_pos = _move_to(cur_pos, target, actions)\n      actions.append(4)   # USE to pick up the stick\n      return actions\n\n  # ----------------------------------------------------------------------\n  # Case 2: stick must be crafted from a recipe.\n  # ----------------------------------------------------------------------\n  recipe = cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = cookbook.index[workshop_name] if workshop_name is not None else None\n\n  # Gather required primitive ingredients.\n  primitive_requirements = cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n  for prim_idx, needed in primitive_requirements.items():\n      while inventory[prim_idx] < needed:\n          target = _find_any(grid, prim_idx)\n          if target is None:\n              # Required primitive not available.\n              return []\n          cur_pos = _move_to(cur_pos, target, actions)\n          actions.append(4)                     # USE to pick up the primitive\n          inventory[prim_idx] += 1\n          # Mark the cell as empty for future searches.\n          grid[target[0], target[1], prim_idx] = 0\n\n  # If the recipe specifies a workshop, move there before crafting.\n  if workshop_idx is not None:\n      target = _find_any(grid, workshop_idx)\n      if target is None:\n          # Workshop not found on the map.\n          return []\n      cur_pos = _move_to(cur_pos, target, actions)\n\n  # Finally, craft the stick (USE at the current location or at the workshop).\n  actions.append(4)   # USE to craft the stick\n  return actions", "env_interactions": 4, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:47:29.843665", "function_name": "make_arrow", "function_body": "  # Get current state and world information\n  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  # Index of the stick item\n  stick_idx = cookbook.index['stick']\n\n  # If we already have a stick in inventory, nothing to do\n  if state.inventory[stick_idx] > 0:\n      return []\n\n  # Helper: generate movement actions from cur_pos to target\n  def _move_to(cur_pos, target, action_list):\n      x, y = cur_pos\n      tx, ty = target\n      while x < tx:\n          action_list.append(3)   # RIGHT\n          x += 1\n      while x > tx:\n          action_list.append(2)   # LEFT\n          x -= 1\n      while y < ty:\n          action_list.append(0)   # DOWN\n          y += 1\n      while y > ty:\n          action_list.append(1)   # UP\n          y -= 1\n      return (x, y)\n\n  # Helper: locate any cell containing a given kind index\n  def _find_any(grid, kind_idx):\n      cells = np.argwhere(grid[:, :, kind_idx] > 0)\n      return tuple(cells[0]) if cells.size > 0 else None\n\n  actions = []\n  cur_pos = state.pos\n  # Work on a copy of the grid so we can mark cells as empty after planning to pick them up\n  grid = state.grid.copy()\n  inventory = state.inventory.copy()\n\n  # ----------------------------------------------------------------------\n  # Case 1: stick is a primitive that can be collected directly.\n  # ----------------------------------------------------------------------\n  if stick_idx in cookbook.primitives:\n      target = _find_any(grid, stick_idx)\n      if target is None:\n          # No stick primitive present on the map.\n          return actions\n      cur_pos = _move_to(cur_pos, target, actions)\n      actions.append(4)   # USE to pick up the stick\n      return actions\n\n  # ----------------------------------------------------------------------\n  # Case 2: stick must be crafted from a recipe.\n  # ----------------------------------------------------------------------\n  recipe = cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = cookbook.index[workshop_name] if workshop_name is not None else None\n\n  # Gather required primitive ingredients.\n  primitive_requirements = cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n  for prim_idx, needed in primitive_requirements.items():\n      while inventory[prim_idx] < needed:\n          target = _find_any(grid, prim_idx)\n          if target is None:\n              # Required primitive not available on the map.\n              return actions\n          cur_pos = _move_to(cur_pos, target, actions)\n          actions.append(4)                     # USE to pick up the primitive\n          inventory[prim_idx] += 1\n          # Mark the cell as empty for subsequent searches\n          grid[target[0], target[1], prim_idx] = 0\n\n  # If the recipe specifies a workshop, move there before crafting.\n  if workshop_idx is not None:\n      target = _find_any(grid, workshop_idx)\n      if target is not None:\n          cur_pos = _move_to(cur_pos, target, actions)\n\n  # Finally, craft the stick (USE at current location or at the workshop).\n  actions.append(4)   # USE to craft the stick\n  return actions", "env_interactions": 4, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:47:31.162774", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  # Index for the stick item\n  stick_idx = cookbook.index['stick']\n\n  # If we already have a stick in inventory, nothing to do.\n  if state.inventory[stick_idx] > 0:\n      return []\n\n  # Helper to generate movement actions from current position to a target cell.\n  def _move_to(cur_pos, target, action_list):\n      x, y = cur_pos\n      tx, ty = target\n      # Horizontal moves (x coordinate)\n      while x < tx:\n          action_list.append(3)   # RIGHT\n          x += 1\n      while x > tx:\n          action_list.append(2)   # LEFT\n          x -= 1\n      # Vertical moves (y coordinate)\n      while y < ty:\n          action_list.append(0)   # DOWN\n          y += 1\n      while y > ty:\n          action_list.append(1)   # UP\n          y -= 1\n      return (x, y)\n\n  # Helper to locate any cell that currently contains the given kind index.\n  def _find_any(grid, kind_idx):\n      cells = np.argwhere(grid[:, :, kind_idx] > 0)\n      return tuple(cells[0]) if cells.size > 0 else None\n\n  actions = []\n  cur_pos = state.pos\n  # Work on a local copy of the grid so we can \u201cconsume\u201d items we plan to pick up.\n  grid = state.grid.copy()\n  inventory = state.inventory.copy()\n\n  # ----------------------------------------------------------------------\n  # Case 1: stick is a primitive that can be collected directly.\n  # ----------------------------------------------------------------------\n  if stick_idx in cookbook.primitives:\n      target = _find_any(grid, stick_idx)\n      if target is None:\n          # No stick primitive present on the map.\n          return []\n      cur_pos = _move_to(cur_pos, target, actions)\n      actions.append(4)   # USE to pick up the stick\n      return actions\n\n  # ----------------------------------------------------------------------\n  # Case 2: stick must be crafted from a recipe.\n  # ----------------------------------------------------------------------\n  recipe = cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = cookbook.index[workshop_name] if workshop_name is not None else None\n\n  # Gather required primitive ingredients.\n  primitive_requirements = cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n  for prim_idx, needed in primitive_requirements.items():\n      while inventory[prim_idx] < needed:\n          target = _find_any(grid, prim_idx)\n          if target is None:\n              # Required primitive not available.\n              return []\n          cur_pos = _move_to(cur_pos, target, actions)\n          actions.append(4)                     # USE to pick up the primitive\n          inventory[prim_idx] += 1\n          # Mark the cell as empty for future searches.\n          grid[target[0], target[1], prim_idx] = 0\n\n  # If the recipe specifies a workshop, move there before crafting.\n  if workshop_idx is not None:\n      target = _find_any(grid, workshop_idx)\n      if target is None:\n          # Workshop not found on the map.\n          return []\n      cur_pos = _move_to(cur_pos, target, actions)\n\n  # Finally, craft the stick (USE at the current location or at the workshop).\n  actions.append(4)   # USE to craft the stick\n  return actions", "env_interactions": 4, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:48:03.370269", "function_name": "make_arrow", "function_body": "  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions from start to goal (horizontal then vertical).\"\"\"\n      x, y = start\n      gx, gy = goal\n      actions = []\n      while x < gx:\n          actions.append(ACTION_RIGHT)\n          x += 1\n      while x > gx:\n          actions.append(ACTION_LEFT)\n          x -= 1\n      while y < gy:\n          actions.append(ACTION_DOWN)\n          y += 1\n      while y > gy:\n          actions.append(ACTION_UP)\n          y -= 1\n      return actions\n\n  def nearest_position(positions, reference):\n      \"\"\"Pick the position from *positions* with smallest Manhattan distance to *reference*.\"\"\"\n      if positions.shape[0] == 0:\n          return None\n      ref = np.array(reference)\n      dists = np.sum(np.abs(positions - ref), axis=1)\n      return tuple(positions[np.argmin(dists)])\n\n  # ------------------------------------------------------------------\n  # Gather current state information\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n\n  # ------------------------------------------------------------------\n  # Identify goal (stick)\n  # ------------------------------------------------------------------\n  goal_name = \"stick\"\n  try:\n      goal_idx = env.world.cookbook.index[goal_name]\n  except Exception:\n      return []  # goal not present in the cookbook\n\n  # ------------------------------------------------------------------\n  # 1) Collect required primitives (if any)\n  # ------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  plan_actions = []\n\n  for prim_idx, needed_cnt in primitives_needed.items():\n      while inventory[prim_idx] < needed_cnt:\n          # locate cells containing the primitive\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # no more of this primitive on the map \u2013 abort planning\n              return plan_actions\n          target = nearest_position(prim_cells, pos)\n\n          # move to the primitive\n          plan_actions.extend(manhattan_path(pos, target))\n          pos = target\n\n          # pick it up\n          plan_actions.append(ACTION_USE)\n\n          # simulate pick\u2011up locally for subsequent planning\n          inventory[prim_idx] += 1\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # ------------------------------------------------------------------\n  # 2) Go to workshop (if required) and craft the stick\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      try:\n          workshop_idx = env.world.cookbook.index[workshop_name]\n      except Exception:\n          return plan_actions\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          # no visible workshop \u2013 cannot craft\n          return plan_actions\n      wcell = tuple(workshop_cells[0])\n\n      # Find a free adjacent cell to stand on\n      neighbours = [(wcell[0] + dx, wcell[1] + dy) for dx, dy in\n                    [(1, 0), (-1, 0), (0, 1), (0, -1)]]\n      stand_pos = None\n      for nx, ny in neighbours:\n          if (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and\n                  grid[nx, ny, :].sum() == 0):\n              stand_pos = (nx, ny)\n              break\n      if stand_pos is None:\n          stand_pos = wcell  # fallback: stand directly on the workshop\n\n      # Move to the chosen standing position\n      plan_actions.extend(manhattan_path(pos, stand_pos))\n      pos = stand_pos\n\n      # Use the workshop to craft the stick\n      plan_actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # Return the assembled action list\n  # ------------------------------------------------------------------\n  return plan_actions", "env_interactions": 5, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:48:04.712871", "function_name": "make_arrow", "function_body": "  # Action indices (as defined in CraftLab.action_specs)\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions from start to goal using\n      horizontal then vertical moves (ignores obstacles).\"\"\"\n      x, y = start\n      gx, gy = goal\n      actions = []\n      while x < gx:\n          actions.append(ACTION_RIGHT)\n          x += 1\n      while x > gx:\n          actions.append(ACTION_LEFT)\n          x -= 1\n      while y < gy:\n          actions.append(ACTION_DOWN)\n          y += 1\n      while y > gy:\n          actions.append(ACTION_UP)\n          y -= 1\n      return actions\n\n  def nearest_position(positions, reference):\n      \"\"\"Pick the position from *positions* with smallest Manhattan distance\n      to *reference*.\"\"\"\n      if positions.shape[0] == 0:\n          return None\n      ref = np.array(reference)\n      dists = np.sum(np.abs(positions - ref), axis=1)\n      return tuple(positions[np.argmin(dists)])\n\n  # ------------------------------------------------------------------\n  # Gather current state information\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n\n  # ------------------------------------------------------------------\n  # Identify goal (stick)\n  # ------------------------------------------------------------------\n  goal_name = \"stick\"\n  try:\n      goal_idx = env.world.cookbook.index[goal_name]\n  except Exception:\n      return []  # goal not defined in the cookbook\n\n  plan_actions = []\n\n  # ------------------------------------------------------------------\n  # Case 1: goal is a primitive \u2013 just pick it up\n  # ------------------------------------------------------------------\n  if goal_idx in env.world.cookbook.primitives:\n      while inventory[goal_idx] == 0:\n          stick_cells = np.argwhere(grid[:, :, goal_idx] > 0)\n          if stick_cells.size == 0:\n              # No stick left on the map; abort planning\n              return plan_actions\n          target = nearest_position(stick_cells, pos)\n\n          # Move to the stick\n          plan_actions.extend(manhattan_path(pos, target))\n          pos = target\n\n          # Pick it up\n          plan_actions.append(ACTION_USE)\n\n          # Simulate the pickup locally\n          inventory[goal_idx] += 1\n          grid[target[0], target[1], goal_idx] -= 1\n      return plan_actions\n\n  # ------------------------------------------------------------------\n  # Case 2: goal is crafted \u2013 collect required primitives first\n  # ------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  for prim_idx, needed_cnt in primitives_needed.items():\n      while inventory[prim_idx] < needed_cnt:\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # Required primitive not available; abort planning\n              return plan_actions\n          target = nearest_position(prim_cells, pos)\n\n          # Move to the primitive\n          plan_actions.extend(manhattan_path(pos, target))\n          pos = target\n\n          # Pick it up\n          plan_actions.append(ACTION_USE)\n\n          # Update local copies\n          inventory[prim_idx] += 1\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if required) and craft the stick\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      try:\n          workshop_idx = env.world.cookbook.index[workshop_name]\n      except Exception:\n          return plan_actions\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.shape[0] == 0:\n          # No workshop visible \u2013 cannot craft\n          return plan_actions\n      wcell = tuple(workshop_cells[0])\n\n      # Find a free adjacent cell to stand on\n      neighbours = [(wcell[0] + dx, wcell[1] + dy) for dx, dy in\n                    [(1, 0), (-1, 0), (0, 1), (0, -1)]]\n      stand_pos = None\n      for nx, ny in neighbours:\n          if (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and\n                  grid[nx, ny, :].sum() == 0):\n              stand_pos = (nx, ny)\n              break\n      if stand_pos is None:\n          stand_pos = wcell  # fallback: stand directly on the workshop\n\n      # Move to the chosen standing position\n      plan_actions.extend(manhattan_path(pos, stand_pos))\n      pos = stand_pos\n\n      # Use the workshop to craft the stick\n      plan_actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # Return the full action list\n  # ------------------------------------------------------------------\n  return plan_actions", "env_interactions": 5, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:48:26.845179", "function_name": "make_arrow", "function_body": "  # action indices (as defined in CraftLab.action_specs)\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # helper utilities\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions from start to goal using only\n      horizontal then vertical moves (no obstacle avoidance).\"\"\"\n      x, y = start\n      gx, gy = goal\n      actions = []\n      while x < gx:\n          actions.append(ACTION_RIGHT)\n          x += 1\n      while x > gx:\n          actions.append(ACTION_LEFT)\n          x -= 1\n      while y < gy:\n          actions.append(ACTION_DOWN)\n          y += 1\n      while y > gy:\n          actions.append(ACTION_UP)\n          y -= 1\n      return actions\n\n  def nearest_position(positions, reference):\n      \"\"\"Return the position from *positions* with smallest Manhattan distance to *reference*.\"\"\"\n      if len(positions) == 0:\n          return None\n      ref = np.array(reference)\n      dists = np.sum(np.abs(positions - ref), axis=1)\n      return tuple(positions[np.argmin(dists)])\n\n  # ------------------------------------------------------------------\n  # main planning logic\n  # ------------------------------------------------------------------\n  state = env._current_state                # current CraftState\n  grid = state.grid.copy()                  # (W, H, n_kinds) numpy array\n  pos = tuple(state.pos)                    # (x, y)\n  inventory = state.inventory.copy()        # 1\u2011D array of counts\n\n  # ------------------------------------------------------------------\n  # identify the stick index\n  # ------------------------------------------------------------------\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      return []  # stick not defined in this world\n\n  # If we already have a stick, nothing to do\n  if inventory[stick_idx] > 0:\n      return []\n\n  plan_actions = []\n\n  # ------------------------------------------------------------------\n  # 1) gather required primitives (if any)\n  # ------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(stick_idx)  # dict {kind_idx: count}\n  for prim_idx, needed_cnt in primitives_needed.items():\n      while inventory[prim_idx] < needed_cnt:\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # primitive not available on map \u2013 abort planning\n              return plan_actions\n          target = nearest_position(prim_cells, pos)\n\n          # move to the primitive cell\n          plan_actions.extend(manhattan_path(pos, target))\n          pos = target\n\n          # pick it up\n          plan_actions.append(ACTION_USE)\n\n          # simulate the effect for subsequent planning steps\n          inventory[prim_idx] += 1\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # ------------------------------------------------------------------\n  # 2) if stick itself is a primitive (no recipe), just pick it up\n  # ------------------------------------------------------------------\n  if stick_idx not in env.world.cookbook.recipes:\n      stick_cells = np.argwhere(grid[:, :, stick_idx] > 0)\n      if stick_cells.size == 0:\n          return plan_actions\n      target = nearest_position(stick_cells, pos)\n      plan_actions.extend(manhattan_path(pos, target))\n      pos = target\n      plan_actions.append(ACTION_USE)\n      return plan_actions\n\n  # ------------------------------------------------------------------\n  # 3) go to the appropriate workshop and craft the stick\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      return plan_actions\n\n  workshop_idx = env.world.cookbook.index[workshop_name]\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      return plan_actions\n\n  # pick a workshop cell and find a free adjacent cell to stand on\n  wcell = tuple(workshop_cells[0])\n  neighbours = [(wcell[0] + dx, wcell[1] + dy) for dx, dy in\n                [(1, 0), (-1, 0), (0, 1), (0, -1)]]\n  stand_pos = None\n  for nx, ny in neighbours:\n      if (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and\n              grid[nx, ny, :].sum() == 0):\n          stand_pos = (nx, ny)\n          break\n  if stand_pos is None:\n      # fallback: stand on the workshop cell itself (may fail at runtime)\n      stand_pos = wcell\n\n  # move to the chosen standing position\n  plan_actions.extend(manhattan_path(pos, stand_pos))\n  pos = stand_pos\n\n  # finally use the workshop to craft the stick\n  plan_actions.append(ACTION_USE)\n\n  return plan_actions", "env_interactions": 5, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:48:28.106557", "function_name": "make_arrow", "function_body": "  # action indices as defined in CraftLab.action_specs\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # helper utilities\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions from start to goal using\n      horizontal\u2011then\u2011vertical moves (ignores obstacles).\"\"\"\n      x, y = start\n      gx, gy = goal\n      actions = []\n      while x < gx:\n          actions.append(ACTION_RIGHT)\n          x += 1\n      while x > gx:\n          actions.append(ACTION_LEFT)\n          x -= 1\n      while y < gy:\n          actions.append(ACTION_DOWN)\n          y += 1\n      while y > gy:\n          actions.append(ACTION_UP)\n          y -= 1\n      return actions\n\n  def nearest_position(positions, reference):\n      \"\"\"Return the position from *positions* with smallest Manhattan distance to *reference*.\"\"\"\n      if len(positions) == 0:\n          return None\n      ref = np.array(reference)\n      dists = np.sum(np.abs(positions - ref), axis=1)\n      return tuple(positions[np.argmin(dists)])\n\n  # ------------------------------------------------------------------\n  # main planning logic\n  # ------------------------------------------------------------------\n  state = env._current_state                # current CraftState\n  grid = state.grid.copy()                  # (W, H, n_kinds) numpy array\n  pos = tuple(state.pos)                    # (x, y)\n  inventory = state.inventory.copy()        # 1\u2011D array of counts\n\n  # ------------------------------------------------------------------\n  # identify the stick item\n  # ------------------------------------------------------------------\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      # stick not defined in the recipe set\n      return []\n\n  # ------------------------------------------------------------------\n  # 1) collect required primitives for a stick\n  # ------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(stick_idx)  # {kind_idx: count}\n  plan_actions = []\n\n  for prim_idx, needed_cnt in primitives_needed.items():\n      while inventory[prim_idx] < needed_cnt:\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # primitive not present on the map \u2013 abort planning\n              return plan_actions\n          target = nearest_position(prim_cells, pos)\n\n          # move to the primitive cell\n          plan_actions.extend(manhattan_path(pos, target))\n          pos = target\n\n          # pick it up\n          plan_actions.append(ACTION_USE)\n\n          # simulate the effect for subsequent steps\n          inventory[prim_idx] += 1\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # ------------------------------------------------------------------\n  # 2) if the stick itself is a primitive (no recipe), just pick it up\n  # ------------------------------------------------------------------\n  if stick_idx not in env.world.cookbook.recipes:\n      stick_cells = np.argwhere(grid[:, :, stick_idx] > 0)\n      if stick_cells.size == 0:\n          return plan_actions\n      target = nearest_position(stick_cells, pos)\n      plan_actions.extend(manhattan_path(pos, target))\n      pos = target\n      plan_actions.append(ACTION_USE)\n      return plan_actions\n\n  # ------------------------------------------------------------------\n  # 3) go to the appropriate workshop and craft the stick\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      # no workshop required \u2013 should not happen for a non\u2011primitive stick\n      return plan_actions\n\n  try:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n  except Exception:\n      return plan_actions\n\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      return plan_actions\n\n  # pick a workshop cell (first one) and find a free adjacent cell to stand on\n  wcell = tuple(workshop_cells[0])\n  neighbours = [(wcell[0] + dx, wcell[1] + dy) for dx, dy in\n                [(1, 0), (-1, 0), (0, 1), (0, -1)]]\n  stand_pos = None\n  for nx, ny in neighbours:\n      if (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and\n              grid[nx, ny, :].sum() == 0):\n          stand_pos = (nx, ny)\n          break\n  if stand_pos is None:\n      # fallback: stand on the workshop cell itself (may fail at runtime)\n      stand_pos = wcell\n\n  # move to the chosen standing position\n  plan_actions.extend(manhattan_path(pos, stand_pos))\n  pos = stand_pos\n\n  # finally use the workshop to craft the stick\n  plan_actions.append(ACTION_USE)\n\n  return plan_actions", "env_interactions": 5, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:48:47.876658", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # Action indices as defined in CraftLab.action_specs\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions from start to goal using\n      horizontal then vertical moves (ignores obstacles).\"\"\"\n      sx, sy = start\n      gx, gy = goal\n      actions = []\n      while sx < gx:\n          actions.append(ACTION_RIGHT)\n          sx += 1\n      while sx > gx:\n          actions.append(ACTION_LEFT)\n          sx -= 1\n      while sy < gy:\n          actions.append(ACTION_DOWN)\n          sy += 1\n      while sy > gy:\n          actions.append(ACTION_UP)\n          sy -= 1\n      return actions\n\n  def nearest_position(positions, reference):\n      \"\"\"Pick the position from *positions* with smallest Manhattan distance\n      to *reference*.\"\"\"\n      if positions.size == 0:\n          return None\n      ref = np.array(reference)\n      dists = np.sum(np.abs(positions - ref), axis=1)\n      return tuple(positions[np.argmin(dists)])\n\n  # ------------------------------------------------------------------\n  # Gather current state information\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n\n  # ------------------------------------------------------------------\n  # Goal: stick\n  # ------------------------------------------------------------------\n  goal_name = \"stick\"\n  try:\n      goal_idx = env.world.cookbook.index[goal_name]\n  except Exception:\n      # Goal not found \u2013 nothing to do\n      return []\n\n  # If we already have a stick, no actions needed\n  if inventory[goal_idx] > 0:\n      return []\n\n  plan_actions = []\n\n  # ------------------------------------------------------------------\n  # Determine required primitives for the stick\n  # ------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n\n  # ------------------------------------------------------------------\n  # 1) Collect required primitives (if any)\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      while inventory[prim_idx] < needed_cnt:\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # No more primitives of this type are available \u2013 abort planning\n              return plan_actions\n          target = nearest_position(prim_cells, pos)\n\n          # Move to the primitive\n          plan_actions.extend(manhattan_path(pos, target))\n          pos = target\n\n          # Pick it up\n          plan_actions.append(ACTION_USE)\n\n          # Simulate the pickup locally for further planning\n          inventory[prim_idx] += 1\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # ------------------------------------------------------------------\n  # 2) If the stick itself is a primitive (no recipe), just collect it\n  # ------------------------------------------------------------------\n  if not primitives_needed:\n      # Stick is a primitive item\n      stick_cells = np.argwhere(grid[:, :, goal_idx] > 0)\n      if stick_cells.size > 0:\n          target = nearest_position(stick_cells, pos)\n          plan_actions.extend(manhattan_path(pos, target))\n          pos = target\n          plan_actions.append(ACTION_USE)\n      return plan_actions\n\n  # ------------------------------------------------------------------\n  # 3) Craft the stick at its required workshop (if any)\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      try:\n          workshop_idx = env.world.cookbook.index[workshop_name]\n      except Exception:\n          return plan_actions\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          return plan_actions\n      wcell = tuple(workshop_cells[0])\n\n      # Find a free adjacent cell to stand on (fallback to the workshop cell itself)\n      neighbours = [(wcell[0] + dx, wcell[1] + dy) for dx, dy in\n                    [(1, 0), (-1, 0), (0, 1), (0, -1)]]\n      stand_pos = None\n      for nx, ny in neighbours:\n          if (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and\n                  grid[nx, ny, :].sum() == 0):\n              stand_pos = (nx, ny)\n              break\n      if stand_pos is None:\n          stand_pos = wcell  # fallback\n\n      # Move to the chosen standing position\n      plan_actions.extend(manhattan_path(pos, stand_pos))\n      pos = stand_pos\n\n      # Use the workshop to craft the stick\n      plan_actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # Return the compiled action list\n  # ------------------------------------------------------------------\n  return plan_actions", "env_interactions": 5, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:48:49.132700", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # Action indices as defined in CraftLab.action_specs\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions from start to goal using\n      horizontal then vertical moves (ignores obstacles).\"\"\"\n      sx, sy = start\n      gx, gy = goal\n      actions = []\n      while sx < gx:\n          actions.append(ACTION_RIGHT)\n          sx += 1\n      while sx > gx:\n          actions.append(ACTION_LEFT)\n          sx -= 1\n      while sy < gy:\n          actions.append(ACTION_DOWN)\n          sy += 1\n      while sy > gy:\n          actions.append(ACTION_UP)\n          sy -= 1\n      return actions\n\n  def nearest_position(positions, reference):\n      \"\"\"Pick the position from *positions* with smallest Manhattan distance\n      to *reference*.\"\"\"\n      if positions.size == 0:\n          return None\n      ref = np.array(reference)\n      dists = np.sum(np.abs(positions - ref), axis=1)\n      return tuple(positions[np.argmin(dists)])\n\n  # ------------------------------------------------------------------\n  # Gather current state information\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n\n  # ------------------------------------------------------------------\n  # Goal: stick\n  # ------------------------------------------------------------------\n  goal_name = \"stick\"\n  try:\n      goal_idx = env.world.cookbook.index[goal_name]\n  except Exception:\n      # Goal not present in the world\n      return []\n\n  # If we already have a stick, nothing to do\n  if inventory[goal_idx] > 0:\n      return []\n\n  plan_actions = []\n\n  # ------------------------------------------------------------------\n  # Determine required primitives for the stick (if any)\n  # ------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n\n  # ------------------------------------------------------------------\n  # 1) Collect needed primitives\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      while inventory[prim_idx] < needed_cnt:\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # No more of this primitive available \u2013 abort planning\n              return plan_actions\n          target = nearest_position(prim_cells, pos)\n\n          # Move to the primitive\n          plan_actions.extend(manhattan_path(pos, target))\n          pos = target\n\n          # Pick it up\n          plan_actions.append(ACTION_USE)\n\n          # Simulate local state change for further planning\n          inventory[prim_idx] += 1\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # ------------------------------------------------------------------\n  # 2) If the stick itself is a primitive (no recipe), just collect it\n  # ------------------------------------------------------------------\n  if not primitives_needed:\n      stick_cells = np.argwhere(grid[:, :, goal_idx] > 0)\n      if stick_cells.size > 0:\n          target = nearest_position(stick_cells, pos)\n          plan_actions.extend(manhattan_path(pos, target))\n          plan_actions.append(ACTION_USE)\n      return plan_actions\n\n  # ------------------------------------------------------------------\n  # 3) Craft the stick at its required workshop (if any)\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      # Need to go to a specific workshop\n      try:\n          workshop_idx = env.world.cookbook.index[workshop_name]\n      except Exception:\n          return plan_actions\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          return plan_actions\n      wcell = tuple(workshop_cells[0])\n\n      # Find a free adjacent cell to stand on (fallback to the workshop cell itself)\n      neighbours = [(wcell[0] + dx, wcell[1] + dy) for dx, dy in\n                    [(1, 0), (-1, 0), (0, 1), (0, -1)]]\n      stand_pos = None\n      for nx, ny in neighbours:\n          if (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and\n                  grid[nx, ny, :].sum() == 0):\n              stand_pos = (nx, ny)\n              break\n      if stand_pos is None:\n          stand_pos = wcell\n\n      # Move to the chosen standing position\n      plan_actions.extend(manhattan_path(pos, stand_pos))\n      pos = stand_pos\n\n      # Use the workshop to craft the stick\n      plan_actions.append(ACTION_USE)\n  else:\n      # No specific workshop \u2013 simply use the current cell to craft\n      plan_actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # Return the constructed action list\n  # ------------------------------------------------------------------\n  return plan_actions", "env_interactions": 5, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:49:04.527925", "function_name": "make_arrow", "function_body": "  actions = []\n  state = env._current_state\n  grid = state.grid\n  world = env.world\n  cb = world.cookbook\n\n  # index of the target item \"stick\"\n  try:\n      goal_idx = cb.index[\"stick\"]\n  except Exception:\n      return actions\n\n  # primitive requirements for a stick (empty dict if stick is primitive)\n  needed_prims = cb.primitives_for(goal_idx)\n\n  # current agent position (x, y)\n  pos = list(state.pos)\n\n  # helper to move using Manhattan steps\n  def _move_to(target):\n      nonlocal pos, actions\n      tx, ty = target\n      # move horizontally first\n      while pos[0] < tx:\n          actions.append(3)   # RIGHT\n          pos[0] += 1\n      while pos[0] > tx:\n          actions.append(2)   # LEFT\n          pos[0] -= 1\n      # then move vertically\n      while pos[1] < ty:\n          actions.append(0)   # DOWN\n          pos[1] += 1\n      while pos[1] > ty:\n          actions.append(1)   # UP\n          pos[1] -= 1\n\n  # If stick is a primitive, just pick it up.\n  if not needed_prims:\n      locs = np.argwhere(grid[:, :, goal_idx] > 0)\n      if locs.size:\n          _move_to(locs[0].tolist())\n          actions.append(4)   # USE to pick up\n      return actions\n\n  # Collect each required primitive the needed number of times.\n  for prim_idx, count in needed_prims.items():\n      prim_locs = np.argwhere(grid[:, :, prim_idx] > 0)\n      if not prim_locs.size:\n          continue  # primitive not present; should not happen in a valid scenario\n      _move_to(prim_locs[0].tolist())\n      for _ in range(count):\n          actions.append(4)   # USE to pick up\n\n  # Move to the workshop (if required) and craft the stick.\n  recipe = cb.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = cb.index[workshop_name]\n      w_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if w_locs.size:\n          _move_to(w_locs[0].tolist())\n          actions.append(4)   # USE to craft at workshop\n\n  return actions", "env_interactions": 4, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:49:05.801570", "function_name": "make_arrow", "function_body": "  actions = []\n  state = env._current_state\n  grid = state.grid\n  world = env.world\n  cb = world.cookbook\n\n  # index of the target item \"stick\"\n  try:\n      goal_idx = cb.index[\"stick\"]\n  except Exception:\n      return actions\n\n  # primitive requirements for a stick (empty dict if stick is primitive)\n  needed_prims = cb.primitives_for(goal_idx)\n\n  # current agent position (x, y)\n  pos = list(state.pos)\n\n  # helper to move using Manhattan steps\n  def _move_to(target):\n      nonlocal pos, actions\n      tx, ty = target\n      # move in x direction (RIGHT=3, LEFT=2)\n      while pos[0] < tx:\n          actions.append(3)   # RIGHT\n          pos[0] += 1\n      while pos[0] > tx:\n          actions.append(2)   # LEFT\n          pos[0] -= 1\n      # move in y direction (DOWN=0, UP=1)\n      while pos[1] < ty:\n          actions.append(0)   # DOWN\n          pos[1] += 1\n      while pos[1] > ty:\n          actions.append(1)   # UP\n          pos[1] -= 1\n\n  # If stick itself is a primitive, just pick it up.\n  if not needed_prims:\n      locs = np.argwhere(grid[:, :, goal_idx] > 0)\n      if locs.size:\n          _move_to(locs[0].tolist())\n          actions.append(4)   # USE to pick up\n      return actions\n\n  # Collect each required primitive the required number of times.\n  for prim_idx, count in needed_prims.items():\n      # locate any cell containing this primitive\n      locs = np.argwhere(grid[:, :, prim_idx] > 0)\n      if not locs.size:\n          continue  # primitive not present; should not happen in a valid scenario\n      target = locs[0].tolist()\n      _move_to(target)\n      for _ in range(count):\n          actions.append(4)   # USE to pick up\n\n  # Move to the appropriate workshop (if the recipe specifies one) and craft the stick.\n  recipe = cb.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = cb.index[workshop_name]\n      w_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if w_locs.size:\n          _move_to(w_locs[0].tolist())\n          actions.append(4)   # USE to craft at workshop\n\n  return actions", "env_interactions": 4, "island_id": 1, "scores": {"3": 0.0}}
