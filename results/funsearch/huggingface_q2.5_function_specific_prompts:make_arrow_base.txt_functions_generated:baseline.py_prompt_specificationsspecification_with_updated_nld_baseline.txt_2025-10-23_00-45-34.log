{"timestamp": "2025-10-23T00:53:24.454113", "function_name": "make_arrow", "function_body": "  # Helper to move from current pos to a target cell using Manhattan moves.\n  def _move_to(cur_pos, target, act_seq):\n      x, y = cur_pos\n      tx, ty = target\n      # move in x direction\n      while x < tx:\n          act_seq.append(3)          # RIGHT\n          x += 1\n      while x > tx:\n          act_seq.append(2)          # LEFT\n          x -= 1\n      # move in y direction\n      while y < ty:\n          act_seq.append(0)          # DOWN\n          y += 1\n      while y > ty:\n          act_seq.append(1)          # UP\n          y -= 1\n      return (x, y)\n\n  # ------------------------------------------------------------\n  # 1. retrieve current state and goal information\n  # ------------------------------------------------------------\n  state = env._current_state                     # current CraftState\n  grid = state.grid                               # (W, H, n_kinds) one\u2011hot grid\n  cur_pos = state.pos                             # (x, y) tuple\n  goal_idx = env.task.goal                        # integer index of the desired item\n\n  # ------------------------------------------------------------\n  # 2. look up the recipe for the goal (stick)\n  # ------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)         # kind index of the required workshop\n  # ingredients without the special \"_at\" entry\n  ingredients = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  # ------------------------------------------------------------\n  # 3. collect all required primitive items\n  # ------------------------------------------------------------\n  actions = []\n\n  for ing_kind, count in ingredients.items():\n      for _ in range(count):\n          # locate a cell that currently contains the ingredient\n          locations = np.argwhere(grid[:, :, ing_kind] > 0)\n          if locations.size == 0:\n              # nothing left \u2013 break early (should not happen in a valid scenario)\n              break\n          # pick the closest location (Manhattan distance)\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          chosen_idx = int(np.argmin(dists))\n          target_loc = tuple(locations[chosen_idx].tolist())\n\n          # move to that location\n          cur_pos = _move_to(cur_pos, target_loc, actions)\n\n          # pick it up\n          actions.append(4)                     # USE\n          # after USE the item disappears from the grid; we keep the\n          # internal copy `grid` in sync for subsequent searches\n          grid[target_loc[0], target_loc[1], ing_kind] = 0\n\n  # ------------------------------------------------------------\n  # 4. go to the appropriate workshop and craft the stick\n  # ------------------------------------------------------------\n  if workshop_kind is not None:\n      # locate a workshop cell of the required type\n      ws_locs = np.argwhere(grid[:, :, workshop_kind] > 0)\n      if ws_locs.size > 0:\n          # again pick the nearest one\n          dists = np.abs(ws_locs[:, 0] - cur_pos[0]) + np.abs(ws_locs[:, 1] - cur_pos[1])\n          chosen_idx = int(np.argmin(dists))\n          workshop_loc = tuple(ws_locs[chosen_idx].tolist())\n\n          # move to the workshop\n          cur_pos = _move_to(cur_pos, workshop_loc, actions)\n\n          # craft the item\n          actions.append(4)                     # USE\n\n  # ------------------------------------------------------------\n  # 5. return the complete action list\n  # ------------------------------------------------------------\n  return actions", "env_interactions": 0, "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T00:53:25.735276", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Helper functions for navigation and interaction\n  # ----------------------------------------------------------------------\n  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  # Index of the target item \"stick\"\n  stick_idx = cookbook.index[\"stick\"]\n\n  # Primitive requirements for one stick\n  prim_req = cookbook.primitives_for(stick_idx)          # {prim_idx: count}\n  # Workshop where the stick must be crafted\n  workshop_idx = cookbook.recipes[stick_idx][\"_at\"]\n\n  # Action constants (match CraftLab action specs)\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n  DIR2MOVE = {\n      ACTION_DOWN:  (0, 1),\n      ACTION_UP:    (0, -1),\n      ACTION_LEFT:  (-1, 0),\n      ACTION_RIGHT: (1, 0),\n  }\n\n  # ----------------------------------------------------------------------\n  # Breadth\u2011first search returning a list of movement actions that brings\n  # the agent from `start` to any cell in `targets` (set of positions).\n  # The agent may only step on empty cells (no entity present in any layer).\n  # ----------------------------------------------------------------------\n  def bfs(start, targets):\n      from collections import deque\n      visited = {start}\n      queue = deque([(start, [])])\n      while queue:\n          (x, y), path = queue.popleft()\n          if (x, y) in targets:\n              return path\n          for act, (dx, dy) in DIR2MOVE.items():\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]):\n                  continue\n              # blocked if any kind occupies the cell\n              if np.any(state.grid[nx, ny, :]):\n                  continue\n              if (nx, ny) not in visited:\n                  visited.add((nx, ny))\n                  queue.append(((nx, ny), path + [act]))\n      return None  # unreachable\n\n  # ----------------------------------------------------------------------\n  # Move to a cell adjacent to a target entity (primitive or workshop)\n  # and ensure the agent faces the target when the final USE is issued.\n  # Returns the updated position and direction.\n  # ----------------------------------------------------------------------\n  def move_adjacent(target_idx, need_count, consume=True):\n      nonlocal pos, direction, actions, state\n      while need_count > 0:\n          # locate remaining instances of the target on the grid\n          cells = list(zip(*np.where(state.grid[:, :, target_idx] > 0)))\n          if not cells:\n              raise RuntimeError(\"Required entity not found on the map.\")\n          best_path, best_adj, best_cell = None, None, None\n          for cell in cells:\n              # candidate adjacent empty cells\n              adj = []\n              for act, (dx, dy) in DIR2MOVE.items():\n                  ax, ay = cell[0] + dx, cell[1] + dy\n                  if 0 <= ax < state.grid.shape[0] and 0 <= ay < state.grid.shape[1]:\n                      if not np.any(state.grid[ax, ay, :]):\n                          adj.append(((ax, ay), act))\n              if not adj:\n                  continue\n              # pick the adjacent cell whose direction points to the target\n              for (ax, ay), face_act in adj:\n                  path = bfs(pos, {(ax, ay)})\n                  if path is None:\n                      continue\n                  if best_path is None or len(path) < len(best_path):\n                      best_path, best_adj, best_cell, best_face = path, (ax, ay), cell, face_act\n          if best_path is None:\n              raise RuntimeError(\"Cannot reach required entity.\")\n          # execute the movement actions\n          for a in best_path:\n              actions.append(a)\n              dx, dy = DIR2MOVE[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n              direction = a\n          # after arriving, the facing direction is the direction we just moved.\n          # If this is not the direction that looks at the target, perform a\n          # small turn (move away and back) to set the correct orientation.\n          if direction != best_face:\n              # opposite direction\n              opp = {ACTION_DOWN: ACTION_UP,\n                     ACTION_UP: ACTION_DOWN,\n                     ACTION_LEFT: ACTION_RIGHT,\n                     ACTION_RIGHT: ACTION_LEFT}[best_face]\n              # ensure the opposite cell is free\n              ox, oy = pos[0] + DIR2MOVE[opp][0], pos[1] + DIR2MOVE[opp][1]\n              if (0 <= ox < state.grid.shape[0] and 0 <= oy < state.grid.shape[1]\n                      and not np.any(state.grid[ox, oy, :])):\n                  actions.append(opp)\n                  pos = (ox, oy)\n                  direction = opp\n              actions.append(best_face)\n              dx, dy = DIR2MOVE[best_face]\n              pos = (pos[0] + dx, pos[1] + dy)\n              direction = best_face\n          # finally, use the target\n          actions.append(ACTION_USE)\n          # optionally remove the entity from the grid (simulation for planning)\n          if consume:\n              state.grid[best_cell[0], best_cell[1], target_idx] = 0\n          need_count -= 1\n\n  # ----------------------------------------------------------------------\n  # Planning starts here\n  # ----------------------------------------------------------------------\n  actions = []\n  pos = tuple(state.pos)\n  direction = state.dir\n\n  # 1. Gather all primitive resources needed for a stick\n  for prim_idx, cnt in prim_req.items():\n      move_adjacent(prim_idx, cnt, consume=True)\n\n  # 2. Go to the appropriate workshop and craft the stick\n  move_adjacent(workshop_idx, 1, consume=False)   # do not delete workshop\n  # after reaching the workshop cell (adjacent + facing), issue USE to craft\n  actions.append(ACTION_USE)\n\n  return actions", "env_interactions": 0, "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-10-23T00:54:12.479293", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # helper: map action index to movement delta (row, col)\n  _ACTION_DELTAS = {\n      0: (1, 0),   # DOWN\n      1: (-1, 0),  # UP\n      2: (0, -1),  # LEFT\n      3: (0, 1),   # RIGHT\n  }\n\n  def _move_actions(start, goal):\n      \"\"\"Return a list of actions to move from start to goal using Manhattan moves.\"\"\"\n      y, x = start\n      gy, gx = goal\n      actions = []\n      while y < gy:\n          actions.append(0)  # DOWN\n          y += 1\n      while y > gy:\n          actions.append(1)  # UP\n          y -= 1\n      while x < gx:\n          actions.append(3)  # RIGHT\n          x += 1\n      while x > gx:\n          actions.append(2)  # LEFT\n          x -= 1\n      return actions\n\n  # ----------------------------------------------------------------------\n  # obtain world and goal information\n  # ----------------------------------------------------------------------\n  # env may be a CraftLab instance or a raw CraftScenario; try to locate the world\n  if hasattr(env, \"world\"):\n      world = env.world\n  elif hasattr(env, \"scenario\"):\n      world = env.scenario.world\n  else:\n      raise AttributeError(\"Cannot locate CraftWorld instance in the supplied env.\")\n\n  # goal name for a stick\n  goal_name = \"stick\"\n  goal_idx = world.cookbook.index.index(goal_name)\n\n  # ingredients (primitives) required to craft a stick\n  # dict {primitive_index: count}\n  needed = world.cookbook.primitives_for(goal_idx)\n\n  # current state for planning (we only need position and grid)\n  # CraftLab stores the current CraftState in _current_state\n  if hasattr(env, \"_current_state\"):\n      state = env._current_state\n  else:\n      # fallback: initialise a fresh state from the scenario\n      state = env.scenario.init()\n\n  cur_pos = tuple(state.pos)          # (row, col)\n  grid = state.grid                    # (H, W, n_kinds)\n\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # collect each primitive the required number of times\n  # ----------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          # locate any cell that currently holds the primitive\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(f\"Primitive {world.cookbook.index.get(prim_idx)} not found on the grid.\")\n          # pick the first occurrence (could be improved with nearest search)\n          py, px = prim_cells[0]\n\n          # find a neighboring empty cell that lets us approach from the correct direction\n          # we try the four directions; for each direction d we need the cell\n          # (py - dy, px - dx) to be empty, where (dy,dx) is the delta for action d\n          chosen_dir = None\n          target_cell = None\n          for d, (dy, dx) in _ACTION_DELTAS.items():\n              ny, nx = py - dy, px - dx\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  if not grid[ny, nx, :].any():          # empty cell\n                      chosen_dir = d\n                      target_cell = (ny, nx)\n                      break\n          if target_cell is None:\n              raise RuntimeError(\"No reachable empty neighbour around required primitive.\")\n\n          # move to the chosen neighbour\n          actions.extend(_move_actions(cur_pos, target_cell))\n          cur_pos = target_cell\n\n          # the last movement we performed was in direction `chosen_dir`,\n          # which means the agent now faces the primitive.\n          # use the primitive\n          actions.append(4)   # USE\n          # update our internal view of the grid: remove the primitive from the world\n          # (this is only for planning; the real env will handle it when we step)\n          grid[py, px, prim_idx] = 0\n          # after USE we remain on the neighbour cell, facing the same direction\n          # (position unchanged)\n\n  # ----------------------------------------------------------------------\n  # move to the appropriate workshop and craft the stick\n  # ----------------------------------------------------------------------\n  # the recipe dict contains a special key \"_at\" that tells us the workshop name\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      # locate a workshop cell\n      ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_cells.size == 0:\n          raise RuntimeError(f\"Workshop {workshop_name} not found on the grid.\")\n      wy, wx = ws_cells[0]\n\n      # find a neighbour cell that lets us face the workshop\n      chosen_dir = None\n      target_cell = None\n      for d, (dy, dx) in _ACTION_DELTAS.items():\n          ny, nx = wy - dy, wx - dx\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not grid[ny, nx, :].any():\n                  chosen_dir = d\n                  target_cell = (ny, nx)\n                  break\n      if target_cell is None:\n          raise RuntimeError(\"No reachable empty neighbour around workshop.\")\n\n      # move to the neighbour\n      actions.extend(_move_actions(cur_pos, target_cell))\n      cur_pos = target_cell\n\n      # now we are facing the workshop; USE to craft the stick\n      actions.append(4)   # USE\n\n  # return the complete action list\n  return actions", "env_interactions": 5, "island_id": 7, "scores": {"3": 0.0}}
