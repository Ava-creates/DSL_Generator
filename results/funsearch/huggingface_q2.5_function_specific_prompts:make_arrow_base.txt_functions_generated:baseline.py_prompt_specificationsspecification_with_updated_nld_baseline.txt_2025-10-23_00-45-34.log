{"timestamp": "2025-10-23T01:40:39.742855", "function_name": "make_arrow", "function_body": "  def _move_to(cur_pos, target, act_seq):\n      x, y = cur_pos\n      tx, ty = target\n      while x < tx:\n          act_seq.append(3)  # RIGHT\n          x += 1\n      while x > tx:\n          act_seq.append(2)  # LEFT\n          x -= 1\n      while y < ty:\n          act_seq.append(0)  # DOWN\n          y += 1\n      while y > ty:\n          act_seq.append(1)  # UP\n          y -= 1\n      return (x, y)\n\n  # Get current state information\n  state = env._current_state\n  grid = state.grid.copy()\n  cur_pos = state.pos\n  goal_idx = env.task.goal\n\n  # Look up the recipe for the goal (may be empty if primitive)\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n  ingredients = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  actions = []\n\n  # If there are ingredients, collect them first\n  for ing_kind, count in ingredients.items():\n      for _ in range(count):\n          locations = np.argwhere(grid[:, :, ing_kind] > 0)\n          if locations.size == 0:\n              # No more of this ingredient on the map; stop trying\n              break\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          chosen_idx = int(np.argmin(dists))\n          target_loc = tuple(locations[chosen_idx].tolist())\n\n          cur_pos = _move_to(cur_pos, target_loc, actions)\n          actions.append(4)  # USE to pick up\n          grid[target_loc[0], target_loc[1], ing_kind] = 0\n\n  # If the goal itself is a primitive (no recipe), just pick it up\n  if not ingredients and workshop_kind is None:\n      locations = np.argwhere(grid[:, :, goal_idx] > 0)\n      if locations.size > 0:\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          chosen_idx = int(np.argmin(dists))\n          target_loc = tuple(locations[chosen_idx].tolist())\n          cur_pos = _move_to(cur_pos, target_loc, actions)\n          actions.append(4)  # USE to pick up\n      return actions\n\n  # Move to workshop (if required) and craft the goal\n  if workshop_kind is not None:\n      ws_locs = np.argwhere(grid[:, :, workshop_kind] > 0)\n      if ws_locs.size > 0:\n          dists = np.abs(ws_locs[:, 0] - cur_pos[0]) + np.abs(ws_locs[:, 1] - cur_pos[1])\n          chosen_idx = int(np.argmin(dists))\n          workshop_loc = tuple(ws_locs[chosen_idx].tolist())\n          cur_pos = _move_to(cur_pos, workshop_loc, actions)\n          actions.append(4)  # USE to craft\n\n  return actions", "env_interactions": 0, "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T01:40:41.033220", "function_name": "make_arrow", "function_body": "  def _move_to(cur_pos, target, act_seq):\n      x, y = cur_pos\n      tx, ty = target\n      while x < tx:\n          act_seq.append(3)  # RIGHT\n          x += 1\n      while x > tx:\n          act_seq.append(2)  # LEFT\n          x -= 1\n      while y < ty:\n          act_seq.append(0)  # DOWN\n          y += 1\n      while y > ty:\n          act_seq.append(1)  # UP\n          y -= 1\n      return (x, y)\n\n  state = env._current_state\n  grid = state.grid.copy()\n  cur_pos = state.pos\n  goal_idx = env.task.goal\n\n  # Look up recipe for the goal item\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n  ingredients = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  actions = []\n\n  # If there is a recipe, collect its ingredients first\n  for ing_kind, count in ingredients.items():\n      for _ in range(count):\n          locations = np.argwhere(grid[:, :, ing_kind] > 0)\n          if locations.size == 0:\n              # ingredient not found; abort collection\n              break\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          chosen_idx = int(np.argmin(dists))\n          target_loc = tuple(locations[chosen_idx].tolist())\n          cur_pos = _move_to(cur_pos, target_loc, actions)\n          actions.append(4)                     # USE to pick up\n          grid[target_loc[0], target_loc[1], ing_kind] = 0\n\n  # If the goal has no recipe (i.e., it is a primitive), just collect it directly\n  if not ingredients and workshop_kind is None:\n      locations = np.argwhere(grid[:, :, goal_idx] > 0)\n      if locations.size > 0:\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          chosen_idx = int(np.argmin(dists))\n          target_loc = tuple(locations[chosen_idx].tolist())\n          cur_pos = _move_to(cur_pos, target_loc, actions)\n          actions.append(4)                     # USE to pick up\n\n  # Finally, move to the workshop (if any) and craft the item\n  if workshop_kind is not None:\n      ws_locs = np.argwhere(grid[:, :, workshop_kind] > 0)\n      if ws_locs.size > 0:\n          dists = np.abs(ws_locs[:, 0] - cur_pos[0]) + np.abs(ws_locs[:, 1] - cur_pos[1])\n          chosen_idx = int(np.argmin(dists))\n          workshop_loc = tuple(ws_locs[chosen_idx].tolist())\n          cur_pos = _move_to(cur_pos, workshop_loc, actions)\n          actions.append(4)                     # USE to craft\n\n  return actions", "env_interactions": 0, "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T01:41:01.082448", "function_name": "make_arrow", "function_body": "  # Action indices as defined in CraftLab.action_specs\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions from start to goal using\n      horizontal then vertical moves (ignores obstacles).\"\"\"\n      x, y = start\n      gx, gy = goal\n      actions = []\n      while x < gx:\n          actions.append(ACTION_RIGHT)\n          x += 1\n      while x > gx:\n          actions.append(ACTION_LEFT)\n          x -= 1\n      while y < gy:\n          actions.append(ACTION_DOWN)\n          y += 1\n      while y > gy:\n          actions.append(ACTION_UP)\n          y -= 1\n      return actions\n\n  def nearest_position(positions, reference):\n      \"\"\"Pick the position from *positions* with smallest Manhattan distance\n      to *reference*.\"\"\"\n      if len(positions) == 0:\n          return None\n      ref = np.array(reference)\n      dists = np.sum(np.abs(positions - ref), axis=1)\n      return tuple(positions[np.argmin(dists)])\n\n  # ------------------------------------------------------------------\n  # Gather current state information\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n\n  # ------------------------------------------------------------------\n  # Identify goal (stick)\n  # ------------------------------------------------------------------\n  goal_name = \"stick\"\n  try:\n      goal_idx = env.world.cookbook.index[goal_name]\n  except Exception:\n      # Goal not present in index \u2013 return empty plan\n      return []\n\n  # ------------------------------------------------------------------\n  # 1) Collect needed primitives (if any)\n  # ------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  plan_actions = []\n\n  for prim_idx, needed_cnt in primitives_needed.items():\n      while inventory[prim_idx] < needed_cnt:\n          # locate cells containing the primitive\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # nothing left on map \u2013 abort planning\n              return plan_actions\n          target = nearest_position(prim_cells, pos)\n\n          # move to the primitive\n          plan_actions.extend(manhattan_path(pos, target))\n          pos = target\n\n          # pick it up\n          plan_actions.append(ACTION_USE)\n\n          # simulate pick\u2011up locally for further planning\n          inventory[prim_idx] += 1\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # ------------------------------------------------------------------\n  # 2) Go to workshop (if recipe requires one) and craft stick\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      try:\n          workshop_idx = env.world.cookbook.index[workshop_name]\n      except Exception:\n          return plan_actions\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          # no workshop visible \u2013 cannot craft\n          return plan_actions\n      wcell = tuple(workshop_cells[0])\n\n      # find a free adjacent cell to stand on\n      neighbours = [(wcell[0] + dx, wcell[1] + dy) for dx, dy in\n                    [(1, 0), (-1, 0), (0, 1), (0, -1)]]\n      stand_pos = None\n      for nx, ny in neighbours:\n          if (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and\n                  grid[nx, ny, :].sum() == 0):\n              stand_pos = (nx, ny)\n              break\n      if stand_pos is None:\n          stand_pos = wcell  # fallback: stand on the workshop itself\n\n      # move to the chosen standing position\n      plan_actions.extend(manhattan_path(pos, stand_pos))\n      pos = stand_pos\n\n      # use the workshop to craft the stick\n      plan_actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # Return the full action list\n  # ------------------------------------------------------------------\n  return plan_actions", "env_interactions": 5, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T01:41:02.432708", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # Action indices as defined in CraftLab.action_specs\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions from start to goal using\n      horizontal then vertical moves (ignores obstacles).\"\"\"\n      x, y = start\n      gx, gy = goal\n      actions = []\n      while x < gx:\n          actions.append(ACTION_RIGHT)\n          x += 1\n      while x > gx:\n          actions.append(ACTION_LEFT)\n          x -= 1\n      while y < gy:\n          actions.append(ACTION_DOWN)\n          y += 1\n      while y > gy:\n          actions.append(ACTION_UP)\n          y -= 1\n      return actions\n\n  def nearest_position(positions, reference):\n      \"\"\"Pick the position from *positions* with smallest Manhattan distance\n      to *reference*.\"\"\"\n      if len(positions) == 0:\n          return None\n      ref = np.array(reference)\n      dists = np.sum(np.abs(positions - ref), axis=1)\n      return tuple(positions[np.argmin(dists)])\n\n  # ------------------------------------------------------------------\n  # Gather current state information\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n\n  # ------------------------------------------------------------------\n  # Identify goal (stick)\n  # ------------------------------------------------------------------\n  goal_name = \"stick\"\n  try:\n      goal_idx = env.world.cookbook.index[goal_name]\n  except Exception:\n      # Goal not present in index \u2013 nothing to do\n      return []\n\n  plan_actions = []\n\n  # ------------------------------------------------------------------\n  # 1) Collect needed primitives (if any)\n  # ------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  for prim_idx, needed_cnt in primitives_needed.items():\n      while inventory[prim_idx] < needed_cnt:\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # No more primitives available; abort planning\n              return plan_actions\n          target = nearest_position(prim_cells, pos)\n\n          # Move to the primitive\n          plan_actions.extend(manhattan_path(pos, target))\n          pos = target\n\n          # Pick it up\n          plan_actions.append(ACTION_USE)\n\n          # Simulate pickup locally\n          inventory[prim_idx] += 1\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # ------------------------------------------------------------------\n  # 2) If the stick itself is a primitive, just collect it\n  # ------------------------------------------------------------------\n  if inventory[goal_idx] == 0:\n      stick_cells = np.argwhere(grid[:, :, goal_idx] > 0)\n      if stick_cells.size > 0:\n          target = nearest_position(stick_cells, pos)\n          plan_actions.extend(manhattan_path(pos, target))\n          pos = target\n          plan_actions.append(ACTION_USE)\n          # Update inventory simulation (not strictly needed afterwards)\n          inventory[goal_idx] += 1\n          grid[target[0], target[1], goal_idx] -= 1\n\n  # ------------------------------------------------------------------\n  # 3) If a workshop is required for the stick, move there and craft\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      try:\n          workshop_idx = env.world.cookbook.index[workshop_name]\n      except Exception:\n          return plan_actions\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          return plan_actions\n      wcell = tuple(workshop_cells[0])\n\n      # Find a free adjacent cell to stand on\n      neighbours = [(wcell[0] + dx, wcell[1] + dy) for dx, dy in\n                    [(1, 0), (-1, 0), (0, 1), (0, -1)]]\n      stand_pos = None\n      for nx, ny in neighbours:\n          if (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and\n                  grid[nx, ny, :].sum() == 0):\n              stand_pos = (nx, ny)\n              break\n      if stand_pos is None:\n          stand_pos = wcell  # fallback to standing on the workshop\n\n      # Move to the chosen standing position\n      plan_actions.extend(manhattan_path(pos, stand_pos))\n      pos = stand_pos\n\n      # Use the workshop to craft the stick\n      plan_actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # Return the full action list\n  # ------------------------------------------------------------------\n  return plan_actions", "env_interactions": 5, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T01:41:43.455144", "function_name": "make_arrow", "function_body": "  env.reset()\n  actions = []\n\n  # Shortcut references\n  world = env.world\n  cb = world.cookbook\n  state = env._current_state\n\n  # Goal: stick\n  stick_idx = cb.index['stick']\n  recipe = cb.recipes.get(stick_idx, {})\n\n  # Determine workshop (if any)\n  workshop_name = recipe.get('_at')\n  workshop_idx = cb.index[workshop_name] if workshop_name else None\n\n  # Primitive requirements (exclude the workshop key)\n  needed = {int(k): int(v) for k, v in recipe.items() if k != '_at'}\n\n  # Direction vectors for actions: 0:DOWN, 1:UP, 2:LEFT, 3:RIGHT\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n\n  from collections import deque\n\n  def bfs_to_adj(target):\n      \"\"\"BFS to a cell adjacent to *target*; returns path of actions and final (x,y,dir).\"\"\"\n      start = (state.pos[0], state.pos[1], state.dir)\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      w, h = state.grid.shape[0], state.grid.shape[1]\n\n      while q:\n          (x, y, d), path = q.popleft()\n          # Adjacent check (Manhattan distance 1)\n          if abs(x - target[0]) + abs(y - target[1]) == 1:\n              return path, (x, y, d)\n\n          for a in range(4):\n              nd = a\n              nx, ny = x + DIRS[a][0], y + DIRS[a][1]\n\n              # Stay inside bounds\n              if not (0 <= nx < w and 0 <= ny < h):\n                  nx, ny = x, y\n              # Blocked cells keep the agent in place\n              if state.grid[nx, ny, :].any():\n                  nx, ny = x, y\n\n              nxt = (nx, ny, nd)\n              if nxt not in visited:\n                  visited.add(nxt)\n                  q.append((nxt, path + [a]))\n      return None, None\n\n  def find_entities(kind_idx):\n      \"\"\"Return list of (x, y) where *kind_idx* appears on the grid.\"\"\"\n      pts = np.argwhere(state.grid[:, :, kind_idx] > 0)\n      return [(int(p[0]), int(p[1])) for p in pts]\n\n  # ------------------------------------------------------------------\n  # Collect required primitives (or the stick itself if no recipe)\n  # ------------------------------------------------------------------\n  # If there is no recipe (stick is primitive), treat stick as needed primitive\n  if not needed:\n      needed = {stick_idx: 1}\n      workshop_idx = None  # no crafting needed\n\n  for kind_idx, count in needed.items():\n      for _ in range(count):\n          locations = find_entities(kind_idx)\n          if not locations:\n              # Nothing left on the map \u2013 assume we already have it in inventory\n              continue\n\n          # Choose the closest location by BFS path length\n          best_path, best_end, best_target = None, None, None\n          min_len = 10 ** 9\n          for loc in locations:\n              path, end_state = bfs_to_adj(loc)\n              if path is not None and len(path) < min_len:\n                  min_len = len(path)\n                  best_path, best_end, best_target = path, end_state, loc\n\n          if best_path is None:\n              continue  # safety\n\n          # Execute movement actions\n          for a in best_path:\n              actions.append(a)\n              env.step(a)\n              state = env._current_state\n\n          # Face the target cell (turn without moving)\n          x, y, _ = best_end\n          tx, ty = best_target\n          if tx - x == 1:\n              turn = 3          # RIGHT\n          elif tx - x == -1:\n              turn = 2          # LEFT\n          elif ty - y == 1:\n              turn = 0          # DOWN\n          elif ty - y == -1:\n              turn = 1          # UP\n          else:\n              turn = None\n\n          if turn is not None and state.dir != turn:\n              actions.append(turn)\n              env.step(turn)\n              state = env._current_state\n\n          # Use action to pick up the primitive (or the stick itself)\n          actions.append(4)      # USE\n          env.step(4)\n          state = env._current_state\n\n  # ------------------------------------------------------------------\n  # If a workshop is required, move to it and craft the stick\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_locs = find_entities(workshop_idx)\n      if ws_locs:\n          best_path, best_end, best_target = None, None, None\n          min_len = 10 ** 9\n          for loc in ws_locs:\n              path, end_state = bfs_to_adj(loc)\n              if path is not None and len(path) < min_len:\n                  min_len = len(path)\n                  best_path, best_end, best_target = path, end_state, loc\n\n          if best_path is not None:\n              for a in best_path:\n                  actions.append(a)\n                  env.step(a)\n                  state = env._current_state\n\n              # Face the workshop\n              x, y, _ = best_end\n              tx, ty = best_target\n              if tx - x == 1:\n                  turn = 3\n              elif tx - x == -1:\n                  turn = 2\n              elif ty - y == 1:\n                  turn = 0\n              elif ty - y == -1:\n                  turn = 1\n              else:\n                  turn = None\n\n              if turn is not None and state.dir != turn:\n                  actions.append(turn)\n                  env.step(turn)\n                  state = env._current_state\n\n              # Use action to craft the stick\n              actions.append(4)   # USE\n              env.step(4)\n              state = env._current_state\n\n  return actions", "env_interactions": 6, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T01:41:44.779087", "function_name": "make_arrow", "function_body": "  env.reset()\n  actions = []\n\n  world = env.world\n  cb = world.cookbook\n  state = env._current_state\n\n  import numpy as np\n  from collections import deque\n\n  # Index of the target item (stick) and its recipe\n  stick_idx = cb.index['stick']\n  recipe = cb.recipes[stick_idx]\n\n  # Workshop required for crafting (if any)\n  workshop_name = recipe.get('_at')\n  workshop_idx = cb.index[workshop_name] if workshop_name else None\n\n  # Primitive requirements (ignore the '_at' entry)\n  needed = {int(k): int(v) for k, v in recipe.items() if k != '_at'}\n\n  # Action direction vectors: 0=DOWN, 1=UP, 2=LEFT, 3=RIGHT\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n\n  def bfs_to_adj(target):\n      \"\"\"Find a sequence of move actions that brings the agent adjacent to *target*.\"\"\"\n      start = (state.pos[0], state.pos[1], state.dir)\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      w, h = state.grid.shape[0], state.grid.shape[1]\n\n      while q:\n          (x, y, d), path = q.popleft()\n          # Adjacent?\n          if abs(x - target[0]) + abs(y - target[1]) == 1:\n              return path, (x, y, d)\n\n          for a in range(4):\n              nd = a\n              nx, ny = x + DIRS[a][0], y + DIRS[a][1]\n\n              # Stay inside bounds\n              if not (0 <= nx < w and 0 <= ny < h):\n                  nx, ny = x, y\n              # Blocked cells keep the agent in place\n              if state.grid[nx, ny, :].any():\n                  nx, ny = x, y\n\n              nxt = (nx, ny, nd)\n              if nxt not in visited:\n                  visited.add(nxt)\n                  q.append((nxt, path + [a]))\n      return None, None  # Unreachable (should not happen)\n\n  def find_entities(kind_idx):\n      \"\"\"Return a list of (x, y) positions where *kind_idx* is present.\"\"\"\n      pts = np.argwhere(state.grid[:, :, kind_idx] > 0)\n      return [(int(p[0]), int(p[1])) for p in pts]\n\n  # ----------------------------------------------------------------------\n  # Collect all required primitive items\n  # ----------------------------------------------------------------------\n  for kind_idx, count in needed.items():\n      for _ in range(count):\n          locations = find_entities(kind_idx)\n          if not locations:\n              # Assume we already have it in inventory\n              continue\n\n          best_path = best_end = best_target = None\n          min_len = 10 ** 9\n          for loc in locations:\n              path, end_state = bfs_to_adj(loc)\n              if path is not None and len(path) < min_len:\n                  min_len = len(path)\n                  best_path, best_end, best_target = path, end_state, loc\n\n          if best_path is None:\n              continue  # safety\n\n          # Move to the chosen primitive\n          for a in best_path:\n              actions.append(a)\n              env.step(a)\n              state = env._current_state\n\n          # Turn to face the primitive\n          x, y, _ = best_end\n          tx, ty = best_target\n          if tx - x == 1:\n              turn = 3          # RIGHT\n          elif tx - x == -1:\n              turn = 2          # LEFT\n          elif ty - y == 1:\n              turn = 0          # DOWN\n          elif ty - y == -1:\n              turn = 1          # UP\n          else:\n              turn = None\n\n          if turn is not None and state.dir != turn:\n              actions.append(turn)\n              env.step(turn)\n              state = env._current_state\n\n          # Pick up the primitive\n          actions.append(4)      # USE\n          env.step(4)\n          state = env._current_state\n\n  # ----------------------------------------------------------------------\n  # Move to the workshop and craft the stick\n  # ----------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_locs = find_entities(workshop_idx)\n      if ws_locs:\n          best_path = best_end = best_target = None\n          min_len = 10 ** 9\n          for loc in ws_locs:\n              path, end_state = bfs_to_adj(loc)\n              if path is not None and len(path) < min_len:\n                  min_len = len(path)\n                  best_path, best_end, best_target = path, end_state, loc\n\n          if best_path is not None:\n              for a in best_path:\n                  actions.append(a)\n                  env.step(a)\n                  state = env._current_state\n\n              # Face the workshop\n              x, y, _ = best_end\n              tx, ty = best_target\n              if tx - x == 1:\n                  turn = 3\n              elif tx - x == -1:\n                  turn = 2\n              elif ty - y == 1:\n                  turn = 0\n              elif ty - y == -1:\n                  turn = 1\n              else:\n                  turn = None\n\n              if turn is not None and state.dir != turn:\n                  actions.append(turn)\n                  env.step(turn)\n                  state = env._current_state\n\n              # Craft the stick\n              actions.append(4)  # USE\n              env.step(4)\n              state = env._current_state\n\n  return actions", "env_interactions": 6, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T01:42:09.331141", "function_name": "make_arrow", "function_body": "  \"\"\"Plan actions to craft a stick in the given CraftLab environment.\"\"\"\n  # Action constants (fallback to default ordering if spec dict missing)\n  specs = env.action_specs()\n  DOWN = specs.get(\"DOWN\", 0)\n  UP = specs.get(\"UP\", 1)\n  LEFT = specs.get(\"LEFT\", 2)\n  RIGHT = specs.get(\"RIGHT\", 3)\n  USE = specs.get(\"USE\", 4)\n\n  # Obtain current state (reset if needed)\n  try:\n      state = env._current_state\n  except AttributeError:\n      env.reset()\n      state = env._current_state\n\n  # Index of the target item \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      return []\n\n  # Primitives required to craft the stick (empty if already primitive)\n  needed = env.world.cookbook.primitives_for(stick_idx)\n\n  # Helper: locate all cells containing a given kind index\n  def locate(kind_idx):\n      xs, ys = np.where(state.grid[:, :, kind_idx] > 0)\n      return list(zip(xs.tolist(), ys.tolist()))\n\n  # Helper: simple Manhattan path (ignores obstacles)\n  def manhattan_path(start, target):\n      actions = []\n      x, y = start\n      tx, ty = target\n      while x < tx:\n          actions.append(DOWN); x += 1\n      while x > tx:\n          actions.append(UP);   x -= 1\n      while y < ty:\n          actions.append(RIGHT); y += 1\n      while y > ty:\n          actions.append(LEFT);  y -= 1\n      return actions\n\n  plan = []\n  cur_pos = state.pos\n\n  # ------------------------------------------------------------------\n  # 1. Collect each required primitive.\n  # ------------------------------------------------------------------\n  for prim_idx, req_cnt in needed.items():\n      while state.inventory[prim_idx] < req_cnt:\n          locations = locate(prim_idx)\n          if not locations:\n              # Primitive not present in the world \u2013 abort planning.\n              return plan\n\n          # Choose the nearest primitive (Manhattan distance).\n          distances = [\n              abs(px - cur_pos[0]) + abs(py - cur_pos[1]) for (px, py) in locations\n          ]\n          target = locations[int(np.argmin(distances))]\n\n          # Move to a cell adjacent to the target (prefer the cell above it).\n          adj = (target[0] - 1, target[1]) if target[0] > 0 else target\n          move_actions = manhattan_path(cur_pos, adj)\n          plan.extend(move_actions)\n          cur_pos = adj\n\n          # Pick up the primitive.\n          plan.append(USE)\n\n          # Update simulated inventory so the loop condition stays correct.\n          state.inventory[prim_idx] += 1\n\n  # ------------------------------------------------------------------\n  # 2. Go to the required workshop (if any) before crafting.\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  workshop_idx = recipe.get(\"_at\")\n  if workshop_idx is not None:\n      ws_locations = locate(workshop_idx)\n      if ws_locations:\n          distances = [\n              abs(px - cur_pos[0]) + abs(py - cur_pos[1]) for (px, py) in ws_locations\n          ]\n          ws_target = ws_locations[int(np.argmin(distances))]\n          move_actions = manhattan_path(cur_pos, ws_target)\n          plan.extend(move_actions)\n          cur_pos = ws_target\n\n  # ------------------------------------------------------------------\n  # 3. Perform the final crafting action.\n  # ------------------------------------------------------------------\n  plan.append(USE)\n\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": -1}}
