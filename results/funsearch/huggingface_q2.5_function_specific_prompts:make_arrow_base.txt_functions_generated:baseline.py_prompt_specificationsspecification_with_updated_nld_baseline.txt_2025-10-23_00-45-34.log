\n  # Helper: generate a simple Manhattan path (greedy) from cur to target\n  # ----------------------------------------------------------------------\n  def path_to(cur, target):\n      x, y = cur\n      tx, ty = target\n      path = []\n      while (x, y) != (tx, ty):\n          if x < tx:\n              path.append(RIGHT)\n              x += 1\n          elif x > tx:\n              path.append(LEFT)\n              x -= 1\n          elif y < ty:\n              path.append(DOWN)\n              y += 1\n          elif y > ty:\n              path.append(UP)\n              y -= 1\n      return path, (x, y)\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive the needed number of times\n  # ----------------------------------------------------------------------\n  for kind_idx, needed in primitive_needs.items():\n      while needed > 0:\n          target = find_closest(kind_idx, cur_pos)\n          if target is None:\n              # No more of this primitive on the map \u2013 abort planning\n              return actions\n          move_actions, cur_pos = path_to(cur_pos, target)\n          actions.extend(move_actions)\n          actions.append(USE)   # pick up / use the primitive\n\n          # Update local grid copy to reflect the collection\n          grid[target[0], target[1], kind_idx] = max(\n              0, grid[target[0], target[1], kind_idx] - 1\n          )\n          needed -= 1\n\n  # ----------------------------------------------------------------------\n  # If a workshop is required, move to it and craft the stick\n  # ----------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_target = find_closest(workshop_idx, cur_pos)\n      if ws_target is not None:\n          move_actions, cur_pos = path_to(cur_pos, ws_target)\n          actions.extend(move_actions)\n          actions.append(USE)   # craft stick at the workshop\n\n  return actions", "env_interactions": 2, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:09:27.252414", "function_name": "make_arrow", "function_body": "  # Action indices\n  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act.get(\"DOWN\", 0),\n      act.get(\"UP\", 1),\n      act.get(\"LEFT\", 2),\n      act.get(\"RIGHT\", 3),\n      act.get(\"USE\", 4),\n  )\n\n  # Snapshot of current state (do not modify the env)\n  state = env._current_state\n  grid = state.grid.copy()                 # (W, H, n_kinds)\n  cur_pos = tuple(state.pos)               # (x, y)\n\n  # Index of the goal item \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n      if stick_idx is None:\n          return []   # stick not defined in the world\n\n  # Determine primitive requirements for a stick\n  recipe = env.world.cookbook.primitives_for(stick_idx)   # dict {kind_idx: count} possibly with non\u2011int keys\n  primitive_needs = {k: v for k, v in recipe.items() if isinstance(k, int)}\n\n  # If the stick itself is a primitive (no recipe), we need to collect one stick\n  if not primitive_needs:\n      primitive_needs = {stick_idx: 1}\n\n  # Detect workshop requirement (non\u2011int key in recipe)\n  workshop_idx = None\n  for k, v in recipe.items():\n      if not isinstance(k, int):\n          workshop_idx = v if isinstance(v, int) else None\n          break\n\n  actions = []\n\n  # Helper: find the closest cell that still has at least one of the given kind\n  def find_closest(kind_idx, cur):\n      positions = np.argwhere(grid[:, :, kind_idx] > 0)\n      if positions.shape[0] == 0:\n          return None\n      dists = np.sum(np.abs(positions - np.array(cur)), axis=1)\n      nearest = positions[np.argmin(dists)]\n      return tuple(nearest.tolist())\n\n  # Helper: generate a simple Manhattan path (greedy) from cur to target\n  def path_to(cur, target):\n      x, y = cur\n      tx, ty = target\n      path = []\n      while (x, y) != (tx, ty):\n          if x < tx:\n              path.append(RIGHT)\n              x += 1\n          elif x > tx:\n              path.append(LEFT)\n              x -= 1\n          elif y < ty:\n              path.append(DOWN)\n              y += 1\n          elif y > ty:\n              path.append(UP)\n              y -= 1\n      return path, (x, y)\n\n  # Collect each required primitive the needed number of times\n  for kind_idx, needed in primitive_needs.items():\n      while needed > 0:\n          target = find_closest(kind_idx, cur_pos)\n          if target is None:\n              return actions  # cannot find required primitive\n          move_actions, cur_pos = path_to(cur_pos, target)\n          actions.extend(move_actions)\n          actions.append(USE)   # pick up the primitive\n\n          # Update local grid copy to reflect the collection\n          grid[target[0], target[1], kind_idx] = max(\n              0, grid[target[0], target[1], kind_idx] - 1\n          )\n          needed -= 1\n\n  # If a workshop is required, move to it and craft the stick\n  if workshop_idx is not None:\n      ws_target = find_closest(workshop_idx, cur_pos)\n      if ws_target is not None:\n          move_actions, cur_pos = path_to(cur_pos, ws_target)\n          actions.extend(move_actions)\n          actions.append(USE)   # craft stick at the workshop\n\n  return actions", "env_interactions": 2, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:09:54.165461", "function_name": "make_arrow", "function_body": "", "env_interactions": 0, "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-10-23T04:09:55.468248", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n  stick_idx = cookbook.index['stick']\n\n  # If we already have a stick in inventory, nothing to do.\n  if state.inventory[stick_idx] > 0:\n      return []\n\n  actions = []\n  cur_pos = state.pos\n\n  # ----- helper utilities -----\n  def _move_to(tx, ty, pos, act_list):\n      x, y = pos\n      while x < tx:\n          act_list.append(3)   # RIGHT\n          x += 1\n      while x > tx:\n          act_list.append(2)   # LEFT\n          x -= 1\n      while y < ty:\n          act_list.append(0)   # DOWN\n          y += 1\n      while y > ty:\n          act_list.append(1)   # UP\n          y -= 1\n      return (x, y)\n\n  def _nearest(kind_idx, cur):\n      positions = np.argwhere(state.grid[:, :, kind_idx] > 0)\n      if positions.size == 0:\n          return None\n      dists = np.abs(positions[:, 0] - cur[0]) + np.abs(positions[:, 1] - cur[1])\n      best = positions[dists.argmin()]\n      return (int(best[0]), int(best[1]))\n\n  def _go_and_pick(kind_idx, cur, act_list):\n      target = _nearest(kind_idx, cur)\n      if target is None:\n          return cur, False\n      cur = _move_to(target[0], target[1], cur, act_list)\n      act_list.append(4)               # USE / pick up / interact\n      return cur, True\n  # -----------------------------\n\n  # ----- Primitive case -----\n  if stick_idx in cookbook.primitives:\n      cur_pos, ok = _go_and_pick(stick_idx, cur_pos, actions)\n      return actions if ok else []\n\n  # ----- Crafted case -----\n  recipe = cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get('_at', None)\n\n  # Collect all non\u2011workshop ingredients.\n  for ing_key, cnt in recipe.items():\n      if ing_key == '_at':\n          continue\n      ing_idx = ing_key if isinstance(ing_key, int) else cookbook.index[ing_key]\n      for _ in range(cnt):\n          cur_pos, ok = _go_and_pick(ing_idx, cur_pos, actions)\n          if not ok:\n              return []                     # Missing ingredient.\n\n  # Move to workshop (if required) before crafting.\n  if workshop_name is not None:\n      ws_idx = cookbook.index[workshop_name]\n      cur_pos, ok = _go_and_pick(ws_idx, cur_pos, actions)\n      if not ok:\n          return []                         # Workshop not found.\n\n  # Finally, craft the stick.\n  actions.append(4)                           # USE to craft\n  return actions", "env_interactions": 5, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:10:10.494293", "function_name": "make_arrow", "function_body": "  actions = []\n  state = env._current_state\n  grid = state.grid\n  world = env.world\n  cb = world.cookbook\n\n  # index of the target item \"stick\"\n  try:\n      goal_idx = cb.index[\"stick\"]\n  except Exception:\n      return actions\n\n  # primitives (and counts) required to craft a stick; empty if stick is primitive\n  needed_prims = cb.primitives_for(goal_idx)\n\n  # current agent position (x, y)\n  pos = list(state.pos)\n\n  # helper to move to a target cell using Manhattan moves\n  def _move_to(target):\n      nonlocal pos, actions\n      tx, ty = target\n      while pos[0] < tx:\n          actions.append(3)   # RIGHT\n          pos[0] += 1\n      while pos[0] > tx:\n          actions.append(2)   # LEFT\n          pos[0] -= 1\n      while pos[1] < ty:\n          actions.append(0)   # DOWN\n          pos[1] += 1\n      while pos[1] > ty:\n          actions.append(1)   # UP\n          pos[1] -= 1\n\n  # If stick is a primitive, just pick it up.\n  if not needed_prims:\n      locs = np.argwhere(grid[:, :, goal_idx] > 0)\n      if locs.size:\n          _move_to(locs[0].tolist())\n          actions.append(4)   # USE to pick up the stick\n      return actions\n\n  # Collect each required primitive.\n  for prim_idx, count in needed_prims.items():\n      locs = np.argwhere(grid[:, :, prim_idx] > 0)\n      if not locs.size:\n          continue  # primitive not present; should not happen in valid scenarios\n      target = locs[0].tolist()\n      _move_to(target)\n      for _ in range(count):\n          actions.append(4)   # USE to pick up one unit of the primitive\n\n  # Move to the appropriate workshop (if any) and craft the stick.\n  recipe = cb.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = cb.index[workshop_name]\n      w_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if w_locs.size:\n          _move_to(w_locs[0].tolist())\n          actions.append(4)   # USE to craft at the workshop\n\n  return actions", "env_interactions": 4, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:10:11.792025", "function_name": "make_arrow", "function_body": "  actions = []\n  state = env._current_state\n  grid = state.grid\n  world = env.world\n  cb = world.cookbook\n\n  # index of the target item \"stick\"\n  try:\n      goal_idx = cb.index[\"stick\"]\n  except Exception:\n      return actions\n\n  # primitives (and required counts) for the stick\n  needed_prims = cb.primitives_for(goal_idx)\n\n  # current agent position (x, y)\n  pos = list(state.pos)\n\n  # helper to move to a target cell using Manhattan moves\n  def _move_to(target):\n      nonlocal pos, actions\n      tx, ty = target\n      while pos[0] < tx:\n          actions.append(3)   # RIGHT\n          pos[0] += 1\n      while pos[0] > tx:\n          actions.append(2)   # LEFT\n          pos[0] -= 1\n      while pos[1] < ty:\n          actions.append(0)   # DOWN\n          pos[1] += 1\n      while pos[1] > ty:\n          actions.append(1)   # UP\n          pos[1] -= 1\n\n  # If stick is primitive (no recipe), just pick it up.\n  if not needed_prims:\n      locs = np.argwhere(grid[:, :, goal_idx] > 0)\n      if locs.size:\n          _move_to(locs[0].tolist())\n          actions.append(4)   # USE to pick up the stick\n      return actions\n\n  # Collect each required primitive.\n  for prim_idx, count in needed_prims.items():\n      locs = np.argwhere(grid[:, :, prim_idx] > 0)\n      if not locs.size:\n          continue  # primitive not present; should not happen in valid scenarios\n      target = locs[0].tolist()\n      _move_to(target)\n      for _ in range(count):\n          actions.append(4)   # USE to pick up one unit of the primitive\n\n  # Move to the appropriate workshop (if any) and craft the stick.\n  recipe = cb.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = cb.index[workshop_name]\n      w_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if w_locs.size:\n          _move_to(w_locs[0].tolist())\n          actions.append(4)   # USE to craft at the workshop\n\n  return actions", "env_interactions": 4, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:10:28.929627", "function_name": "make_arrow", "function_body": "  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act.get(\"DOWN\", 0),\n      act.get(\"UP\", 1),\n      act.get(\"LEFT\", 2),\n      act.get(\"RIGHT\", 3),\n      act.get(\"USE\", 4),\n  )\n\n  # current state snapshot\n  state = env._current_state\n  grid = state.grid.copy()\n  cur_pos = tuple(state.pos)\n\n  # index of the target item (\"stick\")\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n      if stick_idx is None:\n          return []  # stick not defined in this world\n\n  # recipe for stick (primitives needed and optional workshop)\n  recipe = env.world.cookbook.primitives_for(stick_idx)\n\n  # if there is no recipe, stick is a primitive itself \u2192 need to pick one up\n  if not recipe:\n      primitive_needs = {stick_idx: 1}\n      workshop_idx = None\n  else:\n      primitive_needs = {k: v for k, v in recipe.items() if isinstance(k, int)}\n      workshop_idx = None\n      for k, v in recipe.items():\n          if not isinstance(k, int):\n              workshop_idx = v if isinstance(v, int) else None\n              break\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # helper: locate nearest cell containing at least one of the given kind\n  def find_closest(kind_idx, cur):\n      positions = np.argwhere(grid[:, :, kind_idx] > 0)\n      if positions.shape[0] == 0:\n          return None\n      dists = np.sum(np.abs(positions - np.array(cur)), axis=1)\n      nearest = positions[np.argmin(dists)]\n      return tuple(nearest.tolist())\n\n  # helper: generate Manhattan path actions from cur to target\n  def path_to(cur, target):\n      x, y = cur\n      tx, ty = target\n      path = []\n      while (x, y) != (tx, ty):\n          if x < tx:\n              path.append(RIGHT)\n              x += 1\n          elif x > tx:\n              path.append(LEFT)\n              x -= 1\n          elif y < ty:\n              path.append(DOWN)\n              y += 1\n          elif y > ty:\n              path.append(UP)\n              y -= 1\n      return path, (x, y)\n  # ------------------------------------------------------------------\n\n  # collect required primitives\n  for kind_idx, needed in primitive_needs.items():\n      while needed > 0:\n          target = find_closest(kind_idx, cur_pos)\n          if target is None:\n              # required primitive missing \u2013 abort planning\n              return actions\n          move_actions, cur_pos = path_to(cur_pos, target)\n          actions.extend(move_actions)\n          actions.append(USE)  # pick up the primitive\n          # update local grid copy\n          grid[target[0], target[1], kind_idx] = max(\n              0, grid[target[0], target[1], kind_idx] - 1\n          )\n          needed -= 1\n\n  # if a workshop is required, go there and use it\n  if workshop_idx is not None:\n      ws_target = find_closest(workshop_idx, cur_pos)\n      if ws_target is not None:\n          move_actions, cur_pos = path_to(cur_pos, ws_target)\n          actions.extend(move_actions)\n          actions.append(USE)  # craft at workshop\n\n  return actions", "env_interactions": 2, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:10:30.206196", "function_name": "make_arrow", "function_body": "  # Get action indices\n  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act.get(\"DOWN\", 0),\n      act.get(\"UP\", 1),\n      act.get(\"LEFT\", 2),\n      act.get(\"RIGHT\", 3),\n      act.get(\"USE\", 4),\n  )\n\n  # Snapshot of current state\n  state = env._current_state\n  grid = state.grid.copy()                     # (W, H, n_kinds)\n  cur_pos = tuple(state.pos)                   # (x, y)\n\n  # Locate the index for \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n      if stick_idx is None:\n          return []   # stick not present in index\n\n  # Retrieve recipe (primitives needed and possible workshop)\n  recipe = env.world.cookbook.primitives_for(stick_idx)   # dict {kind_idx: count}\n  primitive_needs = {k: v for k, v in recipe.items() if isinstance(k, int)}\n  workshop_idx = None\n  for k, v in recipe.items():\n      if not isinstance(k, int):\n          workshop_idx = v if isinstance(v, int) else None\n          break\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # helper: find nearest cell containing at least one of the given kind\n  def find_closest(kind_idx, cur):\n      positions = np.argwhere(grid[:, :, kind_idx] > 0)\n      if positions.shape[0] == 0:\n          return None\n      dists = np.sum(np.abs(positions - np.array(cur)), axis=1)\n      nearest = positions[np.argmin(dists)]\n      return tuple(nearest.tolist())\n\n  # helper: simple Manhattan path (returns actions and final position)\n  def path_to(cur, target):\n      x, y = cur\n      tx, ty = target\n      path = []\n      while (x, y) != (tx, ty):\n          if x < tx:\n              path.append(RIGHT)\n              x += 1\n          elif x > tx:\n              path.append(LEFT)\n              x -= 1\n          elif y < ty:\n              path.append(DOWN)\n              y += 1\n          elif y > ty:\n              path.append(UP)\n              y -= 1\n      return path, (x, y)\n  # ------------------------------------------------------------------\n\n  # Collect each required primitive (if any)\n  for kind_idx, needed in primitive_needs.items():\n      while needed > 0:\n          target = find_closest(kind_idx, cur_pos)\n          if target is None:\n              # Primitive not present \u2013 abort planning\n              return actions\n          move_actions, cur_pos = path_to(cur_pos, target)\n          actions.extend(move_actions)\n          actions.append(USE)   # pick up primitive\n          # Update local grid copy to reflect consumption\n          grid[target[0], target[1], kind_idx] = max(\n              0, grid[target[0], target[1], kind_idx] - 1\n          )\n          needed -= 1\n\n  # If a workshop is required for crafting, go there and use it\n  if workshop_idx is not None:\n      ws_target = find_closest(workshop_idx, cur_pos)\n      if ws_target is not None:\n          move_actions, cur_pos = path_to(cur_pos, ws_target)\n          actions.extend(move_actions)\n          actions.append(USE)   # craft at the workshop\n\n  return actions", "env_interactions": 2, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:10:47.417868", "function_name": "make_arrow", "function_body": "  actions = []\n  state = env._current_state\n  grid = state.grid\n  world = env.world\n  cb = world.cookbook\n\n  # Identify the index for the target item \"stick\"\n  try:\n      goal_idx = cb.index[\"stick\"]\n  except Exception:\n      return actions\n\n  # Determine primitive requirements (empty dict if stick is primitive)\n  needed_prims = cb.primitives_for(goal_idx)\n\n  # Mutable copy of the agent's position\n  pos = list(state.pos)\n\n  # Helper to move to a target cell using Manhattan moves\n  def _move_to(target):\n      nonlocal pos, actions\n      tx, ty = target\n      while pos[0] < tx:\n          actions.append(3)   # RIGHT\n          pos[0] += 1\n      while pos[0] > tx:\n          actions.append(2)   # LEFT\n          pos[0] -= 1\n      while pos[1] < ty:\n          actions.append(0)   # DOWN\n          pos[1] += 1\n      while pos[1] > ty:\n          actions.append(1)   # UP\n          pos[1] -= 1\n\n  # If stick is itself a primitive, just pick it up\n  if not needed_prims:\n      locs = np.argwhere(grid[:, :, goal_idx] > 0)\n      if locs.size:\n          _move_to(locs[0].tolist())\n          actions.append(4)   # USE to pick up the stick\n      return actions\n\n  # Collect each required primitive\n  for prim_idx, count in needed_prims.items():\n      prim_locs = np.argwhere(grid[:, :, prim_idx] > 0)\n      if not prim_locs.size:\n          continue  # Primitive not present; skip (should not happen in valid scenarios)\n      target = prim_locs[0].tolist()\n      _move_to(target)\n      for _ in range(count):\n          actions.append(4)   # USE to pick up one unit\n\n  # If the recipe specifies a workshop, move there and craft the stick\n  recipe = cb.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = cb.index[workshop_name]\n      w_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if w_locs.size:\n          _move_to(w_locs[0].tolist())\n          actions.append(4)   # USE to craft at the workshop\n\n  return actions", "env_interactions": 4, "island_id": 1, "scores": {"3": 0.0}}
