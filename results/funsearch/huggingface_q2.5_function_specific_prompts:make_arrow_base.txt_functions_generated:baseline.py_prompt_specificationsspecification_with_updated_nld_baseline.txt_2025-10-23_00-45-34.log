{"timestamp": "2025-10-23T04:22:47.571586", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Locate the CraftWorld instance inside the environment\n  # ----------------------------------------------------------------------\n  if hasattr(env, \"world\"):\n      world = env.world\n  elif hasattr(env, \"scenario\"):\n      world = env.scenario.world\n  else:\n      raise AttributeError(\"Cannot locate CraftWorld instance in the supplied env.\")\n\n  # ----------------------------------------------------------------------\n  # Goal information (stick)\n  # ----------------------------------------------------------------------\n  goal_name = \"stick\"\n  goal_idx = world.cookbook.index.index(goal_name)\n\n  # Ingredients required to craft the stick (if any)\n  needed = world.cookbook.primitives_for(goal_idx)   # dict {prim_idx: count}\n\n  # ----------------------------------------------------------------------\n  # Obtain the current state for planning (position + grid)\n  # ----------------------------------------------------------------------\n  if hasattr(env, \"_current_state\"):\n      state = env._current_state\n  else:\n      state = env.scenario.init()\n\n  cur_pos = tuple(state.pos)          # (row, col)\n  grid = state.grid.copy()            # (H, W, n_kinds)\n\n  # ----------------------------------------------------------------------\n  # Action constants and helper utilities\n  # ----------------------------------------------------------------------\n  _ACTION_DELTAS = {\n      0: (1, 0),   # DOWN\n      1: (-1, 0),  # UP\n      2: (0, -1),  # LEFT\n      3: (0, 1),   # RIGHT\n  }\n\n  def _move_actions(start, goal):\n      \"\"\"Manhattan path from start (y,x) to goal (y,x) as list of actions.\"\"\"\n      y, x = start\n      gy, gx = goal\n      acts = []\n      while y < gy:\n          acts.append(0)   # DOWN\n          y += 1\n      while y > gy:\n          acts.append(1)   # UP\n          y -= 1\n      while x < gx:\n          acts.append(3)   # RIGHT\n          x += 1\n      while x > gx:\n          acts.append(2)   # LEFT\n          x -= 1\n      return acts\n\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # Helper to collect a primitive from the grid\n  # ----------------------------------------------------------------------\n  def _collect_primitive(p_idx):\n      nonlocal cur_pos, actions, grid\n      cells = np.argwhere(grid[:, :, p_idx] > 0)\n      if cells.size == 0:\n          raise RuntimeError(f\"Primitive '{world.cookbook.index.get(p_idx)}' not found on the grid.\")\n      py, px = cells[0]\n\n      # Find an adjacent empty cell to stand on and face the primitive\n      target = None\n      for dy, dx in _ACTION_DELTAS.values():\n          ny, nx = py - dy, px - dx\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not grid[ny, nx, :].any():\n                  target = (ny, nx)\n                  break\n      if target is None:\n          raise RuntimeError(\"No reachable empty neighbour around required primitive.\")\n\n      # Move to the neighbour\n      actions.extend(_move_actions(cur_pos, target))\n      cur_pos = target\n\n      # Use to pick up the primitive\n      actions.append(4)   # USE\n      # Update planning grid\n      grid[py, px, p_idx] = 0\n\n  # ----------------------------------------------------------------------\n  # 1. Collect required primitives (if any)\n  # ----------------------------------------------------------------------\n  if needed:\n      for prim_idx, cnt in needed.items():\n          for _ in range(cnt):\n              _collect_primitive(prim_idx)\n\n  # ----------------------------------------------------------------------\n  # 2. If stick itself is a primitive (no recipe), just collect it\n  # ----------------------------------------------------------------------\n  elif goal_idx in world.cookbook.primitives:\n      _collect_primitive(goal_idx)\n      return actions\n\n  # ----------------------------------------------------------------------\n  # 3. Craft the stick at its workshop (if a workshop is specified)\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_cells.size == 0:\n          raise RuntimeError(f\"Workshop '{workshop_name}' not found on the grid.\")\n      wy, wx = ws_cells[0]\n\n      # Find an empty neighbour to stand on\n      target = None\n      for dy, dx in _ACTION_DELTAS.values():\n          ny, nx = wy - dy, wx - dx\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not grid[ny, nx, :].any():\n                  target = (ny, nx)\n                  break\n      if target is None:\n          raise RuntimeError(\"No reachable empty neighbour around workshop.\")\n\n      actions.extend(_move_actions(cur_pos, target))\n      cur_pos = target\n\n  # ----------------------------------------------------------------------\n  # Final USE to craft (or pick up if no workshop)\n  # ----------------------------------------------------------------------\n  actions.append(4)   # USE\n  return actions", "env_interactions": 5, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:23:13.536394", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  goal_idx = env.task.goal\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # Helper to find all positions of a given kind in the grid\n  def find_positions(kind):\n      locs = np.argwhere(state.grid[:, :, kind] > 0)\n      return [tuple(p) for p in locs]\n\n  # Nearest position (Manhattan) of a kind from a given location\n  def nearest(pos, kind):\n      positions = find_positions(kind)\n      if not positions:\n          return None\n      return min(positions, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n\n  # Convert source\u2192dest into movement actions (DOWN=0, UP=1, LEFT=2, RIGHT=3)\n  def moves_to(src, dst):\n      sx, sy = src\n      dx, dy = dst\n      seq = []\n      while sx < dx:\n          seq.append(0)  # DOWN\n          sx += 1\n      while sx > dx:\n          seq.append(1)  # UP\n          sx -= 1\n      while sy < dy:\n          seq.append(3)  # RIGHT\n          sy += 1\n      while sy > dy:\n          seq.append(2)  # LEFT\n          sy -= 1\n      return seq\n\n  # -----------------------------------------------------------------\n  # 1) If the goal is a primitive, just go to it and pick it up.\n  # -----------------------------------------------------------------\n  primitive_deps = env.world.cookbook.primitives_for(goal_idx)\n  if not primitive_deps:\n      target = nearest(cur_pos, goal_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)  # USE\n      return actions\n\n  # -----------------------------------------------------------------\n  # 2) Collect required primitives.\n  # -----------------------------------------------------------------\n  for prim_idx, cnt in primitive_deps.items():\n      for _ in range(cnt):\n          target = nearest(cur_pos, prim_idx)\n          if target is None:\n              continue\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n          actions.append(4)  # USE to pick up\n\n  # -----------------------------------------------------------------\n  # 3) Move to workshop (if recipe specifies one) and craft.\n  # -----------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  # Look for a string key (e.g., \"_at\") that stores the workshop index\n  for k, v in recipe.items():\n      if isinstance(k, str):\n          workshop_idx = v\n          break\n\n  if workshop_idx is not None:\n      target = nearest(cur_pos, workshop_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)  # USE to craft\n\n  return actions", "env_interactions": 1, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:23:14.786359", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  goal_idx = env.task.goal\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # Locate all cells containing a specific kind\n  def find_positions(kind):\n      locs = np.argwhere(state.grid[:, :, kind] > 0)\n      return [tuple(p) for p in locs]\n\n  # Nearest cell (Manhattan distance) of a kind from a given position\n  def nearest(pos, kind):\n      positions = find_positions(kind)\n      if not positions:\n          return None\n      return min(positions, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n\n  # Convert a source\u2013destination pair into movement actions\n  # (DOWN=0, UP=1, LEFT=2, RIGHT=3)\n  def moves_to(src, dst):\n      sx, sy = src\n      dx, dy = dst\n      seq = []\n      while sx < dx:\n          seq.append(0)  # DOWN\n          sx += 1\n      while sx > dx:\n          seq.append(1)  # UP\n          sx -= 1\n      while sy < dy:\n          seq.append(3)  # RIGHT\n          sy += 1\n      while sy > dy:\n          seq.append(2)  # LEFT\n          sy -= 1\n      return seq\n\n  # -----------------------------------------------------------------\n  # 1) If the goal is a primitive (no recipe), just go to it and pick up.\n  # -----------------------------------------------------------------\n  if not env.world.cookbook.primitives_for(goal_idx):\n      target = nearest(cur_pos, goal_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)  # USE\n      return actions\n\n  # -----------------------------------------------------------------\n  # 2) Collect required primitive ingredients.\n  # -----------------------------------------------------------------\n  needed_prims = env.world.cookbook.primitives_for(goal_idx)\n  for prim_idx, count in needed_prims.items():\n      for _ in range(count):\n          target = nearest(cur_pos, prim_idx)\n          if target is None:\n              continue  # primitive not found; skip\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n          actions.append(4)  # USE to collect\n\n  # -----------------------------------------------------------------\n  # 3) Move to the workshop (if any) and craft the stick.\n  # -----------------------------------------------------------------\n  workshop_idx = None\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  for key, val in recipe.items():\n      if key == \"_at\":\n          workshop_idx = val\n          break\n\n  if workshop_idx is not None:\n      target = nearest(cur_pos, workshop_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)  # USE to craft at workshop\n\n  return actions", "env_interactions": 1, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:23:31.552828", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  goal_idx = env.task.goal\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # --------------------------------------------------------------\n  # Helper utilities\n  # --------------------------------------------------------------\n  def find_positions(kind):\n      \"\"\"Return list of (x, y) positions where kind is present.\"\"\"\n      locs = np.argwhere(state.grid[:, :, kind] > 0)\n      return [tuple(p) for p in locs]\n\n  def nearest(pos, kind):\n      \"\"\"Nearest position of a given kind to pos (Manhattan distance).\"\"\"\n      positions = find_positions(kind)\n      if not positions:\n          return None\n      return min(positions, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n\n  def moves_to(src, dst):\n      \"\"\"Manhattan move sequence from src to dst using action indices.\"\"\"\n      sx, sy = src\n      dx, dy = dst\n      seq = []\n      while sx < dx:\n          seq.append(0)   # DOWN\n          sx += 1\n      while sx > dx:\n          seq.append(1)   # UP\n          sx -= 1\n      while sy < dy:\n          seq.append(3)   # RIGHT\n          sy += 1\n      while sy > dy:\n          seq.append(2)   # LEFT\n          sy -= 1\n      return seq\n\n  # --------------------------------------------------------------\n  # 1) If goal is primitive (no recipe), just go to it and pick up.\n  # --------------------------------------------------------------\n  if not env.world.cookbook.primitives_for(goal_idx):\n      target = nearest(cur_pos, goal_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)   # USE\n      return actions\n\n  # --------------------------------------------------------------\n  # 2) Gather required primitive ingredients.\n  # --------------------------------------------------------------\n  needed = env.world.cookbook.primitives_for(goal_idx)\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          target = nearest(cur_pos, prim_idx)\n          if target is None:\n              continue\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n          actions.append(4)   # USE to collect primitive\n\n  # --------------------------------------------------------------\n  # 3) Move to workshop (if any) and craft the stick.\n  # --------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  if isinstance(recipe, dict):\n      workshop_idx = recipe.get('_at')\n      if workshop_idx is None:\n          # fallback: look for any non\u2011integer key that might specify workshop\n          for k, v in recipe.items():\n              if isinstance(k, str) and k != '_at':\n                  workshop_idx = v\n                  break\n\n  if workshop_idx is not None:\n      target = nearest(cur_pos, workshop_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)   # USE at workshop to craft\n  else:\n      # No explicit workshop \u2013 just use at current location.\n      actions.append(4)\n\n  return actions", "env_interactions": 1, "island_id": 0, "scores": {"3": 0.0}}
