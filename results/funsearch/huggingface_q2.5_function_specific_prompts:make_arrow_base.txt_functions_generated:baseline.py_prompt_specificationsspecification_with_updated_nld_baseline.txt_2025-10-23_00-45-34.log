{"timestamp": "2025-10-23T00:54:41.341090", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # Action indices as defined in CraftLab.action_specs\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions from start to goal using\n      horizontal then vertical moves (ignores obstacles).\"\"\"\n      x, y = start\n      gx, gy = goal\n      actions = []\n      while x < gx:\n          actions.append(ACTION_RIGHT)\n          x += 1\n      while x > gx:\n          actions.append(ACTION_LEFT)\n          x -= 1\n      while y < gy:\n          actions.append(ACTION_DOWN)\n          y += 1\n      while y > gy:\n          actions.append(ACTION_UP)\n          y -= 1\n      return actions\n\n  def nearest_position(positions, reference):\n      \"\"\"Pick the position from *positions* with smallest Manhattan distance\n      to *reference*.\"\"\"\n      if len(positions) == 0:\n          return None\n      ref = np.array(reference)\n      dists = np.sum(np.abs(positions - ref), axis=1)\n      return tuple(positions[np.argmin(dists)])\n\n  # ------------------------------------------------------------------\n  # Gather current state information\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n\n  # ------------------------------------------------------------------\n  # Identify goal (stick)\n  # ------------------------------------------------------------------\n  goal_name = \"stick\"\n  goal_idx = env.world.cookbook.index[goal_name]\n\n  # ------------------------------------------------------------------\n  # 1) Collect needed primitives (if any)\n  # ------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  plan_actions = []\n\n  for prim_idx, needed_cnt in primitives_needed.items():\n      while inventory[prim_idx] < needed_cnt:\n          # locate cells containing the primitive\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # nothing left on map \u2013 abort planning\n              return plan_actions\n          target = nearest_position(prim_cells, pos)\n\n          # move to the primitive\n          plan_actions.extend(manhattan_path(pos, target))\n          pos = target\n\n          # pick it up\n          plan_actions.append(ACTION_USE)\n\n          # simulate pick\u2011up locally for further planning\n          inventory[prim_idx] += 1\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # ------------------------------------------------------------------\n  # 2) Go to workshop (if recipe requires one) and craft stick\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          # no workshop visible \u2013 cannot craft\n          return plan_actions\n      wcell = tuple(workshop_cells[0])\n\n      # find a free adjacent cell to stand on\n      neighbours = [(wcell[0] + dx, wcell[1] + dy) for dx, dy in\n                    [(1, 0), (-1, 0), (0, 1), (0, -1)]]\n      stand_pos = None\n      for nx, ny in neighbours:\n          if (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and\n                  grid[nx, ny, :].sum() == 0):\n              stand_pos = (nx, ny)\n              break\n      if stand_pos is None:\n          stand_pos = wcell  # fallback: stand on the workshop itself\n\n      # move to the chosen standing position\n      plan_actions.extend(manhattan_path(pos, stand_pos))\n      pos = stand_pos\n\n      # use the workshop to craft the stick\n      plan_actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # Return the full action list\n  # ------------------------------------------------------------------\n  return plan_actions", "env_interactions": 5, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T00:55:30.693705", "function_name": "make_arrow", "function_body": "  actions = []\n  # indices and action mapping\n  stick_idx = env.world.cookbook.index.index(\"stick\")\n  act_map = env.action_specs()\n  use_act = act_map[\"USE\"]\n  move_acts = [act_map[d] for d in (\"DOWN\", \"UP\", \"LEFT\", \"RIGHT\")]\n\n  # safety limit to avoid infinite loops\n  max_steps = 2000\n  step_cnt = 0\n\n  # keep acting until we have a stick in inventory\n  while env._current_state.inventory[stick_idx] == 0 and step_cnt < max_steps:\n      # if a stick (or the primitive that yields a stick) is adjacent, pick it up\n      if env._current_state.next_to(stick_idx):\n          actions.append(use_act)\n          env.step(use_act)\n          step_cnt += 1\n          continue\n\n      # otherwise move around; try the four cardinal directions in order\n      moved = False\n      for a in move_acts:\n          actions.append(a)\n          env.step(a)\n          step_cnt += 1\n          if env._current_state.next_to(stick_idx):\n              moved = True\n              break\n      # if none of the moves brought us next to a stick, keep looping\n      if not moved:\n          continue\n\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-10-23T00:55:32.075483", "function_name": "make_arrow", "function_body": "  # Reset the environment and obtain the initial state.\n  env.reset()\n  state = env._current_state\n\n  # Index of the target item.\n  stick_idx = env.world.cookbook.index[\"stick\"]\n\n  # Determine whether the stick is a primitive or must be crafted.\n  if stick_idx in env.world.cookbook.primitives:\n      required = {stick_idx: 1}\n      need_craft = False\n  else:\n      required = env.world.cookbook.primitives_for(stick_idx)\n      need_craft = True\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper utilities.\n  # ------------------------------------------------------------------\n  def blocked_map(grid):\n      \"\"\"Boolean map where True indicates a blocked cell.\"\"\"\n      return grid.sum(axis=2) > 0\n\n  def bfs_path(start, targets, blocked):\n      \"\"\"Bread\u2011first search returning a list of action ids that moves\n      from *start* to any cell in *targets* while avoiding blocked cells.\"\"\"\n      W, H = blocked.shape\n      q = collections.deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in targets:\n              return path\n          for a, (dx, dy) in enumerate(((0, 1), (0, -1), (-1, 0), (1, 0))):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not blocked[nx, ny] and (nx, ny) not in visited:\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [a]))\n      return None\n\n  # ------------------------------------------------------------------\n  # Collect all required primitive resources.\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in required.items():\n      for _ in range(cnt):\n          # Locate the nearest cell containing the primitive.\n          prim_cells = list(zip(*np.where(state.grid[:, :, prim_idx] > 0)))\n          if not prim_cells:\n              raise RuntimeError(\"required primitive not present in the world\")\n          cur = state.pos\n          prim_pos = min(\n              prim_cells,\n              key=lambda p: abs(p[0] - cur[0]) + abs(p[1] - cur[1]),\n          )\n\n          # Find an empty neighbour of that primitive.\n          W, H = state.grid.shape[:2]\n          neighbours = []\n          for dx, dy in ((0, 1), (0, -1), (-1, 0), (1, 0)):\n              nx, ny = prim_pos[0] + dx, prim_pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and state.grid[nx, ny].sum() == 0:\n                  neighbours.append((nx, ny))\n          if not neighbours:\n              raise RuntimeError(\"no free adjacent cell to the primitive\")\n\n          # Plan a path to one of the free neighbours.\n          blocked = blocked_map(state.grid)\n          path = bfs_path(state.pos, set(neighbours), blocked)\n          if path is None:\n              raise RuntimeError(\"cannot reach the primitive\")\n\n          # Execute the movement actions.\n          for a in path:\n              _, _, _ = env.step(a)\n              actions.append(a)\n              state = env._current_state\n\n          # Face the primitive (move into it would be blocked, but direction changes).\n          dx = prim_pos[0] - state.pos[0]\n          dy = prim_pos[1] - state.pos[1]\n          if (dx, dy) == (0, 1):\n              face_action = 0          # DOWN\n          elif (dx, dy) == (0, -1):\n              face_action = 1          # UP\n          elif (dx, dy) == (-1, 0):\n              face_action = 2          # LEFT\n          elif (dx, dy) == (1, 0):\n              face_action = 3          # RIGHT\n          else:\n              raise RuntimeError(\"invalid relative position to primitive\")\n          _, _, _ = env.step(face_action)\n          actions.append(face_action)\n          state = env._current_state\n\n          # Pick up the primitive.\n          _, _, _ = env.step(4)          # USE\n          actions.append(4)\n          state = env._current_state\n\n  # ------------------------------------------------------------------\n  # If the target must be crafted, go to the appropriate workshop.\n  # ------------------------------------------------------------------\n  if need_craft:\n      workshop_kind = env.world.cookbook.recipes[stick_idx].get(\"_at\")\n      if workshop_kind is None:\n          raise RuntimeError(\"crafting workshop not specified for stick\")\n      workshop_cells = list(zip(*np.where(state.grid[:, :, workshop_kind] > 0)))\n      if not workshop_cells:\n          raise RuntimeError(\"workshop not present in the world\")\n      cur = state.pos\n      ws_pos = min(\n          workshop_cells,\n          key=lambda p: abs(p[0] - cur[0]) + abs(p[1] - cur[1]),\n      )\n\n      # Find an empty neighbour of the workshop.\n      W, H = state.grid.shape[:2]\n      neighbours = []\n      for dx, dy in ((0, 1), (0, -1), (-1, 0), (1, 0)):\n          nx, ny = ws_pos[0] + dx, ws_pos[1] + dy\n          if 0 <= nx < W and 0 <= ny < H and state.grid[nx, ny].sum() == 0:\n              neighbours.append((nx, ny))\n      if not neighbours:\n          raise RuntimeError(\"no free adjacent cell to the workshop\")\n\n      # Path to a free neighbour.\n      blocked = blocked_map(state.grid)\n      path = bfs_path(state.pos, set(neighbours), blocked)\n      if path is None:\n          raise RuntimeError(\"cannot reach the workshop\")\n\n      for a in path:\n          _, _, _ = env.step(a)\n          actions.append(a)\n          state = env._current_state\n\n      # Face the workshop.\n      dx = ws_pos[0] - state.pos[0]\n      dy = ws_pos[1] - state.pos[1]\n      if (dx, dy) == (0, 1):\n          face_action = 0\n      elif (dx, dy) == (0, -1):\n          face_action = 1\n      elif (dx, dy) == (-1, 0):\n          face_action = 2\n      elif (dx, dy) == (1, 0):\n          face_action = 3\n      else:\n          raise RuntimeError(\"invalid relative position to workshop\")\n      _, _, _ = env.step(face_action)\n      actions.append(face_action)\n      state = env._current_state\n\n      # Craft the stick.\n      _, _, _ = env.step(4)          # USE\n      actions.append(4)\n\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-10-23T00:56:07.378237", "function_name": "make_arrow", "function_body": "  # Get the index for the target item (stick)\n  stick_idx = env.world.cookbook.index[\"stick\"]\n\n  # Determine which primitive resources are needed to craft a stick\n  needed = env.world.cookbook.primitives_for(stick_idx)  # {prim_idx: count, ...}\n  actions = []\n\n  # Helper to locate all cells that contain a given kind (primitive or workshop)\n  def locate_cells(kind_idx):\n      grid = env._current_state.grid[:, :, kind_idx]\n      return list(zip(*np.where(grid > 0)))\n\n  # Helper to move the agent until it is orthogonally adjacent to a target cell.\n  # After each step we update the local `state` reference.\n  def move_adjacent_to(target):\n      nonlocal actions, env, state\n      while True:\n          px, py = state.pos\n          tx, ty = target\n          # Check adjacency (Manhattan distance 1)\n          if abs(px - tx) + abs(py - ty) == 1:\n              # Face the target cell\n              if tx > px:\n                  face_action = 3          # RIGHT\n              elif tx < px:\n                  face_action = 2          # LEFT\n              elif ty > py:\n                  face_action = 0          # DOWN\n              else:\n                  face_action = 1          # UP\n              actions.append(face_action)\n              _, state = env.step(face_action)\n              break\n\n          # Decide a simple Manhattan move towards the target\n          if px < tx:\n              move_action = 3               # RIGHT\n          elif px > tx:\n              move_action = 2               # LEFT\n          elif py < ty:\n              move_action = 0               # DOWN\n          else:\n              move_action = 1               # UP\n          actions.append(move_action)\n          _, state = env.step(move_action)\n\n  # Current state reference (will be updated after each step)\n  state = env._current_state\n\n  # ----------------------------------------------------------------------\n  # 1) Collect all required primitive resources\n  # ----------------------------------------------------------------------\n  for prim_idx, required_cnt in needed.items():\n      while state.inventory[prim_idx] < required_cnt:\n          # Find all cells that currently contain this primitive\n          prim_cells = locate_cells(prim_idx)\n          if not prim_cells:\n              raise RuntimeError(\"Required primitive not present in the world\")\n          # Choose the nearest primitive cell (Euclidean distance is fine)\n          cur_pos = np.array(state.pos)\n          distances = [np.linalg.norm(np.array(c) - cur_pos) for c in prim_cells]\n          target_cell = prim_cells[int(np.argmin(distances))]\n          # Move next to the primitive and pick it up\n          move_adjacent_to(target_cell)\n          actions.append(4)                  # USE to collect\n          _, state = env.step(4)\n\n  # ----------------------------------------------------------------------\n  # 2) Move to the appropriate workshop and craft the stick\n  # ----------------------------------------------------------------------\n  # The workshop index is stored in the recipe under the special key \"_at\"\n  recipe = env.world.cookbook.recipes[stick_idx]\n  workshop_idx = None\n  for key, val in recipe.items():\n      if key == \"_at\":\n          workshop_idx = val\n          break\n\n  # If the workshop index was not explicitly stored, fall back to any workshop\n  if workshop_idx is None:\n      for w_idx in env.world.workshop_indices:\n          cells = locate_cells(w_idx)\n          if cells:\n              workshop_idx = w_idx\n              workshop_cell = cells[0]\n              break\n      else:\n          raise RuntimeError(\"No workshop found for crafting stick\")\n  else:\n      workshop_cells = locate_cells(workshop_idx)\n      if not workshop_cells:\n          raise RuntimeError(\"Specified workshop cell not present\")\n      workshop_cell = workshop_cells[0]\n\n  # Navigate next to the workshop and use the crafting action\n  move_adjacent_to(workshop_cell)\n  actions.append(4)                          # USE to craft\n\n  # Return the complete action sequence\n  return actions", "env_interactions": 0, "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-10-23T00:56:08.799965", "function_name": "make_arrow", "function_body": "  # ----- helper constants -------------------------------------------------\n  # Action indices follow the ordering used in CraftWorld / CraftLab\n  DOWN = getattr(env, \"DOWN\", 0)\n  UP = getattr(env, \"UP\", 1)\n  LEFT = getattr(env, \"LEFT\", 2)\n  RIGHT = getattr(env, \"RIGHT\", 3)\n  USE = getattr(env, \"USE\", 4)\n\n  # ----- obtain world / scenario information ------------------------------\n  # The environment may expose the underlying CraftWorld either as\n  # `world` (CraftLab) or `craft_world` (direct CraftWorld usage).\n  world = getattr(env, \"world\", None) or getattr(env, \"craft_world\", None)\n  if world is None:\n      raise AttributeError(\"Cannot locate CraftWorld instance inside env\")\n\n  # Scenario holds the initial grid layout and the starting position.\n  scenario = getattr(env, \"scenario\", None) or getattr(env, \"_scenario\", None)\n  if scenario is None:\n      raise AttributeError(\"Cannot locate CraftScenario instance inside env\")\n\n  init_grid = scenario.init_grid          # shape (W, H, n_kinds)\n  init_pos = scenario.init_pos            # (x, y)\n\n  # ----- identify the target item (\"stick\") -------------------------------\n  stick_name = \"stick\"\n  stick_idx = world.cookbook.index.index(stick_name)\n\n  # ----- primitive requirements for the stick -----------------------------\n  # Returns a dict {primitive_idx: count}\n  needed = world.cookbook.primitives_for(stick_idx)\n\n  # ----- locate all primitive instances on the map -----------------------\n  # We simply pick the first occurrence of each kind.\n  primitive_locs = {}\n  for kind_idx in needed:\n      cells = np.argwhere(init_grid[:, :, kind_idx] > 0)\n      if cells.size == 0:\n          continue\n      primitive_locs[kind_idx] = tuple(cells[0])\n\n  # ----- utility to move from one cell to another -------------------------\n  def _move(cur, target):\n      \"\"\"Return a list of movement actions required to go from cur to target.\"\"\"\n      cx, cy = cur\n      tx, ty = target\n      seq = []\n      while cx < tx:\n          seq.append(DOWN); cx += 1\n      while cx > tx:\n          seq.append(UP); cx -= 1\n      while cy < ty:\n          seq.append(RIGHT); cy += 1\n      while cy > ty:\n          seq.append(LEFT); cy -= 1\n      return seq, (cx, cy)\n\n  # ----- plan the action sequence -----------------------------------------\n  actions = []\n  cur_pos = init_pos\n\n  # Collect each required primitive the needed number of times\n  for kind_idx, count in needed.items():\n      for _ in range(count):\n          target = primitive_locs.get(kind_idx)\n          if target is None:\n              # primitive not present \u2013 skip (the environment would be unsolvable)\n              continue\n          move_seq, cur_pos = _move(cur_pos, target)\n          actions.extend(move_seq)\n\n          # The agent must be adjacent and face the primitive before using.\n          # A simple way: step one cell back in the opposite direction,\n          # then USE while facing the primitive.\n          # Determine a neighbor cell (prefer DOWN if possible).\n          tx, ty = target\n          # try to stand on the cell just before the primitive\n          if tx > 0:\n              back = (tx - 1, ty)\n              face_action = DOWN\n          elif tx < init_grid.shape[0] - 1:\n              back = (tx + 1, ty)\n              face_action = UP\n          elif ty > 0:\n              back = (tx, ty - 1)\n              face_action = RIGHT\n          else:\n              back = (tx, ty + 1)\n              face_action = LEFT\n\n          # move to the backing cell if we are not already there\n          if cur_pos != back:\n              move_seq, cur_pos = _move(cur_pos, back)\n              actions.extend(move_seq)\n\n          # now face the primitive (direction already encoded in `face_action`)\n          # In this simplified implementation we assume the environment does\n          # not require an explicit \"turn\" action; the direction is inferred\n          # from the last movement. Therefore we just issue USE.\n          actions.append(USE)\n\n  # ----- craft the stick at its workshop (if any) -------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_idx = recipe.get(\"_at\")\n  if workshop_idx is not None:\n      # locate a workshop of the required type\n      cells = np.argwhere(init_grid[:, :, workshop_idx] > 0)\n      if cells.size > 0:\n          wpos = tuple(cells[0])\n          move_seq, cur_pos = _move(cur_pos, wpos)\n          actions.extend(move_seq)\n          actions.append(USE)   # perform crafting at the workshop\n\n  return actions", "env_interactions": 0, "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-10-23T00:56:55.470709", "function_name": "make_arrow", "function_body": "  actions = []\n  # current state and world references\n  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  # obtain the index for the stick item\n  try:\n      stick_idx = cookbook.index['stick']\n  except Exception:\n      return actions\n\n  # primitive requirements for the stick and possible workshop index\n  prim_req = cookbook.primitives_for(stick_idx)          # {prim_idx: count}\n  recipe = cookbook.recipes.get(stick_idx, {})\n  workshop_kind = recipe.get('_at')\n\n  # keep track of the agent's current position\n  cur_pos = tuple(state.pos)  # (x, y)\n\n  # helper to generate movement actions toward a target cell\n  def move_to(target):\n      nonlocal cur_pos, actions\n      dx = target[0] - cur_pos[0]\n      dy = target[1] - cur_pos[1]\n      while dx != 0:\n          if dx > 0:\n              actions.append(3)          # RIGHT\n              cur_pos = (cur_pos[0] + 1, cur_pos[1])\n              dx -= 1\n          else:\n              actions.append(2)          # LEFT\n              cur_pos = (cur_pos[0] - 1, cur_pos[1])\n              dx += 1\n      while dy != 0:\n          if dy > 0:\n              actions.append(0)          # DOWN\n              cur_pos = (cur_pos[0], cur_pos[1] + 1)\n              dy -= 1\n          else:\n              actions.append(1)          # UP\n              cur_pos = (cur_pos[0], cur_pos[1] - 1)\n              dy += 1\n\n  grid = state.grid\n\n  # ------------------------------------------------------------------\n  # 1. Collect required primitive items\n  # ------------------------------------------------------------------\n  for prim_idx, count in prim_req.items():\n      # locate all cells that contain this primitive\n      locations = np.argwhere(grid[:, :, prim_idx] > 0)\n      if locations.size == 0:\n          continue  # primitive not present; skip\n\n      # pick the first found location and repeat for the needed count\n      target_loc = locations[0]\n      for _ in range(count):\n          # find an empty neighbour of the primitive (agent must stand there)\n          adj = None\n          for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              nx, ny = int(target_loc[0] + dx), int(target_loc[1] + dy)\n              if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n                  if grid[nx, ny, :].sum() == 0:\n                      adj = (nx, ny)\n                      break\n          if adj is None:\n              # fallback: stand on the primitive cell itself\n              adj = (int(target_loc[0]), int(target_loc[1]))\n\n          move_to(adj)\n          actions.append(4)   # USE to pick up the primitive\n\n  # ------------------------------------------------------------------\n  # 2. Move to the required workshop (if any) and craft the stick\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      ws_locs = np.argwhere(grid[:, :, workshop_kind] > 0)\n      if ws_locs.size > 0:\n          ws_target = ws_locs[0]\n          # pick an empty neighbour around the workshop\n          adj = None\n          for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              nx, ny = int(ws_target[0] + dx), int(ws_target[1] + dy)\n              if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n                  if grid[nx, ny, :].sum() == 0:\n                      adj = (nx, ny)\n                      break\n          if adj is None:\n              adj = (int(ws_target[0]), int(ws_target[1]))\n          move_to(adj)\n          actions.append(4)   # USE to craft the stick at the workshop\n\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-10-23T00:56:56.786352", "function_name": "make_arrow", "function_body": "  # Helper: map direction vectors to action indices using the env's spec\n  act_spec = env.action_specs()\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]          # DOWN, UP, LEFT, RIGHT\n  ACTIONS = {\n      (0, 1): act_spec[\"DOWN\"],\n      (0, -1): act_spec[\"UP\"],\n      (-1, 0): act_spec[\"LEFT\"],\n      (1, 0): act_spec[\"RIGHT\"],\n      \"USE\": act_spec[\"USE\"],\n  }\n\n  # ------------------------------------------------------------------ #\n  # Simple BFS that returns a list of actions moving from start to any\n  # position in goal_set while avoiding blocked cells.\n  # ------------------------------------------------------------------ #\n  def bfs(start, goal_set, blocked):\n      from collections import deque\n\n      W, H = blocked.shape\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in goal_set:\n              return path\n          for dvec, act in zip(DIRS, [ACTIONS[(0, 1)], ACTIONS[(0, -1)],\n                                      ACTIONS[(-1, 0)], ACTIONS[(1, 0)]]):\n              nx, ny = x + dvec[0], y + dvec[1]\n              if 0 <= nx < W and 0 <= ny < H and not blocked[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [act]))\n      return []  # no path found (should not happen in well\u2011formed maps)\n\n  # ------------------------------------------------------------------ #\n  # Locate an empty neighbour of a target cell (used for both primitives\n  # and workshop interaction).\n  # ------------------------------------------------------------------ #\n  def empty_neighbour(target, blocked):\n      tx, ty = target\n      neighbours = []\n      for dvec in DIRS:\n          nx, ny = tx + dvec[0], ty + dvec[1]\n          if 0 <= nx < blocked.shape[0] and 0 <= ny < blocked.shape[1]:\n              if not blocked[nx, ny]:\n                  neighbours.append(((nx, ny), dvec))\n      return neighbours\n\n  # ------------------------------------------------------------------ #\n  # Main logic\n  # ------------------------------------------------------------------ #\n  world = env.world\n  state = env._current_state          # current CraftState\n  grid = state.grid                    # (W, H, n_kinds)\n  W, H, _ = grid.shape\n\n  # index of the goal item \u201cstick\u201d\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # primitive requirements for the stick (may be empty if stick is primitive)\n  need = world.cookbook.primitives_for(stick_idx)   # {kind_idx: count}\n\n  # gather blocked mask (any non\u2011zero occupancy blocks movement)\n  blocked = (grid.sum(axis=2) > 0)\n\n  actions = []\n\n  # ------------------------------------------------------------------ #\n  # 1. Collect required primitives\n  # ------------------------------------------------------------------ #\n  for kind, cnt in need.items():\n      # locate all cells containing this primitive\n      locations = list(zip(*np.where(grid[:, :, kind] > 0)))\n      # simple greedy: take the first `cnt` locations\n      for loc in locations[:cnt]:\n          # find an empty neighbour to stand on\n          cand = empty_neighbour(loc, blocked)\n          if not cand:\n              continue  # cannot reach \u2013 skip (should not happen)\n          stand_pos, vec_to_target = cand[0]\n\n          # plan path from current position to the standing position\n          path = bfs(state.pos, {stand_pos}, blocked)\n          actions.extend(path)\n\n          # after moving, update simulated position & direction\n          for a in path:\n              reward, new_state = state.step(a)\n              state = new_state\n              # update blocked mask because we might have picked up something,\n              # but for simplicity we keep the original mask (primitives disappear\n              # after USE, which we handle next).\n\n          # now we are adjacent; face the primitive and USE\n          # (facing is the direction of the last move; we assume it points\n          #  toward the target \u2013 this holds for the neighbour we chose)\n          actions.append(ACTIONS[\"USE\"])\n          reward, new_state = state.step(ACTIONS[\"USE\"])\n          state = new_state\n\n          # mark the primitive cell as empty for subsequent planning\n          blocked[loc[0], loc[1]] = False\n\n  # ------------------------------------------------------------------ #\n  # 2. Craft the stick at its workshop (if a workshop is required)\n  # ------------------------------------------------------------------ #\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n\n  if workshop_kind is not None:\n      # locate any workshop of the required type\n      ws = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n      if ws:\n          ws_loc = ws[0]\n          # find an empty neighbour to stand on\n          cand = empty_neighbour(ws_loc, blocked)\n          if cand:\n              stand_pos, _ = cand[0]\n\n              # plan path to the workshop neighbour\n              path = bfs(state.pos, {stand_pos}, blocked)\n              actions.extend(path)\n\n              # simulate moves\n              for a in path:\n                  reward, new_state = state.step(a)\n                  state = new_state\n\n              # finally USE to craft\n              actions.append(ACTIONS[\"USE\"])\n              # (no need to simulate the final step for the return value)\n\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": -1}}
