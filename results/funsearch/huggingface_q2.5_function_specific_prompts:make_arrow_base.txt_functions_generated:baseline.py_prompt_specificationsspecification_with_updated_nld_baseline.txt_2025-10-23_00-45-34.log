{"timestamp": "2025-10-23T03:59:55.951081", "function_name": "make_arrow", "function_body": "  def _move_to(cur_pos, target, seq):\n      x, y = cur_pos\n      tx, ty = target\n      while x < tx:\n          seq.append(3)   # RIGHT\n          x += 1\n      while x > tx:\n          seq.append(2)   # LEFT\n          x -= 1\n      while y < ty:\n          seq.append(0)   # DOWN\n          y += 1\n      while y > ty:\n          seq.append(1)   # UP\n          y -= 1\n      return (x, y)\n\n  state = env._current_state\n  grid = state.grid.copy()\n  cur_pos = state.pos\n  goal_idx = env.task.goal\n\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n  ingredients = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  actions = []\n\n  for ing_kind, count in ingredients.items():\n      for _ in range(count):\n          locations = np.argwhere(grid[:, :, ing_kind] > 0)\n          if locations.size == 0:\n              break\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          chosen = locations[dists.argmin()]\n          target = (int(chosen[0]), int(chosen[1]))\n          cur_pos = _move_to(cur_pos, target, actions)\n          actions.append(4)  # USE to pick up\n          grid[target[0], target[1], ing_kind] = 0\n\n  if workshop_kind is not None:\n      ws_locs = np.argwhere(grid[:, :, workshop_kind] > 0)\n      if ws_locs.size > 0:\n          dists = np.abs(ws_locs[:, 0] - cur_pos[0]) + np.abs(ws_locs[:, 1] - cur_pos[1])\n          chosen = ws_locs[dists.argmin()]\n          workshop_loc = (int(chosen[0]), int(chosen[1]))\n          cur_pos = _move_to(cur_pos, workshop_loc, actions)\n          actions.append(4)  # USE to craft\n\n  return actions", "env_interactions": 0, "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:00:13.194222", "function_name": "make_arrow", "function_body": "  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act.get(\"DOWN\", 0),\n      act.get(\"UP\", 1),\n      act.get(\"LEFT\", 2),\n      act.get(\"RIGHT\", 3),\n      act.get(\"USE\", 4),\n  )\n\n  # current snapshot\n  state = env._current_state\n  grid = state.grid.copy()\n  cur_pos = tuple(state.pos)\n\n  # index of stick\n  stick_idx = env.world.cookbook.index.get(\"stick\")\n  if stick_idx is None:\n      return []\n\n  # recipe: primitives needed and possible workshop\n  recipe = env.world.cookbook.primitives_for(stick_idx)\n  primitive_needs = {k: v for k, v in recipe.items() if isinstance(k, int)}\n  if not primitive_needs:\n      primitive_needs = {stick_idx: 1}\n\n  workshop_idx = None\n  for k, v in recipe.items():\n      if not isinstance(k, int):\n          workshop_idx = v if isinstance(v, int) else None\n          break\n\n  actions = []\n\n  def find_closest(kind_idx, cur):\n      pos = np.argwhere(grid[:, :, kind_idx] > 0)\n      if pos.size == 0:\n          return None\n      d = np.sum(np.abs(pos - np.array(cur)), axis=1)\n      nearest = pos[np.argmin(d)]\n      return tuple(nearest.tolist())\n\n  def path_to(cur, target):\n      x, y = cur\n      tx, ty = target\n      path = []\n      while (x, y) != (tx, ty):\n          if x < tx:\n              path.append(RIGHT); x += 1\n          elif x > tx:\n              path.append(LEFT); x -= 1\n          elif y < ty:\n              path.append(DOWN); y += 1\n          elif y > ty:\n              path.append(UP); y -= 1\n      return path, (x, y)\n\n  # collect all needed primitives\n  for kind_idx, need in primitive_needs.items():\n      while need > 0:\n          tgt = find_closest(kind_idx, cur_pos)\n          if tgt is None:\n              return actions\n          move, cur_pos = path_to(cur_pos, tgt)\n          actions.extend(move)\n          actions.append(USE)\n          # update local grid copy\n          grid[tgt[0], tgt[1], kind_idx] = max(\n              0, grid[tgt[0], tgt[1], kind_idx] - 1\n          )\n          need -= 1\n\n  # craft at workshop if required\n  if workshop_idx is not None:\n      ws = find_closest(workshop_idx, cur_pos)\n      if ws is not None:\n          move, cur_pos = path_to(cur_pos, ws)\n          actions.extend(move)\n          actions.append(USE)\n\n  return actions", "env_interactions": 0, "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-10-23T04:00:14.469835", "function_name": "make_arrow", "function_body": "  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act.get(\"DOWN\", 0),\n      act.get(\"UP\", 1),\n      act.get(\"LEFT\", 2),\n      act.get(\"RIGHT\", 3),\n      act.get(\"USE\", 4),\n  )\n\n  state = env._current_state\n  grid = state.grid.copy()\n  cur_pos = tuple(state.pos)\n\n  # locate the index for \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n  if stick_idx is None:\n      return []\n\n  # retrieve recipe for stick (primitives needed and optional workshop)\n  recipe = env.world.cookbook.primitives_for(stick_idx)\n  primitive_needs = {k: v for k, v in recipe.items() if isinstance(k, int)}\n  # if stick itself is a primitive, just need to pick one up\n  if not primitive_needs:\n      primitive_needs = {stick_idx: 1}\n\n  workshop_idx = None\n  for k, v in recipe.items():\n      if not isinstance(k, int):\n          workshop_idx = v if isinstance(v, int) else None\n          break\n\n  actions = []\n\n  def find_closest(kind_idx, cur):\n      \"\"\"Return coordinates of the nearest cell containing kind_idx, or None.\"\"\"\n      positions = np.argwhere(grid[:, :, kind_idx] > 0)\n      if positions.shape[0] == 0:\n          return None\n      dists = np.sum(np.abs(positions - np.array(cur)), axis=1)\n      nearest = positions[np.argmin(dists)]\n      return tuple(nearest.tolist())\n\n  def path_to(cur, target):\n      \"\"\"Greedy Manhattan path from cur to target, returning actions and final position.\"\"\"\n      x, y = cur\n      tx, ty = target\n      path = []\n      while (x, y) != (tx, ty):\n          if x < tx:\n              path.append(RIGHT)\n              x += 1\n          elif x > tx:\n              path.append(LEFT)\n              x -= 1\n          elif y < ty:\n              path.append(DOWN)\n              y += 1\n          elif y > ty:\n              path.append(UP)\n              y -= 1\n      return path, (x, y)\n\n  # Collect all required primitives\n  for kind_idx, needed in primitive_needs.items():\n      while needed > 0:\n          target = find_closest(kind_idx, cur_pos)\n          if target is None:\n              return actions  # cannot find required primitive\n          move_actions, cur_pos = path_to(cur_pos, target)\n          actions.extend(move_actions)\n          actions.append(USE)  # pick up the primitive\n          # Update local grid copy to reflect consumption\n          grid[target[0], target[1], kind_idx] = max(\n              0, grid[target[0], target[1], kind_idx] - 1\n          )\n          needed -= 1\n\n  # If a workshop is required, move there and use it to craft the stick\n  if workshop_idx is not None:\n      ws_target = find_closest(workshop_idx, cur_pos)\n      if ws_target is not None:\n          move_actions, cur_pos = path_to(cur_pos, ws_target)\n          actions.extend(move_actions)\n          actions.append(USE)  # craft at the workshop\n\n  return actions", "env_interactions": 2, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:00:28.037024", "function_name": "make_arrow", "function_body": "  actions = []\n  state = env._current_state\n  grid = state.grid\n  world = env.world\n  cb = world.cookbook\n\n  # index of the target item \"stick\"\n  try:\n      goal_idx = cb.index[\"stick\"]\n  except Exception:\n      return actions\n\n  # primitives required to craft a stick (empty if stick is primitive)\n  needed_prims = cb.primitives_for(goal_idx)\n\n  # mutable copy of current position (x, y)\n  pos = list(state.pos)\n\n  def _move_to(target):\n      nonlocal pos, actions\n      tx, ty = target\n      while pos[0] < tx:\n          actions.append(3)   # RIGHT\n          pos[0] += 1\n      while pos[0] > tx:\n          actions.append(2)   # LEFT\n          pos[0] -= 1\n      while pos[1] < ty:\n          actions.append(0)   # DOWN\n          pos[1] += 1\n      while pos[1] > ty:\n          actions.append(1)   # UP\n          pos[1] -= 1\n\n  # If stick is a primitive, just pick it up.\n  if not needed_prims:\n      locs = np.argwhere(grid[:, :, goal_idx] > 0)\n      if locs.size:\n          _move_to(locs[0].tolist())\n          actions.append(4)   # USE to pick up the stick\n      return actions\n\n  # Collect each required primitive.\n  for prim_idx, count in needed_prims.items():\n      locs = np.argwhere(grid[:, :, prim_idx] > 0)\n      if not locs.size:\n          continue  # primitive not present; should not happen in valid scenarios\n      target = locs[0].tolist()\n      _move_to(target)\n      for _ in range(count):\n          actions.append(4)   # USE to pick up one unit of the primitive\n\n  # Move to the appropriate workshop (if any) and craft the stick.\n  recipe = cb.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = cb.index[workshop_name]\n      w_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if w_locs.size:\n          _move_to(w_locs[0].tolist())\n          actions.append(4)   # USE to craft at the workshop\n\n  return actions", "env_interactions": 4, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:00:29.316857", "function_name": "make_arrow", "function_body": "  actions = []\n  state = env._current_state\n  grid = state.grid\n  world = env.world\n  cb = world.cookbook\n\n  # index of the target item \"stick\"\n  try:\n      goal_idx = cb.index[\"stick\"]\n  except Exception:\n      return actions\n\n  # primitive requirements for a stick (empty dict if stick is primitive)\n  needed_prims = cb.primitives_for(goal_idx)\n\n  # mutable copy of current position (x, y)\n  pos = list(state.pos)\n\n  # helper to move to a target cell using Manhattan steps\n  def _move_to(target):\n      nonlocal pos, actions\n      tx, ty = target\n      while pos[0] < tx:\n          actions.append(3)   # RIGHT\n          pos[0] += 1\n      while pos[0] > tx:\n          actions.append(2)   # LEFT\n          pos[0] -= 1\n      while pos[1] < ty:\n          actions.append(0)   # DOWN\n          pos[1] += 1\n      while pos[1] > ty:\n          actions.append(1)   # UP\n          pos[1] -= 1\n\n  # if stick is a primitive (no recipe), just pick it up\n  if not needed_prims:\n      locs = np.argwhere(grid[:, :, goal_idx] > 0)\n      if locs.size:\n          _move_to(locs[0].tolist())\n          actions.append(4)   # USE to pick up the stick\n      return actions\n\n  # collect each required primitive\n  for prim_idx, count in needed_prims.items():\n      locs = np.argwhere(grid[:, :, prim_idx] > 0)\n      if not locs.size:\n          continue  # primitive not present; should not happen in valid scenarios\n      _move_to(locs[0].tolist())\n      for _ in range(count):\n          actions.append(4)   # USE to pick up one unit of the primitive\n\n  # move to the appropriate workshop (if any) and craft the stick\n  recipe = cb.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = cb.index[workshop_name]\n      w_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if w_locs.size:\n          _move_to(w_locs[0].tolist())\n          actions.append(4)   # USE to craft at the workshop\n\n  return actions", "env_interactions": 4, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:00:46.544909", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  goal_idx = env.task.goal\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  def find_positions(kind):\n      locs = np.argwhere(state.grid[:, :, kind] > 0)\n      return [tuple(p) for p in locs]\n\n  def nearest(pos, kind):\n      positions = find_positions(kind)\n      if not positions:\n          return None\n      return min(positions, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n\n  def moves_to(src, dst):\n      sx, sy = src\n      dx, dy = dst\n      seq = []\n      while sx < dx:\n          seq.append(0)   # DOWN\n          sx += 1\n      while sx > dx:\n          seq.append(1)   # UP\n          sx -= 1\n      while sy < dy:\n          seq.append(3)   # RIGHT\n          sy += 1\n      while sy > dy:\n          seq.append(2)   # LEFT\n          sy -= 1\n      return seq\n\n  # Determine primitive requirements for the stick\n  needed = env.world.cookbook.primitives_for(goal_idx)\n\n  # If stick itself is primitive, just collect it\n  if not needed:\n      target = nearest(cur_pos, goal_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)  # USE\n      return actions\n\n  # Collect required primitives\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = nearest(cur_pos, prim_idx)\n          if target is None:\n              continue\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n          actions.append(4)  # USE to pick up primitive\n\n  # Locate workshop (if any) and craft the stick\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  if isinstance(recipe, dict):\n      workshop_idx = recipe.get('_at')\n  if workshop_idx is not None:\n      target = nearest(cur_pos, workshop_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)  # USE to craft at workshop\n  else:\n      actions.append(4)  # USE to craft in place (fallback)\n\n  return actions", "env_interactions": 1, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:00:47.931840", "function_name": "make_arrow", "function_body": "  # Reset environment to start fresh\n  env.reset()\n  state = env._current_state\n  goal_idx = env.task.goal\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # Helper: locate all cells containing a given kind\n  def find_positions(kind):\n      locs = np.argwhere(state.grid[:, :, kind] > 0)\n      return [tuple(p) for p in locs]\n\n  # Helper: nearest location of a kind (Manhattan distance)\n  def nearest(pos, kind):\n      positions = find_positions(kind)\n      if not positions:\n          return None\n      return min(positions, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n\n  # Helper: translate a Manhattan move into action indices\n  def moves_to(src, dst):\n      sx, sy = src\n      dx, dy = dst\n      seq = []\n      while sx < dx:\n          seq.append(0)   # DOWN\n          sx += 1\n      while sx > dx:\n          seq.append(1)   # UP\n          sx -= 1\n      while sy < dy:\n          seq.append(3)   # RIGHT\n          sy += 1\n      while sy > dy:\n          seq.append(2)   # LEFT\n          sy -= 1\n      return seq\n\n  # Determine which primitive resources are required for the stick\n  needed_prims = env.world.cookbook.primitives_for(goal_idx)\n\n  # If the item is primitive (no recipe), just try to pick it up where we are\n  if not needed_prims:\n      actions.append(4)   # USE\n      return actions\n\n  # Collect each required primitive the needed number of times\n  for prim_idx, count in needed_prims.items():\n      for _ in range(count):\n          target = nearest(cur_pos, prim_idx)\n          if target is None:\n              # primitive not found; give up on this step\n              continue\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n          actions.append(4)   # USE to pick up the primitive\n\n  # After gathering, move to the appropriate workshop (if any) and craft\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  if isinstance(recipe, dict):\n      workshop_idx = recipe.get('_at')\n  if workshop_idx is None:\n      # Fallback: any workshop location known to the world\n      if env.world.workshop_indices:\n          workshop_idx = env.world.workshop_indices[0]\n\n  if workshop_idx is not None:\n      target = nearest(cur_pos, workshop_idx)\n      if target is not None:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)   # USE to craft at the workshop\n  else:\n      # No workshop info; just attempt to use at current location\n      actions.append(4)\n\n  return actions", "env_interactions": 1, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:01:09.182912", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n\n  # Action indices\n  act = env.action_specs()\n  DOWN = act[\"DOWN\"]\n  UP = act[\"UP\"]\n  LEFT = act[\"LEFT\"]\n  RIGHT = act[\"RIGHT\"]\n  USE = act[\"USE\"]\n\n  # Index of the primitive \"stick\"\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # Locate all cells containing a stick\n  stick_cells = np.argwhere(state.grid[:, :, stick_idx] > 0)\n  if stick_cells.size == 0:\n      return []  # no sticks present\n\n  # Choose the nearest stick (Manhattan distance)\n  cur_pos = np.array(state.pos)\n  dists = np.abs(stick_cells - cur_pos).sum(axis=1)\n  target = tuple(stick_cells[dists.argmin()])\n\n  # If already on the target cell, just pick up\n  if tuple(state.pos) == target:\n      return [USE]\n\n  # Build blocked map: any occupied cell is blocked except the target and current position\n  blocked = np.any(state.grid > 0, axis=2).copy()\n  blocked[target] = False\n  blocked[tuple(state.pos)] = False\n\n  width, height = blocked.shape\n  from collections import deque\n  queue = deque([tuple(state.pos)])\n  parent = {tuple(state.pos): None}\n\n  # BFS to find a path avoiding blocked cells\n  while queue:\n      x, y = queue.popleft()\n      if (x, y) == target:\n          break\n      for nx, ny, a in [(x + 1, y, DOWN), (x - 1, y, UP),\n                        (x, y + 1, RIGHT), (x, y - 1, LEFT)]:\n          if 0 <= nx < width and 0 <= ny < height and not blocked[nx, ny]:\n              if (nx, ny) not in parent:\n                  parent[(nx, ny)] = (x, y, a)\n                  queue.append((nx, ny))\n\n  # Reconstruct action sequence\n  actions = []\n  node = target\n  while parent[node] is not None:\n      px, py, move_act = parent[node]\n      actions.append(move_act)\n      node = (px, py)\n  actions.reverse()\n  actions.append(USE)\n  return actions", "env_interactions": 0, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:01:10.532525", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n\n  # Action indices\n  act = env.action_specs()\n  DOWN = act[\"DOWN\"]\n  UP = act[\"UP\"]\n  LEFT = act[\"LEFT\"]\n  RIGHT = act[\"RIGHT\"]\n  USE = act[\"USE\"]\n\n  # Index of the primitive \"stick\"\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # Find all cells that contain a stick\n  stick_cells = np.argwhere(state.grid[:, :, stick_idx] > 0)\n  if stick_cells.size == 0:\n      # No stick present \u2013 nothing to do\n      return []\n\n  # Choose the nearest stick cell (Manhattan distance)\n  cur_pos = np.array(state.pos)\n  dists = np.abs(stick_cells - cur_pos).sum(axis=1)\n  target = tuple(stick_cells[dists.argmin()])\n\n  # Build a blocked map: any occupied cell is blocked except the target and current position\n  blocked = np.any(state.grid > 0, axis=2).copy()\n  blocked[target] = False\n  blocked[tuple(state.pos)] = False\n\n  # BFS to find a path avoiding blocked cells\n  width, height = blocked.shape\n  from collections import deque\n  queue = deque([tuple(state.pos)])\n  parent = {tuple(state.pos): None}\n  while queue:\n      x, y = queue.popleft()\n      if (x, y) == target:\n          break\n      for nx, ny, a in [(x + 1, y, DOWN), (x - 1, y, UP),\n                        (x, y + 1, RIGHT), (x, y - 1, LEFT)]:\n          if 0 <= nx < width and 0 <= ny < height and not blocked[nx, ny]:\n              if (nx, ny) not in parent:\n                  parent[(nx, ny)] = (x, y, a)\n                  queue.append((nx, ny))\n\n  # Reconstruct action sequence\n  actions = []\n  node = target\n  while parent[node] is not None:\n      px, py, act_move = parent[node]\n      actions.append(act_move)\n      node = (px, py)\n  actions.reverse()\n  actions.append(USE)\n  return actions", "env_interactions": 0, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:01:41.997061", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n\n  # action indices\n  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act[\"DOWN\"], act[\"UP\"], act[\"LEFT\"], act[\"RIGHT\"], act[\"USE\"]\n  )\n\n  # index of the target item \"stick\"\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # if a stick already exists on the map, just go pick it up\n  stick_cells = np.argwhere(state.grid[:, :, stick_idx] > 0)\n  if stick_cells.size > 0:\n      # find nearest reachable stick and pick it up\n      start = tuple(state.pos)\n      W, H, _ = state.grid.shape\n      blocked = np.any(state.grid > 0, axis=2)\n\n      def bfs_to(target_set):\n          q = collections.deque([start])\n          visited = np.full((W, H), False, dtype=bool)\n          visited[start[0], start[1]] = True\n          prev = {}\n          while q:\n              x, y = q.popleft()\n              if (x, y) in target_set:\n                  # reconstruct path\n                  actions = []\n                  cur = (x, y)\n                  while cur != start:\n                      (px, py), a_code = prev[cur]\n                      actions.append(a_code)\n                      cur = (px, py)\n                  actions.reverse()\n                  return actions, (x, y)\n              for nx, ny, a_code in [(x + 1, y, DOWN), (x - 1, y, UP),\n                                     (x, y + 1, RIGHT), (x, y - 1, LEFT)]:\n                  if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                      if (nx, ny) in target_set or not blocked[nx, ny]:\n                          visited[nx, ny] = True\n                          prev[(nx, ny)] = ((x, y), a_code)\n                          q.append((nx, ny))\n          return None, None\n\n      target_set = {tuple(cell) for cell in stick_cells}\n      path, _ = bfs_to(target_set)\n      if path is None:\n          return []          # unreachable stick\n      return path + [USE]\n\n  # ------------------------------------------------------------------\n  # Otherwise we need to craft a stick from its recipe\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  # primitive requirements (exclude the special \"_at\" key)\n  primitives = {k: v for k, v in recipe.items() if k != \"_at\"}\n  workshop_idx = recipe.get(\"_at\", None)\n\n  # if there is no recipe, nothing to do\n  if not primitives or workshop_idx is None:\n      return []\n\n  actions = []\n  start = tuple(state.pos)\n  W, H, _ = state.grid.shape\n  blocked = np.any(state.grid > 0, axis=2)\n\n  # helper BFS that works from a mutable start position\n  def bfs_from(start_pos, target_set):\n      q = collections.deque([start_pos])\n      visited = np.full((W, H), False, dtype=bool)\n      visited[start_pos[0], start_pos[1]] = True\n      prev = {}\n      while q:\n          x, y = q.popleft()\n          if (x, y) in target_set:\n              # reconstruct path\n              actions_local = []\n              cur = (x, y)\n              while cur != start_pos:\n                  (px, py), a_code = prev[cur]\n                  actions_local.append(a_code)\n                  cur = (px, py)\n              actions_local.reverse()\n              return actions_local, (x, y)\n          for nx, ny, a_code in [(x + 1, y, DOWN), (x - 1, y, UP),\n                                 (x, y + 1, RIGHT), (x, y - 1, LEFT)]:\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if (nx, ny) in target_set or not blocked[nx, ny]:\n                      visited[nx, ny] = True\n                      prev[(nx, ny)] = ((x, y), a_code)\n                      q.append((nx, ny))\n      return None, None\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive\n  # ------------------------------------------------------------------\n  for prim_idx, count in primitives.items():\n      prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n      if prim_cells.size == 0:\n          return []          # cannot find required primitive\n      target_set = {tuple(cell) for cell in prim_cells}\n      path, goal = bfs_from(start, target_set)\n      if path is None:\n          return []          # unreachable primitive\n      actions.extend(path)\n      actions.extend([USE] * count)   # pick up the needed amount\n      start = goal                     # agent now stands on the primitive cell\n\n  # ------------------------------------------------------------------\n  # Move to the appropriate workshop and craft the stick\n  # ------------------------------------------------------------------\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      return actions      # no workshop found; return what we have\n  target_set = {tuple(cell) for cell in workshop_cells}\n  path, _ = bfs_from(start, target_set)\n  if path is None:\n      return actions      # cannot reach workshop\n  actions.extend(path)\n  actions.append(USE)     # craft the stick at the workshop\n\n  return actions", "env_interactions": 0, "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-10-23T04:01:43.338605", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n\n  # action identifiers\n  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act[\"DOWN\"], act[\"UP\"], act[\"LEFT\"], act[\"RIGHT\"], act[\"USE\"]\n  )\n\n  # index of the primitive \"stick\"\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # locate all cells that currently contain a stick\n  stick_cells = np.argwhere(state.grid[:, :, stick_idx] > 0)\n  if stick_cells.size == 0:\n      # No sticks present \u2013 nothing to do\n      return []\n\n  width, height = state.grid.shape[:2]\n  non_grabbable = world.non_grabbable_indices\n\n  def traversable(pos):\n      \"\"\"Return True if the agent can stand on `pos`.\"\"\"\n      x, y = pos\n      if not (0 <= x < width and 0 <= y < height):\n          return False\n      for idx in non_grabbable:\n          if state.grid[x, y, idx] > 0:\n              return False\n      return True\n\n  start = tuple(state.pos)\n  target_set = {tuple(cell) for cell in stick_cells}\n\n  # BFS to the nearest stick cell\n  queue = collections.deque([start])\n  visited = {start: None}          # maps position -> (prev_position, action_to_here)\n  goal = None\n\n  while queue:\n      cur = queue.popleft()\n      if cur in target_set:\n          goal = cur\n          break\n      x, y = cur\n      for nx, ny, a_code in [(x + 1, y, DOWN), (x - 1, y, UP),\n                             (x, y + 1, RIGHT), (x, y - 1, LEFT)]:\n          nxt = (nx, ny)\n          if nxt not in visited and traversable(nxt):\n              visited[nxt] = (cur, a_code)\n              queue.append(nxt)\n\n  if goal is None:\n      # No reachable stick found\n      return []\n\n  # reconstruct action sequence from start to goal\n  actions = []\n  cur = goal\n  while visited[cur] is not None:\n      prev, a_code = visited[cur]\n      actions.append(a_code)\n      cur = prev\n  actions.reverse()\n\n  # finally pick up the stick\n  actions.append(USE)\n  return actions", "env_interactions": 0, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:02:09.547633", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n\n  # Action indices\n  act = env.action_specs()\n  DOWN = act[\"DOWN\"]\n  UP = act[\"UP\"]\n  LEFT = act[\"LEFT\"]\n  RIGHT = act[\"RIGHT\"]\n  USE = act[\"USE\"]\n\n  # Index of the primitive \u201cstick\u201d\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # Locate all cells that contain a stick\n  stick_cells = np.argwhere(state.grid[:, :, stick_idx] > 0)\n  if stick_cells.size == 0:\n      # No stick present \u2013 nothing to do\n      return []\n\n  # Breadth\u2011first search for the nearest reachable stick,\n  # avoiding non\u2011grabbable entities.\n  width, height = state.grid.shape[:2]\n  non_grabbable = world.non_grabbable_indices\n\n  def traversable(p):\n      x, y = p\n      if not (0 <= x < width and 0 <= y < height):\n          return False\n      for idx in non_grabbable:\n          if state.grid[x, y, idx] > 0:\n              return False\n      return True\n\n  start = tuple(state.pos)\n  target_set = {tuple(cell) for cell in stick_cells}\n  queue = collections.deque([start])\n  visited = {start: None}\n  goal = None\n\n  while queue:\n      cur = queue.popleft()\n      if cur in target_set:\n          goal = cur\n          break\n      x, y = cur\n      for nx, ny, act_code in [(x + 1, y, DOWN),\n                               (x - 1, y, UP),\n                               (x, y + 1, RIGHT),\n                               (x, y - 1, LEFT)]:\n          nxt = (nx, ny)\n          if nxt not in visited and traversable(nxt):\n              visited[nxt] = (cur, act_code)\n              queue.append(nxt)\n\n  if goal is None:\n      # No reachable stick found\n      return []\n\n  # Reconstruct the action sequence from start to the goal cell\n  actions = []\n  cur = goal\n  while visited[cur] is not None:\n      prev, act_code = visited[cur]\n      actions.append(act_code)\n      cur = prev\n  actions.reverse()\n\n  # Pick up the stick\n  actions.append(USE)\n  return actions", "env_interactions": 0, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:02:10.927011", "function_name": "make_arrow", "function_body": "  # Helper: find a path (list of movement actions) to the nearest cell containing `kind_idx`.\n  def _path_to_kind(state, kind_idx):\n      act = env.action_specs()\n      DOWN, UP, LEFT, RIGHT = act[\"DOWN\"], act[\"UP\"], act[\"LEFT\"], act[\"RIGHT\"]\n      width, height = state.grid.shape[:2]\n      start = tuple(state.pos)\n\n      # Cells that contain the desired kind.\n      target_cells = {\n          tuple(c) for c in np.argwhere(state.grid[:, :, kind_idx] > 0)\n      }\n      if not target_cells:\n          return []  # nothing to collect\n\n      # BFS over empty cells.\n      q = collections.deque([start])\n      visited = {start: None}  # maps position -> (prev_pos, action_to_reach)\n\n      while q:\n          cur = q.popleft()\n          if cur in target_cells:\n              # Reconstruct actions.\n              actions = []\n              while visited[cur] is not None:\n                  prev, act_code = visited[cur]\n                  actions.append(act_code)\n                  cur = prev\n              actions.reverse()\n              return actions\n\n          x, y = cur\n          for nx, ny, act_code in [\n              (x + 1, y, DOWN),\n              (x - 1, y, UP),\n              (x, y + 1, RIGHT),\n              (x, y - 1, LEFT),\n          ]:\n              if 0 <= nx < width and 0 <= ny < height:\n                  nxt = (nx, ny)\n                  if nxt not in visited:\n                      # Cell is traversable if it has no entities at all.\n                      if not state.grid[nx, ny, :].any():\n                          visited[nxt] = (cur, act_code)\n                          q.append(nxt)\n      return []  # unreachable\n\n  # Main logic -------------------------------------------------------------\n  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act[\"DOWN\"],\n      act[\"UP\"],\n      act[\"LEFT\"],\n      act[\"RIGHT\"],\n      act[\"USE\"],\n  )\n  world = env.world\n  state = env._current_state\n\n  stick_idx = world.cookbook.index[\"stick\"]\n  actions = []\n\n  # If stick is a primitive, just collect one.\n  if stick_idx in world.cookbook.primitives:\n      actions.extend(_path_to_kind(state, stick_idx))\n      actions.append(USE)\n      return actions\n\n  # Otherwise, we need to craft it using its recipe.\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  # Separate ingredients from the required workshop (if any).\n  workshop_name = recipe.get(\"_at\")\n  ingredients = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  # Collect each required ingredient (repeat according to required count).\n  for ing_idx, cnt in ingredients.items():\n      for _ in range(cnt):\n          actions.extend(_path_to_kind(state, ing_idx))\n          actions.append(USE)\n\n  # Move to the required workshop (if the recipe specifies one) before crafting.\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      actions.extend(_path_to_kind(state, workshop_idx))\n      actions.append(USE)  # interact with workshop to trigger crafting\n\n  # Finally, use the workshop (or the stick cell) to craft the stick itself.\n  actions.append(USE)\n  return actions", "env_interactions": 3, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:02:34.873484", "function_name": "make_arrow", "function_body": "  # Retrieve current state; reset if not already initialized\n  try:\n      state = env._current_state\n  except AttributeError:\n      env.reset()\n      state = env._current_state\n\n  # Action indices (with safe defaults)\n  try:\n      specs = env.action_specs()\n      DOWN = specs[\"DOWN\"]\n      UP = specs[\"UP\"]\n      LEFT = specs[\"LEFT\"]\n      RIGHT = specs[\"RIGHT\"]\n      USE = specs[\"USE\"]\n  except Exception:\n      DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Index of the target item \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      return []\n\n  # Primitive requirements for a stick (empty if stick is a primitive)\n  prim_req = env.world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n  grid = state.grid.copy()\n\n  # Build blocked mask (non\u2011traversable cells)\n  blocked = np.zeros(grid.shape[:2], dtype=bool)\n  for idx in env.world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # ------------------------------------------------------------------\n  # Helper: BFS shortest path avoiding blocked cells\n  # ------------------------------------------------------------------\n  dirs = [\n      (1, 0, DOWN),   # down\n      (-1, 0, UP),    # up\n      (0, -1, LEFT),  # left\n      (0, 1, RIGHT),  # right\n  ]\n\n  def bfs_path(start, goal, blocked_mask):\n      q = collections.deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for dx, dy, act in dirs:\n              nx, ny = x + dx, y + dy\n              if (\n                  0 <= nx < blocked_mask.shape[0]\n                  and 0 <= ny < blocked_mask.shape[1]\n                  and not blocked_mask[nx, ny]\n                  and (nx, ny) not in visited\n              ):\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [act]))\n      return None\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # ------------------------------------------------------------------\n  # Case 1: stick is a primitive already placed in the world.\n  # ------------------------------------------------------------------\n  if not prim_req:\n      cells = np.argwhere(grid[:, :, stick_idx] > 0)\n      if cells.size == 0:\n          return []  # no stick available\n      target = tuple(cells[0])\n      if cur_pos != target:\n          path = bfs_path(cur_pos, target, blocked)\n          if path is None:\n              return []  # unreachable\n          actions.extend(path)\n          cur_pos = target\n      actions.append(USE)\n      return actions\n\n  # ------------------------------------------------------------------\n  # Case 2: collect required primitives.\n  # ------------------------------------------------------------------\n  needed = dict(prim_req)  # mutable copy\n  while any(cnt > 0 for cnt in needed.values()):\n      best_path = None\n      best_target = None\n      best_prim = None\n\n      for prim_idx, cnt in needed.items():\n          if cnt <= 0:\n              continue\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          for cell in prim_cells:\n              target = tuple(cell)\n              path = bfs_path(cur_pos, target, blocked)\n              if path is None:\n                  continue\n              if best_path is None or len(path) < len(best_path):\n                  best_path = path\n                  best_target = target\n                  best_prim = prim_idx\n\n      if best_path is None:\n          return []  # cannot reach remaining needed primitives\n\n      actions.extend(best_path)\n      actions.append(USE)\n\n      # Update planning state\n      cur_pos = best_target\n      needed[best_prim] -= 1\n      grid[best_target[0], best_target[1], best_prim] = 0  # remove collected primitive\n\n  # ------------------------------------------------------------------\n  # Case 3: move to required workshop (if any) and craft the stick.\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      try:\n          workshop_idx = env.world.cookbook.index[workshop_name]\n      except Exception:\n          workshop_idx = None\n      if workshop_idx is not None:\n          ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n          if ws_cells.size > 0:\n              ws_target = tuple(ws_cells[0])\n              if cur_pos != ws_target:\n                  path = bfs_path(cur_pos, ws_target, blocked)\n                  if path is not None:\n                      actions.extend(path)\n                      cur_pos = ws_target\n\n  # Final crafting action\n  actions.append(USE)\n  return actions", "env_interactions": 3, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:02:36.180700", "function_name": "make_arrow", "function_body": "  # Ensure we have a current state; reset if needed\n  try:\n      state = env._current_state\n  except AttributeError:\n      env.reset()\n      state = env._current_state\n\n  # Action indices (fallback to defaults if specs missing)\n  try:\n      specs = env.action_specs()\n      DOWN = specs[\"DOWN\"]\n      UP = specs[\"UP\"]\n      LEFT = specs[\"LEFT\"]\n      RIGHT = specs[\"RIGHT\"]\n      USE = specs[\"USE\"]\n  except Exception:\n      DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Index of the target item \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      return []  # stick not defined in this world\n\n  # Primitive requirements for a stick (empty dict if primitive)\n  prim_req = env.world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n  grid = state.grid.copy()\n\n  # Build blocked mask (cells occupied by non\u2011grabbable entities)\n  blocked = np.zeros(grid.shape[:2], dtype=bool)\n  for idx in env.world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # ------------------------------------------------------------------\n  # Helper: BFS shortest path avoiding blocked cells\n  # ------------------------------------------------------------------\n  dirs = [\n      (1, 0, DOWN),   # down\n      (-1, 0, UP),    # up\n      (0, -1, LEFT),  # left\n      (0, 1, RIGHT),  # right\n  ]\n\n  def bfs_path(start, goal, blocked_mask):\n      \"\"\"Return list of actions to move from start to goal, or None.\"\"\"\n      q = collections.deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for dx, dy, act in dirs:\n              nx, ny = x + dx, y + dy\n              if (\n                  0 <= nx < blocked_mask.shape[0]\n                  and 0 <= ny < blocked_mask.shape[1]\n                  and not blocked_mask[nx, ny]\n                  and (nx, ny) not in visited\n              ):\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [act]))\n      return None\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # ------------------------------------------------------------------\n  # Case 1: stick is a primitive already placed in the world\n  # ------------------------------------------------------------------\n  if not prim_req:\n      stick_cells = np.argwhere(grid[:, :, stick_idx] > 0)\n      if stick_cells.size == 0:\n          return []  # no stick to pick up\n      target = tuple(stick_cells[0])\n      if cur_pos != target:\n          path = bfs_path(cur_pos, target, blocked)\n          if path is None:\n              return []  # unreachable\n          actions.extend(path)\n          cur_pos = target\n      actions.append(USE)\n      return actions\n\n  # ------------------------------------------------------------------\n  # Case 2: collect required primitives\n  # ------------------------------------------------------------------\n  needed = dict(prim_req)  # mutable copy of required counts\n  while any(cnt > 0 for cnt in needed.values()):\n      best_path = None\n      best_target = None\n      best_prim = None\n\n      # Find nearest reachable needed primitive\n      for prim_idx, cnt in needed.items():\n          if cnt <= 0:\n              continue\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          for cell in prim_cells:\n              tgt = tuple(cell)\n              path = bfs_path(cur_pos, tgt, blocked)\n              if path is None:\n                  continue\n              if best_path is None or len(path) < len(best_path):\n                  best_path = path\n                  best_target = tgt\n                  best_prim = prim_idx\n\n      if best_path is None:\n          # No reachable required primitive left\n          return []\n\n      # Move to the primitive and pick it up\n      actions.extend(best_path)\n      actions.append(USE)\n\n      # Update planning state\n      cur_pos = best_target\n      needed[best_prim] -= 1\n      grid[best_target[0], best_target[1], best_prim] = 0  # remove from copy\n\n  # ------------------------------------------------------------------\n  # Case 3: move to required workshop (if recipe specifies one) and craft\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      try:\n          workshop_idx = env.world.cookbook.index[workshop_name]\n      except Exception:\n          workshop_idx = None\n      if workshop_idx is not None:\n          ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n          if ws_cells.size > 0:\n              ws_target = tuple(ws_cells[0])\n              if cur_pos != ws_target:\n                  path = bfs_path(cur_pos, ws_target, blocked)\n                  if path is not None:\n                      actions.extend(path)\n                      cur_pos = ws_target\n\n  # ------------------------------------------------------------------\n  # Final crafting action\n  # ------------------------------------------------------------------\n  actions.append(USE)\n  return actions", "env_interactions": 3, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:03:02.840280", "function_name": "make_arrow", "function_body": "  # Helper to generate Manhattan move actions from cur_pos to target\n  def _move_actions(cur_pos, target):\n      actions = []\n      x, y = cur_pos\n      tx, ty = target\n      while x < tx:\n          actions.append(3)   # RIGHT\n          x += 1\n      while x > tx:\n          actions.append(2)   # LEFT\n          x -= 1\n      while y < ty:\n          actions.append(0)   # DOWN\n          y += 1\n      while y > ty:\n          actions.append(1)   # UP\n          y -= 1\n      return actions, (x, y)\n\n  state = env._current_state\n  cookbook = env.world.cookbook\n  stick_idx = cookbook.index['stick']\n\n  # 1) Already have a stick in inventory.\n  if state.inventory[stick_idx] > 0:\n      return []\n\n  # 2) Stick already placed on the grid \u2013 pick it up.\n  stick_cells = np.argwhere(state.grid[:, :, stick_idx] > 0)\n  if stick_cells.size > 0:\n      target = tuple(stick_cells[0])\n      moves, _ = _move_actions(state.pos, target)\n      moves.append(4)                     # USE to pick up\n      return moves\n\n  # 3) Need to craft a stick (or collect its primitive ingredients).\n  primitive_req = cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n  recipe = cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = cookbook.index[workshop_name] if workshop_name is not None else None\n\n  actions = []\n  cur_pos = state.pos\n  inventory = state.inventory.copy()\n\n  # 3a) Collect required primitive resources.\n  for prim_idx, needed in primitive_req.items():\n      while inventory[prim_idx] < needed:\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # No more of this primitive on the map \u2013 abort planning.\n              return actions\n          target = tuple(prim_cells[0])\n          moves, cur_pos = _move_actions(cur_pos, target)\n          actions.extend(moves)\n          actions.append(4)                # USE to pick up primitive\n          inventory[prim_idx] += 1\n\n  # 3b) If a specific workshop is required, go there.\n  if workshop_idx is not None:\n      ws_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if ws_cells.size > 0:\n          target = tuple(ws_cells[0])\n          moves, cur_pos = _move_actions(cur_pos, target)\n          actions.extend(moves)\n          actions.append(4)                # USE to craft the stick at workshop\n      else:\n          # Workshop not found on the map \u2013 cannot craft.\n          return actions\n  else:\n      # No workshop needed; craft at current location.\n      actions.append(4)                    # USE to craft the stick\n\n  return actions", "env_interactions": 4, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:03:04.232959", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n  stick_idx = cookbook.index['stick']\n\n  # 1) Already have a stick in inventory.\n  if state.inventory[stick_idx] > 0:\n      return []\n\n  # 2) If a stick is already placed on the grid, go pick it up.\n  stick_cells = np.argwhere(state.grid[:, :, stick_idx] > 0)\n  if stick_cells.size > 0:\n      target = tuple(stick_cells[0])\n      actions, _ = _move_actions(state.pos, target)\n      actions.append(4)                     # USE to pick up the stick\n      return actions\n\n  # Helper to compute move actions.\n  def _move_actions(cur_pos, target):\n      moves = []\n      x, y = cur_pos\n      tx, ty = target\n      while x < tx:\n          moves.append(3)   # RIGHT\n          x += 1\n      while x > tx:\n          moves.append(2)   # LEFT\n          x -= 1\n      while y < ty:\n          moves.append(0)   # DOWN\n          y += 1\n      while y > ty:\n          moves.append(1)   # UP\n          y -= 1\n      return moves, (x, y)\n\n  # 3) If stick is a primitive, just collect it (should have been caught above,\n  #    but keep for completeness).\n  if stick_idx in cookbook.primitives:\n      # No primitive cells found \u2013 nothing to do.\n      return []\n\n  # 4) Otherwise, follow its recipe.\n  primitive_req = cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n  recipe = cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = cookbook.index[workshop_name] if workshop_name is not None else None\n\n  actions = []\n  cur_pos = state.pos\n  inventory = state.inventory.copy()\n\n  # Collect required primitive ingredients.\n  for prim_idx, needed in primitive_req.items():\n      while inventory[prim_idx] < needed:\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # Primitive not available on the map \u2013 abort planning.\n              return actions\n          target = tuple(prim_cells[0])\n          moves, cur_pos = _move_actions(cur_pos, target)\n          actions.extend(moves)\n          actions.append(4)                # USE to pick up the primitive\n          inventory[prim_idx] += 1\n\n  # Go to the required workshop (if any) and craft the stick.\n  if workshop_idx is not None:\n      ws_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if ws_cells.size == 0:\n          return actions\n      target = tuple(ws_cells[0])\n      moves, cur_pos = _move_actions(cur_pos, target)\n      actions.extend(moves)\n      actions.append(4)                    # USE to craft the stick\n  else:\n      # No workshop needed; craft at current location.\n      actions.append(4)\n\n  return actions", "env_interactions": 4, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:03:27.967928", "function_name": "make_arrow", "function_body": "  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions from start to goal using\n      horizontal then vertical moves (ignores obstacles).\"\"\"\n      x, y = start\n      gx, gy = goal\n      actions = []\n      while x < gx:\n          actions.append(ACTION_RIGHT)\n          x += 1\n      while x > gx:\n          actions.append(ACTION_LEFT)\n          x -= 1\n      while y < gy:\n          actions.append(ACTION_DOWN)\n          y += 1\n      while y > gy:\n          actions.append(ACTION_UP)\n          y -= 1\n      return actions\n\n  def nearest_position(positions, reference):\n      \"\"\"Pick the position from *positions* with smallest Manhattan distance\n      to *reference*.\"\"\"\n      if len(positions) == 0:\n          return None\n      ref = np.array(reference)\n      dists = np.sum(np.abs(positions - ref), axis=1)\n      return tuple(positions[np.argmin(dists)])\n\n  # ------------------------------------------------------------------\n  # Gather current state information\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n\n  # ------------------------------------------------------------------\n  # Identify goal (stick)\n  # ------------------------------------------------------------------\n  goal_name = \"stick\"\n  try:\n      goal_idx = env.world.cookbook.index[goal_name]\n  except Exception:\n      return []\n\n  # If we already have a stick, nothing to do.\n  if inventory[goal_idx] > 0:\n      return []\n\n  plan_actions = []\n\n  # ------------------------------------------------------------------\n  # 1) Collect needed primitives (if any)\n  # ------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  for prim_idx, needed_cnt in primitives_needed.items():\n      while inventory[prim_idx] < needed_cnt:\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # No more of this primitive on the map \u2013 abort planning.\n              return plan_actions\n          target = nearest_position(prim_cells, pos)\n\n          # Move to the primitive.\n          plan_actions.extend(manhattan_path(pos, target))\n          pos = target\n\n          # Pick it up.\n          plan_actions.append(ACTION_USE)\n\n          # Simulate the pick\u2011up for subsequent planning steps.\n          inventory[prim_idx] += 1\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # ------------------------------------------------------------------\n  # 2) Craft the stick (if a recipe exists) or simply collect it.\n  # ------------------------------------------------------------------\n  if goal_idx not in env.world.cookbook.recipes:\n      # Stick is a primitive that can be collected directly.\n      stick_cells = np.argwhere(grid[:, :, goal_idx] > 0)\n      if stick_cells.size == 0:\n          return plan_actions\n      target = nearest_position(stick_cells, pos)\n      plan_actions.extend(manhattan_path(pos, target))\n      plan_actions.append(ACTION_USE)\n      return plan_actions\n\n  # There is a recipe \u2013 check for required workshop.\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      try:\n          workshop_idx = env.world.cookbook.index[workshop_name]\n      except Exception:\n          return plan_actions\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          return plan_actions\n      wcell = tuple(workshop_cells[0])\n\n      # Find a free adjacent cell to stand on.\n      neighbours = [(wcell[0] + dx, wcell[1] + dy) for dx, dy in\n                    [(1, 0), (-1, 0), (0, 1), (0, -1)]]\n      stand_pos = None\n      for nx, ny in neighbours:\n          if (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and\n                  grid[nx, ny, :].sum() == 0):\n              stand_pos = (nx, ny)\n              break\n      if stand_pos is None:\n          stand_pos = wcell  # fallback: stand directly on the workshop\n\n      # Move to the standing position and use the workshop.\n      plan_actions.extend(manhattan_path(pos, stand_pos))\n      plan_actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # Return the full action sequence.\n  # ------------------------------------------------------------------\n  return plan_actions", "env_interactions": 5, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:03:29.246862", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # Action indices (consistent with CraftLab)\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions from start to goal using\n      horizontal then vertical moves (ignores obstacles).\"\"\"\n      x, y = start\n      gx, gy = goal\n      actions = []\n      while x < gx:\n          actions.append(ACTION_RIGHT)\n          x += 1\n      while x > gx:\n          actions.append(ACTION_LEFT)\n          x -= 1\n      while y < gy:\n          actions.append(ACTION_DOWN)\n          y += 1\n      while y > gy:\n          actions.append(ACTION_UP)\n          y -= 1\n      return actions\n\n  def nearest_position(positions, reference):\n      \"\"\"Pick the position from *positions* with smallest Manhattan distance\n      to *reference*.\"\"\"\n      if len(positions) == 0:\n          return None\n      ref = np.array(reference)\n      dists = np.sum(np.abs(positions - ref), axis=1)\n      return tuple(positions[np.argmin(dists)])\n\n  # ------------------------------------------------------------------\n  # Gather current state information\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()          # mutable copy for planning\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n\n  # ------------------------------------------------------------------\n  # Identify goal (stick)\n  # ------------------------------------------------------------------\n  try:\n      goal_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      # Stick not defined in the recipe book \u2013 nothing to do\n      return []\n\n  # If we already have a stick, no actions are needed\n  if inventory[goal_idx] > 0:\n      return []\n\n  plan_actions = []\n\n  # ------------------------------------------------------------------\n  # 1) Collect required primitives (if any)\n  # ------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  for prim_idx, needed_cnt in primitives_needed.items():\n      while inventory[prim_idx] < needed_cnt:\n          # locate cells containing the primitive\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # No more of this primitive on the map \u2013 abort planning\n              return plan_actions\n          target = nearest_position(prim_cells, pos)\n\n          # move to the primitive\n          plan_actions.extend(manhattan_path(pos, target))\n          pos = target\n\n          # pick it up\n          plan_actions.append(ACTION_USE)\n\n          # simulate the pickup locally for subsequent planning\n          inventory[prim_idx] += 1\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # ------------------------------------------------------------------\n  # 2) Craft the stick (if a recipe exists) or pick it up directly\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n\n  if \"_at\" in recipe:\n      # Crafting requires a specific workshop\n      workshop_name = recipe[\"_at\"]\n      try:\n          workshop_idx = env.world.cookbook.index[workshop_name]\n      except Exception:\n          return plan_actions\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          # No visible workshop \u2013 cannot craft\n          return plan_actions\n\n      wcell = tuple(workshop_cells[0])\n\n      # Find a free adjacent cell to stand on\n      neighbours = [\n          (wcell[0] + dx, wcell[1] + dy)\n          for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]\n      ]\n      stand_pos = None\n      for nx, ny in neighbours:\n          if (0 <= nx < grid.shape[0] and\n              0 <= ny < grid.shape[1] and\n              grid[nx, ny, :].sum() == 0):\n              stand_pos = (nx, ny)\n              break\n      if stand_pos is None:\n          # As a fallback, stand directly on the workshop cell\n          stand_pos = wcell\n\n      # Move to the standing position and use the workshop\n      plan_actions.extend(manhattan_path(pos, stand_pos))\n      plan_actions.append(ACTION_USE)\n\n  else:\n      # No workshop required \u2013 the stick should be present on the map\n      stick_cells = np.argwhere(grid[:, :, goal_idx] > 0)\n      if stick_cells.size == 0:\n          # Nothing to pick up; return whatever we have planned so far\n          return plan_actions\n      target = nearest_position(stick_cells, pos)\n      plan_actions.extend(manhattan_path(pos, target))\n      plan_actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # Return the full action list\n  # ------------------------------------------------------------------\n  return plan_actions", "env_interactions": 5, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:03:52.659121", "function_name": "make_arrow", "function_body": "  # Helper: BFS shortest path avoiding blocked cells\n  def _bfs_path(start, goal, blocked_mask):\n      from collections import deque\n\n      specs = env.action_specs()\n      dirs = [\n          (0, 1, specs[\"DOWN\"]),   # down\n          (0, -1, specs[\"UP\"]),    # up\n          (-1, 0, specs[\"LEFT\"]),  # left\n          (1, 0, specs[\"RIGHT\"]),  # right\n      ]\n\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for dx, dy, a in dirs:\n              nx, ny = x + dx, y + dy\n              if (\n                  0 <= nx < blocked_mask.shape[0]\n                  and 0 <= ny < blocked_mask.shape[1]\n                  and not blocked_mask[nx, ny]\n                  and (nx, ny) not in visited\n              ):\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [a]))\n      return None  # unreachable\n\n  # ------------------------------------------------------------------\n  # Gather necessary objects from the environment\n  # ------------------------------------------------------------------\n  state = env._current_state\n  world = env.world\n  grid = state.grid.copy()                     # copy for planning only\n  specs = env.action_specs()\n  USE = specs[\"USE\"]\n\n  # Index of the target item \"stick\"\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # Primitive requirements for a stick (empty dict if stick is primitive)\n  prim_req = world.cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n\n  # Build a mask of blocked cells (non\u2011grabbable entities)\n  blocked = np.zeros(grid.shape[:2], dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # ------------------------------------------------------------------\n  # Case 1: stick is a primitive already placed in the world\n  # ------------------------------------------------------------------\n  if not prim_req:\n      stick_cells = np.argwhere(grid[:, :, stick_idx] > 0)\n      if stick_cells.size == 0:\n          return []  # cannot find a stick\n      target = tuple(stick_cells[0])\n      if cur_pos != target:\n          path = _bfs_path(cur_pos, target, blocked)\n          if path is None:\n              return []  # unreachable\n          actions.extend(path)\n          cur_pos = target\n      actions.append(USE)\n      return actions\n\n  # ------------------------------------------------------------------\n  # Case 2: collect required primitives\n  # ------------------------------------------------------------------\n  needed = dict(prim_req)   # mutable copy of required counts\n\n  while any(cnt > 0 for cnt in needed.values()):\n      best_path = None\n      best_target = None\n      best_prim = None\n\n      # Find the nearest reachable needed primitive\n      for prim_idx, cnt in needed.items():\n          if cnt <= 0:\n              continue\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          for cell in prim_cells:\n              target = tuple(cell)\n              path = _bfs_path(cur_pos, target, blocked)\n              if path is None:\n                  continue\n              if best_path is None or len(path) < len(best_path):\n                  best_path = path\n                  best_target = target\n                  best_prim = prim_idx\n\n      if best_path is None:\n          # No reachable required primitive left\n          return actions\n\n      # Move to the primitive and pick it up\n      actions.extend(best_path)\n      actions.append(USE)\n\n      # Update planning state\n      cur_pos = best_target\n      needed[best_prim] -= 1\n      grid[best_target[0], best_target[1], best_prim] = 0   # remove from copy\n\n  # ------------------------------------------------------------------\n  # Case 3: go to required workshop (if any) and craft the stick\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          target = tuple(workshop_cells[0])\n          if cur_pos != target:\n              path = _bfs_path(cur_pos, target, blocked)\n              if path is not None:\n                  actions.extend(path)\n                  cur_pos = target\n\n  # Finally, craft the stick\n  actions.append(USE)\n  return actions", "env_interactions": 3, "island_id": 3, "scores": {"3": 0.0}}
