{"timestamp": "2025-10-23T04:25:09.913021", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n  stick_idx = cookbook.index['stick']\n\n  # If we already possess a stick, nothing to do.\n  if state.inventory[stick_idx] > 0:\n      return []\n\n  # ---------- helper utilities ----------\n  def _move_to(cur_pos, tx, ty, actions):\n      \"\"\"Append moves that bring the agent from cur_pos to (tx, ty).\"\"\"\n      x, y = cur_pos\n      while x < tx:\n          actions.append(3)   # RIGHT\n          x += 1\n      while x > tx:\n          actions.append(2)   # LEFT\n          x -= 1\n      while y < ty:\n          actions.append(0)   # DOWN\n          y += 1\n      while y > ty:\n          actions.append(1)   # UP\n          y -= 1\n      return (x, y)\n\n  def _find_any(kind_idx):\n      \"\"\"Return coordinates of any cell containing the given kind index.\"\"\"\n      cells = np.argwhere(state.grid[:, :, kind_idx] > 0)\n      return tuple(cells[0]) if cells.size > 0 else None\n  # -----------------------------------------\n\n  actions = []\n  cur_pos = state.pos\n\n  # ----- Case 1: stick is a primitive (just collect it) -----\n  if stick_idx in cookbook.primitives:\n      target = _find_any(stick_idx)\n      if target is None:\n          return []                     # no primitive stick present\n      cur_pos = _move_to(cur_pos, target[0], target[1], actions)\n      actions.append(4)                 # USE to pick up\n      return actions\n\n  # ----- Case 2: stick must be crafted from a recipe -----\n  recipe = cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get('_at', None)\n\n  # Collect all non\u2011workshop ingredients.\n  for ing_key, cnt in recipe.items():\n      if ing_key == '_at':\n          continue\n      ing_idx = ing_key if isinstance(ing_key, int) else cookbook.index[ing_key]\n      for _ in range(cnt):\n          target = _find_any(ing_idx)\n          if target is None:\n              return []                 # missing ingredient\n          cur_pos = _move_to(cur_pos, target[0], target[1], actions)\n          actions.append(4)             # USE to pick up ingredient\n\n  # Move to the required workshop (if any) before crafting.\n  if workshop_name is not None:\n      ws_idx = cookbook.index[workshop_name]\n      target = _find_any(ws_idx)\n      if target is None:\n          return []                     # workshop not found\n      cur_pos = _move_to(cur_pos, target[0], target[1], actions)\n\n  # Finally craft the stick.\n  actions.append(4)                     # USE to craft\n  return actions", "env_interactions": 4, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:25:34.967049", "function_name": "make_arrow", "function_body": "  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Horizontal\u2011then\u2011vertical movement actions from start to goal.\"\"\"\n      x, y = start\n      gx, gy = goal\n      actions = []\n      while x < gx:\n          actions.append(ACTION_RIGHT)\n          x += 1\n      while x > gx:\n          actions.append(ACTION_LEFT)\n          x -= 1\n      while y < gy:\n          actions.append(ACTION_DOWN)\n          y += 1\n      while y > gy:\n          actions.append(ACTION_UP)\n          y -= 1\n      return actions\n\n  def nearest_position(positions, reference):\n      \"\"\"Select the position with smallest Manhattan distance to reference.\"\"\"\n      if positions.shape[0] == 0:\n          return None\n      ref = np.array(reference)\n      dists = np.sum(np.abs(positions - ref), axis=1)\n      return tuple(positions[np.argmin(dists)])\n\n  # ------------------------------------------------------------------\n  # Gather current state\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n\n  # ------------------------------------------------------------------\n  # Identify goal (stick)\n  # ------------------------------------------------------------------\n  goal_name = \"stick\"\n  try:\n      goal_idx = env.world.cookbook.index[goal_name]\n  except Exception:\n      return []\n\n  # If we already have a stick, nothing to do\n  if inventory[goal_idx] > 0:\n      return []\n\n  plan_actions = []\n\n  # ------------------------------------------------------------------\n  # 1) Collect any required primitives\n  # ------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  for prim_idx, needed_cnt in primitives_needed.items():\n      while inventory[prim_idx] < needed_cnt:\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # No more of this primitive on the map \u2013 abort planning\n              return plan_actions\n          target = nearest_position(prim_cells, pos)\n\n          # Move to the primitive\n          plan_actions.extend(manhattan_path(pos, target))\n          pos = target\n\n          # Pick it up\n          plan_actions.append(ACTION_USE)\n\n          # Simulate the effect locally for subsequent planning\n          inventory[prim_idx] += 1\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # ------------------------------------------------------------------\n  # 2) If stick itself is a primitive (no recipe), just pick it up\n  # ------------------------------------------------------------------\n  if goal_idx not in env.world.cookbook.recipes:\n      stick_cells = np.argwhere(grid[:, :, goal_idx] > 0)\n      if stick_cells.shape[0] == 0:\n          return plan_actions\n      target = nearest_position(stick_cells, pos)\n      plan_actions.extend(manhattan_path(pos, target))\n      pos = target\n      plan_actions.append(ACTION_USE)\n      return plan_actions\n\n  # ------------------------------------------------------------------\n  # 3) Go to required workshop and craft the stick\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      return plan_actions\n\n  try:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n  except Exception:\n      return plan_actions\n\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.shape[0] == 0:\n      return plan_actions\n  wcell = tuple(workshop_cells[0])\n\n  # Find a free adjacent cell to stand on (fallback to the workshop cell itself)\n  neighbours = [(wcell[0] + dx, wcell[1] + dy) for dx, dy in\n                [(1, 0), (-1, 0), (0, 1), (0, -1)]]\n  stand_pos = None\n  for nx, ny in neighbours:\n      if (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and\n              grid[nx, ny, :].sum() == 0):\n          stand_pos = (nx, ny)\n          break\n  if stand_pos is None:\n      stand_pos = wcell\n\n  # Move to the chosen standing position\n  plan_actions.extend(manhattan_path(pos, stand_pos))\n  pos = stand_pos\n\n  # Use the workshop to craft the stick\n  plan_actions.append(ACTION_USE)\n\n  return plan_actions", "env_interactions": 5, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:25:36.343918", "function_name": "make_arrow", "function_body": "  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions from start to goal using\n      horizontal\u2011then\u2011vertical moves (ignores obstacles).\"\"\"\n      x, y = start\n      gx, gy = goal\n      actions = []\n      while x < gx:\n          actions.append(ACTION_RIGHT)\n          x += 1\n      while x > gx:\n          actions.append(ACTION_LEFT)\n          x -= 1\n      while y < gy:\n          actions.append(ACTION_DOWN)\n          y += 1\n      while y > gy:\n          actions.append(ACTION_UP)\n          y -= 1\n      return actions\n\n  def nearest_position(positions, reference):\n      \"\"\"Pick the position from *positions* with smallest Manhattan distance\n      to *reference*.\"\"\"\n      if positions.shape[0] == 0:\n          return None\n      ref = np.array(reference)\n      dists = np.sum(np.abs(positions - ref), axis=1)\n      return tuple(positions[np.argmin(dists)])\n\n  # ------------------------------------------------------------------\n  # Gather current state\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n\n  # ------------------------------------------------------------------\n  # Identify goal (stick)\n  # ------------------------------------------------------------------\n  goal_name = \"stick\"\n  try:\n      goal_idx = env.world.cookbook.index[goal_name]\n  except Exception:\n      # Goal not defined in this world\n      return []\n\n  # If we already have a stick, nothing to do\n  if inventory[goal_idx] > 0:\n      return []\n\n  plan_actions = []\n\n  # ------------------------------------------------------------------\n  # 1) Collect required primitives (if any)\n  # ------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  for prim_idx, needed_cnt in primitives_needed.items():\n      while inventory[prim_idx] < needed_cnt:\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # No more of this primitive on the map \u2013 abort planning\n              return plan_actions\n          target = nearest_position(prim_cells, pos)\n\n          # Move to the primitive\n          plan_actions.extend(manhattan_path(pos, target))\n          pos = target\n\n          # Pick it up\n          plan_actions.append(ACTION_USE)\n\n          # Simulate effect locally for subsequent planning\n          inventory[prim_idx] += 1\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # ------------------------------------------------------------------\n  # 2) If stick itself is a primitive (no recipe), just pick it up\n  # ------------------------------------------------------------------\n  if goal_idx not in env.world.cookbook.recipes:\n      stick_cells = np.argwhere(grid[:, :, goal_idx] > 0)\n      if stick_cells.shape[0] == 0:\n          return plan_actions\n      target = nearest_position(stick_cells, pos)\n      plan_actions.extend(manhattan_path(pos, target))\n      pos = target\n      plan_actions.append(ACTION_USE)\n      return plan_actions\n\n  # ------------------------------------------------------------------\n  # 3) Go to required workshop and craft the stick\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      return plan_actions\n\n  try:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n  except Exception:\n      return plan_actions\n\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.shape[0] == 0:\n      return plan_actions\n  wcell = tuple(workshop_cells[0])\n\n  # Find a free adjacent cell to stand on (fallback to the workshop cell itself)\n  neighbours = [(wcell[0] + dx, wcell[1] + dy) for dx, dy in\n                [(1, 0), (-1, 0), (0, 1), (0, -1)]]\n  stand_pos = None\n  for nx, ny in neighbours:\n      if (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and\n              grid[nx, ny, :].sum() == 0):\n          stand_pos = (nx, ny)\n          break\n  if stand_pos is None:\n      stand_pos = wcell\n\n  # Move to the chosen standing position\n  plan_actions.extend(manhattan_path(pos, stand_pos))\n  pos = stand_pos\n\n  # Use the workshop to craft the stick\n  plan_actions.append(ACTION_USE)\n\n  return plan_actions", "env_interactions": 5, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:25:51.512448", "function_name": "make_arrow", "function_body": "  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act.get(\"DOWN\", 0),\n      act.get(\"UP\", 1),\n      act.get(\"LEFT\", 2),\n      act.get(\"RIGHT\", 3),\n      act.get(\"USE\", 4),\n  )\n\n  # snapshot of current state (do not modify env)\n  state = env._current_state\n  grid = state.grid.copy()                 # (W, H, n_kinds)\n  cur_pos = tuple(state.pos)               # (x, y)\n\n  # index of the goal item \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n      if stick_idx is None:\n          return []   # stick not defined in the world\n\n  # recipe: mapping of primitive kind indices to required counts,\n  # possibly with a non\u2011int key for the required workshop.\n  recipe = env.world.cookbook.primitives_for(stick_idx)\n\n  # extract primitive requirements (int keys)\n  primitive_needs = {k: v for k, v in recipe.items() if isinstance(k, int)}\n\n  # if stick itself is a primitive (no recipe), just need one stick\n  if not primitive_needs:\n      primitive_needs = {stick_idx: 1}\n\n  # detect workshop requirement (non\u2011int key in recipe)\n  workshop_idx = None\n  for k, v in recipe.items():\n      if not isinstance(k, int):\n          workshop_idx = v if isinstance(v, int) else None\n          break\n\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # Helper: find the closest cell that still contains at least one of kind_idx\n  # ----------------------------------------------------------------------\n  def find_closest(kind_idx, cur):\n      positions = np.argwhere(grid[:, :, kind_idx] > 0)\n      if positions.shape[0] == 0:\n          return None\n      dists = np.sum(np.abs(positions - np.array(cur)), axis=1)\n      nearest = positions[np.argmin(dists)]\n      return tuple(nearest.tolist())\n\n  # ----------------------------------------------------------------------\n  # Helper: greedy Manhattan path from cur to target, returns actions + final pos\n  # ----------------------------------------------------------------------\n  def path_to(cur, target):\n      x, y = cur\n      tx, ty = target\n      path = []\n      while (x, y) != (tx, ty):\n          if x < tx:\n              path.append(RIGHT)\n              x += 1\n          elif x > tx:\n              path.append(LEFT)\n              x -= 1\n          elif y < ty:\n              path.append(DOWN)\n              y += 1\n          elif y > ty:\n              path.append(UP)\n              y -= 1\n      return path, (x, y)\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive the needed number of times\n  # ----------------------------------------------------------------------\n  for kind_idx, needed in primitive_needs.items():\n      while needed > 0:\n          target = find_closest(kind_idx, cur_pos)\n          if target is None:\n              # required primitive not present \u2013 abort planning\n              return actions\n          move_actions, cur_pos = path_to(cur_pos, target)\n          actions.extend(move_actions)\n          actions.append(USE)   # pick up the primitive\n\n          # Update local grid copy to reflect the collection\n          grid[target[0], target[1], kind_idx] = max(\n              0, grid[target[0], target[1], kind_idx] - 1\n          )\n          needed -= 1\n\n  # ----------------------------------------------------------------------\n  # If a workshop is required, move to it and craft the stick\n  # ----------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_target = find_closest(workshop_idx, cur_pos)\n      if ws_target is not None:\n          move_actions, cur_pos = path_to(cur_pos, ws_target)\n          actions.extend(move_actions)\n          actions.append(USE)   # craft stick at the workshop\n\n  return actions", "env_interactions": 2, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:25:52.829686", "function_name": "make_arrow", "function_body": "  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act.get(\"DOWN\", 0),\n      act.get(\"UP\", 1),\n      act.get(\"LEFT\", 2),\n      act.get(\"RIGHT\", 3),\n      act.get(\"USE\", 4),\n  )\n\n  # snapshot of current state (do not mutate env)\n  state = env._current_state\n  grid = state.grid.copy()                 # (W, H, n_kinds)\n  cur_pos = tuple(state.pos)               # (x, y)\n\n  # locate the index for \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n      if stick_idx is None:\n          return []   # stick not defined in this world\n\n  # retrieve recipe: primitives required and optional workshop\n  recipe = env.world.cookbook.primitives_for(stick_idx)   # dict {kind_idx: count}\n  primitive_needs = {k: v for k, v in recipe.items() if isinstance(k, int)}\n\n  # if stick itself is a primitive (no recipe), we need to collect one\n  if not primitive_needs:\n      primitive_needs = {stick_idx: 1}\n\n  # detect workshop requirement (non\u2011int key in recipe)\n  workshop_idx = None\n  for k, v in recipe.items():\n      if not isinstance(k, int):\n          workshop_idx = v if isinstance(v, int) else None\n          break\n\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # Helper: find the closest cell that still contains at least one of kind_idx\n  # ----------------------------------------------------------------------\n  def find_closest(kind_idx, cur):\n      positions = np.argwhere(grid[:, :, kind_idx] > 0)\n      if positions.shape[0] == 0:\n          return None\n      dists = np.sum(np.abs(positions - np.array(cur)), axis=1)\n      nearest = positions[np.argmin(dists)]\n      return tuple(nearest.tolist())\n\n  # ----------------------------------------------------------------------\n  # Helper: generate a simple Manhattan path from cur to target\n  # ----------------------------------------------------------------------\n  def path_to(cur, target):\n      x, y = cur\n      tx, ty = target\n      path = []\n      while (x, y) != (tx, ty):\n          if x < tx:\n              path.append(RIGHT)\n              x += 1\n          elif x > tx:\n              path.append(LEFT)\n              x -= 1\n          elif y < ty:\n              path.append(DOWN)\n              y += 1\n          elif y > ty:\n              path.append(UP)\n              y -= 1\n      return path, (x, y)\n\n  # ----------------------------------------------------------------------\n  # Collect required primitives\n  # ----------------------------------------------------------------------\n  for kind_idx, needed in primitive_needs.items():\n      while needed > 0:\n          target = find_closest(kind_idx, cur_pos)\n          if target is None:\n              # primitive not present on map \u2013 abort planning\n              return actions\n          move_actions, cur_pos = path_to(cur_pos, target)\n          actions.extend(move_actions)\n          actions.append(USE)   # pick up the primitive\n\n          # update local grid copy to reflect consumption\n          grid[target[0], target[1], kind_idx] = max(\n              0, grid[target[0], target[1], kind_idx] - 1\n          )\n          needed -= 1\n\n  # ----------------------------------------------------------------------\n  # If a workshop is required, move there and craft the stick\n  # ----------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_target = find_closest(workshop_idx, cur_pos)\n      if ws_target is not None:\n          move_actions, cur_pos = path_to(cur_pos, ws_target)\n          actions.extend(move_actions)\n          actions.append(USE)   # craft stick at the workshop\n\n  return actions", "env_interactions": 2, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:26:11.622994", "function_name": "make_arrow", "function_body": "  def _move_actions(cur_pos, target):\n      actions = []\n      x, y = cur_pos\n      tx, ty = target\n      while x < tx:\n          actions.append(3)  # RIGHT\n          x += 1\n      while x > tx:\n          actions.append(2)  # LEFT\n          x -= 1\n      while y < ty:\n          actions.append(0)  # DOWN\n          y += 1\n      while y > ty:\n          actions.append(1)  # UP\n          y -= 1\n      return actions, (x, y)\n\n  state = env._current_state\n  cookbook = env.world.cookbook\n  stick_idx = cookbook.index['stick']\n\n  # If we already have a stick in inventory, nothing to do.\n  if state.inventory[stick_idx] > 0:\n      return []\n\n  # If a stick lies on the ground, go pick it up.\n  stick_cells = np.argwhere(state.grid[:, :, stick_idx] > 0)\n  if stick_cells.size > 0:\n      target = tuple(stick_cells[0])\n      moves, _ = _move_actions(state.pos, target)\n      moves.append(4)  # USE\n      return moves\n\n  # Determine required primitives and workshop (if any) for the stick.\n  primitive_req = cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n  recipe = cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = cookbook.index[workshop_name] if workshop_name is not None else None\n\n  # If there is no recipe and no workshop, we cannot obtain a stick.\n  if not primitive_req and workshop_idx is None:\n      return []\n\n  actions = []\n  cur_pos = state.pos\n  inventory = state.inventory.copy()\n\n  # Collect all required primitive ingredients.\n  for prim_idx, needed in primitive_req.items():\n      while inventory[prim_idx] < needed:\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # Primitive not available on the map \u2013 abort planning.\n              return actions\n          target = tuple(prim_cells[0])\n          moves, cur_pos = _move_actions(cur_pos, target)\n          actions.extend(moves)\n          actions.append(4)                 # USE to pick up the primitive\n          inventory[prim_idx] += 1\n\n  # Move to the appropriate workshop (if required) and craft the stick.\n  if workshop_idx is not None:\n      ws_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if ws_cells.size == 0:\n          # Required workshop missing \u2013 abort.\n          return actions\n      target = tuple(ws_cells[0])\n      moves, cur_pos = _move_actions(cur_pos, target)\n      actions.extend(moves)\n      actions.append(4)                     # USE to craft the stick\n  else:\n      # No workshop needed; craft at current location.\n      actions.append(4)\n\n  return actions", "env_interactions": 4, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:26:12.955701", "function_name": "make_arrow", "function_body": "  # Helper to compute movement actions from current position to target cell.\n  def _move(cur_pos, target):\n      actions = []\n      x, y = cur_pos\n      tx, ty = target\n      # Move in x direction (columns)\n      while x < tx:\n          actions.append(3)  # RIGHT\n          x += 1\n      while x > tx:\n          actions.append(2)  # LEFT\n          x -= 1\n      # Move in y direction (rows)\n      while y < ty:\n          actions.append(0)  # DOWN\n          y += 1\n      while y > ty:\n          actions.append(1)  # UP\n          y -= 1\n      return actions, (x, y)\n\n  state = env._current_state\n  cookbook = env.world.cookbook\n  stick_idx = cookbook.index['stick']\n\n  # 1. Already have a stick in inventory.\n  if state.inventory[stick_idx] > 0:\n      return []\n\n  # 2. Stick lying on the ground \u2013 just go pick it up.\n  stick_cells = np.argwhere(state.grid[:, :, stick_idx] > 0)\n  if stick_cells.size > 0:\n      target = tuple(stick_cells[0])\n      moves, _ = _move(state.pos, target)\n      moves.append(4)                     # USE to pick up\n      return moves\n\n  # 3. Determine recipe requirements.\n  primitive_req = cookbook.primitives_for(stick_idx)          # {prim_idx: count}\n  recipe = cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = cookbook.index[workshop_name] if workshop_name is not None else None\n\n  # If there is nothing to craft (no primitives and no workshop) we cannot obtain a stick.\n  if not primitive_req and workshop_idx is None:\n      return []\n\n  actions = []\n  cur_pos = state.pos\n  inv = state.inventory.copy()\n\n  # 4. Collect required primitive items.\n  for prim_idx, needed in primitive_req.items():\n      while inv[prim_idx] < needed:\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # Primitive not present on the map \u2013 abort planning.\n              return actions\n          target = tuple(prim_cells[0])\n          moves, cur_pos = _move(cur_pos, target)\n          actions.extend(moves)\n          actions.append(4)                 # USE to pick up primitive\n          inv[prim_idx] += 1\n\n  # 5. Go to workshop (if any) and craft the stick.\n  if workshop_idx is not None:\n      ws_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if ws_cells.size == 0:\n          # Required workshop missing \u2013 abort.\n          return actions\n      target = tuple(ws_cells[0])\n      moves, cur_pos = _move(cur_pos, target)\n      actions.extend(moves)\n      actions.append(4)                     # USE to craft stick\n  else:\n      # No workshop needed; just use at current location.\n      actions.append(4)\n\n  return actions", "env_interactions": 4, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:26:30.097207", "function_name": "make_arrow", "function_body": "  actions = []\n  state = env._current_state\n  grid = state.grid\n  world = env.world\n  cb = world.cookbook\n\n  # Index of the target item \"stick\"\n  try:\n      stick_idx = cb.index[\"stick\"]\n  except Exception:\n      return actions\n\n  # Determine required primitives (empty dict if stick is a primitive)\n  needed_prims = cb.primitives_for(stick_idx)\n\n  # Current mutable agent position [x, y]\n  pos = list(state.pos)\n\n  # Helper to move agent to a target cell using Manhattan moves\n  def _move_to(target):\n      nonlocal pos, actions\n      tx, ty = target\n      while pos[0] < tx:\n          actions.append(3)   # RIGHT\n          pos[0] += 1\n      while pos[0] > tx:\n          actions.append(2)   # LEFT\n          pos[0] -= 1\n      while pos[1] < ty:\n          actions.append(0)   # DOWN\n          pos[1] += 1\n      while pos[1] > ty:\n          actions.append(1)   # UP\n          pos[1] -= 1\n\n  # If stick is a primitive, just pick it up and finish.\n  if not needed_prims:\n      locs = np.argwhere(grid[:, :, stick_idx] > 0)\n      if locs.size:\n          _move_to(locs[0].tolist())\n          actions.append(4)   # USE to pick up the stick\n      return actions\n\n  # Collect each required primitive in the quantities needed.\n  for prim_idx, count in needed_prims.items():\n      locs = np.argwhere(grid[:, :, prim_idx] > 0)\n      if not locs.size:\n          continue  # Primitive not present; should not happen in valid scenarios\n      target = locs[0].tolist()\n      _move_to(target)\n      for _ in range(count):\n          actions.append(4)   # USE to pick up one unit of the primitive\n\n  # Move to the appropriate workshop (if any) and craft the stick.\n  recipe = cb.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = cb.index[workshop_name]\n      w_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if w_locs.size:\n          _move_to(w_locs[0].tolist())\n          actions.append(4)   # USE to craft at the workshop\n\n  return actions", "env_interactions": 4, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:26:31.354064", "function_name": "make_arrow", "function_body": "  actions = []\n  state = env._current_state\n  grid = state.grid\n  world = env.world\n  cb = world.cookbook\n\n  # Index of the target item \"stick\"\n  try:\n      goal_idx = cb.index[\"stick\"]\n  except Exception:\n      return actions\n\n  # Primitives required to craft a stick (empty if stick is primitive)\n  needed_prims = cb.primitives_for(goal_idx)\n\n  # Current mutable position (x, y)\n  pos = list(state.pos)\n\n  def _move_to(target):\n      nonlocal pos, actions\n      tx, ty = target\n      while pos[0] < tx:\n          actions.append(3)   # RIGHT\n          pos[0] += 1\n      while pos[0] > tx:\n          actions.append(2)   # LEFT\n          pos[0] -= 1\n      while pos[1] < ty:\n          actions.append(0)   # DOWN\n          pos[1] += 1\n      while pos[1] > ty:\n          actions.append(1)   # UP\n          pos[1] -= 1\n\n  # If stick is a primitive, just pick it up.\n  if not needed_prims:\n      locs = np.argwhere(grid[:, :, goal_idx] > 0)\n      if locs.size:\n          _move_to(locs[0].tolist())\n          actions.append(4)   # USE to pick up the stick\n      return actions\n\n  # Collect each required primitive.\n  for prim_idx, count in needed_prims.items():\n      locs = np.argwhere(grid[:, :, prim_idx] > 0)\n      if not locs.size:\n          continue  # Primitive not present; should not happen in a valid scenario\n      target = locs[0].tolist()\n      _move_to(target)\n      for _ in range(count):\n          actions.append(4)   # USE to pick up one unit of the primitive\n\n  # Move to the appropriate workshop (if any) and craft the stick.\n  recipe = cb.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = cb.index[workshop_name]\n      w_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if w_locs.size:\n          _move_to(w_locs[0].tolist())\n          actions.append(4)   # USE to craft at the workshop\n\n  return actions", "env_interactions": 4, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:26:50.355167", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Resolve world object from environment\n  # ----------------------------------------------------------------------\n  if hasattr(env, \"world\"):\n      world = env.world\n  elif hasattr(env, \"scenario\"):\n      world = env.scenario.world\n  else:\n      raise AttributeError(\"Cannot locate CraftWorld instance in the supplied env.\")\n\n  # ----------------------------------------------------------------------\n  # Goal information (stick)\n  # ----------------------------------------------------------------------\n  goal_name = \"stick\"\n  goal_idx = world.cookbook.index.index(goal_name)\n\n  # Ingredients required to craft the stick (if any)\n  needed = world.cookbook.primitives_for(goal_idx)   # dict {prim_idx: count}\n\n  # ----------------------------------------------------------------------\n  # Obtain the current state for planning (position + grid)\n  # ----------------------------------------------------------------------\n  if hasattr(env, \"_current_state\"):\n      state = env._current_state\n  else:\n      state = env.scenario.init()\n\n  cur_pos = tuple(state.pos)          # (row, col)\n  grid = state.grid.copy()            # (H, W, n_kinds)\n\n  # ----------------------------------------------------------------------\n  # Action constants and helper utilities\n  # ----------------------------------------------------------------------\n  _ACTION_DELTAS = {\n      0: (1, 0),   # DOWN\n      1: (-1, 0),  # UP\n      2: (0, -1),  # LEFT\n      3: (0, 1),   # RIGHT\n  }\n\n  def _move_actions(start, goal):\n      \"\"\"Manhattan path from start (y,x) to goal (y,x) as list of actions.\"\"\"\n      y, x = start\n      gy, gx = goal\n      acts = []\n      while y < gy:\n          acts.append(0)   # DOWN\n          y += 1\n      while y > gy:\n          acts.append(1)   # UP\n          y -= 1\n      while x < gx:\n          acts.append(3)   # RIGHT\n          x += 1\n      while x > gx:\n          acts.append(2)   # LEFT\n          x -= 1\n      return acts\n\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # Helper to collect a primitive from the grid\n  # ----------------------------------------------------------------------\n  def _collect_primitive(p_idx):\n      nonlocal cur_pos, actions, grid\n      cells = np.argwhere(grid[:, :, p_idx] > 0)\n      if cells.size == 0:\n          raise RuntimeError(f\"Primitive '{world.cookbook.index.get(p_idx)}' not found on the grid.\")\n      py, px = cells[0]\n\n      # Find an adjacent empty cell to stand on and face the primitive\n      target = None\n      for dy, dx in _ACTION_DELTAS.values():\n          ny, nx = py - dy, px - dx\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not grid[ny, nx, :].any():\n                  target = (ny, nx)\n                  break\n      if target is None:\n          raise RuntimeError(\"No reachable empty neighbour around required primitive.\")\n\n      # Move to the neighbour\n      actions.extend(_move_actions(cur_pos, target))\n      cur_pos = target\n\n      # Use to pick up the primitive\n      actions.append(4)   # USE\n      # Update planning grid (primitive removed)\n      grid[py, px, p_idx] = 0\n\n  # ----------------------------------------------------------------------\n  # 1. Collect required primitives (if any)\n  # ----------------------------------------------------------------------\n  if needed:\n      for prim_idx, cnt in needed.items():\n          for _ in range(cnt):\n              _collect_primitive(prim_idx)\n\n  # ----------------------------------------------------------------------\n  # 2. If stick itself is a primitive (no recipe), just collect it\n  # ----------------------------------------------------------------------\n  elif goal_idx in world.cookbook.primitives:\n      _collect_primitive(goal_idx)\n      return actions\n\n  # ----------------------------------------------------------------------\n  # 3. Craft the stick at its workshop (if a workshop is specified)\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_cells.size == 0:\n          raise RuntimeError(f\"Workshop '{workshop_name}' not found on the grid.\")\n      wy, wx = ws_cells[0]\n\n      # Find an empty neighbour to stand on\n      target = None\n      for dy, dx in _ACTION_DELTAS.values():\n          ny, nx = wy - dy, wx - dx\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not grid[ny, nx, :].any():\n                  target = (ny, nx)\n                  break\n      if target is None:\n          raise RuntimeError(\"No reachable empty neighbour around workshop.\")\n\n      actions.extend(_move_actions(cur_pos, target))\n      cur_pos = target\n\n  # ----------------------------------------------------------------------\n  # Final USE to craft (or pick up if no workshop)\n  # ----------------------------------------------------------------------\n  actions.append(4)   # USE\n  return actions", "env_interactions": 5, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:26:51.706558", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Identify world object from the environment\n  # ----------------------------------------------------------------------\n  if hasattr(env, \"world\"):\n      world = env.world\n  elif hasattr(env, \"scenario\"):\n      world = env.scenario.world\n  else:\n      raise AttributeError(\"Cannot locate CraftWorld instance in the supplied env.\")\n\n  # ----------------------------------------------------------------------\n  # Goal information (stick)\n  # ----------------------------------------------------------------------\n  goal_name = \"stick\"\n  goal_idx = world.cookbook.index.index(goal_name)\n\n  # Ingredients required to craft the stick (if any)\n  needed = world.cookbook.primitives_for(goal_idx)   # dict {prim_idx: count}\n\n  # ----------------------------------------------------------------------\n  # Obtain the current state for planning (position + grid)\n  # ----------------------------------------------------------------------\n  if hasattr(env, \"_current_state\"):\n      state = env._current_state\n  else:\n      state = env.scenario.init()\n\n  cur_pos = tuple(state.pos)          # (row, col)\n  grid = state.grid.copy()            # (H, W, n_kinds)\n\n  # ----------------------------------------------------------------------\n  # Action constants and helper utilities\n  # ----------------------------------------------------------------------\n  _ACTION_DELTAS = {\n      0: (1, 0),   # DOWN\n      1: (-1, 0),  # UP\n      2: (0, -1),  # LEFT\n      3: (0, 1),   # RIGHT\n  }\n\n  def _move_actions(start, goal):\n      \"\"\"Manhattan path from start (y,x) to goal (y,x) as list of actions.\"\"\"\n      y, x = start\n      gy, gx = goal\n      acts = []\n      while y < gy:\n          acts.append(0)   # DOWN\n          y += 1\n      while y > gy:\n          acts.append(1)   # UP\n          y -= 1\n      while x < gx:\n          acts.append(3)   # RIGHT\n          x += 1\n      while x > gx:\n          acts.append(2)   # LEFT\n          x -= 1\n      return acts\n\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # Helper to collect a primitive from the grid\n  # ----------------------------------------------------------------------\n  def _collect_primitive(p_idx):\n      nonlocal cur_pos, actions, grid\n      cells = np.argwhere(grid[:, :, p_idx] > 0)\n      if cells.size == 0:\n          raise RuntimeError(f\"Primitive '{world.cookbook.index.get(p_idx)}' not found on the grid.\")\n      py, px = cells[0]\n\n      # Find an adjacent empty cell to stand on and face the primitive\n      target = None\n      for dy, dx in _ACTION_DELTAS.values():\n          ny, nx = py - dy, px - dx\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not grid[ny, nx, :].any():\n                  target = (ny, nx)\n                  break\n      if target is None:\n          raise RuntimeError(\"No reachable empty neighbour around required primitive.\")\n\n      # Move to the neighbour\n      actions.extend(_move_actions(cur_pos, target))\n      cur_pos = target\n\n      # Use to pick up the primitive\n      actions.append(4)   # USE\n      # Update planning grid to reflect that the primitive has been taken\n      grid[py, px, p_idx] = 0\n\n  # ----------------------------------------------------------------------\n  # 1. Collect required primitives (if any)\n  # ----------------------------------------------------------------------\n  if needed:\n      for prim_idx, cnt in needed.items():\n          for _ in range(cnt):\n              _collect_primitive(prim_idx)\n\n  # ----------------------------------------------------------------------\n  # 2. If stick itself is a primitive (no recipe), just collect it\n  # ----------------------------------------------------------------------\n  elif goal_idx in world.cookbook.primitives:\n      _collect_primitive(goal_idx)\n      return actions\n\n  # ----------------------------------------------------------------------\n  # 3. Craft the stick at its workshop (if a workshop is specified)\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_cells.size == 0:\n          raise RuntimeError(f\"Workshop '{workshop_name}' not found on the grid.\")\n      wy, wx = ws_cells[0]\n\n      # Find an empty neighbour to stand on\n      target = None\n      for dy, dx in _ACTION_DELTAS.values():\n          ny, nx = wy - dy, wx - dx\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not grid[ny, nx, :].any():\n                  target = (ny, nx)\n                  break\n      if target is None:\n          raise RuntimeError(\"No reachable empty neighbour around workshop.\")\n\n      actions.extend(_move_actions(cur_pos, target))\n      cur_pos = target\n\n  # ----------------------------------------------------------------------\n  # Final USE to craft (or pick up if no workshop)\n  # ----------------------------------------------------------------------\n  actions.append(4)   # USE\n  return actions", "env_interactions": 5, "island_id": 7, "scores": {"3": 0.0}}
