{"timestamp": "2025-10-23T04:04:12.293258", "function_name": "make_arrow", "function_body": "  actions = []\n  state = env._current_state\n  grid = state.grid\n  world = env.world\n  cb = world.cookbook\n\n  # index of the target item \"stick\"\n  try:\n      goal_idx = cb.index[\"stick\"]\n  except Exception:\n      return actions\n\n  # primitives needed to craft a stick (empty if stick is primitive)\n  needed_prims = cb.primitives_for(goal_idx)\n\n  # mutable copy of current position (x, y)\n  pos = list(state.pos)\n\n  def _move_to(target):\n      \"\"\"Append actions to move from current pos to target cell.\"\"\"\n      nonlocal pos, actions\n      tx, ty = target\n      # move in x direction (RIGHT=3, LEFT=2)\n      while pos[0] < tx:\n          actions.append(3)   # RIGHT\n          pos[0] += 1\n      while pos[0] > tx:\n          actions.append(2)   # LEFT\n          pos[0] -= 1\n      # move in y direction (DOWN=0, UP=1)\n      while pos[1] < ty:\n          actions.append(0)   # DOWN\n          pos[1] += 1\n      while pos[1] > ty:\n          actions.append(1)   # UP\n          pos[1] -= 1\n\n  # If stick is a primitive, just pick it up\n  if not needed_prims:\n      locs = np.argwhere(grid[:, :, goal_idx] > 0)\n      if locs.size:\n          _move_to(locs[0].tolist())\n          actions.append(4)   # USE to pick up\n      return actions\n\n  # Collect each required primitive\n  for prim_idx, count in needed_prims.items():\n      locs = np.argwhere(grid[:, :, prim_idx] > 0)\n      if not locs.size:\n          continue  # primitive missing; should not happen in valid scenarios\n      _move_to(locs[0].tolist())\n      for _ in range(count):\n          actions.append(4)   # USE to pick up one unit\n\n  # Move to workshop (if recipe specifies one) and craft the stick\n  recipe = cb.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = cb.index[workshop_name]\n      w_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if w_locs.size:\n          _move_to(w_locs[0].tolist())\n          actions.append(4)   # USE to craft at the workshop\n\n  return actions", "env_interactions": 4, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:04:32.038272", "function_name": "make_arrow", "function_body": "  # Action mapping\n  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act.get(\"DOWN\", 0),\n      act.get(\"UP\", 1),\n      act.get(\"LEFT\", 2),\n      act.get(\"RIGHT\", 3),\n      act.get(\"USE\", 4),\n  )\n\n  # Snapshot of current state\n  state = env._current_state\n  grid = state.grid.copy()          # (W, H, n_kinds)\n  cur_pos = tuple(state.pos)        # (x, y)\n\n  # Index of the target item \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n      if stick_idx is None:\n          return []   # stick not defined\n\n  # Primitive requirements (empty if stick is a primitive)\n  recipe = env.world.cookbook.primitives_for(stick_idx)\n  primitive_needs = {k: v for k, v in recipe.items() if isinstance(k, int)}\n  if not primitive_needs:\n      primitive_needs = {stick_idx: 1}\n\n  # Helper: locate nearest cell containing at least one of kind_idx\n  def find_closest(kind_idx, cur):\n      positions = np.argwhere(grid[:, :, kind_idx] > 0)\n      if positions.shape[0] == 0:\n          return None\n      dists = np.sum(np.abs(positions - np.array(cur)), axis=1)\n      nearest = positions[np.argmin(dists)]\n      return tuple(nearest.tolist())\n\n  # Helper: greedy Manhattan path from cur to target\n  def path_to(cur, target):\n      x, y = cur\n      tx, ty = target\n      path = []\n      while (x, y) != (tx, ty):\n          if x < tx:\n              path.append(RIGHT)\n              x += 1\n          elif x > tx:\n              path.append(LEFT)\n              x -= 1\n          elif y < ty:\n              path.append(DOWN)\n              y += 1\n          elif y > ty:\n              path.append(UP)\n              y -= 1\n      return path, (x, y)\n\n  actions = []\n\n  # Collect required primitives\n  for kind_idx, needed in primitive_needs.items():\n      while needed > 0:\n          target = find_closest(kind_idx, cur_pos)\n          if target is None:\n              return actions  # required primitive missing\n          move_actions, cur_pos = path_to(cur_pos, target)\n          actions.extend(move_actions)\n          actions.append(USE)   # pick up primitive\n          # Update local grid copy\n          grid[target[0], target[1], kind_idx] = max(\n              0, grid[target[0], target[1], kind_idx] - 1\n          )\n          needed -= 1\n\n  # Determine if a workshop is required\n  workshop_idx = None\n  full_recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  for key, val in full_recipe.items():\n      if not isinstance(key, int):\n          workshop_idx = val if isinstance(val, int) else None\n          break\n\n  # Craft at the workshop if needed\n  if workshop_idx is not None:\n      ws_target = find_closest(workshop_idx, cur_pos)\n      if ws_target is not None:\n          move_actions, cur_pos = path_to(cur_pos, ws_target)\n          actions.extend(move_actions)\n          actions.append(USE)   # craft stick\n\n  return actions", "env_interactions": 2, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:04:33.332334", "function_name": "make_arrow", "function_body": "  # ----- Action mapping -----\n  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act.get(\"DOWN\", 0),\n      act.get(\"UP\", 1),\n      act.get(\"LEFT\", 2),\n      act.get(\"RIGHT\", 3),\n      act.get(\"USE\", 4),\n  )\n\n  # ----- Current state snapshot -----\n  state = env._current_state\n  grid = state.grid.copy()               # (W, H, n_kinds)\n  cur_pos = tuple(state.pos)             # (x, y)\n\n  # ----- Identify stick index -----\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n      if stick_idx is None:\n          return []   # stick not defined in this world\n\n  # ----- Recipe information -----\n  recipe = env.world.cookbook.primitives_for(stick_idx)   # {kind_idx: count}\n  primitive_needs = {k: v for k, v in recipe.items() if isinstance(k, int)}\n\n  # If stick itself is a primitive (no recipe), just need to pick one up\n  if not primitive_needs:\n      primitive_needs = {stick_idx: 1}\n\n  # Detect workshop requirement (non\u2011int key in full recipe)\n  workshop_idx = None\n  full_recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  for key, val in full_recipe.items():\n      if not isinstance(key, int):\n          workshop_idx = val if isinstance(val, int) else None\n          break\n\n  actions = []\n\n  # ----- Helper: locate nearest cell containing the required kind -----\n  def find_closest(kind_idx, cur):\n      positions = np.argwhere(grid[:, :, kind_idx] > 0)\n      if positions.shape[0] == 0:\n          return None\n      dists = np.sum(np.abs(positions - np.array(cur)), axis=1)\n      nearest = positions[np.argmin(dists)]\n      return tuple(nearest.tolist())\n\n  # ----- Helper: greedy Manhattan path from cur to target -----\n  def path_to(cur, target):\n      x, y = cur\n      tx, ty = target\n      path = []\n      while (x, y) != (tx, ty):\n          if x < tx:\n              path.append(RIGHT)\n              x += 1\n          elif x > tx:\n              path.append(LEFT)\n              x -= 1\n          elif y < ty:\n              path.append(DOWN)\n              y += 1\n          elif y > ty:\n              path.append(UP)\n              y -= 1\n      return path, (x, y)\n\n  # ----- Collect required primitives -----\n  for kind_idx, needed in primitive_needs.items():\n      while needed > 0:\n          target = find_closest(kind_idx, cur_pos)\n          if target is None:\n              # Primitive not available; abort planning.\n              return actions\n          move_actions, cur_pos = path_to(cur_pos, target)\n          actions.extend(move_actions)\n          actions.append(USE)   # pick up the primitive\n          # Update local grid copy to reflect consumption\n          grid[target[0], target[1], kind_idx] = max(\n              0, grid[target[0], target[1], kind_idx] - 1\n          )\n          needed -= 1\n\n  # ----- Craft at workshop if required -----\n  if workshop_idx is not None:\n      ws_target = find_closest(workshop_idx, cur_pos)\n      if ws_target is not None:\n          move_actions, cur_pos = path_to(cur_pos, ws_target)\n          actions.extend(move_actions)\n          actions.append(USE)   # craft stick at the workshop\n\n  return actions", "env_interactions": 2, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:04:50.686825", "function_name": "make_arrow", "function_body": "  actions = []\n  # Get current state and world information\n  state = env._current_state\n  grid = state.grid\n  world = env.world\n  cb = world.cookbook\n\n  # Index of the target item \"stick\"\n  try:\n      goal_idx = cb.index[\"stick\"]\n  except Exception:\n      return actions\n\n  # Current mutable position of the agent\n  pos = list(state.pos)\n\n  # Helper to move the agent to a target cell using Manhattan steps\n  def _move_to(target):\n      nonlocal pos, actions\n      tx, ty = target\n      while pos[0] < tx:\n          actions.append(3)   # RIGHT\n          pos[0] += 1\n      while pos[0] > tx:\n          actions.append(2)   # LEFT\n          pos[0] -= 1\n      while pos[1] < ty:\n          actions.append(0)   # DOWN\n          pos[1] += 1\n      while pos[1] > ty:\n          actions.append(1)   # UP\n          pos[1] -= 1\n\n  # Determine primitive requirements for the stick\n  required = cb.primitives_for(goal_idx)\n\n  if required:\n      # Collect each required primitive\n      for prim_idx, count in required.items():\n          # Find locations of this primitive in the grid\n          locs = np.argwhere(grid[:, :, prim_idx] > 0)\n          if locs.size == 0:\n              continue  # primitive not present; skip\n          target = locs[0].tolist()  # take the first occurrence\n          _move_to(target)\n          # Pick up the needed amount\n          for _ in range(count):\n              actions.append(4)   # USE\n      # After gathering primitives, go to the workshop (if any) and craft\n      recipe = cb.recipes.get(goal_idx, {})\n      workshop_name = recipe.get(\"_at\")\n      if workshop_name:\n          workshop_idx = cb.index[workshop_name]\n          w_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n          if w_locs.size:\n              w_target = w_locs[0].tolist()\n              _move_to(w_target)\n              actions.append(4)   # USE to craft at the workshop\n  else:\n      # Stick is a primitive item; just pick it up directly\n      locs = np.argwhere(grid[:, :, goal_idx] > 0)\n      if locs.size:\n          target = locs[0].tolist()\n          _move_to(target)\n          actions.append(4)   # USE to pick up the stick\n\n  return actions", "env_interactions": 4, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:04:51.981644", "function_name": "make_arrow", "function_body": "  actions = []\n  # current state and world information\n  state = env._current_state\n  grid = state.grid\n  world = env.world\n  cb = world.cookbook\n\n  # index of the target item \"stick\"\n  try:\n      goal_idx = cb.index[\"stick\"]\n  except Exception:\n      return actions\n\n  # primitive requirements for the stick (empty if stick is primitive)\n  prims = cb.primitives_for(goal_idx)\n\n  # mutable copy of the agent's current position\n  pos = list(state.pos)\n\n  # helper to move the agent using Manhattan steps\n  def _move_to(target):\n      nonlocal pos, actions\n      tx, ty = target\n      # move in x direction (RIGHT=3, LEFT=2)\n      while pos[0] < tx:\n          actions.append(3)   # RIGHT\n          pos[0] += 1\n      while pos[0] > tx:\n          actions.append(2)   # LEFT\n          pos[0] -= 1\n      # move in y direction (DOWN=0, UP=1)\n      while pos[1] < ty:\n          actions.append(0)   # DOWN\n          pos[1] += 1\n      while pos[1] > ty:\n          actions.append(1)   # UP\n          pos[1] -= 1\n\n  # ----------------------------------------------------------------------\n  # Collect required primitives (if any)\n  # ----------------------------------------------------------------------\n  for prim_idx, needed in prims.items():\n      locations = np.argwhere(grid[:, :, prim_idx] > 0)\n      if locations.size == 0:\n          continue  # primitive not present in this scenario\n      # pick the nearest occurrence to reduce travel distance\n      dists = np.abs(locations - np.array(pos)).sum(axis=1)\n      target = locations[np.argmin(dists)].tolist()\n      _move_to(target)\n      for _ in range(needed):\n          actions.append(4)   # USE to pick up the primitive\n\n  # ----------------------------------------------------------------------\n  # If stick is itself a primitive (no recipe), just pick it up now\n  # ----------------------------------------------------------------------\n  if not prims:\n      locs = np.argwhere(grid[:, :, goal_idx] > 0)\n      if locs.size:\n          dists = np.abs(locs - np.array(pos)).sum(axis=1)\n          target = locs[np.argmin(dists)].tolist()\n          _move_to(target)\n          actions.append(4)   # USE to pick up the stick\n      return actions\n\n  # ----------------------------------------------------------------------\n  # Craft the stick at its required workshop (if any)\n  # ----------------------------------------------------------------------\n  recipe = cb.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = cb.index[workshop_name]\n      w_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if w_locs.size:\n          dists = np.abs(w_locs - np.array(pos)).sum(axis=1)\n          w_target = w_locs[np.argmin(dists)].tolist()\n          _move_to(w_target)\n          actions.append(4)   # USE to craft at the workshop\n\n  return actions", "env_interactions": 4, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:05:26.979489", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  def manhattan_path(start, goal):\n      \"\"\"Return movement actions from start to goal using Manhattan moves.\"\"\"\n      x, y = start\n      gx, gy = goal\n      actions = []\n      while x < gx:\n          actions.append(ACTION_RIGHT)\n          x += 1\n      while x > gx:\n          actions.append(ACTION_LEFT)\n          x -= 1\n      while y < gy:\n          actions.append(ACTION_DOWN)\n          y += 1\n      while y > gy:\n          actions.append(ACTION_UP)\n          y -= 1\n      return actions\n\n  def nearest_position(positions, reference):\n      \"\"\"Select the position with smallest Manhattan distance to reference.\"\"\"\n      if positions.shape[0] == 0:\n          return None\n      ref = np.array(reference)\n      dists = np.sum(np.abs(positions - ref), axis=1)\n      return tuple(positions[np.argmin(dists)])\n\n  # ------------------------------------------------------------------\n  # Gather current state information\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n\n  # ------------------------------------------------------------------\n  # Identify goal (stick)\n  # ------------------------------------------------------------------\n  goal_name = \"stick\"\n  try:\n      goal_idx = env.world.cookbook.index[goal_name]\n  except Exception:\n      return []\n\n  # If we already have a stick, nothing to do\n  if inventory[goal_idx] > 0:\n      return []\n\n  plan_actions = []\n\n  # ------------------------------------------------------------------\n  # Collect required primitive resources\n  # ------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  for prim_idx, needed_cnt in primitives_needed.items():\n      while inventory[prim_idx] < needed_cnt:\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.shape[0] == 0:\n              # No more of this primitive on the map\n              return plan_actions\n          target = nearest_position(prim_cells, pos)\n\n          # Move to the primitive\n          plan_actions.extend(manhattan_path(pos, target))\n          pos = target\n\n          # Pick it up\n          plan_actions.append(ACTION_USE)\n\n          # Simulate the pickup locally\n          inventory[prim_idx] += 1\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # ------------------------------------------------------------------\n  # If stick has no recipe, just pick it up from the world\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  if not recipe:\n      stick_cells = np.argwhere(grid[:, :, goal_idx] > 0)\n      if stick_cells.shape[0] == 0:\n          return plan_actions\n      target = nearest_position(stick_cells, pos)\n      plan_actions.extend(manhattan_path(pos, target))\n      plan_actions.append(ACTION_USE)\n      return plan_actions\n\n  # ------------------------------------------------------------------\n  # Craft stick at required workshop, if any\n  # ------------------------------------------------------------------\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      try:\n          workshop_idx = env.world.cookbook.index[workshop_name]\n      except Exception:\n          return plan_actions\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.shape[0] == 0:\n          return plan_actions\n      wcell = tuple(workshop_cells[0])\n\n      # Find a free adjacent cell to stand on\n      neighbours = [(wcell[0] + dx, wcell[1] + dy) for dx, dy in\n                    [(1, 0), (-1, 0), (0, 1), (0, -1)]]\n      stand_pos = None\n      for nx, ny in neighbours:\n          if (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and\n                  grid[nx, ny, :].sum() == 0):\n              stand_pos = (nx, ny)\n              break\n      if stand_pos is None:\n          stand_pos = wcell  # fallback to standing on the workshop itself\n\n      plan_actions.extend(manhattan_path(pos, stand_pos))\n      plan_actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # Return the constructed action list\n  # ------------------------------------------------------------------\n  return plan_actions", "env_interactions": 5, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:05:28.289011", "function_name": "make_arrow", "function_body": "  # Action indices as defined in CraftLab.action_specs\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  import numpy as np\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions from start to goal using\n      horizontal\u2011then\u2011vertical moves (ignores obstacles).\"\"\"\n      x, y = start\n      gx, gy = goal\n      actions = []\n      while x < gx:\n          actions.append(ACTION_RIGHT)\n          x += 1\n      while x > gx:\n          actions.append(ACTION_LEFT)\n          x -= 1\n      while y < gy:\n          actions.append(ACTION_DOWN)\n          y += 1\n      while y > gy:\n          actions.append(ACTION_UP)\n          y -= 1\n      return actions\n\n  def nearest_position(positions, reference):\n      \"\"\"Pick the position from *positions* with smallest Manhattan distance\n      to *reference*.\"\"\"\n      if positions.shape[0] == 0:\n          return None\n      ref = np.array(reference)\n      dists = np.sum(np.abs(positions - ref), axis=1)\n      return tuple(positions[np.argmin(dists)])\n\n  # ------------------------------------------------------------------\n  # Gather current state information\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n\n  # ------------------------------------------------------------------\n  # Identify goal (stick)\n  # ------------------------------------------------------------------\n  goal_name = \"stick\"\n  try:\n      goal_idx = env.world.cookbook.index[goal_name]\n  except Exception:\n      # Goal not present in the world \u2013 nothing to do\n      return []\n\n  # If we already have a stick, no actions are needed\n  if inventory[goal_idx] > 0:\n      return []\n\n  plan_actions = []\n\n  # ------------------------------------------------------------------\n  # 1) Collect required primitive resources (if any)\n  # ------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  for prim_idx, needed_cnt in primitives_needed.items():\n      while inventory[prim_idx] < needed_cnt:\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.shape[0] == 0:\n              # Primitive not available \u2013 abort planning\n              return plan_actions\n          target = nearest_position(prim_cells, pos)\n\n          # Move to the primitive\n          plan_actions.extend(manhattan_path(pos, target))\n          pos = target\n\n          # Pick it up\n          plan_actions.append(ACTION_USE)\n\n          # Simulate the pickup locally for further planning\n          inventory[prim_idx] += 1\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # ------------------------------------------------------------------\n  # 2) If stick itself is a primitive (no recipe), just pick it up\n  # ------------------------------------------------------------------\n  if goal_idx not in env.world.cookbook.recipes:\n      stick_cells = np.argwhere(grid[:, :, goal_idx] > 0)\n      if stick_cells.shape[0] == 0:\n          return plan_actions\n      target = nearest_position(stick_cells, pos)\n      plan_actions.extend(manhattan_path(pos, target))\n      plan_actions.append(ACTION_USE)\n      return plan_actions\n\n  # ------------------------------------------------------------------\n  # 3) Go to the required workshop and craft the stick\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      try:\n          workshop_idx = env.world.cookbook.index[workshop_name]\n      except Exception:\n          return plan_actions\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.shape[0] == 0:\n          return plan_actions\n      wcell = tuple(workshop_cells[0])\n\n      # Find a free adjacent cell to stand on\n      neighbours = [(wcell[0] + dx, wcell[1] + dy) for dx, dy in\n                    [(1, 0), (-1, 0), (0, 1), (0, -1)]]\n      stand_pos = None\n      for nx, ny in neighbours:\n          if (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and\n                  grid[nx, ny, :].sum() == 0):\n              stand_pos = (nx, ny)\n              break\n      if stand_pos is None:\n          stand_pos = wcell  # fallback: stand directly on the workshop\n\n      # Move to the chosen standing position\n      plan_actions.extend(manhattan_path(pos, stand_pos))\n      # Craft the stick\n      plan_actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # Return the constructed action list\n  # ------------------------------------------------------------------\n  return plan_actions", "env_interactions": 5, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:06:00.066792", "function_name": "make_arrow", "function_body": "  # Define movement direction deltas for actions: DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n  _ACTION_DELTAS = {\n      0: (1, 0),   # DOWN\n      1: (-1, 0),  # UP\n      2: (0, -1),  # LEFT\n      3: (0, 1),   # RIGHT\n  }\n\n  def _move_actions(start, goal):\n      \"\"\"Return a list of actions (DOWN/UP/LEFT/RIGHT) to move from start to goal.\"\"\"\n      y, x = start\n      gy, gx = goal\n      actions = []\n      while y < gy:\n          actions.append(0)  # DOWN\n          y += 1\n      while y > gy:\n          actions.append(1)  # UP\n          y -= 1\n      while x < gx:\n          actions.append(3)  # RIGHT\n          x += 1\n      while x > gx:\n          actions.append(2)  # LEFT\n          x -= 1\n      return actions\n\n  # ----------------------------------------------------------------------\n  # Locate the CraftWorld instance inside the supplied env\n  # ----------------------------------------------------------------------\n  if hasattr(env, \"world\"):\n      world = env.world\n  elif hasattr(env, \"scenario\"):\n      world = env.scenario.world\n  else:\n      raise AttributeError(\"Unable to locate CraftWorld instance in the provided env.\")\n\n  # ----------------------------------------------------------------------\n  # Identify the goal (stick) and its recipe\n  # ----------------------------------------------------------------------\n  goal_name = \"stick\"\n  goal_idx = world.cookbook.index.index(goal_name)\n\n  # Primitives required to craft a stick (may be empty if stick is primitive)\n  needed = world.cookbook.primitives_for(goal_idx)\n\n  # ----------------------------------------------------------------------\n  # Obtain current state (position and grid) for planning\n  # ----------------------------------------------------------------------\n  if hasattr(env, \"_current_state\"):\n      state = env._current_state\n  else:\n      # Fallback to a fresh initial state from the scenario\n      state = env.scenario.init()\n\n  cur_pos = tuple(state.pos)          # (row, col)\n  grid = state.grid.copy()            # (H, W, n_kinds)\n\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive the necessary number of times\n  # ----------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(\n                  f\"Primitive '{world.cookbook.index.get(prim_idx)}' not found on the grid.\"\n              )\n          py, px = prim_cells[0]\n\n          # Find an empty neighbour cell from which we can face the primitive\n          target_cell = None\n          for d, (dy, dx) in _ACTION_DELTAS.items():\n              ny, nx = py - dy, px - dx\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  if not grid[ny, nx, :].any():          # empty cell\n                      target_cell = (ny, nx)\n                      break\n          if target_cell is None:\n              raise RuntimeError(\"No reachable empty neighbour around required primitive.\")\n\n          # Move to that neighbour\n          actions.extend(_move_actions(cur_pos, target_cell))\n          cur_pos = target_cell\n\n          # Use the primitive (agent now faces it)\n          actions.append(4)   # USE\n\n          # Update planning grid: primitive consumed\n          grid[py, px, prim_idx] = 0\n\n  # ----------------------------------------------------------------------\n  # Move to the appropriate workshop (if the recipe specifies one) and craft\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_cells.size == 0:\n          raise RuntimeError(f\"Workshop '{workshop_name}' not found on the grid.\")\n      wy, wx = ws_cells[0]\n\n      # Find an empty neighbour to face the workshop\n      target_cell = None\n      for d, (dy, dx) in _ACTION_DELTAS.items():\n          ny, nx = wy - dy, wx - dx\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not grid[ny, nx, :].any():\n                  target_cell = (ny, nx)\n                  break\n      if target_cell is None:\n          raise RuntimeError(\"No reachable empty neighbour around workshop.\")\n\n      actions.extend(_move_actions(cur_pos, target_cell))\n      cur_pos = target_cell\n\n      # Craft the stick\n      actions.append(4)   # USE\n\n  # Return the complete list of actions needed to make a stick\n  return actions", "env_interactions": 5, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:06:01.366178", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  _ACTION_DELTAS = {\n      0: (1, 0),   # DOWN\n      1: (-1, 0),  # UP\n      2: (0, -1),  # LEFT\n      3: (0, 1),   # RIGHT\n  }\n\n  def _move_actions(start, goal):\n      \"\"\"Return a list of actions (Manhattan moves) from start to goal.\"\"\"\n      y, x = start\n      gy, gx = goal\n      actions = []\n      while y < gy:\n          actions.append(0)  # DOWN\n          y += 1\n      while y > gy:\n          actions.append(1)  # UP\n          y -= 1\n      while x < gx:\n          actions.append(3)  # RIGHT\n          x += 1\n      while x > gx:\n          actions.append(2)  # LEFT\n          x -= 1\n      return actions\n\n  # ----------------------------------------------------------------------\n  # locate the CraftWorld instance inside the supplied environment\n  # ----------------------------------------------------------------------\n  if hasattr(env, \"world\"):\n      world = env.world\n  elif hasattr(env, \"scenario\"):\n      world = env.scenario.world\n  else:\n      raise AttributeError(\"Unable to locate CraftWorld instance in the provided env.\")\n\n  # ----------------------------------------------------------------------\n  # identify the goal (stick) and its recipe\n  # ----------------------------------------------------------------------\n  goal_name = \"stick\"\n  goal_idx = world.cookbook.index.index(goal_name)\n\n  # primitives needed to craft a stick (may be empty if stick is primitive)\n  needed = world.cookbook.primitives_for(goal_idx)\n\n  # ----------------------------------------------------------------------\n  # obtain the current state for planning (position + grid)\n  # ----------------------------------------------------------------------\n  if hasattr(env, \"_current_state\"):\n      state = env._current_state\n  else:\n      state = env.scenario.init()\n\n  cur_pos = tuple(state.pos)          # (row, col)\n  grid = state.grid.copy()            # (H, W, n_kinds)\n\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # collect each required primitive the necessary number of times\n  # ----------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(\n                  f\"Primitive '{world.cookbook.index.get(prim_idx)}' not found on the grid.\"\n              )\n          py, px = prim_cells[0]\n\n          # find an empty neighbour cell from which we can face the primitive\n          target_cell = None\n          for d, (dy, dx) in _ACTION_DELTAS.items():\n              ny, nx = py - dy, px - dx\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  if not grid[ny, nx, :].any():          # empty cell\n                      target_cell = (ny, nx)\n                      break\n          if target_cell is None:\n              raise RuntimeError(\"No reachable empty neighbour around required primitive.\")\n\n          # move to that neighbour\n          actions.extend(_move_actions(cur_pos, target_cell))\n          cur_pos = target_cell\n\n          # use the primitive (agent now faces the primitive)\n          actions.append(4)   # USE\n\n          # update planning grid: remove the primitive we just collected\n          grid[py, px, prim_idx] = 0\n\n  # ----------------------------------------------------------------------\n  # move to the appropriate workshop (if the recipe specifies one) and craft\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_cells.size == 0:\n          raise RuntimeError(f\"Workshop '{workshop_name}' not found on the grid.\")\n      wy, wx = ws_cells[0]\n\n      # find an empty neighbour to face the workshop\n      target_cell = None\n      for d, (dy, dx) in _ACTION_DELTAS.items():\n          ny, nx = wy - dy, wx - dx\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not grid[ny, nx, :].any():\n                  target_cell = (ny, nx)\n                  break\n      if target_cell is None:\n          raise RuntimeError(\"No reachable empty neighbour around workshop.\")\n\n      actions.extend(_move_actions(cur_pos, target_cell))\n      cur_pos = target_cell\n\n      # craft the stick\n      actions.append(4)   # USE\n\n  # return the complete list of actions needed to make a stick\n  return actions", "env_interactions": 5, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:06:20.875528", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  goal_idx = env.task.goal\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # -----------------------------------------------------------------\n  # Helper utilities\n  # -----------------------------------------------------------------\n  def find_positions(kind):\n      \"\"\"Return list of (x, y) where the grid contains at least one of `kind`.\"\"\"\n      locs = np.argwhere(state.grid[:, :, kind] > 0)\n      return [tuple(p) for p in locs]\n\n  def nearest(pos, kind):\n      \"\"\"Manhattan\u2011closest position of the given kind, or None if absent.\"\"\"\n      positions = find_positions(kind)\n      if not positions:\n          return None\n      return min(positions, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n\n  def moves_to(src, dst):\n      \"\"\"Sequence of movement actions (DOWN=0, UP=1, LEFT=2, RIGHT=3) from src to dst.\"\"\"\n      sx, sy = src\n      dx, dy = dst\n      seq = []\n      while sx < dx:\n          seq.append(0)   # DOWN\n          sx += 1\n      while sx > dx:\n          seq.append(1)   # UP\n          sx -= 1\n      while sy < dy:\n          seq.append(3)   # RIGHT\n          sy += 1\n      while sy > dy:\n          seq.append(2)   # LEFT\n          sy -= 1\n      return seq\n\n  # -----------------------------------------------------------------\n  # 1) If the goal is a primitive (no recipe), just go to it and pick it up.\n  # -----------------------------------------------------------------\n  if not env.world.cookbook.primitives_for(goal_idx):\n      target = nearest(cur_pos, goal_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)   # USE\n      return actions\n\n  # -----------------------------------------------------------------\n  # 2) Gather required primitive ingredients.\n  # -----------------------------------------------------------------\n  needed_prims = env.world.cookbook.primitives_for(goal_idx)\n  for prim_idx, count in needed_prims.items():\n      for _ in range(count):\n          target = nearest(cur_pos, prim_idx)\n          if target is None:\n              continue\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n          actions.append(4)   # USE to collect primitive\n\n  # -----------------------------------------------------------------\n  # 3) Move to the appropriate workshop (if any) and craft the item.\n  # -----------------------------------------------------------------\n  workshop_idx = None\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  for key, val in recipe.items():\n      if isinstance(key, str):\n          workshop_idx = val\n          break\n\n  if workshop_idx is not None:\n      target = nearest(cur_pos, workshop_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)   # USE to craft\n\n  return actions", "env_interactions": 1, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:06:22.177658", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  goal_idx = env.task.goal\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # -----------------------------------------------------------------\n  # Helper utilities\n  # -----------------------------------------------------------------\n  def find_positions(kind):\n      \"\"\"Return list of (x, y) where the grid contains at least one of `kind`.\"\"\"\n      locs = np.argwhere(state.grid[:, :, kind] > 0)\n      return [tuple(p) for p in locs]\n\n  def nearest(pos, kind):\n      \"\"\"Manhattan\u2011closest position of the given kind, or None if absent.\"\"\"\n      positions = find_positions(kind)\n      if not positions:\n          return None\n      return min(positions, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n\n  def moves_to(src, dst):\n      \"\"\"Sequence of movement actions (DOWN=0, UP=1, LEFT=2, RIGHT=3) from src to dst.\"\"\"\n      sx, sy = src\n      dx, dy = dst\n      seq = []\n      while sx < dx:\n          seq.append(0)   # DOWN\n          sx += 1\n      while sx > dx:\n          seq.append(1)   # UP\n          sx -= 1\n      while sy < dy:\n          seq.append(3)   # RIGHT\n          sy += 1\n      while sy > dy:\n          seq.append(2)   # LEFT\n          sy -= 1\n      return seq\n\n  # -----------------------------------------------------------------\n  # 1) If the goal is a primitive (no recipe), just go to it and pick it up.\n  # -----------------------------------------------------------------\n  if not env.world.cookbook.primitives_for(goal_idx):\n      target = nearest(cur_pos, goal_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)   # USE\n      return actions\n\n  # -----------------------------------------------------------------\n  # 2) Gather required primitive ingredients.\n  # -----------------------------------------------------------------\n  needed_prims = env.world.cookbook.primitives_for(goal_idx)\n  for prim_idx, count in needed_prims.items():\n      for _ in range(count):\n          target = nearest(cur_pos, prim_idx)\n          if target is None:\n              continue\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n          actions.append(4)   # USE to collect primitive\n\n  # -----------------------------------------------------------------\n  # 3) Move to the appropriate workshop (if any) and craft the stick.\n  # -----------------------------------------------------------------\n  workshop_idx = None\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  for key, val in recipe.items():\n      if isinstance(key, str):\n          workshop_idx = val\n          break\n\n  if workshop_idx is not None:\n      target = nearest(cur_pos, workshop_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)   # USE to craft\n\n  return actions", "env_interactions": 1, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:06:39.912607", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n\n  # action indices\n  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act[\"DOWN\"], act[\"UP\"], act[\"LEFT\"], act[\"RIGHT\"], act[\"USE\"]\n  )\n\n  # index of the stick item\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # helper to compute Manhattan move actions from cur to target\n  def moves(cur, tgt):\n      cur = np.array(cur)\n      tgt = np.array(tgt)\n      dx, dy = tgt - cur\n      seq = []\n      if dx > 0:\n          seq += [DOWN] * int(dx)\n      elif dx < 0:\n          seq += [UP] * int(-dx)\n      if dy > 0:\n          seq += [RIGHT] * int(dy)\n      elif dy < 0:\n          seq += [LEFT] * int(-dy)\n      return seq\n\n  # ------------------------------------------------------------------\n  # 1) Determine if stick is a primitive (no recipe) or needs crafting\n  # ------------------------------------------------------------------\n  primitive_requirements = world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n  if not primitive_requirements:\n      # Stick is a primitive \u2013 just go pick it up\n      stick_cells = np.argwhere(state.grid[:, :, stick_idx] > 0)\n      if stick_cells.size == 0:\n          return []  # nothing to collect\n      cur_pos = state.pos\n      # pick nearest stick\n      dists = np.abs(stick_cells - np.array(cur_pos)).sum(axis=1)\n      target = stick_cells[dists.argmin()]\n      actions = moves(cur_pos, target) + [USE]\n      return actions\n\n  # ------------------------------------------------------------------\n  # 2) Stick must be crafted \u2013 collect required primitives first\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = state.pos\n\n  for prim_idx, needed_cnt in primitive_requirements.items():\n      # safeguard: ignore any non\u2011int keys (shouldn't appear)\n      if not isinstance(prim_idx, (int, np.integer)):\n          continue\n      for _ in range(needed_cnt):\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              return []  # cannot satisfy requirement\n          dists = np.abs(prim_cells - np.array(cur_pos)).sum(axis=1)\n          target = prim_cells[dists.argmin()]\n          actions += moves(cur_pos, target) + [USE]\n          cur_pos = tuple(target.tolist())\n          # simulate pickup so we don't reuse the same cell\n          state.grid[target[0], target[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 3) Go to the workshop for stick and craft it\n  # ------------------------------------------------------------------\n  recipe_dict = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe_dict.get(\"_at\")\n  if workshop_name is None:\n      return actions  # no workshop information; cannot craft\n\n  workshop_idx = world.cookbook.index[workshop_name]\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      return actions  # workshop not present\n\n  dists = np.abs(workshop_cells - np.array(cur_pos)).sum(axis=1)\n  target_ws = workshop_cells[dists.argmin()]\n  actions += moves(cur_pos, target_ws) + [USE]  # USE at workshop to craft\n\n  return actions", "env_interactions": 4, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:06:41.239550", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n\n  # action indices\n  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act[\"DOWN\"], act[\"UP\"], act[\"LEFT\"], act[\"RIGHT\"], act[\"USE\"]\n  )\n\n  # index of the stick item\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # helper to convert a Manhattan displacement into a sequence of moves\n  def moves(cur, tgt):\n      cur = np.array(cur)\n      tgt = np.array(tgt)\n      dx, dy = tgt - cur\n      seq = []\n      if dx > 0:\n          seq += [DOWN] * int(dx)\n      elif dx < 0:\n          seq += [UP] * int(-dx)\n      if dy > 0:\n          seq += [RIGHT] * int(dy)\n      elif dy < 0:\n          seq += [LEFT] * int(-dy)\n      return seq\n\n  # ------------------------------------------------------------------\n  # 1) Determine whether stick is a primitive or needs to be crafted\n  # ------------------------------------------------------------------\n  primitive_requirements = world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n  actions = []\n  cur_pos = state.pos\n\n  if not primitive_requirements:\n      # Stick is a primitive \u2013 just go pick it up\n      stick_cells = np.argwhere(state.grid[:, :, stick_idx] > 0)\n      if stick_cells.size == 0:\n          return []  # nothing to collect\n      # choose nearest stick\n      dists = np.abs(stick_cells - np.array(cur_pos)).sum(axis=1)\n      target = stick_cells[dists.argmin()]\n      actions = moves(cur_pos, target) + [USE]\n      return actions\n\n  # ------------------------------------------------------------------\n  # 2) Stick must be crafted \u2013 collect each required primitive\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_requirements.items():\n      # skip possible special keys (should not appear here)\n      if isinstance(prim_idx, str):\n          continue\n      for _ in range(needed_cnt):\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              return []  # cannot satisfy requirement\n          dists = np.abs(prim_cells - np.array(cur_pos)).sum(axis=1)\n          target = prim_cells[dists.argmin()]\n          actions += moves(cur_pos, target) + [USE]\n          cur_pos = tuple(target.tolist())\n          # simulate pickup so we don't reuse the same cell\n          state.grid[target[0], target[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 3) Go to the workshop where sticks are crafted and craft them\n  # ------------------------------------------------------------------\n  recipe_dict = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe_dict.get(\"_at\")\n  if workshop_name is None:\n      return actions  # no workshop info \u2013 cannot craft\n\n  workshop_idx = world.cookbook.index[workshop_name]\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      return actions  # no workshop present\n\n  dists = np.abs(workshop_cells - np.array(cur_pos)).sum(axis=1)\n  target_ws = workshop_cells[dists.argmin()]\n  actions += moves(cur_pos, target_ws) + [USE]  # USE at workshop to craft stick\n\n  return actions", "env_interactions": 4, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:07:02.179436", "function_name": "make_arrow", "function_body": "  def _move_to(cur_pos, target, seq):\n      x, y = cur_pos\n      tx, ty = target\n      while x < tx:\n          seq.append(3)  # RIGHT\n          x += 1\n      while x > tx:\n          seq.append(2)  # LEFT\n          x -= 1\n      while y < ty:\n          seq.append(0)  # DOWN\n          y += 1\n      while y > ty:\n          seq.append(1)  # UP\n          y -= 1\n      return (x, y)\n\n  state = env._current_state\n  grid = state.grid.copy()\n  cur_pos = state.pos\n  goal_idx = env.task.goal\n\n  # Retrieve recipe for the goal (empty if primitive)\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n  ingredients = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  actions = []\n\n  # Primitive goal: just pick it up\n  if not ingredients:\n      locs = np.argwhere(grid[:, :, goal_idx] > 0)\n      if locs.size > 0:\n          dists = np.abs(locs[:, 0] - cur_pos[0]) + np.abs(locs[:, 1] - cur_pos[1])\n          best = int(np.argmin(dists))\n          target = tuple(locs[best].tolist())\n          cur_pos = _move_to(cur_pos, target, actions)\n          actions.append(4)  # USE\n      return actions\n\n  # Gather required ingredients\n  for ing_kind, count in ingredients.items():\n      for _ in range(count):\n          locs = np.argwhere(grid[:, :, ing_kind] > 0)\n          if locs.size == 0:\n              # Ingredient missing; abort early\n              return actions\n          dists = np.abs(locs[:, 0] - cur_pos[0]) + np.abs(locs[:, 1] - cur_pos[1])\n          best = int(np.argmin(dists))\n          target = tuple(locs[best].tolist())\n          cur_pos = _move_to(cur_pos, target, actions)\n          actions.append(4)  # USE to pick up\n          grid[target[0], target[1], ing_kind] = 0\n\n  # Move to workshop (if any) and craft\n  if workshop_kind is not None:\n      ws_locs = np.argwhere(grid[:, :, workshop_kind] > 0)\n      if ws_locs.size > 0:\n          dists = np.abs(ws_locs[:, 0] - cur_pos[0]) + np.abs(ws_locs[:, 1] - cur_pos[1])\n          best = int(np.argmin(dists))\n          workshop = tuple(ws_locs[best].tolist())\n          cur_pos = _move_to(cur_pos, workshop, actions)\n          actions.append(4)  # USE to craft\n\n  return actions", "env_interactions": 0, "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:07:03.510280", "function_name": "make_arrow", "function_body": "  def _move_to(cur_pos, target, seq):\n      x, y = cur_pos\n      tx, ty = target\n      while x < tx:\n          seq.append(3)  # RIGHT\n          x += 1\n      while x > tx:\n          seq.append(2)  # LEFT\n          x -= 1\n      while y < ty:\n          seq.append(0)  # DOWN\n          y += 1\n      while y > ty:\n          seq.append(1)  # UP\n          y -= 1\n      return (x, y)\n\n  # Get current state information\n  state = env._current_state\n  grid = state.grid.copy()\n  cur_pos = state.pos\n  goal_idx = env.task.goal\n\n  # Retrieve the recipe for the goal (stick)\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n  ingredients = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  actions = []\n\n  # If there is no recipe (primitive), simply pick up the goal item.\n  if not ingredients:\n      locs = np.argwhere(grid[:, :, goal_idx] > 0)\n      if locs.size > 0:\n          dists = np.abs(locs[:, 0] - cur_pos[0]) + np.abs(locs[:, 1] - cur_pos[1])\n          chosen = int(np.argmin(dists))\n          target = tuple(locs[chosen].tolist())\n          cur_pos = _move_to(cur_pos, target, actions)\n          actions.append(4)  # USE to pick up\n      return actions\n\n  # Gather required ingredients (may need multiple copies of the same kind)\n  for ing_kind, count in ingredients.items():\n      for _ in range(count):\n          locs = np.argwhere(grid[:, :, ing_kind] > 0)\n          if locs.size == 0:\n              # Ingredient not found \u2013 abort early.\n              return actions\n          dists = np.abs(locs[:, 0] - cur_pos[0]) + np.abs(locs[:, 1] - cur_pos[1])\n          chosen = int(np.argmin(dists))\n          target = tuple(locs[chosen].tolist())\n          cur_pos = _move_to(cur_pos, target, actions)\n          actions.append(4)  # USE to pick up\n          # Remove the picked item from our local copy so we don't reuse it\n          grid[target[0], target[1], ing_kind] = 0\n\n  # If crafting must happen at a specific workshop, move there and use.\n  if workshop_kind is not None:\n      ws_locs = np.argwhere(grid[:, :, workshop_kind] > 0)\n      if ws_locs.size > 0:\n          dists = np.abs(ws_locs[:, 0] - cur_pos[0]) + np.abs(ws_locs[:, 1] - cur_pos[1])\n          chosen = int(np.argmin(dists))\n          workshop = tuple(ws_locs[chosen].tolist())\n          cur_pos = _move_to(cur_pos, workshop, actions)\n          actions.append(4)  # USE to craft at the workshop\n\n  return actions", "env_interactions": 0, "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:07:29.412635", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n  stick_idx = cookbook.index['stick']\n\n  # Already have stick\n  if state.inventory[stick_idx] > 0:\n      return []\n\n  actions = []\n  cur_pos = state.pos\n\n  # Helper to append movement actions\n  def _move_to(target, pos):\n      x, y = pos\n      tx, ty = target\n      moves = []\n      while x < tx:\n          moves.append(3)   # RIGHT\n          x += 1\n      while x > tx:\n          moves.append(2)   # LEFT\n          x -= 1\n      while y < ty:\n          moves.append(0)   # DOWN\n          y += 1\n      while y > ty:\n          moves.append(1)   # UP\n          y -= 1\n      return moves, (x, y)\n\n  # Helper to find nearest cell containing a kind\n  def _nearest(kind_idx, pos):\n      cells = np.argwhere(state.grid[:, :, kind_idx] > 0)\n      if cells.size == 0:\n          return None\n      dists = np.abs(cells[:, 0] - pos[0]) + np.abs(cells[:, 1] - pos[1])\n      best = cells[dists.argmin()]\n      return tuple(best.tolist())\n\n  # 1) If stick is a primitive, just pick it up.\n  if stick_idx in cookbook.primitives:\n      target = _nearest(stick_idx, cur_pos)\n      if target is None:\n          return []   # no stick on map\n      moves, cur_pos = _move_to(target, cur_pos)\n      actions.extend(moves)\n      actions.append(4)   # USE to pick up\n      return actions\n\n  # 2) Stick must be crafted.\n  # Collect required primitives.\n  prims_needed = cookbook.primitives_for(stick_idx)   # dict {prim_idx: count}\n  inventory = state.inventory.copy()\n  for prim_idx, needed in prims_needed.items():\n      while inventory[prim_idx] < needed:\n          target = _nearest(prim_idx, cur_pos)\n          if target is None:\n              return []   # cannot find required primitive\n          moves, cur_pos = _move_to(target, cur_pos)\n          actions.extend(moves)\n          actions.append(4)   # pick up primitive\n          inventory[prim_idx] += 1\n\n  # Move to workshop (if recipe specifies one) and craft.\n  recipe = cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      ws_idx = workshop_name if isinstance(workshop_name, int) else cookbook.index[workshop_name]\n      target = _nearest(ws_idx, cur_pos)\n      if target is None:\n          # Workshop not present \u2013 attempt to craft in place.\n          actions.append(4)\n      else:\n          moves, cur_pos = _move_to(target, cur_pos)\n          actions.extend(moves)\n          actions.append(4)   # craft at workshop\n  else:\n      # No workshop required.\n      actions.append(4)\n\n  return actions", "env_interactions": 4, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:07:30.750039", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n  stick_idx = cookbook.index['stick']\n\n  # If we already have a stick in inventory, nothing to do.\n  if state.inventory[stick_idx] > 0:\n      return []\n\n  actions = []\n  cur_pos = state.pos\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def move_to(target, pos, act_list):\n      \"\"\"Append moves that bring the agent from pos to target.\"\"\"\n      x, y = pos\n      tx, ty = target\n      while x < tx:\n          act_list.append(3)   # RIGHT\n          x += 1\n      while x > tx:\n          act_list.append(2)   # LEFT\n          x -= 1\n      while y < ty:\n          act_list.append(0)   # DOWN\n          y += 1\n      while y > ty:\n          act_list.append(1)   # UP\n          y -= 1\n      return (x, y)\n\n  def nearest(kind_idx, pos):\n      \"\"\"Return coordinates of the nearest cell containing kind_idx.\"\"\"\n      positions = np.argwhere(state.grid[:, :, kind_idx] > 0)\n      if positions.size == 0:\n          return None\n      dists = np.abs(positions[:, 0] - pos[0]) + np.abs(positions[:, 1] - pos[1])\n      best = positions[dists.argmin()]\n      return (int(best[0]), int(best[1]))\n\n  def go_and_pick(kind_idx, pos, act_list):\n      \"\"\"Move to a cell with kind_idx and USE it.\"\"\"\n      target = nearest(kind_idx, pos)\n      if target is None:\n          return pos, False\n      pos = move_to(target, pos, act_list)\n      act_list.append(4)               # USE / pick up / interact\n      return pos, True\n\n  # ------------------------------------------------------------------\n  # 1) Stick is a primitive: just collect it.\n  # ------------------------------------------------------------------\n  if stick_idx in cookbook.primitives:\n      cur_pos, ok = go_and_pick(stick_idx, cur_pos, actions)\n      return actions if ok else []\n\n  # ------------------------------------------------------------------\n  # 2) Stick must be crafted: collect ingredients then craft at workshop.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(stick_idx, {})\n  workshop_key = recipe.get('_at')\n\n  # Gather all non\u2011workshop ingredients.\n  for ing_key, cnt in recipe.items():\n      if ing_key == '_at':\n          continue\n      ing_idx = ing_key if isinstance(ing_key, int) else cookbook.index[ing_key]\n      for _ in range(cnt):\n          cur_pos, ok = go_and_pick(ing_idx, cur_pos, actions)\n          if not ok:\n              return []   # cannot satisfy the recipe\n\n  # Move to the required workshop (if any) before crafting.\n  if workshop_key is not None:\n      ws_idx = workshop_key if isinstance(workshop_key, int) else cookbook.index[workshop_key]\n      cur_pos, ok = go_and_pick(ws_idx, cur_pos, actions)\n      if not ok:\n          return []   # workshop not found\n\n  # Finally craft the stick.\n  actions.append(4)   # USE to craft at the workshop (or in place if no workshop)\n  return actions", "env_interactions": 5, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:07:50.734879", "function_name": "make_arrow", "function_body": "  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act.get(\"DOWN\", 0),\n      act.get(\"UP\", 1),\n      act.get(\"LEFT\", 2),\n      act.get(\"RIGHT\", 3),\n      act.get(\"USE\", 4),\n  )\n\n  # snapshot of current state\n  state = env._current_state\n  grid = state.grid.copy()                     # (W, H, n_kinds)\n  cur_pos = tuple(state.pos)                   # (x, y)\n\n  # index of the target item \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n      if stick_idx is None:\n          return []   # stick not defined in the world\n\n  # recipe: primitive requirements and optional workshop\n  recipe = env.world.cookbook.primitives_for(stick_idx)   # dict {kind_idx: count}\n  primitive_needs = {}\n  workshop_idx = None\n  for k, v in recipe.items():\n      if isinstance(k, int):\n          primitive_needs[k] = v\n      else:\n          # non\u2011int key usually represents the workshop location\n          workshop_idx = v if isinstance(v, int) else None\n\n  # if there is no recipe, the stick itself is a primitive we must pick up\n  if not primitive_needs:\n      primitive_needs = {stick_idx: 1}\n      workshop_idx = None\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # helper: locate nearest cell that contains at least one of the given kind\n  def find_closest(kind_idx, cur):\n      positions = np.argwhere(grid[:, :, kind_idx] > 0)\n      if positions.shape[0] == 0:\n          return None\n      dists = np.sum(np.abs(positions - np.array(cur)), axis=1)\n      nearest = positions[np.argmin(dists)]\n      return tuple(nearest.tolist())\n\n  # helper: simple Manhattan path (returns actions list and final position)\n  def path_to(cur, target):\n      x, y = cur\n      tx, ty = target\n      path = []\n      while (x, y) != (tx, ty):\n          if x < tx:\n              path.append(RIGHT)\n              x += 1\n          elif x > tx:\n              path.append(LEFT)\n              x -= 1\n          elif y < ty:\n              path.append(DOWN)\n              y += 1\n          elif y > ty:\n              path.append(UP)\n              y -= 1\n      return path, (x, y)\n  # ------------------------------------------------------------------\n\n  # collect each required primitive (or the stick itself if primitive)\n  for kind_idx, needed in primitive_needs.items():\n      while needed > 0:\n          target = find_closest(kind_idx, cur_pos)\n          if target is None:\n              # required item not present \u2013 abort planning\n              return actions\n          move_actions, cur_pos = path_to(cur_pos, target)\n          actions.extend(move_actions)\n          actions.append(USE)   # pick up the item\n          # update local grid copy to reflect the item being taken\n          grid[target[0], target[1], kind_idx] = max(\n              0, grid[target[0], target[1], kind_idx] - 1\n          )\n          needed -= 1\n\n  # if crafting requires a workshop, move there and use it\n  if workshop_idx is not None:\n      ws_target = find_closest(workshop_idx, cur_pos)\n      if ws_target is not None:\n          move_actions, cur_pos = path_to(cur_pos, ws_target)\n          actions.extend(move_actions)\n          actions.append(USE)   # craft at the workshop\n\n  return actions", "env_interactions": 2, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:07:52.032934", "function_name": "make_arrow", "function_body": "  # Retrieve action indices\n  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act.get(\"DOWN\", 0),\n      act.get(\"UP\", 1),\n      act.get(\"LEFT\", 2),\n      act.get(\"RIGHT\", 3),\n      act.get(\"USE\", 4),\n  )\n\n  # Snapshot of current state\n  state = env._current_state\n  grid = state.grid.copy()                     # (W, H, n_kinds)\n  cur_pos = tuple(state.pos)                   # (x, y)\n\n  # Index of the target item \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n      if stick_idx is None:\n          return []   # stick not defined in the world\n\n  # Get recipe (primitives required and optional workshop)\n  recipe = env.world.cookbook.primitives_for(stick_idx)   # dict {kind_idx: count, \"_at\": workshop_idx}\n  primitive_needs = {k: v for k, v in recipe.items() if isinstance(k, int)}\n  workshop_idx = recipe.get(\"_at\", None)\n\n  # If there is no recipe, the stick itself is a primitive to pick up\n  if not primitive_needs:\n      primitive_needs = {stick_idx: 1}\n      workshop_idx = None\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper: locate nearest cell containing at least one of the given kind\n  def find_closest(kind_idx, cur):\n      positions = np.argwhere(grid[:, :, kind_idx] > 0)\n      if positions.shape[0] == 0:\n          return None\n      dists = np.sum(np.abs(positions - np.array(cur)), axis=1)\n      nearest = positions[np.argmin(dists)]\n      return tuple(nearest.tolist())\n\n  # Helper: simple Manhattan path (returns actions list and final position)\n  def path_to(cur, target):\n      x, y = cur\n      tx, ty = target\n      path = []\n      while (x, y) != (tx, ty):\n          if x < tx:\n              path.append(RIGHT)\n              x += 1\n          elif x > tx:\n              path.append(LEFT)\n              x -= 1\n          elif y < ty:\n              path.append(DOWN)\n              y += 1\n          elif y > ty:\n              path.append(UP)\n              y -= 1\n      return path, (x, y)\n  # ------------------------------------------------------------------\n\n  # Collect each required primitive\n  for kind_idx, needed in primitive_needs.items():\n      while needed > 0:\n          target = find_closest(kind_idx, cur_pos)\n          if target is None:\n              # Required primitive not present in the current grid \u2013 abort planning\n              return actions\n          move_actions, cur_pos = path_to(cur_pos, target)\n          actions.extend(move_actions)\n          actions.append(USE)   # pick up the primitive\n          # Update local grid copy to reflect that the item has been taken\n          grid[target[0], target[1], kind_idx] = max(\n              0, grid[target[0], target[1], kind_idx] - 1\n          )\n          needed -= 1\n\n  # If crafting requires a specific workshop, go there and use it\n  if workshop_idx is not None:\n      ws_target = find_closest(workshop_idx, cur_pos)\n      if ws_target is not None:\n          move_actions, cur_pos = path_to(cur_pos, ws_target)\n          actions.extend(move_actions)\n          actions.append(USE)   # craft at the workshop\n\n  return actions", "env_interactions": 2, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:08:12.640401", "function_name": "make_arrow", "function_body": "  # ------------------------------------------------------------------\n  # locate the CraftWorld instance inside the supplied environment\n  # ------------------------------------------------------------------\n  if hasattr(env, \"world\"):\n      world = env.world\n  elif hasattr(env, \"scenario\"):\n      world = env.scenario.world\n  else:\n      raise AttributeError(\"Cannot locate CraftWorld instance in the supplied env.\")\n\n  # ------------------------------------------------------------------\n  # identify the stick goal and its recipe\n  # ------------------------------------------------------------------\n  goal_name = \"stick\"\n  goal_idx = world.cookbook.index[goal_name]\n\n  # primitives required to craft the stick (empty dict if stick is primitive)\n  needed = world.cookbook.primitives_for(goal_idx)\n\n  # ------------------------------------------------------------------\n  # obtain current state for planning (position + grid)\n  # ------------------------------------------------------------------\n  if hasattr(env, \"_current_state\"):\n      state = env._current_state\n  else:\n      state = env.scenario.init()\n  cur_pos = tuple(state.pos)          # (row, col)\n  grid = state.grid.copy()            # (H, W, n_kinds)\n\n  # ------------------------------------------------------------------\n  # movement/action helpers\n  # ------------------------------------------------------------------\n  _ACTION_DELTAS = {\n      0: (1, 0),   # DOWN\n      1: (-1, 0),  # UP\n      2: (0, -1),  # LEFT\n      3: (0, 1),   # RIGHT\n  }\n\n  def _move_actions(start, goal):\n      \"\"\"Manhattan walk from start to goal, returning a list of movement actions.\"\"\"\n      sy, sx = start\n      gy, gx = goal\n      acts = []\n      while sy < gy:\n          acts.append(0)   # DOWN\n          sy += 1\n      while sy > gy:\n          acts.append(1)   # UP\n          sy -= 1\n      while sx < gx:\n          acts.append(3)   # RIGHT\n          sx += 1\n      while sx > gx:\n          acts.append(2)   # LEFT\n          sx -= 1\n      return acts\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Case 1: stick is itself a primitive (no recipe). Just collect it.\n  # ------------------------------------------------------------------\n  if not needed:\n      stick_cells = np.argwhere(grid[:, :, goal_idx] > 0)\n      if stick_cells.size == 0:\n          raise RuntimeError(\"Stick not found on the grid.\")\n      py, px = stick_cells[0]\n\n      # Find an empty neighbour to stand on and face the stick.\n      target = None\n      for dy, dx in _ACTION_DELTAS.values():\n          ny, nx = py - dy, px - dx\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not grid[ny, nx, :].any():\n                  target = (ny, nx)\n                  break\n      if target is None:\n          # fallback: stand directly on the stick cell\n          target = (py, px)\n\n      actions.extend(_move_actions(cur_pos, target))\n      cur_pos = target\n      actions.append(4)   # USE to pick up the stick\n      return actions\n\n  # ------------------------------------------------------------------\n  # Case 2: stick requires primitives (and possibly a workshop)\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(\n                  f\"Required primitive {world.cookbook.index.get(prim_idx)} not found on the grid.\"\n              )\n          py, px = prim_cells[0]\n\n          # Find an empty neighbour to interact with the primitive.\n          target = None\n          for dy, dx in _ACTION_DELTAS.values():\n              ny, nx = py - dy, px - dx\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  if not grid[ny, nx, :].any():\n                      target = (ny, nx)\n                      break\n          if target is None:\n              raise RuntimeError(\"No reachable empty neighbour around required primitive.\")\n\n          # Move there and pick up.\n          actions.extend(_move_actions(cur_pos, target))\n          cur_pos = target\n          actions.append(4)   # USE\n          # Update planning grid.\n          grid[py, px, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Craft the stick at its workshop, if one is specified.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = world.cookbook.index[workshop_name]\n      ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_cells.size == 0:\n          raise RuntimeError(f\"Workshop {workshop_name} not found on the grid.\")\n      wy, wx = ws_cells[0]\n\n      # Find an empty neighbour to face the workshop.\n      target = None\n      for dy, dx in _ACTION_DELTAS.values():\n          ny, nx = wy - dy, wx - dx\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not grid[ny, nx, :].any():\n                  target = (ny, nx)\n                  break\n      if target is None:\n          raise RuntimeError(\"No reachable empty neighbour around the workshop.\")\n\n      actions.extend(_move_actions(cur_pos, target))\n      cur_pos = target\n      actions.append(4)   # USE to craft the stick\n\n  return actions", "env_interactions": 5, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:08:14.031155", "function_name": "make_arrow", "function_body": "  # locate the CraftWorld instance inside the supplied environment\n  if hasattr(env, \"world\"):\n      world = env.world\n  elif hasattr(env, \"scenario\"):\n      world = env.scenario.world\n  else:\n      raise AttributeError(\"Cannot locate CraftWorld instance in the supplied env.\")\n\n  # goal information for \"stick\"\n  goal_name = \"stick\"\n  goal_idx = world.cookbook.index[goal_name]\n\n  # primitives needed to craft a stick (empty dict if stick is primitive)\n  needed = world.cookbook.primitives_for(goal_idx)\n\n  # obtain current state (position + grid) for planning\n  if hasattr(env, \"_current_state\"):\n      state = env._current_state\n  else:\n      state = env.scenario.init()\n  cur_pos = tuple(state.pos)          # (row, col)\n  grid = state.grid.copy()            # (H, W, n_kinds)\n\n  # action -> (dy, dx) movement deltas (consistent with CraftWorld)\n  _ACTION_DELTAS = {\n      0: (1, 0),   # DOWN\n      1: (-1, 0),  # UP\n      2: (0, -1),  # LEFT\n      3: (0, 1),   # RIGHT\n  }\n\n  def _move_actions(start, goal):\n      \"\"\"Manhattan walk from start to goal, returning a list of movement actions.\"\"\"\n      sy, sx = start\n      gy, gx = goal\n      acts = []\n      while sy < gy:\n          acts.append(0)   # DOWN\n          sy += 1\n      while sy > gy:\n          acts.append(1)   # UP\n          sy -= 1\n      while sx < gx:\n          acts.append(3)   # RIGHT\n          sx += 1\n      while sx > gx:\n          acts.append(2)   # LEFT\n          sx -= 1\n      return acts\n\n  def _find_empty_neighbour(y, x):\n      \"\"\"Return a free neighbour cell (ny,nx) from which we can face (y,x).\"\"\"\n      for dy, dx in _ACTION_DELTAS.values():\n          ny, nx = y - dy, x - dx\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not grid[ny, nx, :].any():\n                  return (ny, nx)\n      return None\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Case 1: stick is a primitive (no recipe). Just collect it.\n  # ------------------------------------------------------------------\n  if not needed:\n      stick_cells = np.argwhere(grid[:, :, goal_idx] > 0)\n      if stick_cells.size == 0:\n          raise RuntimeError(\"Stick not found on the grid.\")\n      py, px = stick_cells[0]\n      target = _find_empty_neighbour(py, px) or (py, px)\n      actions.extend(_move_actions(cur_pos, target))\n      actions.append(4)   # USE to pick up the stick\n      return actions\n\n  # ------------------------------------------------------------------\n  # Case 2: need to collect primitives first.\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(\n                  f\"Required primitive {world.cookbook.index.get(prim_idx)} not found on the grid.\"\n              )\n          py, px = prim_cells[0]\n          target = _find_empty_neighbour(py, px)\n          if target is None:\n              raise RuntimeError(\"No reachable empty neighbour around required primitive.\")\n          actions.extend(_move_actions(cur_pos, target))\n          cur_pos = target\n          actions.append(4)   # USE to collect the primitive\n          grid[py, px, prim_idx] = 0   # update planning grid\n\n  # ------------------------------------------------------------------\n  # Craft the stick at its workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = world.cookbook.index[workshop_name]\n      ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_cells.size == 0:\n          raise RuntimeError(f\"Workshop {workshop_name} not found on the grid.\")\n      wy, wx = ws_cells[0]\n      target = _find_empty_neighbour(wy, wx)\n      if target is None:\n          raise RuntimeError(\"No reachable empty neighbour around the workshop.\")\n      actions.extend(_move_actions(cur_pos, target))\n      actions.append(4)   # USE to craft the stick\n\n  return actions", "env_interactions": 5, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:08:41.376884", "function_name": "make_arrow", "function_body": "  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act.get(\"DOWN\", 0),\n      act.get(\"UP\", 1),\n      act.get(\"LEFT\", 2),\n      act.get(\"RIGHT\", 3),\n      act.get(\"USE\", 4),\n  )\n  # Snapshot the current state without modifying the environment\n  state = env._current_state\n  grid = state.grid.copy()                 # (W, H, n_kinds)\n  cur_pos = tuple(state.pos)               # (x, y)\n\n  # Locate the index of the goal item \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n      if stick_idx is None:\n          return []   # stick not defined in this world\n\n  # Retrieve the recipe for a stick (primitives needed)\n  recipe = env.world.cookbook.primitives_for(stick_idx)\n\n  # Primitives required (non\u2011int keys are workshop specifications)\n  primitive_needs = {k: v for k, v in recipe.items() if isinstance(k, int)}\n  # If the stick itself is a primitive (no recipe), just pick one up\n  if not primitive_needs:\n      primitive_needs = {stick_idx: 1}\n\n  # Identify workshop index if the recipe demands one\n  workshop_idx = None\n  for k, v in recipe.items():\n      if not isinstance(k, int):\n          # v may be an int index or a string name\n          if isinstance(v, int):\n              workshop_idx = v\n          else:\n              workshop_idx = env.world.cookbook.index.get(v)\n          break\n\n  actions = []\n\n  # Helper: find the closest cell that still contains the given kind\n  def find_closest(kind_idx, cur):\n      positions = np.argwhere(grid[:, :, kind_idx] > 0)\n      if positions.shape[0] == 0:\n          return None\n      dists = np.sum(np.abs(positions - np.array(cur)), axis=1)\n      nearest = positions[np.argmin(dists)]\n      return tuple(nearest.tolist())\n\n  # Helper: greedy Manhattan path from cur to target\n  def path_to(cur, target):\n      x, y = cur\n      tx, ty = target\n      path = []\n      while (x, y) != (tx, ty):\n          if x < tx:\n              path.append(RIGHT)\n              x += 1\n          elif x > tx:\n              path.append(LEFT)\n              x -= 1\n          elif y < ty:\n              path.append(DOWN)\n              y += 1\n          elif y > ty:\n              path.append(UP)\n              y -= 1\n      return path, (x, y)\n\n  # Collect each required primitive the needed number of times\n  for kind_idx, needed in primitive_needs.items():\n      while needed > 0:\n          target = find_closest(kind_idx, cur_pos)\n          if target is None:\n              # Primitive missing from the map \u2013 abort planning\n              return actions\n          move_actions, cur_pos = path_to(cur_pos, target)\n          actions.extend(move_actions)\n          actions.append(USE)   # pick up / use the primitive\n\n          # Update local grid copy to reflect the collection\n          grid[target[0], target[1], kind_idx] = max(\n              0, grid[target[0], target[1], kind_idx] - 1\n          )\n          needed -= 1\n\n  # If a workshop is required, move there and craft the stick\n  if workshop_idx is not None:\n      ws_target = find_closest(workshop_idx, cur_pos)\n      if ws_target is not None:\n          move_actions, cur_pos = path_to(cur_pos, ws_target)\n          actions.extend(move_actions)\n          actions.append(USE)   # craft at the workshop\n\n  return actions", "env_interactions": 2, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:08:42.651604", "function_name": "make_arrow", "function_body": "  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act.get(\"DOWN\", 0),\n      act.get(\"UP\", 1),\n      act.get(\"LEFT\", 2),\n      act.get(\"RIGHT\", 3),\n      act.get(\"USE\", 4),\n  )\n\n  # snapshot current state (do not modify env)\n  state = env._current_state\n  grid = state.grid.copy()                 # (W, H, n_kinds)\n  cur_pos = tuple(state.pos)               # (x, y)\n\n  # locate the index of the goal item \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n      if stick_idx is None:\n          return []   # stick not defined in this world\n\n  # retrieve the recipe (primitives needed) for a stick\n  recipe = env.world.cookbook.primitives_for(stick_idx)\n\n  # primitives needed (int keys) \u2013 if none, stick is itself primitive\n  primitive_needs = {k: v for k, v in recipe.items() if isinstance(k, int)}\n  if not primitive_needs:\n      primitive_needs = {stick_idx: 1}\n\n  # locate any workshop requirement (non\u2011int key)\n  workshop_idx = None\n  for k, v in recipe.items():\n      if not isinstance(k, int):\n          workshop_idx = v if isinstance(v, int) else None\n          break\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper: find the nearest cell that still contains at least one of\n  # the given kind (according to the local copy of the grid).\n  # ------------------------------------------------------------------\n  def find_closest(kind_idx, cur):\n      positions = np.argwhere(grid[:, :, kind_idx] > 0)\n      if positions.shape[0] == 0:\n          return None\n      dists = np.sum(np.abs(positions - np.array(cur)), axis=1)\n      nearest = positions[np.argmin(dists)]\n      return tuple(nearest.tolist())\n\n  # ------------------------------------------------------------------\n  # Helper: greedy Manhattan path from cur to target.\n  # ------------------------------------------------------------------\n  def path_to(cur, target):\n      x, y = cur\n      tx, ty = target\n      path = []\n      while (x, y) != (tx, ty):\n          if x < tx:\n              path.append(RIGHT)\n              x += 1\n          elif x > tx:\n              path.append(LEFT)\n              x -= 1\n          elif y < ty:\n              path.append(DOWN)\n              y += 1\n          elif y > ty:\n              path.append(UP)\n              y -= 1\n      return path, (x, y)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the needed number of times.\n  # ------------------------------------------------------------------\n  for kind_idx, needed in primitive_needs.items():\n      while needed > 0:\n          target = find_closest(kind_idx, cur_pos)\n          if target is None:\n              # primitive missing from map \u2013 abort planning\n              return actions\n          move_actions, cur_pos = path_to(cur_pos, target)\n          actions.extend(move_actions)\n          actions.append(USE)   # pick up / use the primitive\n\n          # update local grid copy to reflect the pickup\n          grid[target[0], target[1], kind_idx] = max(\n              0, grid[target[0], target[1], kind_idx] - 1\n          )\n          needed -= 1\n\n  # ------------------------------------------------------------------\n  # If a workshop is required, go there and craft the stick.\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_target = find_closest(workshop_idx, cur_pos)\n      if ws_target is not None:\n          move_actions, cur_pos = path_to(cur_pos, ws_target)\n          actions.extend(move_actions)\n          actions.append(USE)   # craft the stick at the workshop\n\n  return actions", "env_interactions": 2, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:09:03.762468", "function_name": "make_arrow", "function_body": "  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act.get(\"DOWN\", 0),\n      act.get(\"UP\", 1),\n      act.get(\"LEFT\", 2),\n      act.get(\"RIGHT\", 3),\n      act.get(\"USE\", 4),\n  )\n\n  # Snapshot of current state (do not modify the env)\n  state = env._current_state\n  grid = state.grid.copy()                 # (W, H, n_kinds)\n  cur_pos = tuple(state.pos)               # (x, y)\n\n  # Index of the goal item \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n      if stick_idx is None:\n          return []   # stick not defined in the world\n\n  # Determine primitive requirements for a stick\n  recipe = env.world.cookbook.primitives_for(stick_idx)   # dict {kind_idx: count}\n  primitive_needs = {k: v for k, v in recipe.items() if isinstance(k, int)}\n  workshop_idx = None\n  for k, v in recipe.items():\n      if not isinstance(k, int):\n          workshop_idx = v if isinstance(v, int) else None\n          break\n\n  # If the stick itself is a primitive (no recipe), we need to collect one stick\n  if not primitive_needs:\n      primitive_needs = {stick_idx: 1}\n\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # Helper: find the closest cell that still has at least one of the given kind\n  # ----------------------------------------------------------------------\n  def find_closest(kind_idx, cur):\n      positions = np.argwhere(grid[:, :, kind_idx] > 0)\n      if positions.shape[0] == 0:\n          return None\n      dists = np.sum(np.abs(positions - np.array(cur)), axis=1)\n      nearest = positions[np.argmin(dists)]\n      return tuple(nearest.tolist())\n\n  # ----------------------------------------------------------------------\n  # Helper: generate a simple Manhattan path (greedy) from cur to target\n  # ----------------------------------------------------------------------\n  def path_to(cur, target):\n      x, y = cur\n      tx, ty = target\n      path = []\n      while (x, y) != (tx, ty):\n          if x < tx:\n              path.append(RIGHT)\n              x += 1\n          elif x > tx:\n              path.append(LEFT)\n              x -= 1\n          elif y < ty:\n              path.append(DOWN)\n              y += 1\n          elif y > ty:\n              path.append(UP)\n              y -= 1\n      return path, (x, y)\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive the needed number of times\n  # ----------------------------------------------------------------------\n  for kind_idx, needed in primitive_needs.items():\n      while needed > 0:\n          target = find_closest(kind_idx, cur_pos)\n          if target is None:\n              # No more of this primitive on the map \u2013 abort planning\n              return actions\n          move_actions, cur_pos = path_to(cur_pos, target)\n          actions.extend(move_actions)\n          actions.append(USE)   # pick up / use the primitive\n\n          # Update local grid copy to reflect the collection\n          grid[target[0], target[1], kind_idx] = max(\n              0, grid[target[0], target[1], kind_idx] - 1\n          )\n          needed -= 1\n\n  # ----------------------------------------------------------------------\n  # If a workshop is required, move to it and craft the stick\n  # ----------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_target = find_closest(workshop_idx, cur_pos)\n      if ws_target is not None:\n          move_actions, cur_pos = path_to(cur_pos, ws_target)\n          actions.extend(move_actions)\n          actions.append(USE)   # craft stick at the workshop\n\n  return actions", "env_interactions": 2, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:09:05.066956", "function_name": "make_arrow", "function_body": "  # Action indices\n  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act.get(\"DOWN\", 0),\n      act.get(\"UP\", 1),\n      act.get(\"LEFT\", 2),\n      act.get(\"RIGHT\", 3),\n      act.get(\"USE\", 4),\n  )\n\n  # Current snapshot (do not modify the real env)\n  state = env._current_state\n  grid = state.grid.copy()                 # (W, H, n_kinds)\n  cur_pos = tuple(state.pos)               # (x, y)\n\n  # Index of the target item \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n      if stick_idx is None:\n          return []   # stick not defined in this world\n\n  # Recipe: primitives needed + possible workshop requirement\n  recipe = env.world.cookbook.primitives_for(stick_idx)\n\n  # Separate primitive requirements and workshop (if any)\n  primitive_needs = {k: v for k, v in recipe.items() if isinstance(k, int)}\n  workshop_idx = None\n  for k, v in recipe.items():\n      if not isinstance(k, int):\n          # non\u2011int key encodes workshop location\n          workshop_idx = v if isinstance(v, int) else None\n          break\n\n  # If there is no recipe, the stick itself is a primitive resource\n  if not primitive_needs:\n      primitive_needs = {stick_idx: 1}\n\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # Helper: locate the nearest cell containing at least one of `kind_idx`\n  # ----------------------------------------------------------------------\n  def find_closest(kind_idx, cur):\n      positions = np.argwhere(grid[:, :, kind_idx] > 0)\n      if positions.shape[0] == 0:\n          return None\n      dists = np.sum(np.abs(positions - np.array(cur)), axis=1)\n      nearest = positions[np.argmin(dists)]\n      return tuple(nearest.tolist())\n\n  # ----------------------------------------------------------------------\n  # Helper: simple Manhattan path (greedy) from `cur` to `target`\n  # ----------------------------------------------------------------------\n  def path_to(cur, target):\n      x, y = cur\n      tx, ty = target\n      path = []\n      while (x, y) != (tx, ty):\n          if x < tx:\n              path.append(RIGHT)\n              x += 1\n          elif x > tx:\n              path.append(LEFT)\n              x -= 1\n          elif y < ty:\n              path.append(DOWN)\n              y += 1\n          elif y > ty:\n              path.append(UP)\n              y -= 1\n      return path, (x, y)\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive the needed number of times\n  # ----------------------------------------------------------------------\n  for kind_idx, needed in primitive_needs.items():\n      while needed > 0:\n          target = find_closest(kind_idx, cur_pos)\n          if target is None:\n              # Primitive not available on the map \u2013 abort planning\n              return actions\n          move_actions, cur_pos = path_to(cur_pos, target)\n          actions.extend(move_actions)\n          actions.append(USE)   # pick up the primitive\n\n          # Update local grid copy to reflect the collection\n          grid[target[0], target[1], kind_idx] = max(\n              0, grid[target[0], target[1], kind_idx] - 1\n          )\n          needed -= 1\n\n  # ----------------------------------------------------------------------\n  # If a workshop is required, move to it and craft the stick\n  # ----------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_target = find_closest(workshop_idx, cur_pos)\n      if ws_target is not None:\n          move_actions, cur_pos = path_to(cur_pos, ws_target)\n          actions.extend(move_actions)\n          actions.append(USE)   # craft stick at the workshop\n\n  return actions", "env_interactions": 2, "island_id": 2, "scores": {"3": 0.0}}
