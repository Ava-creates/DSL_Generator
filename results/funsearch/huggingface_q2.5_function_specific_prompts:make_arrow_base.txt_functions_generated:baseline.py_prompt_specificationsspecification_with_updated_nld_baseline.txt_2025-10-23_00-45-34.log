{"timestamp": "2025-10-23T01:28:57.724615", "function_name": "make_arrow", "function_body": "  # Helper: BFS shortest path avoiding non\u2011grabbable cells\n  from collections import deque\n\n  act_map = env.action_specs()\n  USE = act_map[\"USE\"]\n  DIRS = [\n      (0, 1, act_map[\"DOWN\"]),\n      (0, -1, act_map[\"UP\"]),\n      (-1, 0, act_map[\"LEFT\"]),\n      (1, 0, act_map[\"RIGHT\"]),\n  ]\n\n  def _bfs_path(start, goal, blocked):\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for dx, dy, a in DIRS:\n              nx, ny = x + dx, y + dy\n              if (\n                  0 <= nx < blocked.shape[0]\n                  and 0 <= ny < blocked.shape[1]\n                  and not blocked[nx, ny]\n                  and (nx, ny) not in visited\n              ):\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [a]))\n      return None  # unreachable\n\n  # ------------------------------------------------------------------\n  # Main logic\n  # ------------------------------------------------------------------\n  state = env._current_state\n  world = env.world\n  grid = state.grid\n\n  # Index of the target item \"stick\"\n  try:\n      stick_idx = world.cookbook.index[\"stick\"]\n  except Exception:\n      return []  # stick not defined in this world\n\n  # Primitive requirements for a stick (empty if stick is primitive)\n  prim_req = world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n\n  # Cells that cannot be traversed (non\u2011grabbable entities)\n  blocked = np.zeros(grid.shape[:2], dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  actions_plan = []\n  cur_pos = tuple(state.pos)\n\n  # ------------------------------------------------------------------\n  # Case 1: stick is already a primitive placed in the world\n  # ------------------------------------------------------------------\n  if not prim_req:\n      stick_cells = np.argwhere(grid[:, :, stick_idx] > 0)\n      if stick_cells.size == 0:\n          return []  # no stick present\n      target = tuple(stick_cells[0])\n      if cur_pos != target:\n          path = _bfs_path(cur_pos, target, blocked)\n          if path is None:\n              return []  # cannot reach the stick\n          actions_plan.extend(path)\n      actions_plan.append(USE)\n      return actions_plan\n\n  # ------------------------------------------------------------------\n  # Case 2: need to collect required primitives first\n  # ------------------------------------------------------------------\n  needed = dict(prim_req)  # mutable copy of required counts\n\n  while any(cnt > 0 for cnt in needed.values()):\n      best_path = None\n      best_target = None\n      best_prim = None\n\n      for prim_idx, cnt in needed.items():\n          if cnt <= 0:\n              continue\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          for cell in prim_cells:\n              target = tuple(cell)\n              path = _bfs_path(cur_pos, target, blocked)\n              if path is None:\n                  continue\n              if best_path is None or len(path) < len(best_path):\n                  best_path = path\n                  best_target = target\n                  best_prim = prim_idx\n\n      if best_path is None:\n          # No reachable required primitive left\n          return []  # abort planning\n\n      # Move to the primitive and pick it up\n      actions_plan.extend(best_path)\n      actions_plan.append(USE)\n\n      # Update planning state\n      cur_pos = best_target\n      needed[best_prim] -= 1\n      # Remove the collected primitive from the grid copy so we don't reuse it\n      grid[best_target[0], best_target[1], best_prim] = 0\n\n  # ------------------------------------------------------------------\n  # Case 3: go to the workshop (if the recipe specifies one)\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          target = tuple(workshop_cells[0])\n          if cur_pos != target:\n              path = _bfs_path(cur_pos, target, blocked)\n              if path is None:\n                  return []  # cannot reach workshop\n              actions_plan.extend(path)\n              cur_pos = target\n\n  # ------------------------------------------------------------------\n  # Finally, craft the stick\n  # ------------------------------------------------------------------\n  actions_plan.append(USE)\n  return actions_plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T01:28:59.026574", "function_name": "make_arrow", "function_body": "  # Helper: BFS shortest path on the walkable grid\n  def _bfs_path(start, goal, blocked):\n      from collections import deque\n\n      act_map = env.action_specs()\n      dirs = [\n          (0, 1, act_map[\"DOWN\"]),\n          (0, -1, act_map[\"UP\"]),\n          (-1, 0, act_map[\"LEFT\"]),\n          (1, 0, act_map[\"RIGHT\"]),\n      ]\n\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for dx, dy, a in dirs:\n              nx, ny = x + dx, y + dy\n              if (\n                  0 <= nx < blocked.shape[0]\n                  and 0 <= ny < blocked.shape[1]\n                  and not blocked[nx, ny]\n                  and (nx, ny) not in visited\n              ):\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [a]))\n      return None  # unreachable\n\n  # ----------------------------------------------------------------------\n  # Main planning logic\n  # ----------------------------------------------------------------------\n  state = env._current_state\n  world = env.world\n  grid = state.grid.copy()          # work on a copy so we can \u201cremove\u201d items\n\n  # index of the target item \"stick\"\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # primitive requirements for a stick (empty dict if stick is primitive)\n  prim_req = world.cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n\n  # mask of cells we cannot walk through (non\u2011grabbable entities)\n  blocked = np.zeros(grid.shape[:2], dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  actions_plan = []\n  cur_pos = tuple(state.pos)\n\n  # ----------------------------------------------------------------------\n  # Case 1: stick is already a primitive placed in the world\n  # ----------------------------------------------------------------------\n  if not prim_req:\n      stick_cells = np.argwhere(grid[:, :, stick_idx] > 0)\n      if stick_cells.size == 0:\n          return []                     # nothing to do / cannot find stick\n      target = tuple(stick_cells[0])\n      if cur_pos != target:\n          path = _bfs_path(cur_pos, target, blocked)\n          if path is None:\n              return []                 # unreachable\n          actions_plan.extend(path)\n      actions_plan.append(env.action_specs()[\"USE\"])\n      return actions_plan\n\n  # ----------------------------------------------------------------------\n  # Case 2: collect required primitives\n  # ----------------------------------------------------------------------\n  needed = dict(prim_req)               # mutable copy of required counts\n\n  while any(cnt > 0 for cnt in needed.values()):\n      best_path = None\n      best_target = None\n      best_prim = None\n\n      # search all needed primitive cells for the shortest reachable one\n      for prim_idx, cnt in needed.items():\n          if cnt <= 0:\n              continue\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          for cell in prim_cells:\n              target = tuple(cell)\n              path = _bfs_path(cur_pos, target, blocked)\n              if path is None:\n                  continue\n              if best_path is None or len(path) < len(best_path):\n                  best_path = path\n                  best_target = target\n                  best_prim = prim_idx\n\n      if best_path is None:\n          # cannot reach any remaining required primitive\n          return []\n\n      # move to the primitive and pick it up\n      actions_plan.extend(best_path)\n      actions_plan.append(env.action_specs()[\"USE\"])\n\n      # update planning state (pretend we moved & collected)\n      cur_pos = best_target\n      needed[best_prim] -= 1\n      # remove the primitive from the grid copy so we don't try to collect it again\n      grid[best_target[0], best_target[1], best_prim] = 0\n\n  # ----------------------------------------------------------------------\n  # Case 3: go to the appropriate workshop (if recipe specifies one)\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          target = tuple(workshop_cells[0])\n          if cur_pos != target:\n              path = _bfs_path(cur_pos, target, blocked)\n              if path is None:\n                  return []                 # cannot reach workshop\n              actions_plan.extend(path)\n              cur_pos = target\n\n  # ----------------------------------------------------------------------\n  # Finally, craft the stick (USE action)\n  # ----------------------------------------------------------------------\n  actions_plan.append(env.action_specs()[\"USE\"])\n  return actions_plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T01:29:17.574450", "function_name": "make_arrow", "function_body": "  # ----- Action indices -----\n  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act.get(\"DOWN\", 0),\n      act.get(\"UP\", 1),\n      act.get(\"LEFT\", 2),\n      act.get(\"RIGHT\", 3),\n      act.get(\"USE\", 4),\n  )\n\n  # ----- Current snapshot -----\n  state = env._current_state\n  grid = state.grid.copy()                     # (W, H, n_kinds)\n  cur_pos = tuple(state.pos)                   # (x, y)\n\n  # ----- Identify stick index -----\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n      if stick_idx is None:\n          return []   # cannot find stick in index\n\n  # ----- Recipe: primitives needed and optional workshop -----\n  recipe = env.world.cookbook.primitives_for(stick_idx)   # dict {kind_idx: count}\n  primitive_needs = {k: v for k, v in recipe.items() if isinstance(k, int)}\n  workshop_idx = None\n  for k, v in recipe.items():\n      if not isinstance(k, int):   # non\u2011int key denotes workshop spec\n          workshop_idx = v if isinstance(v, int) else None\n          break\n\n  actions = []\n\n  # ----- Utility helpers -----\n  def find_closest(kind_idx, cur):\n      \"\"\"Return nearest cell (x, y) that still contains at least one of kind_idx.\"\"\"\n      positions = np.argwhere(grid[:, :, kind_idx] > 0)\n      if positions.shape[0] == 0:\n          return None\n      dists = np.sum(np.abs(positions - np.array(cur)), axis=1)\n      nearest = positions[np.argmin(dists)]\n      return tuple(nearest.tolist())\n\n  def path_to(cur, target):\n      \"\"\"Greedy Manhattan path from cur to target, returning list of actions and final pos.\"\"\"\n      x, y = cur\n      tx, ty = target\n      path = []\n      while (x, y) != (tx, ty):\n          if x < tx:\n              path.append(RIGHT)\n              x += 1\n          elif x > tx:\n              path.append(LEFT)\n              x -= 1\n          elif y < ty:\n              path.append(DOWN)\n              y += 1\n          elif y > ty:\n              path.append(UP)\n              y -= 1\n      return path, (x, y)\n\n  # ----- Collect required primitives -----\n  for kind_idx, needed in primitive_needs.items():\n      while needed > 0:\n          target = find_closest(kind_idx, cur_pos)\n          if target is None:\n              # Primitive not available any more; abort planning.\n              return actions\n          move_actions, cur_pos = path_to(cur_pos, target)\n          actions.extend(move_actions)\n          actions.append(USE)  # collect the primitive\n          # Update local grid copy to reflect consumption\n          grid[target[0], target[1], kind_idx] = max(\n              0, grid[target[0], target[1], kind_idx] - 1\n          )\n          needed -= 1\n\n  # ----- Craft stick at workshop (if required) -----\n  if workshop_idx is not None:\n      ws_target = find_closest(workshop_idx, cur_pos)\n      if ws_target is not None:\n          move_actions, cur_pos = path_to(cur_pos, ws_target)\n          actions.extend(move_actions)\n          actions.append(USE)   # craft at the workshop\n\n  return actions", "env_interactions": 2, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T01:29:18.880010", "function_name": "make_arrow", "function_body": "  # Get action mapping\n  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act.get(\"DOWN\", 0),\n      act.get(\"UP\", 1),\n      act.get(\"LEFT\", 2),\n      act.get(\"RIGHT\", 3),\n      act.get(\"USE\", 4),\n  )\n\n  # Snapshot of current state (do not modify the env)\n  state = env._current_state\n  grid = state.grid.copy()                 # (W, H, n_kinds)\n  cur_pos = tuple(state.pos)               # (x, y)\n\n  # Index of the goal item \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\", None)\n      if stick_idx is None:\n          return []   # stick not defined in the world\n\n  # Determine primitive requirements for a stick\n  recipe = env.world.cookbook.primitives_for(stick_idx)   # dict {kind_idx: count}\n  # Keep only integer keys (actual primitive kinds)\n  primitive_needs = {k: v for k, v in recipe.items() if isinstance(k, int)}\n\n  # If the stick itself is a primitive (no recipe), we need to collect one stick\n  if not primitive_needs:\n      primitive_needs = {stick_idx: 1}\n\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # Helper: find the closest cell that still has at least one of the given kind\n  # ----------------------------------------------------------------------\n  def find_closest(kind_idx, cur):\n      positions = np.argwhere(grid[:, :, kind_idx] > 0)\n      if positions.shape[0] == 0:\n          return None\n      dists = np.sum(np.abs(positions - np.array(cur)), axis=1)\n      nearest = positions[np.argmin(dists)]\n      return tuple(nearest.tolist())\n\n  # ----------------------------------------------------------------------\n  # Helper: generate a simple Manhattan path (greedy) from cur to target\n  # ----------------------------------------------------------------------\n  def path_to(cur, target):\n      x, y = cur\n      tx, ty = target\n      path = []\n      while (x, y) != (tx, ty):\n          if x < tx:\n              path.append(RIGHT)\n              x += 1\n          elif x > tx:\n              path.append(LEFT)\n              x -= 1\n          elif y < ty:\n              path.append(DOWN)\n              y += 1\n          elif y > ty:\n              path.append(UP)\n              y -= 1\n      return path, (x, y)\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive the needed number of times\n  # ----------------------------------------------------------------------\n  for kind_idx, needed in primitive_needs.items():\n      while needed > 0:\n          target = find_closest(kind_idx, cur_pos)\n          if target is None:\n              # No more of this primitive on the map \u2013 abort planning\n              return actions\n          move_actions, cur_pos = path_to(cur_pos, target)\n          actions.extend(move_actions)\n          actions.append(USE)   # pick up / use the primitive\n\n          # Update local grid copy to reflect the collection\n          grid[target[0], target[1], kind_idx] = max(\n              0, grid[target[0], target[1], kind_idx] - 1\n          )\n          needed -= 1\n\n  # ----------------------------------------------------------------------\n  # If a workshop is required, move to it and craft the stick\n  # ----------------------------------------------------------------------\n  workshop_idx = None\n  for k, v in recipe.items():\n      if not isinstance(k, int):   # non\u2011int key encodes workshop requirement\n          workshop_idx = v if isinstance(v, int) else None\n          break\n\n  if workshop_idx is not None:\n      target_ws = find_closest(workshop_idx, cur_pos)\n      if target_ws is not None:\n          move_actions, cur_pos = path_to(cur_pos, target_ws)\n          actions.extend(move_actions)\n          actions.append(USE)   # craft stick at the workshop\n\n  return actions", "env_interactions": 2, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T01:29:42.643991", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # mapping from action indices to movement deltas (row, col)\n  _ACTION_DELTAS = {\n      0: (1, 0),   # DOWN\n      1: (-1, 0),  # UP\n      2: (0, -1),  # LEFT\n      3: (0, 1),   # RIGHT\n  }\n\n  def _move_actions(start, goal):\n      \"\"\"Generate a list of movement actions (Manhattan) from start to goal.\"\"\"\n      y, x = start\n      gy, gx = goal\n      actions = []\n      while y < gy:\n          actions.append(0)  # DOWN\n          y += 1\n      while y > gy:\n          actions.append(1)  # UP\n          y -= 1\n      while x < gx:\n          actions.append(3)  # RIGHT\n          x += 1\n      while x > gx:\n          actions.append(2)  # LEFT\n          x -= 1\n      return actions\n\n  # ----------------------------------------------------------------------\n  # locate the world instance inside the supplied environment\n  # ----------------------------------------------------------------------\n  if hasattr(env, \"world\"):\n      world = env.world\n  elif hasattr(env, \"scenario\"):\n      world = env.scenario.world\n  else:\n      raise AttributeError(\"Unable to locate CraftWorld instance in the provided env.\")\n\n  # ----------------------------------------------------------------------\n  # identify the goal (stick) and its recipe\n  # ----------------------------------------------------------------------\n  goal_name = \"stick\"\n  goal_idx = world.cookbook.index.index(goal_name)\n\n  # primitives needed to craft a stick (dict {prim_idx: count})\n  needed = world.cookbook.primitives_for(goal_idx)\n\n  # ----------------------------------------------------------------------\n  # obtain the current state for planning (position + grid)\n  # ----------------------------------------------------------------------\n  if hasattr(env, \"_current_state\"):\n      state = env._current_state\n  else:\n      # fallback to a fresh initial state from the scenario\n      state = env.scenario.init()\n\n  cur_pos = tuple(state.pos)          # (row, col)\n  grid = state.grid.copy()            # (H, W, n_kinds)\n\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # collect each required primitive the necessary number of times\n  # ----------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          # locate any cell that currently holds this primitive\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(\n                  f\"Primitive '{world.cookbook.index.get(prim_idx)}' not found on the grid.\"\n              )\n          py, px = prim_cells[0]\n\n          # find an empty neighbour cell from which we can face the primitive\n          chosen_dir = None\n          target_cell = None\n          for d, (dy, dx) in _ACTION_DELTAS.items():\n              ny, nx = py - dy, px - dx\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  if not grid[ny, nx, :].any():          # empty cell\n                      chosen_dir = d\n                      target_cell = (ny, nx)\n                      break\n          if target_cell is None:\n              raise RuntimeError(\"No reachable empty neighbour around required primitive.\")\n\n          # move to that neighbour\n          actions.extend(_move_actions(cur_pos, target_cell))\n          cur_pos = target_cell\n\n          # use the primitive (agent now faces the primitive)\n          actions.append(4)   # USE\n\n          # update planning grid: remove the primitive we just collected\n          grid[py, px, prim_idx] = 0\n\n  # ----------------------------------------------------------------------\n  # move to the appropriate workshop (if the recipe specifies one) and craft\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_cells.size == 0:\n          raise RuntimeError(f\"Workshop '{workshop_name}' not found on the grid.\")\n      wy, wx = ws_cells[0]\n\n      # find an empty neighbour to face the workshop\n      chosen_dir = None\n      target_cell = None\n      for d, (dy, dx) in _ACTION_DELTAS.items():\n          ny, nx = wy - dy, wx - dx\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not grid[ny, nx, :].any():\n                  chosen_dir = d\n                  target_cell = (ny, nx)\n                  break\n      if target_cell is None:\n          raise RuntimeError(\"No reachable empty neighbour around workshop.\")\n\n      actions.extend(_move_actions(cur_pos, target_cell))\n      cur_pos = target_cell\n\n      # craft the stick\n      actions.append(4)   # USE\n\n  # return the complete list of actions needed to make a stick\n  return actions", "env_interactions": 5, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T01:29:44.061771", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  # Action mapping (same as in CraftWorld)\n  _ACTION_DELTAS = {\n      0: (1, 0),   # DOWN\n      1: (-1, 0),  # UP\n      2: (0, -1),  # LEFT\n      3: (0, 1),   # RIGHT\n  }\n\n  def _move_actions(start, goal):\n      \"\"\"Manhattan path from start (y,x) to goal (y,x) using only\n      orthogonal moves. Returns list of action indices.\"\"\"\n      y, x = start\n      gy, gx = goal\n      actions = []\n      while y < gy:\n          actions.append(0)   # DOWN\n          y += 1\n      while y > gy:\n          actions.append(1)   # UP\n          y -= 1\n      while x < gx:\n          actions.append(3)   # RIGHT\n          x += 1\n      while x > gx:\n          actions.append(2)   # LEFT\n          x -= 1\n      return actions\n\n  # ------------------------------------------------------------------\n  # Locate world object\n  # ------------------------------------------------------------------\n  if hasattr(env, \"world\"):\n      world = env.world\n  elif hasattr(env, \"scenario\"):\n      world = env.scenario.world\n  else:\n      raise AttributeError(\"Cannot locate CraftWorld instance in the supplied env.\")\n\n  # ------------------------------------------------------------------\n  # Goal information (stick)\n  # ------------------------------------------------------------------\n  goal_name = \"stick\"\n  goal_idx = world.cookbook.index.index(goal_name)\n\n  # Primitives required to craft the stick (may be empty if stick is primitive)\n  needed = world.cookbook.primitives_for(goal_idx)\n\n  # If no recipe, treat the stick itself as a primitive that must be collected\n  collect_directly = False\n  if not needed:\n      # No ingredients \u21d2 stick is a primitive entity on the map\n      needed = {goal_idx: 1}\n      collect_directly = True\n\n  # ------------------------------------------------------------------\n  # Current state (grid & position) for planning\n  # ------------------------------------------------------------------\n  if hasattr(env, \"_current_state\"):\n      state = env._current_state\n  else:\n      state = env.scenario.init()\n  cur_pos = tuple(state.pos)          # (row, col)\n  grid = state.grid.copy()            # (H, W, n_kinds)\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Collect all required primitives (or the stick itself if primitive)\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(\n                  f\"Required primitive {world.cookbook.index.get(prim_idx)} not found on the grid.\"\n              )\n          py, px = prim_cells[0]\n\n          # Find an empty neighbour from which we can face the primitive\n          chosen_dir = None\n          target_cell = None\n          for d, (dy, dx) in _ACTION_DELTAS.items():\n              ny, nx = py - dy, px - dx\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  if not grid[ny, nx, :].any():\n                      chosen_dir = d\n                      target_cell = (ny, nx)\n                      break\n          if target_cell is None:\n              raise RuntimeError(\"No reachable empty neighbour around required primitive.\")\n\n          # Move to that neighbour\n          actions.extend(_move_actions(cur_pos, target_cell))\n          cur_pos = target_cell\n\n          # Use (pick up / craft) the primitive\n          actions.append(4)   # USE\n          # Update planning grid: primitive disappears after use\n          grid[py, px, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # If a workshop is required (i.e., stick is not a direct primitive),\n  # move to it and USE to craft.\n  # ------------------------------------------------------------------\n  if not collect_directly:\n      recipe = world.cookbook.recipes.get(goal_idx, {})\n      workshop_name = recipe.get(\"_at\")\n      if workshop_name:\n          workshop_idx = world.cookbook.index.index(workshop_name)\n          ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n          if ws_cells.size == 0:\n              raise RuntimeError(f\"Workshop {workshop_name} not found on the grid.\")\n          wy, wx = ws_cells[0]\n\n          # Find empty neighbour to face the workshop\n          chosen_dir = None\n          target_cell = None\n          for d, (dy, dx) in _ACTION_DELTAS.items():\n              ny, nx = wy - dy, wx - dx\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  if not grid[ny, nx, :].any():\n                      chosen_dir = d\n                      target_cell = (ny, nx)\n                      break\n          if target_cell is None:\n              raise RuntimeError(\"No reachable empty neighbour around workshop.\")\n\n          # Move there and craft\n          actions.extend(_move_actions(cur_pos, target_cell))\n          cur_pos = target_cell\n          actions.append(4)   # USE\n\n  # ------------------------------------------------------------------\n  # Return the planned action sequence\n  # ------------------------------------------------------------------\n  return actions", "env_interactions": 5, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T01:30:12.487218", "function_name": "make_arrow", "function_body": "  # Reset the environment and obtain the initial state.\n  env.reset()\n  state = env._current_state\n  goal_idx = env.task.goal\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # Helper: locate all cells that contain a given kind (primitive, workshop, etc.).\n  def find_positions(kind):\n      # state.grid has shape (W, H, n_kinds); a cell contains the kind if the\n      # count at that slice is > 0.\n      locs = np.argwhere(state.grid[:, :, kind] > 0)\n      return [tuple(p) for p in locs]\n\n  # Helper: choose the Manhattan\u2011closest location of the desired kind.\n  def nearest(pos, kind):\n      positions = find_positions(kind)\n      if not positions:\n          return None\n      return min(positions, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n\n  # Helper: produce a list of movement actions (DOWN=0, UP=1, LEFT=2, RIGHT=3)\n  # that moves from src to dst using a simple Manhattan path.\n  def moves_to(src, dst):\n      sx, sy = src\n      dx, dy = dst\n      seq = []\n      while sx < dx:\n          seq.append(0)   # DOWN\n          sx += 1\n      while sx > dx:\n          seq.append(1)   # UP\n          sx -= 1\n      while sy < dy:\n          seq.append(3)   # RIGHT\n          sy += 1\n      while sy > dy:\n          seq.append(2)   # LEFT\n          sy -= 1\n      return seq\n\n  # -------------------------------------------------------------------------\n  # 1) If the goal itself is a primitive, just go to the nearest instance and\n  #    use the USE action (index 4) to pick it up.\n  # -------------------------------------------------------------------------\n  if not env.world.cookbook.primitives_for(goal_idx):\n      target = nearest(cur_pos, goal_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)   # USE\n      return actions\n\n  # -------------------------------------------------------------------------\n  # 2) Collect all required primitive ingredients for the goal.\n  # -------------------------------------------------------------------------\n  needed_prims = env.world.cookbook.primitives_for(goal_idx)\n  for prim_idx, count in needed_prims.items():\n      for _ in range(count):\n          target = nearest(cur_pos, prim_idx)\n          if target is None:\n              # Primitive not found \u2013 give up on this ingredient.\n              continue\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n          actions.append(4)   # pick up the primitive\n\n  # -------------------------------------------------------------------------\n  # 3) Move to the required workshop (if any) and craft the item.\n  # -------------------------------------------------------------------------\n  workshop_idx = None\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  for key, val in recipe.items():\n      # In the YAML recipes the workshop is stored under a string key such\n      # as \"_at\" or \"_key\".  Detect that and treat its value as the workshop\n      # kind index.\n      if isinstance(key, str):\n          workshop_idx = val\n          break\n\n  if workshop_idx is not None:\n      target = nearest(cur_pos, workshop_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)   # USE to craft at the workshop\n\n  return actions", "env_interactions": 1, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T01:30:13.792182", "function_name": "make_arrow", "function_body": "  env.reset()\n  goal_idx = env.task.goal\n  if not env.world.cookbook.primitives_for(goal_idx):\n      return [4]  # USE action for primitive goals\n  return [4]      # fallback: USE action to attempt crafting", "env_interactions": 1, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T01:30:31.182073", "function_name": "make_arrow", "function_body": "  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions from start to goal using\n      horizontal then vertical moves (ignores obstacles).\"\"\"\n      sx, sy = start\n      gx, gy = goal\n      actions = []\n      while sx < gx:\n          actions.append(ACTION_RIGHT)\n          sx += 1\n      while sx > gx:\n          actions.append(ACTION_LEFT)\n          sx -= 1\n      while sy < gy:\n          actions.append(ACTION_DOWN)\n          sy += 1\n      while sy > gy:\n          actions.append(ACTION_UP)\n          sy -= 1\n      return actions\n\n  def nearest_position(positions, reference):\n      \"\"\"Pick the position from *positions* with smallest Manhattan distance\n      to *reference*.\"\"\"\n      if len(positions) == 0:\n          return None\n      ref = np.array(reference)\n      dists = np.sum(np.abs(positions - ref), axis=1)\n      return tuple(positions[np.argmin(dists)])\n\n  # ------------------------------------------------------------------\n  # Gather current state information\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n\n  # ------------------------------------------------------------------\n  # Identify goal (stick)\n  # ------------------------------------------------------------------\n  goal_name = \"stick\"\n  goal_idx = env.world.cookbook.index[goal_name]\n\n  plan_actions = []\n\n  # ------------------------------------------------------------------\n  # Determine required primitives for the stick\n  # ------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n\n  # If stick is a primitive (no recipe), just collect it directly.\n  if not primitives_needed:\n      stick_cells = np.argwhere(grid[:, :, goal_idx] > 0)\n      if stick_cells.size == 0:\n          return plan_actions  # nothing to collect\n      target = nearest_position(stick_cells, pos)\n      plan_actions.extend(manhattan_path(pos, target))\n      plan_actions.append(ACTION_USE)\n      return plan_actions\n\n  # ------------------------------------------------------------------\n  # 1) Collect needed primitives\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      while inventory[prim_idx] < needed_cnt:\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              return plan_actions  # cannot satisfy requirement\n          target = nearest_position(prim_cells, pos)\n\n          # move to the primitive\n          plan_actions.extend(manhattan_path(pos, target))\n          pos = target\n\n          # pick it up\n          plan_actions.append(ACTION_USE)\n\n          # simulate pick\u2011up locally for further planning\n          inventory[prim_idx] += 1\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # ------------------------------------------------------------------\n  # 2) Go to workshop (if recipe requires one) and craft the stick\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          return plan_actions  # no workshop visible\n      wcell = tuple(workshop_cells[0])\n\n      # find a free adjacent cell to stand on\n      neighbours = [(wcell[0] + dx, wcell[1] + dy) for dx, dy in\n                    [(1, 0), (-1, 0), (0, 1), (0, -1)]]\n      stand_pos = None\n      for nx, ny in neighbours:\n          if (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and\n                  grid[nx, ny, :].sum() == 0):\n              stand_pos = (nx, ny)\n              break\n      if stand_pos is None:\n          stand_pos = wcell  # fallback: stand on the workshop itself\n\n      # move to the chosen standing position\n      plan_actions.extend(manhattan_path(pos, stand_pos))\n      pos = stand_pos\n\n      # use the workshop to craft the stick\n      plan_actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # Return the full action list\n  # ------------------------------------------------------------------\n  return plan_actions", "env_interactions": 5, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T01:30:32.596922", "function_name": "make_arrow", "function_body": "  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of actions moving horizontally then vertically.\"\"\"\n      sx, sy = start\n      gx, gy = goal\n      actions = []\n      while sx < gx:\n          actions.append(ACTION_RIGHT)\n          sx += 1\n      while sx > gx:\n          actions.append(ACTION_LEFT)\n          sx -= 1\n      while sy < gy:\n          actions.append(ACTION_DOWN)\n          sy += 1\n      while sy > gy:\n          actions.append(ACTION_UP)\n          sy -= 1\n      return actions\n\n  def nearest_position(positions, reference):\n      \"\"\"Pick the position from *positions* with smallest Manhattan distance to *reference*.\"\"\"\n      if len(positions) == 0:\n          return None\n      ref = np.array(reference)\n      dists = np.sum(np.abs(positions - ref), axis=1)\n      return tuple(positions[np.argmin(dists)])\n\n  # ------------------------------------------------------------------\n  # Gather current state information\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n\n  # ------------------------------------------------------------------\n  # Goal: stick\n  # ------------------------------------------------------------------\n  goal_name = \"stick\"\n  goal_idx = env.world.cookbook.index[goal_name]\n\n  plan_actions = []\n\n  # ------------------------------------------------------------------\n  # Determine required primitives for the stick\n  # ------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n\n  # If there is no recipe (stick is a primitive), just collect it directly.\n  if not primitives_needed:\n      stick_cells = np.argwhere(grid[:, :, goal_idx] > 0)\n      if stick_cells.size == 0:\n          return plan_actions\n      target = nearest_position(stick_cells, pos)\n      plan_actions.extend(manhattan_path(pos, target))\n      plan_actions.append(ACTION_USE)\n      return plan_actions\n\n  # ------------------------------------------------------------------\n  # 1) Collect needed primitives\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      while inventory[prim_idx] < needed_cnt:\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              return plan_actions  # cannot satisfy requirement\n          target = nearest_position(prim_cells, pos)\n\n          # move to the primitive\n          plan_actions.extend(manhattan_path(pos, target))\n          pos = target\n\n          # pick it up\n          plan_actions.append(ACTION_USE)\n\n          # simulate pick\u2011up locally for further planning\n          inventory[prim_idx] += 1\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # ------------------------------------------------------------------\n  # 2) Go to workshop (if required) and craft the stick\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          return plan_actions  # no workshop visible\n      wcell = tuple(workshop_cells[0])\n\n      # find a free adjacent cell to stand on\n      neighbours = [(wcell[0] + dx, wcell[1] + dy) for dx, dy in\n                    [(1, 0), (-1, 0), (0, 1), (0, -1)]]\n      stand_pos = None\n      for nx, ny in neighbours:\n          if (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and\n                  grid[nx, ny, :].sum() == 0):\n              stand_pos = (nx, ny)\n              break\n      if stand_pos is None:\n          stand_pos = wcell  # fallback: stand on the workshop itself\n\n      # move to the chosen standing position\n      plan_actions.extend(manhattan_path(pos, stand_pos))\n      pos = stand_pos\n\n      # use the workshop to craft the stick\n      plan_actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # Return the full action list\n  # ------------------------------------------------------------------\n  return plan_actions", "env_interactions": 5, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T01:30:44.890082", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n\n  # Action indices\n  act = env.action_specs()\n  DOWN = act[\"DOWN\"]\n  UP = act[\"UP\"]\n  LEFT = act[\"LEFT\"]\n  RIGHT = act[\"RIGHT\"]\n  USE = act[\"USE\"]\n\n  # Index of the primitive \"stick\"\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # Find all cells containing a stick\n  stick_cells = np.argwhere(state.grid[:, :, stick_idx] > 0)\n  if stick_cells.size == 0:\n      # No stick present \u2013 nothing to do\n      return []\n\n  # Choose the nearest stick (Manhattan distance)\n  cur_pos = np.array(state.pos)\n  dists = np.abs(stick_cells - cur_pos).sum(axis=1)\n  target = stick_cells[dists.argmin()]\n\n  # Compute moves (ignore obstacles)\n  dx = int(target[0] - cur_pos[0])\n  dy = int(target[1] - cur_pos[1])\n\n  actions = []\n\n  if dx > 0:\n      actions += [DOWN] * dx\n  elif dx < 0:\n      actions += [UP] * (-dx)\n\n  if dy > 0:\n      actions += [RIGHT] * dy\n  elif dy < 0:\n      actions += [LEFT] * (-dy)\n\n  # Pick up the stick\n  actions.append(USE)\n\n  return actions", "env_interactions": 0, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T01:30:46.238894", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n\n  # Action indices\n  act = env.action_specs()\n  DOWN = act[\"DOWN\"]\n  UP = act[\"UP\"]\n  LEFT = act[\"LEFT\"]\n  RIGHT = act[\"RIGHT\"]\n  USE = act[\"USE\"]\n\n  # Index of the primitive \"stick\"\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # Find all cells that contain a stick\n  stick_cells = np.argwhere(state.grid[:, :, stick_idx] > 0)\n  if stick_cells.size == 0:\n      # No stick present \u2013 nothing to do\n      return []\n\n  # Choose the nearest stick (Manhattan distance)\n  cur_pos = np.array(state.pos)\n  dists = np.abs(stick_cells - cur_pos).sum(axis=1)\n  target = stick_cells[dists.argmin()]\n\n  # Compute Manhattan moves (ignoring obstacles)\n  dx = int(target[0] - cur_pos[0])\n  dy = int(target[1] - cur_pos[1])\n\n  actions = []\n\n  if dx > 0:\n      actions += [DOWN] * dx\n  elif dx < 0:\n      actions += [UP] * (-dx)\n\n  if dy > 0:\n      actions += [RIGHT] * dy\n  elif dy < 0:\n      actions += [LEFT] * (-dy)\n\n  # Pick up the stick\n  actions.append(USE)\n\n  return actions", "env_interactions": 0, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T01:31:15.087564", "function_name": "make_arrow", "function_body": "  # Helper: BFS shortest path avoiding non\u2011grabbable cells\n  def _bfs_path(start, goal, blocked):\n      from collections import deque\n\n      act_map = env.action_specs()\n      directions = [\n          (0, 1, act_map[\"DOWN\"]),\n          (0, -1, act_map[\"UP\"]),\n          (-1, 0, act_map[\"LEFT\"]),\n          (1, 0, act_map[\"RIGHT\"]),\n      ]\n\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for dx, dy, a in directions:\n              nx, ny = x + dx, y + dy\n              if (\n                  0 <= nx < blocked.shape[0]\n                  and 0 <= ny < blocked.shape[1]\n                  and not blocked[nx, ny]\n                  and (nx, ny) not in visited\n              ):\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [a]))\n      return None  # unreachable\n\n  # ------------------------------------------------------------------\n  # Main planning logic\n  # ------------------------------------------------------------------\n  state = env._current_state\n  world = env.world\n  grid = state.grid.copy()                # work on a copy to \u201cremove\u201d items\n\n  # Index of the target item \"stick\"\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # Primitive requirements for a stick (empty dict if stick is primitive)\n  prim_req = world.cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n\n  # Build mask of cells that cannot be traversed (non\u2011grabbable entities)\n  blocked = np.zeros(grid.shape[:2], dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # ------------------------------------------------------------------\n  # Case 1: stick is a primitive already placed in the world\n  # ------------------------------------------------------------------\n  if not prim_req:\n      stick_cells = np.argwhere(grid[:, :, stick_idx] > 0)\n      if stick_cells.size == 0:\n          return []                         # cannot find a stick\n      target = tuple(stick_cells[0])\n      if cur_pos != target:\n          path = _bfs_path(cur_pos, target, blocked)\n          if path is None:\n              return []                     # unreachable\n          actions.extend(path)\n      actions.append(env.action_specs()[\"USE\"])\n      return actions\n\n  # ------------------------------------------------------------------\n  # Case 2: collect required primitives\n  # ------------------------------------------------------------------\n  needed = dict(prim_req)                 # mutable copy of required counts\n\n  while any(cnt > 0 for cnt in needed.values()):\n      best_path = None\n      best_target = None\n      best_prim = None\n\n      # Search for the nearest reachable cell of any needed primitive\n      for prim_idx, cnt in needed.items():\n          if cnt <= 0:\n              continue\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          for cell in prim_cells:\n              target = tuple(cell)\n              path = _bfs_path(cur_pos, target, blocked)\n              if path is None:\n                  continue\n              if best_path is None or len(path) < len(best_path):\n                  best_path = path\n                  best_target = target\n                  best_prim = prim_idx\n\n      if best_path is None:\n          # No remaining required primitive is reachable\n          return []\n\n      # Move to the primitive and pick it up\n      actions.extend(best_path)\n      actions.append(env.action_specs()[\"USE\"])\n\n      # Update planning state\n      cur_pos = best_target\n      needed[best_prim] -= 1\n      grid[best_target[0], best_target[1], best_prim] = 0   # remove from copy\n\n  # ------------------------------------------------------------------\n  # Case 3: go to the required workshop (if any)\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          target = tuple(workshop_cells[0])\n          if cur_pos != target:\n              path = _bfs_path(cur_pos, target, blocked)\n              if path is None:\n                  return []                     # cannot reach workshop\n              actions.extend(path)\n              cur_pos = target\n\n  # ------------------------------------------------------------------\n  # Finally, craft the stick\n  # ------------------------------------------------------------------\n  actions.append(env.action_specs()[\"USE\"])\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T01:31:16.490428", "function_name": "make_arrow", "function_body": "", "env_interactions": 0, "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-10-23T01:31:40.707850", "function_name": "make_arrow", "function_body": "  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act.get(\"DOWN\", 0),\n      act.get(\"UP\", 1),\n      act.get(\"LEFT\", 2),\n      act.get(\"RIGHT\", 3),\n      act.get(\"USE\", 4),\n  )\n\n  # Snapshot of current state (do not modify the env)\n  state = env._current_state\n  grid = state.grid.copy()                 # (W, H, n_kinds)\n  cur_pos = tuple(state.pos)               # (x, y)\n\n  # Index of the goal item \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\", None)\n      if stick_idx is None:\n          return []   # stick not defined in the world\n\n  # Determine primitive requirements for a stick\n  recipe = env.world.cookbook.primitives_for(stick_idx)   # dict {kind_idx: count}\n  primitive_needs = {k: v for k, v in recipe.items() if isinstance(k, int)}\n\n  # If the stick itself is a primitive (no recipe), we need to collect one stick\n  if not primitive_needs:\n      primitive_needs = {stick_idx: 1}\n\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # Helper: find the closest cell that still has at least one of the given kind\n  # ----------------------------------------------------------------------\n  def find_closest(kind_idx, cur):\n      positions = np.argwhere(grid[:, :, kind_idx] > 0)\n      if positions.shape[0] == 0:\n          return None\n      dists = np.sum(np.abs(positions - np.array(cur)), axis=1)\n      nearest = positions[np.argmin(dists)]\n      return tuple(nearest.tolist())\n\n  # ----------------------------------------------------------------------\n  # Helper: generate a simple Manhattan path (greedy) from cur to target\n  # ----------------------------------------------------------------------\n  def path_to(cur, target):\n      x, y = cur\n      tx, ty = target\n      path = []\n      while (x, y) != (tx, ty):\n          if x < tx:\n              path.append(RIGHT)\n              x += 1\n          elif x > tx:\n              path.append(LEFT)\n              x -= 1\n          elif y < ty:\n              path.append(DOWN)\n              y += 1\n          elif y > ty:\n              path.append(UP)\n              y -= 1\n      return path, (x, y)\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive the needed number of times\n  # ----------------------------------------------------------------------\n  for kind_idx, needed in primitive_needs.items():\n      while needed > 0:\n          target = find_closest(kind_idx, cur_pos)\n          if target is None:\n              # No more of this primitive on the map \u2013 abort planning\n              return actions\n          move_actions, cur_pos = path_to(cur_pos, target)\n          actions.extend(move_actions)\n          actions.append(USE)   # pick up / use the primitive\n\n          # Update local grid copy to reflect the collection\n          grid[target[0], target[1], kind_idx] = max(\n              0, grid[target[0], target[1], kind_idx] - 1\n          )\n          needed -= 1\n\n  # ----------------------------------------------------------------------\n  # If a workshop is required, move to it and craft the stick\n  # ----------------------------------------------------------------------\n  workshop_idx = None\n  for k, v in recipe.items():\n      if not isinstance(k, int):\n          workshop_idx = v if isinstance(v, int) else None\n          break\n\n  if workshop_idx is not None:\n      target_ws = find_closest(workshop_idx, cur_pos)\n      if target_ws is not None:\n          move_actions, cur_pos = path_to(cur_pos, target_ws)\n          actions.extend(move_actions)\n          actions.append(USE)   # craft stick at the workshop\n\n  return actions", "env_interactions": 2, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T01:31:42.032678", "function_name": "make_arrow", "function_body": "  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act.get(\"DOWN\", 0),\n      act.get(\"UP\", 1),\n      act.get(\"LEFT\", 2),\n      act.get(\"RIGHT\", 3),\n      act.get(\"USE\", 4),\n  )\n\n  # Snapshot of the current state (do not modify the env)\n  state = env._current_state\n  grid = state.grid.copy()                 # (W, H, n_kinds)\n  cur_pos = tuple(state.pos)               # (x, y)\n\n  # Index of the goal item \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\", None)\n      if stick_idx is None:\n          return []   # stick not defined in this world\n\n  # Primitive requirements for a stick (may be empty if stick is primitive)\n  recipe = env.world.cookbook.primitives_for(stick_idx)   # dict {kind_idx: count}\n  primitive_needs = {k: v for k, v in recipe.items() if isinstance(k, int)}\n\n  # If there is no recipe, we must simply pick up a stick from the map\n  if not primitive_needs:\n      primitive_needs = {stick_idx: 1}\n\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # Helper: locate the nearest cell that still contains at least one of the\n  # given kind (according to the local copy of the grid).\n  # ----------------------------------------------------------------------\n  def find_closest(kind_idx, cur):\n      positions = np.argwhere(grid[:, :, kind_idx] > 0)\n      if positions.shape[0] == 0:\n          return None\n      dists = np.sum(np.abs(positions - np.array(cur)), axis=1)\n      nearest = positions[np.argmin(dists)]\n      return tuple(nearest.tolist())\n\n  # ----------------------------------------------------------------------\n  # Helper: generate a greedy Manhattan path from cur to target.\n  # ----------------------------------------------------------------------\n  def path_to(cur, target):\n      x, y = cur\n      tx, ty = target\n      path = []\n      while (x, y) != (tx, ty):\n          if x < tx:\n              path.append(RIGHT)\n              x += 1\n          elif x > tx:\n              path.append(LEFT)\n              x -= 1\n          elif y < ty:\n              path.append(DOWN)\n              y += 1\n          elif y > ty:\n              path.append(UP)\n              y -= 1\n      return path, (x, y)\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive the needed number of times.\n  # ----------------------------------------------------------------------\n  for kind_idx, needed in primitive_needs.items():\n      while needed > 0:\n          target = find_closest(kind_idx, cur_pos)\n          if target is None:\n              # Primitive not present on the map \u2013 abort planning.\n              return actions\n          move_actions, cur_pos = path_to(cur_pos, target)\n          actions.extend(move_actions)\n          actions.append(USE)   # pick up / use the primitive\n\n          # Update local grid copy to reflect the collection.\n          grid[target[0], target[1], kind_idx] = max(\n              0, grid[target[0], target[1], kind_idx] - 1\n          )\n          needed -= 1\n\n  # ----------------------------------------------------------------------\n  # If a workshop is required, move to it and craft the stick.\n  # ----------------------------------------------------------------------\n  workshop_idx = None\n  for k, v in recipe.items():\n      if not isinstance(k, int):   # non\u2011int key encodes workshop requirement\n          workshop_idx = v if isinstance(v, int) else None\n          break\n\n  if workshop_idx is not None:\n      target_ws = find_closest(workshop_idx, cur_pos)\n      if target_ws is not None:\n          move_actions, cur_pos = path_to(cur_pos, target_ws)\n          actions.extend(move_actions)\n          actions.append(USE)   # craft the stick at the workshop\n\n  return actions", "env_interactions": 2, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T01:31:55.961401", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n\n  # Action indices\n  act = env.action_specs()\n  DOWN = act[\"DOWN\"]\n  UP = act[\"UP\"]\n  LEFT = act[\"LEFT\"]\n  RIGHT = act[\"RIGHT\"]\n  USE = act[\"USE\"]\n\n  # Index of the primitive \"stick\"\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # Locate cells that contain a stick\n  stick_cells = np.argwhere(state.grid[:, :, stick_idx] > 0)\n  if stick_cells.size == 0:\n      # No stick present in the world \u2013 nothing to do\n      return []\n\n  # Choose the nearest stick (Manhattan distance)\n  cur_pos = np.array(state.pos)\n  dists = np.abs(stick_cells - cur_pos).sum(axis=1)\n  target = stick_cells[dists.argmin()]\n\n  # Compute Manhattan moves (ignore obstacles)\n  dx = int(target[0] - cur_pos[0])\n  dy = int(target[1] - cur_pos[1])\n\n  actions = []\n\n  # Move along x\u2011axis\n  if dx > 0:\n      actions += [DOWN] * dx\n  elif dx < 0:\n      actions += [UP] * (-dx)\n\n  # Move along y\u2011axis\n  if dy > 0:\n      actions += [RIGHT] * dy\n  elif dy < 0:\n      actions += [LEFT] * (-dy)\n\n  # Pick up the stick\n  actions.append(USE)\n\n  return actions", "env_interactions": 0, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T01:31:57.364784", "function_name": "make_arrow", "function_body": "  # get current state and world reference\n  state = env._current_state\n  world = env.world\n\n  # action identifiers\n  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act[\"DOWN\"], act[\"UP\"], act[\"LEFT\"], act[\"RIGHT\"], act[\"USE\"]\n  )\n\n  # index of the primitive stick\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # locate all sticks on the grid\n  stick_cells = np.argwhere(state.grid[:, :, stick_idx] > 0)\n  if stick_cells.size == 0:\n      # nothing to collect\n      return []\n\n  # BFS to find shortest path to any stick, avoiding non\u2011grabbable entities\n  width, height = state.grid.shape[:2]\n  non_grabbable = world.non_grabbable_indices\n\n  def traversable(p):\n      x, y = p\n      # inside bounds\n      if not (0 <= x < width and 0 <= y < height):\n          return False\n      # cell must not contain any non\u2011grabbable kind\n      for idx in non_grabbable:\n          if state.grid[x, y, idx] > 0:\n              return False\n      return True\n\n  start = tuple(state.pos)\n  target_set = {tuple(cell) for cell in stick_cells}\n  queue = collections.deque([start])\n  visited = {start: None}\n  goal = None\n\n  while queue:\n      cur = queue.popleft()\n      if cur in target_set:\n          goal = cur\n          break\n      x, y = cur\n      for nx, ny, act_code in [(x + 1, y, DOWN), (x - 1, y, UP),\n                               (x, y + 1, RIGHT), (x, y - 1, LEFT)]:\n          nxt = (nx, ny)\n          if nxt not in visited and traversable(nxt):\n              visited[nxt] = (cur, act_code)\n              queue.append(nxt)\n\n  if goal is None:\n      # no reachable stick\n      return []\n\n  # reconstruct actions from start to goal\n  actions = []\n  cur = goal\n  while visited[cur] is not None:\n      prev, act_code = visited[cur]\n      actions.append(act_code)\n      cur = prev\n  actions.reverse()  # now from start to goal\n\n  # finally pick up the stick\n  actions.append(USE)\n  return actions", "env_interactions": 0, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T01:32:21.748022", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  stick_idx = env.world.cookbook.index['stick']\n  grid = state.grid\n  actions = []\n\n  # helper to generate movement actions from start to target\n  def _navigate(start, target):\n      sx, sy = start\n      tx, ty = target\n      seq = []\n      while sx < tx:\n          seq.append(3)   # RIGHT\n          sx += 1\n      while sx > tx:\n          seq.append(2)   # LEFT\n          sx -= 1\n      while sy < ty:\n          seq.append(0)   # DOWN\n          sy += 1\n      while sy > ty:\n          seq.append(1)   # UP\n          sy -= 1\n      return seq\n\n  # 1. If a stick already exists on the map, just go pick it up.\n  stick_cells = np.argwhere(grid[:, :, stick_idx] > 0)\n  if stick_cells.size:\n      target = stick_cells[0]\n      actions.extend(_navigate(state.pos, target))\n      actions.append(4)   # USE\n      return actions\n\n  # 2. Otherwise, try to craft a stick using its recipe.\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  if not recipe:\n      return []   # no way to obtain a stick\n\n  cur_pos = state.pos\n\n  # 2a. Collect each ingredient (ignore counts >1 for simplicity).\n  for ing_key, cnt in recipe.items():\n      if isinstance(ing_key, str) and ing_key.startswith('_'):\n          continue\n      ing_idx = ing_key\n      # find any cell that contains this ingredient\n      ing_cells = np.argwhere(grid[:, :, ing_idx] > 0)\n      if not ing_cells.size:\n          return []   # missing ingredient on the map\n      ing_target = ing_cells[0]\n      actions.extend(_navigate(cur_pos, ing_target))\n      actions.append(4)   # USE to pick up the ingredient\n      cur_pos = ing_target\n\n  # 2b. Move to the required workshop, if any.\n  workshop_idx = recipe.get('_at')\n  if workshop_idx is not None:\n      ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_cells.size:\n          ws_target = ws_cells[0]\n          actions.extend(_navigate(cur_pos, ws_target))\n          cur_pos = ws_target\n\n  # 3. Craft the stick at the current location.\n  actions.append(4)   # USE to craft\n\n  return actions", "env_interactions": 0, "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-10-23T01:32:23.148570", "function_name": "make_arrow", "function_body": "  # Access current state and world objects\n  state = env._current_state\n  world = env.world\n\n  # Index of the stick item\n  stick_idx = world.cookbook.index['stick']\n\n  # If we already have a stick in inventory, no actions needed\n  if state.inventory[stick_idx] > 0:\n      return []\n\n  actions = []\n  # Track the agent's position as we plan moves\n  cur_pos = list(state.pos)\n\n  # Helper to move Manhattan\u2011style to a target cell\n  def move_to(target):\n      nonlocal actions, cur_pos\n      tx, ty = target\n      # move in x (horizontal) direction\n      while cur_pos[0] < tx:\n          actions.append(3)          # RIGHT\n          cur_pos[0] += 1\n      while cur_pos[0] > tx:\n          actions.append(2)          # LEFT\n          cur_pos[0] -= 1\n      # move in y (vertical) direction\n      while cur_pos[1] < ty:\n          actions.append(0)          # DOWN\n          cur_pos[1] += 1\n      while cur_pos[1] > ty:\n          actions.append(1)          # UP\n          cur_pos[1] -= 1\n\n  # Retrieve the recipe for a stick (may be None if stick is a primitive)\n  recipe = world.cookbook.recipes.get(stick_idx)\n\n  # ------------------------------------------------------------------\n  # Case 1: stick is a primitive already placed on the ground.\n  # ------------------------------------------------------------------\n  if not recipe:\n      locations = np.argwhere(state.grid[:, :, stick_idx] > 0)\n      if locations.size == 0:\n          return []                     # nothing to pick up\n      move_to(locations[0])\n      actions.append(4)                 # USE (pick up)\n      return actions\n\n  # ------------------------------------------------------------------\n  # Case 2: stick must be crafted from ingredients.\n  # ------------------------------------------------------------------\n  # Gather each required ingredient the required number of times.\n  for ing_idx, cnt in recipe.items():\n      if ing_idx == '_at':\n          continue                     # workshop key, not an ingredient\n      for _ in range(cnt):\n          # Find any instance of the ingredient on the ground.\n          locs = np.argwhere(state.grid[:, :, ing_idx] > 0)\n          if locs.size == 0:\n              continue                 # ingredient not present; skip\n          move_to(locs[0])\n          actions.append(4)             # USE (pick up)\n\n  # After collecting ingredients, go to the appropriate workshop and craft.\n  workshop_idx = recipe.get('_at')\n  if workshop_idx is not None:\n      ws_locs = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if ws_locs.size:\n          move_to(ws_locs[0])\n          actions.append(4)             # USE (craft at workshop)\n\n  return actions", "env_interactions": 0, "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-10-23T01:32:53.823359", "function_name": "make_arrow", "function_body": "", "env_interactions": 0, "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-10-23T01:32:55.173597", "function_name": "make_arrow", "function_body": "  actions = []\n  state = env._current_state\n  grid = state.grid\n  world = env.world\n  cb = world.cookbook\n\n  # index of the goal item \"stick\"\n  try:\n      goal_idx = cb.index[\"stick\"]\n  except Exception:\n      return actions\n\n  # primitives (and their required counts) for the goal\n  prims = cb.primitives_for(goal_idx)\n\n  # current agent position (x, y)\n  pos = list(state.pos)\n\n  # helper to move to a target cell using Manhattan moves\n  def _move_to(target):\n      nonlocal pos, actions\n      tx, ty = target\n      while pos[0] < tx:\n          actions.append(3)   # RIGHT\n          pos[0] += 1\n      while pos[0] > tx:\n          actions.append(2)   # LEFT\n          pos[0] -= 1\n      while pos[1] < ty:\n          actions.append(0)   # DOWN\n          pos[1] += 1\n      while pos[1] > ty:\n          actions.append(1)   # UP\n          pos[1] -= 1\n\n  # collect each required primitive\n  for prim_idx, needed in prims.items():\n      # locate cells that contain this primitive\n      locs = np.argwhere(grid[:, :, prim_idx] > 0)\n      if locs.size == 0:\n          continue  # cannot find; skip (should not happen in valid scenarios)\n      target = locs[0].tolist()  # pick the first occurrence\n      _move_to(target)\n      # pick up the required amount (USE action)\n      for _ in range(needed):\n          actions.append(4)   # USE\n\n  # move to the workshop specified in the recipe and craft the stick\n  recipe = cb.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = cb.index[workshop_name]\n      w_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if w_locs.size:\n          w_target = w_locs[0].tolist()\n          _move_to(w_target)\n          actions.append(4)   # USE to craft at the workshop\n\n  return actions", "env_interactions": 4, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T01:33:29.953752", "function_name": "make_arrow", "function_body": "  # Get current state and world objects\n  state = env._current_state\n  world = env.world\n\n  # Index of the target item \"stick\"\n  stick_idx = world.cookbook.index['stick']\n\n  # Primitive requirements for one stick (primitive_idx -> count)\n  needed = world.cookbook.primitives_for(stick_idx)\n\n  actions = []\n  # Current agent position as mutable list [x, y]\n  pos = list(state.pos)\n  grid = state.grid\n\n  def get_coords(kind):\n      \"\"\"Return list of (x, y) positions where `kind` is present.\"\"\"\n      coords = np.argwhere(grid[:, :, kind] > 0)\n      # argwhere returns (x, y) already in the order we need\n      return [tuple(coord) for coord in coords]\n\n  def move_towards(target):\n      \"\"\"Append actions that move the agent from current `pos` to `target`.\"\"\"\n      nonlocal pos\n      while pos[0] != target[0] or pos[1] != target[1]:\n          if pos[0] < target[0]:\n              actions.append(3)   # RIGHT\n              pos[0] += 1\n          elif pos[0] > target[0]:\n              actions.append(2)   # LEFT\n              pos[0] -= 1\n          elif pos[1] < target[1]:\n              actions.append(0)   # DOWN\n              pos[1] += 1\n          elif pos[1] > target[1]:\n              actions.append(1)   # UP\n              pos[1] -= 1\n\n  # ----------------------------------------------------------------------\n  # 1) Collect all required primitives\n  # ----------------------------------------------------------------------\n  for kind_idx, count in needed.items():\n      for _ in range(count):\n          primitive_cells = get_coords(kind_idx)\n          if not primitive_cells:\n              # Primitive not found; skip (environment may already have it)\n              continue\n          # Choose the closest primitive cell (Manhattan distance)\n          distances = [abs(pos[0] - x) + abs(pos[1] - y) for (x, y) in primitive_cells]\n          target_cell = primitive_cells[int(np.argmin(distances))]\n          # Move to the cell and pick up\n          move_towards(target_cell)\n          actions.append(4)   # USE to collect\n\n  # ----------------------------------------------------------------------\n  # 2) Move to the appropriate workshop and craft the stick\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_kind = recipe.get('_at')  # workshop identifier stored under \"_at\"\n  if workshop_kind is not None:\n      workshop_cells = get_coords(workshop_kind)\n      if workshop_cells:\n          distances = [abs(pos[0] - x) + abs(pos[1] - y) for (x, y) in workshop_cells]\n          target_ws = workshop_cells[int(np.argmin(distances))]\n          move_towards(target_ws)\n          actions.append(4)   # USE to craft at the workshop\n\n  return actions", "env_interactions": 0, "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-10-23T01:33:31.330886", "function_name": "make_arrow", "function_body": "  # Helper constants for actions (match CraftWorld's ordering)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Utility functions\n  # ------------------------------------------------------------------\n  def manhattan_path(cur, dst):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that moves\n      from cur (x, y) to dst (x, y) using a simple Manhattan walk.\"\"\"\n      cx, cy = cur\n      tx, ty = dst\n      actions = []\n      # move in x direction\n      while cx < tx:\n          actions.append(DOWN)\n          cx += 1\n      while cx > tx:\n          actions.append(UP)\n          cx -= 1\n      # move in y direction\n      while cy < ty:\n          actions.append(RIGHT)\n          cy += 1\n      while cy > ty:\n          actions.append(LEFT)\n          cy -= 1\n      return actions\n\n  # ------------------------------------------------------------------\n  # Extract goal information\n  # ------------------------------------------------------------------\n  # env is a CraftLab instance\n  world = env.world\n  task = env.task                     # Task(namedtuple) with .goal (int)\n  goal_idx = task.goal\n  goal_name = world.cookbook.index.get(goal_idx)\n\n  # If the goal is not a stick, return an empty plan\n  if goal_name.lower() != \"stick\":\n      return []\n\n  # ------------------------------------------------------------------\n  # Get the current state to inspect the grid and agent position\n  # ------------------------------------------------------------------\n  state = env._current_state          # CraftState instance\n  grid = state.grid                    # (W, H, n_kinds) occupancy\n  pos = state.pos                      # (x, y) tuple\n\n  # ------------------------------------------------------------------\n  # Determine required primitive resources for a stick\n  # ------------------------------------------------------------------\n  # primitives_for returns a dict {primitive_idx: count}\n  prim_dict = world.cookbook.primitives_for(goal_idx)\n\n  plan = []            # list of actions to be returned\n  cur_pos = pos        # keep track of simulated position\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive\n  # ------------------------------------------------------------------\n  for prim_idx, needed in prim_dict.items():\n      # locate all cells that contain this primitive\n      locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n      if not locations:\n          # primitive not present; give up with empty plan\n          return []\n      # simple strategy: always pick the first location\n      # (could be improved with nearest\u2011neighbor search)\n      prim_loc = locations[0]\n\n      # Move adjacent to the primitive (Manhattan walk to the cell itself;\n      # we will later issue a USE which works from the neighboring cell)\n      path_to_prim = manhattan_path(cur_pos, prim_loc)\n      plan.extend(path_to_prim)\n      cur_pos = prim_loc\n\n      # Perform a USE action to pick it up\n      plan.append(USE)\n\n      # Update our simulated grid: remove the primitive from the world\n      # (so that subsequent searches don't find the same instance)\n      grid[prim_loc[0], prim_loc[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Move to the appropriate workshop and craft the stick\n  # ------------------------------------------------------------------\n  # The workshop type is stored in the recipe under the special key\n  # \"_at\".  The cookbook stores recipes as {output_idx: {ingredient_idx: cnt,\n  # \"_at\": workshop_idx}}.\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = recipe.get(\"_at\")\n  if workshop_idx is None:\n      # No explicit workshop \u2013 assume crafting can be done anywhere\n      return plan\n\n  # Find any workshop cell of the required type\n  work_cells = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))\n  if not work_cells:\n      return plan  # cannot find workshop; return what we have\n\n  workshop_loc = work_cells[0]\n\n  # Move to the workshop\n  path_to_workshop = manhattan_path(cur_pos, workshop_loc)\n  plan.extend(path_to_workshop)\n  cur_pos = workshop_loc\n\n  # Use the workshop to craft the stick\n  plan.append(USE)\n\n  return plan", "env_interactions": 0, "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-10-23T01:34:00.068208", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Get current state (reset if necessary)\n  # ----------------------------------------------------------------------\n  try:\n      state = env._current_state\n  except AttributeError:\n      env.reset()\n      state = env._current_state\n\n  # ----------------------------------------------------------------------\n  # Action IDs\n  # ----------------------------------------------------------------------\n  act_spec = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act_spec[\"DOWN\"],\n      act_spec[\"UP\"],\n      act_spec[\"LEFT\"],\n      act_spec[\"RIGHT\"],\n      act_spec[\"USE\"],\n  )\n\n  # ----------------------------------------------------------------------\n  # Identify stick index and its recipe requirements\n  # ----------------------------------------------------------------------\n  stick_idx = env.world.cookbook.index[\"stick\"]\n  needed = env.world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n  # workshop index (if any) stored under \"_at\" in the recipe dict\n  workshop_idx = env.world.cookbook.recipes.get(stick_idx, {}).get(\"_at\", None)\n\n  # ----------------------------------------------------------------------\n  # Helpers\n  # ----------------------------------------------------------------------\n  def plan_move(start, target):\n      \"\"\"Manhattan planner returning list of actions and final position.\"\"\"\n      actions = []\n      x, y = start\n      tx, ty = target\n      while x < tx:\n          actions.append(DOWN)\n          x += 1\n      while x > tx:\n          actions.append(UP)\n          x -= 1\n      while y < ty:\n          actions.append(RIGHT)\n          y += 1\n      while y > ty:\n          actions.append(LEFT)\n          y -= 1\n      return actions, (x, y)\n\n  def locate(kind_idx):\n      \"\"\"Return list of grid coordinates where kind_idx is present.\"\"\"\n      xs, ys = np.where(state.grid[:, :, kind_idx] > 0)\n      return list(zip(xs.tolist(), ys.tolist()))\n\n  # ----------------------------------------------------------------------\n  # Planning\n  # ----------------------------------------------------------------------\n  actions_plan = []\n  cur_pos = state.pos\n  inventory = state.inventory.copy()\n\n  # ----------------------------------------------------------------------\n  # Collect required primitives\n  # ----------------------------------------------------------------------\n  for prim_idx, req_cnt in needed.items():\n      while inventory[prim_idx] < req_cnt:\n          prim_locs = locate(prim_idx)\n          if not prim_locs:\n              # primitive not available \u2013 abort planning\n              return actions_plan\n          # pick nearest location (Manhattan)\n          dists = [abs(px - cur_pos[0]) + abs(py - cur_pos[1]) for (px, py) in prim_locs]\n          target = prim_locs[int(np.argmin(dists))]\n          # move to the cell itself (assume it is walkable)\n          move_actions, cur_pos = plan_move(cur_pos, target)\n          actions_plan.extend(move_actions)\n          # use to pick up\n          actions_plan.append(USE)\n          # update simulated state\n          inventory[prim_idx] += 1\n\n  # ----------------------------------------------------------------------\n  # Move to workshop (if required) and craft stick\n  # ----------------------------------------------------------------------\n  if workshop_idx is not None:\n      workshop_cells = locate(workshop_idx)\n      if workshop_cells:\n          # choose nearest workshop cell\n          dists = [\n              abs(px - cur_pos[0]) + abs(py - cur_pos[1]) for (px, py) in workshop_cells\n          ]\n          target_ws = workshop_cells[int(np.argmin(dists))]\n          move_actions, cur_pos = plan_move(cur_pos, target_ws)\n          actions_plan.extend(move_actions)\n  # finally craft / pick up stick\n  actions_plan.append(USE)\n\n  return actions_plan", "env_interactions": 0, "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-10-23T01:34:01.377061", "function_name": "make_arrow", "function_body": "  # Ensure we have a current state\n  try:\n      state = env._current_state\n  except AttributeError:\n      env.reset()\n      state = env._current_state\n\n  # Action specs\n  specs = env.action_specs()\n  DOWN = specs[\"DOWN\"]\n  UP = specs[\"UP\"]\n  LEFT = specs[\"LEFT\"]\n  RIGHT = specs[\"RIGHT\"]\n  USE = specs[\"USE\"]\n\n  # Index of the goal item 'stick'\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      return []\n\n  # Primitives required to craft a stick (empty if stick is primitive)\n  needed = env.world.cookbook.primitives_for(stick_idx)\n\n  # ------------------------------------------------------------------\n  # Helper functions\n  # ------------------------------------------------------------------\n  def locate(kind_idx):\n      \"\"\"Return list of (x, y) positions where `kind_idx` exists.\"\"\"\n      xs, ys = np.where(state.grid[:, :, kind_idx] > 0)\n      return list(zip(xs.tolist(), ys.tolist()))\n\n  def manhattan_path(start, target):\n      \"\"\"\n      Generate a list of actions moving from `start` to `target`\n      using simple Manhattan moves (ignores obstacles).\n      \"\"\"\n      actions = []\n      x, y = start\n      tx, ty = target\n      while x < tx:\n          actions.append(DOWN)\n          x += 1\n      while x > tx:\n          actions.append(UP)\n          x -= 1\n      while y < ty:\n          actions.append(RIGHT)\n          y += 1\n      while y > ty:\n          actions.append(LEFT)\n          y -= 1\n      return actions\n\n  # ------------------------------------------------------------------\n  # Build the action plan\n  # ------------------------------------------------------------------\n  actions_plan = []\n  cur_pos = state.pos\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive\n  # ------------------------------------------------------------------\n  for prim_idx, req_cnt in needed.items():\n      while state.inventory[prim_idx] < req_cnt:\n          prim_locs = locate(prim_idx)\n          if not prim_locs:\n              # Primitive not present \u2013 abort planning\n              return actions_plan\n\n          # Choose the closest primitive (Manhattan distance)\n          distances = [\n              abs(px - cur_pos[0]) + abs(py - cur_pos[1]) for (px, py) in prim_locs\n          ]\n          target = prim_locs[int(np.argmin(distances))]\n\n          # Move to an adjacent cell (prefer the cell above the target)\n          adj = (target[0] - 1, target[1]) if target[0] > 0 else target\n          move_actions = manhattan_path(cur_pos, adj)\n          actions_plan.extend(move_actions)\n          cur_pos = adj\n\n          # Pick up the primitive\n          actions_plan.append(USE)\n\n          # Update local copy of inventory to keep loop condition accurate\n          state.inventory[prim_idx] += 1\n\n  # ------------------------------------------------------------------\n  # Move to a workshop to craft the stick (if any workshop exists)\n  # ------------------------------------------------------------------\n  workshop_cells = []\n  for w_idx in env.world.workshop_indices:\n      xs, ys = np.where(state.grid[:, :, w_idx] > 0)\n      workshop_cells.extend(zip(xs.tolist(), ys.tolist()))\n\n  if workshop_cells:\n      distances = [\n          abs(px - cur_pos[0]) + abs(py - cur_pos[1]) for (px, py) in workshop_cells\n      ]\n      workshop_target = workshop_cells[int(np.argmin(distances))]\n      move_actions = manhattan_path(cur_pos, workshop_target)\n      actions_plan.extend(move_actions)\n      cur_pos = workshop_target\n\n  # ------------------------------------------------------------------\n  # Craft the stick\n  # ------------------------------------------------------------------\n  actions_plan.append(USE)\n\n  return actions_plan", "env_interactions": 6, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T01:34:21.487872", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # action -> (dy, dx) mapping (DOWN,UP,LEFT,RIGHT)\n  _ACTION_DELTAS = {\n      0: (1, 0),   # DOWN\n      1: (-1, 0),  # UP\n      2: (0, -1),  # LEFT\n      3: (0, 1),   # RIGHT\n  }\n\n  def _move_actions(start, goal):\n      \"\"\"Manhattan path from start (row,col) to goal (row,col).\"\"\"\n      y, x = start\n      gy, gx = goal\n      acts = []\n      while y < gy:\n          acts.append(0)   # DOWN\n          y += 1\n      while y > gy:\n          acts.append(1)   # UP\n          y -= 1\n      while x < gx:\n          acts.append(3)   # RIGHT\n          x += 1\n      while x > gx:\n          acts.append(2)   # LEFT\n          x -= 1\n      return acts\n\n  # ------------------------------------------------------------------\n  # locate the CraftWorld instance inside the supplied env\n  # ------------------------------------------------------------------\n  if hasattr(env, \"world\"):\n      world = env.world\n  elif hasattr(env, \"scenario\"):\n      world = env.scenario.world\n  else:\n      raise AttributeError(\"Cannot find CraftWorld instance in env.\")\n\n  # ------------------------------------------------------------------\n  # identify the goal (stick) and its recipe\n  # ------------------------------------------------------------------\n  goal_name = \"stick\"\n  goal_idx = world.cookbook.index.index(goal_name)\n\n  # primitives required to craft the stick (may be empty if stick is primitive)\n  needed = world.cookbook.primitives_for(goal_idx)\n\n  # ------------------------------------------------------------------\n  # obtain current state for planning (position + grid)\n  # ------------------------------------------------------------------\n  if hasattr(env, \"_current_state\"):\n      state = env._current_state\n  else:\n      state = env.scenario.init()\n\n  cur_pos = tuple(state.pos)          # (row, col)\n  grid = state.grid.copy()            # (H, W, n_kinds)\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # collect each required primitive the required number of times\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          # locate any cell that currently holds this primitive\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(\n                  f\"Primitive '{world.cookbook.index.get(prim_idx)}' not found on the grid.\"\n              )\n          py, px = prim_cells[0]\n\n          # find an empty neighbour cell from which we can face the primitive\n          target_cell = None\n          for d, (dy, dx) in _ACTION_DELTAS.items():\n              ny, nx = py - dy, px - dx\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  if not grid[ny, nx, :].any():          # empty\n                      target_cell = (ny, nx)\n                      break\n          if target_cell is None:\n              raise RuntimeError(\"No reachable empty neighbour around required primitive.\")\n\n          # move to that neighbour\n          actions.extend(_move_actions(cur_pos, target_cell))\n          cur_pos = target_cell\n\n          # use (collect) the primitive\n          actions.append(4)   # USE\n\n          # update planning grid \u2013 primitive has been taken\n          grid[py, px, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # move to workshop (if recipe specifies one) and craft the stick\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_cells.size == 0:\n          raise RuntimeError(f\"Workshop '{workshop_name}' not found on the grid.\")\n      wy, wx = ws_cells[0]\n\n      # find empty neighbour to face the workshop\n      target_cell = None\n      for d, (dy, dx) in _ACTION_DELTAS.items():\n          ny, nx = wy - dy, wx - dx\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not grid[ny, nx, :].any():\n                  target_cell = (ny, nx)\n                  break\n      if target_cell is None:\n          raise RuntimeError(\"No reachable empty neighbour around workshop.\")\n\n      actions.extend(_move_actions(cur_pos, target_cell))\n      cur_pos = target_cell\n\n      # craft the stick\n      actions.append(4)   # USE\n\n  # return the complete action list\n  return actions", "env_interactions": 5, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T01:34:22.802337", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # action index to movement delta (row, col)\n  _ACTION_DELTAS = {\n      0: (1, 0),   # DOWN\n      1: (-1, 0),  # UP\n      2: (0, -1),  # LEFT\n      3: (0, 1),   # RIGHT\n  }\n\n  def _move_actions(start, goal):\n      \"\"\"Manhattan path from start to goal as a list of movement actions.\"\"\"\n      y, x = start\n      gy, gx = goal\n      actions = []\n      while y < gy:\n          actions.append(0)   # DOWN\n          y += 1\n      while y > gy:\n          actions.append(1)   # UP\n          y -= 1\n      while x < gx:\n          actions.append(3)   # RIGHT\n          x += 1\n      while x > gx:\n          actions.append(2)   # LEFT\n          x -= 1\n      return actions\n\n  # ----------------------------------------------------------------------\n  # locate the world instance inside the supplied environment\n  # ----------------------------------------------------------------------\n  if hasattr(env, \"world\"):\n      world = env.world\n  elif hasattr(env, \"scenario\"):\n      world = env.scenario.world\n  else:\n      raise AttributeError(\"Cannot find CraftWorld instance in the provided env.\")\n\n  # ----------------------------------------------------------------------\n  # identify the goal (stick) and its recipe\n  # ----------------------------------------------------------------------\n  goal_name = \"stick\"\n  goal_idx = world.cookbook.index.index(goal_name)\n\n  # primitives needed for the stick (dict {prim_idx: count})\n  needed = world.cookbook.primitives_for(goal_idx)\n\n  # ----------------------------------------------------------------------\n  # obtain the current state for planning (position + grid)\n  # ----------------------------------------------------------------------\n  if hasattr(env, \"_current_state\"):\n      state = env._current_state\n  else:\n      state = env.scenario.init()\n\n  cur_pos = tuple(state.pos)          # (row, col)\n  grid = state.grid.copy()            # (H, W, n_kinds)\n\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # collect each required primitive the required number of times\n  # ----------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          # locate a cell that currently holds this primitive\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(\n                  f\"Primitive '{world.cookbook.index.get(prim_idx)}' not found on the grid.\"\n              )\n          py, px = prim_cells[0]\n\n          # find an empty neighbour from which we can face the primitive\n          target_cell = None\n          chosen_dir = None\n          for d, (dy, dx) in _ACTION_DELTAS.items():\n              ny, nx = py - dy, px - dx\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  if not grid[ny, nx, :].any():          # empty cell\n                      target_cell = (ny, nx)\n                      chosen_dir = d\n                      break\n          if target_cell is None:\n              raise RuntimeError(\"No reachable empty neighbour around required primitive.\")\n\n          # move to that neighbour\n          actions.extend(_move_actions(cur_pos, target_cell))\n          cur_pos = target_cell\n\n          # use (collect) the primitive; agent now faces the primitive\n          actions.append(4)   # USE\n\n          # update planning grid: remove the collected primitive\n          grid[py, px, prim_idx] = 0\n\n  # ----------------------------------------------------------------------\n  # if the recipe specifies a workshop, move to it and craft the stick\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_cells.size == 0:\n          raise RuntimeError(f\"Workshop '{workshop_name}' not found on the grid.\")\n      wy, wx = ws_cells[0]\n\n      # find an empty neighbour to face the workshop\n      target_cell = None\n      for d, (dy, dx) in _ACTION_DELTAS.items():\n          ny, nx = wy - dy, wx - dx\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not grid[ny, nx, :].any():\n                  target_cell = (ny, nx)\n                  break\n      if target_cell is None:\n          raise RuntimeError(\"No reachable empty neighbour around workshop.\")\n\n      actions.extend(_move_actions(cur_pos, target_cell))\n      cur_pos = target_cell\n\n      # craft the stick\n      actions.append(4)   # USE\n\n  # Return the complete action sequence to obtain a stick\n  return actions", "env_interactions": 5, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T01:35:00.197635", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n  stick_idx = world.cookbook.index['stick']\n\n  # Helper to move the agent from (x, y) to (tx, ty)\n  def move_to(tx, ty, pos, actions_list):\n      x, y = pos\n      # horizontal moves\n      while x < tx:\n          actions_list.append(3)   # RIGHT\n          x += 1\n      while x > tx:\n          actions_list.append(2)   # LEFT\n          x -= 1\n      # vertical moves\n      while y < ty:\n          actions_list.append(0)   # DOWN\n          y += 1\n      while y > ty:\n          actions_list.append(1)   # UP\n          y -= 1\n      return (x, y)\n\n  # Simple collector: go to the nearest cell containing the given kind and USE it\n  def collect_item(kind_idx, cur_pos, actions_list):\n      # locate any occurrence of the item on the grid\n      positions = np.argwhere(state.grid[:, :, kind_idx] > 0)\n      if positions.size == 0:\n          return cur_pos, False  # failed to find the item\n      tx, ty = positions[0]\n      cur_pos = move_to(tx, ty, cur_pos, actions_list)\n      actions_list.append(4)       # USE to pick up / interact\n      return cur_pos, True\n\n  # ----------------------------------------------------------------------\n  # If stick is a primitive, just collect it directly.\n  if stick_idx in world.cookbook.primitives:\n      pos, ok = collect_item(stick_idx, state.pos, [])\n      return [] if not ok else pos and [4]  # fallback: empty if not found\n\n  # Otherwise stick must be crafted. Retrieve its recipe.\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get('_at', None)\n\n  actions = []\n  cur_pos = state.pos\n\n  # Gather all required ingredients (ignore the workshop entry)\n  for ing_key, count in recipe.items():\n      if ing_key == '_at':\n          continue\n      # ingredient may be stored as index or name\n      if isinstance(ing_key, int):\n          ing_idx = ing_key\n      else:\n          ing_idx = world.cookbook.index[ing_key]\n      for _ in range(count):\n          cur_pos, ok = collect_item(ing_idx, cur_pos, actions)\n          if not ok:\n              return []  # cannot satisfy the recipe\n\n  # Move to the appropriate workshop (if any) before crafting\n  if workshop_name is not None:\n      ws_idx = world.cookbook.index[workshop_name]\n      cur_pos, ok = collect_item(ws_idx, cur_pos, actions)  # reuse move logic\n      if not ok:\n          return []  # workshop not found\n\n  # Finally, use the stick workshop (or current cell) to craft the stick\n  actions.append(4)   # USE to craft\n  return actions", "env_interactions": 5, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T01:35:01.620967", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n  index = world.cookbook.index\n\n  # Index of the stick item\n  if 'stick' not in index.contents:\n      return []\n  stick_idx = index['stick']\n\n  # Helper to move to a target cell (Manhattan moves)\n  actions = []\n  pos = list(state.pos)\n\n  def _move_to(target):\n      nonlocal actions, pos\n      # horizontal (x) movement\n      while pos[0] != target[0]:\n          if pos[0] < target[0]:\n              actions.append(3)   # RIGHT\n              pos[0] += 1\n          else:\n              actions.append(2)   # LEFT\n              pos[0] -= 1\n      # vertical (y) movement\n      while pos[1] != target[1]:\n          if pos[1] < target[1]:\n              actions.append(0)   # DOWN\n              pos[1] += 1\n          else:\n              actions.append(1)   # UP\n              pos[1] -= 1\n\n  grid = state.grid\n\n  # First, try to see if the stick itself is already placed in the world\n  stick_cells = np.argwhere(grid[:, :, stick_idx] > 0)\n  if stick_cells.size > 0:\n      target = stick_cells[0].tolist()\n      _move_to(target)\n      actions.append(4)   # USE to pick up the stick\n      return actions\n\n  # Otherwise, we need to craft the stick from its primitives\n  # Get the recipe for the stick (may be empty if stick is primitive)\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  # Determine required primitives\n  prim_requirements = world.cookbook.primitives_for(stick_idx)\n\n  # Collect each required primitive\n  for prim_idx, needed in prim_requirements.items():\n      # Locate all cells that contain this primitive\n      prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n      if prim_cells.size == 0:\n          # Primitive not present \u2013 cannot complete the task\n          return []\n      collected = 0\n      used = set()\n      while collected < needed:\n          # Choose the nearest unused primitive cell\n          best = None\n          best_dist = None\n          for cell in prim_cells:\n              cell_t = tuple(cell)\n              if cell_t in used:\n                  continue\n              dist = abs(pos[0] - cell[0]) + abs(pos[1] - cell[1])\n              if best is None or dist < best_dist:\n                  best = cell\n                  best_dist = dist\n          if best is None:\n              return []  # not enough primitives left\n          _move_to(best.tolist())\n          actions.append(4)   # USE to pick up the primitive\n          used.add(tuple(best))\n          collected += 1\n\n  # After gathering all primitives, go to the appropriate workshop (if any)\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = index[workshop_name]\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          return []\n      # Move to the nearest workshop\n      best = None\n      best_dist = None\n      for cell in workshop_cells:\n          dist = abs(pos[0] - cell[0]) + abs(pos[1] - cell[1])\n          if best is None or dist < best_dist:\n              best = cell\n              best_dist = dist\n      _move_to(best.tolist())\n      actions.append(4)   # USE to craft the stick\n\n  return actions", "env_interactions": 4, "island_id": 8, "scores": {"3": 0.0}}
