{"timestamp": "2025-10-23T01:27:51.157311", "function_name": "make_arrow", "function_body": "  # Helper to map direction names to action indices\n  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act.get(\"DOWN\", 0),\n      act.get(\"UP\", 1),\n      act.get(\"LEFT\", 2),\n      act.get(\"RIGHT\", 3),\n      act.get(\"USE\", 4),\n  )\n\n  # Current state snapshot (do not modify the env itself)\n  state = env._current_state\n  grid = state.grid.copy()                 # (W, H, n_kinds)\n  cur_pos = tuple(state.pos)               # (x, y)\n\n  # Identify the index for the goal item \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      # fallback to lowercase name lookup\n      stick_idx = env.world.cookbook.index.get(\"stick\", None)\n      if stick_idx is None:\n          return []   # cannot find stick in index\n\n  # Get the primitive requirements for a stick (may be empty if stick is primitive)\n  recipe = env.world.cookbook.primitives_for(stick_idx)   # dict {kind_idx: count}\n  # The recipe dict may contain a special \"_key\" entry for the workshop; ignore non\u2011int keys\n  primitive_needs = {k: v for k, v in recipe.items() if isinstance(k, int)}\n\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # Utility: compute Manhattan distance\n  # ----------------------------------------------------------------------\n  def manhattan(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  # ----------------------------------------------------------------------\n  # Utility: find the closest cell that still has at least one of the given kind\n  # ----------------------------------------------------------------------\n  def find_closest(kind_idx, cur):\n      positions = np.argwhere(grid[:, :, kind_idx] > 0)\n      if positions.shape[0] == 0:\n          return None\n      dists = np.sum(np.abs(positions - np.array(cur)), axis=1)\n      nearest = positions[np.argmin(dists)]\n      return tuple(nearest.tolist())\n\n  # ----------------------------------------------------------------------\n  # Utility: generate a simple Manhattan path (greedy) from cur to target\n  # ----------------------------------------------------------------------\n  def path_to(cur, target):\n      x, y = cur\n      tx, ty = target\n      path = []\n      while (x, y) != (tx, ty):\n          if x < tx:\n              path.append(RIGHT)\n              x += 1\n          elif x > tx:\n              path.append(LEFT)\n              x -= 1\n          elif y < ty:\n              path.append(DOWN)\n              y += 1\n          elif y > ty:\n              path.append(UP)\n              y -= 1\n      return path, (x, y)\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive the needed number of times\n  # ----------------------------------------------------------------------\n  for kind_idx, needed in primitive_needs.items():\n      while needed > 0:\n          target = find_closest(kind_idx, cur_pos)\n          if target is None:\n              # No more of this primitive on the map \u2013 give up\n              return actions\n          # Move next to the target (if the target cell itself is occupied we still\n          # move onto it; the environment will block illegal moves, but this simple\n          # planner works for most open maps).\n          move_actions, cur_pos = path_to(cur_pos, target)\n          actions.extend(move_actions)\n\n          # Use the item (collect / craft)\n          actions.append(USE)\n\n          # Update our local copy of the grid to reflect the collection\n          grid[target[0], target[1], kind_idx] = max(\n              0, grid[target[0], target[1], kind_idx] - 1\n          )\n          needed -= 1\n\n  # ----------------------------------------------------------------------\n  # After having all primitives, craft the stick at a workshop (if any)\n  # ----------------------------------------------------------------------\n  # The recipe may specify a workshop via the special key \"_key\".\n  # If such a key exists, locate the nearest workshop cell.\n  workshop_idx = None\n  for k, v in recipe.items():\n      if not isinstance(k, int):   # non\u2011int key -> workshop spec\n          # The value associated is usually the workshop kind index\n          workshop_idx = v if isinstance(v, int) else None\n          break\n\n  if workshop_idx is not None:\n      target_ws = find_closest(workshop_idx, cur_pos)\n      if target_ws is not None:\n          move_actions, cur_pos = path_to(cur_pos, target_ws)\n          actions.extend(move_actions)\n          actions.append(USE)   # craft at the workshop\n\n  # Return the complete action list\n  return actions", "env_interactions": 2, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T01:28:30.038659", "function_name": "make_arrow", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants (match CraftLab.action_specs order)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]\n  OPPOSITE = {DOWN: UP, UP: DOWN, LEFT: RIGHT, RIGHT: LEFT}\n  DELTA = {DOWN: (1, 0), UP: (-1, 0), LEFT: (0, -1), RIGHT: (0, 1)}\n\n  # Ensure the environment is in a fresh state\n  env.reset()\n  state = env._current_state\n  world = env.world\n\n  # Goal item (stick) \u2013 use the task goal if it matches a recipe, otherwise look up by name\n  goal_idx = getattr(env, \"task\", None).goal if hasattr(env, \"task\") else None\n  if goal_idx is None or goal_idx not in world.cookbook.recipes:\n      # fallback to name lookup\n      goal_idx = world.cookbook.index.get(\"stick\")\n      if goal_idx is None:\n          return []  # cannot determine stick index\n\n  # If we already have the stick, nothing to do\n  if state.inventory[goal_idx] > 0:\n      return []\n\n  # Retrieve the recipe for the stick\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = recipe.get(\"_at\")                     # workshop kind required for crafting\n  prim_requirements = {k: v for k, v in recipe.items() if k != \"_at\"}  # primitive kind \u2192 count\n\n  W, H, _ = state.grid.shape\n  actions_plan = []\n\n  def is_free(pos):\n      x, y = pos\n      return 0 <= x < W and 0 <= y < H and not state.grid[x, y, :].any()\n\n  def bfs(start, goal):\n      \"\"\"Return list of actions to move from start to goal (both (x,y)).\"\"\"\n      visited = np.full((W, H), False, dtype=bool)\n      q = collections.deque()\n      q.append((start, []))\n      visited[start] = True\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for dx, dy, act in DIRS:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if not state.grid[nx, ny, :].any():   # cannot step on occupied cells\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [act]))\n      return None\n\n  def adjacent_free(cell):\n      \"\"\"Find a free adjacent cell to `cell` that can be used to interact with `cell`.\"\"\"\n      cx, cy = cell\n      for dx, dy, act in DIRS:\n          ax, ay = cx + dx, cy + dy\n          if 0 <= ax < W and 0 <= ay < H and is_free((ax, ay)):\n              return (ax, ay), act  # act is the direction we must face when standing on (ax,ay)\n      return None, None\n\n  # ----------------------------------------------------------------------\n  # Collect all required primitives\n  # ----------------------------------------------------------------------\n  for prim_idx, needed_cnt in prim_requirements.items():\n      while state.inventory[prim_idx] < needed_cnt:\n          # locate a primitive instance on the grid\n          prim_positions = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_positions.size == 0:\n              raise RuntimeError(\"Required primitive not found on map.\")\n          prim_pos = tuple(prim_positions[0])  # (x,y)\n\n          # find a free cell adjacent to the primitive and the direction needed\n          adj_cell, needed_dir = adjacent_free(prim_pos)\n          if adj_cell is None:\n              raise RuntimeError(\"No free adjacent cell to primitive.\")\n\n          # move to that adjacent cell\n          path = bfs(state.pos, adj_cell)\n          if path is None:\n              raise RuntimeError(\"Cannot reach primitive.\")\n          for act in path:\n              actions_plan.append(act)\n              _, _, _ = env.step(act)\n              state = env._current_state\n\n          # ensure we are facing the primitive; if the last move does not give the\n          # correct orientation, perform a small back\u2011and\u2011forth adjustment.\n          if needed_dir is not None:\n              # Determine current facing direction (last move direction)\n              current_dir = path[-1] if path else state.dir\n              if current_dir != needed_dir:\n                  # try to step one cell opposite then back\n                  opp_dir = OPPOSITE[needed_dir]\n                  dx, dy = DELTA[opp_dir]\n                  back_pos = (adj_cell[0] + dx, adj_cell[1] + dy)\n                  if is_free(back_pos):\n                      actions_plan.append(opp_dir)\n                      _, _, _ = env.step(opp_dir)\n                      state = env._current_state\n                      actions_plan.append(needed_dir)\n                      _, _, _ = env.step(needed_dir)\n                      state = env._current_state\n                  else:\n                      # fallback: just turn by moving in a circle (right\u2011left)\n                      actions_plan.append(RIGHT)\n                      _, _, _ = env.step(RIGHT)\n                      state = env._current_state\n                      actions_plan.append(LEFT)\n                      _, _, _ = env.step(LEFT)\n                      state = env._current_state\n\n          # collect the primitive\n          actions_plan.append(USE)\n          _, _, _ = env.step(USE)\n          state = env._current_state\n\n  # ----------------------------------------------------------------------\n  # Move to the required workshop and craft the stick\n  # ----------------------------------------------------------------------\n  if workshop_idx is not None:\n      workshop_positions = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_positions.size == 0:\n          raise RuntimeError(\"Workshop for stick not found.\")\n      ws_pos = tuple(workshop_positions[0])\n      adj_ws, ws_needed_dir = adjacent_free(ws_pos)\n      if adj_ws is None:\n          raise RuntimeError(\"No free adjacent cell to workshop.\")\n      path = bfs(state.pos, adj_ws)\n      if path is None:\n          raise RuntimeError(\"Cannot reach workshop.\")\n      for act in path:\n          actions_plan.append(act)\n          _, _, _ = env.step(act)\n          state = env._current_state\n\n      # adjust facing as done for primitives\n      if ws_needed_dir is not None:\n          current_dir = path[-1] if path else state.dir\n          if current_dir != ws_needed_dir:\n              opp_dir = OPPOSITE[ws_needed_dir]\n              dx, dy = DELTA[opp_dir]\n              back_pos = (adj_ws[0] + dx, adj_ws[1] + dy)\n              if is_free(back_pos):\n                  actions_plan.append(opp_dir)\n                  _, _, _ = env.step(opp_dir)\n                  state = env._current_state\n                  actions_plan.append(ws_needed_dir)\n                  _, _, _ = env.step(ws_needed_dir)\n                  state = env._current_state\n              else:\n                  actions_plan.append(RIGHT)\n                  _, _, _ = env.step(RIGHT)\n                  state = env._current_state\n                  actions_plan.append(LEFT)\n                  _, _, _ = env.step(LEFT)\n                  state = env._current_state\n\n      # craft the stick\n      actions_plan.append(USE)\n      _, _, _ = env.step(USE)\n      state = env._current_state\n\n  return actions_plan", "env_interactions": 0, "island_id": 0, "scores": {"3": -1}}
