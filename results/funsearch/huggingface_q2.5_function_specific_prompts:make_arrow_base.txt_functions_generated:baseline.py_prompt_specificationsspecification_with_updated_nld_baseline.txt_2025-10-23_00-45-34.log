{"timestamp": "2025-10-23T03:55:23.039884", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  _ACTION_DELTAS = {\n      0: (1, 0),   # DOWN\n      1: (-1, 0),  # UP\n      2: (0, -1),  # LEFT\n      3: (0, 1),   # RIGHT\n  }\n\n  def _move_actions(start, goal):\n      \"\"\"Manhattan path from start (y,x) to goal (y,x) using orthogonal moves.\"\"\"\n      y, x = start\n      gy, gx = goal\n      actions = []\n      while y < gy:\n          actions.append(0)   # DOWN\n          y += 1\n      while y > gy:\n          actions.append(1)   # UP\n          y -= 1\n      while x < gx:\n          actions.append(3)   # RIGHT\n          x += 1\n      while x > gx:\n          actions.append(2)   # LEFT\n          x -= 1\n      return actions\n\n  # ------------------------------------------------------------------\n  # Locate the CraftWorld instance inside the provided env\n  # ------------------------------------------------------------------\n  if hasattr(env, \"world\"):\n      world = env.world\n  elif hasattr(env, \"scenario\"):\n      world = env.scenario.world\n  else:\n      raise AttributeError(\"Cannot locate CraftWorld instance in the supplied env.\")\n\n  # ------------------------------------------------------------------\n  # Goal information (stick)\n  # ------------------------------------------------------------------\n  goal_name = \"stick\"\n  goal_idx = world.cookbook.index.index(goal_name)\n\n  # Determine which primitive items are needed to craft a stick.\n  needed = world.cookbook.primitives_for(goal_idx)\n\n  # If there is no recipe, the stick itself is a primitive that must be collected.\n  collect_directly = False\n  if not needed:\n      needed = {goal_idx: 1}\n      collect_directly = True\n\n  # ------------------------------------------------------------------\n  # Obtain the current state (grid and agent position) for planning.\n  # ------------------------------------------------------------------\n  if hasattr(env, \"_current_state\"):\n      state = env._current_state\n  else:\n      state = env.scenario.init()\n  cur_pos = tuple(state.pos)          # (row, col)\n  grid = state.grid.copy()            # (H, W, n_kinds)\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Collect all required primitives (or the stick itself if primitive)\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(\n                  f\"Required primitive {world.cookbook.index.get(prim_idx)} not found on the grid.\"\n              )\n          py, px = prim_cells[0]\n\n          # Find an empty neighbour from which we can face the primitive.\n          target_cell = None\n          for d, (dy, dx) in _ACTION_DELTAS.items():\n              ny, nx = py - dy, px - dx\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  if not grid[ny, nx, :].any():\n                      target_cell = (ny, nx)\n                      break\n          if target_cell is None:\n              raise RuntimeError(\"No reachable empty neighbour around required primitive.\")\n\n          # Move to that neighbour.\n          actions.extend(_move_actions(cur_pos, target_cell))\n          cur_pos = target_cell\n\n          # Use (pick up / craft) the primitive.\n          actions.append(4)   # USE\n\n          # Update planning grid: primitive disappears after use.\n          grid[py, px, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # If a workshop is required (i.e., stick is not a direct primitive),\n  # move to it and USE to craft.\n  # ------------------------------------------------------------------\n  if not collect_directly:\n      recipe = world.cookbook.recipes.get(goal_idx, {})\n      workshop_name = recipe.get(\"_at\")\n      if workshop_name:\n          workshop_idx = world.cookbook.index.index(workshop_name)\n          ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n          if ws_cells.size == 0:\n              raise RuntimeError(f\"Workshop {workshop_name} not found on the grid.\")\n          wy, wx = ws_cells[0]\n\n          # Find an empty neighbour to face the workshop.\n          target_cell = None\n          for d, (dy, dx) in _ACTION_DELTAS.items():\n              ny, nx = wy - dy, wx - dx\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  if not grid[ny, nx, :].any():\n                      target_cell = (ny, nx)\n                      break\n          if target_cell is None:\n              raise RuntimeError(\"No reachable empty neighbour around workshop.\")\n\n          # Move there and craft.\n          actions.extend(_move_actions(cur_pos, target_cell))\n          cur_pos = target_cell\n          actions.append(4)   # USE\n\n  # ------------------------------------------------------------------\n  # Return the planned action sequence.\n  # ------------------------------------------------------------------\n  return actions", "env_interactions": 5, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:55:24.444082", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  _ACTION_DELTAS = {\n      0: (1, 0),   # DOWN\n      1: (-1, 0),  # UP\n      2: (0, -1),  # LEFT\n      3: (0, 1),   # RIGHT\n  }\n\n  def _move_actions(start, goal):\n      \"\"\"Manhattan path from start (row, col) to goal (row, col).\"\"\"\n      y, x = start\n      gy, gx = goal\n      actions = []\n      while y < gy:\n          actions.append(0)   # DOWN\n          y += 1\n      while y > gy:\n          actions.append(1)   # UP\n          y -= 1\n      while x < gx:\n          actions.append(3)   # RIGHT\n          x += 1\n      while x > gx:\n          actions.append(2)   # LEFT\n          x -= 1\n      return actions\n\n  # ------------------------------------------------------------------\n  # Locate the CraftWorld instance inside the provided env\n  # ------------------------------------------------------------------\n  if hasattr(env, \"world\"):\n      world = env.world\n  elif hasattr(env, \"scenario\"):\n      world = env.scenario.world\n  else:\n      raise AttributeError(\"Cannot locate CraftWorld instance in the supplied env.\")\n\n  # ------------------------------------------------------------------\n  # Goal information (stick)\n  # ------------------------------------------------------------------\n  goal_name = \"stick\"\n  goal_idx = world.cookbook.index.index(goal_name)\n\n  # Determine which primitive items are needed to craft a stick.\n  needed = world.cookbook.primitives_for(goal_idx)\n\n  # If there is no recipe, the stick itself is a primitive that must be collected.\n  collect_directly = False\n  if not needed:\n      needed = {goal_idx: 1}\n      collect_directly = True\n\n  # ------------------------------------------------------------------\n  # Obtain the current state (grid and agent position) for planning.\n  # ------------------------------------------------------------------\n  if hasattr(env, \"_current_state\"):\n      state = env._current_state\n  else:\n      state = env.scenario.init()\n  cur_pos = tuple(state.pos)          # (row, col)\n  grid = state.grid.copy()            # (H, W, n_kinds)\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Collect all required primitives (or the stick itself if primitive)\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(\n                  f\"Required primitive {world.cookbook.index.get(prim_idx)} not found on the grid.\"\n              )\n          py, px = prim_cells[0]\n\n          # Find an empty neighbour from which we can face the primitive.\n          target_cell = None\n          for d, (dy, dx) in _ACTION_DELTAS.items():\n              ny, nx = py - dy, px - dx\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  if not grid[ny, nx, :].any():\n                      target_cell = (ny, nx)\n                      break\n          if target_cell is None:\n              raise RuntimeError(\"No reachable empty neighbour around required primitive.\")\n\n          # Move to that neighbour.\n          actions.extend(_move_actions(cur_pos, target_cell))\n          cur_pos = target_cell\n\n          # Use (pick up / craft) the primitive.\n          actions.append(4)   # USE\n\n          # Update planning grid: primitive disappears after use.\n          grid[py, px, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # If a workshop is required (i.e., stick is not a direct primitive),\n  # move to it and USE to craft.\n  # ------------------------------------------------------------------\n  if not collect_directly:\n      recipe = world.cookbook.recipes.get(goal_idx, {})\n      workshop_name = recipe.get(\"_at\")\n      if workshop_name:\n          workshop_idx = world.cookbook.index.index(workshop_name)\n          ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n          if ws_cells.size == 0:\n              raise RuntimeError(f\"Workshop {workshop_name} not found on the grid.\")\n          wy, wx = ws_cells[0]\n\n          # Find an empty neighbour to face the workshop.\n          target_cell = None\n          for d, (dy, dx) in _ACTION_DELTAS.items():\n              ny, nx = wy - dy, wx - dx\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  if not grid[ny, nx, :].any():\n                      target_cell = (ny, nx)\n                      break\n          if target_cell is None:\n              raise RuntimeError(\"No reachable empty neighbour around workshop.\")\n\n          # Move there and craft.\n          actions.extend(_move_actions(cur_pos, target_cell))\n          cur_pos = target_cell\n          actions.append(4)   # USE\n\n  # ------------------------------------------------------------------\n  # Return the planned action sequence.\n  # ------------------------------------------------------------------\n  return actions", "env_interactions": 5, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:55:43.314230", "function_name": "make_arrow", "function_body": "  # Get action indices from the environment\n  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act.get(\"DOWN\", 0),\n      act.get(\"UP\", 1),\n      act.get(\"LEFT\", 2),\n      act.get(\"RIGHT\", 3),\n      act.get(\"USE\", 4),\n  )\n\n  # Snapshot of the current state (do not modify the real env)\n  state = env._current_state\n  grid = state.grid.copy()                 # (W, H, n_kinds)\n  cur_pos = tuple(state.pos)               # (x, y)\n\n  # Resolve the integer index for the item \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n      if stick_idx is None:\n          return []   # stick not defined in this world\n\n  # ----------------------------------------------------------------------\n  # Determine primitive requirements for a stick\n  # ----------------------------------------------------------------------\n  # primitives_for returns a dict mapping primitive kind indices to counts\n  primitive_req = env.world.cookbook.primitives_for(stick_idx)\n\n  # Filter only integer keys (actual primitive kinds)\n  primitive_needs = {k: v for k, v in primitive_req.items() if isinstance(k, int)}\n\n  # If there is no recipe (stick itself is primitive), we need to collect one\n  if not primitive_needs:\n      primitive_needs = {stick_idx: 1}\n\n  # Detect if a workshop is required (non\u2011int key in the raw recipe)\n  workshop_idx = None\n  raw_recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  for key, val in raw_recipe.items():\n      if not isinstance(key, int):\n          # Assume the value is the index of the workshop entity\n          workshop_idx = val if isinstance(val, int) else None\n          break\n\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # Helper: locate the nearest cell that still contains at least one of kind\n  # ----------------------------------------------------------------------\n  def find_closest(kind_idx, cur):\n      positions = np.argwhere(grid[:, :, kind_idx] > 0)\n      if positions.shape[0] == 0:\n          return None\n      dists = np.sum(np.abs(positions - np.array(cur)), axis=1)\n      nearest = positions[np.argmin(dists)]\n      return tuple(nearest.tolist())\n\n  # ----------------------------------------------------------------------\n  # Helper: generate a Manhattan path (greedy) from cur to target\n  # ----------------------------------------------------------------------\n  def path_to(cur, target):\n      x, y = cur\n      tx, ty = target\n      path = []\n      while (x, y) != (tx, ty):\n          if x < tx:\n              path.append(RIGHT)\n              x += 1\n          elif x > tx:\n              path.append(LEFT)\n              x -= 1\n          elif y < ty:\n              path.append(DOWN)\n              y += 1\n          elif y > ty:\n              path.append(UP)\n              y -= 1\n      return path, (x, y)\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive the needed number of times\n  # ----------------------------------------------------------------------\n  for kind_idx, needed in primitive_needs.items():\n      while needed > 0:\n          target = find_closest(kind_idx, cur_pos)\n          if target is None:\n              # Primitive not available any more \u2013 abort planning\n              return actions\n          move_actions, cur_pos = path_to(cur_pos, target)\n          actions.extend(move_actions)\n          actions.append(USE)   # pick up the primitive\n\n          # Update our local copy of the grid\n          grid[target[0], target[1], kind_idx] = max(\n              0, grid[target[0], target[1], kind_idx] - 1\n          )\n          needed -= 1\n\n  # ----------------------------------------------------------------------\n  # If a workshop is needed, move there and craft the stick\n  # ----------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_target = find_closest(workshop_idx, cur_pos)\n      if ws_target is not None:\n          move_actions, cur_pos = path_to(cur_pos, ws_target)\n          actions.extend(move_actions)\n          actions.append(USE)   # craft stick at the workshop\n\n  return actions", "env_interactions": 2, "island_id": 2, "scores": {"3": 0.0}}
