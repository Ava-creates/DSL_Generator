{"timestamp": "2025-10-23T00:51:43.815237", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ----------------------------------------------------------------------\n  # Helper: shortest path (Manhattan) respecting non\u2011traversable entities.\n  # ----------------------------------------------------------------------\n  def bfs_path(start, goal, grid, blocked_kinds):\n      \"\"\"Return a list of movement actions (0\u20114) from start to goal.\"\"\"\n      H, W = grid.shape[:2]\n      # directions: (dx, dy, action_index)\n      dirs = [(1, 0, 0),   # DOWN\n              (-1, 0, 1),  # UP\n              (0, -1, 2),  # LEFT\n              (0, 1, 3)]   # RIGHT\n\n      def traversable(x, y):\n          # cell is free if none of the blocked kinds are present\n          for k in blocked_kinds:\n              if grid[x, y, k] > 0:\n                  return False\n          return True\n\n      q = deque()\n      q.append(start)\n      visited = np.full((H, W), False, dtype=bool)\n      visited[start] = True\n      prev = dict()          # (x, y) -> (prev_x, prev_y, action)\n\n      while q:\n          cx, cy = q.popleft()\n          if (cx, cy) == goal:\n              # reconstruct actions\n              actions_rev = []\n              while (cx, cy) != start:\n                  px, py, act = prev[(cx, cy)]\n                  actions_rev.append(act)\n                  cx, cy = px, py\n              actions_rev.reverse()\n              return actions_rev\n          for dx, dy, act in dirs:\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < H and 0 <= ny < W and not visited[nx, ny] and traversable(nx, ny):\n                  visited[nx, ny] = True\n                  prev[(nx, ny)] = (cx, cy, act)\n                  q.append((nx, ny))\n      # No path found \u2013 return empty list (caller may raise)\n      return []\n\n  # ----------------------------------------------------------------------\n  # Retrieve indices for the goal (\u201cstick\u201d) and its recipe information.\n  # ----------------------------------------------------------------------\n  world = env.world\n  cookbook = world.cookbook\n  stick_idx = cookbook.index[\"stick\"]                       # goal index\n  recipe = cookbook.recipes.get(stick_idx, {})\n\n  # ----------------------------------------------------------------------\n  # Determine which primitives are required and how many of each.\n  # ----------------------------------------------------------------------\n  primitives_needed = cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n  # If the goal itself is primitive, nothing to craft \u2013 just collect.\n  if not primitives_needed:\n      primitives_needed = {stick_idx: 1}\n\n  # ----------------------------------------------------------------------\n  # Find the workshop where the stick must be crafted.\n  # ----------------------------------------------------------------------\n  workshop_kind = None\n  for key, val in recipe.items():\n      if key == \"_at\":          # special key naming the workshop\n          workshop_kind = val\n          break\n  # If no explicit workshop is specified we will just try to USE where we are.\n  # ----------------------------------------------------------------------\n  # Prepare a mutable copy of the grid to simulate pickups/crafting.\n  # ----------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()\n  pos = tuple(state.pos)          # (x, y)\n\n  # ----------------------------------------------------------------------\n  # Accumulate actions.\n  # ----------------------------------------------------------------------\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # Helper to locate the nearest cell containing a given kind.\n  # ----------------------------------------------------------------------\n  def nearest_position(kind):\n      locations = np.argwhere(grid[:, :, kind] > 0)\n      if locations.size == 0:\n          raise ValueError(f\"No instances of kind {kind} found on the map.\")\n      # Manhattan distance from current position\n      dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n      nearest = locations[dists.argmin()]\n      return tuple(nearest)\n\n  # ----------------------------------------------------------------------\n  # Collect all required primitives.\n  # ----------------------------------------------------------------------\n  for prim_kind, count in primitives_needed.items():\n      for _ in range(count):\n          target = nearest_position(prim_kind)\n          actions += bfs_path(pos, target, grid, world.non_grabbable_indices)\n          # USE to pick up the primitive\n          actions.append(4)                     # USE action\n          # Simulate the pickup: remove from grid, add to inventory\n          grid[target[0], target[1], prim_kind] = 0\n          pos = target                           # agent now stands on the primitive\n\n  # ----------------------------------------------------------------------\n  # If a workshop is needed, move there and craft.\n  # ----------------------------------------------------------------------\n  if workshop_kind is not None:\n      workshop_pos = nearest_position(workshop_kind)\n      actions += bfs_path(pos, workshop_pos, grid, world.non_grabbable_indices)\n      actions.append(4)                         # USE to craft at workshop\n      pos = workshop_pos\n\n  # ----------------------------------------------------------------------\n  # Return the complete action list.\n  # ----------------------------------------------------------------------\n  return actions", "env_interactions": 0, "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-10-23T00:51:45.103706", "function_name": "make_arrow", "function_body": "  # Get the current state and world information\n  state = env._current_state\n  world = env.world\n\n  # Action indices\n  act = env.action_specs()\n  DOWN = act[\"DOWN\"]\n  UP = act[\"UP\"]\n  LEFT = act[\"LEFT\"]\n  RIGHT = act[\"RIGHT\"]\n  USE = act[\"USE\"]\n\n  # Index of the primitive \"stick\"\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # Locate a cell that contains a stick (if any)\n  stick_cells = list(zip(*np.where(state.grid[:, :, stick_idx] > 0)))\n  if not stick_cells:\n      # No stick present in the world \u2013 nothing to do\n      return []\n\n  # Choose the first stick cell (could be improved to nearest)\n  target = stick_cells[0]\n  cur_x, cur_y = state.pos\n\n  actions = []\n\n  # Simple Manhattan moves ignoring obstacles\n  dx = target[0] - cur_x\n  dy = target[1] - cur_y\n\n  # Move in the x\u2011direction\n  if dx > 0:\n      actions += [DOWN] * dx\n  elif dx < 0:\n      actions += [UP] * (-dx)\n\n  # Move in the y\u2011direction\n  if dy > 0:\n      actions += [RIGHT] * dy\n  elif dy < 0:\n      actions += [LEFT] * (-dy)\n\n  # Finally, use the cell to pick up the stick\n  actions.append(USE)\n\n  return actions", "env_interactions": 0, "island_id": 5, "scores": {"3": 0.0}}
