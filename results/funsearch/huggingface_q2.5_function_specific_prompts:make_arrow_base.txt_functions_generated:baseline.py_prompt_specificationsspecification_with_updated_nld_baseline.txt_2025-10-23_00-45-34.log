{"timestamp": "2025-10-23T02:43:29.760833", "function_name": "make_arrow", "function_body": "  # Get current state and world references\n  state = env._current_state\n  world = env.world\n\n  # Action indices\n  act = env.action_specs()\n  DOWN = act[\"DOWN\"]\n  UP = act[\"UP\"]\n  LEFT = act[\"LEFT\"]\n  RIGHT = act[\"RIGHT\"]\n  USE = act[\"USE\"]\n\n  # Index of the primitive \"stick\"\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # Locate all stick cells on the grid\n  stick_cells = np.argwhere(state.grid[:, :, stick_idx] > 0)\n  if stick_cells.size == 0:\n      # No sticks present in the world\n      return []\n\n  W, H, _ = state.grid.shape\n  start = tuple(state.pos)\n\n  # Cells occupied by any entity (blocked for movement)\n  blocked = np.any(state.grid > 0, axis=2)\n\n  from collections import deque\n\n  def bfs(target):\n      \"\"\"Return a list of actions to reach `target` cell, or None if unreachable.\"\"\"\n      q = deque([start])\n      visited = np.full((W, H), False, dtype=bool)\n      visited[start[0], start[1]] = True\n      prev = np.empty((W, H, 2), dtype=int)\n\n      while q:\n          x, y = q.popleft()\n          if (x, y) == tuple(target):\n              # Reconstruct path\n              actions = []\n              cx, cy = x, y\n              while (cx, cy) != start:\n                  px, py = prev[cx, cy]\n                  dx, dy = cx - px, cy - py\n                  if dx == 1:\n                      actions.append(DOWN)\n                  elif dx == -1:\n                      actions.append(UP)\n                  elif dy == 1:\n                      actions.append(RIGHT)\n                  elif dy == -1:\n                      actions.append(LEFT)\n                  cx, cy = px, py\n              actions.reverse()\n              return actions\n\n          # Explore neighbours\n          for nx, ny, a in [(x + 1, y, DOWN), (x - 1, y, UP),\n                            (x, y + 1, RIGHT), (x, y - 1, LEFT)]:\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  # Allow stepping onto the target even if it is blocked (contains the stick)\n                  if (nx, ny) == tuple(target) or not blocked[nx, ny]:\n                      visited[nx, ny] = True\n                      prev[nx, ny] = (x, y)\n                      q.append((nx, ny))\n      return None\n\n  # Find the shortest reachable stick\n  best_path = None\n  for cell in stick_cells:\n      path = bfs(cell)\n      if path is not None and (best_path is None or len(path) < len(best_path)):\n          best_path = path\n\n  if best_path is None:\n      # No reachable stick found\n      return []\n\n  # Append USE to pick up the stick\n  best_path.append(USE)\n  return best_path", "env_interactions": 0, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:43:31.073689", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n\n  # Action indices\n  act = env.action_specs()\n  DOWN = act[\"DOWN\"]\n  UP = act[\"UP\"]\n  LEFT = act[\"LEFT\"]\n  RIGHT = act[\"RIGHT\"]\n  USE = act[\"USE\"]\n\n  # Index of the primitive \"stick\"\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # Find all cells that contain a stick\n  stick_cells = np.argwhere(state.grid[:, :, stick_idx] > 0)\n  if stick_cells.size == 0:\n      # No sticks available in this scenario\n      return []\n\n  W, H, _ = state.grid.shape\n  start = tuple(state.pos)\n\n  # Cells occupied by any entity (blocked for movement)\n  blocked = np.any(state.grid > 0, axis=2)\n\n  from collections import deque\n\n  def bfs(target):\n      \"\"\"Return a list of actions to reach `target` cell, or None if unreachable.\"\"\"\n      q = deque([start])\n      visited = np.full((W, H), False, dtype=bool)\n      visited[start[0], start[1]] = True\n      prev = np.empty((W, H, 2), dtype=int)\n\n      while q:\n          x, y = q.popleft()\n          if (x, y) == tuple(target):\n              # Reconstruct path\n              actions = []\n              cx, cy = x, y\n              while (cx, cy) != start:\n                  px, py = prev[cx, cy]\n                  dx, dy = cx - px, cy - py\n                  if dx == 1:\n                      actions.append(DOWN)\n                  elif dx == -1:\n                      actions.append(UP)\n                  elif dy == 1:\n                      actions.append(RIGHT)\n                  elif dy == -1:\n                      actions.append(LEFT)\n                  cx, cy = px, py\n              actions.reverse()\n              return actions\n\n          for nx, ny, a in [(x + 1, y, DOWN), (x - 1, y, UP),\n                            (x, y + 1, RIGHT), (x, y - 1, LEFT)]:\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  # Allow stepping onto the target even if it is blocked (contains the stick)\n                  if (nx, ny) == tuple(target) or not blocked[nx, ny]:\n                      visited[nx, ny] = True\n                      prev[nx, ny] = (x, y)\n                      q.append((nx, ny))\n      return None\n\n  # Find the shortest reachable stick\n  best_path = None\n  for cell in stick_cells:\n      path = bfs(cell)\n      if path is not None and (best_path is None or len(path) < len(best_path)):\n          best_path = path\n\n  if best_path is None:\n      # No reachable stick found\n      return []\n\n  # Append USE to pick up the stick\n  best_path.append(USE)\n  return best_path", "env_interactions": 0, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:43:54.244330", "function_name": "make_arrow", "function_body": "  # --------------------------------------------------------------\n  # Common utilities for all versions\n  # --------------------------------------------------------------\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  def manhattan_path(start, goal):\n      \"\"\"Horizontal\u2011then\u2011vertical moves (ignores obstacles).\"\"\"\n      x, y = start\n      gx, gy = goal\n      actions = []\n      while x < gx:\n          actions.append(ACTION_RIGHT)\n          x += 1\n      while x > gx:\n          actions.append(ACTION_LEFT)\n          x -= 1\n      while y < gy:\n          actions.append(ACTION_DOWN)\n          y += 1\n      while y > gy:\n          actions.append(ACTION_UP)\n          y -= 1\n      return actions\n\n  def nearest_position(positions, reference):\n      \"\"\"Return position with smallest Manhattan distance to reference.\"\"\"\n      if len(positions) == 0:\n          return None\n      ref = np.array(reference)\n      dists = np.sum(np.abs(positions - ref), axis=1)\n      return tuple(positions[np.argmin(dists)])\n\n  # --------------------------------------------------------------\n  # Version 0 : straightforward planner\n  # --------------------------------------------------------------\n  # Gather current state\n  state = env._current_state\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n\n  # Identify stick index\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      return []  # stick not defined\n\n  # Already have a stick?\n  if inventory[stick_idx] > 0:\n      return []\n\n  actions_v0 = []\n\n  # 1) Collect required primitives for a stick\n  primitives_needed = env.world.cookbook.primitives_for(stick_idx)  # {kind_idx: count}\n  for prim_idx, needed_cnt in primitives_needed.items():\n      while inventory[prim_idx] < needed_cnt:\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              return actions_v0  # cannot find required primitive\n          target = nearest_position(prim_cells, pos)\n\n          # Move and pick up\n          actions_v0.extend(manhattan_path(pos, target))\n          pos = target\n          actions_v0.append(ACTION_USE)\n\n          # Simulate local pickup\n          inventory[prim_idx] += 1\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # 2) If stick is a primitive (no recipe), just pick it up\n  if stick_idx not in env.world.cookbook.recipes:\n      stick_cells = np.argwhere(grid[:, :, stick_idx] > 0)\n      if stick_cells.size == 0:\n          return actions_v0\n      target = nearest_position(stick_cells, pos)\n      actions_v0.extend(manhattan_path(pos, target))\n      pos = target\n      actions_v0.append(ACTION_USE)\n      return actions_v0\n\n  # 3) Go to workshop and craft the stick\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      try:\n          workshop_idx = env.world.cookbook.index[workshop_name]\n      except Exception:\n          return actions_v0\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          return actions_v0\n      wcell = tuple(workshop_cells[0])\n\n      # Find a free adjacent cell\n      neighbours = [\n          (wcell[0] + dx, wcell[1] + dy)\n          for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]\n      ]\n      stand_pos = None\n      for nx, ny in neighbours:\n          if (\n              0 <= nx < grid.shape[0]\n              and 0 <= ny < grid.shape[1]\n              and grid[nx, ny, :].sum() == 0\n          ):\n              stand_pos = (nx, ny)\n              break\n      if stand_pos is None:\n          stand_pos = wcell  # fallback\n\n      actions_v0.extend(manhattan_path(pos, stand_pos))\n      pos = stand_pos\n      actions_v0.append(ACTION_USE)\n\n  # Return the constructed plan for version 0\n  return actions_v0\n\n  # --------------------------------------------------------------\n  # Version 1 : reuse version\u20110 planner (simple wrapper)\n  # --------------------------------------------------------------\n  return make_stick_v0(env)\n\n  # --------------------------------------------------------------\n  # Version 2 : also reuse version\u20110 (placeholder for future improvements)\n  # --------------------------------------------------------------\n  return make_stick_v0(env)", "env_interactions": 5, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:43:55.543504", "function_name": "make_arrow", "function_body": "  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions from start to goal using\n      horizontal\u2011then\u2011vertical moves (ignores obstacles).\"\"\"\n      x, y = start\n      gx, gy = goal\n      actions = []\n      while x < gx:\n          actions.append(ACTION_RIGHT)\n          x += 1\n      while x > gx:\n          actions.append(ACTION_LEFT)\n          x -= 1\n      while y < gy:\n          actions.append(ACTION_DOWN)\n          y += 1\n      while y > gy:\n          actions.append(ACTION_UP)\n          y -= 1\n      return actions\n\n  def nearest_position(positions, reference):\n      \"\"\"Pick the position from *positions* with smallest Manhattan distance\n      to *reference*.\"\"\"\n      if len(positions) == 0:\n          return None\n      ref = np.array(reference)\n      dists = np.sum(np.abs(positions - ref), axis=1)\n      return tuple(positions[np.argmin(dists)])\n\n  # ------------------------------------------------------------------\n  # Gather current state information\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n\n  # ------------------------------------------------------------------\n  # Identify the goal (stick)\n  # ------------------------------------------------------------------\n  goal_name = \"stick\"\n  try:\n      goal_idx = env.world.cookbook.index[goal_name]\n  except Exception:\n      # Stick not defined in this world\n      return []\n\n  # If we already have a stick, nothing to do\n  if inventory[goal_idx] > 0:\n      return []\n\n  plan_actions = []\n\n  # ------------------------------------------------------------------\n  # 1) Collect required primitive resources (if any)\n  # ------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  for prim_idx, needed_cnt in primitives_needed.items():\n      while inventory[prim_idx] < needed_cnt:\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # No more of this primitive on the map \u2013 abort planning\n              return plan_actions\n          target = nearest_position(prim_cells, pos)\n\n          # Move to the primitive\n          plan_actions.extend(manhattan_path(pos, target))\n          pos = target\n\n          # Pick it up\n          plan_actions.append(ACTION_USE)\n\n          # Simulate pickup locally\n          inventory[prim_idx] += 1\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # ------------------------------------------------------------------\n  # 2) If stick is a primitive (no recipe), just pick it up\n  # ------------------------------------------------------------------\n  if goal_idx not in env.world.cookbook.recipes:\n      stick_cells = np.argwhere(grid[:, :, goal_idx] > 0)\n      if stick_cells.size == 0:\n          return plan_actions\n      target = nearest_position(stick_cells, pos)\n      plan_actions.extend(manhattan_path(pos, target))\n      pos = target\n      plan_actions.append(ACTION_USE)\n      return plan_actions\n\n  # ------------------------------------------------------------------\n  # 3) Go to the required workshop and craft the stick\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      try:\n          workshop_idx = env.world.cookbook.index[workshop_name]\n      except Exception:\n          return plan_actions\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          return plan_actions\n      wcell = tuple(workshop_cells[0])\n\n      # Find a free adjacent cell to stand on\n      neighbours = [\n          (wcell[0] + dx, wcell[1] + dy)\n          for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]\n      ]\n      stand_pos = None\n      for nx, ny in neighbours:\n          if (\n              0 <= nx < grid.shape[0]\n              and 0 <= ny < grid.shape[1]\n              and grid[nx, ny, :].sum() == 0\n          ):\n              stand_pos = (nx, ny)\n              break\n      if stand_pos is None:\n          stand_pos = wcell  # fallback: stand directly on the workshop\n\n      # Move to the chosen standing position\n      plan_actions.extend(manhattan_path(pos, stand_pos))\n      pos = stand_pos\n\n      # Use the workshop to craft the stick\n      plan_actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # Return the constructed action list\n  # ------------------------------------------------------------------\n  return plan_actions", "env_interactions": 5, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:44:21.808700", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  grid = state.grid\n  width, height = grid.shape[:2]\n\n  # direction vectors and mapping to action indices (DOWN=0, UP=1, LEFT=2, RIGHT=3)\n  dirs = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n  dir_action = {(0, 1): 0, (0, -1): 1, (-1, 0): 2, (1, 0): 3}\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # helper utilities\n  # ------------------------------------------------------------------\n  def find_cells(kind):\n      \"\"\"Return list of (x, y) positions where the grid contains the given kind.\"\"\"\n      xs, ys = np.where(grid[:, :, kind] > 0)\n      return list(zip(xs.tolist(), ys.tolist()))\n\n  from collections import deque\n\n  def bfs(start, goal):\n      \"\"\"Return list of (dx, dy) moves from start to goal on free cells.\"\"\"\n      q = deque([start])\n      visited = {start}\n      prev = {}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          x, y = cur\n          for dx, dy in dirs:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height:\n                  if (nx, ny) not in visited and not grid[nx, ny].any():\n                      visited.add((nx, ny))\n                      prev[(nx, ny)] = (cur, (dx, dy))\n                      q.append((nx, ny))\n      if start == goal:\n          return []\n      if goal not in prev:\n          return []  # no path found\n      # reconstruct path\n      path = []\n      cur = goal\n      while cur != start:\n          pnode, move = prev[cur]\n          path.append(move)\n          cur = pnode\n      path.reverse()\n      return path\n\n  # ------------------------------------------------------------------\n  # identify stick recipe\n  # ------------------------------------------------------------------\n  stick_idx = env.world.cookbook.index[\"stick\"]\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  primitive_needs = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  # ------------------------------------------------------------------\n  # collect required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          prim_cells = find_cells(prim_idx)\n          if not prim_cells:\n              continue  # primitive not present in this scenario\n          tx, ty = prim_cells[0]\n\n          # try to stand on a free neighbour opposite the direction we will face\n          neighbour_found = False\n          for dx, dy in dirs:\n              nx, ny = tx - dx, ty - dy\n              if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  # face the primitive\n                  actions.append(dir_action[(-dx, -dy)])\n                  state.dir = dir_action[(-dx, -dy)]\n                  # pick up\n                  actions.append(4)  # USE\n                  neighbour_found = True\n                  # remove primitive from grid so future paths see it as empty\n                  grid[tx, ty, prim_idx] = 0\n                  break\n          if not neighbour_found:\n              # fallback: any adjacent free cell\n              for dx, dy in dirs:\n                  nx, ny = tx + dx, ty + dy\n                  if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                      path = bfs(state.pos, (nx, ny))\n                      for mv in path:\n                          actions.append(dir_action[mv])\n                          state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                          state.dir = dir_action[mv]\n                      actions.append(dir_action[(-dx, -dy)])  # face primitive\n                      state.dir = dir_action[(-dx, -dy)]\n                      actions.append(4)  # USE\n                      grid[tx, ty, prim_idx] = 0\n                      break\n\n  # ------------------------------------------------------------------\n  # craft at required workshop (if any)\n  # ------------------------------------------------------------------\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      workshop_cells = find_cells(workshop_idx)\n      if workshop_cells:\n          wx, wy = workshop_cells[0]\n          for dx, dy in dirs:\n              nx, ny = wx - dx, wy - dy\n              if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  actions.append(4)  # USE to craft\n                  break\n\n  return actions", "env_interactions": 4, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:44:23.144961", "function_name": "make_arrow", "function_body": "  # ------------------------------------------------------------------\n  # reset environment and gather basic info\n  # ------------------------------------------------------------------\n  env.reset()\n  state = env._current_state\n  grid = state.grid\n  width, height = grid.shape[:2]\n\n  # movement vectors and mapping to action indices (DOWN=0, UP=1, LEFT=2, RIGHT=3)\n  dirs = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n  dir_action = {(0, 1): 0, (0, -1): 1, (-1, 0): 2, (1, 0): 3}\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # helper utilities\n  # ------------------------------------------------------------------\n  def find_cells(kind):\n      \"\"\"Return list of (x, y) positions where the grid contains the given kind.\"\"\"\n      xs, ys = np.where(grid[:, :, kind] > 0)\n      return list(zip(xs.tolist(), ys.tolist()))\n\n  from collections import deque\n\n  def bfs(start, goal):\n      \"\"\"Return list of (dx, dy) moves from start to goal on free cells.\"\"\"\n      q = deque([start])\n      visited = {start}\n      prev = {}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          x, y = cur\n          for dx, dy in dirs:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height:\n                  if (nx, ny) not in visited and not grid[nx, ny].any():\n                      visited.add((nx, ny))\n                      prev[(nx, ny)] = (cur, (dx, dy))\n                      q.append((nx, ny))\n      if start == goal:\n          return []\n      if goal not in prev:\n          return []  # no path found\n      # reconstruct path\n      path = []\n      cur = goal\n      while cur != start:\n          pnode, move = prev[cur]\n          path.append(move)\n          cur = pnode\n      path.reverse()\n      return path\n\n  # ------------------------------------------------------------------\n  # identify stick recipe\n  # ------------------------------------------------------------------\n  stick_idx = env.world.cookbook.index[\"stick\"]\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  primitive_needs = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  # ------------------------------------------------------------------\n  # collect required primitives (if any)\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          prim_cells = find_cells(prim_idx)\n          if not prim_cells:\n              continue\n          tx, ty = prim_cells[0]\n\n          # try to stand on a free neighbour opposite the direction we will face\n          neighbour_found = False\n          for dx, dy in dirs:\n              nx, ny = tx - dx, ty - dy\n              if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  actions.append(dir_action[(-dx, -dy)])  # face primitive\n                  state.dir = dir_action[(-dx, -dy)]\n                  actions.append(4)  # USE\n                  neighbour_found = True\n                  break\n          if not neighbour_found:\n              # fallback: any adjacent free cell\n              for dx, dy in dirs:\n                  nx, ny = tx + dx, ty + dy\n                  if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                      path = bfs(state.pos, (nx, ny))\n                      for mv in path:\n                          actions.append(dir_action[mv])\n                          state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                          state.dir = dir_action[mv]\n                      actions.append(dir_action[(-dx, -dy)])  # face primitive\n                      state.dir = dir_action[(-dx, -dy)]\n                      actions.append(4)  # USE\n                      break\n\n  # ------------------------------------------------------------------\n  # if stick itself is a primitive (no recipe), just collect one stick\n  # ------------------------------------------------------------------\n  if not primitive_needs:\n      stick_cells = find_cells(stick_idx)\n      if stick_cells:\n          tx, ty = stick_cells[0]\n          neighbour_found = False\n          for dx, dy in dirs:\n              nx, ny = tx - dx, ty - dy\n              if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  actions.append(dir_action[(-dx, -dy)])  # face stick\n                  state.dir = dir_action[(-dx, -dy)]\n                  actions.append(4)  # USE\n                  neighbour_found = True\n                  break\n          if not neighbour_found:\n              for dx, dy in dirs:\n                  nx, ny = tx + dx, ty + dy\n                  if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                      path = bfs(state.pos, (nx, ny))\n                      for mv in path:\n                          actions.append(dir_action[mv])\n                          state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                          state.dir = dir_action[mv]\n                      actions.append(dir_action[(-dx, -dy)])\n                      state.dir = dir_action[(-dx, -dy)]\n                      actions.append(4)\n                      break\n\n  # ------------------------------------------------------------------\n  # craft at required workshop (if any)\n  # ------------------------------------------------------------------\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      workshop_cells = find_cells(workshop_idx)\n      if workshop_cells:\n          wx, wy = workshop_cells[0]\n          for dx, dy in dirs:\n              nx, ny = wx - dx, wy - dy\n              if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  actions.append(4)  # USE to craft\n                  break\n\n  return actions", "env_interactions": 8, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-23T02:44:48.466734", "function_name": "make_arrow", "function_body": "", "env_interactions": 0, "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-10-23T02:44:49.879431", "function_name": "make_arrow", "function_body": "  # Get action indices\n  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act.get(\"DOWN\", 0),\n      act.get(\"UP\", 1),\n      act.get(\"LEFT\", 2),\n      act.get(\"RIGHT\", 3),\n      act.get(\"USE\", 4),\n  )\n\n  # Snapshot of current state (do not modify the env)\n  state = env._current_state\n  grid = state.grid.copy()                 # (W, H, n_kinds)\n  cur_pos = tuple(state.pos)               # (x, y)\n\n  # Index of the goal item \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n      if stick_idx is None:\n          return []   # stick not defined in the world\n\n  # Determine primitive requirements for a stick\n  recipe = env.world.cookbook.primitives_for(stick_idx)   # dict {kind_idx: count}\n  primitive_needs = {k: v for k, v in recipe.items() if isinstance(k, int)}\n\n  # If the stick itself is a primitive (no recipe), we need to collect one stick\n  if not primitive_needs:\n      primitive_needs = {stick_idx: 1}\n\n  # Detect workshop requirement (non\u2011int key in recipe)\n  workshop_idx = None\n  for k, v in recipe.items():\n      if not isinstance(k, int):\n          workshop_idx = v if isinstance(v, int) else None\n          break\n\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # Helper: find the closest cell that still has at least one of the given kind\n  # ----------------------------------------------------------------------\n  def find_closest(kind_idx, cur):\n      positions = np.argwhere(grid[:, :, kind_idx] > 0)\n      if positions.shape[0] == 0:\n          return None\n      dists = np.sum(np.abs(positions - np.array(cur)), axis=1)\n      nearest = positions[np.argmin(dists)]\n      return tuple(nearest.tolist())\n\n  # ----------------------------------------------------------------------\n  # Helper: generate a simple Manhattan path (greedy) from cur to target\n  # ----------------------------------------------------------------------\n  def path_to(cur, target):\n      x, y = cur\n      tx, ty = target\n      path = []\n      while (x, y) != (tx, ty):\n          if x < tx:\n              path.append(RIGHT)\n              x += 1\n          elif x > tx:\n              path.append(LEFT)\n              x -= 1\n          elif y < ty:\n              path.append(DOWN)\n              y += 1\n          elif y > ty:\n              path.append(UP)\n              y -= 1\n      return path, (x, y)\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive the needed number of times\n  # ----------------------------------------------------------------------\n  for kind_idx, needed in primitive_needs.items():\n      while needed > 0:\n          target = find_closest(kind_idx, cur_pos)\n          if target is None:\n              # No more of this primitive on the map \u2013 abort planning\n              return actions\n          move_actions, cur_pos = path_to(cur_pos, target)\n          actions.extend(move_actions)\n          actions.append(USE)   # pick up / use the primitive\n\n          # Update local grid copy to reflect the collection\n          grid[target[0], target[1], kind_idx] = max(\n              0, grid[target[0], target[1], kind_idx] - 1\n          )\n          needed -= 1\n\n  # ----------------------------------------------------------------------\n  # If a workshop is required, move to it and craft the stick\n  # ----------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_target = find_closest(workshop_idx, cur_pos)\n      if ws_target is not None:\n          move_actions, cur_pos = path_to(cur_pos, ws_target)\n          actions.extend(move_actions)\n          actions.append(USE)   # craft stick at the workshop\n\n  return actions", "env_interactions": 2, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:45:09.366997", "function_name": "make_arrow", "function_body": "  # Reset environment and fetch initial state\n  env.reset()\n  state = env._current_state\n  goal_idx = env.task.goal\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # -----------------------------------------------------------------\n  # Helper utilities\n  # -----------------------------------------------------------------\n  def find_positions(kind):\n      \"\"\"Return list of (x, y) where the grid contains at least one of `kind`.\"\"\"\n      locs = np.argwhere(state.grid[:, :, kind] > 0)\n      return [tuple(p) for p in locs]\n\n  def nearest(pos, kind):\n      \"\"\"Find the nearest position of a given kind using Manhattan distance.\"\"\"\n      positions = find_positions(kind)\n      if not positions:\n          return None\n      return min(positions, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n\n  def moves_to(src, dst):\n      \"\"\"Generate a sequence of movement actions (DOWN,UP,LEFT,RIGHT) from src to dst.\"\"\"\n      sx, sy = src\n      dx, dy = dst\n      seq = []\n      while sx < dx:\n          seq.append(0)   # DOWN\n          sx += 1\n      while sx > dx:\n          seq.append(1)   # UP\n          sx -= 1\n      while sy < dy:\n          seq.append(3)   # RIGHT\n          sy += 1\n      while sy > dy:\n          seq.append(2)   # LEFT\n          sy -= 1\n      return seq\n\n  # -----------------------------------------------------------------\n  # 1) If the goal is a primitive (no recipe), just go pick it up.\n  # -----------------------------------------------------------------\n  if not env.world.cookbook.primitives_for(goal_idx):\n      target = nearest(cur_pos, goal_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)   # USE\n      return actions\n\n  # -----------------------------------------------------------------\n  # 2) Collect all required primitive ingredients.\n  # -----------------------------------------------------------------\n  needed_prims = env.world.cookbook.primitives_for(goal_idx)\n  for prim_idx, count in needed_prims.items():\n      for _ in range(count):\n          target = nearest(cur_pos, prim_idx)\n          if target is None:\n              # No reachable primitive; abort collection for this item.\n              continue\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n          actions.append(4)   # USE to collect\n\n  # -----------------------------------------------------------------\n  # 3) Move to the appropriate workshop (if any) and craft the item.\n  # -----------------------------------------------------------------\n  workshop_idx = None\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  if \"_at\" in recipe:\n      workshop_idx = recipe[\"_at\"]\n\n  if workshop_idx is not None:\n      target = nearest(cur_pos, workshop_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)   # USE to craft at the workshop\n\n  return actions", "env_interactions": 1, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:45:10.698669", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  goal_idx = env.task.goal\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # -----------------------------------------------------------------\n  # Helper utilities\n  # -----------------------------------------------------------------\n  def find_positions(kind):\n      \"\"\"Return list of (x, y) where grid has at least one of kind.\"\"\"\n      locs = np.argwhere(state.grid[:, :, kind] > 0)\n      return [tuple(p) for p in locs]\n\n  def nearest(pos, kind):\n      \"\"\"Nearest position of given kind by Manhattan distance.\"\"\"\n      positions = find_positions(kind)\n      if not positions:\n          return None\n      return min(positions, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n\n  def moves_to(src, dst):\n      \"\"\"Sequence of movement actions from src to dst.\"\"\"\n      sx, sy = src\n      dx, dy = dst\n      seq = []\n      while sx < dx:\n          seq.append(0)   # DOWN\n          sx += 1\n      while sx > dx:\n          seq.append(1)   # UP\n          sx -= 1\n      while sy < dy:\n          seq.append(3)   # RIGHT\n          sy += 1\n      while sy > dy:\n          seq.append(2)   # LEFT\n          sy -= 1\n      return seq\n\n  # -----------------------------------------------------------------\n  # 1) If stick is a primitive (no recipe), just collect it.\n  # -----------------------------------------------------------------\n  if not env.world.cookbook.primitives_for(goal_idx):\n      target = nearest(cur_pos, goal_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)   # USE to pick up\n      return actions\n\n  # -----------------------------------------------------------------\n  # 2) Collect required primitive ingredients.\n  # -----------------------------------------------------------------\n  needed_prims = env.world.cookbook.primitives_for(goal_idx)\n  for prim_idx, count in needed_prims.items():\n      for _ in range(count):\n          target = nearest(cur_pos, prim_idx)\n          if target is None:\n              continue\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n          actions.append(4)   # USE to collect\n\n  # -----------------------------------------------------------------\n  # 3) Move to appropriate workshop (if any) and craft the stick.\n  # -----------------------------------------------------------------\n  workshop_idx = None\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  for key, val in recipe.items():\n      if isinstance(key, str):\n          workshop_idx = val\n          break\n\n  if workshop_idx is not None:\n      target = nearest(cur_pos, workshop_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)   # USE to craft\n\n  return actions", "env_interactions": 1, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:45:28.848438", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n\n  # Action mapping\n  act_map = env.action_specs()\n  USE = act_map[\"USE\"]\n\n  # Index for the target item \"stick\"\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # Primitive requirements for a stick (empty dict if already primitive)\n  prim_req = world.cookbook.primitives_for(stick_idx)\n\n  # Copy of the grid to modify during planning\n  grid = state.grid.copy()\n\n  # Build mask of blocked cells (non\u2011grabbable entities)\n  blocked = np.zeros(grid.shape[:2], dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # ------------------------------------------------------------------\n  # Helper: breadth\u2011first search returning a list of actions\n  # ------------------------------------------------------------------\n  def _bfs_path(start, goal):\n      from collections import deque\n\n      directions = [\n          (0, 1, act_map[\"DOWN\"]),\n          (0, -1, act_map[\"UP\"]),\n          (-1, 0, act_map[\"LEFT\"]),\n          (1, 0, act_map[\"RIGHT\"]),\n      ]\n\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for dx, dy, a in directions:\n              nx, ny = x + dx, y + dy\n              if (\n                  0 <= nx < blocked.shape[0]\n                  and 0 <= ny < blocked.shape[1]\n                  and not blocked[nx, ny]\n                  and (nx, ny) not in visited\n              ):\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [a]))\n      return None  # unreachable\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # ------------------------------------------------------------------\n  # Case 1: stick is already a primitive placed in the world\n  # ------------------------------------------------------------------\n  if not prim_req:\n      stick_cells = np.argwhere(grid[:, :, stick_idx] > 0)\n      if stick_cells.size == 0:\n          return []  # cannot find a stick\n      target = tuple(stick_cells[0])\n      if cur_pos != target:\n          path = _bfs_path(cur_pos, target)\n          if path is None:\n              return []  # unreachable\n          actions.extend(path)\n      actions.append(USE)\n      return actions\n\n  # ------------------------------------------------------------------\n  # Case 2: collect required primitives\n  # ------------------------------------------------------------------\n  needed = dict(prim_req)  # mutable copy of required counts\n\n  while any(cnt > 0 for cnt in needed.values()):\n      best_path = None\n      best_target = None\n      best_prim = None\n\n      # Search for the nearest reachable needed primitive\n      for prim_idx, cnt in needed.items():\n          if cnt <= 0:\n              continue\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          for cell in prim_cells:\n              target = tuple(cell)\n              path = _bfs_path(cur_pos, target)\n              if path is None:\n                  continue\n              if best_path is None or len(path) < len(best_path):\n                  best_path = path\n                  best_target = target\n                  best_prim = prim_idx\n\n      if best_path is None:\n          # No reachable required primitive left\n          return actions\n\n      # Move to the primitive and pick it up\n      actions.extend(best_path)\n      actions.append(USE)\n\n      # Update planning state\n      cur_pos = best_target\n      needed[best_prim] -= 1\n      grid[best_target[0], best_target[1], best_prim] = 0  # remove from copy\n\n  # ------------------------------------------------------------------\n  # Case 3: go to the required workshop (if any)\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          target = tuple(workshop_cells[0])\n          if cur_pos != target:\n              path = _bfs_path(cur_pos, target)\n              if path is None:\n                  return actions\n              actions.extend(path)\n              cur_pos = target\n\n  # ------------------------------------------------------------------\n  # Finally, craft the stick\n  # ------------------------------------------------------------------\n  actions.append(USE)\n  return actions", "env_interactions": 2, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:45:30.231573", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n\n  # Action mapping\n  act_map = env.action_specs()\n  USE = act_map[\"USE\"]\n\n  # Index of the target item \"stick\"\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # Primitive requirements for a stick (empty dict if primitive)\n  prim_req = world.cookbook.primitives_for(stick_idx)\n\n  # Copy of the grid for planning updates\n  grid = state.grid.copy()\n\n  # Build mask of blocked cells (non\u2011grabbable entities)\n  blocked = np.zeros(grid.shape[:2], dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # ------------------------------------------------------------------\n  # Helper: breadth\u2011first search returning a list of actions\n  # ------------------------------------------------------------------\n  def _bfs_path(start, goal):\n      from collections import deque\n\n      dirs = [\n          (0, 1, act_map[\"DOWN\"]),\n          (0, -1, act_map[\"UP\"]),\n          (-1, 0, act_map[\"LEFT\"]),\n          (1, 0, act_map[\"RIGHT\"]),\n      ]\n\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for dx, dy, a in dirs:\n              nx, ny = x + dx, y + dy\n              if (\n                  0 <= nx < blocked.shape[0]\n                  and 0 <= ny < blocked.shape[1]\n                  and not blocked[nx, ny]\n                  and (nx, ny) not in visited\n              ):\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [a]))\n      return None\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # ------------------------------------------------------------------\n  # Case 1: stick is already a primitive placed in the world\n  # ------------------------------------------------------------------\n  if not prim_req:\n      stick_cells = np.argwhere(grid[:, :, stick_idx] > 0)\n      if stick_cells.size == 0:\n          return []  # no stick found\n      target = tuple(stick_cells[0])\n      if cur_pos != target:\n          path = _bfs_path(cur_pos, target)\n          if path is None:\n              return []  # unreachable\n          actions.extend(path)\n      actions.append(USE)\n      return actions\n\n  # ------------------------------------------------------------------\n  # Case 2: collect required primitives\n  # ------------------------------------------------------------------\n  needed = dict(prim_req)  # mutable copy\n\n  while any(cnt > 0 for cnt in needed.values()):\n      best_path = None\n      best_target = None\n      best_prim = None\n\n      # Find nearest needed primitive\n      for prim_idx, cnt in needed.items():\n          if cnt <= 0:\n              continue\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          for cell in prim_cells:\n              tgt = tuple(cell)\n              path = _bfs_path(cur_pos, tgt)\n              if path is None:\n                  continue\n              if best_path is None or len(path) < len(best_path):\n                  best_path = path\n                  best_target = tgt\n                  best_prim = prim_idx\n\n      if best_path is None:\n          # No reachable required primitive left\n          return actions\n\n      # Move to primitive and pick it up\n      actions.extend(best_path)\n      actions.append(USE)\n\n      # Update planning state\n      cur_pos = best_target\n      needed[best_prim] -= 1\n      grid[best_target[0], best_target[1], best_prim] = 0  # remove from copy\n\n  # ------------------------------------------------------------------\n  # Case 3: go to the required workshop (if any)\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          target = tuple(workshop_cells[0])\n          if cur_pos != target:\n              path = _bfs_path(cur_pos, target)\n              if path is not None:\n                  actions.extend(path)\n                  cur_pos = target\n\n  # ------------------------------------------------------------------\n  # Finally, craft the stick\n  # ------------------------------------------------------------------\n  actions.append(USE)\n  return actions", "env_interactions": 3, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:45:50.399941", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # Action indices as defined in CraftLab.action_specs\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Horizontal\u2011then\u2011vertical movement actions from start to goal.\"\"\"\n      x, y = start\n      gx, gy = goal\n      actions = []\n      while x < gx:\n          actions.append(ACTION_RIGHT)\n          x += 1\n      while x > gx:\n          actions.append(ACTION_LEFT)\n          x -= 1\n      while y < gy:\n          actions.append(ACTION_DOWN)\n          y += 1\n      while y > gy:\n          actions.append(ACTION_UP)\n          y -= 1\n      return actions\n\n  def nearest_position(positions, reference):\n      \"\"\"Select position from *positions* with smallest Manhattan distance to *reference*.\"\"\"\n      if len(positions) == 0:\n          return None\n      ref = np.array(reference)\n      dists = np.sum(np.abs(positions - ref), axis=1)\n      return tuple(positions[np.argmin(dists)])\n\n  # ------------------------------------------------------------------\n  # Gather current state\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n\n  # ------------------------------------------------------------------\n  # Identify the goal (stick)\n  # ------------------------------------------------------------------\n  goal_name = \"stick\"\n  try:\n      goal_idx = env.world.cookbook.index[goal_name]\n  except Exception:\n      return []                     # goal not defined in this world\n\n  # Already have the stick?\n  if inventory[goal_idx] > 0:\n      return []\n\n  plan_actions = []\n\n  # ------------------------------------------------------------------\n  # 1) Gather required primitives (if any)\n  # ------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n  for prim_idx, needed_cnt in primitives_needed.items():\n      while inventory[prim_idx] < needed_cnt:\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # No more of this primitive on the map \u2013 abort planning\n              return plan_actions\n          target = nearest_position(prim_cells, pos)\n\n          # move to the primitive\n          plan_actions.extend(manhattan_path(pos, target))\n          pos = target\n\n          # pick it up\n          plan_actions.append(ACTION_USE)\n\n          # simulate locally for subsequent planning steps\n          inventory[prim_idx] += 1\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # ------------------------------------------------------------------\n  # 2) If stick itself is a primitive (no recipe), just pick it up\n  # ------------------------------------------------------------------\n  if goal_idx not in env.world.cookbook.recipes:\n      stick_cells = np.argwhere(grid[:, :, goal_idx] > 0)\n      if stick_cells.size == 0:\n          return plan_actions\n      target = nearest_position(stick_cells, pos)\n\n      plan_actions.extend(manhattan_path(pos, target))\n      pos = target\n      plan_actions.append(ACTION_USE)\n      return plan_actions\n\n  # ------------------------------------------------------------------\n  # 3) Go to the appropriate workshop and craft the stick\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      try:\n          workshop_idx = env.world.cookbook.index[workshop_name]\n      except Exception:\n          return plan_actions\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          return plan_actions\n      wcell = tuple(workshop_cells[0])\n\n      # Find a free adjacent cell to stand on (prefer orthogonal neighbours)\n      neighbours = [(wcell[0] + dx, wcell[1] + dy) for dx, dy in\n                    [(1, 0), (-1, 0), (0, 1), (0, -1)]]\n      stand_pos = None\n      for nx, ny in neighbours:\n          if (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and\n                  grid[nx, ny, :].sum() == 0):\n              stand_pos = (nx, ny)\n              break\n      if stand_pos is None:\n          stand_pos = wcell   # fallback to the workshop cell itself\n\n      plan_actions.extend(manhattan_path(pos, stand_pos))\n      pos = stand_pos\n\n      # Craft the stick\n      plan_actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # Return the constructed list of actions\n  # ------------------------------------------------------------------\n  return plan_actions", "env_interactions": 5, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:45:51.806380", "function_name": "make_arrow", "function_body": "  # Action indices (as defined in CraftLab.action_specs)\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions from start to goal using\n      horizontal\u2011then\u2011vertical moves (ignores obstacles).\"\"\"\n      x, y = start\n      gx, gy = goal\n      actions = []\n      while x < gx:\n          actions.append(ACTION_RIGHT)\n          x += 1\n      while x > gx:\n          actions.append(ACTION_LEFT)\n          x -= 1\n      while y < gy:\n          actions.append(ACTION_DOWN)\n          y += 1\n      while y > gy:\n          actions.append(ACTION_UP)\n          y -= 1\n      return actions\n\n  def nearest_position(positions, reference):\n      \"\"\"Pick the position from *positions* with smallest Manhattan distance\n      to *reference*.\"\"\"\n      if len(positions) == 0:\n          return None\n      ref = np.array(reference)\n      dists = np.sum(np.abs(positions - ref), axis=1)\n      return tuple(positions[np.argmin(dists)])\n\n  # ------------------------------------------------------------------\n  # Gather current state information\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n\n  # ------------------------------------------------------------------\n  # Identify goal (stick)\n  # ------------------------------------------------------------------\n  goal_name = \"stick\"\n  try:\n      goal_idx = env.world.cookbook.index[goal_name]\n  except Exception:\n      # Goal not present \u2013 nothing to do\n      return []\n\n  # If we already have the stick, no actions needed\n  if inventory[goal_idx] > 0:\n      return []\n\n  plan_actions = []\n\n  # ------------------------------------------------------------------\n  # 1) Collect required primitives (if any)\n  # ------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  for prim_idx, needed_cnt in primitives_needed.items():\n      while inventory[prim_idx] < needed_cnt:\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # No more primitives of this type on the map \u2013 abort planning\n              return plan_actions\n          target = nearest_position(prim_cells, pos)\n\n          # Move to the primitive\n          plan_actions.extend(manhattan_path(pos, target))\n          pos = target\n\n          # Pick it up\n          plan_actions.append(ACTION_USE)\n\n          # Simulate the effect locally for further planning\n          inventory[prim_idx] += 1\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # ------------------------------------------------------------------\n  # 2) If stick itself is a primitive (no recipe), just pick it up\n  # ------------------------------------------------------------------\n  if goal_idx not in env.world.cookbook.recipes:\n      stick_cells = np.argwhere(grid[:, :, goal_idx] > 0)\n      if stick_cells.size == 0:\n          return plan_actions\n      target = nearest_position(stick_cells, pos)\n\n      plan_actions.extend(manhattan_path(pos, target))\n      pos = target\n      plan_actions.append(ACTION_USE)\n      return plan_actions\n\n  # ------------------------------------------------------------------\n  # 3) Go to required workshop and craft the stick\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      try:\n          workshop_idx = env.world.cookbook.index[workshop_name]\n      except Exception:\n          return plan_actions\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          return plan_actions\n      wcell = tuple(workshop_cells[0])\n\n      # Find a free adjacent cell to stand on\n      neighbours = [(wcell[0] + dx, wcell[1] + dy) for dx, dy in\n                    [(1, 0), (-1, 0), (0, 1), (0, -1)]]\n      stand_pos = None\n      for nx, ny in neighbours:\n          if (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and\n                  grid[nx, ny, :].sum() == 0):\n              stand_pos = (nx, ny)\n              break\n      if stand_pos is None:\n          stand_pos = wcell  # fallback to the workshop cell itself\n\n      plan_actions.extend(manhattan_path(pos, stand_pos))\n      pos = stand_pos\n\n      # Craft the stick\n      plan_actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # Return the constructed action list\n  # ------------------------------------------------------------------\n  return plan_actions", "env_interactions": 5, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:46:16.017668", "function_name": "make_arrow", "function_body": "  def _move_actions(cur_pos, target):\n      actions = []\n      x, y = cur_pos\n      tx, ty = target\n      while x < tx:\n          actions.append(3)  # RIGHT\n          x += 1\n      while x > tx:\n          actions.append(2)  # LEFT\n          x -= 1\n      while y < ty:\n          actions.append(0)  # DOWN\n          y += 1\n      while y > ty:\n          actions.append(1)  # UP\n          y -= 1\n      return actions, (x, y)\n\n  state = env._current_state\n  cookbook = env.world.cookbook\n  stick_idx = cookbook.index['stick']\n\n  # 1) Already have a stick.\n  if state.inventory[stick_idx] > 0:\n      return []\n\n  # 2) Pick up a stick that is already on the grid.\n  stick_cells = np.argwhere(state.grid[:, :, stick_idx] > 0)\n  if stick_cells.size > 0:\n      target = tuple(stick_cells[0])\n      moves, _ = _move_actions(state.pos, target)\n      moves.append(4)                     # USE\n      return moves\n\n  # 3) Need to craft a stick.\n  primitive_req = cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n  recipe = cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = cookbook.index[workshop_name] if workshop_name is not None else None\n\n  actions = []\n  cur_pos = state.pos\n  inventory = state.inventory.copy()\n\n  # 3a) Collect required primitive ingredients.\n  for prim_idx, needed in primitive_req.items():\n      while inventory[prim_idx] < needed:\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # Primitive not available on the map \u2013 abort planning.\n              return actions\n          target = tuple(prim_cells[0])\n          moves, cur_pos = _move_actions(cur_pos, target)\n          actions.extend(moves)\n          actions.append(4)                # USE to pick up the primitive\n          inventory[prim_idx] += 1\n\n  # 3b) Go to the appropriate workshop (if required) and craft the stick.\n  if workshop_idx is not None:\n      ws_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if ws_cells.size > 0:\n          target = tuple(ws_cells[0])\n          moves, cur_pos = _move_actions(cur_pos, target)\n          actions.extend(moves)\n          actions.append(4)                # USE to craft the stick\n      else:\n          # No workshop cell found; attempt to craft at current location.\n          actions.append(4)\n  else:\n      # No workshop needed; craft at current location.\n      actions.append(4)\n\n  return actions", "env_interactions": 4, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:46:17.349117", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  def _move_actions(cur_pos, target):\n      actions = []\n      x, y = cur_pos\n      tx, ty = target\n      while x < tx:\n          actions.append(3)  # RIGHT\n          x += 1\n      while x > tx:\n          actions.append(2)  # LEFT\n          x -= 1\n      while y < ty:\n          actions.append(0)  # DOWN\n          y += 1\n      while y > ty:\n          actions.append(1)  # UP\n          y -= 1\n      return actions, (x, y)\n\n  state = env._current_state\n  cookbook = env.world.cookbook\n  stick_idx = cookbook.index['stick']\n\n  # 1) Stick already in inventory.\n  if state.inventory[stick_idx] > 0:\n      return []\n\n  # 2) Pick up a stick already lying on the grid.\n  stick_cells = np.argwhere(state.grid[:, :, stick_idx] > 0)\n  if stick_cells.size > 0:\n      target = tuple(stick_cells[0])\n      moves, _ = _move_actions(state.pos, target)\n      moves.append(4)                     # USE\n      return moves\n\n  # 3) Need to craft a stick.\n  primitive_req = cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n  recipe = cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = cookbook.index[workshop_name] if workshop_name is not None else None\n\n  actions = []\n  cur_pos = state.pos\n  inventory = state.inventory.copy()\n\n  # 3a) Gather required primitives.\n  for prim_idx, needed in primitive_req.items():\n      while inventory[prim_idx] < needed:\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # Primitive not available on the map \u2013 abort planning.\n              return actions\n          target = tuple(prim_cells[0])\n          moves, cur_pos = _move_actions(cur_pos, target)\n          actions.extend(moves)\n          actions.append(4)                # USE to pick up primitive\n          inventory[prim_idx] += 1\n\n  # 3b) Go to workshop (if any) and craft the stick.\n  if workshop_idx is not None:\n      ws_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if ws_cells.size > 0:\n          target = tuple(ws_cells[0])\n          moves, cur_pos = _move_actions(cur_pos, target)\n          actions.extend(moves)\n          actions.append(4)                # USE to craft at workshop\n      else:\n          # No workshop cell found; try crafting where we are.\n          actions.append(4)\n  else:\n      # No workshop required.\n      actions.append(4)\n\n  return actions", "env_interactions": 4, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:46:45.244690", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Retrieve current state (may be stored differently depending on wrapper)\n  # ----------------------------------------------------------------------\n  try:\n      state = env._current_state\n  except AttributeError:          # raw CraftWorld usage\n      env.reset()\n      state = env._current_state\n\n  # ----------------------------------------------------------------------\n  # Action indices (consistent across environments)\n  # ----------------------------------------------------------------------\n  specs = env.action_specs()\n  DOWN = specs[\"DOWN\"]\n  UP = specs[\"UP\"]\n  LEFT = specs[\"LEFT\"]\n  RIGHT = specs[\"RIGHT\"]\n  USE = specs[\"USE\"]\n\n  # ----------------------------------------------------------------------\n  # Index of the target item \"stick\"\n  # ----------------------------------------------------------------------\n  stick_idx = env.world.cookbook.index[\"stick\"]\n\n  # ----------------------------------------------------------------------\n  # Primitive requirements for a stick (empty dict if stick is primitive)\n  # ----------------------------------------------------------------------\n  prim_req = env.world.cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n\n  # ----------------------------------------------------------------------\n  # Copy grid for planning (so we can \u201cremove\u201d collected items)\n  # ----------------------------------------------------------------------\n  grid = state.grid.copy()\n\n  # ----------------------------------------------------------------------\n  # Build mask of blocked cells (non\u2011grabbable entities)\n  # ----------------------------------------------------------------------\n  blocked = np.zeros(grid.shape[:2], dtype=bool)\n  for idx in env.world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS shortest path avoiding blocked cells\n  # ----------------------------------------------------------------------\n  def _bfs_path(start, goal, blocked_mask):\n      from collections import deque\n\n      dirs = [\n          (1, 0, DOWN),   # down\n          (-1, 0, UP),    # up\n          (0, -1, LEFT),  # left\n          (0, 1, RIGHT),  # right\n      ]\n\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for dx, dy, a in dirs:\n              nx, ny = x + dx, y + dy\n              if (\n                  0 <= nx < blocked_mask.shape[0]\n                  and 0 <= ny < blocked_mask.shape[1]\n                  and not blocked_mask[nx, ny]\n                  and (nx, ny) not in visited\n              ):\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [a]))\n      return None  # unreachable\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # ----------------------------------------------------------------------\n  # CASE 1: stick is a primitive placed directly in the world\n  # ----------------------------------------------------------------------\n  if not prim_req:\n      stick_cells = np.argwhere(grid[:, :, stick_idx] > 0)\n      if stick_cells.size == 0:\n          return []                     # no stick available\n      target = tuple(stick_cells[0])\n      if cur_pos != target:\n          path = _bfs_path(cur_pos, target, blocked)\n          if path is None:\n              return []                 # cannot reach the stick\n          actions.extend(path)\n          cur_pos = target\n      actions.append(USE)\n      return actions\n\n  # ----------------------------------------------------------------------\n  # CASE 2: collect required primitives\n  # ----------------------------------------------------------------------\n  needed = dict(prim_req)               # mutable copy of requirements\n\n  while any(cnt > 0 for cnt in needed.values()):\n      best_path = None\n      best_target = None\n      best_prim = None\n\n      # Find nearest reachable primitive that we still need\n      for prim_idx, cnt in needed.items():\n          if cnt <= 0:\n              continue\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          for cell in prim_cells:\n              target = tuple(cell)\n              path = _bfs_path(cur_pos, target, blocked)\n              if path is None:\n                  continue\n              if best_path is None or len(path) < len(best_path):\n                  best_path = path\n                  best_target = target\n                  best_prim = prim_idx\n\n      if best_path is None:\n          # No reachable required primitive left\n          return []\n\n      # Move to the primitive and pick it up\n      actions.extend(best_path)\n      actions.append(USE)\n\n      # Update planning state\n      cur_pos = best_target\n      needed[best_prim] -= 1\n      grid[best_target[0], best_target[1], best_prim] = 0   # remove from copy\n\n  # ----------------------------------------------------------------------\n  # CASE 3: go to required workshop (if any) and craft the stick\n  # ----------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      # workshop_name is a string; obtain its index\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_cells.size > 0:\n          target = tuple(ws_cells[0])\n          if cur_pos != target:\n              path = _bfs_path(cur_pos, target, blocked)\n              if path is None:\n                  return []                 # cannot reach workshop\n              actions.extend(path)\n              cur_pos = target\n\n  # Finally, use the workshop (or the current cell) to craft the stick\n  actions.append(USE)\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:46:46.530167", "function_name": "make_arrow", "function_body": "  # Try to obtain the current CraftState; reset if necessary.\n  try:\n      state = env._current_state\n  except AttributeError:\n      env.reset()\n      state = env._current_state\n\n  # ------------------------------------------------------------------\n  # Action index lookup (fallback to default ordering if the env does not\n  # provide a spec dictionary).\n  # ------------------------------------------------------------------\n  try:\n      specs = env.action_specs()\n      DOWN = specs[\"DOWN\"]\n      UP = specs[\"UP\"]\n      LEFT = specs[\"LEFT\"]\n      RIGHT = specs[\"RIGHT\"]\n      USE = specs[\"USE\"]\n  except Exception:\n      DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Identify the index for the target item \u201cstick\u201d.\n  # ------------------------------------------------------------------\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      return []  # cannot find stick in the index\n\n  # ------------------------------------------------------------------\n  # Determine primitive requirements for a stick.\n  # ------------------------------------------------------------------\n  prim_req = env.world.cookbook.primitives_for(stick_idx)  # dict {prim_idx: count}\n  grid = state.grid.copy()\n\n  # ------------------------------------------------------------------\n  # Build a mask of cells that cannot be traversed (non\u2011grabbable entities).\n  # ------------------------------------------------------------------\n  blocked = np.zeros(grid.shape[:2], dtype=bool)\n  for idx in env.world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # ------------------------------------------------------------------\n  # Helper: BFS shortest path that avoids blocked cells.\n  # Returns a list of action indices moving from start to goal, or None.\n  # ------------------------------------------------------------------\n  def bfs_path(start, goal, blocked_mask):\n      from collections import deque\n\n      dirs = [\n          (1, 0, DOWN),   # down\n          (-1, 0, UP),    # up\n          (0, -1, LEFT),  # left\n          (0, 1, RIGHT),  # right\n      ]\n\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for dx, dy, a in dirs:\n              nx, ny = x + dx, y + dy\n              if (\n                  0 <= nx < blocked_mask.shape[0]\n                  and 0 <= ny < blocked_mask.shape[1]\n                  and not blocked_mask[nx, ny]\n                  and (nx, ny) not in visited\n              ):\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [a]))\n      return None\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # ------------------------------------------------------------------\n  # If the stick itself is a primitive (no recipe), just pick it up.\n  # ------------------------------------------------------------------\n  if not prim_req:\n      stick_cells = np.argwhere(grid[:, :, stick_idx] > 0)\n      if stick_cells.size == 0:\n          return []  # no stick present in the world\n      target = tuple(stick_cells[0])\n      if cur_pos != target:\n          path = bfs_path(cur_pos, target, blocked)\n          if path is None:\n              return []  # unreachable\n          actions.extend(path)\n          cur_pos = target\n      actions.append(USE)\n      return actions\n\n  # ------------------------------------------------------------------\n  # Collect all required primitive resources.\n  # ------------------------------------------------------------------\n  needed = dict(prim_req)  # mutable copy of required counts\n  while any(cnt > 0 for cnt in needed.values()):\n      best_path = None\n      best_target = None\n      best_prim = None\n\n      # Search for the closest reachable primitive that we still need.\n      for prim_idx, cnt in needed.items():\n          if cnt <= 0:\n              continue\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          for cell in prim_cells:\n              target = tuple(cell)\n              path = bfs_path(cur_pos, target, blocked)\n              if path is None:\n                  continue\n              if best_path is None or len(path) < len(best_path):\n                  best_path = path\n                  best_target = target\n                  best_prim = prim_idx\n\n      if best_path is None:\n          # No reachable required primitive left.\n          return actions\n\n      # Move to the primitive and pick it up.\n      actions.extend(best_path)\n      actions.append(USE)\n\n      # Update planning state.\n      cur_pos = best_target\n      needed[best_prim] -= 1\n      grid[best_target[0], best_target[1], best_prim] = 0  # remove from copy\n\n  # ------------------------------------------------------------------\n  # If the recipe specifies a workshop, move to one.\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      try:\n          workshop_idx = env.world.cookbook.index[workshop_name]\n      except Exception:\n          workshop_idx = None\n      if workshop_idx is not None:\n          ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n          if ws_cells.size > 0:\n              ws_target = tuple(ws_cells[0])\n              if cur_pos != ws_target:\n                  path = bfs_path(cur_pos, ws_target, blocked)\n                  if path is not None:\n                      actions.extend(path)\n                      cur_pos = ws_target\n\n  # ------------------------------------------------------------------\n  # Finally, use the workshop (or the current tile) to craft the stick.\n  # ------------------------------------------------------------------\n  actions.append(USE)\n  return actions", "env_interactions": 3, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:47:09.398153", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  goal_idx = env.task.goal\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # Helper functions\n  def find_positions(kind):\n      \"\"\"Return list of positions where `kind` is present.\"\"\"\n      locs = np.argwhere(state.grid[:, :, kind] > 0)\n      return [tuple(p) for p in locs]\n\n  def nearest(pos, kind):\n      \"\"\"Find the Manhattan\u2011closest cell containing `kind`.\"\"\"\n      positions = find_positions(kind)\n      if not positions:\n          return None\n      return min(positions, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n\n  def moves_to(src, dst):\n      \"\"\"Generate a Manhattan path from src to dst as action indices.\n      Action mapping: DOWN=0, UP=1, LEFT=2, RIGHT=3.\n      \"\"\"\n      sx, sy = src\n      dx, dy = dst\n      seq = []\n      while sx < dx:\n          seq.append(0)   # DOWN\n          sx += 1\n      while sx > dx:\n          seq.append(1)   # UP\n          sx -= 1\n      while sy < dy:\n          seq.append(3)   # RIGHT\n          sy += 1\n      while sy > dy:\n          seq.append(2)   # LEFT\n          sy -= 1\n      return seq\n\n  # -----------------------------------------------------------------\n  # 1) If the goal is a primitive (no recipe), just go pick it up.\n  # -----------------------------------------------------------------\n  if not env.world.cookbook.primitives_for(goal_idx):\n      target = nearest(cur_pos, goal_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)   # USE to pick up\n      return actions\n\n  # -----------------------------------------------------------------\n  # 2) Collect required primitive ingredients.\n  # -----------------------------------------------------------------\n  needed_prims = env.world.cookbook.primitives_for(goal_idx)\n  for prim_idx, count in needed_prims.items():\n      for _ in range(count):\n          target = nearest(cur_pos, prim_idx)\n          if target is None:\n              continue  # primitive not found; skip\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n          actions.append(4)   # USE to pick up primitive\n\n  # -----------------------------------------------------------------\n  # 3) Move to workshop (if any) and craft the item.\n  # -----------------------------------------------------------------\n  workshop_idx = None\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  for key, val in recipe.items():\n      if isinstance(key, str) and key == \"_at\":\n          workshop_idx = val\n          break\n\n  if workshop_idx is not None:\n      target = nearest(cur_pos, workshop_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)   # USE to craft at the workshop\n\n  return actions", "env_interactions": 1, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:47:10.740464", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  goal_idx = env.task.goal\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # -----------------------------------------------------------------\n  # Helper functions\n  # -----------------------------------------------------------------\n  def find_positions(kind):\n      \"\"\"Return list of (x, y) positions where `kind` is present.\"\"\"\n      locs = np.argwhere(state.grid[:, :, kind] > 0)\n      return [tuple(p) for p in locs]\n\n  def nearest(pos, kind):\n      \"\"\"Find Manhattan\u2011closest cell containing `kind`.\"\"\"\n      positions = find_positions(kind)\n      if not positions:\n          return None\n      return min(positions,\n                 key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n\n  def moves_to(src, dst):\n      \"\"\"Generate a Manhattan path from src to dst as action indices.\n      Action mapping: DOWN=0, UP=1, LEFT=2, RIGHT=3.\n      \"\"\"\n      sx, sy = src\n      dx, dy = dst\n      seq = []\n      while sx < dx:\n          seq.append(0)   # DOWN\n          sx += 1\n      while sx > dx:\n          seq.append(1)   # UP\n          sx -= 1\n      while sy < dy:\n          seq.append(3)   # RIGHT\n          sy += 1\n      while sy > dy:\n          seq.append(2)   # LEFT\n          sy -= 1\n      return seq\n\n  # -----------------------------------------------------------------\n  # 1) If the goal is a primitive (no recipe), just go pick it up.\n  # -----------------------------------------------------------------\n  if not env.world.cookbook.primitives_for(goal_idx):\n      target = nearest(cur_pos, goal_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)   # USE to pick up the primitive\n      return actions\n\n  # -----------------------------------------------------------------\n  # 2) Collect required primitive ingredients.\n  # -----------------------------------------------------------------\n  needed_prims = env.world.cookbook.primitives_for(goal_idx)\n  for prim_idx, count in needed_prims.items():\n      for _ in range(count):\n          target = nearest(cur_pos, prim_idx)\n          if target is None:\n              # Primitive not found; cannot craft \u2013 skip.\n              continue\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n          actions.append(4)   # USE to pick up primitive\n\n  # -----------------------------------------------------------------\n  # 3) Move to workshop (if any) and craft the item.\n  # -----------------------------------------------------------------\n  workshop_idx = None\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  for key, val in recipe.items():\n      if isinstance(key, str) and key == \"_at\":\n          workshop_idx = val\n          break\n\n  if workshop_idx is not None:\n      target = nearest(cur_pos, workshop_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)   # USE to craft at the workshop\n\n  return actions", "env_interactions": 1, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:47:36.715665", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # Action indices (as defined in CraftWorld)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Mapping from action to delta (row, col)\n  _ACTION_DELTAS = {\n      DOWN: (1, 0),\n      UP: (-1, 0),\n      LEFT: (0, -1),\n      RIGHT: (0, 1),\n  }\n\n  def _move_actions(start, goal):\n      \"\"\"Manhattan moves from start (row, col) to goal (row, col).\"\"\"\n      y, x = start\n      gy, gx = goal\n      actions = []\n      while y < gy:\n          actions.append(DOWN)\n          y += 1\n      while y > gy:\n          actions.append(UP)\n          y -= 1\n      while x < gx:\n          actions.append(RIGHT)\n          x += 1\n      while x > gx:\n          actions.append(LEFT)\n          x -= 1\n      return actions\n\n  # ----------------------------------------------------------------------\n  # Locate the CraftWorld instance\n  # ----------------------------------------------------------------------\n  if hasattr(env, \"world\"):\n      world = env.world\n  elif hasattr(env, \"scenario\"):\n      world = env.scenario.world\n  else:\n      raise AttributeError(\"Cannot locate CraftWorld instance in the supplied env.\")\n\n  # ----------------------------------------------------------------------\n  # Identify the goal (stick) and its required primitives\n  # ----------------------------------------------------------------------\n  goal_name = \"stick\"\n  goal_idx = world.cookbook.index[goal_name]\n  needed = world.cookbook.primitives_for(goal_idx)   # dict {prim_idx: count}\n\n  # ----------------------------------------------------------------------\n  # Obtain the current state (position + grid) for planning\n  # ----------------------------------------------------------------------\n  if hasattr(env, \"_current_state\"):\n      state = env._current_state\n  else:\n      state = env.scenario.init()\n  cur_pos = tuple(state.pos)          # (row, col)\n  grid = state.grid.copy()            # (H, W, n_kinds)\n\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive\n  # ----------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(\n                  f\"Primitive {world.cookbook.index.get(prim_idx)} not found on the grid.\"\n              )\n          py, px = prim_cells[0]\n\n          # Find an empty neighbouring cell from which we can face the primitive\n          target_cell = None\n          chosen_dir = None\n          for d, (dy, dx) in _ACTION_DELTAS.items():\n              ny, nx = py - dy, px - dx\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  if not grid[ny, nx, :].any():\n                      target_cell = (ny, nx)\n                      chosen_dir = d\n                      break\n          if target_cell is None:\n              raise RuntimeError(\"No reachable empty neighbour around required primitive.\")\n\n          # Move to that neighbour\n          actions.extend(_move_actions(cur_pos, target_cell))\n          cur_pos = target_cell\n\n          # Use the primitive (agent now faces it)\n          actions.append(USE)\n\n          # Update planning grid \u2013 primitive has been taken\n          grid[py, px, prim_idx] = 0\n\n  # ----------------------------------------------------------------------\n  # If the recipe specifies a workshop, go there and craft the stick\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = world.cookbook.index[workshop_name]\n      ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_cells.size == 0:\n          raise RuntimeError(f\"Workshop {workshop_name} not found on the grid.\")\n      wy, wx = ws_cells[0]\n\n      # Find an empty neighbour around the workshop\n      target_cell = None\n      for d, (dy, dx) in _ACTION_DELTAS.items():\n          ny, nx = wy - dy, wx - dx\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not grid[ny, nx, :].any():\n                  target_cell = (ny, nx)\n                  break\n      if target_cell is None:\n          raise RuntimeError(\"No reachable empty neighbour around workshop.\")\n\n      actions.extend(_move_actions(cur_pos, target_cell))\n      cur_pos = target_cell\n      actions.append(USE)   # Use at workshop to craft the stick\n\n  return actions", "env_interactions": 5, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:47:38.003434", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # locate the world object (CraftWorld) from the supplied env\n  # ----------------------------------------------------------------------\n  if hasattr(env, \"world\"):\n      world = env.world\n  elif hasattr(env, \"scenario\"):\n      world = env.scenario.world\n  else:\n      raise AttributeError(\"Cannot locate CraftWorld instance in the supplied env.\")\n\n  # ----------------------------------------------------------------------\n  # identify the goal (stick) and its recipe\n  # ----------------------------------------------------------------------\n  goal_name = \"stick\"\n  goal_idx = world.cookbook.index[goal_name]          # integer id of the stick\n  needed = world.cookbook.primitives_for(goal_idx)   # {primitive_idx: count}\n\n  # ----------------------------------------------------------------------\n  # obtain current state (position + grid) for planning\n  # ----------------------------------------------------------------------\n  if hasattr(env, \"_current_state\"):\n      state = env._current_state\n  else:\n      state = env.scenario.init()\n  cur_pos = tuple(state.pos)          # (row, col)\n  grid = state.grid.copy()            # (H, W, n_kinds)\n\n  # ----------------------------------------------------------------------\n  # helper utilities for movement\n  # ----------------------------------------------------------------------\n  _ACTION_DELTAS = {\n      0: (1, 0),   # DOWN\n      1: (-1, 0),  # UP\n      2: (0, -1),  # LEFT\n      3: (0, 1),   # RIGHT\n  }\n\n  def _move_actions(start, goal):\n      \"\"\"Manhattan movement actions from start (row,col) to goal (row,col).\"\"\"\n      sy, sx = start\n      gy, gx = goal\n      acts = []\n      while sy < gy:\n          acts.append(0)   # DOWN\n          sy += 1\n      while sy > gy:\n          acts.append(1)   # UP\n          sy -= 1\n      while sx < gx:\n          acts.append(3)   # RIGHT\n          sx += 1\n      while sx > gx:\n          acts.append(2)   # LEFT\n          sx -= 1\n      return acts\n\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # function to collect a primitive located at (py,px)\n  # ----------------------------------------------------------------------\n  def _collect_primitive(prim_idx, py, px):\n      nonlocal cur_pos, actions, grid\n      # find an empty neighbour cell from which we can face the primitive\n      target_cell = None\n      for d, (dy, dx) in _ACTION_DELTAS.items():\n          ny, nx = py - dy, px - dx\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not grid[ny, nx, :].any():          # empty cell\n                  target_cell = (ny, nx)\n                  break\n      if target_cell is None:\n          raise RuntimeError(\"No reachable empty neighbour around required primitive.\")\n      # move to the neighbour\n      actions.extend(_move_actions(cur_pos, target_cell))\n      cur_pos = target_cell\n      # use to pick up the primitive\n      actions.append(4)   # USE\n      # remove primitive from planning grid\n      grid[py, px, prim_idx] = 0\n\n  # ----------------------------------------------------------------------\n  # 1) Collect required primitives (if any)\n  # ----------------------------------------------------------------------\n  if needed:\n      for prim_idx, cnt in needed.items():\n          for _ in range(cnt):\n              prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n              if prim_cells.size == 0:\n                  raise RuntimeError(f\"Primitive {world.cookbook.index.get(prim_idx)} not found on the grid.\")\n              py, px = prim_cells[0]\n              _collect_primitive(prim_idx, py, px)\n\n  # ----------------------------------------------------------------------\n  # 2) If the stick itself is a primitive (no recipe), just collect it\n  # ----------------------------------------------------------------------\n  if not needed:\n      stick_cells = np.argwhere(grid[:, :, goal_idx] > 0)\n      if stick_cells.size == 0:\n          # nothing to do \u2013 stick already in inventory or not present\n          return actions\n      py, px = stick_cells[0]\n      _collect_primitive(goal_idx, py, px)\n      # after this the stick is in inventory; no further crafting needed\n      return actions\n\n  # ----------------------------------------------------------------------\n  # 3) Craft the stick at its required workshop (if any)\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = world.cookbook.index[workshop_name]\n      ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_cells.size == 0:\n          raise RuntimeError(f\"Workshop {workshop_name} not found on the grid.\")\n      wy, wx = ws_cells[0]\n\n      # find empty neighbour around workshop\n      target_cell = None\n      for d, (dy, dx) in _ACTION_DELTAS.items():\n          ny, nx = wy - dy, wx - dx\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not grid[ny, nx, :].any():\n                  target_cell = (ny, nx)\n                  break\n      if target_cell is None:\n          raise RuntimeError(\"No reachable empty neighbour around workshop.\")\n      actions.extend(_move_actions(cur_pos, target_cell))\n      cur_pos = target_cell\n      actions.append(4)   # USE to craft the stick\n\n  return actions", "env_interactions": 5, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:47:52.035085", "function_name": "make_arrow", "function_body": "  # Helper to move from cur_pos to target, appending actions to seq\n  def _move_to(cur_pos, target, seq):\n      x, y = cur_pos\n      tx, ty = target\n      while x < tx:\n          seq.append(3)  # RIGHT\n          x += 1\n      while x > tx:\n          seq.append(2)  # LEFT\n          x -= 1\n      while y < ty:\n          seq.append(0)  # DOWN\n          y += 1\n      while y > ty:\n          seq.append(1)  # UP\n          y -= 1\n      return (x, y)\n\n  # Current environment information\n  state = env._current_state\n  grid = state.grid.copy()\n  cur_pos = state.pos\n  goal_idx = env.task.goal\n\n  # Retrieve recipe for the goal (may be empty if primitive)\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n  ingredients = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # 1) Gather all required ingredients (if any)\n  # ------------------------------------------------------------------\n  for ing_kind, count in ingredients.items():\n      for _ in range(count):\n          # Find all cells containing this ingredient\n          locations = np.argwhere(grid[:, :, ing_kind] > 0)\n          if locations.size == 0:\n              # Ingredient not present on map \u2013 abort early\n              return actions\n          # Choose the closest occurrence (Manhattan distance)\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          best_idx = int(np.argmin(dists))\n          target_loc = tuple(locations[best_idx].tolist())\n          # Move to the target and pick it up\n          cur_pos = _move_to(cur_pos, target_loc, actions)\n          actions.append(4)                     # USE to pick up\n          grid[target_loc[0], target_loc[1], ing_kind] = 0   # remove from map\n\n  # ------------------------------------------------------------------\n  # 2) If the goal is a primitive (no recipe) just pick it up\n  # ------------------------------------------------------------------\n  if not ingredients and workshop_kind is None:\n      locations = np.argwhere(grid[:, :, goal_idx] > 0)\n      if locations.size > 0:\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          best_idx = int(np.argmin(dists))\n          target_loc = tuple(locations[best_idx].tolist())\n          cur_pos = _move_to(cur_pos, target_loc, actions)\n          actions.append(4)                     # USE to pick up\n      return actions\n\n  # ------------------------------------------------------------------\n  # 3) Move to the required workshop (if any) and craft the goal\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      ws_locs = np.argwhere(grid[:, :, workshop_kind] > 0)\n      if ws_locs.size > 0:\n          dists = np.abs(ws_locs[:, 0] - cur_pos[0]) + np.abs(ws_locs[:, 1] - cur_pos[1])\n          best_idx = int(np.argmin(dists))\n          workshop_loc = tuple(ws_locs[best_idx].tolist())\n          cur_pos = _move_to(cur_pos, workshop_loc, actions)\n          actions.append(4)                     # USE to craft at workshop\n\n  return actions", "env_interactions": 0, "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:47:53.372035", "function_name": "make_arrow", "function_body": "  def _move_to(cur_pos, target, seq):\n      x, y = cur_pos\n      tx, ty = target\n      while x < tx:\n          seq.append(3)  # RIGHT\n          x += 1\n      while x > tx:\n          seq.append(2)  # LEFT\n          x -= 1\n      while y < ty:\n          seq.append(0)  # DOWN\n          y += 1\n      while y > ty:\n          seq.append(1)  # UP\n          y -= 1\n      return (x, y)\n\n  # current environment information\n  state = env._current_state\n  grid = state.grid.copy()\n  cur_pos = state.pos\n  goal_idx = env.task.goal\n\n  # recipe information for the goal (stick)\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n  ingredients = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  actions = []\n\n  # ---- collect required ingredients ---------------------------------\n  for ing_kind, count in ingredients.items():\n      for _ in range(count):\n          # locate the nearest instance of the ingredient on the map\n          locations = np.argwhere(grid[:, :, ing_kind] > 0)\n          if locations.size == 0:\n              # ingredient not present \u2013 abort early\n              return actions\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          best_idx = int(np.argmin(dists))\n          target_loc = tuple(locations[best_idx].tolist())\n\n          # move to the ingredient and pick it up\n          cur_pos = _move_to(cur_pos, target_loc, actions)\n          actions.append(4)                     # USE\n          grid[target_loc[0], target_loc[1], ing_kind] = 0  # remove from map\n\n  # ---- if the goal itself is a primitive, just pick it up -------------\n  if not ingredients and workshop_kind is None:\n      locations = np.argwhere(grid[:, :, goal_idx] > 0)\n      if locations.size > 0:\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          best_idx = int(np.argmin(dists))\n          target_loc = tuple(locations[best_idx].tolist())\n          cur_pos = _move_to(cur_pos, target_loc, actions)\n          actions.append(4)                     # USE\n      return actions\n\n  # ---- move to the appropriate workshop and craft the stick ----------\n  if workshop_kind is not None:\n      ws_locs = np.argwhere(grid[:, :, workshop_kind] > 0)\n      if ws_locs.size > 0:\n          dists = np.abs(ws_locs[:, 0] - cur_pos[0]) + np.abs(ws_locs[:, 1] - cur_pos[1])\n          best_idx = int(np.argmin(dists))\n          workshop_loc = tuple(ws_locs[best_idx].tolist())\n          cur_pos = _move_to(cur_pos, workshop_loc, actions)\n          actions.append(4)                     # USE (craft)\n\n  return actions", "env_interactions": 0, "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:48:16.370331", "function_name": "make_arrow", "function_body": "  # Helper: shortest path (BFS) respecting blocked cells\n  def _bfs_path(start, goal, blocked):\n      act_map = env.action_specs()\n      moves = [\n          (1, 0, act_map[\"DOWN\"]),   # row +1\n          (-1, 0, act_map[\"UP\"]),    # row -1\n          (0, -1, act_map[\"LEFT\"]),  # col -1\n          (0, 1, act_map[\"RIGHT\"]),  # col +1\n      ]\n      from collections import deque\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for dx, dy, a in moves:\n              nx, ny = x + dx, y + dy\n              if (\n                  0 <= nx < blocked.shape[0]\n                  and 0 <= ny < blocked.shape[1]\n                  and not blocked[nx, ny]\n                  and (nx, ny) not in visited\n              ):\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [a]))\n      return None  # unreachable\n\n  # ----------------------------------------------------------------------\n  # Obtain current state (reset if necessary)\n  # ----------------------------------------------------------------------\n  try:\n      state = env._current_state\n  except AttributeError:\n      env.reset()\n      state = env._current_state\n\n  world = env.world\n  grid = state.grid.copy()                     # mutable copy for planning\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # Primitive requirements for a stick (empty if stick itself is primitive)\n  needed = dict(world.cookbook.primitives_for(stick_idx))\n\n  # Cells that block movement (non\u2011grabbable entities)\n  blocked = np.zeros(grid.shape[:2], dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # ----------------------------------------------------------------------\n  # Case 1: stick is a primitive \u2013 just pick it up\n  # ----------------------------------------------------------------------\n  if not needed:\n      stick_cells = np.argwhere(grid[:, :, stick_idx] > 0)\n      if stick_cells.size == 0:\n          return []  # no stick present\n      target = tuple(stick_cells[0])\n      if cur_pos != target:\n          path = _bfs_path(cur_pos, target, blocked)\n          if path is None:\n              return []  # unreachable\n          actions.extend(path)\n          cur_pos = target\n      actions.append(env.action_specs()[\"USE\"])\n      return actions\n\n  # ----------------------------------------------------------------------\n  # Case 2: need to collect primitives\n  # ----------------------------------------------------------------------\n  while any(cnt > 0 for cnt in needed.values()):\n      best_path = None\n      best_target = None\n      best_prim = None\n\n      # iterate over needed primitive types\n      for prim_idx, cnt in needed.items():\n          if cnt <= 0:\n              continue\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          for cell in prim_cells:\n              target = tuple(cell)\n              path = _bfs_path(cur_pos, target, blocked)\n              if path is None:\n                  continue\n              if best_path is None or len(path) < len(best_path):\n                  best_path = path\n                  best_target = target\n                  best_prim = prim_idx\n\n      if best_path is None:\n          # cannot reach any remaining required primitive\n          return actions\n\n      # move to the primitive and pick it up\n      actions.extend(best_path)\n      actions.append(env.action_specs()[\"USE\"])\n\n      # update bookkeeping\n      cur_pos = best_target\n      needed[best_prim] -= 1\n      grid[best_target[0], best_target[1], best_prim] = 0   # remove from copy\n\n  # ----------------------------------------------------------------------\n  # Move to workshop if the recipe specifies one\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_cells.size > 0:\n          target = tuple(ws_cells[0])\n          if cur_pos != target:\n              path = _bfs_path(cur_pos, target, blocked)\n              if path is not None:\n                  actions.extend(path)\n                  cur_pos = target\n\n  # ----------------------------------------------------------------------\n  # Finally craft the stick\n  # ----------------------------------------------------------------------\n  actions.append(env.action_specs()[\"USE\"])\n  return actions", "env_interactions": 3, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:48:17.690602", "function_name": "make_arrow", "function_body": "  # Helper: BFS shortest path avoiding blocked cells\n  def _bfs_path(start, goal, blocked):\n      act_map = env.action_specs()\n      moves = [\n          (1, 0, act_map[\"DOWN\"]),   # row +1\n          (-1, 0, act_map[\"UP\"]),    # row -1\n          (0, -1, act_map[\"LEFT\"]),  # col -1\n          (0, 1, act_map[\"RIGHT\"]),  # col +1\n      ]\n      from collections import deque\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for dx, dy, a in moves:\n              nx, ny = x + dx, y + dy\n              if (\n                  0 <= nx < blocked.shape[0]\n                  and 0 <= ny < blocked.shape[1]\n                  and not blocked[nx, ny]\n                  and (nx, ny) not in visited\n              ):\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [a]))\n      return None  # unreachable\n\n  # ----------------------------------------------------------------------\n  # Obtain current state (reset if needed)\n  # ----------------------------------------------------------------------\n  try:\n      state = env._current_state\n  except AttributeError:\n      env.reset()\n      state = env._current_state\n\n  world = env.world\n  grid = state.grid.copy()                     # mutable copy for planning\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # Primitive requirements for a stick (empty dict if stick itself is primitive)\n  needed = dict(world.cookbook.primitives_for(stick_idx))\n\n  # Cells that block movement (non\u2011grabbable entities)\n  blocked = np.zeros(grid.shape[:2], dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # ----------------------------------------------------------------------\n  # Case 1: stick is a primitive \u2013 just pick it up\n  # ----------------------------------------------------------------------\n  if not needed:\n      stick_cells = np.argwhere(grid[:, :, stick_idx] > 0)\n      if stick_cells.size == 0:\n          return []  # no stick present\n      target = tuple(stick_cells[0])\n      if cur_pos != target:\n          path = _bfs_path(cur_pos, target, blocked)\n          if path is None:\n              return []  # unreachable\n          actions.extend(path)\n          cur_pos = target\n      actions.append(env.action_specs()[\"USE\"])\n      return actions\n\n  # ----------------------------------------------------------------------\n  # Case 2: need to collect primitives first\n  # ----------------------------------------------------------------------\n  while any(cnt > 0 for cnt in needed.values()):\n      best_path = None\n      best_target = None\n      best_prim = None\n\n      # search for the closest needed primitive instance\n      for prim_idx, cnt in needed.items():\n          if cnt <= 0:\n              continue\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          for cell in prim_cells:\n              target = tuple(cell)\n              path = _bfs_path(cur_pos, target, blocked)\n              if path is None:\n                  continue\n              if best_path is None or len(path) < len(best_path):\n                  best_path = path\n                  best_target = target\n                  best_prim = prim_idx\n\n      if best_path is None:\n          # cannot reach any remaining primitive\n          break\n\n      # move to the primitive and pick it up\n      actions.extend(best_path)\n      actions.append(env.action_specs()[\"USE\"])\n\n      # bookkeeping: mark primitive as taken\n      cur_pos = best_target\n      needed[best_prim] -= 1\n      grid[best_target[0], best_target[1], best_prim] = 0\n\n  # ----------------------------------------------------------------------\n  # Move to the required workshop (if any) before crafting\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_cells.size > 0:\n          target = tuple(ws_cells[0])\n          if cur_pos != target:\n              path = _bfs_path(cur_pos, target, blocked)\n              if path is not None:\n                  actions.extend(path)\n                  cur_pos = target\n\n  # ----------------------------------------------------------------------\n  # Finally craft the stick\n  # ----------------------------------------------------------------------\n  actions.append(env.action_specs()[\"USE\"])\n  return actions", "env_interactions": 3, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:48:39.151327", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  grid = state.grid\n  width, height = grid.shape[:2]\n\n  # direction vectors and corresponding action indices (DOWN=0,UP=1,LEFT=2,RIGHT=3)\n  dirs = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n  dir_action = {(0, 1): 0, (0, -1): 1, (-1, 0): 2, (1, 0): 3}\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def find_cells(kind):\n      \"\"\"Return list of (x, y) positions where `kind` is present.\"\"\"\n      xs, ys = np.where(grid[:, :, kind] > 0)\n      return list(zip(xs.tolist(), ys.tolist()))\n\n  from collections import deque\n\n  def bfs(start, goal):\n      \"\"\"Shortest path on free cells; returns list of (dx,dy) moves.\"\"\"\n      if start == goal:\n          return []\n      q = deque([start])\n      visited = {start}\n      prev = {}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          x, y = cur\n          for dx, dy in dirs:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height:\n                  if (nx, ny) not in visited and not grid[nx, ny].any():\n                      visited.add((nx, ny))\n                      prev[(nx, ny)] = (cur, (dx, dy))\n                      q.append((nx, ny))\n      if goal not in prev:\n          return []  # no path found\n      # reconstruct path\n      path = []\n      cur = goal\n      while cur != start:\n          prev_node, move = prev[cur]\n          path.append(move)\n          cur = prev_node\n      path.reverse()\n      return path\n\n  # ------------------------------------------------------------------\n  # Identify stick recipe\n  # ------------------------------------------------------------------\n  stick_idx = env.world.cookbook.index[\"stick\"]\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  primitive_needs = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  # ------------------------------------------------------------------\n  # Collect required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          prim_cells = find_cells(prim_idx)\n          if not prim_cells:\n              continue  # primitive not present\n          tx, ty = prim_cells[0]\n\n          # try to stand on a free neighbour opposite the direction we will face\n          neighbour_found = False\n          for dx, dy in dirs:\n              nx, ny = tx - dx, ty - dy\n              if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                  # move there\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  # face the primitive\n                  actions.append(dir_action[(-dx, -dy)])\n                  state.dir = dir_action[(-dx, -dy)]\n                  # pick up\n                  actions.append(4)  # USE\n                  neighbour_found = True\n                  break\n\n          if not neighbour_found:\n              # fallback: any adjacent free cell, then turn towards primitive\n              for dx, dy in dirs:\n                  nx, ny = tx + dx, ty + dy\n                  if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                      path = bfs(state.pos, (nx, ny))\n                      for mv in path:\n                          actions.append(dir_action[mv])\n                          state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                          state.dir = dir_action[mv]\n                      actions.append(dir_action[(-dx, -dy)])\n                      state.dir = dir_action[(-dx, -dy)]\n                      actions.append(4)  # USE\n                      neighbour_found = True\n                      break\n\n  # ------------------------------------------------------------------\n  # Craft at workshop if required\n  # ------------------------------------------------------------------\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      workshop_cells = find_cells(workshop_idx)\n      if workshop_cells:\n          wx, wy = workshop_cells[0]\n          # find free neighbour to stand on\n          for dx, dy in dirs:\n              nx, ny = wx - dx, wy - dy\n              if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  actions.append(4)  # USE to craft\n                  break\n\n  return actions", "env_interactions": 8, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-23T02:48:40.427143", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  grid = state.grid\n  width, height = grid.shape[:2]\n\n  # direction vectors and mapping to action indices (DOWN=0, UP=1, LEFT=2, RIGHT=3)\n  dirs = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n  dir_action = {(0, 1): 0, (0, -1): 1, (-1, 0): 2, (1, 0): 3}\n\n  actions = []\n\n  # helper to locate all cells containing a given kind index\n  def find_cells(kind):\n      xs, ys = np.where(grid[:, :, kind] > 0)\n      return list(zip(xs.tolist(), ys.tolist()))\n\n  # BFS that returns a list of (dx,dy) moves from start to goal avoiding occupied cells\n  from collections import deque\n\n  def bfs(start, goal):\n      \"\"\"Return a list of (dx,dy) moves from start to goal on free cells.\"\"\"\n      if start == goal:\n          return []\n      q = deque([start])\n      visited = {start}\n      prev = {}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          x, y = cur\n          for dx, dy in dirs:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height:\n                  if (nx, ny) not in visited and not grid[nx, ny].any():\n                      visited.add((nx, ny))\n                      prev[(nx, ny)] = (cur, (dx, dy))\n                      q.append((nx, ny))\n      if goal not in prev:\n          return []  # no path found\n      # reconstruct path\n      path = []\n      cur = goal\n      while cur != start:\n          prev_node, move = prev[cur]\n          path.append(move)\n          cur = prev_node\n      path.reverse()\n      return path\n\n  # ----------------------------------------------------------------------\n  # Identify the recipe for a stick\n  # ----------------------------------------------------------------------\n  stick_idx = env.world.cookbook.index[\"stick\"]\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  primitive_needs = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive the needed number of times\n  # ----------------------------------------------------------------------\n  for prim_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          prim_cells = find_cells(prim_idx)\n          if not prim_cells:\n              continue  # primitive not present\n          tx, ty = prim_cells[0]\n\n          # Try to stand on a free neighbour from which we can USE the primitive\n          neighbour_found = False\n          for dx, dy in dirs:\n              nx, ny = tx - dx, ty - dy  # cell opposite the direction we will face\n              if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  # Face the primitive\n                  actions.append(dir_action[(-dx, -dy)])\n                  state.dir = dir_action[(-dx, -dy)]\n                  # Pick it up\n                  actions.append(4)  # USE\n                  neighbour_found = True\n                  break\n\n          if not neighbour_found:\n              # Fallback: any adjacent free cell, then turn towards primitive\n              for dx, dy in dirs:\n                  nx, ny = tx + dx, ty + dy\n                  if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                      path = bfs(state.pos, (nx, ny))\n                      for mv in path:\n                          actions.append(dir_action[mv])\n                          state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                          state.dir = dir_action[mv]\n                      actions.append(dir_action[(-dx, -dy)])\n                      state.dir = dir_action[(-dx, -dy)]\n                      actions.append(4)  # USE\n                      neighbour_found = True\n                      break\n\n  # ----------------------------------------------------------------------\n  # If the recipe requires a workshop, move there and craft the stick\n  # ----------------------------------------------------------------------\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      workshop_cells = find_cells(workshop_idx)\n      if workshop_cells:\n          wx, wy = workshop_cells[0]\n          # Find a free neighbour to stand on\n          for dx, dy in dirs:\n              nx, ny = wx - dx, wy - dy\n              if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  actions.append(4)  # USE to craft the stick\n                  break\n\n  return actions", "env_interactions": 8, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-23T02:49:24.583600", "function_name": "make_arrow", "function_body": "", "env_interactions": 0, "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-10-23T02:49:25.861671", "function_name": "make_arrow", "function_body": "  # Get action indices\n  act = env.action_specs()\n  DOWN = act.get(\"DOWN\", 0)\n  UP = act.get(\"UP\", 1)\n  LEFT = act.get(\"LEFT\", 2)\n  RIGHT = act.get(\"RIGHT\", 3)\n  USE = act.get(\"USE\", 4)\n\n  # Snapshot of the current state (do not modify the environment)\n  state = env._current_state\n  grid = state.grid.copy()                 # (W, H, n_kinds)\n  cur_pos = tuple(state.pos)               # (x, y)\n\n  # Index of the target item \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\", None)\n      if stick_idx is None:\n          return []   # stick not defined in this world\n\n  # Primitive requirements for a stick (may be empty if stick is primitive)\n  recipe = env.world.cookbook.primitives_for(stick_idx)   # dict {kind_idx: count}\n  primitive_needs = {k: v for k, v in recipe.items() if isinstance(k, int)}\n\n  # If there is no recipe, we must simply pick up a stick from the map\n  if not primitive_needs:\n      primitive_needs = {stick_idx: 1}\n\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # Helper: locate the nearest cell that still contains at least one of the\n  # given kind (according to the local copy of the grid).\n  # ----------------------------------------------------------------------\n  def find_closest(kind_idx, cur):\n      positions = np.argwhere(grid[:, :, kind_idx] > 0)\n      if positions.shape[0] == 0:\n          return None\n      dists = np.sum(np.abs(positions - np.array(cur)), axis=1)\n      nearest = positions[np.argmin(dists)]\n      return tuple(nearest.tolist())\n\n  # ----------------------------------------------------------------------\n  # Helper: generate a greedy Manhattan path from cur to target.\n  # ----------------------------------------------------------------------\n  def path_to(cur, target):\n      x, y = cur\n      tx, ty = target\n      path = []\n      while (x, y) != (tx, ty):\n          if x < tx:\n              path.append(RIGHT)\n              x += 1\n          elif x > tx:\n              path.append(LEFT)\n              x -= 1\n          elif y < ty:\n              path.append(DOWN)\n              y += 1\n          elif y > ty:\n              path.append(UP)\n              y -= 1\n      return path, (x, y)\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive the needed number of times.\n  # ----------------------------------------------------------------------\n  for kind_idx, needed in primitive_needs.items():\n      while needed > 0:\n          target = find_closest(kind_idx, cur_pos)\n          if target is None:\n              # Primitive not present on the map \u2013 abort planning.\n              return actions\n          move_actions, cur_pos = path_to(cur_pos, target)\n          actions.extend(move_actions)\n          actions.append(USE)   # pick up / use the primitive\n\n          # Update local grid copy to reflect the collection.\n          grid[target[0], target[1], kind_idx] = max(\n              0, grid[target[0], target[1], kind_idx] - 1\n          )\n          needed -= 1\n\n  # ----------------------------------------------------------------------\n  # Determine if a workshop is required for crafting the stick.\n  # ----------------------------------------------------------------------\n  workshop_idx = None\n  full_recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  for key, val in full_recipe.items():\n      if not isinstance(key, int):   # non\u2011int key encodes workshop requirement\n          if isinstance(val, int):\n              workshop_idx = val\n          else:\n              workshop_idx = env.world.cookbook.index.get(val, None)\n          break\n\n  # ----------------------------------------------------------------------\n  # If a workshop is required, move to it and craft the stick.\n  # ----------------------------------------------------------------------\n  if workshop_idx is not None:\n      target_ws = find_closest(workshop_idx, cur_pos)\n      if target_ws is not None:\n          move_actions, cur_pos = path_to(cur_pos, target_ws)\n          actions.extend(move_actions)\n          actions.append(USE)   # craft the stick at the workshop\n  else:\n      # No workshop needed (either stick is primitive or crafting without a specific location)\n      actions.append(USE)\n\n  return actions", "env_interactions": 0, "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-10-23T02:49:55.671663", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  grid = state.grid\n  width, height = grid.shape[:2]\n\n  # movement vectors and corresponding action ids (DOWN=0, UP=1, LEFT=2, RIGHT=3)\n  dirs = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n  dir_action = {(0, 1): 0, (0, -1): 1, (-1, 0): 2, (1, 0): 3}\n\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # Helper utilities\n  # ----------------------------------------------------------------------\n  def find_cells(kind):\n      xs, ys = np.where(grid[:, :, kind] > 0)\n      return list(zip(xs.tolist(), ys.tolist()))\n\n  from collections import deque\n\n  def bfs(start, goal):\n      \"\"\"Return a list of (dx,dy) moves from start to goal on free cells.\"\"\"\n      if start == goal:\n          return []\n      q = deque([start])\n      visited = {start}\n      prev = {}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          x, y = cur\n          for dx, dy in dirs:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height:\n                  if (nx, ny) not in visited and not grid[nx, ny].any():\n                      visited.add((nx, ny))\n                      prev[(nx, ny)] = (cur, (dx, dy))\n                      q.append((nx, ny))\n      if goal not in prev:\n          return []  # no path found\n      # reconstruct path\n      path = []\n      cur = goal\n      while cur != start:\n          pnode, move = prev[cur]\n          path.append(move)\n          cur = pnode\n      path.reverse()\n      return path\n\n  # ----------------------------------------------------------------------\n  # Identify the recipe for a stick\n  # ----------------------------------------------------------------------\n  stick_idx = env.world.cookbook.index[\"stick\"]\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  primitive_needs = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive the needed number of times\n  # ----------------------------------------------------------------------\n  for prim_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          prim_cells = find_cells(prim_idx)\n          if not prim_cells:\n              continue  # primitive not present; skip\n          tx, ty = prim_cells[0]\n\n          # Try to stand on a free neighbour opposite the direction we will face\n          neighbour_found = False\n          for dx, dy in dirs:\n              nx, ny = tx - dx, ty - dy\n              if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  # Face the primitive\n                  actions.append(dir_action[(-dx, -dy)])\n                  state.dir = dir_action[(-dx, -dy)]\n                  # Pick up\n                  actions.append(4)  # USE\n                  neighbour_found = True\n                  break\n\n          if not neighbour_found:\n              # Fallback: any adjacent free cell then turn towards primitive\n              for dx, dy in dirs:\n                  nx, ny = tx + dx, ty + dy\n                  if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                      path = bfs(state.pos, (nx, ny))\n                      for mv in path:\n                          actions.append(dir_action[mv])\n                          state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                          state.dir = dir_action[mv]\n                      actions.append(dir_action[(-dx, -dy)])\n                      state.dir = dir_action[(-dx, -dy)]\n                      actions.append(4)  # USE\n                      break\n\n  # ----------------------------------------------------------------------\n  # If a workshop is required, move there and craft the stick\n  # ----------------------------------------------------------------------\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      workshop_cells = find_cells(workshop_idx)\n      if workshop_cells:\n          wx, wy = workshop_cells[0]\n          for dx, dy in dirs:\n              nx, ny = wx - dx, wy - dy\n              if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  actions.append(4)  # USE to craft\n                  break\n\n  return actions", "env_interactions": 8, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-23T02:49:56.955235", "function_name": "make_arrow", "function_body": "  # reset environment and get initial state\n  env.reset()\n  state = env._current_state\n  grid = state.grid\n  width, height = grid.shape[:2]\n\n  # movement directions and mapping to action indices (DOWN=0, UP=1, LEFT=2, RIGHT=3)\n  dirs = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n  dir_action = {(0, 1): 0, (0, -1): 1, (-1, 0): 2, (1, 0): 3}\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # helper utilities\n  # ------------------------------------------------------------------\n  def find_cells(kind):\n      \"\"\"Return list of (x, y) positions where `kind` is present.\"\"\"\n      xs, ys = np.where(grid[:, :, kind] > 0)\n      return list(zip(xs.tolist(), ys.tolist()))\n\n  from collections import deque\n\n  def bfs(start, goal):\n      \"\"\"Bread\u2011first search on free cells, returning a list of (dx, dy) moves.\"\"\"\n      if start == goal:\n          return []\n      q = deque([start])\n      visited = {start}\n      prev = {}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          x, y = cur\n          for dx, dy in dirs:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height:\n                  if (nx, ny) not in visited and not grid[nx, ny].any():\n                      visited.add((nx, ny))\n                      prev[(nx, ny)] = (cur, (dx, dy))\n                      q.append((nx, ny))\n      if goal not in prev:\n          return []          # no path found\n      # reconstruct moves\n      path = []\n      cur = goal\n      while cur != start:\n          pnode, move = prev[cur]\n          path.append(move)\n          cur = pnode\n      path.reverse()\n      return path\n\n  # ------------------------------------------------------------------\n  # obtain stick recipe\n  # ------------------------------------------------------------------\n  stick_idx = env.world.cookbook.index[\"stick\"]\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  primitive_needs = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  # ------------------------------------------------------------------\n  # collect required primitives (or the stick itself if it is primitive)\n  # ------------------------------------------------------------------\n  if not primitive_needs and stick_idx in env.world.cookbook.primitives:\n      # stick is a primitive; just pick it up like any other resource\n      primitive_needs = {stick_idx: 1}\n\n  for prim_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          prim_cells = find_cells(prim_idx)\n          if not prim_cells:\n              continue          # primitive not present in this scenario\n          tx, ty = prim_cells[0]\n\n          # try to stand on a free neighbour opposite the direction we will face\n          found = False\n          for dx, dy in dirs:\n              nx, ny = tx - dx, ty - dy          # cell opposite the direction we will look from\n              if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  # turn to face the primitive\n                  actions.append(dir_action[(-dx, -dy)])\n                  state.dir = dir_action[(-dx, -dy)]\n                  # pick up\n                  actions.append(4)               # USE action\n                  found = True\n                  break\n          if not found:\n              # fallback: any adjacent free cell then turn towards primitive\n              for dx, dy in dirs:\n                  nx, ny = tx + dx, ty + dy\n                  if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                      path = bfs(state.pos, (nx, ny))\n                      for mv in path:\n                          actions.append(dir_action[mv])\n                          state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                          state.dir = dir_action[mv]\n                      actions.append(dir_action[(-dx, -dy)])\n                      state.dir = dir_action[(-dx, -dy)]\n                      actions.append(4)           # USE\n                      found = True\n                      break\n          # after picking up, the primitive disappears from the grid \u2013 update local view\n          grid = state.grid\n\n  # ------------------------------------------------------------------\n  # if a workshop is required, move there and craft the stick\n  # ------------------------------------------------------------------\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      workshop_cells = find_cells(workshop_idx)\n      if workshop_cells:\n          wx, wy = workshop_cells[0]\n          for dx, dy in dirs:\n              nx, ny = wx - dx, wy - dy\n              if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  actions.append(4)               # USE to craft at workshop\n                  break\n\n  return actions", "env_interactions": 8, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-23T02:50:18.207586", "function_name": "make_arrow", "function_body": "  # Reset environment to start fresh and get initial state\n  env.reset()\n  state = env._current_state\n  goal_idx = env.task.goal\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # Helper: locate all cells containing a given kind (entity index)\n  def find_positions(kind):\n      locs = np.argwhere(state.grid[:, :, kind] > 0)\n      return [tuple(p) for p in locs]\n\n  # Helper: choose the nearest location of a kind (Manhattan distance)\n  def nearest(pos, kind):\n      positions = find_positions(kind)\n      if not positions:\n          return None\n      return min(positions, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n\n  # Helper: generate a sequence of movement actions from src to dst\n  def moves_to(src, dst):\n      sx, sy = src\n      dx, dy = dst\n      seq = []\n      while sx < dx:\n          seq.append(0)   # DOWN\n          sx += 1\n      while sx > dx:\n          seq.append(1)   # UP\n          sx -= 1\n      while sy < dy:\n          seq.append(3)   # RIGHT\n          sy += 1\n      while sy > dy:\n          seq.append(2)   # LEFT\n          sy -= 1\n      return seq\n\n  # -----------------------------------------------------------------\n  # 1) If the goal is a primitive (no recipe), just go to it and pick up.\n  # -----------------------------------------------------------------\n  if not env.world.cookbook.primitives_for(goal_idx):\n      target = nearest(cur_pos, goal_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)   # USE to collect primitive\n      return actions\n\n  # -----------------------------------------------------------------\n  # 2) Collect all required primitive ingredients for the goal.\n  # -----------------------------------------------------------------\n  needed_prims = env.world.cookbook.primitives_for(goal_idx)\n  for prim_idx, count in needed_prims.items():\n      for _ in range(count):\n          target = nearest(cur_pos, prim_idx)\n          if target is None:\n              continue\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n          actions.append(4)   # USE to pick up primitive\n\n  # -----------------------------------------------------------------\n  # 3) Move to the appropriate workshop (if any) and craft the item.\n  # -----------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  if isinstance(recipe, dict):\n      workshop_idx = recipe.get('_at')\n      if workshop_idx is None:\n          for k, v in recipe.items():\n              if isinstance(k, str) and k != '_at':\n                  workshop_idx = v\n                  break\n\n  if workshop_idx is not None:\n      target = nearest(cur_pos, workshop_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)   # USE at workshop to craft\n  else:\n      # No explicit workshop \u2013 attempt to craft at current location.\n      actions.append(4)\n\n  return actions", "env_interactions": 1, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:50:19.643718", "function_name": "make_arrow", "function_body": "  # Reset environment to start fresh\n  env.reset()\n  state = env._current_state\n  goal_idx = env.task.goal\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # Helper: find all positions of a given kind on the grid\n  def find_positions(kind):\n      locs = np.argwhere(state.grid[:, :, kind] > 0)\n      return [tuple(p) for p in locs]\n\n  # Helper: nearest position of a kind to current location\n  def nearest(pos, kind):\n      positions = find_positions(kind)\n      if not positions:\n          return None\n      return min(positions, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n\n  # Helper: sequence of actions to move from src to dst (Manhattan path)\n  def moves_to(src, dst):\n      sx, sy = src\n      dx, dy = dst\n      seq = []\n      while sx < dx:\n          seq.append(0)   # DOWN\n          sx += 1\n      while sx > dx:\n          seq.append(1)   # UP\n          sx -= 1\n      while sy < dy:\n          seq.append(3)   # RIGHT\n          sy += 1\n      while sy > dy:\n          seq.append(2)   # LEFT\n          sy -= 1\n      return seq\n\n  # -----------------------------------------------------------------\n  # 1) If the goal is a primitive (no recipe), just go grab it.\n  # -----------------------------------------------------------------\n  if not env.world.cookbook.primitives_for(goal_idx):\n      target = nearest(cur_pos, goal_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)   # USE to collect\n      return actions\n\n  # -----------------------------------------------------------------\n  # 2) Collect all required primitive ingredients.\n  # -----------------------------------------------------------------\n  needed_prims = env.world.cookbook.primitives_for(goal_idx)\n  for prim_idx, cnt in needed_prims.items():\n      for _ in range(cnt):\n          target = nearest(cur_pos, prim_idx)\n          if target is None:\n              continue\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n          actions.append(4)   # USE to pick up primitive\n\n  # -----------------------------------------------------------------\n  # 3) Move to the appropriate workshop (if any) and craft the stick.\n  # -----------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  if isinstance(recipe, dict):\n      workshop_idx = recipe.get('_at')\n      # Fallback: some recipes store workshop under a string key other than '_at'\n      if workshop_idx is None:\n          for k, v in recipe.items():\n              if isinstance(k, str) and k != '_at':\n                  workshop_idx = v\n                  break\n\n  if workshop_idx is not None:\n      target = nearest(cur_pos, workshop_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n\n  actions.append(4)   # USE to craft at workshop (or current cell)\n\n  return actions", "env_interactions": 1, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:50:41.326700", "function_name": "make_arrow", "function_body": "  # Get current state (reset if necessary)\n  try:\n      state = env._current_state\n  except AttributeError:\n      env.reset()\n      state = env._current_state\n\n  # Action indices (fallback to default ordering)\n  try:\n      specs = env.action_specs()\n      DOWN = specs[\"DOWN\"]\n      UP = specs[\"UP\"]\n      LEFT = specs[\"LEFT\"]\n      RIGHT = specs[\"RIGHT\"]\n      USE = specs[\"USE\"]\n  except Exception:\n      DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Index for the target item \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      return []  # stick not defined in this world\n\n  # Primitive requirements for a stick (empty dict if stick is primitive)\n  prim_req = env.world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n  grid = state.grid.copy()\n\n  # Mask of non\u2011traversable cells (non\u2011grabbable entities)\n  blocked = np.zeros(grid.shape[:2], dtype=bool)\n  for idx in env.world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # ------------------------------------------------------------------\n  # Helper: BFS shortest path avoiding blocked cells.\n  # Returns a list of action indices moving from start to goal, or None.\n  # ------------------------------------------------------------------\n  def bfs_path(start, goal, blocked_mask):\n      from collections import deque\n\n      dirs = [\n          (1, 0, DOWN),   # down\n          (-1, 0, UP),    # up\n          (0, -1, LEFT),  # left\n          (0, 1, RIGHT),  # right\n      ]\n\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for dx, dy, act in dirs:\n              nx, ny = x + dx, y + dy\n              if (\n                  0 <= nx < blocked_mask.shape[0]\n                  and 0 <= ny < blocked_mask.shape[1]\n                  and not blocked_mask[nx, ny]\n                  and (nx, ny) not in visited\n              ):\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [act]))\n      return None\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # ------------------------------------------------------------------\n  # Case A: stick is a primitive placed directly in the world.\n  # ------------------------------------------------------------------\n  if not prim_req:\n      stick_cells = np.argwhere(grid[:, :, stick_idx] > 0)\n      if stick_cells.size == 0:\n          return []  # no stick to pick up\n      target = tuple(stick_cells[0])\n      if cur_pos != target:\n          path = bfs_path(cur_pos, target, blocked)\n          if path is None:\n              return []  # unreachable\n          actions.extend(path)\n          cur_pos = target\n      actions.append(USE)\n      return actions\n\n  # ------------------------------------------------------------------\n  # Case B: collect required primitives.\n  # ------------------------------------------------------------------\n  needed = dict(prim_req)  # mutable copy of required counts\n  while any(cnt > 0 for cnt in needed.values()):\n      best_path = None\n      best_target = None\n      best_prim = None\n\n      # Find nearest needed primitive that is reachable.\n      for prim_idx, cnt in needed.items():\n          if cnt <= 0:\n              continue\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          for cell in prim_cells:\n              target = tuple(cell)\n              path = bfs_path(cur_pos, target, blocked)\n              if path is None:\n                  continue\n              if best_path is None or len(path) < len(best_path):\n                  best_path = path\n                  best_target = target\n                  best_prim = prim_idx\n\n      if best_path is None:\n          return []  # cannot reach any remaining required primitive\n\n      # Move to the primitive and pick it up.\n      actions.extend(best_path)\n      actions.append(USE)\n\n      # Update planning state.\n      cur_pos = best_target\n      needed[best_prim] -= 1\n      grid[best_target[0], best_target[1], best_prim] = 0  # remove from copy\n\n  # ------------------------------------------------------------------\n  # Case C: move to required workshop (if recipe specifies one).\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      try:\n          workshop_idx = env.world.cookbook.index[workshop_name]\n      except Exception:\n          workshop_idx = None\n      if workshop_idx is not None:\n          ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n          if ws_cells.size > 0:\n              ws_target = tuple(ws_cells[0])\n              if cur_pos != ws_target:\n                  path = bfs_path(cur_pos, ws_target, blocked)\n                  if path is not None:\n                      actions.extend(path)\n                      cur_pos = ws_target\n\n  # ------------------------------------------------------------------\n  # Final crafting action.\n  # ------------------------------------------------------------------\n  actions.append(USE)\n  return actions", "env_interactions": 3, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:50:42.619298", "function_name": "make_arrow", "function_body": "  # Retrieve current state (reset if needed)\n  try:\n      state = env._current_state\n  except AttributeError:\n      env.reset()\n      state = env._current_state\n\n  # --------------------------------------------------------------\n  # Action indices (fallback to default ordering if specs missing)\n  # --------------------------------------------------------------\n  try:\n      specs = env.action_specs()\n      DOWN = specs[\"DOWN\"]\n      UP = specs[\"UP\"]\n      LEFT = specs[\"LEFT\"]\n      RIGHT = specs[\"RIGHT\"]\n      USE = specs[\"USE\"]\n  except Exception:\n      DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # --------------------------------------------------------------\n  # Identify index of the target item \"stick\"\n  # --------------------------------------------------------------\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      return []  # stick not defined in this world\n\n  # --------------------------------------------------------------\n  # Primitive requirements for a stick (empty if stick is primitive)\n  # --------------------------------------------------------------\n  prim_req = env.world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n  grid = state.grid.copy()\n\n  # --------------------------------------------------------------\n  # Build blocked\u2011cell mask (non\u2011grabbable entities are obstacles)\n  # --------------------------------------------------------------\n  blocked = np.zeros(grid.shape[:2], dtype=bool)\n  for idx in env.world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # --------------------------------------------------------------\n  # Helper: BFS shortest path avoiding blocked cells\n  # --------------------------------------------------------------\n  def _bfs_path(start, goal, blocked_mask):\n      from collections import deque\n\n      dirs = [\n          (1, 0, DOWN),   # down\n          (-1, 0, UP),    # up\n          (0, -1, LEFT),  # left\n          (0, 1, RIGHT),  # right\n      ]\n\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for dx, dy, act in dirs:\n              nx, ny = x + dx, y + dy\n              if (\n                  0 <= nx < blocked_mask.shape[0]\n                  and 0 <= ny < blocked_mask.shape[1]\n                  and not blocked_mask[nx, ny]\n                  and (nx, ny) not in visited\n              ):\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [act]))\n      return None\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # --------------------------------------------------------------\n  # Case A: stick is a primitive already placed in the world\n  # --------------------------------------------------------------\n  if not prim_req:\n      stick_cells = np.argwhere(grid[:, :, stick_idx] > 0)\n      if stick_cells.size == 0:\n          return []  # no stick to pick up\n      target = tuple(stick_cells[0])\n      if cur_pos != target:\n          path = _bfs_path(cur_pos, target, blocked)\n          if path is None:\n              return []  # unreachable\n          actions.extend(path)\n          cur_pos = target\n      actions.append(USE)\n      return actions\n\n  # --------------------------------------------------------------\n  # Case B: collect required primitives\n  # --------------------------------------------------------------\n  needed = dict(prim_req)  # mutable copy\n  while any(cnt > 0 for cnt in needed.values()):\n      best_path = None\n      best_target = None\n      best_prim = None\n\n      for prim_idx, cnt in needed.items():\n          if cnt <= 0:\n              continue\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          for cell in prim_cells:\n              target = tuple(cell)\n              path = _bfs_path(cur_pos, target, blocked)\n              if path is None:\n                  continue\n              if best_path is None or len(path) < len(best_path):\n                  best_path = path\n                  best_target = target\n                  best_prim = prim_idx\n\n      if best_path is None:\n          return []  # cannot reach remaining needed primitives\n\n      actions.extend(best_path)\n      actions.append(USE)\n\n      cur_pos = best_target\n      needed[best_prim] -= 1\n      grid[best_target[0], best_target[1], best_prim] = 0  # remove from planning grid\n\n  # --------------------------------------------------------------\n  # Case C: move to required workshop (if recipe specifies one)\n  # --------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      try:\n          workshop_idx = env.world.cookbook.index[workshop_name]\n          ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n          if ws_cells.size > 0:\n              ws_target = tuple(ws_cells[0])\n              if cur_pos != ws_target:\n                  path = _bfs_path(cur_pos, ws_target, blocked)\n                  if path is not None:\n                      actions.extend(path)\n                      cur_pos = ws_target\n      except Exception:\n          pass  # workshop not present; ignore\n\n  # --------------------------------------------------------------\n  # Final crafting action\n  # --------------------------------------------------------------\n  actions.append(USE)\n  return actions", "env_interactions": 3, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:51:08.386188", "function_name": "make_arrow", "function_body": "", "env_interactions": 0, "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-10-23T02:51:09.748031", "function_name": "make_arrow", "function_body": "  # Action indices (consistent with CraftWorld)\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Generate a list of movement actions from start to goal using\n      horizontal then vertical moves (ignores obstacles).\"\"\"\n      y, x = start\n      gy, gx = goal\n      actions = []\n      while x < gx:\n          actions.append(ACTION_RIGHT)\n          x += 1\n      while x > gx:\n          actions.append(ACTION_LEFT)\n          x -= 1\n      while y < gy:\n          actions.append(ACTION_DOWN)\n          y += 1\n      while y > gy:\n          actions.append(ACTION_UP)\n          y -= 1\n      return actions\n\n  def nearest_pos(candidates, ref):\n      \"\"\"Return the candidate position with smallest Manhattan distance to ref.\"\"\"\n      if len(candidates) == 0:\n          return None\n      ref_arr = np.array(ref)\n      dists = np.sum(np.abs(candidates - ref_arr), axis=1)\n      return tuple(candidates[np.argmin(dists)])\n\n  # ------------------------------------------------------------------\n  # Gather current state information\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n\n  # ------------------------------------------------------------------\n  # Identify the stick goal\n  # ------------------------------------------------------------------\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      # Stick not defined in the cookbook\n      return []\n\n  # ------------------------------------------------------------------\n  # Determine recipe (if any) and needed primitives\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  primitives_needed = env.world.cookbook.primitives_for(stick_idx)  # {kind_idx: count}\n\n  plan = []\n\n  # ------------------------------------------------------------------\n  # 1) Collect required primitives for the stick recipe\n  # ------------------------------------------------------------------\n  for prim_idx, required_cnt in primitives_needed.items():\n      while inventory[prim_idx] < required_cnt:\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # No more of this primitive on the map \u2013 abort planning\n              return plan\n          target = nearest_pos(prim_cells, pos)\n\n          # Move to the primitive\n          plan.extend(manhattan_path(pos, target))\n          pos = target\n\n          # Pick it up\n          plan.append(ACTION_USE)\n\n          # Simulate the pick\u2011up locally for further planning\n          inventory[prim_idx] += 1\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # ------------------------------------------------------------------\n  # 2) If the stick itself is a primitive (no recipe), collect it now\n  # ------------------------------------------------------------------\n  if not recipe:  # no crafting required\n      if inventory[stick_idx] == 0:\n          stick_cells = np.argwhere(grid[:, :, stick_idx] > 0)\n          if stick_cells.size > 0:\n              target = nearest_pos(stick_cells, pos)\n              plan.extend(manhattan_path(pos, target))\n              pos = target\n              plan.append(ACTION_USE)\n      return plan\n\n  # ------------------------------------------------------------------\n  # 3) Go to the required workshop and craft the stick\n  # ------------------------------------------------------------------\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      try:\n          workshop_idx = env.world.cookbook.index[workshop_name]\n      except Exception:\n          return plan\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          return plan\n      wcell = tuple(workshop_cells[0])\n\n      # Find a free adjacent cell to stand on (fallback to the workshop cell itself)\n      neighbours = [(wcell[0] + dy, wcell[1] + dx) for dy, dx in\n                    [(1, 0), (-1, 0), (0, 1), (0, -1)]]\n      stand_pos = None\n      for ny, nx in neighbours:\n          if (0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1] and\n                  grid[ny, nx, :].sum() == 0):\n              stand_pos = (ny, nx)\n              break\n      if stand_pos is None:\n          stand_pos = wcell\n\n      # Move to the standing position\n      plan.extend(manhattan_path(pos, stand_pos))\n      pos = stand_pos\n\n      # Use the workshop to craft the stick\n      plan.append(ACTION_USE)\n\n  return plan", "env_interactions": 5, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:51:36.500154", "function_name": "make_arrow", "function_body": "  # Ensure we have a current state\n  try:\n      state = env._current_state\n  except AttributeError:\n      env.reset()\n      state = env._current_state\n\n  world = env.world\n  act_map = env.action_specs()\n  USE = act_map[\"USE\"]\n  DOWN = act_map[\"DOWN\"]\n  UP = act_map[\"UP\"]\n  LEFT = act_map[\"LEFT\"]\n  RIGHT = act_map[\"RIGHT\"]\n\n  # Index of the target item \"stick\"\n  stick_idx = world.cookbook.index[\"stick\"]\n  # Primitive requirements (empty if stick itself is primitive)\n  prim_req = world.cookbook.primitives_for(stick_idx)\n\n  # Working copy of the grid and blocked mask\n  grid = state.grid.copy()\n  blocked = np.zeros(grid.shape[:2], dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # ------------------------------------------------------------------\n  # Bread\u2011first\u2011search returning a list of actions from start to goal\n  # ------------------------------------------------------------------\n  def bfs_path(start, goal):\n      from collections import deque\n\n      dirs = [\n          (1, 0, DOWN),   # DOWN increases row index\n          (-1, 0, UP),    # UP decreases row index\n          (0, -1, LEFT),  # LEFT decreases column index\n          (0, 1, RIGHT),  # RIGHT increases column index\n      ]\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for dx, dy, a in dirs:\n              nx, ny = x + dx, y + dy\n              if (\n                  0 <= nx < blocked.shape[0]\n                  and 0 <= ny < blocked.shape[1]\n                  and not blocked[nx, ny]\n                  and (nx, ny) not in visited\n              ):\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [a]))\n      return None  # unreachable\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # ------------------------------------------------------------------\n  # If stick is a primitive, just go pick it up\n  # ------------------------------------------------------------------\n  if not prim_req:\n      stick_cells = np.argwhere(grid[:, :, stick_idx] > 0)\n      if stick_cells.size == 0:\n          return []  # no stick present\n      target = tuple(stick_cells[0])\n      if cur_pos != target:\n          path = bfs_path(cur_pos, target)\n          if path is None:\n              return []  # unreachable\n          actions.extend(path)\n          cur_pos = target\n      actions.append(USE)\n      return actions\n\n  # ------------------------------------------------------------------\n  # Collect required primitives\n  # ------------------------------------------------------------------\n  needed = dict(prim_req)  # mutable copy of counts\n\n  while any(cnt > 0 for cnt in needed.values()):\n      best_path = None\n      best_target = None\n      best_kind = None\n\n      # Look for the closest reachable needed primitive\n      for kind_idx, cnt in needed.items():\n          if cnt <= 0:\n              continue\n          cells = np.argwhere(grid[:, :, kind_idx] > 0)\n          for cell in cells:\n              tgt = tuple(cell)\n              path = bfs_path(cur_pos, tgt)\n              if path is None:\n                  continue\n              if best_path is None or len(path) < len(best_path):\n                  best_path = path\n                  best_target = tgt\n                  best_kind = kind_idx\n\n      if best_path is None:\n          # No more reachable needed primitives\n          return actions\n\n      # Move to the primitive and pick it up\n      actions.extend(best_path)\n      actions.append(USE)\n\n      # Update planning state\n      cur_pos = best_target\n      needed[best_kind] -= 1\n      grid[best_target[0], best_target[1], best_kind] = 0  # remove from copy\n\n  # ------------------------------------------------------------------\n  # Go to the workshop (if recipe specifies one)\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          target = tuple(workshop_cells[0])\n          if cur_pos != target:\n              path = bfs_path(cur_pos, target)\n              if path is not None:\n                  actions.extend(path)\n                  cur_pos = target\n\n  # ------------------------------------------------------------------\n  # Craft the stick\n  # ------------------------------------------------------------------\n  actions.append(USE)\n  return actions", "env_interactions": 3, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:51:37.821287", "function_name": "make_arrow", "function_body": "  # Ensure we have a current state\n  try:\n      state = env._current_state\n  except AttributeError:\n      env.reset()\n      state = env._current_state\n\n  world = env.world\n  act_map = env.action_specs()\n  USE = act_map[\"USE\"]\n  DOWN = act_map.get(\"DOWN\", 0)\n  UP = act_map.get(\"UP\", 1)\n  LEFT = act_map.get(\"LEFT\", 2)\n  RIGHT = act_map.get(\"RIGHT\", 3)\n\n  # Index of the target item\n  stick_idx = world.cookbook.index[\"stick\"]\n  # Primitive requirements for a stick (empty if stick itself is primitive)\n  prim_req = world.cookbook.primitives_for(stick_idx)\n\n  # Planning copies of grid and blocked cells\n  grid = state.grid.copy()\n  blocked = np.zeros(grid.shape[:2], dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # ------------------------------------------------------------------\n  # Helper: breadth\u2011first search returning a list of actions\n  # ------------------------------------------------------------------\n  def bfs(start, goal):\n      from collections import deque\n\n      directions = [\n          (1, 0, DOWN),   # down\n          (-1, 0, UP),    # up\n          (0, 1, RIGHT),  # right\n          (0, -1, LEFT),  # left\n      ]\n\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for dx, dy, a in directions:\n              nx, ny = x + dx, y + dy\n              if (\n                  0 <= nx < blocked.shape[0]\n                  and 0 <= ny < blocked.shape[1]\n                  and not blocked[nx, ny]\n                  and (nx, ny) not in visited\n              ):\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [a]))\n      return None\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # ------------------------------------------------------------------\n  # Case 1: stick is a primitive already placed in the world\n  # ------------------------------------------------------------------\n  if not prim_req:\n      cells = np.argwhere(grid[:, :, stick_idx] > 0)\n      if cells.size == 0:\n          return actions\n      target = tuple(cells[0])\n      if cur_pos != target:\n          path = bfs(cur_pos, target)\n          if path is None:\n              return actions\n          actions.extend(path)\n      actions.append(USE)\n      return actions\n\n  # ------------------------------------------------------------------\n  # Case 2: collect required primitives\n  # ------------------------------------------------------------------\n  needed = dict(prim_req)  # mutable copy\n\n  while any(cnt > 0 for cnt in needed.values()):\n      best_path = None\n      best_target = None\n      best_prim = None\n\n      for prim_idx, cnt in needed.items():\n          if cnt <= 0:\n              continue\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          for cell in prim_cells:\n              target = tuple(cell)\n              path = bfs(cur_pos, target)\n              if path is None:\n                  continue\n              if best_path is None or len(path) < len(best_path):\n                  best_path = path\n                  best_target = target\n                  best_prim = prim_idx\n\n      if best_path is None:\n          # No reachable required primitive left\n          break\n\n      actions.extend(best_path)\n      actions.append(USE)\n\n      # Update planning state\n      cur_pos = best_target\n      needed[best_prim] -= 1\n      grid[best_target[0], best_target[1], best_prim] = 0\n\n  # ------------------------------------------------------------------\n  # Case 3: move to workshop if recipe specifies one\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          target = tuple(workshop_cells[0])\n          if cur_pos != target:\n              path = bfs(cur_pos, target)\n              if path is not None:\n                  actions.extend(path)\n                  cur_pos = target\n\n  # ------------------------------------------------------------------\n  # Finally, craft the stick\n  # ------------------------------------------------------------------\n  actions.append(USE)\n  return actions", "env_interactions": 3, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:51:53.971311", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n\n  # Action identifiers\n  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act[\"DOWN\"], act[\"UP\"], act[\"LEFT\"], act[\"RIGHT\"], act[\"USE\"]\n  )\n\n  # Index for the primitive \"stick\"\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # Find all cells that contain a stick\n  stick_cells = np.argwhere(state.grid[:, :, stick_idx] > 0)\n  if stick_cells.size == 0:\n      # No sticks present on the map\n      return []\n\n  # Grid dimensions\n  width, height = state.grid.shape[:2]\n\n  # Set of non\u2011grabbable entity indices (obstacles)\n  non_grabbable = world.non_grabbable_indices\n\n  def traversable(pos):\n      \"\"\"Return True if the agent can step on the given position.\"\"\"\n      x, y = pos\n      if not (0 <= x < width and 0 <= y < height):\n          return False\n      # Position is blocked if any non\u2011grabbable entity occupies it\n      for idx in non_grabbable:\n          if state.grid[x, y, idx] > 0:\n              return False\n      return True\n\n  start = tuple(state.pos)\n  target_set = {tuple(cell) for cell in stick_cells}\n\n  # Breadth\u2011first search to the nearest reachable stick\n  queue = collections.deque([start])\n  visited = {start: None}  # maps position -> (prev_position, action_to_here)\n  goal = None\n\n  while queue:\n      cur = queue.popleft()\n      if cur in target_set:\n          goal = cur\n          break\n      x, y = cur\n      for nx, ny, a_code in [(x + 1, y, DOWN), (x - 1, y, UP),\n                             (x, y + 1, RIGHT), (x, y - 1, LEFT)]:\n          nxt = (nx, ny)\n          if nxt not in visited and traversable(nxt):\n              visited[nxt] = (cur, a_code)\n              queue.append(nxt)\n\n  if goal is None:\n      # No reachable stick found\n      return []\n\n  # Reconstruct the action sequence from start to the goal cell\n  actions = []\n  cur = goal\n  while visited[cur] is not None:\n      prev, a_code = visited[cur]\n      actions.append(a_code)\n      cur = prev\n  actions.reverse()  # now actions go from start to goal\n\n  # Finally, use the stick\n  actions.append(USE)\n  return actions", "env_interactions": 0, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:51:55.391421", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n\n  # action indices\n  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act[\"DOWN\"], act[\"UP\"], act[\"LEFT\"], act[\"RIGHT\"], act[\"USE\"]\n  )\n\n  # index of the primitive \"stick\"\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # locate all cells that currently contain a stick\n  stick_cells = np.argwhere(state.grid[:, :, stick_idx] > 0)\n  if stick_cells.size == 0:\n      # no sticks present in the world\n      return []\n\n  # grid dimensions\n  width, height = state.grid.shape[:2]\n  non_grabbable = world.non_grabbable_indices\n\n  def traversable(pos):\n      \"\"\"Return True if the agent can stand on `pos`.\"\"\"\n      x, y = pos\n      if not (0 <= x < width and 0 <= y < height):\n          return False\n      # cell must not contain any non\u2011grabbable entity\n      for idx in non_grabbable:\n          if state.grid[x, y, idx] > 0:\n              return False\n      return True\n\n  start = tuple(state.pos)\n  target_set = {tuple(cell) for cell in stick_cells}\n\n  # BFS to find the shortest path to any stick cell\n  queue = collections.deque([start])\n  visited = {start: None}   # maps position -> (prev_position, action_to_here)\n  goal = None\n\n  while queue:\n      cur = queue.popleft()\n      if cur in target_set:\n          goal = cur\n          break\n      x, y = cur\n      for nx, ny, a_code in [(x + 1, y, DOWN), (x - 1, y, UP),\n                             (x, y + 1, RIGHT), (x, y - 1, LEFT)]:\n          nxt = (nx, ny)\n          if nxt not in visited and traversable(nxt):\n              visited[nxt] = (cur, a_code)\n              queue.append(nxt)\n\n  if goal is None:\n      # no reachable stick found\n      return []\n\n  # reconstruct action sequence from start to goal\n  actions = []\n  cur = goal\n  while visited[cur] is not None:\n      prev, a_code = visited[cur]\n      actions.append(a_code)\n      cur = prev\n  actions.reverse()\n\n  # finally pick up the stick\n  actions.append(USE)\n  return actions", "env_interactions": 0, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:52:15.208671", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n  stick_idx = world.cookbook.index['stick']\n\n  # ---------- helper utilities ----------\n  def move_to(tx, ty, pos, act_list):\n      \"\"\"Append moves that bring the agent from pos to (tx, ty).\"\"\"\n      x, y = pos\n      while x < tx:\n          act_list.append(3)   # RIGHT\n          x += 1\n      while x > tx:\n          act_list.append(2)   # LEFT\n          x -= 1\n      while y < ty:\n          act_list.append(0)   # DOWN\n          y += 1\n      while y > ty:\n          act_list.append(1)   # UP\n          y -= 1\n      return (x, y)\n\n  def nearest_pos(kind_idx, cur_pos):\n      \"\"\"Return the coordinates of the nearest cell containing kind_idx.\"\"\"\n      positions = np.argwhere(state.grid[:, :, kind_idx] > 0)\n      if positions.size == 0:\n          return None\n      dists = np.abs(positions[:, 0] - cur_pos[0]) + np.abs(positions[:, 1] - cur_pos[1])\n      best = positions[dists.argmin()]\n      return (int(best[0]), int(best[1]))\n\n  def go_and_pick(kind_idx, cur_pos, act_list):\n      \"\"\"Move to a cell with kind_idx and USE it.\"\"\"\n      target = nearest_pos(kind_idx, cur_pos)\n      if target is None:\n          return cur_pos, False\n      cur_pos = move_to(target[0], target[1], cur_pos, act_list)\n      act_list.append(4)               # USE / pick up / interact\n      return cur_pos, True\n  # ---------------------------------------\n\n  actions = []\n  cur_pos = state.pos\n\n  # ----- case 1: stick is a primitive (just collect it) -----\n  if stick_idx in world.cookbook.primitives:\n      cur_pos, ok = go_and_pick(stick_idx, cur_pos, actions)\n      return actions if ok else []\n\n  # ----- case 2: stick must be crafted -----------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get('_at', None)\n\n  # collect all non\u2011workshop ingredients\n  for ing_key, cnt in recipe.items():\n      if ing_key == '_at':\n          continue\n      ing_idx = ing_key if isinstance(ing_key, int) else world.cookbook.index[ing_key]\n      for _ in range(cnt):\n          cur_pos, ok = go_and_pick(ing_idx, cur_pos, actions)\n          if not ok:\n              return []                     # cannot satisfy the recipe\n\n  # move to workshop (if required) before crafting\n  if workshop_name is not None:\n      ws_idx = world.cookbook.index[workshop_name]\n      cur_pos, ok = go_and_pick(ws_idx, cur_pos, actions)\n      if not ok:\n          return []                         # workshop not found\n\n  # finally craft the stick\n  actions.append(4)                           # USE to craft\n  return actions", "env_interactions": 5, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:52:16.486141", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n  stick_idx = world.cookbook.index['stick']\n\n  # ---------- helper utilities ----------\n  def move_to(tx, ty, pos, act_list):\n      \"\"\"Append moves that bring the agent from pos to (tx, ty).\"\"\"\n      x, y = pos\n      while x < tx:\n          act_list.append(3)   # RIGHT\n          x += 1\n      while x > tx:\n          act_list.append(2)   # LEFT\n          x -= 1\n      while y < ty:\n          act_list.append(0)   # DOWN\n          y += 1\n      while y > ty:\n          act_list.append(1)   # UP\n          y -= 1\n      return (x, y)\n\n  def nearest_pos(kind_idx, cur_pos):\n      \"\"\"Return the coordinates of the nearest cell containing kind_idx.\"\"\"\n      positions = np.argwhere(state.grid[:, :, kind_idx] > 0)\n      if positions.size == 0:\n          return None\n      dists = np.abs(positions[:, 0] - cur_pos[0]) + np.abs(positions[:, 1] - cur_pos[1])\n      best = positions[dists.argmin()]\n      return (int(best[0]), int(best[1]))\n\n  def go_and_pick(kind_idx, cur_pos, act_list):\n      \"\"\"Move to a cell with kind_idx and USE it.\"\"\"\n      target = nearest_pos(kind_idx, cur_pos)\n      if target is None:\n          return cur_pos, False\n      cur_pos = move_to(target[0], target[1], cur_pos, act_list)\n      act_list.append(4)               # USE / pick up / interact\n      return cur_pos, True\n  # ---------------------------------------\n\n  actions = []\n  cur_pos = state.pos\n\n  # ----- case 1: stick is a primitive (just collect it) -----\n  if stick_idx in world.cookbook.primitives:\n      cur_pos, ok = go_and_pick(stick_idx, cur_pos, actions)\n      return actions if ok else []\n\n  # ----- case 2: stick must be crafted -----------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get('_at', None)\n\n  # collect all non\u2011workshop ingredients\n  for ing_key, cnt in recipe.items():\n      if ing_key == '_at':\n          continue\n      ing_idx = ing_key if isinstance(ing_key, int) else world.cookbook.index[ing_key]\n      for _ in range(cnt):\n          cur_pos, ok = go_and_pick(ing_idx, cur_pos, actions)\n          if not ok:\n              return []                     # cannot satisfy the recipe\n\n  # move to workshop (if required) before crafting\n  if workshop_name is not None:\n      ws_idx = world.cookbook.index[workshop_name]\n      cur_pos, ok = go_and_pick(ws_idx, cur_pos, actions)\n      if not ok:\n          return []                         # workshop not found\n\n  # finally craft the stick\n  actions.append(4)                           # USE to craft\n  return actions", "env_interactions": 5, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:52:37.191623", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  goal_idx = env.task.goal\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # Helper to locate all cells containing a given kind\n  def find_positions(kind):\n      locs = np.argwhere(state.grid[:, :, kind] > 0)\n      return [tuple(p) for p in locs]\n\n  # Nearest position (Manhattan distance) of a kind from a given location\n  def nearest(pos, kind):\n      positions = find_positions(kind)\n      if not positions:\n          return None\n      return min(positions, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n\n  # Convert a source\u2013destination pair into a list of movement actions\n  # (DOWN=0, UP=1, LEFT=2, RIGHT=3)\n  def moves_to(src, dst):\n      sx, sy = src\n      dx, dy = dst\n      seq = []\n      while sx < dx:\n          seq.append(0)  # DOWN\n          sx += 1\n      while sx > dx:\n          seq.append(1)  # UP\n          sx -= 1\n      while sy < dy:\n          seq.append(3)  # RIGHT\n          sy += 1\n      while sy > dy:\n          seq.append(2)  # LEFT\n          sy -= 1\n      return seq\n\n  # -----------------------------------------------------------------\n  # 1) If the goal is a primitive, just move to it and pick it up.\n  # -----------------------------------------------------------------\n  if not env.world.cookbook.primitives_for(goal_idx):\n      target = nearest(cur_pos, goal_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)  # USE\n      return actions\n\n  # -----------------------------------------------------------------\n  # 2) Collect all required primitive ingredients.\n  # -----------------------------------------------------------------\n  needed_prims = env.world.cookbook.primitives_for(goal_idx)\n  for prim_idx, count in needed_prims.items():\n      for _ in range(count):\n          target = nearest(cur_pos, prim_idx)\n          if target is None:\n              continue  # primitive not found; skip\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n          actions.append(4)  # USE to collect\n\n  # -----------------------------------------------------------------\n  # 3) Move to the appropriate workshop (if any) and craft the item.\n  # -----------------------------------------------------------------\n  workshop_idx = None\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  for key, val in recipe.items():\n      if isinstance(key, str):\n          workshop_idx = val\n          break\n\n  if workshop_idx is not None:\n      target = nearest(cur_pos, workshop_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)  # USE to craft at workshop\n\n  return actions", "env_interactions": 1, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:52:38.471036", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  goal_idx = env.task.goal\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  def find_positions(kind):\n      locs = np.argwhere(state.grid[:, :, kind] > 0)\n      return [tuple(p) for p in locs]\n\n  def nearest(pos, kind):\n      positions = find_positions(kind)\n      if not positions:\n          return None\n      return min(positions, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n\n  def moves_to(src, dst):\n      sx, sy = src\n      dx, dy = dst\n      seq = []\n      while sx < dx:\n          seq.append(0)   # DOWN\n          sx += 1\n      while sx > dx:\n          seq.append(1)   # UP\n          sx -= 1\n      while sy < dy:\n          seq.append(3)   # RIGHT\n          sy += 1\n      while sy > dy:\n          seq.append(2)   # LEFT\n          sy -= 1\n      return seq\n\n  # -----------------------------------------------------------------\n  # 1) Primitive goal \u2013 just go to it and pick it up.\n  # -----------------------------------------------------------------\n  if not env.world.cookbook.primitives_for(goal_idx):\n      target = nearest(cur_pos, goal_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)   # USE\n      return actions\n\n  # -----------------------------------------------------------------\n  # 2) Collect required primitive ingredients.\n  # -----------------------------------------------------------------\n  needed_prims = env.world.cookbook.primitives_for(goal_idx)\n  for prim_idx, count in needed_prims.items():\n      for _ in range(count):\n          target = nearest(cur_pos, prim_idx)\n          if target is None:\n              continue    # primitive not found; skip\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n          actions.append(4)   # USE to pick up\n\n  # -----------------------------------------------------------------\n  # 3) Move to workshop (if any) and craft the item.\n  # -----------------------------------------------------------------\n  workshop_idx = None\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  for key, val in recipe.items():\n      if isinstance(key, str):\n          workshop_idx = val\n          break\n\n  if workshop_idx is not None:\n      target = nearest(cur_pos, workshop_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)   # USE to craft\n\n  return actions", "env_interactions": 1, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:53:05.406816", "function_name": "make_arrow", "function_body": "  _ACTION_DELTAS = {\n      0: (1, 0),   # DOWN\n      1: (-1, 0),  # UP\n      2: (0, -1),  # LEFT\n      3: (0, 1),   # RIGHT\n  }\n\n  def _move_actions(start, goal):\n      y, x = start\n      gy, gx = goal\n      actions = []\n      while y < gy:\n          actions.append(0)  # DOWN\n          y += 1\n      while y > gy:\n          actions.append(1)  # UP\n          y -= 1\n      while x < gx:\n          actions.append(3)  # RIGHT\n          x += 1\n      while x > gx:\n          actions.append(2)  # LEFT\n          x -= 1\n      return actions\n\n  # ----------------------------------------------------------------------\n  # locate the CraftWorld instance inside the supplied env\n  # ----------------------------------------------------------------------\n  if hasattr(env, \"world\"):\n      world = env.world\n  elif hasattr(env, \"scenario\"):\n      world = env.scenario.world\n  else:\n      raise AttributeError(\"Cannot locate CraftWorld instance in the supplied env.\")\n\n  # ----------------------------------------------------------------------\n  # identify the goal (stick) and its recipe\n  # ----------------------------------------------------------------------\n  goal_name = \"stick\"\n  goal_idx = world.cookbook.index.index(goal_name)\n\n  # primitives required to craft a stick (may be empty if stick is primitive)\n  needed = world.cookbook.primitives_for(goal_idx)\n\n  # ----------------------------------------------------------------------\n  # obtain current state (position and grid) for planning\n  # ----------------------------------------------------------------------\n  if hasattr(env, \"_current_state\"):\n      state = env._current_state\n  else:\n      state = env.scenario.init()\n\n  cur_pos = tuple(state.pos)          # (row, col)\n  grid = state.grid.copy()            # copy to allow planning updates\n\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # collect each required primitive the needed number of times\n  # ----------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(\n                  f\"Primitive {world.cookbook.index.get(prim_idx)} not found on the grid.\"\n              )\n          py, px = prim_cells[0]\n\n          # find an empty neighbour cell from which we can face the primitive\n          target_cell = None\n          for d, (dy, dx) in _ACTION_DELTAS.items():\n              ny, nx = py - dy, px - dx\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  if not grid[ny, nx, :].any():\n                      target_cell = (ny, nx)\n                      break\n          if target_cell is None:\n              raise RuntimeError(\"No reachable empty neighbour around required primitive.\")\n\n          # move to that neighbour\n          actions.extend(_move_actions(cur_pos, target_cell))\n          cur_pos = target_cell\n\n          # use the primitive (the agent is already facing it)\n          actions.append(4)   # USE\n\n          # update planning grid: primitive consumed\n          grid[py, px, prim_idx] = 0\n\n  # ----------------------------------------------------------------------\n  # move to the workshop (if any) and craft the stick\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_cells.size == 0:\n          raise RuntimeError(f\"Workshop {workshop_name} not found on the grid.\")\n      wy, wx = ws_cells[0]\n\n      # find empty neighbour to face the workshop\n      target_cell = None\n      for d, (dy, dx) in _ACTION_DELTAS.items():\n          ny, nx = wy - dy, wx - dx\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not grid[ny, nx, :].any():\n                  target_cell = (ny, nx)\n                  break\n      if target_cell is None:\n          raise RuntimeError(\"No reachable empty neighbour around workshop.\")\n\n      actions.extend(_move_actions(cur_pos, target_cell))\n      cur_pos = target_cell\n\n      # craft by using the workshop\n      actions.append(4)   # USE\n\n  # ----------------------------------------------------------------------\n  # return the full action sequence\n  # ----------------------------------------------------------------------\n  return actions", "env_interactions": 5, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:53:06.740946", "function_name": "make_arrow", "function_body": "  # Mapping from action index to (dy, dx) movement deltas\n  _ACTION_DELTAS = {\n      0: (1, 0),   # DOWN\n      1: (-1, 0),  # UP\n      2: (0, -1),  # LEFT\n      3: (0, 1),   # RIGHT\n  }\n\n  def _move_actions(start, goal):\n      \"\"\"Return a list of actions that moves the agent from start to goal\n      using simple Manhattan moves (no obstacles considered).\"\"\"\n      y, x = start\n      gy, gx = goal\n      actions = []\n      while y < gy:\n          actions.append(0)   # DOWN\n          y += 1\n      while y > gy:\n          actions.append(1)   # UP\n          y -= 1\n      while x < gx:\n          actions.append(3)   # RIGHT\n          x += 1\n      while x > gx:\n          actions.append(2)   # LEFT\n          x -= 1\n      return actions\n\n  # ----------------------------------------------------------------------\n  # Locate the CraftWorld instance inside the supplied env\n  # ----------------------------------------------------------------------\n  if hasattr(env, \"world\"):\n      world = env.world\n  elif hasattr(env, \"scenario\"):\n      world = env.scenario.world\n  else:\n      raise AttributeError(\"Cannot locate CraftWorld instance in the supplied env.\")\n\n  # ----------------------------------------------------------------------\n  # Identify the goal (stick) and its recipe\n  # ----------------------------------------------------------------------\n  goal_name = \"stick\"\n  goal_idx = world.cookbook.index.index(goal_name)\n\n  # Primitives required to craft a stick (empty if stick is primitive)\n  needed = world.cookbook.primitives_for(goal_idx)\n\n  # ----------------------------------------------------------------------\n  # Obtain current state (position and grid) for planning\n  # ----------------------------------------------------------------------\n  if hasattr(env, \"_current_state\"):\n      state = env._current_state\n  else:\n      state = env.scenario.init()\n\n  cur_pos = tuple(state.pos)               # (row, col)\n  grid = state.grid.copy()                  # planning copy\n\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive the needed number of times\n  # ----------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(\n                  f\"Primitive {world.cookbook.index.get(prim_idx)} not found on the grid.\"\n              )\n          py, px = prim_cells[0]\n\n          # Find an empty neighbour cell from which we can face the primitive\n          target_cell = None\n          for d, (dy, dx) in _ACTION_DELTAS.items():\n              ny, nx = py - dy, px - dx\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  if not grid[ny, nx, :].any():\n                      target_cell = (ny, nx)\n                      break\n          if target_cell is None:\n              raise RuntimeError(\"No reachable empty neighbour around required primitive.\")\n\n          # Move to that neighbour\n          actions.extend(_move_actions(cur_pos, target_cell))\n          cur_pos = target_cell\n\n          # Use the primitive (the agent is already facing it)\n          actions.append(4)   # USE\n\n          # Update planning grid: primitive consumed\n          grid[py, px, prim_idx] = 0\n\n  # ----------------------------------------------------------------------\n  # If the recipe requires a workshop, move to it and craft the stick\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_cells.size == 0:\n          raise RuntimeError(f\"Workshop {workshop_name} not found on the grid.\")\n      wy, wx = ws_cells[0]\n\n      # Find an empty neighbour to face the workshop\n      target_cell = None\n      for d, (dy, dx) in _ACTION_DELTAS.items():\n          ny, nx = wy - dy, wx - dx\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not grid[ny, nx, :].any():\n                  target_cell = (ny, nx)\n                  break\n      if target_cell is None:\n          raise RuntimeError(\"No reachable empty neighbour around workshop.\")\n\n      actions.extend(_move_actions(cur_pos, target_cell))\n      cur_pos = target_cell\n\n      # Craft by using the workshop\n      actions.append(4)   # USE\n\n  # ----------------------------------------------------------------------\n  # Return the complete action sequence\n  # ----------------------------------------------------------------------\n  return actions", "env_interactions": 5, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:53:19.944442", "function_name": "make_arrow", "function_body": "  actions = []\n  state = env._current_state\n  grid = state.grid\n  world = env.world\n  cb = world.cookbook\n\n  # index for the target item \"stick\"\n  try:\n      goal_idx = cb.index[\"stick\"]\n  except Exception:\n      return actions\n\n  # primitives required to craft a stick (primitive_index -> count)\n  prims = cb.primitives_for(goal_idx)\n\n  # mutable copy of the agent's current position (x, y)\n  pos = list(state.pos)\n\n  # helper to move the agent using Manhattan steps\n  def _move_to(target):\n      nonlocal pos, actions\n      tx, ty = target\n      # move in x direction (RIGHT=3, LEFT=2)\n      while pos[0] < tx:\n          actions.append(3)   # RIGHT\n          pos[0] += 1\n      while pos[0] > tx:\n          actions.append(2)   # LEFT\n          pos[0] -= 1\n      # move in y direction (DOWN=0, UP=1)\n      while pos[1] < ty:\n          actions.append(0)   # DOWN\n          pos[1] += 1\n      while pos[1] > ty:\n          actions.append(1)   # UP\n          pos[1] -= 1\n\n  # collect each required primitive\n  for prim_idx, needed in prims.items():\n      locations = np.argwhere(grid[:, :, prim_idx] > 0)\n      if locations.size == 0:\n          continue  # primitive not present; skip\n      target = locations[0].tolist()  # take first occurrence\n      _move_to(target)\n      for _ in range(needed):\n          actions.append(4)   # USE to pick up\n\n  # if the recipe specifies a workshop, move there and craft the stick\n  recipe = cb.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = cb.index[workshop_name]\n      w_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if w_locs.size:\n          w_target = w_locs[0].tolist()\n          _move_to(w_target)\n          actions.append(4)   # USE to craft at workshop\n\n  return actions", "env_interactions": 4, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:53:21.228677", "function_name": "make_arrow", "function_body": "  actions = []\n  state = env._current_state\n  grid = state.grid\n  world = env.world\n  cb = world.cookbook\n\n  # target index for \"stick\"\n  try:\n      goal_idx = cb.index[\"stick\"]\n  except Exception:\n      return actions\n\n  # primitives (and required counts) needed to craft a stick\n  prims = cb.primitives_for(goal_idx)\n\n  # mutable copy of the agent's current position (x, y)\n  pos = list(state.pos)\n\n  # helper to move the agent to a target cell using Manhattan moves\n  def _move_to(target):\n      nonlocal pos, actions\n      tx, ty = target\n      # move in x direction (RIGHT=3, LEFT=2)\n      while pos[0] < tx:\n          actions.append(3)   # RIGHT\n          pos[0] += 1\n      while pos[0] > tx:\n          actions.append(2)   # LEFT\n          pos[0] -= 1\n      # move in y direction (DOWN=0, UP=1)\n      while pos[1] < ty:\n          actions.append(0)   # DOWN\n          pos[1] += 1\n      while pos[1] > ty:\n          actions.append(1)   # UP\n          pos[1] -= 1\n\n  # collect each required primitive\n  for prim_idx, needed in prims.items():\n      # find all cells containing this primitive\n      locations = np.argwhere(grid[:, :, prim_idx] > 0)\n      if locations.size == 0:\n          continue  # primitive not present; skip (should not happen)\n      # choose the first occurrence as the target\n      target = locations[0].tolist()\n      _move_to(target)\n      # pick up the required amount\n      for _ in range(needed):\n          actions.append(4)   # USE\n\n  # if the recipe specifies a workshop, move there and craft the stick\n  recipe = cb.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = cb.index[workshop_name]\n      w_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if w_locs.size:\n          w_target = w_locs[0].tolist()\n          _move_to(w_target)\n          actions.append(4)   # USE to craft at the workshop\n\n  return actions", "env_interactions": 4, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:53:55.333105", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  grid = state.grid\n  width, height = grid.shape[:2]\n\n  # movement vectors and mapping to action IDs\n  dirs = [(0, 1), (0, -1), (-1, 0), (1, 0)]          # DOWN, UP, LEFT, RIGHT\n  dir_action = {(0, 1): 0, (0, -1): 1, (-1, 0): 2, (1, 0): 3}\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # helper utilities\n  # ------------------------------------------------------------------\n  def find_cells(kind):\n      xs, ys = np.where(grid[:, :, kind] > 0)\n      return list(zip(xs, ys))\n\n  from collections import deque\n\n  def bfs(start, goal):\n      \"\"\"Return a list of (dx,dy) moves from start to goal on free cells.\"\"\"\n      q = deque([start])\n      visited = {start}\n      prev = {}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          x, y = cur\n          for dx, dy in dirs:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height:\n                  if (nx, ny) not in visited and not np.any(grid[nx, ny, :]):\n                      visited.add((nx, ny))\n                      prev[(nx, ny)] = (cur, (dx, dy))\n                      q.append((nx, ny))\n      if start == goal:\n          return []\n      if goal not in prev:\n          return []          # no path found\n      # reconstruct path\n      path = []\n      cur = goal\n      while cur != start:\n          pnode, move = prev[cur]\n          path.append(move)\n          cur = pnode\n      path.reverse()\n      return path\n\n  # ------------------------------------------------------------------\n  # Identify the recipe for a stick\n  # ------------------------------------------------------------------\n  stick_idx = env.world.cookbook.index[\"stick\"]\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  primitive_needs = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the needed number of times\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          prim_cells = find_cells(prim_idx)\n          if not prim_cells:\n              continue\n          tx, ty = prim_cells[0]\n\n          # try to stand on a free neighbour opposite the primitive\n          neighbour_found = False\n          for dx, dy in dirs:\n              nx, ny = tx - dx, ty - dy\n              if 0 <= nx < width and 0 <= ny < height and not np.any(grid[nx, ny, :]):\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  # face the primitive\n                  actions.append(dir_action[(-dx, -dy)])\n                  state.dir = dir_action[(-dx, -dy)]\n                  actions.append(4)          # USE\n                  neighbour_found = True\n                  break\n\n          if not neighbour_found:\n              # fallback: any adjacent free cell, then turn towards primitive\n              for dx, dy in dirs:\n                  nx, ny = tx + dx, ty + dy\n                  if 0 <= nx < width and 0 <= ny < height and not np.any(grid[nx, ny, :]):\n                      path = bfs(state.pos, (nx, ny))\n                      for mv in path:\n                          actions.append(dir_action[mv])\n                          state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                          state.dir = dir_action[mv]\n                      actions.append(dir_action[(-dx, -dy)])\n                      state.dir = dir_action[(-dx, -dy)]\n                      actions.append(4)          # USE\n                      break\n\n  # ------------------------------------------------------------------\n  # If the recipe specifies a workshop, go there and craft the stick\n  # ------------------------------------------------------------------\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      workshop_cells = find_cells(workshop_idx)\n      if workshop_cells:\n          wx, wy = workshop_cells[0]\n          for dx, dy in dirs:\n              nx, ny = wx - dx, wy - dy\n              if 0 <= nx < width and 0 <= ny < height and not np.any(grid[nx, ny, :]):\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  actions.append(4)          # USE to craft the stick\n                  break\n\n  return actions", "env_interactions": 8, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-23T02:53:56.662813", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  grid = state.grid\n  width, height = grid.shape[:2]\n\n  # movement directions and mapping to action ids\n  dirs = [(0, 1), (0, -1), (-1, 0), (1, 0)]          # DOWN, UP, LEFT, RIGHT\n  dir_action = {(0, 1): 0, (0, -1): 1, (-1, 0): 2, (1, 0): 3}\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # helper functions\n  # ------------------------------------------------------------------\n  def find_cells(kind):\n      xs, ys = np.where(grid[:, :, kind] > 0)\n      return list(zip(xs.tolist(), ys.tolist()))\n\n  from collections import deque\n\n  def bfs(start, goal):\n      \"\"\"Return a list of (dx,dy) moves from start to goal on free cells.\"\"\"\n      q = deque([start])\n      visited = {start}\n      prev = {}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          x, y = cur\n          for dx, dy in dirs:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height:\n                  if (nx, ny) not in visited and not np.any(grid[nx, ny, :]):\n                      visited.add((nx, ny))\n                      prev[(nx, ny)] = (cur, (dx, dy))\n                      q.append((nx, ny))\n      if start == goal:\n          return []\n      if goal not in prev:\n          return []          # no path found\n      # reconstruct path\n      path = []\n      cur = goal\n      while cur != start:\n          pnode, move = prev[cur]\n          path.append(move)\n          cur = pnode\n      path.reverse()\n      return path\n\n  # ------------------------------------------------------------------\n  # Identify the recipe for a stick\n  # ------------------------------------------------------------------\n  stick_idx = env.world.cookbook.index[\"stick\"]\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  primitive_needs = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the needed number of times\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          prim_cells = find_cells(prim_idx)\n          if not prim_cells:\n              continue\n          tx, ty = prim_cells[0]\n\n          # try to stand on a free neighbour opposite the direction we will face\n          neighbour_found = False\n          for dx, dy in dirs:\n              nx, ny = tx - dx, ty - dy\n              if 0 <= nx < width and 0 <= ny < height and not np.any(grid[nx, ny, :]):\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  # face the primitive\n                  actions.append(dir_action[(-dx, -dy)])\n                  state.dir = dir_action[(-dx, -dy)]\n                  # pick it up\n                  actions.append(4)          # USE\n                  neighbour_found = True\n                  break\n          if not neighbour_found:\n              # fallback: any adjacent free cell\n              for dx, dy in dirs:\n                  nx, ny = tx + dx, ty + dy\n                  if 0 <= nx < width and 0 <= ny < height and not np.any(grid[nx, ny, :]):\n                      path = bfs(state.pos, (nx, ny))\n                      for mv in path:\n                          actions.append(dir_action[mv])\n                          state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                          state.dir = dir_action[mv]\n                      actions.append(dir_action[(-dx, -dy)])\n                      state.dir = dir_action[(-dx, -dy)]\n                      actions.append(4)          # USE\n                      break\n\n  # ------------------------------------------------------------------\n  # If the recipe specifies a workshop, go there and craft the stick\n  # ------------------------------------------------------------------\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      workshop_cells = find_cells(workshop_idx)\n      if workshop_cells:\n          wx, wy = workshop_cells[0]\n          for dx, dy in dirs:\n              nx, ny = wx - dx, wy - dy\n              if 0 <= nx < width and 0 <= ny < height and not np.any(grid[nx, ny, :]):\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  actions.append(4)          # USE to craft the stick\n                  break\n\n  return actions", "env_interactions": 8, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-23T02:54:25.623956", "function_name": "make_arrow", "function_body": "  # Reset environment and get initial state\n  env.reset()\n  state = env._current_state\n  grid = state.grid\n  width, height = grid.shape[:2]\n\n  # Direction vectors and mapping to action indices (DOWN=0, UP=1, LEFT=2, RIGHT=3)\n  dirs = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n  dir_action = {(0, 1): 0, (0, -1): 1, (-1, 0): 2, (1, 0): 3}\n\n  actions = []\n\n  # Helper to find all cells containing a given kind index\n  def find_cells(kind):\n      xs, ys = np.where(grid[:, :, kind] > 0)\n      return list(zip(xs.tolist(), ys.tolist()))\n\n  # BFS that returns a list of (dx,dy) moves on free cells only\n  from collections import deque\n\n  def bfs(start, goal):\n      \"\"\"Return list of moves (dx,dy) from start to goal avoiding occupied cells.\"\"\"\n      q = deque([start])\n      visited = {start}\n      prev = {}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          x, y = cur\n          for dx, dy in dirs:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height:\n                  if (nx, ny) not in visited and not grid[nx, ny].any():\n                      visited.add((nx, ny))\n                      prev[(nx, ny)] = (cur, (dx, dy))\n                      q.append((nx, ny))\n      if start == goal:\n          return []\n      if goal not in prev:\n          return []  # no path found\n      # reconstruct path\n      path = []\n      cur = goal\n      while cur != start:\n          prev_node, move = prev[cur]\n          path.append(move)\n          cur = prev_node\n      path.reverse()\n      return path\n\n  # ----------------------------------------------------------------------\n  # Identify the recipe for a stick\n  # ----------------------------------------------------------------------\n  stick_idx = env.world.cookbook.index[\"stick\"]\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  primitive_needs = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive the required number of times\n  # ----------------------------------------------------------------------\n  for prim_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          prim_cells = find_cells(prim_idx)\n          if not prim_cells:\n              continue  # primitive not present in this scenario\n          tx, ty = prim_cells[0]\n\n          # Try to stand on a free neighbour from which we can USE the primitive\n          neighbour_found = False\n          for dx, dy in dirs:\n              nx, ny = tx - dx, ty - dy  # cell opposite the direction we will face\n              if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                  # Move to (nx, ny)\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  # Face the primitive\n                  actions.append(dir_action[(-dx, -dy)])\n                  state.dir = dir_action[(-dx, -dy)]\n                  # Pick up\n                  actions.append(4)  # USE action\n                  neighbour_found = True\n                  break\n\n          if not neighbour_found:\n              # Fallback: any adjacent free cell, then turn towards primitive\n              for dx, dy in dirs:\n                  nx, ny = tx + dx, ty + dy\n                  if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                      path = bfs(state.pos, (nx, ny))\n                      for mv in path:\n                          actions.append(dir_action[mv])\n                          state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                          state.dir = dir_action[mv]\n                      actions.append(dir_action[(-dx, -dy)])  # face primitive\n                      state.dir = dir_action[(-dx, -dy)]\n                      actions.append(4)  # USE\n                      neighbour_found = True\n                      break\n\n  # ----------------------------------------------------------------------\n  # If the recipe requires a workshop, move there and craft the stick\n  # ----------------------------------------------------------------------\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      workshop_cells = find_cells(workshop_idx)\n      if workshop_cells:\n          wx, wy = workshop_cells[0]\n          # Find a free neighbour to stand on\n          for dx, dy in dirs:\n              nx, ny = wx - dx, wy - dy\n              if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  # Use to craft\n                  actions.append(4)  # USE\n                  break\n\n  return actions", "env_interactions": 8, "island_id": 9, "scores": {"3": 0.5}}
