{"timestamp": "2025-10-23T03:53:56.076396", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  state = env._current_state\n  world = env.world\n  stick_idx = world.cookbook.index['stick']\n\n  # ---------- helper utilities ----------\n  def move_to(tx, ty, pos, act_list):\n      \"\"\"Append moves that bring the agent from pos to (tx, ty).\"\"\"\n      x, y = pos\n      while x < tx:\n          act_list.append(3)   # RIGHT\n          x += 1\n      while x > tx:\n          act_list.append(2)   # LEFT\n          x -= 1\n      while y < ty:\n          act_list.append(0)   # DOWN\n          y += 1\n      while y > ty:\n          act_list.append(1)   # UP\n          y -= 1\n      return (x, y)\n\n  def nearest_pos(kind_idx, cur_pos):\n      \"\"\"Return the coordinates of the nearest cell containing kind_idx.\"\"\"\n      positions = np.argwhere(state.grid[:, :, kind_idx] > 0)\n      if positions.size == 0:\n          return None\n      dists = np.abs(positions[:, 0] - cur_pos[0]) + np.abs(positions[:, 1] - cur_pos[1])\n      best = positions[dists.argmin()]\n      return (int(best[0]), int(best[1]))\n\n  def go_and_pick(kind_idx, cur_pos, act_list):\n      \"\"\"Move to a cell with kind_idx and USE it.\"\"\"\n      target = nearest_pos(kind_idx, cur_pos)\n      if target is None:\n          return cur_pos, False\n      cur_pos = move_to(target[0], target[1], cur_pos, act_list)\n      act_list.append(4)               # USE / pick up / interact\n      return cur_pos, True\n  # ---------------------------------------\n\n  actions = []\n  cur_pos = state.pos\n\n  # ----- case 1: stick is a primitive (just collect it) -----\n  if stick_idx in world.cookbook.primitives:\n      cur_pos, ok = go_and_pick(stick_idx, cur_pos, actions)\n      return actions if ok else []\n\n  # ----- case 2: stick must be crafted -----------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get('_at', None)\n\n  # collect all non\u2011workshop ingredients\n  for ing_key, cnt in recipe.items():\n      if ing_key == '_at':\n          continue\n      ing_idx = ing_key if isinstance(ing_key, int) else world.cookbook.index[ing_key]\n      for _ in range(cnt):\n          cur_pos, ok = go_and_pick(ing_idx, cur_pos, actions)\n          if not ok:\n              return []                     # cannot satisfy the recipe\n\n  # move to workshop (if required) before crafting\n  if workshop_name is not None:\n      ws_idx = world.cookbook.index[workshop_name]\n      cur_pos, ok = go_and_pick(ws_idx, cur_pos, actions)\n      if not ok:\n          return []                         # workshop not found\n\n  # finally craft the stick\n  actions.append(4)                           # USE to craft\n  return actions", "env_interactions": 5, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:54:18.000818", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  goal_idx = env.task.goal\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # -----------------------------------------------------------------\n  # Helper utilities\n  # -----------------------------------------------------------------\n  def find_positions(kind):\n      \"\"\"Return list of (x, y) where the grid contains at least one of `kind`.\"\"\"\n      locs = np.argwhere(state.grid[:, :, kind] > 0)\n      return [tuple(p) for p in locs]\n\n  def nearest(pos, kind):\n      \"\"\"Find the nearest position of a given kind using Manhattan distance.\"\"\"\n      positions = find_positions(kind)\n      if not positions:\n          return None\n      return min(positions, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n\n  def moves_to(src, dst):\n      \"\"\"Generate a sequence of movement actions (DOWN,UP,LEFT,RIGHT) from src to dst.\"\"\"\n      sx, sy = src\n      dx, dy = dst\n      seq = []\n      while sx < dx:\n          seq.append(0)   # DOWN\n          sx += 1\n      while sx > dx:\n          seq.append(1)   # UP\n          sx -= 1\n      while sy < dy:\n          seq.append(3)   # RIGHT\n          sy += 1\n      while sy > dy:\n          seq.append(2)   # LEFT\n          sy -= 1\n      return seq\n\n  # -----------------------------------------------------------------\n  # 1) If the goal is a primitive (no recipe), just go pick it up.\n  # -----------------------------------------------------------------\n  if not env.world.cookbook.primitives_for(goal_idx):\n      target = nearest(cur_pos, goal_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)   # USE\n      return actions\n\n  # -----------------------------------------------------------------\n  # 2) Collect all required primitive ingredients.\n  # -----------------------------------------------------------------\n  needed_prims = env.world.cookbook.primitives_for(goal_idx)\n  for prim_idx, count in needed_prims.items():\n      for _ in range(count):\n          target = nearest(cur_pos, prim_idx)\n          if target is None:\n              continue  # skip if unreachable\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n          actions.append(4)   # USE to collect\n\n  # -----------------------------------------------------------------\n  # 3) Move to the appropriate workshop (if any) and craft the item.\n  # -----------------------------------------------------------------\n  workshop_idx = None\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  if \"_at\" in recipe:\n      workshop_idx = recipe[\"_at\"]\n  else:\n      # fallback: look for any string-keyed entry (e.g., workshop name)\n      for key, val in recipe.items():\n          if isinstance(key, str):\n              workshop_idx = val\n              break\n\n  if workshop_idx is not None:\n      target = nearest(cur_pos, workshop_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)   # USE to craft at the workshop\n\n  return actions", "env_interactions": 1, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:54:19.256415", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  goal_idx = env.task.goal\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  def find_positions(kind):\n      locs = np.argwhere(state.grid[:, :, kind] > 0)\n      return [tuple(p) for p in locs]\n\n  def nearest(pos, kind):\n      positions = find_positions(kind)\n      if not positions:\n          return None\n      return min(positions, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n\n  def moves_to(src, dst):\n      sx, sy = src\n      dx, dy = dst\n      seq = []\n      while sx < dx:\n          seq.append(0)   # DOWN\n          sx += 1\n      while sx > dx:\n          seq.append(1)   # UP\n          sx -= 1\n      while sy < dy:\n          seq.append(3)   # RIGHT\n          sy += 1\n      while sy > dy:\n          seq.append(2)   # LEFT\n          sy -= 1\n      return seq\n\n  # 1) Primitive case: directly collect the stick.\n  if not env.world.cookbook.primitives_for(goal_idx):\n      target = nearest(cur_pos, goal_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)   # USE\n      return actions\n\n  # 2) Gather required primitive ingredients.\n  needed_prims = env.world.cookbook.primitives_for(goal_idx)\n  for prim_idx, count in needed_prims.items():\n      for _ in range(count):\n          target = nearest(cur_pos, prim_idx)\n          if target is None:\n              continue\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n          actions.append(4)   # USE to collect\n\n  # 3) Craft at the appropriate workshop if needed.\n  workshop_idx = None\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  if \"_at\" in recipe:\n      workshop_idx = recipe[\"_at\"]\n  else:\n      for key, val in recipe.items():\n          if isinstance(key, str):\n              workshop_idx = val\n              break\n\n  if workshop_idx is not None:\n      target = nearest(cur_pos, workshop_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)   # USE to craft\n\n  return actions", "env_interactions": 1, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:54:41.092936", "function_name": "make_arrow", "function_body": "  # Identify the CraftWorld instance inside the provided environment\n  if hasattr(env, \"world\"):\n      world = env.world\n  elif hasattr(env, \"scenario\"):\n      world = env.scenario.world\n  else:\n      raise AttributeError(\"Cannot locate CraftWorld instance in the supplied env.\")\n\n  # Goal is the stick\n  goal_name = \"stick\"\n  goal_idx = world.cookbook.index[goal_name]\n\n  # Determine required primitives for the stick (empty if stick is a primitive itself)\n  needed_prims = world.cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n\n  # Obtain a state for planning (current grid and position)\n  if hasattr(env, \"_current_state\"):\n      state = env._current_state\n  else:\n      state = env.scenario.init()\n  cur_pos = tuple(state.pos)               # (row, col)\n  grid = state.grid.copy()                 # (H, W, n_kinds)\n\n  # Action to delta mapping for movement actions\n  _ACTION_DELTAS = {\n      0: (1, 0),   # DOWN\n      1: (-1, 0),  # UP\n      2: (0, -1),  # LEFT\n      3: (0, 1),   # RIGHT\n  }\n\n  def _move_actions(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) to walk Manhattan\u2011wise.\"\"\"\n      sy, sx = start\n      gy, gx = goal\n      acts = []\n      while sy < gy:\n          acts.append(0)   # DOWN\n          sy += 1\n      while sy > gy:\n          acts.append(1)   # UP\n          sy -= 1\n      while sx < gx:\n          acts.append(3)   # RIGHT\n          sx += 1\n      while sx > gx:\n          acts.append(2)   # LEFT\n          sx -= 1\n      return acts\n\n  def _collect_primitive(p_idx, py, px):\n      \"\"\"Move next to the primitive at (py,px) and USE to pick it up.\"\"\"\n      nonlocal cur_pos, grid, actions\n      # Find an empty neighbouring cell from which the agent can face the primitive\n      target = None\n      for dy, dx in _ACTION_DELTAS.values():\n          ny, nx = py - dy, px - dx\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not grid[ny, nx, :].any():   # empty cell\n                  target = (ny, nx)\n                  break\n      if target is None:\n          raise RuntimeError(\"No reachable empty neighbour around required primitive.\")\n      # Move there\n      actions.extend(_move_actions(cur_pos, target))\n      cur_pos = target\n      # Use to collect\n      actions.append(4)   # USE\n      # Update planning grid\n      grid[py, px, p_idx] = 0\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # 1) Gather all required primitives (if any)\n  # ------------------------------------------------------------------\n  if needed_prims:\n      for prim_idx, count in needed_prims.items():\n          for _ in range(count):\n              prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n              if prim_cells.size == 0:\n                  raise RuntimeError(\n                      f\"Required primitive '{world.cookbook.index.get(prim_idx)}' not found on the grid.\"\n                  )\n              py, px = prim_cells[0]\n              _collect_primitive(prim_idx, py, px)\n\n  # ------------------------------------------------------------------\n  # 2) If stick itself is a primitive (no recipe), just collect it\n  # ------------------------------------------------------------------\n  if not needed_prims:\n      stick_cells = np.argwhere(grid[:, :, goal_idx] > 0)\n      if stick_cells.size:\n          py, px = stick_cells[0]\n          _collect_primitive(goal_idx, py, px)\n      return actions\n\n  # ------------------------------------------------------------------\n  # 3) Craft the stick at its workshop (if a workshop is specified)\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = world.cookbook.index[workshop_name]\n      ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_cells.size == 0:\n          raise RuntimeError(f\"Workshop '{workshop_name}' not found on the grid.\")\n      wy, wx = ws_cells[0]\n\n      # Find an empty neighbour to stand on while facing the workshop\n      target = None\n      for dy, dx in _ACTION_DELTAS.values():\n          ny, nx = wy - dy, wx - dx\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not grid[ny, nx, :].any():\n                  target = (ny, nx)\n                  break\n      if target is None:\n          raise RuntimeError(\"No reachable empty neighbour around the workshop.\")\n      actions.extend(_move_actions(cur_pos, target))\n      cur_pos = target\n      actions.append(4)   # USE to craft the stick\n\n  return actions", "env_interactions": 5, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:54:42.391916", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # action -> (dy, dx) movement deltas\n  _ACTION_DELTAS = {\n      0: (1, 0),   # DOWN\n      1: (-1, 0),  # UP\n      2: (0, -1),  # LEFT\n      3: (0, 1),   # RIGHT\n  }\n\n  def _move_actions(start, goal):\n      \"\"\"Manhattan walk from start to goal, returning a list of movement actions.\"\"\"\n      sy, sx = start\n      gy, gx = goal\n      acts = []\n      while sy < gy:\n          acts.append(0)   # DOWN\n          sy += 1\n      while sy > gy:\n          acts.append(1)   # UP\n          sy -= 1\n      while sx < gx:\n          acts.append(3)   # RIGHT\n          sx += 1\n      while sx > gx:\n          acts.append(2)   # LEFT\n          sx -= 1\n      return acts\n\n  # ----------------------------------------------------------------------\n  # locate CraftWorld instance inside the supplied environment\n  # ----------------------------------------------------------------------\n  if hasattr(env, \"world\"):\n      world = env.world\n  elif hasattr(env, \"scenario\"):\n      world = env.scenario.world\n  else:\n      raise AttributeError(\"Cannot locate CraftWorld instance in the supplied env.\")\n\n  # ----------------------------------------------------------------------\n  # identify the stick goal and its recipe\n  # ----------------------------------------------------------------------\n  goal_name = \"stick\"\n  goal_idx = world.cookbook.index[goal_name]\n\n  # primitives required to craft the stick (empty dict if stick is primitive)\n  needed = world.cookbook.primitives_for(goal_idx)\n\n  # ----------------------------------------------------------------------\n  # obtain current state for planning (position + grid)\n  # ----------------------------------------------------------------------\n  if hasattr(env, \"_current_state\"):\n      state = env._current_state\n  else:\n      state = env.scenario.init()\n  cur_pos = tuple(state.pos)          # (row, col)\n  grid = state.grid.copy()            # (H, W, n_kinds)\n\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # collect each required primitive the required number of times\n  # ----------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          # locate a cell that currently holds this primitive\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(\n                  f\"Required primitive {world.cookbook.index.get(prim_idx)} not found on the grid.\"\n              )\n          py, px = prim_cells[0]\n\n          # find an empty neighbour from which we can face the primitive\n          target = None\n          for dy, dx in _ACTION_DELTAS.values():\n              ny, nx = py - dy, px - dx\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  if not grid[ny, nx, :].any():\n                      target = (ny, nx)\n                      break\n          if target is None:\n              raise RuntimeError(\"No reachable empty neighbour around required primitive.\")\n\n          # move to the neighbour\n          actions.extend(_move_actions(cur_pos, target))\n          cur_pos = target\n\n          # use to pick up the primitive\n          actions.append(4)   # USE\n\n          # update planning grid: primitive has been collected\n          grid[py, px, prim_idx] = 0\n\n  # ----------------------------------------------------------------------\n  # if stick itself is a primitive (no recipe), just collect it now\n  # ----------------------------------------------------------------------\n  if not needed:\n      stick_cells = np.argwhere(grid[:, :, goal_idx] > 0)\n      if stick_cells.size == 0:\n          raise RuntimeError(\"Stick not found on the grid.\")\n      py, px = stick_cells[0]\n\n      # find empty neighbour to face the stick\n      target = None\n      for dy, dx in _ACTION_DELTAS.values():\n          ny, nx = py - dy, px - dx\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not grid[ny, nx, :].any():\n                  target = (ny, nx)\n                  break\n      if target is None:\n          raise RuntimeError(\"No reachable empty neighbour around the stick.\")\n\n      actions.extend(_move_actions(cur_pos, target))\n      cur_pos = target\n      actions.append(4)   # USE\n      return actions\n\n  # ----------------------------------------------------------------------\n  # craft the stick at its workshop (if a workshop is specified)\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = world.cookbook.index[workshop_name]\n      ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_cells.size == 0:\n          raise RuntimeError(f\"Workshop {workshop_name} not found on the grid.\")\n      wy, wx = ws_cells[0]\n\n      # find empty neighbour to face the workshop\n      target = None\n      for dy, dx in _ACTION_DELTAS.values():\n          ny, nx = wy - dy, wx - dx\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not grid[ny, nx, :].any():\n                  target = (ny, nx)\n                  break\n      if target is None:\n          raise RuntimeError(\"No reachable empty neighbour around the workshop.\")\n\n      actions.extend(_move_actions(cur_pos, target))\n      cur_pos = target\n      actions.append(4)   # USE to craft the stick\n\n  return actions", "env_interactions": 5, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:55:00.732296", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n  stick_idx = cookbook.index['stick']\n\n  # If we already have a stick in inventory, nothing to do.\n  if state.inventory[stick_idx] > 0:\n      return []\n\n  # Helper to generate movement actions from cur_pos to target.\n  def _move_actions(cur_pos, target):\n      actions = []\n      x, y = cur_pos\n      tx, ty = target\n      while x < tx:\n          actions.append(3)   # RIGHT\n          x += 1\n      while x > tx:\n          actions.append(2)   # LEFT\n          x -= 1\n      while y < ty:\n          actions.append(0)   # DOWN\n          y += 1\n      while y > ty:\n          actions.append(1)   # UP\n          y -= 1\n      return actions, (x, y)\n\n  actions = []\n  cur_pos = state.pos\n  inventory = state.inventory.copy()\n\n  # ------------------------------------------------------------\n  # Case 1: stick is a primitive (just pick it up from the map)\n  # ------------------------------------------------------------\n  if stick_idx in cookbook.primitives:\n      stick_cells = np.argwhere(state.grid[:, :, stick_idx] > 0)\n      if stick_cells.size > 0:\n          target = tuple(stick_cells[0])\n          moves, cur_pos = _move_actions(cur_pos, target)\n          actions.extend(moves)\n          actions.append(4)                     # USE to pick up stick\n      return actions\n\n  # ------------------------------------------------------------\n  # Case 2: stick must be crafted from primitives\n  # ------------------------------------------------------------\n  # Determine primitive requirements for one stick.\n  primitive_req = cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n  recipe = cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = None\n  if workshop_name is not None:\n      workshop_idx = cookbook.index[workshop_name]\n\n  # 1) Collect all required primitives.\n  for prim_idx, needed in primitive_req.items():\n      while inventory[prim_idx] < needed:\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # No more of this primitive on the map; stop planning.\n              return actions\n          target = tuple(prim_cells[0])\n          moves, cur_pos = _move_actions(cur_pos, target)\n          actions.extend(moves)\n          actions.append(4)                    # USE to pick up primitive\n          inventory[prim_idx] += 1\n\n  # 2) If a workshop is required, move to it.\n  if workshop_idx is not None:\n      ws_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if ws_cells.size > 0:\n          target = tuple(ws_cells[0])\n          moves, cur_pos = _move_actions(cur_pos, target)\n          actions.extend(moves)\n\n  # 3) Finally, craft the stick.\n  actions.append(4)    # USE to craft at current location (workshop or open ground)\n\n  return actions", "env_interactions": 4, "island_id": 8, "scores": {"3": 0.0}}
