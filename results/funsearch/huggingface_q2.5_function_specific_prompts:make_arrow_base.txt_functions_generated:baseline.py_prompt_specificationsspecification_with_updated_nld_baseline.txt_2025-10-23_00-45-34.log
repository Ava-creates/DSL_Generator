{"timestamp": "2025-10-23T03:22:05.372019", "function_name": "make_arrow", "function_body": "  import re\n  import numpy as np\n\n  # Reset the environment to obtain a fresh state and the task name.\n  obs = env.reset()\n  task_name = obs.get(\"task_name\", \"\")\n\n  # Extract the goal item name from the task string, e.g. \"make[stick]\".\n  m = re.search(r\"\\[([^\\]]+)\\]\", task_name)\n  if not m:\n      return []  # cannot determine goal\n  goal_name = m.group(1)\n\n  # Shortcut references.\n  world = env.world\n  cookbook = world.cookbook\n  state = env._current_state  # current CraftState after reset\n\n  # Resolve the integer index for the goal item.\n  try:\n      goal_idx = cookbook.index[goal_name]\n  except Exception:\n      return []  # unknown goal\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  # Mapping from direction to action index (as defined in CraftLab).\n  ACTIONS = {\n      \"DOWN\": 0,\n      \"UP\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4,\n  }\n\n  # Simple Manhattan movement planner (ignores obstacles).\n  def move_to(cur_pos, target_pos):\n      \"\"\"Append actions that move from cur_pos to target_pos.\"\"\"\n      x, y = cur_pos\n      tx, ty = target_pos\n      # Horizontal moves.\n      while x != tx:\n          if tx > x:\n              actions.append(ACTIONS[\"RIGHT\"])\n              x += 1\n          else:\n              actions.append(ACTIONS[\"LEFT\"])\n              x -= 1\n      # Vertical moves.\n      while y != ty:\n          if ty > y:\n              actions.append(ACTIONS[\"DOWN\"])\n              y += 1\n          else:\n              actions.append(ACTIONS[\"UP\"])\n              y -= 1\n      return (x, y)\n\n  def locate_kind(kind_idx):\n      \"\"\"Return the (x, y) of any cell that contains the given kind.\"\"\"\n      grid = state.grid\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if len(locations) == 0:\n          return None\n      return tuple(locations[0])  # first occurrence\n\n  # ------------------------------------------------------------------\n  # Planning\n  # ------------------------------------------------------------------\n  actions = []\n\n  # 1. Gather all primitive resources required for the goal.\n  primitive_requirements = cookbook.primitives_for(goal_idx)\n  for prim_idx, needed_cnt in primitive_requirements.items():\n      for _ in range(needed_cnt):\n          loc = locate_kind(prim_idx)\n          if loc is None:\n              # Primitive not found \u2013 give up on this plan.\n              return actions\n          # Move to the primitive and pick it up.\n          state.pos = move_to(state.pos, loc)\n          actions.append(ACTIONS[\"USE\"])\n\n  # 2. If the goal is not a primitive, craft it at the required workshop.\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  for key, val in recipe.items():\n      if key == \"_at\":\n          workshop_idx = val\n          break\n\n  if workshop_idx is not None:\n      loc = locate_kind(workshop_idx)\n      if loc is not None:\n          state.pos = move_to(state.pos, loc)\n          actions.append(ACTIONS[\"USE\"])\n\n  return actions", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:22:26.422759", "function_name": "make_arrow", "function_body": "  def _move_actions(cur_pos, target):\n      actions = []\n      x, y = cur_pos\n      tx, ty = target\n      while x < tx:\n          actions.append(3)  # RIGHT\n          x += 1\n      while x > tx:\n          actions.append(2)  # LEFT\n          x -= 1\n      while y < ty:\n          actions.append(0)  # DOWN\n          y += 1\n      while y > ty:\n          actions.append(1)  # UP\n          y -= 1\n      return actions, (x, y)\n\n  state = env._current_state\n  cookbook = env.world.cookbook\n  stick_idx = cookbook.index['stick']\n\n  # Already have a stick.\n  if state.inventory[stick_idx] > 0:\n      return []\n\n  # Stick lying on the ground.\n  stick_cells = np.argwhere(state.grid[:, :, stick_idx] > 0)\n  if stick_cells.size > 0:\n      target = tuple(stick_cells[0])\n      moves, _ = _move_actions(state.pos, target)\n      moves.append(4)                     # USE to pick it up\n      return moves\n\n  # Need to craft a stick.\n  primitive_req = cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n  recipe = cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = cookbook.index[workshop_name] if workshop_name is not None else None\n\n  actions = []\n  cur_pos = state.pos\n  inventory = state.inventory.copy()\n\n  # Collect required primitives.\n  for prim_idx, needed in primitive_req.items():\n      while inventory[prim_idx] < needed:\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # Primitive not available \u2013 abort planning.\n              return actions\n          target = tuple(prim_cells[0])\n          moves, cur_pos = _move_actions(cur_pos, target)\n          actions.extend(moves)\n          actions.append(4)                # USE to pick up the primitive\n          inventory[prim_idx] += 1\n\n  # Go to workshop (if any) and craft the stick.\n  if workshop_idx is not None:\n      ws_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if ws_cells.size > 0:\n          target = tuple(ws_cells[0])\n          moves, cur_pos = _move_actions(cur_pos, target)\n          actions.extend(moves)\n      actions.append(4)                    # USE to craft the stick\n  else:\n      # No workshop required \u2013 craft at current location.\n      actions.append(4)\n\n  return actions", "env_interactions": 4, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:22:27.720608", "function_name": "make_arrow", "function_body": "  def _move_actions(cur_pos, target):\n      actions = []\n      x, y = cur_pos\n      tx, ty = target\n      while x < tx:\n          actions.append(3)  # RIGHT\n          x += 1\n      while x > tx:\n          actions.append(2)  # LEFT\n          x -= 1\n      while y < ty:\n          actions.append(0)  # DOWN\n          y += 1\n      while y > ty:\n          actions.append(1)  # UP\n          y -= 1\n      return actions, (x, y)\n\n  state = env._current_state\n  cookbook = env.world.cookbook\n  stick_idx = cookbook.index['stick']\n\n  # If we already have a stick, nothing to do.\n  if state.inventory[stick_idx] > 0:\n      return []\n\n  # If a stick is lying on the ground, go pick it up.\n  stick_cells = np.argwhere(state.grid[:, :, stick_idx] > 0)\n  if stick_cells.size > 0:\n      target = tuple(stick_cells[0])\n      moves, _ = _move_actions(state.pos, target)\n      moves.append(4)                     # USE to pick it up\n      return moves\n\n  # Need to craft a stick from primitives.\n  primitive_req = cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n  recipe = cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = cookbook.index[workshop_name] if workshop_name is not None else None\n\n  actions = []\n  cur_pos = state.pos\n  inventory = state.inventory.copy()\n\n  # Collect each required primitive.\n  for prim_idx, needed in primitive_req.items():\n      while inventory[prim_idx] < needed:\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # No more of this primitive available; abort planning.\n              return actions\n          target = tuple(prim_cells[0])\n          moves, cur_pos = _move_actions(cur_pos, target)\n          actions.extend(moves)\n          actions.append(4)                # USE to pick up the primitive\n          inventory[prim_idx] += 1\n\n  # Go to the appropriate workshop (if any) and craft the stick.\n  if workshop_idx is not None:\n      ws_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if ws_cells.size > 0:\n          target = tuple(ws_cells[0])\n          moves, cur_pos = _move_actions(cur_pos, target)\n          actions.extend(moves)\n          actions.append(4)                # USE to craft the stick\n      else:\n          # No workshop cell found; attempt to craft at current location.\n          actions.append(4)\n  else:\n      # No specific workshop required; craft in place.\n      actions.append(4)\n\n  return actions", "env_interactions": 4, "island_id": 8, "scores": {"3": 0.0}}
