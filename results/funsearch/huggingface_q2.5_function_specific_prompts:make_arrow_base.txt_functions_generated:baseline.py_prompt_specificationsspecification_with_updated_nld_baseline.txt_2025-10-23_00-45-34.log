------------------------------------------------------\n  # Helper: generate a simple Manhattan path (greedy) from cur to target\n  # ----------------------------------------------------------------------\n  def path_to(cur, target):\n      x, y = cur\n      tx, ty = target\n      path = []\n      while (x, y) != (tx, ty):\n          if x < tx:\n              path.append(RIGHT)\n              x += 1\n          elif x > tx:\n              path.append(LEFT)\n              x -= 1\n          elif y < ty:\n              path.append(DOWN)\n              y += 1\n          elif y > ty:\n              path.append(UP)\n              y -= 1\n      return path, (x, y)\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive the needed number of times\n  # ----------------------------------------------------------------------\n  for kind_idx, needed in primitive_needs.items():\n      while needed > 0:\n          target = find_closest(kind_idx, cur_pos)\n          if target is None:\n              # No more of this primitive on the map \u2013 abort planning\n              return actions\n          move_actions, cur_pos = path_to(cur_pos, target)\n          actions.extend(move_actions)\n          actions.append(USE)   # pick up / use the primitive\n\n          # Update local grid copy to reflect the collection\n          grid[target[0], target[1], kind_idx] = max(\n              0, grid[target[0], target[1], kind_idx] - 1\n          )\n          needed -= 1\n\n  # ----------------------------------------------------------------------\n  # If a workshop is required, move to it and craft the stick\n  # ----------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_target = find_closest(workshop_idx, cur_pos)\n      if ws_target is not None:\n          move_actions, cur_pos = path_to(cur_pos, ws_target)\n          actions.extend(move_actions)\n          actions.append(USE)   # craft stick at the workshop\n\n  return actions", "env_interactions": 2, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:24:35.603571", "function_name": "make_arrow", "function_body": "  actions = []\n  # Access current state and world information\n  state = env._current_state\n  grid = state.grid\n  world = env.world\n  cb = world.cookbook\n\n  # Identify the index of the target item \"stick\"\n  try:\n      goal_idx = cb.index[\"stick\"]\n  except Exception:\n      return actions\n\n  # Helper to move the agent to a target cell using Manhattan steps\n  pos = list(state.pos)  # mutable copy of current position\n\n  def _move_to(target):\n      nonlocal pos, actions\n      tx, ty = target\n      while pos[0] < tx:\n          actions.append(3)   # RIGHT\n          pos[0] += 1\n      while pos[0] > tx:\n          actions.append(2)   # LEFT\n          pos[0] -= 1\n      while pos[1] < ty:\n          actions.append(0)   # DOWN\n          pos[1] += 1\n      while pos[1] > ty:\n          actions.append(1)   # UP\n          pos[1] -= 1\n\n  # Determine primitive requirements for the stick\n  required = cb.primitives_for(goal_idx)\n\n  if required:\n      # Collect each required primitive\n      for prim_idx, count in required.items():\n          # Find all locations containing this primitive\n          locs = np.argwhere(grid[:, :, prim_idx] > 0)\n          if locs.size == 0:\n              continue  # primitive not present; skip\n          # Choose the first occurrence (could be improved to nearest)\n          target = locs[0].tolist()\n          _move_to(target)\n          # Pick up the needed amount\n          for _ in range(count):\n              actions.append(4)   # USE\n      # After gathering primitives, go to the workshop (if any) and craft\n      recipe = cb.recipes.get(goal_idx, {})\n      workshop_name = recipe.get(\"_at\")\n      if workshop_name:\n          workshop_idx = cb.index[workshop_name]\n          w_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n          if w_locs.size:\n              w_target = w_locs[0].tolist()\n              _move_to(w_target)\n              actions.append(4)   # USE to craft at the workshop\n  else:\n      # Stick is a primitive item; just pick it up directly\n      locs = np.argwhere(grid[:, :, goal_idx] > 0)\n      if locs.size:\n          target = locs[0].tolist()\n          _move_to(target)\n          actions.append(4)   # USE to pick up the stick\n\n  return actions", "env_interactions": 4, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:24:36.986394", "function_name": "make_arrow", "function_body": "  actions = []\n  # current state and world\n  state = env._current_state\n  grid = state.grid\n  world = env.world\n  cb = world.cookbook\n\n  # index of the target item \"stick\"\n  try:\n      goal_idx = cb.index[\"stick\"]\n  except Exception:\n      return actions\n\n  # primitive requirements for the stick\n  required = cb.primitives_for(goal_idx)\n\n  # mutable copy of agent position\n  pos = list(state.pos)\n\n  # helper to move Manhattan-wise to a target cell\n  def _move_to(target):\n      nonlocal pos, actions\n      tx, ty = target\n      while pos[0] < tx:\n          actions.append(3)   # RIGHT\n          pos[0] += 1\n      while pos[0] > tx:\n          actions.append(2)   # LEFT\n          pos[0] -= 1\n      while pos[1] < ty:\n          actions.append(0)   # DOWN\n          pos[1] += 1\n      while pos[1] > ty:\n          actions.append(1)   # UP\n          pos[1] -= 1\n\n  # collect each required primitive\n  for prim_idx, count in required.items():\n      locations = np.argwhere(grid[:, :, prim_idx] > 0)\n      if locations.size == 0:\n          continue  # primitive missing; skip (should not happen)\n      # pick the first occurrence (could be improved to nearest)\n      target = locations[0].tolist()\n      _move_to(target)\n      for _ in range(count):\n          actions.append(4)   # USE to pick up one unit\n\n  # if the recipe specifies a workshop, move there and craft\n  recipe = cb.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = cb.index[workshop_name]\n      w_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if w_locs.size:\n          w_target = w_locs[0].tolist()\n          _move_to(w_target)\n          actions.append(4)   # USE to craft at the workshop\n\n  return actions", "env_interactions": 4, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:25:00.567507", "function_name": "make_arrow", "function_body": "  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act.get(\"DOWN\", 0),\n      act.get(\"UP\", 1),\n      act.get(\"LEFT\", 2),\n      act.get(\"RIGHT\", 3),\n      act.get(\"USE\", 4),\n  )\n\n  # snapshot of the current state (do not modify env)\n  state = env._current_state\n  grid = state.grid.copy()\n  cur_pos = tuple(state.pos)\n\n  # index of the goal item \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\", None)\n      if stick_idx is None:\n          return []  # stick not defined\n\n  # recipe information\n  recipe = env.world.cookbook.primitives_for(stick_idx)  # {kind_idx: count}\n  primitive_needs = {k: v for k, v in recipe.items() if isinstance(k, int)}\n  workshop_idx = None\n  for k, v in recipe.items():\n      if not isinstance(k, int):\n          workshop_idx = v if isinstance(v, int) else None\n          break\n\n  # if stick itself is primitive (no recipe), we just need to pick one up\n  if not primitive_needs:\n      primitive_needs = {stick_idx: 1}\n      workshop_idx = None\n\n  actions = []\n\n  # helper: locate nearest cell containing at least one of kind_idx\n  def find_closest(kind_idx, cur):\n      positions = np.argwhere(grid[:, :, kind_idx] > 0)\n      if positions.shape[0] == 0:\n          return None\n      dists = np.sum(np.abs(positions - np.array(cur)), axis=1)\n      nearest = positions[np.argmin(dists)]\n      return tuple(nearest.tolist())\n\n  # helper: greedy Manhattan path\n  def path_to(cur, target):\n      x, y = cur\n      tx, ty = target\n      path = []\n      while (x, y) != (tx, ty):\n          if x < tx:\n              path.append(RIGHT)\n              x += 1\n          elif x > tx:\n              path.append(LEFT)\n              x -= 1\n          elif y < ty:\n              path.append(DOWN)\n              y += 1\n          elif y > ty:\n              path.append(UP)\n              y -= 1\n      return path, (x, y)\n\n  # collect required primitives\n  for kind_idx, needed in primitive_needs.items():\n      while needed > 0:\n          target = find_closest(kind_idx, cur_pos)\n          if target is None:\n              return actions  # primitive unavailable\n          move_actions, cur_pos = path_to(cur_pos, target)\n          actions.extend(move_actions)\n          actions.append(USE)  # pick up\n\n          # update local grid copy\n          grid[target[0], target[1], kind_idx] = max(\n              0, grid[target[0], target[1], kind_idx] - 1\n          )\n          needed -= 1\n\n  # if crafting requires a workshop, move there and use\n  if workshop_idx is not None:\n      ws_target = find_closest(workshop_idx, cur_pos)\n      if ws_target is not None:\n          move_actions, cur_pos = path_to(cur_pos, ws_target)\n          actions.extend(move_actions)\n          actions.append(USE)  # craft at workshop\n\n  return actions", "env_interactions": 2, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:25:01.987552", "function_name": "make_arrow", "function_body": "  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act.get(\"DOWN\", 0),\n      act.get(\"UP\", 1),\n      act.get(\"LEFT\", 2),\n      act.get(\"RIGHT\", 3),\n      act.get(\"USE\", 4),\n  )\n  # snapshot\n  state = env._current_state\n  grid = state.grid.copy()\n  cur_pos = tuple(state.pos)\n\n  # get stick index\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n      if stick_idx is None:\n          return []\n\n  # recipe\n  recipe = env.world.cookbook.primitives_for(stick_idx)\n  primitive_needs = {k: v for k, v in recipe.items() if isinstance(k, int)}\n  # If no recipe (stick is primitive), need to pick it up directly\n  if not primitive_needs:\n      primitive_needs = {stick_idx: 1}\n  workshop_idx = None\n  for k, v in recipe.items():\n      if not isinstance(k, int):\n          # workshop key may be something like \"_at\"\n          workshop_idx = v if isinstance(v, int) else None\n          break\n\n  actions = []\n\n  def find_closest(kind_idx, cur):\n      positions = np.argwhere(grid[:, :, kind_idx] > 0)\n      if positions.shape[0] == 0:\n          return None\n      dists = np.sum(np.abs(positions - np.array(cur)), axis=1)\n      nearest = positions[np.argmin(dists)]\n      return tuple(nearest.tolist())\n\n  def path_to(cur, target):\n      x, y = cur\n      tx, ty = target\n      path = []\n      while (x, y) != (tx, ty):\n          if x < tx:\n              path.append(RIGHT)\n              x += 1\n          elif x > tx:\n              path.append(LEFT)\n              x -= 1\n          elif y < ty:\n              path.append(DOWN)\n              y += 1\n          elif y > ty:\n              path.append(UP)\n              y -= 1\n      return path, (x, y)\n\n  # collect primitives\n  for kind_idx, needed in primitive_needs.items():\n      while needed > 0:\n          target = find_closest(kind_idx, cur_pos)\n          if target is None:\n              return actions\n          move_actions, cur_pos = path_to(cur_pos, target)\n          actions.extend(move_actions)\n          actions.append(USE)\n          # update grid copy\n          grid[target[0], target[1], kind_idx] = max(\n              0, grid[target[0], target[1], kind_idx] - 1\n          )\n          needed -= 1\n\n  # craft at workshop if needed\n  if workshop_idx is not None:\n      ws_target = find_closest(workshop_idx, cur_pos)\n      if ws_target is not None:\n          move_actions, cur_pos = path_to(cur_pos, ws_target)\n          actions.extend(move_actions)\n          actions.append(USE)\n\n  return actions", "env_interactions": 2, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:25:24.022842", "function_name": "make_arrow", "function_body": "  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act.get(\"DOWN\", 0),\n      act.get(\"UP\", 1),\n      act.get(\"LEFT\", 2),\n      act.get(\"RIGHT\", 3),\n      act.get(\"USE\", 4),\n  )\n\n  state = env._current_state\n  grid = state.grid.copy()\n  cur_pos = tuple(state.pos)\n\n  # locate the index for \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n      if stick_idx is None:\n          return []\n\n  # retrieve recipe (primitives needed and possible workshop)\n  recipe = env.world.cookbook.primitives_for(stick_idx)\n  primitive_needs = {k: v for k, v in recipe.items() if isinstance(k, int)}\n  # if stick itself is a primitive, just need to pick one up\n  if not primitive_needs:\n      primitive_needs = {stick_idx: 1}\n\n  workshop_idx = None\n  for k, v in recipe.items():\n      if not isinstance(k, int):\n          workshop_idx = v if isinstance(v, int) else None\n          break\n\n  actions = []\n\n  def find_closest(kind_idx, cur):\n      \"\"\"Return coordinates of the nearest cell containing kind_idx, or None.\"\"\"\n      positions = np.argwhere(grid[:, :, kind_idx] > 0)\n      if positions.shape[0] == 0:\n          return None\n      dists = np.sum(np.abs(positions - np.array(cur)), axis=1)\n      nearest = positions[np.argmin(dists)]\n      return tuple(nearest.tolist())\n\n  def path_to(cur, target):\n      \"\"\"Greedy Manhattan path from cur to target, returning actions and final pos.\"\"\"\n      x, y = cur\n      tx, ty = target\n      path = []\n      while (x, y) != (tx, ty):\n          if x < tx:\n              path.append(RIGHT)\n              x += 1\n          elif x > tx:\n              path.append(LEFT)\n              x -= 1\n          elif y < ty:\n              path.append(DOWN)\n              y += 1\n          elif y > ty:\n              path.append(UP)\n              y -= 1\n      return path, (x, y)\n\n  # Collect all required primitives\n  for kind_idx, needed in primitive_needs.items():\n      while needed > 0:\n          target = find_closest(kind_idx, cur_pos)\n          if target is None:\n              return actions  # cannot find required primitive\n          move_actions, cur_pos = path_to(cur_pos, target)\n          actions.extend(move_actions)\n          actions.append(USE)  # pick up the primitive\n          # Update local grid copy to reflect consumption\n          grid[target[0], target[1], kind_idx] = max(\n              0, grid[target[0], target[1], kind_idx] - 1\n          )\n          needed -= 1\n\n  # If a workshop is required, move there and use it\n  if workshop_idx is not None:\n      ws_target = find_closest(workshop_idx, cur_pos)\n      if ws_target is not None:\n          move_actions, cur_pos = path_to(cur_pos, ws_target)\n          actions.extend(move_actions)\n          actions.append(USE)  # craft at the workshop\n\n  return actions", "env_interactions": 2, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:25:25.367000", "function_name": "make_arrow", "function_body": "  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act.get(\"DOWN\", 0),\n      act.get(\"UP\", 1),\n      act.get(\"LEFT\", 2),\n      act.get(\"RIGHT\", 3),\n      act.get(\"USE\", 4),\n  )\n\n  # current state snapshot\n  state = env._current_state\n  grid = state.grid.copy()                     # (W, H, n_kinds)\n  cur_pos = tuple(state.pos)                   # (x, y)\n\n  # index of the target item \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n      if stick_idx is None:\n          return []   # stick not present in the world index\n\n  # obtain recipe (primitives needed and optional workshop)\n  recipe = env.world.cookbook.primitives_for(stick_idx)   # dict {kind_idx: count}\n  # primitives are the entries with integer keys\n  primitive_needs = {k: v for k, v in recipe.items() if isinstance(k, int)}\n  # if there is no recipe, stick itself is a primitive we need to pick up\n  if not primitive_needs:\n      primitive_needs = {stick_idx: 1}\n\n  # workshop (non\u2011integer key) \u2013 value should be the index of the workshop entity\n  workshop_idx = None\n  for k, v in recipe.items():\n      if not isinstance(k, int):\n          workshop_idx = v if isinstance(v, int) else None\n          break\n\n  actions = []\n\n  # --------------------------------------------------------------\n  # helper: find nearest cell containing at least one of `kind_idx`\n  def find_closest(kind_idx, cur):\n      positions = np.argwhere(grid[:, :, kind_idx] > 0)\n      if positions.shape[0] == 0:\n          return None\n      dists = np.sum(np.abs(positions - np.array(cur)), axis=1)\n      nearest = positions[np.argmin(dists)]\n      return tuple(nearest.tolist())\n\n  # helper: Manhattan path (returns list of actions and final position)\n  def path_to(cur, target):\n      x, y = cur\n      tx, ty = target\n      path = []\n      while (x, y) != (tx, ty):\n          if x < tx:\n              path.append(RIGHT)\n              x += 1\n          elif x > tx:\n              path.append(LEFT)\n              x -= 1\n          elif y < ty:\n              path.append(DOWN)\n              y += 1\n          elif y > ty:\n              path.append(UP)\n              y -= 1\n      return path, (x, y)\n  # --------------------------------------------------------------\n\n  # Collect each required primitive\n  for kind_idx, needed in primitive_needs.items():\n      while needed > 0:\n          target = find_closest(kind_idx, cur_pos)\n          if target is None:\n              # primitive not present in the world \u2013 abort planning\n              return actions\n          move_actions, cur_pos = path_to(cur_pos, target)\n          actions.extend(move_actions)\n          actions.append(USE)   # pick up the primitive\n          # update our local copy of the grid to reflect consumption\n          grid[target[0], target[1], kind_idx] = max(\n              0, grid[target[0], target[1], kind_idx] - 1\n          )\n          needed -= 1\n\n  # If crafting requires a workshop, move there and use it\n  if workshop_idx is not None:\n      ws_target = find_closest(workshop_idx, cur_pos)\n      if ws_target is not None:\n          move_actions, cur_pos = path_to(cur_pos, ws_target)\n          actions.extend(move_actions)\n          actions.append(USE)   # craft at the workshop\n\n  return actions", "env_interactions": 2, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:25:51.145185", "function_name": "make_arrow", "function_body": "  # helper to generate movement actions from cur_pos to target (x,y)\n  def _move_actions(cur_pos, target):\n      actions = []\n      x, y = cur_pos\n      tx, ty = target\n      # horizontal moves\n      while x < tx:\n          actions.append(3)  # RIGHT\n          x += 1\n      while x > tx:\n          actions.append(2)  # LEFT\n          x -= 1\n      # vertical moves\n      while y < ty:\n          actions.append(0)  # DOWN\n          y += 1\n      while y > ty:\n          actions.append(1)  # UP\n          y -= 1\n      return actions, (x, y)\n\n  state = env._current_state\n  cookbook = env.world.cookbook\n  stick_idx = cookbook.index['stick']\n\n  # 1) already have a stick in inventory\n  if state.inventory[stick_idx] > 0:\n      return []\n\n  # 2) try to pick up an existing stick on the grid\n  stick_cells = np.argwhere(state.grid[:, :, stick_idx] > 0)\n  if stick_cells.size > 0:\n      target = tuple(stick_cells[0])\n      moves, _ = _move_actions(state.pos, target)\n      moves.append(4)                     # USE to pick it up\n      return moves\n\n  # 3) need to craft a stick: collect primitives then craft at workshop (if any)\n  primitive_req = cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n  recipe = cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = cookbook.index[workshop_name] if workshop_name is not None else None\n\n  actions = []\n  cur_pos = state.pos\n  inventory = state.inventory.copy()\n\n  # 3a) collect required primitive ingredients\n  for prim_idx, needed in primitive_req.items():\n      while inventory[prim_idx] < needed:\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # primitive not available on map \u2013 abort planning\n              return actions\n          target = tuple(prim_cells[0])\n          moves, cur_pos = _move_actions(cur_pos, target)\n          actions.extend(moves)\n          actions.append(4)                # USE to pick up the primitive\n          inventory[prim_idx] += 1\n\n  # 3b) move to workshop if required\n  if workshop_idx is not None:\n      ws_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if ws_cells.size > 0:\n          target = tuple(ws_cells[0])\n          moves, cur_pos = _move_actions(cur_pos, target)\n          actions.extend(moves)\n\n  # 3c) craft the stick (USE at current location or workshop)\n  actions.append(4)  # USE to craft\n\n  return actions", "env_interactions": 4, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:25:52.471020", "function_name": "make_arrow", "function_body": "  def _move_actions(cur_pos, target):\n      actions = []\n      x, y = cur_pos\n      tx, ty = target\n      while x < tx:\n          actions.append(3)   # RIGHT\n          x += 1\n      while x > tx:\n          actions.append(2)   # LEFT\n          x -= 1\n      while y < ty:\n          actions.append(0)   # DOWN\n          y += 1\n      while y > ty:\n          actions.append(1)   # UP\n          y -= 1\n      return actions, (x, y)\n\n  state = env._current_state\n  cookbook = env.world.cookbook\n  stick_idx = cookbook.index.get('stick')\n  if stick_idx is None:\n      return []\n\n  # If already have a stick in inventory, nothing to do.\n  if state.inventory[stick_idx] > 0:\n      return []\n\n  # Try to pick up a stick that is already placed on the grid.\n  stick_cells = np.argwhere(state.grid[:, :, stick_idx] > 0)\n  if stick_cells.size > 0:\n      target = tuple(stick_cells[0])\n      moves, _ = _move_actions(state.pos, target)\n      moves.append(4)  # USE to pick it up\n      return moves\n\n  # Need to craft a stick (or collect its primitive ingredients).\n  primitive_req = cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n  recipe = cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = cookbook.index[workshop_name] if workshop_name is not None else None\n\n  actions = []\n  cur_pos = state.pos\n  inventory = state.inventory.copy()\n  used_cells = set()\n\n  # Collect required primitive ingredients.\n  for prim_idx, needed in primitive_req.items():\n      while inventory[prim_idx] < needed:\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          # Find a cell not already used.\n          target_cell = None\n          for cell in prim_cells:\n              cell_tup = tuple(cell)\n              if cell_tup not in used_cells:\n                  target_cell = cell_tup\n                  break\n          if target_cell is None:\n              # No available primitive left on the map.\n              return actions\n          moves, cur_pos = _move_actions(cur_pos, target_cell)\n          actions.extend(moves)\n          actions.append(4)  # USE to pick up the primitive\n          used_cells.add(target_cell)\n          inventory[prim_idx] += 1\n\n  # Go to the workshop (if any) and craft the stick.\n  if workshop_idx is not None:\n      ws_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if ws_cells.size == 0:\n          # No workshop found; cannot craft.\n          return actions\n      target = tuple(ws_cells[0])\n      moves, cur_pos = _move_actions(cur_pos, target)\n      actions.extend(moves)\n      actions.append(4)  # USE to craft the stick\n  else:\n      # No specific workshop required; craft at current location.\n      actions.append(4)\n\n  return actions", "env_interactions": 0, "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-10-23T02:26:19.600143", "function_name": "make_arrow", "function_body": "  # ----- setup -----\n  state = env._current_state\n  world = env.world\n  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act[\"DOWN\"], act[\"UP\"], act[\"LEFT\"], act[\"RIGHT\"], act[\"USE\"]\n  )\n\n  # ----- helper functions -----\n  def nearest_cell(pos, kind_idx):\n      \"\"\"Return coordinates (x, y) of the nearest cell containing kind_idx,\n      or None if none exist.\"\"\"\n      cells = np.argwhere(state.grid[:, :, kind_idx] > 0)\n      if cells.size == 0:\n          return None\n      dists = np.abs(cells - np.array(pos)).sum(axis=1)\n      return tuple(cells[dists.argmin()])\n\n  def manhattan_path(cur, target):\n      \"\"\"Return list of actions to move from cur to target (ignoring obstacles).\"\"\"\n      actions = []\n      dx = target[0] - cur[0]\n      dy = target[1] - cur[1]\n      if dx > 0:\n          actions += [DOWN] * dx\n      elif dx < 0:\n          actions += [UP] * (-dx)\n      if dy > 0:\n          actions += [RIGHT] * dy\n      elif dy < 0:\n          actions += [LEFT] * (-dy)\n      return actions\n\n  # ----- identify stick -----\n  stick_idx = world.cookbook.index[\"stick\"]\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # If there is no recipe, stick is a primitive; just collect one.\n  if not recipe:\n      target = nearest_cell(cur_pos, stick_idx)\n      if target is None:\n          return []  # cannot find a stick\n      actions += manhattan_path(cur_pos, target)\n      actions.append(USE)\n      return actions\n\n  # ----- collect required primitives -----\n  # recipe contains a special key \"_at\" for workshop; other keys are ingredient indices.\n  workshop_name = recipe.get(\"_at\")\n  workshop_idx = world.cookbook.index[workshop_name] if workshop_name else None\n\n  # primitives needed for one stick\n  needed = world.cookbook.primitives_for(stick_idx)  # dict {prim_idx: count}\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = nearest_cell(cur_pos, prim_idx)\n          if target is None:\n              return []  # missing required primitive\n          actions += manhattan_path(cur_pos, target)\n          cur_pos = target\n          actions.append(USE)   # pick up one unit\n  # ----- move to workshop and craft -----\n  if workshop_idx is not None:\n      target = nearest_cell(cur_pos, workshop_idx)\n      if target is None:\n          return []  # no workshop found\n      actions += manhattan_path(cur_pos, target)\n      cur_pos = target\n      actions.append(USE)   # craft the stick\n  return actions", "env_interactions": 4, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:26:20.927274", "function_name": "make_arrow", "function_body": "  # Retrieve action indices\n  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act[\"DOWN\"],\n      act[\"UP\"],\n      act[\"LEFT\"],\n      act[\"RIGHT\"],\n      act[\"USE\"],\n  )\n\n  state = env._current_state\n  world = env.world\n\n  # Index of the target item \"stick\"\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # Primitive requirements for a stick (empty dict if stick is primitive)\n  required = world.cookbook.primitives_for(stick_idx)\n\n  actions = []\n  cur_pos = np.array(state.pos)  # mutable current position\n\n  # Helper to move Manhattan\u2011style from cur_pos to target\n  def _move_to(target):\n      nonlocal actions, cur_pos\n      dx = int(target[0] - cur_pos[0])\n      dy = int(target[1] - cur_pos[1])\n\n      if dx > 0:\n          actions.extend([DOWN] * dx)\n      elif dx < 0:\n          actions.extend([UP] * (-dx))\n\n      if dy > 0:\n          actions.extend([RIGHT] * dy)\n      elif dy < 0:\n          actions.extend([LEFT] * (-dy))\n\n      cur_pos[:] = target\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitive resources\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in required.items():\n      # Find all cells that currently contain this primitive\n      cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n      if cells.size == 0:\n          # No source for this primitive \u2013 cannot succeed\n          return []\n\n      for _ in range(cnt):\n          # Choose the nearest cell (Manhattan distance)\n          dists = np.abs(cells - cur_pos).sum(axis=1)\n          nearest = cells[dists.argmin()]\n\n          _move_to(nearest)\n          actions.append(USE)\n\n          # Pretend we have taken one unit from the cell so that\n          # subsequent searches do not repeatedly target an empty spot.\n          state.grid[nearest[0], nearest[1], prim_idx] = max(\n              0, state.grid[nearest[0], nearest[1], prim_idx] - 1\n          )\n\n  # ------------------------------------------------------------------\n  # 2) If a recipe exists, go to the required workshop and craft the stick\n  # ------------------------------------------------------------------\n  if required:\n      recipe = world.cookbook.recipes.get(stick_idx, {})\n      workshop_idx = recipe.get(\"_at\")\n      if workshop_idx is not None:\n          workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n          if workshop_cells.size == 0:\n              return []  # No workshop available\n\n          dists = np.abs(workshop_cells - cur_pos).sum(axis=1)\n          nearest_ws = workshop_cells[dists.argmin()]\n          _move_to(nearest_ws)\n          actions.append(USE)  # craft the stick at the workshop\n\n  return actions", "env_interactions": 0, "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-10-23T02:26:40.838774", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n\n  # Action identifiers\n  act = env.action_specs()\n  DOWN = act[\"DOWN\"]\n  UP = act[\"UP\"]\n  LEFT = act[\"LEFT\"]\n  RIGHT = act[\"RIGHT\"]\n  USE = act[\"USE\"]\n\n  # Index of the primitive \"stick\"\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # Locate all cells that contain a stick\n  stick_cells = np.argwhere(state.grid[:, :, stick_idx] > 0)\n  if stick_cells.size == 0:\n      # No stick present \u2013 nothing to do\n      return []\n\n  # Grid dimensions\n  W, H, _ = state.grid.shape\n\n  # Cells that are blocked (any entity present)\n  blocked = np.any(state.grid > 0, axis=2)\n\n  start = tuple(state.pos)\n\n  from collections import deque\n\n  def bfs(target):\n      \"\"\"Return list of actions to reach target cell, or None if unreachable.\"\"\"\n      q = deque([start])\n      visited = np.full((W, H), False, dtype=bool)\n      visited[start[0], start[1]] = True\n      # store predecessor for path reconstruction\n      prev = np.empty((W, H, 2), dtype=int)\n\n      while q:\n          x, y = q.popleft()\n          if (x, y) == tuple(target):\n              # reconstruct path\n              actions = []\n              cx, cy = x, y\n              while (cx, cy) != start:\n                  px, py = prev[cx, cy]\n                  dx, dy = cx - px, cy - py\n                  if dx == 1:\n                      actions.append(DOWN)\n                  elif dx == -1:\n                      actions.append(UP)\n                  elif dy == 1:\n                      actions.append(RIGHT)\n                  elif dy == -1:\n                      actions.append(LEFT)\n                  cx, cy = px, py\n              actions.reverse()\n              return actions\n\n          # explore neighbours\n          for nx, ny, a in [(x + 1, y, DOWN), (x - 1, y, UP),\n                            (x, y + 1, RIGHT), (x, y - 1, LEFT)]:\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  # allow stepping onto the target even if it is blocked (contains the stick)\n                  if (nx, ny) == tuple(target) or not blocked[nx, ny]:\n                      visited[nx, ny] = True\n                      prev[nx, ny] = (x, y)\n                      q.append((nx, ny))\n      return None\n\n  # Find the closest reachable stick\n  best_path = None\n  for cell in stick_cells:\n      path = bfs(cell)\n      if path is not None and (best_path is None or len(path) < len(best_path)):\n          best_path = path\n\n  if best_path is None:\n      # No reachable stick found\n      return []\n\n  # Pick up the stick\n  best_path.append(USE)\n  return best_path", "env_interactions": 0, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:26:42.198778", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n\n  # action identifiers\n  act = env.action_specs()\n  DOWN = act[\"DOWN\"]\n  UP = act[\"UP\"]\n  LEFT = act[\"LEFT\"]\n  RIGHT = act[\"RIGHT\"]\n  USE = act[\"USE\"]\n\n  # index of the primitive \u201cstick\u201d\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # locate all cells that contain a stick\n  stick_cells = np.argwhere(state.grid[:, :, stick_idx] > 0)\n  if stick_cells.size == 0:\n      # nothing to collect\n      return []\n\n  # grid shape\n  W, H, _ = state.grid.shape\n\n  # cells that are blocked (any entity present)\n  blocked = np.any(state.grid > 0, axis=2)\n\n  start = tuple(state.pos)\n\n  from collections import deque\n\n  def bfs(target):\n      \"\"\"Return a list of actions to reach *target* (row, col) or None.\"\"\"\n      q = deque([start])\n      visited = np.full((W, H), False, dtype=bool)\n      visited[start[0], start[1]] = True\n      # predecessor for path reconstruction\n      prev = np.empty((W, H, 2), dtype=int)\n\n      while q:\n          x, y = q.popleft()\n          if (x, y) == tuple(target):\n              # reconstruct path\n              actions = []\n              cx, cy = x, y\n              while (cx, cy) != start:\n                  px, py = prev[cx, cy]\n                  dx, dy = cx - px, cy - py\n                  if dx == 1:\n                      actions.append(DOWN)\n                  elif dx == -1:\n                      actions.append(UP)\n                  elif dy == 1:\n                      actions.append(RIGHT)\n                  elif dy == -1:\n                      actions.append(LEFT)\n                  cx, cy = px, py\n              actions.reverse()\n              return actions\n\n          # explore neighbours\n          for nx, ny, a in [(x + 1, y, DOWN), (x - 1, y, UP),\n                            (x, y + 1, RIGHT), (x, y - 1, LEFT)]:\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  # allow stepping onto the target even if blocked (it contains the stick)\n                  if (nx, ny) == tuple(target) or not blocked[nx, ny]:\n                      visited[nx, ny] = True\n                      prev[nx, ny] = (x, y)\n                      q.append((nx, ny))\n      return None\n\n  # find the shortest reachable stick\n  best_path = None\n  for cell in stick_cells:\n      path = bfs(cell)\n      if path is not None and (best_path is None or len(path) < len(best_path)):\n          best_path = path\n\n  if best_path is None:\n      # no reachable stick found\n      return []\n\n  # pick up the stick\n  best_path.append(USE)\n  return best_path", "env_interactions": 0, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:26:57.851995", "function_name": "make_arrow", "function_body": "  def _move_actions(cur_pos, target):\n      actions = []\n      x, y = cur_pos\n      tx, ty = target\n      while x < tx:\n          actions.append(3)  # RIGHT\n          x += 1\n      while x > tx:\n          actions.append(2)  # LEFT\n          x -= 1\n      while y < ty:\n          actions.append(0)  # DOWN\n          y += 1\n      while y > ty:\n          actions.append(1)  # UP\n          y -= 1\n      return actions, (x, y)\n\n  state = env._current_state\n  cookbook = env.world.cookbook\n  stick_idx = cookbook.index['stick']\n\n  # 1) Already have a stick in inventory.\n  if state.inventory[stick_idx] > 0:\n      return []\n\n  # 2) Look for a stick placed on the grid and pick it up.\n  stick_cells = np.argwhere(state.grid[:, :, stick_idx] > 0)\n  if stick_cells.size > 0:\n      target = tuple(stick_cells[0])\n      moves, _ = _move_actions(state.pos, target)\n      moves.append(4)  # USE to pick up the stick\n      return moves\n\n  # 3) Need to craft a stick from its primitive ingredients.\n  primitive_req = cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n  recipe = cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = cookbook.index[workshop_name] if workshop_name is not None else None\n\n  actions = []\n  cur_pos = state.pos\n  inventory = state.inventory.copy()\n\n  # 3a) Collect each required primitive.\n  for prim_idx, needed in primitive_req.items():\n      while inventory[prim_idx] < needed:\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # No more of this primitive on the map \u2013 abort planning.\n              return actions\n          target = tuple(prim_cells[0])\n          moves, cur_pos = _move_actions(cur_pos, target)\n          actions.extend(moves)\n          actions.append(4)                # USE to pick up primitive\n          inventory[prim_idx] += 1\n\n  # 3b) Go to the appropriate workshop (if any) and craft the stick.\n  if workshop_idx is not None:\n      ws_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if ws_cells.size > 0:\n          target = tuple(ws_cells[0])\n          moves, cur_pos = _move_actions(cur_pos, target)\n          actions.extend(moves)\n  # Use action to trigger crafting at the current location.\n  actions.append(4)  # USE\n\n  return actions", "env_interactions": 4, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:26:59.187742", "function_name": "make_arrow", "function_body": "  def _move_actions(start, goal):\n      actions = []\n      x, y = start\n      tx, ty = goal\n      while x < tx:\n          actions.append(3)   # RIGHT\n          x += 1\n      while x > tx:\n          actions.append(2)   # LEFT\n          x -= 1\n      while y < ty:\n          actions.append(0)   # DOWN\n          y += 1\n      while y > ty:\n          actions.append(1)   # UP\n          y -= 1\n      return actions, (x, y)\n\n  # current state and cookbook\n  state = env._current_state\n  cookbook = env.world.cookbook\n  stick_idx = cookbook.index['stick']\n\n  # already have a stick\n  if state.inventory[stick_idx] > 0:\n      return []\n\n  # look for a stick placed on the grid and pick it up\n  stick_cells = np.argwhere(state.grid[:, :, stick_idx] > 0)\n  if stick_cells.size > 0:\n      target = tuple(stick_cells[0])\n      moves, _ = _move_actions(state.pos, target)\n      moves.append(4)                     # USE to pick up\n      return moves\n\n  # need to craft a stick\n  primitive_req = cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n  recipe = cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = cookbook.index[workshop_name] if workshop_name is not None else None\n\n  actions = []\n  cur_pos = state.pos\n  inventory = state.inventory.copy()\n\n  # collect required primitives\n  for prim_idx, needed in primitive_req.items():\n      while inventory[prim_idx] < needed:\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # primitive not available \u2013 abort planning\n              return actions\n          target = tuple(prim_cells[0])\n          moves, cur_pos = _move_actions(cur_pos, target)\n          actions.extend(moves)\n          actions.append(4)                # USE to pick up primitive\n          inventory[prim_idx] += 1\n\n  # go to workshop if required\n  if workshop_idx is not None:\n      ws_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if ws_cells.size > 0:\n          target = tuple(ws_cells[0])\n          moves, cur_pos = _move_actions(cur_pos, target)\n          actions.extend(moves)\n\n  # craft the stick at current location\n  actions.append(4)    # USE\n\n  return actions", "env_interactions": 4, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:27:19.390799", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # Action indices (as defined in CraftLab.action_specs)\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of actions moving horizontally then vertically.\"\"\"\n      sx, sy = start\n      gx, gy = goal\n      actions = []\n      while sx < gx:\n          actions.append(ACTION_RIGHT)\n          sx += 1\n      while sx > gx:\n          actions.append(ACTION_LEFT)\n          sx -= 1\n      while sy < gy:\n          actions.append(ACTION_DOWN)\n          sy += 1\n      while sy > gy:\n          actions.append(ACTION_UP)\n          sy -= 1\n      return actions\n\n  def nearest_position(positions, reference):\n      \"\"\"Pick the position from *positions* with smallest Manhattan distance to *reference*.\"\"\"\n      if len(positions) == 0:\n          return None\n      ref = np.array(reference)\n      dists = np.sum(np.abs(positions - ref), axis=1)\n      return tuple(positions[np.argmin(dists)])\n\n  # ------------------------------------------------------------------\n  # Gather current state information\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n\n  # ------------------------------------------------------------------\n  # Goal: stick\n  # ------------------------------------------------------------------\n  goal_name = \"stick\"\n  try:\n      goal_idx = env.world.cookbook.index[goal_name]\n  except Exception:\n      return []\n\n  # If we already have a stick, no actions needed\n  if inventory[goal_idx] > 0:\n      return []\n\n  plan_actions = []\n\n  # ------------------------------------------------------------------\n  # Determine required primitives for the stick\n  # ------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n\n  # If there is no recipe (stick is a primitive), just collect it directly.\n  if not primitives_needed:\n      stick_cells = np.argwhere(grid[:, :, goal_idx] > 0)\n      if stick_cells.size == 0:\n          return plan_actions\n      target = nearest_position(stick_cells, pos)\n      plan_actions.extend(manhattan_path(pos, target))\n      plan_actions.append(ACTION_USE)\n      return plan_actions\n\n  # ------------------------------------------------------------------\n  # 1) Collect needed primitives\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      while inventory[prim_idx] < needed_cnt:\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # Cannot satisfy requirement; abort planning\n              return plan_actions\n          target = nearest_position(prim_cells, pos)\n\n          # Move to the primitive\n          plan_actions.extend(manhattan_path(pos, target))\n          pos = target\n\n          # Pick it up\n          plan_actions.append(ACTION_USE)\n\n          # Simulate local state update for further planning\n          inventory[prim_idx] += 1\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # ------------------------------------------------------------------\n  # 2) Go to the required workshop and craft the stick (if any)\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      try:\n          workshop_idx = env.world.cookbook.index[workshop_name]\n      except Exception:\n          return plan_actions\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          return plan_actions\n      wcell = tuple(workshop_cells[0])\n\n      # Find a free adjacent cell to stand on (or fallback to the workshop cell)\n      neighbours = [(wcell[0] + dx, wcell[1] + dy) for dx, dy in\n                    [(1, 0), (-1, 0), (0, 1), (0, -1)]]\n      stand_pos = None\n      for nx, ny in neighbours:\n          if (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and\n                  grid[nx, ny, :].sum() == 0):\n              stand_pos = (nx, ny)\n              break\n      if stand_pos is None:\n          stand_pos = wcell  # fallback\n\n      # Move to the chosen standing position\n      plan_actions.extend(manhattan_path(pos, stand_pos))\n      pos = stand_pos\n\n      # Use the workshop to craft the stick\n      plan_actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # Return the constructed action list\n  # ------------------------------------------------------------------\n  return plan_actions", "env_interactions": 5, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:27:20.676922", "function_name": "make_arrow", "function_body": "  # Action indices as defined in CraftLab.action_specs\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions from start to goal (horizontal then vertical).\"\"\"\n      sx, sy = start\n      gx, gy = goal\n      actions = []\n      while sx < gx:\n          actions.append(ACTION_RIGHT)\n          sx += 1\n      while sx > gx:\n          actions.append(ACTION_LEFT)\n          sx -= 1\n      while sy < gy:\n          actions.append(ACTION_DOWN)\n          sy += 1\n      while sy > gy:\n          actions.append(ACTION_UP)\n          sy -= 1\n      return actions\n\n  def nearest_position(positions, reference):\n      \"\"\"Pick the position from *positions* with smallest Manhattan distance to *reference*.\"\"\"\n      if len(positions) == 0:\n          return None\n      ref = np.array(reference)\n      dists = np.sum(np.abs(positions - ref), axis=1)\n      return tuple(positions[np.argmin(dists)])\n\n  # ------------------------------------------------------------------\n  # Gather current state information\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n\n  # ------------------------------------------------------------------\n  # Goal: stick\n  # ------------------------------------------------------------------\n  goal_name = \"stick\"\n  try:\n      goal_idx = env.world.cookbook.index[goal_name]\n  except Exception:\n      return []\n\n  plan_actions = []\n\n  # ------------------------------------------------------------------\n  # Determine required primitives for the stick\n  # ------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n\n  # If there is no recipe (stick is a primitive), just collect it directly.\n  if not primitives_needed:\n      stick_cells = np.argwhere(grid[:, :, goal_idx] > 0)\n      if stick_cells.size == 0:\n          return plan_actions\n      target = nearest_position(stick_cells, pos)\n      plan_actions.extend(manhattan_path(pos, target))\n      plan_actions.append(ACTION_USE)\n      return plan_actions\n\n  # ------------------------------------------------------------------\n  # 1) Collect needed primitives\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      while inventory[prim_idx] < needed_cnt:\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              return plan_actions  # cannot satisfy requirement\n          target = nearest_position(prim_cells, pos)\n\n          # Move to the primitive\n          plan_actions.extend(manhattan_path(pos, target))\n          pos = target\n\n          # Pick it up\n          plan_actions.append(ACTION_USE)\n\n          # Simulate pick\u2011up locally for further planning\n          inventory[prim_idx] += 1\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # ------------------------------------------------------------------\n  # 2) Go to workshop (if required) and craft the stick\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      try:\n          workshop_idx = env.world.cookbook.index[workshop_name]\n      except Exception:\n          return plan_actions\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          return plan_actions  # no workshop visible\n      wcell = tuple(workshop_cells[0])\n\n      # Find a free adjacent cell to stand on (fallback to the workshop cell itself)\n      neighbours = [(wcell[0] + dx, wcell[1] + dy) for dx, dy in\n                    [(1, 0), (-1, 0), (0, 1), (0, -1)]]\n      stand_pos = None\n      for nx, ny in neighbours:\n          if (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and\n                  grid[nx, ny, :].sum() == 0):\n              stand_pos = (nx, ny)\n              break\n      if stand_pos is None:\n          stand_pos = wcell\n\n      # Move to the chosen standing position\n      plan_actions.extend(manhattan_path(pos, stand_pos))\n      pos = stand_pos\n\n      # Use the workshop to craft the stick\n      plan_actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # Return the constructed action list\n  # ------------------------------------------------------------------\n  return plan_actions", "env_interactions": 5, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:27:51.405750", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # reset environment and get initial state\n  env.reset()\n  state = env._current_state\n  grid = state.grid\n  width, height = grid.shape[:2]\n\n  # direction vectors and mapping to action indices (DOWN=0, UP=1, LEFT=2, RIGHT=3)\n  dirs = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n  dir_action = {(0, 1): 0, (0, -1): 1, (-1, 0): 2, (1, 0): 3}\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def find_cells(kind):\n      \"\"\"Return list of (x, y) positions where the given kind is present.\"\"\"\n      xs, ys = np.where(grid[:, :, kind] > 0)\n      return list(zip(xs, ys))\n\n  def bfs(start, goal):\n      \"\"\"Return a list of (dx, dy) moves from start to goal avoiding occupied cells.\"\"\"\n      q = deque([start])\n      visited = {start}\n      prev = {}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          x, y = cur\n          for dx, dy in dirs:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height:\n                  if (nx, ny) not in visited and not np.any(grid[nx, ny, :]):\n                      visited.add((nx, ny))\n                      prev[(nx, ny)] = (cur, (dx, dy))\n                      q.append((nx, ny))\n      if start == goal:\n          return []\n      if goal not in prev:\n          return []  # no path found\n      # reconstruct path\n      path = []\n      cur = goal\n      while cur != start:\n          prev_node, move = prev[cur]\n          path.append(move)\n          cur = prev_node\n      path.reverse()\n      return path\n\n  # ------------------------------------------------------------------\n  # Identify the recipe for a stick\n  # ------------------------------------------------------------------\n  stick_idx = env.world.cookbook.index[\"stick\"]\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  primitive_needs = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  # ------------------------------------------------------------------\n  # Collect required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          prim_cells = find_cells(prim_idx)\n          if not prim_cells:\n              continue  # primitive not present; skip\n          tx, ty = prim_cells[0]  # take first occurrence\n\n          # Try to stand on a free neighbour from which we can USE the primitive\n          neighbour_found = False\n          for dx, dy in dirs:\n              nx, ny = tx - dx, ty - dy  # cell opposite the direction we will face\n              if 0 <= nx < width and 0 <= ny < height and not np.any(grid[nx, ny, :]):\n                  # move there\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  # turn to face the primitive\n                  actions.append(dir_action[(-dx, -dy)])\n                  state.dir = dir_action[(-dx, -dy)]\n                  # pick up\n                  actions.append(4)  # USE\n                  neighbour_found = True\n                  break\n\n          # Fallback: any free adjacent cell, then turn towards primitive\n          if not neighbour_found:\n              for dx, dy in dirs:\n                  nx, ny = tx + dx, ty + dy\n                  if 0 <= nx < width and 0 <= ny < height and not np.any(grid[nx, ny, :]):\n                      path = bfs(state.pos, (nx, ny))\n                      for mv in path:\n                          actions.append(dir_action[mv])\n                          state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                          state.dir = dir_action[mv]\n                      actions.append(dir_action[(-dx, -dy)])\n                      state.dir = dir_action[(-dx, -dy)]\n                      actions.append(4)  # USE\n                      neighbour_found = True\n                      break\n\n  # ------------------------------------------------------------------\n  # Craft the stick at its workshop (if required)\n  # ------------------------------------------------------------------\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      workshop_cells = find_cells(workshop_idx)\n      if workshop_cells:\n          wx, wy = workshop_cells[0]\n          # Find a free neighbour to stand on\n          for dx, dy in dirs:\n              nx, ny = wx - dx, wy - dy\n              if 0 <= nx < width and 0 <= ny < height and not np.any(grid[nx, ny, :]):\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  actions.append(4)  # USE to craft the stick\n                  break\n\n  return actions", "env_interactions": 8, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-23T02:27:52.719175", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  grid = state.grid\n  width, height = grid.shape[:2]\n\n  # direction vectors and mapping to action indices (DOWN=0, UP=1, LEFT=2, RIGHT=3)\n  dirs = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n  dir_action = {(0, 1): 0, (0, -1): 1, (-1, 0): 2, (1, 0): 3}\n\n  actions = []\n\n  # helper to locate all cells containing a given kind index\n  def find_cells(kind):\n      xs, ys = np.where(grid[:, :, kind] > 0)\n      return list(zip(xs, ys))\n\n  # BFS that finds a path of moves (dx,dy) on free cells only\n  from collections import deque\n\n  def bfs(start, goal):\n      \"\"\"Return list of (dx,dy) moves from start to goal avoiding occupied cells.\"\"\"\n      q = deque([start])\n      visited = {start}\n      prev = {}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          x, y = cur\n          for dx, dy in dirs:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height:\n                  if (nx, ny) not in visited and not np.any(grid[nx, ny, :]):\n                      visited.add((nx, ny))\n                      prev[(nx, ny)] = (cur, (dx, dy))\n                      q.append((nx, ny))\n      if start == goal:\n          return []\n      if goal not in prev:\n          return []  # no path found\n      # reconstruct moves\n      path = []\n      cur = goal\n      while cur != start:\n          prev_node, move = prev[cur]\n          path.append(move)\n          cur = prev_node\n      path.reverse()\n      return path\n\n  # ----------------------------------------------------------------------\n  # Identify the recipe for a stick\n  # ----------------------------------------------------------------------\n  stick_idx = env.world.cookbook.index[\"stick\"]\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  primitive_needs = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive the needed number of times\n  # ----------------------------------------------------------------------\n  for prim_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          prim_cells = find_cells(prim_idx)\n          if not prim_cells:\n              continue  # primitive not present; skip\n          tx, ty = prim_cells[0]\n\n          # Try to stand on a free neighbour from which we can USE the primitive\n          neighbour_found = False\n          for dx, dy in dirs:\n              nx, ny = tx - dx, ty - dy  # cell opposite the direction we will face\n              if 0 <= nx < width and 0 <= ny < height and not np.any(grid[nx, ny, :]):\n                  # Move to (nx, ny)\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  # Face the primitive\n                  actions.append(dir_action[(-dx, -dy)])\n                  state.dir = dir_action[(-dx, -dy)]\n                  # Pick up\n                  actions.append(4)  # USE action\n                  neighbour_found = True\n                  break\n\n          if not neighbour_found:\n              # Fallback: any adjacent free cell, then turn towards primitive\n              for dx, dy in dirs:\n                  nx, ny = tx + dx, ty + dy\n                  if 0 <= nx < width and 0 <= ny < height and not np.any(grid[nx, ny, :]):\n                      path = bfs(state.pos, (nx, ny))\n                      for mv in path:\n                          actions.append(dir_action[mv])\n                          state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                          state.dir = dir_action[mv]\n                      actions.append(dir_action[(-dx, -dy)])\n                      state.dir = dir_action[(-dx, -dy)]\n                      actions.append(4)  # USE\n                      neighbour_found = True\n                      break\n\n  # ----------------------------------------------------------------------\n  # If the recipe requires a workshop, move there and craft the stick\n  # ----------------------------------------------------------------------\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      workshop_cells = find_cells(workshop_idx)\n      if workshop_cells:\n          wx, wy = workshop_cells[0]\n          # Find a free neighbour to stand on\n          for dx, dy in dirs:\n              nx, ny = wx - dx, wy - dy\n              if 0 <= nx < width and 0 <= ny < height and not np.any(grid[nx, ny, :]):\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  # Use to craft\n                  actions.append(4)  # USE\n                  break\n\n  return actions", "env_interactions": 8, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-23T02:28:10.577125", "function_name": "make_arrow", "function_body": "  from collections import deque\n\n  def _bfs_path(start, goal, blocked):\n      act = env.action_specs()\n      moves = [\n          (0, 1, act[\"DOWN\"]),\n          (0, -1, act[\"UP\"]),\n          (-1, 0, act[\"LEFT\"]),\n          (1, 0, act[\"RIGHT\"]),\n      ]\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for dx, dy, a in moves:\n              nx, ny = x + dx, y + dy\n              if (\n                  0 <= nx < blocked.shape[0]\n                  and 0 <= ny < blocked.shape[1]\n                  and not blocked[nx, ny]\n                  and (nx, ny) not in visited\n              ):\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [a]))\n      return None\n\n  # ----------------------------------------------------------------------\n  # Main planning\n  # ----------------------------------------------------------------------\n  state = env._current_state\n  world = env.world\n  grid = state.grid.copy()\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # Primitive requirements for a stick (empty if stick is primitive)\n  needed_prims = dict(world.cookbook.primitives_for(stick_idx))\n\n  # Cells that block movement (non\u2011grabbable entities)\n  blocked = np.zeros(grid.shape[:2], dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # ----------------------------------------------------------------------\n  # Case 1: stick is already a primitive placed in the world\n  # ----------------------------------------------------------------------\n  if not needed_prims:\n      stick_cells = np.argwhere(grid[:, :, stick_idx] > 0)\n      if stick_cells.size == 0:\n          return []  # no stick to pick up\n      target = tuple(stick_cells[0])\n      if cur_pos != target:\n          path = _bfs_path(cur_pos, target, blocked)\n          if path is None:\n              return []  # unreachable\n          actions.extend(path)\n      actions.append(env.action_specs()[\"USE\"])\n      return actions\n\n  # ----------------------------------------------------------------------\n  # Case 2: collect required primitives\n  # ----------------------------------------------------------------------\n  while any(cnt > 0 for cnt in needed_prims.values()):\n      best_path = None\n      best_target = None\n      best_prim = None\n\n      for prim_idx, cnt in needed_prims.items():\n          if cnt <= 0:\n              continue\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          for cell in prim_cells:\n              target = tuple(cell)\n              path = _bfs_path(cur_pos, target, blocked)\n              if path is None:\n                  continue\n              if best_path is None or len(path) < len(best_path):\n                  best_path = path\n                  best_target = target\n                  best_prim = prim_idx\n\n      if best_path is None:\n          # No reachable primitive left; cannot complete task\n          return []\n\n      actions.extend(best_path)\n      actions.append(env.action_specs()[\"USE\"])\n\n      # Update bookkeeping\n      cur_pos = best_target\n      needed_prims[best_prim] -= 1\n      grid[best_target[0], best_target[1], best_prim] = 0\n\n  # ----------------------------------------------------------------------\n  # Case 3: go to the workshop (if required by the recipe)\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_cells.size > 0:\n          target = tuple(ws_cells[0])\n          if cur_pos != target:\n              path = _bfs_path(cur_pos, target, blocked)\n              if path is None:\n                  return []  # cannot reach workshop\n              actions.extend(path)\n              cur_pos = target\n\n  # ----------------------------------------------------------------------\n  # Finally, craft the stick\n  # ----------------------------------------------------------------------\n  actions.append(env.action_specs()[\"USE\"])\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:28:11.902178", "function_name": "make_arrow", "function_body": "  from collections import deque\n\n  def _bfs_path(start, goal, blocked):\n      act_map = env.action_specs()\n      moves = [\n          (0, 1, act_map[\"DOWN\"]),\n          (0, -1, act_map[\"UP\"]),\n          (-1, 0, act_map[\"LEFT\"]),\n          (1, 0, act_map[\"RIGHT\"]),\n      ]\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for dx, dy, a in moves:\n              nx, ny = x + dx, y + dy\n              if (\n                  0 <= nx < blocked.shape[0]\n                  and 0 <= ny < blocked.shape[1]\n                  and not blocked[nx, ny]\n                  and (nx, ny) not in visited\n              ):\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [a]))\n      return None  # unreachable\n\n  state = env._current_state\n  world = env.world\n  grid = state.grid.copy()\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # Primitive requirements for a stick (empty if stick itself is primitive)\n  prim_req = world.cookbook.primitives_for(stick_idx)  # dict {prim_idx: count}\n\n  # Cells that block movement (non\u2011grabbable entities)\n  blocked = np.zeros(grid.shape[:2], dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # ------------------------------------------------------------------\n  # Case 1: stick is already a primitive placed in the world\n  # ------------------------------------------------------------------\n  if not prim_req:\n      stick_cells = np.argwhere(grid[:, :, stick_idx] > 0)\n      if stick_cells.size == 0:\n          return []  # nothing to do\n      target = tuple(stick_cells[0])\n      if cur_pos != target:\n          path = _bfs_path(cur_pos, target, blocked)\n          if path is None:\n              return []  # unreachable\n          actions.extend(path)\n      actions.append(env.action_specs()[\"USE\"])\n      return actions\n\n  # ------------------------------------------------------------------\n  # Case 2: collect required primitives\n  # ------------------------------------------------------------------\n  needed = dict(prim_req)  # mutable copy\n  while any(cnt > 0 for cnt in needed.values()):\n      best_path = None\n      best_target = None\n      best_prim = None\n\n      for prim_idx, cnt in needed.items():\n          if cnt <= 0:\n              continue\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          for cell in prim_cells:\n              target = tuple(cell)\n              path = _bfs_path(cur_pos, target, blocked)\n              if path is None:\n                  continue\n              if best_path is None or len(path) < len(best_path):\n                  best_path = path\n                  best_target = target\n                  best_prim = prim_idx\n\n      if best_path is None:\n          return []  # cannot reach any remaining required primitive\n\n      actions.extend(best_path)\n      actions.append(env.action_specs()[\"USE\"])\n\n      cur_pos = best_target\n      needed[best_prim] -= 1\n      grid[best_target[0], best_target[1], best_prim] = 0  # remove from copy\n\n  # ------------------------------------------------------------------\n  # Case 3: go to the workshop (if recipe specifies one)\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_cells.size > 0:\n          target = tuple(ws_cells[0])\n          if cur_pos != target:\n              path = _bfs_path(cur_pos, target, blocked)\n              if path is None:\n                  return []  # cannot reach workshop\n              actions.extend(path)\n              cur_pos = target\n\n  # ------------------------------------------------------------------\n  # Finally, craft the stick\n  # ------------------------------------------------------------------\n  actions.append(env.action_specs()[\"USE\"])\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:28:30.786240", "function_name": "make_arrow", "function_body": "  # Helper: shortest path (BFS) avoiding blocked cells\n  from collections import deque\n\n  def _bfs_path(start, goal, blocked):\n      act_map = env.action_specs()\n      dirs = [\n          (0, 1, act_map[\"DOWN\"]),\n          (0, -1, act_map[\"UP\"]),\n          (-1, 0, act_map[\"LEFT\"]),\n          (1, 0, act_map[\"RIGHT\"]),\n      ]\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for dx, dy, a in dirs:\n              nx, ny = x + dx, y + dy\n              if (\n                  0 <= nx < blocked.shape[0]\n                  and 0 <= ny < blocked.shape[1]\n                  and not blocked[nx, ny]\n                  and (nx, ny) not in visited\n              ):\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [a]))\n      return None  # unreachable\n\n  # ----------------------------------------------------------------------\n  # Main planning\n  # ----------------------------------------------------------------------\n  state = env._current_state\n  world = env.world\n  grid = state.grid.copy()                     # mutable copy for bookkeeping\n  stick_idx = world.cookbook.index[\"stick\"]    # target item index\n\n  # Primitive requirements for one stick (empty if stick is primitive)\n  prim_req = world.cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n\n  # Determine cells that cannot be traversed (non\u2011grabbable entities)\n  blocked = np.zeros(grid.shape[:2], dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  actions_plan = []\n  cur_pos = tuple(state.pos)\n\n  # ----------------------------------------------------------------------\n  # Case 1: stick is a primitive already placed in the world\n  # ----------------------------------------------------------------------\n  if not prim_req:\n      stick_cells = np.argwhere(grid[:, :, stick_idx] > 0)\n      if stick_cells.size == 0:\n          return []  # nothing to do / cannot find stick\n      target = tuple(stick_cells[0])\n      if cur_pos != target:\n          path = _bfs_path(cur_pos, target, blocked)\n          if path is None:\n              return []  # unreachable\n          actions_plan.extend(path)\n      actions_plan.append(env.action_specs()[\"USE\"])\n      return actions_plan\n\n  # ----------------------------------------------------------------------\n  # Case 2: collect required primitives\n  # ----------------------------------------------------------------------\n  needed = dict(prim_req)   # mutable copy of required counts\n\n  while any(cnt > 0 for cnt in needed.values()):\n      best_path = None\n      best_target = None\n      best_prim = None\n\n      # Look for the nearest reachable primitive of any needed type\n      for prim_idx, cnt in needed.items():\n          if cnt <= 0:\n              continue\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          for cell in prim_cells:\n              target = tuple(cell)\n              path = _bfs_path(cur_pos, target, blocked)\n              if path is None:\n                  continue\n              if best_path is None or len(path) < len(best_path):\n                  best_path = path\n                  best_target = target\n                  best_prim = prim_idx\n\n      if best_path is None:\n          # No reachable primitive left \u2192 abort planning\n          return []\n\n      # Move to the primitive and pick it up\n      actions_plan.extend(best_path)\n      actions_plan.append(env.action_specs()[\"USE\"])\n\n      # Update state tracking\n      cur_pos = best_target\n      needed[best_prim] -= 1\n      grid[best_target[0], best_target[1], best_prim] = 0   # remove from map\n\n  # ----------------------------------------------------------------------\n  # Case 3: go to the workshop (if the recipe specifies one)\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          target = tuple(workshop_cells[0])\n          if cur_pos != target:\n              path = _bfs_path(cur_pos, target, blocked)\n              if path is None:\n                  return []  # cannot reach workshop\n              actions_plan.extend(path)\n              cur_pos = target\n\n  # ----------------------------------------------------------------------\n  # Finally, craft the stick\n  # ----------------------------------------------------------------------\n  actions_plan.append(env.action_specs()[\"USE\"])\n  return actions_plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:28:32.204621", "function_name": "make_arrow", "function_body": "  # Helper: shortest path (BFS) avoiding non\u2011grabbable cells\n  from collections import deque\n\n  def _bfs_path(start, goal, blocked):\n      act_map = env.action_specs()\n      dirs = [\n          (0, 1, act_map[\"DOWN\"]),\n          (0, -1, act_map[\"UP\"]),\n          (-1, 0, act_map[\"LEFT\"]),\n          (1, 0, act_map[\"RIGHT\"]),\n      ]\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for dx, dy, a in dirs:\n              nx, ny = x + dx, y + dy\n              if (\n                  0 <= nx < blocked.shape[0]\n                  and 0 <= ny < blocked.shape[1]\n                  and not blocked[nx, ny]\n                  and (nx, ny) not in visited\n              ):\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [a]))\n      return None  # unreachable\n\n  # ------------------------------------------------------------------\n  # Main planning\n  # ------------------------------------------------------------------\n  state = env._current_state\n  world = env.world\n  grid = state.grid.copy()                     # mutable copy for bookkeeping\n  stick_idx = world.cookbook.index[\"stick\"]    # index of the target item\n\n  # Primitive requirements for one stick (empty if stick is primitive)\n  prim_req = world.cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n\n  # Cells that cannot be traversed (non\u2011grabbable entities)\n  blocked = np.zeros(grid.shape[:2], dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  actions_plan = []\n  cur_pos = tuple(state.pos)\n\n  # ------------------------------------------------------------------\n  # Case 1: stick is already a primitive placed in the world\n  # ------------------------------------------------------------------\n  if not prim_req:\n      stick_cells = np.argwhere(grid[:, :, stick_idx] > 0)\n      if stick_cells.size == 0:\n          return []  # nothing to do / cannot find stick\n      target = tuple(stick_cells[0])\n      if cur_pos != target:\n          path = _bfs_path(cur_pos, target, blocked)\n          if path is None:\n              return []  # unreachable\n          actions_plan.extend(path)\n      actions_plan.append(env.action_specs()[\"USE\"])\n      return actions_plan\n\n  # ------------------------------------------------------------------\n  # Case 2: collect required primitives\n  # ------------------------------------------------------------------\n  needed = dict(prim_req)   # mutable copy of required counts\n\n  while any(cnt > 0 for cnt in needed.values()):\n      best_path = None\n      best_target = None\n      best_prim = None\n\n      # Find nearest reachable primitive of any needed type\n      for prim_idx, cnt in needed.items():\n          if cnt <= 0:\n              continue\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          for cell in prim_cells:\n              target = tuple(cell)\n              path = _bfs_path(cur_pos, target, blocked)\n              if path is None:\n                  continue\n              if best_path is None or len(path) < len(best_path):\n                  best_path = path\n                  best_target = target\n                  best_prim = prim_idx\n\n      if best_path is None:\n          # No reachable primitive left \u2192 abort\n          return []\n\n      # Move to the primitive and pick it up\n      actions_plan.extend(best_path)\n      actions_plan.append(env.action_specs()[\"USE\"])\n\n      # Update planning state\n      cur_pos = best_target\n      needed[best_prim] -= 1\n      grid[best_target[0], best_target[1], best_prim] = 0   # remove from map\n\n  # ------------------------------------------------------------------\n  # Case 3: go to the workshop (if recipe specifies one)\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          target = tuple(workshop_cells[0])\n          if cur_pos != target:\n              path = _bfs_path(cur_pos, target, blocked)\n              if path is None:\n                  return []  # cannot reach workshop\n              actions_plan.extend(path)\n              cur_pos = target\n\n  # ------------------------------------------------------------------\n  # Finally, craft the stick\n  # ------------------------------------------------------------------\n  actions_plan.append(env.action_specs()[\"USE\"])\n  return actions_plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:28:49.528473", "function_name": "make_arrow", "function_body": "  def _move_to(cur_pos, target, seq):\n      x, y = cur_pos\n      tx, ty = target\n      while x < tx:\n          seq.append(3)  # RIGHT\n          x += 1\n      while x > tx:\n          seq.append(2)  # LEFT\n          x -= 1\n      while y < ty:\n          seq.append(0)  # DOWN\n          y += 1\n      while y > ty:\n          seq.append(1)  # UP\n          y -= 1\n      return (x, y)\n\n  state = env._current_state\n  grid = state.grid.copy()\n  cur_pos = state.pos\n  goal_idx = env.task.goal\n\n  # Retrieve recipe for the goal (empty if primitive)\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n  ingredients = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  actions = []\n\n  # Primitive case: just pick up the goal item.\n  if not ingredients:\n      locs = np.argwhere(grid[:, :, goal_idx] > 0)\n      if locs.size > 0:\n          dists = np.abs(locs[:, 0] - cur_pos[0]) + np.abs(locs[:, 1] - cur_pos[1])\n          chosen = int(np.argmin(dists))\n          target = tuple(locs[chosen].tolist())\n          cur_pos = _move_to(cur_pos, target, actions)\n          actions.append(4)  # USE to pick up\n      return actions\n\n  # Gather required ingredients.\n  for ing_kind, count in ingredients.items():\n      for _ in range(count):\n          locs = np.argwhere(grid[:, :, ing_kind] > 0)\n          if locs.size == 0:\n              # Ingredient missing; abort early.\n              return actions\n          dists = np.abs(locs[:, 0] - cur_pos[0]) + np.abs(locs[:, 1] - cur_pos[1])\n          chosen = int(np.argmin(dists))\n          target = tuple(locs[chosen].tolist())\n          cur_pos = _move_to(cur_pos, target, actions)\n          actions.append(4)  # USE to pick up\n          grid[target[0], target[1], ing_kind] = 0  # remove from map\n\n  # If a specific workshop is required, go there and craft.\n  if workshop_kind is not None:\n      ws_locs = np.argwhere(grid[:, :, workshop_kind] > 0)\n      if ws_locs.size > 0:\n          dists = np.abs(ws_locs[:, 0] - cur_pos[0]) + np.abs(ws_locs[:, 1] - cur_pos[1])\n          chosen = int(np.argmin(dists))\n          workshop = tuple(ws_locs[chosen].tolist())\n          cur_pos = _move_to(cur_pos, workshop, actions)\n          actions.append(4)  # USE to craft\n\n  return actions", "env_interactions": 0, "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:28:50.839258", "function_name": "make_arrow", "function_body": "  # Helper to move in Manhattan order (no obstacles considered)\n  def _move_to(cur_pos, target, seq):\n      x, y = cur_pos\n      tx, ty = target\n      while x < tx:\n          seq.append(3)  # RIGHT\n          x += 1\n      while x > tx:\n          seq.append(2)  # LEFT\n          x -= 1\n      while y < ty:\n          seq.append(0)  # DOWN\n          y += 1\n      while y > ty:\n          seq.append(1)  # UP\n          y -= 1\n      return (x, y)\n\n  state = env._current_state\n  grid = state.grid.copy()\n  cur_pos = state.pos\n  goal_idx = env.task.goal\n\n  # Retrieve recipe (may be empty for primitives)\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n  ingredients = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  actions = []\n\n  # Primitive case: just pick up the target item\n  if not ingredients:\n      locs = np.argwhere(grid[:, :, goal_idx] > 0)\n      if locs.size > 0:\n          dists = np.abs(locs[:, 0] - cur_pos[0]) + np.abs(locs[:, 1] - cur_pos[1])\n          chosen = int(np.argmin(dists))\n          target = tuple(locs[chosen].tolist())\n          cur_pos = _move_to(cur_pos, target, actions)\n          actions.append(4)  # USE\n      return actions\n\n  # Gather each required ingredient (respecting required counts)\n  for ing_kind, count in ingredients.items():\n      for _ in range(count):\n          locs = np.argwhere(grid[:, :, ing_kind] > 0)\n          if locs.size == 0:\n              # ingredient missing \u2013 abort early\n              return actions\n          dists = np.abs(locs[:, 0] - cur_pos[0]) + np.abs(locs[:, 1] - cur_pos[1])\n          chosen = int(np.argmin(dists))\n          target = tuple(locs[chosen].tolist())\n          cur_pos = _move_to(cur_pos, target, actions)\n          actions.append(4)                     # USE to pick up\n          grid[target[0], target[1], ing_kind] = 0\n\n  # If a specific workshop is required, go there and craft\n  if workshop_kind is not None:\n      ws_locs = np.argwhere(grid[:, :, workshop_kind] > 0)\n      if ws_locs.size > 0:\n          dists = np.abs(ws_locs[:, 0] - cur_pos[0]) + np.abs(ws_locs[:, 1] - cur_pos[1])\n          chosen = int(np.argmin(dists))\n          workshop = tuple(ws_locs[chosen].tolist())\n          cur_pos = _move_to(cur_pos, workshop, actions)\n          actions.append(4)                     # USE to craft\n\n  return actions", "env_interactions": 0, "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:29:18.108407", "function_name": "make_arrow", "function_body": "  # reset environment to get fresh state\n  env.reset()\n  state = env._current_state\n  grid = state.grid\n  width, height = grid.shape[:2]\n\n  # direction vectors and mapping to action indices (DOWN=0, UP=1, LEFT=2, RIGHT=3)\n  dirs = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n  dir_action = {(0, 1): 0, (0, -1): 1, (-1, 0): 2, (1, 0): 3}\n\n  actions = []\n\n  # helper to find all cells containing a given kind index\n  def find_cells(kind):\n      xs, ys = np.where(grid[:, :, kind] > 0)\n      return list(zip(xs.tolist(), ys.tolist()))\n\n  # BFS returning a list of (dx,dy) moves on free cells only\n  from collections import deque\n\n  def bfs(start, goal):\n      if start == goal:\n          return []\n      q = deque([start])\n      visited = {start}\n      prev = {}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          x, y = cur\n          for dx, dy in dirs:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height:\n                  if (nx, ny) not in visited and not grid[nx, ny].any():\n                      visited.add((nx, ny))\n                      prev[(nx, ny)] = (cur, (dx, dy))\n                      q.append((nx, ny))\n      if goal not in prev:\n          return []  # no path found\n      # reconstruct moves\n      path = []\n      cur = goal\n      while cur != start:\n          prev_node, move = prev[cur]\n          path.append(move)\n          cur = prev_node\n      path.reverse()\n      return path\n\n  # ----------------------------------------------------------------------\n  # Identify the recipe for a stick\n  # ----------------------------------------------------------------------\n  stick_idx = env.world.cookbook.index[\"stick\"]\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  primitive_needs = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive the needed number of times\n  # ----------------------------------------------------------------------\n  for prim_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          prim_cells = find_cells(prim_idx)\n          if not prim_cells:\n              continue  # primitive not present; skip\n          tx, ty = prim_cells[0]\n\n          # try to stand on a free neighbour opposite the direction we will face\n          neighbour_found = False\n          for dx, dy in dirs:\n              nx, ny = tx - dx, ty - dy\n              if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  # face the primitive\n                  actions.append(dir_action[(-dx, -dy)])\n                  state.dir = dir_action[(-dx, -dy)]\n                  # pick up\n                  actions.append(4)  # USE\n                  neighbour_found = True\n                  break\n\n          if not neighbour_found:\n              # fallback: any adjacent free cell then turn towards primitive\n              for dx, dy in dirs:\n                  nx, ny = tx + dx, ty + dy\n                  if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                      path = bfs(state.pos, (nx, ny))\n                      for mv in path:\n                          actions.append(dir_action[mv])\n                          state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                          state.dir = dir_action[mv]\n                      actions.append(dir_action[(-dx, -dy)])\n                      state.dir = dir_action[(-dx, -dy)]\n                      actions.append(4)  # USE\n                      neighbour_found = True\n                      break\n\n  # ----------------------------------------------------------------------\n  # If a workshop is required, move there and craft the stick\n  # ----------------------------------------------------------------------\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      workshop_cells = find_cells(workshop_idx)\n      if workshop_cells:\n          wx, wy = workshop_cells[0]\n          for dx, dy in dirs:\n              nx, ny = wx - dx, wy - dy\n              if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  actions.append(4)  # USE to craft\n                  break\n\n  return actions", "env_interactions": 8, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-23T02:29:19.510198", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Reset environment and get initial state\n  env.reset()\n  state = env._current_state\n  grid = state.grid\n  width, height = grid.shape[:2]\n\n  # Direction vectors and mapping to action indices (DOWN=0, UP=1, LEFT=2, RIGHT=3)\n  dirs = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n  dir_action = {(0, 1): 0, (0, -1): 1, (-1, 0): 2, (1, 0): 3}\n\n  actions = []\n\n  # Helper to find all cells containing a given kind index\n  def find_cells(kind):\n      xs, ys = np.where(grid[:, :, kind] > 0)\n      return list(zip(xs.tolist(), ys.tolist()))\n\n  # BFS returning a list of (dx,dy) moves from start to goal on free cells\n  def bfs(start, goal):\n      if start == goal:\n          return []\n      q = deque([start])\n      visited = {start}\n      prev = {}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          x, y = cur\n          for dx, dy in dirs:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height:\n                  if (nx, ny) not in visited and not grid[nx, ny].any():\n                      visited.add((nx, ny))\n                      prev[(nx, ny)] = (cur, (dx, dy))\n                      q.append((nx, ny))\n      if goal not in prev:\n          return []  # no path found\n      # reconstruct path\n      path = []\n      cur = goal\n      while cur != start:\n          prev_node, move = prev[cur]\n          path.append(move)\n          cur = prev_node\n      path.reverse()\n      return path\n\n  # ------------------------------------------------------------------\n  # Determine recipe for stick\n  # ------------------------------------------------------------------\n  stick_idx = env.world.cookbook.index[\"stick\"]\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  primitive_needs = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  # ------------------------------------------------------------------\n  # Collect required primitives (if any)\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          prim_cells = find_cells(prim_idx)\n          if not prim_cells:\n              continue  # primitive not present; skip\n          tx, ty = prim_cells[0]\n\n          # Find a free neighbour from which we can USE the primitive\n          neighbour_found = False\n          for dx, dy in dirs:\n              nx, ny = tx - dx, ty - dy  # cell opposite the direction we will face\n              if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                  # Move to neighbour\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  # Face the primitive\n                  actions.append(dir_action[(-dx, -dy)])\n                  state.dir = dir_action[(-dx, -dy)]\n                  # Use to pick up\n                  actions.append(4)  # USE\n                  neighbour_found = True\n                  break\n          if not neighbour_found:\n              # Fallback: any adjacent free cell, then turn towards primitive\n              for dx, dy in dirs:\n                  nx, ny = tx + dx, ty + dy\n                  if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                      path = bfs(state.pos, (nx, ny))\n                      for mv in path:\n                          actions.append(dir_action[mv])\n                          state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                          state.dir = dir_action[mv]\n                      actions.append(dir_action[(-dx, -dy)])\n                      state.dir = dir_action[(-dx, -dy)]\n                      actions.append(4)  # USE\n                      neighbour_found = True\n                      break\n\n  # ------------------------------------------------------------------\n  # If stick itself is a primitive (no recipe), just pick it up\n  # ------------------------------------------------------------------\n  if not primitive_needs and not recipe:\n      stick_cells = find_cells(stick_idx)\n      if stick_cells:\n          tx, ty = stick_cells[0]\n          neighbour_found = False\n          for dx, dy in dirs:\n              nx, ny = tx - dx, ty - dy\n              if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  actions.append(dir_action[(-dx, -dy)])\n                  state.dir = dir_action[(-dx, -dy)]\n                  actions.append(4)  # USE\n                  neighbour_found = True\n                  break\n          if not neighbour_found:\n              for dx, dy in dirs:\n                  nx, ny = tx + dx, ty + dy\n                  if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                      path = bfs(state.pos, (nx, ny))\n                      for mv in path:\n                          actions.append(dir_action[mv])\n                          state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                          state.dir = dir_action[mv]\n                      actions.append(dir_action[(-dx, -dy)])\n                      state.dir = dir_action[(-dx, -dy)]\n                      actions.append(4)  # USE\n                      break\n\n  # ------------------------------------------------------------------\n  # If the recipe requires a workshop, move there and craft the stick\n  # ------------------------------------------------------------------\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      workshop_cells = find_cells(workshop_idx)\n      if workshop_cells:\n          wx, wy = workshop_cells[0]\n          for dx, dy in dirs:\n              nx, ny = wx - dx, wy - dy\n              if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  actions.append(4)  # USE to craft stick\n                  break\n\n  return actions", "env_interactions": 8, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-23T02:29:41.112509", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  grid = state.grid\n  width, height = grid.shape[:2]\n\n  # movement vectors and action mapping (DOWN=0, UP=1, LEFT=2, RIGHT=3)\n  dirs = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n  dir_action = {(0, 1): 0, (0, -1): 1, (-1, 0): 2, (1, 0): 3}\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # helper utilities\n  # ------------------------------------------------------------------\n  def find_cells(kind):\n      \"\"\"Return list of (x, y) positions where the grid contains the given kind.\"\"\"\n      xs, ys = np.where(grid[:, :, kind] > 0)\n      return list(zip(xs.tolist(), ys.tolist()))\n\n  from collections import deque\n\n  def bfs(start, goal):\n      \"\"\"Return list of (dx, dy) moves from start to goal on free cells.\"\"\"\n      q = deque([start])\n      visited = {start}\n      prev = {}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          x, y = cur\n          for dx, dy in dirs:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height:\n                  if (nx, ny) not in visited and not grid[nx, ny].any():\n                      visited.add((nx, ny))\n                      prev[(nx, ny)] = (cur, (dx, dy))\n                      q.append((nx, ny))\n      if start == goal:\n          return []\n      if goal not in prev:\n          return []  # no path found\n      # reconstruct path\n      path = []\n      cur = goal\n      while cur != start:\n          pnode, move = prev[cur]\n          path.append(move)\n          cur = pnode\n      path.reverse()\n      return path\n\n  # ------------------------------------------------------------------\n  # identify stick recipe\n  # ------------------------------------------------------------------\n  stick_idx = env.world.cookbook.index[\"stick\"]\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  primitive_needs = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  # ------------------------------------------------------------------\n  # collect required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          prim_cells = find_cells(prim_idx)\n          if not prim_cells:\n              continue  # primitive not present in this scenario\n          tx, ty = prim_cells[0]\n\n          # try to stand on a free neighbour opposite the direction we will face\n          neighbour_found = False\n          for dx, dy in dirs:\n              nx, ny = tx - dx, ty - dy\n              if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  # face the primitive\n                  actions.append(dir_action[(-dx, -dy)])\n                  state.dir = dir_action[(-dx, -dy)]\n                  # pick up\n                  actions.append(4)  # USE\n                  neighbour_found = True\n                  break\n          if not neighbour_found:\n              # fallback: any adjacent free cell\n              for dx, dy in dirs:\n                  nx, ny = tx + dx, ty + dy\n                  if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                      path = bfs(state.pos, (nx, ny))\n                      for mv in path:\n                          actions.append(dir_action[mv])\n                          state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                          state.dir = dir_action[mv]\n                      actions.append(dir_action[(-dx, -dy)])\n                      state.dir = dir_action[(-dx, -dy)]\n                      actions.append(4)  # USE\n                      break\n\n  # ------------------------------------------------------------------\n  # craft at required workshop (if any)\n  # ------------------------------------------------------------------\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      workshop_cells = find_cells(workshop_idx)\n      if workshop_cells:\n          wx, wy = workshop_cells[0]\n          for dx, dy in dirs:\n              nx, ny = wx - dx, wy - dy\n              if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  actions.append(4)  # USE to craft\n                  break\n\n  return actions", "env_interactions": 8, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-23T02:29:42.482176", "function_name": "make_arrow", "function_body": "  # reset environment and get current state/grid dimensions\n  env.reset()\n  state = env._current_state\n  grid = state.grid\n  width, height = grid.shape[:2]\n\n  # direction vectors and mapping to action IDs (DOWN=0, UP=1, LEFT=2, RIGHT=3)\n  dirs = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n  dir_action = {(0, 1): 0, (0, -1): 1, (-1, 0): 2, (1, 0): 3}\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def find_cells(kind):\n      \"\"\"Return list of (x, y) positions where the grid contains the given kind.\"\"\"\n      xs, ys = np.where(grid[:, :, kind] > 0)\n      return list(zip(xs.tolist(), ys.tolist()))\n\n  from collections import deque\n\n  def bfs(start, goal):\n      \"\"\"Return a list of (dx, dy) moves from start to goal avoiding occupied cells.\"\"\"\n      q = deque([start])\n      visited = {start}\n      prev = {}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          x, y = cur\n          for dx, dy in dirs:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height:\n                  if (nx, ny) not in visited and not grid[nx, ny].any():\n                      visited.add((nx, ny))\n                      prev[(nx, ny)] = (cur, (dx, dy))\n                      q.append((nx, ny))\n      if start == goal:\n          return []\n      if goal not in prev:\n          return []  # no path found\n      # reconstruct path\n      path = []\n      cur = goal\n      while cur != start:\n          pnode, move = prev[cur]\n          path.append(move)\n          cur = pnode\n      path.reverse()\n      return path\n\n  # ------------------------------------------------------------------\n  # Identify stick recipe and its primitive requirements\n  # ------------------------------------------------------------------\n  stick_idx = env.world.cookbook.index[\"stick\"]\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  primitive_needs = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          prim_cells = find_cells(prim_idx)\n          if not prim_cells:\n              continue  # primitive not present in this scenario\n          tx, ty = prim_cells[0]\n\n          # Try to stand on a free neighbour opposite the direction we will face\n          neighbour_found = False\n          for dx, dy in dirs:\n              nx, ny = tx - dx, ty - dy  # cell opposite the facing direction\n              if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                  # Move to the neighbour\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  # Face the primitive\n                  actions.append(dir_action[(-dx, -dy)])\n                  state.dir = dir_action[(-dx, -dy)]\n                  # Pick it up\n                  actions.append(4)  # USE\n                  neighbour_found = True\n                  break\n\n          if not neighbour_found:\n              # Fallback: any adjacent free cell, then turn towards the primitive\n              for dx, dy in dirs:\n                  nx, ny = tx + dx, ty + dy\n                  if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                      path = bfs(state.pos, (nx, ny))\n                      for mv in path:\n                          actions.append(dir_action[mv])\n                          state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                          state.dir = dir_action[mv]\n                      actions.append(dir_action[(-dx, -dy)])\n                      state.dir = dir_action[(-dx, -dy)]\n                      actions.append(4)  # USE\n                      neighbour_found = True\n                      break\n\n  # ------------------------------------------------------------------\n  # If the stick requires a workshop, move there and craft it\n  # ------------------------------------------------------------------\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      workshop_cells = find_cells(workshop_idx)\n      if workshop_cells:\n          wx, wy = workshop_cells[0]\n          # Find a free neighbour to stand on\n          for dx, dy in dirs:\n              nx, ny = wx - dx, wy - dy\n              if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  actions.append(4)  # USE to craft the stick\n                  break\n\n  return actions", "env_interactions": 8, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-23T02:29:57.771781", "function_name": "make_arrow", "function_body": "  actions = []\n  state = env._current_state\n  grid = state.grid\n  world = env.world\n  cb = world.cookbook\n\n  # target item index for \"stick\"\n  try:\n      goal_idx = cb.index[\"stick\"]\n  except Exception:\n      return actions\n\n  # primitive requirements for the stick (empty if stick is a primitive)\n  prims = cb.primitives_for(goal_idx)\n\n  # mutable copy of current position (x, y)\n  pos = list(state.pos)\n\n  # helper to move agent to a target cell using Manhattan steps\n  def _move_to(target):\n      nonlocal pos, actions\n      tx, ty = target\n      while pos[0] < tx:\n          actions.append(3)   # RIGHT\n          pos[0] += 1\n      while pos[0] > tx:\n          actions.append(2)   # LEFT\n          pos[0] -= 1\n      while pos[1] < ty:\n          actions.append(0)   # DOWN\n          pos[1] += 1\n      while pos[1] > ty:\n          actions.append(1)   # UP\n          pos[1] -= 1\n\n  # If stick is a primitive (no recipe), just pick it up.\n  if not prims:\n      locs = np.argwhere(grid[:, :, goal_idx] > 0)\n      if locs.size:\n          _move_to(locs[0].tolist())\n          actions.append(4)   # USE to pick up the stick\n      return actions\n\n  # Collect each required primitive\n  for prim_idx, needed in prims.items():\n      locs = np.argwhere(grid[:, :, prim_idx] > 0)\n      if not locs.size:\n          continue  # primitive not found; skip (should not happen)\n      _move_to(locs[0].tolist())\n      for _ in range(needed):\n          actions.append(4)   # USE to pick up one unit\n\n  # Move to the workshop (if the recipe specifies one) and craft the stick\n  recipe = cb.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = cb.index[workshop_name]\n      w_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if w_locs.size:\n          _move_to(w_locs[0].tolist())\n          actions.append(4)   # USE to craft at the workshop\n\n  return actions", "env_interactions": 4, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:29:59.080209", "function_name": "make_arrow", "function_body": "  actions = []\n  state = env._current_state\n  grid = state.grid\n  world = env.world\n  cb = world.cookbook\n\n  # Index of the target item \"stick\"\n  try:\n      goal_idx = cb.index[\"stick\"]\n  except Exception:\n      return actions\n\n  # Primitive requirements for the stick (empty dict if stick is primitive)\n  prims = cb.primitives_for(goal_idx)\n\n  # Current mutable agent position\n  pos = list(state.pos)\n\n  # Helper to move the agent to a target cell using Manhattan steps\n  def _move_to(target):\n      nonlocal pos, actions\n      tx, ty = target\n      while pos[0] < tx:\n          actions.append(3)   # RIGHT\n          pos[0] += 1\n      while pos[0] > tx:\n          actions.append(2)   # LEFT\n          pos[0] -= 1\n      while pos[1] < ty:\n          actions.append(0)   # DOWN\n          pos[1] += 1\n      while pos[1] > ty:\n          actions.append(1)   # UP\n          pos[1] -= 1\n\n  # If stick is a primitive (no recipe), just pick it up.\n  if not prims:\n      locations = np.argwhere(grid[:, :, goal_idx] > 0)\n      if locations.size:\n          _move_to(locations[0].tolist())\n          actions.append(4)   # USE to pick up the stick\n      return actions\n\n  # Collect each required primitive\n  for prim_idx, needed in prims.items():\n      # Find cells containing this primitive\n      locations = np.argwhere(grid[:, :, prim_idx] > 0)\n      if locations.size == 0:\n          continue  # Primitive not found; should not happen in valid scenarios\n      target = locations[0].tolist()  # Choose first occurrence\n      _move_to(target)\n      for _ in range(needed):\n          actions.append(4)   # USE to pick up one unit\n\n  # Move to the workshop (if the recipe specifies one) and craft the stick\n  recipe = cb.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = cb.index[workshop_name]\n      w_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if w_locs.size:\n          _move_to(w_locs[0].tolist())\n          actions.append(4)   # USE to craft at the workshop\n\n  return actions", "env_interactions": 4, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:30:24.832107", "function_name": "make_arrow", "function_body": "  # Reset environment and get initial state\n  env.reset()\n  state = env._current_state\n  grid = state.grid\n  width, height = grid.shape[:2]\n\n  # Direction vectors and corresponding action indices (DOWN=0, UP=1, LEFT=2, RIGHT=3)\n  dirs = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n  dir_action = {(0, 1): 0, (0, -1): 1, (-1, 0): 2, (1, 0): 3}\n\n  actions = []\n\n  # Helper: locate all cells containing a given kind index\n  def find_cells(kind):\n      xs, ys = np.where(grid[:, :, kind] > 0)\n      return list(zip(xs.tolist(), ys.tolist()))\n\n  # BFS on free cells (cells with no entities)\n  from collections import deque\n\n  def bfs(start, goal):\n      \"\"\"Return list of (dx,dy) moves from start to goal avoiding occupied cells.\"\"\"\n      if start == goal:\n          return []\n      q = deque([start])\n      visited = {start}\n      prev = {}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          x, y = cur\n          for dx, dy in dirs:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height:\n                  if (nx, ny) not in visited and not grid[nx, ny].any():\n                      visited.add((nx, ny))\n                      prev[(nx, ny)] = (cur, (dx, dy))\n                      q.append((nx, ny))\n      if goal not in prev:\n          return []  # no path found\n      # reconstruct path\n      path = []\n      cur = goal\n      while cur != start:\n          prev_node, move = prev[cur]\n          path.append(move)\n          cur = prev_node\n      path.reverse()\n      return path\n\n  # ------------------------------------------------------------------\n  # Identify the recipe for a stick\n  # ------------------------------------------------------------------\n  stick_idx = env.world.cookbook.index[\"stick\"]\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  primitive_needs = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  # ------------------------------------------------------------------\n  # If stick is a primitive (no recipe), just pick it up\n  # ------------------------------------------------------------------\n  if not primitive_needs and not recipe:\n      stick_cells = find_cells(stick_idx)\n      if stick_cells:\n          tx, ty = stick_cells[0]\n          # Find a free neighbour to stand on\n          for dx, dy in dirs:\n              nx, ny = tx - dx, ty - dy\n              if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  actions.append(dir_action[(-dx, -dy)])  # face the stick\n                  state.dir = dir_action[(-dx, -dy)]\n                  actions.append(4)  # USE\n                  break\n  else:\n      # ------------------------------------------------------------------\n      # Collect required primitives\n      # ------------------------------------------------------------------\n      for prim_idx, needed in primitive_needs.items():\n          for _ in range(needed):\n              prim_cells = find_cells(prim_idx)\n              if not prim_cells:\n                  continue  # primitive not present; skip\n              tx, ty = prim_cells[0]\n\n              # Try to stand on a free neighbour opposite the direction we will face\n              neighbour_found = False\n              for dx, dy in dirs:\n                  nx, ny = tx - dx, ty - dy\n                  if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                      path = bfs(state.pos, (nx, ny))\n                      for mv in path:\n                          actions.append(dir_action[mv])\n                          state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                          state.dir = dir_action[mv]\n                      actions.append(dir_action[(-dx, -dy)])  # face primitive\n                      state.dir = dir_action[(-dx, -dy)]\n                      actions.append(4)  # USE\n                      neighbour_found = True\n                      break\n              if not neighbour_found:\n                  # fallback: any adjacent free cell, then turn towards primitive\n                  for dx, dy in dirs:\n                      nx, ny = tx + dx, ty + dy\n                      if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                          path = bfs(state.pos, (nx, ny))\n                          for mv in path:\n                              actions.append(dir_action[mv])\n                              state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                              state.dir = dir_action[mv]\n                          actions.append(dir_action[(-dx, -dy)])  # face primitive\n                          state.dir = dir_action[(-dx, -dy)]\n                          actions.append(4)  # USE\n                          neighbour_found = True\n                          break\n\n      # ------------------------------------------------------------------\n      # If a workshop is required, move adjacent and craft the stick\n      # ------------------------------------------------------------------\n      workshop_name = recipe.get(\"_at\")\n      if workshop_name:\n          workshop_idx = env.world.cookbook.index[workshop_name]\n          workshop_cells = find_cells(workshop_idx)\n          if workshop_cells:\n              wx, wy = workshop_cells[0]\n              for dx, dy in dirs:\n                  nx, ny = wx - dx, wy - dy\n                  if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                      path = bfs(state.pos, (nx, ny))\n                      for mv in path:\n                          actions.append(dir_action[mv])\n                          state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                          state.dir = dir_action[mv]\n                      actions.append(4)  # USE to craft the stick\n                      break\n\n  return actions", "env_interactions": 8, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-23T02:30:26.146461", "function_name": "make_arrow", "function_body": "  # Reset environment and get initial state\n  env.reset()\n  state = env._current_state\n  grid = state.grid\n  width, height = grid.shape[:2]\n\n  # Direction vectors and corresponding action indices (DOWN=0, UP=1, LEFT=2, RIGHT=3)\n  dirs = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n  dir_action = {(0, 1): 0, (0, -1): 1, (-1, 0): 2, (1, 0): 3}\n\n  actions = []\n\n  # Helper to locate all cells containing a given kind index\n  def find_cells(kind):\n      xs, ys = np.where(grid[:, :, kind] > 0)\n      return list(zip(xs.tolist(), ys.tolist()))\n\n  # BFS on free cells (cells with no entities)\n  from collections import deque\n\n  def bfs(start, goal):\n      \"\"\"Return list of (dx,dy) moves from start to goal avoiding occupied cells.\"\"\"\n      if start == goal:\n          return []\n      q = deque([start])\n      visited = {start}\n      prev = {}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          x, y = cur\n          for dx, dy in dirs:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height:\n                  if (nx, ny) not in visited and not grid[nx, ny].any():\n                      visited.add((nx, ny))\n                      prev[(nx, ny)] = (cur, (dx, dy))\n                      q.append((nx, ny))\n      if goal not in prev:\n          return []  # no path found\n      # reconstruct path\n      path = []\n      cur = goal\n      while cur != start:\n          prev_node, move = prev[cur]\n          path.append(move)\n          cur = prev_node\n      path.reverse()\n      return path\n\n  # ------------------------------------------------------------------\n  # Identify the recipe for a stick\n  # ------------------------------------------------------------------\n  stick_idx = env.world.cookbook.index[\"stick\"]\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  primitive_needs = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the needed number of times\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          prim_cells = find_cells(prim_idx)\n          if not prim_cells:\n              continue  # primitive not present in the world\n          tx, ty = prim_cells[0]\n\n          # Try to stand on a free neighbour from which we can USE the primitive\n          neighbour_found = False\n          for dx, dy in dirs:\n              nx, ny = tx - dx, ty - dy  # cell opposite the direction we will face\n              if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                  # Move to neighbour\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  # Face the primitive\n                  actions.append(dir_action[(-dx, -dy)])\n                  state.dir = dir_action[(-dx, -dy)]\n                  # Pick up\n                  actions.append(4)  # USE\n                  neighbour_found = True\n                  break\n\n          if not neighbour_found:\n              # Fallback: any adjacent free cell, then turn towards primitive\n              for dx, dy in dirs:\n                  nx, ny = tx + dx, ty + dy\n                  if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                      path = bfs(state.pos, (nx, ny))\n                      for mv in path:\n                          actions.append(dir_action[mv])\n                          state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                          state.dir = dir_action[mv]\n                      actions.append(dir_action[(-dx, -dy)])\n                      state.dir = dir_action[(-dx, -dy)]\n                      actions.append(4)  # USE\n                      neighbour_found = True\n                      break\n\n  # ------------------------------------------------------------------\n  # If stick itself is a primitive (no recipe), just pick it up\n  # ------------------------------------------------------------------\n  if not primitive_needs and not recipe:\n      stick_cells = find_cells(stick_idx)\n      if stick_cells:\n          tx, ty = stick_cells[0]\n          neighbour_found = False\n          for dx, dy in dirs:\n              nx, ny = tx - dx, ty - dy\n              if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  actions.append(dir_action[(-dx, -dy)])\n                  state.dir = dir_action[(-dx, -dy)]\n                  actions.append(4)  # USE\n                  neighbour_found = True\n                  break\n          if not neighbour_found:\n              for dx, dy in dirs:\n                  nx, ny = tx + dx, ty + dy\n                  if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                      path = bfs(state.pos, (nx, ny))\n                      for mv in path:\n                          actions.append(dir_action[mv])\n                          state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                          state.dir = dir_action[mv]\n                      actions.append(dir_action[(-dx, -dy)])\n                      state.dir = dir_action[(-dx, -dy)]\n                      actions.append(4)  # USE\n                      break\n\n  # ------------------------------------------------------------------\n  # If the recipe requires a workshop, move there and craft the stick\n  # ------------------------------------------------------------------\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      workshop_cells = find_cells(workshop_idx)\n      if workshop_cells:\n          wx, wy = workshop_cells[0]\n          for dx, dy in dirs:\n              nx, ny = wx - dx, wy - dy\n              if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  actions.append(4)  # USE to craft the stick\n                  break\n\n  return actions", "env_interactions": 8, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-23T02:30:47.213812", "function_name": "make_arrow", "function_body": "  # Helper to generate movement actions from current position to target (row, col)\n  def _move_actions(cur_pos, target):\n      actions = []\n      x, y = cur_pos\n      tx, ty = target\n      while x < tx:\n          actions.append(3)  # RIGHT\n          x += 1\n      while x > tx:\n          actions.append(2)  # LEFT\n          x -= 1\n      while y < ty:\n          actions.append(0)  # DOWN\n          y += 1\n      while y > ty:\n          actions.append(1)  # UP\n          y -= 1\n      return actions, (x, y)\n\n  state = env._current_state\n  cookbook = env.world.cookbook\n  stick_idx = cookbook.index['stick']\n\n  # 1) Already have a stick in inventory.\n  if state.inventory[stick_idx] > 0:\n      return []\n\n  # 2) Try to pick up a stick that is already placed on the grid.\n  stick_cells = np.argwhere(state.grid[:, :, stick_idx] > 0)\n  if stick_cells.size > 0:\n      target = tuple(stick_cells[0])\n      moves, _ = _move_actions(state.pos, target)\n      moves.append(4)                     # USE to pick it up\n      return moves\n\n  # 3) Need to craft a stick.\n  primitive_req = cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n  recipe = cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = cookbook.index[workshop_name] if workshop_name is not None else None\n\n  actions = []\n  cur_pos = state.pos\n  inventory = state.inventory.copy()\n\n  # 3a) Collect required primitive ingredients.\n  for prim_idx, needed in primitive_req.items():\n      while inventory[prim_idx] < needed:\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # Primitive not available on the map \u2013 abort planning.\n              return actions\n          target = tuple(prim_cells[0])\n          moves, cur_pos = _move_actions(cur_pos, target)\n          actions.extend(moves)\n          actions.append(4)                # USE to pick up the primitive\n          inventory[prim_idx] += 1\n\n  # 3b) Go to the appropriate workshop (if required) and craft the stick.\n  if workshop_idx is not None:\n      ws_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if ws_cells.size > 0:\n          target = tuple(ws_cells[0])\n          moves, cur_pos = _move_actions(cur_pos, target)\n          actions.extend(moves)\n          actions.append(4)                # USE to craft the stick\n      else:\n          # No workshop cell found; attempt to craft at current location.\n          actions.append(4)\n  else:\n      # No workshop needed; craft at current location.\n      actions.append(4)\n\n  return actions", "env_interactions": 4, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:30:48.555898", "function_name": "make_arrow", "function_body": "  def _move_actions(cur_pos, target):\n      actions = []\n      x, y = cur_pos\n      tx, ty = target\n      while x < tx:\n          actions.append(3)  # RIGHT\n          x += 1\n      while x > tx:\n          actions.append(2)  # LEFT\n          x -= 1\n      while y < ty:\n          actions.append(0)  # DOWN\n          y += 1\n      while y > ty:\n          actions.append(1)  # UP\n          y -= 1\n      return actions, (x, y)\n\n  state = env._current_state\n  cookbook = env.world.cookbook\n  stick_idx = cookbook.index['stick']\n\n  # 1) Already have a stick in inventory.\n  if state.inventory[stick_idx] > 0:\n      return []\n\n  # 2) Try to pick up a stick that is already placed on the grid.\n  stick_cells = np.argwhere(state.grid[:, :, stick_idx] > 0)\n  if stick_cells.size > 0:\n      target = tuple(stick_cells[0])\n      moves, _ = _move_actions(state.pos, target)\n      moves.append(4)                     # USE to pick it up\n      return moves\n\n  # 3) Need to craft a stick.\n  primitive_req = cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n  recipe = cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = cookbook.index[workshop_name] if workshop_name is not None else None\n\n  actions = []\n  cur_pos = state.pos\n  inventory = state.inventory.copy()\n\n  # 3a) Collect required primitive ingredients.\n  for prim_idx, needed in primitive_req.items():\n      while inventory[prim_idx] < needed:\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # No more of this primitive on the map \u2013 abort planning.\n              return actions\n          target = tuple(prim_cells[0])\n          moves, cur_pos = _move_actions(cur_pos, target)\n          actions.extend(moves)\n          actions.append(4)                # USE to pick up the primitive\n          inventory[prim_idx] += 1\n\n  # 3b) Go to the appropriate workshop (if required) and craft the stick.\n  if workshop_idx is not None:\n      ws_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if ws_cells.size > 0:\n          target = tuple(ws_cells[0])\n          moves, cur_pos = _move_actions(cur_pos, target)\n          actions.extend(moves)\n          actions.append(4)                # USE to craft the stick\n      else:\n          # No workshop cell found; attempt to craft at current location.\n          actions.append(4)\n  else:\n      # No workshop needed; craft at current location.\n      actions.append(4)\n\n  return actions", "env_interactions": 4, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:31:08.968656", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # Action indices as defined in CraftLab.action_specs\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions from start to goal using\n      horizontal\u2011then\u2011vertical moves (ignores obstacles).\"\"\"\n      x, y = start\n      gx, gy = goal\n      actions = []\n      while x < gx:\n          actions.append(ACTION_RIGHT)\n          x += 1\n      while x > gx:\n          actions.append(ACTION_LEFT)\n          x -= 1\n      while y < gy:\n          actions.append(ACTION_DOWN)\n          y += 1\n      while y > gy:\n          actions.append(ACTION_UP)\n          y -= 1\n      return actions\n\n  def nearest_position(positions, reference):\n      \"\"\"Pick the position from *positions* with smallest Manhattan distance\n      to *reference*.\"\"\"\n      if len(positions) == 0:\n          return None\n      ref = np.array(reference)\n      dists = np.sum(np.abs(positions - ref), axis=1)\n      return tuple(positions[np.argmin(dists)])\n\n  # ------------------------------------------------------------------\n  # Gather current state information\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n\n  # ------------------------------------------------------------------\n  # Identify the goal (stick)\n  # ------------------------------------------------------------------\n  goal_name = \"stick\"\n  try:\n      goal_idx = env.world.cookbook.index[goal_name]\n  except Exception:\n      # Goal not present in the world \u2013 nothing to do\n      return []\n\n  # If we already have a stick, no actions are needed\n  if inventory[goal_idx] > 0:\n      return []\n\n  plan_actions = []\n\n  # ------------------------------------------------------------------\n  # 1) Collect needed primitive resources (if any)\n  # ------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  for prim_idx, needed_cnt in primitives_needed.items():\n      while inventory[prim_idx] < needed_cnt:\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # No more of this primitive on the map \u2013 abort planning\n              return plan_actions\n          target = nearest_position(prim_cells, pos)\n\n          # Move to the primitive\n          plan_actions.extend(manhattan_path(pos, target))\n          pos = target\n\n          # Pick it up\n          plan_actions.append(ACTION_USE)\n\n          # Simulate the pickup locally for further planning\n          inventory[prim_idx] += 1\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # ------------------------------------------------------------------\n  # 2) If stick itself is a primitive (no recipe), just pick it up\n  # ------------------------------------------------------------------\n  if goal_idx not in env.world.cookbook.recipes:\n      stick_cells = np.argwhere(grid[:, :, goal_idx] > 0)\n      if stick_cells.size == 0:\n          return plan_actions\n      target = nearest_position(stick_cells, pos)\n      plan_actions.extend(manhattan_path(pos, target))\n      pos = target\n      plan_actions.append(ACTION_USE)\n      return plan_actions\n\n  # ------------------------------------------------------------------\n  # 3) Go to the required workshop and craft the stick\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      try:\n          workshop_idx = env.world.cookbook.index[workshop_name]\n      except Exception:\n          return plan_actions\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          return plan_actions\n      wcell = tuple(workshop_cells[0])\n\n      # Find a free adjacent cell to stand on\n      neighbours = [\n          (wcell[0] + dx, wcell[1] + dy)\n          for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]\n      ]\n      stand_pos = None\n      for nx, ny in neighbours:\n          if (\n              0 <= nx < grid.shape[0]\n              and 0 <= ny < grid.shape[1]\n              and grid[nx, ny, :].sum() == 0\n          ):\n              stand_pos = (nx, ny)\n              break\n      if stand_pos is None:\n          stand_pos = wcell  # fallback: stand directly on the workshop\n\n      # Move to the chosen standing position\n      plan_actions.extend(manhattan_path(pos, stand_pos))\n      pos = stand_pos\n\n      # Use the workshop to craft the stick\n      plan_actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # Return the constructed action list\n  # ------------------------------------------------------------------\n  return plan_actions", "env_interactions": 5, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:31:10.323462", "function_name": "make_arrow", "function_body": "  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions from start to goal using\n      horizontal\u2011then\u2011vertical moves (ignores obstacles).\"\"\"\n      x, y = start\n      gx, gy = goal\n      actions = []\n      while x < gx:\n          actions.append(ACTION_RIGHT)\n          x += 1\n      while x > gx:\n          actions.append(ACTION_LEFT)\n          x -= 1\n      while y < gy:\n          actions.append(ACTION_DOWN)\n          y += 1\n      while y > gy:\n          actions.append(ACTION_UP)\n          y -= 1\n      return actions\n\n  def nearest_position(positions, reference):\n      \"\"\"Pick the position from *positions* with smallest Manhattan distance\n      to *reference*.\"\"\"\n      if len(positions) == 0:\n          return None\n      ref = np.array(reference)\n      dists = np.sum(np.abs(positions - ref), axis=1)\n      return tuple(positions[np.argmin(dists)])\n\n  # ------------------------------------------------------------------\n  # Gather current state information\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n\n  # ------------------------------------------------------------------\n  # Identify the goal (stick)\n  # ------------------------------------------------------------------\n  goal_name = \"stick\"\n  try:\n      goal_idx = env.world.cookbook.index[goal_name]\n  except Exception:\n      # Stick not defined in this world\n      return []\n\n  # If we already have a stick, nothing to do\n  if inventory[goal_idx] > 0:\n      return []\n\n  plan_actions = []\n\n  # ------------------------------------------------------------------\n  # 1) Collect required primitive resources\n  # ------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  for prim_idx, needed_cnt in primitives_needed.items():\n      while inventory[prim_idx] < needed_cnt:\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # No more of this primitive on the map \u2013 abort planning\n              return plan_actions\n          target = nearest_position(prim_cells, pos)\n\n          # Move to the primitive\n          plan_actions.extend(manhattan_path(pos, target))\n          pos = target\n\n          # Pick it up\n          plan_actions.append(ACTION_USE)\n\n          # Simulate pickup locally\n          inventory[prim_idx] += 1\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # ------------------------------------------------------------------\n  # 2) If stick is a primitive (no recipe), just pick it up\n  # ------------------------------------------------------------------\n  if goal_idx not in env.world.cookbook.recipes:\n      stick_cells = np.argwhere(grid[:, :, goal_idx] > 0)\n      if stick_cells.size == 0:\n          return plan_actions\n      target = nearest_position(stick_cells, pos)\n      plan_actions.extend(manhattan_path(pos, target))\n      pos = target\n      plan_actions.append(ACTION_USE)\n      return plan_actions\n\n  # ------------------------------------------------------------------\n  # 3) Go to the required workshop and craft the stick\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      try:\n          workshop_idx = env.world.cookbook.index[workshop_name]\n      except Exception:\n          return plan_actions\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          return plan_actions\n      wcell = tuple(workshop_cells[0])\n\n      # Find a free adjacent cell to stand on\n      neighbours = [\n          (wcell[0] + dx, wcell[1] + dy)\n          for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]\n      ]\n      stand_pos = None\n      for nx, ny in neighbours:\n          if (\n              0 <= nx < grid.shape[0]\n              and 0 <= ny < grid.shape[1]\n              and grid[nx, ny, :].sum() == 0\n          ):\n              stand_pos = (nx, ny)\n              break\n      if stand_pos is None:\n          stand_pos = wcell  # fallback: stand directly on the workshop\n\n      # Move to the chosen standing position\n      plan_actions.extend(manhattan_path(pos, stand_pos))\n      pos = stand_pos\n\n      # Use the workshop to craft the stick\n      plan_actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # Return the constructed action list\n  # ------------------------------------------------------------------\n  return plan_actions", "env_interactions": 5, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:31:27.686722", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # map action index to movement delta (row, col)\n  _ACTION_DELTAS = {\n      0: (1, 0),   # DOWN\n      1: (-1, 0),  # UP\n      2: (0, -1),  # LEFT\n      3: (0, 1),   # RIGHT\n  }\n\n  def _move_actions(start, goal):\n      \"\"\"Return a list of actions (indices) to move Manhattan\u2011style from start to goal.\"\"\"\n      y, x = start\n      gy, gx = goal\n      actions = []\n      while y < gy:\n          actions.append(0)  # DOWN\n          y += 1\n      while y > gy:\n          actions.append(1)  # UP\n          y -= 1\n      while x < gx:\n          actions.append(3)  # RIGHT\n          x += 1\n      while x > gx:\n          actions.append(2)  # LEFT\n          x -= 1\n      return actions\n\n  # ----------------------------------------------------------------------\n  # locate the world object (CraftWorld) from the supplied env\n  # ----------------------------------------------------------------------\n  if hasattr(env, \"world\"):\n      world = env.world\n  elif hasattr(env, \"scenario\"):\n      world = env.scenario.world\n  else:\n      raise AttributeError(\"Cannot locate CraftWorld instance in the supplied env.\")\n\n  # ----------------------------------------------------------------------\n  # identify the goal (stick) and its recipe\n  # ----------------------------------------------------------------------\n  goal_name = \"stick\"\n  goal_idx = world.cookbook.index.index(goal_name)\n  needed = world.cookbook.primitives_for(goal_idx)   # {primitive_idx: count}\n\n  # ----------------------------------------------------------------------\n  # obtain current state (position + grid) for planning\n  # ----------------------------------------------------------------------\n  if hasattr(env, \"_current_state\"):\n      state = env._current_state\n  else:\n      state = env.scenario.init()\n  cur_pos = tuple(state.pos)          # (row, col)\n  grid = state.grid.copy()            # (H, W, n_kinds)\n\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # collect each required primitive\n  # ----------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(f\"Primitive {world.cookbook.index.get(prim_idx)} not found on the grid.\")\n          py, px = prim_cells[0]\n\n          # find an empty neighbour from which we can face the primitive\n          chosen_dir = None\n          target_cell = None\n          for d, (dy, dx) in _ACTION_DELTAS.items():\n              ny, nx = py - dy, px - dx\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  if not grid[ny, nx, :].any():\n                      chosen_dir = d\n                      target_cell = (ny, nx)\n                      break\n          if target_cell is None:\n              raise RuntimeError(\"No reachable empty neighbour around required primitive.\")\n\n          # move to that neighbour\n          actions.extend(_move_actions(cur_pos, target_cell))\n          cur_pos = target_cell\n\n          # use the primitive (agent now faces it)\n          actions.append(4)   # USE\n\n          # update planning grid \u2013 primitive is taken\n          grid[py, px, prim_idx] = 0\n\n  # ----------------------------------------------------------------------\n  # if the recipe specifies a workshop, go there and craft the stick\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_cells.size == 0:\n          raise RuntimeError(f\"Workshop {workshop_name} not found on the grid.\")\n      wy, wx = ws_cells[0]\n\n      chosen_dir = None\n      target_cell = None\n      for d, (dy, dx) in _ACTION_DELTAS.items():\n          ny, nx = wy - dy, wx - dx\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not grid[ny, nx, :].any():\n                  chosen_dir = d\n                  target_cell = (ny, nx)\n                  break\n      if target_cell is None:\n          raise RuntimeError(\"No reachable empty neighbour around workshop.\")\n\n      actions.extend(_move_actions(cur_pos, target_cell))\n      cur_pos = target_cell\n      actions.append(4)   # USE to craft the stick\n\n  return actions", "env_interactions": 5, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:31:29.041668", "function_name": "make_arrow", "function_body": "  # helper mapping action indices to movement deltas\n  _ACTION_DELTAS = {\n      0: (1, 0),   # DOWN\n      1: (-1, 0),  # UP\n      2: (0, -1),  # LEFT\n      3: (0, 1),   # RIGHT\n  }\n\n  def _move_actions(start, goal):\n      \"\"\"Return a list of actions to move from start to goal using Manhattan moves.\"\"\"\n      y, x = start\n      gy, gx = goal\n      actions = []\n      while y < gy:\n          actions.append(0)  # DOWN\n          y += 1\n      while y > gy:\n          actions.append(1)  # UP\n          y -= 1\n      while x < gx:\n          actions.append(3)  # RIGHT\n          x += 1\n      while x > gx:\n          actions.append(2)  # LEFT\n          x -= 1\n      return actions\n\n  # ----------------------------------------------------------------------\n  # locate the CraftWorld instance inside the supplied env\n  # ----------------------------------------------------------------------\n  if hasattr(env, \"world\"):\n      world = env.world\n  elif hasattr(env, \"scenario\"):\n      world = env.scenario.world\n  else:\n      raise AttributeError(\"Cannot locate CraftWorld instance in the supplied env.\")\n\n  # ----------------------------------------------------------------------\n  # identify the goal (stick) and its recipe\n  # ----------------------------------------------------------------------\n  goal_name = \"stick\"\n  goal_idx = world.cookbook.index.index(goal_name)\n\n  # primitives required to craft a stick (may be empty if stick is primitive)\n  needed = world.cookbook.primitives_for(goal_idx)\n\n  # ----------------------------------------------------------------------\n  # obtain current state (position and grid) for planning\n  # ----------------------------------------------------------------------\n  if hasattr(env, \"_current_state\"):\n      state = env._current_state\n  else:\n      state = env.scenario.init()\n\n  cur_pos = tuple(state.pos)          # (row, col)\n  grid = state.grid.copy()            # copy to allow planning updates\n\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # collect each required primitive the needed number of times\n  # ----------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(\n                  f\"Primitive {world.cookbook.index.get(prim_idx)} not found on the grid.\"\n              )\n          py, px = prim_cells[0]\n\n          # find an empty neighbour cell from which we can face the primitive\n          chosen_dir = None\n          target_cell = None\n          for d, (dy, dx) in _ACTION_DELTAS.items():\n              ny, nx = py - dy, px - dx\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  if not grid[ny, nx, :].any():\n                      chosen_dir = d\n                      target_cell = (ny, nx)\n                      break\n          if target_cell is None:\n              raise RuntimeError(\"No reachable empty neighbour around required primitive.\")\n\n          # move to that neighbour\n          actions.extend(_move_actions(cur_pos, target_cell))\n          cur_pos = target_cell\n\n          # use the primitive (the agent is already facing it)\n          actions.append(4)   # USE\n\n          # update planning grid: primitive consumed\n          grid[py, px, prim_idx] = 0\n\n  # ----------------------------------------------------------------------\n  # move to the workshop (if any) and craft the stick\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_cells.size == 0:\n          raise RuntimeError(f\"Workshop {workshop_name} not found on the grid.\")\n      wy, wx = ws_cells[0]\n\n      # find empty neighbour to face the workshop\n      chosen_dir = None\n      target_cell = None\n      for d, (dy, dx) in _ACTION_DELTAS.items():\n          ny, nx = wy - dy, wx - dx\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not grid[ny, nx, :].any():\n                  chosen_dir = d\n                  target_cell = (ny, nx)\n                  break\n      if target_cell is None:\n          raise RuntimeError(\"No reachable empty neighbour around workshop.\")\n\n      actions.extend(_move_actions(cur_pos, target_cell))\n      cur_pos = target_cell\n\n      # craft by using the workshop\n      actions.append(4)   # USE\n\n  # ----------------------------------------------------------------------\n  # return the full action sequence\n  # ----------------------------------------------------------------------\n  return actions", "env_interactions": 5, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:31:46.975029", "function_name": "make_arrow", "function_body": "  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions from start to goal using\n      horizontal then vertical moves (ignores obstacles).\"\"\"\n      sx, sy = start\n      gx, gy = goal\n      actions = []\n      while sx < gx:\n          actions.append(ACTION_RIGHT)\n          sx += 1\n      while sx > gx:\n          actions.append(ACTION_LEFT)\n          sx -= 1\n      while sy < gy:\n          actions.append(ACTION_DOWN)\n          sy += 1\n      while sy > gy:\n          actions.append(ACTION_UP)\n          sy -= 1\n      return actions\n\n  def nearest_position(positions, reference):\n      \"\"\"Pick the position from *positions* with smallest Manhattan distance\n      to *reference*.\"\"\"\n      if len(positions) == 0:\n          return None\n      ref = np.array(reference)\n      dists = np.sum(np.abs(positions - ref), axis=1)\n      return tuple(positions[np.argmin(dists)])\n\n  # ------------------------------------------------------------------\n  # Gather current state information\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n\n  # ------------------------------------------------------------------\n  # Identify goal (stick)\n  # ------------------------------------------------------------------\n  goal_name = \"stick\"\n  goal_idx = env.world.cookbook.index[goal_name]\n\n  plan_actions = []\n\n  # ------------------------------------------------------------------\n  # Determine required primitives for the stick\n  # ------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n\n  # If stick is a primitive (no recipe), just collect it directly.\n  if not primitives_needed:\n      stick_cells = np.argwhere(grid[:, :, goal_idx] > 0)\n      if stick_cells.size == 0:\n          return plan_actions  # nothing to collect\n      target = nearest_position(stick_cells, pos)\n      plan_actions.extend(manhattan_path(pos, target))\n      plan_actions.append(ACTION_USE)\n      return plan_actions\n\n  # ------------------------------------------------------------------\n  # 1) Collect needed primitives\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      while inventory[prim_idx] < needed_cnt:\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              return plan_actions  # cannot satisfy requirement\n          target = nearest_position(prim_cells, pos)\n\n          # move to the primitive\n          plan_actions.extend(manhattan_path(pos, target))\n          pos = target\n\n          # pick it up\n          plan_actions.append(ACTION_USE)\n\n          # simulate pick\u2011up locally for further planning\n          inventory[prim_idx] += 1\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # ------------------------------------------------------------------\n  # 2) Go to workshop (if recipe requires one) and craft the stick\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          return plan_actions  # no workshop visible\n      wcell = tuple(workshop_cells[0])\n\n      # find a free adjacent cell to stand on\n      neighbours = [(wcell[0] + dx, wcell[1] + dy) for dx, dy in\n                    [(1, 0), (-1, 0), (0, 1), (0, -1)]]\n      stand_pos = None\n      for nx, ny in neighbours:\n          if (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and\n                  grid[nx, ny, :].sum() == 0):\n              stand_pos = (nx, ny)\n              break\n      if stand_pos is None:\n          stand_pos = wcell  # fallback: stand on the workshop itself\n\n      # move to the chosen standing position\n      plan_actions.extend(manhattan_path(pos, stand_pos))\n      pos = stand_pos\n\n      # use the workshop to craft the stick\n      plan_actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # Return the full action list\n  # ------------------------------------------------------------------\n  return plan_actions", "env_interactions": 5, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:31:48.423412", "function_name": "make_arrow", "function_body": "  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions from start to goal using\n      horizontal then vertical moves (ignores obstacles).\"\"\"\n      sx, sy = start\n      gx, gy = goal\n      actions = []\n      while sx < gx:\n          actions.append(ACTION_RIGHT)\n          sx += 1\n      while sx > gx:\n          actions.append(ACTION_LEFT)\n          sx -= 1\n      while sy < gy:\n          actions.append(ACTION_DOWN)\n          sy += 1\n      while sy > gy:\n          actions.append(ACTION_UP)\n          sy -= 1\n      return actions\n\n  def nearest_position(positions, reference):\n      \"\"\"Pick the position from *positions* with smallest Manhattan distance\n      to *reference*.\"\"\"\n      if len(positions) == 0:\n          return None\n      ref = np.array(reference)\n      dists = np.sum(np.abs(positions - ref), axis=1)\n      return tuple(positions[np.argmin(dists)])\n\n  # ------------------------------------------------------------------\n  # Gather current state information\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n\n  # ------------------------------------------------------------------\n  # Identify goal (stick)\n  # ------------------------------------------------------------------\n  goal_name = \"stick\"\n  goal_idx = env.world.cookbook.index[goal_name]\n\n  plan_actions = []\n\n  # ------------------------------------------------------------------\n  # Determine required primitives for the stick\n  # ------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n\n  # If stick is a primitive (no recipe), just collect it directly.\n  if not primitives_needed:\n      stick_cells = np.argwhere(grid[:, :, goal_idx] > 0)\n      if stick_cells.size == 0:\n          return plan_actions  # nothing to collect\n      target = nearest_position(stick_cells, pos)\n      plan_actions.extend(manhattan_path(pos, target))\n      plan_actions.append(ACTION_USE)\n      return plan_actions\n\n  # ------------------------------------------------------------------\n  # 1) Collect needed primitives\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      while inventory[prim_idx] < needed_cnt:\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              return plan_actions  # cannot satisfy requirement\n          target = nearest_position(prim_cells, pos)\n\n          # move to the primitive\n          plan_actions.extend(manhattan_path(pos, target))\n          pos = target\n\n          # pick it up\n          plan_actions.append(ACTION_USE)\n\n          # simulate pick\u2011up locally for further planning\n          inventory[prim_idx] += 1\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # ------------------------------------------------------------------\n  # 2) Go to workshop (if recipe requires one) and craft the stick\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          return plan_actions  # no workshop visible\n      wcell = tuple(workshop_cells[0])\n\n      # find a free adjacent cell to stand on\n      neighbours = [(wcell[0] + dx, wcell[1] + dy) for dx, dy in\n                    [(1, 0), (-1, 0), (0, 1), (0, -1)]]\n      stand_pos = None\n      for nx, ny in neighbours:\n          if (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and\n                  grid[nx, ny, :].sum() == 0):\n              stand_pos = (nx, ny)\n              break\n      if stand_pos is None:\n          stand_pos = wcell  # fallback: stand on the workshop itself\n\n      # move to the chosen standing position\n      plan_actions.extend(manhattan_path(pos, stand_pos))\n      pos = stand_pos\n\n      # use the workshop to craft the stick\n      plan_actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # Return the full action list\n  # ------------------------------------------------------------------\n  return plan_actions", "env_interactions": 5, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:32:09.319914", "function_name": "make_arrow", "function_body": "  _ACTION_DELTAS = {\n      0: (1, 0),   # DOWN\n      1: (-1, 0),  # UP\n      2: (0, -1),  # LEFT\n      3: (0, 1),   # RIGHT\n  }\n\n  def _move_actions(start, goal):\n      \"\"\"Manhattan path from start (row, col) to goal (row, col).\"\"\"\n      y, x = start\n      gy, gx = goal\n      acts = []\n      while y < gy:\n          acts.append(0)   # DOWN\n          y += 1\n      while y > gy:\n          acts.append(1)   # UP\n          y -= 1\n      while x < gx:\n          acts.append(3)   # RIGHT\n          x += 1\n      while x > gx:\n          acts.append(2)   # LEFT\n          x -= 1\n      return acts\n\n  # ----------------------------------------------------------------------\n  # locate the CraftWorld instance\n  # ----------------------------------------------------------------------\n  if hasattr(env, \"world\"):\n      world = env.world\n  elif hasattr(env, \"scenario\"):\n      world = env.scenario.world\n  else:\n      raise AttributeError(\"Cannot locate CraftWorld instance in the supplied env.\")\n\n  # ----------------------------------------------------------------------\n  # goal information (stick)\n  # ----------------------------------------------------------------------\n  goal_name = \"stick\"\n  goal_idx = world.cookbook.index.index(goal_name)\n\n  # primitives required to craft the stick (if any)\n  needed = world.cookbook.primitives_for(goal_idx)   # dict {prim_idx: count}\n\n  # ----------------------------------------------------------------------\n  # obtain current state for planning\n  # ----------------------------------------------------------------------\n  if hasattr(env, \"_current_state\"):\n      state = env._current_state\n  else:\n      state = env.scenario.init()\n\n  cur_pos = tuple(state.pos)          # (row, col)\n  grid = state.grid.copy()            # (H, W, n_kinds)\n\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # helper to move to a primitive cell and pick it up\n  # ----------------------------------------------------------------------\n  def _collect_primitive(p_idx):\n      nonlocal cur_pos, actions, grid\n      cells = np.argwhere(grid[:, :, p_idx] > 0)\n      if cells.size == 0:\n          raise RuntimeError(f\"Primitive {world.cookbook.index.get(p_idx)} not found on the grid.\")\n      py, px = cells[0]\n\n      # find an adjacent empty cell to stand on\n      target = None\n      for dy, dx in _ACTION_DELTAS.values():\n          ny, nx = py - dy, px - dx\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not grid[ny, nx, :].any():          # empty\n                  target = (ny, nx)\n                  break\n      if target is None:\n          raise RuntimeError(\"No reachable empty neighbour around required primitive.\")\n\n      # move to that neighbour\n      actions.extend(_move_actions(cur_pos, target))\n      cur_pos = target\n\n      # USE to pick up the primitive (agent will be facing the primitive)\n      actions.append(4)   # USE\n\n      # update planning grid: remove the primitive\n      grid[py, px, p_idx] = 0\n\n  # ----------------------------------------------------------------------\n  # 1. Collect required primitives (if any)\n  # ----------------------------------------------------------------------\n  if needed:\n      for prim_idx, cnt in needed.items():\n          for _ in range(cnt):\n              _collect_primitive(prim_idx)\n\n  # ----------------------------------------------------------------------\n  # 2. If the stick itself is a primitive (no recipe), just collect it\n  # ----------------------------------------------------------------------\n  elif goal_idx in world.cookbook.primitives:\n      _collect_primitive(goal_idx)\n      return actions\n\n  # ----------------------------------------------------------------------\n  # 3. Craft the stick at its workshop (if a workshop is specified)\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_cells.size == 0:\n          raise RuntimeError(f\"Workshop {workshop_name} not found on the grid.\")\n      wy, wx = ws_cells[0]\n\n      # find empty neighbour to stand on\n      target = None\n      for dy, dx in _ACTION_DELTAS.values():\n          ny, nx = wy - dy, wx - dx\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not grid[ny, nx, :].any():\n                  target = (ny, nx)\n                  break\n      if target is None:\n          raise RuntimeError(\"No reachable empty neighbour around workshop.\")\n\n      actions.extend(_move_actions(cur_pos, target))\n      cur_pos = target\n      actions.append(4)   # USE to craft the stick\n\n  # ----------------------------------------------------------------------\n  # return the full action list\n  # ----------------------------------------------------------------------\n  return actions", "env_interactions": 5, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:32:10.663193", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Define movement deltas for actions (DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4)\n  # ----------------------------------------------------------------------\n  _ACTION_DELTAS = {\n      0: (1, 0),   # DOWN\n      1: (-1, 0),  # UP\n      2: (0, -1),  # LEFT\n      3: (0, 1),   # RIGHT\n  }\n\n  def _move_actions(start, goal):\n      \"\"\"Return a list of actions to walk Manhattan\u2011style from start to goal.\"\"\"\n      y, x = start\n      gy, gx = goal\n      acts = []\n      while y < gy:\n          acts.append(0)   # DOWN\n          y += 1\n      while y > gy:\n          acts.append(1)   # UP\n          y -= 1\n      while x < gx:\n          acts.append(3)   # RIGHT\n          x += 1\n      while x > gx:\n          acts.append(2)   # LEFT\n          x -= 1\n      return acts\n\n  # ----------------------------------------------------------------------\n  # Locate the underlying CraftWorld instance inside the supplied env.\n  # ----------------------------------------------------------------------\n  if hasattr(env, \"world\"):\n      world = env.world\n  elif hasattr(env, \"scenario\"):\n      world = env.scenario.world\n  else:\n      raise AttributeError(\"Cannot locate CraftWorld instance in the supplied env.\")\n\n  # ----------------------------------------------------------------------\n  # Goal information \u2013 we want to make a `stick`.\n  # ----------------------------------------------------------------------\n  goal_name = \"stick\"\n  goal_idx = world.cookbook.index.index(goal_name)\n\n  # Primitives required for the stick (empty dict if stick is a primitive itself)\n  needed = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ----------------------------------------------------------------------\n  # Get the current state for planning (grid, position, etc.).\n  # ----------------------------------------------------------------------\n  if hasattr(env, \"_current_state\"):\n      state = env._current_state\n  else:\n      state = env.scenario.init()\n\n  cur_pos = tuple(state.pos)          # (row, col)\n  grid = state.grid.copy()            # (H, W, n_kinds)\n\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # Helper: move to a primitive cell, stand adjacent, and USE to pick it up.\n  # ----------------------------------------------------------------------\n  def _collect_primitive(p_idx):\n      nonlocal cur_pos, actions, grid\n      cells = np.argwhere(grid[:, :, p_idx] > 0)\n      if cells.size == 0:\n          raise RuntimeError(f\"Primitive {world.cookbook.index.get(p_idx)} not found on the grid.\")\n      py, px = cells[0]\n\n      # Find an empty neighbour to stand on.\n      target = None\n      for dy, dx in _ACTION_DELTAS.values():\n          ny, nx = py - dy, px - dx\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not grid[ny, nx, :].any():\n                  target = (ny, nx)\n                  break\n      if target is None:\n          raise RuntimeError(\"No reachable empty neighbour around required primitive.\")\n\n      # Walk to the neighbour.\n      actions.extend(_move_actions(cur_pos, target))\n      cur_pos = target\n\n      # USE to pick up the primitive (agent faces the primitive).\n      actions.append(4)   # USE\n\n      # Update planning grid \u2013 primitive is now gone.\n      grid[py, px, p_idx] = 0\n\n  # ----------------------------------------------------------------------\n  # 1. Collect all required primitives (if any).\n  # ----------------------------------------------------------------------\n  if needed:\n      for prim_idx, cnt in needed.items():\n          for _ in range(cnt):\n              _collect_primitive(prim_idx)\n\n  # ----------------------------------------------------------------------\n  # 2. If stick itself is a primitive (no recipe), just collect it and finish.\n  # ----------------------------------------------------------------------\n  elif goal_idx in world.cookbook.primitives:\n      _collect_primitive(goal_idx)\n      return actions\n\n  # ----------------------------------------------------------------------\n  # 3. Craft the stick at its designated workshop (if a workshop is specified).\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_cells.size == 0:\n          raise RuntimeError(f\"Workshop {workshop_name} not found on the grid.\")\n      wy, wx = ws_cells[0]\n\n      # Find an empty neighbour to stand on.\n      target = None\n      for dy, dx in _ACTION_DELTAS.values():\n          ny, nx = wy - dy, wx - dx\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not grid[ny, nx, :].any():\n                  target = (ny, nx)\n                  break\n      if target is None:\n          raise RuntimeError(\"No reachable empty neighbour around workshop.\")\n\n      # Walk to the neighbour and USE to craft.\n      actions.extend(_move_actions(cur_pos, target))\n      cur_pos = target\n      actions.append(4)   # USE to craft the stick\n\n  # ----------------------------------------------------------------------\n  # Return the complete action sequence.\n  # ----------------------------------------------------------------------\n  return actions", "env_interactions": 5, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:32:42.961248", "function_name": "make_arrow", "function_body": "", "env_interactions": 0, "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-10-23T02:32:44.401611", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  grid = state.grid\n  width, height = grid.shape[:2]\n\n  # direction vectors and corresponding action indices (DOWN=0, UP=1, LEFT=2, RIGHT=3)\n  dirs = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n  dir_action = {(0, 1): 0, (0, -1): 1, (-1, 0): 2, (1, 0): 3}\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def find_cells(kind):\n      \"\"\"Return list of (x, y) positions where the grid contains the given kind.\"\"\"\n      xs, ys = np.where(grid[:, :, kind] > 0)\n      return list(zip(xs.tolist(), ys.tolist()))\n\n  from collections import deque\n\n  def bfs(start, goal):\n      \"\"\"Return a list of (dx, dy) moves from start to goal avoiding occupied cells.\"\"\"\n      q = deque([start])\n      visited = {start}\n      prev = {}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          x, y = cur\n          for dx, dy in dirs:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height:\n                  if (nx, ny) not in visited and not grid[nx, ny].any():\n                      visited.add((nx, ny))\n                      prev[(nx, ny)] = (cur, (dx, dy))\n                      q.append((nx, ny))\n      if start == goal:\n          return []\n      if goal not in prev:\n          return []  # no path found\n      # reconstruct path\n      path = []\n      cur = goal\n      while cur != start:\n          prev_node, move = prev[cur]\n          path.append(move)\n          cur = prev_node\n      path.reverse()\n      return path\n\n  # ------------------------------------------------------------------\n  # Identify the recipe for a stick\n  # ------------------------------------------------------------------\n  stick_idx = env.world.cookbook.index[\"stick\"]\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  primitive_needs = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the needed number of times\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          prim_cells = find_cells(prim_idx)\n          if not prim_cells:\n              continue  # primitive not present; skip\n          tx, ty = prim_cells[0]\n\n          # Try to stand on a free neighbour from which we can USE the primitive\n          neighbour_found = False\n          for dx, dy in dirs:\n              nx, ny = tx - dx, ty - dy  # cell opposite the direction we will face\n              if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                  # Move to (nx, ny)\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  # Face the primitive\n                  actions.append(dir_action[(-dx, -dy)])\n                  state.dir = dir_action[(-dx, -dy)]\n                  # Pick up\n                  actions.append(4)  # USE action\n                  neighbour_found = True\n                  break\n\n          if not neighbour_found:\n              # Fallback: any adjacent free cell, then turn towards primitive\n              for dx, dy in dirs:\n                  nx, ny = tx + dx, ty + dy\n                  if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                      path = bfs(state.pos, (nx, ny))\n                      for mv in path:\n                          actions.append(dir_action[mv])\n                          state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                          state.dir = dir_action[mv]\n                      actions.append(dir_action[(-dx, -dy)])\n                      state.dir = dir_action[(-dx, -dy)]\n                      actions.append(4)  # USE\n                      neighbour_found = True\n                      break\n\n  # ------------------------------------------------------------------\n  # If the recipe requires a workshop, move there and craft the stick\n  # ------------------------------------------------------------------\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      workshop_cells = find_cells(workshop_idx)\n      if workshop_cells:\n          wx, wy = workshop_cells[0]\n          # Find a free neighbour to stand on\n          for dx, dy in dirs:\n              nx, ny = wx - dx, wy - dy\n              if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  # Use to craft\n                  actions.append(4)  # USE\n                  break\n\n  return actions", "env_interactions": 8, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-23T02:33:05.568383", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  goal_idx = env.task.goal\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # --------------------------------------------------------------\n  # Helper utilities\n  # --------------------------------------------------------------\n  def find_positions(kind):\n      \"\"\"Return list of (x, y) cells containing the given kind.\"\"\"\n      locs = np.argwhere(state.grid[:, :, kind] > 0)\n      return [tuple(p) for p in locs]\n\n  def nearest(pos, kind):\n      \"\"\"Manhattan\u2011closest cell of the requested kind.\"\"\"\n      positions = find_positions(kind)\n      if not positions:\n          return None\n      return min(positions, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n\n  def moves_to(src, dst):\n      \"\"\"Sequence of movement actions (DOWN=0, UP=1, LEFT=2, RIGHT=3)\n      that walks from src to dst using a simple Manhattan path.\"\"\"\n      sx, sy = src\n      dx, dy = dst\n      seq = []\n      while sx < dx:\n          seq.append(0)   # DOWN\n          sx += 1\n      while sx > dx:\n          seq.append(1)   # UP\n          sx -= 1\n      while sy < dy:\n          seq.append(3)   # RIGHT\n          sy += 1\n      while sy > dy:\n          seq.append(2)   # LEFT\n          sy -= 1\n      return seq\n\n  # --------------------------------------------------------------\n  # 1) If goal is a primitive (no recipe), just collect it.\n  # --------------------------------------------------------------\n  if not env.world.cookbook.primitives_for(goal_idx):\n      target = nearest(cur_pos, goal_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)   # USE\n      return actions\n\n  # --------------------------------------------------------------\n  # 2) Gather required primitive ingredients.\n  # --------------------------------------------------------------\n  needed_prims = env.world.cookbook.primitives_for(goal_idx)\n  for prim_idx, count in needed_prims.items():\n      for _ in range(count):\n          target = nearest(cur_pos, prim_idx)\n          if target is None:\n              # Primitive not present; skip (will fail later if impossible)\n              continue\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n          actions.append(4)   # USE to pick up primitive\n\n  # --------------------------------------------------------------\n  # 3) Move to workshop (if any) and craft the stick.\n  # --------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  if isinstance(recipe, dict):\n      workshop_idx = recipe.get('_at')\n      if workshop_idx is None:\n          # Look for any string key other than '_at' that might denote workshop\n          for k, v in recipe.items():\n              if isinstance(k, str) and k != '_at':\n                  workshop_idx = v\n                  break\n\n  if workshop_idx is not None:\n      target = nearest(cur_pos, workshop_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)   # USE at workshop to craft\n  else:\n      # No explicit workshop \u2013 try crafting at current location.\n      actions.append(4)\n\n  return actions", "env_interactions": 1, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:33:06.915442", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  goal_idx = env.task.goal\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  import numpy as np\n\n  def find_positions(kind):\n      \"\"\"Return list of coordinates where the given kind is present.\"\"\"\n      locs = np.argwhere(state.grid[:, :, kind] > 0)\n      return [tuple(p) for p in locs]\n\n  def nearest(pos, kind):\n      \"\"\"Manhattan\u2011closest cell containing the requested kind.\"\"\"\n      positions = find_positions(kind)\n      if not positions:\n          return None\n      return min(positions, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n\n  def moves_to(src, dst):\n      \"\"\"Return a list of movement actions (DOWN=0, UP=1, LEFT=2, RIGHT=3)\n      that walks from src to dst using a simple Manhattan path.\"\"\"\n      sx, sy = src\n      dx, dy = dst\n      seq = []\n      while sx < dx:\n          seq.append(0)   # DOWN\n          sx += 1\n      while sx > dx:\n          seq.append(1)   # UP\n          sx -= 1\n      while sy < dy:\n          seq.append(3)   # RIGHT\n          sy += 1\n      while sy > dy:\n          seq.append(2)   # LEFT\n          sy -= 1\n      return seq\n\n  # --------------------------------------------------------------\n  # 1) If the goal is a primitive (no recipe), just go pick it up.\n  # --------------------------------------------------------------\n  if not env.world.cookbook.primitives_for(goal_idx):\n      target = nearest(cur_pos, goal_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)   # USE to collect the primitive\n      return actions\n\n  # --------------------------------------------------------------\n  # 2) Gather all required primitive ingredients.\n  # --------------------------------------------------------------\n  needed_prims = env.world.cookbook.primitives_for(goal_idx)\n  for prim_idx, count in needed_prims.items():\n      for _ in range(count):\n          target = nearest(cur_pos, prim_idx)\n          if target is None:\n              # Primitive not present on the map; skip it.\n              continue\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n          actions.append(4)   # USE to pick up the primitive\n\n  # --------------------------------------------------------------\n  # 3) Move to the appropriate workshop (if any) and craft.\n  # --------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  if isinstance(recipe, dict):\n      workshop_idx = recipe.get('_at')\n      if workshop_idx is None:\n          for k, v in recipe.items():\n              if isinstance(k, str) and k != '_at':\n                  workshop_idx = v\n                  break\n\n  if workshop_idx is not None:\n      target = nearest(cur_pos, workshop_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)   # USE at workshop to craft the stick\n  else:\n      # No designated workshop \u2013 attempt to craft at current location.\n      actions.append(4)\n\n  return actions", "env_interactions": 1, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:33:29.060848", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  goal_idx = env.task.goal\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  def find_positions(kind):\n      \"\"\"Return list of (x, y) cells containing the given kind.\"\"\"\n      locs = np.argwhere(state.grid[:, :, kind] > 0)\n      return [tuple(p) for p in locs]\n\n  def nearest(pos, kind):\n      \"\"\"Manhattan\u2011closest cell of the requested kind.\"\"\"\n      positions = find_positions(kind)\n      if not positions:\n          return None\n      return min(positions, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n\n  def moves_to(src, dst):\n      \"\"\"Sequence of movement actions (DOWN=0, UP=1, LEFT=2, RIGHT=3)\n      that walks from src to dst using a simple Manhattan path.\"\"\"\n      sx, sy = src\n      dx, dy = dst\n      seq = []\n      while sx < dx:\n          seq.append(0)   # DOWN\n          sx += 1\n      while sx > dx:\n          seq.append(1)   # UP\n          sx -= 1\n      while sy < dy:\n          seq.append(3)   # RIGHT\n          sy += 1\n      while sy > dy:\n          seq.append(2)   # LEFT\n          sy -= 1\n      return seq\n\n  # If the goal is a primitive \u2013 just go collect it.\n  if not env.world.cookbook.primitives_for(goal_idx):\n      target = nearest(cur_pos, goal_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)   # USE to pick up the primitive\n      return actions\n\n  # Gather all required primitive ingredients.\n  needed_prims = env.world.cookbook.primitives_for(goal_idx)\n  for prim_idx, count in needed_prims.items():\n      for _ in range(count):\n          target = nearest(cur_pos, prim_idx)\n          if target is None:\n              continue\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n          actions.append(4)   # USE to pick it up\n\n  # Move to the appropriate workshop (if any) and craft.\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n\n  if isinstance(recipe, dict):\n      workshop_idx = recipe.get('_at')\n      if workshop_idx is None:\n          for k, v in recipe.items():\n              if isinstance(k, str) and k != '_at':\n                  workshop_idx = v\n                  break\n\n  if workshop_idx is not None:\n      target = nearest(cur_pos, workshop_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)   # USE at workshop to craft the stick\n  else:\n      actions.append(4)   # TRY to craft at current location\n\n  return actions", "env_interactions": 1, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:33:30.398167", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  goal_idx = env.task.goal\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def find_positions(kind):\n      \"\"\"Return list of (x, y) cells containing the given kind.\"\"\"\n      locs = np.argwhere(state.grid[:, :, kind] > 0)\n      return [tuple(p) for p in locs]\n\n  def nearest(pos, kind):\n      \"\"\"Manhattan\u2011closest cell of the requested kind.\"\"\"\n      positions = find_positions(kind)\n      if not positions:\n          return None\n      return min(positions, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n\n  def moves_to(src, dst):\n      \"\"\"Sequence of movement actions (DOWN=0, UP=1, LEFT=2, RIGHT=3)\n      that walks from src to dst using a simple Manhattan path.\"\"\"\n      sx, sy = src\n      dx, dy = dst\n      seq = []\n      while sx < dx:\n          seq.append(0)   # DOWN\n          sx += 1\n      while sx > dx:\n          seq.append(1)   # UP\n          sx -= 1\n      while sy < dy:\n          seq.append(3)   # RIGHT\n          sy += 1\n      while sy > dy:\n          seq.append(2)   # LEFT\n          sy -= 1\n      return seq\n\n  # ------------------------------------------------------------------\n  # 1) If stick is a primitive, just collect it.\n  # ------------------------------------------------------------------\n  if not env.world.cookbook.primitives_for(goal_idx):\n      target = nearest(cur_pos, goal_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)   # USE\n      return actions\n\n  # ------------------------------------------------------------------\n  # 2) Gather required primitive ingredients.\n  # ------------------------------------------------------------------\n  needed_prims = env.world.cookbook.primitives_for(goal_idx)\n  for prim_idx, count in needed_prims.items():\n      for _ in range(count):\n          target = nearest(cur_pos, prim_idx)\n          if target is None:\n              continue\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n          actions.append(4)   # USE to pick up primitive\n\n  # ------------------------------------------------------------------\n  # 3) Move to the designated workshop (if any) and craft the stick.\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  if isinstance(recipe, dict):\n      workshop_idx = recipe.get('_at')\n      if workshop_idx is None:\n          for k, v in recipe.items():\n              if isinstance(k, str) and k != '_at':\n                  workshop_idx = v\n                  break\n\n  if workshop_idx is not None:\n      target = nearest(cur_pos, workshop_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)   # USE at workshop to craft stick\n  else:\n      # No specific workshop \u2013 attempt crafting at current location.\n      actions.append(4)\n\n  return actions", "env_interactions": 1, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:33:47.837221", "function_name": "make_arrow", "function_body": "  actions = []\n  state = env._current_state\n  grid = state.grid\n  world = env.world\n  cb = world.cookbook\n\n  # target item name\n  target_name = \"stick\"\n  try:\n      goal_idx = cb.index[target_name]\n  except Exception:\n      return actions\n\n  # primitive requirements for the stick (empty if stick is primitive)\n  required = cb.primitives_for(goal_idx)\n\n  # mutable copy of current position (x, y)\n  pos = list(state.pos)\n\n  # helper to move the agent using Manhattan steps\n  def _move_to(target):\n      nonlocal pos, actions\n      tx, ty = target\n      while pos[0] < tx:\n          actions.append(3)   # RIGHT\n          pos[0] += 1\n      while pos[0] > tx:\n          actions.append(2)   # LEFT\n          pos[0] -= 1\n      while pos[1] < ty:\n          actions.append(0)   # DOWN\n          pos[1] += 1\n      while pos[1] > ty:\n          actions.append(1)   # UP\n          pos[1] -= 1\n\n  if required:\n      # collect each required primitive\n      for prim_idx, cnt in required.items():\n          locs = np.argwhere(grid[:, :, prim_idx] > 0)\n          if locs.size == 0:\n              continue  # primitive not present\n          target = locs[0].tolist()  # pick the first occurrence\n          _move_to(target)\n          for _ in range(cnt):\n              actions.append(4)   # USE to pick up\n\n      # after gathering primitives, craft at the designated workshop if any\n      recipe = cb.recipes.get(goal_idx, {})\n      workshop_name = recipe.get(\"_at\")\n      if workshop_name:\n          workshop_idx = cb.index[workshop_name]\n          w_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n          if w_locs.size:\n              w_target = w_locs[0].tolist()\n              _move_to(w_target)\n              actions.append(4)   # USE to craft at workshop\n  else:\n      # stick is a primitive itself; just pick it up\n      locs = np.argwhere(grid[:, :, goal_idx] > 0)\n      if locs.size:\n          target = locs[0].tolist()\n          _move_to(target)\n          actions.append(4)   # USE to pick up the stick\n\n  return actions", "env_interactions": 4, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:33:49.182158", "function_name": "make_arrow", "function_body": "  actions = []\n  state = env._current_state\n  grid = state.grid\n  world = env.world\n  cb = world.cookbook\n\n  try:\n      stick_idx = cb.index[\"stick\"]\n  except Exception:\n      return actions\n\n  pos = list(state.pos)\n\n  def _move_to(target):\n      nonlocal pos, actions\n      tx, ty = target\n      while pos[0] < tx:\n          actions.append(3)   # RIGHT\n          pos[0] += 1\n      while pos[0] > tx:\n          actions.append(2)   # LEFT\n          pos[0] -= 1\n      while pos[1] < ty:\n          actions.append(0)   # DOWN\n          pos[1] += 1\n      while pos[1] > ty:\n          actions.append(1)   # UP\n          pos[1] -= 1\n\n  required = cb.primitives_for(stick_idx)\n\n  if required:\n      for prim_idx, count in required.items():\n          locations = np.argwhere(grid[:, :, prim_idx] > 0)\n          if locations.size == 0:\n              continue\n          target = locations[0].tolist()\n          _move_to(target)\n          for _ in range(count):\n              actions.append(4)   # USE\n      recipe = cb.recipes.get(stick_idx, {})\n      workshop_name = recipe.get(\"_at\")\n      if workshop_name:\n          workshop_idx = cb.index[workshop_name]\n          w_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n          if w_locs.size:\n              w_target = w_locs[0].tolist()\n              _move_to(w_target)\n              actions.append(4)   # USE to craft\n  else:\n      locations = np.argwhere(grid[:, :, stick_idx] > 0)\n      if locations.size:\n          target = locations[0].tolist()\n          _move_to(target)\n          actions.append(4)   # USE to pick up stick\n\n  return actions", "env_interactions": 4, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:34:11.979707", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Helper utilities\n  # ----------------------------------------------------------------------\n  # Directions as used by CraftWorld: 0=DOWN, 1=UP, 2=LEFT, 3=RIGHT\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n  ACTION_USE = 4\n\n  def bfs_path(start, goal, grid):\n      \"\"\"Return a list of (x,y) positions from start to goal inclusive.\n      Traversable cells are those with no entities (sum over kinds == 0).\"\"\"\n      h, w = grid.shape[:2]\n      visited = np.zeros((h, w), dtype=bool)\n      prev = {}\n      q = collections.deque([start])\n      visited[start[1], start[0]] = True\n      while q:\n          x, y = q.popleft()\n          if (x, y) == goal:\n              break\n          for dx, dy in DIRS:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and not visited[ny, nx]:\n                  # cell is free or is the goal itself\n                  if np.sum(grid[ny, nx, :]) == 0 or (nx, ny) == goal:\n                      visited[ny, nx] = True\n                      prev[(nx, ny)] = (x, y)\n                      q.append((nx, ny))\n      else:\n          return []  # no path found\n\n      # reconstruct path\n      path = []\n      cur = goal\n      while cur != start:\n          path.append(cur)\n          cur = prev[cur]\n      path.append(start)\n      path.reverse()\n      return path\n\n  def actions_from_path(path, start_dir):\n      \"\"\"Translate a position path into action indices.\"\"\"\n      actions = []\n      cur_dir = start_dir\n      for (x0, y0), (x1, y1) in zip(path, path[1:]):\n          dx, dy = x1 - x0, y1 - y0\n          for a, (adx, ady) in enumerate(DIRS):\n              if (dx, dy) == (adx, ady):\n                  actions.append(a)\n                  cur_dir = a\n                  break\n      return actions, cur_dir\n\n  def opposite_dir(a):\n      return {0: 1, 1: 0, 2: 3, 3: 2}[a]\n\n  # ----------------------------------------------------------------------\n  # Gather environment information\n  # ----------------------------------------------------------------------\n  world = env.world                         # CraftWorld instance\n  scenario = env.scenario                   # CraftScenario instance\n  grid = scenario.init_grid.copy()          # (W, H, n_kinds)\n  pos = tuple(scenario.init_pos)            # (x, y)\n  direction = 0                             # default facing DOWN\n\n  # ----------------------------------------------------------------------\n  # Identify stick recipe\n  # ----------------------------------------------------------------------\n  stick_idx = world.cookbook.index[\"stick\"]\n  needed_prims = world.cookbook.primitives_for(stick_idx)\n\n  action_seq = []\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive\n  # ----------------------------------------------------------------------\n  for prim_idx, cnt in needed_prims.items():\n      for _ in range(cnt):\n          # locate any cell containing the primitive\n          locs = np.argwhere(grid[:, :, prim_idx] > 0)\n          if locs.size == 0:\n              continue\n          ty, tx = locs[0]  # (y, x)\n\n          # choose an adjacent empty cell to stand on\n          stand = None\n          for dx, dy in DIRS:\n              sx, sy = tx + dx, ty + dy\n              if 0 <= sx < grid.shape[0] and 0 <= sy < grid.shape[1]:\n                  if np.sum(grid[sy, sx, :]) == 0:\n                      stand = (sx, sy)\n                      break\n          if stand is None:\n              stand = (tx, ty)  # fallback\n\n          # move to standing position\n          path = bfs_path(pos, stand, grid)\n          if path:\n              moves, direction = actions_from_path(path, direction)\n              action_seq.extend(moves)\n              pos = stand\n\n          # face the primitive and USE\n          dx, dy = tx - stand[0], ty - stand[1]\n          for a, (adx, ady) in enumerate(DIRS):\n              if (dx, dy) == (adx, ady):\n                  if direction != a:\n                      # turn by stepping towards the primitive then back\n                      action_seq.append(a)\n                      action_seq.append(ACTION_USE)\n                      action_seq.append(opposite_dir(a))\n                  else:\n                      action_seq.append(ACTION_USE)\n                  direction = a\n                  break\n\n          # simulate picking up the primitive\n          grid[ty, tx, prim_idx] = 0\n\n  # ----------------------------------------------------------------------\n  # Craft the stick at its workshop (if a workshop is specified)\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = world.cookbook.index[workshop_name]\n      ws = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws.size:\n          wy, wx = ws[0]\n\n          # find adjacent empty cell to stand on\n          stand = None\n          for dx, dy in DIRS:\n              sx, sy = wx + dx, wy + dy\n              if 0 <= sx < grid.shape[0] and 0 <= sy < grid.shape[1]:\n                  if np.sum(grid[sy, sx, :]) == 0:\n                      stand = (sx, sy)\n                      break\n          if stand is None:\n              stand = (wx, wy)\n\n          # move to workshop adjacency\n          path = bfs_path(pos, stand, grid)\n          if path:\n              moves, direction = actions_from_path(path, direction)\n              action_seq.extend(moves)\n              pos = stand\n\n          # face workshop and USE to craft\n          dx, dy = wx - stand[0], wy - stand[1]\n          for a, (adx, ady) in enumerate(DIRS):\n              if (dx, dy) == (adx, ady):\n                  if direction != a:\n                      action_seq.append(a)\n                      action_seq.append(ACTION_USE)\n                      action_seq.append(opposite_dir(a))\n                  else:\n                      action_seq.append(ACTION_USE)\n                  direction = a\n                  break\n\n  # ----------------------------------------------------------------------\n  # Return compiled action list\n  # ----------------------------------------------------------------------\n  return action_seq", "env_interactions": 9, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:34:13.350579", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # --------------------------------------------------------------\n  # Constants and helpers\n  # --------------------------------------------------------------\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # DOWN,UP,LEFT,RIGHT\n  ACTION_USE = 4\n\n  def bfs_path(start, goal, grid):\n      \"\"\"Return list of (x,y) positions from start to goal inclusive.\n      Traversable cells are empty (sum over kinds == 0) or the goal cell.\"\"\"\n      h, w = grid.shape[:2]\n      visited = np.zeros((h, w), dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start[1], start[0]] = True\n      while q:\n          x, y = q.popleft()\n          if (x, y) == goal:\n              break\n          for dx, dy in DIRS:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and not visited[ny, nx]:\n                  if np.sum(grid[ny, nx, :]) == 0 or (nx, ny) == goal:\n                      visited[ny, nx] = True\n                      prev[(nx, ny)] = (x, y)\n                      q.append((nx, ny))\n      else:\n          return []  # no path found\n\n      # reconstruct path\n      path = []\n      cur = goal\n      while cur != start:\n          path.append(cur)\n          cur = prev[cur]\n      path.append(start)\n      path.reverse()\n      return path\n\n  def actions_from_path(path, start_dir):\n      \"\"\"Translate a position path to action indices; returns actions and final dir.\"\"\"\n      actions = []\n      cur_dir = start_dir\n      for (x0, y0), (x1, y1) in zip(path, path[1:]):\n          dx, dy = x1 - x0, y1 - y0\n          for a, (adx, ady) in enumerate(DIRS):\n              if (dx, dy) == (adx, ady):\n                  actions.append(a)\n                  cur_dir = a\n                  break\n      return actions, cur_dir\n\n  def opposite_dir(a):\n      return {0: 1, 1: 0, 2: 3, 3: 2}[a]\n\n  # --------------------------------------------------------------\n  # Gather world information\n  # --------------------------------------------------------------\n  world = env.world                         # CraftWorld\n  scenario = env.scenario                   # CraftScenario\n  grid = scenario.init_grid.copy()          # (W, H, n_kinds)\n  pos = tuple(scenario.init_pos)            # (x, y)\n  direction = 0                             # default facing DOWN\n\n  # --------------------------------------------------------------\n  # Identify stick recipe and required primitives\n  # --------------------------------------------------------------\n  stick_idx = world.cookbook.index[\"stick\"]\n  prim_dict = world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n  action_seq = []\n\n  # --------------------------------------------------------------\n  # Collect each primitive required for a stick\n  # --------------------------------------------------------------\n  for prim_idx, needed_cnt in prim_dict.items():\n      for _ in range(needed_cnt):\n          # locate first occurrence of the primitive\n          locs = np.argwhere(grid[:, :, prim_idx] > 0)\n          if locs.size == 0:\n              continue  # primitive missing; skip\n          ty, tx = locs[0]  # y, x coordinates in grid\n\n          # choose a free adjacent cell to stand on\n          stand = None\n          for dx, dy in DIRS:\n              sx, sy = tx + dx, ty + dy\n              if 0 <= sx < grid.shape[0] and 0 <= sy < grid.shape[1]:\n                  if np.sum(grid[sy, sx, :]) == 0:\n                      stand = (sx, sy)\n                      break\n          if stand is None:\n              stand = (tx, ty)   # fallback: stand on the primitive cell\n\n          # move to standing position\n          path = bfs_path(pos, stand, grid)\n          if not path:\n              continue\n          moves, direction = actions_from_path(path, direction)\n          action_seq.extend(moves)\n          pos = stand\n\n          # face the primitive and USE\n          dx, dy = tx - stand[0], ty - stand[1]\n          for a, (adx, ady) in enumerate(DIRS):\n              if (dx, dy) == (adx, ady):\n                  if direction != a:\n                      # turn by stepping towards then stepping back after USE\n                      action_seq.append(a)\n                      action_seq.append(ACTION_USE)\n                      action_seq.append(opposite_dir(a))\n                  else:\n                      action_seq.append(ACTION_USE)\n                  direction = a\n                  break\n\n          # simulate picking up the primitive\n          grid[ty, tx, prim_idx] = 0\n\n  # --------------------------------------------------------------\n  # Craft the stick at its workshop (if any)\n  # --------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      ws = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws.size:\n          wy, wx = ws[0]   # workshop location\n          # find adjacent free cell to stand\n          stand = None\n          for dx, dy in DIRS:\n              sx, sy = wx + dx, wy + dy\n              if 0 <= sx < grid.shape[0] and 0 <= sy < grid.shape[1]:\n                  if np.sum(grid[sy, sx, :]) == 0:\n                      stand = (sx, sy)\n                      break\n          if stand is None:\n              stand = (wx, wy)\n\n          # move to workshop adjacent cell\n          path = bfs_path(pos, stand, grid)\n          if path:\n              moves, direction = actions_from_path(path, direction)\n              action_seq.extend(moves)\n              pos = stand\n\n          # face workshop and USE to craft\n          dx, dy = wx - stand[0], wy - stand[1]\n          for a, (adx, ady) in enumerate(DIRS):\n              if (dx, dy) == (adx, ady):\n                  if direction != a:\n                      action_seq.append(a)\n                      action_seq.append(ACTION_USE)\n                      action_seq.append(opposite_dir(a))\n                  else:\n                      action_seq.append(ACTION_USE)\n                  direction = a\n                  break\n\n  # --------------------------------------------------------------\n  # Return the compiled action list\n  # --------------------------------------------------------------\n  return action_seq", "env_interactions": 9, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:34:37.673131", "function_name": "make_arrow", "function_body": "  # Helper to generate Manhattan moves from cur_pos to target\n  def _move(cur, tgt):\n      moves = []\n      x, y = cur\n      tx, ty = tgt\n      while x < tx:\n          moves.append(3)   # RIGHT\n          x += 1\n      while x > tx:\n          moves.append(2)   # LEFT\n          x -= 1\n      while y < ty:\n          moves.append(0)   # DOWN\n          y += 1\n      while y > ty:\n          moves.append(1)   # UP\n          y -= 1\n      return moves, (x, y)\n\n  state = env._current_state\n  cookbook = env.world.cookbook\n  stick_idx = cookbook.index['stick']\n\n  # 1) Already have a stick in inventory.\n  if state.inventory[stick_idx] > 0:\n      return []\n\n  # 2) Stick exists on the grid \u2013 pick it up.\n  stick_cells = np.argwhere(state.grid[:, :, stick_idx] > 0)\n  if stick_cells.size > 0:\n      target = tuple(stick_cells[0])\n      moves, _ = _move(state.pos, target)\n      moves.append(4)                     # USE to pick up\n      return moves\n\n  # 3) Need to craft a stick.\n  primitive_req = cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n  recipe = cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = cookbook.index[workshop_name] if workshop_name is not None else None\n\n  actions = []\n  cur_pos = state.pos\n  # keep a local copy of inventory to track collected primitives\n  inv = state.inventory.copy()\n\n  # 3a) Collect each required primitive.\n  for prim_idx, needed in primitive_req.items():\n      while inv[prim_idx] < needed:\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # primitive unavailable \u2013 abort planning\n              return actions\n          # choose the first occurrence (could be improved with nearest search)\n          target = tuple(prim_cells[0])\n          moves, cur_pos = _move(cur_pos, target)\n          actions.extend(moves)\n          actions.append(4)               # USE to pick up primitive\n          inv[prim_idx] += 1\n\n  # 3b) Go to workshop (if required) and craft the stick.\n  if workshop_idx is not None:\n      ws_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if ws_cells.size > 0:\n          target = tuple(ws_cells[0])\n          moves, cur_pos = _move(cur_pos, target)\n          actions.extend(moves)\n          actions.append(4)               # USE to craft stick\n      else:\n          # No workshop cell found \u2013 attempt craft at current location.\n          actions.append(4)\n  else:\n      # No workshop needed.\n      actions.append(4)\n\n  return actions", "env_interactions": 4, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:34:39.063999", "function_name": "make_arrow", "function_body": "  def _move_actions(cur_pos, target):\n      actions = []\n      x, y = cur_pos\n      tx, ty = target\n      while x < tx:\n          actions.append(3)  # RIGHT\n          x += 1\n      while x > tx:\n          actions.append(2)  # LEFT\n          x -= 1\n      while y < ty:\n          actions.append(0)  # DOWN\n          y += 1\n      while y > ty:\n          actions.append(1)  # UP\n          y -= 1\n      return actions, (x, y)\n\n  state = env._current_state\n  cookbook = env.world.cookbook\n  stick_idx = cookbook.index['stick']\n\n  # 1) Already have a stick in inventory.\n  if state.inventory[stick_idx] > 0:\n      return []\n\n  # 2) Try to pick up a stick that is already placed on the grid.\n  stick_cells = np.argwhere(state.grid[:, :, stick_idx] > 0)\n  if stick_cells.size > 0:\n      target = tuple(stick_cells[0])\n      moves, _ = _move_actions(state.pos, target)\n      moves.append(4)                     # USE to pick it up\n      return moves\n\n  # 3) Need to craft a stick.\n  primitive_req = cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n  recipe = cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = cookbook.index[workshop_name] if workshop_name is not None else None\n\n  actions = []\n  cur_pos = state.pos\n  inventory = state.inventory.copy()\n\n  # 3a) Collect required primitive ingredients.\n  for prim_idx, needed in primitive_req.items():\n      while inventory[prim_idx] < needed:\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # No more of this primitive on the map \u2013 abort planning.\n              return actions\n          target = tuple(prim_cells[0])\n          moves, cur_pos = _move_actions(cur_pos, target)\n          actions.extend(moves)\n          actions.append(4)                # USE to pick up the primitive\n          inventory[prim_idx] += 1\n\n  # 3b) Go to the appropriate workshop (if required) and craft the stick.\n  if workshop_idx is not None:\n      ws_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if ws_cells.size > 0:\n          target = tuple(ws_cells[0])\n          moves, cur_pos = _move_actions(cur_pos, target)\n          actions.extend(moves)\n          actions.append(4)                # USE to craft the stick\n      else:\n          # No workshop cell found; attempt to craft at current location.\n          actions.append(4)\n  else:\n      # No workshop needed; craft at current location.\n      actions.append(4)\n\n  return actions", "env_interactions": 4, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:35:08.785874", "function_name": "make_arrow", "function_body": "  # Retrieve current state, resetting if necessary\n  try:\n      state = env._current_state\n  except AttributeError:\n      env.reset()\n      state = env._current_state\n\n  # Action indices\n  specs = env.action_specs()\n  DOWN = specs[\"DOWN\"]\n  UP = specs[\"UP\"]\n  LEFT = specs[\"LEFT\"]\n  RIGHT = specs[\"RIGHT\"]\n  USE = specs[\"USE\"]\n\n  # Index of the target item \"stick\"\n  stick_idx = env.world.cookbook.index[\"stick\"]\n\n  # Primitive requirements for a stick (empty dict if primitive)\n  prim_req = env.world.cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n\n  # Copy grid for planning (so we can \"remove\" collected items)\n  grid = state.grid.copy()\n\n  # Build mask of blocked cells (non\u2011grabbable entities)\n  blocked = np.zeros(grid.shape[:2], dtype=bool)\n  for idx in env.world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # ------------------------------------------------------------------\n  # Helper: BFS shortest path avoiding blocked cells\n  # ------------------------------------------------------------------\n  def _bfs_path(start, goal, blocked_mask):\n      from collections import deque\n\n      dirs = [\n          (1, 0, DOWN),   # down\n          (-1, 0, UP),    # up\n          (0, -1, LEFT),  # left\n          (0, 1, RIGHT),  # right\n      ]\n\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for dx, dy, a in dirs:\n              nx, ny = x + dx, y + dy\n              if (\n                  0 <= nx < blocked_mask.shape[0]\n                  and 0 <= ny < blocked_mask.shape[1]\n                  and not blocked_mask[nx, ny]\n                  and (nx, ny) not in visited\n              ):\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [a]))\n      return None  # unreachable\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # ------------------------------------------------------------------\n  # Case A: stick is a primitive placed in the world\n  # ------------------------------------------------------------------\n  if not prim_req:\n      stick_cells = np.argwhere(grid[:, :, stick_idx] > 0)\n      if stick_cells.size == 0:\n          return []  # no stick available\n      target = tuple(stick_cells[0])\n      if cur_pos != target:\n          path = _bfs_path(cur_pos, target, blocked)\n          if path is None:\n              return []  # cannot reach the stick\n          actions.extend(path)\n          cur_pos = target\n      actions.append(USE)\n      return actions\n\n  # ------------------------------------------------------------------\n  # Case B: collect required primitives\n  # ------------------------------------------------------------------\n  needed = dict(prim_req)  # mutable copy\n\n  while any(cnt > 0 for cnt in needed.values()):\n      best_path = None\n      best_target = None\n      best_prim = None\n\n      # Search for the nearest reachable needed primitive\n      for prim_idx, cnt in needed.items():\n          if cnt <= 0:\n              continue\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          for cell in prim_cells:\n              target = tuple(cell)\n              path = _bfs_path(cur_pos, target, blocked)\n              if path is None:\n                  continue\n              if best_path is None or len(path) < len(best_path):\n                  best_path = path\n                  best_target = target\n                  best_prim = prim_idx\n\n      if best_path is None:\n          # No reachable required primitive left\n          return []\n\n      # Move to the primitive and pick it up\n      actions.extend(best_path)\n      actions.append(USE)\n\n      # Update planning state\n      cur_pos = best_target\n      needed[best_prim] -= 1\n      grid[best_target[0], best_target[1], best_prim] = 0  # remove from copy\n\n  # ------------------------------------------------------------------\n  # Case C: go to required workshop (if any)\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          target = tuple(workshop_cells[0])\n          if cur_pos != target:\n              path = _bfs_path(cur_pos, target, blocked)\n              if path is None:\n                  return []  # cannot reach workshop\n              actions.extend(path)\n              cur_pos = target\n\n  # ------------------------------------------------------------------\n  # Finally, craft the stick\n  # ------------------------------------------------------------------\n  actions.append(USE)\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:35:10.211567", "function_name": "make_arrow", "function_body": "  # Ensure we have a current state\n  try:\n      state = env._current_state\n  except AttributeError:\n      env.reset()\n      state = env._current_state\n\n  # Action indices\n  specs = env.action_specs()\n  DOWN = specs[\"DOWN\"]\n  UP = specs[\"UP\"]\n  LEFT = specs[\"LEFT\"]\n  RIGHT = specs[\"RIGHT\"]\n  USE = specs[\"USE\"]\n\n  # Index of the target item \"stick\"\n  stick_idx = env.world.cookbook.index[\"stick\"]\n\n  # Primitive requirements for a stick (empty dict if stick is primitive)\n  prim_req = env.world.cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n\n  # Copy grid for planning (so we can \"remove\" collected items)\n  grid = state.grid.copy()\n\n  # Build mask of blocked cells (non\u2011grabbable entities)\n  blocked = np.zeros(grid.shape[:2], dtype=bool)\n  for idx in env.world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # ------------------------------------------------------------------\n  # Helper: BFS shortest path avoiding blocked cells\n  # ------------------------------------------------------------------\n  def _bfs_path(start, goal, blocked_mask):\n      from collections import deque\n\n      dirs = [\n          (1, 0, DOWN),   # down\n          (-1, 0, UP),    # up\n          (0, -1, LEFT),  # left\n          (0, 1, RIGHT),  # right\n      ]\n\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for dx, dy, a in dirs:\n              nx, ny = x + dx, y + dy\n              if (\n                  0 <= nx < blocked_mask.shape[0]\n                  and 0 <= ny < blocked_mask.shape[1]\n                  and not blocked_mask[nx, ny]\n                  and (nx, ny) not in visited\n              ):\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [a]))\n      return None  # unreachable\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # ------------------------------------------------------------------\n  # Case A: stick is already a primitive placed in the world\n  # ------------------------------------------------------------------\n  if not prim_req:\n      stick_cells = np.argwhere(grid[:, :, stick_idx] > 0)\n      if stick_cells.size == 0:\n          return []  # no stick available\n      target = tuple(stick_cells[0])\n      if cur_pos != target:\n          path = _bfs_path(cur_pos, target, blocked)\n          if path is None:\n              return []  # cannot reach the stick\n          actions.extend(path)\n          cur_pos = target\n      actions.append(USE)\n      return actions\n\n  # ------------------------------------------------------------------\n  # Case B: collect required primitives\n  # ------------------------------------------------------------------\n  needed = dict(prim_req)  # mutable copy\n\n  while any(cnt > 0 for cnt in needed.values()):\n      best_path = None\n      best_target = None\n      best_prim = None\n\n      # Search for the nearest reachable needed primitive\n      for prim_idx, cnt in needed.items():\n          if cnt <= 0:\n              continue\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          for cell in prim_cells:\n              target = tuple(cell)\n              path = _bfs_path(cur_pos, target, blocked)\n              if path is None:\n                  continue\n              if best_path is None or len(path) < len(best_path):\n                  best_path = path\n                  best_target = target\n                  best_prim = prim_idx\n\n      if best_path is None:\n          # No reachable required primitive left\n          return []\n\n      # Move to the primitive and pick it up\n      actions.extend(best_path)\n      actions.append(USE)\n\n      # Update planning state\n      cur_pos = best_target\n      needed[best_prim] -= 1\n      grid[best_target[0], best_target[1], best_prim] = 0  # remove from copy\n\n  # ------------------------------------------------------------------\n  # Case C: go to required workshop (if any)\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          target = tuple(workshop_cells[0])\n          if cur_pos != target:\n              path = _bfs_path(cur_pos, target, blocked)\n              if path is None:\n                  return []  # cannot reach workshop\n              actions.extend(path)\n              cur_pos = target\n\n  # ------------------------------------------------------------------\n  # Finally, craft the stick\n  # ------------------------------------------------------------------\n  actions.append(USE)\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:35:34.966602", "function_name": "make_arrow", "function_body": "  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  def manhattan_path(start, goal):\n      \"\"\"Horizontal\u2011then\u2011vertical moves from start to goal (ignores obstacles).\"\"\"\n      x, y = start\n      gx, gy = goal\n      actions = []\n      while x < gx:\n          actions.append(ACTION_RIGHT)\n          x += 1\n      while x > gx:\n          actions.append(ACTION_LEFT)\n          x -= 1\n      while y < gy:\n          actions.append(ACTION_DOWN)\n          y += 1\n      while y > gy:\n          actions.append(ACTION_UP)\n          y -= 1\n      return actions\n\n  def nearest_position(positions, reference):\n      \"\"\"Return the position from *positions* with smallest Manhattan distance to *reference*.\"\"\"\n      if positions.shape[0] == 0:\n          return None\n      ref = np.array(reference)\n      dists = np.sum(np.abs(positions - ref), axis=1)\n      return tuple(positions[np.argmin(dists)])\n\n  # ------------------------------------------------------------------\n  # Gather current state information\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n\n  # ------------------------------------------------------------------\n  # Identify the goal (stick)\n  # ------------------------------------------------------------------\n  goal_name = \"stick\"\n  try:\n      goal_idx = env.world.cookbook.index[goal_name]\n  except Exception:\n      return []\n\n  # Already have a stick?\n  if inventory[goal_idx] > 0:\n      return []\n\n  plan_actions = []\n\n  # ------------------------------------------------------------------\n  # Determine required primitives for the stick\n  # ------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n\n  # If there is no recipe (stick is a primitive on the map), just collect it.\n  if not primitives_needed:\n      stick_cells = np.argwhere(grid[:, :, goal_idx] > 0)\n      if stick_cells.shape[0] == 0:\n          return plan_actions\n      target = nearest_position(stick_cells, pos)\n      plan_actions.extend(manhattan_path(pos, target))\n      plan_actions.append(ACTION_USE)\n      return plan_actions\n\n  # ------------------------------------------------------------------\n  # 1) Collect needed primitives\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      while inventory[prim_idx] < needed_cnt:\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.shape[0] == 0:\n              return plan_actions  # cannot satisfy requirement\n          target = nearest_position(prim_cells, pos)\n\n          # Move to the primitive\n          plan_actions.extend(manhattan_path(pos, target))\n          pos = target\n\n          # Pick it up\n          plan_actions.append(ACTION_USE)\n\n          # Simulate local state update for further planning\n          inventory[prim_idx] += 1\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # ------------------------------------------------------------------\n  # 2) Go to required workshop (if any) and craft the stick\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      try:\n          workshop_idx = env.world.cookbook.index[workshop_name]\n      except Exception:\n          return plan_actions\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.shape[0] == 0:\n          return plan_actions\n      wcell = tuple(workshop_cells[0])\n\n      # Find a free adjacent cell to stand on (fallback to the workshop cell itself)\n      neighbours = [(wcell[0] + dx, wcell[1] + dy) for dx, dy in\n                    [(1, 0), (-1, 0), (0, 1), (0, -1)]]\n      stand_pos = None\n      for nx, ny in neighbours:\n          if (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and\n                  grid[nx, ny, :].sum() == 0):\n              stand_pos = (nx, ny)\n              break\n      if stand_pos is None:\n          stand_pos = wcell\n\n      # Move to the chosen standing position\n      plan_actions.extend(manhattan_path(pos, stand_pos))\n      pos = stand_pos\n\n      # Craft the stick\n      plan_actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # Return the constructed action list\n  # ------------------------------------------------------------------\n  return plan_actions", "env_interactions": 5, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:35:36.362189", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # Action indices as defined in CraftLab.action_specs\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions from start to goal using\n      horizontal\u2011then\u2011vertical moves (ignores obstacles).\"\"\"\n      x, y = start\n      gx, gy = goal\n      actions = []\n      while x < gx:\n          actions.append(ACTION_RIGHT)\n          x += 1\n      while x > gx:\n          actions.append(ACTION_LEFT)\n          x -= 1\n      while y < gy:\n          actions.append(ACTION_DOWN)\n          y += 1\n      while y > gy:\n          actions.append(ACTION_UP)\n          y -= 1\n      return actions\n\n  def nearest_position(positions, reference):\n      \"\"\"Pick the position from *positions* with smallest Manhattan distance\n      to *reference*.\"\"\"\n      if positions.shape[0] == 0:\n          return None\n      ref = np.array(reference)\n      dists = np.sum(np.abs(positions - ref), axis=1)\n      return tuple(positions[np.argmin(dists)])\n\n  # ------------------------------------------------------------------\n  # Gather current state information\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n\n  # ------------------------------------------------------------------\n  # Identify the goal (stick)\n  # ------------------------------------------------------------------\n  goal_name = \"stick\"\n  try:\n      goal_idx = env.world.cookbook.index[goal_name]\n  except Exception:\n      # Goal not present \u2013 nothing to do\n      return []\n\n  # If we already have a stick in inventory, no actions are needed\n  if inventory[goal_idx] > 0:\n      return []\n\n  plan_actions = []\n\n  # ------------------------------------------------------------------\n  # Determine required primitives for the stick\n  # ------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n\n  # If there is no recipe (stick is a primitive), just collect it directly.\n  if not primitives_needed:\n      stick_cells = np.argwhere(grid[:, :, goal_idx] > 0)\n      if stick_cells.shape[0] == 0:\n          return plan_actions\n      target = nearest_position(stick_cells, pos)\n      plan_actions.extend(manhattan_path(pos, target))\n      plan_actions.append(ACTION_USE)\n      return plan_actions\n\n  # ------------------------------------------------------------------\n  # 1) Collect needed primitives\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      while inventory[prim_idx] < needed_cnt:\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.shape[0] == 0:\n              # Primitive not available \u2013 abort planning\n              return plan_actions\n          target = nearest_position(prim_cells, pos)\n\n          # Move to the primitive\n          plan_actions.extend(manhattan_path(pos, target))\n          pos = target\n\n          # Pick it up\n          plan_actions.append(ACTION_USE)\n\n          # Simulate the pick\u2011up locally for further planning\n          inventory[prim_idx] += 1\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # ------------------------------------------------------------------\n  # 2) Go to the required workshop (if any) and craft the stick\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      try:\n          workshop_idx = env.world.cookbook.index[workshop_name]\n      except Exception:\n          return plan_actions\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.shape[0] == 0:\n          return plan_actions\n      wcell = tuple(workshop_cells[0])\n\n      # Find a free adjacent cell to stand on (or fallback to the workshop cell)\n      neighbours = [(wcell[0] + dx, wcell[1] + dy) for dx, dy in\n                    [(1, 0), (-1, 0), (0, 1), (0, -1)]]\n      stand_pos = None\n      for nx, ny in neighbours:\n          if (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and\n                  grid[nx, ny, :].sum() == 0):\n              stand_pos = (nx, ny)\n              break\n      if stand_pos is None:\n          stand_pos = wcell  # fallback\n\n      plan_actions.extend(manhattan_path(pos, stand_pos))\n      pos = stand_pos\n\n      # Craft the stick\n      plan_actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # Return the constructed action list\n  # ------------------------------------------------------------------\n  return plan_actions", "env_interactions": 5, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:35:53.814340", "function_name": "make_arrow", "function_body": "  actions = []\n  state = env._current_state\n  grid = state.grid\n  world = env.world\n  cb = world.cookbook\n\n  # index of the target item \"stick\"\n  try:\n      goal_idx = cb.index[\"stick\"]\n  except Exception:\n      return actions\n\n  # primitives (and required counts) for the stick\n  prims = cb.primitives_for(goal_idx)\n\n  # current agent position (mutable)\n  pos = list(state.pos)\n\n  # helper to move to a target cell using Manhattan moves\n  def _move_to(target):\n      nonlocal pos, actions\n      tx, ty = target\n      while pos[0] < tx:\n          actions.append(3)   # RIGHT\n          pos[0] += 1\n      while pos[0] > tx:\n          actions.append(2)   # LEFT\n          pos[0] -= 1\n      while pos[1] < ty:\n          actions.append(0)   # DOWN\n          pos[1] += 1\n      while pos[1] > ty:\n          actions.append(1)   # UP\n          pos[1] -= 1\n\n  # collect each required primitive\n  for prim_idx, needed in prims.items():\n      locs = np.argwhere(grid[:, :, prim_idx] > 0)\n      if locs.size == 0:\n          continue  # primitive not present; skip\n      target = locs[0].tolist()  # take the first occurrence\n      _move_to(target)\n      for _ in range(needed):\n          actions.append(4)   # USE to pick up\n\n  # if the recipe specifies a workshop, move there and craft the stick\n  recipe = cb.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = cb.index[workshop_name]\n      w_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if w_locs.size:\n          w_target = w_locs[0].tolist()\n          _move_to(w_target)\n          actions.append(4)   # USE to craft at the workshop\n\n  return actions", "env_interactions": 4, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:35:55.146985", "function_name": "make_arrow", "function_body": "  actions = []\n  # current state and world information\n  state = env._current_state\n  grid = state.grid\n  world = env.world\n  cb = world.cookbook\n\n  # index of the target item \"stick\"\n  try:\n      goal_idx = cb.index[\"stick\"]\n  except Exception:\n      return actions\n\n  # helper to move the agent using Manhattan steps\n  # action mapping: 0=DOWN, 1=UP, 2=LEFT, 3=RIGHT, 4=USE\n  pos = list(state.pos)\n\n  def _move_to(target):\n      nonlocal pos, actions\n      tx, ty = target\n      while pos[0] < tx:\n          actions.append(3)   # RIGHT\n          pos[0] += 1\n      while pos[0] > tx:\n          actions.append(2)   # LEFT\n          pos[0] -= 1\n      while pos[1] < ty:\n          actions.append(0)   # DOWN\n          pos[1] += 1\n      while pos[1] > ty:\n          actions.append(1)   # UP\n          pos[1] -= 1\n\n  # Determine whether the stick must be crafted or is a primitive itself\n  recipe = cb.recipes.get(goal_idx, {})\n  primitives_needed = cb.primitives_for(goal_idx)\n\n  if primitives_needed:\n      # Collect each required primitive in the needed quantity\n      for prim_idx, count in primitives_needed.items():\n          locs = np.argwhere(grid[:, :, prim_idx] > 0)\n          if locs.size == 0:\n              continue  # primitive not present; skip (should not happen)\n          target = locs[0].tolist()\n          _move_to(target)\n          for _ in range(count):\n              actions.append(4)   # USE to pick up\n\n      # If the recipe specifies a workshop, move there and craft\n      workshop_name = recipe.get(\"_at\")\n      if workshop_name:\n          workshop_idx = cb.index[workshop_name]\n          w_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n          if w_locs.size:\n              w_target = w_locs[0].tolist()\n              _move_to(w_target)\n              actions.append(4)   # USE to craft at the workshop\n  else:\n      # Stick is a primitive; just pick up any instance\n      locs = np.argwhere(grid[:, :, goal_idx] > 0)\n      if locs.size:\n          target = locs[0].tolist()\n          _move_to(target)\n          actions.append(4)   # USE to pick up the stick\n\n  return actions", "env_interactions": 4, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:36:27.127093", "function_name": "make_arrow", "function_body": "  # Access the current state of the environment\n  state = env._current_state\n\n  # Find the integer index for the \"stick\" item\n  stick_idx = env.world.cookbook.index.get('stick')\n  if stick_idx is None:\n      return []\n\n  # Locate all cells that currently contain a stick\n  stick_positions = np.argwhere(state.grid[:, :, stick_idx] > 0)\n  if len(stick_positions) == 0:\n      # No sticks present in the world \u2013 nothing to do\n      return []\n\n  # Pick the first stick we find as the target\n  target = tuple(stick_positions[0])\n\n  # Build a blocked\u2011cell map (any non\u2011zero kind makes the cell impassable)\n  blocked = np.any(state.grid > 0, axis=2)\n  # The agent's starting cell is considered free\n  blocked[state.pos[0], state.pos[1]] = False\n\n  # Four\u2011direction offsets\n  offsets = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n  # Identify free neighbouring cells of the target (where we can stand to use)\n  neighbor_cells = []\n  for dx, dy in offsets:\n      nx, ny = target[0] + dx, target[1] + dy\n      if (0 <= nx < blocked.shape[0] and 0 <= ny < blocked.shape[1]\n              and not blocked[nx, ny]):\n          neighbor_cells.append((nx, ny))\n\n  # BFS to the nearest reachable neighbour cell\n  start = tuple(state.pos)\n  queue = collections.deque([start])\n  visited = {start}\n  parent = {}\n  goal_cell = None\n\n  while queue:\n      cur = queue.popleft()\n      if cur in neighbor_cells:\n          goal_cell = cur\n          break\n      for dx, dy in offsets:\n          nx, ny = cur[0] + dx, cur[1] + dy\n          if (0 <= nx < blocked.shape[0] and 0 <= ny < blocked.shape[1]\n                  and not blocked[nx, ny]):\n              nxt = (nx, ny)\n              if nxt not in visited:\n                  visited.add(nxt)\n                  parent[nxt] = cur\n                  queue.append(nxt)\n\n  if goal_cell is None:\n      # No reachable neighbour \u2013 give up\n      return []\n\n  # Reconstruct the path from start to the chosen neighbour\n  path = []\n  cur = goal_cell\n  while cur != start:\n      path.append(cur)\n      cur = parent[cur]\n  path.reverse()\n\n  # Mapping from (dx, dy) to action indices (DOWN, UP, LEFT, RIGHT)\n  move_to_action = {(1, 0): 0, (-1, 0): 1, (0, -1): 2, (0, 1): 3}\n  opposite = {0: 1, 1: 0, 2: 3, 3: 2}\n\n  actions = []\n  cur_pos = start\n  cur_dir = state.dir\n\n  # Follow the path, emitting movement actions\n  for step in path:\n      dx, dy = step[0] - cur_pos[0], step[1] - cur_pos[1]\n      act = move_to_action[(dx, dy)]\n      actions.append(act)\n      cur_dir = act\n      cur_pos = step\n\n  # Determine the direction we must face to have the target cell in front\n  dx, dy = target[0] - goal_cell[0], target[1] - goal_cell[1]\n  required_dir = move_to_action[(dx, dy)]\n\n  # If we are not already facing the target, adjust by a small detour\n  if cur_dir != required_dir:\n      # Move one step towards the target and immediately step back;\n      # this changes the facing direction without altering position.\n      actions.append(required_dir)\n      actions.append(opposite[required_dir])\n      cur_dir = required_dir\n\n  # Finally, use the item in front to pick up the stick\n  actions.append(4)  # USE action\n\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-10-23T02:41:27.214512", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # Action constants (as defined in the environment)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Helper to move one step towards a target position\n  def _move_towards(pos, target):\n      x, y = pos\n      tx, ty = target\n      if x < tx:\n          return (x + 1, y), DOWN\n      if x > tx:\n          return (x - 1, y), UP\n      if y < ty:\n          return (x, y + 1), RIGHT\n      if y > ty:\n          return (x, y - 1), LEFT\n      # already at target\n      return pos, None\n\n  # Get current state\n  state = env._current_state\n  grid = state.grid\n  pos = tuple(state.pos)\n\n  # Goal name (stick)\n  goal_name = \"stick\"\n  goal_idx = env.world.cookbook.index[goal_name]\n\n  # Determine required primitives for the goal\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  required = {}\n  # Ingredients other than the special \"_at\" key are primitives needed\n  for k, v in recipe.items():\n      if k != \"_at\":\n          required[int(k)] = int(v)\n\n  # If there is no recipe, stick is a primitive itself\n  if not required:\n      required = {goal_idx: 1}\n      workshop_name = None\n  else:\n      workshop_name = recipe.get(\"_at\", None)\n\n  actions = []\n\n  # Function to locate any cell containing a given kind\n  def _find_any_kind(kind):\n      locs = np.argwhere(grid[:, :, kind] > 0)\n      if len(locs) == 0:\n          return None\n      # return first location as (row, col)\n      return tuple(locs[0])\n\n  # Collect all required primitives\n  for kind_idx, count_needed in required.items():\n      # Collect until we have enough of this kind in inventory\n      while state.inventory[kind_idx] < count_needed:\n          target_loc = _find_any_kind(kind_idx)\n          if target_loc is None:\n              # No more of this primitive on the map; break to avoid infinite loop\n              break\n          # Move to a cell adjacent to the target (Manhattan adjacency)\n          # We consider adjacency when max(|dx|,|dy|) == 1\n          while max(abs(pos[0] - target_loc[0]), abs(pos[1] - target_loc[1])) > 1:\n              pos, act = _move_towards(pos, target_loc)\n              actions.append(act)\n              # simulate the move in the local copy of the state\n              state = state.step(act)[1]\n              pos = tuple(state.pos)\n          # Use action to pick up / interact\n          actions.append(USE)\n          state = state.step(USE)[1]\n          pos = tuple(state.pos)\n          # Update grid reference after the interaction\n          grid = state.grid\n\n  # If a workshop is required for crafting, go there and use\n  if workshop_name is not None:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      workshop_loc = _find_any_kind(workshop_idx)\n      if workshop_loc is not None:\n          while max(abs(pos[0] - workshop_loc[0]), abs(pos[1] - workshop_loc[1])) > 1:\n              pos, act = _move_towards(pos, workshop_loc)\n              actions.append(act)\n              state = state.step(act)[1]\n              pos = tuple(state.pos)\n          actions.append(USE)\n          state = state.step(USE)[1]\n\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-10-23T02:41:41.864516", "function_name": "make_arrow", "function_body": "  actions = []\n  state = env._current_state\n  grid = state.grid\n  world = env.world\n  cb = world.cookbook\n\n  # Index of the target item \"stick\"\n  try:\n      goal_idx = cb.index[\"stick\"]\n  except Exception:\n      return actions\n\n  # Primitive requirements for a stick (empty dict if stick is primitive)\n  needed_prims = cb.primitives_for(goal_idx)\n\n  # Current agent position (x, y)\n  pos = list(state.pos)\n\n  # Helper to move using Manhattan steps\n  def _move_to(target):\n      nonlocal pos, actions\n      tx, ty = target\n      while pos[0] < tx:\n          actions.append(3)   # RIGHT\n          pos[0] += 1\n      while pos[0] > tx:\n          actions.append(2)   # LEFT\n          pos[0] -= 1\n      while pos[1] < ty:\n          actions.append(0)   # DOWN\n          pos[1] += 1\n      while pos[1] > ty:\n          actions.append(1)   # UP\n          pos[1] -= 1\n\n  # If stick itself is a primitive, just pick it up.\n  if not needed_prims:\n      locs = np.argwhere(grid[:, :, goal_idx] > 0)\n      if locs.size:\n          _move_to(locs[0].tolist())\n          actions.append(4)   # USE to pick up\n      return actions\n\n  # Collect each required primitive.\n  for prim_idx, count in needed_prims.items():\n      locs = np.argwhere(grid[:, :, prim_idx] > 0)\n      if not locs.size:\n          continue  # primitive not present; should not happen in valid scenarios\n      _move_to(locs[0].tolist())\n      for _ in range(count):\n          actions.append(4)   # USE to pick up one unit\n\n  # Move to workshop (if recipe specifies one) and craft the stick.\n  recipe = cb.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = cb.index[workshop_name]\n      w_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if w_locs.size:\n          _move_to(w_locs[0].tolist())\n          actions.append(4)   # USE to craft at the workshop\n\n  return actions", "env_interactions": 4, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:41:43.154457", "function_name": "make_arrow", "function_body": "  actions = []\n  state = env._current_state\n  grid = state.grid\n  world = env.world\n  cb = world.cookbook\n\n  # index of the target item \"stick\"\n  try:\n      goal_idx = cb.index[\"stick\"]\n  except Exception:\n      return actions\n\n  # primitive requirements for a stick (empty dict if stick is primitive)\n  needed_prims = cb.primitives_for(goal_idx)\n\n  # current agent position (x, y)\n  pos = list(state.pos)\n\n  # helper to move using Manhattan steps\n  def _move_to(target):\n      nonlocal pos, actions\n      tx, ty = target\n      # move in x (horizontal) direction first\n      while pos[0] < tx:\n          actions.append(3)   # RIGHT\n          pos[0] += 1\n      while pos[0] > tx:\n          actions.append(2)   # LEFT\n          pos[0] -= 1\n      # then move in y (vertical) direction\n      while pos[1] < ty:\n          actions.append(0)   # DOWN\n          pos[1] += 1\n      while pos[1] > ty:\n          actions.append(1)   # UP\n          pos[1] -= 1\n\n  # If stick itself is a primitive, just pick it up.\n  if not needed_prims:\n      locs = np.argwhere(grid[:, :, goal_idx] > 0)\n      if locs.size:\n          _move_to(locs[0].tolist())\n          actions.append(4)   # USE to pick up\n      return actions\n\n  # Collect each required primitive the required number of times.\n  for prim_idx, count in needed_prims.items():\n      # find any location that contains this primitive\n      locs = np.argwhere(grid[:, :, prim_idx] > 0)\n      if not locs.size:\n          continue  # primitive not present; should not happen in a valid scenario\n      # move to the first occurrence\n      _move_to(locs[0].tolist())\n      # pick up the required amount\n      for _ in range(count):\n          actions.append(4)   # USE\n\n  # Move to the appropriate workshop (if the recipe specifies one) and craft the stick.\n  recipe = cb.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = cb.index[workshop_name]\n      w_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if w_locs.size:\n          _move_to(w_locs[0].tolist())\n          actions.append(4)   # USE to craft\n\n  return actions", "env_interactions": 4, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:42:02.441121", "function_name": "make_arrow", "function_body": "  # Action indices as defined in CraftLab.action_specs\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions from start to goal using\n      horizontal then vertical moves (ignores obstacles).\"\"\"\n      x, y = start\n      gx, gy = goal\n      actions = []\n      while x < gx:\n          actions.append(ACTION_RIGHT)\n          x += 1\n      while x > gx:\n          actions.append(ACTION_LEFT)\n          x -= 1\n      while y < gy:\n          actions.append(ACTION_DOWN)\n          y += 1\n      while y > gy:\n          actions.append(ACTION_UP)\n          y -= 1\n      return actions\n\n  def nearest_position(positions, reference):\n      \"\"\"Pick the position from *positions* with smallest Manhattan distance\n      to *reference*.\"\"\"\n      if len(positions) == 0:\n          return None\n      ref = np.array(reference)\n      dists = np.sum(np.abs(positions - ref), axis=1)\n      return tuple(positions[np.argmin(dists)])\n\n  # ------------------------------------------------------------------\n  # Gather current state information\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n\n  # ------------------------------------------------------------------\n  # Identify goal (stick)\n  # ------------------------------------------------------------------\n  goal_name = \"stick\"\n  try:\n      goal_idx = env.world.cookbook.index[goal_name]\n  except Exception:\n      return []\n\n  # ------------------------------------------------------------------\n  # 1) Collect needed primitives (if any)\n  # ------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  plan_actions = []\n\n  for prim_idx, needed_cnt in primitives_needed.items():\n      while inventory[prim_idx] < needed_cnt:\n          # locate cells containing the primitive\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # nothing left on map \u2013 abort planning\n              return plan_actions\n          target = nearest_position(prim_cells, pos)\n\n          # move to the primitive\n          plan_actions.extend(manhattan_path(pos, target))\n          pos = target\n\n          # pick it up\n          plan_actions.append(ACTION_USE)\n\n          # simulate pick\u2011up locally for further planning\n          inventory[prim_idx] += 1\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # ------------------------------------------------------------------\n  # 2) Go to workshop (if recipe requires one) and craft stick\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      try:\n          workshop_idx = env.world.cookbook.index[workshop_name]\n      except Exception:\n          return plan_actions\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          # no workshop visible \u2013 cannot craft\n          return plan_actions\n      wcell = tuple(workshop_cells[0])\n\n      # find a free adjacent cell to stand on\n      neighbours = [(wcell[0] + dx, wcell[1] + dy) for dx, dy in\n                    [(1, 0), (-1, 0), (0, 1), (0, -1)]]\n      stand_pos = None\n      for nx, ny in neighbours:\n          if (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and\n                  grid[nx, ny, :].sum() == 0):\n              stand_pos = (nx, ny)\n              break\n      if stand_pos is None:\n          stand_pos = wcell  # fallback: stand on the workshop itself\n\n      # move to the chosen standing position\n      plan_actions.extend(manhattan_path(pos, stand_pos))\n      pos = stand_pos\n\n      # use the workshop to craft the stick\n      plan_actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # Return the full action list\n  # ------------------------------------------------------------------\n  return plan_actions", "env_interactions": 5, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:42:03.752491", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # Action indices (as defined in CraftLab.action_specs)\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions from start to goal using\n      horizontal then vertical moves (ignores obstacles).\"\"\"\n      x, y = start\n      gx, gy = goal\n      actions = []\n      while x < gx:\n          actions.append(ACTION_RIGHT)\n          x += 1\n      while x > gx:\n          actions.append(ACTION_LEFT)\n          x -= 1\n      while y < gy:\n          actions.append(ACTION_DOWN)\n          y += 1\n      while y > gy:\n          actions.append(ACTION_UP)\n          y -= 1\n      return actions\n\n  def nearest_position(positions, reference):\n      \"\"\"Pick the position from *positions* with smallest Manhattan distance\n      to *reference*.\"\"\"\n      if len(positions) == 0:\n          return None\n      ref = np.array(reference)\n      dists = np.sum(np.abs(positions - ref), axis=1)\n      return tuple(positions[np.argmin(dists)])\n\n  # ------------------------------------------------------------------\n  # Gather current state information\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n\n  # ------------------------------------------------------------------\n  # Identify goal (stick)\n  # ------------------------------------------------------------------\n  goal_name = \"stick\"\n  try:\n      goal_idx = env.world.cookbook.index[goal_name]\n  except Exception:\n      return []  # goal not present\n\n  # ------------------------------------------------------------------\n  # 1) Collect needed primitives (if any)\n  # ------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  plan_actions = []\n\n  for prim_idx, needed_cnt in primitives_needed.items():\n      while inventory[prim_idx] < needed_cnt:\n          # locate cells containing the primitive\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # nothing left on map \u2013 abort planning\n              return plan_actions\n          target = nearest_position(prim_cells, pos)\n\n          # move to the primitive\n          plan_actions.extend(manhattan_path(pos, target))\n          pos = target\n\n          # pick it up\n          plan_actions.append(ACTION_USE)\n\n          # simulate pick\u2011up locally for further planning\n          inventory[prim_idx] += 1\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # ------------------------------------------------------------------\n  # 2) Go to workshop (if recipe requires one) and craft stick\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      try:\n          workshop_idx = env.world.cookbook.index[workshop_name]\n      except Exception:\n          return plan_actions\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          # no workshop visible \u2013 cannot craft\n          return plan_actions\n      wcell = tuple(workshop_cells[0])\n\n      # find a free adjacent cell to stand on\n      neighbours = [(wcell[0] + dx, wcell[1] + dy) for dx, dy in\n                    [(1, 0), (-1, 0), (0, 1), (0, -1)]]\n      stand_pos = None\n      for nx, ny in neighbours:\n          if (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and\n                  grid[nx, ny, :].sum() == 0):\n              stand_pos = (nx, ny)\n              break\n      if stand_pos is None:\n          stand_pos = wcell  # fallback: stand on the workshop itself\n\n      # move to the chosen standing position\n      plan_actions.extend(manhattan_path(pos, stand_pos))\n      pos = stand_pos\n\n      # use the workshop to craft the stick\n      plan_actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # Return the full action list\n  # ------------------------------------------------------------------\n  return plan_actions", "env_interactions": 5, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:42:31.352207", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n\n  # action indices\n  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (act[\"DOWN\"], act[\"UP\"],\n                               act[\"LEFT\"], act[\"RIGHT\"], act[\"USE\"])\n\n  # index of the goal item \"stick\"\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # ------------------------------------------------------------------\n  # Helper: BFS to compute actions from a start cell to a target cell.\n  # ------------------------------------------------------------------\n  W, H, _ = state.grid.shape\n  blocked = np.any(state.grid > 0, axis=2)          # any entity blocks movement\n\n  def bfs(start_pos, target_pos):\n      \"\"\"Return list of actions to move from start_pos to target_pos.\n      Returns None if target is unreachable.\"\"\"\n      from collections import deque\n      q = deque([start_pos])\n      visited = np.full((W, H), False, dtype=bool)\n      visited[start_pos[0], start_pos[1]] = True\n      prev = np.empty((W, H, 2), dtype=int)        # store predecessor\n\n      while q:\n          x, y = q.popleft()\n          if (x, y) == target_pos:\n              # reconstruct path\n              actions = []\n              cx, cy = x, y\n              while (cx, cy) != start_pos:\n                  px, py = prev[cx, cy]\n                  dx, dy = cx - px, cy - py\n                  if dx == 1:\n                      actions.append(DOWN)\n                  elif dx == -1:\n                      actions.append(UP)\n                  elif dy == 1:\n                      actions.append(RIGHT)\n                  elif dy == -1:\n                      actions.append(LEFT)\n                  cx, cy = px, py\n              actions.reverse()\n              return actions\n\n          # explore 4 neighbours\n          for nx, ny, a in [(x + 1, y, DOWN), (x - 1, y, UP),\n                            (x, y + 1, RIGHT), (x, y - 1, LEFT)]:\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  # we may step onto the target even if it is blocked\n                  if (nx, ny) == target_pos or not blocked[nx, ny]:\n                      visited[nx, ny] = True\n                      prev[nx, ny] = (x, y)\n                      q.append((nx, ny))\n      return None\n\n  # ------------------------------------------------------------------\n  # Determine if stick needs crafting or is a primitive.\n  # ------------------------------------------------------------------\n  primitives_needed = world.cookbook.primitives_for(stick_idx)   # dict {kind_idx: count}\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  if not primitives_needed:\n      # Stick is a primitive \u2013 just pick one up.\n      stick_cells = np.argwhere(state.grid[:, :, stick_idx] > 0)\n      if stick_cells.size == 0:\n          return []                     # no stick present in the world\n      # pick the closest reachable stick\n      best_path = None\n      for cell in stick_cells:\n          path = bfs(cur_pos, tuple(cell))\n          if path is not None and (best_path is None or len(path) < len(best_path)):\n              best_path = path\n      if best_path is None:\n          return []                     # unreachable\n      actions.extend(best_path)\n      actions.append(USE)                # collect the stick\n      return actions\n\n  # ------------------------------------------------------------------\n  # Stick must be crafted: collect required primitives first.\n  # ------------------------------------------------------------------\n  for kind_idx, needed_cnt in primitives_needed.items():\n      # locate cells containing this kind\n      cells = np.argwhere(state.grid[:, :, kind_idx] > 0)\n      if cells.shape[0] == 0:\n          return []                     # missing ingredient\n      # collect as many as required (may be multiple)\n      collected = 0\n      while collected < needed_cnt:\n          # find nearest reachable cell among remaining ones\n          best_path = None\n          best_cell = None\n          for cell in cells:\n              if state.grid[cell[0], cell[1], kind_idx] == 0:\n                  continue                # already taken in previous loop\n              path = bfs(cur_pos, tuple(cell))\n              if path is not None and (best_path is None or len(path) < len(best_path)):\n                  best_path = path\n                  best_cell = tuple(cell)\n          if best_path is None:\n              return []                 # cannot reach remaining ingredient\n          # move to ingredient and pick it up\n          actions.extend(best_path)\n          actions.append(USE)\n          cur_pos = best_cell\n          collected += 1\n          # mark as taken in our mental copy (so future loops ignore)\n          # we simply clear it in a temporary copy of the grid\n          state.grid[cur_pos[0], cur_pos[1], kind_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Go to the appropriate workshop and craft the stick.\n  # ------------------------------------------------------------------\n  # workshop name is stored under key \"_at\" in the recipe dict\n  workshop_name = world.cookbook.recipes[stick_idx].get(\"_at\")\n  if workshop_name is None:\n      return []                         # cannot determine workshop\n  workshop_idx = world.cookbook.index[workshop_name]\n\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      return []                         # no workshop present\n\n  # find nearest reachable workshop\n  best_path = None\n  best_cell = None\n  for cell in workshop_cells:\n      path = bfs(cur_pos, tuple(cell))\n      if path is not None and (best_path is None or len(path) < len(best_path)):\n          best_path = path\n          best_cell = tuple(cell)\n  if best_path is None:\n      return []                         # unreachable workshop\n\n  actions.extend(best_path)\n  actions.append(USE)                    # craft the stick\n  return actions", "env_interactions": 4, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:42:32.665354", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n\n  # action ids\n  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act[\"DOWN\"], act[\"UP\"], act[\"LEFT\"], act[\"RIGHT\"], act[\"USE\"]\n  )\n\n  # indices\n  stick_idx = world.cookbook.index[\"stick\"]\n  recipe = world.cookbook.recipes.get(stick_idx, None)\n\n  # grid helpers\n  W, H, _ = state.grid.shape\n  blocked = np.any(state.grid > 0, axis=2)          # any entity blocks movement\n  start = tuple(state.pos)\n\n  # ------------------------------------------------------------------ #\n  # BFS that returns a list of actions to move from `src` to `dst`.\n  # It may step onto `dst` even if that cell is blocked (e.g. contains the\n  # target item).\n  # ------------------------------------------------------------------ #\n  from collections import deque\n\n  def bfs(src, dst, allow_dst_blocked=False):\n      q = deque([src])\n      visited = np.full((W, H), False, dtype=bool)\n      visited[src[0], src[1]] = True\n      prev = np.empty((W, H, 2), dtype=int)\n\n      while q:\n          x, y = q.popleft()\n          if (x, y) == dst:\n              # reconstruct actions\n              actions = []\n              cx, cy = x, y\n              while (cx, cy) != src:\n                  px, py = prev[cx, cy]\n                  dx, dy = cx - px, cy - py\n                  if dx == 1:\n                      actions.append(DOWN)\n                  elif dx == -1:\n                      actions.append(UP)\n                  elif dy == 1:\n                      actions.append(RIGHT)\n                  elif dy == -1:\n                      actions.append(LEFT)\n                  cx, cy = px, py\n              actions.reverse()\n              return actions\n\n          for nx, ny, a in [(x + 1, y, DOWN), (x - 1, y, UP),\n                            (x, y + 1, RIGHT), (x, y - 1, LEFT)]:\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  # allow stepping on the destination even if blocked\n                  if (nx, ny) == dst and allow_dst_blocked:\n                      visited[nx, ny] = True\n                      prev[nx, ny] = (x, y)\n                      q.append((nx, ny))\n                  elif not blocked[nx, ny]:\n                      visited[nx, ny] = True\n                      prev[nx, ny] = (x, y)\n                      q.append((nx, ny))\n      return None\n  # ------------------------------------------------------------------ #\n\n  actions_plan = []\n\n  # ------------------------------------------------------------------ #\n  # Helper: collect a primitive kind until we have the required count.\n  # ------------------------------------------------------------------ #\n  def collect_primitive(kind_idx, needed):\n      nonlocal actions_plan, start\n      while needed > 0:\n          cells = np.argwhere(state.grid[:, :, kind_idx] > 0)\n          if cells.size == 0:\n              # nothing left on the map \u2013 give up\n              return False\n          best_path = None\n          best_cell = None\n          for cell in cells:\n              cell = tuple(cell)\n              path = bfs(start, cell, allow_dst_blocked=True)\n              if path is not None and (best_path is None or len(path) < len(best_path)):\n                  best_path = path\n                  best_cell = cell\n          if best_path is None:\n              return False  # unreachable\n          # move to the cell\n          actions_plan.extend(best_path)\n          start = best_cell\n          # pick up\n          actions_plan.append(USE)\n          # simulate the pickup locally to keep `state` consistent for next loop\n          # (the real env will execute these actions later)\n          state.grid[best_cell[0], best_cell[1], kind_idx] -= 1\n          state.inventory[kind_idx] += 1\n          needed -= 1\n      return True\n  # ------------------------------------------------------------------ #\n\n  if recipe is None:\n      # stick is a primitive \u2013 just grab any stick on the map\n      cells = np.argwhere(state.grid[:, :, stick_idx] > 0)\n      if cells.size == 0:\n          return []  # nothing to do\n      # find closest stick\n      best_path = None\n      best_cell = None\n      for cell in cells:\n          cell = tuple(cell)\n          path = bfs(start, cell, allow_dst_blocked=True)\n          if path is not None and (best_path is None or len(path) < len(best_path)):\n              best_path = path\n              best_cell = cell\n      if best_path is None:\n          return []\n      actions_plan.extend(best_path)\n      actions_plan.append(USE)\n      return actions_plan\n\n  # ------------------------------------------------------------------ #\n  # 1) Gather required primitives\n  # ------------------------------------------------------------------ #\n  for ing_kind, cnt in recipe.items():\n      if ing_kind == \"_at\":\n          continue\n      if not collect_primitive(ing_kind, cnt):\n          return []   # failed to gather\n\n  # ------------------------------------------------------------------ #\n  # 2) Go to the workshop indicated by the recipe and craft the stick\n  # ------------------------------------------------------------------ #\n  workshop_idx = recipe.get(\"_at\", None)\n  if workshop_idx is not None:\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          return []  # no workshop found\n      best_path = None\n      best_cell = None\n      for cell in workshop_cells:\n          cell = tuple(cell)\n          path = bfs(start, cell, allow_dst_blocked=False)\n          if path is not None and (best_path is None or len(path) < len(best_path)):\n              best_path = path\n              best_cell = cell\n      if best_path is None:\n          return []  # unreachable workshop\n      actions_plan.extend(best_path)\n      start = best_cell\n      actions_plan.append(USE)   # craft at workshop\n  else:\n      # no explicit workshop \u2013 just use at current location\n      actions_plan.append(USE)\n\n  return actions_plan", "env_interactions": 0, "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-10-23T02:42:49.940619", "function_name": "make_arrow", "function_body": "  # Reset environment to start a fresh episode\n  env.reset()\n  state = env._current_state\n  goal_idx = env.task.goal\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # -----------------------------------------------------------------\n  # Helper functions\n  # -----------------------------------------------------------------\n  def find_positions(kind):\n      \"\"\"Return list of (x, y) positions where `kind` is present.\"\"\"\n      locs = np.argwhere(state.grid[:, :, kind] > 0)\n      return [tuple(p) for p in locs]\n\n  def nearest(pos, kind):\n      \"\"\"Find Manhattan\u2011closest cell containing `kind`.\"\"\"\n      positions = find_positions(kind)\n      if not positions:\n          return None\n      return min(positions,\n                 key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n\n  def moves_to(src, dst):\n      \"\"\"Generate a Manhattan path from src to dst as action indices.\n      Action mapping: DOWN=0, UP=1, LEFT=2, RIGHT=3.\n      \"\"\"\n      sx, sy = src\n      dx, dy = dst\n      seq = []\n      while sx < dx:\n          seq.append(0)   # DOWN\n          sx += 1\n      while sx > dx:\n          seq.append(1)   # UP\n          sx -= 1\n      while sy < dy:\n          seq.append(3)   # RIGHT\n          sy += 1\n      while sy > dy:\n          seq.append(2)   # LEFT\n          sy -= 1\n      return seq\n\n  # -----------------------------------------------------------------\n  # 1) If the goal is a primitive (no recipe), just go pick it up.\n  # -----------------------------------------------------------------\n  if not env.world.cookbook.primitives_for(goal_idx):\n      target = nearest(cur_pos, goal_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)   # USE\n      return actions\n\n  # -----------------------------------------------------------------\n  # 2) Collect required primitive ingredients.\n  # -----------------------------------------------------------------\n  needed_prims = env.world.cookbook.primitives_for(goal_idx)\n  for prim_idx, count in needed_prims.items():\n      for _ in range(count):\n          target = nearest(cur_pos, prim_idx)\n          if target is None:\n              # Primitive not found; skip (cannot craft)\n              continue\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n          actions.append(4)   # pick up primitive\n\n  # -----------------------------------------------------------------\n  # 3) Move to workshop (if any) and craft the item.\n  # -----------------------------------------------------------------\n  workshop_idx = None\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  for key, val in recipe.items():\n      if isinstance(key, str) and key == \"_at\":\n          workshop_idx = val\n          break\n\n  if workshop_idx is not None:\n      target = nearest(cur_pos, workshop_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)   # USE to craft at the workshop\n\n  return actions", "env_interactions": 1, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:42:51.297764", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  goal_idx = env.task.goal\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # Helper to locate all cells containing a specific kind.\n  def find_positions(kind):\n      locs = np.argwhere(state.grid[:, :, kind] > 0)\n      return [tuple(p) for p in locs]\n\n  # Helper to pick the Manhattan\u2011closest position of a given kind.\n  def nearest(pos, kind):\n      positions = find_positions(kind)\n      if not positions:\n          return None\n      return min(positions, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n\n  # Helper to generate a simple Manhattan path as action indices.\n  # Action mapping: DOWN=0, UP=1, LEFT=2, RIGHT=3.\n  def moves_to(src, dst):\n      sx, sy = src\n      dx, dy = dst\n      seq = []\n      while sx < dx:\n          seq.append(0)   # DOWN\n          sx += 1\n      while sx > dx:\n          seq.append(1)   # UP\n          sx -= 1\n      while sy < dy:\n          seq.append(3)   # RIGHT\n          sy += 1\n      while sy > dy:\n          seq.append(2)   # LEFT\n          sy -= 1\n      return seq\n\n  # -------------------------------------------------------------\n  # 1) If the goal is a primitive (no recipe), just go to the nearest\n  #    instance and pick it up with USE (action 4).\n  # -------------------------------------------------------------\n  if not env.world.cookbook.primitives_for(goal_idx):\n      target = nearest(cur_pos, goal_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)   # USE\n      return actions\n\n  # -------------------------------------------------------------\n  # 2) Gather all required primitive ingredients for the goal.\n  # -------------------------------------------------------------\n  needed_prims = env.world.cookbook.primitives_for(goal_idx)\n  for prim_idx, count in needed_prims.items():\n      for _ in range(count):\n          target = nearest(cur_pos, prim_idx)\n          if target is None:\n              continue  # primitive not present; skip\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n          actions.append(4)   # pick up primitive\n\n  # -------------------------------------------------------------\n  # 3) Move to the appropriate workshop (if any) and craft the item.\n  # -------------------------------------------------------------\n  workshop_idx = None\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  for key, val in recipe.items():\n      if isinstance(key, str):\n          workshop_idx = val\n          break\n\n  if workshop_idx is not None:\n      target = nearest(cur_pos, workshop_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)   # USE to craft at the workshop\n\n  return actions", "env_interactions": 1, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:43:15.318545", "function_name": "make_arrow", "function_body": "  # Get current state (reset if needed)\n  try:\n      state = env._current_state\n  except AttributeError:\n      env.reset()\n      state = env._current_state\n\n  # Action indices (fallback defaults if spec missing)\n  try:\n      specs = env.action_specs()\n      DOWN = specs.get(\"DOWN\", 0)\n      UP = specs.get(\"UP\", 1)\n      LEFT = specs.get(\"LEFT\", 2)\n      RIGHT = specs.get(\"RIGHT\", 3)\n      USE = specs.get(\"USE\", 4)\n  except Exception:\n      DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Index for the target item \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      return []  # cannot locate stick in index\n\n  # Primitives required to craft a stick (empty if stick is primitive)\n  needed = env.world.cookbook.primitives_for(stick_idx)\n\n  # Helper: locate all cells containing a given kind\n  def locate(kind_idx):\n      xs, ys = np.where(state.grid[:, :, kind_idx] > 0)\n      return list(zip(xs.tolist(), ys.tolist()))\n\n  # Helper: simple Manhattan movement plan (ignores obstacles)\n  def manhattan_plan(start, target):\n      actions = []\n      x, y = start\n      tx, ty = target\n      while x < tx:\n          actions.append(DOWN); x += 1\n      while x > tx:\n          actions.append(UP);   x -= 1\n      while y < ty:\n          actions.append(RIGHT); y += 1\n      while y > ty:\n          actions.append(LEFT);  y -= 1\n      return actions, (x, y)\n\n  actions_plan = []\n  cur_pos = state.pos\n\n  # ------------------------------------------------------------------\n  # Case 1: stick itself is a primitive (no recipe)\n  # ------------------------------------------------------------------\n  if not needed:\n      stick_locs = locate(stick_idx)\n      if not stick_locs:\n          return []  # nothing to pick up\n      # Choose nearest location\n      dists = [abs(px - cur_pos[0]) + abs(py - cur_pos[1]) for (px, py) in stick_locs]\n      target = stick_locs[int(np.argmin(dists))]\n      # Move to an adjacent cell (prefer the cell above the target if possible)\n      adj = (target[0] - 1, target[1]) if target[0] > 0 else target\n      move_actions, cur_pos = manhattan_plan(cur_pos, adj)\n      actions_plan.extend(move_actions)\n      actions_plan.append(USE)\n      return actions_plan\n\n  # ------------------------------------------------------------------\n  # Case 2: need to collect primitives and then craft at a workshop\n  # ------------------------------------------------------------------\n  for prim_idx, req_cnt in needed.items():\n      # Collect until we have enough of this primitive\n      while state.inventory[prim_idx] < req_cnt:\n          prim_positions = locate(prim_idx)\n          if not prim_positions:\n              return actions_plan  # cannot satisfy requirement\n          # Nearest primitive\n          dists = [abs(px - cur_pos[0]) + abs(py - cur_pos[1]) for (px, py) in prim_positions]\n          target = prim_positions[int(np.argmin(dists))]\n          # Move adjacent (prefer cell above if possible)\n          adj = (target[0] - 1, target[1]) if target[0] > 0 else target\n          move_actions, cur_pos = manhattan_plan(cur_pos, adj)\n          actions_plan.extend(move_actions)\n          actions_plan.append(USE)\n          # Simulate pickup for planning continuity\n          if state.grid[target[0], target[1], prim_idx] > 0:\n              state.grid[target[0], target[1], prim_idx] -= 1\n              state.inventory[prim_idx] += 1\n\n  # Move to a workshop (any workshop cell) to craft the stick\n  workshop_cells = []\n  for w_idx in env.world.workshop_indices:\n      xs, ys = np.where(state.grid[:, :, w_idx] > 0)\n      workshop_cells.extend(zip(xs.tolist(), ys.tolist()))\n  if workshop_cells:\n      dists = [abs(px - cur_pos[0]) + abs(py - cur_pos[1]) for (px, py) in workshop_cells]\n      ws_target = workshop_cells[int(np.argmin(dists))]\n      move_actions, cur_pos = manhattan_plan(cur_pos, ws_target)\n      actions_plan.extend(move_actions)\n\n  # Craft the stick\n  actions_plan.append(USE)\n\n  return actions_plan", "env_interactions": 6, "island_id": 3, "scores": {"3": 0.0}}
