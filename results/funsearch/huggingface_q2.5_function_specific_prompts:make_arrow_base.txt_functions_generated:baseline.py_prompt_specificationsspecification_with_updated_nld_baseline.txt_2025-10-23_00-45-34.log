{"timestamp": "2025-10-23T04:27:45.036533", "function_name": "make_arrow", "function_body": "  # ------------------------------------------------------------\n  # make_stick_vn: collect a single stick primitive\n  # ------------------------------------------------------------\n  state = env._current_state\n  world = env.world\n\n  # action identifiers\n  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act[\"DOWN\"], act[\"UP\"], act[\"LEFT\"], act[\"RIGHT\"], act[\"USE\"]\n  )\n\n  # index of the primitive \"stick\"\n  stick_idx = world.cookbook.index.get(\"stick\")\n  if stick_idx is None:\n      return []                     # stick not defined in this world\n\n  # locate all cells containing a stick\n  stick_cells = np.argwhere(state.grid[:, :, stick_idx] > 0)\n  if stick_cells.size == 0:\n      return []                     # no sticks present\n\n  # grid dimensions\n  width, height = state.grid.shape[:2]\n\n  # set of entity indices that block movement\n  non_grabbable = world.non_grabbable_indices\n\n  # helper: can the agent stand on (x, y)?\n  def traversable(pos):\n      x, y = pos\n      if not (0 <= x < width and 0 <= y < height):\n          return False\n      for idx in non_grabbable:\n          if state.grid[x, y, idx] > 0:\n              return False\n      return True\n\n  start = tuple(state.pos)\n  target_set = {tuple(cell) for cell in stick_cells}\n  queue = collections.deque([start])\n  visited = {start: None}          # maps position -> (prev_pos, action_to_here)\n\n  goal = None\n  while queue:\n      cur = queue.popleft()\n      if cur in target_set:\n          goal = cur\n          break\n      x, y = cur\n      for nx, ny, a_code in [(x + 1, y, DOWN), (x - 1, y, UP),\n                             (x, y + 1, RIGHT), (x, y - 1, LEFT)]:\n          nxt = (nx, ny)\n          if nxt not in visited and traversable(nxt):\n              visited[nxt] = (cur, a_code)\n              queue.append(nxt)\n\n  if goal is None:\n      return []                     # no reachable stick\n\n  # reconstruct path from start to goal\n  actions = []\n  cur = goal\n  while visited[cur] is not None:\n      prev, a_code = visited[cur]\n      actions.append(a_code)\n      cur = prev\n  actions.reverse()\n\n  # pick up the stick\n  actions.append(USE)\n  return actions", "env_interactions": 0, "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-10-23T04:27:46.293745", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n\n  # action identifiers\n  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act[\"DOWN\"], act[\"UP\"], act[\"LEFT\"], act[\"RIGHT\"], act[\"USE\"]\n  )\n\n  # index for primitive stick\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # locate all stick cells\n  stick_cells = np.argwhere(state.grid[:, :, stick_idx] > 0)\n  if stick_cells.size == 0:\n      return []  # no sticks present\n\n  # grid dimensions\n  W, H, _ = state.grid.shape\n\n  # cells that are blocked (any entity present)\n  blocked = np.any(state.grid > 0, axis=2)\n\n  start = tuple(state.pos)\n\n  from collections import deque\n\n  def bfs(target):\n      \"\"\"Return list of actions to reach *target* (row, col) or None.\"\"\"\n      q = deque([start])\n      visited = np.full((W, H), False, dtype=bool)\n      visited[start[0], start[1]] = True\n      # predecessor for path reconstruction: store previous coordinates\n      prev = np.empty((W, H, 2), dtype=int)\n\n      while q:\n          x, y = q.popleft()\n          if (x, y) == tuple(target):\n              # reconstruct path\n              actions = []\n              cx, cy = x, y\n              while (cx, cy) != start:\n                  px, py = prev[cx, cy]\n                  dx, dy = cx - px, cy - py\n                  if dx == 1:\n                      actions.append(DOWN)\n                  elif dx == -1:\n                      actions.append(UP)\n                  elif dy == 1:\n                      actions.append(RIGHT)\n                  elif dy == -1:\n                      actions.append(LEFT)\n                  cx, cy = px, py\n              actions.reverse()\n              return actions\n\n          # explore neighbours\n          for nx, ny, a in [(x + 1, y, DOWN), (x - 1, y, UP),\n                            (x, y + 1, RIGHT), (x, y - 1, LEFT)]:\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  # allow stepping onto the target even if blocked (it contains the stick)\n                  if (nx, ny) == tuple(target) or not blocked[nx, ny]:\n                      visited[nx, ny] = True\n                      prev[nx, ny] = (x, y)\n                      q.append((nx, ny))\n      return None\n\n  # find the shortest reachable stick\n  best_path = None\n  for cell in stick_cells:\n      path = bfs(cell)\n      if path is not None and (best_path is None or len(path) < len(best_path)):\n          best_path = path\n\n  if best_path is None:\n      return []  # no reachable stick\n\n  # pick up the stick\n  best_path.append(USE)\n  return best_path", "env_interactions": 0, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:28:12.496403", "function_name": "make_arrow", "function_body": "  # Reset the environment and get initial state\n  env.reset()\n  state = env._current_state\n  grid = state.grid\n  width, height = grid.shape[:2]\n\n  # Direction vectors and mapping to action indices (DOWN=0, UP=1, LEFT=2, RIGHT=3)\n  dirs = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n  dir_action = {(0, 1): 0, (0, -1): 1, (-1, 0): 2, (1, 0): 3}\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def find_cells(kind):\n      \"\"\"Return a list of (x, y) positions where `kind` is present.\"\"\"\n      xs, ys = np.where(grid[:, :, kind] > 0)\n      return list(zip(xs.tolist(), ys.tolist()))\n\n  from collections import deque\n\n  def bfs(start, goal):\n      \"\"\"Bread\u2011first search on free cells, returning a list of (dx, dy) moves.\"\"\"\n      if start == goal:\n          return []\n      q = deque([start])\n      visited = {start}\n      prev = {}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          x, y = cur\n          for dx, dy in dirs:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height:\n                  if (nx, ny) not in visited and not grid[nx, ny].any():\n                      visited.add((nx, ny))\n                      prev[(nx, ny)] = (cur, (dx, dy))\n                      q.append((nx, ny))\n      if goal not in prev:\n          return []  # no path found\n      # reconstruct moves\n      path = []\n      cur = goal\n      while cur != start:\n          pnode, move = prev[cur]\n          path.append(move)\n          cur = pnode\n      path.reverse()\n      return path\n\n  # ------------------------------------------------------------------\n  # Identify stick recipe\n  # ------------------------------------------------------------------\n  stick_idx = env.world.cookbook.index[\"stick\"]\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  primitive_needs = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  # If stick itself is a primitive (no recipe), treat it as a needed primitive\n  if not primitive_needs and stick_idx in env.world.cookbook.primitives:\n      primitive_needs = {stick_idx: 1}\n\n  # ------------------------------------------------------------------\n  # Collect required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          prim_cells = find_cells(prim_idx)\n          if not prim_cells:\n              continue  # primitive not present in this scenario\n          tx, ty = prim_cells[0]\n\n          # Try to stand on a free neighbour opposite the direction we will face\n          positioned = False\n          for dx, dy in dirs:\n              nx, ny = tx - dx, ty - dy  # cell opposite the facing direction\n              if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  # Face the primitive\n                  actions.append(dir_action[(-dx, -dy)])\n                  state.dir = dir_action[(-dx, -dy)]\n                  # Pick up\n                  actions.append(4)  # USE\n                  positioned = True\n                  break\n\n          if not positioned:\n              # Fallback: any adjacent free cell then turn towards primitive\n              for dx, dy in dirs:\n                  nx, ny = tx + dx, ty + dy\n                  if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                      path = bfs(state.pos, (nx, ny))\n                      for mv in path:\n                          actions.append(dir_action[mv])\n                          state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                          state.dir = dir_action[mv]\n                      actions.append(dir_action[(-dx, -dy)])\n                      state.dir = dir_action[(-dx, -dy)]\n                      actions.append(4)  # USE\n                      positioned = True\n                      break\n\n          # Update local grid view after the pickup\n          grid = state.grid\n\n  # ------------------------------------------------------------------\n  # If a workshop is required, move there and craft the stick\n  # ------------------------------------------------------------------\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      workshop_cells = find_cells(workshop_idx)\n      if workshop_cells:\n          wx, wy = workshop_cells[0]\n          for dx, dy in dirs:\n              nx, ny = wx - dx, wy - dy\n              if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  # Craft at workshop\n                  actions.append(4)  # USE\n                  break\n\n  return actions", "env_interactions": 8, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-23T04:28:13.768121", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  grid = state.grid\n  width, height = grid.shape[:2]\n\n  # movement vectors and mapping to action IDs (DOWN=0, UP=1, LEFT=2, RIGHT=3)\n  dirs = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n  dir_action = {(0, 1): 0, (0, -1): 1, (-1, 0): 2, (1, 0): 3}\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def find_cells(kind):\n      \"\"\"Return list of (x, y) positions where `kind` is present.\"\"\"\n      xs, ys = np.where(grid[:, :, kind] > 0)\n      return list(zip(xs.tolist(), ys.tolist()))\n\n  from collections import deque\n\n  def bfs(start, goal):\n      \"\"\"Bread\u2011first search on free cells, returning a list of (dx, dy) moves.\"\"\"\n      if start == goal:\n          return []\n      q = deque([start])\n      visited = {start}\n      prev = {}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          x, y = cur\n          for dx, dy in dirs:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height:\n                  if (nx, ny) not in visited and not grid[nx, ny].any():\n                      visited.add((nx, ny))\n                      prev[(nx, ny)] = (cur, (dx, dy))\n                      q.append((nx, ny))\n      if goal not in prev:\n          return []  # no path found\n      # reconstruct moves\n      path = []\n      cur = goal\n      while cur != start:\n          pnode, move = prev[cur]\n          path.append(move)\n          cur = pnode\n      path.reverse()\n      return path\n\n  # ------------------------------------------------------------------\n  # Identify the recipe for a stick\n  # ------------------------------------------------------------------\n  stick_idx = env.world.cookbook.index[\"stick\"]\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  primitive_needs = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  # If stick itself is a primitive (no recipe), treat it as a needed primitive\n  if not primitive_needs and stick_idx in env.world.cookbook.primitives:\n      primitive_needs = {stick_idx: 1}\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the needed number of times\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          prim_cells = find_cells(prim_idx)\n          if not prim_cells:\n              continue  # primitive not present; skip\n          tx, ty = prim_cells[0]\n\n          # Try to stand on a free neighbour opposite the direction we will face\n          positioned = False\n          for dx, dy in dirs:\n              nx, ny = tx - dx, ty - dy  # cell opposite the facing direction\n              if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  # Face the primitive\n                  actions.append(dir_action[(-dx, -dy)])\n                  state.dir = dir_action[(-dx, -dy)]\n                  # Pick up\n                  actions.append(4)  # USE\n                  positioned = True\n                  break\n\n          if not positioned:\n              # Fallback: any adjacent free cell then turn towards primitive\n              for dx, dy in dirs:\n                  nx, ny = tx + dx, ty + dy\n                  if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                      path = bfs(state.pos, (nx, ny))\n                      for mv in path:\n                          actions.append(dir_action[mv])\n                          state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                          state.dir = dir_action[mv]\n                      actions.append(dir_action[(-dx, -dy)])\n                      state.dir = dir_action[(-dx, -dy)]\n                      actions.append(4)  # USE\n                      positioned = True\n                      break\n\n          # Update local grid reference after pickup (grid may have changed)\n          grid = state.grid\n\n  # ------------------------------------------------------------------\n  # If a workshop is required, move there and craft the stick\n  # ------------------------------------------------------------------\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      workshop_cells = find_cells(workshop_idx)\n      if workshop_cells:\n          wx, wy = workshop_cells[0]\n          for dx, dy in dirs:\n              nx, ny = wx - dx, wy - dy\n              if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  # Craft at workshop\n                  actions.append(4)  # USE\n                  break\n\n  return actions", "env_interactions": 8, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-23T04:28:38.010236", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # reset environment and obtain initial state/grid\n  env.reset()\n  state = env._current_state\n  grid = state.grid\n  width, height = grid.shape[:2]\n\n  # action mapping (DOWN,UP,LEFT,RIGHT,USE)\n  dirs = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n  dir_action = {(0, 1): 0, (0, -1): 1, (-1, 0): 2, (1, 0): 3}\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # helper utilities\n  # ------------------------------------------------------------------\n  def find_cells(kind):\n      \"\"\"Return list of (x, y) positions where `kind` is present.\"\"\"\n      xs, ys = np.where(grid[:, :, kind] > 0)\n      return list(zip(xs.tolist(), ys.tolist()))\n\n  def bfs(start, goal):\n      \"\"\"Shortest path (as list of (dx,dy) moves) from start to goal avoiding occupied cells.\"\"\"\n      if start == goal:\n          return []\n      q = deque([start])\n      visited = {start}\n      prev = {}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          x, y = cur\n          for dx, dy in dirs:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height:\n                  if (nx, ny) not in visited and not grid[nx, ny].any():\n                      visited.add((nx, ny))\n                      prev[(nx, ny)] = (cur, (dx, dy))\n                      q.append((nx, ny))\n      if goal not in prev:\n          return []  # no path found\n      # reconstruct moves\n      path = []\n      cur = goal\n      while cur != start:\n          pnode, move = prev[cur]\n          path.append(move)\n          cur = pnode\n      path.reverse()\n      return path\n\n  # ------------------------------------------------------------------\n  # identify stick recipe\n  # ------------------------------------------------------------------\n  stick_idx = env.world.cookbook.index[\"stick\"]\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  primitive_needs = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  # ------------------------------------------------------------------\n  # collect all required primitive items\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          prim_cells = find_cells(prim_idx)\n          if not prim_cells:\n              continue  # primitive not on map\n          tx, ty = prim_cells[0]\n\n          # try to stand on a free neighbour opposite the direction we will face\n          neighbour_found = False\n          for dx, dy in dirs:\n              nx, ny = tx - dx, ty - dy\n              if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  # face the primitive and use\n                  actions.append(dir_action[(-dx, -dy)])\n                  state.dir = dir_action[(-dx, -dy)]\n                  actions.append(4)  # USE\n                  neighbour_found = True\n                  break\n          if not neighbour_found:\n              # fallback: any adjacent free cell then turn towards primitive\n              for dx, dy in dirs:\n                  nx, ny = tx + dx, ty + dy\n                  if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                      path = bfs(state.pos, (nx, ny))\n                      for mv in path:\n                          actions.append(dir_action[mv])\n                          state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                          state.dir = dir_action[mv]\n                      actions.append(dir_action[(-dx, -dy)])\n                      state.dir = dir_action[(-dx, -dy)]\n                      actions.append(4)  # USE\n                      break\n\n  # ------------------------------------------------------------------\n  # if stick itself has no recipe (i.e., it is a primitive), just collect it\n  # ------------------------------------------------------------------\n  if not primitive_needs:\n      stick_cells = find_cells(stick_idx)\n      if stick_cells:\n          tx, ty = stick_cells[0]\n          neighbour_found = False\n          for dx, dy in dirs:\n              nx, ny = tx - dx, ty - dy\n              if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  actions.append(dir_action[(-dx, -dy)])\n                  state.dir = dir_action[(-dx, -dy)]\n                  actions.append(4)  # USE\n                  neighbour_found = True\n                  break\n          if not neighbour_found:\n              for dx, dy in dirs:\n                  nx, ny = tx + dx, ty + dy\n                  if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                      path = bfs(state.pos, (nx, ny))\n                      for mv in path:\n                          actions.append(dir_action[mv])\n                          state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                          state.dir = dir_action[mv]\n                      actions.append(dir_action[(-dx, -dy)])\n                      state.dir = dir_action[(-dx, -dy)]\n                      actions.append(4)\n                      break\n\n  # ------------------------------------------------------------------\n  # if a workshop is required, move next to it and craft the stick\n  # ------------------------------------------------------------------\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      workshop_cells = find_cells(workshop_idx)\n      if workshop_cells:\n          wx, wy = workshop_cells[0]\n          for dx, dy in dirs:\n              nx, ny = wx - dx, wy - dy\n              if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  actions.append(4)  # USE to craft\n                  break\n\n  return actions", "env_interactions": 8, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-23T04:28:39.264253", "function_name": "make_arrow", "function_body": "  # Reset environment and get current state\n  env.reset()\n  state = env._current_state\n  grid = state.grid\n  width, height = grid.shape[:2]\n\n  # Direction vectors and mapping to action indices (DOWN=0, UP=1, LEFT=2, RIGHT=3)\n  dirs = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n  dir_action = {(0, 1): 0, (0, -1): 1, (-1, 0): 2, (1, 0): 3}\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def find_cells(kind):\n      \"\"\"Return list of (x, y) positions where the grid contains the given kind.\"\"\"\n      xs, ys = np.where(grid[:, :, kind] > 0)\n      return list(zip(xs.tolist(), ys.tolist()))\n\n  from collections import deque\n\n  def bfs(start, goal):\n      \"\"\"Return list of (dx, dy) moves from start to goal on free cells.\"\"\"\n      if start == goal:\n          return []\n      q = deque([start])\n      visited = {start}\n      prev = {}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          x, y = cur\n          for dx, dy in dirs:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height:\n                  if (nx, ny) not in visited and not grid[nx, ny].any():\n                      visited.add((nx, ny))\n                      prev[(nx, ny)] = (cur, (dx, dy))\n                      q.append((nx, ny))\n      if goal not in prev:\n          return []  # no path found\n      # reconstruct path\n      path = []\n      cur = goal\n      while cur != start:\n          pnode, move = prev[cur]\n          path.append(move)\n          cur = pnode\n      path.reverse()\n      return path\n\n  # ------------------------------------------------------------------\n  # Identify the stick recipe\n  # ------------------------------------------------------------------\n  stick_idx = env.world.cookbook.index[\"stick\"]\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  primitive_needs = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  # ------------------------------------------------------------------\n  # Collect required primitives (if any)\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          prim_cells = find_cells(prim_idx)\n          if not prim_cells:\n              continue\n          tx, ty = prim_cells[0]\n\n          # Try to stand on a free neighbour opposite the direction we will face\n          neighbour_found = False\n          for dx, dy in dirs:\n              nx, ny = tx - dx, ty - dy\n              if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  # Face the primitive and pick it up\n                  actions.append(dir_action[(-dx, -dy)])\n                  state.dir = dir_action[(-dx, -dy)]\n                  actions.append(4)  # USE\n                  neighbour_found = True\n                  break\n          if not neighbour_found:\n              # Fallback: any adjacent free cell, then turn towards primitive\n              for dx, dy in dirs:\n                  nx, ny = tx + dx, ty + dy\n                  if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                      path = bfs(state.pos, (nx, ny))\n                      for mv in path:\n                          actions.append(dir_action[mv])\n                          state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                          state.dir = dir_action[mv]\n                      actions.append(dir_action[(-dx, -dy)])\n                      state.dir = dir_action[(-dx, -dy)]\n                      actions.append(4)  # USE\n                      break\n\n  # ------------------------------------------------------------------\n  # If stick is a primitive (no recipe), just collect it\n  # ------------------------------------------------------------------\n  if not primitive_needs:\n      stick_cells = find_cells(stick_idx)\n      if stick_cells:\n          tx, ty = stick_cells[0]\n          neighbour_found = False\n          for dx, dy in dirs:\n              nx, ny = tx - dx, ty - dy\n              if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  actions.append(dir_action[(-dx, -dy)])\n                  state.dir = dir_action[(-dx, -dy)]\n                  actions.append(4)  # USE\n                  neighbour_found = True\n                  break\n          if not neighbour_found:\n              for dx, dy in dirs:\n                  nx, ny = tx + dx, ty + dy\n                  if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                      path = bfs(state.pos, (nx, ny))\n                      for mv in path:\n                          actions.append(dir_action[mv])\n                          state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                          state.dir = dir_action[mv]\n                      actions.append(dir_action[(-dx, -dy)])\n                      state.dir = dir_action[(-dx, -dy)]\n                      actions.append(4)\n                      break\n\n  # ------------------------------------------------------------------\n  # Craft at required workshop (if any)\n  # ------------------------------------------------------------------\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      workshop_cells = find_cells(workshop_idx)\n      if workshop_cells:\n          wx, wy = workshop_cells[0]\n          for dx, dy in dirs:\n              nx, ny = wx - dx, wy - dy\n              if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  actions.append(4)  # USE to craft the stick\n                  break\n\n  return actions", "env_interactions": 8, "island_id": 9, "scores": {"3": 0.5}}
