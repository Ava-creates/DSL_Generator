{"timestamp": "2025-10-23T03:11:57.655614", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n  stick_idx = cookbook.index['stick']\n\n  # If we already have a stick, nothing to do.\n  if state.inventory[stick_idx] > 0:\n      return []\n\n  # Helper to move from current position to target and record actions.\n  def _move_to(cur_pos, tx, ty, actions):\n      x, y = cur_pos\n      while x < tx:\n          actions.append(3)   # RIGHT\n          x += 1\n      while x > tx:\n          actions.append(2)   # LEFT\n          x -= 1\n      while y < ty:\n          actions.append(0)   # DOWN\n          y += 1\n      while y > ty:\n          actions.append(1)   # UP\n          y -= 1\n      return (x, y)\n\n  # Helper to find any cell containing a given kind index.\n  def _find_any(kind_idx):\n      cells = np.argwhere(state.grid[:, :, kind_idx] > 0)\n      return tuple(cells[0]) if cells.size > 0 else None\n\n  actions = []\n  cur_pos = state.pos\n\n  # Case 1: stick is a primitive that can be directly collected.\n  if stick_idx in cookbook.primitives:\n      target = _find_any(stick_idx)\n      if target is None:\n          return []  # No stick primitive on the map.\n      cur_pos = _move_to(cur_pos, target[0], target[1], actions)\n      actions.append(4)   # USE to pick it up\n      return actions\n\n  # Case 2: stick must be crafted according to its recipe.\n  recipe = cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get('_at', None)\n\n  # Collect all required ingredients (ignore the workshop entry).\n  for ing_key, count in recipe.items():\n      if ing_key == '_at':\n          continue\n      ing_idx = ing_key if isinstance(ing_key, int) else cookbook.index[ing_key]\n      for _ in range(count):\n          target = _find_any(ing_idx)\n          if target is None:\n              return []  # Missing ingredient.\n          cur_pos = _move_to(cur_pos, target[0], target[1], actions)\n          actions.append(4)   # USE to pick up the ingredient.\n\n  # Move to the appropriate workshop (if any) before crafting.\n  if workshop_name is not None:\n      ws_idx = cookbook.index[workshop_name]\n      target = _find_any(ws_idx)\n      if target is None:\n          return []  # Workshop not found.\n      cur_pos = _move_to(cur_pos, target[0], target[1], actions)\n\n  # Finally, use the workshop (or current cell) to craft the stick.\n  actions.append(4)   # USE to craft\n  return actions", "env_interactions": 4, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:11:58.915216", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n  stick_idx = cookbook.index['stick']\n\n  # If we already have a stick, nothing to do.\n  if state.inventory[stick_idx] > 0:\n      return []\n\n  # Helper to move from current position to target coordinates.\n  def _move_to(cur, tx, ty, act_list):\n      x, y = cur\n      while x < tx:\n          act_list.append(3)   # RIGHT\n          x += 1\n      while x > tx:\n          act_list.append(2)   # LEFT\n          x -= 1\n      while y < ty:\n          act_list.append(0)   # DOWN\n          y += 1\n      while y > ty:\n          act_list.append(1)   # UP\n          y -= 1\n      return (x, y)\n\n  # Helper to locate any cell containing a given kind index.\n  def _find_any(kind_idx):\n      cells = np.argwhere(state.grid[:, :, kind_idx] > 0)\n      return tuple(cells[0]) if cells.size > 0 else None\n\n  actions = []\n  cur_pos = state.pos\n\n  # Stick may be a primitive that can be collected directly.\n  if stick_idx in cookbook.primitives:\n      target = _find_any(stick_idx)\n      if target is None:\n          return []  # No stick primitive present.\n      cur_pos = _move_to(cur_pos, target[0], target[1], actions)\n      actions.append(4)   # USE to pick up the stick\n      return actions\n\n  # Otherwise stick must be crafted from a recipe.\n  recipe = cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get('_at', None)\n\n  # Gather all required ingredients.\n  for ing_key, cnt in recipe.items():\n      if ing_key == '_at':\n          continue\n      ing_idx = ing_key if isinstance(ing_key, int) else cookbook.index[ing_key]\n      for _ in range(cnt):\n          target = _find_any(ing_idx)\n          if target is None:\n              return []  # Missing ingredient.\n          cur_pos = _move_to(cur_pos, target[0], target[1], actions)\n          actions.append(4)   # USE to pick up the ingredient.\n\n  # Move to workshop if required.\n  if workshop_name is not None:\n      ws_idx = cookbook.index[workshop_name]\n      target = _find_any(ws_idx)\n      if target is None:\n          return []  # Workshop not found.\n      cur_pos = _move_to(cur_pos, target[0], target[1], actions)\n\n  # Craft the stick.\n  actions.append(4)   # USE to craft\n  return actions", "env_interactions": 4, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:12:24.786505", "function_name": "make_arrow", "function_body": "  # Helper: shortest path (BFS) on the grid avoiding non\u2011grabbable cells\n  def _bfs_path(start, goal, blocked):\n      act_map = env.action_specs()\n      moves = [\n          (1, 0, act_map[\"DOWN\"]),   # row +1\n          (-1, 0, act_map[\"UP\"]),    # row -1\n          (0, -1, act_map[\"LEFT\"]),  # col -1\n          (0, 1, act_map[\"RIGHT\"]),  # col +1\n      ]\n      from collections import deque\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for dx, dy, a in moves:\n              nx, ny = x + dx, y + dy\n              if (\n                  0 <= nx < blocked.shape[0]\n                  and 0 <= ny < blocked.shape[1]\n                  and not blocked[nx, ny]\n                  and (nx, ny) not in visited\n              ):\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [a]))\n      return None  # unreachable\n\n  # ----------------------------------------------------------------------\n  # Main planning for making a stick\n  # ----------------------------------------------------------------------\n  try:\n      state = env._current_state\n  except AttributeError:\n      env.reset()\n      state = env._current_state\n\n  world = env.world\n  grid = state.grid.copy()                     # mutable copy for bookkeeping\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # Primitive requirements for one stick (empty if stick is primitive)\n  needed = dict(world.cookbook.primitives_for(stick_idx))\n\n  # Cells that block movement (non\u2011grabbable entities)\n  blocked = np.zeros(grid.shape[:2], dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # ----------------------------------------------------------------------\n  # Case 1: stick itself is a primitive already placed in the world\n  # ----------------------------------------------------------------------\n  if not needed:\n      stick_cells = np.argwhere(grid[:, :, stick_idx] > 0)\n      if stick_cells.size == 0:\n          return []  # nothing to do / cannot find stick\n      target = tuple(stick_cells[0])\n      if cur_pos != target:\n          path = _bfs_path(cur_pos, target, blocked)\n          if path is None:\n              return []  # unreachable\n          actions.extend(path)\n          cur_pos = target\n      actions.append(env.action_specs()[\"USE\"])\n      return actions\n\n  # ----------------------------------------------------------------------\n  # Case 2: collect required primitives\n  # ----------------------------------------------------------------------\n  while any(cnt > 0 for cnt in needed.values()):\n      best_path = None\n      best_target = None\n      best_prim = None\n\n      # Search nearest reachable primitive of any needed type\n      for prim_idx, cnt in needed.items():\n          if cnt <= 0:\n              continue\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          for cell in prim_cells:\n              target = tuple(cell)\n              path = _bfs_path(cur_pos, target, blocked)\n              if path is None:\n                  continue\n              if best_path is None or len(path) < len(best_path):\n                  best_path = path\n                  best_target = target\n                  best_prim = prim_idx\n\n      if best_path is None:\n          # No reachable primitive left \u2192 abort planning\n          return []\n\n      # Move to the primitive and pick it up\n      actions.extend(best_path)\n      actions.append(env.action_specs()[\"USE\"])\n\n      # Update bookkeeping\n      cur_pos = best_target\n      needed[best_prim] -= 1\n      grid[best_target[0], best_target[1], best_prim] = 0   # remove from map\n\n  # ----------------------------------------------------------------------\n  # Case 3: go to the workshop (if recipe specifies one)\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          target = tuple(workshop_cells[0])\n          if cur_pos != target:\n              path = _bfs_path(cur_pos, target, blocked)\n              if path is None:\n                  return []  # cannot reach workshop\n              actions.extend(path)\n              cur_pos = target\n\n  # ----------------------------------------------------------------------\n  # Finally, craft the stick\n  # ----------------------------------------------------------------------\n  actions.append(env.action_specs()[\"USE\"])\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:12:26.109806", "function_name": "make_arrow", "function_body": "  from collections import deque\n\n  def _bfs_path(start, goal, blocked):\n      act_map = env.action_specs()\n      moves = [\n          (0, 1, act_map[\"DOWN\"]),\n          (0, -1, act_map[\"UP\"]),\n          (-1, 0, act_map[\"LEFT\"]),\n          (1, 0, act_map[\"RIGHT\"]),\n      ]\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for dx, dy, a in moves:\n              nx, ny = x + dx, y + dy\n              if (\n                  0 <= nx < blocked.shape[0]\n                  and 0 <= ny < blocked.shape[1]\n                  and not blocked[nx, ny]\n                  and (nx, ny) not in visited\n              ):\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [a]))\n      return None\n\n  # ----------------------------------------------------------------------\n  # Main planning\n  # ----------------------------------------------------------------------\n  state = env._current_state\n  world = env.world\n  grid = state.grid.copy()\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # Primitive requirements for one stick (empty if stick itself is primitive)\n  needed = dict(world.cookbook.primitives_for(stick_idx))\n\n  # Cells that block movement (non\u2011grabbable entities)\n  blocked = np.zeros(grid.shape[:2], dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # ----------------------------------------------------------------------\n  # Case 1: stick is a primitive already placed in the world\n  # ----------------------------------------------------------------------\n  if not needed:\n      stick_cells = np.argwhere(grid[:, :, stick_idx] > 0)\n      if stick_cells.size == 0:\n          return []  # nothing to do / cannot find stick\n      target = tuple(stick_cells[0])\n      if cur_pos != target:\n          path = _bfs_path(cur_pos, target, blocked)\n          if path is None:\n              return []  # unreachable\n          actions.extend(path)\n          cur_pos = target\n      actions.append(env.action_specs()[\"USE\"])\n      return actions\n\n  # ----------------------------------------------------------------------\n  # Case 2: collect required primitives\n  # ----------------------------------------------------------------------\n  while any(cnt > 0 for cnt in needed.values()):\n      best_path = None\n      best_target = None\n      best_prim = None\n\n      # Look for the nearest reachable primitive of any needed type\n      for prim_idx, cnt in needed.items():\n          if cnt <= 0:\n              continue\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          for cell in prim_cells:\n              target = tuple(cell)\n              path = _bfs_path(cur_pos, target, blocked)\n              if path is None:\n                  continue\n              if best_path is None or len(path) < len(best_path):\n                  best_path = path\n                  best_target = target\n                  best_prim = prim_idx\n\n      if best_path is None:\n          # No reachable primitive left \u2192 abort planning\n          return actions\n\n      # Move to the primitive and pick it up\n      actions.extend(best_path)\n      actions.append(env.action_specs()[\"USE\"])\n\n      # Update state tracking\n      cur_pos = best_target\n      needed[best_prim] -= 1\n      grid[best_target[0], best_target[1], best_prim] = 0   # remove from map\n\n  # ----------------------------------------------------------------------\n  # Case 3: go to the workshop (if the recipe specifies one)\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          target = tuple(workshop_cells[0])\n          if cur_pos != target:\n              path = _bfs_path(cur_pos, target, blocked)\n              if path is not None:\n                  actions.extend(path)\n                  cur_pos = target\n\n  # ----------------------------------------------------------------------\n  # Finally, craft the stick\n  # ----------------------------------------------------------------------\n  actions.append(env.action_specs()[\"USE\"])\n  return actions", "env_interactions": 3, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:12:46.357922", "function_name": "make_arrow", "function_body": "  # reset environment and get initial state\n  env.reset()\n  state = env._current_state\n  grid = state.grid\n  width, height = grid.shape[:2]\n\n  # movement directions and corresponding action indices\n  dirs = [(0, 1), (0, -1), (-1, 0), (1, 0)]          # DOWN, UP, LEFT, RIGHT\n  dir_action = {(0, 1): 0, (0, -1): 1, (-1, 0): 2, (1, 0): 3}\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # helper utilities\n  # ------------------------------------------------------------------\n  def find_cells(kind):\n      \"\"\"Return list of (x, y) positions where `kind` is present.\"\"\"\n      xs, ys = np.where(grid[:, :, kind] > 0)\n      return list(zip(xs.tolist(), ys.tolist()))\n\n  from collections import deque\n\n  def bfs(start, goal):\n      \"\"\"Shortest path (as list of moves) from start to goal on empty cells.\"\"\"\n      if start == goal:\n          return []\n      q = deque([start])\n      visited = {start}\n      prev = {}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          x, y = cur\n          for dx, dy in dirs:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height:\n                  if (nx, ny) not in visited and not grid[nx, ny].any():\n                      visited.add((nx, ny))\n                      prev[(nx, ny)] = (cur, (dx, dy))\n                      q.append((nx, ny))\n      if goal not in prev:\n          return []          # no reachable path\n      # reconstruct moves\n      path = []\n      cur = goal\n      while cur != start:\n          pnode, move = prev[cur]\n          path.append(move)\n          cur = pnode\n      path.reverse()\n      return path\n\n  # ------------------------------------------------------------------\n  # obtain stick recipe\n  # ------------------------------------------------------------------\n  stick_idx = env.world.cookbook.index[\"stick\"]\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  primitive_needs = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  # ------------------------------------------------------------------\n  # collect each required primitive the needed number of times\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          prim_cells = find_cells(prim_idx)\n          if not prim_cells:\n              continue          # primitive absent in this scenario\n          tx, ty = prim_cells[0]\n\n          # try to stand on a free neighbour opposite the direction we will face\n          neighbour_found = False\n          for dx, dy in dirs:\n              nx, ny = tx - dx, ty - dy\n              if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  # face the primitive and use it\n                  actions.append(dir_action[(-dx, -dy)])\n                  state.dir = dir_action[(-dx, -dy)]\n                  actions.append(4)          # USE\n                  neighbour_found = True\n                  break\n\n          if not neighbour_found:\n              # fallback: any adjacent free cell\n              for dx, dy in dirs:\n                  nx, ny = tx + dx, ty + dy\n                  if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                      path = bfs(state.pos, (nx, ny))\n                      for mv in path:\n                          actions.append(dir_action[mv])\n                          state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                          state.dir = dir_action[mv]\n                      actions.append(dir_action[(-dx, -dy)])\n                      state.dir = dir_action[(-dx, -dy)]\n                      actions.append(4)          # USE\n                      break\n\n  # ------------------------------------------------------------------\n  # if a workshop is required, go there and craft the stick\n  # ------------------------------------------------------------------\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      workshop_cells = find_cells(workshop_idx)\n      if workshop_cells:\n          wx, wy = workshop_cells[0]\n          for dx, dy in dirs:\n              nx, ny = wx - dx, wy - dy\n              if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  actions.append(4)          # USE to craft\n                  break\n\n  return actions", "env_interactions": 8, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-23T03:12:47.656280", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  grid = state.grid\n  width, height = grid.shape[:2]\n\n  # direction vectors and corresponding action indices (DOWN=0, UP=1, LEFT=2, RIGHT=3)\n  dirs = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n  dir_action = {(0, 1): 0, (0, -1): 1, (-1, 0): 2, (1, 0): 3}\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # helper utilities\n  # ------------------------------------------------------------------\n  def find_cells(kind):\n      \"\"\"Return list of (x, y) positions where `kind` is present in the grid.\"\"\"\n      xs, ys = np.where(grid[:, :, kind] > 0)\n      return list(zip(xs.tolist(), ys.tolist()))\n\n  from collections import deque\n\n  def bfs(start, goal):\n      \"\"\"Return a list of (dx, dy) moves from start to goal avoiding occupied cells.\"\"\"\n      if start == goal:\n          return []\n      q = deque([start])\n      visited = {start}\n      prev = {}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          x, y = cur\n          for dx, dy in dirs:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height:\n                  if (nx, ny) not in visited and not np.any(grid[nx, ny, :]):\n                      visited.add((nx, ny))\n                      prev[(nx, ny)] = (cur, (dx, dy))\n                      q.append((nx, ny))\n      if goal not in prev:\n          return []  # no path found\n      path = []\n      cur = goal\n      while cur != start:\n          pnode, move = prev[cur]\n          path.append(move)\n          cur = pnode\n      path.reverse()\n      return path\n\n  # ------------------------------------------------------------------\n  # identify stick recipe\n  # ------------------------------------------------------------------\n  stick_idx = env.world.cookbook.index[\"stick\"]\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  primitive_needs = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  # ------------------------------------------------------------------\n  # collect required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          prim_cells = find_cells(prim_idx)\n          if not prim_cells:\n              continue  # primitive not present in this scenario\n          tx, ty = prim_cells[0]\n\n          # try to stand on a free neighbour opposite the direction we will face\n          neighbour_found = False\n          for dx, dy in dirs:\n              nx, ny = tx - dx, ty - dy\n              if 0 <= nx < width and 0 <= ny < height and not np.any(grid[nx, ny, :]):\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  # face the primitive\n                  actions.append(dir_action[(-dx, -dy)])\n                  state.dir = dir_action[(-dx, -dy)]\n                  # pick up\n                  actions.append(4)  # USE\n                  neighbour_found = True\n                  break\n\n          if not neighbour_found:\n              # fallback: any adjacent free cell, then turn towards primitive\n              for dx, dy in dirs:\n                  nx, ny = tx + dx, ty + dy\n                  if 0 <= nx < width and 0 <= ny < height and not np.any(grid[nx, ny, :]):\n                      path = bfs(state.pos, (nx, ny))\n                      for mv in path:\n                          actions.append(dir_action[mv])\n                          state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                          state.dir = dir_action[mv]\n                      actions.append(dir_action[(-dx, -dy)])  # face primitive\n                      state.dir = dir_action[(-dx, -dy)]\n                      actions.append(4)  # USE\n                      break\n\n  # ------------------------------------------------------------------\n  # craft at required workshop (if any)\n  # ------------------------------------------------------------------\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      workshop_cells = find_cells(workshop_idx)\n      if workshop_cells:\n          wx, wy = workshop_cells[0]\n          for dx, dy in dirs:\n              nx, ny = wx - dx, wy - dy\n              if 0 <= nx < width and 0 <= ny < height and not np.any(grid[nx, ny, :]):\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  actions.append(4)  # USE to craft the stick\n                  break\n\n  return actions", "env_interactions": 8, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-23T03:13:07.926810", "function_name": "make_arrow", "function_body": "  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act.get(\"DOWN\", 0),\n      act.get(\"UP\", 1),\n      act.get(\"LEFT\", 2),\n      act.get(\"RIGHT\", 3),\n      act.get(\"USE\", 4),\n  )\n\n  # Snapshot of the current state (do not modify the environment)\n  state = env._current_state\n  grid = state.grid.copy()                 # (W, H, n_kinds)\n  cur_pos = tuple(state.pos)               # (x, y)\n\n  # Find the index for the goal item \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n      if stick_idx is None:\n          return []   # stick not defined in this world\n\n  # Obtain the recipe: primitive requirements and optional workshop\n  recipe = env.world.cookbook.primitives_for(stick_idx)   # dict {kind_idx: count}\n  primitive_needs = {k: v for k, v in recipe.items() if isinstance(k, int)}\n\n  # If there is no recipe (stick is a primitive), we need to collect one stick\n  if not primitive_needs:\n      primitive_needs = {stick_idx: 1}\n\n  # Detect workshop requirement (non\u2011int key in recipe)\n  workshop_idx = None\n  for k, v in recipe.items():\n      if not isinstance(k, int):\n          workshop_idx = v if isinstance(v, int) else None\n          break\n\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # Helper: locate the nearest cell containing at least one of the given kind\n  # ----------------------------------------------------------------------\n  def find_closest(kind_idx, cur):\n      positions = np.argwhere(grid[:, :, kind_idx] > 0)\n      if positions.shape[0] == 0:\n          return None\n      dists = np.sum(np.abs(positions - np.array(cur)), axis=1)\n      nearest = positions[np.argmin(dists)]\n      return tuple(nearest.tolist())\n\n  # ----------------------------------------------------------------------\n  # Helper: greedy Manhattan path from cur to target (returns actions + final pos)\n  # ----------------------------------------------------------------------\n  def path_to(cur, target):\n      x, y = cur\n      tx, ty = target\n      path = []\n      while (x, y) != (tx, ty):\n          if x < tx:\n              path.append(RIGHT)\n              x += 1\n          elif x > tx:\n              path.append(LEFT)\n              x -= 1\n          elif y < ty:\n              path.append(DOWN)\n              y += 1\n          elif y > ty:\n              path.append(UP)\n              y -= 1\n      return path, (x, y)\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive the needed number of times\n  # ----------------------------------------------------------------------\n  for kind_idx, needed in primitive_needs.items():\n      while needed > 0:\n          target = find_closest(kind_idx, cur_pos)\n          if target is None:\n              # Primitive not available on the map \u2013 abort planning\n              return actions\n          move_actions, cur_pos = path_to(cur_pos, target)\n          actions.extend(move_actions)\n          actions.append(USE)   # pick up the primitive\n\n          # Update the local grid copy to reflect the collection\n          grid[target[0], target[1], kind_idx] = max(\n              0, grid[target[0], target[1], kind_idx] - 1\n          )\n          needed -= 1\n\n  # ----------------------------------------------------------------------\n  # If a workshop is required, move to it and craft the stick there\n  # ----------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_target = find_closest(workshop_idx, cur_pos)\n      if ws_target is not None:\n          move_actions, cur_pos = path_to(cur_pos, ws_target)\n          actions.extend(move_actions)\n          actions.append(USE)   # craft the stick at the workshop\n\n  return actions", "env_interactions": 2, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:13:09.277940", "function_name": "make_arrow", "function_body": "  # ----- action indices -------------------------------------------------\n  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act.get(\"DOWN\", 0),\n      act.get(\"UP\", 1),\n      act.get(\"LEFT\", 2),\n      act.get(\"RIGHT\", 3),\n      act.get(\"USE\", 4),\n  )\n\n  # ----- current state snapshot ----------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()                 # (W, H, n_kinds)\n  cur_pos = tuple(state.pos)               # (x, y)\n\n  # ----- index of the target item (\"stick\") ----------------------------\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n      if stick_idx is None:\n          return []   # stick not defined in this world\n\n  # ----- recipe decomposition -------------------------------------------\n  recipe = env.world.cookbook.primitives_for(stick_idx)   # {kind_idx: count}\n  primitive_needs = {k: v for k, v in recipe.items() if isinstance(k, int)}\n  # if the item itself is a primitive (no recipe) we just need one of it\n  if not primitive_needs:\n      primitive_needs = {stick_idx: 1}\n\n  workshop_idx = None\n  for k, v in recipe.items():\n      if not isinstance(k, int):\n          workshop_idx = v if isinstance(v, int) else None\n          break\n\n  actions = []\n\n  # ----- helper: locate nearest cell containing a given kind ----------\n  def find_closest(kind_idx, cur):\n      positions = np.argwhere(grid[:, :, kind_idx] > 0)\n      if positions.shape[0] == 0:\n          return None\n      dists = np.sum(np.abs(positions - np.array(cur)), axis=1)\n      nearest = positions[np.argmin(dists)]\n      return tuple(nearest.tolist())\n\n  # ----- helper: greedy Manhattan path ---------------------------------\n  def path_to(cur, target):\n      x, y = cur\n      tx, ty = target\n      path = []\n      while (x, y) != (tx, ty):\n          if x < tx:\n              path.append(RIGHT)\n              x += 1\n          elif x > tx:\n              path.append(LEFT)\n              x -= 1\n          elif y < ty:\n              path.append(DOWN)\n              y += 1\n          elif y > ty:\n              path.append(UP)\n              y -= 1\n      return path, (x, y)\n\n  # ----- collect required primitives ------------------------------------\n  for kind_idx, needed in primitive_needs.items():\n      while needed > 0:\n          target = find_closest(kind_idx, cur_pos)\n          if target is None:\n              # primitive missing from the map \u2013 abort planning\n              return actions\n          move_actions, cur_pos = path_to(cur_pos, target)\n          actions.extend(move_actions)\n          actions.append(USE)   # pick up the primitive\n\n          # update local copy of the grid to reflect the collection\n          grid[target[0], target[1], kind_idx] = max(\n              0, grid[target[0], target[1], kind_idx] - 1\n          )\n          needed -= 1\n\n  # ----- if a workshop is required, go there and craft -----------------\n  if workshop_idx is not None:\n      ws_target = find_closest(workshop_idx, cur_pos)\n      if ws_target is not None:\n          move_actions, cur_pos = path_to(cur_pos, ws_target)\n          actions.extend(move_actions)\n          actions.append(USE)   # craft the stick at the workshop\n\n  return actions", "env_interactions": 2, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:13:29.469961", "function_name": "make_arrow", "function_body": "  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act.get(\"DOWN\", 0),\n      act.get(\"UP\", 1),\n      act.get(\"LEFT\", 2),\n      act.get(\"RIGHT\", 3),\n      act.get(\"USE\", 4),\n  )\n\n  # ----- snapshot of current state -----\n  state = env._current_state\n  grid = state.grid.copy()               # (W, H, n_kinds)\n  cur_pos = tuple(state.pos)             # (x, y)\n\n  # ----- locate the stick item index -----\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n      if stick_idx is None:\n          return []   # stick not defined in this world\n\n  # ----- decode recipe for stick -----\n  recipe = env.world.cookbook.primitives_for(stick_idx)   # {kind_idx: count}\n  primitive_needs = {k: v for k, v in recipe.items() if isinstance(k, int)}\n\n  # if stick itself is a primitive (no recipe) we just need one of it\n  if not primitive_needs:\n      primitive_needs = {stick_idx: 1}\n\n  # workshop requirement (non\u2011int key in full recipe)\n  workshop_idx = None\n  full_recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  for key, val in full_recipe.items():\n      if not isinstance(key, int):\n          workshop_idx = val if isinstance(val, int) else None\n          break\n\n  actions = []\n\n  # ----- helper: find closest cell containing a given kind ----------\n  def find_closest(kind_idx, cur):\n      positions = np.argwhere(grid[:, :, kind_idx] > 0)\n      if positions.shape[0] == 0:\n          return None\n      dists = np.sum(np.abs(positions - np.array(cur)), axis=1)\n      nearest = positions[np.argmin(dists)]\n      return tuple(nearest.tolist())\n\n  # ----- helper: greedy Manhattan path -------------------------------\n  def path_to(cur, target):\n      x, y = cur\n      tx, ty = target\n      path = []\n      while (x, y) != (tx, ty):\n          if x < tx:\n              path.append(RIGHT)\n              x += 1\n          elif x > tx:\n              path.append(LEFT)\n              x -= 1\n          elif y < ty:\n              path.append(DOWN)\n              y += 1\n          elif y > ty:\n              path.append(UP)\n              y -= 1\n      return path, (x, y)\n\n  # ----- collect required primitives ---------------------------------\n  for kind_idx, needed in primitive_needs.items():\n      while needed > 0:\n          target = find_closest(kind_idx, cur_pos)\n          if target is None:\n              # primitive missing from the map \u2013 abort planning\n              return actions\n          move_actions, cur_pos = path_to(cur_pos, target)\n          actions.extend(move_actions)\n          actions.append(USE)   # pick up the primitive\n\n          # update local copy of the grid to reflect the collection\n          grid[target[0], target[1], kind_idx] = max(\n              0, grid[target[0], target[1], kind_idx] - 1\n          )\n          needed -= 1\n\n  # ----- if a workshop is required, go there and craft ---------------\n  if workshop_idx is not None:\n      ws_target = find_closest(workshop_idx, cur_pos)\n      if ws_target is not None:\n          move_actions, cur_pos = path_to(cur_pos, ws_target)\n          actions.extend(move_actions)\n          actions.append(USE)   # craft the stick at the workshop\n\n  return actions", "env_interactions": 2, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:13:30.789941", "function_name": "make_arrow", "function_body": "  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act.get(\"DOWN\", 0),\n      act.get(\"UP\", 1),\n      act.get(\"LEFT\", 2),\n      act.get(\"RIGHT\", 3),\n      act.get(\"USE\", 4),\n  )\n\n  # current state snapshot\n  state = env._current_state\n  grid = state.grid.copy()                     # (W, H, n_kinds)\n  cur_pos = tuple(state.pos)                   # (x, y)\n\n  # index of the target item (\"stick\")\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n      if stick_idx is None:\n          return []   # stick not present in this world\n\n  # recipe decomposition\n  recipe = env.world.cookbook.primitives_for(stick_idx)   # {kind_idx: count}\n  primitive_needs = {k: v for k, v in recipe.items() if isinstance(k, int)}\n\n  # if stick itself is primitive (no recipe), need just one of it\n  if not primitive_needs:\n      primitive_needs = {stick_idx: 1}\n\n  # detect workshop requirement (non\u2011int key in full recipe dict)\n  workshop_idx = None\n  full_recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  for key, val in full_recipe.items():\n      if not isinstance(key, int):\n          workshop_idx = val if isinstance(val, int) else None\n          break\n\n  actions = []\n\n  # helper: locate nearest cell containing at least one of kind_idx\n  def find_closest(kind_idx, cur):\n      positions = np.argwhere(grid[:, :, kind_idx] > 0)\n      if positions.shape[0] == 0:\n          return None\n      dists = np.sum(np.abs(positions - np.array(cur)), axis=1)\n      nearest = positions[np.argmin(dists)]\n      return tuple(nearest.tolist())\n\n  # helper: greedy Manhattan path from cur to target\n  def path_to(cur, target):\n      x, y = cur\n      tx, ty = target\n      path = []\n      while (x, y) != (tx, ty):\n          if x < tx:\n              path.append(RIGHT)\n              x += 1\n          elif x > tx:\n              path.append(LEFT)\n              x -= 1\n          elif y < ty:\n              path.append(DOWN)\n              y += 1\n          elif y > ty:\n              path.append(UP)\n              y -= 1\n      return path, (x, y)\n\n  # collect required primitives\n  for kind_idx, needed in primitive_needs.items():\n      while needed > 0:\n          target = find_closest(kind_idx, cur_pos)\n          if target is None:\n              # primitive missing; abort planning\n              return actions\n          move_actions, cur_pos = path_to(cur_pos, target)\n          actions.extend(move_actions)\n          actions.append(USE)   # pick up the primitive\n          # update local grid copy\n          grid[target[0], target[1], kind_idx] = max(\n              0, grid[target[0], target[1], kind_idx] - 1\n          )\n          needed -= 1\n\n  # if a workshop is required, go there and craft\n  if workshop_idx is not None:\n      ws_target = find_closest(workshop_idx, cur_pos)\n      if ws_target is not None:\n          move_actions, cur_pos = path_to(cur_pos, ws_target)\n          actions.extend(move_actions)\n          actions.append(USE)   # craft the stick\n\n  return actions", "env_interactions": 2, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:13:50.259975", "function_name": "make_arrow", "function_body": "  actions = []\n  state = env._current_state\n  grid = state.grid\n  world = env.world\n  cb = world.cookbook\n\n  # target index for \"stick\"\n  try:\n      goal_idx = cb.index[\"stick\"]\n  except Exception:\n      return actions\n\n  # primitive requirements for the stick (may be empty if stick is primitive)\n  prims = cb.primitives_for(goal_idx)\n\n  # mutable copy of the agent's current position\n  pos = list(state.pos)\n\n  # helper to move the agent using Manhattan steps\n  def _move_to(target):\n      nonlocal pos, actions\n      tx, ty = target\n      # move in x direction (RIGHT=3, LEFT=2)\n      while pos[0] < tx:\n          actions.append(3)   # RIGHT\n          pos[0] += 1\n      while pos[0] > tx:\n          actions.append(2)   # LEFT\n          pos[0] -= 1\n      # move in y direction (DOWN=0, UP=1)\n      while pos[1] < ty:\n          actions.append(0)   # DOWN\n          pos[1] += 1\n      while pos[1] > ty:\n          actions.append(1)   # UP\n          pos[1] -= 1\n\n  # collect each required primitive\n  for prim_idx, needed in prims.items():\n      locations = np.argwhere(grid[:, :, prim_idx] > 0)\n      if locations.size == 0:\n          continue  # primitive not present; skip\n      target = locations[0].tolist()  # take first occurrence\n      _move_to(target)\n      for _ in range(needed):\n          actions.append(4)   # USE to pick up\n\n  # if the recipe specifies a workshop, move there and craft the stick\n  recipe = cb.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = cb.index[workshop_name]\n      w_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if w_locs.size:\n          w_target = w_locs[0].tolist()\n          _move_to(w_target)\n          actions.append(4)   # USE to craft at workshop\n\n  return actions", "env_interactions": 4, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:13:51.627070", "function_name": "make_arrow", "function_body": "  actions = []\n  state = env._current_state\n  grid = state.grid\n  world = env.world\n  cb = world.cookbook\n\n  try:\n      goal_idx = cb.index[\"stick\"]\n  except Exception:\n      return actions\n\n  # Primitive requirements for a stick (empty if stick itself is primitive)\n  prims = cb.primitives_for(goal_idx)\n\n  # Current mutable position (x, y)\n  pos = list(state.pos)\n\n  # Helper to move the agent using Manhattan steps\n  def _move_to(target):\n      nonlocal pos, actions\n      tx, ty = target\n      while pos[0] < tx:\n          actions.append(3)   # RIGHT\n          pos[0] += 1\n      while pos[0] > tx:\n          actions.append(2)   # LEFT\n          pos[0] -= 1\n      while pos[1] < ty:\n          actions.append(0)   # DOWN\n          pos[1] += 1\n      while pos[1] > ty:\n          actions.append(1)   # UP\n          pos[1] -= 1\n\n  if prims:\n      # Collect each required primitive\n      for prim_idx, needed in prims.items():\n          locations = np.argwhere(grid[:, :, prim_idx] > 0)\n          if locations.size == 0:\n              continue  # primitive not present; skip\n          target = locations[0].tolist()\n          _move_to(target)\n          for _ in range(needed):\n              actions.append(4)   # USE to pick up one unit\n\n      # If the recipe specifies a workshop, move there and craft the stick\n      recipe = cb.recipes.get(goal_idx, {})\n      workshop_name = recipe.get(\"_at\")\n      if workshop_name:\n          workshop_idx = cb.index[workshop_name]\n          w_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n          if w_locs.size:\n              w_target = w_locs[0].tolist()\n              _move_to(w_target)\n              actions.append(4)   # USE to craft at the workshop\n  else:\n      # Stick is a primitive; simply pick it up\n      locations = np.argwhere(grid[:, :, goal_idx] > 0)\n      if locations.size:\n          target = locations[0].tolist()\n          _move_to(target)\n          actions.append(4)   # USE to pick up the stick\n\n  return actions", "env_interactions": 4, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:14:05.868228", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n\n  # Action indices\n  act = env.action_specs()\n  DOWN = act[\"DOWN\"]\n  UP = act[\"UP\"]\n  LEFT = act[\"LEFT\"]\n  RIGHT = act[\"RIGHT\"]\n  USE = act[\"USE\"]\n\n  # Index of the primitive \"stick\"\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # Find all cells containing a stick\n  stick_cells = np.argwhere(state.grid[:, :, stick_idx] > 0)\n  if stick_cells.size == 0:\n      # No sticks present in the world\n      return []\n\n  # Breadth\u2011first search for the nearest reachable stick,\n  # avoiding non\u2011grabbable entities (e.g., water, stone, trees)\n  width, height = state.grid.shape[:2]\n  non_grabbable = world.non_grabbable_indices\n\n  def traversable(pos):\n      x, y = pos\n      if not (0 <= x < width and 0 <= y < height):\n          return False\n      for idx in non_grabbable:\n          if state.grid[x, y, idx] > 0:\n              return False\n      return True\n\n  start = tuple(state.pos)\n  targets = {tuple(cell) for cell in stick_cells}\n  queue = collections.deque([start])\n  visited = {start: None}   # maps position -> (previous_position, action_to_reach)\n  goal = None\n\n  while queue:\n      cur = queue.popleft()\n      if cur in targets:\n          goal = cur\n          break\n      x, y = cur\n      for nx, ny, a in [(x + 1, y, DOWN), (x - 1, y, UP),\n                        (x, y + 1, RIGHT), (x, y - 1, LEFT)]:\n          nxt = (nx, ny)\n          if nxt not in visited and traversable(nxt):\n              visited[nxt] = (cur, a)\n              queue.append(nxt)\n\n  if goal is None:\n      # No reachable stick found\n      return []\n\n  # Reconstruct action sequence from start to goal\n  actions = []\n  cur = goal\n  while visited[cur] is not None:\n      prev, a = visited[cur]\n      actions.append(a)\n      cur = prev\n  actions.reverse()   # now ordered from start to goal\n\n  # Pick up the stick\n  actions.append(USE)\n  return actions", "env_interactions": 0, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:14:07.190631", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n\n  # Action identifiers\n  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act[\"DOWN\"], act[\"UP\"], act[\"LEFT\"], act[\"RIGHT\"], act[\"USE\"]\n  )\n\n  # Index of the primitive stick\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # Find all cells containing a stick\n  stick_cells = np.argwhere(state.grid[:, :, stick_idx] > 0)\n  if stick_cells.size == 0:\n      # No sticks present\n      return []\n\n  # Breadth\u2011first search for the nearest reachable stick,\n  # avoiding non\u2011grabbable entities.\n  width, height = state.grid.shape[:2]\n  non_grabbable = world.non_grabbable_indices\n\n  def traversable(p):\n      x, y = p\n      if not (0 <= x < width and 0 <= y < height):\n          return False\n      # Cell must not contain any non\u2011grabbable kind\n      for idx in non_grabbable:\n          if state.grid[x, y, idx] > 0:\n              return False\n      return True\n\n  start = tuple(state.pos)\n  target_set = {tuple(cell) for cell in stick_cells}\n  queue = collections.deque([start])\n  visited = {start: None}\n  goal = None\n\n  while queue:\n      cur = queue.popleft()\n      if cur in target_set:\n          goal = cur\n          break\n      x, y = cur\n      for nx, ny, act_code in [(x + 1, y, DOWN),\n                               (x - 1, y, UP),\n                               (x, y + 1, RIGHT),\n                               (x, y - 1, LEFT)]:\n          nxt = (nx, ny)\n          if nxt not in visited and traversable(nxt):\n              visited[nxt] = (cur, act_code)\n              queue.append(nxt)\n\n  if goal is None:\n      # No reachable stick found\n      return []\n\n  # Reconstruct the action sequence from start to the goal cell\n  actions = []\n  cur = goal\n  while visited[cur] is not None:\n      prev, act_code = visited[cur]\n      actions.append(act_code)\n      cur = prev\n  actions.reverse()\n\n  # Pick up the stick\n  actions.append(USE)\n  return actions", "env_interactions": 0, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:14:18.291651", "function_name": "make_arrow", "function_body": "  # Reset the environment to start a fresh episode.\n  env.reset()\n  goal_idx = env.task.goal\n\n  # Determine which primitive resources are needed for the goal.\n  needed = env.world.cookbook.primitives_for(goal_idx)\n\n  # If the goal is a primitive (no recipe), a single USE action may be enough.\n  if not needed:\n      return [4]  # USE\n\n  # Action indices (as defined in the environment):\n  # LEFT=2, DOWN=0, RIGHT=3, UP=1, USE=4\n  move_cycle = [2, 0, 3, 1]\n\n  actions = []\n  steps_per_dir = 1          # number of steps in the current direction of the spiral\n  total_steps = 0\n  max_total_steps = 300      # safety cap to prevent infinite loops\n\n  # Perform an expanding square spiral, using the \"USE\" action after each move.\n  while total_steps < max_total_steps:\n      for direction in move_cycle:\n          for _ in range(steps_per_dir):\n              actions.append(direction)   # move\n              actions.append(4)           # USE after moving\n              total_steps += 2\n              if total_steps >= max_total_steps:\n                  break\n          if total_steps >= max_total_steps:\n              break\n      steps_per_dir += 1  # expand the spiral outward\n\n  # After the exploration phase, issue a few extra USE actions in case we are\n  # standing on a workshop or near required primitives.\n  actions.extend([4] * 10)\n\n  return actions", "env_interactions": 1, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:14:19.612148", "function_name": "make_arrow", "function_body": "  # Reset the environment to start a fresh episode.\n  env.reset()\n  # Index of the goal item (stick) for this task.\n  goal_idx = env.task.goal\n\n  # Determine the primitive resources required to craft the goal.\n  needed = env.world.cookbook.primitives_for(goal_idx)\n\n  # If the goal has no recipe (i.e., it is a primitive), simply try to pick it up.\n  if not needed:\n      return [4]  # USE action\n\n  # Estimate a generous bound on how many primitive items we must collect.\n  total_needed = sum(needed.values())\n\n  # Simple movement pattern that explores the map while repeatedly using the\n  # \"USE\" action to collect resources and attempt crafting at workshops.\n  # Action indices: LEFT=2, DOWN=0, RIGHT=3, UP=1, USE=4.\n  move_cycle = [2, 0, 3, 1]  # cycle through the four cardinal directions\n\n  actions = []\n  # Multiply by a factor to give ample time for gathering resources and reaching\n  # the appropriate workshop. The factor can be tuned; 30 provides a comfortable margin.\n  for i in range(total_needed * 30):\n      actions.append(move_cycle[i % len(move_cycle)])  # move\n      actions.append(4)                               # USE after each move\n\n  return actions", "env_interactions": 1, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:14:42.211562", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  grid = state.grid\n  width, height = grid.shape[:2]\n\n  # movement vectors and mapping to action indices\n  dirs = [(0, 1), (0, -1), (-1, 0), (1, 0)]          # DOWN, UP, LEFT, RIGHT\n  dir_action = {(0, 1): 0, (0, -1): 1, (-1, 0): 2, (1, 0): 3}\n\n  actions = []\n\n  # locate all cells containing a particular kind index\n  def find_cells(kind):\n      xs, ys = np.where(grid[:, :, kind] > 0)\n      return list(zip(xs.tolist(), ys.tolist()))\n\n  # BFS that returns a list of (dx,dy) moves on free cells only\n  from collections import deque\n\n  def bfs(start, goal):\n      \"\"\"Return list of (dx,dy) moves from start to goal avoiding occupied cells.\"\"\"\n      if start == goal:\n          return []\n      q = deque([start])\n      visited = {start}\n      prev = {}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          x, y = cur\n          for dx, dy in dirs:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height:\n                  if (nx, ny) not in visited and not np.any(grid[nx, ny, :]):\n                      visited.add((nx, ny))\n                      prev[(nx, ny)] = (cur, (dx, dy))\n                      q.append((nx, ny))\n      if goal not in prev:\n          return []  # no path found\n      # reconstruct path\n      path = []\n      cur = goal\n      while cur != start:\n          prev_node, move = prev[cur]\n          path.append(move)\n          cur = prev_node\n      path.reverse()\n      return path\n\n  # ------------------------------------------------------------------\n  # Identify stick recipe\n  # ------------------------------------------------------------------\n  stick_idx = env.world.cookbook.index[\"stick\"]\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  primitive_needs = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  # ------------------------------------------------------------------\n  # Collect required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          prim_cells = find_cells(prim_idx)\n          if not prim_cells:\n              continue  # primitive not present in the world\n          tx, ty = prim_cells[0]\n\n          # try to stand on a free neighbour from which we can USE the primitive\n          neighbour_found = False\n          for dx, dy in dirs:\n              nx, ny = tx - dx, ty - dy  # cell opposite the direction we will face\n              if 0 <= nx < width and 0 <= ny < height and not np.any(grid[nx, ny, :]):\n                  # move to (nx, ny)\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  # face the primitive\n                  actions.append(dir_action[(-dx, -dy)])\n                  state.dir = dir_action[(-dx, -dy)]\n                  # pick up\n                  actions.append(4)  # USE\n                  neighbour_found = True\n                  break\n\n          if not neighbour_found:\n              # fallback: any adjacent free cell, then turn towards primitive\n              for dx, dy in dirs:\n                  nx, ny = tx + dx, ty + dy\n                  if 0 <= nx < width and 0 <= ny < height and not np.any(grid[nx, ny, :]):\n                      path = bfs(state.pos, (nx, ny))\n                      for mv in path:\n                          actions.append(dir_action[mv])\n                          state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                          state.dir = dir_action[mv]\n                      actions.append(dir_action[(-dx, -dy)])  # face primitive\n                      state.dir = dir_action[(-dx, -dy)]\n                      actions.append(4)  # USE\n                      neighbour_found = True\n                      break\n\n  # ------------------------------------------------------------------\n  # If a workshop is required, move there and craft the stick\n  # ------------------------------------------------------------------\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      workshop_cells = find_cells(workshop_idx)\n      if workshop_cells:\n          wx, wy = workshop_cells[0]\n          # find a free neighbour to stand on\n          for dx, dy in dirs:\n              nx, ny = wx - dx, wy - dy\n              if 0 <= nx < width and 0 <= ny < height and not np.any(grid[nx, ny, :]):\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  actions.append(4)  # USE to craft the stick\n                  break\n\n  return actions", "env_interactions": 8, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-23T03:14:43.544393", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  grid = state.grid\n  width, height = grid.shape[:2]\n\n  # direction vectors and mapping to action indices (DOWN=0, UP=1, LEFT=2, RIGHT=3)\n  dirs = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n  dir_action = {(0, 1): 0, (0, -1): 1, (-1, 0): 2, (1, 0): 3}\n\n  actions = []\n\n  # helper to locate all cells containing a given kind index\n  def find_cells(kind):\n      xs, ys = np.where(grid[:, :, kind] > 0)\n      return list(zip(xs.tolist(), ys.tolist()))\n\n  # BFS that returns a list of (dx,dy) moves on free cells only\n  from collections import deque\n\n  def bfs(start, goal):\n      \"\"\"Return list of (dx,dy) moves from start to goal avoiding occupied cells.\"\"\"\n      q = deque([start])\n      visited = {start}\n      prev = {}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          x, y = cur\n          for dx, dy in dirs:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height:\n                  if (nx, ny) not in visited and not grid[nx, ny].any():\n                      visited.add((nx, ny))\n                      prev[(nx, ny)] = (cur, (dx, dy))\n                      q.append((nx, ny))\n      if start == goal:\n          return []\n      if goal not in prev:\n          return []  # no path found\n      # reconstruct path\n      path = []\n      cur = goal\n      while cur != start:\n          prev_node, move = prev[cur]\n          path.append(move)\n          cur = prev_node\n      path.reverse()\n      return path\n\n  # ----------------------------------------------------------------------\n  # Identify the recipe for a stick\n  # ----------------------------------------------------------------------\n  stick_idx = env.world.cookbook.index[\"stick\"]\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  primitive_needs = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive the needed number of times\n  # ----------------------------------------------------------------------\n  for prim_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          prim_cells = find_cells(prim_idx)\n          if not prim_cells:\n              continue  # primitive not present; skip\n          tx, ty = prim_cells[0]\n\n          # Try to stand on a free neighbour from which we can USE the primitive\n          neighbour_found = False\n          for dx, dy in dirs:\n              nx, ny = tx - dx, ty - dy  # cell opposite the direction we will face\n              if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  # Face the primitive\n                  actions.append(dir_action[(-dx, -dy)])\n                  state.dir = dir_action[(-dx, -dy)]\n                  # Pick up\n                  actions.append(4)  # USE\n                  neighbour_found = True\n                  break\n\n          if not neighbour_found:\n              # Fallback: any adjacent free cell, then turn towards primitive\n              for dx, dy in dirs:\n                  nx, ny = tx + dx, ty + dy\n                  if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                      path = bfs(state.pos, (nx, ny))\n                      for mv in path:\n                          actions.append(dir_action[mv])\n                          state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                          state.dir = dir_action[mv]\n                      actions.append(dir_action[(-dx, -dy)])\n                      state.dir = dir_action[(-dx, -dy)]\n                      actions.append(4)  # USE\n                      neighbour_found = True\n                      break\n\n  # ----------------------------------------------------------------------\n  # If the recipe requires a workshop, move there and craft the stick\n  # ----------------------------------------------------------------------\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      workshop_cells = find_cells(workshop_idx)\n      if workshop_cells:\n          wx, wy = workshop_cells[0]\n          # Find a free neighbour to stand on\n          for dx, dy in dirs:\n              nx, ny = wx - dx, wy - dy\n              if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  actions.append(4)  # USE to craft the stick\n                  break\n\n  return actions", "env_interactions": 8, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-23T03:15:04.312613", "function_name": "make_arrow", "function_body": "  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions from start to goal using\n      horizontal\u2011then\u2011vertical moves (ignores obstacles).\"\"\"\n      x, y = start\n      gx, gy = goal\n      actions = []\n      while x < gx:\n          actions.append(ACTION_RIGHT)\n          x += 1\n      while x > gx:\n          actions.append(ACTION_LEFT)\n          x -= 1\n      while y < gy:\n          actions.append(ACTION_DOWN)\n          y += 1\n      while y > gy:\n          actions.append(ACTION_UP)\n          y -= 1\n      return actions\n\n  def nearest_position(positions, reference):\n      \"\"\"Pick the position from *positions* with smallest Manhattan distance\n      to *reference*.\"\"\"\n      if len(positions) == 0:\n          return None\n      ref = np.array(reference)\n      dists = np.sum(np.abs(positions - ref), axis=1)\n      return tuple(positions[np.argmin(dists)])\n\n  # ------------------------------------------------------------------\n  # Gather current state information\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n\n  # ------------------------------------------------------------------\n  # Identify goal (stick)\n  # ------------------------------------------------------------------\n  goal_name = \"stick\"\n  try:\n      goal_idx = env.world.cookbook.index[goal_name]\n  except Exception:\n      # Goal not present \u2013 nothing to do\n      return []\n\n  # If we already have a stick, no actions needed\n  if inventory[goal_idx] > 0:\n      return []\n\n  plan_actions = []\n\n  # ------------------------------------------------------------------\n  # 1) Collect required primitives (if any)\n  # ------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  for prim_idx, needed_cnt in primitives_needed.items():\n      while inventory[prim_idx] < needed_cnt:\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # No more primitives of this type on the map \u2013 abort planning\n              return plan_actions\n          target = nearest_position(prim_cells, pos)\n\n          # Move to the primitive\n          plan_actions.extend(manhattan_path(pos, target))\n          pos = target\n\n          # Pick it up\n          plan_actions.append(ACTION_USE)\n\n          # Simulate the effect locally for further planning\n          inventory[prim_idx] += 1\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # ------------------------------------------------------------------\n  # 2) If stick itself is a primitive (no recipe), just pick it up\n  # ------------------------------------------------------------------\n  if goal_idx not in env.world.cookbook.recipes:\n      stick_cells = np.argwhere(grid[:, :, goal_idx] > 0)\n      if stick_cells.size == 0:\n          return plan_actions\n      target = nearest_position(stick_cells, pos)\n\n      plan_actions.extend(manhattan_path(pos, target))\n      pos = target\n      plan_actions.append(ACTION_USE)\n      return plan_actions\n\n  # ------------------------------------------------------------------\n  # 3) Go to required workshop and craft the stick\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      try:\n          workshop_idx = env.world.cookbook.index[workshop_name]\n      except Exception:\n          return plan_actions\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          return plan_actions\n      wcell = tuple(workshop_cells[0])\n\n      # Find a free adjacent cell to stand on\n      neighbours = [(wcell[0] + dx, wcell[1] + dy) for dx, dy in\n                    [(1, 0), (-1, 0), (0, 1), (0, -1)]]\n      stand_pos = None\n      for nx, ny in neighbours:\n          if (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and\n                  grid[nx, ny, :].sum() == 0):\n              stand_pos = (nx, ny)\n              break\n      if stand_pos is None:\n          stand_pos = wcell  # fallback to the workshop cell itself\n\n      plan_actions.extend(manhattan_path(pos, stand_pos))\n      pos = stand_pos\n\n      # Craft the stick\n      plan_actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # Return the constructed action list\n  # ------------------------------------------------------------------\n  return plan_actions", "env_interactions": 5, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:15:05.641498", "function_name": "make_arrow", "function_body": "  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Horizontal\u2011then\u2011vertical movement actions from start to goal.\"\"\"\n      x, y = start\n      gx, gy = goal\n      actions = []\n      while x < gx:\n          actions.append(ACTION_RIGHT)\n          x += 1\n      while x > gx:\n          actions.append(ACTION_LEFT)\n          x -= 1\n      while y < gy:\n          actions.append(ACTION_DOWN)\n          y += 1\n      while y > gy:\n          actions.append(ACTION_UP)\n          y -= 1\n      return actions\n\n  def nearest_position(positions, reference):\n      \"\"\"Select the position with smallest Manhattan distance to reference.\"\"\"\n      if len(positions) == 0:\n          return None\n      ref = np.array(reference)\n      dists = np.sum(np.abs(positions - ref), axis=1)\n      return tuple(positions[np.argmin(dists)])\n\n  # ------------------------------------------------------------------\n  # Gather current state\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n\n  # ------------------------------------------------------------------\n  # Identify goal (stick)\n  # ------------------------------------------------------------------\n  goal_name = \"stick\"\n  try:\n      goal_idx = env.world.cookbook.index[goal_name]\n  except Exception:\n      # Goal not defined in this world\n      return []\n\n  # Already have a stick?\n  if inventory[goal_idx] > 0:\n      return []\n\n  plan_actions = []\n\n  # ------------------------------------------------------------------\n  # 1) Collect any required primitives\n  # ------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  for prim_idx, needed_cnt in primitives_needed.items():\n      while inventory[prim_idx] < needed_cnt:\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # No more of this primitive on the map \u2013 abort planning\n              return plan_actions\n          target = nearest_position(prim_cells, pos)\n\n          # Move to the primitive\n          plan_actions.extend(manhattan_path(pos, target))\n          pos = target\n\n          # Pick it up\n          plan_actions.append(ACTION_USE)\n\n          # Simulate local effect for further planning\n          inventory[prim_idx] += 1\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # ------------------------------------------------------------------\n  # 2) If the stick itself is a primitive (no recipe), just pick it up\n  # ------------------------------------------------------------------\n  if goal_idx not in env.world.cookbook.recipes:\n      stick_cells = np.argwhere(grid[:, :, goal_idx] > 0)\n      if stick_cells.size == 0:\n          return plan_actions\n      target = nearest_position(stick_cells, pos)\n\n      plan_actions.extend(manhattan_path(pos, target))\n      pos = target\n      plan_actions.append(ACTION_USE)\n      return plan_actions\n\n  # ------------------------------------------------------------------\n  # 3) Go to the required workshop and craft the stick\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      try:\n          workshop_idx = env.world.cookbook.index[workshop_name]\n      except Exception:\n          return plan_actions\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          return plan_actions\n      wcell = tuple(workshop_cells[0])\n\n      # Find a free adjacent cell to stand on\n      neighbours = [(wcell[0] + dx, wcell[1] + dy) for dx, dy in\n                    [(1, 0), (-1, 0), (0, 1), (0, -1)]]\n      stand_pos = None\n      for nx, ny in neighbours:\n          if (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and\n                  grid[nx, ny, :].sum() == 0):\n              stand_pos = (nx, ny)\n              break\n      if stand_pos is None:\n          stand_pos = wcell  # fallback to workshop cell itself\n\n      plan_actions.extend(manhattan_path(pos, stand_pos))\n      pos = stand_pos\n\n      # Craft the stick\n      plan_actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # Return the compiled action list\n  # ------------------------------------------------------------------\n  return plan_actions", "env_interactions": 5, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:15:25.873969", "function_name": "make_arrow", "function_body": "  def _move_actions(cur_pos, target):\n      actions = []\n      x, y = cur_pos\n      tx, ty = target\n      while x < tx:\n          actions.append(3)   # RIGHT\n          x += 1\n      while x > tx:\n          actions.append(2)   # LEFT\n          x -= 1\n      while y < ty:\n          actions.append(0)   # DOWN\n          y += 1\n      while y > ty:\n          actions.append(1)   # UP\n          y -= 1\n      return actions, (x, y)\n\n  state = env._current_state\n  cookbook = env.world.cookbook\n  stick_idx = cookbook.index['stick']\n\n  # 1. Already have a stick in inventory.\n  if state.inventory[stick_idx] > 0:\n      return []\n\n  # 2. Look for a stick already placed on the grid.\n  stick_cells = np.argwhere(state.grid[:, :, stick_idx] > 0)\n  if stick_cells.size > 0:\n      target = tuple(stick_cells[0])\n      moves, _ = _move_actions(state.pos, target)\n      moves.append(4)                       # USE to pick it up\n      return moves\n\n  # 3. Need to craft a stick.\n  primitive_req = cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n  recipe = cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = cookbook.index[workshop_name] if workshop_name is not None else None\n\n  actions = []\n  cur_pos = state.pos\n  inventory = state.inventory.copy()\n\n  # 4. Collect each needed primitive.\n  for prim_idx, needed in primitive_req.items():\n      while inventory[prim_idx] < needed:\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # No more of this primitive on the map \u2013 abort planning.\n              return actions\n          target = tuple(prim_cells[0])\n          moves, cur_pos = _move_actions(cur_pos, target)\n          actions.extend(moves)\n          actions.append(4)                # USE to pick up primitive\n          inventory[prim_idx] += 1\n\n  # 5. Go to the workshop (if required) and craft the stick.\n  if workshop_idx is not None:\n      ws_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if ws_cells.size == 0:\n          # Required workshop not present \u2013 abort.\n          return actions\n      target = tuple(ws_cells[0])\n      moves, cur_pos = _move_actions(cur_pos, target)\n      actions.extend(moves)\n      actions.append(4)                    # USE to craft stick at workshop\n  else:\n      # No specific workshop needed; craft at current location.\n      actions.append(4)\n\n  return actions", "env_interactions": 4, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:15:27.195499", "function_name": "make_arrow", "function_body": "  # Helper to compute move actions between two positions.\n  def _move_actions(cur_pos, target):\n      actions = []\n      x, y = cur_pos\n      tx, ty = target\n      while x < tx:\n          actions.append(3)   # RIGHT\n          x += 1\n      while x > tx:\n          actions.append(2)   # LEFT\n          x -= 1\n      while y < ty:\n          actions.append(0)   # DOWN\n          y += 1\n      while y > ty:\n          actions.append(1)   # UP\n          y -= 1\n      return actions, (x, y)\n\n  state = env._current_state\n  cookbook = env.world.cookbook\n  stick_idx = cookbook.index['stick']\n\n  # 1. Already have a stick in inventory.\n  if state.inventory[stick_idx] > 0:\n      return []\n\n  # 2. If stick is a primitive resource, just pick it up from the grid.\n  if stick_idx in cookbook.primitives:\n      stick_cells = np.argwhere(state.grid[:, :, stick_idx] > 0)\n      if stick_cells.size == 0:\n          return []                     # no stick available on map\n      target = tuple(stick_cells[0])\n      moves, _ = _move_actions(state.pos, target)\n      moves.append(4)                    # USE to collect\n      return moves\n\n  # 3. Look for an already\u2011crafted stick placed on the grid.\n  stick_cells = np.argwhere(state.grid[:, :, stick_idx] > 0)\n  if stick_cells.size > 0:\n      target = tuple(stick_cells[0])\n      moves, _ = _move_actions(state.pos, target)\n      moves.append(4)                    # USE to pick it up\n      return moves\n\n  # 4. Need to craft a stick.\n  #    a) Determine primitive requirements.\n  primitive_req = cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n  #    b) Find required workshop (if any).\n  recipe = cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = cookbook.index[workshop_name] if workshop_name is not None else None\n\n  actions = []\n  cur_pos = state.pos\n  inventory = state.inventory.copy()\n\n  # 5. Collect each needed primitive.\n  for prim_idx, needed in primitive_req.items():\n      while inventory[prim_idx] < needed:\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # Primitive not present on the map \u2013 abort planning.\n              return actions\n          target = tuple(prim_cells[0])\n          moves, cur_pos = _move_actions(cur_pos, target)\n          actions.extend(moves)\n          actions.append(4)                # USE to pick up primitive\n          inventory[prim_idx] += 1\n\n  # 6. Go to the workshop (if required) and craft the stick.\n  if workshop_idx is not None:\n      ws_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if ws_cells.size == 0:\n          # Required workshop missing \u2013 abort.\n          return actions\n      target = tuple(ws_cells[0])\n      moves, cur_pos = _move_actions(cur_pos, target)\n      actions.extend(moves)\n      actions.append(4)                    # USE to craft at workshop\n  else:\n      # No specific workshop needed; craft at current location.\n      actions.append(4)                    # USE to craft\n\n  return actions", "env_interactions": 4, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:15:45.192995", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  goal_idx = env.task.goal\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # -----------------------------------------------------------------\n  # Helper utilities\n  # -----------------------------------------------------------------\n  def find_positions(kind):\n      \"\"\"Return list of (x, y) cells containing the given kind.\"\"\"\n      locs = np.argwhere(state.grid[:, :, kind] > 0)\n      return [tuple(p) for p in locs]\n\n  def nearest(pos, kind):\n      \"\"\"Manhattan\u2011closest cell of the requested kind.\"\"\"\n      positions = find_positions(kind)\n      if not positions:\n          return None\n      return min(positions, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n\n  def moves_to(src, dst):\n      \"\"\"Sequence of movement actions (DOWN=0, UP=1, LEFT=2, RIGHT=3)\n      that walks from src to dst using a simple Manhattan path.\"\"\"\n      sx, sy = src\n      dx, dy = dst\n      seq = []\n      while sx < dx:\n          seq.append(0)   # DOWN\n          sx += 1\n      while sx > dx:\n          seq.append(1)   # UP\n          sx -= 1\n      while sy < dy:\n          seq.append(3)   # RIGHT\n          sy += 1\n      while sy > dy:\n          seq.append(2)   # LEFT\n          sy -= 1\n      return seq\n\n  # -----------------------------------------------------------------\n  # 1) Primitive goal \u2013 just collect it.\n  # -----------------------------------------------------------------\n  if not env.world.cookbook.primitives_for(goal_idx):\n      target = nearest(cur_pos, goal_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)   # USE\n      return actions\n\n  # -----------------------------------------------------------------\n  # 2) Gather required primitive ingredients.\n  # -----------------------------------------------------------------\n  needed_prims = env.world.cookbook.primitives_for(goal_idx)\n  for prim_idx, count in needed_prims.items():\n      for _ in range(count):\n          target = nearest(cur_pos, prim_idx)\n          if target is None:\n              # Primitive not present \u2013 skip (will cause failure later if impossible)\n              continue\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n          actions.append(4)   # pick up primitive\n\n  # -----------------------------------------------------------------\n  # 3) Move to workshop (if any) and craft the stick.\n  # -----------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  if isinstance(recipe, dict):\n      workshop_idx = recipe.get('_at')\n      if workshop_idx is None:\n          # Fallback: look for any string key that maps to a workshop index\n          for k, v in recipe.items():\n              if isinstance(k, str) and k != '_at':\n                  workshop_idx = v\n                  break\n\n  if workshop_idx is not None:\n      target = nearest(cur_pos, workshop_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)   # USE at workshop to craft\n  else:\n      # No explicit workshop \u2013 attempt to craft at current location.\n      actions.append(4)\n\n  return actions", "env_interactions": 1, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:15:46.508839", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  goal_idx = env.task.goal\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  def find_positions(kind):\n      locs = np.argwhere(state.grid[:, :, kind] > 0)\n      return [tuple(p) for p in locs]\n\n  def nearest(pos, kind):\n      positions = find_positions(kind)\n      if not positions:\n          return None\n      return min(positions, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n\n  def moves_to(src, dst):\n      sx, sy = src\n      dx, dy = dst\n      seq = []\n      while sx < dx:\n          seq.append(0)   # DOWN\n          sx += 1\n      while sx > dx:\n          seq.append(1)   # UP\n          sx -= 1\n      while sy < dy:\n          seq.append(3)   # RIGHT\n          sy += 1\n      while sy > dy:\n          seq.append(2)   # LEFT\n          sy -= 1\n      return seq\n\n  # If the goal is a primitive, just collect it.\n  if not env.world.cookbook.primitives_for(goal_idx):\n      target = nearest(cur_pos, goal_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)   # USE\n      return actions\n\n  # Gather required primitive ingredients.\n  needed_prims = env.world.cookbook.primitives_for(goal_idx)\n  for prim_idx, count in needed_prims.items():\n      for _ in range(count):\n          target = nearest(cur_pos, prim_idx)\n          if target is None:\n              continue\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n          actions.append(4)   # USE to pick up primitive\n\n  # Move to workshop (if any) and craft the stick.\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  if isinstance(recipe, dict):\n      workshop_idx = recipe.get('_at')\n      if workshop_idx is None:\n          for k, v in recipe.items():\n              if isinstance(k, str) and k != '_at':\n                  workshop_idx = v\n                  break\n\n  if workshop_idx is not None:\n      target = nearest(cur_pos, workshop_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)   # USE at workshop to craft\n  else:\n      # No explicit workshop; attempt crafting at current location.\n      actions.append(4)\n\n  return actions", "env_interactions": 1, "island_id": 0, "scores": {"3": 0.0}}
