{"timestamp": "2025-10-23T02:59:59.836805", "function_name": "make_arrow", "function_body": "  # Action indices\n  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act.get(\"DOWN\", 0),\n      act.get(\"UP\", 1),\n      act.get(\"LEFT\", 2),\n      act.get(\"RIGHT\", 3),\n      act.get(\"USE\", 4),\n  )\n\n  # Snapshot of current state\n  state = env._current_state\n  grid = state.grid.copy()                 # (W, H, n_kinds)\n  cur_pos = tuple(state.pos)               # (x, y)\n\n  # Index of the goal item \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n      if stick_idx is None:\n          return []   # stick not defined in the world\n\n  # Primitive requirements for a stick\n  recipe = env.world.cookbook.primitives_for(stick_idx)   # dict {kind_idx: count}\n  primitive_needs = {k: v for k, v in recipe.items() if isinstance(k, int)}\n\n  # If stick itself is a primitive (no recipe), we need to collect one stick\n  if not primitive_needs:\n      primitive_needs = {stick_idx: 1}\n\n  # Detect workshop index (if any) from the recipe\n  workshop_idx = None\n  for k, v in recipe.items():\n      if not isinstance(k, int):\n          workshop_idx = v if isinstance(v, int) else None\n          break\n\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # Helper: find the closest cell that still has at least one of the given kind\n  # ----------------------------------------------------------------------\n  def find_closest(kind_idx, cur):\n      positions = np.argwhere(grid[:, :, kind_idx] > 0)\n      if positions.shape[0] == 0:\n          return None\n      dists = np.sum(np.abs(positions - np.array(cur)), axis=1)\n      nearest = positions[np.argmin(dists)]\n      return tuple(nearest.tolist())\n\n  # ----------------------------------------------------------------------\n  # Helper: generate a simple Manhattan path (greedy) from cur to target\n  # ----------------------------------------------------------------------\n  def path_to(cur, target):\n      x, y = cur\n      tx, ty = target\n      path = []\n      while (x, y) != (tx, ty):\n          if x < tx:\n              path.append(RIGHT)\n              x += 1\n          elif x > tx:\n              path.append(LEFT)\n              x -= 1\n          elif y < ty:\n              path.append(DOWN)\n              y += 1\n          elif y > ty:\n              path.append(UP)\n              y -= 1\n      return path, (x, y)\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive the needed number of times\n  # ----------------------------------------------------------------------\n  for kind_idx, needed in primitive_needs.items():\n      while needed > 0:\n          target = find_closest(kind_idx, cur_pos)\n          if target is None:\n              # No more of this primitive on the map \u2013 abort planning\n              return actions\n          move_actions, cur_pos = path_to(cur_pos, target)\n          actions.extend(move_actions)\n          actions.append(USE)   # pick up / use the primitive\n\n          # Update local grid copy to reflect the collection\n          grid[target[0], target[1], kind_idx] = max(\n              0, grid[target[0], target[1], kind_idx] - 1\n          )\n          needed -= 1\n\n  # ----------------------------------------------------------------------\n  # If a workshop is required, move to it and craft the stick\n  # ----------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_target = find_closest(workshop_idx, cur_pos)\n      if ws_target is not None:\n          move_actions, cur_pos = path_to(cur_pos, ws_target)\n          actions.extend(move_actions)\n          actions.append(USE)   # craft stick at the workshop\n\n  return actions", "env_interactions": 2, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:00:31.518691", "function_name": "make_arrow", "function_body": "  # reset environment and get initial state\n  env.reset()\n  state = env._current_state\n  grid = state.grid\n  width, height = grid.shape[:2]\n\n  # movement vectors and corresponding action ids (DOWN=0, UP=1, LEFT=2, RIGHT=3)\n  dirs = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n  dir_action = {(0, 1): 0, (0, -1): 1, (-1, 0): 2, (1, 0): 3}\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def find_cells(kind):\n      \"\"\"Return list of (x, y) coordinates where `kind` is present.\"\"\"\n      xs, ys = np.where(grid[:, :, kind] > 0)\n      return list(zip(xs.tolist(), ys.tolist()))\n\n  from collections import deque\n\n  def bfs(start, goal):\n      \"\"\"Return a list of (dx, dy) moves from start to goal avoiding occupied cells.\"\"\"\n      if start == goal:\n          return []\n      q = deque([start])\n      visited = {start}\n      prev = {}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          x, y = cur\n          for dx, dy in dirs:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height:\n                  if (nx, ny) not in visited and not grid[nx, ny].any():\n                      visited.add((nx, ny))\n                      prev[(nx, ny)] = (cur, (dx, dy))\n                      q.append((nx, ny))\n      if goal not in prev:\n          return []  # no path found\n      # reconstruct path\n      path = []\n      cur = goal\n      while cur != start:\n          pnode, move = prev[cur]\n          path.append(move)\n          cur = pnode\n      path.reverse()\n      return path\n\n  # ------------------------------------------------------------------\n  # Identify stick recipe\n  # ------------------------------------------------------------------\n  stick_idx = env.world.cookbook.index.get(\"stick\")\n  if stick_idx is None:\n      return actions  # no stick defined in this world\n\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  primitive_needs = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  # ------------------------------------------------------------------\n  # Collect required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          prim_cells = find_cells(prim_idx)\n          if not prim_cells:\n              continue  # primitive not present in the map\n          tx, ty = prim_cells[0]\n\n          collected = False\n          # Try to stand on a free neighbour opposite the direction we will face\n          for dx, dy in dirs:\n              nx, ny = tx - dx, ty - dy\n              if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  # Face the primitive\n                  actions.append(dir_action[(-dx, -dy)])\n                  state.dir = dir_action[(-dx, -dy)]\n                  # Pick it up\n                  actions.append(4)  # USE\n                  collected = True\n                  break\n\n          if not collected:\n              # Fallback: any adjacent free cell, then turn towards the primitive\n              for dx, dy in dirs:\n                  nx, ny = tx + dx, ty + dy\n                  if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                      path = bfs(state.pos, (nx, ny))\n                      for mv in path:\n                          actions.append(dir_action[mv])\n                          state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                          state.dir = dir_action[mv]\n                      actions.append(dir_action[(-dx, -dy)])\n                      state.dir = dir_action[(-dx, -dy)]\n                      actions.append(4)  # USE\n                      break\n\n  # ------------------------------------------------------------------\n  # Craft the stick at its required workshop (if any)\n  # ------------------------------------------------------------------\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      wk_idx = env.world.cookbook.index[workshop_name]\n      wk_cells = find_cells(wk_idx)\n      if wk_cells:\n          wx, wy = wk_cells[0]\n          for dx, dy in dirs:\n              nx, ny = wx - dx, wy - dy\n              if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  actions.append(4)  # USE to craft\n                  break\n\n  return actions", "env_interactions": 0, "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-10-23T03:00:32.851192", "function_name": "make_arrow", "function_body": "  # Reset environment and get initial state information\n  env.reset()\n  state = env._current_state\n  grid = state.grid\n  width, height = grid.shape[:2]\n\n  # Movement vectors and corresponding action IDs (DOWN=0, UP=1, LEFT=2, RIGHT=3)\n  dirs = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n  dir_action = {(0, 1): 0, (0, -1): 1, (-1, 0): 2, (1, 0): 3}\n\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # Helper utilities\n  # ----------------------------------------------------------------------\n  def find_cells(kind):\n      \"\"\"Return list of (x, y) positions where a given kind is present.\"\"\"\n      xs, ys = np.where(grid[:, :, kind] > 0)\n      return list(zip(xs.tolist(), ys.tolist()))\n\n  from collections import deque\n\n  def bfs(start, goal):\n      \"\"\"\n      Bread\u2011first search on the current grid (ignoring occupied cells).\n      Returns a list of (dx, dy) moves to get from start to goal.\n      \"\"\"\n      if start == goal:\n          return []\n      q = deque([start])\n      visited = {start}\n      prev = {}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          x, y = cur\n          for dx, dy in dirs:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height:\n                  if (nx, ny) not in visited and not np.any(grid[nx, ny, :]):\n                      visited.add((nx, ny))\n                      prev[(nx, ny)] = (cur, (dx, dy))\n                      q.append((nx, ny))\n      if goal not in prev:\n          return []  # no reachable path\n      # reconstruct move list\n      path = []\n      cur = goal\n      while cur != start:\n          pnode, move = prev[cur]\n          path.append(move)\n          cur = pnode\n      path.reverse()\n      return path\n\n  # ----------------------------------------------------------------------\n  # Identify the recipe for a stick\n  # ----------------------------------------------------------------------\n  stick_idx = env.world.cookbook.index[\"stick\"]\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  primitive_needs = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive the needed number of times\n  # ----------------------------------------------------------------------\n  for prim_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          prim_cells = find_cells(prim_idx)\n          if not prim_cells:\n              continue  # primitive not present on the map\n          tx, ty = prim_cells[0]\n\n          # Try to stand on a free neighbour opposite the direction we will face\n          neighbour_found = False\n          for dx, dy in dirs:\n              nx, ny = tx - dx, ty - dy  # cell opposite the direction we will face\n              if 0 <= nx < width and 0 <= ny < height and not np.any(grid[nx, ny, :]):\n                  # Move to (nx, ny)\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  # Face the primitive\n                  actions.append(dir_action[(-dx, -dy)])\n                  state.dir = dir_action[(-dx, -dy)]\n                  # Pick up / use\n                  actions.append(4)  # USE action\n                  neighbour_found = True\n                  break\n\n          if not neighbour_found:\n              # Fallback: any adjacent free cell, then turn towards the primitive\n              for dx, dy in dirs:\n                  nx, ny = tx + dx, ty + dy\n                  if 0 <= nx < width and 0 <= ny < height and not np.any(grid[nx, ny, :]):\n                      path = bfs(state.pos, (nx, ny))\n                      for mv in path:\n                          actions.append(dir_action[mv])\n                          state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                          state.dir = dir_action[mv]\n                      actions.append(dir_action[(-dx, -dy)])\n                      state.dir = dir_action[(-dx, -dy)]\n                      actions.append(4)  # USE\n                      neighbour_found = True\n                      break\n\n  # ----------------------------------------------------------------------\n  # If the stick recipe requires a workshop, move there and craft the stick\n  # ----------------------------------------------------------------------\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      workshop_cells = find_cells(workshop_idx)\n      if workshop_cells:\n          wx, wy = workshop_cells[0]\n          # Locate a free neighbour to stand on\n          for dx, dy in dirs:\n              nx, ny = wx - dx, wy - dy\n              if 0 <= nx < width and 0 <= ny < height and not np.any(grid[nx, ny, :]):\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  # Use to craft the stick\n                  actions.append(4)  # USE\n                  break\n\n  return actions", "env_interactions": 8, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-23T03:00:50.771376", "function_name": "make_arrow", "function_body": "  actions = []\n  state = env._current_state\n  grid = state.grid\n  world = env.world\n  cb = world.cookbook\n\n  # index of the target item \"stick\"\n  try:\n      goal_idx = cb.index[\"stick\"]\n  except Exception:\n      return actions\n\n  # primitive requirements for the stick (may be empty if stick is primitive)\n  prims = cb.primitives_for(goal_idx)\n\n  # mutable copy of current position\n  pos = list(state.pos)\n\n  # helper to move to a target cell using Manhattan steps\n  def _move_to(target):\n      nonlocal pos, actions\n      tx, ty = target\n      while pos[0] < tx:\n          actions.append(3)   # RIGHT\n          pos[0] += 1\n      while pos[0] > tx:\n          actions.append(2)   # LEFT\n          pos[0] -= 1\n      while pos[1] < ty:\n          actions.append(0)   # DOWN\n          pos[1] += 1\n      while pos[1] > ty:\n          actions.append(1)   # UP\n          pos[1] -= 1\n\n  # Collect each required primitive\n  for prim_idx, needed in prims.items():\n      locations = np.argwhere(grid[:, :, prim_idx] > 0)\n      if locations.size == 0:\n          continue  # primitive not found; skip\n      target = locations[0].tolist()  # pick first occurrence\n      _move_to(target)\n      for _ in range(needed):\n          actions.append(4)   # USE to pick up one unit\n\n  # If the recipe specifies a workshop, move there and craft the stick\n  recipe = cb.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = cb.index[workshop_name]\n      w_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if w_locs.size:\n          w_target = w_locs[0].tolist()\n          _move_to(w_target)\n          actions.append(4)   # USE to craft at the workshop\n\n  return actions", "env_interactions": 4, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:00:52.165786", "function_name": "make_arrow", "function_body": "  actions = []\n  state = env._current_state\n  grid = state.grid\n  world = env.world\n  cb = world.cookbook\n\n  # index of the target item \"stick\"\n  try:\n      stick_idx = cb.index[\"stick\"]\n  except Exception:\n      return actions\n\n  # if we already have a stick, nothing to do\n  if state.inventory[stick_idx] > 0:\n      return actions\n\n  # primitives required to craft a stick (may be empty if stick is primitive)\n  prims = cb.primitives_for(stick_idx)\n\n  # mutable copy of the agent position\n  pos = list(state.pos)\n\n  # helper to move using Manhattan steps (DOWN=0, UP=1, LEFT=2, RIGHT=3)\n  def _move_to(target):\n      nonlocal pos, actions\n      tx, ty = target\n      while pos[0] < tx:\n          actions.append(3)   # RIGHT\n          pos[0] += 1\n      while pos[0] > tx:\n          actions.append(2)   # LEFT\n          pos[0] -= 1\n      while pos[1] < ty:\n          actions.append(0)   # DOWN\n          pos[1] += 1\n      while pos[1] > ty:\n          actions.append(1)   # UP\n          pos[1] -= 1\n\n  # collect required primitives\n  for prim_idx, needed in prims.items():\n      locs = np.argwhere(grid[:, :, prim_idx] > 0)\n      if locs.size == 0:\n          continue  # primitive not present in the world\n      target = locs[0].tolist()          # pick the first occurrence\n      _move_to(target)\n      for _ in range(needed):\n          actions.append(4)               # USE to pick up one unit\n\n  # if stick itself is a primitive (no recipe), just pick it up\n  if not prims and not cb.recipes.get(stick_idx):\n      locs = np.argwhere(grid[:, :, stick_idx] > 0)\n      if locs.size:\n          target = locs[0].tolist()\n          _move_to(target)\n          actions.append(4)               # USE to pick up the stick\n      return actions\n\n  # move to the workshop (if the recipe specifies one) and craft the stick\n  recipe = cb.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = cb.index[workshop_name]\n      w_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if w_locs.size:\n          w_target = w_locs[0].tolist()\n          _move_to(w_target)\n          actions.append(4)               # USE to craft at the workshop\n\n  return actions", "env_interactions": 4, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:01:04.536088", "function_name": "make_arrow", "function_body": "  # Reset the environment to start a fresh episode\n  env.reset()\n  goal_idx = env.task.goal\n\n  # If the goal has no recipe (i.e., it is a primitive that can be collected directly),\n  # we can simply keep trying to USE the cell we are facing until we obtain it.\n  # Otherwise we still need to explore and USE, because crafting will be handled\n  # automatically by the environment when the required ingredients are present.\n  actions = []\n\n  # Action indices according to CraftLab.action_specs():\n  # DOWN \u2192 0, UP \u2192 1, LEFT \u2192 2, RIGHT \u2192 3, USE \u2192 4\n  move_cycle = [0, 1, 2, 3]  # simple square\u2011walk pattern\n\n  # Perform a fixed\u2011length open\u2011loop exploration.\n  # After each move we issue a USE action to pick up or craft.\n  for i in range(60):          # enough steps for most small maps\n      actions.append(move_cycle[i % 4])\n      actions.append(4)        # USE\n\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-10-23T03:01:05.831294", "function_name": "make_arrow", "function_body": "  env.reset()\n  goal_idx = env.task.goal\n  # Determine required primitives for the goal.\n  needed = env.world.cookbook.primitives_for(goal_idx)\n  # If the goal is a primitive (no recipe), just try to pick it up.\n  if not needed:\n      return [4]  # USE action\n\n  # Estimate a safe number of USE actions: each primitive may need to be\n  # collected multiple times.  We overshoot to increase chance of success.\n  total_needed = sum(needed.values())\n  # Simple movement pattern: cycle through the four cardinal directions.\n  move_cycle = [2, 0, 3, 1]  # LEFT, DOWN, RIGHT, UP (action indices)\n  actions = []\n  # Produce a sequence long enough to gather resources and reach the workshop.\n  for i in range(total_needed * 20):\n      actions.append(move_cycle[i % len(move_cycle)])\n      actions.append(4)  # USE after each move\n  return actions", "env_interactions": 1, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:01:32.974897", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n  stick_idx = cookbook.index['stick']\n\n  # If we already have a stick in inventory, nothing to do.\n  if state.inventory[stick_idx] > 0:\n      return []\n\n  actions = []\n  cur_pos = state.pos\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def move_to(tx, ty, pos, act_list):\n      \"\"\"Append moves that bring the agent from pos to (tx, ty).\"\"\"\n      x, y = pos\n      while x < tx:\n          act_list.append(3)   # RIGHT\n          x += 1\n      while x > tx:\n          act_list.append(2)   # LEFT\n          x -= 1\n      while y < ty:\n          act_list.append(0)   # DOWN\n          y += 1\n      while y > ty:\n          act_list.append(1)   # UP\n          y -= 1\n      return (x, y)\n\n  def nearest_pos(kind_idx, cur_pos):\n      \"\"\"Return coordinates of the nearest cell containing kind_idx.\"\"\"\n      positions = np.argwhere(state.grid[:, :, kind_idx] > 0)\n      if positions.size == 0:\n          return None\n      dists = np.abs(positions[:, 0] - cur_pos[0]) + np.abs(positions[:, 1] - cur_pos[1])\n      best = positions[dists.argmin()]\n      return (int(best[0]), int(best[1]))\n\n  def go_and_pick(kind_idx, cur_pos, act_list):\n      \"\"\"Move to a cell with kind_idx and USE it.\"\"\"\n      target = nearest_pos(kind_idx, cur_pos)\n      if target is None:\n          return cur_pos, False\n      cur_pos = move_to(target[0], target[1], cur_pos, act_list)\n      act_list.append(4)               # USE / pick up / interact\n      return cur_pos, True\n\n  # ------------------------------------------------------------------\n  # 1) Stick is a primitive: just collect it.\n  # ------------------------------------------------------------------\n  if stick_idx in cookbook.primitives:\n      cur_pos, ok = go_and_pick(stick_idx, cur_pos, actions)\n      return actions if ok else []\n\n  # ------------------------------------------------------------------\n  # 2) Stick must be crafted: collect ingredients then craft at workshop.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get('_at')\n\n  # Gather all non\u2011workshop ingredients.\n  for ing_key, cnt in recipe.items():\n      if ing_key == '_at':\n          continue\n      ing_idx = ing_key if isinstance(ing_key, int) else cookbook.index[ing_key]\n      for _ in range(cnt):\n          # If ingredient is primitive, just pick it up.\n          # Otherwise, attempt to pick it up (could be a pre\u2011crafted item).\n          cur_pos, ok = go_and_pick(ing_idx, cur_pos, actions)\n          if not ok:\n              return []   # cannot satisfy the recipe\n\n  # Move to the required workshop (if any) before crafting.\n  if workshop_name is not None:\n      ws_idx = workshop_name if isinstance(workshop_name, int) else cookbook.index[workshop_name]\n      cur_pos, ok = go_and_pick(ws_idx, cur_pos, actions)\n      if not ok:\n          return []   # workshop not found\n\n  # Finally craft the stick.\n  actions.append(4)   # USE to craft at the workshop (or in place if no workshop)\n  return actions", "env_interactions": 5, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:01:34.254875", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n  stick_idx = cookbook.index['stick']\n\n  # If we already have a stick in inventory, nothing to do.\n  if state.inventory[stick_idx] > 0:\n      return []\n\n  actions = []\n  cur_pos = state.pos\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def move_to(tx, ty, pos, act_list):\n      \"\"\"Append moves that bring the agent from pos to (tx, ty).\"\"\"\n      x, y = pos\n      while x < tx:\n          act_list.append(3)   # RIGHT\n          x += 1\n      while x > tx:\n          act_list.append(2)   # LEFT\n          x -= 1\n      while y < ty:\n          act_list.append(0)   # DOWN\n          y += 1\n      while y > ty:\n          act_list.append(1)   # UP\n          y -= 1\n      return (x, y)\n\n  def nearest_pos(kind_idx, cur_pos):\n      \"\"\"Return the coordinates of the nearest cell containing kind_idx.\"\"\"\n      positions = np.argwhere(state.grid[:, :, kind_idx] > 0)\n      if positions.size == 0:\n          return None\n      dists = np.abs(positions[:, 0] - cur_pos[0]) + np.abs(positions[:, 1] - cur_pos[1])\n      best = positions[dists.argmin()]\n      return (int(best[0]), int(best[1]))\n\n  def go_and_pick(kind_idx, cur_pos, act_list):\n      \"\"\"Move to a cell with kind_idx and USE it.\"\"\"\n      target = nearest_pos(kind_idx, cur_pos)\n      if target is None:\n          return cur_pos, False\n      cur_pos = move_to(target[0], target[1], cur_pos, act_list)\n      act_list.append(4)               # USE / pick up / interact\n      return cur_pos, True\n  # ------------------------------------------------------------------\n\n  # ----- case 1: stick is a primitive (just collect it) -----\n  if stick_idx in cookbook.primitives:\n      cur_pos, ok = go_and_pick(stick_idx, cur_pos, actions)\n      return actions if ok else []\n\n  # ----- case 2: stick must be crafted -----------------------\n  recipe = cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get('_at')\n\n  # collect all non\u2011workshop ingredients\n  for ing_key, cnt in recipe.items():\n      if ing_key == '_at':\n          continue\n      ing_idx = ing_key if isinstance(ing_key, int) else cookbook.index[ing_key]\n      for _ in range(cnt):\n          cur_pos, ok = go_and_pick(ing_idx, cur_pos, actions)\n          if not ok:\n              return []                     # cannot satisfy the recipe\n\n  # move to workshop (if required) before crafting\n  if workshop_name is not None:\n      ws_idx = cookbook.index[workshop_name]\n      cur_pos, ok = go_and_pick(ws_idx, cur_pos, actions)\n      if not ok:\n          return []                         # workshop not found\n\n  # finally craft the stick\n  actions.append(4)                           # USE to craft\n  return actions", "env_interactions": 5, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:02:00.324663", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # Reset the environment to start a fresh episode and obtain the initial observation.\n  obs = env.reset()\n  # Access the internal state object \u2013 it holds the grid, position, etc.\n  state = env._current_state\n\n  # Identify the integer index that corresponds to the primitive \u201cstick\u201d.\n  # The cookbook\u2019s index maps item names to unique IDs.\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      # If the world does not expose the index mapping, fall back to a generic name.\n      # This keeps the function robust even if the attribute name differs.\n      stick_idx = None\n\n  # If we could not locate the stick index, simply return an empty action list.\n  if stick_idx is None:\n      return []\n\n  # Helper to check whether the inventory already contains a stick.\n  def have_stick(inv):\n      return inv[stick_idx] > 0\n\n  # Extract the inventory vector from the latest observation.\n  inventory = obs[\"features_dict\"][\"inventory\"]\n  if have_stick(inventory):\n      return []  # Already have the stick at the start.\n\n  # Action mapping \u2013 obtain the integer codes for movement and the USE action.\n  # The environment follows the convention: DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4.\n  action_map = env.action_specs()\n  # Ensure we have the expected keys; otherwise default to the usual ordering.\n  down = action_map.get(\"DOWN\", 0)\n  up = action_map.get(\"UP\", 1)\n  left = action_map.get(\"LEFT\", 2)\n  right = action_map.get(\"RIGHT\", 3)\n  use = action_map.get(\"USE\", 4)\n\n  # Simple deterministic exploration: walk in a spiral pattern while occasionally\n  # trying to USE (pick up) the item directly in front of the agent.\n  actions = []\n  max_steps = 2000  # safeguard against infinite loops\n  step_count = 0\n\n  # Direction vectors corresponding to the action order defined above.\n  dirs = {\n      down: (1, 0),\n      up: (-1, 0),\n      left: (0, -1),\n      right: (0, 1),\n  }\n\n  # Spiral walk parameters.\n  step_len = 1\n  dir_sequence = [right, down, left, up]  # clockwise spiral\n  dir_idx = 0\n\n  while step_count < max_steps:\n      # Check inventory after each step.\n      inventory = state.inventory\n      if have_stick(inventory):\n          break\n\n      # Try to pick up whatever is directly in front of the agent.\n      actions.append(int(use))\n      reward, done, obs = env.step(int(use))\n      step_count += 1\n      if done:\n          break\n      # Update internal reference after the step.\n      state = env._current_state\n\n      # After attempting to use, move according to the spiral pattern.\n      for _ in range(step_len):\n          move_action = dir_sequence[dir_idx % 4]\n          actions.append(int(move_action))\n          reward, done, obs = env.step(int(move_action))\n          step_count += 1\n          if done:\n              break\n          state = env._current_state\n\n          # After each move, attempt a USE again (in case we are now facing the stick).\n          actions.append(int(use))\n          reward, done, obs = env.step(int(use))\n          step_count += 1\n          if done:\n              break\n          state = env._current_state\n\n          # Check if we have obtained the stick.\n          if have_stick(state.inventory):\n              break\n      if have_stick(state.inventory):\n          break\n\n      # After completing moves in the current direction, turn to the next direction.\n      dir_idx += 1\n      # Increase step length every two direction changes (to create a spiral).\n      if dir_idx % 2 == 0:\n          step_len += 1\n\n  return actions", "env_interactions": 0, "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-10-23T03:02:01.603598", "function_name": "make_arrow", "function_body": "  # Get current state and relevant indices\n  state = env._current_state\n  goal_name = 'stick'\n  goal_idx = env.world.cookbook.index[goal_name]\n\n  # Determine which primitives are needed for a stick\n  needed = env.world.cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n  actions = []\n  pos = state.pos\n  grid = state.grid\n\n  # Helper to move the agent to a specific cell (Manhattan moves)\n  def move_to(target):\n      nonlocal pos, actions\n      # Move in x direction (first axis)\n      while pos[0] < target[0]:\n          actions.append(3)          # RIGHT\n          pos = (pos[0] + 1, pos[1])\n      while pos[0] > target[0]:\n          actions.append(2)          # LEFT\n          pos = (pos[0] - 1, pos[1])\n      # Move in y direction (second axis)\n      while pos[1] < target[1]:\n          actions.append(0)          # DOWN\n          pos = (pos[0], pos[1] + 1)\n      while pos[1] > target[1]:\n          actions.append(1)          # UP\n          pos = (pos[0], pos[1] - 1)\n\n  # Collect each required primitive\n  for prim_idx, cnt in needed.items():\n      # Find all cells that currently contain this primitive\n      locations = np.argwhere(grid[:, :, prim_idx] > 0)\n      for _ in range(cnt):\n          if len(locations) == 0:\n              break  # safety check\n          # Choose the nearest instance (Manhattan distance)\n          dists = np.sum(np.abs(locations - np.array([pos[0], pos[1]])), axis=1)\n          nearest_i = np.argmin(dists)\n          target_cell = tuple(locations[nearest_i].tolist())\n          # Move next to the primitive and pick it up\n          move_to(target_cell)\n          actions.append(4)          # USE (pick up)\n          # Remove this location from future consideration\n          locations = np.delete(locations, nearest_i, axis=0)\n\n  # After gathering primitives, go to the appropriate workshop and craft the stick\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if len(workshop_cells) > 0:\n          dists = np.sum(np.abs(workshop_cells - np.array([pos[0], pos[1]])), axis=1)\n          nearest_i = np.argmin(dists)\n          target_cell = tuple(workshop_cells[nearest_i].tolist())\n          move_to(target_cell)\n          actions.append(4)          # USE (craft)\n\n  return actions", "env_interactions": 4, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:02:25.017414", "function_name": "make_arrow", "function_body": "  def _move_to(cur_pos, target, act_seq):\n      x, y = cur_pos\n      tx, ty = target\n      while x < tx:\n          act_seq.append(3)  # RIGHT\n          x += 1\n      while x > tx:\n          act_seq.append(2)  # LEFT\n          x -= 1\n      while y < ty:\n          act_seq.append(0)  # DOWN\n          y += 1\n      while y > ty:\n          act_seq.append(1)  # UP\n          y -= 1\n      return (x, y)\n\n  state = env._current_state\n  grid = state.grid.copy()\n  cur_pos = state.pos\n  goal_idx = env.task.goal\n\n  # Retrieve recipe for the goal (may be empty if primitive)\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n  ingredients = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  actions = []\n\n  # Step 1: collect required ingredients\n  for ing_kind, count in ingredients.items():\n      for _ in range(count):\n          locations = np.argwhere(grid[:, :, ing_kind] > 0)\n          if locations.size == 0:\n              # Ingredient not available; stop early\n              break\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          chosen_idx = int(np.argmin(dists))\n          target_loc = tuple(locations[chosen_idx].tolist())\n\n          cur_pos = _move_to(cur_pos, target_loc, actions)\n          actions.append(4)  # USE to pick up\n          grid[target_loc[0], target_loc[1], ing_kind] = 0\n\n  # Step 2: if goal is primitive (no ingredients & no workshop), pick it up\n  if not ingredients and workshop_kind is None:\n      locs = np.argwhere(grid[:, :, goal_idx] > 0)\n      if locs.size > 0:\n          dists = np.abs(locs[:, 0] - cur_pos[0]) + np.abs(locs[:, 1] - cur_pos[1])\n          chosen_idx = int(np.argmin(dists))\n          target_loc = tuple(locs[chosen_idx].tolist())\n          cur_pos = _move_to(cur_pos, target_loc, actions)\n          actions.append(4)  # USE to pick up\n      return actions\n\n  # Step 3: move to workshop (if required) and craft the goal\n  if workshop_kind is not None:\n      ws_locs = np.argwhere(grid[:, :, workshop_kind] > 0)\n      if ws_locs.size > 0:\n          dists = np.abs(ws_locs[:, 0] - cur_pos[0]) + np.abs(ws_locs[:, 1] - cur_pos[1])\n          chosen_idx = int(np.argmin(dists))\n          workshop_loc = tuple(ws_locs[chosen_idx].tolist())\n          cur_pos = _move_to(cur_pos, workshop_loc, actions)\n          actions.append(4)  # USE to craft\n\n  return actions", "env_interactions": 0, "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:02:26.443985", "function_name": "make_arrow", "function_body": "  # Helper to move the agent from cur_pos to target, appending actions to seq.\n  def _move_to(cur_pos, target, seq):\n      x, y = cur_pos\n      tx, ty = target\n      while x < tx:\n          seq.append(3)  # RIGHT\n          x += 1\n      while x > tx:\n          seq.append(2)  # LEFT\n          x -= 1\n      while y < ty:\n          seq.append(0)  # DOWN\n          y += 1\n      while y > ty:\n          seq.append(1)  # UP\n          y -= 1\n      return (x, y)\n\n  # Current state information.\n  state = env._current_state\n  grid = state.grid.copy()\n  cur_pos = state.pos\n  goal_idx = env.task.goal\n\n  # Retrieve the recipe for the goal (if any).\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n  ingredients = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Collect required ingredients.\n  # ------------------------------------------------------------------\n  for ing_kind, count in ingredients.items():\n      for _ in range(count):\n          # Find all cells containing this ingredient.\n          locs = np.argwhere(grid[:, :, ing_kind] > 0)\n          if locs.size == 0:\n              # Ingredient not present; abort early.\n              return actions\n          # Choose the closest one (Manhattan distance).\n          dists = np.abs(locs[:, 0] - cur_pos[0]) + np.abs(locs[:, 1] - cur_pos[1])\n          chosen = int(np.argmin(dists))\n          target = tuple(locs[chosen].tolist())\n\n          # Move to the ingredient and pick it up.\n          cur_pos = _move_to(cur_pos, target, actions)\n          actions.append(4)                     # USE to pick up.\n          grid[target[0], target[1], ing_kind] = 0  # Remove from map.\n\n  # ------------------------------------------------------------------\n  # If the goal is a primitive (no recipe) just pick it up.\n  # ------------------------------------------------------------------\n  if not ingredients and workshop_kind is None:\n      locs = np.argwhere(grid[:, :, goal_idx] > 0)\n      if locs.size > 0:\n          dists = np.abs(locs[:, 0] - cur_pos[0]) + np.abs(locs[:, 1] - cur_pos[1])\n          chosen = int(np.argmin(dists))\n          target = tuple(locs[chosen].tolist())\n          cur_pos = _move_to(cur_pos, target, actions)\n          actions.append(4)                     # USE to pick up.\n      return actions\n\n  # ------------------------------------------------------------------\n  # If crafting requires a specific workshop, go there and craft.\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      ws_locs = np.argwhere(grid[:, :, workshop_kind] > 0)\n      if ws_locs.size > 0:\n          dists = np.abs(ws_locs[:, 0] - cur_pos[0]) + np.abs(ws_locs[:, 1] - cur_pos[1])\n          chosen = int(np.argmin(dists))\n          workshop = tuple(ws_locs[chosen].tolist())\n          cur_pos = _move_to(cur_pos, workshop, actions)\n          actions.append(4)                     # USE to craft at workshop.\n\n  return actions", "env_interactions": 0, "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:02:42.460350", "function_name": "make_arrow", "function_body": "  # ----- action mapping -------------------------------------------------\n  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act.get(\"DOWN\", 0),\n      act.get(\"UP\", 1),\n      act.get(\"LEFT\", 2),\n      act.get(\"RIGHT\", 3),\n      act.get(\"USE\", 4),\n  )\n\n  # ----- snapshot of current state (do not modify env) -----------------\n  state = env._current_state\n  grid = state.grid.copy()                 # (W, H, n_kinds)\n  cur_pos = tuple(state.pos)               # (x, y)\n\n  # ----- index of the goal item \"stick\" --------------------------------\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n      if stick_idx is None:\n          return []   # stick not defined in this world\n\n  # ----- recipe for a stick --------------------------------------------\n  recipe = env.world.cookbook.primitives_for(stick_idx)\n\n  # primitives needed (int keys are item kinds)\n  primitive_needs = {k: v for k, v in recipe.items() if isinstance(k, int)}\n  # if stick itself is primitive (no recipe), we just need to pick one up\n  if not primitive_needs:\n      primitive_needs = {stick_idx: 1}\n\n  # workshop requirement (non\u2011int key encodes where to craft)\n  workshop_idx = None\n  for k, v in recipe.items():\n      if not isinstance(k, int):\n          workshop_idx = v if isinstance(v, int) else None\n          break\n\n  actions = []\n\n  # ----- helper: find closest cell containing given kind ----------------\n  def find_closest(kind_idx, cur):\n      positions = np.argwhere(grid[:, :, kind_idx] > 0)\n      if positions.shape[0] == 0:\n          return None\n      dists = np.sum(np.abs(positions - np.array(cur)), axis=1)\n      nearest = positions[np.argmin(dists)]\n      return tuple(nearest.tolist())\n\n  # ----- helper: Manhattan path (greedy) --------------------------------\n  def path_to(cur, target):\n      x, y = cur\n      tx, ty = target\n      path = []\n      while (x, y) != (tx, ty):\n          if x < tx:\n              path.append(RIGHT)\n              x += 1\n          elif x > tx:\n              path.append(LEFT)\n              x -= 1\n          elif y < ty:\n              path.append(DOWN)\n              y += 1\n          elif y > ty:\n              path.append(UP)\n              y -= 1\n      return path, (x, y)\n\n  # ----- collect all required primitives --------------------------------\n  for kind_idx, needed in primitive_needs.items():\n      while needed > 0:\n          target = find_closest(kind_idx, cur_pos)\n          if target is None:\n              # primitive missing from map \u2013 abort planning\n              return actions\n          move_actions, cur_pos = path_to(cur_pos, target)\n          actions.extend(move_actions)\n          actions.append(USE)   # pick up / use the primitive\n\n          # update local grid copy\n          grid[target[0], target[1], kind_idx] = max(\n              0, grid[target[0], target[1], kind_idx] - 1\n          )\n          needed -= 1\n\n  # ----- if a workshop is required, go there and craft ------------------\n  if workshop_idx is not None:\n      ws_target = find_closest(workshop_idx, cur_pos)\n      if ws_target is not None:\n          move_actions, cur_pos = path_to(cur_pos, ws_target)\n          actions.extend(move_actions)\n          actions.append(USE)   # craft the stick at the workshop\n\n  return actions", "env_interactions": 2, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:02:43.797296", "function_name": "make_arrow", "function_body": "  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act.get(\"DOWN\", 0),\n      act.get(\"UP\", 1),\n      act.get(\"LEFT\", 2),\n      act.get(\"RIGHT\", 3),\n      act.get(\"USE\", 4),\n  )\n\n  # snapshot state (do not modify the environment)\n  state = env._current_state\n  grid = state.grid.copy()                 # (W, H, n_kinds)\n  cur_pos = tuple(state.pos)               # (x, y)\n\n  # obtain index of the stick item\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n      if stick_idx is None:\n          return []   # stick not defined\n\n  # recipe (primitive requirements + optional workshop)\n  recipe = env.world.cookbook.primitives_for(stick_idx)\n\n  # primitive requirements (int keys)\n  primitive_needs = {k: v for k, v in recipe.items() if isinstance(k, int)}\n  # if no recipe, we must pick up a stick directly\n  if not primitive_needs:\n      primitive_needs = {stick_idx: 1}\n\n  # workshop requirement (non\u2011int key)\n  workshop_idx = None\n  for k, v in recipe.items():\n      if not isinstance(k, int):\n          workshop_idx = v if isinstance(v, int) else None\n          break\n\n  actions = []\n\n  # helper: locate nearest cell containing at least one of the given kind\n  def find_closest(kind_idx, cur):\n      positions = np.argwhere(grid[:, :, kind_idx] > 0)\n      if positions.shape[0] == 0:\n          return None\n      dists = np.sum(np.abs(positions - np.array(cur)), axis=1)\n      nearest = positions[np.argmin(dists)]\n      return tuple(nearest.tolist())\n\n  # helper: simple greedy Manhattan path from cur to target\n  def path_to(cur, target):\n      x, y = cur\n      tx, ty = target\n      path = []\n      while (x, y) != (tx, ty):\n          if x < tx:\n              path.append(RIGHT)\n              x += 1\n          elif x > tx:\n              path.append(LEFT)\n              x -= 1\n          elif y < ty:\n              path.append(DOWN)\n              y += 1\n          elif y > ty:\n              path.append(UP)\n              y -= 1\n      return path, (x, y)\n\n  # collect each required primitive the needed number of times\n  for kind_idx, needed in primitive_needs.items():\n      while needed > 0:\n          target = find_closest(kind_idx, cur_pos)\n          if target is None:\n              return actions          # cannot find required primitive\n          move_actions, cur_pos = path_to(cur_pos, target)\n          actions.extend(move_actions)\n          actions.append(USE)         # pick up / use the primitive\n\n          # update local grid copy\n          grid[target[0], target[1], kind_idx] = max(\n              0, grid[target[0], target[1], kind_idx] - 1\n          )\n          needed -= 1\n\n  # if a workshop is required, move to it and craft the stick\n  if workshop_idx is not None:\n      ws_target = find_closest(workshop_idx, cur_pos)\n      if ws_target is not None:\n          move_actions, cur_pos = path_to(cur_pos, ws_target)\n          actions.extend(move_actions)\n          actions.append(USE)   # craft at the workshop\n\n  return actions", "env_interactions": 2, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:03:06.115382", "function_name": "make_arrow", "function_body": "  # Retrieve current state; reset if needed\n  try:\n      state = env._current_state\n  except AttributeError:\n      env.reset()\n      state = env._current_state\n\n  # Action indices\n  specs = env.action_specs()\n  DOWN = specs[\"DOWN\"]\n  UP = specs[\"UP\"]\n  LEFT = specs[\"LEFT\"]\n  RIGHT = specs[\"RIGHT\"]\n  USE = specs[\"USE\"]\n\n  # Index of the target item \"stick\"\n  stick_idx = env.world.cookbook.index[\"stick\"]\n\n  # Primitive requirements for a stick (empty dict if primitive)\n  prim_req = env.world.cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n\n  # Copy of the grid for planning (so we can \"remove\" collected items)\n  grid = state.grid.copy()\n\n  # Build a mask of blocked cells (non\u2011grabbable entities)\n  blocked = np.zeros(grid.shape[:2], dtype=bool)\n  for idx in env.world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # ------------------------------------------------------------------\n  # Helper: BFS shortest path avoiding blocked cells\n  # ------------------------------------------------------------------\n  def _bfs_path(start, goal, blocked_mask):\n      from collections import deque\n\n      dirs = [\n          (1, 0, DOWN),   # down\n          (-1, 0, UP),    # up\n          (0, -1, LEFT),  # left\n          (0, 1, RIGHT),  # right\n      ]\n\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for dx, dy, a in dirs:\n              nx, ny = x + dx, y + dy\n              if (\n                  0 <= nx < blocked_mask.shape[0]\n                  and 0 <= ny < blocked_mask.shape[1]\n                  and not blocked_mask[nx, ny]\n                  and (nx, ny) not in visited\n              ):\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [a]))\n      return None  # unreachable\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # ------------------------------------------------------------------\n  # Case 1: stick is a primitive already placed in the world\n  # ------------------------------------------------------------------\n  if not prim_req:\n      stick_cells = np.argwhere(grid[:, :, stick_idx] > 0)\n      if stick_cells.size == 0:\n          return []  # cannot find a stick\n      target = tuple(stick_cells[0])\n      if cur_pos != target:\n          path = _bfs_path(cur_pos, target, blocked)\n          if path is None:\n              return []  # unreachable\n          actions.extend(path)\n          cur_pos = target\n      actions.append(USE)\n      return actions\n\n  # ------------------------------------------------------------------\n  # Case 2: collect required primitives\n  # ------------------------------------------------------------------\n  needed = dict(prim_req)  # mutable copy of required counts\n\n  while any(cnt > 0 for cnt in needed.values()):\n      best_path = None\n      best_target = None\n      best_prim = None\n\n      # Search for the nearest reachable needed primitive\n      for prim_idx, cnt in needed.items():\n          if cnt <= 0:\n              continue\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          for cell in prim_cells:\n              target = tuple(cell)\n              path = _bfs_path(cur_pos, target, blocked)\n              if path is None:\n                  continue\n              if best_path is None or len(path) < len(best_path):\n                  best_path = path\n                  best_target = target\n                  best_prim = prim_idx\n\n      if best_path is None:\n          # No reachable required primitive left\n          return actions\n\n      # Move to the primitive and pick it up\n      actions.extend(best_path)\n      actions.append(USE)\n\n      # Update planning state\n      cur_pos = best_target\n      needed[best_prim] -= 1\n      grid[best_target[0], best_target[1], best_prim] = 0   # remove from copy\n\n  # ------------------------------------------------------------------\n  # Case 3: go to required workshop (if any) and craft the stick\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          target = tuple(workshop_cells[0])\n          if cur_pos != target:\n              path = _bfs_path(cur_pos, target, blocked)\n              if path is None:\n                  return actions  # cannot reach workshop\n              actions.extend(path)\n              cur_pos = target\n\n  # Finally, craft the stick\n  actions.append(USE)\n  return actions", "env_interactions": 2, "island_id": 3, "scores": {"3": 0.0}}
