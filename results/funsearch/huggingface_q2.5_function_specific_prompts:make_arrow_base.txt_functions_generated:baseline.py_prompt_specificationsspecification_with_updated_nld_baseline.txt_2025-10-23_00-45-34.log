{"timestamp": "2025-10-23T00:49:29.521407", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # Helper to generate movement actions from current to target cell\n  def _navigate(cur_pos, target_pos):\n      actions = []\n      y, x = cur_pos  # note: grid indexing is (row, col)\n      ty, tx = target_pos\n      # Move vertically\n      while y < ty:\n          actions.append(0)   # DOWN\n          y += 1\n      while y > ty:\n          actions.append(1)   # UP\n          y -= 1\n      # Move horizontally\n      while x < tx:\n          actions.append(3)   # RIGHT\n          x += 1\n      while x > tx:\n          actions.append(2)   # LEFT\n          x -= 1\n      return actions\n\n  # Access the underlying world and cookbook\n  world = env.world\n  cookbook = world.cookbook\n\n  # Index of the target item (\u201cstick\u201d)\n  try:\n      stick_idx = cookbook.index[\"stick\"]\n  except Exception:\n      # If the name is not present, just return empty plan\n      return []\n\n  # Determine required primitives and their counts\n  primitives_needed = cookbook.primitives_for(stick_idx)  # dict {prim_idx: count}\n  # Determine at which workshop the stick must be crafted\n  recipe = cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\", None)\n\n  # Get the current state to inspect the grid and position\n  state = env._current_state\n\n  plan = []\n\n  # Collect each required primitive\n  for prim_idx, qty in primitives_needed.items():\n      for _ in range(qty):\n          # Find a location of the primitive on the grid\n          locations = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if locations.size == 0:\n              # Primitive not found \u2013 cannot continue\n              return plan\n          # Choose the first occurrence (could be improved with nearest search)\n          target = tuple(locations[0])\n          # Navigate to the primitive\n          plan += _navigate(state.pos, target)\n          # Use action to pick it up\n          plan.append(4)  # USE\n          # Update the imagined position for subsequent steps\n          state.pos = target\n\n  # If a workshop is required, move to it and craft\n  if workshop_name is not None:\n      try:\n          workshop_idx = cookbook.index[workshop_name]\n      except Exception:\n          return plan\n      workshop_locs = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_locs.size == 0:\n          return plan\n      workshop_pos = tuple(workshop_locs[0])\n      plan += _navigate(state.pos, workshop_pos)\n      plan.append(4)  # USE to craft at the workshop\n\n  return plan", "env_interactions": 4, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T00:49:30.872380", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # action indices (as defined in CraftLab.action_specs)\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # helper utilities\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a simple list of movement actions that walks from start to goal\n      using only horizontal then vertical moves.  No obstacle avoidance.\"\"\"\n      x, y = start\n      gx, gy = goal\n      actions = []\n\n      # horizontal moves (x axis)\n      while x < gx:\n          actions.append(ACTION_RIGHT)\n          x += 1\n      while x > gx:\n          actions.append(ACTION_LEFT)\n          x -= 1\n\n      # vertical moves (y axis)\n      while y < gy:\n          actions.append(ACTION_DOWN)\n          y += 1\n      while y > gy:\n          actions.append(ACTION_UP)\n          y -= 1\n\n      return actions\n\n  def nearest_position(positions, reference):\n      \"\"\"Return the position from *positions* with smallest Manhattan distance to *reference*.\"\"\"\n      if len(positions) == 0:\n          return None\n      ref = np.array(reference)\n      dists = np.sum(np.abs(positions - ref), axis=1)\n      return tuple(positions[np.argmin(dists)])\n\n  # ------------------------------------------------------------------\n  # main planning logic\n  # ------------------------------------------------------------------\n  state = env._current_state                # current CraftState\n  grid = state.grid                          # (W, H, n_kinds) numpy array\n  pos = tuple(state.pos)                     # (x, y)\n  inventory = state.inventory                # 1\u2011D array of counts\n\n  # index of the goal item (\"stick\")\n  goal_name = \"stick\"\n  goal_idx = env.world.cookbook.index[goal_name]\n\n  # ------------------------------------------------------------------\n  # 1) gather required primitives (if any)\n  # ------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # dict {kind_idx: count}\n  plan_actions = []\n\n  for prim_idx, needed_cnt in primitives_needed.items():\n      # already have enough?\n      while inventory[prim_idx] < needed_cnt:\n          # locate any cell that currently holds this primitive\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # nothing left on the map \u2013 give up\n              return plan_actions\n          target = nearest_position(prim_cells, pos)\n\n          # move to the primitive cell\n          plan_actions.extend(manhattan_path(pos, target))\n          pos = target\n\n          # pick it up\n          plan_actions.append(ACTION_USE)\n\n          # simulate the effect on inventory / grid so that subsequent loops see the update\n          # (we do a very lightweight simulation \u2013 enough for planning)\n          inventory[prim_idx] += 1\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # ------------------------------------------------------------------\n  # 2) go to the appropriate workshop and craft the stick\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes[goal_idx]\n  workshop_name = recipe[\"_at\"]\n  workshop_idx = env.world.cookbook.index[workshop_name]\n\n  # locate workshop cells\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      # no workshop visible \u2013 nothing we can do\n      return plan_actions\n\n  # pick a workshop cell and then find a free adjacent cell to stand on\n  wcell = tuple(workshop_cells[0])\n  # examine 4\u2011neighbourhood for an empty spot\n  neighbours = [(wcell[0] + dx, wcell[1] + dy) for dx, dy in\n                [(1, 0), (-1, 0), (0, 1), (0, -1)]]\n  stand_pos = None\n  for nx, ny in neighbours:\n      if (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and\n              grid[nx, ny, :].sum() == 0):\n          stand_pos = (nx, ny)\n          break\n  if stand_pos is None:\n      # fallback: just move next to the workshop even if occupied (may fail at runtime)\n      stand_pos = wcell\n\n  # move to the chosen standing position\n  plan_actions.extend(manhattan_path(pos, stand_pos))\n  pos = stand_pos\n\n  # finally use the workshop to craft the stick\n  plan_actions.append(ACTION_USE)\n\n  return plan_actions", "env_interactions": 5, "island_id": 4, "scores": {"3": 0.0}}
