{"timestamp": "2025-10-23T02:19:33.384353", "function_name": "make_arrow", "function_body": "  actions = []\n  state = env._current_state\n  grid = state.grid\n  world = env.world\n  cb = world.cookbook\n\n  # index of the goal item \"stick\"\n  try:\n      goal_idx = cb.index[\"stick\"]\n  except Exception:\n      return actions\n\n  # primitive requirements for a stick (empty dict if stick is primitive)\n  needed_prims = cb.primitives_for(goal_idx)\n\n  # mutable copy of current position (x, y)\n  pos = list(state.pos)\n\n  # helper to move to a target cell using Manhattan steps\n  def _move_to(target):\n      nonlocal pos, actions\n      tx, ty = target\n      while pos[0] < tx:\n          actions.append(3)   # RIGHT\n          pos[0] += 1\n      while pos[0] > tx:\n          actions.append(2)   # LEFT\n          pos[0] -= 1\n      while pos[1] < ty:\n          actions.append(0)   # DOWN\n          pos[1] += 1\n      while pos[1] > ty:\n          actions.append(1)   # UP\n          pos[1] -= 1\n\n  # If stick itself is a primitive, just pick it up.\n  if not needed_prims:\n      locs = np.argwhere(grid[:, :, goal_idx] > 0)\n      if locs.size:\n          _move_to(locs[0].tolist())\n          actions.append(4)   # USE to pick up\n      return actions\n\n  # Collect each required primitive.\n  for prim_idx, count in needed_prims.items():\n      locs = np.argwhere(grid[:, :, prim_idx] > 0)\n      if not locs.size:\n          continue  # primitive not present; should not happen in valid scenarios\n      _move_to(locs[0].tolist())\n      for _ in range(count):\n          actions.append(4)   # USE to pick up one unit\n\n  # Move to workshop (if recipe specifies one) and craft the stick.\n  recipe = cb.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = cb.index[workshop_name]\n      w_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if w_locs.size:\n          _move_to(w_locs[0].tolist())\n          actions.append(4)   # USE to craft at the workshop\n\n  return actions", "env_interactions": 4, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:19:55.665235", "function_name": "make_arrow", "function_body": "  # Helper to move from current position to a target cell, appending actions.\n  def _move_to(cur_pos, target, act_seq):\n      x, y = cur_pos\n      tx, ty = target\n      while x < tx:\n          act_seq.append(3)  # RIGHT\n          x += 1\n      while x > tx:\n          act_seq.append(2)  # LEFT\n          x -= 1\n      while y < ty:\n          act_seq.append(0)  # DOWN\n          y += 1\n      while y > ty:\n          act_seq.append(1)  # UP\n          y -= 1\n      return (x, y)\n\n  state = env._current_state\n  grid = state.grid.copy()\n  cur_pos = state.pos\n  goal_idx = env.task.goal\n\n  # Retrieve the recipe for the desired item (stick).\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n  ingredients = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  actions = []\n\n  # Collect each required ingredient the required number of times.\n  for ing_kind, cnt in ingredients.items():\n      for _ in range(cnt):\n          # Locate all cells containing this ingredient.\n          locs = np.argwhere(grid[:, :, ing_kind] > 0)\n          if locs.size == 0:\n              # No more of this ingredient on the map; abort collection.\n              break\n          # Choose the closest instance (Manhattan distance).\n          dists = np.abs(locs[:, 0] - cur_pos[0]) + np.abs(locs[:, 1] - cur_pos[1])\n          chosen = int(np.argmin(dists))\n          target = tuple(locs[chosen].tolist())\n\n          # Move to the ingredient and pick it up.\n          cur_pos = _move_to(cur_pos, target, actions)\n          actions.append(4)  # USE to pick up\n          # Remove the collected item from the simulated grid.\n          grid[target[0], target[1], ing_kind] = 0\n\n  # If the recipe requires a specific workshop, go there and craft.\n  if workshop_kind is not None:\n      ws_locs = np.argwhere(grid[:, :, workshop_kind] > 0)\n      if ws_locs.size > 0:\n          dists = np.abs(ws_locs[:, 0] - cur_pos[0]) + np.abs(ws_locs[:, 1] - cur_pos[1])\n          chosen = int(np.argmin(dists))\n          workshop = tuple(ws_locs[chosen].tolist())\n          cur_pos = _move_to(cur_pos, workshop, actions)\n          actions.append(4)  # USE to craft\n\n  return actions", "env_interactions": 0, "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:19:56.983864", "function_name": "make_arrow", "function_body": "  def _move_to(cur_pos, target, seq):\n      x, y = cur_pos\n      tx, ty = target\n      while x < tx:\n          seq.append(3)  # RIGHT\n          x += 1\n      while x > tx:\n          seq.append(2)  # LEFT\n          x -= 1\n      while y < ty:\n          seq.append(0)  # DOWN\n          y += 1\n      while y > ty:\n          seq.append(1)  # UP\n          y -= 1\n      return (x, y)\n\n  state = env._current_state\n  grid = state.grid.copy()\n  cur_pos = state.pos\n  goal_idx = env.task.goal\n\n  # Retrieve recipe for the goal (may be empty for primitives)\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n  ingredients = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  actions = []\n\n  # If there is no recipe (primitive), simply pick up the goal item.\n  if not ingredients:\n      locs = np.argwhere(grid[:, :, goal_idx] > 0)\n      if locs.size > 0:\n          dists = np.abs(locs[:, 0] - cur_pos[0]) + np.abs(locs[:, 1] - cur_pos[1])\n          chosen = int(np.argmin(dists))\n          target = tuple(locs[chosen].tolist())\n          cur_pos = _move_to(cur_pos, target, actions)\n          actions.append(4)  # USE to pick up\n      return actions\n\n  # Gather required ingredients.\n  for ing_kind, count in ingredients.items():\n      for _ in range(count):\n          locs = np.argwhere(grid[:, :, ing_kind] > 0)\n          if locs.size == 0:\n              # Ingredient not found; abort early.\n              return actions\n          dists = np.abs(locs[:, 0] - cur_pos[0]) + np.abs(locs[:, 1] - cur_pos[1])\n          chosen = int(np.argmin(dists))\n          target = tuple(locs[chosen].tolist())\n          cur_pos = _move_to(cur_pos, target, actions)\n          actions.append(4)  # USE to pick up\n          grid[target[0], target[1], ing_kind] = 0\n\n  # Move to workshop (if required) and craft.\n  if workshop_kind is not None:\n      ws_locs = np.argwhere(grid[:, :, workshop_kind] > 0)\n      if ws_locs.size > 0:\n          dists = np.abs(ws_locs[:, 0] - cur_pos[0]) + np.abs(ws_locs[:, 1] - cur_pos[1])\n          chosen = int(np.argmin(dists))\n          workshop = tuple(ws_locs[chosen].tolist())\n          cur_pos = _move_to(cur_pos, workshop, actions)\n          actions.append(4)  # USE to craft\n\n  return actions", "env_interactions": 0, "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:20:15.902439", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  goal_idx = env.task.goal\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # --------------------------------------------------------------\n  # Helper utilities\n  # --------------------------------------------------------------\n  def find_positions(kind):\n      \"\"\"Return list of (x, y) cells containing the given kind.\"\"\"\n      locs = np.argwhere(state.grid[:, :, kind] > 0)\n      return [tuple(p) for p in locs]\n\n  def nearest(pos, kind):\n      \"\"\"Manhattan\u2011closest cell of the requested kind.\"\"\"\n      positions = find_positions(kind)\n      if not positions:\n          return None\n      return min(positions, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n\n  def moves_to(src, dst):\n      \"\"\"Sequence of movement actions (DOWN=0, UP=1, LEFT=2, RIGHT=3)\n      that walks from src to dst using a simple Manhattan path.\"\"\"\n      sx, sy = src\n      dx, dy = dst\n      seq = []\n      while sx < dx:\n          seq.append(0)   # DOWN\n          sx += 1\n      while sx > dx:\n          seq.append(1)   # UP\n          sx -= 1\n      while sy < dy:\n          seq.append(3)   # RIGHT\n          sy += 1\n      while sy > dy:\n          seq.append(2)   # LEFT\n          sy -= 1\n      return seq\n\n  # --------------------------------------------------------------\n  # 1) If the goal itself is a primitive \u2013 just go collect it.\n  # --------------------------------------------------------------\n  if not env.world.cookbook.primitives_for(goal_idx):\n      target = nearest(cur_pos, goal_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)   # USE to pick up the primitive\n      return actions\n\n  # --------------------------------------------------------------\n  # 2) Gather all required primitive ingredients.\n  # --------------------------------------------------------------\n  needed_prims = env.world.cookbook.primitives_for(goal_idx)\n  for prim_idx, count in needed_prims.items():\n      for _ in range(count):\n          target = nearest(cur_pos, prim_idx)\n          if target is None:\n              # Primitive not present in the current map; skip.\n              continue\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n          actions.append(4)   # USE to pick it up\n\n  # --------------------------------------------------------------\n  # 3) Move to the appropriate workshop (if any) and craft.\n  # --------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n\n  if isinstance(recipe, dict):\n      # Preferred explicit key.\n      workshop_idx = recipe.get('_at')\n      # Fallback: any string key other than '_at' is assumed to be the workshop.\n      if workshop_idx is None:\n          for k, v in recipe.items():\n              if isinstance(k, str) and k != '_at':\n                  workshop_idx = v\n                  break\n\n  if workshop_idx is not None:\n      target = nearest(cur_pos, workshop_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)   # USE at workshop to craft the stick\n  else:\n      # No designated workshop \u2013 try crafting at current location.\n      actions.append(4)\n\n  return actions", "env_interactions": 1, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:20:17.245421", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  goal_idx = env.task.goal\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # --------------------------------------------------------------\n  # Helper utilities\n  # --------------------------------------------------------------\n  def find_positions(kind):\n      \"\"\"Return list of (x, y) cells containing the given kind.\"\"\"\n      locs = np.argwhere(state.grid[:, :, kind] > 0)\n      return [tuple(p) for p in locs]\n\n  def nearest(pos, kind):\n      \"\"\"Manhattan\u2011closest cell of the requested kind.\"\"\"\n      positions = find_positions(kind)\n      if not positions:\n          return None\n      return min(positions, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n\n  def moves_to(src, dst):\n      \"\"\"Sequence of movement actions (DOWN=0, UP=1, LEFT=2, RIGHT=3)\n      that walks from src to dst using a simple Manhattan path.\"\"\"\n      sx, sy = src\n      dx, dy = dst\n      seq = []\n      while sx < dx:\n          seq.append(0)   # DOWN\n          sx += 1\n      while sx > dx:\n          seq.append(1)   # UP\n          sx -= 1\n      while sy < dy:\n          seq.append(3)   # RIGHT\n          sy += 1\n      while sy > dy:\n          seq.append(2)   # LEFT\n          sy -= 1\n      return seq\n\n  # --------------------------------------------------------------\n  # 1) If the goal itself is a primitive \u2013 just collect it.\n  # --------------------------------------------------------------\n  if not env.world.cookbook.primitives_for(goal_idx):\n      target = nearest(cur_pos, goal_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)   # USE to pick up the primitive\n      return actions\n\n  # --------------------------------------------------------------\n  # 2) Gather all required primitive ingredients.\n  # --------------------------------------------------------------\n  needed_prims = env.world.cookbook.primitives_for(goal_idx)\n  for prim_idx, count in needed_prims.items():\n      for _ in range(count):\n          target = nearest(cur_pos, prim_idx)\n          if target is None:\n              # Primitive not present in the current map; skip.\n              continue\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n          actions.append(4)   # USE to pick it up\n\n  # --------------------------------------------------------------\n  # 3) Move to the appropriate workshop (if any) and craft.\n  # --------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n\n  if isinstance(recipe, dict):\n      # Look for an explicit '_at' key first.\n      workshop_idx = recipe.get('_at')\n      # If not found, any other string key is assumed to denote the workshop.\n      if workshop_idx is None:\n          for k, v in recipe.items():\n              if isinstance(k, str) and k != '_at':\n                  workshop_idx = v\n                  break\n\n  if workshop_idx is not None:\n      target = nearest(cur_pos, workshop_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)   # USE at the workshop to craft the stick\n  else:\n      # No designated workshop \u2013 attempt crafting at current location.\n      actions.append(4)\n\n  return actions", "env_interactions": 1, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:20:41.629771", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # Action indices as defined in CraftLab.action_specs\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions from start to goal using\n      horizontal\u2011then\u2011vertical moves (ignores obstacles).\"\"\"\n      x, y = start\n      gx, gy = goal\n      actions = []\n      while x < gx:\n          actions.append(ACTION_RIGHT)\n          x += 1\n      while x > gx:\n          actions.append(ACTION_LEFT)\n          x -= 1\n      while y < gy:\n          actions.append(ACTION_DOWN)\n          y += 1\n      while y > gy:\n          actions.append(ACTION_UP)\n          y -= 1\n      return actions\n\n  def nearest_position(positions, reference):\n      \"\"\"Pick the position from *positions* with smallest Manhattan distance\n      to *reference*.\"\"\"\n      if len(positions) == 0:\n          return None\n      ref = np.array(reference)\n      dists = np.sum(np.abs(positions - ref), axis=1)\n      return tuple(positions[np.argmin(dists)])\n\n  # ------------------------------------------------------------------\n  # Gather current state information\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n\n  # ------------------------------------------------------------------\n  # Identify the goal (stick)\n  # ------------------------------------------------------------------\n  goal_name = \"stick\"\n  try:\n      goal_idx = env.world.cookbook.index[goal_name]\n  except Exception:\n      # Goal not present in the world \u2013 nothing to do\n      return []\n\n  # If we already have a stick in inventory, no actions are needed\n  if inventory[goal_idx] > 0:\n      return []\n\n  plan_actions = []\n\n  # ------------------------------------------------------------------\n  # 1) Collect needed primitive resources (if any)\n  # ------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  for prim_idx, needed_cnt in primitives_needed.items():\n      while inventory[prim_idx] < needed_cnt:\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # No more of this primitive on the map \u2013 abort planning\n              return plan_actions\n          target = nearest_position(prim_cells, pos)\n\n          # Move to the primitive\n          plan_actions.extend(manhattan_path(pos, target))\n          pos = target\n\n          # Pick it up\n          plan_actions.append(ACTION_USE)\n\n          # Simulate the pickup locally for further planning\n          inventory[prim_idx] += 1\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # ------------------------------------------------------------------\n  # 2) If the stick itself is a primitive (no recipe), just pick it up\n  # ------------------------------------------------------------------\n  if goal_idx not in env.world.cookbook.recipes:\n      stick_cells = np.argwhere(grid[:, :, goal_idx] > 0)\n      if stick_cells.size == 0:\n          return plan_actions\n      target = nearest_position(stick_cells, pos)\n      plan_actions.extend(manhattan_path(pos, target))\n      pos = target\n      plan_actions.append(ACTION_USE)\n      return plan_actions\n\n  # ------------------------------------------------------------------\n  # 3) Go to the required workshop and craft the stick\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      try:\n          workshop_idx = env.world.cookbook.index[workshop_name]\n      except Exception:\n          return plan_actions\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          return plan_actions\n      wcell = tuple(workshop_cells[0])\n\n      # Find a free adjacent cell to stand on\n      neighbours = [\n          (wcell[0] + dx, wcell[1] + dy)\n          for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]\n      ]\n      stand_pos = None\n      for nx, ny in neighbours:\n          if (\n              0 <= nx < grid.shape[0]\n              and 0 <= ny < grid.shape[1]\n              and grid[nx, ny, :].sum() == 0\n          ):\n              stand_pos = (nx, ny)\n              break\n      if stand_pos is None:\n          stand_pos = wcell  # fallback: stand directly on the workshop\n\n      # Move to the chosen standing position\n      plan_actions.extend(manhattan_path(pos, stand_pos))\n      pos = stand_pos\n\n      # Use the workshop to craft the stick\n      plan_actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # Return the constructed action list\n  # ------------------------------------------------------------------\n  return plan_actions", "env_interactions": 5, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:20:42.947841", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # Action indices (as defined in CraftLab.action_specs)\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions from start to goal using\n      horizontal\u2011then\u2011vertical moves (ignores obstacles).\"\"\"\n      x, y = start\n      gx, gy = goal\n      actions = []\n      while x < gx:\n          actions.append(ACTION_RIGHT)\n          x += 1\n      while x > gx:\n          actions.append(ACTION_LEFT)\n          x -= 1\n      while y < gy:\n          actions.append(ACTION_DOWN)\n          y += 1\n      while y > gy:\n          actions.append(ACTION_UP)\n          y -= 1\n      return actions\n\n  def nearest_position(positions, reference):\n      \"\"\"Pick the position from *positions* with smallest Manhattan distance\n      to *reference*.\"\"\"\n      if len(positions) == 0:\n          return None\n      ref = np.array(reference)\n      dists = np.sum(np.abs(positions - ref), axis=1)\n      return tuple(positions[np.argmin(dists)])\n\n  # ------------------------------------------------------------------\n  # Gather current state information\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n\n  # ------------------------------------------------------------------\n  # Identify goal (stick)\n  # ------------------------------------------------------------------\n  goal_name = \"stick\"\n  try:\n      goal_idx = env.world.cookbook.index[goal_name]\n  except Exception:\n      # Goal not defined in the world \u2013 nothing to do\n      return []\n\n  # If we already possess a stick, no actions are needed\n  if inventory[goal_idx] > 0:\n      return []\n\n  plan_actions = []\n\n  # ------------------------------------------------------------------\n  # 1) Collect required primitive resources (if any)\n  # ------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  for prim_idx, needed_cnt in primitives_needed.items():\n      while inventory[prim_idx] < needed_cnt:\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # No more of this primitive on the map \u2013 abort planning\n              return plan_actions\n          target = nearest_position(prim_cells, pos)\n\n          # Move to the primitive cell\n          plan_actions.extend(manhattan_path(pos, target))\n          pos = target\n\n          # Pick it up\n          plan_actions.append(ACTION_USE)\n\n          # Simulate the pickup locally for subsequent planning\n          inventory[prim_idx] += 1\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # ------------------------------------------------------------------\n  # 2) If stick is itself a primitive (no recipe), just pick it up\n  # ------------------------------------------------------------------\n  if goal_idx not in env.world.cookbook.recipes:\n      stick_cells = np.argwhere(grid[:, :, goal_idx] > 0)\n      if stick_cells.size == 0:\n          return plan_actions\n      target = nearest_position(stick_cells, pos)\n\n      plan_actions.extend(manhattan_path(pos, target))\n      pos = target\n      plan_actions.append(ACTION_USE)\n      return plan_actions\n\n  # ------------------------------------------------------------------\n  # 3) Go to the required workshop (if any) and craft the stick\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      try:\n          workshop_idx = env.world.cookbook.index[workshop_name]\n      except Exception:\n          return plan_actions\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          return plan_actions\n      wcell = tuple(workshop_cells[0])\n\n      # Find a free adjacent cell to stand on for using the workshop\n      neighbours = [(wcell[0] + dx, wcell[1] + dy) for dx, dy in\n                    [(1, 0), (-1, 0), (0, 1), (0, -1)]]\n      stand_pos = None\n      for nx, ny in neighbours:\n          if (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and\n                  grid[nx, ny, :].sum() == 0):\n              stand_pos = (nx, ny)\n              break\n      if stand_pos is None:\n          stand_pos = wcell  # fallback to standing directly on the workshop\n\n      plan_actions.extend(manhattan_path(pos, stand_pos))\n      pos = stand_pos\n\n      # Use the workshop to craft the stick\n      plan_actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # Return the constructed list of actions\n  # ------------------------------------------------------------------\n  return plan_actions", "env_interactions": 5, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:21:01.238035", "function_name": "make_arrow", "function_body": "  actions = []\n  state = env._current_state\n  grid = state.grid\n  world = env.world\n  cb = world.cookbook\n\n  # index of the target item \"stick\"\n  try:\n      goal_idx = cb.index[\"stick\"]\n  except Exception:\n      return actions\n\n  # primitives (and required counts) needed to craft a stick\n  needed_prims = cb.primitives_for(goal_idx)\n\n  # current agent position as mutable list [x, y]\n  pos = list(state.pos)\n\n  # helper to move the agent to a target cell using Manhattan moves\n  def _move_to(target):\n      nonlocal pos, actions\n      tx, ty = target\n      while pos[0] < tx:\n          actions.append(3)   # RIGHT\n          pos[0] += 1\n      while pos[0] > tx:\n          actions.append(2)   # LEFT\n          pos[0] -= 1\n      while pos[1] < ty:\n          actions.append(0)   # DOWN\n          pos[1] += 1\n      while pos[1] > ty:\n          actions.append(1)   # UP\n          pos[1] -= 1\n\n  # If stick is itself a primitive (no recipe), just pick it up.\n  if not needed_prims:\n      locs = np.argwhere(grid[:, :, goal_idx] > 0)\n      if locs.size:\n          _move_to(locs[0].tolist())\n          actions.append(4)   # USE to pick up the stick\n      return actions\n\n  # Collect each required primitive.\n  for prim_idx, count in needed_prims.items():\n      locs = np.argwhere(grid[:, :, prim_idx] > 0)\n      if not locs.size:\n          continue  # primitive not present; should not happen in valid scenarios\n      _move_to(locs[0].tolist())\n      for _ in range(count):\n          actions.append(4)   # USE to pick up one unit of the primitive\n\n  # Move to the appropriate workshop (if any) and craft the stick.\n  recipe = cb.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = cb.index[workshop_name]\n      w_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if w_locs.size:\n          _move_to(w_locs[0].tolist())\n          actions.append(4)   # USE to craft at the workshop\n\n  return actions", "env_interactions": 4, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:21:02.571401", "function_name": "make_arrow", "function_body": "  actions = []\n  state = env._current_state\n  grid = state.grid\n  world = env.world\n  cb = world.cookbook\n\n  # index of the target item \"stick\"\n  try:\n      goal_idx = cb.index[\"stick\"]\n  except Exception:\n      return actions\n\n  # primitives required for a stick (empty dict if stick is primitive)\n  needed_prims = cb.primitives_for(goal_idx)\n\n  # current agent position (x, y)\n  pos = list(state.pos)\n\n  # helper to move using Manhattan steps\n  def _move_to(target):\n      nonlocal pos, actions\n      tx, ty = target\n      while pos[0] < tx:\n          actions.append(3)   # RIGHT\n          pos[0] += 1\n      while pos[0] > tx:\n          actions.append(2)   # LEFT\n          pos[0] -= 1\n      while pos[1] < ty:\n          actions.append(0)   # DOWN\n          pos[1] += 1\n      while pos[1] > ty:\n          actions.append(1)   # UP\n          pos[1] -= 1\n\n  # If stick itself is a primitive, just pick it up.\n  if not needed_prims:\n      locs = np.argwhere(grid[:, :, goal_idx] > 0)\n      if locs.size:\n          _move_to(locs[0].tolist())\n          actions.append(4)   # USE to pick up\n      return actions\n\n  # Collect each required primitive.\n  for prim_idx, count in needed_prims.items():\n      locs = np.argwhere(grid[:, :, prim_idx] > 0)\n      if not locs.size:\n          continue  # primitive not present; should not happen in valid scenarios\n      _move_to(locs[0].tolist())\n      for _ in range(count):\n          actions.append(4)   # USE to pick up one unit\n\n  # Move to workshop (if recipe specifies one) and craft the stick.\n  recipe = cb.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = cb.index[workshop_name]\n      w_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if w_locs.size:\n          _move_to(w_locs[0].tolist())\n          actions.append(4)   # USE to craft at the workshop\n\n  return actions", "env_interactions": 4, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:21:18.671186", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n  stick_idx = world.cookbook.index['stick']\n\n  # Helper to move from cur_pos to (tx, ty), appending actions\n  def move_to(cur_pos, tx, ty, actions):\n      x, y = cur_pos\n      while x < tx:\n          actions.append(3)   # RIGHT\n          x += 1\n      while x > tx:\n          actions.append(2)   # LEFT\n          x -= 1\n      while y < ty:\n          actions.append(0)   # DOWN\n          y += 1\n      while y > ty:\n          actions.append(1)   # UP\n          y -= 1\n      return (x, y)\n\n  # Find any cell that currently contains the given kind index\n  def find_any(kind_idx):\n      positions = np.argwhere(state.grid[:, :, kind_idx] > 0)\n      return positions[0] if positions.size > 0 else None\n\n  actions = []\n  cur_pos = state.pos\n\n  # If stick is a primitive, just pick it up\n  if stick_idx in world.cookbook.primitives:\n      target = find_any(stick_idx)\n      if target is None:\n          return []  # no stick found\n      cur_pos = move_to(cur_pos, target[0], target[1], actions)\n      actions.append(4)   # USE to pick up\n      return actions\n\n  # Otherwise, craft the stick according to its recipe\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get('_at', None)\n\n  # Collect all required ingredients (ignore the workshop entry)\n  for ing_key, count in recipe.items():\n      if ing_key == '_at':\n          continue\n      ing_idx = ing_key if isinstance(ing_key, int) else world.cookbook.index[ing_key]\n      for _ in range(count):\n          target = find_any(ing_idx)\n          if target is None:\n              return []  # missing ingredient\n          cur_pos = move_to(cur_pos, target[0], target[1], actions)\n          actions.append(4)   # USE to pick up ingredient\n\n  # Move to the workshop (if required) before crafting\n  if workshop_name is not None:\n      ws_idx = world.cookbook.index[workshop_name]\n      target = find_any(ws_idx)\n      if target is None:\n          return []  # workshop not found\n      cur_pos = move_to(cur_pos, target[0], target[1], actions)\n\n  # Finally, use the workshop (or current cell) to craft the stick\n  actions.append(4)   # USE to craft\n  return actions", "env_interactions": 4, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:21:19.998705", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n  stick_idx = world.cookbook.index['stick']\n\n  # move from (x,y) to (tx,ty) appending actions, return new position\n  def move_to(cur_pos, tx, ty, actions):\n      x, y = cur_pos\n      while x < tx:\n          actions.append(3)   # RIGHT\n          x += 1\n      while x > tx:\n          actions.append(2)   # LEFT\n          x -= 1\n      while y < ty:\n          actions.append(0)   # DOWN\n          y += 1\n      while y > ty:\n          actions.append(1)   # UP\n          y -= 1\n      return (x, y)\n\n  # locate any cell containing the given kind index\n  def find_any(kind_idx):\n      pos = np.argwhere(state.grid[:, :, kind_idx] > 0)\n      return pos[0] if pos.size > 0 else None\n\n  actions = []\n  cur_pos = state.pos\n\n  # If stick is a primitive resource, just pick it up\n  if stick_idx in world.cookbook.primitives:\n      target = find_any(stick_idx)\n      if target is None:\n          return []  # no stick found\n      cur_pos = move_to(cur_pos, target[0], target[1], actions)\n      actions.append(4)   # USE to pick up\n      return actions\n\n  # Otherwise stick must be crafted using its recipe\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get('_at', None)\n\n  # Collect all required ingredients (ignore the workshop entry)\n  for ing_key, count in recipe.items():\n      if ing_key == '_at':\n          continue\n      ing_idx = ing_key if isinstance(ing_key, int) else world.cookbook.index[ing_key]\n      for _ in range(count):\n          target = find_any(ing_idx)\n          if target is None:\n              return []  # missing ingredient\n          cur_pos = move_to(cur_pos, target[0], target[1], actions)\n          actions.append(4)   # USE to pick up ingredient\n\n  # Move to the appropriate workshop (if any) before crafting\n  if workshop_name is not None:\n      ws_idx = world.cookbook.index[workshop_name]\n      target = find_any(ws_idx)\n      if target is None:\n          return []  # workshop not found\n      cur_pos = move_to(cur_pos, target[0], target[1], actions)\n\n  # Finally, use (craft) the stick\n  actions.append(4)   # USE to craft\n  return actions", "env_interactions": 4, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:21:43.346761", "function_name": "make_arrow", "function_body": "  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Generate a list of movement actions from start to goal using\n      horizontal then vertical moves (ignores obstacles).\"\"\"\n      x, y = start\n      gx, gy = goal\n      actions = []\n      while x < gx:\n          actions.append(ACTION_RIGHT)\n          x += 1\n      while x > gx:\n          actions.append(ACTION_LEFT)\n          x -= 1\n      while y < gy:\n          actions.append(ACTION_DOWN)\n          y += 1\n      while y > gy:\n          actions.append(ACTION_UP)\n          y -= 1\n      return actions\n\n  def nearest_position(positions, reference):\n      \"\"\"Return the position from *positions* with smallest Manhattan distance\n      to *reference*.\"\"\"\n      if len(positions) == 0:\n          return None\n      ref = np.array(reference)\n      dists = np.sum(np.abs(positions - ref), axis=1)\n      return tuple(positions[np.argmin(dists)])\n\n  # ------------------------------------------------------------------\n  # Gather current state information\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n\n  # ------------------------------------------------------------------\n  # Identify goal (stick)\n  # ------------------------------------------------------------------\n  goal_name = \"stick\"\n  try:\n      goal_idx = env.world.cookbook.index[goal_name]\n  except Exception:\n      # Goal not known \u2013 return empty plan\n      return []\n\n  # ------------------------------------------------------------------\n  # Determine recipe (if any) and needed primitives\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n\n  plan_actions = []\n\n  # ------------------------------------------------------------------\n  # 1) Collect required primitives for the recipe\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      while inventory[prim_idx] < needed_cnt:\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # No more of this primitive on the map \u2013 abort planning\n              return plan_actions\n          target = nearest_position(prim_cells, pos)\n\n          # Move to the primitive\n          plan_actions.extend(manhattan_path(pos, target))\n          pos = target\n\n          # Pick it up\n          plan_actions.append(ACTION_USE)\n\n          # Simulate the pick\u2011up locally for further planning\n          inventory[prim_idx] += 1\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # ------------------------------------------------------------------\n  # 2) If the stick itself is a primitive (no recipe), collect it now\n  # ------------------------------------------------------------------\n  if not recipe:  # no crafting needed\n      if inventory[goal_idx] == 0:\n          stick_cells = np.argwhere(grid[:, :, goal_idx] > 0)\n          if stick_cells.size > 0:\n              target = nearest_position(stick_cells, pos)\n              plan_actions.extend(manhattan_path(pos, target))\n              pos = target\n              plan_actions.append(ACTION_USE)\n      # Nothing else to do; return the plan\n      return plan_actions\n\n  # ------------------------------------------------------------------\n  # 3) Go to the required workshop and craft the stick\n  # ------------------------------------------------------------------\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      try:\n          workshop_idx = env.world.cookbook.index[workshop_name]\n      except Exception:\n          return plan_actions\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          return plan_actions\n      wcell = tuple(workshop_cells[0])\n\n      # Find a free adjacent cell to stand on (or fallback to the workshop cell)\n      neighbours = [(wcell[0] + dx, wcell[1] + dy) for dx, dy in\n                    [(1, 0), (-1, 0), (0, 1), (0, -1)]]\n      stand_pos = None\n      for nx, ny in neighbours:\n          if (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and\n                  grid[nx, ny, :].sum() == 0):\n              stand_pos = (nx, ny)\n              break\n      if stand_pos is None:\n          stand_pos = wcell  # fallback\n\n      # Move to the standing position\n      plan_actions.extend(manhattan_path(pos, stand_pos))\n      pos = stand_pos\n\n      # Use the workshop to craft the stick\n      plan_actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # Return the completed action list\n  # ------------------------------------------------------------------\n  return plan_actions", "env_interactions": 5, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:21:44.701716", "function_name": "make_arrow", "function_body": "  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions from start to goal using\n      horizontal then vertical moves (ignores obstacles).\"\"\"\n      x, y = start\n      gx, gy = goal\n      actions = []\n      while x < gx:\n          actions.append(ACTION_RIGHT)\n          x += 1\n      while x > gx:\n          actions.append(ACTION_LEFT)\n          x -= 1\n      while y < gy:\n          actions.append(ACTION_DOWN)\n          y += 1\n      while y > gy:\n          actions.append(ACTION_UP)\n          y -= 1\n      return actions\n\n  def nearest_position(positions, reference):\n      \"\"\"Pick the position from *positions* with smallest Manhattan distance\n      to *reference*.\"\"\"\n      if len(positions) == 0:\n          return None\n      ref = np.array(reference)\n      dists = np.sum(np.abs(positions - ref), axis=1)\n      return tuple(positions[np.argmin(dists)])\n\n  # ------------------------------------------------------------------\n  # Gather current state information\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n\n  # ------------------------------------------------------------------\n  # Identify goal (stick)\n  # ------------------------------------------------------------------\n  goal_name = \"stick\"\n  goal_idx = env.world.cookbook.index[goal_name]\n\n  # ------------------------------------------------------------------\n  # 1) Collect needed primitives (if any)\n  # ------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  plan_actions = []\n\n  for prim_idx, needed_cnt in primitives_needed.items():\n      while inventory[prim_idx] < needed_cnt:\n          # locate cells containing the primitive\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # nothing left on map \u2013 abort planning\n              return plan_actions\n          target = nearest_position(prim_cells, pos)\n\n          # move to the primitive\n          plan_actions.extend(manhattan_path(pos, target))\n          pos = target\n\n          # pick it up\n          plan_actions.append(ACTION_USE)\n\n          # simulate pick\u2011up locally for further planning\n          inventory[prim_idx] += 1\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # ------------------------------------------------------------------\n  # 2) Go to workshop (if recipe requires one) and craft stick\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          # no workshop visible \u2013 cannot craft\n          return plan_actions\n      wcell = tuple(workshop_cells[0])\n\n      # find a free adjacent cell to stand on\n      neighbours = [(wcell[0] + dx, wcell[1] + dy) for dx, dy in\n                    [(1, 0), (-1, 0), (0, 1), (0, -1)]]\n      stand_pos = None\n      for nx, ny in neighbours:\n          if (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and\n                  grid[nx, ny, :].sum() == 0):\n              stand_pos = (nx, ny)\n              break\n      if stand_pos is None:\n          stand_pos = wcell  # fallback: stand on the workshop itself\n\n      # move to the chosen standing position\n      plan_actions.extend(manhattan_path(pos, stand_pos))\n      pos = stand_pos\n\n      # use the workshop to craft the stick\n      plan_actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # Return the full action list\n  # ------------------------------------------------------------------\n  return plan_actions", "env_interactions": 5, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:22:07.941850", "function_name": "make_arrow", "function_body": "  # Helper to generate movement actions from current position to target cell.\n  def _move_actions(cur_pos, target):\n      actions = []\n      x, y = cur_pos\n      tx, ty = target\n      while x < tx:\n          actions.append(3)  # RIGHT\n          x += 1\n      while x > tx:\n          actions.append(2)  # LEFT\n          x -= 1\n      while y < ty:\n          actions.append(0)  # DOWN\n          y += 1\n      while y > ty:\n          actions.append(1)  # UP\n          y -= 1\n      return actions, (x, y)\n\n  state = env._current_state\n  cookbook = env.world.cookbook\n  stick_idx = cookbook.index['stick']\n\n  # 1) Stick already in inventory \u2192 nothing to do.\n  if state.inventory[stick_idx] > 0:\n      return []\n\n  # 2) Stick lies on the ground \u2192 go pick it up.\n  stick_cells = np.argwhere(state.grid[:, :, stick_idx] > 0)\n  if stick_cells.size > 0:\n      target = tuple(stick_cells[0])\n      moves, _ = _move_actions(state.pos, target)\n      moves.append(4)                     # USE to pick up\n      return moves\n\n  # 3) Need to craft a stick.\n  # Determine required primitives and possible workshop.\n  primitive_req = cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n  recipe = cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = cookbook.index[workshop_name] if workshop_name is not None else None\n\n  # If there is no recipe (stick is a primitive that cannot be found), abort.\n  if not primitive_req and workshop_idx is None:\n      return []\n\n  actions = []\n  cur_pos = state.pos\n  # Work on a copy of the inventory for planning purposes.\n  inventory = state.inventory.copy()\n\n  # 3a) Collect each required primitive.\n  for prim_idx, needed in primitive_req.items():\n      while inventory[prim_idx] < needed:\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # Primitive not available on the map \u2192 abort planning.\n              return actions\n          target = tuple(prim_cells[0])\n          moves, cur_pos = _move_actions(cur_pos, target)\n          actions.extend(moves)\n          actions.append(4)                # USE to pick up primitive\n          inventory[prim_idx] += 1\n\n  # 3b) Move to the required workshop (if any) and craft the stick.\n  if workshop_idx is not None:\n      ws_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if ws_cells.size == 0:\n          # Required workshop missing \u2192 abort.\n          return actions\n      target = tuple(ws_cells[0])\n      moves, cur_pos = _move_actions(cur_pos, target)\n      actions.extend(moves)\n      actions.append(4)                    # USE to craft stick at workshop\n  else:\n      # No workshop needed; craft at current location.\n      actions.append(4)\n\n  return actions", "env_interactions": 4, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:22:09.319296", "function_name": "make_arrow", "function_body": "  def _move_actions(cur_pos, target):\n      actions = []\n      x, y = cur_pos\n      tx, ty = target\n      while x < tx:\n          actions.append(3)  # RIGHT\n          x += 1\n      while x > tx:\n          actions.append(2)  # LEFT\n          x -= 1\n      while y < ty:\n          actions.append(0)  # DOWN\n          y += 1\n      while y > ty:\n          actions.append(1)  # UP\n          y -= 1\n      return actions, (x, y)\n\n  state = env._current_state\n  cookbook = env.world.cookbook\n  stick_idx = cookbook.index['stick']\n\n  # If we already have a stick, nothing to do.\n  if state.inventory[stick_idx] > 0:\n      return []\n\n  # If a stick lies on the ground, pick it up.\n  stick_cells = np.argwhere(state.grid[:, :, stick_idx] > 0)\n  if stick_cells.size > 0:\n      target = tuple(stick_cells[0])\n      moves, _ = _move_actions(state.pos, target)\n      moves.append(4)  # USE\n      return moves\n\n  # Determine what primitives (if any) are needed and whether a workshop is required.\n  primitive_req = cookbook.primitives_for(stick_idx)          # {prim_idx: count}\n  recipe = cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = cookbook.index[workshop_name] if workshop_name is not None else None\n\n  # If there is no recipe (i.e., stick is a primitive that cannot be found) and no workshop, we cannot obtain it.\n  if not primitive_req and workshop_idx is None:\n      return []\n\n  actions = []\n  cur_pos = state.pos\n  inventory = state.inventory.copy()\n\n  # Collect all required primitive ingredients.\n  for prim_idx, needed in primitive_req.items():\n      while inventory[prim_idx] < needed:\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # Primitive not available on the map \u2013 abort planning.\n              return actions\n          target = tuple(prim_cells[0])\n          moves, cur_pos = _move_actions(cur_pos, target)\n          actions.extend(moves)\n          actions.append(4)                 # USE to pick up the primitive\n          inventory[prim_idx] += 1\n\n  # Move to the appropriate workshop (if required) and craft the stick.\n  if workshop_idx is not None:\n      ws_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if ws_cells.size == 0:\n          # Required workshop missing \u2013 abort.\n          return actions\n      target = tuple(ws_cells[0])\n      moves, cur_pos = _move_actions(cur_pos, target)\n      actions.extend(moves)\n      actions.append(4)                     # USE to craft the stick\n  else:\n      # No workshop needed; craft at current location.\n      actions.append(4)\n\n  return actions", "env_interactions": 4, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:22:28.930838", "function_name": "make_arrow", "function_body": "  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions from start to goal\n      (horizontal then vertical, ignoring obstacles).\"\"\"\n      x, y = start\n      gx, gy = goal\n      actions = []\n      while x < gx:\n          actions.append(ACTION_RIGHT)\n          x += 1\n      while x > gx:\n          actions.append(ACTION_LEFT)\n          x -= 1\n      while y < gy:\n          actions.append(ACTION_DOWN)\n          y += 1\n      while y > gy:\n          actions.append(ACTION_UP)\n          y -= 1\n      return actions\n\n  def nearest_position(positions, reference):\n      \"\"\"Pick the position from *positions* with smallest Manhattan distance\n      to *reference*.\"\"\"\n      if positions.shape[0] == 0:\n          return None\n      ref = np.array(reference)\n      dists = np.sum(np.abs(positions - ref), axis=1)\n      return tuple(positions[np.argmin(dists)])\n\n  # ------------------------------------------------------------------\n  # Gather current state information\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n\n  # ------------------------------------------------------------------\n  # Identify goal (stick)\n  # ------------------------------------------------------------------\n  goal_name = \"stick\"\n  try:\n      goal_idx = env.world.cookbook.index[goal_name]\n  except Exception:\n      return []\n\n  # If we already have a stick, nothing to do\n  if inventory[goal_idx] > 0:\n      return []\n\n  plan_actions = []\n\n  # ------------------------------------------------------------------\n  # 1) Collect required primitives (if any)\n  # ------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  for prim_idx, needed_cnt in primitives_needed.items():\n      while inventory[prim_idx] < needed_cnt:\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # No more of this primitive on the map \u2013 abort planning\n              return plan_actions\n          target = nearest_position(prim_cells, pos)\n\n          # Move to the primitive\n          plan_actions.extend(manhattan_path(pos, target))\n          pos = target\n\n          # Pick it up\n          plan_actions.append(ACTION_USE)\n\n          # Simulate local state update for further planning\n          inventory[prim_idx] += 1\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # ------------------------------------------------------------------\n  # 2) If stick itself is a primitive (no recipe), just pick it up\n  # ------------------------------------------------------------------\n  if goal_idx not in env.world.cookbook.recipes:\n      stick_cells = np.argwhere(grid[:, :, goal_idx] > 0)\n      if stick_cells.size == 0:\n          return plan_actions\n      target = nearest_position(stick_cells, pos)\n      plan_actions.extend(manhattan_path(pos, target))\n      plan_actions.append(ACTION_USE)\n      return plan_actions\n\n  # ------------------------------------------------------------------\n  # 3) Go to required workshop and craft the stick\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      return plan_actions\n\n  try:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n  except Exception:\n      return plan_actions\n\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.shape[0] == 0:\n      return plan_actions\n  wcell = tuple(workshop_cells[0])\n\n  # Find a free adjacent cell to stand on (fallback to workshop cell)\n  neighbours = [(wcell[0] + dx, wcell[1] + dy) for dx, dy in\n                [(1, 0), (-1, 0), (0, 1), (0, -1)]]\n  stand_pos = None\n  for nx, ny in neighbours:\n      if (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and\n              grid[nx, ny, :].sum() == 0):\n          stand_pos = (nx, ny)\n          break\n  if stand_pos is None:\n      stand_pos = wcell\n\n  plan_actions.extend(manhattan_path(pos, stand_pos))\n  plan_actions.append(ACTION_USE)\n\n  return plan_actions", "env_interactions": 5, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:22:30.358662", "function_name": "make_arrow", "function_body": "  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions from start to goal (horizontal then vertical).\"\"\"\n      x, y = start\n      gx, gy = goal\n      actions = []\n      while x < gx:\n          actions.append(ACTION_RIGHT)\n          x += 1\n      while x > gx:\n          actions.append(ACTION_LEFT)\n          x -= 1\n      while y < gy:\n          actions.append(ACTION_DOWN)\n          y += 1\n      while y > gy:\n          actions.append(ACTION_UP)\n          y -= 1\n      return actions\n\n  def nearest_position(positions, reference):\n      \"\"\"Pick the position from *positions* with smallest Manhattan distance to *reference*.\"\"\"\n      if positions.shape[0] == 0:\n          return None\n      ref = np.array(reference)\n      dists = np.sum(np.abs(positions - ref), axis=1)\n      return tuple(positions[np.argmin(dists)])\n\n  # ------------------------------------------------------------------\n  # Gather state information\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n\n  # ------------------------------------------------------------------\n  # Identify goal (stick)\n  # ------------------------------------------------------------------\n  goal_name = \"stick\"\n  try:\n      goal_idx = env.world.cookbook.index[goal_name]\n  except Exception:\n      return []\n\n  # If we already have a stick, nothing to do\n  if inventory[goal_idx] > 0:\n      return []\n\n  plan_actions = []\n\n  # ------------------------------------------------------------------\n  # 1) Collect needed primitives (if any)\n  # ------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  for prim_idx, needed_cnt in primitives_needed.items():\n      while inventory[prim_idx] < needed_cnt:\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # No more of this primitive on the map \u2013 abort planning\n              return plan_actions\n          target = nearest_position(prim_cells, pos)\n\n          # Move to the primitive\n          plan_actions.extend(manhattan_path(pos, target))\n          pos = target\n\n          # Pick it up\n          plan_actions.append(ACTION_USE)\n\n          # Update local copies for further planning\n          inventory[prim_idx] += 1\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # ------------------------------------------------------------------\n  # 2) If stick itself is a primitive (no recipe), just pick it up\n  # ------------------------------------------------------------------\n  if goal_idx not in env.world.cookbook.recipes:\n      stick_cells = np.argwhere(grid[:, :, goal_idx] > 0)\n      if stick_cells.size == 0:\n          return plan_actions\n      target = nearest_position(stick_cells, pos)\n      plan_actions.extend(manhattan_path(pos, target))\n      pos = target\n      plan_actions.append(ACTION_USE)\n      return plan_actions\n\n  # ------------------------------------------------------------------\n  # 3) Go to required workshop and craft the stick\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      return plan_actions\n\n  try:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n  except Exception:\n      return plan_actions\n\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.shape[0] == 0:\n      return plan_actions\n  wcell = tuple(workshop_cells[0])\n\n  # Find a free adjacent cell to stand on (fallback to workshop cell)\n  neighbours = [(wcell[0] + dx, wcell[1] + dy) for dx, dy in\n                [(1, 0), (-1, 0), (0, 1), (0, -1)]]\n  stand_pos = None\n  for nx, ny in neighbours:\n      if (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and\n              grid[nx, ny, :].sum() == 0):\n          stand_pos = (nx, ny)\n          break\n  if stand_pos is None:\n      stand_pos = wcell\n\n  # Move to the chosen standing position\n  plan_actions.extend(manhattan_path(pos, stand_pos))\n  pos = stand_pos\n\n  # Use the workshop to craft the stick\n  plan_actions.append(ACTION_USE)\n\n  return plan_actions", "env_interactions": 5, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:22:53.216375", "function_name": "make_arrow", "function_body": "  # reset environment and get initial state\n  env.reset()\n  state = env._current_state\n  grid = state.grid\n  width, height = grid.shape[:2]\n\n  # movement directions and mapping to action indices (DOWN=0, UP=1, LEFT=2, RIGHT=3)\n  dirs = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n  dir_action = {(0, 1): 0, (0, -1): 1, (-1, 0): 2, (1, 0): 3}\n  USE = 4\n\n  actions = []\n\n  # helper: locate all cells containing a given kind index\n  def find_cells(kind):\n      xs, ys = np.where(grid[:, :, kind] > 0)\n      return list(zip(xs.tolist(), ys.tolist()))\n\n  # BFS path planner on free cells (no entity in any channel)\n  from collections import deque\n\n  def bfs(start, goal):\n      \"\"\"Return list of (dx,dy) moves from start to goal avoiding occupied cells.\"\"\"\n      if start == goal:\n          return []\n      q = deque([start])\n      visited = {start}\n      prev = {}\n      while q:\n          x, y = q.popleft()\n          for dx, dy in dirs:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height:\n                  if (nx, ny) not in visited and not grid[nx, ny].any():\n                      visited.add((nx, ny))\n                      prev[(nx, ny)] = (x, y, (dx, dy))\n                      if (nx, ny) == goal:\n                          q.clear()\n                          break\n                      q.append((nx, ny))\n      if goal not in prev:\n          return []  # no path found\n      # reconstruct\n      path = []\n      cur = goal\n      while cur != start:\n          px, py, move = prev[cur]\n          path.append(move)\n          cur = (px, py)\n      path.reverse()\n      return path\n\n  # ------------------------------------------------------------------\n  # Identify stick recipe\n  # ------------------------------------------------------------------\n  stick_idx = env.world.cookbook.index[\"stick\"]\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  primitive_needs = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  # ------------------------------------------------------------------\n  # Collect required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, count in primitive_needs.items():\n      for _ in range(count):\n          cells = find_cells(prim_idx)\n          if not cells:\n              continue  # primitive not present\n          tx, ty = cells[0]\n\n          # try to stand on a free neighbour opposite the direction we will face\n          placed = False\n          for dx, dy in dirs:\n              nx, ny = tx - dx, ty - dy\n              if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  # face the primitive\n                  actions.append(dir_action[(-dx, -dy)])\n                  state.dir = dir_action[(-dx, -dy)]\n                  actions.append(USE)  # pick up\n                  placed = True\n                  break\n          if not placed:\n              # fallback: any adjacent free cell then turn\n              for dx, dy in dirs:\n                  nx, ny = tx + dx, ty + dy\n                  if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                      path = bfs(state.pos, (nx, ny))\n                      for mv in path:\n                          actions.append(dir_action[mv])\n                          state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                          state.dir = dir_action[mv]\n                      actions.append(dir_action[(-dx, -dy)])\n                      state.dir = dir_action[(-dx, -dy)]\n                      actions.append(USE)\n                      placed = True\n                      break\n          # after picking up, the primitive cell becomes empty; update grid view\n          grid[tx, ty, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Craft at required workshop (if any)\n  # ------------------------------------------------------------------\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      w_cells = find_cells(workshop_idx)\n      if w_cells:\n          wx, wy = w_cells[0]\n          for dx, dy in dirs:\n              nx, ny = wx - dx, wy - dy\n              if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  actions.append(USE)  # craft stick\n                  break\n\n  return actions", "env_interactions": 4, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:22:54.576964", "function_name": "make_arrow", "function_body": "  # Reset environment and get current state\n  env.reset()\n  state = env._current_state\n  grid = state.grid\n  width, height = grid.shape[:2]\n\n  # Direction vectors and mapping to action indices (DOWN=0, UP=1, LEFT=2, RIGHT=3)\n  dirs = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n  dir_action = {(0, 1): 0, (0, -1): 1, (-1, 0): 2, (1, 0): 3}\n\n  actions = []\n\n  # Helper: locate all cells that contain a given kind index\n  def find_cells(kind):\n      xs, ys = np.where(grid[:, :, kind] > 0)\n      return list(zip(xs.tolist(), ys.tolist()))\n\n  # BFS that returns a list of (dx,dy) moves from start to goal avoiding occupied cells\n  from collections import deque\n\n  def bfs(start, goal):\n      \"\"\"Return a list of (dx,dy) moves from start to goal on free cells.\"\"\"\n      if start == goal:\n          return []\n      q = deque([start])\n      visited = {start}\n      prev = {}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          x, y = cur\n          for dx, dy in dirs:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height:\n                  if (nx, ny) not in visited and not grid[nx, ny].any():\n                      visited.add((nx, ny))\n                      prev[(nx, ny)] = (cur, (dx, dy))\n                      q.append((nx, ny))\n      if goal not in prev:\n          return []  # no path found\n      # Reconstruct path\n      path = []\n      cur = goal\n      while cur != start:\n          prev_node, move = prev[cur]\n          path.append(move)\n          cur = prev_node\n      path.reverse()\n      return path\n\n  # ----------------------------------------------------------------------\n  # Identify the recipe for a stick\n  # ----------------------------------------------------------------------\n  stick_idx = env.world.cookbook.index[\"stick\"]\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  primitive_needs = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive the needed number of times\n  # ----------------------------------------------------------------------\n  for prim_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          prim_cells = find_cells(prim_idx)\n          if not prim_cells:\n              continue  # primitive not present in the current grid\n          tx, ty = prim_cells[0]\n\n          # Try to stand on a free neighbour from which we can USE the primitive\n          neighbour_found = False\n          for dx, dy in dirs:\n              nx, ny = tx - dx, ty - dy  # cell opposite the direction we will face\n              if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  # Face the primitive\n                  actions.append(dir_action[(-dx, -dy)])\n                  state.dir = dir_action[(-dx, -dy)]\n                  # Pick it up\n                  actions.append(4)  # USE\n                  neighbour_found = True\n                  break\n\n          if not neighbour_found:\n              # Fallback: any adjacent free cell, then turn towards primitive\n              for dx, dy in dirs:\n                  nx, ny = tx + dx, ty + dy\n                  if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                      path = bfs(state.pos, (nx, ny))\n                      for mv in path:\n                          actions.append(dir_action[mv])\n                          state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                          state.dir = dir_action[mv]\n                      actions.append(dir_action[(-dx, -dy)])\n                      state.dir = dir_action[(-dx, -dy)]\n                      actions.append(4)  # USE\n                      neighbour_found = True\n                      break\n\n  # ----------------------------------------------------------------------\n  # If the recipe requires a workshop, move there and craft the stick\n  # ----------------------------------------------------------------------\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      workshop_cells = find_cells(workshop_idx)\n      if workshop_cells:\n          wx, wy = workshop_cells[0]\n          # Find a free neighbour to stand on\n          for dx, dy in dirs:\n              nx, ny = wx - dx, wy - dy\n              if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  actions.append(4)  # USE to craft the stick\n                  break\n\n  return actions", "env_interactions": 8, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-23T02:23:15.953650", "function_name": "make_arrow", "function_body": "  # Reset environment and obtain initial state\n  env.reset()\n  state = env._current_state\n  goal_idx = env.task.goal\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # Helper: locations of a given kind on the grid\n  def find_positions(kind):\n      locs = np.argwhere(state.grid[:, :, kind] > 0)\n      return [tuple(p) for p in locs]\n\n  # Helper: nearest location of a kind to a position\n  def nearest(pos, kind):\n      positions = find_positions(kind)\n      if not positions:\n          return None\n      return min(positions, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n\n  # Helper: simple Manhattan move sequence (DOWN,UP,RIGHT,LEFT)\n  def moves_to(src, dst):\n      sx, sy = src\n      dx, dy = dst\n      seq = []\n      while sx < dx:\n          seq.append(0)   # DOWN\n          sx += 1\n      while sx > dx:\n          seq.append(1)   # UP\n          sx -= 1\n      while sy < dy:\n          seq.append(3)   # RIGHT\n          sy += 1\n      while sy > dy:\n          seq.append(2)   # LEFT\n          sy -= 1\n      return seq\n\n  # -----------------------------------------------------------------\n  # 1) If the goal is a primitive (no recipe), just go to it and pick up.\n  # -----------------------------------------------------------------\n  if not env.world.cookbook.primitives_for(goal_idx):\n      target = nearest(cur_pos, goal_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)   # USE to collect\n      return actions\n\n  # -----------------------------------------------------------------\n  # 2) Collect required primitive ingredients.\n  # -----------------------------------------------------------------\n  needed = env.world.cookbook.primitives_for(goal_idx)\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          target = nearest(cur_pos, prim_idx)\n          if target is None:\n              continue\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n          actions.append(4)   # USE to pick up primitive\n\n  # -----------------------------------------------------------------\n  # 3) Move to workshop (if specified) and craft the stick.\n  # -----------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  if isinstance(recipe, dict):\n      workshop_idx = recipe.get('_at')\n      if workshop_idx is None:\n          # fallback: any non\u2011integer key could hold workshop id\n          for k, v in recipe.items():\n              if isinstance(k, str) and k != '_at':\n                  workshop_idx = v\n                  break\n\n  if workshop_idx is not None:\n      target = nearest(cur_pos, workshop_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)   # USE at workshop to craft\n  else:\n      # No explicit workshop \u2013 just use at current location.\n      actions.append(4)\n\n  return actions", "env_interactions": 1, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:23:17.294729", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  goal_idx = env.task.goal\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  def find_positions(kind):\n      locs = np.argwhere(state.grid[:, :, kind] > 0)\n      return [tuple(p) for p in locs]\n\n  def nearest(pos, kind):\n      positions = find_positions(kind)\n      if not positions:\n          return None\n      return min(positions, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n\n  def moves_to(src, dst):\n      sx, sy = src\n      dx, dy = dst\n      seq = []\n      while sx < dx:\n          seq.append(0)   # DOWN\n          sx += 1\n      while sx > dx:\n          seq.append(1)   # UP\n          sx -= 1\n      while sy < dy:\n          seq.append(3)   # RIGHT\n          sy += 1\n      while sy > dy:\n          seq.append(2)   # LEFT\n          sy -= 1\n      return seq\n\n  # If the goal is a primitive with no recipe, just pick it up.\n  if not env.world.cookbook.primitives_for(goal_idx):\n      target = nearest(cur_pos, goal_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)   # USE to collect primitive\n      return actions\n\n  # Collect required primitive ingredients.\n  needed_prims = env.world.cookbook.primitives_for(goal_idx)\n  for prim_idx, count in needed_prims.items():\n      for _ in range(count):\n          target = nearest(cur_pos, prim_idx)\n          if target is None:\n              continue\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n          actions.append(4)   # USE to pick up primitive\n\n  # Move to the workshop (if any) and craft.\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  if isinstance(recipe, dict):\n      workshop_idx = recipe.get('_at')\n      if workshop_idx is None:\n          for k, v in recipe.items():\n              if isinstance(k, str) and k != '_at':\n                  workshop_idx = v\n                  break\n\n  if workshop_idx is not None:\n      target = nearest(cur_pos, workshop_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)   # USE at workshop to craft\n  else:\n      actions.append(4)   # USE to craft in place\n\n  return actions", "env_interactions": 1, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:23:38.970642", "function_name": "make_arrow", "function_body": "  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions from start to goal using\n      horizontal\u2011then\u2011vertical moves (ignores obstacles).\"\"\"\n      x, y = start\n      gx, gy = goal\n      actions = []\n      while x < gx:\n          actions.append(ACTION_RIGHT)\n          x += 1\n      while x > gx:\n          actions.append(ACTION_LEFT)\n          x -= 1\n      while y < gy:\n          actions.append(ACTION_DOWN)\n          y += 1\n      while y > gy:\n          actions.append(ACTION_UP)\n          y -= 1\n      return actions\n\n  def nearest_position(positions, reference):\n      \"\"\"Pick the position from *positions* with smallest Manhattan distance\n      to *reference*.\"\"\"\n      if positions.shape[0] == 0:\n          return None\n      ref = np.array(reference)\n      dists = np.sum(np.abs(positions - ref), axis=1)\n      return tuple(positions[np.argmin(dists)])\n\n  # ------------------------------------------------------------------\n  # Gather current state information\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n\n  # ------------------------------------------------------------------\n  # Identify the goal (stick)\n  # ------------------------------------------------------------------\n  goal_name = \"stick\"\n  try:\n      goal_idx = env.world.cookbook.index[goal_name]\n  except Exception:\n      # Goal not present \u2013 nothing to do\n      return []\n\n  # If we already have a stick in inventory, no actions are needed\n  if inventory[goal_idx] > 0:\n      return []\n\n  plan_actions = []\n\n  # ------------------------------------------------------------------\n  # 1) Collect needed primitives (if any)\n  # ------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  for prim_idx, needed_cnt in primitives_needed.items():\n      while inventory[prim_idx] < needed_cnt:\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # No more of this primitive on the map \u2013 abort planning\n              return plan_actions\n          target = nearest_position(prim_cells, pos)\n\n          # Move to the primitive\n          plan_actions.extend(manhattan_path(pos, target))\n          pos = target\n\n          # Pick it up\n          plan_actions.append(ACTION_USE)\n\n          # Simulate local state update for further planning\n          inventory[prim_idx] += 1\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # ------------------------------------------------------------------\n  # 2) If stick itself is a primitive (no recipe), just pick it up\n  # ------------------------------------------------------------------\n  if goal_idx not in env.world.cookbook.recipes:\n      stick_cells = np.argwhere(grid[:, :, goal_idx] > 0)\n      if stick_cells.size == 0:\n          return plan_actions\n      target = nearest_position(stick_cells, pos)\n      plan_actions.extend(manhattan_path(pos, target))\n      plan_actions.append(ACTION_USE)\n      return plan_actions\n\n  # ------------------------------------------------------------------\n  # 3) Go to the required workshop and craft the stick\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      try:\n          workshop_idx = env.world.cookbook.index[workshop_name]\n      except Exception:\n          return plan_actions\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          return plan_actions\n      wcell = tuple(workshop_cells[0])\n\n      # Find a free adjacent cell to stand on (or fallback to the workshop cell)\n      neighbours = [(wcell[0] + dx, wcell[1] + dy) for dx, dy in\n                    [(1, 0), (-1, 0), (0, 1), (0, -1)]]\n      stand_pos = None\n      for nx, ny in neighbours:\n          if (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and\n                  grid[nx, ny, :].sum() == 0):\n              stand_pos = (nx, ny)\n              break\n      if stand_pos is None:\n          stand_pos = wcell  # fallback\n\n      plan_actions.extend(manhattan_path(pos, stand_pos))\n      pos = stand_pos\n\n      # Craft the stick\n      plan_actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # Return the constructed action list\n  # ------------------------------------------------------------------\n  return plan_actions", "env_interactions": 5, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:23:40.289902", "function_name": "make_arrow", "function_body": "  # Action indices as defined in CraftLab.action_specs\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions from start to goal using\n      horizontal\u2011then\u2011vertical moves (ignores obstacles).\"\"\"\n      x, y = start\n      gx, gy = goal\n      actions = []\n      while x < gx:\n          actions.append(ACTION_RIGHT)\n          x += 1\n      while x > gx:\n          actions.append(ACTION_LEFT)\n          x -= 1\n      while y < gy:\n          actions.append(ACTION_DOWN)\n          y += 1\n      while y > gy:\n          actions.append(ACTION_UP)\n          y -= 1\n      return actions\n\n  def nearest_position(positions, reference):\n      \"\"\"Pick the position from *positions* with smallest Manhattan distance\n      to *reference*.\"\"\"\n      if positions.shape[0] == 0:\n          return None\n      ref = np.array(reference)\n      dists = np.sum(np.abs(positions - ref), axis=1)\n      return tuple(positions[np.argmin(dists)])\n\n  # ------------------------------------------------------------------\n  # Gather current state information\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n\n  # ------------------------------------------------------------------\n  # Identify the goal (stick)\n  # ------------------------------------------------------------------\n  goal_name = \"stick\"\n  try:\n      goal_idx = env.world.cookbook.index[goal_name]\n  except Exception:\n      # Goal not present \u2013 nothing to do\n      return []\n\n  # If we already have a stick in inventory, no actions are needed\n  if inventory[goal_idx] > 0:\n      return []\n\n  plan_actions = []\n\n  # ------------------------------------------------------------------\n  # 1) Collect needed primitives (if any)\n  # ------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  for prim_idx, needed_cnt in primitives_needed.items():\n      while inventory[prim_idx] < needed_cnt:\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # No more of this primitive on the map \u2013 abort planning\n              return plan_actions\n          target = nearest_position(prim_cells, pos)\n\n          # Move to the primitive\n          plan_actions.extend(manhattan_path(pos, target))\n          pos = target\n\n          # Pick it up\n          plan_actions.append(ACTION_USE)\n\n          # Simulate local state update for further planning\n          inventory[prim_idx] += 1\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # ------------------------------------------------------------------\n  # 2) If stick itself is a primitive (no recipe), just pick it up\n  # ------------------------------------------------------------------\n  if goal_idx not in env.world.cookbook.recipes:\n      stick_cells = np.argwhere(grid[:, :, goal_idx] > 0)\n      if stick_cells.size == 0:\n          return plan_actions\n      target = nearest_position(stick_cells, pos)\n\n      plan_actions.extend(manhattan_path(pos, target))\n      pos = target\n      plan_actions.append(ACTION_USE)\n      return plan_actions\n\n  # ------------------------------------------------------------------\n  # 3) Go to the required workshop and craft the stick\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      try:\n          workshop_idx = env.world.cookbook.index[workshop_name]\n      except Exception:\n          return plan_actions\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          return plan_actions\n      wcell = tuple(workshop_cells[0])\n\n      # Find a free adjacent cell to stand on (or fallback to the workshop cell)\n      neighbours = [(wcell[0] + dx, wcell[1] + dy) for dx, dy in\n                    [(1, 0), (-1, 0), (0, 1), (0, -1)]]\n      stand_pos = None\n      for nx, ny in neighbours:\n          if (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and\n                  grid[nx, ny, :].sum() == 0):\n              stand_pos = (nx, ny)\n              break\n      if stand_pos is None:\n          stand_pos = wcell  # fallback\n\n      plan_actions.extend(manhattan_path(pos, stand_pos))\n      pos = stand_pos\n\n      # Craft the stick\n      plan_actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # Return the constructed action list\n  # ------------------------------------------------------------------\n  return plan_actions", "env_interactions": 5, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T02:24:03.126637", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  grid = state.grid\n  width, height = grid.shape[:2]\n\n  # movement vectors and mapping to action ids\n  dirs = [(0, 1), (0, -1), (-1, 0), (1, 0)]          # DOWN, UP, LEFT, RIGHT\n  dir_action = {(0, 1): 0, (0, -1): 1, (-1, 0): 2, (1, 0): 3}\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # helpers\n  # ------------------------------------------------------------------\n  def find_cells(kind):\n      xs, ys = np.where(grid[:, :, kind] > 0)\n      return list(zip(xs.tolist(), ys.tolist()))\n\n  from collections import deque\n\n  def bfs(start, goal):\n      \"\"\"Return list of (dx,dy) moves from start to goal on free cells.\"\"\"\n      q = deque([start])\n      visited = {start}\n      prev = {}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          x, y = cur\n          for dx, dy in dirs:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height:\n                  if (nx, ny) not in visited and not grid[nx, ny].any():\n                      visited.add((nx, ny))\n                      prev[(nx, ny)] = (cur, (dx, dy))\n                      q.append((nx, ny))\n      if start == goal:\n          return []\n      if goal not in prev:\n          return []          # no path found\n      # reconstruct path\n      path = []\n      cur = goal\n      while cur != start:\n          pnode, move = prev[cur]\n          path.append(move)\n          cur = pnode\n      path.reverse()\n      return path\n\n  # ------------------------------------------------------------------\n  # identify stick recipe\n  # ------------------------------------------------------------------\n  stick_idx = env.world.cookbook.index[\"stick\"]\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  primitive_needs = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  # ------------------------------------------------------------------\n  # collect required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          prim_cells = find_cells(prim_idx)\n          if not prim_cells:\n              continue\n          tx, ty = prim_cells[0]\n\n          # try to stand on a free neighbour opposite the direction we will face\n          neighbour_found = False\n          for dx, dy in dirs:\n              nx, ny = tx - dx, ty - dy\n              if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  # face the primitive\n                  actions.append(dir_action[(-dx, -dy)])\n                  state.dir = dir_action[(-dx, -dy)]\n                  # pick up\n                  actions.append(4)          # USE\n                  neighbour_found = True\n                  break\n          if not neighbour_found:\n              # fallback: any adjacent free cell\n              for dx, dy in dirs:\n                  nx, ny = tx + dx, ty + dy\n                  if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                      path = bfs(state.pos, (nx, ny))\n                      for mv in path:\n                          actions.append(dir_action[mv])\n                          state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                          state.dir = dir_action[mv]\n                      actions.append(dir_action[(-dx, -dy)])\n                      state.dir = dir_action[(-dx, -dy)]\n                      actions.append(4)\n                      break\n\n  # ------------------------------------------------------------------\n  # craft at required workshop (if any)\n  # ------------------------------------------------------------------\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      workshop_cells = find_cells(workshop_idx)\n      if workshop_cells:\n          wx, wy = workshop_cells[0]\n          for dx, dy in dirs:\n              nx, ny = wx - dx, wy - dy\n              if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  actions.append(4)          # USE to craft\n                  break\n\n  return actions", "env_interactions": 8, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-23T02:24:04.458989", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  grid = state.grid\n  width, height = grid.shape[:2]\n\n  # Direction vectors and mapping to action indices (DOWN=0, UP=1, LEFT=2, RIGHT=3)\n  dirs = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n  dir_action = {(0, 1): 0, (0, -1): 1, (-1, 0): 2, (1, 0): 3}\n\n  actions = []\n\n  # Helper: locate all cells that contain a given kind index\n  def find_cells(kind):\n      xs, ys = np.where(grid[:, :, kind] > 0)\n      return list(zip(xs.tolist(), ys.tolist()))\n\n  # BFS returning a list of (dx,dy) moves on free cells only\n  from collections import deque\n\n  def bfs(start, goal):\n      \"\"\"Return list of moves (dx,dy) from start to goal avoiding occupied cells.\"\"\"\n      q = deque([start])\n      visited = {start}\n      prev = {}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          x, y = cur\n          for dx, dy in dirs:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height:\n                  if (nx, ny) not in visited and not grid[nx, ny].any():\n                      visited.add((nx, ny))\n                      prev[(nx, ny)] = (cur, (dx, dy))\n                      q.append((nx, ny))\n      if start == goal:\n          return []\n      if goal not in prev:\n          return []  # no path found\n      # reconstruct path\n      path = []\n      cur = goal\n      while cur != start:\n          prev_node, move = prev[cur]\n          path.append(move)\n          cur = prev_node\n      path.reverse()\n      return path\n\n  # ----------------------------------------------------------------------\n  # Identify the recipe for a stick\n  # ----------------------------------------------------------------------\n  stick_idx = env.world.cookbook.index[\"stick\"]\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  primitive_needs = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive the needed number of times\n  # ----------------------------------------------------------------------\n  for prim_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          prim_cells = find_cells(prim_idx)\n          if not prim_cells:\n              continue  # primitive not present; skip\n          tx, ty = prim_cells[0]\n\n          # Try to stand on a free neighbour from which we can USE the primitive\n          neighbour_found = False\n          for dx, dy in dirs:\n              nx, ny = tx - dx, ty - dy  # cell opposite the direction we will face\n              if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  # Face the primitive\n                  actions.append(dir_action[(-dx, -dy)])\n                  state.dir = dir_action[(-dx, -dy)]\n                  # Pick up\n                  actions.append(4)  # USE\n                  neighbour_found = True\n                  break\n\n          if not neighbour_found:\n              # Fallback: any adjacent free cell, then turn towards primitive\n              for dx, dy in dirs:\n                  nx, ny = tx + dx, ty + dy\n                  if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                      path = bfs(state.pos, (nx, ny))\n                      for mv in path:\n                          actions.append(dir_action[mv])\n                          state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                          state.dir = dir_action[mv]\n                      actions.append(dir_action[(-dx, -dy)])  # face primitive\n                      state.dir = dir_action[(-dx, -dy)]\n                      actions.append(4)  # USE\n                      break\n\n  # ----------------------------------------------------------------------\n  # If the recipe requires a workshop, move there and craft the stick\n  # ----------------------------------------------------------------------\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      workshop_cells = find_cells(workshop_idx)\n      if workshop_cells:\n          wx, wy = workshop_cells[0]\n          # Find a free neighbour to stand on\n          for dx, dy in dirs:\n              nx, ny = wx - dx, wy - dy\n              if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  # Use to craft\n                  actions.append(4)  # USE\n                  break\n\n  return actions", "env_interactions": 8, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-23T02:24:21.046947", "function_name": "make_arrow", "function_body": "  # Get action indices\n  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act.get(\"DOWN\", 0),\n      act.get(\"UP\", 1),\n      act.get(\"LEFT\", 2),\n      act.get(\"RIGHT\", 3),\n      act.get(\"USE\", 4),\n  )\n\n  # Snapshot of current state (do not modify the environment)\n  state = env._current_state\n  grid = state.grid.copy()                 # (W, H, n_kinds)\n  cur_pos = tuple(state.pos)               # (x, y)\n\n  # Index of the goal item \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n      if stick_idx is None:\n          return []   # stick not defined in the world\n\n  # Recipe for a stick: mapping from kind index (or special keys) to counts\n  recipe = env.world.cookbook.primitives_for(stick_idx)\n\n  # Primitive requirements (int keys are item kinds)\n  primitive_needs = {k: v for k, v in recipe.items() if isinstance(k, int)}\n  # If stick itself is a primitive (no recipe), we need to collect one stick\n  if not primitive_needs:\n      primitive_needs = {stick_idx: 1}\n\n  # Detect workshop requirement (non\u2011int key in recipe)\n  workshop_idx = None\n  for k, v in recipe.items():\n      if not isinstance(k, int):\n          workshop_idx = v if isinstance(v, int) else None\n          break\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper: find the closest cell that still has at least one of the given kind\n  # ------------------------------------------------------------------\n  def find_closest(kind_idx, cur):\n      positions = np.argwhere(grid[:, :, kind_idx] > 0)\n      if positions.shape[0] == 0:\n          return None\n      dists = np.sum(np.abs(positions - np.array(cur)), axis=1)\n      nearest = positions[np.argmin(dists)]\n      return tuple(nearest.tolist())\n\n  # ------------------------------------------------------------------\n  # Helper: generate a simple Manhattan path (greedy) from cur to target\n  # ------------------------------------------------------------------\n  def path_to(cur, target):\n      x, y = cur\n      tx, ty = target\n      path = []\n      while (x, y) != (tx, ty):\n          if x < tx:\n              path.append(RIGHT)\n              x += 1\n          elif x > tx:\n              path.append(LEFT)\n              x -= 1\n          elif y < ty:\n              path.append(DOWN)\n              y += 1\n          elif y > ty:\n              path.append(UP)\n              y -= 1\n      return path, (x, y)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the needed number of times\n  # ------------------------------------------------------------------\n  for kind_idx, needed in primitive_needs.items():\n      while needed > 0:\n          target = find_closest(kind_idx, cur_pos)\n          if target is None:\n              # No more of this primitive on the map \u2013 abort planning\n              return actions\n          move_actions, cur_pos = path_to(cur_pos, target)\n          actions.extend(move_actions)\n          actions.append(USE)   # pick up / use the primitive\n\n          # Update local grid copy to reflect the collection\n          grid[target[0], target[1], kind_idx] = max(\n              0, grid[target[0], target[1], kind_idx] - 1\n          )\n          needed -= 1\n\n  # ------------------------------------------------------------------\n  # If a workshop is required, move to it and craft the stick\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_target = find_closest(workshop_idx, cur_pos)\n      if ws_target is not None:\n          move_actions, cur_pos = path_to(cur_pos, ws_target)\n          actions.extend(move_actions)\n          actions.append(USE)   # craft stick at the workshop\n\n  return actions", "env_interactions": 2, "island_id": 2, "scores": {"3": 0.0}}
