{"timestamp": "2025-10-23T03:10:20.276298", "function_name": "make_arrow", "function_body": "  # Helper BFS to find shortest path avoiding blocked cells\n  def _bfs_path(start, goal, blocked):\n      act = env.action_specs()\n      moves = [\n          (0, 1, act[\"DOWN\"]),\n          (0, -1, act[\"UP\"]),\n          (-1, 0, act[\"LEFT\"]),\n          (1, 0, act[\"RIGHT\"]),\n      ]\n      from collections import deque\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for dx, dy, a in moves:\n              nx, ny = x + dx, y + dy\n              if (\n                  0 <= nx < blocked.shape[0]\n                  and 0 <= ny < blocked.shape[1]\n                  and not blocked[nx, ny]\n                  and (nx, ny) not in visited\n              ):\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [a]))\n      return None\n\n  # ----------------------------------------------------------------------\n  # Main planning for stick\n  # ----------------------------------------------------------------------\n  state = env._current_state\n  world = env.world\n  grid = state.grid.copy()\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # Primitive requirements for a stick (empty if stick is primitive)\n  needed_prims = dict(world.cookbook.primitives_for(stick_idx))\n\n  # Cells that block movement (non\u2011grabbable entities)\n  blocked = np.zeros(grid.shape[:2], dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # ----------------------------------------------------------------------\n  # Case 1: stick is already a primitive placed in the world\n  # ----------------------------------------------------------------------\n  if not needed_prims:\n      stick_cells = np.argwhere(grid[:, :, stick_idx] > 0)\n      if stick_cells.size == 0:\n          return []  # no stick to pick up\n      target = tuple(stick_cells[0])\n      if cur_pos != target:\n          path = _bfs_path(cur_pos, target, blocked)\n          if path is None:\n              return []  # unreachable\n          actions.extend(path)\n      actions.append(env.action_specs()[\"USE\"])\n      return actions\n\n  # ----------------------------------------------------------------------\n  # Case 2: collect required primitives\n  # ----------------------------------------------------------------------\n  while any(cnt > 0 for cnt in needed_prims.values()):\n      best_path = None\n      best_target = None\n      best_prim = None\n\n      for prim_idx, cnt in needed_prims.items():\n          if cnt <= 0:\n              continue\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          for cell in prim_cells:\n              target = tuple(cell)\n              path = _bfs_path(cur_pos, target, blocked)\n              if path is None:\n                  continue\n              if best_path is None or len(path) < len(best_path):\n                  best_path = path\n                  best_target = target\n                  best_prim = prim_idx\n\n      if best_path is None:\n          # No reachable primitive left; cannot complete task\n          return []\n\n      actions.extend(best_path)\n      actions.append(env.action_specs()[\"USE\"])\n\n      # Update bookkeeping\n      cur_pos = best_target\n      needed_prims[best_prim] -= 1\n      grid[best_target[0], best_target[1], best_prim] = 0\n\n  # ----------------------------------------------------------------------\n  # Case 3: go to the workshop (if required by the recipe)\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_cells.size > 0:\n          target = tuple(ws_cells[0])\n          if cur_pos != target:\n              path = _bfs_path(cur_pos, target, blocked)\n              if path is None:\n                  return []  # cannot reach workshop\n              actions.extend(path)\n              cur_pos = target\n\n  # ----------------------------------------------------------------------\n  # Finally, craft the stick\n  # ----------------------------------------------------------------------\n  actions.append(env.action_specs()[\"USE\"])\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:10:21.574507", "function_name": "make_arrow", "function_body": "  # Helper: BFS shortest path avoiding blocked cells\n  def _bfs_path(start, goal, blocked):\n      act = env.action_specs()\n      moves = [\n          (0, 1, act[\"DOWN\"]),\n          (0, -1, act[\"UP\"]),\n          (-1, 0, act[\"LEFT\"]),\n          (1, 0, act[\"RIGHT\"]),\n      ]\n      from collections import deque\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for dx, dy, a in moves:\n              nx, ny = x + dx, y + dy\n              if (\n                  0 <= nx < blocked.shape[0]\n                  and 0 <= ny < blocked.shape[1]\n                  and not blocked[nx, ny]\n                  and (nx, ny) not in visited\n              ):\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [a]))\n      return None\n\n  # ----------------------------------------------------------------------\n  # Gather required data from the environment\n  # ----------------------------------------------------------------------\n  state = env._current_state\n  world = env.world\n  grid = state.grid.copy()\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # Primitive requirements for a stick (empty dict if stick is primitive)\n  needed_prims = dict(world.cookbook.primitives_for(stick_idx))\n\n  # Cells that block movement (non\u2011grabbable entities)\n  blocked = np.zeros(grid.shape[:2], dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # ----------------------------------------------------------------------\n  # Case A: stick is a primitive already placed in the world\n  # ----------------------------------------------------------------------\n  if not needed_prims:\n      stick_cells = np.argwhere(grid[:, :, stick_idx] > 0)\n      if stick_cells.size == 0:\n          return []  # nothing to pick up\n      target = tuple(stick_cells[0])\n      if cur_pos != target:\n          path = _bfs_path(cur_pos, target, blocked)\n          if path is None:\n              return []  # unreachable\n          actions.extend(path)\n          cur_pos = target\n      actions.append(env.action_specs()[\"USE\"])\n      return actions\n\n  # ----------------------------------------------------------------------\n  # Case B: collect all needed primitive resources\n  # ----------------------------------------------------------------------\n  while any(cnt > 0 for cnt in needed_prims.values()):\n      best_path = None\n      best_target = None\n      best_prim = None\n\n      for prim_idx, cnt in needed_prims.items():\n          if cnt <= 0:\n              continue\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          for cell in prim_cells:\n              target = tuple(cell)\n              path = _bfs_path(cur_pos, target, blocked)\n              if path is None:\n                  continue\n              if best_path is None or len(path) < len(best_path):\n                  best_path = path\n                  best_target = target\n                  best_prim = prim_idx\n\n      if best_path is None:\n          # No reachable primitive left \u2013 cannot finish the task\n          return []\n\n      actions.extend(best_path)\n      actions.append(env.action_specs()[\"USE\"])\n\n      # Update bookkeeping\n      cur_pos = best_target\n      needed_prims[best_prim] -= 1\n      grid[best_target[0], best_target[1], best_prim] = 0\n\n  # ----------------------------------------------------------------------\n  # Case C: move to the workshop required by the stick recipe (if any)\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_cells.size > 0:\n          target = tuple(ws_cells[0])\n          if cur_pos != target:\n              path = _bfs_path(cur_pos, target, blocked)\n              if path is None:\n                  return []  # cannot reach workshop\n              actions.extend(path)\n              cur_pos = target\n\n  # ----------------------------------------------------------------------\n  # Finally, craft the stick\n  # ----------------------------------------------------------------------\n  actions.append(env.action_specs()[\"USE\"])\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:10:47.294385", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  grid = state.grid\n  width, height = grid.shape[:2]\n\n  # direction vectors and mapping to action ids (DOWN=0, UP=1, LEFT=2, RIGHT=3)\n  dirs = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n  dir_action = {(0, 1): 0, (0, -1): 1, (-1, 0): 2, (1, 0): 3}\n\n  actions = []\n\n  # helper to locate all cells that contain a given kind index\n  def find_cells(kind):\n      xs, ys = np.where(grid[:, :, kind] > 0)\n      return list(zip(xs.tolist(), ys.tolist()))\n\n  from collections import deque\n\n  def bfs(start, goal):\n      \"\"\"Return a list of (dx,dy) moves from start to goal on free cells.\"\"\"\n      if start == goal:\n          return []\n      q = deque([start])\n      visited = {start}\n      prev = {}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          x, y = cur\n          for dx, dy in dirs:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height:\n                  if (nx, ny) not in visited and not grid[nx, ny].any():\n                      visited.add((nx, ny))\n                      prev[(nx, ny)] = (cur, (dx, dy))\n                      q.append((nx, ny))\n      if goal not in prev:\n          return []  # no path found\n      # reconstruct path\n      path = []\n      cur = goal\n      while cur != start:\n          pnode, move = prev[cur]\n          path.append(move)\n          cur = pnode\n      path.reverse()\n      return path\n\n  # ------------------------------------------------------------------\n  # Identify the recipe for a stick\n  # ------------------------------------------------------------------\n  stick_idx = env.world.cookbook.index[\"stick\"]\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n\n  if recipe:\n      # ------------------------------------------------------------------\n      # Collect each required primitive the needed number of times\n      # ------------------------------------------------------------------\n      primitive_needs = {k: v for k, v in recipe.items() if k != \"_at\"}\n      for prim_idx, needed in primitive_needs.items():\n          for _ in range(needed):\n              prim_cells = find_cells(prim_idx)\n              if not prim_cells:\n                  continue\n              tx, ty = prim_cells[0]\n\n              # Try to stand on a free neighbour opposite the direction we will face\n              neighbour_found = False\n              for dx, dy in dirs:\n                  nx, ny = tx - dx, ty - dy\n                  if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                      path = bfs(state.pos, (nx, ny))\n                      for mv in path:\n                          actions.append(dir_action[mv])\n                          state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                          state.dir = dir_action[mv]\n                      actions.append(dir_action[(-dx, -dy)])   # face the primitive\n                      state.dir = dir_action[(-dx, -dy)]\n                      actions.append(4)                        # USE to pick up\n                      neighbour_found = True\n                      break\n\n              if not neighbour_found:\n                  # Fallback: any adjacent free cell, then turn towards primitive\n                  for dx, dy in dirs:\n                      nx, ny = tx + dx, ty + dy\n                      if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                          path = bfs(state.pos, (nx, ny))\n                          for mv in path:\n                              actions.append(dir_action[mv])\n                              state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                              state.dir = dir_action[mv]\n                          actions.append(dir_action[(-dx, -dy)])\n                          state.dir = dir_action[(-dx, -dy)]\n                          actions.append(4)\n                          break\n\n      # ------------------------------------------------------------------\n      # If a workshop is required, move there and craft the stick\n      # ------------------------------------------------------------------\n      workshop_name = recipe.get(\"_at\")\n      if workshop_name:\n          workshop_idx = env.world.cookbook.index[workshop_name]\n          workshop_cells = find_cells(workshop_idx)\n          if workshop_cells:\n              wx, wy = workshop_cells[0]\n              for dx, dy in dirs:\n                  nx, ny = wx - dx, wy - dy\n                  if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                      path = bfs(state.pos, (nx, ny))\n                      for mv in path:\n                          actions.append(dir_action[mv])\n                          state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                          state.dir = dir_action[mv]\n                      actions.append(4)   # USE to craft the stick\n                      break\n  else:\n      # ------------------------------------------------------------------\n      # No recipe: stick itself is a primitive. Just pick one up.\n      # ------------------------------------------------------------------\n      stick_cells = find_cells(stick_idx)\n      if stick_cells:\n          tx, ty = stick_cells[0]\n          neighbour_found = False\n          for dx, dy in dirs:\n              nx, ny = tx - dx, ty - dy\n              if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  actions.append(dir_action[(-dx, -dy)])\n                  state.dir = dir_action[(-dx, -dy)]\n                  actions.append(4)\n                  neighbour_found = True\n                  break\n          if not neighbour_found:\n              for dx, dy in dirs:\n                  nx, ny = tx + dx, ty + dy\n                  if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                      path = bfs(state.pos, (nx, ny))\n                      for mv in path:\n                          actions.append(dir_action[mv])\n                          state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                          state.dir = dir_action[mv]\n                      actions.append(dir_action[(-dx, -dy)])\n                      state.dir = dir_action[(-dx, -dy)]\n                      actions.append(4)\n                      break\n\n  return actions", "env_interactions": 8, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-23T03:10:48.637846", "function_name": "make_arrow", "function_body": "  # Reset environment to start fresh\n  env.reset()\n  state = env._current_state\n  grid = state.grid\n  width, height = grid.shape[:2]\n\n  # Direction vectors and corresponding action ids (DOWN=0, UP=1, LEFT=2, RIGHT=3)\n  dirs = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n  dir_action = {(0, 1): 0, (0, -1): 1, (-1, 0): 2, (1, 0): 3}\n\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # Helper utilities\n  # ----------------------------------------------------------------------\n  def find_cells(kind):\n      \"\"\"Return list of (x, y) coordinates where a given kind is present.\"\"\"\n      xs, ys = np.where(grid[:, :, kind] > 0)\n      return list(zip(xs.tolist(), ys.tolist()))\n\n  from collections import deque\n\n  def bfs(start, goal):\n      \"\"\"Return list of (dx, dy) moves from start to goal on free cells.\"\"\"\n      if start == goal:\n          return []\n      q = deque([start])\n      visited = {start}\n      prev = {}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          x, y = cur\n          for dx, dy in dirs:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height:\n                  if (nx, ny) not in visited and not grid[nx, ny].any():\n                      visited.add((nx, ny))\n                      prev[(nx, ny)] = (cur, (dx, dy))\n                      q.append((nx, ny))\n      if goal not in prev:\n          return []  # no path found\n      # reconstruct path\n      path = []\n      cur = goal\n      while cur != start:\n          pnode, move = prev[cur]\n          path.append(move)\n          cur = pnode\n      path.reverse()\n      return path\n\n  # ----------------------------------------------------------------------\n  # Identify the recipe for a stick\n  # ----------------------------------------------------------------------\n  stick_idx = env.world.cookbook.index[\"stick\"]\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  primitive_needs = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive the needed number of times\n  # ----------------------------------------------------------------------\n  for prim_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          prim_cells = find_cells(prim_idx)\n          if not prim_cells:\n              continue  # primitive not present in this scenario\n          tx, ty = prim_cells[0]\n\n          # Try to stand on a free neighbour opposite the direction we will face\n          neighbour_found = False\n          for dx, dy in dirs:\n              nx, ny = tx - dx, ty - dy  # cell from which we can face the primitive\n              if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                  # Move to (nx, ny)\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  # Face the primitive\n                  actions.append(dir_action[(-dx, -dy)])\n                  state.dir = dir_action[(-dx, -dy)]\n                  # Pick up\n                  actions.append(4)  # USE\n                  neighbour_found = True\n                  break\n\n          if not neighbour_found:\n              # Fallback: any adjacent free cell, then turn toward the primitive\n              for dx, dy in dirs:\n                  nx, ny = tx + dx, ty + dy\n                  if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                      path = bfs(state.pos, (nx, ny))\n                      for mv in path:\n                          actions.append(dir_action[mv])\n                          state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                          state.dir = dir_action[mv]\n                      actions.append(dir_action[(-dx, -dy)])\n                      state.dir = dir_action[(-dx, -dy)]\n                      actions.append(4)  # USE\n                      neighbour_found = True\n                      break\n\n  # ----------------------------------------------------------------------\n  # If the recipe requires a workshop, move there and craft the stick\n  # ----------------------------------------------------------------------\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      workshop_cells = find_cells(workshop_idx)\n      if workshop_cells:\n          wx, wy = workshop_cells[0]\n          # Find a free neighbour to stand on\n          for dx, dy in dirs:\n              nx, ny = wx - dx, wy - dy\n              if 0 <= nx < width and 0 <= ny < height and not grid[nx, ny].any():\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  # Craft at the workshop\n                  actions.append(4)  # USE\n                  break\n\n  return actions", "env_interactions": 8, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-23T03:11:12.247012", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  # Action mapping (same as in CraftWorld)\n  _ACTION_DELTAS = {\n      0: (1, 0),   # DOWN\n      1: (-1, 0),  # UP\n      2: (0, -1),  # LEFT\n      3: (0, 1),   # RIGHT\n  }\n\n  def _move_actions(start, goal):\n      \"\"\"Manhattan path from start (row, col) to goal (row, col).\"\"\"\n      y, x = start\n      gy, gx = goal\n      actions = []\n      while y < gy:\n          actions.append(0)   # DOWN\n          y += 1\n      while y > gy:\n          actions.append(1)   # UP\n          y -= 1\n      while x < gx:\n          actions.append(3)   # RIGHT\n          x += 1\n      while x > gx:\n          actions.append(2)   # LEFT\n          x -= 1\n      return actions\n\n  # ------------------------------------------------------------------\n  # Locate world object\n  # ------------------------------------------------------------------\n  if hasattr(env, \"world\"):\n      world = env.world\n  elif hasattr(env, \"scenario\"):\n      world = env.scenario.world\n  else:\n      raise AttributeError(\"Cannot locate CraftWorld instance in the supplied env.\")\n\n  # ------------------------------------------------------------------\n  # Goal information (stick)\n  # ------------------------------------------------------------------\n  goal_name = \"stick\"\n  goal_idx = world.cookbook.index.index(goal_name)\n\n  # Primitives required to craft the stick (empty if stick itself is primitive)\n  needed = world.cookbook.primitives_for(goal_idx)\n\n  collect_directly = False\n  if not needed:\n      # Stick is a primitive that must be collected directly\n      needed = {goal_idx: 1}\n      collect_directly = True\n\n  # ------------------------------------------------------------------\n  # Current state (grid & position) for planning\n  # ------------------------------------------------------------------\n  if hasattr(env, \"_current_state\"):\n      state = env._current_state\n  else:\n      state = env.scenario.init()\n  cur_pos = tuple(state.pos)          # (row, col)\n  grid = state.grid.copy()            # (H, W, n_kinds)\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Collect all required primitives (or the stick itself if primitive)\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(\n                  f\"Required primitive {world.cookbook.index.get(prim_idx)} not found on the grid.\"\n              )\n          py, px = prim_cells[0]\n\n          # Find an empty neighbour from which we can face the primitive\n          target_cell = None\n          for d, (dy, dx) in _ACTION_DELTAS.items():\n              ny, nx = py - dy, px - dx\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  if not grid[ny, nx, :].any():\n                      target_cell = (ny, nx)\n                      break\n          if target_cell is None:\n              raise RuntimeError(\"No reachable empty neighbour around required primitive.\")\n\n          # Move to that neighbour\n          actions.extend(_move_actions(cur_pos, target_cell))\n          cur_pos = target_cell\n\n          # Use (pick up / craft) the primitive\n          actions.append(4)   # USE\n\n          # Update planning grid: primitive disappears after use\n          grid[py, px, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # If a workshop is required (i.e., stick is not a direct primitive),\n  # move to it and USE to craft.\n  # ------------------------------------------------------------------\n  if not collect_directly:\n      recipe = world.cookbook.recipes.get(goal_idx, {})\n      workshop_name = recipe.get(\"_at\")\n      if workshop_name:\n          workshop_idx = world.cookbook.index.index(workshop_name)\n          ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n          if ws_cells.size == 0:\n              raise RuntimeError(f\"Workshop {workshop_name} not found on the grid.\")\n          wy, wx = ws_cells[0]\n\n          # Find empty neighbour to face the workshop\n          target_cell = None\n          for d, (dy, dx) in _ACTION_DELTAS.items():\n              ny, nx = wy - dy, wx - dx\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  if not grid[ny, nx, :].any():\n                      target_cell = (ny, nx)\n                      break\n          if target_cell is None:\n              raise RuntimeError(\"No reachable empty neighbour around workshop.\")\n\n          # Move there and craft\n          actions.extend(_move_actions(cur_pos, target_cell))\n          cur_pos = target_cell\n          actions.append(4)   # USE\n\n  # ------------------------------------------------------------------\n  # Return the planned action sequence\n  # ------------------------------------------------------------------\n  return actions", "env_interactions": 5, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:11:13.538772", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  _ACTION_DELTAS = {\n      0: (1, 0),   # DOWN\n      1: (-1, 0),  # UP\n      2: (0, -1),  # LEFT\n      3: (0, 1),   # RIGHT\n  }\n\n  def _move_actions(start, goal):\n      \"\"\"Manhattan path from start (y,x) to goal (y,x) using orthogonal moves.\"\"\"\n      y, x = start\n      gy, gx = goal\n      actions = []\n      while y < gy:\n          actions.append(0)   # DOWN\n          y += 1\n      while y > gy:\n          actions.append(1)   # UP\n          y -= 1\n      while x < gx:\n          actions.append(3)   # RIGHT\n          x += 1\n      while x > gx:\n          actions.append(2)   # LEFT\n          x -= 1\n      return actions\n\n  # ------------------------------------------------------------------\n  # Locate the CraftWorld instance inside the provided env\n  # ------------------------------------------------------------------\n  if hasattr(env, \"world\"):\n      world = env.world\n  elif hasattr(env, \"scenario\"):\n      world = env.scenario.world\n  else:\n      raise AttributeError(\"Cannot locate CraftWorld instance in the supplied env.\")\n\n  # ------------------------------------------------------------------\n  # Goal information (stick)\n  # ------------------------------------------------------------------\n  goal_name = \"stick\"\n  goal_idx = world.cookbook.index.index(goal_name)\n\n  # Determine which primitive items are needed to craft a stick.\n  needed = world.cookbook.primitives_for(goal_idx)\n\n  # If there is no recipe, the stick itself is a primitive that must be collected.\n  collect_directly = False\n  if not needed:\n      needed = {goal_idx: 1}\n      collect_directly = True\n\n  # ------------------------------------------------------------------\n  # Obtain the current state (grid and agent position) for planning.\n  # ------------------------------------------------------------------\n  if hasattr(env, \"_current_state\"):\n      state = env._current_state\n  else:\n      state = env.scenario.init()\n  cur_pos = tuple(state.pos)          # (row, col)\n  grid = state.grid.copy()            # (H, W, n_kinds)\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Collect all required primitives (or the stick itself if primitive)\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(\n                  f\"Required primitive {world.cookbook.index.get(prim_idx)} not found on the grid.\"\n              )\n          py, px = prim_cells[0]\n\n          # Find an empty neighbour from which we can face the primitive.\n          target_cell = None\n          for d, (dy, dx) in _ACTION_DELTAS.items():\n              ny, nx = py - dy, px - dx\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  if not grid[ny, nx, :].any():\n                      target_cell = (ny, nx)\n                      break\n          if target_cell is None:\n              raise RuntimeError(\"No reachable empty neighbour around required primitive.\")\n\n          # Move to that neighbour.\n          actions.extend(_move_actions(cur_pos, target_cell))\n          cur_pos = target_cell\n\n          # Use (pick up / craft) the primitive.\n          actions.append(4)   # USE\n\n          # Update planning grid: primitive disappears after use.\n          grid[py, px, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # If a workshop is required (i.e., stick is not a direct primitive),\n  # move to it and USE to craft.\n  # ------------------------------------------------------------------\n  if not collect_directly:\n      recipe = world.cookbook.recipes.get(goal_idx, {})\n      workshop_name = recipe.get(\"_at\")\n      if workshop_name:\n          workshop_idx = world.cookbook.index.index(workshop_name)\n          ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n          if ws_cells.size == 0:\n              raise RuntimeError(f\"Workshop {workshop_name} not found on the grid.\")\n          wy, wx = ws_cells[0]\n\n          # Find an empty neighbour to face the workshop.\n          target_cell = None\n          for d, (dy, dx) in _ACTION_DELTAS.items():\n              ny, nx = wy - dy, wx - dx\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  if not grid[ny, nx, :].any():\n                      target_cell = (ny, nx)\n                      break\n          if target_cell is None:\n              raise RuntimeError(\"No reachable empty neighbour around workshop.\")\n\n          # Move there and craft.\n          actions.extend(_move_actions(cur_pos, target_cell))\n          cur_pos = target_cell\n          actions.append(4)   # USE\n\n  # ------------------------------------------------------------------\n  # Return the planned action sequence.\n  # ------------------------------------------------------------------\n  return actions", "env_interactions": 5, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:11:31.992715", "function_name": "make_arrow", "function_body": "  actions = []\n  state = env._current_state\n  grid = state.grid\n  world = env.world\n  cb = world.cookbook\n\n  try:\n      goal_idx = cb.index[\"stick\"]\n  except Exception:\n      return actions\n\n  needed = cb.primitives_for(goal_idx)\n\n  pos = list(state.pos)\n\n  def _move_to(target):\n      nonlocal pos, actions\n      tx, ty = target\n      while pos[0] < tx:\n          actions.append(3)  # RIGHT\n          pos[0] += 1\n      while pos[0] > tx:\n          actions.append(2)  # LEFT\n          pos[0] -= 1\n      while pos[1] < ty:\n          actions.append(0)  # DOWN\n          pos[1] += 1\n      while pos[1] > ty:\n          actions.append(1)  # UP\n          pos[1] -= 1\n\n  if not needed:\n      locs = np.argwhere(grid[:, :, goal_idx] > 0)\n      if locs.size:\n          _move_to(locs[0].tolist())\n          actions.append(4)  # USE\n      return actions\n\n  for prim_idx, count in needed.items():\n      locs = np.argwhere(grid[:, :, prim_idx] > 0)\n      if not locs.size:\n          continue\n      target = locs[0].tolist()\n      _move_to(target)\n      for _ in range(count):\n          actions.append(4)  # USE\n\n  recipe = cb.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = cb.index[workshop_name]\n      w_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if w_locs.size:\n          _move_to(w_locs[0].tolist())\n          actions.append(4)  # USE to craft\n\n  return actions", "env_interactions": 4, "island_id": 1, "scores": {"3": 0.0}}
