{"timestamp": "2025-10-23T03:51:41.069373", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # Mapping from action index to (dy, dx) movement\n  _ACTION_DELTAS = {\n      0: (1, 0),   # DOWN\n      1: (-1, 0),  # UP\n      2: (0, -1),  # LEFT\n      3: (0, 1),   # RIGHT\n  }\n\n  def _move_actions(start, goal):\n      \"\"\"Manhattan path from start (y, x) to goal (y, x).\"\"\"\n      y, x = start\n      gy, gx = goal\n      acts = []\n      while y < gy:\n          acts.append(0)   # DOWN\n          y += 1\n      while y > gy:\n          acts.append(1)   # UP\n          y -= 1\n      while x < gx:\n          acts.append(3)   # RIGHT\n          x += 1\n      while x > gx:\n          acts.append(2)   # LEFT\n          x -= 1\n      return acts\n\n  # ----------------------------------------------------------------------\n  # Locate the CraftWorld instance inside the supplied env\n  # ----------------------------------------------------------------------\n  if hasattr(env, \"world\"):\n      world = env.world\n  elif hasattr(env, \"scenario\"):\n      world = env.scenario.world\n  else:\n      raise AttributeError(\"Cannot locate CraftWorld instance in the supplied env.\")\n\n  # ----------------------------------------------------------------------\n  # Goal information (stick)\n  # ----------------------------------------------------------------------\n  goal_name = \"stick\"\n  goal_idx = world.cookbook.index.index(goal_name)\n\n  # Primitives required to craft the stick (empty if stick itself is primitive)\n  needed = world.cookbook.primitives_for(goal_idx)\n\n  # If there is no recipe, treat the stick as a primitive that must be collected\n  collect_directly = False\n  if not needed:\n      needed = {goal_idx: 1}\n      collect_directly = True\n\n  # ----------------------------------------------------------------------\n  # Obtain current state for planning\n  # ----------------------------------------------------------------------\n  if hasattr(env, \"_current_state\"):\n      state = env._current_state\n  else:\n      state = env.scenario.init()\n  cur_pos = tuple(state.pos)          # (row, col)\n  grid = state.grid.copy()            # (H, W, n_kinds)\n\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # Helper to collect a primitive from the grid\n  # ----------------------------------------------------------------------\n  def _collect(p_idx):\n      nonlocal cur_pos, actions, grid\n      cells = np.argwhere(grid[:, :, p_idx] > 0)\n      if cells.size == 0:\n          raise RuntimeError(\n              f\"Primitive {world.cookbook.index.get(p_idx)} not found on the grid.\"\n          )\n      py, px = cells[0]\n\n      # Find an empty neighbour cell to stand on\n      target = None\n      for d, (dy, dx) in _ACTION_DELTAS.items():\n          ny, nx = py - dy, px - dx\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not grid[ny, nx, :].any():          # empty cell\n                  target = (ny, nx)\n                  break\n      if target is None:\n          raise RuntimeError(\"No reachable empty neighbour around required primitive.\")\n\n      # Move to the neighbour and use\n      actions.extend(_move_actions(cur_pos, target))\n      cur_pos = target\n      actions.append(4)   # USE\n      grid[py, px, p_idx] = 0   # primitive disappears after pickup\n\n  # ----------------------------------------------------------------------\n  # 1. Collect all required primitives (or the stick itself if primitive)\n  # ----------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          _collect(prim_idx)\n\n  # ----------------------------------------------------------------------\n  # 2. If crafting is needed, move to the appropriate workshop and USE\n  # ----------------------------------------------------------------------\n  if not collect_directly:\n      recipe = world.cookbook.recipes.get(goal_idx, {})\n      workshop_name = recipe.get(\"_at\")\n      if workshop_name:\n          workshop_idx = world.cookbook.index.index(workshop_name)\n          ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n          if ws_cells.size == 0:\n              raise RuntimeError(f\"Workshop {workshop_name} not found on the grid.\")\n          wy, wx = ws_cells[0]\n\n          # Find an empty neighbour to stand on\n          target = None\n          for d, (dy, dx) in _ACTION_DELTAS.items():\n              ny, nx = wy - dy, wx - dx\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  if not grid[ny, nx, :].any():\n                      target = (ny, nx)\n                      break\n          if target is None:\n              raise RuntimeError(\"No reachable empty neighbour around workshop.\")\n\n          actions.extend(_move_actions(cur_pos, target))\n          cur_pos = target\n          actions.append(4)   # USE to craft the stick\n\n  # ----------------------------------------------------------------------\n  # Return the planned action sequence\n  # ----------------------------------------------------------------------\n  return actions", "env_interactions": 5, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:52:29.532875", "function_name": "make_arrow", "function_body": "", "env_interactions": 0, "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-10-23T03:52:30.853719", "function_name": "make_arrow", "function_body": "  try:\n      state = env._current_state\n  except AttributeError:\n      env.reset()\n      state = env._current_state\n\n  # Get action indices, with fallback defaults\n  try:\n      specs = env.action_specs()\n      DOWN = specs[\"DOWN\"]\n      UP = specs[\"UP\"]\n      LEFT = specs[\"LEFT\"]\n      RIGHT = specs[\"RIGHT\"]\n      USE = specs[\"USE\"]\n  except Exception:\n      DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Index for the target item \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      return []\n\n  # Determine primitive requirements for a stick (empty if primitive)\n  prim_req = env.world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n  grid = state.grid.copy()\n\n  # Build blocked mask (non\u2011traversable cells)\n  blocked = np.zeros(grid.shape[:2], dtype=bool)\n  for idx in env.world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # BFS helper to compute shortest path avoiding blocked cells\n  dirs = [\n      (1, 0, DOWN),   # down\n      (-1, 0, UP),    # up\n      (0, -1, LEFT),  # left\n      (0, 1, RIGHT),  # right\n  ]\n\n  def bfs_path(start, goal, blocked_mask):\n      q = collections.deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for dx, dy, act in dirs:\n              nx, ny = x + dx, y + dy\n              if (\n                  0 <= nx < blocked_mask.shape[0]\n                  and 0 <= ny < blocked_mask.shape[1]\n                  and not blocked_mask[nx, ny]\n                  and (nx, ny) not in visited\n              ):\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [act]))\n      return None\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # ------------------------------------------------------------------\n  # Case 1: stick is a primitive already placed in the world.\n  # ------------------------------------------------------------------\n  if not prim_req:\n      cells = np.argwhere(grid[:, :, stick_idx] > 0)\n      if cells.size == 0:\n          return []  # no stick to pick up\n      target = tuple(cells[0])\n      if cur_pos != target:\n          path = bfs_path(cur_pos, target, blocked)\n          if path is None:\n              return []  # unreachable\n          actions.extend(path)\n          cur_pos = target\n      actions.append(USE)\n      return actions\n\n  # ------------------------------------------------------------------\n  # Case 2: collect required primitives.\n  # ------------------------------------------------------------------\n  needed = dict(prim_req)  # mutable copy\n  while any(cnt > 0 for cnt in needed.values()):\n      best_path = None\n      best_target = None\n      best_prim = None\n\n      for prim_idx, cnt in needed.items():\n          if cnt <= 0:\n              continue\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          for cell in prim_cells:\n              target = tuple(cell)\n              path = bfs_path(cur_pos, target, blocked)\n              if path is None:\n                  continue\n              if best_path is None or len(path) < len(best_path):\n                  best_path = path\n                  best_target = target\n                  best_prim = prim_idx\n\n      if best_path is None:\n          return []  # cannot reach remaining primitives\n\n      actions.extend(best_path)\n      actions.append(USE)\n\n      # Update planning state\n      cur_pos = best_target\n      needed[best_prim] -= 1\n      grid[best_target[0], best_target[1], best_prim] = 0  # remove collected primitive\n\n  # ------------------------------------------------------------------\n  # Case 3: move to required workshop (if recipe specifies one) and craft.\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      try:\n          workshop_idx = env.world.cookbook.index[workshop_name]\n      except Exception:\n          workshop_idx = None\n      if workshop_idx is not None:\n          ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n          if ws_cells.size > 0:\n              ws_target = tuple(ws_cells[0])\n              if cur_pos != ws_target:\n                  path = bfs_path(cur_pos, ws_target, blocked)\n                  if path is not None:\n                      actions.extend(path)\n                      cur_pos = ws_target\n\n  # Final crafting action\n  actions.append(USE)\n  return actions", "env_interactions": 3, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:52:50.168182", "function_name": "make_arrow", "function_body": "  # Get current state and world reference\n  state = env._current_state\n  world = env.world\n\n  # Action mapping (ensure USE exists)\n  act_map = env.action_specs()\n  USE = act_map[\"USE\"]\n\n  # Index of the target item \"stick\"\n  try:\n      stick_idx = world.cookbook.index[\"stick\"]\n  except Exception:\n      return []  # cannot find stick in index\n\n  # Primitive requirements for a stick (empty dict if stick is primitive)\n  prim_req = world.cookbook.primitives_for(stick_idx)\n\n  # Working copy of the grid for planning\n  grid = state.grid.copy()\n\n  # Build mask of blocked cells (non\u2011grabbable entities)\n  blocked = np.zeros(grid.shape[:2], dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions (direction indices)\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  def _bfs_path(start, goal):\n      directions = [\n          (0, 1, act_map[\"DOWN\"]),\n          (0, -1, act_map[\"UP\"]),\n          (-1, 0, act_map[\"LEFT\"]),\n          (1, 0, act_map[\"RIGHT\"]),\n      ]\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for dx, dy, a in directions:\n              nx, ny = x + dx, y + dy\n              if (\n                  0 <= nx < blocked.shape[0]\n                  and 0 <= ny < blocked.shape[1]\n                  and not blocked[nx, ny]\n                  and (nx, ny) not in visited\n              ):\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [a]))\n      return None  # unreachable\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # ------------------------------------------------------------------\n  # Case 1: stick is already a primitive placed in the world\n  # ------------------------------------------------------------------\n  if not prim_req:\n      stick_cells = np.argwhere(grid[:, :, stick_idx] > 0)\n      if stick_cells.size == 0:\n          return []  # no stick present\n      target = tuple(stick_cells[0])\n      if cur_pos != target:\n          path = _bfs_path(cur_pos, target)\n          if path is None:\n              return []  # unreachable\n          actions.extend(path)\n      actions.append(USE)\n      return actions\n\n  # ------------------------------------------------------------------\n  # Case 2: collect required primitives\n  # ------------------------------------------------------------------\n  needed = dict(prim_req)  # mutable copy of required counts\n\n  while any(cnt > 0 for cnt in needed.values()):\n      best_path = None\n      best_target = None\n      best_prim = None\n\n      # Find nearest reachable needed primitive\n      for prim_idx, cnt in needed.items():\n          if cnt <= 0:\n              continue\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          for cell in prim_cells:\n              target = tuple(cell)\n              path = _bfs_path(cur_pos, target)\n              if path is None:\n                  continue\n              if best_path is None or len(path) < len(best_path):\n                  best_path = path\n                  best_target = target\n                  best_prim = prim_idx\n\n      if best_path is None:\n          # No reachable required primitive left\n          return actions\n\n      # Move to the primitive and pick it up\n      actions.extend(best_path)\n      actions.append(USE)\n\n      # Update planning state\n      cur_pos = best_target\n      needed[best_prim] -= 1\n      grid[best_target[0], best_target[1], best_prim] = 0  # remove from copy\n\n  # ------------------------------------------------------------------\n  # Case 3: go to the required workshop (if any) and craft the stick\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          target = tuple(workshop_cells[0])\n          if cur_pos != target:\n              path = _bfs_path(cur_pos, target)\n              if path is None:\n                  return actions\n              actions.extend(path)\n              cur_pos = target\n\n  # Final crafting action\n  actions.append(USE)\n  return actions", "env_interactions": 2, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:52:51.498320", "function_name": "make_arrow", "function_body": "  # Access current state and world configuration\n  state = env._current_state\n  world = env.world\n\n  # Action indices\n  act_map = env.action_specs()\n  USE = act_map[\"USE\"]\n\n  # Index of the target item \"stick\"\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # Determine primitive requirements for a stick (empty if stick is primitive)\n  prim_req = world.cookbook.primitives_for(stick_idx)\n\n  # Working copy of the grid for planning\n  grid = state.grid.copy()\n\n  # Build a mask of blocked cells (non\u2011grabbable entities)\n  blocked = np.zeros(grid.shape[:2], dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # ------------------------------------------------------------------\n  # Helper: breadth\u2011first search returning a list of action indices\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  directions = [\n      (0, 1, act_map[\"DOWN\"]),\n      (0, -1, act_map[\"UP\"]),\n      (-1, 0, act_map[\"LEFT\"]),\n      (1, 0, act_map[\"RIGHT\"]),\n  ]\n\n  def _bfs_path(start, goal):\n      \"\"\"Return a list of actions moving from start to goal, or None if unreachable.\"\"\"\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for dx, dy, a in directions:\n              nx, ny = x + dx, y + dy\n              if (\n                  0 <= nx < blocked.shape[0]\n                  and 0 <= ny < blocked.shape[1]\n                  and not blocked[nx, ny]\n                  and (nx, ny) not in visited\n              ):\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [a]))\n      return None\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # ------------------------------------------------------------------\n  # Case 1: stick is a primitive already placed in the world\n  # ------------------------------------------------------------------\n  if not prim_req:\n      stick_cells = np.argwhere(grid[:, :, stick_idx] > 0)\n      if stick_cells.size == 0:\n          return []  # nothing to pick up\n      target = tuple(stick_cells[0])\n      if cur_pos != target:\n          path = _bfs_path(cur_pos, target)\n          if path is None:\n              return []  # unreachable\n          actions.extend(path)\n      actions.append(USE)\n      return actions\n\n  # ------------------------------------------------------------------\n  # Case 2: collect required primitives\n  # ------------------------------------------------------------------\n  needed = dict(prim_req)  # mutable copy of required counts\n\n  while any(cnt > 0 for cnt in needed.values()):\n      best_path = None\n      best_target = None\n      best_prim = None\n\n      # Find the nearest reachable needed primitive\n      for prim_idx, cnt in needed.items():\n          if cnt <= 0:\n              continue\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          for cell in prim_cells:\n              target = tuple(cell)\n              path = _bfs_path(cur_pos, target)\n              if path is None:\n                  continue\n              if best_path is None or len(path) < len(best_path):\n                  best_path = path\n                  best_target = target\n                  best_prim = prim_idx\n\n      if best_path is None:\n          # No reachable required primitive left\n          return actions\n\n      # Move to the primitive and pick it up\n      actions.extend(best_path)\n      actions.append(USE)\n\n      # Update planning state\n      cur_pos = best_target\n      needed[best_prim] -= 1\n      grid[best_target[0], best_target[1], best_prim] = 0  # remove from planning copy\n\n  # ------------------------------------------------------------------\n  # Case 3: go to the required workshop (if any)\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          target = tuple(workshop_cells[0])\n          if cur_pos != target:\n              path = _bfs_path(cur_pos, target)\n              if path is not None:\n                  actions.extend(path)\n                  cur_pos = target\n\n  # ------------------------------------------------------------------\n  # Finally, craft the stick\n  # ------------------------------------------------------------------\n  actions.append(USE)\n  return actions", "env_interactions": 3, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:53:14.040984", "function_name": "make_arrow", "function_body": "  # get current state (reset if needed)\n  try:\n      state = env._current_state\n  except AttributeError:\n      env.reset()\n      state = env._current_state\n\n  # obtain action ids (fallback order)\n  try:\n      specs = env.action_specs()\n      DOWN = specs[\"DOWN\"]\n      UP = specs[\"UP\"]\n      LEFT = specs[\"LEFT\"]\n      RIGHT = specs[\"RIGHT\"]\n      USE = specs[\"USE\"]\n  except Exception:\n      DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # index of the target item \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      return []  # stick not defined\n\n  # primitive requirements for stick (empty dict -> primitive)\n  prim_req = env.world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n  grid = state.grid.copy()  # (W, H, n_kinds)\n\n  # construct blocked mask: any non\u2011grabbable entity blocks movement\n  blocked = np.zeros(grid.shape[:2], dtype=bool)\n  for idx in env.world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # ------------------------------------------------------------------\n  # Helper: BFS returning list of action indices from start to goal.\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  def bfs_path(start, goal, blocked_mask):\n      dirs = [\n          (1, 0, DOWN),   # down  (x+1)\n          (-1, 0, UP),    # up    (x-1)\n          (0, -1, LEFT),  # left  (y-1)\n          (0, 1, RIGHT),  # right (y+1)\n      ]\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for dx, dy, act in dirs:\n              nx, ny = x + dx, y + dy\n              if (\n                  0 <= nx < blocked_mask.shape[0]\n                  and 0 <= ny < blocked_mask.shape[1]\n                  and not blocked_mask[nx, ny]\n                  and (nx, ny) not in visited\n              ):\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [act]))\n      return None\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # ------------------------------------------------------------------\n  # Case 1: stick is a primitive already placed in the world.\n  # ------------------------------------------------------------------\n  if not prim_req:\n      stick_cells = np.argwhere(grid[:, :, stick_idx] > 0)\n      if stick_cells.size == 0:\n          return []  # nothing to pick up\n      target = tuple(stick_cells[0])\n      if cur_pos != target:\n          path = bfs_path(cur_pos, target, blocked)\n          if path is None:\n              return []  # unreachable\n          actions.extend(path)\n          cur_pos = target\n      actions.append(USE)\n      return actions\n\n  # ------------------------------------------------------------------\n  # Case 2: need to gather primitives.\n  # ------------------------------------------------------------------\n  needed = dict(prim_req)  # mutable copy\n  while any(cnt > 0 for cnt in needed.values()):\n      best_path = None\n      best_target = None\n      best_prim = None\n\n      # search for nearest needed primitive that is reachable\n      for prim_idx, cnt in needed.items():\n          if cnt <= 0:\n              continue\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          for cell in prim_cells:\n              target = tuple(cell)\n              path = bfs_path(cur_pos, target, blocked)\n              if path is None:\n                  continue\n              if best_path is None or len(path) < len(best_path):\n                  best_path = path\n                  best_target = target\n                  best_prim = prim_idx\n\n      if best_path is None:\n          return []  # cannot reach any remaining primitive\n\n      # move to primitive and pick it up\n      actions.extend(best_path)\n      actions.append(USE)\n\n      # update planning state\n      cur_pos = best_target\n      needed[best_prim] -= 1\n      grid[best_target[0], best_target[1], best_prim] = 0  # remove from copy\n\n  # ------------------------------------------------------------------\n  # Case 3: move to workshop (if recipe specifies one) and craft.\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      try:\n          workshop_idx = env.world.cookbook.index[workshop_name]\n      except Exception:\n          workshop_idx = None\n      if workshop_idx is not None:\n          ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n          if ws_cells.size > 0:\n              ws_target = tuple(ws_cells[0])\n              if cur_pos != ws_target:\n                  path = bfs_path(cur_pos, ws_target, blocked)\n                  if path is not None:\n                      actions.extend(path)\n                      cur_pos = ws_target\n\n  # final crafting action\n  actions.append(USE)\n  return actions", "env_interactions": 3, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:53:15.361689", "function_name": "make_arrow", "function_body": "  try:\n      state = env._current_state\n  except AttributeError:\n      env.reset()\n      state = env._current_state\n\n  # Obtain action indices, with fallback defaults\n  try:\n      specs = env.action_specs()\n      DOWN = specs[\"DOWN\"]\n      UP = specs[\"UP\"]\n      LEFT = specs[\"LEFT\"]\n      RIGHT = specs[\"RIGHT\"]\n      USE = specs[\"USE\"]\n  except Exception:\n      DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Index of the target item \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      return []  # stick not defined\n\n  # Primitive requirements for a stick (empty dict if stick is primitive)\n  prim_req = env.world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n  grid = state.grid.copy()\n\n  # Build mask of blocked cells (non\u2011grabbable entities)\n  blocked = np.zeros(grid.shape[:2], dtype=bool)\n  for idx in env.world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # ------------------------------------------------------------------\n  # Helper: BFS shortest path avoiding blocked cells.\n  # Returns a list of action indices moving from start to goal, or None.\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  def bfs_path(start, goal, blocked_mask):\n      dirs = [\n          (1, 0, DOWN),   # down (+x)\n          (-1, 0, UP),    # up   (-x)\n          (0, -1, LEFT),  # left (-y)\n          (0, 1, RIGHT),  # right(+y)\n      ]\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for dx, dy, act in dirs:\n              nx, ny = x + dx, y + dy\n              if (\n                  0 <= nx < blocked_mask.shape[0]\n                  and 0 <= ny < blocked_mask.shape[1]\n                  and not blocked_mask[nx, ny]\n                  and (nx, ny) not in visited\n              ):\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [act]))\n      return None\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # ------------------------------------------------------------------\n  # Case A: stick is a primitive placed directly in the world.\n  # ------------------------------------------------------------------\n  if not prim_req:\n      stick_cells = np.argwhere(grid[:, :, stick_idx] > 0)\n      if stick_cells.size == 0:\n          return []  # no stick to pick up\n      target = tuple(stick_cells[0])\n      if cur_pos != target:\n          path = bfs_path(cur_pos, target, blocked)\n          if path is None:\n              return []  # unreachable\n          actions.extend(path)\n          cur_pos = target\n      actions.append(USE)\n      return actions\n\n  # ------------------------------------------------------------------\n  # Case B: collect required primitives.\n  # ------------------------------------------------------------------\n  needed = dict(prim_req)  # mutable copy of required counts\n  while any(cnt > 0 for cnt in needed.values()):\n      best_path = None\n      best_target = None\n      best_prim = None\n\n      # Find nearest needed primitive that is reachable.\n      for prim_idx, cnt in needed.items():\n          if cnt <= 0:\n              continue\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          for cell in prim_cells:\n              target = tuple(cell)\n              path = bfs_path(cur_pos, target, blocked)\n              if path is None:\n                  continue\n              if best_path is None or len(path) < len(best_path):\n                  best_path = path\n                  best_target = target\n                  best_prim = prim_idx\n\n      if best_path is None:\n          return []  # cannot reach any remaining required primitive\n\n      # Move to the primitive and pick it up.\n      actions.extend(best_path)\n      actions.append(USE)\n\n      # Update planning state.\n      cur_pos = best_target\n      needed[best_prim] -= 1\n      grid[best_target[0], best_target[1], best_prim] = 0  # remove from copy\n\n  # ------------------------------------------------------------------\n  # Case C: move to required workshop (if recipe specifies one).\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      try:\n          workshop_idx = env.world.cookbook.index[workshop_name]\n      except Exception:\n          workshop_idx = None\n      if workshop_idx is not None:\n          ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n          if ws_cells.size > 0:\n              ws_target = tuple(ws_cells[0])\n              if cur_pos != ws_target:\n                  path = bfs_path(cur_pos, ws_target, blocked)\n                  if path is not None:\n                      actions.extend(path)\n                      cur_pos = ws_target\n\n  # ------------------------------------------------------------------\n  # Final crafting action.\n  # ------------------------------------------------------------------\n  actions.append(USE)\n  return actions", "env_interactions": 3, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:53:36.725122", "function_name": "make_arrow", "function_body": "  # Helper utilities ---------------------------------------------------------\n  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n  stick_idx = cookbook.index['stick']\n\n  # If we already have a stick in inventory, nothing to do.\n  if state.inventory[stick_idx] > 0:\n      return []\n\n  # If a stick is placed somewhere on the grid, go pick it up.\n  stick_cells = np.argwhere(state.grid[:, :, stick_idx] > 0)\n  if stick_cells.size > 0:\n      target = tuple(stick_cells[0])\n      actions = []\n      cur_pos = state.pos\n\n      # move to the cell\n      x, y = cur_pos\n      tx, ty = target\n      while x < tx:\n          actions.append(3)   # RIGHT\n          x += 1\n      while x > tx:\n          actions.append(2)   # LEFT\n          x -= 1\n      while y < ty:\n          actions.append(0)   # DOWN\n          y += 1\n      while y > ty:\n          actions.append(1)   # UP\n          y -= 1\n      actions.append(4)       # USE to pick up\n      return actions\n\n  # -------------------------------------------------------------------------\n  # General planning for crafting a stick (when it is not a primitive)\n  # -------------------------------------------------------------------------\n  def move_to(tx, ty, pos, act_list):\n      \"\"\"Append moves that bring the agent from pos to (tx, ty).\"\"\"\n      x, y = pos\n      while x < tx:\n          act_list.append(3)   # RIGHT\n          x += 1\n      while x > tx:\n          act_list.append(2)   # LEFT\n          x -= 1\n      while y < ty:\n          act_list.append(0)   # DOWN\n          y += 1\n      while y > ty:\n          act_list.append(1)   # UP\n          y -= 1\n      return (x, y)\n\n  def nearest_pos(kind_idx, cur_pos):\n      \"\"\"Return the coordinates of the nearest cell containing kind_idx.\"\"\"\n      positions = np.argwhere(state.grid[:, :, kind_idx] > 0)\n      if positions.size == 0:\n          return None\n      dists = np.abs(positions[:, 0] - cur_pos[0]) + np.abs(positions[:, 1] - cur_pos[1])\n      best = positions[dists.argmin()]\n      return (int(best[0]), int(best[1]))\n\n  def go_and_pick(kind_idx, cur_pos, act_list):\n      \"\"\"Move to a cell with kind_idx and USE it.\"\"\"\n      target = nearest_pos(kind_idx, cur_pos)\n      if target is None:\n          return cur_pos, False\n      cur_pos = move_to(target[0], target[1], cur_pos, act_list)\n      act_list.append(4)               # USE / pick up / craft interaction\n      return cur_pos, True\n\n  actions = []\n  cur_pos = state.pos\n\n  # If stick is a primitive, just collect it.\n  if stick_idx in cookbook.primitives:\n      cur_pos, ok = go_and_pick(stick_idx, cur_pos, actions)\n      return actions if ok else []\n\n  # Otherwise, follow its recipe.\n  recipe = cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get('_at', None)\n\n  # Collect all non\u2011workshop ingredients.\n  for ing_key, cnt in recipe.items():\n      if ing_key == '_at':\n          continue\n      ing_idx = ing_key if isinstance(ing_key, int) else cookbook.index[ing_key]\n      for _ in range(cnt):\n          cur_pos, ok = go_and_pick(ing_idx, cur_pos, actions)\n          if not ok:\n              return []   # cannot satisfy the recipe\n\n  # If a specific workshop is required, go there.\n  if workshop_name is not None:\n      ws_idx = cookbook.index[workshop_name]\n      cur_pos, ok = go_and_pick(ws_idx, cur_pos, actions)\n      if not ok:\n          return []   # workshop not found\n\n  # Finally, craft the stick.\n  actions.append(4)   # USE to craft\n  return actions", "env_interactions": 5, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:53:37.987547", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n  stick_idx = cookbook.index['stick']\n\n  # 1) Already have a stick in inventory.\n  if state.inventory[stick_idx] > 0:\n      return []\n\n  # 2) Stick already placed on the grid \u2013 go pick it up.\n  stick_cells = np.argwhere(state.grid[:, :, stick_idx] > 0)\n  if stick_cells.size > 0:\n      target = tuple(stick_cells[0])\n      actions = []\n      x, y = state.pos\n      tx, ty = target\n      while x < tx:\n          actions.append(3)  # RIGHT\n          x += 1\n      while x > tx:\n          actions.append(2)  # LEFT\n          x -= 1\n      while y < ty:\n          actions.append(0)  # DOWN\n          y += 1\n      while y > ty:\n          actions.append(1)  # UP\n          y -= 1\n      actions.append(4)      # USE to pick up\n      return actions\n\n  # 3) Need to craft a stick.\n  primitive_req = cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n  recipe = cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = cookbook.index[workshop_name] if workshop_name is not None else None\n\n  actions = []\n  cur_pos = state.pos\n  inventory = state.inventory.copy()\n\n  # a) Collect each required primitive from the map.\n  for prim_idx, needed in primitive_req.items():\n      while inventory[prim_idx] < needed:\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # Primitive not available \u2013 abort planning.\n              return actions\n          target = tuple(prim_cells[0])\n          x, y = cur_pos\n          tx, ty = target\n          while x < tx:\n              actions.append(3)  # RIGHT\n              x += 1\n          while x > tx:\n              actions.append(2)  # LEFT\n              x -= 1\n          while y < ty:\n              actions.append(0)  # DOWN\n              y += 1\n          while y > ty:\n              actions.append(1)  # UP\n              y -= 1\n          cur_pos = (x, y)\n          actions.append(4)      # USE to pick up the primitive\n          inventory[prim_idx] += 1\n\n  # b) Go to the appropriate workshop (if any) and craft the stick.\n  if workshop_idx is not None:\n      ws_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if ws_cells.size > 0:\n          target = tuple(ws_cells[0])\n          x, y = cur_pos\n          tx, ty = target\n          while x < tx:\n              actions.append(3)  # RIGHT\n              x += 1\n          while x > tx:\n              actions.append(2)  # LEFT\n              x -= 1\n          while y < ty:\n              actions.append(0)  # DOWN\n              y += 1\n          while y > ty:\n              actions.append(1)  # UP\n              y -= 1\n          cur_pos = (x, y)\n          actions.append(4)      # USE to craft the stick\n      else:\n          # No workshop cell found \u2013 attempt to craft at current location.\n          actions.append(4)\n  else:\n      # No workshop required \u2013 craft at current location.\n      actions.append(4)\n\n  return actions", "env_interactions": 4, "island_id": 8, "scores": {"3": 0.0}}
