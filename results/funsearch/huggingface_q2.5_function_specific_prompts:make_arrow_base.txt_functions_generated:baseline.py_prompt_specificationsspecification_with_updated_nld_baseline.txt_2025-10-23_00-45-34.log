{"timestamp": "2025-10-23T03:56:26.369274", "function_name": "make_arrow", "function_body": "  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act.get(\"DOWN\", 0),\n      act.get(\"UP\", 1),\n      act.get(\"LEFT\", 2),\n      act.get(\"RIGHT\", 3),\n      act.get(\"USE\", 4),\n  )\n\n  # Snapshot of current state (do not modify the environment)\n  state = env._current_state\n  grid = state.grid.copy()                 # (W, H, n_kinds)\n  cur_pos = tuple(state.pos)               # (x, y)\n\n  # Index of the goal item \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n      if stick_idx is None:\n          return []   # stick not defined in the world\n\n  # Determine primitive requirements for a stick\n  recipe = env.world.cookbook.primitives_for(stick_idx)   # dict {kind_idx: count}\n  primitive_needs = {k: v for k, v in recipe.items() if isinstance(k, int)}\n\n  # If the stick itself is a primitive (no recipe), we need to collect one stick\n  if not primitive_needs:\n      primitive_needs = {stick_idx: 1}\n\n  # Detect workshop requirement (non\u2011int key in recipe)\n  workshop_idx = None\n  for k, v in recipe.items():\n      if not isinstance(k, int):\n          workshop_idx = v if isinstance(v, int) else None\n          break\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper: find the closest cell that still has at least one of the given kind\n  # ------------------------------------------------------------------\n  def find_closest(kind_idx, cur):\n      positions = np.argwhere(grid[:, :, kind_idx] > 0)\n      if positions.shape[0] == 0:\n          return None\n      dists = np.sum(np.abs(positions - np.array(cur)), axis=1)\n      nearest = positions[np.argmin(dists)]\n      return tuple(nearest.tolist())\n\n  # ------------------------------------------------------------------\n  # Helper: generate a simple Manhattan path (greedy) from cur to target\n  # ------------------------------------------------------------------\n  def path_to(cur, target):\n      x, y = cur\n      tx, ty = target\n      path = []\n      while (x, y) != (tx, ty):\n          if x < tx:\n              path.append(RIGHT)\n              x += 1\n          elif x > tx:\n              path.append(LEFT)\n              x -= 1\n          elif y < ty:\n              path.append(DOWN)\n              y += 1\n          elif y > ty:\n              path.append(UP)\n              y -= 1\n      return path, (x, y)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the needed number of times\n  # ------------------------------------------------------------------\n  for kind_idx, needed in primitive_needs.items():\n      while needed > 0:\n          target = find_closest(kind_idx, cur_pos)\n          if target is None:\n              # No more of this primitive on the map \u2013 abort planning\n              return actions\n          move_actions, cur_pos = path_to(cur_pos, target)\n          actions.extend(move_actions)\n          actions.append(USE)   # pick up / use the primitive\n\n          # Update local grid copy to reflect the collection\n          grid[target[0], target[1], kind_idx] = max(\n              0, grid[target[0], target[1], kind_idx] - 1\n          )\n          needed -= 1\n\n  # ------------------------------------------------------------------\n  # If a workshop is required, move to it and craft the stick\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_target = find_closest(workshop_idx, cur_pos)\n      if ws_target is not None:\n          move_actions, cur_pos = path_to(cur_pos, ws_target)\n          actions.extend(move_actions)\n          actions.append(USE)   # craft stick at the workshop\n\n  return actions", "env_interactions": 2, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:56:54.859925", "function_name": "make_arrow", "function_body": "  def _bfs_path(start, goal, blocked):\n      act_map = env.action_specs()\n      moves = [\n          (1, 0, act_map[\"DOWN\"]),   # row +1\n          (-1, 0, act_map[\"UP\"]),    # row -1\n          (0, -1, act_map[\"LEFT\"]),  # col -1\n          (0, 1, act_map[\"RIGHT\"]),  # col +1\n      ]\n      from collections import deque\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for dx, dy, a in moves:\n              nx, ny = x + dx, y + dy\n              if (\n                  0 <= nx < blocked.shape[0]\n                  and 0 <= ny < blocked.shape[1]\n                  and not blocked[nx, ny]\n                  and (nx, ny) not in visited\n              ):\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [a]))\n      return None\n\n  # ------------------------------------------------------------------\n  # Main planning\n  # ------------------------------------------------------------------\n  try:\n      state = env._current_state\n  except AttributeError:\n      env.reset()\n      state = env._current_state\n\n  world = env.world\n  grid = state.grid.copy()\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # primitives required to craft a stick (empty if stick itself is primitive)\n  needed = dict(world.cookbook.primitives_for(stick_idx))\n\n  # cells that cannot be traversed (non\u2011grabbable entities)\n  blocked = np.zeros(grid.shape[:2], dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # ------------------------------------------------------------------\n  # Case 1: stick is a primitive already placed in the world\n  # ------------------------------------------------------------------\n  if not needed:\n      stick_cells = np.argwhere(grid[:, :, stick_idx] > 0)\n      if stick_cells.size == 0:\n          return []  # no stick present\n      target = tuple(stick_cells[0])\n      if cur_pos != target:\n          path = _bfs_path(cur_pos, target, blocked)\n          if path is None:\n              return []  # unreachable\n          actions.extend(path)\n          cur_pos = target\n      actions.append(env.action_specs()[\"USE\"])\n      return actions\n\n  # ------------------------------------------------------------------\n  # Case 2: collect required primitives\n  # ------------------------------------------------------------------\n  while any(cnt > 0 for cnt in needed.values()):\n      best_path = None\n      best_target = None\n      best_prim = None\n\n      for prim_idx, cnt in needed.items():\n          if cnt <= 0:\n              continue\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          for cell in prim_cells:\n              target = tuple(cell)\n              path = _bfs_path(cur_pos, target, blocked)\n              if path is None:\n                  continue\n              if best_path is None or len(path) < len(best_path):\n                  best_path = path\n                  best_target = target\n                  best_prim = prim_idx\n\n      if best_path is None:\n          return actions  # cannot reach any remaining primitive\n\n      actions.extend(best_path)\n      actions.append(env.action_specs()[\"USE\"])\n\n      cur_pos = best_target\n      needed[best_prim] -= 1\n      grid[best_target[0], best_target[1], best_prim] = 0  # remove from copy\n\n  # ------------------------------------------------------------------\n  # Case 3: go to workshop if required\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_cells.size > 0:\n          target = tuple(ws_cells[0])\n          if cur_pos != target:\n              path = _bfs_path(cur_pos, target, blocked)\n              if path is not None:\n                  actions.extend(path)\n                  cur_pos = target\n\n  # ------------------------------------------------------------------\n  # Finally, craft the stick\n  # ------------------------------------------------------------------\n  actions.append(env.action_specs()[\"USE\"])\n  return actions", "env_interactions": 3, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:56:56.173209", "function_name": "make_arrow", "function_body": "  # helper BFS to find shortest path avoiding blocked cells\n  def _bfs_path(start, goal, blocked):\n      act_map = env.action_specs()\n      moves = [\n          (1, 0, act_map[\"DOWN\"]),\n          (-1, 0, act_map[\"UP\"]),\n          (0, -1, act_map[\"LEFT\"]),\n          (0, 1, act_map[\"RIGHT\"]),\n      ]\n      from collections import deque\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for dx, dy, a in moves:\n              nx, ny = x + dx, y + dy\n              if (\n                  0 <= nx < blocked.shape[0]\n                  and 0 <= ny < blocked.shape[1]\n                  and not blocked[nx, ny]\n                  and (nx, ny) not in visited\n              ):\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [a]))\n      return None\n\n  # ------------------------------------------------------------------\n  # Main planning\n  # ------------------------------------------------------------------\n  try:\n      state = env._current_state\n  except AttributeError:\n      env.reset()\n      state = env._current_state\n\n  world = env.world\n  grid = state.grid.copy()\n\n  stick_idx = world.cookbook.index[\"stick\"]\n  # primitives required to craft stick (empty if stick is primitive)\n  needed = dict(world.cookbook.primitives_for(stick_idx))\n\n  # cells that block movement (non\u2011grabbable entities)\n  blocked = np.zeros(grid.shape[:2], dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # ------------------------------------------------------------------\n  # Stick is a primitive: just pick it up\n  # ------------------------------------------------------------------\n  if not needed:\n      stick_cells = np.argwhere(grid[:, :, stick_idx] > 0)\n      if stick_cells.size == 0:\n          return []  # no stick present\n      target = tuple(stick_cells[0])\n      if cur_pos != target:\n          path = _bfs_path(cur_pos, target, blocked)\n          if path is None:\n              return []  # unreachable\n          actions.extend(path)\n          cur_pos = target\n      actions.append(env.action_specs()[\"USE\"])\n      return actions\n\n  # ------------------------------------------------------------------\n  # Collect required primitives\n  # ------------------------------------------------------------------\n  while any(cnt > 0 for cnt in needed.values()):\n      best_path = None\n      best_target = None\n      best_prim = None\n\n      for prim_idx, cnt in needed.items():\n          if cnt <= 0:\n              continue\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          for cell in prim_cells:\n              target = tuple(cell)\n              path = _bfs_path(cur_pos, target, blocked)\n              if path is None:\n                  continue\n              if best_path is None or len(path) < len(best_path):\n                  best_path = path\n                  best_target = target\n                  best_prim = prim_idx\n\n      if best_path is None:\n          # cannot reach any remaining needed primitive\n          return actions\n\n      actions.extend(best_path)\n      actions.append(env.action_specs()[\"USE\"])\n      cur_pos = best_target\n      needed[best_prim] -= 1\n      grid[best_target[0], best_target[1], best_prim] = 0  # remove from copy\n\n  # ------------------------------------------------------------------\n  # Go to workshop if recipe specifies one\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_cells.size > 0:\n          target = tuple(ws_cells[0])\n          if cur_pos != target:\n              path = _bfs_path(cur_pos, target, blocked)\n              if path is not None:\n                  actions.extend(path)\n                  cur_pos = target\n\n  # ------------------------------------------------------------------\n  # Craft the stick\n  # ------------------------------------------------------------------\n  actions.append(env.action_specs()[\"USE\"])\n  return actions", "env_interactions": 3, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:57:23.043821", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  def manhattan_path(start, goal):\n      x, y = start\n      gx, gy = goal\n      actions = []\n      while x < gx:\n          actions.append(ACTION_RIGHT)\n          x += 1\n      while x > gx:\n          actions.append(ACTION_LEFT)\n          x -= 1\n      while y < gy:\n          actions.append(ACTION_DOWN)\n          y += 1\n      while y > gy:\n          actions.append(ACTION_UP)\n          y -= 1\n      return actions\n\n  def nearest_position(positions, reference):\n      if len(positions) == 0:\n          return None\n      ref = np.array(reference)\n      dists = np.sum(np.abs(positions - ref), axis=1)\n      return tuple(positions[np.argmin(dists)])\n\n  state = env._current_state\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n\n  try:\n      goal_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      return []\n\n  if inventory[goal_idx] > 0:\n      return []\n\n  plan_actions = []\n\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)\n  for prim_idx, needed_cnt in primitives_needed.items():\n      while inventory[prim_idx] < needed_cnt:\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              return plan_actions\n          target = nearest_position(prim_cells, pos)\n          plan_actions.extend(manhattan_path(pos, target))\n          pos = target\n          plan_actions.append(ACTION_USE)\n          inventory[prim_idx] += 1\n          grid[target[0], target[1], prim_idx] -= 1\n\n  if goal_idx not in env.world.cookbook.recipes:\n      stick_cells = np.argwhere(grid[:, :, goal_idx] > 0)\n      if stick_cells.size == 0:\n          return plan_actions\n      target = nearest_position(stick_cells, pos)\n      plan_actions.extend(manhattan_path(pos, target))\n      pos = target\n      plan_actions.append(ACTION_USE)\n      return plan_actions\n\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      try:\n          workshop_idx = env.world.cookbook.index[workshop_name]\n      except Exception:\n          return plan_actions\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          return plan_actions\n      wcell = tuple(workshop_cells[0])\n      neighbours = [\n          (wcell[0] + dx, wcell[1] + dy)\n          for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]\n      ]\n      stand_pos = None\n      for nx, ny in neighbours:\n          if (\n              0 <= nx < grid.shape[0]\n              and 0 <= ny < grid.shape[1]\n              and grid[nx, ny, :].sum() == 0\n          ):\n              stand_pos = (nx, ny)\n              break\n      if stand_pos is None:\n          stand_pos = wcell\n      plan_actions.extend(manhattan_path(pos, stand_pos))\n      plan_actions.append(ACTION_USE)\n\n  return plan_actions", "env_interactions": 5, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:57:24.317983", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # Action indices as defined in CraftLab.action_specs\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions from start to goal (horizontal then vertical).\"\"\"\n      x, y = start\n      gx, gy = goal\n      actions = []\n      while x < gx:\n          actions.append(ACTION_RIGHT)\n          x += 1\n      while x > gx:\n          actions.append(ACTION_LEFT)\n          x -= 1\n      while y < gy:\n          actions.append(ACTION_DOWN)\n          y += 1\n      while y > gy:\n          actions.append(ACTION_UP)\n          y -= 1\n      return actions\n\n  def nearest_position(positions, reference):\n      \"\"\"Select the position from *positions* with smallest Manhattan distance to *reference*.\"\"\"\n      if len(positions) == 0:\n          return None\n      ref = np.array(reference)\n      dists = np.sum(np.abs(positions - ref), axis=1)\n      return tuple(positions[np.argmin(dists)])\n\n  # ------------------------------------------------------------------\n  # Gather current state information\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n\n  # ------------------------------------------------------------------\n  # Identify the goal (stick)\n  # ------------------------------------------------------------------\n  try:\n      goal_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      # Stick not defined in this world\n      return []\n\n  # If we already have a stick, nothing to do\n  if inventory[goal_idx] > 0:\n      return []\n\n  plan_actions = []\n\n  # ------------------------------------------------------------------\n  # 1) Collect required primitive resources (if any)\n  # ------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  for prim_idx, needed_cnt in primitives_needed.items():\n      while inventory[prim_idx] < needed_cnt:\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # No more of this primitive on the map \u2013 abort planning\n              return plan_actions\n          target = nearest_position(prim_cells, pos)\n\n          # Move to the primitive\n          plan_actions.extend(manhattan_path(pos, target))\n          pos = target\n\n          # Pick it up\n          plan_actions.append(ACTION_USE)\n\n          # Simulate pickup locally\n          inventory[prim_idx] += 1\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # ------------------------------------------------------------------\n  # 2) If stick is a primitive (no recipe), just pick it up\n  # ------------------------------------------------------------------\n  if goal_idx not in env.world.cookbook.recipes:\n      stick_cells = np.argwhere(grid[:, :, goal_idx] > 0)\n      if stick_cells.size == 0:\n          return plan_actions\n      target = nearest_position(stick_cells, pos)\n      plan_actions.extend(manhattan_path(pos, target))\n      plan_actions.append(ACTION_USE)\n      return plan_actions\n\n  # ------------------------------------------------------------------\n  # 3) Go to the required workshop and craft the stick\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      try:\n          workshop_idx = env.world.cookbook.index[workshop_name]\n      except Exception:\n          return plan_actions\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          return plan_actions\n      wcell = tuple(workshop_cells[0])\n\n      # Find a free adjacent cell to stand on\n      neighbours = [\n          (wcell[0] + dx, wcell[1] + dy)\n          for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]\n      ]\n      stand_pos = None\n      for nx, ny in neighbours:\n          if (\n              0 <= nx < grid.shape[0]\n              and 0 <= ny < grid.shape[1]\n              and grid[nx, ny, :].sum() == 0\n          ):\n              stand_pos = (nx, ny)\n              break\n      if stand_pos is None:\n          stand_pos = wcell  # fallback: stand directly on the workshop\n\n      # Move to the chosen standing position\n      plan_actions.extend(manhattan_path(pos, stand_pos))\n      pos = stand_pos\n\n      # Use the workshop to craft the stick\n      plan_actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # Return the constructed action list\n  # ------------------------------------------------------------------\n  return plan_actions", "env_interactions": 5, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:57:43.761676", "function_name": "make_arrow", "function_body": "  # ----- action mapping -----\n  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act.get(\"DOWN\", 0),\n      act.get(\"UP\", 1),\n      act.get(\"LEFT\", 2),\n      act.get(\"RIGHT\", 3),\n      act.get(\"USE\", 4),\n  )\n\n  # ----- current state snapshot -----\n  state = env._current_state\n  grid = state.grid.copy()               # (W, H, n_kinds)\n  cur_pos = tuple(state.pos)             # (x, y)\n\n  # ----- locate stick index -----\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n      if stick_idx is None:\n          return []   # stick not defined in this world\n\n  # ----- decode recipe for stick (primitive requirements) -----\n  primitive_needs = {\n      k: v for k, v in env.world.cookbook.primitives_for(stick_idx).items()\n      if isinstance(k, int)\n  }\n  # if stick itself is a primitive (no recipe) we just need one stick\n  if not primitive_needs:\n      primitive_needs = {stick_idx: 1}\n\n  # ----- workshop requirement (if any) -----\n  workshop_idx = None\n  full_recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  for key, val in full_recipe.items():\n      if not isinstance(key, int):\n          workshop_idx = val if isinstance(val, int) else None\n          break\n\n  actions = []\n\n  # ----- helper: find closest cell containing a given kind ----------\n  def find_closest(kind_idx, cur):\n      positions = np.argwhere(grid[:, :, kind_idx] > 0)\n      if positions.shape[0] == 0:\n          return None\n      dists = np.sum(np.abs(positions - np.array(cur)), axis=1)\n      nearest = positions[np.argmin(dists)]\n      return tuple(nearest.tolist())\n\n  # ----- helper: simple Manhattan path -------------------------------\n  def path_to(cur, target):\n      x, y = cur\n      tx, ty = target\n      path = []\n      while (x, y) != (tx, ty):\n          if x < tx:\n              path.append(RIGHT)\n              x += 1\n          elif x > tx:\n              path.append(LEFT)\n              x -= 1\n          elif y < ty:\n              path.append(DOWN)\n              y += 1\n          elif y > ty:\n              path.append(UP)\n              y -= 1\n      return path, (x, y)\n\n  # ----- collect required primitives ---------------------------------\n  for kind_idx, needed in primitive_needs.items():\n      while needed > 0:\n          target = find_closest(kind_idx, cur_pos)\n          if target is None:\n              # required primitive not present \u2013 abort planning\n              return actions\n          move_actions, cur_pos = path_to(cur_pos, target)\n          actions.extend(move_actions)\n          actions.append(USE)   # pick up the primitive\n\n          # update local grid copy to reflect the collection\n          grid[target[0], target[1], kind_idx] = max(\n              0, grid[target[0], target[1], kind_idx] - 1\n          )\n          needed -= 1\n\n  # ----- craft at workshop if needed ---------------------------------\n  if workshop_idx is not None:\n      ws_target = find_closest(workshop_idx, cur_pos)\n      if ws_target is not None:\n          move_actions, cur_pos = path_to(cur_pos, ws_target)\n          actions.extend(move_actions)\n          actions.append(USE)   # craft the stick at the workshop\n\n  return actions", "env_interactions": 2, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:57:45.075747", "function_name": "make_arrow", "function_body": "  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act.get(\"DOWN\", 0),\n      act.get(\"UP\", 1),\n      act.get(\"LEFT\", 2),\n      act.get(\"RIGHT\", 3),\n      act.get(\"USE\", 4),\n  )\n\n  # current state snapshot\n  state = env._current_state\n  grid = state.grid.copy()               # (W, H, n_kinds)\n  cur_pos = tuple(state.pos)             # (x, y)\n\n  # index of the target item (\"stick\")\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n      if stick_idx is None:\n          return []   # stick not defined in this world\n\n  # primitives required to craft a stick\n  primitive_needs = {\n      k: v for k, v in env.world.cookbook.primitives_for(stick_idx).items()\n      if isinstance(k, int)\n  }\n  # if the stick itself is a primitive (no recipe) we just need one of it\n  if not primitive_needs:\n      primitive_needs = {stick_idx: 1}\n\n  # workshop requirement (if any) \u2013 non\u2011int key in the recipe dict holds it\n  workshop_idx = None\n  full_recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  for key, val in full_recipe.items():\n      if not isinstance(key, int):\n          workshop_idx = val if isinstance(val, int) else None\n          break\n\n  actions = []\n\n  # helper: locate nearest cell containing a given kind\n  def find_closest(kind_idx, cur):\n      positions = np.argwhere(grid[:, :, kind_idx] > 0)\n      if positions.shape[0] == 0:\n          return None\n      dists = np.sum(np.abs(positions - np.array(cur)), axis=1)\n      nearest = positions[np.argmin(dists)]\n      return tuple(nearest.tolist())\n\n  # helper: greedy Manhattan path\n  def path_to(cur, target):\n      x, y = cur\n      tx, ty = target\n      path = []\n      while (x, y) != (tx, ty):\n          if x < tx:\n              path.append(RIGHT)\n              x += 1\n          elif x > tx:\n              path.append(LEFT)\n              x -= 1\n          elif y < ty:\n              path.append(DOWN)\n              y += 1\n          elif y > ty:\n              path.append(UP)\n              y -= 1\n      return path, (x, y)\n\n  # collect required primitives\n  for kind_idx, needed in primitive_needs.items():\n      while needed > 0:\n          target = find_closest(kind_idx, cur_pos)\n          if target is None:\n              # required primitive not present \u2013 abort planning\n              return actions\n          move_actions, cur_pos = path_to(cur_pos, target)\n          actions.extend(move_actions)\n          actions.append(USE)   # pick up the primitive\n\n          # update local grid copy to reflect the collection\n          grid[target[0], target[1], kind_idx] = max(\n              0, grid[target[0], target[1], kind_idx] - 1\n          )\n          needed -= 1\n\n  # craft at workshop if needed\n  if workshop_idx is not None:\n      ws_target = find_closest(workshop_idx, cur_pos)\n      if ws_target is not None:\n          move_actions, cur_pos = path_to(cur_pos, ws_target)\n          actions.extend(move_actions)\n          actions.append(USE)   # craft the stick at the workshop\n\n  return actions", "env_interactions": 2, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:58:01.611052", "function_name": "make_arrow", "function_body": "  actions = []\n  state = env._current_state\n  grid = state.grid\n  world = env.world\n  cb = world.cookbook\n\n  # Index of the target item \"stick\"\n  try:\n      goal_idx = cb.index[\"stick\"]\n  except Exception:\n      return actions\n\n  # Primitive requirements for a stick (empty dict if stick is primitive)\n  needed_prims = cb.primitives_for(goal_idx)\n\n  # Current agent position (x, y)\n  pos = list(state.pos)\n\n  # Helper to move using Manhattan steps\n  def _move_to(target):\n      nonlocal pos, actions\n      tx, ty = target\n      while pos[0] < tx:\n          actions.append(3)   # RIGHT\n          pos[0] += 1\n      while pos[0] > tx:\n          actions.append(2)   # LEFT\n          pos[0] -= 1\n      while pos[1] < ty:\n          actions.append(0)   # DOWN\n          pos[1] += 1\n      while pos[1] > ty:\n          actions.append(1)   # UP\n          pos[1] -= 1\n\n  # If stick itself is a primitive, just pick it up.\n  if not needed_prims:\n      locs = np.argwhere(grid[:, :, goal_idx] > 0)\n      if locs.size:\n          _move_to(locs[0].tolist())\n          actions.append(4)   # USE to pick up\n      return actions\n\n  # Collect each required primitive.\n  for prim_idx, count in needed_prims.items():\n      locs = np.argwhere(grid[:, :, prim_idx] > 0)\n      if not locs.size:\n          continue  # primitive not present; should not happen in valid scenarios\n      _move_to(locs[0].tolist())\n      for _ in range(count):\n          actions.append(4)   # USE to pick up one unit\n\n  # Move to workshop (if recipe specifies one) and craft the stick.\n  recipe = cb.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = cb.index[workshop_name]\n      w_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if w_locs.size:\n          _move_to(w_locs[0].tolist())\n          actions.append(4)   # USE to craft at the workshop\n\n  return actions", "env_interactions": 4, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:58:02.911623", "function_name": "make_arrow", "function_body": "  actions = []\n  state = env._current_state\n  grid = state.grid\n  world = env.world\n  cb = world.cookbook\n\n  # index of the target item \"stick\"\n  try:\n      goal_idx = cb.index[\"stick\"]\n  except Exception:\n      return actions\n\n  # primitive requirements for a stick (empty dict if stick is primitive)\n  needed_prims = cb.primitives_for(goal_idx)\n\n  # current agent position (x, y)\n  pos = list(state.pos)\n\n  # helper to move using Manhattan steps\n  def _move_to(target):\n      nonlocal pos, actions\n      tx, ty = target\n      while pos[0] < tx:\n          actions.append(3)   # RIGHT\n          pos[0] += 1\n      while pos[0] > tx:\n          actions.append(2)   # LEFT\n          pos[0] -= 1\n      while pos[1] < ty:\n          actions.append(0)   # DOWN\n          pos[1] += 1\n      while pos[1] > ty:\n          actions.append(1)   # UP\n          pos[1] -= 1\n\n  # If stick itself is a primitive, just pick it up.\n  if not needed_prims:\n      locs = np.argwhere(grid[:, :, goal_idx] > 0)\n      if locs.size:\n          _move_to(locs[0].tolist())\n          actions.append(4)   # USE to pick up\n      return actions\n\n  # Collect each required primitive.\n  for prim_idx, count in needed_prims.items():\n      locs = np.argwhere(grid[:, :, prim_idx] > 0)\n      if not locs.size:\n          continue  # primitive not present; should not happen in valid scenarios\n      _move_to(locs[0].tolist())\n      for _ in range(count):\n          actions.append(4)   # USE to pick up one unit\n\n  # Move to workshop (if recipe specifies one) and craft the stick.\n  recipe = cb.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = cb.index[workshop_name]\n      w_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if w_locs.size:\n          _move_to(w_locs[0].tolist())\n          actions.append(4)   # USE to craft at the workshop\n\n  return actions", "env_interactions": 4, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:58:34.933949", "function_name": "make_arrow", "function_body": "  _ACTION_DELTAS = {\n      0: (1, 0),   # DOWN\n      1: (-1, 0),  # UP\n      2: (0, -1),  # LEFT\n      3: (0, 1),   # RIGHT\n  }\n\n  def _move_actions(start, goal):\n      \"\"\"Return a list of actions to move from start to goal using Manhattan moves.\"\"\"\n      y, x = start\n      gy, gx = goal\n      acts = []\n      while y < gy:\n          acts.append(0)   # DOWN\n          y += 1\n      while y > gy:\n          acts.append(1)   # UP\n          y -= 1\n      while x < gx:\n          acts.append(3)   # RIGHT\n          x += 1\n      while x > gx:\n          acts.append(2)   # LEFT\n          x -= 1\n      return acts\n\n  # ----------------------------------------------------------------------\n  # locate the CraftWorld instance inside the supplied env\n  # ----------------------------------------------------------------------\n  if hasattr(env, \"world\"):\n      world = env.world\n  elif hasattr(env, \"scenario\"):\n      world = env.scenario.world\n  else:\n      raise AttributeError(\"Cannot locate CraftWorld instance in the supplied env.\")\n\n  # ----------------------------------------------------------------------\n  # identify the goal (stick) and its recipe\n  # ----------------------------------------------------------------------\n  goal_name = \"stick\"\n  goal_idx = world.cookbook.index[goal_name]\n\n  # primitives required to craft a stick (may be empty if stick is primitive)\n  needed = world.cookbook.primitives_for(goal_idx)   # dict {prim_idx: count}\n\n  # ----------------------------------------------------------------------\n  # obtain current state (position and grid) for planning\n  # ----------------------------------------------------------------------\n  if hasattr(env, \"_current_state\"):\n      state = env._current_state\n  else:\n      state = env.scenario.init()\n\n  cur_pos = tuple(state.pos)          # (row, col)\n  grid = state.grid.copy()            # (H, W, n_kinds)\n\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # helper to move to a primitive cell and pick it up\n  # ----------------------------------------------------------------------\n  def _collect_primitive(p_idx):\n      nonlocal cur_pos, actions, grid\n      cells = np.argwhere(grid[:, :, p_idx] > 0)\n      if cells.size == 0:\n          raise RuntimeError(\n              f\"Primitive '{world.cookbook.index.get(p_idx)}' not found on the grid.\"\n          )\n      py, px = cells[0]\n\n      # find an adjacent empty cell to stand on and face the primitive\n      target = None\n      for d, (dy, dx) in _ACTION_DELTAS.items():\n          ny, nx = py - dy, px - dx\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not grid[ny, nx, :].any():          # empty neighbour\n                  target = (ny, nx)\n                  break\n      if target is None:\n          raise RuntimeError(\"No reachable empty neighbour around required primitive.\")\n\n      # move to that neighbour\n      actions.extend(_move_actions(cur_pos, target))\n      cur_pos = target\n\n      # USE to pick up the primitive (agent is already facing it)\n      actions.append(4)   # USE\n\n      # update planning grid: primitive consumed\n      grid[py, px, p_idx] = 0\n\n  # ----------------------------------------------------------------------\n  # 1. Collect required primitives (if any)\n  # ----------------------------------------------------------------------\n  if needed:\n      for prim_idx, cnt in needed.items():\n          for _ in range(cnt):\n              _collect_primitive(prim_idx)\n\n  # ----------------------------------------------------------------------\n  # 2. Determine whether stick itself is a primitive or must be crafted\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n\n  if not recipe:\n      # Stick is a primitive item on the map; just collect it\n      _collect_primitive(goal_idx)\n      return actions\n\n  # ----------------------------------------------------------------------\n  # 3. Craft the stick at its workshop (if a workshop is specified)\n  # ----------------------------------------------------------------------\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = world.cookbook.index[workshop_name]\n      ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_cells.size == 0:\n          raise RuntimeError(f\"Workshop '{workshop_name}' not found on the grid.\")\n      wy, wx = ws_cells[0]\n\n      # find empty neighbour to stand on and face the workshop\n      target = None\n      for d, (dy, dx) in _ACTION_DELTAS.items():\n          ny, nx = wy - dy, wx - dx\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not grid[ny, nx, :].any():\n                  target = (ny, nx)\n                  break\n      if target is None:\n          raise RuntimeError(\"No reachable empty neighbour around workshop.\")\n\n      actions.extend(_move_actions(cur_pos, target))\n      cur_pos = target\n      actions.append(4)   # USE to craft the stick\n  else:\n      raise RuntimeError(\"No workshop specified for crafting stick.\")\n\n  # ----------------------------------------------------------------------\n  # return the full action list\n  # ----------------------------------------------------------------------\n  return actions", "env_interactions": 5, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:58:36.200556", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # action \u2192 (dy, dx) for movement; USE is action 4\n  _ACTION_DELTAS = {\n      0: (1, 0),   # DOWN\n      1: (-1, 0),  # UP\n      2: (0, -1),  # LEFT\n      3: (0, 1),   # RIGHT\n  }\n\n  def _move_actions(start, goal):\n      \"\"\"Manhattan path from start (row,col) to goal (row,col).\"\"\"\n      y, x = start\n      gy, gx = goal\n      acts = []\n      while y < gy:\n          acts.append(0)   # DOWN\n          y += 1\n      while y > gy:\n          acts.append(1)   # UP\n          y -= 1\n      while x < gx:\n          acts.append(3)   # RIGHT\n          x += 1\n      while x > gx:\n          acts.append(2)   # LEFT\n          x -= 1\n      return acts\n\n  # ----------------------------------------------------------------------\n  # locate CraftWorld instance inside the supplied env\n  # ----------------------------------------------------------------------\n  if hasattr(env, \"world\"):\n      world = env.world\n  elif hasattr(env, \"scenario\"):\n      world = env.scenario.world\n  else:\n      raise AttributeError(\"Cannot locate CraftWorld instance in the given env.\")\n\n  # ----------------------------------------------------------------------\n  # identify the goal (stick) and its recipe\n  # ----------------------------------------------------------------------\n  goal_name = \"stick\"\n  goal_idx = world.cookbook.index[goal_name]\n\n  # primitives needed to craft the stick (empty if stick itself is primitive)\n  needed = world.cookbook.primitives_for(goal_idx)\n\n  # ----------------------------------------------------------------------\n  # obtain current state (position + grid) for planning\n  # ----------------------------------------------------------------------\n  if hasattr(env, \"_current_state\"):\n      state = env._current_state\n  else:\n      state = env.scenario.init()\n\n  cur_pos = tuple(state.pos)          # (row, col)\n  grid = state.grid.copy()            # (H, W, n_kinds)\n\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # helper: move to a primitive and pick it up\n  # ----------------------------------------------------------------------\n  def _collect_primitive(p_idx):\n      nonlocal cur_pos, actions, grid\n      cells = np.argwhere(grid[:, :, p_idx] > 0)\n      if cells.size == 0:\n          raise RuntimeError(\n              f\"Required primitive '{world.cookbook.index.get(p_idx)}' not found on the grid.\"\n          )\n      py, px = cells[0]\n\n      # find an empty neighbour to stand on and face the primitive\n      target = None\n      for d, (dy, dx) in _ACTION_DELTAS.items():\n          ny, nx = py - dy, px - dx\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not grid[ny, nx, :].any():\n                  target = (ny, nx)\n                  break\n      if target is None:\n          raise RuntimeError(\"No reachable empty neighbour around required primitive.\")\n\n      # move there and use\n      actions.extend(_move_actions(cur_pos, target))\n      cur_pos = target\n      actions.append(4)   # USE\n      grid[py, px, p_idx] = 0   # consume the primitive\n\n  # ----------------------------------------------------------------------\n  # 1. Collect required primitives (if any)\n  # ----------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          _collect_primitive(prim_idx)\n\n  # ----------------------------------------------------------------------\n  # 2. If stick is a primitive (no recipe), just pick it up\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  if not recipe:   # stick is primitive\n      _collect_primitive(goal_idx)\n      return actions\n\n  # ----------------------------------------------------------------------\n  # 3. Craft stick at its workshop (specified via \"_at\")\n  # ----------------------------------------------------------------------\n  workshop_name = recipe.get(\"_at\")\n  if not workshop_name:\n      raise RuntimeError(\"Stick recipe exists but no workshop ('_at') specified.\")\n\n  workshop_idx = world.cookbook.index[workshop_name]\n  ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if ws_cells.size == 0:\n      raise RuntimeError(f\"Workshop '{workshop_name}' not found on the grid.\")\n  wy, wx = ws_cells[0]\n\n  # find empty neighbour to stand on and face the workshop\n  target = None\n  for d, (dy, dx) in _ACTION_DELTAS.items():\n      ny, nx = wy - dy, wx - dx\n      if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n          if not grid[ny, nx, :].any():\n              target = (ny, nx)\n              break\n  if target is None:\n      raise RuntimeError(\"No reachable empty neighbour around the workshop.\")\n\n  actions.extend(_move_actions(cur_pos, target))\n  cur_pos = target\n  actions.append(4)   # USE to craft the stick\n\n  return actions", "env_interactions": 5, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:58:54.029878", "function_name": "make_arrow", "function_body": "  # Access current state and cookbook.\n  state = env._current_state\n  cookbook = env.world.cookbook\n  stick_idx = cookbook.index['stick']\n\n  # Helper to generate move actions from one position to another.\n  def _move_actions(cur_pos, target):\n      actions = []\n      x, y = cur_pos\n      tx, ty = target\n      while x < tx:\n          actions.append(3)  # RIGHT\n          x += 1\n      while x > tx:\n          actions.append(2)  # LEFT\n          x -= 1\n      while y < ty:\n          actions.append(0)  # DOWN\n          y += 1\n      while y > ty:\n          actions.append(1)  # UP\n          y -= 1\n      return actions, (x, y)\n\n  # 1) Already have a stick in inventory.\n  if state.inventory[stick_idx] > 0:\n      return []\n\n  # 2) Stick already placed on the grid \u2013 go pick it up.\n  stick_cells = np.argwhere(state.grid[:, :, stick_idx] > 0)\n  if stick_cells.size:\n      target = tuple(stick_cells[0])\n      moves, _ = _move_actions(state.pos, target)\n      moves.append(4)                     # USE to pick it up\n      return moves\n\n  # 3) Need to craft a stick.\n  primitive_req = cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n  recipe = cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = cookbook.index[workshop_name] if workshop_name is not None else None\n\n  actions = []\n  cur_pos = state.pos\n  inventory = state.inventory.copy()\n\n  # 3a) Collect each required primitive from the map.\n  for prim_idx, needed in primitive_req.items():\n      while inventory[prim_idx] < needed:\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # Primitive not available \u2013 abort planning.\n              return actions\n          target = tuple(prim_cells[0])\n          moves, cur_pos = _move_actions(cur_pos, target)\n          actions.extend(moves)\n          actions.append(4)                # USE to pick up the primitive\n          inventory[prim_idx] += 1\n\n  # 3b) Go to the appropriate workshop (if any) and craft the stick.\n  if workshop_idx is not None:\n      ws_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if ws_cells.size:\n          target = tuple(ws_cells[0])\n          moves, cur_pos = _move_actions(cur_pos, target)\n          actions.extend(moves)\n  # Craft the stick (USE at current location or workshop).\n  actions.append(4)                        # USE to craft\n  return actions", "env_interactions": 4, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:58:55.290472", "function_name": "make_arrow", "function_body": "  # Helper: generate actions to move from cur_pos to target (grid coordinates)\n  def _move_actions(cur_pos, target):\n      actions = []\n      x, y = cur_pos\n      tx, ty = target\n      while x < tx:\n          actions.append(3)  # RIGHT\n          x += 1\n      while x > tx:\n          actions.append(2)  # LEFT\n          x -= 1\n      while y < ty:\n          actions.append(0)  # DOWN\n          y += 1\n      while y > ty:\n          actions.append(1)  # UP\n          y -= 1\n      return actions, (x, y)\n\n  # Access current state and cookbook.\n  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n  stick_idx = cookbook.index['stick']\n\n  # 1) Already have a stick in inventory.\n  if state.inventory[stick_idx] > 0:\n      return []\n\n  # 2) Stick already placed on the grid \u2013 go pick it up.\n  stick_cells = np.argwhere(state.grid[:, :, stick_idx] > 0)\n  if stick_cells.size > 0:\n      target = tuple(stick_cells[0])\n      moves, _ = _move_actions(state.pos, target)\n      moves.append(4)                     # USE to pick it up\n      return moves\n\n  # 3) Need to craft a stick.\n  # Primitive requirements for one stick.\n  primitive_req = cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n  recipe = cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = cookbook.index[workshop_name] if workshop_name is not None else None\n\n  actions = []\n  cur_pos = state.pos\n  inventory = state.inventory.copy()\n\n  # 3b) Collect each required primitive from the map.\n  for prim_idx, needed in primitive_req.items():\n      while inventory[prim_idx] < needed:\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # Primitive not available \u2013 abort planning.\n              return actions\n          target = tuple(prim_cells[0])\n          moves, cur_pos = _move_actions(cur_pos, target)\n          actions.extend(moves)\n          actions.append(4)                # USE to pick up the primitive\n          inventory[prim_idx] += 1\n\n  # 3c) Go to the appropriate workshop (if any) and craft the stick.\n  if workshop_idx is not None:\n      ws_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if ws_cells.size > 0:\n          target = tuple(ws_cells[0])\n          moves, cur_pos = _move_actions(cur_pos, target)\n          actions.extend(moves)\n          actions.append(4)                # USE to craft the stick\n      else:\n          # No workshop cell found \u2013 attempt to craft at current location.\n          actions.append(4)\n  else:\n      # No workshop required \u2013 craft at current location.\n      actions.append(4)\n\n  return actions", "env_interactions": 4, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:59:16.732732", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n\n  # action identifiers\n  act = env.action_specs()\n  DOWN = act[\"DOWN\"]\n  UP = act[\"UP\"]\n  LEFT = act[\"LEFT\"]\n  RIGHT = act[\"RIGHT\"]\n  USE = act[\"USE\"]\n\n  # index of the primitive \"stick\"\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # locate all cells that contain a stick\n  stick_cells = np.argwhere(state.grid[:, :, stick_idx] > 0)\n  if stick_cells.size == 0:\n      # no stick present in the world\n      return []\n\n  # grid dimensions\n  W, H, _ = state.grid.shape\n\n  # cells that are blocked (any entity present)\n  blocked = np.any(state.grid > 0, axis=2)\n\n  start = tuple(state.pos)\n\n  from collections import deque\n\n  def bfs(target):\n      \"\"\"Return a list of actions to reach `target` cell, or None if unreachable.\"\"\"\n      q = deque([start])\n      visited = np.full((W, H), False, dtype=bool)\n      visited[start[0], start[1]] = True\n      # store predecessor cell for path reconstruction\n      prev = np.empty((W, H, 2), dtype=int)\n\n      while q:\n          x, y = q.popleft()\n          if (x, y) == tuple(target):\n              # reconstruct path\n              actions = []\n              cx, cy = x, y\n              while (cx, cy) != start:\n                  px, py = prev[cx, cy]\n                  dx, dy = cx - px, cy - py\n                  if dx == 1:\n                      actions.append(DOWN)\n                  elif dx == -1:\n                      actions.append(UP)\n                  elif dy == 1:\n                      actions.append(RIGHT)\n                  elif dy == -1:\n                      actions.append(LEFT)\n                  cx, cy = px, py\n              actions.reverse()\n              return actions\n\n          # explore neighbours\n          for nx, ny, a in [(x + 1, y, DOWN), (x - 1, y, UP),\n                            (x, y + 1, RIGHT), (x, y - 1, LEFT)]:\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  # allow stepping onto the target even if it is blocked (contains the stick)\n                  if (nx, ny) == tuple(target) or not blocked[nx, ny]:\n                      visited[nx, ny] = True\n                      prev[nx, ny] = (x, y)\n                      q.append((nx, ny))\n      return None\n\n  # find the closest reachable stick\n  best_path = None\n  for cell in stick_cells:\n      path = bfs(cell)\n      if path is not None and (best_path is None or len(path) < len(best_path)):\n          best_path = path\n\n  if best_path is None:\n      # no reachable stick found\n      return []\n\n  # pick up the stick\n  best_path.append(USE)\n  return best_path", "env_interactions": 0, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:59:18.091756", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n  act = env.action_specs()\n  DOWN = act[\"DOWN\"]\n  UP = act[\"UP\"]\n  LEFT = act[\"LEFT\"]\n  RIGHT = act[\"RIGHT\"]\n  USE = act[\"USE\"]\n  stick_idx = world.cookbook.index[\"stick\"]\n  stick_cells = np.argwhere(state.grid[:, :, stick_idx] > 0)\n  if stick_cells.size == 0:\n      return []\n  W, H, _ = state.grid.shape\n  blocked = np.any(state.grid > 0, axis=2)\n  start = tuple(state.pos)\n  from collections import deque\n  def bfs(target):\n      q = deque([start])\n      visited = np.full((W, H), False, dtype=bool)\n      visited[start[0], start[1]] = True\n      prev = np.empty((W, H, 2), dtype=int)\n      while q:\n          x, y = q.popleft()\n          if (x, y) == tuple(target):\n              actions = []\n              cx, cy = x, y\n              while (cx, cy) != start:\n                  px, py = prev[cx, cy]\n                  dx, dy = cx - px, cy - py\n                  if dx == 1:\n                      actions.append(DOWN)\n                  elif dx == -1:\n                      actions.append(UP)\n                  elif dy == 1:\n                      actions.append(RIGHT)\n                  elif dy == -1:\n                      actions.append(LEFT)\n                  cx, cy = px, py\n              actions.reverse()\n              return actions\n          for nx, ny, a in [(x + 1, y, DOWN), (x - 1, y, UP),\n                            (x, y + 1, RIGHT), (x, y - 1, LEFT)]:\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if (nx, ny) == tuple(target) or not blocked[nx, ny]:\n                      visited[nx, ny] = True\n                      prev[nx, ny] = (x, y)\n                      q.append((nx, ny))\n      return None\n  best_path = None\n  for cell in stick_cells:\n      path = bfs(cell)\n      if path is not None and (best_path is None or len(path) < len(best_path)):\n          best_path = path\n  if best_path is None:\n      return []\n  best_path.append(USE)\n  return best_path", "env_interactions": 0, "island_id": 5, "scores": {"3": 0.0}}
