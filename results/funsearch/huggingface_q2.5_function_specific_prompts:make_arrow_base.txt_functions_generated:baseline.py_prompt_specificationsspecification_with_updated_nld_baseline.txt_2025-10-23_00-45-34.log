{"timestamp": "2025-10-23T04:18:30.863582", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  goal_idx = env.task.goal\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # -----------------------------------------------------------------\n  # Helper utilities\n  # -----------------------------------------------------------------\n  def find_positions(kind):\n      \"\"\"Return list of (x, y) cells containing the given kind.\"\"\"\n      locs = np.argwhere(state.grid[:, :, kind] > 0)\n      return [tuple(p) for p in locs]\n\n  def nearest(pos, kind):\n      \"\"\"Manhattan\u2011closest cell of the requested kind.\"\"\"\n      positions = find_positions(kind)\n      if not positions:\n          return None\n      return min(positions, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n\n  def moves_to(src, dst):\n      \"\"\"Sequence of movement actions (DOWN=0, UP=1, LEFT=2, RIGHT=3)\n      that walks from src to dst using a simple Manhattan path.\"\"\"\n      sx, sy = src\n      dx, dy = dst\n      seq = []\n      while sx < dx:\n          seq.append(0)   # DOWN\n          sx += 1\n      while sx > dx:\n          seq.append(1)   # UP\n          sx -= 1\n      while sy < dy:\n          seq.append(3)   # RIGHT\n          sy += 1\n      while sy > dy:\n          seq.append(2)   # LEFT\n          sy -= 1\n      return seq\n\n  # -----------------------------------------------------------------\n  # 1) If the stick itself is a primitive \u2013 just go collect it.\n  # -----------------------------------------------------------------\n  if not env.world.cookbook.primitives_for(goal_idx):\n      target = nearest(cur_pos, goal_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)   # USE to pick up the primitive\n      return actions\n\n  # -----------------------------------------------------------------\n  # 2) Gather all required primitive ingredients for the stick.\n  # -----------------------------------------------------------------\n  needed_prims = env.world.cookbook.primitives_for(goal_idx)\n  for prim_idx, count in needed_prims.items():\n      for _ in range(count):\n          target = nearest(cur_pos, prim_idx)\n          if target is None:\n              continue  # primitive not present; skip\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n          actions.append(4)   # USE to pick it up\n\n  # -----------------------------------------------------------------\n  # 3) Move to the appropriate workshop (if any) and craft the stick.\n  # -----------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n\n  if isinstance(recipe, dict):\n      workshop_idx = recipe.get('_at')\n      if workshop_idx is None:\n          for k, v in recipe.items():\n              if isinstance(k, str) and k != '_at':\n                  workshop_idx = v\n                  break\n\n  if workshop_idx is not None:\n      target = nearest(cur_pos, workshop_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)   # USE at workshop to craft the stick\n  else:\n      # No specific workshop \u2013 attempt to craft at current location.\n      actions.append(4)\n\n  return actions", "env_interactions": 1, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:18:32.184130", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  goal_idx = env.task.goal\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # Helper utilities\n  def find_positions(kind):\n      \"\"\"Return list of (x, y) positions where `kind` is present.\"\"\"\n      locs = np.argwhere(state.grid[:, :, kind] > 0)\n      return [tuple(p) for p in locs]\n\n  def nearest(pos, kind):\n      \"\"\"Manhattan\u2011closest cell containing `kind`.\"\"\"\n      positions = find_positions(kind)\n      if not positions:\n          return None\n      return min(positions, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n\n  def moves_to(src, dst):\n      \"\"\"Generate a Manhattan path from src to dst as action indices.\n      Action mapping: DOWN=0, UP=1, LEFT=2, RIGHT=3.\n      \"\"\"\n      sx, sy = src\n      dx, dy = dst\n      seq = []\n      while sx < dx:\n          seq.append(0)   # DOWN\n          sx += 1\n      while sx > dx:\n          seq.append(1)   # UP\n          sx -= 1\n      while sy < dy:\n          seq.append(3)   # RIGHT\n          sy += 1\n      while sy > dy:\n          seq.append(2)   # LEFT\n          sy -= 1\n      return seq\n\n  # -----------------------------------------------------------------\n  # 1) If the goal is a primitive (no recipe), just go pick it up.\n  # -----------------------------------------------------------------\n  if not env.world.cookbook.primitives_for(goal_idx):\n      target = nearest(cur_pos, goal_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)   # USE to pick up\n      return actions\n\n  # -----------------------------------------------------------------\n  # 2) Collect required primitive ingredients.\n  # -----------------------------------------------------------------\n  needed_prims = env.world.cookbook.primitives_for(goal_idx)\n  for prim_idx, count in needed_prims.items():\n      for _ in range(count):\n          target = nearest(cur_pos, prim_idx)\n          if target is None:\n              continue  # primitive not found; skip\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n          actions.append(4)   # USE to pick up primitive\n\n  # -----------------------------------------------------------------\n  # 3) Move to workshop (if any) and craft the stick.\n  # -----------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  if isinstance(recipe, dict):\n      # Preferred explicit key.\n      workshop_idx = recipe.get('_at')\n      # Fallback: any string key other than '_at' is assumed to be the workshop.\n      if workshop_idx is None:\n          for k, v in recipe.items():\n              if isinstance(k, str) and k != '_at':\n                  workshop_idx = v\n                  break\n\n  if workshop_idx is not None:\n      target = nearest(cur_pos, workshop_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)   # USE to craft at the workshop\n  else:\n      # No designated workshop \u2013 try crafting at current location.\n      actions.append(4)\n\n  return actions", "env_interactions": 1, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:19:02.987294", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n\n  # action indices\n  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act[\"DOWN\"], act[\"UP\"], act[\"LEFT\"], act[\"RIGHT\"], act[\"USE\"]\n  )\n\n  # stick index and its recipe\n  stick_idx = world.cookbook.index[\"stick\"]\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  workshop_idx = world.cookbook.index[workshop_name] if workshop_name else None\n\n  # primitive requirements for a stick (empty dict if stick is primitive)\n  prim_req = world.cookbook.primitives_for(stick_idx)\n\n  # grid dimensions\n  W, H, _ = state.grid.shape\n\n  def bfs(src, tgt):\n      \"\"\"Return a list of actions to move from src to tgt (including stepping onto tgt).\"\"\"\n      src = tuple(src)\n      tgt = tuple(tgt)\n      blocked = np.any(state.grid > 0, axis=2)\n\n      q = collections.deque([src])\n      visited = np.full((W, H), False, dtype=bool)\n      visited[src[0], src[1]] = True\n      prev = np.empty((W, H, 2), dtype=int)\n\n      while q:\n          x, y = q.popleft()\n          if (x, y) == tgt:\n              # reconstruct path\n              actions = []\n              cx, cy = x, y\n              while (cx, cy) != src:\n                  px, py = prev[cx, cy]\n                  dx, dy = cx - px, cy - py\n                  if dx == 1:\n                      actions.append(DOWN)\n                  elif dx == -1:\n                      actions.append(UP)\n                  elif dy == 1:\n                      actions.append(RIGHT)\n                  elif dy == -1:\n                      actions.append(LEFT)\n                  cx, cy = px, py\n              actions.reverse()\n              return actions\n\n          for nx, ny, a in [(x + 1, y, DOWN), (x - 1, y, UP),\n                            (x, y + 1, RIGHT), (x, y - 1, LEFT)]:\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  # allow stepping onto target even if blocked\n                  if (nx, ny) == tgt or not blocked[nx, ny]:\n                      visited[nx, ny] = True\n                      prev[nx, ny] = (x, y)\n                      q.append((nx, ny))\n      return None  # unreachable\n\n  # ----------------------------------------------------------------------\n  # Case 1: stick is a primitive (no recipe)\n  # ----------------------------------------------------------------------\n  if not prim_req:\n      stick_cells = np.argwhere(state.grid[:, :, stick_idx] > 0)\n      if stick_cells.size == 0:\n          return []  # nothing to pick up\n      best_actions = None\n      for cell in stick_cells:\n          path = bfs(state.pos, cell)\n          if path is not None and (best_actions is None or len(path) < len(best_actions)):\n              best_actions = path\n      if best_actions is None:\n          return []  # unreachable\n      best_actions.append(USE)\n      return best_actions\n\n  # ----------------------------------------------------------------------\n  # Case 2: stick must be crafted \u2013 collect required primitives\n  # ----------------------------------------------------------------------\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  for prim_idx, needed_cnt in prim_req.items():\n      for _ in range(needed_cnt):\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              return actions  # cannot satisfy requirement\n          best_path = None\n          best_cell = None\n          for cell in prim_cells:\n              path = bfs(cur_pos, cell)\n              if path is not None and (best_path is None or len(path) < len(best_path)):\n                  best_path = path\n                  best_cell = tuple(cell)\n          if best_path is None:\n              return actions  # unreachable primitive\n          actions.extend(best_path)\n          actions.append(USE)          # pick up primitive\n          cur_pos = best_cell\n          # simulate removal so we don't reuse the same cell\n          state.grid[best_cell[0], best_cell[1], prim_idx] = 0\n\n  # ----------------------------------------------------------------------\n  # Go to workshop and craft the stick\n  # ----------------------------------------------------------------------\n  if workshop_idx is None:\n      return actions  # no workshop info; cannot craft\n\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      return actions  # workshop not present\n\n  best_path = None\n  best_cell = None\n  for cell in workshop_cells:\n      path = bfs(cur_pos, cell)\n      if path is not None and (best_path is None or len(path) < len(best_path)):\n          best_path = path\n          best_cell = tuple(cell)\n\n  if best_path is None:\n      return actions  # cannot reach workshop\n\n  actions.extend(best_path)\n  actions.append(USE)   # craft stick at workshop\n  return actions", "env_interactions": 4, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:19:04.354853", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n\n  # -------------------------------------------------------------\n  # Action indices\n  # -------------------------------------------------------------\n  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act[\"DOWN\"], act[\"UP\"], act[\"LEFT\"], act[\"RIGHT\"], act[\"USE\"]\n  )\n\n  # -------------------------------------------------------------\n  # Index of stick and its recipe information\n  # -------------------------------------------------------------\n  stick_idx = world.cookbook.index[\"stick\"]\n  primitive_req = world.cookbook.primitives_for(stick_idx)  # dict {prim_idx: count}\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  workshop_idx = None\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n\n  # -------------------------------------------------------------\n  # Helper: BFS returning a list of actions from src to tgt\n  # -------------------------------------------------------------\n  W, H, _ = state.grid.shape\n\n  def bfs(src, tgt):\n      \"\"\"Return actions to move from src to tgt (including stepping onto tgt).\"\"\"\n      src = tuple(src)\n      tgt = tuple(tgt)\n      q = collections.deque([src])\n      visited = np.full((W, H), False, dtype=bool)\n      visited[src[0], src[1]] = True\n      prev = np.empty((W, H, 2), dtype=int)\n\n      while q:\n          x, y = q.popleft()\n          if (x, y) == tgt:\n              actions = []\n              cx, cy = x, y\n              while (cx, cy) != src:\n                  px, py = prev[cx, cy]\n                  dx, dy = cx - px, cy - py\n                  if dx == 1:\n                      actions.append(DOWN)\n                  elif dx == -1:\n                      actions.append(UP)\n                  elif dy == 1:\n                      actions.append(RIGHT)\n                  elif dy == -1:\n                      actions.append(LEFT)\n                  cx, cy = px, py\n              actions.reverse()\n              return actions\n\n          # recompute blocked cells based on current grid state\n          blocked = np.any(state.grid > 0, axis=2)\n\n          for nx, ny, a in [(x + 1, y, DOWN), (x - 1, y, UP),\n                            (x, y + 1, RIGHT), (x, y - 1, LEFT)]:\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  # allow moving onto the target even if it is currently blocked\n                  if (nx, ny) == tgt or not blocked[nx, ny]:\n                      visited[nx, ny] = True\n                      prev[nx, ny] = (x, y)\n                      q.append((nx, ny))\n      return None  # unreachable\n\n  # -------------------------------------------------------------\n  # 1) If stick is a primitive (no recipe), just pick one up.\n  # -------------------------------------------------------------\n  if not primitive_req:\n      stick_cells = np.argwhere(state.grid[:, :, stick_idx] > 0)\n      if stick_cells.size == 0:\n          return []  # no sticks present\n      best_actions = None\n      for cell in stick_cells:\n          path = bfs(state.pos, cell)\n          if path is not None and (best_actions is None or len(path) < len(best_actions)):\n              best_actions = path\n      if best_actions is None:\n          return []  # unreachable stick\n      best_actions.append(USE)\n      return best_actions\n\n  # -------------------------------------------------------------\n  # 2) Stick must be crafted \u2013 collect required primitives.\n  # -------------------------------------------------------------\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  for prim_idx, needed_cnt in primitive_req.items():\n      for _ in range(needed_cnt):\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              return actions  # cannot satisfy requirement\n          best_path = None\n          best_cell = None\n          for cell in prim_cells:\n              path = bfs(cur_pos, cell)\n              if path is not None and (best_path is None or len(path) < len(best_path)):\n                  best_path = path\n                  best_cell = tuple(cell)\n          if best_path is None:\n              return actions  # unreachable primitive\n          actions.extend(best_path)\n          actions.append(USE)          # pick up the primitive\n          cur_pos = best_cell\n          # simulate removal of the primitive so it won't be reused\n          state.grid[best_cell[0], best_cell[1], prim_idx] = 0\n\n  # -------------------------------------------------------------\n  # 3) Go to the workshop (if any) and craft the stick.\n  # -------------------------------------------------------------\n  if workshop_idx is None:\n      return actions  # no workshop information; cannot craft\n\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      return actions  # workshop not present\n\n  best_path = None\n  best_cell = None\n  for cell in workshop_cells:\n      path = bfs(cur_pos, cell)\n      if path is not None and (best_path is None or len(path) < len(best_path)):\n          best_path = path\n          best_cell = tuple(cell)\n\n  if best_path is None:\n      return actions  # cannot reach workshop\n\n  actions.extend(best_path)\n  actions.append(USE)   # craft stick at the workshop\n  return actions", "env_interactions": 4, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:19:20.614336", "function_name": "make_arrow", "function_body": "  actions = []\n  # current state and world info\n  state = env._current_state\n  grid = state.grid\n  world = env.world\n  cb = world.cookbook\n\n  # index for the target item \"stick\"\n  try:\n      goal_idx = cb.index[\"stick\"]\n  except Exception:\n      return actions\n\n  # primitives required to craft a stick (empty dict if stick is primitive)\n  primitives_needed = cb.primitives_for(goal_idx)\n\n  # mutable copy of the agent position [x, y]\n  pos = list(state.pos)\n\n  # helper to move the agent using Manhattan steps\n  def _move_to(target):\n      nonlocal pos, actions\n      tx, ty = target\n      # move in x direction (RIGHT=3, LEFT=2)\n      while pos[0] < tx:\n          actions.append(3)   # RIGHT\n          pos[0] += 1\n      while pos[0] > tx:\n          actions.append(2)   # LEFT\n          pos[0] -= 1\n      # move in y direction (DOWN=0, UP=1)\n      while pos[1] < ty:\n          actions.append(0)   # DOWN\n          pos[1] += 1\n      while pos[1] > ty:\n          actions.append(1)   # UP\n          pos[1] -= 1\n\n  # If stick is a primitive, just collect one instance\n  if not primitives_needed:\n      locs = np.argwhere(grid[:, :, goal_idx] > 0)\n      if locs.size:\n          target = locs[0].tolist()\n          _move_to(target)\n          actions.append(4)   # USE to pick up the stick\n      return actions\n\n  # Collect each required primitive in the needed quantity\n  for prim_idx, count in primitives_needed.items():\n      locs = np.argwhere(grid[:, :, prim_idx] > 0)\n      if locs.size == 0:\n          continue  # primitive not present; should not happen\n      target = locs[0].tolist()\n      _move_to(target)\n      for _ in range(count):\n          actions.append(4)   # USE to pick up the primitive\n\n  # If the recipe specifies a workshop, move there and craft the stick\n  recipe = cb.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = cb.index[workshop_name]\n      w_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if w_locs.size:\n          w_target = w_locs[0].tolist()\n          _move_to(w_target)\n          actions.append(4)   # USE to craft at the workshop\n\n  return actions", "env_interactions": 4, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:19:21.955202", "function_name": "make_arrow", "function_body": "  actions = []\n  state = env._current_state\n  grid = state.grid\n  world = env.world\n  cb = world.cookbook\n\n  # Index of the target item \"stick\"\n  try:\n      goal_idx = cb.index[\"stick\"]\n  except Exception:\n      return actions\n\n  # Current agent position (mutable)\n  pos = list(state.pos)\n\n  # Helper to move the agent using Manhattan steps\n  def _move_to(target):\n      nonlocal pos, actions\n      tx, ty = target\n      # Move in x direction (RIGHT=3, LEFT=2)\n      while pos[0] < tx:\n          actions.append(3)   # RIGHT\n          pos[0] += 1\n      while pos[0] > tx:\n          actions.append(2)   # LEFT\n          pos[0] -= 1\n      # Move in y direction (DOWN=0, UP=1)\n      while pos[1] < ty:\n          actions.append(0)   # DOWN\n          pos[1] += 1\n      while pos[1] > ty:\n          actions.append(1)   # UP\n          pos[1] -= 1\n\n  # Determine which primitives are required to craft a stick\n  primitives_needed = cb.primitives_for(goal_idx)\n\n  # If no primitives are needed, the stick is itself a primitive\n  if not primitives_needed:\n      locs = np.argwhere(grid[:, :, goal_idx] > 0)\n      if locs.size:\n          target = locs[0].tolist()\n          _move_to(target)\n          actions.append(4)   # USE to pick up the stick\n      return actions\n\n  # Collect each required primitive in the needed quantity\n  for prim_idx, count in primitives_needed.items():\n      locs = np.argwhere(grid[:, :, prim_idx] > 0)\n      if locs.size == 0:\n          continue  # Primitive not present; skip (should not happen)\n      target = locs[0].tolist()\n      _move_to(target)\n      for _ in range(count):\n          actions.append(4)   # USE to pick up the primitive\n\n  # If the recipe specifies a workshop, move there and craft the stick\n  recipe = cb.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = cb.index[workshop_name]\n      w_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if w_locs.size:\n          w_target = w_locs[0].tolist()\n          _move_to(w_target)\n          actions.append(4)   # USE to craft at the workshop\n\n  return actions", "env_interactions": 4, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:19:37.266085", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n\n  # action identifiers\n  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act[\"DOWN\"], act[\"UP\"], act[\"LEFT\"], act[\"RIGHT\"], act[\"USE\"]\n  )\n\n  # index of the primitive \u201cstick\u201d\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # if stick is not a primitive (i.e., must be crafted), we do nothing here\n  if stick_idx not in world.cookbook.primitives:\n      return []\n\n  # locate all cells that contain a stick\n  stick_cells = np.argwhere(state.grid[:, :, stick_idx] > 0)\n  if stick_cells.size == 0:\n      return []          # nothing to collect\n\n  # grid dimensions\n  W, H = state.grid.shape[:2]\n\n  # set of non\u2011grabbable entity indices (obstacles)\n  non_grabbable = world.non_grabbable_indices\n\n  def traversable(pos):\n      \"\"\"Return True if the agent can step on the given position.\"\"\"\n      x, y = pos\n      if not (0 <= x < W and 0 <= y < H):\n          return False\n      for idx in non_grabbable:\n          if state.grid[x, y, idx] > 0:\n              return False\n      return True\n\n  start = tuple(state.pos)\n  target_set = {tuple(cell) for cell in stick_cells}\n\n  # breadth\u2011first search to the nearest reachable stick\n  queue = collections.deque([start])\n  visited = {start: None}          # maps position -> (prev_position, action_to_here)\n  goal = None\n\n  while queue:\n      cur = queue.popleft()\n      if cur in target_set:\n          goal = cur\n          break\n      x, y = cur\n      for nx, ny, a_code in [(x + 1, y, DOWN), (x - 1, y, UP),\n                             (x, y + 1, RIGHT), (x, y - 1, LEFT)]:\n          nxt = (nx, ny)\n          if nxt not in visited and traversable(nxt):\n              visited[nxt] = (cur, a_code)\n              queue.append(nxt)\n\n  if goal is None:\n      # no reachable stick found\n      return []\n\n  # reconstruct action sequence from start to the goal cell\n  actions = []\n  cur = goal\n  while visited[cur] is not None:\n      prev, a_code = visited[cur]\n      actions.append(a_code)\n      cur = prev\n  actions.reverse()\n\n  # finally, pick up the stick\n  actions.append(USE)\n  return actions", "env_interactions": 0, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:19:38.523990", "function_name": "make_arrow", "function_body": "  # Get current state and world reference\n  state = env._current_state\n  world = env.world\n\n  # Action identifiers\n  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act[\"DOWN\"], act[\"UP\"], act[\"LEFT\"], act[\"RIGHT\"], act[\"USE\"]\n  )\n\n  # Index of the primitive \"stick\"\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # Find all cells containing a stick\n  stick_cells = np.argwhere(state.grid[:, :, stick_idx] > 0)\n  if stick_cells.size == 0:\n      # No sticks on the map\n      return []\n\n  # Grid dimensions\n  width, height = state.grid.shape[:2]\n\n  # Set of indices that are non\u2011grabbable (obstacles)\n  non_grabbable = world.non_grabbable_indices\n\n  def traversable(pos):\n      \"\"\"Return True if the agent can step on the given position.\"\"\"\n      x, y = pos\n      if not (0 <= x < width and 0 <= y < height):\n          return False\n      # Position is blocked if any non\u2011grabbable entity occupies it\n      for idx in non_grabbable:\n          if state.grid[x, y, idx] > 0:\n              return False\n      return True\n\n  start = tuple(state.pos)\n  targets = {tuple(cell) for cell in stick_cells}\n\n  # Breadth\u2011first search to the nearest reachable stick\n  queue = collections.deque([start])\n  visited = {start: None}          # maps position -> (prev_position, action_to_here)\n  goal = None\n\n  while queue:\n      cur = queue.popleft()\n      if cur in targets:\n          goal = cur\n          break\n      x, y = cur\n      for nx, ny, a_code in [(x + 1, y, DOWN), (x - 1, y, UP),\n                             (x, y + 1, RIGHT), (x, y - 1, LEFT)]:\n          nxt = (nx, ny)\n          if nxt not in visited and traversable(nxt):\n              visited[nxt] = (cur, a_code)\n              queue.append(nxt)\n\n  if goal is None:\n      # No reachable stick found\n      return []\n\n  # Reconstruct the action sequence from start to the goal cell\n  actions = []\n  cur = goal\n  while visited[cur] is not None:\n      prev, a_code = visited[cur]\n      actions.append(a_code)\n      cur = prev\n  actions.reverse()\n\n  # Use the stick once we are on the target cell\n  actions.append(USE)\n  return actions", "env_interactions": 0, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:19:53.512130", "function_name": "make_arrow", "function_body": "  def _move_to(cur_pos, target, seq):\n      x, y = cur_pos\n      tx, ty = target\n      while x < tx:\n          seq.append(3)  # RIGHT\n          x += 1\n      while x > tx:\n          seq.append(2)  # LEFT\n          x -= 1\n      while y < ty:\n          seq.append(0)  # DOWN\n          y += 1\n      while y > ty:\n          seq.append(1)  # UP\n          y -= 1\n      return (x, y)\n\n  state = env._current_state\n  grid = state.grid.copy()\n  cur_pos = state.pos\n  goal_idx = env.task.goal\n\n  # lookup recipe for the goal (stick)\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n  ingredients = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  actions = []\n\n  # collect each required ingredient the required number of times\n  for ing_kind, count in ingredients.items():\n      for _ in range(count):\n          locations = np.argwhere(grid[:, :, ing_kind] > 0)\n          if locations.size == 0:\n              # ingredient not present on the map; stop trying\n              break\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          chosen = int(np.argmin(dists))\n          target = tuple(locations[chosen].tolist())\n\n          cur_pos = _move_to(cur_pos, target, actions)\n          actions.append(4)                     # USE to pick up\n          grid[target[0], target[1], ing_kind] = 0\n\n  # if a specific workshop is required, move there and use\n  if workshop_kind is not None:\n      ws_locs = np.argwhere(grid[:, :, workshop_kind] > 0)\n      if ws_locs.size > 0:\n          dists = np.abs(ws_locs[:, 0] - cur_pos[0]) + np.abs(ws_locs[:, 1] - cur_pos[1])\n          chosen = int(np.argmin(dists))\n          workshop = tuple(ws_locs[chosen].tolist())\n          cur_pos = _move_to(cur_pos, workshop, actions)\n          actions.append(4)                     # USE to craft\n\n  return actions", "env_interactions": 0, "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:19:54.815172", "function_name": "make_arrow", "function_body": "  def _move_to(cur_pos, target, seq):\n      x, y = cur_pos\n      tx, ty = target\n      while x < tx:\n          seq.append(3)  # RIGHT\n          x += 1\n      while x > tx:\n          seq.append(2)  # LEFT\n          x -= 1\n      while y < ty:\n          seq.append(0)  # DOWN\n          y += 1\n      while y > ty:\n          seq.append(1)  # UP\n          y -= 1\n      return (x, y)\n\n  state = env._current_state\n  grid = state.grid.copy()\n  cur_pos = state.pos\n  goal_idx = env.task.goal\n\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n  ingredients = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  actions = []\n\n  for ing_kind, count in ingredients.items():\n      for _ in range(count):\n          locs = np.argwhere(grid[:, :, ing_kind] > 0)\n          if locs.size == 0:\n              break\n          dists = np.abs(locs[:, 0] - cur_pos[0]) + np.abs(locs[:, 1] - cur_pos[1])\n          chosen = int(np.argmin(dists))\n          target = tuple(locs[chosen].tolist())\n          cur_pos = _move_to(cur_pos, target, actions)\n          actions.append(4)  # USE\n          grid[target[0], target[1], ing_kind] = 0\n\n  if workshop_kind is not None:\n      ws_locs = np.argwhere(grid[:, :, workshop_kind] > 0)\n      if ws_locs.size > 0:\n          dists = np.abs(ws_locs[:, 0] - cur_pos[0]) + np.abs(ws_locs[:, 1] - cur_pos[1])\n          chosen = int(np.argmin(dists))\n          workshop = tuple(ws_locs[chosen].tolist())\n          cur_pos = _move_to(cur_pos, workshop, actions)\n          actions.append(4)  # USE\n\n  return actions", "env_interactions": 0, "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:20:26.910079", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  _ACTION_DELTAS = {\n      0: (1, 0),   # DOWN\n      1: (-1, 0),  # UP\n      2: (0, -1),  # LEFT\n      3: (0, 1),   # RIGHT\n  }\n\n  def _move_actions(start, goal):\n      \"\"\"Manhattan path from start (row, col) to goal (row, col).\"\"\"\n      y, x = start\n      gy, gx = goal\n      actions = []\n      while y < gy:\n          actions.append(0)   # DOWN\n          y += 1\n      while y > gy:\n          actions.append(1)   # UP\n          y -= 1\n      while x < gx:\n          actions.append(3)   # RIGHT\n          x += 1\n      while x > gx:\n          actions.append(2)   # LEFT\n          x -= 1\n      return actions\n\n  # ------------------------------------------------------------------\n  # Locate the CraftWorld instance inside the provided env\n  # ------------------------------------------------------------------\n  if hasattr(env, \"world\"):\n      world = env.world\n  elif hasattr(env, \"scenario\"):\n      world = env.scenario.world\n  else:\n      raise AttributeError(\"Cannot locate CraftWorld instance in the supplied env.\")\n\n  # ------------------------------------------------------------------\n  # Goal information (stick)\n  # ------------------------------------------------------------------\n  goal_name = \"stick\"\n  goal_idx = world.cookbook.index.index(goal_name)\n\n  # Determine which primitive items are needed to craft a stick.\n  needed = world.cookbook.primitives_for(goal_idx)\n\n  # ------------------------------------------------------------------\n  # Obtain the current state (grid and agent position) for planning.\n  # ------------------------------------------------------------------\n  if hasattr(env, \"_current_state\"):\n      state = env._current_state\n  else:\n      state = env.scenario.init()\n  cur_pos = tuple(state.pos)          # (row, col)\n  grid = state.grid.copy()            # (H, W, n_kinds)\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper to collect a primitive (or the stick itself if primitive)\n  # ------------------------------------------------------------------\n  def _collect(p_idx):\n      nonlocal cur_pos, actions, grid\n      cells = np.argwhere(grid[:, :, p_idx] > 0)\n      if cells.size == 0:\n          raise RuntimeError(\n              f\"Required primitive {world.cookbook.index.get(p_idx)} not found on the grid.\"\n          )\n      py, px = cells[0]\n\n      # Find an empty neighbour from which we can face the primitive.\n      target = None\n      for dy, dx in _ACTION_DELTAS.values():\n          ny, nx = py - dy, px - dx\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not grid[ny, nx, :].any():\n                  target = (ny, nx)\n                  break\n      if target is None:\n          raise RuntimeError(\"No reachable empty neighbour around required primitive.\")\n\n      # Move to that neighbour.\n      actions.extend(_move_actions(cur_pos, target))\n      cur_pos = target\n\n      # Use (pick up) the primitive.\n      actions.append(4)   # USE\n\n      # Update planning grid: primitive disappears after use.\n      grid[py, px, p_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 1. Collect required primitives (if any)\n  # ------------------------------------------------------------------\n  if needed:\n      for prim_idx, cnt in needed.items():\n          for _ in range(cnt):\n              _collect(prim_idx)\n  else:\n      # Stick itself is a primitive; collect it directly.\n      _collect(goal_idx)\n      return actions\n\n  # ------------------------------------------------------------------\n  # 2. Craft the stick at its workshop (if a workshop is specified)\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_cells.size == 0:\n          raise RuntimeError(f\"Workshop {workshop_name} not found on the grid.\")\n      wy, wx = ws_cells[0]\n\n      # Find an empty neighbour to stand on.\n      target = None\n      for dy, dx in _ACTION_DELTAS.values():\n          ny, nx = wy - dy, wx - dx\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not grid[ny, nx, :].any():\n                  target = (ny, nx)\n                  break\n      if target is None:\n          raise RuntimeError(\"No reachable empty neighbour around workshop.\")\n\n      actions.extend(_move_actions(cur_pos, target))\n      cur_pos = target\n      actions.append(4)   # USE to craft the stick\n\n  # ------------------------------------------------------------------\n  # Return the planned action sequence.\n  # ------------------------------------------------------------------\n  return actions", "env_interactions": 5, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:20:28.152727", "function_name": "make_arrow", "function_body": "", "env_interactions": 0, "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-10-23T04:20:49.076165", "function_name": "make_arrow", "function_body": "  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of actions moving horizontally then vertically.\"\"\"\n      sx, sy = start\n      gx, gy = goal\n      actions = []\n      while sx < gx:\n          actions.append(ACTION_RIGHT)\n          sx += 1\n      while sx > gx:\n          actions.append(ACTION_LEFT)\n          sx -= 1\n      while sy < gy:\n          actions.append(ACTION_DOWN)\n          sy += 1\n      while sy > gy:\n          actions.append(ACTION_UP)\n          sy -= 1\n      return actions\n\n  def nearest_position(candidates, reference):\n      \"\"\"Pick the candidate with smallest Manhattan distance to reference.\"\"\"\n      if len(candidates) == 0:\n          return None\n      ref = np.array(reference)\n      dists = np.sum(np.abs(candidates - ref), axis=1)\n      return tuple(candidates[np.argmin(dists)])\n\n  # ------------------------------------------------------------------\n  # Gather current state information\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n\n  # ------------------------------------------------------------------\n  # Goal: stick\n  # ------------------------------------------------------------------\n  goal_name = \"stick\"\n  try:\n      goal_idx = env.world.cookbook.index[goal_name]\n  except Exception:\n      return []\n\n  plan_actions = []\n\n  # ------------------------------------------------------------------\n  # Determine required primitives for the stick\n  # ------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n\n  # If stick is a primitive (no recipe), just collect it.\n  if not primitives_needed:\n      stick_cells = np.argwhere(grid[:, :, goal_idx] > 0)\n      if stick_cells.size == 0:\n          return plan_actions\n      target = nearest_position(stick_cells, pos)\n      plan_actions.extend(manhattan_path(pos, target))\n      plan_actions.append(ACTION_USE)\n      return plan_actions\n\n  # ------------------------------------------------------------------\n  # 1) Collect needed primitives\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      while inventory[prim_idx] < needed_cnt:\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              return plan_actions  # cannot satisfy requirement\n          target = nearest_position(prim_cells, pos)\n\n          # Move to the primitive\n          plan_actions.extend(manhattan_path(pos, target))\n          pos = target\n\n          # Pick it up\n          plan_actions.append(ACTION_USE)\n\n          # Simulate pick\u2011up locally for further planning\n          inventory[prim_idx] += 1\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # ------------------------------------------------------------------\n  # 2) Go to workshop (if required) and craft the stick\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      try:\n          workshop_idx = env.world.cookbook.index[workshop_name]\n      except Exception:\n          return plan_actions\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          return plan_actions\n      wcell = tuple(workshop_cells[0])\n\n      # Find a free adjacent cell to stand on (fallback to the workshop cell itself)\n      neighbours = [(wcell[0] + dx, wcell[1] + dy) for dx, dy in\n                    [(1, 0), (-1, 0), (0, 1), (0, -1)]]\n      stand_pos = None\n      for nx, ny in neighbours:\n          if (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and\n                  grid[nx, ny, :].sum() == 0):\n              stand_pos = (nx, ny)\n              break\n      if stand_pos is None:\n          stand_pos = wcell\n\n      # Move to the chosen standing position\n      plan_actions.extend(manhattan_path(pos, stand_pos))\n      pos = stand_pos\n\n      # Use the workshop to craft the stick\n      plan_actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # Return the constructed action list\n  # ------------------------------------------------------------------\n  return plan_actions", "env_interactions": 5, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:20:50.381180", "function_name": "make_arrow", "function_body": "  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  def manhattan_path(start, goal):\n      \"\"\"Horizontal\u2011then\u2011vertical Manhattan path as a list of actions.\"\"\"\n      sx, sy = start\n      gx, gy = goal\n      actions = []\n      while sx < gx:\n          actions.append(ACTION_RIGHT)\n          sx += 1\n      while sx > gx:\n          actions.append(ACTION_LEFT)\n          sx -= 1\n      while sy < gy:\n          actions.append(ACTION_DOWN)\n          sy += 1\n      while sy > gy:\n          actions.append(ACTION_UP)\n          sy -= 1\n      return actions\n\n  def nearest_position(positions, reference):\n      \"\"\"Pick the cell from *positions* with smallest Manhattan distance to *reference*.\"\"\"\n      if len(positions) == 0:\n          return None\n      ref = np.array(reference)\n      dists = np.sum(np.abs(positions - ref), axis=1)\n      return tuple(positions[np.argmin(dists)])\n\n  # ------------------------------------------------------------------\n  # Gather current state information\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n\n  # ------------------------------------------------------------------\n  # Goal: stick\n  # ------------------------------------------------------------------\n  goal_name = \"stick\"\n  try:\n      goal_idx = env.world.cookbook.index[goal_name]\n  except Exception:\n      return []\n\n  plan_actions = []\n\n  # ------------------------------------------------------------------\n  # Determine required primitives for the stick\n  # ------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n\n  # If there is no recipe (stick is a primitive), just collect it directly.\n  if not primitives_needed:\n      stick_cells = np.argwhere(grid[:, :, goal_idx] > 0)\n      if stick_cells.size == 0:\n          return plan_actions\n      target = nearest_position(stick_cells, pos)\n      plan_actions.extend(manhattan_path(pos, target))\n      plan_actions.append(ACTION_USE)\n      return plan_actions\n\n  # ------------------------------------------------------------------\n  # 1) Collect needed primitives\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      while inventory[prim_idx] < needed_cnt:\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              return plan_actions  # cannot satisfy requirement\n          target = nearest_position(prim_cells, pos)\n\n          # Move to the primitive\n          plan_actions.extend(manhattan_path(pos, target))\n          pos = target\n\n          # Pick it up\n          plan_actions.append(ACTION_USE)\n\n          # Simulate pick\u2011up locally for further planning\n          inventory[prim_idx] += 1\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # ------------------------------------------------------------------\n  # 2) Go to workshop (if required) and craft the stick\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      try:\n          workshop_idx = env.world.cookbook.index[workshop_name]\n      except Exception:\n          return plan_actions\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          return plan_actions  # no visible workshop\n      wcell = tuple(workshop_cells[0])\n\n      # Find a free adjacent cell to stand on (fallback to the workshop cell itself)\n      neighbours = [(wcell[0] + dx, wcell[1] + dy) for dx, dy in\n                    [(1, 0), (-1, 0), (0, 1), (0, -1)]]\n      stand_pos = None\n      for nx, ny in neighbours:\n          if (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and\n                  grid[nx, ny, :].sum() == 0):\n              stand_pos = (nx, ny)\n              break\n      if stand_pos is None:\n          stand_pos = wcell\n\n      # Move to the chosen standing position\n      plan_actions.extend(manhattan_path(pos, stand_pos))\n      pos = stand_pos\n\n      # Use the workshop to craft the stick\n      plan_actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # Return the constructed action list\n  # ------------------------------------------------------------------\n  return plan_actions", "env_interactions": 5, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:21:06.633072", "function_name": "make_arrow", "function_body": "  actions = []\n  state = env._current_state\n  grid = state.grid\n  world = env.world\n  cb = world.cookbook\n\n  try:\n      goal_idx = cb.index[\"stick\"]\n  except Exception:\n      return actions\n\n  needed = cb.primitives_for(goal_idx)\n\n  pos = list(state.pos)\n\n  def _move_to(target):\n      nonlocal pos, actions\n      tx, ty = target\n      while pos[0] < tx:\n          actions.append(3)   # RIGHT\n          pos[0] += 1\n      while pos[0] > tx:\n          actions.append(2)   # LEFT\n          pos[0] -= 1\n      while pos[1] < ty:\n          actions.append(0)   # DOWN\n          pos[1] += 1\n      while pos[1] > ty:\n          actions.append(1)   # UP\n          pos[1] -= 1\n\n  if not needed:\n      locs = np.argwhere(grid[:, :, goal_idx] > 0)\n      if locs.size:\n          _move_to(locs[0].tolist())\n          actions.append(4)   # USE\n      return actions\n\n  for prim_idx, cnt in needed.items():\n      locs = np.argwhere(grid[:, :, prim_idx] > 0)\n      if not locs.size:\n          continue\n      target = locs[0].tolist()\n      _move_to(target)\n      for _ in range(cnt):\n          actions.append(4)   # USE\n\n  recipe = cb.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = cb.index[workshop_name]\n      w_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if w_locs.size:\n          _move_to(w_locs[0].tolist())\n          actions.append(4)   # USE\n\n  return actions", "env_interactions": 4, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:21:07.887603", "function_name": "make_arrow", "function_body": "  actions = []\n  state = env._current_state\n  grid = state.grid\n  world = env.world\n  cb = world.cookbook\n\n  # Index of the target item \"stick\"\n  try:\n      goal_idx = cb.index[\"stick\"]\n  except Exception:\n      return actions\n\n  # Map of primitive indices \u2192 required counts for one stick\n  needed_prims = cb.primitives_for(goal_idx)\n\n  # Mutable copy of the agent's current position\n  pos = list(state.pos)\n\n  # Helper to move the agent to a target (x, y) using Manhattan steps\n  def _move_to(target):\n      nonlocal pos, actions\n      tx, ty = target\n      # move along x (RIGHT=3, LEFT=2)\n      while pos[0] < tx:\n          actions.append(3)   # RIGHT\n          pos[0] += 1\n      while pos[0] > tx:\n          actions.append(2)   # LEFT\n          pos[0] -= 1\n      # move along y (DOWN=0, UP=1)\n      while pos[1] < ty:\n          actions.append(0)   # DOWN\n          pos[1] += 1\n      while pos[1] > ty:\n          actions.append(1)   # UP\n          pos[1] -= 1\n\n  # ------------------------------------------------------------------\n  # If there is no recipe, the stick itself is a primitive; just pick it.\n  # ------------------------------------------------------------------\n  if not needed_prims:\n      locs = np.argwhere(grid[:, :, goal_idx] > 0)\n      if locs.size:\n          _move_to(locs[0].tolist())\n          actions.append(4)   # USE to pick up the stick\n      return actions\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive.\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed_prims.items():\n      # Find a cell that contains the primitive.\n      prim_locs = np.argwhere(grid[:, :, prim_idx] > 0)\n      if not prim_locs.size:\n          continue  # primitive missing; should not happen in a valid scenario\n      target = prim_locs[0].tolist()\n      _move_to(target)\n      for _ in range(cnt):\n          actions.append(4)   # USE to pick up one unit\n\n  # ------------------------------------------------------------------\n  # If the recipe requires a workshop, move there and craft the stick.\n  # ------------------------------------------------------------------\n  recipe = cb.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = cb.index[workshop_name]\n      w_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if w_locs.size:\n          _move_to(w_locs[0].tolist())\n          actions.append(4)   # USE to craft at the workshop\n\n  return actions", "env_interactions": 4, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:21:24.487483", "function_name": "make_arrow", "function_body": "  # get current state (handle raw CraftWorld usage)\n  try:\n      state = env._current_state\n  except AttributeError:\n      env.reset()\n      state = env._current_state\n\n  # action indices\n  specs = env.action_specs()\n  DOWN = specs[\"DOWN\"]\n  UP = specs[\"UP\"]\n  LEFT = specs[\"LEFT\"]\n  RIGHT = specs[\"RIGHT\"]\n  USE = specs[\"USE\"]\n\n  # index of stick\n  stick_idx = env.world.cookbook.index[\"stick\"]\n  # required primitives (empty dict if stick is primitive)\n  prim_req = env.world.cookbook.primitives_for(stick_idx)\n\n  # copy grid for planning and build blocked mask (non\u2011grabbable entities)\n  grid = state.grid.copy()\n  blocked = np.zeros(grid.shape[:2], dtype=bool)\n  for idx in env.world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # BFS helper returning list of actions from start to goal avoiding blocked cells\n  def _bfs_path(start, goal):\n      from collections import deque\n      dirs = [\n          (1, 0, DOWN),   # down\n          (-1, 0, UP),    # up\n          (0, -1, LEFT),  # left\n          (0, 1, RIGHT),  # right\n      ]\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for dx, dy, a in dirs:\n              nx, ny = x + dx, y + dy\n              if (\n                  0 <= nx < blocked.shape[0]\n                  and 0 <= ny < blocked.shape[1]\n                  and not blocked[nx, ny]\n                  and (nx, ny) not in visited\n              ):\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [a]))\n      return None\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # ------------------------------------------------------------------\n  # Case 1: stick is a primitive already placed in the world\n  # ------------------------------------------------------------------\n  if not prim_req:\n      cells = np.argwhere(grid[:, :, stick_idx] > 0)\n      if cells.size == 0:\n          return actions\n      target = tuple(cells[0])\n      if cur_pos != target:\n          path = _bfs_path(cur_pos, target)\n          if path is None:\n              return actions\n          actions.extend(path)\n          cur_pos = target\n      actions.append(USE)\n      return actions\n\n  # ------------------------------------------------------------------\n  # Case 2: collect required primitives\n  # ------------------------------------------------------------------\n  needed = dict(prim_req)  # mutable copy\n  while any(cnt > 0 for cnt in needed.values()):\n      best_path = None\n      best_target = None\n      best_prim = None\n      for prim_idx, cnt in needed.items():\n          if cnt <= 0:\n              continue\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          for cell in prim_cells:\n              target = tuple(cell)\n              path = _bfs_path(cur_pos, target)\n              if path is None:\n                  continue\n              if best_path is None or len(path) < len(best_path):\n                  best_path = path\n                  best_target = target\n                  best_prim = prim_idx\n      if best_path is None:\n          # cannot reach any remaining required primitive\n          return actions\n      actions.extend(best_path)\n      actions.append(USE)\n      cur_pos = best_target\n      needed[best_prim] -= 1\n      grid[best_target[0], best_target[1], best_prim] = 0\n\n  # ------------------------------------------------------------------\n  # Case 3: move to required workshop (if recipe specifies one) and craft\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_cells.size > 0:\n          target = tuple(ws_cells[0])\n          if cur_pos != target:\n              path = _bfs_path(cur_pos, target)\n              if path is not None:\n                  actions.extend(path)\n                  cur_pos = target\n\n  # final USE to craft or pick up the stick\n  actions.append(USE)\n  return actions", "env_interactions": 3, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:21:25.747492", "function_name": "make_arrow", "function_body": "  # Get action indices from the environment\n  specs = env.action_specs()\n  DOWN = specs[\"DOWN\"]\n  UP = specs[\"UP\"]\n  LEFT = specs[\"LEFT\"]\n  RIGHT = specs[\"RIGHT\"]\n  USE = specs[\"USE\"]\n\n  # Index of the item we want to create: stick\n  stick_idx = env.world.cookbook.index[\"stick\"]\n\n  # Primitive requirements for a stick (empty dict if stick is primitive)\n  prim_req = env.world.cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n\n  # Copy the current grid for planning (so we can \u201cremove\u201d collected items)\n  state = env._current_state if hasattr(env, \"_current_state\") else env.reset()\n  grid = state.grid.copy()\n\n  # Build a mask of blocked cells (non\u2011grabbable entities)\n  blocked = np.zeros(grid.shape[:2], dtype=bool)\n  for idx in env.world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS shortest path avoiding blocked cells, returns list of actions\n  # ----------------------------------------------------------------------\n  def _bfs_path(start, goal, blocked_mask):\n      from collections import deque\n\n      dirs = [\n          (1, 0, DOWN),   # down\n          (-1, 0, UP),    # up\n          (0, -1, LEFT),  # left\n          (0, 1, RIGHT),  # right\n      ]\n\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for dx, dy, a in dirs:\n              nx, ny = x + dx, y + dy\n              if (\n                  0 <= nx < blocked_mask.shape[0]\n                  and 0 <= ny < blocked_mask.shape[1]\n                  and not blocked_mask[nx, ny]\n                  and (nx, ny) not in visited\n              ):\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [a]))\n      return None  # unreachable\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # ----------------------------------------------------------------------\n  # CASE 1: stick is already a primitive placed in the world\n  # ----------------------------------------------------------------------\n  if not prim_req:\n      stick_cells = np.argwhere(grid[:, :, stick_idx] > 0)\n      if stick_cells.size == 0:\n          return []                     # no stick available\n      target = tuple(stick_cells[0])\n      if cur_pos != target:\n          path = _bfs_path(cur_pos, target, blocked)\n          if path is None:\n              return []                 # cannot reach the stick\n          actions.extend(path)\n          cur_pos = target\n      actions.append(USE)\n      return actions\n\n  # ----------------------------------------------------------------------\n  # CASE 2: collect required primitives\n  # ----------------------------------------------------------------------\n  needed = dict(prim_req)               # mutable copy of requirements\n\n  while any(cnt > 0 for cnt in needed.values()):\n      best_path = None\n      best_target = None\n      best_prim = None\n\n      # Find nearest reachable primitive that we still need\n      for prim_idx, cnt in needed.items():\n          if cnt <= 0:\n              continue\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          for cell in prim_cells:\n              target = tuple(cell)\n              path = _bfs_path(cur_pos, target, blocked)\n              if path is None:\n                  continue\n              if best_path is None or len(path) < len(best_path):\n                  best_path = path\n                  best_target = target\n                  best_prim = prim_idx\n\n      if best_path is None:\n          # No reachable required primitive left\n          return []\n\n      # Move to the primitive and pick it up\n      actions.extend(best_path)\n      actions.append(USE)\n\n      # Update planning state\n      cur_pos = best_target\n      needed[best_prim] -= 1\n      grid[best_target[0], best_target[1], best_prim] = 0   # remove from copy\n\n  # ----------------------------------------------------------------------\n  # CASE 3: go to required workshop (if any) and craft the stick\n  # ----------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      # workshop_name is a string; obtain its index\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_cells.size > 0:\n          target = tuple(ws_cells[0])\n          if cur_pos != target:\n              path = _bfs_path(cur_pos, target, blocked)\n              if path is None:\n                  return []                 # cannot reach workshop\n              actions.extend(path)\n              cur_pos = target\n\n  # Finally, use the workshop (or the current cell) to craft the stick\n  actions.append(USE)\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:21:47.991145", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # ------------------------------------------------------------------\n  # Helpers for movement and interaction\n  # ------------------------------------------------------------------\n  _ACTION_DELTAS = {\n      0: (1, 0),   # DOWN\n      1: (-1, 0),  # UP\n      2: (0, -1),  # LEFT\n      3: (0, 1),   # RIGHT\n  }\n\n  def _move_actions(start, goal):\n      \"\"\"Manhattan walk from start (row,col) to goal (row,col).\"\"\"\n      y, x = start\n      gy, gx = goal\n      acts = []\n      while y < gy:\n          acts.append(0)   # DOWN\n          y += 1\n      while y > gy:\n          acts.append(1)   # UP\n          y -= 1\n      while x < gx:\n          acts.append(3)   # RIGHT\n          x += 1\n      while x > gx:\n          acts.append(2)   # LEFT\n          x -= 1\n      return acts\n\n  def _adjacent_empty(cell_y, cell_x, grid):\n      \"\"\"Return a free neighbour (ny,nx) that can face the given cell.\"\"\"\n      for dy, dx in _ACTION_DELTAS.values():\n          ny, nx = cell_y - dy, cell_x - dx\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not grid[ny, nx, :].any():\n                  return (ny, nx)\n      return None\n\n  # ------------------------------------------------------------------\n  # Locate the CraftWorld instance inside the supplied env\n  # ------------------------------------------------------------------\n  if hasattr(env, \"world\"):\n      world = env.world\n  elif hasattr(env, \"scenario\"):\n      world = env.scenario.world\n  else:\n      raise AttributeError(\"Cannot locate CraftWorld instance in the given env.\")\n\n  # ------------------------------------------------------------------\n  # Identify the goal (stick) and its recipe\n  # ------------------------------------------------------------------\n  goal_name = \"stick\"\n  goal_idx = world.cookbook.index[goal_name]\n\n  # primitives needed to craft the stick (empty dict if stick itself is primitive)\n  needed = world.cookbook.primitives_for(goal_idx)\n\n  # ------------------------------------------------------------------\n  # Obtain current state (position + grid) for planning\n  # ------------------------------------------------------------------\n  if hasattr(env, \"_current_state\"):\n      state = env._current_state\n  else:\n      state = env.scenario.init()\n\n  cur_pos = tuple(state.pos)          # (row, col)\n  grid = state.grid.copy()            # (H, W, n_kinds)\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper: move to a primitive (or stick) and pick it up\n  # ------------------------------------------------------------------\n  def _collect_item(item_idx):\n      nonlocal cur_pos, actions, grid\n      cells = np.argwhere(grid[:, :, item_idx] > 0)\n      if cells.size == 0:\n          raise RuntimeError(\n              f\"Required item '{world.cookbook.index.get(item_idx)}' not found on the grid.\"\n          )\n      iy, ix = cells[0]\n\n      target = _adjacent_empty(iy, ix, grid)\n      if target is None:\n          raise RuntimeError(\"No reachable empty neighbour around required item.\")\n      actions.extend(_move_actions(cur_pos, target))\n      cur_pos = target\n      actions.append(4)   # USE to pick up / craft\n      grid[iy, ix, item_idx] = 0   # consume the item from the world\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives (if any)\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          _collect_item(prim_idx)\n\n  # ------------------------------------------------------------------\n  # 2. If stick is a primitive (no recipe), just pick it up and finish\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  if not recipe:   # stick has no recipe \u2192 primitive\n      _collect_item(goal_idx)\n      return actions\n\n  # ------------------------------------------------------------------\n  # 3. Craft the stick at its designated workshop (specified via \"_at\")\n  # ------------------------------------------------------------------\n  workshop_name = recipe.get(\"_at\")\n  if not workshop_name:\n      raise RuntimeError(\"Stick recipe exists but no workshop ('_at') specified.\")\n  workshop_idx = world.cookbook.index[workshop_name]\n\n  ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if ws_cells.size == 0:\n      raise RuntimeError(f\"Workshop '{workshop_name}' not found on the grid.\")\n  wy, wx = ws_cells[0]\n\n  target = _adjacent_empty(wy, wx, grid)\n  if target is None:\n      raise RuntimeError(\"No reachable empty neighbour around the workshop.\")\n  actions.extend(_move_actions(cur_pos, target))\n  cur_pos = target\n  actions.append(4)   # USE to craft the stick\n\n  return actions", "env_interactions": 5, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:21:49.435930", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # ----------------------------------------------------------------------\n  # locate the CraftWorld instance inside the supplied env\n  # ----------------------------------------------------------------------\n  if hasattr(env, \"world\"):\n      world = env.world\n  elif hasattr(env, \"scenario\"):\n      world = env.scenario.world\n  else:\n      raise AttributeError(\"Cannot locate CraftWorld instance in the given env.\")\n\n  # ----------------------------------------------------------------------\n  # identify the goal (stick) and its recipe\n  # ----------------------------------------------------------------------\n  goal_name = \"stick\"\n  goal_idx = world.cookbook.index[goal_name]\n\n  # primitives needed to craft the stick (empty if stick itself is primitive)\n  needed = world.cookbook.primitives_for(goal_idx)\n\n  # ----------------------------------------------------------------------\n  # obtain current state (position + grid) for planning\n  # ----------------------------------------------------------------------\n  if hasattr(env, \"_current_state\"):\n      state = env._current_state\n  else:\n      state = env.scenario.init()\n\n  cur_pos = tuple(state.pos)          # (row, col)\n  grid = state.grid.copy()            # (H, W, n_kinds)\n\n  # ----------------------------------------------------------------------\n  # movement helpers (action indices: 0=DOWN,1=UP,2=LEFT,3=RIGHT,4=USE)\n  # ----------------------------------------------------------------------\n  _ACTION_DELTAS = {\n      0: (1, 0),    # DOWN\n      1: (-1, 0),   # UP\n      2: (0, -1),   # LEFT\n      3: (0, 1),    # RIGHT\n  }\n\n  def _move_actions(start, goal):\n      \"\"\"Manhattan walk from start (row,col) to goal (row,col).\"\"\"\n      y, x = start\n      gy, gx = goal\n      acts = []\n      while y < gy:\n          acts.append(0)   # DOWN\n          y += 1\n      while y > gy:\n          acts.append(1)   # UP\n          y -= 1\n      while x < gx:\n          acts.append(3)   # RIGHT\n          x += 1\n      while x > gx:\n          acts.append(2)   # LEFT\n          x -= 1\n      return acts\n\n  def _empty_neighbour(y, x):\n      \"\"\"Return coordinates of a free neighbour cell from which (y,x) can be faced.\"\"\"\n      for dy, dx in _ACTION_DELTAS.values():\n          ny, nx = y - dy, x - dx\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not grid[ny, nx, :].any():\n                  return (ny, nx)\n      return None\n\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # helper: collect a primitive (or primitive stick) and update planning state\n  # ----------------------------------------------------------------------\n  def _collect(p_idx):\n      nonlocal cur_pos, actions, grid\n      cells = np.argwhere(grid[:, :, p_idx] > 0)\n      if cells.size == 0:\n          raise RuntimeError(\n              f\"Required primitive '{world.cookbook.index.get(p_idx)}' not found on the grid.\"\n          )\n      py, px = cells[0]\n\n      target = _empty_neighbour(py, px)\n      if target is None:\n          raise RuntimeError(\"No reachable empty neighbour around required primitive.\")\n      actions.extend(_move_actions(cur_pos, target))\n      cur_pos = target\n      actions.append(4)                     # USE to pick up / craft\n      grid[py, px, p_idx] = 0               # mark as consumed for planning\n\n  # ----------------------------------------------------------------------\n  # 1. Collect all needed primitives for the stick recipe (if any)\n  # ----------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          _collect(prim_idx)\n\n  # ----------------------------------------------------------------------\n  # 2. Determine whether stick itself needs to be crafted or is a primitive\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  if not recipe:                     # stick is a primitive item\n      _collect(goal_idx)\n      return actions\n\n  # ----------------------------------------------------------------------\n  # 3. Craft the stick at its designated workshop\n  # ----------------------------------------------------------------------\n  workshop_name = recipe.get(\"_at\")\n  if not workshop_name:\n      raise RuntimeError(\"Stick recipe exists but no workshop ('_at') specified.\")\n\n  workshop_idx = world.cookbook.index[workshop_name]\n  ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if ws_cells.size == 0:\n      raise RuntimeError(f\"Workshop '{workshop_name}' not found on the grid.\")\n  wy, wx = ws_cells[0]\n\n  target = _empty_neighbour(wy, wx)\n  if target is None:\n      raise RuntimeError(\"No reachable empty neighbour around the workshop.\")\n  actions.extend(_move_actions(cur_pos, target))\n  cur_pos = target\n  actions.append(4)                     # USE to craft the stick\n\n  return actions", "env_interactions": 5, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:22:18.992070", "function_name": "make_arrow", "function_body": "  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  _ACTION_DELTAS = {\n      0: (1, 0),   # DOWN\n      1: (-1, 0),  # UP\n      2: (0, -1),  # LEFT\n      3: (0, 1),   # RIGHT\n  }\n\n  def _move_actions(start, goal):\n      \"\"\"Manhattan path from start (y,x) to goal (y,x) using orthogonal moves.\"\"\"\n      y, x = start\n      gy, gx = goal\n      actions = []\n      while y < gy:\n          actions.append(0)   # DOWN\n          y += 1\n      while y > gy:\n          actions.append(1)   # UP\n          y -= 1\n      while x < gx:\n          actions.append(3)   # RIGHT\n          x += 1\n      while x > gx:\n          actions.append(2)   # LEFT\n          x -= 1\n      return actions\n\n  # ------------------------------------------------------------------\n  # Locate the CraftWorld instance inside the provided env\n  # ------------------------------------------------------------------\n  if hasattr(env, \"world\"):\n      world = env.world\n  elif hasattr(env, \"scenario\"):\n      world = env.scenario.world\n  else:\n      raise AttributeError(\"Cannot locate CraftWorld instance in the supplied env.\")\n\n  # ------------------------------------------------------------------\n  # Goal information (stick)\n  # ------------------------------------------------------------------\n  goal_name = \"stick\"\n  goal_idx = world.cookbook.index.index(goal_name)\n\n  # Determine which primitive items are needed to craft a stick.\n  needed = world.cookbook.primitives_for(goal_idx)\n\n  # If there is no recipe, the stick itself is a primitive that must be collected.\n  collect_directly = False\n  if not needed:\n      needed = {goal_idx: 1}\n      collect_directly = True\n\n  # ------------------------------------------------------------------\n  # Obtain the current state (grid and agent position) for planning.\n  # ------------------------------------------------------------------\n  if hasattr(env, \"_current_state\"):\n      state = env._current_state\n  else:\n      state = env.scenario.init()\n  cur_pos = tuple(state.pos)          # (row, col)\n  grid = state.grid.copy()            # (H, W, n_kinds)\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Collect all required primitives (or the stick itself if primitive)\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(\n                  f\"Required primitive {world.cookbook.index.get(prim_idx)} not found on the grid.\"\n              )\n          py, px = prim_cells[0]\n\n          # Find an empty neighbour from which we can face the primitive.\n          target_cell = None\n          for d, (dy, dx) in _ACTION_DELTAS.items():\n              ny, nx = py - dy, px - dx\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  if not grid[ny, nx, :].any():\n                      target_cell = (ny, nx)\n                      break\n          if target_cell is None:\n              raise RuntimeError(\"No reachable empty neighbour around required primitive.\")\n\n          # Move to that neighbour.\n          actions.extend(_move_actions(cur_pos, target_cell))\n          cur_pos = target_cell\n\n          # Use (pick up / craft) the primitive.\n          actions.append(4)   # USE\n\n          # Update planning grid: primitive disappears after use.\n          grid[py, px, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # If a workshop is required (i.e., stick is not a direct primitive),\n  # move to it and USE to craft.\n  # ------------------------------------------------------------------\n  if not collect_directly:\n      recipe = world.cookbook.recipes.get(goal_idx, {})\n      workshop_name = recipe.get(\"_at\")\n      if workshop_name:\n          workshop_idx = world.cookbook.index.index(workshop_name)\n          ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n          if ws_cells.size == 0:\n              raise RuntimeError(f\"Workshop {workshop_name} not found on the grid.\")\n          wy, wx = ws_cells[0]\n\n          # Find an empty neighbour to face the workshop.\n          target_cell = None\n          for d, (dy, dx) in _ACTION_DELTAS.items():\n              ny, nx = wy - dy, wx - dx\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  if not grid[ny, nx, :].any():\n                      target_cell = (ny, nx)\n                      break\n          if target_cell is None:\n              raise RuntimeError(\"No reachable empty neighbour around workshop.\")\n\n          # Move there and craft.\n          actions.extend(_move_actions(cur_pos, target_cell))\n          cur_pos = target_cell\n          actions.append(4)   # USE\n\n  # ------------------------------------------------------------------\n  # Return the planned action sequence.\n  # ------------------------------------------------------------------\n  return actions", "env_interactions": 5, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:22:20.301877", "function_name": "make_arrow", "function_body": "  # Helper utilities\n  _ACTION_DELTAS = {\n      0: (1, 0),   # DOWN\n      1: (-1, 0),  # UP\n      2: (0, -1),  # LEFT\n      3: (0, 1),   # RIGHT\n  }\n\n  def _move_actions(start, goal):\n      \"\"\"Return a list of actions to move from start (y,x) to goal (y,x) using Manhattan moves.\"\"\"\n      y, x = start\n      gy, gx = goal\n      actions = []\n      while y < gy:\n          actions.append(0)   # DOWN\n          y += 1\n      while y > gy:\n          actions.append(1)   # UP\n          y -= 1\n      while x < gx:\n          actions.append(3)   # RIGHT\n          x += 1\n      while x > gx:\n          actions.append(2)   # LEFT\n          x -= 1\n      return actions\n\n  # Locate the CraftWorld instance inside the environment\n  if hasattr(env, \"world\"):\n      world = env.world\n  elif hasattr(env, \"scenario\"):\n      world = env.scenario.world\n  else:\n      raise AttributeError(\"Cannot locate CraftWorld instance in the supplied env.\")\n\n  # Goal information (stick)\n  goal_name = \"stick\"\n  goal_idx = world.cookbook.index.index(goal_name)\n\n  # Determine required primitives for the stick\n  needed = world.cookbook.primitives_for(goal_idx)\n\n  # If there is no recipe, the stick itself is a primitive to be collected directly\n  collect_directly = False\n  if not needed:\n      needed = {goal_idx: 1}\n      collect_directly = True\n\n  # Obtain the current state (grid and agent position) for planning\n  if hasattr(env, \"_current_state\"):\n      state = env._current_state\n  else:\n      state = env.scenario.init()\n  cur_pos = tuple(state.pos)          # (row, col)\n  grid = state.grid.copy()            # (H, W, n_kinds)\n\n  actions = []\n\n  # Collect all required primitives (or the stick itself if primitive)\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(\n                  f\"Required primitive {world.cookbook.index.get(prim_idx)} not found on the grid.\"\n              )\n          py, px = prim_cells[0]\n\n          # Find an empty neighbour from which we can face the primitive.\n          target_cell = None\n          for d, (dy, dx) in _ACTION_DELTAS.items():\n              ny, nx = py - dy, px - dx\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  if not grid[ny, nx, :].any():\n                      target_cell = (ny, nx)\n                      break\n          if target_cell is None:\n              raise RuntimeError(\"No reachable empty neighbour around required primitive.\")\n\n          # Move to that neighbour.\n          actions.extend(_move_actions(cur_pos, target_cell))\n          cur_pos = target_cell\n\n          # Use (pick up / craft) the primitive.\n          actions.append(4)   # USE\n\n          # Update planning grid: primitive disappears after use.\n          grid[py, px, prim_idx] = 0\n\n  # If a workshop is required (i.e., stick is not a direct primitive), move to it and craft.\n  if not collect_directly:\n      recipe = world.cookbook.recipes.get(goal_idx, {})\n      workshop_name = recipe.get(\"_at\")\n      if workshop_name:\n          workshop_idx = world.cookbook.index.index(workshop_name)\n          ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n          if ws_cells.size == 0:\n              raise RuntimeError(f\"Workshop {workshop_name} not found on the grid.\")\n          wy, wx = ws_cells[0]\n\n          # Find an empty neighbour to face the workshop.\n          target_cell = None\n          for d, (dy, dx) in _ACTION_DELTAS.items():\n              ny, nx = wy - dy, wx - dx\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  if not grid[ny, nx, :].any():\n                      target_cell = (ny, nx)\n                      break\n          if target_cell is None:\n              raise RuntimeError(\"No reachable empty neighbour around workshop.\")\n\n          # Move there and craft.\n          actions.extend(_move_actions(cur_pos, target_cell))\n          cur_pos = target_cell\n          actions.append(4)   # USE\n\n  # Return the planned action sequence.\n  return actions", "env_interactions": 5, "island_id": 7, "scores": {"3": 0.0}}
