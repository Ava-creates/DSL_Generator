{"timestamp": "2025-10-23T03:40:07.050847", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n  stick_idx = cookbook.index['stick']\n\n  # Already have a stick.\n  if state.inventory[stick_idx] > 0:\n      return []\n\n  actions = []\n  cur_pos = state.pos\n\n  # ----- helper utilities -----\n  def _move_to(tx, ty, pos, act_list):\n      x, y = pos\n      while x < tx:\n          act_list.append(3)   # RIGHT\n          x += 1\n      while x > tx:\n          act_list.append(2)   # LEFT\n          x -= 1\n      while y < ty:\n          act_list.append(0)   # DOWN\n          y += 1\n      while y > ty:\n          act_list.append(1)   # UP\n          y -= 1\n      return (x, y)\n\n  def _nearest(kind_idx, cur):\n      positions = np.argwhere(state.grid[:, :, kind_idx] > 0)\n      if positions.size == 0:\n          return None\n      dists = np.abs(positions[:, 0] - cur[0]) + np.abs(positions[:, 1] - cur[1])\n      best = positions[dists.argmin()]\n      return (int(best[0]), int(best[1]))\n\n  def _go_and_pick(kind_idx, cur, act_list):\n      target = _nearest(kind_idx, cur)\n      if target is None:\n          return cur, False\n      cur = _move_to(target[0], target[1], cur, act_list)\n      act_list.append(4)               # USE / pick up / interact\n      return cur, True\n  # -----------------------------\n\n  # Case 1: stick is a primitive resource.\n  if stick_idx in cookbook.primitives:\n      cur_pos, ok = _go_and_pick(stick_idx, cur_pos, actions)\n      return actions if ok else []\n\n  # Case 2: stick must be crafted.\n  recipe = cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get('_at', None)\n\n  # Collect all non\u2011workshop ingredients.\n  for ing_key, cnt in recipe.items():\n      if ing_key == '_at':\n          continue\n      ing_idx = ing_key if isinstance(ing_key, int) else cookbook.index[ing_key]\n      for _ in range(cnt):\n          cur_pos, ok = _go_and_pick(ing_idx, cur_pos, actions)\n          if not ok:\n              return []                     # Missing ingredient.\n\n  # Move to workshop (if required) before crafting.\n  if workshop_name is not None:\n      ws_idx = cookbook.index[workshop_name]\n      cur_pos, ok = _go_and_pick(ws_idx, cur_pos, actions)\n      if not ok:\n          return []                         # Workshop not found.\n\n  # Finally, craft the stick.\n  actions.append(4)                           # USE to craft\n  return actions", "env_interactions": 5, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:40:32.060722", "function_name": "make_arrow", "function_body": "  # Retrieve action indices from the environment.\n  act = env.action_specs()\n  DOWN = act.get(\"DOWN\", 0)\n  UP = act.get(\"UP\", 1)\n  LEFT = act.get(\"LEFT\", 2)\n  RIGHT = act.get(\"RIGHT\", 3)\n  USE = act.get(\"USE\", 4)\n\n  # Current state and a mutable copy of the grid for planning.\n  state = env._current_state\n  grid = state.grid.copy()                     # shape (W, H, n_kinds)\n  cur_pos = tuple(state.pos)                   # (x, y)\n\n  # Resolve the integer index for the goal item \"stick\".\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n      if stick_idx is None:\n          return []   # stick not defined in this world\n\n  # Determine primitive requirements for one stick.\n  primitive_req = env.world.cookbook.primitives_for(stick_idx)\n  # If the item itself is a primitive (no recipe), we need to collect it.\n  if not primitive_req:\n      primitive_req = {stick_idx: 1}\n\n  # Identify any required workshop from the recipe (key \"_at\").\n  workshop_idx = None\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  for k, v in recipe.items():\n      if k == \"_at\":\n          workshop_idx = v\n          break\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper: find the closest cell that still contains at least one of the\n  # given kind (according to the planning grid copy).\n  # ------------------------------------------------------------------\n  def find_closest(kind_idx, cur):\n      positions = np.argwhere(grid[:, :, kind_idx] > 0)\n      if positions.shape[0] == 0:\n          return None\n      dists = np.sum(np.abs(positions - np.array(cur)), axis=1)\n      nearest = positions[np.argmin(dists)]\n      return tuple(nearest.tolist())\n\n  # ------------------------------------------------------------------\n  # Helper: generate a simple Manhattan path (greedy) from cur to target.\n  # Returns the list of movement actions and the new position.\n  # ------------------------------------------------------------------\n  def path_to(cur, target):\n      x, y = cur\n      tx, ty = target\n      path = []\n      while (x, y) != (tx, ty):\n          if x < tx:\n              path.append(RIGHT)\n              x += 1\n          elif x > tx:\n              path.append(LEFT)\n              x -= 1\n          elif y < ty:\n              path.append(DOWN)\n              y += 1\n          elif y > ty:\n              path.append(UP)\n              y -= 1\n      return path, (x, y)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the needed number of times.\n  # ------------------------------------------------------------------\n  for kind_idx, needed in primitive_req.items():\n      while needed > 0:\n          target = find_closest(kind_idx, cur_pos)\n          if target is None:\n              # No more of this primitive available \u2013 abort planning.\n              return actions\n          move_actions, cur_pos = path_to(cur_pos, target)\n          actions.extend(move_actions)\n          actions.append(USE)   # pick up the primitive\n\n          # Update the planning grid to reflect the consumption.\n          grid[target[0], target[1], kind_idx] = max(\n              0, grid[target[0], target[1], kind_idx] - 1\n          )\n          needed -= 1\n\n  # ------------------------------------------------------------------\n  # If a workshop is required, move to it and craft the stick.\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_target = find_closest(workshop_idx, cur_pos)\n      if ws_target is not None:\n          move_actions, cur_pos = path_to(cur_pos, ws_target)\n          actions.extend(move_actions)\n          actions.append(USE)   # craft the stick at the workshop\n\n  return actions", "env_interactions": 0, "island_id": 2, "scores": {"3": -1}}
