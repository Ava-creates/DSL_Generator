{"timestamp": "2025-10-23T03:49:48.572939", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n\n  # Action identifiers\n  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act[\"DOWN\"], act[\"UP\"], act[\"LEFT\"], act[\"RIGHT\"], act[\"USE\"]\n  )\n\n  # Index for the primitive \"stick\"\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # Locate all sticks on the map\n  stick_cells = np.argwhere(state.grid[:, :, stick_idx] > 0)\n  if stick_cells.size == 0:\n      # No sticks present\n      return []\n\n  # Grid dimensions\n  width, height = state.grid.shape[:2]\n\n  # Set of non\u2011grabbable entity indices (obstacles)\n  non_grabbable = world.non_grabbable_indices\n\n  def traversable(pos):\n      \"\"\"Return True if the agent can step on the given position.\"\"\"\n      x, y = pos\n      if not (0 <= x < width and 0 <= y < height):\n          return False\n      for idx in non_grabbable:\n          if state.grid[x, y, idx] > 0:\n              return False\n      return True\n\n  start = tuple(state.pos)\n  target_set = {tuple(cell) for cell in stick_cells}\n\n  # Breadth\u2011first search for the nearest reachable stick\n  from collections import deque\n\n  queue = deque([start])\n  visited = {start: None}  # maps position -> (prev_position, action_to_here)\n  goal = None\n\n  while queue:\n      cur = queue.popleft()\n      if cur in target_set:\n          goal = cur\n          break\n      x, y = cur\n      for nx, ny, a_code in [(x + 1, y, DOWN), (x - 1, y, UP),\n                             (x, y + 1, RIGHT), (x, y - 1, LEFT)]:\n          nxt = (nx, ny)\n          if nxt not in visited and traversable(nxt):\n              visited[nxt] = (cur, a_code)\n              queue.append(nxt)\n\n  if goal is None:\n      # No reachable stick found\n      return []\n\n  # Reconstruct the action sequence from start to the goal cell\n  actions = []\n  cur = goal\n  while visited[cur] is not None:\n      prev, a_code = visited[cur]\n      actions.append(a_code)\n      cur = prev\n  actions.reverse()  # actions now go from start to goal\n\n  # Finally, pick up the stick\n  actions.append(USE)\n  return actions", "env_interactions": 0, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:49:49.902350", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n\n  # Action identifiers\n  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act[\"DOWN\"], act[\"UP\"], act[\"LEFT\"], act[\"RIGHT\"], act[\"USE\"]\n  )\n\n  # Index of the primitive \"stick\"\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # Locate all cells containing a stick\n  stick_cells = np.argwhere(state.grid[:, :, stick_idx] > 0)\n  if stick_cells.size == 0:\n      return []\n\n  # Grid dimensions\n  width, height = state.grid.shape[:2]\n\n  # Set of non\u2011grabbable entity indices (obstacles)\n  non_grabbable = world.non_grabbable_indices\n\n  def traversable(pos):\n      \"\"\"Return True if the agent can step on the given position.\"\"\"\n      x, y = pos\n      if not (0 <= x < width and 0 <= y < height):\n          return False\n      for idx in non_grabbable:\n          if state.grid[x, y, idx] > 0:\n              return False\n      return True\n\n  start = tuple(state.pos)\n  target_set = {tuple(cell) for cell in stick_cells}\n\n  # Breadth\u2011first search to the nearest reachable stick\n  queue = collections.deque([start])\n  visited = {start: None}  # maps position -> (prev_position, action_to_here)\n  goal = None\n\n  while queue:\n      cur = queue.popleft()\n      if cur in target_set:\n          goal = cur\n          break\n      x, y = cur\n      for nx, ny, a_code in [(x + 1, y, DOWN), (x - 1, y, UP),\n                             (x, y + 1, RIGHT), (x, y - 1, LEFT)]:\n          nxt = (nx, ny)\n          if nxt not in visited and traversable(nxt):\n              visited[nxt] = (cur, a_code)\n              queue.append(nxt)\n\n  if goal is None:\n      # No reachable stick found\n      return []\n\n  # Reconstruct the action sequence from start to the goal cell\n  actions = []\n  cur = goal\n  while visited[cur] is not None:\n      prev, a_code = visited[cur]\n      actions.append(a_code)\n      cur = prev\n  actions.reverse()  # now actions go from start to goal\n\n  # Finally, use the stick\n  actions.append(USE)\n  return actions", "env_interactions": 0, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:50:13.649684", "function_name": "make_arrow", "function_body": "  # Action indices (as defined in CraftLab.action_specs)\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions from start to goal using\n      horizontal\u2011then\u2011vertical moves (ignores obstacles).\"\"\"\n      x, y = start\n      gx, gy = goal\n      actions = []\n      while x < gx:\n          actions.append(ACTION_RIGHT)\n          x += 1\n      while x > gx:\n          actions.append(ACTION_LEFT)\n          x -= 1\n      while y < gy:\n          actions.append(ACTION_DOWN)\n          y += 1\n      while y > gy:\n          actions.append(ACTION_UP)\n          y -= 1\n      return actions\n\n  def nearest_position(positions, reference):\n      \"\"\"Pick the position from *positions* with smallest Manhattan distance\n      to *reference*.\"\"\"\n      if len(positions) == 0:\n          return None\n      ref = np.array(reference)\n      dists = np.sum(np.abs(positions - ref), axis=1)\n      return tuple(positions[np.argmin(dists)])\n\n  # ------------------------------------------------------------------\n  # Gather current state information\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n\n  # ------------------------------------------------------------------\n  # Identify the goal (stick)\n  # ------------------------------------------------------------------\n  goal_name = \"stick\"\n  try:\n      goal_idx = env.world.cookbook.index[goal_name]\n  except Exception:\n      # Stick not defined in this world\n      return []\n\n  # If we already have a stick in inventory, nothing to do\n  if inventory[goal_idx] > 0:\n      return []\n\n  plan_actions = []\n\n  # ------------------------------------------------------------------\n  # 1) Collect required primitives (if any)\n  # ------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  for prim_idx, needed_cnt in primitives_needed.items():\n      while inventory[prim_idx] < needed_cnt:\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # No more of this primitive on the map; abort planning\n              return plan_actions\n          target = nearest_position(prim_cells, pos)\n\n          # Move to the primitive\n          plan_actions.extend(manhattan_path(pos, target))\n          pos = target\n\n          # Pick it up\n          plan_actions.append(ACTION_USE)\n\n          # Simulate the pickup locally for further planning\n          inventory[prim_idx] += 1\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # ------------------------------------------------------------------\n  # 2) If stick itself is a primitive (no recipe), just pick it up\n  # ------------------------------------------------------------------\n  if goal_idx not in env.world.cookbook.recipes:\n      stick_cells = np.argwhere(grid[:, :, goal_idx] > 0)\n      if stick_cells.size == 0:\n          return plan_actions\n      target = nearest_position(stick_cells, pos)\n      plan_actions.extend(manhattan_path(pos, target))\n      pos = target\n      plan_actions.append(ACTION_USE)\n      return plan_actions\n\n  # ------------------------------------------------------------------\n  # 3) Go to the required workshop and craft the stick\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      try:\n          workshop_idx = env.world.cookbook.index[workshop_name]\n      except Exception:\n          return plan_actions\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          return plan_actions\n      wcell = tuple(workshop_cells[0])\n\n      # Find a free adjacent cell to stand on\n      neighbours = [\n          (wcell[0] + dx, wcell[1] + dy)\n          for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]\n      ]\n      stand_pos = None\n      for nx, ny in neighbours:\n          if (\n              0 <= nx < grid.shape[0]\n              and 0 <= ny < grid.shape[1]\n              and grid[nx, ny, :].sum() == 0\n          ):\n              stand_pos = (nx, ny)\n              break\n      if stand_pos is None:\n          stand_pos = wcell  # fallback: stand directly on the workshop\n\n      # Move to the chosen standing position\n      plan_actions.extend(manhattan_path(pos, stand_pos))\n      pos = stand_pos\n\n      # Use the workshop to craft the stick\n      plan_actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # Return the constructed action list\n  # ------------------------------------------------------------------\n  return plan_actions", "env_interactions": 5, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:50:14.963803", "function_name": "make_arrow", "function_body": "  # Action indices as defined in CraftLab.action_specs\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions from start to goal using\n      horizontal\u2011then\u2011vertical moves (ignores obstacles).\"\"\"\n      x, y = start\n      gx, gy = goal\n      actions = []\n      while x < gx:\n          actions.append(ACTION_RIGHT)\n          x += 1\n      while x > gx:\n          actions.append(ACTION_LEFT)\n          x -= 1\n      while y < gy:\n          actions.append(ACTION_DOWN)\n          y += 1\n      while y > gy:\n          actions.append(ACTION_UP)\n          y -= 1\n      return actions\n\n  def nearest_position(positions, reference):\n      \"\"\"Pick the position from *positions* with smallest Manhattan distance\n      to *reference*.\"\"\"\n      if len(positions) == 0:\n          return None\n      ref = np.array(reference)\n      dists = np.sum(np.abs(positions - ref), axis=1)\n      return tuple(positions[np.argmin(dists)])\n\n  # ------------------------------------------------------------------\n  # Gather current state information\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n\n  # ------------------------------------------------------------------\n  # Identify the goal (stick)\n  # ------------------------------------------------------------------\n  goal_name = \"stick\"\n  try:\n      goal_idx = env.world.cookbook.index[goal_name]\n  except Exception:\n      # Goal not present in the world \u2013 nothing to do\n      return []\n\n  # If we already have a stick in inventory, no actions are needed\n  if inventory[goal_idx] > 0:\n      return []\n\n  plan_actions = []\n\n  # ------------------------------------------------------------------\n  # 1) Collect needed primitive resources (if any)\n  # ------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  for prim_idx, needed_cnt in primitives_needed.items():\n      while inventory[prim_idx] < needed_cnt:\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # No more of this primitive on the map \u2013 abort planning\n              return plan_actions\n          target = nearest_position(prim_cells, pos)\n\n          # Move to the primitive\n          plan_actions.extend(manhattan_path(pos, target))\n          pos = target\n\n          # Pick it up\n          plan_actions.append(ACTION_USE)\n\n          # Simulate the pickup locally for further planning\n          inventory[prim_idx] += 1\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # ------------------------------------------------------------------\n  # 2) If the stick itself is a primitive (no recipe), just pick it up\n  # ------------------------------------------------------------------\n  if goal_idx not in env.world.cookbook.recipes:\n      stick_cells = np.argwhere(grid[:, :, goal_idx] > 0)\n      if stick_cells.size == 0:\n          return plan_actions\n      target = nearest_position(stick_cells, pos)\n      plan_actions.extend(manhattan_path(pos, target))\n      pos = target\n      plan_actions.append(ACTION_USE)\n      return plan_actions\n\n  # ------------------------------------------------------------------\n  # 3) Go to the required workshop and craft the stick\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      try:\n          workshop_idx = env.world.cookbook.index[workshop_name]\n      except Exception:\n          return plan_actions\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          return plan_actions\n      wcell = tuple(workshop_cells[0])\n\n      # Find a free adjacent cell to stand on\n      neighbours = [\n          (wcell[0] + dx, wcell[1] + dy)\n          for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]\n      ]\n      stand_pos = None\n      for nx, ny in neighbours:\n          if (\n              0 <= nx < grid.shape[0]\n              and 0 <= ny < grid.shape[1]\n              and grid[nx, ny, :].sum() == 0\n          ):\n              stand_pos = (nx, ny)\n              break\n      if stand_pos is None:\n          stand_pos = wcell  # fallback: stand directly on the workshop\n\n      # Move to the chosen standing position\n      plan_actions.extend(manhattan_path(pos, stand_pos))\n      pos = stand_pos\n\n      # Use the workshop to craft the stick\n      plan_actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # Return the constructed action list\n  # ------------------------------------------------------------------\n  return plan_actions", "env_interactions": 5, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:50:37.857369", "function_name": "make_arrow", "function_body": "  # Helper: BFS shortest path avoiding non\u2011grabbable obstacles\n  def _bfs_path(start, goal, blocked):\n      from collections import deque\n\n      act_map = env.action_specs()\n      dirs = [\n          (0, 1, act_map[\"DOWN\"]),\n          (0, -1, act_map[\"UP\"]),\n          (-1, 0, act_map[\"LEFT\"]),\n          (1, 0, act_map[\"RIGHT\"]),\n      ]\n\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for dx, dy, a in dirs:\n              nx, ny = x + dx, y + dy\n              if (\n                  0 <= nx < blocked.shape[0]\n                  and 0 <= ny < blocked.shape[1]\n                  and not blocked[nx, ny]\n                  and (nx, ny) not in visited\n              ):\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [a]))\n      return None  # unreachable\n\n  # ------------------------------------------------------------------\n  # Main logic\n  # ------------------------------------------------------------------\n  state = env._current_state\n  world = env.world\n  grid = state.grid.copy()          # copy for planning (we will modify it)\n\n  # index of the target item \"stick\"\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # primitive requirements for a stick (empty dict if stick is primitive)\n  prim_req = world.cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n\n  # blocked cells = any non\u2011grabbable entity present\n  blocked = np.zeros(grid.shape[:2], dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  actions_plan = []\n  cur_pos = tuple(state.pos)\n\n  # ------------------------------------------------------------------\n  # Case 1: stick is already a primitive placed in the world\n  # ------------------------------------------------------------------\n  if not prim_req:\n      stick_cells = np.argwhere(grid[:, :, stick_idx] > 0)\n      if stick_cells.size == 0:\n          return []                       # nothing to do / cannot find stick\n      target = tuple(stick_cells[0])\n      if cur_pos != target:\n          path = _bfs_path(cur_pos, target, blocked)\n          if path is None:\n              return []                   # unreachable\n          actions_plan.extend(path)\n      actions_plan.append(env.action_specs()[\"USE\"])\n      return actions_plan\n\n  # ------------------------------------------------------------------\n  # Case 2: need to collect required primitives first\n  # ------------------------------------------------------------------\n  needed = dict(prim_req)               # mutable copy of requirements\n\n  while any(cnt > 0 for cnt in needed.values()):\n      best_path = None\n      best_target = None\n      best_prim = None\n\n      # search all needed primitives for the closest reachable instance\n      for prim_idx, cnt in needed.items():\n          if cnt <= 0:\n              continue\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          for cell in prim_cells:\n              target = tuple(cell)\n              path = _bfs_path(cur_pos, target, blocked)\n              if path is None:\n                  continue\n              if best_path is None or len(path) < len(best_path):\n                  best_path = path\n                  best_target = target\n                  best_prim = prim_idx\n\n      if best_path is None:\n          return []                       # cannot reach any remaining primitive\n\n      # move to the primitive and pick it up\n      actions_plan.extend(best_path)\n      actions_plan.append(env.action_specs()[\"USE\"])\n\n      # update planning state\n      cur_pos = best_target\n      needed[best_prim] -= 1\n      grid[best_target[0], best_target[1], best_prim] = 0   # remove collected item\n\n  # ------------------------------------------------------------------\n  # Case 3: go to the workshop (if recipe specifies one)\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          target = tuple(workshop_cells[0])\n          if cur_pos != target:\n              path = _bfs_path(cur_pos, target, blocked)\n              if path is None:\n                  return []               # cannot reach workshop\n              actions_plan.extend(path)\n              cur_pos = target\n\n  # ------------------------------------------------------------------\n  # Finally, craft the stick (USE action)\n  # ------------------------------------------------------------------\n  actions_plan.append(env.action_specs()[\"USE\"])\n  return actions_plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:50:39.154931", "function_name": "make_arrow", "function_body": "  # Helper: BFS shortest path avoiding non\u2011grabbable cells\n  def _bfs_path(start, goal, blocked):\n      from collections import deque\n\n      act_map = env.action_specs()\n      dirs = [\n          (0, 1, act_map[\"DOWN\"]),\n          (0, -1, act_map[\"UP\"]),\n          (-1, 0, act_map[\"LEFT\"]),\n          (1, 0, act_map[\"RIGHT\"]),\n      ]\n\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for dx, dy, a in dirs:\n              nx, ny = x + dx, y + dy\n              if (\n                  0 <= nx < blocked.shape[0]\n                  and 0 <= ny < blocked.shape[1]\n                  and not blocked[nx, ny]\n                  and (nx, ny) not in visited\n              ):\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [a]))\n      return None  # unreachable\n\n  # ---- main logic ----------------------------------------------------\n  state = env._current_state\n  world = env.world\n  grid = state.grid\n\n  # index of the target item \"stick\"\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # primitive requirements for a stick (empty if stick is primitive)\n  prim_req = world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n\n  # mask of cells we cannot walk through (non\u2011grabbable entities)\n  blocked = np.zeros(grid.shape[:2], dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  actions_plan = []\n  cur_pos = tuple(state.pos)\n\n  # ---- case 1: stick is already a primitive placed in the world ----\n  if not prim_req:\n      stick_cells = np.argwhere(grid[:, :, stick_idx] > 0)\n      if stick_cells.size == 0:\n          return []  # nothing to do / cannot find stick\n      target = tuple(stick_cells[0])\n      if cur_pos != target:\n          path = _bfs_path(cur_pos, target, blocked)\n          if path is None:\n              return []  # unreachable\n          actions_plan.extend(path)\n      actions_plan.append(env.action_specs()[\"USE\"])\n      return actions_plan\n\n  # ---- case 2: need to collect primitives first -------------------\n  needed = dict(prim_req)  # copy so we can decrement\n\n  while any(cnt > 0 for cnt in needed.values()):\n      best_path = None\n      best_target = None\n      best_prim = None\n\n      for prim_idx, cnt in needed.items():\n          if cnt <= 0:\n              continue\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          for cell in prim_cells:\n              target = tuple(cell)\n              path = _bfs_path(cur_pos, target, blocked)\n              if path is None:\n                  continue\n              if best_path is None or len(path) < len(best_path):\n                  best_path = path\n                  best_target = target\n                  best_prim = prim_idx\n\n      if best_path is None:\n          # cannot reach any remaining required primitive\n          return []\n\n      # move to the primitive and pick it up\n      actions_plan.extend(best_path)\n      actions_plan.append(env.action_specs()[\"USE\"])\n\n      # update planning state\n      cur_pos = best_target\n      needed[best_prim] -= 1\n      # pretend the primitive disappears from the grid\n      grid[best_target[0], best_target[1], best_prim] = 0\n\n  # ---- case 3: go to the required workshop (if any) ---------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          target = tuple(workshop_cells[0])\n          if cur_pos != target:\n              path = _bfs_path(cur_pos, target, blocked)\n              if path is None:\n                  return []  # cannot reach workshop\n              actions_plan.extend(path)\n              cur_pos = target\n\n  # final crafting action\n  actions_plan.append(env.action_specs()[\"USE\"])\n  return actions_plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:51:02.509679", "function_name": "make_arrow", "function_body": "  # Mapping from action indices to (dy, dx) movement vectors.\n  _ACTION_DELTAS = {\n      0: (1, 0),   # DOWN\n      1: (-1, 0),  # UP\n      2: (0, -1),  # LEFT\n      3: (0, 1),   # RIGHT\n  }\n\n  def _move_actions(start, goal):\n      \"\"\"Return a list of actions (DOWN/UP/LEFT/RIGHT) that move from\n      start (row, col) to goal (row, col) using Manhattan routing.\"\"\"\n      y, x = start\n      gy, gx = goal\n      acts = []\n      while y < gy:\n          acts.append(0)   # DOWN\n          y += 1\n      while y > gy:\n          acts.append(1)   # UP\n          y -= 1\n      while x < gx:\n          acts.append(3)   # RIGHT\n          x += 1\n      while x > gx:\n          acts.append(2)   # LEFT\n          x -= 1\n      return acts\n\n  # ------------------------------------------------------------------\n  # Locate the CraftWorld instance inside the supplied env\n  # ------------------------------------------------------------------\n  if hasattr(env, \"world\"):\n      world = env.world\n  elif hasattr(env, \"scenario\"):\n      world = env.scenario.world\n  else:\n      raise AttributeError(\"Cannot locate CraftWorld instance inside env.\")\n\n  # ------------------------------------------------------------------\n  # Identify the goal (stick) and its recipe\n  # ------------------------------------------------------------------\n  goal_name = \"stick\"\n  goal_idx = world.cookbook.index.index(goal_name)\n\n  # Primitives required to craft a stick (may be empty if stick is primitive)\n  needed = world.cookbook.primitives_for(goal_idx)\n\n  # ------------------------------------------------------------------\n  # Obtain the current state for planning (position + grid)\n  # ------------------------------------------------------------------\n  if hasattr(env, \"_current_state\"):\n      state = env._current_state\n  else:\n      state = env.scenario.init()\n\n  cur_pos = tuple(state.pos)          # (row, col)\n  grid = state.grid.copy()            # (H, W, n_kinds)\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the necessary number of times\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          # Find any cell that currently holds this primitive\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(\n                  f\"Primitive '{world.cookbook.index.get(prim_idx)}' not found on the grid.\"\n              )\n          py, px = prim_cells[0]\n\n          # Find an empty neighbour cell from which we can face the primitive\n          target_cell = None\n          for dy, dx in _ACTION_DELTAS.values():\n              ny, nx = py - dy, px - dx\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  if not grid[ny, nx, :].any():          # empty\n                      target_cell = (ny, nx)\n                      break\n          if target_cell is None:\n              raise RuntimeError(\"No reachable empty neighbour around required primitive.\")\n\n          # Move to that neighbour\n          actions.extend(_move_actions(cur_pos, target_cell))\n          cur_pos = target_cell\n\n          # Use (collect) the primitive\n          actions.append(4)   # USE\n\n          # Update planning grid \u2013 primitive has been taken\n          grid[py, px, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if recipe specifies one) and craft the stick\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_cells.size == 0:\n          raise RuntimeError(f\"Workshop '{workshop_name}' not found on the grid.\")\n      wy, wx = ws_cells[0]\n\n      # Find an empty neighbour to face the workshop\n      target_cell = None\n      for dy, dx in _ACTION_DELTAS.values():\n          ny, nx = wy - dy, wx - dx\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not grid[ny, nx, :].any():\n                  target_cell = (ny, nx)\n                  break\n      if target_cell is None:\n          raise RuntimeError(\"No reachable empty neighbour around workshop.\")\n\n      actions.extend(_move_actions(cur_pos, target_cell))\n      cur_pos = target_cell\n\n  # Final USE to craft the stick (whether we moved to a workshop or not)\n  actions.append(4)   # USE\n\n  return actions", "env_interactions": 5, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T03:51:03.777194", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # Mapping from action index to (dy, dx) movement.\n  _ACTION_DELTAS = {\n      0: (1, 0),   # DOWN\n      1: (-1, 0),  # UP\n      2: (0, -1),  # LEFT\n      3: (0, 1),   # RIGHT\n  }\n\n  def _move_actions(start, goal):\n      \"\"\"Return a list of actions that moves from start to goal using Manhattan moves.\"\"\"\n      y, x = start\n      gy, gx = goal\n      acts = []\n      while y < gy:\n          acts.append(0)   # DOWN\n          y += 1\n      while y > gy:\n          acts.append(1)   # UP\n          y -= 1\n      while x < gx:\n          acts.append(3)   # RIGHT\n          x += 1\n      while x > gx:\n          acts.append(2)   # LEFT\n          x -= 1\n      return acts\n\n  # ------------------------------------------------------------------\n  # Locate the CraftWorld instance inside the supplied env\n  # ------------------------------------------------------------------\n  if hasattr(env, \"world\"):\n      world = env.world\n  elif hasattr(env, \"scenario\"):\n      world = env.scenario.world\n  else:\n      raise AttributeError(\"Cannot find CraftWorld instance in env.\")\n\n  # ------------------------------------------------------------------\n  # Identify the goal (stick) and its recipe\n  # ------------------------------------------------------------------\n  goal_name = \"stick\"\n  goal_idx = world.cookbook.index.index(goal_name)\n\n  # Primitives required to craft the stick (may be empty if stick is primitive)\n  needed = world.cookbook.primitives_for(goal_idx)\n\n  # ------------------------------------------------------------------\n  # Obtain current state for planning (position + grid)\n  # ------------------------------------------------------------------\n  if hasattr(env, \"_current_state\"):\n      state = env._current_state\n  else:\n      state = env.scenario.init()\n\n  cur_pos = tuple(state.pos)          # (row, col)\n  grid = state.grid.copy()            # (H, W, n_kinds)\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the required number of times\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(\n                  f\"Primitive '{world.cookbook.index.get(prim_idx)}' not found on the grid.\"\n              )\n          py, px = prim_cells[0]\n\n          # Find an empty neighbour cell from which we can face the primitive\n          target_cell = None\n          for d, (dy, dx) in _ACTION_DELTAS.items():\n              ny, nx = py - dy, px - dx\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  if not grid[ny, nx, :].any():          # empty\n                      target_cell = (ny, nx)\n                      break\n          if target_cell is None:\n              raise RuntimeError(\"No reachable empty neighbour around required primitive.\")\n\n          # Move to that neighbour\n          actions.extend(_move_actions(cur_pos, target_cell))\n          cur_pos = target_cell\n\n          # Use (collect) the primitive\n          actions.append(4)   # USE\n\n          # Update planning grid \u2013 primitive has been taken\n          grid[py, px, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if recipe specifies one) and craft the stick\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_cells.size == 0:\n          raise RuntimeError(f\"Workshop '{workshop_name}' not found on the grid.\")\n      wy, wx = ws_cells[0]\n\n      # Find an empty neighbour to face the workshop\n      target_cell = None\n      for d, (dy, dx) in _ACTION_DELTAS.items():\n          ny, nx = wy - dy, wx - dx\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not grid[ny, nx, :].any():\n                  target_cell = (ny, nx)\n                  break\n      if target_cell is None:\n          raise RuntimeError(\"No reachable empty neighbour around workshop.\")\n\n      actions.extend(_move_actions(cur_pos, target_cell))\n      cur_pos = target_cell\n\n  # Final USE to craft (or simply pick up if no workshop)\n  actions.append(4)   # USE\n\n  return actions", "env_interactions": 5, "island_id": 7, "scores": {"3": 0.0}}
