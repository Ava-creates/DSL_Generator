{"timestamp": "2025-10-23T01:42:32.718687", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  goal_idx = env.task.goal\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # Locate all cells containing a specific kind.\n  def find_positions(kind):\n      locs = np.argwhere(state.grid[:, :, kind] > 0)\n      return [tuple(p) for p in locs]\n\n  # Choose the Manhattan\u2011closest cell of the desired kind.\n  def nearest(pos, kind):\n      positions = find_positions(kind)\n      if not positions:\n          return None\n      return min(positions, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n\n  # Produce a sequence of movement actions (DOWN=0, UP=1, LEFT=2, RIGHT=3)\n  # that moves from src to dst along a simple Manhattan path.\n  def moves_to(src, dst):\n      sx, sy = src\n      dx, dy = dst\n      seq = []\n      while sx < dx:\n          seq.append(0)   # DOWN\n          sx += 1\n      while sx > dx:\n          seq.append(1)   # UP\n          sx -= 1\n      while sy < dy:\n          seq.append(3)   # RIGHT\n          sy += 1\n      while sy > dy:\n          seq.append(2)   # LEFT\n          sy -= 1\n      return seq\n\n  # -----------------------------------------------------------------\n  # 1) If the goal (stick) is a primitive, just go to the nearest\n  #    instance and pick it up.\n  # -----------------------------------------------------------------\n  if not env.world.cookbook.primitives_for(goal_idx):\n      target = nearest(cur_pos, goal_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)   # USE\n      return actions\n\n  # -----------------------------------------------------------------\n  # 2) Collect all required primitive ingredients.\n  # -----------------------------------------------------------------\n  needed_prims = env.world.cookbook.primitives_for(goal_idx)\n  for prim_idx, count in needed_prims.items():\n      for _ in range(count):\n          target = nearest(cur_pos, prim_idx)\n          if target is None:\n              continue  # primitive not found; skip\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n          actions.append(4)   # pick up the primitive\n\n  # -----------------------------------------------------------------\n  # 3) Move to the required workshop (if any) and craft the stick.\n  # -----------------------------------------------------------------\n  workshop_idx = None\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  for key, val in recipe.items():\n      if isinstance(key, str):\n          workshop_idx = val\n          break\n\n  if workshop_idx is not None:\n      target = nearest(cur_pos, workshop_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)   # USE at workshop to craft\n  else:\n      # No explicit workshop; attempt crafting at current location.\n      actions.append(4)\n\n  return actions", "env_interactions": 1, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T01:42:34.014060", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  goal_idx = env.task.goal\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # Helper to locate all cells containing a specific kind (primitive, workshop, etc.).\n  def find_positions(kind):\n      # state.grid shape: (WIDTH, HEIGHT, n_kinds); a cell contains the kind if count > 0.\n      locs = np.argwhere(state.grid[:, :, kind] > 0)\n      return [tuple(p) for p in locs]\n\n  # Choose the Manhattan\u2011closest location of the desired kind.\n  def nearest(pos, kind):\n      positions = find_positions(kind)\n      if not positions:\n          return None\n      return min(positions, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n\n  # Produce a list of movement actions (DOWN=0, UP=1, LEFT=2, RIGHT=3) to travel\n  # from src to dst using a simple Manhattan path.\n  def moves_to(src, dst):\n      sx, sy = src\n      dx, dy = dst\n      seq = []\n      while sx < dx:\n          seq.append(0)   # DOWN\n          sx += 1\n      while sx > dx:\n          seq.append(1)   # UP\n          sx -= 1\n      while sy < dy:\n          seq.append(3)   # RIGHT\n          sy += 1\n      while sy > dy:\n          seq.append(2)   # LEFT\n          sy -= 1\n      return seq\n\n  # -------------------------------------------------------------------------\n  # 1) If the goal is a primitive (no recipe), just go to the nearest instance\n  #    and use the USE action (index 4) to pick it up.\n  # -------------------------------------------------------------------------\n  if not env.world.cookbook.primitives_for(goal_idx):\n      target = nearest(cur_pos, goal_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)   # USE\n      return actions\n\n  # -------------------------------------------------------------------------\n  # 2) Collect all required primitive ingredients for the goal.\n  # -------------------------------------------------------------------------\n  needed_prims = env.world.cookbook.primitives_for(goal_idx)\n  for prim_idx, count in needed_prims.items():\n      for _ in range(count):\n          target = nearest(cur_pos, prim_idx)\n          if target is None:\n              # Primitive not found \u2013 skip this ingredient.\n              continue\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n          actions.append(4)   # PICK UP the primitive\n\n  # -------------------------------------------------------------------------\n  # 3) Move to the required workshop (if any) and craft the item.\n  # -------------------------------------------------------------------------\n  workshop_idx = None\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  for key, val in recipe.items():\n      # In the YAML recipes the workshop is stored under a string key such as\n      # \"_at\" or \"_key\". Detect that and treat its value as the workshop kind index.\n      if isinstance(key, str):\n          workshop_idx = val\n          break\n\n  if workshop_idx is not None:\n      target = nearest(cur_pos, workshop_idx)\n      if target:\n          actions += moves_to(cur_pos, target)\n          cur_pos = target\n      actions.append(4)   # USE to craft at the workshop\n\n  return actions", "env_interactions": 1, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T01:43:06.953408", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  _ACTION_DELTAS = {\n      0: (1, 0),   # DOWN\n      1: (-1, 0),  # UP\n      2: (0, -1),  # LEFT\n      3: (0, 1),   # RIGHT\n  }\n\n  def _move_actions(start, goal):\n      y, x = start\n      gy, gx = goal\n      acts = []\n      while y < gy:\n          acts.append(0)   # DOWN\n          y += 1\n      while y > gy:\n          acts.append(1)   # UP\n          y -= 1\n      while x < gx:\n          acts.append(3)   # RIGHT\n          x += 1\n      while x > gx:\n          acts.append(2)   # LEFT\n          x -= 1\n      return acts\n\n  # ------------------------------------------------------------------\n  # Locate the world instance\n  # ------------------------------------------------------------------\n  if hasattr(env, \"world\"):\n      world = env.world\n  elif hasattr(env, \"scenario\"):\n      world = env.scenario.world\n  else:\n      raise AttributeError(\"Cannot locate CraftWorld instance in the supplied env.\")\n\n  # ------------------------------------------------------------------\n  # Obtain the current state for planning\n  # ------------------------------------------------------------------\n  if hasattr(env, \"_current_state\"):\n      state = env._current_state\n  else:\n      state = env.scenario.init()\n\n  cur_pos = tuple(state.pos)          # (row, col)\n  grid = state.grid.copy()            # (H, W, n_kinds)\n\n  # ------------------------------------------------------------------\n  # Goal information (stick)\n  # ------------------------------------------------------------------\n  goal_name = \"stick\"\n  goal_idx = world.cookbook.index.index(goal_name)\n\n  # Primitives required to craft a stick (empty if stick is a primitive)\n  needed = world.cookbook.primitives_for(goal_idx)\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper to collect a primitive from the grid\n  # ------------------------------------------------------------------\n  def _collect_primitive(p_idx):\n      nonlocal cur_pos, actions, grid\n      cells = np.argwhere(grid[:, :, p_idx] > 0)\n      if cells.size == 0:\n          raise RuntimeError(\n              f\"Primitive '{world.cookbook.index.get(p_idx)}' not found on the grid.\"\n          )\n      py, px = cells[0]\n\n      # Find an empty neighbour to stand on and face the primitive\n      target = None\n      for d, (dy, dx) in _ACTION_DELTAS.items():\n          ny, nx = py - dy, px - dx\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not grid[ny, nx, :].any():\n                  target = (ny, nx)\n                  break\n      if target is None:\n          raise RuntimeError(\"No reachable empty neighbour around required primitive.\")\n\n      # Move to the neighbour cell\n      actions.extend(_move_actions(cur_pos, target))\n      cur_pos = target\n\n      # Use (collect) the primitive\n      actions.append(4)   # USE\n      grid[py, px, p_idx] = 0   # update planning grid\n\n  # ------------------------------------------------------------------\n  # 1. Collect required primitives (if any)\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          _collect_primitive(prim_idx)\n\n  # ------------------------------------------------------------------\n  # 2. If stick itself is a primitive (no recipe), we are done after collecting it\n  # ------------------------------------------------------------------\n  if not needed and goal_idx in world.cookbook.primitives:\n      _collect_primitive(goal_idx)\n      return actions\n\n  # ------------------------------------------------------------------\n  # 3. Craft the stick at its workshop (if a workshop is specified)\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_cells.size == 0:\n          raise RuntimeError(f\"Workshop '{workshop_name}' not found on the grid.\")\n      wy, wx = ws_cells[0]\n\n      # Find an empty neighbour to stand on and face the workshop\n      target = None\n      for d, (dy, dx) in _ACTION_DELTAS.items():\n          ny, nx = wy - dy, wx - dx\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not grid[ny, nx, :].any():\n                  target = (ny, nx)\n                  break\n      if target is None:\n          raise RuntimeError(\"No reachable empty neighbour around workshop.\")\n\n      # Move to that neighbour cell\n      actions.extend(_move_actions(cur_pos, target))\n      cur_pos = target\n\n      # Use (craft) the stick\n      actions.append(4)   # USE\n\n  # ------------------------------------------------------------------\n  # Return the complete action sequence\n  # ------------------------------------------------------------------\n  return actions", "env_interactions": 5, "island_id": 7, "scores": {"3": 0.0}}
