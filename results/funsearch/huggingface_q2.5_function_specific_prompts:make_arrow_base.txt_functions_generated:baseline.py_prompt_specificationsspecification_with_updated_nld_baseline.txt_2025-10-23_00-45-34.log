{"timestamp": "2025-10-23T01:43:44.226542", "function_name": "make_arrow", "function_body": "  # Helper imports (already available in the outer file)\n  # Determine goal index for \"stick\"\n  world = env.world\n  idx = world.cookbook.index\n  try:\n      stick_idx = idx[\"stick\"]\n  except Exception:\n      # fallback: maybe the name is capitalized\n      stick_idx = idx.get(\"Stick\")\n      if stick_idx is None:\n          raise ValueError(\"Stick item not found in cookbook\")\n\n  # Primitive requirements for the stick (may be empty if stick is primitive)\n  needed = world.cookbook.primitives_for(stick_idx)  # dict {kind_idx: count}\n\n  # Action mapping from name to integer used by the environment\n  action_map = env.action_specs()\n  # Expected direction actions (these names exist in the spec)\n  MOVE_NAMES = [\"DOWN\", \"UP\", \"LEFT\", \"RIGHT\"]\n  # Offsets assuming (row, col) coordinates\n  MOVE_OFFSETS = {\n      \"DOWN\": (1, 0),\n      \"UP\": (-1, 0),\n      \"LEFT\": (0, -1),\n      \"RIGHT\": (0, 1),\n  }\n\n  # Mapping from move name to its integer id\n  move_id = {name: action_map[name] for name in MOVE_NAMES}\n  use_id = action_map[\"USE\"]\n\n  # Current simulated state (position, grid)\n  state = env._current_state\n  pos = tuple(state.pos)                     # (row, col)\n  grid = state.grid.copy()                   # (W, H, n_kinds)\n\n  # ----------------------------------------------------------------------\n  # Utility functions\n  # ----------------------------------------------------------------------\n  def cells_of_kind(kind):\n      \"\"\"Return list of (row, col) where the grid contains at least one of kind.\"\"\"\n      rows, cols = np.where(grid[:, :, kind] > 0)\n      return list(zip(rows.tolist(), cols.tolist()))\n\n  def is_blocked(cell):\n      \"\"\"True if any non\u2011grabbable entity occupies the cell.\"\"\"\n      r, c = cell\n      return any(grid[r, c, k] > 0 for k in world.non_grabbable_indices)\n\n  from collections import deque\n\n  def bfs(start, goal_set, blocked_kinds):\n      \"\"\"Bread\u2011first search returning list of move names to reach any cell in goal_set.\"\"\"\n      visited = set()\n      q = deque()\n      q.append((start, []))\n      visited.add(start)\n      while q:\n          cur, path = q.popleft()\n          if cur in goal_set:\n              return path, cur\n          for name, off in MOVE_OFFSETS.items():\n              nr, nc = cur[0] + off[0], cur[1] + off[1]\n              if 0 <= nr < grid.shape[0] and 0 <= nc < grid.shape[1]:\n                  if (nr, nc) not in visited:\n                      # blocked if any of the blocked_kinds are present\n                      if any(grid[nr, nc, k] > 0 for k in blocked_kinds):\n                          continue\n                      visited.add((nr, nc))\n                      q.append(((nr, nc), path + [name]))\n      return None, None\n\n  # ----------------------------------------------------------------------\n  # Collect required primitives\n  # ----------------------------------------------------------------------\n  actions = []\n\n  for kind, count in needed.items():\n      # locate all cells containing this primitive\n      available = cells_of_kind(kind)\n      if not available:\n          raise ValueError(f\"Required primitive kind {kind} not present on the grid\")\n      for _ in range(count):\n          # choose the nearest available cell\n          dists = [abs(pos[0] - r) + abs(pos[1] - c) for (r, c) in available]\n          target = available[np.argmin(dists)]\n\n          # Find a reachable adjacent cell\n          adj_candidates = [\n              (target[0] + dr, target[1] + dc)\n              for dr, dc in MOVE_OFFSETS.values()\n          ]\n          adj_candidates = [\n              p for p in adj_candidates\n              if 0 <= p[0] < grid.shape[0] and 0 <= p[1] < grid.shape[1] and not is_blocked(p)\n          ]\n\n          best_path = None\n          best_adj = None\n          for adj in adj_candidates:\n              path, _ = bfs(pos, {adj}, world.non_grabbable_indices)\n              if path is not None and (best_path is None or len(path) < len(best_path)):\n                  best_path, best_adj = path, adj\n\n          if best_path is None:\n              raise RuntimeError(\"No path to primitive\")\n\n          # Execute moves\n          for move_name in best_path:\n              actions.append(move_id[move_name])\n              off = MOVE_OFFSETS[move_name]\n              pos = (pos[0] + off[0], pos[1] + off[1])\n\n          # Now we are adjacent; use action to pick up\n          actions.append(use_id)\n\n          # Simulate removal of the primitive from the grid for future planning\n          grid[target[0], target[1], kind] = 0\n          available.remove(target)\n\n  # ----------------------------------------------------------------------\n  # If the stick must be crafted at a workshop, go there and USE\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      workshop_cells = cells_of_kind(workshop_kind)\n      if not workshop_cells:\n          raise ValueError(\"Required workshop not found on the grid\")\n      # Pick the first workshop cell (any will do)\n      ws_target = workshop_cells[0]\n\n      # Find reachable adjacent cell to the workshop\n      adj_candidates = [\n          (ws_target[0] + dr, ws_target[1] + dc)\n          for dr, dc in MOVE_OFFSETS.values()\n      ]\n      adj_candidates = [\n          p for p in adj_candidates\n          if 0 <= p[0] < grid.shape[0] and 0 <= p[1] < grid.shape[1] and not is_blocked(p)\n      ]\n\n      best_path = None\n      best_adj = None\n      for adj in adj_candidates:\n          path, _ = bfs(pos, {adj}, world.non_grabbable_indices)\n          if path is not None and (best_path is None or len(path) < len(best_path)):\n              best_path, best_adj = path, adj\n\n      if best_path is None:\n          raise RuntimeError(\"No path to workshop\")\n\n      for move_name in best_path:\n          actions.append(move_id[move_name])\n          off = MOVE_OFFSETS[move_name]\n          pos = (pos[0] + off[0], pos[1] + off[1])\n\n      # Use at the workshop to craft the stick\n      actions.append(use_id)\n\n  return actions", "env_interactions": 0, "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-10-23T01:43:45.514115", "function_name": "make_arrow", "function_body": "  # Access world and recipe index\n  world = env.world\n  # Index for the target item \"stick\"\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # Initial grid and starting position\n  grid = env.scenario.init_grid\n  start_pos = env.scenario.init_pos  # (x, y)\n\n  # Find any cell that contains a stick primitive\n  stick_cells = np.argwhere(grid[:, :, stick_idx] > 0)\n  if len(stick_cells) == 0:\n      # No stick found \u2013 return an empty plan\n      return []\n\n  # Choose the first available stick location\n  target_x, target_y = stick_cells[0]\n\n  # Build a simple Manhattan path from start to the target cell\n  actions = []\n  cur_x, cur_y = start_pos\n\n  # Move horizontally\n  while cur_x < target_x:\n      actions.append(3)  # RIGHT\n      cur_x += 1\n  while cur_x > target_x:\n      actions.append(2)  # LEFT\n      cur_x -= 1\n\n  # Move vertically\n  while cur_y < target_y:\n      actions.append(0)  # DOWN\n      cur_y += 1\n  while cur_y > target_y:\n      actions.append(1)  # UP\n      cur_y -= 1\n\n  # Use the item (collect the stick)\n  actions.append(4)  # USE\n\n  return actions", "env_interactions": 0, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T01:44:06.042113", "function_name": "make_arrow", "function_body": "  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act.get(\"DOWN\", 0),\n      act.get(\"UP\", 1),\n      act.get(\"LEFT\", 2),\n      act.get(\"RIGHT\", 3),\n      act.get(\"USE\", 4),\n  )\n\n  # snapshot of current state\n  state = env._current_state\n  grid = state.grid.copy()                     # (W, H, n_kinds)\n  cur_pos = tuple(state.pos)                   # (x, y)\n\n  # locate the index for \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n      if stick_idx is None:\n          return []   # cannot find stick in index\n\n  # retrieve recipe for stick\n  recipe = env.world.cookbook.primitives_for(stick_idx)   # dict {kind_idx: count}\n  primitive_needs = {k: v for k, v in recipe.items() if isinstance(k, int)}\n  workshop_idx = None\n  for k, v in recipe.items():\n      if not isinstance(k, int):   # non\u2011int key denotes workshop spec\n          workshop_idx = v if isinstance(v, int) else None\n          break\n\n  actions = []\n\n  # helper: find nearest cell containing at least one of kind_idx\n  def find_closest(kind_idx, cur):\n      positions = np.argwhere(grid[:, :, kind_idx] > 0)\n      if positions.shape[0] == 0:\n          return None\n      dists = np.sum(np.abs(positions - np.array(cur)), axis=1)\n      nearest = positions[np.argmin(dists)]\n      return tuple(nearest.tolist())\n\n  # helper: greedy Manhattan path\n  def path_to(cur, target):\n      x, y = cur\n      tx, ty = target\n      path = []\n      while (x, y) != (tx, ty):\n          if x < tx:\n              path.append(RIGHT)\n              x += 1\n          elif x > tx:\n              path.append(LEFT)\n              x -= 1\n          elif y < ty:\n              path.append(DOWN)\n              y += 1\n          elif y > ty:\n              path.append(UP)\n              y -= 1\n      return path, (x, y)\n\n  # collect all required primitives\n  for kind_idx, needed in primitive_needs.items():\n      while needed > 0:\n          target = find_closest(kind_idx, cur_pos)\n          if target is None:\n              return actions    # primitive not available, abort planning\n          move_actions, cur_pos = path_to(cur_pos, target)\n          actions.extend(move_actions)\n          actions.append(USE)    # pick up the primitive\n          # update local grid copy to reflect consumption\n          grid[target[0], target[1], kind_idx] = max(\n              0, grid[target[0], target[1], kind_idx] - 1\n          )\n          needed -= 1\n\n  # if a workshop is required, go there and craft the stick\n  if workshop_idx is not None:\n      ws_target = find_closest(workshop_idx, cur_pos)\n      if ws_target is not None:\n          move_actions, cur_pos = path_to(cur_pos, ws_target)\n          actions.extend(move_actions)\n          actions.append(USE)   # craft at the workshop\n\n  return actions", "env_interactions": 2, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T01:44:07.336123", "function_name": "make_arrow", "function_body": "  # get action indices\n  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act.get(\"DOWN\", 0),\n      act.get(\"UP\", 1),\n      act.get(\"LEFT\", 2),\n      act.get(\"RIGHT\", 3),\n      act.get(\"USE\", 4),\n  )\n\n  # snapshot of current state\n  state = env._current_state\n  grid = state.grid.copy()                     # (W, H, n_kinds)\n  cur_pos = tuple(state.pos)                   # (x, y)\n\n  # find index for \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n      if stick_idx is None:\n          return []   # stick not present in index\n\n  # obtain recipe: primitive requirements and optional workshop\n  recipe = env.world.cookbook.primitives_for(stick_idx)   # dict {kind_idx: count}\n  # split into primitive needs (int keys) and possible workshop spec (non\u2011int key)\n  primitive_needs = {k: v for k, v in recipe.items() if isinstance(k, int)}\n  workshop_idx = None\n  for k, v in recipe.items():\n      if not isinstance(k, int):\n          workshop_idx = v if isinstance(v, int) else None\n          break\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # helper: locate nearest cell that contains at least one of the given kind\n  def find_closest(kind_idx, cur):\n      positions = np.argwhere(grid[:, :, kind_idx] > 0)\n      if positions.shape[0] == 0:\n          return None\n      dists = np.sum(np.abs(positions - np.array(cur)), axis=1)\n      nearest = positions[np.argmin(dists)]\n      return tuple(nearest.tolist())\n\n  # helper: greedy Manhattan path from cur to target (returns actions + final pos)\n  def path_to(cur, target):\n      x, y = cur\n      tx, ty = target\n      path = []\n      while (x, y) != (tx, ty):\n          if x < tx:\n              path.append(RIGHT)\n              x += 1\n          elif x > tx:\n              path.append(LEFT)\n              x -= 1\n          elif y < ty:\n              path.append(DOWN)\n              y += 1\n          elif y > ty:\n              path.append(UP)\n              y -= 1\n      return path, (x, y)\n  # ------------------------------------------------------------------\n\n  # collect each required primitive\n  for kind_idx, needed in primitive_needs.items():\n      while needed > 0:\n          target = find_closest(kind_idx, cur_pos)\n          if target is None:\n              # primitive not present \u2013 abort planning\n              return actions\n          move_actions, cur_pos = path_to(cur_pos, target)\n          actions.extend(move_actions)\n          actions.append(USE)   # pick up primitive\n          # update local grid copy to reflect that we consumed one item\n          grid[target[0], target[1], kind_idx] = max(\n              0, grid[target[0], target[1], kind_idx] - 1\n          )\n          needed -= 1\n\n  # if crafting requires a workshop, go there and use it\n  if workshop_idx is not None:\n      ws_target = find_closest(workshop_idx, cur_pos)\n      if ws_target is not None:\n          move_actions, cur_pos = path_to(cur_pos, ws_target)\n          actions.extend(move_actions)\n          actions.append(USE)   # craft at the workshop\n\n  return actions", "env_interactions": 2, "island_id": 2, "scores": {"3": 0.0}}
