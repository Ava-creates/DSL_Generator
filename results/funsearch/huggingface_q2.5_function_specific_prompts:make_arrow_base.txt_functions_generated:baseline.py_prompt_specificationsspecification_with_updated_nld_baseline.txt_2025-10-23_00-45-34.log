{"timestamp": "2025-10-23T01:35:17.771655", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # ----------------------------------------------------------------------\n  # Helper to move in Manhattan fashion, appending actions to a list.\n  # Action indices: DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n  # ----------------------------------------------------------------------\n  def _move_to(cur, target, seq):\n      x, y = cur\n      tx, ty = target\n      while x < tx:\n          seq.append(3)      # RIGHT\n          x += 1\n      while x > tx:\n          seq.append(2)      # LEFT\n          x -= 1\n      while y < ty:\n          seq.append(0)      # DOWN\n          y += 1\n      while y > ty:\n          seq.append(1)      # UP\n          y -= 1\n      return (x, y)\n\n  # ----------------------------------------------------------------------\n  # 1. Extract current state information\n  # ----------------------------------------------------------------------\n  state = env._current_state               # current CraftState\n  grid = state.grid.copy()                 # (W, H, n_kinds) one\u2011hot grid\n  cur_pos = state.pos                       # (x, y) tuple\n  goal_idx = env.task.goal                 # index of the desired item (stick)\n\n  # ----------------------------------------------------------------------\n  # 2. Look up the recipe for the goal (stick)\n  # ----------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)          # workshop index if needed\n  ingredients = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  # ----------------------------------------------------------------------\n  # 3. Collect all required primitive items\n  # ----------------------------------------------------------------------\n  actions = []\n\n  for ing_kind, count in ingredients.items():\n      for _ in range(count):\n          # find any cell that currently contains the ingredient\n          locs = np.argwhere(grid[:, :, ing_kind] > 0)\n          if locs.size == 0:\n              # ingredient not found \u2013 cannot continue\n              break\n          # choose the closest one (Manhattan distance)\n          dists = np.abs(locs[:, 0] - cur_pos[0]) + np.abs(locs[:, 1] - cur_pos[1])\n          chosen = int(np.argmin(dists))\n          target = tuple(locs[chosen].tolist())\n\n          # move to that location\n          cur_pos = _move_to(cur_pos, target, actions)\n\n          # pick it up\n          actions.append(4)                     # USE\n          # update our copy of the grid so future searches are correct\n          grid[target[0], target[1], ing_kind] = 0\n\n  # ----------------------------------------------------------------------\n  # 4. If a workshop is required, go there and craft the stick\n  # ----------------------------------------------------------------------\n  if workshop_kind is not None:\n      ws_locs = np.argwhere(grid[:, :, workshop_kind] > 0)\n      if ws_locs.size > 0:\n          dists = np.abs(ws_locs[:, 0] - cur_pos[0]) + np.abs(ws_locs[:, 1] - cur_pos[1])\n          chosen = int(np.argmin(dists))\n          workshop_loc = tuple(ws_locs[chosen].tolist())\n\n          # move to the workshop cell\n          cur_pos = _move_to(cur_pos, workshop_loc, actions)\n\n          # craft the stick\n          actions.append(4)                     # USE\n\n  # ----------------------------------------------------------------------\n  # 5. Return the full action sequence\n  # ----------------------------------------------------------------------\n  return actions", "env_interactions": 0, "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T01:35:39.158060", "function_name": "make_arrow", "function_body": "  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act.get(\"DOWN\", 0),\n      act.get(\"UP\", 1),\n      act.get(\"LEFT\", 2),\n      act.get(\"RIGHT\", 3),\n      act.get(\"USE\", 4),\n  )\n\n  # current snapshot of the world\n  state = env._current_state\n  grid = state.grid.copy()                     # (W, H, n_kinds)\n  cur_pos = tuple(state.pos)                   # (x, y)\n\n  # locate the index for \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n      if stick_idx is None:\n          return []   # cannot find stick in index\n\n  # recipe: primitive requirements and optional workshop\n  recipe = env.world.cookbook.primitives_for(stick_idx)   # dict {kind_idx: count}\n  primitive_needs = {k: v for k, v in recipe.items() if isinstance(k, int)}\n  workshop_idx = None\n  for k, v in recipe.items():\n      if not isinstance(k, int):   # non\u2011int key denotes workshop spec\n          workshop_idx = v if isinstance(v, int) else None\n          break\n\n  actions = []\n\n  # helper: find nearest cell containing at least one of kind_idx\n  def find_closest(kind_idx, cur):\n      positions = np.argwhere(grid[:, :, kind_idx] > 0)\n      if positions.shape[0] == 0:\n          return None\n      dists = np.sum(np.abs(positions - np.array(cur)), axis=1)\n      nearest = positions[np.argmin(dists)]\n      return tuple(nearest.tolist())\n\n  # helper: greedy Manhattan path\n  def path_to(cur, target):\n      x, y = cur\n      tx, ty = target\n      path = []\n      while (x, y) != (tx, ty):\n          if x < tx:\n              path.append(RIGHT)\n              x += 1\n          elif x > tx:\n              path.append(LEFT)\n              x -= 1\n          elif y < ty:\n              path.append(DOWN)\n              y += 1\n          elif y > ty:\n              path.append(UP)\n              y -= 1\n      return path, (x, y)\n\n  # collect all required primitives\n  for kind_idx, needed in primitive_needs.items():\n      while needed > 0:\n          target = find_closest(kind_idx, cur_pos)\n          if target is None:\n              return actions    # primitive not available, abort planning\n          move_actions, cur_pos = path_to(cur_pos, target)\n          actions.extend(move_actions)\n          actions.append(USE)    # pick up the primitive\n          # update local grid copy to reflect consumption\n          grid[target[0], target[1], kind_idx] = max(\n              0, grid[target[0], target[1], kind_idx] - 1\n          )\n          needed -= 1\n\n  # if a workshop is required, go there and craft the stick\n  if workshop_idx is not None:\n      ws_target = find_closest(workshop_idx, cur_pos)\n      if ws_target is not None:\n          move_actions, cur_pos = path_to(cur_pos, ws_target)\n          actions.extend(move_actions)\n          actions.append(USE)   # craft at the workshop\n\n  return actions", "env_interactions": 2, "island_id": 2, "scores": {"3": 0.0}}
