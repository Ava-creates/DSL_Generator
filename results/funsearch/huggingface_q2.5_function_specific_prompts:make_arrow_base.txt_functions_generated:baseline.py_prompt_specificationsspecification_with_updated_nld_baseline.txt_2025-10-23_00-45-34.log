{"timestamp": "2025-10-23T04:16:30.504206", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n\n  # Action identifiers\n  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act[\"DOWN\"], act[\"UP\"], act[\"LEFT\"], act[\"RIGHT\"], act[\"USE\"]\n  )\n\n  # Index of the primitive \"stick\"\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # Locate all cells containing a stick\n  stick_cells = np.argwhere(state.grid[:, :, stick_idx] > 0)\n  if stick_cells.size == 0:\n      return []  # no sticks present\n\n  width, height = state.grid.shape[:2]\n  non_grabbable = world.non_grabbable_indices\n\n  def traversable(pos):\n      x, y = pos\n      if not (0 <= x < width and 0 <= y < height):\n          return False\n      for idx in non_grabbable:\n          if state.grid[x, y, idx] > 0:\n              return False\n      return True\n\n  start = tuple(state.pos)\n  target_set = {tuple(cell) for cell in stick_cells}\n\n  # If already on a stick cell, just pick it up\n  if start in target_set:\n      return [USE]\n\n  # BFS to find the nearest reachable stick\n  queue = collections.deque([start])\n  visited = {start: None}  # maps position -> (prev_position, action_to_here)\n  goal = None\n\n  while queue:\n      cur = queue.popleft()\n      if cur in target_set:\n          goal = cur\n          break\n      x, y = cur\n      for nx, ny, a_code in [(x + 1, y, DOWN), (x - 1, y, UP),\n                             (x, y + 1, RIGHT), (x, y - 1, LEFT)]:\n          nxt = (nx, ny)\n          if nxt not in visited and traversable(nxt):\n              visited[nxt] = (cur, a_code)\n              queue.append(nxt)\n\n  if goal is None:\n      return []  # no reachable stick found\n\n  # Reconstruct action sequence from start to goal\n  actions = []\n  cur = goal\n  while visited[cur] is not None:\n      prev, a_code = visited[cur]\n      actions.append(a_code)\n      cur = prev\n  actions.reverse()   # now actions lead from start to goal\n\n  # Pick up the stick\n  actions.append(USE)\n  return actions", "env_interactions": 0, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:16:31.836488", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n\n  # Action identifiers\n  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act[\"DOWN\"], act[\"UP\"], act[\"LEFT\"], act[\"RIGHT\"], act[\"USE\"]\n  )\n\n  # Index of the primitive stick\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # Locate all sticks on the grid\n  stick_cells = np.argwhere(state.grid[:, :, stick_idx] > 0)\n  if stick_cells.size == 0:\n      # No sticks present in the environment\n      return []\n\n  width, height = state.grid.shape[:2]\n  non_grabbable = world.non_grabbable_indices\n\n  def traversable(pos):\n      x, y = pos\n      # Check bounds\n      if not (0 <= x < width and 0 <= y < height):\n          return False\n      # Cell must not contain any non\u2011grabbable entity\n      for idx in non_grabbable:\n          if state.grid[x, y, idx] > 0:\n              return False\n      return True\n\n  start = tuple(state.pos)\n  target_set = {tuple(cell) for cell in stick_cells}\n  from collections import deque\n\n  queue = deque([start])\n  visited = {start: None}  # maps position -> (prev_pos, action_to_here)\n  goal = None\n\n  # Breadth\u2011first search for the nearest reachable stick\n  while queue:\n      cur = queue.popleft()\n      if cur in target_set:\n          goal = cur\n          break\n      x, y = cur\n      for nx, ny, a_code in [(x + 1, y, DOWN), (x - 1, y, UP),\n                             (x, y + 1, RIGHT), (x, y - 1, LEFT)]:\n          nxt = (nx, ny)\n          if nxt not in visited and traversable(nxt):\n              visited[nxt] = (cur, a_code)\n              queue.append(nxt)\n\n  if goal is None:\n      # No reachable stick found\n      return []\n\n  # Reconstruct action sequence from start to goal\n  actions = []\n  cur = goal\n  while visited[cur] is not None:\n      prev, a_code = visited[cur]\n      actions.append(a_code)\n      cur = prev\n  actions.reverse()   # actions now lead from start to goal\n\n  # Pick up the stick\n  actions.append(USE)\n  return actions", "env_interactions": 0, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:17:00.985234", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n\n  # ------------------------------------------------------------------\n  # Action indices\n  # ------------------------------------------------------------------\n  act = env.action_specs()\n  DOWN = act[\"DOWN\"]\n  UP = act[\"UP\"]\n  LEFT = act[\"LEFT\"]\n  RIGHT = act[\"RIGHT\"]\n  USE = act[\"USE\"]\n\n  # ------------------------------------------------------------------\n  # Indices for stick and its recipe\n  # ------------------------------------------------------------------\n  stick_idx = world.cookbook.index[\"stick\"]\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n\n  # If there is no recipe, stick is a primitive \u2013 just go grab it.\n  if not recipe:\n      # locate any stick cell\n      stick_cells = np.argwhere(state.grid[:, :, stick_idx] > 0)\n      if stick_cells.size == 0:\n          return []  # no sticks available\n      # simple Manhattan path (ignoring obstacles)\n      cur = np.array(state.pos)\n      dists = np.abs(stick_cells - cur).sum(axis=1)\n      target = stick_cells[dists.argmin()]\n      dx, dy = int(target[0] - cur[0]), int(target[1] - cur[1])\n      actions = []\n      actions += [DOWN] * max(dx, 0) if dx > 0 else [UP] * max(-dx, 0)\n      actions += [RIGHT] * max(dy, 0) if dy > 0 else [LEFT] * max(-dy, 0)\n      actions.append(USE)\n      return actions\n\n  # ------------------------------------------------------------------\n  # Ingredients and required workshop\n  # ------------------------------------------------------------------\n  workshop_idx = recipe.get(\"_at\")\n  ingredients = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  # ------------------------------------------------------------------\n  # Helper: BFS returning a list of actions to reach a target cell\n  # ------------------------------------------------------------------\n  W, H, _ = state.grid.shape\n  blocked = np.any(state.grid > 0, axis=2)\n\n  start = tuple(state.pos)\n\n  from collections import deque\n\n  def bfs(target, allow_target_blocked=True):\n      \"\"\"Return list of actions to reach `target` from current start.\"\"\"\n      q = deque([start])\n      visited = np.full((W, H), False, dtype=bool)\n      visited[start[0], start[1]] = True\n      prev = np.empty((W, H, 2), dtype=int)\n\n      while q:\n          x, y = q.popleft()\n          if (x, y) == tuple(target):\n              # reconstruct path\n              actions = []\n              cx, cy = x, y\n              while (cx, cy) != start:\n                  px, py = prev[cx, cy]\n                  dx, dy = cx - px, cy - py\n                  if dx == 1:\n                      actions.append(DOWN)\n                  elif dx == -1:\n                      actions.append(UP)\n                  elif dy == 1:\n                      actions.append(RIGHT)\n                  elif dy == -1:\n                      actions.append(LEFT)\n                  cx, cy = px, py\n              actions.reverse()\n              return actions\n\n          for nx, ny, a in [(x + 1, y, DOWN), (x - 1, y, UP),\n                            (x, y + 1, RIGHT), (x, y - 1, LEFT)]:\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  # can step onto the target cell even if blocked\n                  if (nx, ny) == tuple(target) or not blocked[nx, ny]:\n                      visited[nx, ny] = True\n                      prev[nx, ny] = (x, y)\n                      q.append((nx, ny))\n      return None\n\n  # ------------------------------------------------------------------\n  # Collect all required primitives\n  # ------------------------------------------------------------------\n  actions = []\n\n  for ing_idx, count in ingredients.items():\n      # locate all cells containing this ingredient\n      cells = np.argwhere(state.grid[:, :, ing_idx] > 0)\n      if cells.size == 0:\n          # ingredient not present \u2013 cannot solve\n          return []\n      for _ in range(count):\n          # find the nearest reachable cell for this ingredient\n          best_path = None\n          best_cell = None\n          for cell in cells:\n              path = bfs(cell, allow_target_blocked=True)\n              if path is not None and (best_path is None or len(path) < len(best_path)):\n                  best_path = path\n                  best_cell = cell\n          if best_path is None:\n              return []  # unreachable ingredient\n          actions.extend(best_path)\n          actions.append(USE)  # pick up the ingredient\n          # after picking, pretend the cell is now empty for future searches\n          state.grid[best_cell[0], best_cell[1], ing_idx] = 0\n          # update start position for next search\n          start = tuple(best_cell)\n\n  # ------------------------------------------------------------------\n  # Go to the appropriate workshop and craft the stick\n  # ------------------------------------------------------------------\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      return []  # no workshop available\n\n  best_path = None\n  for cell in workshop_cells:\n      path = bfs(cell, allow_target_blocked=True)\n      if path is not None and (best_path is None or len(path) < len(best_path)):\n          best_path = path\n  if best_path is None:\n      return []  # cannot reach workshop\n\n  actions.extend(best_path)\n  actions.append(USE)  # craft stick at the workshop\n\n  return actions", "env_interactions": 0, "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-10-23T04:17:02.229578", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n\n  # action identifiers\n  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act[\"DOWN\"], act[\"UP\"], act[\"LEFT\"], act[\"RIGHT\"], act[\"USE\"]\n  )\n\n  # ----------------------------------------------------------------------\n  # Helper utilities\n  # ----------------------------------------------------------------------\n  def bfs_path(start, target, blocked):\n      \"\"\"Return a list of movement actions from start to target using BFS.\n      `blocked` is a 2\u2011D bool array where True means the cell cannot be entered.\n      The target cell itself may be blocked (e.g., contains the item we want).\"\"\"\n      from collections import deque\n\n      W, H = blocked.shape\n      q = deque([start])\n      visited = np.full((W, H), False, dtype=bool)\n      visited[start[0], start[1]] = True\n      # predecessor to reconstruct path (store previous cell)\n      prev = np.empty((W, H, 2), dtype=int)\n\n      while q:\n          x, y = q.popleft()\n          if (x, y) == target:\n              # reconstruct actions\n              actions = []\n              cx, cy = x, y\n              while (cx, cy) != start:\n                  px, py = prev[cx, cy]\n                  dx, dy = cx - px, cy - py\n                  if dx == 1:\n                      actions.append(DOWN)\n                  elif dx == -1:\n                      actions.append(UP)\n                  elif dy == 1:\n                      actions.append(RIGHT)\n                  elif dy == -1:\n                      actions.append(LEFT)\n                  cx, cy = px, py\n              actions.reverse()\n              return actions\n\n          # explore four neighbours\n          for nx, ny, a in [\n              (x + 1, y, DOWN),\n              (x - 1, y, UP),\n              (x, y + 1, RIGHT),\n              (x, y - 1, LEFT),\n          ]:\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  # allow stepping onto the target even if it is blocked\n                  if (nx, ny) == target or not blocked[nx, ny]:\n                      visited[nx, ny] = True\n                      prev[nx, ny] = (x, y)\n                      q.append((nx, ny))\n      # unreachable\n      return None\n\n  def go_to_kind(kind_idx):\n      \"\"\"Compute actions to move to the nearest cell containing `kind_idx`.\"\"\"\n      # locate all cells with the desired kind\n      cells = np.argwhere(state.grid[:, :, kind_idx] > 0)\n      if cells.size == 0:\n          return None  # nothing to go to\n\n      # blocked cells (any entity present)\n      blocked = np.any(state.grid > 0, axis=2)\n\n      start = tuple(state.pos)\n      best_path = None\n      for cell in cells:\n          target = tuple(cell.tolist())\n          path = bfs_path(start, target, blocked)\n          if path is not None and (best_path is None or len(path) < len(best_path)):\n              best_path = path\n      return best_path\n\n  def collect_primitive(prim_idx):\n      \"\"\"Move to a primitive of type `prim_idx` and pick it up.\"\"\"\n      path = go_to_kind(prim_idx)\n      if path is None:\n          return []  # cannot find / reach the primitive\n      return path + [USE]\n\n  # ----------------------------------------------------------------------\n  # Main logic for making a stick\n  # ----------------------------------------------------------------------\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # If there is no recipe for a stick, it is a primitive \u2013 just collect one.\n  if stick_idx not in world.cookbook.recipes:\n      return collect_primitive(stick_idx)\n\n  # Otherwise we need to gather its primitive ingredients.\n  # `primitives_for` returns a dict {primitive_idx: count}.\n  needed_prims = world.cookbook.primitives_for(stick_idx)\n\n  actions = []\n  for prim_idx, count in needed_prims.items():\n      for _ in range(count):\n          actions += collect_primitive(prim_idx)\n\n  # After having all ingredients, go to the appropriate workshop.\n  recipe = world.cookbook.recipes[stick_idx]\n  workshop_idx = recipe.get(\"_at\")\n  if workshop_idx is not None:\n      workshop_path = go_to_kind(workshop_idx)\n      if workshop_path is not None:\n          actions += workshop_path\n\n  # Finally use the workshop to craft the stick.\n  actions.append(USE)\n\n  return actions", "env_interactions": 0, "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-10-23T04:17:25.417656", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # ------------------------------------------------------------------\n  # Locate the CraftWorld instance inside the provided environment\n  # ------------------------------------------------------------------\n  if hasattr(env, \"world\"):\n      world = env.world\n  elif hasattr(env, \"scenario\"):\n      world = env.scenario.world\n  else:\n      raise AttributeError(\"Cannot locate CraftWorld instance in the supplied env.\")\n\n  # ------------------------------------------------------------------\n  # Obtain a state for planning (grid layout and current position)\n  # ------------------------------------------------------------------\n  if hasattr(env, \"_current_state\"):\n      state = env._current_state\n  else:\n      state = env.scenario.init()\n  cur_pos = tuple(state.pos)                # (row, col)\n  grid = state.grid.copy()                  # (H, W, n_kinds)\n\n  # ------------------------------------------------------------------\n  # Goal definition (stick)\n  # ------------------------------------------------------------------\n  goal_name = \"stick\"\n  goal_idx = world.cookbook.index.index(goal_name)\n\n  # ------------------------------------------------------------------\n  # Movement utilities\n  # ------------------------------------------------------------------\n  _ACTION_DELTAS = {\n      0: (1, 0),   # DOWN\n      1: (-1, 0),  # UP\n      2: (0, -1),  # LEFT\n      3: (0, 1),   # RIGHT\n  }\n\n  def _move_actions(start, target):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) to go\n      from start to target using Manhattan distance.\"\"\"\n      sy, sx = start\n      ty, tx = target\n      acts = []\n      while sy < ty:\n          acts.append(0)   # DOWN\n          sy += 1\n      while sy > ty:\n          acts.append(1)   # UP\n          sy -= 1\n      while sx < tx:\n          acts.append(3)   # RIGHT\n          sx += 1\n      while sx > tx:\n          acts.append(2)   # LEFT\n          sx -= 1\n      return acts\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper: collect a primitive located at (py, px)\n  # ------------------------------------------------------------------\n  def _collect_primitive(p_idx, py, px):\n      \"\"\"Move next to the primitive cell and USE to pick it up.\"\"\"\n      nonlocal cur_pos, actions, grid\n      # Find an empty neighbour from which the agent can face the primitive\n      target = None\n      for dy, dx in _ACTION_DELTAS.values():\n          ny, nx = py - dy, px - dx\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not grid[ny, nx, :].any():\n                  target = (ny, nx)\n                  break\n      if target is None:\n          raise RuntimeError(\"No reachable empty neighbour around required primitive.\")\n      # Move there\n      actions.extend(_move_actions(cur_pos, target))\n      cur_pos = target\n      # Use (collect)\n      actions.append(4)   # USE\n      # Update planning grid\n      grid[py, px, p_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 1. Gather all required primitives (if any)\n  # ------------------------------------------------------------------\n  needed = world.cookbook.primitives_for(goal_idx)   # dict {prim_idx: count}\n  if needed:\n      for prim_idx, cnt in needed.items():\n          for _ in range(cnt):\n              cells = np.argwhere(grid[:, :, prim_idx] > 0)\n              if cells.size == 0:\n                  raise RuntimeError(\n                      f\"Required primitive '{world.cookbook.index.get(prim_idx)}' not found on the grid.\"\n                  )\n              py, px = cells[0]\n              _collect_primitive(prim_idx, py, px)\n\n  # ------------------------------------------------------------------\n  # 2. If stick itself is a primitive (no recipe), just collect it\n  # ------------------------------------------------------------------\n  if not needed and goal_idx in world.cookbook.primitives:\n      stick_cells = np.argwhere(grid[:, :, goal_idx] > 0)\n      if stick_cells.size == 0:\n          raise RuntimeError(\"Stick primitive not found on the grid.\")\n      py, px = stick_cells[0]\n      _collect_primitive(goal_idx, py, px)\n      return actions\n\n  # ------------------------------------------------------------------\n  # 3. Craft the stick at its designated workshop (if any)\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_cells.size == 0:\n          raise RuntimeError(f\"Workshop '{workshop_name}' not found on the grid.\")\n      wy, wx = ws_cells[0]\n\n      # Find an empty neighbour to stand on and face the workshop\n      target = None\n      for dy, dx in _ACTION_DELTAS.values():\n          ny, nx = wy - dy, wx - dx\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not grid[ny, nx, :].any():\n                  target = (ny, nx)\n                  break\n      if target is None:\n          raise RuntimeError(\"No reachable empty neighbour around the workshop.\")\n      # Move there and craft\n      actions.extend(_move_actions(cur_pos, target))\n      cur_pos = target\n      actions.append(4)   # USE to craft\n\n  # ------------------------------------------------------------------\n  # Return the complete action sequence\n  # ------------------------------------------------------------------\n  return actions", "env_interactions": 5, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:17:26.715439", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # ------------------------------------------------------------------\n  # Locate the CraftWorld instance from the environment\n  # ------------------------------------------------------------------\n  if hasattr(env, \"world\"):\n      world = env.world\n  elif hasattr(env, \"scenario\"):\n      world = env.scenario.world\n  else:\n      raise AttributeError(\"Cannot locate CraftWorld instance in the supplied env.\")\n\n  # ------------------------------------------------------------------\n  # Obtain a state for planning (grid layout and current position)\n  # ------------------------------------------------------------------\n  if hasattr(env, \"_current_state\"):\n      state = env._current_state\n  else:\n      state = env.scenario.init()\n  cur_pos = tuple(state.pos)                # (row, col)\n  grid = state.grid.copy()                  # (H, W, n_kinds)\n\n  # ------------------------------------------------------------------\n  # Goal information (stick)\n  # ------------------------------------------------------------------\n  goal_name = \"stick\"\n  goal_idx = world.cookbook.index.index(goal_name)\n\n  # ------------------------------------------------------------------\n  # Helper: Manhattan movement actions\n  # ------------------------------------------------------------------\n  _ACTION_DELTAS = {\n      0: (1, 0),   # DOWN\n      1: (-1, 0),  # UP\n      2: (0, -1),  # LEFT\n      3: (0, 1),   # RIGHT\n  }\n\n  def _move_actions(start, target):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) to go from start to target.\"\"\"\n      sy, sx = start\n      ty, tx = target\n      acts = []\n      while sy < ty:\n          acts.append(0)   # DOWN\n          sy += 1\n      while sy > ty:\n          acts.append(1)   # UP\n          sy -= 1\n      while sx < tx:\n          acts.append(3)   # RIGHT\n          sx += 1\n      while sx > tx:\n          acts.append(2)   # LEFT\n          sx -= 1\n      return acts\n\n  # ------------------------------------------------------------------\n  # Helper: collect a primitive located at (py, px) of kind p_idx\n  # ------------------------------------------------------------------\n  def _collect_primitive(p_idx, py, px):\n      nonlocal cur_pos, actions, grid\n      # Find an empty neighbour cell from which we can face the primitive\n      target = None\n      for dy, dx in _ACTION_DELTAS.values():\n          ny, nx = py - dy, px - dx\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not grid[ny, nx, :].any():\n                  target = (ny, nx)\n                  break\n      if target is None:\n          raise RuntimeError(\"No reachable empty neighbour around required primitive.\")\n      # Move to the neighbour cell\n      actions.extend(_move_actions(cur_pos, target))\n      cur_pos = target\n      # Use (pick up) the primitive\n      actions.append(4)   # USE\n      # Update planning grid\n      grid[py, px, p_idx] = 0\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # 1. Gather required primitives (if any)\n  # ------------------------------------------------------------------\n  needed = world.cookbook.primitives_for(goal_idx)   # dict {prim_idx: count}\n  if needed:\n      for prim_idx, cnt in needed.items():\n          for _ in range(cnt):\n              cells = np.argwhere(grid[:, :, prim_idx] > 0)\n              if cells.size == 0:\n                  raise RuntimeError(\n                      f\"Required primitive '{world.cookbook.index.get(prim_idx)}' not found on the grid.\"\n                  )\n              py, px = cells[0]\n              _collect_primitive(prim_idx, py, px)\n\n  # ------------------------------------------------------------------\n  # 2. If stick itself is a primitive (no recipe), just collect it\n  # ------------------------------------------------------------------\n  if not needed and goal_idx in world.cookbook.primitives:\n      stick_cells = np.argwhere(grid[:, :, goal_idx] > 0)\n      if stick_cells.size == 0:\n          raise RuntimeError(\"Stick primitive not present on the grid.\")\n      py, px = stick_cells[0]\n      _collect_primitive(goal_idx, py, px)\n      return actions\n\n  # ------------------------------------------------------------------\n  # 3. Craft the stick at its workshop (if a workshop is specified)\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_cells.size == 0:\n          raise RuntimeError(f\"Workshop '{workshop_name}' not found on the grid.\")\n      wy, wx = ws_cells[0]\n\n      # Find an empty neighbour to stand on and face the workshop\n      target = None\n      for dy, dx in _ACTION_DELTAS.values():\n          ny, nx = wy - dy, wx - dx\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not grid[ny, nx, :].any():\n                  target = (ny, nx)\n                  break\n      if target is None:\n          raise RuntimeError(\"No reachable empty neighbour around workshop.\")\n\n      # Move to that neighbour cell\n      actions.extend(_move_actions(cur_pos, target))\n      cur_pos = target\n\n      # Use (craft) the stick\n      actions.append(4)   # USE\n\n  # ------------------------------------------------------------------\n  # Return the complete action sequence\n  # ------------------------------------------------------------------\n  return actions", "env_interactions": 5, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:17:48.990808", "function_name": "make_arrow", "function_body": "  # Helper: BFS shortest path avoiding non\u2011grabbable cells\n  def _bfs_path(start, goal, blocked):\n      from collections import deque\n\n      act_map = env.action_specs()\n      dirs = [\n          (0, 1, act_map[\"DOWN\"]),\n          (0, -1, act_map[\"UP\"]),\n          (-1, 0, act_map[\"LEFT\"]),\n          (1, 0, act_map[\"RIGHT\"]),\n      ]\n\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for dx, dy, a in dirs:\n              nx, ny = x + dx, y + dy\n              if (\n                  0 <= nx < blocked.shape[0]\n                  and 0 <= ny < blocked.shape[1]\n                  and not blocked[nx, ny]\n                  and (nx, ny) not in visited\n              ):\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [a]))\n      return None  # unreachable\n\n  # ------------------------------------------------------------------\n  # Main planning\n  # ------------------------------------------------------------------\n  state = env._current_state\n  world = env.world\n  grid = state.grid.copy()                     # planning copy\n\n  # Index of the item we need to make\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # Primitive requirements for a stick (empty dict if primitive)\n  prim_req = world.cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n\n  # Cells that cannot be traversed (non\u2011grabbable entities)\n  blocked = np.zeros(grid.shape[:2], dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # ------------------------------------------------------------------\n  # Case A: stick is already a primitive placed in the world\n  # ------------------------------------------------------------------\n  if not prim_req:\n      stick_cells = np.argwhere(grid[:, :, stick_idx] > 0)\n      if stick_cells.size == 0:\n          return []                               # no stick to pick up\n      target = tuple(stick_cells[0])\n      if cur_pos != target:\n          path = _bfs_path(cur_pos, target, blocked)\n          if path is None:\n              return []                           # unreachable\n          actions.extend(path)\n      actions.append(env.action_specs()[\"USE\"])\n      return actions\n\n  # ------------------------------------------------------------------\n  # Case B: collect required primitives\n  # ------------------------------------------------------------------\n  needed = dict(prim_req)                       # mutable copy\n\n  while any(cnt > 0 for cnt in needed.values()):\n      best_path = None\n      best_target = None\n      best_prim = None\n\n      # Find nearest reachable cell of any still\u2011needed primitive\n      for prim_idx, cnt in needed.items():\n          if cnt <= 0:\n              continue\n          cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          for cell in cells:\n              target = tuple(cell)\n              path = _bfs_path(cur_pos, target, blocked)\n              if path is None:\n                  continue\n              if best_path is None or len(path) < len(best_path):\n                  best_path = path\n                  best_target = target\n                  best_prim = prim_idx\n\n      if best_path is None:\n          return []                               # cannot reach remaining primitives\n\n      # Move to the primitive and pick it up\n      actions.extend(best_path)\n      actions.append(env.action_specs()[\"USE\"])\n\n      # Update planning state\n      cur_pos = best_target\n      needed[best_prim] -= 1\n      grid[best_target[0], best_target[1], best_prim] = 0   # remove from copy\n\n  # ------------------------------------------------------------------\n  # Case C: go to the workshop required by the recipe (if any)\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          target = tuple(workshop_cells[0])\n          if cur_pos != target:\n              path = _bfs_path(cur_pos, target, blocked)\n              if path is None:\n                  return []                       # cannot reach workshop\n              actions.extend(path)\n              cur_pos = target\n\n  # ------------------------------------------------------------------\n  # Finally, craft the stick\n  # ------------------------------------------------------------------\n  actions.append(env.action_specs()[\"USE\"])\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:17:50.247910", "function_name": "make_arrow", "function_body": "  def _bfs_path(start, goal, blocked):\n      from collections import deque\n\n      act_map = env.action_specs()\n      directions = [\n          (0, 1, act_map[\"DOWN\"]),\n          (0, -1, act_map[\"UP\"]),\n          (-1, 0, act_map[\"LEFT\"]),\n          (1, 0, act_map[\"RIGHT\"]),\n      ]\n\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for dx, dy, a in directions:\n              nx, ny = x + dx, y + dy\n              if (\n                  0 <= nx < blocked.shape[0]\n                  and 0 <= ny < blocked.shape[1]\n                  and not blocked[nx, ny]\n                  and (nx, ny) not in visited\n              ):\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [a]))\n      return None  # unreachable\n\n  # ------------------------------------------------------------------\n  # Main planning logic\n  # ------------------------------------------------------------------\n  state = env._current_state\n  world = env.world\n  grid = state.grid.copy()                # work on a copy for planning\n\n  # Index of the target item \"stick\"\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # Primitive requirements for a stick (empty dict if stick is primitive)\n  prim_req = world.cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n\n  # Build mask of cells that cannot be traversed (non\u2011grabbable entities)\n  blocked = np.zeros(grid.shape[:2], dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # ------------------------------------------------------------------\n  # Case 1: stick is a primitive already placed in the world\n  # ------------------------------------------------------------------\n  if not prim_req:\n      stick_cells = np.argwhere(grid[:, :, stick_idx] > 0)\n      if stick_cells.size == 0:\n          return []                         # cannot find a stick\n      target = tuple(stick_cells[0])\n      if cur_pos != target:\n          path = _bfs_path(cur_pos, target, blocked)\n          if path is None:\n              return []                     # unreachable\n          actions.extend(path)\n      actions.append(env.action_specs()[\"USE\"])\n      return actions\n\n  # ------------------------------------------------------------------\n  # Case 2: collect required primitives\n  # ------------------------------------------------------------------\n  needed = dict(prim_req)                 # mutable copy of required counts\n\n  while any(cnt > 0 for cnt in needed.values()):\n      best_path = None\n      best_target = None\n      best_prim = None\n\n      # Search for the nearest reachable cell of any needed primitive\n      for prim_idx, cnt in needed.items():\n          if cnt <= 0:\n              continue\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          for cell in prim_cells:\n              target = tuple(cell)\n              path = _bfs_path(cur_pos, target, blocked)\n              if path is None:\n                  continue\n              if best_path is None or len(path) < len(best_path):\n                  best_path = path\n                  best_target = target\n                  best_prim = prim_idx\n\n      if best_path is None:\n          # No remaining required primitive is reachable\n          return []\n\n      # Move to the primitive and pick it up\n      actions.extend(best_path)\n      actions.append(env.action_specs()[\"USE\"])\n\n      # Update planning state\n      cur_pos = best_target\n      needed[best_prim] -= 1\n      grid[best_target[0], best_target[1], best_prim] = 0   # remove from copy\n\n  # ------------------------------------------------------------------\n  # Case 3: go to the required workshop (if any)\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          target = tuple(workshop_cells[0])\n          if cur_pos != target:\n              path = _bfs_path(cur_pos, target, blocked)\n              if path is None:\n                  return []                     # cannot reach workshop\n              actions.extend(path)\n              cur_pos = target\n\n  # ------------------------------------------------------------------\n  # Finally, craft the stick\n  # ------------------------------------------------------------------\n  actions.append(env.action_specs()[\"USE\"])\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T04:18:08.151000", "function_name": "make_arrow", "function_body": "  actions = []\n  # current state and world information\n  state = env._current_state\n  grid = state.grid\n  world = env.world\n  cb = world.cookbook\n\n  # index of the target item \"stick\"\n  try:\n      goal_idx = cb.index[\"stick\"]\n  except Exception:\n      return actions\n\n  # primitives required to craft a stick (empty if stick is a primitive)\n  required = cb.primitives_for(goal_idx)\n\n  # mutable copy of agent position\n  pos = list(state.pos)\n\n  # helper to move Manhattan\u2011wise to a target cell\n  def _move_to(target):\n      nonlocal pos, actions\n      tx, ty = target\n      while pos[0] < tx:\n          actions.append(3)   # RIGHT\n          pos[0] += 1\n      while pos[0] > tx:\n          actions.append(2)   # LEFT\n          pos[0] -= 1\n      while pos[1] < ty:\n          actions.append(0)   # DOWN\n          pos[1] += 1\n      while pos[1] > ty:\n          actions.append(1)   # UP\n          pos[1] -= 1\n\n  # If no primitives are needed, just pick up the stick (if present)\n  if not required:\n      locations = np.argwhere(grid[:, :, goal_idx] > 0)\n      if locations.size:\n          _move_to(locations[0].tolist())\n          actions.append(4)   # USE to pick up the stick\n      return actions\n\n  # Collect each required primitive\n  for prim_idx, count in required.items():\n      prim_locs = np.argwhere(grid[:, :, prim_idx] > 0)\n      if prim_locs.size == 0:\n          continue  # primitive missing; cannot collect\n      target = prim_locs[0].tolist()\n      _move_to(target)\n      for _ in range(count):\n          actions.append(4)   # USE to pick up one unit\n\n  # If the recipe specifies a workshop, move there and craft\n  recipe = cb.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = cb.index[workshop_name]\n      w_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if w_locs.size:\n          _move_to(w_locs[0].tolist())\n          actions.append(4)   # USE to craft at the workshop\n\n  return actions", "env_interactions": 4, "island_id": 1, "scores": {"3": 0.0}}
