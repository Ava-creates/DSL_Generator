{"timestamp": "2025-10-23T00:52:15.340993", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # Helper to translate direction index to movement vector\n  DIR_VECTORS = {\n      0: (0, 1),   # DOWN\n      1: (0, -1),  # UP\n      2: (-1, 0),  # LEFT\n      3: (1, 0),   # RIGHT\n  }\n\n  # Action constants (must match CraftLab.action_specs)\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  state = env._current_state\n  grid = state.grid\n  pos = list(state.pos)          # mutable copy [x, y]\n  direction = state.dir          # current facing direction\n  actions = []\n\n  # Index mapping from names to integer IDs\n  idx = env.world.cookbook.index\n\n  # ------------------------------------------------------------------\n  # Utility functions\n  # ------------------------------------------------------------------\n  def is_blocked(x, y):\n      \"\"\"Return True if the cell (x, y) is occupied by any entity.\"\"\"\n      if x < 0 or x >= grid.shape[0] or y < 0 or y >= grid.shape[1]:\n          return True\n      return grid[x, y].sum() > 0\n\n  def move_step(dx, dy):\n      \"\"\"Append a movement action that changes pos by (dx, dy).\"\"\"\n      nonlocal pos, direction\n      if dx == 1 and dy == 0:\n          actions.append(ACTION_RIGHT)\n          direction = ACTION_RIGHT\n      elif dx == -1 and dy == 0:\n          actions.append(ACTION_LEFT)\n          direction = ACTION_LEFT\n      elif dx == 0 and dy == 1:\n          actions.append(ACTION_DOWN)\n          direction = ACTION_DOWN\n      elif dx == 0 and dy == -1:\n          actions.append(ACTION_UP)\n          direction = ACTION_UP\n      else:\n          raise ValueError(\"Invalid move step\")\n      pos[0] += dx\n      pos[1] += dy\n\n  def go_to(target):\n      \"\"\"Move (Manhattan) from current pos to target (x, y).\"\"\"\n      while pos[0] < target[0]:\n          move_step(1, 0)\n      while pos[0] > target[0]:\n          move_step(-1, 0)\n      while pos[1] < target[1]:\n          move_step(0, 1)\n      while pos[1] > target[1]:\n          move_step(0, -1)\n\n  def adjacent_position(item_x, item_y):\n      \"\"\"Return a free adjacent cell (x, y) and the direction needed to face the item.\"\"\"\n      # order: left, right, up, down (any will do)\n      candidates = [(-1, 0, ACTION_RIGHT), (1, 0, ACTION_LEFT),\n                    (0, -1, ACTION_DOWN), (0, 1, ACTION_UP)]\n      for dx, dy, face_dir in candidates:\n          ax, ay = item_x + dx, item_y + dy\n          if 0 <= ax < grid.shape[0] and 0 <= ay < grid.shape[1] and not is_blocked(ax, ay):\n              return (ax, ay), face_dir\n      # fallback: stay where we are (should not happen in well\u2011formed maps)\n      return (pos[0], pos[1]), direction\n\n  # ------------------------------------------------------------------\n  # Determine what we need to collect / craft for a stick\n  # ------------------------------------------------------------------\n  stick_name = \"stick\"\n  if stick_name not in idx:\n      raise ValueError(f\"'{stick_name}' not found in world index\")\n  stick_idx = idx[stick_name]\n\n  # Retrieve recipe (if any)\n  recipe = env.world.cookbook.recipes.get(stick_idx, None)\n\n  # If there is a recipe, we need its ingredients; otherwise stick is primitive.\n  ingredients = {}\n  workshop_name = None\n  if recipe:\n      for k, v in recipe.items():\n          if k == \"_at\":\n              workshop_name = v\n          else:\n              ingredients[k] = v\n  else:\n      # primitive: just need to pick up one stick\n      ingredients[stick_idx] = 1\n\n  # ------------------------------------------------------------------\n  # Collect required primitives\n  # ------------------------------------------------------------------\n  for ing_idx, count in ingredients.items():\n      for _ in range(count):\n          # locate any cell containing this ingredient\n          locations = np.argwhere(grid[:, :, ing_idx] > 0)\n          if locations.size == 0:\n              raise RuntimeError(f\"Cannot find required ingredient {ing_idx}\")\n          # pick the nearest location (Manhattan)\n          dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n          nearest = locations[dists.argmin()]\n          ix, iy = int(nearest[0]), int(nearest[1])\n\n          # move to a free adjacent cell and face the item\n          (adj_x, adj_y), face_dir = adjacent_position(ix, iy)\n          go_to((adj_x, adj_y))\n          # set direction to face the item (move_step with zero displacement not possible,\n          # so we simply record the intended direction for the upcoming USE)\n          direction = face_dir\n          actions.append(ACTION_USE)   # pick up the ingredient\n\n          # simulate that the item was removed from the grid\n          grid[ix, iy, ing_idx] = 0\n\n  # ------------------------------------------------------------------\n  # If a workshop is required, go there and craft the stick\n  # ------------------------------------------------------------------\n  if workshop_name:\n      if workshop_name not in idx:\n          raise ValueError(f\"Workshop '{workshop_name}' not known\")\n      workshop_idx = idx[workshop_name]\n      ws_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_locs.size == 0:\n          raise RuntimeError(f\"No workshop of type {workshop_name} found\")\n      # pick the nearest workshop\n      dists = np.abs(ws_locs[:, 0] - pos[0]) + np.abs(ws_locs[:, 1] - pos[1])\n      nearest_ws = ws_locs[dists.argmin()]\n      wx, wy = int(nearest_ws[0]), int(nearest_ws[1])\n      (adj_x, adj_y), face_dir = adjacent_position(wx, wy)\n      go_to((adj_x, adj_y))\n      direction = face_dir\n      actions.append(ACTION_USE)   # craft at the workshop\n\n  return actions", "env_interactions": 5, "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T00:52:39.672486", "function_name": "make_arrow", "function_body": "  # Get current state and world objects\n  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  # Index of the target item \"stick\"\n  stick_idx = cookbook.index[\"stick\"]\n\n  # Primitive requirements for one stick (primitive idx -> count)\n  prim_counts = cookbook.primitives_for(stick_idx)\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # Helper: generate actions to move from cur_pos to target (Manhattan path)\n  def path_to(start, target):\n      x, y = start\n      tx, ty = target\n      seq = []\n      while x < tx:\n          seq.append(3)   # RIGHT\n          x += 1\n      while x > tx:\n          seq.append(2)   # LEFT\n          x -= 1\n      while y < ty:\n          seq.append(0)   # DOWN\n          y += 1\n      while y > ty:\n          seq.append(1)   # UP\n          y -= 1\n      return seq\n\n  # Collect each required primitive\n  grid = state.grid\n  for prim_idx, needed_cnt in prim_counts.items():\n      # Locate all cells that currently contain this primitive\n      prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n      # Sort by Manhattan distance from current position\n      prim_cells.sort(key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))\n      # Gather the required amount\n      remaining = needed_cnt\n      for cell in prim_cells:\n          if remaining <= 0:\n              break\n          # Move to the cell\n          actions.extend(path_to(cur_pos, cell))\n          cur_pos = cell\n          # Pick up the item\n          actions.append(4)   # USE\n          remaining -= 1\n\n  # After gathering primitives, go to the appropriate workshop and craft\n  recipe = cookbook.recipes.get(stick_idx, {})\n  workshop_idx = recipe.get(\"_at\")\n  if workshop_idx is not None:\n      # Find all workshop locations of the required type\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))\n      if workshop_cells:\n          # Choose the nearest workshop\n          workshop_cells.sort(key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))\n          target_ws = workshop_cells[0]\n          actions.extend(path_to(cur_pos, target_ws))\n          cur_pos = target_ws\n          # Craft the stick\n          actions.append(4)   # USE\n\n  return actions", "env_interactions": 0, "island_id": 2, "scores": {"3": -1}}
