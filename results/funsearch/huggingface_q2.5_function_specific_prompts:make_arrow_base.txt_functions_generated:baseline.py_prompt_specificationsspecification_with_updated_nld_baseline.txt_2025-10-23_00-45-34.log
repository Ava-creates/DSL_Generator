{"timestamp": "2025-10-23T00:51:15.824259", "function_name": "make_arrow", "function_body": "  # Helper to get the integer index of a kind name\n  def _idx(name):\n      return env.world.cookbook.index[name]\n\n  # Indices for actions\n  act_map = env.action_specs()\n  ACTION_USE = act_map[\"USE\"]\n  ACTIONS_MOVE = [act_map[d] for d in (\"DOWN\", \"UP\", \"LEFT\", \"RIGHT\")]\n\n  # Goal: one stick\n  stick_idx = _idx(\"stick\")\n  # Primitive requirements for a stick (may be empty if stick is primitive)\n  prim_req = env.world.cookbook.primitives_for(stick_idx)  # dict {prim_idx: count}\n  # Workshop where a stick can be crafted (if any)\n  workshop_idx = None\n  if stick_idx in env.world.cookbook.recipes:\n      workshop_name = env.world.cookbook.recipes[stick_idx].get(\"_at\")\n      if workshop_name is not None:\n          workshop_idx = _idx(workshop_name)\n\n  # Simple Manhattan\u2011distance mover\n  def _move_towards(pos, target):\n      y, x = pos\n      ty, tx = target\n      if y < ty:\n          return act_map[\"DOWN\"]\n      if y > ty:\n          return act_map[\"UP\"]\n      if x < tx:\n          return act_map[\"RIGHT\"]\n      if x > tx:\n          return act_map[\"LEFT\"]\n      return None  # already there\n\n  # Locate the nearest cell containing any of the needed kinds\n  def _find_nearest(state, kind_idx):\n      # returns (row, col) of the closest cell with the given kind\n      grid = state.grid[:, :, kind_idx]\n      ys, xs = np.where(grid > 0)\n      if len(ys) == 0:\n          return None\n      pos_y, pos_x = state.pos\n      dists = np.abs(ys - pos_y) + np.abs(xs - pos_x)\n      best = np.argmin(dists)\n      return (int(ys[best]), int(xs[best]))\n\n  # Main planning loop\n  actions = []\n  max_steps = 1000  # safety guard\n  steps = 0\n\n  while steps < max_steps:\n      state = env._current_state  # current CraftState\n      # check goal\n      if state.inventory[stick_idx] > 0:\n          break\n\n      # ------------------------------------------------------------\n      # 1. If we still miss some primitive, go collect it\n      missing = {p: c - state.inventory[p] for p, c in prim_req.items()\n                 if state.inventory[p] < c}\n      if missing:\n          # pick the first missing primitive\n          p_idx = next(iter(missing))\n          # if we are next to it, use it\n          if state.next_to(p_idx):\n              actions.append(ACTION_USE)\n              _, state = env.step(ACTION_USE)\n              steps += 1\n              continue\n          # otherwise move towards the nearest instance\n          target = _find_nearest(state, p_idx)\n          if target is not None:\n              move_act = _move_towards(state.pos, target)\n              if move_act is not None:\n                  actions.append(move_act)\n                  _, state = env.step(move_act)\n                  steps += 1\n                  continue\n          # if we cannot find it, just wander\n      # ------------------------------------------------------------\n      # 2. All primitives gathered \u2013 go to the workshop (if any) and craft\n      if workshop_idx is not None:\n          if state.next_to(workshop_idx):\n              actions.append(ACTION_USE)   # craft at the workshop\n              _, state = env.step(ACTION_USE)\n              steps += 1\n              continue\n          else:\n              target = _find_nearest(state, workshop_idx)\n              if target is not None:\n                  move_act = _move_towards(state.pos, target)\n                  if move_act is not None:\n                      actions.append(move_act)\n                      _, state = env.step(move_act)\n                      steps += 1\n                      continue\n      # ------------------------------------------------------------\n      # 3. No workshop needed (stick is primitive) \u2013 just wait (should not happen)\n      #    If we get here, just perform a random move to avoid infinite loop.\n      rand_move = np.random.choice(ACTIONS_MOVE)\n      actions.append(rand_move)\n      _, state = env.step(rand_move)\n      steps += 1\n\n  return actions", "env_interactions": 0, "island_id": 9, "scores": {"3": -1}}
