{"timestamp": "2025-10-23T01:15:44.464613", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ----------------------------------------------------------------------\n  # Helper functions\n  # ----------------------------------------------------------------------\n  def manhattan(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def nearest_target(pos, targets):\n      \"\"\"Return the target cell (x, y) with smallest Manhattan distance.\"\"\"\n      if len(targets) == 0:\n          return None\n      dists = [manhattan(pos, t) for t in targets]\n      return targets[int(np.argmin(dists))]\n\n  def bfs_path(grid, start, goal):\n      \"\"\"\n      Compute a shortest path from start to goal on the current grid.\n      Cells with any non\u2011zero occupancy are considered blocked,\n      except the goal cell itself (which may contain a primitive or workshop).\n      Returns a list of positions [(x0, y0), (x1, y1), ...] including start and goal.\n      \"\"\"\n      w, h, _ = grid.shape\n      visited = np.full((w, h), False, dtype=bool)\n      prev = dict()\n\n      q = deque()\n      q.append(start)\n      visited[start] = True\n\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          x, y = cur\n          for dx, dy in [(0, 1), (0, -1), (1, 0), (-1, 0)]:   # DOWN, UP, RIGHT, LEFT\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:\n                  # allow stepping onto the goal even if occupied\n                  if (nx, ny) != goal and grid[nx, ny].any():\n                      continue\n                  visited[nx, ny] = True\n                  prev[(nx, ny)] = (x, y)\n                  q.append((nx, ny))\n\n      # reconstruct path\n      if goal not in prev and start != goal:\n          # no path found \u2013 return direct line (may be invalid) to avoid crash\n          return [start, goal]\n\n      path = [goal]\n      while path[-1] != start:\n          path.append(prev[path[-1]])\n      path.reverse()\n      return path\n\n  def positions_to_actions(path):\n      \"\"\"\n      Convert a list of consecutive positions into a list of movement actions.\n      Action mapping (as defined in CraftLab):\n          DOWN \u2192 0,  UP \u2192 1,  LEFT \u2192 2,  RIGHT \u2192 3\n      \"\"\"\n      act_map = {\n          (0, 1): 0,   # y+1  DOWN\n          (0, -1): 1,  # y-1  UP\n          (-1, 0): 2,  # x-1  LEFT\n          (1, 0): 3    # x+1  RIGHT\n      }\n      actions = []\n      for (x0, y0), (x1, y1) in zip(path, path[1:]):\n          dx, dy = x1 - x0, y1 - y0\n          actions.append(act_map[(dx, dy)])\n      return actions\n\n  # ----------------------------------------------------------------------\n  # Begin planning\n  # ----------------------------------------------------------------------\n  # Ensure we have a current state (reset if necessary)\n  if not hasattr(env, \"_current_state\") or env._current_state is None:\n      env.reset()\n  state = env._current_state\n\n  world = env.world\n  cookbook = world.cookbook\n\n  # Identify the index for the target item \u201cstick\u201d\n  stick_idx = cookbook.index.get(\"stick\")\n  if stick_idx is None:\n      raise ValueError(\"Stick not found in cookbook index.\")\n\n  # Retrieve the recipe for the stick (ingredients and workshop)\n  recipe = cookbook.recipes.get(stick_idx, {})\n  workshop_idx = recipe.get(\"_at\")          # index of the workshop where stick is crafted\n  ingredient_dict = {k: v for k, v in recipe.items() if k not in (\"_at\", \"_key\")}\n\n  # ----------------------------------------------------------------------\n  # Collect required primitives\n  # ----------------------------------------------------------------------\n  actions_plan = []\n  grid = state.grid\n  pos = state.pos\n\n  for ing_idx, count in ingredient_dict.items():\n      # For each required primitive, collect the needed amount\n      for _ in range(count):\n          # locate all cells that currently contain this ingredient\n          locations = np.argwhere(grid[:, :, ing_idx] > 0)\n          locations = [(int(x), int(y)) for x, y in locations]\n          if not locations:\n              raise RuntimeError(f\"Required ingredient (index {ing_idx}) not present on the map.\")\n          target = nearest_target(pos, locations)\n\n          # compute path and convert to actions\n          path = bfs_path(grid, pos, target)\n          actions_plan.extend(positions_to_actions(path))\n\n          # use the ingredient (action 4)\n          actions_plan.append(4)   # USE\n\n          # Update our internal notion of position and grid for subsequent steps\n          # (the environment itself will be stepped later when the actions are executed)\n          pos = target\n          # after a successful USE the ingredient disappears from the grid\n          grid[target[0], target[1], ing_idx] = 0\n\n  # ----------------------------------------------------------------------\n  # Move to the workshop and craft the stick\n  # ----------------------------------------------------------------------\n  if workshop_idx is None:\n      raise RuntimeError(\"Stick recipe does not specify a workshop location.\")\n\n  # locate a workshop cell (any cell containing the workshop entity)\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if not len(workshop_cells):\n      raise RuntimeError(\"No workshop cell found for stick crafting.\")\n  workshop_pos = (int(workshop_cells[0][0]), int(workshop_cells[0][1]))\n\n  # path to workshop\n  path_to_ws = bfs_path(grid, pos, workshop_pos)\n  actions_plan.extend(positions_to_actions(path_to_ws))\n\n  # craft (USE) at the workshop\n  actions_plan.append(4)   # USE\n\n  # ----------------------------------------------------------------------\n  # Return the complete action list\n  # ----------------------------------------------------------------------\n  return actions_plan", "env_interactions": 0, "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-10-23T01:16:12.759550", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  grid = state.grid\n  width, height = grid.shape[:2]\n\n  # Directions and mapping to action indices\n  dirs = [(0, 1), (0, -1), (-1, 0), (1, 0)]               # DOWN, UP, LEFT, RIGHT\n  dir_action = {(0, 1): 0, (0, -1): 1, (-1, 0): 2, (1, 0): 3}\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Utility helpers\n  # ------------------------------------------------------------------\n  def find_cells(kind):\n      \"\"\"Return list of (x, y) positions where `kind` exists on the grid.\"\"\"\n      xs, ys = np.where(grid[:, :, kind] > 0)\n      return list(zip(xs, ys))\n\n  def bfs(start, goal):\n      \"\"\"Shortest path (as list of direction vectors) from start to goal avoiding occupied cells.\"\"\"\n      from collections import deque\n      q = deque([start])\n      visited = {start}\n      prev = {}\n\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          x, y = cur\n          for dx, dy in dirs:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height:\n                  if (nx, ny) not in visited:\n                      # cell is free if no entity occupies any kind there\n                      if not np.any(grid[nx, ny, :]):\n                          visited.add((nx, ny))\n                          prev[(nx, ny)] = (cur, (dx, dy))\n                          q.append((nx, ny))\n\n      if goal not in prev and start != goal:\n          return []                     # no path found\n\n      # reconstruct moves\n      path = []\n      cur = goal\n      while cur != start:\n          prev_node, move = prev[cur]\n          path.append(move)\n          cur = prev_node\n      path.reverse()\n      return path\n\n  # ------------------------------------------------------------------\n  # Identify stick recipe and its primitive requirements\n  # ------------------------------------------------------------------\n  stick_idx = env.world.cookbook.index[\"stick\"]\n  recipe = env.world.cookbook.recipes[stick_idx]\n\n  # Primitive ingredients (ignore the workshop entry \"_at\")\n  primitive_needs = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  # ------------------------------------------------------------------\n  # Collect all required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, count in primitive_needs.items():\n      for _ in range(count):\n          # locate any instance of the primitive on the map\n          prim_cells = find_cells(prim_idx)\n          if not prim_cells:\n              continue  # should not happen in a valid scenario\n          tx, ty = prim_cells[0]\n\n          # Choose a free neighboring cell from which we can face the primitive\n          neighbor_found = False\n          for dx, dy in dirs:\n              nx, ny = tx - dx, ty - dy\n              if 0 <= nx < width and 0 <= ny < height and not np.any(grid[nx, ny, :]):\n                  # Plan path to this neighbor\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      # update hypothetical state\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  # Use action to pick up the primitive (we are already facing it)\n                  actions.append(4)  # USE\n                  neighbor_found = True\n                  break\n          if not neighbor_found:\n              # fallback: try to move directly onto the primitive cell (rare)\n              path = bfs(state.pos, (tx, ty))\n              for mv in path:\n                  actions.append(dir_action[mv])\n                  state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                  state.dir = dir_action[mv]\n              actions.append(4)  # USE on the cell itself\n\n  # ------------------------------------------------------------------\n  # Craft the stick at its designated workshop\n  # ------------------------------------------------------------------\n  workshop_name = recipe[\"_at\"]\n  workshop_idx = env.world.cookbook.index[workshop_name]\n  workshop_cells = find_cells(workshop_idx)\n\n  if workshop_cells:\n      wx, wy = workshop_cells[0]  # pick first workshop location\n      # Find a free adjacent cell to stand on before using the workshop\n      for dx, dy in dirs:\n          nx, ny = wx - dx, wy - dy\n          if 0 <= nx < width and 0 <= ny < height and not np.any(grid[nx, ny, :]):\n              path = bfs(state.pos, (nx, ny))\n              for mv in path:\n                  actions.append(dir_action[mv])\n                  state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                  state.dir = dir_action[mv]\n              actions.append(4)  # USE to craft at workshop\n              break\n\n  return actions", "env_interactions": 7, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T01:16:14.061616", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  grid = state.grid\n  width, height = grid.shape[:2]\n\n  dirs = [(0, 1), (0, -1), (-1, 0), (1, 0)]  # DOWN, UP, LEFT, RIGHT\n  dir_action = {(0, 1): 0, (0, -1): 1, (-1, 0): 2, (1, 0): 3}\n  actions = []\n\n  def find_cells(kind):\n      xs, ys = np.where(grid[:, :, kind] > 0)\n      return list(zip(xs, ys))\n\n  from collections import deque\n\n  def bfs(start, goal):\n      q = deque([start])\n      visited = {start}\n      prev = {}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          x, y = cur\n          for dx, dy in dirs:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height:\n                  if (nx, ny) not in visited:\n                      if not np.any(grid[nx, ny, :]):  # free cell\n                          visited.add((nx, ny))\n                          prev[(nx, ny)] = (cur, (dx, dy))\n                          q.append((nx, ny))\n      if goal not in prev and start != goal:\n          return []\n      path = []\n      cur = goal\n      while cur != start:\n          prev_node, move = prev[cur]\n          path.append(move)\n          cur = prev_node\n      path.reverse()\n      return path\n\n  stick_idx = env.world.cookbook.index[\"stick\"]\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  primitive_needs = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  # ------------------------------------------------------------------\n  # Collect required primitive resources\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          prim_cells = find_cells(prim_idx)\n          if not prim_cells:\n              continue\n          tx, ty = prim_cells[0]\n\n          neighbor_found = False\n          for dx, dy in dirs:\n              nx, ny = tx - dx, ty - dy\n              if 0 <= nx < width and 0 <= ny < height and not np.any(grid[nx, ny, :]):\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  actions.append(4)  # USE to pick up primitive\n                  neighbor_found = True\n                  break\n          if not neighbor_found:\n              # fallback: any free neighbor, then face the primitive\n              for dx, dy in dirs:\n                  nx, ny = tx + dx, ty + dy\n                  if 0 <= nx < width and 0 <= ny < height and not np.any(grid[nx, ny, :]):\n                      path = bfs(state.pos, (nx, ny))\n                      for mv in path:\n                          actions.append(dir_action[mv])\n                          state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                          state.dir = dir_action[mv]\n                      # turn to face the primitive\n                      actions.append(dir_action[(-dx, -dy)])\n                      state.dir = dir_action[(-dx, -dy)]\n                      actions.append(4)\n                      neighbor_found = True\n                      break\n\n  # ------------------------------------------------------------------\n  # Craft the stick at its workshop (if a workshop is required)\n  # ------------------------------------------------------------------\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      workshop_cells = find_cells(workshop_idx)\n      if workshop_cells:\n          wx, wy = workshop_cells[0]\n          for dx, dy in dirs:\n              nx, ny = wx - dx, wy - dy\n              if 0 <= nx < width and 0 <= ny < height and not np.any(grid[nx, ny, :]):\n                  path = bfs(state.pos, (nx, ny))\n                  for mv in path:\n                      actions.append(dir_action[mv])\n                      state.pos = (state.pos[0] + mv[0], state.pos[1] + mv[1])\n                      state.dir = dir_action[mv]\n                  actions.append(4)  # USE to craft the stick\n                  break\n\n  return actions", "env_interactions": 7, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T01:16:40.322435", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  _ACTION_DELTAS = {\n      0: (1, 0),   # DOWN\n      1: (-1, 0),  # UP\n      2: (0, -1),  # LEFT\n      3: (0, 1),   # RIGHT\n  }\n\n  def _move_actions(start, goal):\n      \"\"\"Manhattan path from start to goal as a list of action indices.\"\"\"\n      y, x = start\n      gy, gx = goal\n      acts = []\n      while y < gy:\n          acts.append(0)   # DOWN\n          y += 1\n      while y > gy:\n          acts.append(1)   # UP\n          y -= 1\n      while x < gx:\n          acts.append(3)   # RIGHT\n          x += 1\n      while x > gx:\n          acts.append(2)   # LEFT\n          x -= 1\n      return acts\n\n  # ------------------------------------------------------------------\n  # Locate the world and current state\n  # ------------------------------------------------------------------\n  if hasattr(env, \"world\"):\n      world = env.world\n  elif hasattr(env, \"scenario\"):\n      world = env.scenario.world\n  else:\n      raise AttributeError(\"Cannot locate CraftWorld instance in the supplied env.\")\n\n  if hasattr(env, \"_current_state\"):\n      state = env._current_state\n  else:\n      # Assume env is a scenario; initialise a fresh state\n      state = env.scenario.init()\n\n  cur_pos = tuple(state.pos)          # (row, col)\n  grid = state.grid.copy()            # (H, W, n_kinds)\n\n  # ------------------------------------------------------------------\n  # Goal information (stick)\n  # ------------------------------------------------------------------\n  goal_name = \"stick\"\n  goal_idx = world.cookbook.index.index(goal_name)\n\n  # Primitives required to craft a stick\n  needed = world.cookbook.primitives_for(goal_idx)\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the necessary number of times\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(\n                  f\"Primitive '{world.cookbook.index.get(prim_idx)}' not found on the grid.\"\n              )\n          py, px = prim_cells[0]\n\n          # Find an empty neighbour from which we can face the primitive\n          chosen_dir = None\n          target_cell = None\n          for d, (dy, dx) in _ACTION_DELTAS.items():\n              ny, nx = py - dy, px - dx\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  if not grid[ny, nx, :].any():\n                      chosen_dir = d\n                      target_cell = (ny, nx)\n                      break\n          if target_cell is None:\n              raise RuntimeError(\"No reachable empty neighbour around required primitive.\")\n\n          # Move to the neighbour cell\n          actions.extend(_move_actions(cur_pos, target_cell))\n          cur_pos = target_cell\n\n          # Use (collect) the primitive\n          actions.append(4)   # USE\n          # Update planning grid: remove the primitive we just collected\n          grid[py, px, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Move to the workshop (if any) and craft the stick\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_cells.size == 0:\n          raise RuntimeError(f\"Workshop '{workshop_name}' not found on the grid.\")\n      wy, wx = ws_cells[0]\n\n      # Find an empty neighbour to face the workshop\n      chosen_dir = None\n      target_cell = None\n      for d, (dy, dx) in _ACTION_DELTAS.items():\n          ny, nx = wy - dy, wx - dx\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not grid[ny, nx, :].any():\n                  chosen_dir = d\n                  target_cell = (ny, nx)\n                  break\n      if target_cell is None:\n          raise RuntimeError(\"No reachable empty neighbour around workshop.\")\n\n      # Move to that neighbour\n      actions.extend(_move_actions(cur_pos, target_cell))\n      cur_pos = target_cell\n\n      # Craft the stick\n      actions.append(4)   # USE\n\n  # ------------------------------------------------------------------\n  # Return the full action sequence\n  # ------------------------------------------------------------------\n  return actions", "env_interactions": 5, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T01:16:41.687271", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # helper structures\n  # ----------------------------------------------------------------------\n  _ACTION_DELTAS = {\n      0: (1, 0),   # DOWN\n      1: (-1, 0),  # UP\n      2: (0, -1),  # LEFT\n      3: (0, 1),   # RIGHT\n  }\n\n  def _move_actions(start, goal):\n      \"\"\"Manhattan path from start (y,x) to goal (y,x) as list of actions.\"\"\"\n      y, x = start\n      gy, gx = goal\n      acts = []\n      while y < gy:\n          acts.append(0)   # DOWN\n          y += 1\n      while y > gy:\n          acts.append(1)   # UP\n          y -= 1\n      while x < gx:\n          acts.append(3)   # RIGHT\n          x += 1\n      while x > gx:\n          acts.append(2)   # LEFT\n          x -= 1\n      return acts\n\n  # ----------------------------------------------------------------------\n  # locate world instance\n  # ----------------------------------------------------------------------\n  if hasattr(env, \"world\"):\n      world = env.world\n  elif hasattr(env, \"scenario\"):\n      world = env.scenario.world\n  else:\n      raise AttributeError(\"Cannot locate CraftWorld instance in the supplied env.\")\n\n  # ----------------------------------------------------------------------\n  # goal information (stick)\n  # ----------------------------------------------------------------------\n  goal_name = \"stick\"\n  goal_idx = world.cookbook.index.index(goal_name)\n\n  # ingredients required to craft the stick (if any)\n  needed = world.cookbook.primitives_for(goal_idx)   # dict {prim_idx: count}\n\n  # ----------------------------------------------------------------------\n  # obtain current state for planning\n  # ----------------------------------------------------------------------\n  if hasattr(env, \"_current_state\"):\n      state = env._current_state\n  else:\n      # fallback: initialise a fresh state from the scenario\n      state = env.scenario.init()\n\n  cur_pos = tuple(state.pos)          # (row, col)\n  grid = state.grid.copy()            # (H, W, n_kinds)\n\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # helper to move to a primitive cell and pick it up\n  # ----------------------------------------------------------------------\n  def _collect_primitive(p_idx):\n      nonlocal cur_pos, actions, grid\n      # locate a cell containing the primitive\n      cells = np.argwhere(grid[:, :, p_idx] > 0)\n      if cells.size == 0:\n          raise RuntimeError(f\"Primitive {world.cookbook.index.get(p_idx)} not found on the grid.\")\n      py, px = cells[0]\n\n      # find an adjacent empty cell to stand on\n      chosen_dir = None\n      target = None\n      for d, (dy, dx) in _ACTION_DELTAS.items():\n          ny, nx = py - dy, px - dx\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not grid[ny, nx, :].any():          # empty\n                  chosen_dir = d\n                  target = (ny, nx)\n                  break\n      if target is None:\n          raise RuntimeError(\"No reachable empty neighbour around required primitive.\")\n\n      # move to that neighbour\n      actions.extend(_move_actions(cur_pos, target))\n      cur_pos = target\n\n      # USE to pick up the primitive (agent will be facing the primitive)\n      actions.append(4)   # USE\n      # update planning grid: remove the primitive\n      grid[py, px, p_idx] = 0\n\n  # ----------------------------------------------------------------------\n  # 1. Collect required primitives (if any)\n  # ----------------------------------------------------------------------\n  if needed:\n      for prim_idx, cnt in needed.items():\n          for _ in range(cnt):\n              _collect_primitive(prim_idx)\n\n  # ----------------------------------------------------------------------\n  # 2. If the stick itself is a primitive (no recipe), just collect it\n  # ----------------------------------------------------------------------\n  elif goal_idx in world.cookbook.primitives:\n      _collect_primitive(goal_idx)\n      # after picking up the primitive we are done\n      return actions\n\n  # ----------------------------------------------------------------------\n  # 3. Craft the stick at its workshop (if a workshop is specified)\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_cells.size == 0:\n          raise RuntimeError(f\"Workshop {workshop_name} not found on the grid.\")\n      wy, wx = ws_cells[0]\n\n      # find empty neighbour to stand on\n      chosen_dir = None\n      target = None\n      for d, (dy, dx) in _ACTION_DELTAS.items():\n          ny, nx = wy - dy, wx - dx\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not grid[ny, nx, :].any():\n                  chosen_dir = d\n                  target = (ny, nx)\n                  break\n      if target is None:\n          raise RuntimeError(\"No reachable empty neighbour around workshop.\")\n\n      actions.extend(_move_actions(cur_pos, target))\n      cur_pos = target\n      actions.append(4)   # USE to craft the stick\n\n  # ----------------------------------------------------------------------\n  # return the full action list\n  # ----------------------------------------------------------------------\n  return actions", "env_interactions": 5, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T01:17:16.562473", "function_name": "make_arrow", "function_body": "  actions = []\n  # assume the environment has already been reset and holds a current state\n  state = env._current_state\n  world = env.world\n\n  # index of the target item \"stick\"\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # primitive requirements for one stick (primitive indices \u2192 counts)\n  needed = world.cookbook.primitives_for(stick_idx).copy()\n\n  # workshop type needed for crafting the stick (may be None)\n  workshop_kind = world.cookbook.recipes.get(stick_idx, {}).get(\"_at\")\n\n  # ----------------------------------------------------------------------\n  # Helper: move one step towards a target coordinate (x, y) using the\n  # action encoding: 0=DOWN, 1=UP, 2=LEFT, 3=RIGHT, 4=USE.\n  # ----------------------------------------------------------------------\n  def move_towards(target, cur):\n      dx = target[0] - cur[0]\n      dy = target[1] - cur[1]\n      if dx > 0:\n          return 3          # RIGHT\n      if dx < 0:\n          return 2          # LEFT\n      if dy > 0:\n          return 0          # DOWN\n      if dy < 0:\n          return 1          # UP\n      return 0  # arbitrary if already on target\n\n  # ----------------------------------------------------------------------\n  # Phase 1 \u2013 collect all required primitives.\n  # ----------------------------------------------------------------------\n  while any(state.inventory[k] < v for k, v in needed.items()):\n      # If we are adjacent to a needed primitive, pick it up.\n      picked = False\n      for kind, cnt in needed.items():\n          if state.inventory[kind] >= cnt:\n              continue\n          if state.next_to(kind):\n              actions.append(4)                 # USE\n              _, _ = env.step(4)                # perform the action\n              state = env._current_state        # refresh state reference\n              picked = True\n              break\n      if picked:\n          continue\n\n      # Otherwise, navigate towards the closest needed primitive.\n      best_target = None\n      best_dist = float('inf')\n      for kind, cnt in needed.items():\n          if state.inventory[kind] >= cnt:\n              continue\n          positions = np.argwhere(state.grid[:, :, kind] > 0)\n          for pos in positions:\n              dist = abs(pos[0] - state.pos[0]) + abs(pos[1] - state.pos[1])\n              if dist < best_dist:\n                  best_dist = dist\n                  best_target = (pos[0], pos[1])\n\n      # If for some reason we cannot find any remaining primitive, abort.\n      if best_target is None:\n          break\n\n      act = move_towards(best_target, state.pos)\n      actions.append(act)\n      _, _ = env.step(act)\n      state = env._current_state\n\n  # ----------------------------------------------------------------------\n  # Phase 2 \u2013 go to the appropriate workshop and craft the stick.\n  # ----------------------------------------------------------------------\n  if workshop_kind is not None:\n      # Locate the nearest workshop cell of the required type.\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_kind] > 0)\n      if workshop_cells.size > 0:\n          target_ws = min(\n              workshop_cells,\n              key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1])\n          )\n          target_ws = (int(target_ws[0]), int(target_ws[1]))\n\n          # Move until we are adjacent (3\u00d73 neighbourhood) to the workshop.\n          while not state.next_to(workshop_kind):\n              act = move_towards(target_ws, state.pos)\n              actions.append(act)\n              _, _ = env.step(act)\n              state = env._current_state\n\n          # Finally, use the workshop to craft the stick.\n          actions.append(4)          # USE\n          _, _ = env.step(4)\n          state = env._current_state\n\n  return actions", "env_interactions": 0, "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-10-23T01:17:17.843793", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # Helper: simple Manhattan path (ignores obstacles)\n  def _path_actions(start, goal):\n      actions = []\n      x, y = start\n      tx, ty = goal\n      # Move vertically (DOWN=0, UP=1)\n      while x < tx:\n          actions.append(0)   # DOWN\n          x += 1\n      while x > tx:\n          actions.append(1)   # UP\n          x -= 1\n      # Move horizontally (LEFT=2, RIGHT=3)\n      while y < ty:\n          actions.append(3)   # RIGHT\n          y += 1\n      while y > ty:\n          actions.append(2)   # LEFT\n          y -= 1\n      return actions\n\n  # Access the underlying state (CraftLab keeps it in _current_state)\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      # Fallback for environments that expose the state directly\n      state = getattr(env, \"current_state\", None)\n\n  # Safety checks \u2013 if we cannot obtain a state, just return an empty plan.\n  if state is None:\n      return []\n\n  world = env.world\n  cookbook = world.cookbook\n\n  # Index of the target item \u201cstick\u201d\n  stick_idx = cookbook.index.get(\"stick\")\n  if stick_idx is None:\n      return []  # unknown goal\n\n  # ------------------------------------------------------------------\n  # 1. Determine which primitives (or intermediate items) are needed.\n  # ------------------------------------------------------------------\n  needed = cookbook.primitives_for(stick_idx)          # {kind_idx: count}\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # ------------------------------------------------------------------\n  # 2. Collect each required primitive/intermediate item.\n  # ------------------------------------------------------------------\n  grid = state.grid\n  for kind_idx, cnt in needed.items():\n      for _ in range(cnt):\n          # Locate all cells that currently contain the desired kind\n          locations = np.argwhere(grid[:, :, kind_idx] > 0)\n          if locations.size == 0:\n              # Nothing left to pick up \u2013 give up early.\n              return actions\n          # Choose the nearest location (Manhattan distance)\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          nearest = locations[np.argmin(dists)]\n          target_pos = (int(nearest[0]), int(nearest[1]))\n\n          # Move to the target cell\n          actions.extend(_path_actions(cur_pos, target_pos))\n          cur_pos = target_pos\n\n          # Pick it up (USE action, conventionally index 4)\n          actions.append(4)   # USE\n          # Update our simulated grid/inventory view (optional \u2013 not required for planning)\n\n  # ------------------------------------------------------------------\n  # 3. Go to the appropriate workshop and craft the stick.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      wk_idx = cookbook.index.get(workshop_name)\n      if wk_idx is not None:\n          wk_locs = np.argwhere(grid[:, :, wk_idx] > 0)\n          if wk_locs.size > 0:\n              dists = np.abs(wk_locs[:, 0] - cur_pos[0]) + np.abs(wk_locs[:, 1] - cur_pos[1])\n              nearest_wk = wk_locs[np.argmin(dists)]\n              wk_pos = (int(nearest_wk[0]), int(nearest_wk[1]))\n\n              # Move next to the workshop (standing on the same cell is fine)\n              actions.extend(_path_actions(cur_pos, wk_pos))\n              cur_pos = wk_pos\n\n              # Craft by using the workshop cell\n              actions.append(4)   # USE\n\n  return actions", "env_interactions": 0, "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-10-23T01:17:45.655459", "function_name": "make_arrow", "function_body": "", "env_interactions": 0, "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-10-23T01:17:47.001147", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # Action indices as defined in CraftLab.action_specs\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions from start to goal using\n      horizontal then vertical moves (ignores obstacles).\"\"\"\n      x, y = start\n      gx, gy = goal\n      actions = []\n      while x < gx:\n          actions.append(ACTION_RIGHT)\n          x += 1\n      while x > gx:\n          actions.append(ACTION_LEFT)\n          x -= 1\n      while y < gy:\n          actions.append(ACTION_DOWN)\n          y += 1\n      while y > gy:\n          actions.append(ACTION_UP)\n          y -= 1\n      return actions\n\n  def nearest_position(positions, reference):\n      \"\"\"Pick the position from *positions* with smallest Manhattan distance\n      to *reference*.\"\"\"\n      if len(positions) == 0:\n          return None\n      ref = np.array(reference)\n      dists = np.sum(np.abs(positions - ref), axis=1)\n      return tuple(positions[np.argmin(dists)])\n\n  # ------------------------------------------------------------------\n  # Gather current state information\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n\n  # ------------------------------------------------------------------\n  # Identify goal (stick)\n  # ------------------------------------------------------------------\n  goal_name = \"stick\"\n  goal_idx = env.world.cookbook.index[goal_name]\n\n  plan_actions = []\n\n  # ------------------------------------------------------------------\n  # Determine required primitives for the stick\n  # ------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n\n  # If no recipe (stick is a primitive), just collect it directly\n  if not primitives_needed:\n      stick_cells = np.argwhere(grid[:, :, goal_idx] > 0)\n      if stick_cells.size == 0:\n          return plan_actions  # nothing to collect\n      target = nearest_position(stick_cells, pos)\n      plan_actions.extend(manhattan_path(pos, target))\n      plan_actions.append(ACTION_USE)\n      return plan_actions\n\n  # ------------------------------------------------------------------\n  # 1) Collect needed primitives\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      while inventory[prim_idx] < needed_cnt:\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              return plan_actions  # cannot satisfy requirement\n          target = nearest_position(prim_cells, pos)\n\n          # move to the primitive\n          plan_actions.extend(manhattan_path(pos, target))\n          pos = target\n\n          # pick it up\n          plan_actions.append(ACTION_USE)\n\n          # simulate pick\u2011up locally for further planning\n          inventory[prim_idx] += 1\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # ------------------------------------------------------------------\n  # 2) Go to workshop (if recipe requires one) and craft the stick\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          return plan_actions  # no workshop visible\n      wcell = tuple(workshop_cells[0])\n\n      # find a free adjacent cell to stand on\n      neighbours = [(wcell[0] + dx, wcell[1] + dy) for dx, dy in\n                    [(1, 0), (-1, 0), (0, 1), (0, -1)]]\n      stand_pos = None\n      for nx, ny in neighbours:\n          if (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and\n                  grid[nx, ny, :].sum() == 0):\n              stand_pos = (nx, ny)\n              break\n      if stand_pos is None:\n          stand_pos = wcell  # fallback: stand on the workshop itself\n\n      # move to the chosen standing position\n      plan_actions.extend(manhattan_path(pos, stand_pos))\n      pos = stand_pos\n\n      # use the workshop to craft the stick\n      plan_actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # Return the full action list\n  # ------------------------------------------------------------------\n  return plan_actions", "env_interactions": 5, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T01:18:07.061225", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n\n  # Identify the index for the \"stick\" item\n  try:\n      stick_idx = world.cookbook.index[\"stick\"]\n  except Exception:\n      # Stick not defined in this world \u2013 nothing to do\n      return []\n\n  grid = state.grid\n\n  # Locate all cells that currently contain a stick\n  stick_cells = np.argwhere(grid[:, :, stick_idx] > 0)\n  if stick_cells.size == 0:\n      # No sticks on the map; cannot collect one\n      return []\n\n  # Choose the first available stick cell as the target\n  target_x, target_y = stick_cells[0]\n\n  # Build a mask of cells that block movement (non\u2011grabbable entities)\n  blocked = np.zeros(grid.shape[:2], dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  start_x, start_y = state.pos\n\n  # If we are already on the stick cell, just use it\n  if (start_x, start_y) == (target_x, target_y):\n      return [env.action_specs()[\"USE\"]]\n\n  # Breadth\u2011first search for the shortest path to the stick\n  from collections import deque\n\n  act_map = env.action_specs()\n  directions = [\n      (0, 1, act_map[\"DOWN\"]),   # move down\n      (0, -1, act_map[\"UP\"]),    # move up\n      (-1, 0, act_map[\"LEFT\"]),  # move left\n      (1, 0, act_map[\"RIGHT\"]),  # move right\n  ]\n\n  queue = deque()\n  queue.append(((start_x, start_y), []))\n  visited = {(start_x, start_y)}\n  path_actions = None\n\n  while queue:\n      (x, y), actions = queue.popleft()\n      if (x, y) == (target_x, target_y):\n          path_actions = actions\n          break\n      for dx, dy, act in directions:\n          nx, ny = x + dx, y + dy\n          if (\n              0 <= nx < grid.shape[0]\n              and 0 <= ny < grid.shape[1]\n              and not blocked[nx, ny]\n              and (nx, ny) not in visited\n          ):\n              visited.add((nx, ny))\n              queue.append(((nx, ny), actions + [act]))\n\n  if path_actions is None:\n      # No reachable path to a stick\n      return []\n\n  # Append the USE action to pick up the stick once arrived\n  path_actions.append(act_map[\"USE\"])\n  return path_actions", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T01:18:08.320253", "function_name": "make_arrow", "function_body": "  # ---- helper: BFS shortest path (returns list of action ids) ----\n  def _bfs_path(start, goal, blocked):\n      from collections import deque\n\n      act_map = env.action_specs()\n      dirs = [\n          (0, 1, act_map[\"DOWN\"]),\n          (0, -1, act_map[\"UP\"]),\n          (-1, 0, act_map[\"LEFT\"]),\n          (1, 0, act_map[\"RIGHT\"]),\n      ]\n\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for dx, dy, a in dirs:\n              nx, ny = x + dx, y + dy\n              if (\n                  0 <= nx < blocked.shape[0]\n                  and 0 <= ny < blocked.shape[1]\n                  and not blocked[nx, ny]\n                  and (nx, ny) not in visited\n              ):\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [a]))\n      return None  # unreachable\n\n  # ---- main logic ----------------------------------------------------\n  state = env._current_state\n  world = env.world\n  grid = state.grid\n\n  # index of the target item \"stick\"\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # primitive requirements for a stick (may be empty if stick is primitive)\n  prim_req = world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n\n  # mask of cells we cannot walk through (non\u2011grabbable entities)\n  blocked = np.zeros(grid.shape[:2], dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  actions_plan = []\n  cur_pos = tuple(state.pos)\n\n  # ---- case 1: stick is a primitive already placed in the world ----\n  if not prim_req:\n      # find any stick cell\n      stick_cells = np.argwhere(grid[:, :, stick_idx] > 0)\n      if stick_cells.size == 0:\n          return []  # nothing to do / cannot find stick\n      target = tuple(stick_cells[0])\n      if cur_pos != target:\n          path = _bfs_path(cur_pos, target, blocked)\n          if path is None:\n              return []  # unreachable\n          actions_plan.extend(path)\n      actions_plan.append(env.action_specs()[\"USE\"])\n      return actions_plan\n\n  # ---- case 2: need to collect primitives first -------------------\n  # copy of required counts so we can decrement as we collect\n  needed = dict(prim_req)\n\n  # repeatedly collect the nearest needed primitive\n  while any(cnt > 0 for cnt in needed.values()):\n      # find the closest needed primitive cell\n      best_path = None\n      best_target = None\n      best_prim = None\n\n      for prim_idx, cnt in needed.items():\n          if cnt <= 0:\n              continue\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          for cell in prim_cells:\n              target = tuple(cell)\n              path = _bfs_path(cur_pos, target, blocked)\n              if path is None:\n                  continue\n              if best_path is None or len(path) < len(best_path):\n                  best_path = path\n                  best_target = target\n                  best_prim = prim_idx\n\n      if best_path is None:\n          # cannot reach any remaining required primitive\n          return []\n\n      # move to the primitive and pick it up\n      actions_plan.extend(best_path)\n      actions_plan.append(env.action_specs()[\"USE\"])\n\n      # update state for planning purposes (pretend we moved & collected)\n      cur_pos = best_target\n      needed[best_prim] -= 1\n      # pretend the primitive disappears from the grid so we don't try to\n      # collect the same instance again\n      grid[best_target[0], best_target[1], best_prim] = 0\n\n  # ---- case 3: go to the workshop (if recipe specifies one) ----\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          # no explicit workshop tile \u2013 assume we can craft anywhere\n          pass\n      else:\n          target = tuple(workshop_cells[0])\n          if cur_pos != target:\n              path = _bfs_path(cur_pos, target, blocked)\n              if path is None:\n                  return []  # cannot reach workshop\n              actions_plan.extend(path)\n              cur_pos = target\n\n  # finally, use the crafting action (same USE key)\n  actions_plan.append(env.action_specs()[\"USE\"])\n  return actions_plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-23T01:18:25.107334", "function_name": "make_arrow", "function_body": "  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions from start to goal using\n      horizontal then vertical moves (ignores obstacles).\"\"\"\n      sx, sy = start\n      gx, gy = goal\n      actions = []\n      while sx < gx:\n          actions.append(ACTION_RIGHT)\n          sx += 1\n      while sx > gx:\n          actions.append(ACTION_LEFT)\n          sx -= 1\n      while sy < gy:\n          actions.append(ACTION_DOWN)\n          sy += 1\n      while sy > gy:\n          actions.append(ACTION_UP)\n          sy -= 1\n      return actions\n\n  def nearest_position(positions, reference):\n      \"\"\"Pick the position from *positions* with smallest Manhattan distance\n      to *reference*.\"\"\"\n      if len(positions) == 0:\n          return None\n      ref = np.array(reference)\n      dists = np.sum(np.abs(positions - ref), axis=1)\n      return tuple(positions[np.argmin(dists)])\n\n  # ------------------------------------------------------------------\n  # Gather current state information\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n\n  # ------------------------------------------------------------------\n  # Identify goal (stick)\n  # ------------------------------------------------------------------\n  goal_name = \"stick\"\n  goal_idx = env.world.cookbook.index[goal_name]\n\n  # ------------------------------------------------------------------\n  # 1) Collect needed primitives (if any)\n  # ------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  plan_actions = []\n\n  for prim_idx, needed_cnt in primitives_needed.items():\n      while inventory[prim_idx] < needed_cnt:\n          # locate cells containing the primitive\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # nothing left on map \u2013 abort planning\n              return plan_actions\n          target = nearest_position(prim_cells, pos)\n\n          # move to the primitive\n          plan_actions.extend(manhattan_path(pos, target))\n          pos = target\n\n          # pick it up\n          plan_actions.append(ACTION_USE)\n\n          # simulate pick\u2011up locally for further planning\n          inventory[prim_idx] += 1\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # ------------------------------------------------------------------\n  # 2) Go to workshop (if recipe requires one) and craft stick\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          # no workshop visible \u2013 cannot craft\n          return plan_actions\n      wcell = tuple(workshop_cells[0])\n\n      # find a free adjacent cell to stand on\n      neighbours = [(wcell[0] + dx, wcell[1] + dy) for dx, dy in\n                    [(1, 0), (-1, 0), (0, 1), (0, -1)]]\n      stand_pos = None\n      for nx, ny in neighbours:\n          if (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and\n                  grid[nx, ny, :].sum() == 0):\n              stand_pos = (nx, ny)\n              break\n      if stand_pos is None:\n          stand_pos = wcell  # fallback: stand on the workshop itself\n\n      # move to the chosen standing position\n      plan_actions.extend(manhattan_path(pos, stand_pos))\n      pos = stand_pos\n\n      # use the workshop to craft the stick\n      plan_actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # Return the full action list\n  # ------------------------------------------------------------------\n  return plan_actions", "env_interactions": 5, "island_id": 4, "scores": {"3": 0.0}}
