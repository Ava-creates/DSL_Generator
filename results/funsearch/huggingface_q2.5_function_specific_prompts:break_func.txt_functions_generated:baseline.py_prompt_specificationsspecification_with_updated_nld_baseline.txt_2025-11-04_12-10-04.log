{"timestamp": "2025-11-04T12:56:30.282237", "function_name": "break_func", "function_body": "  # Map direction strings to the corresponding movement action indices.\n  dir_map = {\"DOWN\": 0, \"UP\": 1, \"LEFT\": 2, \"RIGHT\": 3}\n  # Normalize the input direction.\n  d = str(dir).upper()\n  if d not in dir_map:\n      # Unknown direction \u2013 return an empty action list.\n      return np.array([], dtype=np.int32)\n\n  move_action = dir_map[d]\n\n  # Determine the index of the USE action.  The environment usually provides\n  # an `action_specs` method that maps action names to indices.\n  use_action = None\n  if hasattr(env, \"action_specs\"):\n      try:\n          specs = env.action_specs()\n          use_action = specs.get(\"USE\", None)\n      except Exception:\n          use_action = None\n\n  # Fallback to the default index (4) if we could not retrieve it.\n  if use_action is None:\n      use_action = 4\n\n  # Return a sequence that first moves (or faces) the obstacle direction\n  # and then performs the USE action to attempt breaking it.\n  return np.array([move_action, use_action], dtype=np.int32)", "env_interactions": 0, "island_id": 0, "scores": {"3": 0.0}}
