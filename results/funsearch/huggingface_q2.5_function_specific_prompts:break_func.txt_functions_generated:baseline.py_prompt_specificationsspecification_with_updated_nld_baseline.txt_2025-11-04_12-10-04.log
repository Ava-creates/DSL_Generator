{"timestamp": "2025-11-04T13:59:23.067574", "function_name": "break_func", "function_body": "  # No operation: return an empty list of actions\n  return []", "env_interactions": 0, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-11-04T13:59:24.213454", "function_name": "break_func", "function_body": "  import collections\n  import numpy as np\n\n  def _bfs_path(grid, start, goal, allow_target=True):\n      \"\"\"Return list of action indices to move from start to goal.\"\"\"\n      w, h, _ = grid.shape\n      visited = np.full((w, h), False, dtype=bool)\n      prev = {}\n      dq = collections.deque()\n      dq.append(start)\n      visited[start[0], start[1]] = True\n      # (dx, dy, action_index)\n      moves = [(0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)]  # DOWN,UP,LEFT,RIGHT\n      while dq:\n          x, y = dq.popleft()\n          if (x, y) == goal:\n              break\n          for dx, dy, act in moves:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:\n                  blocked = np.any(grid[nx, ny, :] > 0)\n                  if blocked and not (allow_target and (nx, ny) == goal):\n                      continue\n                  visited[nx, ny] = True\n                  prev[(nx, ny)] = (x, y, act)\n                  dq.append((nx, ny))\n      if start == goal:\n          return []\n      if (goal[0], goal[1]) not in prev:\n          return []  # no path found\n      # reconstruct path\n      path = []\n      cur = goal\n      while cur != start:\n          px, py, act = prev[cur]\n          path.append(act)\n          cur = (px, py)\n      path.reverse()\n      return path\n\n  # reset environment and obtain initial observation\n  obs = env.reset()\n  actions_taken = []\n\n  # shortcuts to world and goal information\n  world = env.world\n  goal_idx = env.task.goal\n  # map of primitive kind -> required count for one unit of goal\n  needed_prims = dict(world.cookbook.primitives_for(goal_idx))\n\n  # main loop: keep acting until the task is done\n  while not env._is_done():\n      state = env._current_state\n      grid = state.grid\n      pos = state.pos\n      inventory = state.inventory\n\n      # check if we already have enough primitives to craft the goal\n      have_all = all(inventory.get(p, 0) >= cnt for p, cnt in needed_prims.items())\n\n      if have_all:\n          # move to the workshop (if any) and craft\n          recipe = world.cookbook.recipes.get(goal_idx, {})\n          workshop_idx = recipe.get('_at')\n          if workshop_idx is None:\n              # no workshop required \u2013 task should be finished\n              break\n          # locate a workshop cell (any)\n          ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n          if ws_cells.size == 0:\n              # cannot find workshop \u2013 abort\n              break\n          target = tuple(ws_cells[0][:2])\n          path = _bfs_path(grid, pos, target, allow_target=True)\n          for act in path:\n              reward, done, _ = env.step(act)\n              actions_taken.append(act)\n              if done:\n                  return actions_taken\n          # use the workshop to craft\n          reward, done, _ = env.step(4)  # USE action\n          actions_taken.append(4)\n          if done:\n              break\n          continue\n\n      # otherwise we need to collect a missing primitive\n      # select the first primitive that is still lacking\n      target_prim = None\n      for prim, cnt in needed_prims.items():\n          if inventory.get(prim, 0) < cnt:\n              target_prim = prim\n              break\n      if target_prim is None:\n          # nothing to collect (should not happen)\n          break\n\n      # find all cells that contain this primitive\n      prim_cells = np.argwhere(grid[:, :, target_prim] > 0)\n      if prim_cells.size == 0:\n          # no reachable primitive \u2013 abort\n          break\n      # pick the nearest cell (Manhattan distance)\n      distances = np.sum(np.abs(prim_cells[:, :2] - np.array(pos)), axis=1)\n      nearest_idx = np.argmin(distances)\n      target = tuple(prim_cells[nearest_idx][:2])\n\n      # move to the primitive cell\n      path = _bfs_path(grid, pos, target, allow_target=True)\n      for act in path:\n          reward, done, _ = env.step(act)\n          actions_taken.append(act)\n          if done:\n              return actions_taken\n\n      # collect the primitive\n      reward, done, _ = env.step(4)  # USE action\n      actions_taken.append(4)\n      if done:\n          break\n\n  return actions_taken", "env_interactions": 0, "island_id": 5, "scores": {"3": 0.0}}
