{"timestamp": "2025-11-04T14:40:38.754033", "function_name": "break_func", "function_body": "  return []", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-11-04T14:41:05.922040", "function_name": "break_func", "function_body": "  # Helper: BFS returning list of action indices to reach any target cell\n  from collections import deque\n\n  # Mapping from direction vector to action index (as used by CraftLab)\n  _DIR2ACT = {\n      (0, 1): 0,   # DOWN\n      (0, -1): 1,  # UP\n      (-1, 0): 2,  # LEFT\n      (1, 0): 3,   # RIGHT\n  }\n\n  def _bfs(start, target_set, blocked):\n      \"\"\"Return a list of actions (ints) from start to the nearest target.\"\"\"\n      w, h = blocked.shape\n      visited = np.full((w, h), False, dtype=bool)\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited[start[0], start[1]] = True\n      while q:\n          x, y, path = q.popleft()\n          if (x, y) in target_set:\n              return path\n          for dx, dy in [(0, 1), (0, -1), (-1, 0), (1, 0)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:\n                  if not blocked[nx, ny]:\n                      visited[nx, ny] = True\n                      act = _DIR2ACT[(dx, dy)]\n                      q.append((nx, ny, path + [act]))\n      return None\n\n  # ----- Begin main solving logic -----\n  actions = []\n\n  # reset environment and obtain initial observation\n  env.reset()\n  state = env._current_state\n\n  # identify goal index\n  try:\n      goal = env.task.goal\n  except Exception:\n      # fallback: try to read from observation dict\n      obs = env.observations()\n      goal = obs.get(\"task_name\", None)\n      if isinstance(goal, str):\n          # try to map name to index via world index\n          goal = env.world.cookbook.index[goal]\n      else:\n          raise RuntimeError(\"Cannot determine goal from environment.\")\n  cookbook = env.world.cookbook\n\n  # Determine whether goal is a primitive or a crafted item\n  if goal in cookbook.primitives:\n      # simple primitive collection\n      needed = {goal: 1}\n      workshop_kind = None\n  else:\n      # retrieve recipe ingredients (primitives) and workshop kind\n      recipe = cookbook.recipes.get(goal, {})\n      needed = {k: v for k, v in recipe.items() if k != \"_at\"}\n      workshop_kind = recipe.get(\"_at\", None)\n\n  # Helper to obtain USE action index\n  use_action = env.action_specs().get(\"USE\", 4)\n\n  # ----- Collect required primitives -----\n  for kind, count in needed.items():\n      for _ in range(count):\n          # locate nearest cell containing the required primitive\n          while True:\n              state = env._current_state\n              grid = state.grid\n              pos = state.pos\n\n              # positions where the primitive exists (count > 0)\n              locs = np.argwhere(grid[:, :, kind] > 0)\n              if locs.size == 0:\n                  # nothing left to collect; break out\n                  break\n\n              # compute blocked cells (non\u2011grabbable entities)\n              non_grab = list(env.world.non_grabbable_indices)\n              if non_grab:\n                  blocked = np.any(grid[:, :, non_grab] > 0, axis=2)\n              else:\n                  blocked = np.zeros(grid.shape[:2], dtype=bool)\n\n              target_set = set(map(tuple, locs))\n              path = _bfs(pos, target_set, blocked)\n              if path is None:\n                  # cannot reach any instance; abort this primitive\n                  break\n\n              # execute movement actions\n              for a in path:\n                  reward, _ = env.step(a)\n                  actions.append(a)\n                  if env._is_done():\n                      return actions\n\n              # now we are on a cell that contains the primitive;\n              # attempt to pick it up with USE\n              reward, _ = env.step(use_action)\n              actions.append(use_action)\n              if env._is_done():\n                  return actions\n              # after USE, break the inner loop (primitive collected)\n              break\n\n  # ----- If goal is a crafted item, go to workshop and craft -----\n  if workshop_kind is not None:\n      while True:\n          state = env._current_state\n          grid = state.grid\n          pos = state.pos\n\n          # locate any workshop cell of the required kind\n          locs = np.argwhere(grid[:, :, workshop_kind] > 0)\n          if locs.size == 0:\n              # no workshop found; cannot craft\n              break\n\n          non_grab = list(env.world.non_grabbable_indices)\n          if non_grab:\n              blocked = np.any(grid[:, :, non_grab] > 0, axis=2)\n          else:\n              blocked = np.zeros(grid.shape[:2], dtype=bool)\n\n          target_set = set(map(tuple, locs))\n          path = _bfs(pos, target_set, blocked)\n          if path is None:\n              # cannot reach workshop\n              break\n\n          for a in path:\n              reward, _ = env.step(a)\n              actions.append(a)\n              if env._is_done():\n                  return actions\n\n          # at workshop cell: USE to craft the goal item\n          reward, _ = env.step(use_action)\n          actions.append(use_action)\n          # crafting may succeed; exit loop\n          break\n\n  # Return the complete action sequence\n  return actions", "env_interactions": 0, "island_id": 9, "scores": {"3": 0.0}}
