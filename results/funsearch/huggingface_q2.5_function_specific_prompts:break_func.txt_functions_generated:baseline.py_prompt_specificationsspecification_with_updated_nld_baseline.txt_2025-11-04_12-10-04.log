{"timestamp": "2025-11-04T14:22:36.125910", "function_name": "break_func", "function_body": "  import numpy as np\n\n  # Reset environment to get a fresh state\n  env.reset()\n  state = env._current_state\n\n  # Mapping from action names to indices\n  action_map = env.action_specs()\n  # Ensure we have numeric indices for movement and USE\n  DOWN = action_map.get(\"DOWN\", 0)\n  UP = action_map.get(\"UP\", 1)\n  LEFT = action_map.get(\"LEFT\", 2)\n  RIGHT = action_map.get(\"RIGHT\", 3)\n  USE = action_map.get(\"USE\", 4)\n\n  # Goal item index (the integer representing the desired kind)\n  goal_idx = env.task.goal\n\n  # Locate all cells that currently contain the goal item\n  grid = state.grid  # shape (W, H, n_kinds)\n  goal_cells = np.argwhere(grid[:, :, goal_idx] > 0)\n\n  # If the goal item is not present in the world, fall back to a no\u2011op plan\n  if goal_cells.size == 0:\n      return []\n\n  # Choose the closest goal cell (Manhattan distance)\n  cur_x, cur_y = state.pos\n  dists = np.abs(goal_cells[:, 0] - cur_x) + np.abs(goal_cells[:, 1] - cur_y)\n  target_x, target_y = goal_cells[np.argmin(dists)]\n\n  actions = []\n\n  # Simple greedy navigation: first move in x, then in y\n  while cur_x != target_x:\n      if target_x > cur_x:\n          actions.append(RIGHT)\n          cur_x += 1\n      else:\n          actions.append(LEFT)\n          cur_x -= 1\n\n  while cur_y != target_y:\n      if target_y > cur_y:\n          actions.append(DOWN)\n          cur_y += 1\n      else:\n          actions.append(UP)\n          cur_y -= 1\n\n  # Once on the target cell, issue a USE action to collect it\n  actions.append(USE)\n\n  # Truncate to the environment's maximum step limit if it exists\n  max_steps = getattr(env, \"max_steps\", None)\n  if max_steps is not None:\n      actions = actions[:max_steps]\n\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": -1}}
