{"timestamp": "2025-11-04T12:36:10.954749", "function_name": "break_func", "function_body": "  # Initialize environment and retrieve goal information\n  obs = env.reset()\n  goal = env.task.goal                     # integer index of the desired item\n  world = env.world\n  cookbook = world.cookbook\n\n  # Mapping from action names to integer indices\n  action_map = env.action_specs()\n  # Direction vectors corresponding to movement actions\n  dir_vectors = {\n      \"DOWN\":  (0, 1),\n      \"UP\":    (0, -1),\n      \"LEFT\":  (-1, 0),\n      \"RIGHT\": (1, 0),\n  }\n\n  # Helper: locate the nearest cell containing a given kind\n  def nearest_pos(state, kind):\n      coords = np.argwhere(state.grid[:, :, kind] > 0)\n      if coords.size == 0:\n          return None\n      pos = np.array(state.pos)\n      dists = np.abs(coords - pos).sum(axis=1)\n      return tuple(coords[dists.argmin()])\n\n  # Helper: check if two positions are orthogonally adjacent\n  def is_adjacent(a, b):\n      return (abs(a[0] - b[0]) + abs(a[1] - b[1])) == 1\n\n  # Helper: choose a valid move that brings the agent closer to a target\n  def step_towards(state, target):\n      cur = np.array(state.pos)\n      best_act = None\n      best_dist = np.inf\n      for name, vec in dir_vectors.items():\n          nxt = cur + np.array(vec)\n          # bounds check\n          w, h, _ = state.grid.shape\n          if not (0 <= nxt[0] < w and 0 <= nxt[1] < h):\n              continue\n          # cell must be empty (no entity occupies it)\n          if state.grid[nxt[0], nxt[1]].any():\n              continue\n          dist = np.abs(nxt - target).sum()\n          if dist < best_dist:\n              best_dist = dist\n              best_act = name\n      # fallback to any legal random move if stuck\n      if best_act is None:\n          for name, vec in dir_vectors.items():\n              nxt = cur + np.array(vec)\n              w, h, _ = state.grid.shape\n              if 0 <= nxt[0] < w and 0 <= nxt[1] < h and not state.grid[nxt[0], nxt[1]].any():\n                  best_act = name\n                  break\n      if best_act is None:\n          # completely stuck \u2013 just stay (no move)\n          return None\n      return action_map[best_act]\n\n  # Determine primitive requirements for the goal\n  needed_prims = dict(cookbook.primitives_for(goal))\n\n  actions_taken = []\n  max_steps = getattr(env, \"max_steps\", 1000)\n  steps = 0\n\n  while steps < max_steps:\n      state = env._current_state\n\n      # Update needed primitives based on current inventory\n      for k in list(needed_prims.keys()):\n          if state.inventory[k] >= needed_prims[k]:\n              needed_prims.pop(k)\n\n      # Goal already satisfied?\n      if state.inventory[goal] > 0:\n          break\n\n      # If we still need primitives, go collect them\n      if needed_prims:\n          prim_kind = next(iter(needed_prims))\n          target = nearest_pos(state, prim_kind)\n          if target is None:\n              # primitive not present \u2013 abort\n              break\n          if is_adjacent(state.pos, target):\n              # Use to pick up the primitive\n              act = action_map[\"USE\"]\n              env.step(act)\n              actions_taken.append(act)\n              steps += 1\n              continue\n          else:\n              act = step_towards(state, target)\n              if act is None:\n                  # no valid move; give up\n                  break\n              env.step(act)\n              actions_taken.append(act)\n              steps += 1\n              continue\n\n      # All required primitives collected \u2013 move to workshop and craft\n      recipe = cookbook.recipes.get(goal, {})\n      workshop_kind = recipe.get(\"_at\")\n      if workshop_kind is None:\n          # No workshop needed; cannot craft\n          break\n      target = nearest_pos(state, workshop_kind)\n      if target is None:\n          break\n      if is_adjacent(state.pos, target):\n          # Use to craft at the workshop\n          act = action_map[\"USE\"]\n          env.step(act)\n          actions_taken.append(act)\n          steps += 1\n          continue\n      else:\n          act = step_towards(state, target)\n          if act is None:\n              break\n          env.step(act)\n          actions_taken.append(act)\n          steps += 1\n          continue\n\n  return actions_taken", "env_interactions": 0, "island_id": 7, "scores": {"3": -1}}
