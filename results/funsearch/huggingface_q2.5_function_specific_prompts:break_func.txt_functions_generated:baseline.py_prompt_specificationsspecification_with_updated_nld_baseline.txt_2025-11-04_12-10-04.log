{"timestamp": "2025-11-04T12:42:15.102866", "function_name": "break_func", "function_body": "  return []", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-11-04T12:42:45.323962", "function_name": "break_func", "function_body": "  import numpy as np\n\n  # ------------------------------------------------------------------\n  # action indices (as defined in CraftLab.action_specs)\n  # ------------------------------------------------------------------\n  action_map = env.action_specs()\n  DOWN = action_map.get(\"DOWN\", 0)\n  UP = action_map.get(\"UP\", 1)\n  LEFT = action_map.get(\"LEFT\", 2)\n  RIGHT = action_map.get(\"RIGHT\", 3)\n  USE = action_map.get(\"USE\", 4)\n\n  # ------------------------------------------------------------------\n  # helper utilities\n  # ------------------------------------------------------------------\n  def _find_cells(grid, kind):\n      \"\"\"Return list of (x, y) positions where grid[..., kind] > 0.\"\"\"\n      occ = grid[:, :, kind] > 0\n      xs, ys = np.where(occ)\n      return list(zip(xs.tolist(), ys.tolist()))\n\n  def _manhattan(p1, p2):\n      return abs(p1[0] - p2[0]) + abs(p1[1] - p2[1])\n\n  def _step(action):\n      \"\"\"Execute a single action in the env and return the new state.\"\"\"\n      env.step(action)\n      return env._current_state\n\n  def _move_towards(state, target, actions):\n      \"\"\"Append actions that move the agent from its current position to target.\"\"\"\n      cur = list(state.pos)\n      while cur[0] != target[0] or cur[1] != target[1]:\n          if cur[0] < target[0]:\n              actions.append(RIGHT)\n              cur[0] += 1\n          elif cur[0] > target[0]:\n              actions.append(LEFT)\n              cur[0] -= 1\n          elif cur[1] < target[1]:\n              actions.append(DOWN)\n              cur[1] += 1\n          elif cur[1] > target[1]:\n              actions.append(UP)\n              cur[1] -= 1\n          # apply step to keep env state consistent\n          _step(actions[-1])\n          # refresh state reference\n          state = env._current_state\n\n  def _face_and_use(state, target, actions):\n      \"\"\"\n      Agent is assumed to be on a cell adjacent to `target`.\n      It will turn towards the target (by issuing a directional action,\n      which may be blocked) and then perform USE.\n      \"\"\"\n      ax, ay = state.pos\n      tx, ty = target\n      if tx > ax:\n          actions.append(RIGHT)\n      elif tx < ax:\n          actions.append(LEFT)\n      elif ty > ay:\n          actions.append(DOWN)\n      elif ty < ay:\n          actions.append(UP)\n      # direction change (may not move)\n      if actions:\n          _step(actions[-1])\n      actions.append(USE)\n      _step(USE)\n\n  # ------------------------------------------------------------------\n  # start solving\n  # ------------------------------------------------------------------\n  obs = env.reset()\n  state = env._current_state\n\n  # decode goal\n  goal = env.task.goal\n  if isinstance(goal, tuple):\n      goal_name, goal_idx = goal\n  else:\n      goal_name = goal\n      goal_idx = env.world.cookbook.index[goal_name]\n\n  # primitive requirements for the goal (direct primitives only)\n  required_counts = dict(env.world.cookbook.primitives_for(goal_idx))\n\n  actions = []\n\n  # main loop\n  while True:\n      # termination check\n      if env._is_done():\n          break\n\n      state = env._current_state\n      inv = state.inventory\n\n      # update requirements based on inventory\n      for prim_idx, needed in list(required_counts.items()):\n          have = int(inv[prim_idx])\n          if have >= needed:\n              del required_counts[prim_idx]\n\n      # if all primitives gathered, go to workshop (if any) and craft\n      if not required_counts:\n          recipe = env.world.cookbook.recipes.get(goal_idx, {})\n          workshop_idx = recipe.get(\"_at\")\n          if workshop_idx is None:\n              # goal is a primitive; nothing else to do\n              break\n\n          # locate workshop cells\n          workshop_cells = _find_cells(state.grid, workshop_idx)\n          if not workshop_cells:\n              break  # cannot find workshop\n\n          # choose nearest workshop\n          cur_pos = state.pos\n          workshop_target = min(workshop_cells, key=lambda p: _manhattan(cur_pos, p))\n\n          # find an adjacent empty cell to stand on\n          wx, wy = workshop_target\n          adj_candidates = [(wx - 1, wy), (wx + 1, wy), (wx, wy - 1), (wx, wy + 1)]\n          valid_adj = [\n              (ax, ay)\n              for ax, ay in adj_candidates\n              if 0 <= ax < state.grid.shape[0]\n              and 0 <= ay < state.grid.shape[1]\n              and not state.grid[ax, ay].any()\n          ]\n          if not valid_adj:\n              adj_pos = workshop_target\n          else:\n              adj_pos = min(valid_adj, key=lambda p: _manhattan(cur_pos, p))\n\n          # move to adjacent position\n          _move_towards(state, adj_pos, actions)\n\n          # face workshop and use (craft)\n          _face_and_use(env._current_state, workshop_target, actions)\n\n          # after crafting loop will exit on done condition\n          continue\n\n      # --------------------------------------------------------------\n      # need to collect a missing primitive\n      # --------------------------------------------------------------\n      # pick a primitive that is still needed (simple heuristic)\n      target_prim = next(iter(required_counts))\n      prim_cells = _find_cells(state.grid, target_prim)\n      if not prim_cells:\n          break  # cannot find required primitive\n\n      # choose nearest primitive cell\n      cur_pos = state.pos\n      prim_target = min(prim_cells, key=lambda p: _manhattan(cur_pos, p))\n\n      # find adjacent empty cell to stand on\n      px, py = prim_target\n      adj_candidates = [(px - 1, py), (px + 1, py), (px, py - 1), (px, py + 1)]\n      valid_adj = [\n          (ax, ay)\n          for ax, ay in adj_candidates\n          if 0 <= ax < state.grid.shape[0]\n          and 0 <= ay < state.grid.shape[1]\n          and not state.grid[ax, ay].any()\n      ]\n      if not valid_adj:\n          # cannot approach this primitive; abort\n          break\n      adj_pos = min(valid_adj, key=lambda p: _manhattan(cur_pos, p))\n\n      # move to adjacent position\n      _move_towards(state, adj_pos, actions)\n\n      # face primitive and use to pick up\n      _face_and_use(env._current_state, prim_target, actions)\n\n  # return the accumulated action list\n  return actions", "env_interactions": 0, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-11-04T12:42:46.461577", "function_name": "break_func", "function_body": "  import numpy as np\n\n  # action indices (as defined in CraftLab.action_specs)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # helper utilities\n  # ------------------------------------------------------------------\n  def _find_cells(grid, kind):\n      \"\"\"Return list of (x, y) positions where grid[..., kind] > 0.\"\"\"\n      occ = grid[:, :, kind] > 0\n      xs, ys = np.where(occ)\n      return list(zip(xs.tolist(), ys.tolist()))\n\n  def _manhattan(p1, p2):\n      return abs(p1[0] - p2[0]) + abs(p1[1] - p2[1])\n\n  def _move_towards(state, target, actions):\n      \"\"\"Append actions that move the agent from its current position to target.\"\"\"\n      cur = list(state.pos)\n      while cur[0] != target[0] or cur[1] != target[1]:\n          if cur[0] < target[0]:\n              actions.append(RIGHT)\n              cur[0] += 1\n          elif cur[0] > target[0]:\n              actions.append(LEFT)\n              cur[0] -= 1\n          elif cur[1] < target[1]:\n              actions.append(DOWN)\n              cur[1] += 1\n          elif cur[1] > target[1]:\n              actions.append(UP)\n              cur[1] -= 1\n          # apply the action to keep the internal state in sync\n          _, done, _ = env.step(actions[-1])\n          if done:\n              break\n\n  def _face_and_use(state, target, actions):\n      \"\"\"\n      Agent is assumed to be on a cell adjacent to `target`.\n      Turn towards the target (direction action may be blocked) then USE.\n      \"\"\"\n      ax, ay = state.pos\n      tx, ty = target\n      if tx > ax:\n          actions.append(RIGHT)\n      elif tx < ax:\n          actions.append(LEFT)\n      elif ty > ay:\n          actions.append(DOWN)\n      elif ty < ay:\n          actions.append(UP)\n      # update direction (may not move)\n      env.step(actions[-1])\n      actions.append(USE)\n      env.step(USE)\n\n  # ------------------------------------------------------------------\n  # start solving\n  # ------------------------------------------------------------------\n  # reset environment and obtain initial observation / state\n  env.reset()\n  state = env._current_state\n\n  # decode the goal (could be a tuple or a string)\n  goal = env.task.goal\n  if isinstance(goal, tuple):\n      goal_name, goal_idx = goal\n  else:\n      goal_name = goal\n      goal_idx = env.world.cookbook.index[goal_name]\n\n  # primitive requirements for the goal (direct primitives only)\n  primitive_reqs = env.world.cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n  required_counts = dict(primitive_reqs)  # mutable copy\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # main loop: collect needed primitives, then craft at workshop\n  # ------------------------------------------------------------------\n  while True:\n      # termination check\n      if env._is_done():\n          break\n\n      # refresh state reference after each step\n      state = env._current_state\n\n      # update inventory and remove satisfied primitives\n      inv = state.inventory\n      for prim_idx, needed in list(required_counts.items()):\n          if int(inv[prim_idx]) >= needed:\n              del required_counts[prim_idx]\n\n      # if all primitives gathered, go to workshop (if any) and craft\n      if not required_counts:\n          recipe = env.world.cookbook.recipes.get(goal_idx, {})\n          workshop_idx = recipe.get(\"_at\")\n          if workshop_idx is None:\n              # goal is a primitive itself; we are done\n              break\n          workshop_cells = _find_cells(state.grid, workshop_idx)\n          if not workshop_cells:\n              break  # cannot find workshop\n          # choose nearest workshop cell\n          cur_pos = state.pos\n          workshop_target = min(workshop_cells, key=lambda p: _manhattan(cur_pos, p))\n\n          # find an adjacent empty cell to stand on\n          wx, wy = workshop_target\n          adj_candidates = [(wx - 1, wy), (wx + 1, wy), (wx, wy - 1), (wx, wy + 1)]\n          valid_adj = [\n              (ax, ay)\n              for ax, ay in adj_candidates\n              if 0 <= ax < state.grid.shape[0]\n              and 0 <= ay < state.grid.shape[1]\n              and not state.grid[ax, ay].any()\n          ]\n          if not valid_adj:\n              adj_pos = workshop_target\n          else:\n              adj_pos = min(valid_adj, key=lambda p: _manhattan(cur_pos, p))\n\n          # move adjacent to workshop\n          _move_towards(state, adj_pos, actions)\n\n          # face workshop and use (craft)\n          _face_and_use(state, workshop_target, actions)\n\n          # after crafting loop will detect goal satisfaction\n          continue\n\n      # ------------------------------------------------------------------\n      # need to collect a missing primitive\n      # ------------------------------------------------------------------\n      # pick a primitive that is still needed (simple heuristic: first)\n      target_prim = next(iter(required_counts))\n      prim_cells = _find_cells(state.grid, target_prim)\n      if not prim_cells:\n          break  # primitive not present in the world\n\n      # choose nearest primitive cell\n      cur_pos = state.pos\n      prim_target = min(prim_cells, key=lambda p: _manhattan(cur_pos, p))\n\n      # find adjacent empty cell to stand on\n      px, py = prim_target\n      adj_candidates = [(px - 1, py), (px + 1, py), (px, py - 1), (px, py + 1)]\n      valid_adj = [\n          (ax, ay)\n          for ax, ay in adj_candidates\n          if 0 <= ax < state.grid.shape[0]\n          and 0 <= ay < state.grid.shape[1]\n          and not state.grid[ax, ay].any()\n      ]\n      if not valid_adj:\n          break  # cannot approach this primitive\n      adj_pos = min(valid_adj, key=lambda p: _manhattan(cur_pos, p))\n\n      # move adjacent to primitive\n      _move_towards(state, adj_pos, actions)\n\n      # face primitive and use to pick it up\n      _face_and_use(state, prim_target, actions)\n\n  # return the accumulated action list\n  return actions", "env_interactions": 0, "island_id": 7, "scores": {"3": 0.0}}
