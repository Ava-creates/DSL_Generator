{"timestamp": "2025-11-04T12:49:42.278637", "function_name": "break_func", "function_body": "  return None", "env_interactions": 0, "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-11-04T12:49:43.408280", "function_name": "break_func", "function_body": "  # Map direction strings to action indices (consistent with CraftWorld action ordering)\n  act_map = {\"DOWN\": 0, \"UP\": 1, \"LEFT\": 2, \"RIGHT\": 3}\n  # Accept either string or already\u2011upper\u2011cased key\n  dir_key = dir.upper() if isinstance(dir, str) else dir\n  action_dir = act_map.get(dir_key)\n  if action_dir is None:\n      raise ValueError(f\"Unknown direction {dir!r}\")\n  # First, turn towards the obstacle (by attempting to move into it, which updates direction)\n  # Then use the tool with the USE action (index 4)\n  return [action_dir, 4]", "env_interactions": 0, "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-11-04T12:50:02.085184", "function_name": "break_func", "function_body": "  if not hasattr(env, \"world\") or not hasattr(env.world, \"n_actions\"):\n      return np.array([], dtype=np.int32)\n  return np.zeros(env.world.n_actions, dtype=np.int32)", "env_interactions": 5, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-11-04T12:50:03.215385", "function_name": "break_func", "function_body": "  import numpy as np\n\n  # Validate environment and state\n  if not hasattr(env, \"_current_state\") or not hasattr(env, \"world\"):\n      return np.array([], dtype=np.int32)\n\n  state = env._current_state\n\n  # Assume action ordering: DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n  USE_IDX = 4\n  n_actions = getattr(env.world, \"n_actions\", 5)\n  mask = np.zeros(n_actions, dtype=np.int32)\n\n  # Mapping from direction string to coordinate offset\n  dir_vectors = {\n      \"down\": (1, 0),\n      \"up\": (-1, 0),\n      \"left\": (0, -1),\n      \"right\": (0, 1),\n      \"south\": (1, 0),\n      \"north\": (-1, 0),\n      \"west\": (0, -1),\n      \"east\": (0, 1),\n  }\n\n  d = dir.lower()\n  if d not in dir_vectors:\n      return mask\n\n  dx, dy = dir_vectors[d]\n  x, y = state.pos\n  nx, ny = x + dx, y + dy\n\n  # Check bounds\n  grid_shape = state.grid.shape[:2]\n  if not (0 <= nx < grid_shape[0] and 0 <= ny < grid_shape[1]):\n      return mask\n\n  cell = state.grid[nx, ny]\n  if not cell.any():\n      return mask\n\n  kind = int(np.argmax(cell))\n\n  # If the adjacent cell contains a non\u2011grabbable (obstacle) entity,\n  # allow the USE action to attempt breaking it.\n  if hasattr(env.world, \"non_grabbable_indices\") and kind in env.world.non_grabbable_indices:\n      mask[USE_IDX] = 1\n\n  return mask", "env_interactions": 0, "island_id": 0, "scores": {"3": -1}}
