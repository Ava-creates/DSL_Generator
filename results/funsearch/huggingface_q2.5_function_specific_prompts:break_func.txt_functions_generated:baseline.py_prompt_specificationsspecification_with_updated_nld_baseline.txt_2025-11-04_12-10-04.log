{"timestamp": "2025-11-04T14:27:01.503587", "function_name": "break_func", "function_body": "  # No operation policy: return an empty list of actions.\n  return []", "env_interactions": 0, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-11-04T14:27:20.243815", "function_name": "break_func", "function_body": "  import random\n  # Reset environment and get initial observation\n  obs = env.reset()\n  # Extract useful references\n  world = env.world\n  goal_idx = env.task.goal\n  # Determine primitive requirements for a single goal item\n  needed_prims = world.cookbook.primitives_for(goal_idx)  # dict {prim_idx: count}\n  # If no recipe (primitive itself), just need to collect it\n  if not needed_prims:\n      needed_prims = {goal_idx: 1}\n  actions_taken = []\n\n  # Helper to decode direction one\u2011hot\n  def current_dir_onehot(dir_vec):\n      for i, v in enumerate(dir_vec):\n          if v > 0.5:\n              return i\n      return 0\n\n  # Mapping from direction index to action id (same ordering as env.action_specs)\n  DIR_TO_ACTION = {0: 0,  # DOWN\n                   1: 1,  # UP\n                   2: 3,  # LEFT (note: env uses LEFT=2, RIGHT=3; we map after)\n                   3: 2}  # RIGHT\n\n  # Main loop\n  while True:\n      # Check termination condition\n      if env._is_done():\n          break\n      # Get latest observation dict\n      obs_dict = env.observations()\n      features = obs_dict[\"features_dict\"]\n      inventory = features[\"inventory\"]\n      # Goal satisfied?\n      if inventory[goal_idx] > 0:\n          break\n      # Determine which primitives are still missing\n      missing = {}\n      for p_idx, cnt in needed_prims.items():\n          have = inventory[p_idx] if p_idx < len(inventory) else 0\n          if have < cnt:\n              missing[p_idx] = cnt - have\n      # If nothing missing (maybe need to craft at workshop)\n      if not missing:\n          # Look for workshop of the goal item in view and try to USE\n          ego = features[\"features_ego\"]\n          w = ego.shape[0]\n          center = w // 2\n          goal_output = goal_idx\n          # Find workshop cell (identified by the recipe key \"_at\")\n          # Simplify: try USE in front\n          action = 4  # USE\n          actions_taken.append(action)\n          _, _ = env.step(action)\n          continue\n\n      # Scan egocentric view for needed primitives\n      ego = features[\"features_ego\"]\n      w = ego.shape[0]\n      center = w // 2\n      target_dir = None\n      min_dist = w * w\n      for i in range(w):\n          for j in range(w):\n              if i == center and j == center:\n                  continue\n              cell_vec = ego[i, j, :]\n              # check if any needed primitive present\n              for p_idx in missing:\n                  if cell_vec[p_idx] > 0:\n                      dist = abs(i - center) + abs(j - center)\n                      if dist < min_dist:\n                          min_dist = dist\n                          # Determine primary direction towards this cell\n                          di = i - center\n                          dj = j - center\n                          if abs(di) >= abs(dj):\n                              target_dir = 1 if di < 0 else 0  # UP or DOWN\n                          else:\n                              target_dir = 3 if dj > 0 else 2  # RIGHT or LEFT\n      # If we found a direction towards needed primitive\n      if target_dir is not None:\n          # Check if the primitive is adjacent (Manhattan distance == 1)\n          if min_dist == 1:\n              # Ensure we are facing it before using\n              cur_dir_vec = features[\"direction\"]\n              cur_dir = current_dir_onehot(cur_dir_vec)\n              if cur_dir != target_dir:\n                  # Move action also sets direction, so just move\n                  action = DIR_TO_ACTION[target_dir]\n              else:\n                  action = 4  # USE to collect\n          else:\n              # Move towards the target direction\n              action = DIR_TO_ACTION[target_dir]\n      else:\n          # No needed primitive in view: take random movement\n          action = random.choice([0, 1, 2, 3])\n      # Execute action\n      actions_taken.append(action)\n      _, _ = env.step(action)\n  # Return the sequence of actions taken\n  return actions_taken", "env_interactions": 0, "island_id": 9, "scores": {"3": -1}}
