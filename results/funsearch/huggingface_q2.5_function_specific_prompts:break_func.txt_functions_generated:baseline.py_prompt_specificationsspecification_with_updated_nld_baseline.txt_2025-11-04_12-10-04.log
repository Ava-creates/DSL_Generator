{"timestamp": "2025-11-04T12:30:10.709335", "function_name": "break_func", "function_body": "  import numpy as np\n\n  # Mapping from action names to indices\n  action_map = env.action_specs()\n  use_action = action_map.get(\"USE\", 4)\n\n  # Goal index and required primitive counts\n  goal_idx = env.task.goal\n  primitive_reqs = env.world.cookbook.primitives_for(goal_idx)\n\n  # If there are no primitive requirements (goal is a primitive), do nothing\n  if not primitive_reqs:\n      return []\n\n  actions = []\n  state = env._current_state\n\n  # Simple loop: move toward needed primitives and use them\n  for _ in range(env.max_steps):\n      # Check if goal already satisfied\n      if state.satisfies(None, goal_idx):\n          break\n\n      # Determine which primitives are still needed\n      needed = {\n          kind: cnt - state.inventory[kind]\n          for kind, cnt in primitive_reqs.items()\n          if state.inventory[kind] < cnt\n      }\n\n      # If we still need primitives, locate the nearest required one\n      if needed:\n          # Find a target cell containing any needed primitive\n          target_pos = None\n          target_kind = None\n          min_dist = None\n          for kind in needed:\n              # Positions where this kind exists on the grid\n              positions = np.argwhere(state.grid[:, :, kind] > 0)\n              if positions.size == 0:\n                  continue\n              # Choose the closest position (Manhattan distance)\n              for pos in positions:\n                  dist = abs(pos[0] - state.pos[0]) + abs(pos[1] - state.pos[1])\n                  if (min_dist is None) or (dist < min_dist):\n                      min_dist = dist\n                      target_pos = pos\n                      target_kind = kind\n          # If we found a target, move toward it (or USE if adjacent)\n          if target_pos is not None:\n              dy = target_pos[0] - state.pos[0]\n              dx = target_pos[1] - state.pos[1]\n              if abs(dy) + abs(dx) == 1:\n                  # Adjacent cell: use action to collect/craft\n                  chosen_action = use_action\n              else:\n                  # Move in a cardinal direction that reduces Manhattan distance\n                  if dy != 0:\n                      chosen_action = (\n                          action_map[\"DOWN\"] if dy > 0 else action_map[\"UP\"]\n                      )\n                  else:\n                      chosen_action = (\n                          action_map[\"RIGHT\"] if dx > 0 else action_map[\"LEFT\"]\n                      )\n              reward, new_state = state.step(chosen_action)\n              state = new_state\n              actions.append(chosen_action)\n              continue\n\n      # If no needed primitives are reachable (or none left), break\n      break\n\n  return actions", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
