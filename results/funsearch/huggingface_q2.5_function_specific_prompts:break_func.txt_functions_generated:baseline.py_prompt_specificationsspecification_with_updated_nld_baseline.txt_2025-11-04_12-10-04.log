{"timestamp": "2025-11-04T13:19:48.471548", "function_name": "break_func", "function_body": "  import numpy as np\n\n  actions = []\n  max_steps = 1000\n\n  # Mapping from action names to indices\n  action_map = env.action_specs()\n  direction_names = [\"DOWN\", \"UP\", \"LEFT\", \"RIGHT\"]\n  direction_actions = [action_map[d] for d in direction_names if d in action_map]\n  use_action = action_map.get(\"USE\")\n\n  for _ in range(max_steps):\n      # Try to use (collect/craft) if possible; otherwise move randomly\n      if use_action is not None:\n          a = use_action\n      elif direction_actions:\n          a = int(np.random.choice(direction_actions))\n      else:\n          break\n\n      _, done, _ = env.step(int(a))\n      actions.append(int(a))\n\n      if done:\n          break\n\n  return actions", "env_interactions": 0, "island_id": 9, "scores": {"3": -1}}
