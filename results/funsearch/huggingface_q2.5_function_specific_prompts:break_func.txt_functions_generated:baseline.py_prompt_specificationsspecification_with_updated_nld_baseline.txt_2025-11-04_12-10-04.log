{"timestamp": "2025-11-04T14:14:56.639282", "function_name": "break_func", "function_body": "  import numpy as np\n\n  # Get current state and position\n  state = env._current_state\n  x, y = state.pos\n\n  # Resolve direction to a delta\n  dir_vectors = {\n      \"UP\": (0, -1),\n      \"DOWN\": (0, 1),\n      \"LEFT\": (-1, 0),\n      \"RIGHT\": (1, 0),\n  }\n  if isinstance(dir, str):\n      dx, dy = dir_vectors.get(dir.upper(), (0, 0))\n  else:\n      # Fallback: assume integer direction (0:DOWN,1:UP,2:LEFT,3:RIGHT)\n      int_dirs = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n      dx, dy = int_dirs[dir % 4]\n\n  nx, ny = x + dx, y + dy\n  grid = state.grid\n\n  # Check bounds\n  if not (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]):\n      return []\n\n  # Identify the kind present in the adjacent cell (if any)\n  cell = grid[nx, ny]\n  if not cell.any():\n      return []\n  i_kind = int(np.argmax(cell))\n\n  # Map known obstacles to the tool required to break them\n  world = env.world\n  obstacle_to_tool = {\n      getattr(world, \"water_index\", None): \"boat\",\n      getattr(world, \"stone_index\", None): \"pickaxe\",\n      getattr(world, \"tree_index\", None): \"axe\",\n  }\n  tool_name = obstacle_to_tool.get(i_kind)\n  if not tool_name:\n      return []\n\n  # Look up the tool's index in the cookbook\n  tool_idx = world.cookbook.index.index(tool_name)\n\n  # If we already have the tool, the action to use it is the USE action (index 4)\n  if state.inventory[tool_idx] > 0:\n      return [4]  # USE action\n\n  # No suitable tool available \u2013 cannot break the obstacle now\n  return []", "env_interactions": 0, "island_id": 9, "scores": {"3": 0.0}}
