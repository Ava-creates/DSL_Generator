{"timestamp": "2025-11-04T12:46:13.509369", "function_name": "break_func", "function_body": "  import numpy as np\n\n  # Reset the environment and obtain the initial observation\n  obs = env.reset()\n\n  # Determine the goal item index (if available)\n  try:\n      goal_idx = env.task.goal\n  except Exception:\n      goal_idx = None\n\n  # Prepare action space and loop limits\n  action_space = list(env.action_specs().values())\n  max_steps = getattr(env, \"max_steps\", 1000)\n\n  actions_taken = []\n\n  for _ in range(max_steps):\n      # Check if the goal has been satisfied via the inventory vector\n      inventory = obs.get(\"features_dict\", {}).get(\"inventory\")\n      if inventory is not None and goal_idx is not None and inventory[goal_idx] > 0:\n          break\n\n      # Choose a random action from the available actions\n      action = np.random.choice(action_space)\n      reward, done, obs = env.step(int(action))\n\n      actions_taken.append(int(action))\n\n      if done:\n          break\n\n  return actions_taken", "env_interactions": 0, "island_id": 0, "scores": {"3": -1}}
