{"timestamp": "2025-11-04T12:35:17.552640", "function_name": "break_func", "function_body": "  # Use the most advanced breaking strategy.\n  # Return a callable that, given a direction string, invokes break_func_v2.\n  return lambda dir: break_func_v2(env, dir)", "env_interactions": 0, "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-11-04T12:35:41.042362", "function_name": "break_func", "function_body": "  import numpy as np\n\n  # action indices (as defined in CraftLab.action_specs)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # helper utilities\n  # ------------------------------------------------------------------\n  def _find_cells(grid, kind):\n      \"\"\"Return list of (x, y) positions where grid[..., kind] > 0.\"\"\"\n      occ = grid[:, :, kind] > 0\n      xs, ys = np.where(occ)\n      return list(zip(xs.tolist(), ys.tolist()))\n\n  def _manhattan(p1, p2):\n      return abs(p1[0] - p2[0]) + abs(p1[1] - p2[1])\n\n  def _move_towards(state, target, actions):\n      \"\"\"Append actions that move the agent from its current position to target.\"\"\"\n      cur = list(state.pos)\n      while cur[0] != target[0] or cur[1] != target[1]:\n          if cur[0] < target[0]:\n              actions.append(RIGHT)\n              cur[0] += 1\n          elif cur[0] > target[0]:\n              actions.append(LEFT)\n              cur[0] -= 1\n          elif cur[1] < target[1]:\n              actions.append(DOWN)\n              cur[1] += 1\n          elif cur[1] > target[1]:\n              actions.append(UP)\n              cur[1] -= 1\n          # apply the action to keep the internal state in sync\n          _, done, _ = env.step(actions[-1])\n          if done:\n              break\n\n  def _face_and_use(state, target, actions):\n      \"\"\"\n      Agent is assumed to be on a cell adjacent to `target`.\n      It will turn towards the target (by issuing a directional action that may be blocked)\n      and then perform USE.\n      \"\"\"\n      ax, ay = state.pos\n      tx, ty = target\n      # decide required facing direction\n      if tx > ax:\n          actions.append(RIGHT)\n      elif tx < ax:\n          actions.append(LEFT)\n      elif ty > ay:\n          actions.append(DOWN)\n      elif ty < ay:\n          actions.append(UP)\n      else:\n          # already on the target cell (should not happen for primitives)\n          pass\n      # the directional action may not move (blocked) but updates direction\n      env.step(actions[-1])\n      actions.append(USE)\n      env.step(USE)\n\n  # ------------------------------------------------------------------\n  # start solving\n  # ------------------------------------------------------------------\n  # reset environment and obtain initial observation\n  obs = env.reset()\n  state = env._current_state\n\n  # decode the goal (may be a tuple or a string)\n  goal = env.task.goal\n  if isinstance(goal, tuple):\n      goal_name, goal_idx = goal\n  else:\n      # goal is a string name; look up its index via the world cookbook\n      goal_name = goal\n      goal_idx = env.world.cookbook.index[goal_name]\n\n  # compute primitive requirements for the goal (direct primitives only)\n  primitive_reqs = env.world.cookbook.primitives_for(goal_idx)  # dict {prim_idx: count}\n  required_counts = dict(primitive_reqs)  # make a mutable copy\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # main loop: collect needed primitives, then craft at workshop\n  # ------------------------------------------------------------------\n  while True:\n      # check termination condition\n      if env._is_done():\n          break\n\n      # refresh state reference after each step\n      state = env._current_state\n\n      # update inventory counts for required primitives\n      inv = state.inventory\n      for prim_idx, needed in list(required_counts.items()):\n          have = int(inv[prim_idx])\n          if have >= needed:\n              # requirement satisfied, remove from dict\n              del required_counts[prim_idx]\n\n      # if all primitives gathered, go to workshop and craft\n      if not required_counts:\n          # locate workshop for the goal\n          recipe = env.world.cookbook.recipes.get(goal_idx, {})\n          workshop_idx = recipe.get(\"_at\")\n          if workshop_idx is None:\n              # no workshop needed; goal might be a primitive itself\n              break\n          workshop_cells = _find_cells(state.grid, workshop_idx)\n          if not workshop_cells:\n              # cannot find workshop \u2013 abort\n              break\n          # choose the nearest workshop cell\n          cur_pos = state.pos\n          workshop_target = min(workshop_cells, key=lambda p: _manhattan(cur_pos, p))\n\n          # compute an adjacent empty cell to the workshop\n          wx, wy = workshop_target\n          adj_candidates = [\n              (wx - 1, wy), (wx + 1, wy), (wx, wy - 1), (wx, wy + 1)\n          ]\n          # filter valid and empty cells\n          valid_adj = [\n              (ax, ay) for ax, ay in adj_candidates\n              if 0 <= ax < state.grid.shape[0] and 0 <= ay < state.grid.shape[1]\n              and not state.grid[ax, ay].any()\n          ]\n          if not valid_adj:\n              # fallback: try to stand on the workshop cell itself (may be allowed)\n              adj_pos = workshop_target\n          else:\n              # choose the closest adjacent cell\n              adj_pos = min(valid_adj, key=lambda p: _manhattan(cur_pos, p))\n\n          # move to the adjacent position\n          _move_towards(state, adj_pos, actions)\n\n          # face the workshop and use (craft)\n          _face_and_use(state, workshop_target, actions)\n\n          # after crafting, loop will detect goal satisfaction and exit\n          continue\n\n      # ------------------------------------------------------------------\n      # need to collect a missing primitive\n      # ------------------------------------------------------------------\n      # pick the primitive with the largest shortfall\n      missing = {\n          k: max(0, required_counts[k] - int(inv[k]))\n          for k in required_counts\n      }\n      # select one primitive to fetch (simple heuristic: first)\n      target_prim = next(iter(missing.keys()))\n      # locate all cells containing this primitive\n      prim_cells = _find_cells(state.grid, target_prim)\n      if not prim_cells:\n          # primitive not present \u2013 cannot proceed\n          break\n      # choose the nearest primitive cell\n      cur_pos = state.pos\n      prim_target = min(prim_cells, key=lambda p: _manhattan(cur_pos, p))\n\n      # find an adjacent empty cell to stand on\n      px, py = prim_target\n      adj_candidates = [\n          (px - 1, py), (px + 1, py), (px, py - 1), (px, py + 1)\n      ]\n      valid_adj = [\n          (ax, ay) for ax, ay in adj_candidates\n          if 0 <= ax < state.grid.shape[0] and 0 <= ay < state.grid.shape[1]\n          and not state.grid[ax, ay].any()\n      ]\n      if not valid_adj:\n          # cannot approach this primitive, try another one\n          # remove this primitive from consideration for this iteration\n          # (could also try a different adjacent side of same primitive)\n          # for simplicity, break the loop\n          break\n      adj_pos = min(valid_adj, key=lambda p: _manhattan(cur_pos, p))\n\n      # move to the adjacent position\n      _move_towards(state, adj_pos, actions)\n\n      # face the primitive and use to pick it up\n      _face_and_use(state, prim_target, actions)\n\n  # return the accumulated action list\n  return actions", "env_interactions": 0, "island_id": 7, "scores": {"3": 0.0}}
