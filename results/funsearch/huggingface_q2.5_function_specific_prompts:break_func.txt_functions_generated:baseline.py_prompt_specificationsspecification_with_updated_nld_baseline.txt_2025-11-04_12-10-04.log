{"timestamp": "2025-11-04T13:28:03.064458", "function_name": "break_func", "function_body": "  import numpy as np\n\n  # Mapping from direction string to movement action index (as used in CraftLab)\n  dir_to_action = {\"down\": 0, \"up\": 1, \"left\": 2, \"right\": 3}\n  # The USE action is always index 4 in the default action set\n  USE_ACTION = 4\n\n  # Get the current state from the environment\n  state = env._current_state\n  pos_x, pos_y = state.pos\n\n  # Normalise direction argument\n  dir_key = str(dir).strip().lower()\n  if dir_key not in dir_to_action:\n      # Unknown direction \u2013 nothing to do\n      return []\n\n  move_action = dir_to_action[dir_key]\n\n  # Compute neighbour coordinates according to the chosen direction\n  if move_action == 0:      # DOWN  (y + 1)\n      nx, ny = pos_x, pos_y + 1\n  elif move_action == 1:    # UP    (y - 1)\n      nx, ny = pos_x, pos_y - 1\n  elif move_action == 2:    # LEFT  (x - 1)\n      nx, ny = pos_x - 1, pos_y\n  else:                     # RIGHT (x + 1)\n      nx, ny = pos_x + 1, pos_y\n\n  # Bounds check \u2013 if out of grid we cannot break anything\n  max_x, max_y, _ = state.grid.shape\n  if not (0 <= nx < max_x and 0 <= ny < max_y):\n      return []\n\n  # Identify the kind occupying the neighbour cell (if any)\n  cell_vec = state.grid[nx, ny, :]\n  if cell_vec.sum() == 0:\n      # Empty cell \u2013 nothing to break\n      return []\n\n  # Index of the entity kind present in the neighbour cell\n  neighbour_kind = int(np.argmax(cell_vec))\n\n  # Determine which kinds are breakable obstacles (water or stone)\n  breakable_kinds = {env.world.water_index, env.world.stone_index}\n  if neighbour_kind not in breakable_kinds:\n      # Not a breakable obstacle\n      return []\n\n  # Return the sequence: first issue the move action to set the facing direction,\n  # then issue the USE action to attempt breaking the obstacle.\n  return [move_action, USE_ACTION]", "env_interactions": 0, "island_id": 9, "scores": {"3": 0.0}}
