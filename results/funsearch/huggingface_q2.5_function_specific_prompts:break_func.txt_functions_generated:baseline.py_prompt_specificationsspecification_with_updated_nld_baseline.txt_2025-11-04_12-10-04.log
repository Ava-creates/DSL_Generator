{"timestamp": "2025-11-04T13:57:07.100589", "function_name": "break_func", "function_body": "  import collections\n  import numpy as np\n\n  # Reset the environment and obtain the initial state\n  env.reset()\n  state = env._current_state\n\n  # Helper: shortest path (BFS) to a target cell while avoiding any occupied cells\n  def bfs_path(start, targets, needed_dirs):\n      \"\"\"Find a path from start to any of the target cells such that the last\n      move direction matches the required facing direction.\n\n      Args:\n          start: (x, y) tuple of current position.\n          targets: set of (x, y) positions that are acceptable goals.\n          needed_dirs: dict mapping (x, y) \u2192 direction that must be used\n                       for the last move to face the object.\n\n      Returns:\n          List[int] of actions (0=DOWN,1=UP,2=LEFT,3=RIGHT) leading to the goal,\n          or empty list if no path found.\n      \"\"\"\n      width, height = state.grid.shape[:2]\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      # direction vectors aligned with action indices\n      dirs = [(0, 1), (0, -1), (-1, 0), (1, 0)]  # DOWN, UP, LEFT, RIGHT\n      while q:\n          x, y, path = q.popleft()\n          if (x, y) in targets:\n              # verify the last move direction (if any) is the one we need\n              if not path:\n                  # already on target \u2013 we will handle direction later\n                  return path\n              if path[-1] == needed_dirs[(x, y)]:\n                  return path\n          for a, (dx, dy) in enumerate(dirs):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n                  # can step only on completely empty cells\n                  if state.grid[nx, ny, :].sum() == 0:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [a]))\n      return []\n\n  # Helper: move to an entity (primitive or workshop) and USE it\n  def go_and_use(target_kind):\n      \"\"\"Return a list of actions that moves the agent adjacent to an entity\n      of kind ``target_kind`` and performs a USE action.\"\"\"\n      # locate all cells containing the target kind\n      positions = np.argwhere(state.grid[:, :, target_kind] > 0)\n      if positions.size == 0:\n          return []  # nothing to do\n      # choose the first occurrence\n      tx, ty = positions[0]\n      width, height = state.grid.shape[:2]\n\n      # candidate adjacent cells (must be empty) together with the direction\n      # needed for the final USE (i.e., direction we will be facing when we\n      # step onto the candidate cell)\n      adj_offsets = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n      candidates = set()\n      needed_dirs = {}\n      for dx, dy in adj_offsets:\n          cx, cy = tx + dx, ty + dy\n          if 0 <= cx < width and 0 <= cy < height:\n              if state.grid[cx, cy, :].sum() == 0:\n                  # direction needed to face the target after stepping onto (cx,cy)\n                  if dx == -1 and dy == 0:\n                      ndir = 3          # RIGHT\n                  elif dx == 1 and dy == 0:\n                      ndir = 2          # LEFT\n                  elif dx == 0 and dy == -1:\n                      ndir = 0          # DOWN\n                  else:  # dx == 0 and dy == 1\n                      ndir = 1          # UP\n                  candidates.add((cx, cy))\n                  needed_dirs[(cx, cy)] = ndir\n\n      # find a path to any candidate that ends with the correct facing direction\n      path = bfs_path(state.pos, candidates, needed_dirs)\n      if not path and (state.pos in candidates):\n          # already adjacent \u2013 we need to turn to the correct direction.\n          # Since turning is not a separate action, we move one step away and\n          # step back to set the direction.\n          # Choose any free neighbour to wiggle.\n          wiggle_dirs = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n          for a, (dx, dy) in enumerate(wiggle_dirs):\n              nx, ny = state.pos[0] + dx, state.pos[1] + dy\n              if 0 <= nx < width and 0 <= ny < height:\n                  if state.grid[nx, ny, :].sum() == 0:\n                      # move away then back using the needed direction\n                      back_dir = needed_dirs[state.pos]\n                      return [a, back_dir]\n          return []  # no wiggle possible\n      if not path:\n          return []  # no reachable candidate\n      # after reaching the adjacent cell, perform USE\n      return path + [4]  # 4 == USE\n\n  # Main planning loop\n  actions_plan = []\n  cookbook = env.world.cookbook\n  goal_arg = env.task.goal.arg\n  goal_name = getattr(env.task.goal, \"name\", None)\n\n  # safety limit to avoid infinite loops\n  step_limit = 2000\n  steps_taken = 0\n\n  while not state.satisfies(goal_name, goal_arg):\n      if steps_taken > step_limit:\n          break\n\n      # Determine which primitive resources are still missing\n      needed_prims = cookbook.primitives_for(goal_arg)\n      missing_prim = None\n      for prim_idx, req_cnt in needed_prims.items():\n          if state.inventory[prim_idx] < req_cnt:\n              missing_prim = prim_idx\n              break\n\n      if missing_prim is not None:\n          # Go to the missing primitive and collect it\n          seq = go_and_use(missing_prim)\n      else:\n          # All primitives are present \u2013 need to craft at the appropriate workshop\n          recipe = cookbook.recipes.get(goal_arg, {})\n          workshop_kind = recipe.get(\"_at\")\n          if workshop_kind is None:\n              # No recipe \u2013 cannot proceed\n              break\n          seq = go_and_use(workshop_kind)\n\n      if not seq:\n          # Nothing could be generated \u2013 abort\n          break\n\n      for a in seq:\n          reward, state = env.step(a)\n          actions_plan.append(a)\n          steps_taken += 1\n          if state.satisfies(goal_name, goal_arg):\n              break\n\n  return actions_plan", "env_interactions": 0, "island_id": 5, "scores": {"3": -1}}
