{"timestamp": "2025-11-04T12:47:49.397819", "function_name": "break_func", "function_body": "  # Initialize environment and get initial state\n  obs = env.reset()\n  state = env._current_state\n\n  # Action indices (matching CraftLab.action_specs())\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n  # Direction vectors corresponding to the above actions\n  DIRS = [\n      (1, 0, ACTION_DOWN),   # DOWN\n      (-1, 0, ACTION_UP),    # UP\n      (0, -1, ACTION_LEFT),  # LEFT\n      (0, 1, ACTION_RIGHT),  # RIGHT\n  ]\n\n  # Helper: check if a cell (r, c) is inside the grid bounds\n  def in_bounds(r, c):\n      return 0 <= r < state.grid.shape[0] and 0 <= c < state.grid.shape[1]\n\n  # Helper: find all positions of a given kind in the grid\n  def find_positions(kind):\n      idxs = np.argwhere(state.grid[:, :, kind] > 0)\n      return [(int(r), int(c)) for r, c in idxs]\n\n  # Goal kind index\n  goal_kind = env.task.goal\n\n  # Main action list to be returned\n  action_sequence = []\n\n  # Simple loop: keep acting until goal satisfied or step limit reached\n  max_steps = getattr(env, \"max_steps\", 1000)\n  steps = 0\n  while not state.satisfies(\"\", goal_kind) and steps < max_steps:\n      # 1. If any adjacent cell contains a needed item (any non\u2011zero kind), use it\n      used = False\n      for dr, dc, act_use in DIRS:\n          nr, nc = state.pos[0] + dr, state.pos[1] + dc\n          if in_bounds(nr, nc):\n              # check if there is any grab\u2011able entity in that cell\n              cell_contents = state.grid[nr, nc, :]\n              if np.any(cell_contents > 0):\n                  # Perform USE action\n                  reward, new_state = state.step(ACTION_USE)\n                  action_sequence.append(ACTION_USE)\n                  state = new_state\n                  used = True\n                  break\n      if used:\n          steps += 1\n          continue\n\n      # 2. Otherwise move towards the closest cell that contains any grab\u2011able entity\n      #    (primitives, crafted items, or workshop needed for crafting)\n      # Gather all candidate positions (any non\u2011zero kind)\n      candidates = np.argwhere(state.grid.reshape(-1, state.grid.shape[2]).any(axis=1))\n      # Convert flat indices back to 2\u2011D coordinates\n      candidates = [(int(idx // state.grid.shape[1]), int(idx % state.grid.shape[1]))\n                    for idx in candidates]\n      if not candidates:\n          # Nothing left to collect; break to avoid infinite loop\n          break\n\n      # Choose the nearest candidate by Manhattan distance\n      cur_r, cur_c = state.pos\n      target = min(candidates,\n                   key=lambda rc: abs(rc[0] - cur_r) + abs(rc[1] - cur_c))\n\n      # Determine step direction towards target\n      dr = target[0] - cur_r\n      dc = target[1] - cur_c\n      if abs(dr) > abs(dc):\n          move_dir = (np.sign(dr), 0)\n      else:\n          move_dir = (0, np.sign(dc))\n\n      # Map move_dir to action\n      for mv_dr, mv_dc, act in DIRS:\n          if (mv_dr, mv_dc) == move_dir:\n              reward, new_state = state.step(act)\n              action_sequence.append(act)\n              state = new_state\n              break\n\n      steps += 1\n\n  return action_sequence", "env_interactions": 0, "island_id": 9, "scores": {"3": -1}}
