{"timestamp": "2025-11-04T13:18:53.656582", "function_name": "break_func", "function_body": "  # Validate environment and action space\n  if not hasattr(env, \"world\") or not hasattr(env.world, \"n_actions\"):\n      return np.array([], dtype=np.int32)\n\n  # Initialize a mask of allowed actions (all zeros)\n  action_mask = np.zeros(env.world.n_actions, dtype=np.int32)\n\n  # Mapping from direction strings to movement action indices\n  dir_to_action = {\"DOWN\": 0, \"UP\": 1, \"LEFT\": 2, \"RIGHT\": 3}\n\n  # Always allow the USE action (index 4) to attempt breaking the obstacle\n  if env.world.n_actions > 4:\n      action_mask[4] = 1\n\n  # Optionally also allow moving towards the obstacle direction\n  if isinstance(dir, str):\n      dir = dir.upper()\n      if dir in dir_to_action and dir_to_action[dir] < env.world.n_actions:\n          action_mask[dir_to_action[dir]] = 1\n\n  return action_mask", "env_interactions": 5, "island_id": 0, "scores": {"3": 0.0}}
