{"timestamp": "2025-11-04T12:23:39.968478", "function_name": "break_func", "function_body": "  # If the environment does not expose the expected attributes, return an empty\n  # action vector.  This mirrors the behavior of the placeholder break functions.\n  if not hasattr(env, \"world\") or not hasattr(env.world, \"n_actions\"):\n      return np.array([], dtype=np.int32)\n\n  # No\u2011op policy: produce a vector of zeros with length equal to the number of\n  # possible actions.  The surrounding framework can interpret this as \u201cdo\n  # nothing\u201d or as a placeholder for a more sophisticated policy.\n  return np.zeros(env.world.n_actions, dtype=np.int32)", "env_interactions": 5, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-11-04T12:23:59.525914", "function_name": "break_func", "function_body": "  import numpy as np\n\n  # ----------------------------------------------------------------------\n  # Helper utilities\n  # ----------------------------------------------------------------------\n  def move_actions(cur_pos, target_pos):\n      \"\"\"Return a list of actions (0\u2011DOWN,1\u2011UP,2\u2011LEFT,3\u2011RIGHT) that moves\n      from cur_pos to target_pos using Manhattan steps.\"\"\"\n      actions = []\n      x, y = cur_pos\n      tx, ty = target_pos\n      while x < tx:\n          actions.append(0)   # DOWN\n          x += 1\n      while x > tx:\n          actions.append(1)   # UP\n          x -= 1\n      while y < ty:\n          actions.append(3)   # RIGHT\n          y += 1\n      while y > ty:\n          actions.append(2)   # LEFT\n          y -= 1\n      return actions\n\n  def step_position(pos, act):\n      \"\"\"Update a (x, y) position according to a movement action.\"\"\"\n      x, y = pos\n      if act == 0:   # DOWN\n          x += 1\n      elif act == 1: # UP\n          x -= 1\n      elif act == 2: # LEFT\n          y -= 1\n      elif act == 3: # RIGHT\n          y += 1\n      return (x, y)\n\n  # ----------------------------------------------------------------------\n  # Initialise environment and obtain the current state\n  # ----------------------------------------------------------------------\n  obs = env.reset()\n  state = env._current_state          # CraftState instance\n  world = env.world                    # CraftWorld instance\n  cookbook = world.cookbook\n  goal_idx = env.task.goal             # integer index of the desired item\n\n  # ----------------------------------------------------------------------\n  # Determine which primitive resources are required for ONE unit of the goal\n  # ----------------------------------------------------------------------\n  needed_prims = cookbook.primitives_for(goal_idx)   # dict {prim_idx: count}\n  plan_actions = []\n\n  # ----------------------------------------------------------------------\n  # Helper to locate the nearest cell containing a given kind (primitive or workshop)\n  # ----------------------------------------------------------------------\n  def locate_kind(kind_idx):\n      \"\"\"Return coordinates (x, y) of the first occurrence of kind_idx in the grid,\n      or None if not present.\"\"\"\n      locs = np.argwhere(state.grid[:, :, kind_idx] > 0)\n      return tuple(locs[0]) if len(locs) > 0 else None\n\n  # ----------------------------------------------------------------------\n  # Collect all required primitives\n  # ----------------------------------------------------------------------\n  for prim_idx, required_cnt in needed_prims.items():\n      while state.inventory[prim_idx] < required_cnt:\n          target = locate_kind(prim_idx)\n          if target is None:\n              # No more of this primitive on the map \u2013 give up.\n              break\n\n          # Move to a cell adjacent to the primitive (Manhattan distance 1)\n          # Prefer a simple adjacent cell that is inside the grid.\n          tx, ty = target\n          # Choose an adjacent cell that is within bounds; ignore obstacles.\n          adj = (max(0, tx - 1), ty)   # try one step up\n          # If already adjacent, keep it; else move closer.\n          if abs(state.pos[0] - tx) + abs(state.pos[1] - ty) == 1:\n              adj = state.pos\n          else:\n              # move to the cell directly above the primitive (if possible)\n              adj = (tx - 1, ty) if tx > 0 else (tx + 1, ty)\n\n          # Generate movement actions\n          moves = move_actions(state.pos, adj)\n          for a in moves:\n              plan_actions.append(a)\n              state = state.step(a)[1]   # update internal state\n\n          # Finally, use the USE action to pick up the primitive.\n          plan_actions.append(4)          # USE\n          state = state.step(4)[1]\n\n  # ----------------------------------------------------------------------\n  # Craft the final goal at its required workshop (if any)\n  # ----------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_idx = recipe.get('_at')\n  if workshop_idx is not None:\n      workshop_loc = locate_kind(workshop_idx)\n      if workshop_loc is not None:\n          moves = move_actions(state.pos, workshop_loc)\n          for a in moves:\n              plan_actions.append(a)\n              state = state.step(a)[1]\n          # USE at the workshop to craft the goal item.\n          plan_actions.append(4)          # USE\n          state = state.step(4)[1]\n\n  # Return the complete list of action indices.\n  plan_actions", "env_interactions": 0, "island_id": 5, "scores": {"3": -1}}
