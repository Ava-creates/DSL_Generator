{"timestamp": "2025-11-04T13:47:48.233648", "function_name": "break_func", "function_body": "  actions = []\n  # get shortcuts to objects\n  state = env._current_state\n  world = env.world\n  # action mapping\n  act_map = env.action_specs()\n  # goal index\n  goal = env.task.goal\n\n  # ------------------------------------------------------------------\n  # Helper to move the agent to a target (x, y) location using Manhattan steps\n  # ------------------------------------------------------------------\n  def move_to(target):\n      nonlocal state\n      while state.pos[0] < target[0]:\n          a = act_map[\"RIGHT\"]\n          actions.append(a)\n          state, _ = env.step(a)\n      while state.pos[0] > target[0]:\n          a = act_map[\"LEFT\"]\n          actions.append(a)\n          state, _ = env.step(a)\n      while state.pos[1] < target[1]:\n          a = act_map[\"DOWN\"]\n          actions.append(a)\n          state, _ = env.step(a)\n      while state.pos[1] > target[1]:\n          a = act_map[\"UP\"]\n          actions.append(a)\n          state, _ = env.step(a)\n\n  # ------------------------------------------------------------------\n  # Collect required primitive resources\n  # ------------------------------------------------------------------\n  needed = world.cookbook.primitives_for(goal)          # {primitive_idx: count}\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          # locate all cells that currently contain this primitive\n          prim_grid = state.grid[:, :, prim_idx]\n          locations = np.argwhere(prim_grid > 0)\n          if locations.size == 0:\n              # primitive not present \u2013 give up on this item\n              continue\n          # pick the closest instance (Manhattan distance)\n          dists = np.abs(locations - np.array(state.pos)).sum(axis=1)\n          target = locations[dists.argmin()]\n          # move and pick up\n          move_to(target)\n          a = act_map[\"USE\"]\n          actions.append(a)\n          state, _ = env.step(a)\n\n  # ------------------------------------------------------------------\n  # Move to the appropriate workshop and craft the goal item\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal, {})\n  workshop_idx = recipe.get(\"_at\")\n  if workshop_idx is not None:\n      workshop_grid = state.grid[:, :, workshop_idx]\n      locations = np.argwhere(workshop_grid > 0)\n      if locations.size > 0:\n          dists = np.abs(locations - np.array(state.pos)).sum(axis=1)\n          target = locations[dists.argmin()]\n          move_to(target)\n          a = act_map[\"USE\"]\n          actions.append(a)\n          state, _ = env.step(a)\n\n  return actions", "env_interactions": 0, "island_id": 6, "scores": {"3": 0.0}}
