{"timestamp": "2025-11-04T13:04:39.085490", "function_name": "break_func", "function_body": "  # Reset the environment to start a fresh episode\n  env.reset()\n  actions = []\n\n  # Shortcut references\n  state = env._current_state\n  goal = env.task.goal\n  cookbook = env.world.cookbook\n\n  # Determine which primitive resources are needed for the goal\n  needed = dict(cookbook.primitives_for(goal))\n\n  # Mapping of action indices (as defined in CraftLab.action_specs)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Helper to move the agent to a target (row, col) position\n  def move_to(target_x: int, target_y: int):\n      nonlocal actions, state\n      while (state.pos[0] != target_x) or (state.pos[1] != target_y):\n          cur_x, cur_y = state.pos\n          if cur_x < target_x:\n              act = DOWN\n          elif cur_x > target_x:\n              act = UP\n          elif cur_y < target_y:\n              act = RIGHT\n          else:\n              act = LEFT\n          actions.append(act)\n          _, _ = env.step(act)\n          state = env._current_state\n\n  # ----------------------------------------------------------------------\n  # 1. Collect all required primitive items\n  # ----------------------------------------------------------------------\n  for prim_idx, count in list(needed.items()):\n      while needed[prim_idx] > 0:\n          # Locate all cells that currently contain this primitive\n          prim_grid = state.grid[:, :, prim_idx]\n          positions = np.argwhere(prim_grid > 0)\n\n          # If the primitive is no longer on the map, break out (unlikely)\n          if positions.size == 0:\n              break\n\n          # Choose the nearest instance (Manhattan distance)\n          cur_pos = np.array(state.pos)\n          dists = np.abs(positions - cur_pos).sum(axis=1)\n          nearest = positions[dists.argmin()]\n          tx, ty = int(nearest[0]), int(nearest[1])\n\n          # Move to the primitive's cell and pick it up\n          move_to(tx, ty)\n          actions.append(USE)\n          _, _ = env.step(USE)\n          state = env._current_state\n          needed[prim_idx] -= 1\n\n  # ----------------------------------------------------------------------\n  # 2. If the goal item is not yet in the inventory, craft it at the proper workshop\n  # ----------------------------------------------------------------------\n  if state.inventory[goal] == 0:\n      recipe = cookbook.recipes.get(goal, {})\n      workshop_idx = recipe.get('_at')\n      if workshop_idx is not None:\n          # Find any workshop cell of the required type\n          workshop_grid = state.grid[:, :, workshop_idx]\n          workshop_cells = np.argwhere(workshop_grid > 0)\n          if workshop_cells.size > 0:\n              wx, wy = int(workshop_cells[0][0]), int(workshop_cells[0][1])\n              move_to(wx, wy)\n              actions.append(USE)          # Use the workshop to craft the goal\n              _, _ = env.step(USE)\n              state = env._current_state\n\n  # Return the full action sequence that should solve the task\n  return actions", "env_interactions": 0, "island_id": 7, "scores": {"3": -1}}
