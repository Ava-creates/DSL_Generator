{"timestamp": "2025-11-04T14:34:31.542291", "function_name": "break_func", "function_body": "  import numpy as np\n\n  # Reset environment to start a new episode and obtain initial observation\n  _ = env.reset()\n  actions = []\n\n  # Access world configuration and goal\n  world = env.world\n  goal = env.task.goal\n  cookbook = world.cookbook\n\n  # Determine required primitive resources for the goal\n  required = dict(cookbook.primitives_for(goal))  # {primitive_idx: count}\n  # Locate the workshop kind for the goal (if any)\n  workshop_kind = None\n  recipe = cookbook.recipes.get(goal, {})\n  if isinstance(recipe, dict):\n      workshop_kind = recipe.get(\"_at\")\n\n  # Helper to compute Manhattan distance\n  def manhattan(a, b):\n      return abs(int(a[0] - b[0])) + abs(int(a[1] - b[1]))\n\n  # Main loop: keep acting until the goal is satisfied or no progress can be made\n  while True:\n      state = env._current_state\n      if state.satisfies(None, goal):\n          break\n\n      # Update remaining primitive needs based on current inventory\n      inventory = state.inventory\n      remaining = {}\n      for k, cnt in required.items():\n          have = int(inventory[k])\n          need = cnt - have\n          if need > 0:\n              remaining[k] = need\n\n      # -------------------------------------------------\n      # 1) Collect needed primitives (if any remain)\n      # -------------------------------------------------\n      if remaining:\n          # pick an arbitrary needed primitive\n          prim, _ = next(iter(remaining.items()))\n          # locate all cells containing that primitive\n          grid = state.grid\n          cells = np.argwhere(grid[:, :, prim] > 0)\n          if cells.size == 0:\n              # cannot find required primitive \u2013 abort\n              break\n          # choose the closest cell (Manhattan distance)\n          cur_pos = np.array(state.pos)\n          dists = np.array([manhattan(cur_pos, c) for c in cells])\n          target = cells[dists.argmin()]\n\n          # Move step\u2011by\u2011step toward the target cell\n          while not np.array_equal(state.pos, target):\n              cur = np.array(state.pos)\n              dy, dx = int(target[0] - cur[0]), int(target[1] - cur[1])\n              if dy > 0:\n                  act = 0          # DOWN\n              elif dy < 0:\n                  act = 1          # UP\n              elif dx < 0:\n                  act = 2          # LEFT\n              elif dx > 0:\n                  act = 3          # RIGHT\n              else:\n                  break\n              _, done, _ = env.step(act)\n              actions.append(act)\n              if done:\n                  return actions\n              state = env._current_state\n\n          # At the primitive location: use the USE action to pick it up\n          _, done, _ = env.step(4)   # USE\n          actions.append(4)\n          if done:\n              break\n          continue  # re\u2011evaluate needs after collection\n\n      # -------------------------------------------------\n      # 2) All primitives gathered \u2013 go to workshop to craft\n      # -------------------------------------------------\n      if workshop_kind is None:\n          # No workshop information; cannot craft \u2013 abort\n          break\n\n      # locate workshop cells\n      grid = state.grid\n      workshop_cells = np.argwhere(grid[:, :, workshop_kind] > 0)\n      if workshop_cells.size == 0:\n          break\n      cur_pos = np.array(state.pos)\n      dists = np.array([manhattan(cur_pos, c) for c in workshop_cells])\n      target = workshop_cells[dists.argmin()]\n\n      # Move toward the workshop\n      while not np.array_equal(state.pos, target):\n          cur = np.array(state.pos)\n          dy, dx = int(target[0] - cur[0]), int(target[1] - cur[1])\n          if dy > 0:\n              act = 0\n          elif dy < 0:\n              act = 1\n          elif dx < 0:\n              act = 2\n          elif dx > 0:\n              act = 3\n          else:\n              break\n          _, done, _ = env.step(act)\n          actions.append(act)\n          if done:\n              return actions\n          state = env._current_state\n\n      # At the workshop: attempt to craft the goal item\n      _, done, _ = env.step(4)   # USE\n      actions.append(4)\n      if done:\n          break\n\n  return actions", "env_interactions": 0, "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-11-04T14:34:32.686022", "function_name": "break_func", "function_body": "  # Simple random policy: reset the environment, then take random actions\n  # until the episode ends (goal achieved or max steps reached).  The\n  # sequence of actions taken is returned.\n  #\n  # This implementation works with the CraftLab interface:\n  #   * env.reset() returns the initial observation dict.\n  #   * env.action_specs() returns a dict mapping action names to integer IDs.\n  #   * env.step(action) returns (reward, done, observation).\n  #\n  # The function does not attempt any planning; it merely provides a\n  # fallback that will eventually terminate because CraftLab enforces a\n  # maximum number of steps per episode.\n  #\n  # Parameters\n  # ----------\n  # env : CraftLab\n  #     The environment instance to interact with.\n  #\n  # Returns\n  # -------\n  # List[int]\n  #     List of action indices executed during the episode.\n  #\n  # Note\n  # ----\n  # The random policy is deterministic only if the environment's RNG is\n  # seeded (e.g., via env.reset(seed=...)).  For reproducibility the\n  # function uses the environment's own RNG if available; otherwise it\n  # falls back to NumPy's default RNG.\n  #\n  # If the environment provides a `max_steps` attribute we respect it;\n  # otherwise we cap the loop at 10,000 steps as a safety net.\n  #\n  # The function assumes that `env` follows the CraftLab API described\n  # in the provided code base.\n  #\n  # --------------------------------------------------------------------\n  # Reset the environment to start a new episode.\n  obs = env.reset()\n  # Gather the list of possible action IDs.\n  action_ids = list(env.action_specs().values())\n  # Prepare the container for the executed actions.\n  executed_actions = []\n  # Determine a safe step limit.\n  max_steps = getattr(env, \"max_steps\", 10000)\n  steps = 0\n  done = False\n  # Use the environment's RNG if it exposes one; otherwise default to numpy.\n  rng = getattr(env, \"random\", np.random)\n  while not done and steps < max_steps:\n      # Sample a random action.\n      action = int(rng.choice(action_ids))\n      # Apply the action.\n      reward, done, obs = env.step(action)\n      # Record the action.\n      executed_actions.append(action)\n      steps += 1\n  return executed_actions", "env_interactions": 0, "island_id": 7, "scores": {"3": -1}}
