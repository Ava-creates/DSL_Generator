{"timestamp": "2025-11-04T12:27:46.522363", "function_name": "break_func", "function_body": "  import numpy as np\n\n  # Initialize the environment and obtain the set of possible actions\n  env.reset()\n  action_space = list(env.action_specs().values())\n\n  actions = []\n  max_steps = 1000\n  done = False\n\n  for _ in range(max_steps):\n      if done:\n          break\n      # Choose a random action from the available action space\n      a = int(np.random.choice(action_space))\n      actions.append(a)\n      # Execute the action; env.step returns (reward, done, observation)\n      _, done, _ = env.step(a)\n\n  return actions", "env_interactions": 0, "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-11-04T12:27:47.662173", "function_name": "break_func", "function_body": "  import collections\n  import numpy as np\n\n  # movement mapping: action index -> (dx, dy)\n  MOVE_DELTAS = {\n      0: (0, 1),   # DOWN\n      1: (0, -1),  # UP\n      2: (-1, 0),  # LEFT\n      3: (1, 0),   # RIGHT\n  }\n\n  def _find_any(grid, kind):\n      \"\"\"Return the first position (x, y) where the given kind is present.\"\"\"\n      xs, ys = np.where(grid[:, :, kind] > 0)\n      if len(xs) == 0:\n          return None\n      return int(xs[0]), int(ys[0])\n\n  def _is_blocked(grid, pos):\n      \"\"\"A cell is blocked if any kind occupies it.\"\"\"\n      x, y = pos\n      return grid[x, y, :].any()\n\n  def _bfs_path(grid, start, goal):\n      \"\"\"Return a list of movement actions from start to goal (both (x,y)).\"\"\"\n      width, height = grid.shape[:2]\n      q = collections.deque()\n      q.append(start)\n      visited = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          for act, (dx, dy) in MOVE_DELTAS.items():\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < width and 0 <= ny < height:\n                  if not _is_blocked(grid, (nx, ny)):\n                      nxt = (nx, ny)\n                      if nxt not in visited:\n                          visited[nxt] = (cur, act)\n                          q.append(nxt)\n      # reconstruct path\n      if goal not in visited:\n          return []  # no path\n      path_actions = []\n      cur = goal\n      while visited[cur] is not None:\n          prev, act = visited[cur]\n          path_actions.append(act)\n          cur = prev\n      path_actions.reverse()\n      return path_actions\n\n  def _move_adjacent_and_use(state_grid, cur_pos, target_pos):\n      \"\"\"\n      Produce actions that move the agent from cur_pos to a free cell\n      adjacent to target_pos, then turn towards target and issue USE.\n      Returns list of actions.\n      \"\"\"\n      tx, ty = target_pos\n      width, height = state_grid.shape[:2]\n\n      # find a free adjacent cell and the direction needed to face the target\n      for act, (dx, dy) in MOVE_DELTAS.items():\n          adj_x, adj_y = tx - dx, ty - dy  # cell where we must stand\n          if 0 <= adj_x < width and 0 <= adj_y < height:\n              if not _is_blocked(state_grid, (adj_x, adj_y)):\n                  # we have a viable adjacent cell\n                  path = _bfs_path(state_grid, cur_pos, (adj_x, adj_y))\n                  if not path:\n                      continue  # cannot reach this adjacent cell\n                  # after reaching the adjacent cell we need to face the target.\n                  # issuing the movement action towards the target will set the direction.\n                  # it may fail to move (because target is occupied) but direction updates.\n                  actions = path + [act, 4]  # 4 == USE\n                  return actions\n      # fallback: no reachable adjacent cell\n      return []\n\n  # ----------------------------------------------------------------------\n  # Begin main planning\n  # ----------------------------------------------------------------------\n  actions = []\n\n  # current state and world references\n  state = env._current_state\n  world = env.world\n  grid = state.grid\n  cur_pos = tuple(state.pos)\n\n  goal = env.task.goal\n\n  # If goal already satisfied, nothing to do\n  if state.satisfies('', goal):\n      return actions\n\n  # Determine which primitives are required (raw resources)\n  needed_prims = world.cookbook.primitives_for(goal).copy()  # dict {kind: count}\n  # If the goal itself is a primitive (no recipe), just collect it\n  is_primitive = goal in world.cookbook.primitives\n\n  # ------------------------------------------------------------------\n  # Collect required primitives (ignore multiplicities for simplicity)\n  # ------------------------------------------------------------------\n  for prim_kind, cnt in needed_prims.items():\n      for _ in range(cnt):\n          target = _find_any(grid, prim_kind)\n          if target is None:\n              # cannot find required primitive; abort planning\n              return actions\n          # generate actions to collect this primitive\n          seq = _move_adjacent_and_use(grid, cur_pos, target)\n          actions.extend(seq)\n          # update our simulated position and grid to keep planning roughly correct\n          # (we move to the adjacent cell; after USE we stay there)\n          # simulate movement\n          for a in seq:\n              if a == 4:  # USE does not change position\n                  continue\n              dx, dy = MOVE_DELTAS[a]\n              nx, ny = cur_pos[0] + dx, cur_pos[1] + dy\n              if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n                  if not _is_blocked(grid, (nx, ny)):\n                      cur_pos = (nx, ny)\n          # after picking up, the primitive cell becomes empty\n          grid[target[0], target[1], prim_kind] = 0\n\n  # ------------------------------------------------------------------\n  # If the goal is non\u2011primitive, craft it at its workshop\n  # ------------------------------------------------------------------\n  if not is_primitive:\n      recipe = world.cookbook.recipes.get(goal, {})\n      workshop_kind = recipe.get('_at')\n      if workshop_kind is not None:\n          workshop_pos = _find_any(grid, workshop_kind)\n          if workshop_pos is not None:\n              seq = _move_adjacent_and_use(grid, cur_pos, workshop_pos)\n              actions.extend(seq)\n\n  return actions", "env_interactions": 0, "island_id": 7, "scores": {"3": -1}}
