{"timestamp": "2025-11-04T13:47:22.314811", "function_name": "break_func", "function_body": "  import random\n  import numpy as np\n\n  # Reset the environment to start a new episode\n  obs = env.reset()\n  # Mapping from action names to integer indices\n  action_map = env.action_specs()\n  # Goal item index (the item we need to have in inventory)\n  goal_idx = env.task.goal\n  # Reference to the current CraftState (updated after each step)\n  state = env._current_state\n  # Maximum number of steps allowed in the episode\n  max_steps = getattr(env, \"max_steps\", 1000)\n\n  actions = []\n\n  for _ in range(max_steps):\n      # If the goal is already in the inventory, stop planning\n      if state.satisfies(None, goal_idx):\n          break\n\n      # Locate all cells that currently contain the goal item\n      grid = state.grid\n      goal_cells = np.argwhere(grid[:, :, goal_idx] > 0)\n\n      # If there are no goal items on the map, fall back to random exploration\n      if goal_cells.size == 0:\n          act = random.choice(list(action_map.values()))\n          actions.append(act)\n          _, _, _ = env.step(act)\n          state = env._current_state\n          continue\n\n      # Choose the nearest goal cell (Manhattan distance)\n      agent_pos = np.array(state.pos)\n      distances = np.sum(np.abs(goal_cells - agent_pos), axis=1)\n      target_cell = goal_cells[distances.argmin()]\n\n      # Compute the offset from the agent to the target cell\n      dy, dx = target_cell - agent_pos\n\n      # If we are already adjacent, use the USE action to pick up / craft\n      if abs(dy) + abs(dx) == 1:\n          use_action = action_map[\"USE\"]\n          actions.append(use_action)\n          _, _, _ = env.step(use_action)\n          state = env._current_state\n      else:\n          # Otherwise move one step towards the target (prefer vertical movement)\n          if dy != 0:\n              act_name = \"DOWN\" if dy > 0 else \"UP\"\n          else:\n              act_name = \"RIGHT\" if dx > 0 else \"LEFT\"\n          move_action = action_map[act_name]\n          actions.append(move_action)\n          _, _, _ = env.step(move_action)\n          state = env._current_state\n\n      # If the environment reports the episode is done, exit early\n      if getattr(env, \"done\", False):\n          break\n\n  return actions", "env_interactions": 0, "island_id": 6, "scores": {"3": -1}}
