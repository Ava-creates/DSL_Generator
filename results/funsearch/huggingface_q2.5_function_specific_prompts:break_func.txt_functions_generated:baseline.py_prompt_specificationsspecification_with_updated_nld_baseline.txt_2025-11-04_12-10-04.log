{"timestamp": "2025-11-04T12:35:10.076894", "function_name": "break_func", "function_body": "  import numpy as np\n\n  # Helper to move from current position to a target position using Manhattan moves\n  def _move_to(cur_pos, target_pos, env):\n      specs = env.action_specs()\n      actions = []\n      y, x = cur_pos\n      ty, tx = target_pos\n      dy = ty - y\n      dx = tx - x\n      # vertical moves\n      while dy != 0:\n          if dy > 0:\n              actions.append(specs[\"DOWN\"])\n              dy -= 1\n          else:\n              actions.append(specs[\"UP\"])\n              dy += 1\n      # horizontal moves\n      while dx != 0:\n          if dx > 0:\n              actions.append(specs[\"RIGHT\"])\n              dx -= 1\n          else:\n              actions.append(specs[\"LEFT\"])\n              dx += 1\n      return actions\n\n  # Main planning loop\n  actions_plan = []\n  state = env._current_state               # current CraftState\n  world = env.world                         # CraftWorld instance\n  goal_idx = env.task.goal                  # integer index of the goal item\n  use_action = env.action_specs()[\"USE\"]\n\n  # Continue until the goal is in the inventory\n  while not state.satisfies(None, goal_idx):\n      # ------------------------------------------------------------------\n      # 1. Gather required primitive resources for the goal\n      # ------------------------------------------------------------------\n      primitives_needed = world.cookbook.primitives_for(goal_idx)\n      # For each primitive, collect the missing amount\n      for prim_idx, required_cnt in primitives_needed.items():\n          have_cnt = int(state.inventory[prim_idx])\n          missing = required_cnt - have_cnt\n          for _ in range(missing):\n              # locate any cell that currently contains this primitive\n              prim_layer = state.grid[:, :, prim_idx]\n              positions = np.argwhere(prim_layer > 0)\n              if positions.size == 0:\n                  # No more of this primitive on the map \u2013 give up\n                  break\n              # choose the nearest instance (Manhattan distance)\n              dists = np.sum(np.abs(positions - np.array(state.pos)), axis=1)\n              target = tuple(positions[dists.argmin()])\n\n              # move to the target cell\n              for a in _move_to(state.pos, target, env):\n                  actions_plan.append(a)\n                  _, state = env.step(a)\n\n              # pick up the primitive\n              actions_plan.append(use_action)\n              _, state = env.step(use_action)\n\n      # ------------------------------------------------------------------\n      # 2. If still not satisfied, attempt to craft at the required workshop\n      # ------------------------------------------------------------------\n      if state.satisfies(None, goal_idx):\n          break  # goal already achieved after gathering primitives\n\n      recipe = world.cookbook.recipes.get(goal_idx, {})\n      workshop_kind = recipe.get(\"_at\")\n      if workshop_kind is None:\n          # No workshop required \u2013 just use (some environments allow direct use)\n          actions_plan.append(use_action)\n          _, state = env.step(use_action)\n          continue\n\n      # Find a workshop cell of the required kind\n      workshop_layer = state.grid[:, :, workshop_kind]\n      workshop_poss = np.argwhere(workshop_layer > 0)\n      if workshop_poss.size == 0:\n          # No workshop present \u2013 cannot craft further\n          break\n\n      # Move to the first workshop we find\n      wpos = tuple(workshop_poss[0])\n      for a in _move_to(state.pos, wpos, env):\n          actions_plan.append(a)\n          _, state = env.step(a)\n\n      # Craft by using the workshop\n      actions_plan.append(use_action)\n      _, state = env.step(use_action)\n\n  return actions_plan", "env_interactions": 0, "island_id": 5, "scores": {"3": -1}}
