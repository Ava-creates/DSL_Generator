{"timestamp": "2025-11-04T14:09:31.791637", "function_name": "break_func", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Helper to get current state\n  state = env._current_state if hasattr(env, \"_current_state\") else env.current_state\n\n  # Goal index (item to obtain)\n  goal_idx = env.task.goal if hasattr(env, \"task\") else None\n  if goal_idx is None:\n      # fallback: try to parse from task_name like \"make_axe\"\n      goal_idx = None\n\n  # If no goal, just return empty\n  if goal_idx is None:\n      return []\n\n  # Determine primitive requirements for the goal\n  # Use the cookbook to decompose into primitive counts\n  cookbook = env.world.cookbook\n  primitive_reqs = cookbook.primitives_for(goal_idx)  # dict {prim_idx: count}\n\n  # If there are no primitive requirements (maybe goal is primitive itself)\n  if not primitive_reqs:\n      primitive_reqs = {goal_idx: 1}\n\n  actions = []\n  # Direction to action mapping (DOWN,UP,LEFT,RIGHT)\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]  # (dx, dy) for actions 0-3\n  ACTION_MOVE = [0, 1, 2, 3]  # indices for MOVE actions\n  ACTION_USE = 4\n\n  # Function to compute Manhattan distance\n  manhattan = lambda a, b: abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  # BFS path finder to any cell that is adjacent to a target cell\n  def bfs_to_adjacent(start, target_cells, occupied):\n      \"\"\"Return list of movement actions to reach a cell adjacent to any target.\"\"\"\n      visited = set()\n      q = deque()\n      q.append((start, []))\n      visited.add(start)\n      target_set = set(target_cells)\n\n      while q:\n          (x, y), path = q.popleft()\n          # Check if adjacent to any target cell\n          for tx, ty in target_set:\n              if manhattan((x, y), (tx, ty)) == 1:\n                  return path\n          # Expand neighbours\n          for a_idx, (dx, dy) in enumerate(DIRS):\n              nx, ny = x + dx, y + dy\n              if (0 <= nx < occupied.shape[0] and 0 <= ny < occupied.shape[1] and\n                      not occupied[nx, ny] and (nx, ny) not in visited):\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [ACTION_MOVE[a_idx]]))\n      return None\n\n  # Main loop: collect needed primitives\n  while True:\n      # Check if goal already satisfied\n      if state.satisfies(\"\", goal_idx):\n          break\n\n      # Find a primitive that we still need\n      needed = None\n      for prim_idx, cnt in primitive_reqs.items():\n          if state.inventory[prim_idx] < cnt:\n              needed = prim_idx\n              break\n      if needed is None:\n          # All primitives collected; attempt to craft the goal if possible\n          # Simplify: just try to USE at current position (assuming adjacent workshop)\n          actions.append(ACTION_USE)\n          # after using, we will break the loop on next iteration if satisfied\n          continue\n\n      # Locate all cells containing the needed primitive\n      grid = state.grid\n      occ = np.any(grid, axis=2)  # blocked cells\n      primitive_locations = list(zip(*np.where(grid[:, :, needed] > 0)))\n\n      if not primitive_locations:\n          # No such primitive on map; break to avoid infinite loop\n          break\n\n      # Find path to a cell adjacent to one of the locations\n      start_pos = state.pos\n      path = bfs_to_adjacent(start_pos, primitive_locations, occ)\n      if path is None:\n          # Cannot reach; break\n          break\n\n      # Execute movement actions\n      actions.extend(path)\n      # Update simulated state position for planning purposes\n      # (We don't have a full simulator here, so we just approximate)\n      # After moving, we are adjacent; issue USE\n      actions.append(ACTION_USE)\n\n      # Update inventory estimate (increment needed primitive)\n      # This helps the loop terminate without full simulation\n      state.inventory[needed] += 1\n\n  return actions", "env_interactions": 0, "island_id": 7, "scores": {"3": -1}}
