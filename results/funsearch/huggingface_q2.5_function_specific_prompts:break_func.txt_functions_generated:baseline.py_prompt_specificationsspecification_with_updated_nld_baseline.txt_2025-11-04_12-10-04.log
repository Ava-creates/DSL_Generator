{"timestamp": "2025-11-04T12:14:52.512142", "function_name": "break_func", "function_body": "  import numpy as np\n\n  # Reset the environment to start a new episode and obtain the initial observation.\n  # The reset may return an observation dictionary; we ignore its contents here.\n  try:\n      env.reset()\n  except Exception:\n      # If reset requires a seed argument, provide a default seed.\n      env.reset(seed=0)\n\n  actions = []\n  # Determine the available action indices from the environment specification.\n  try:\n      action_space = list(env.action_specs().values())\n  except Exception:\n      # Fallback: assume standard DMLab actions if the spec is unavailable.\n      action_space = [0, 1, 2, 3, 4]  # DOWN, UP, LEFT, RIGHT, USE\n\n  max_steps = 1000  # safeguard to avoid infinite loops\n\n  for _ in range(max_steps):\n      # Check if the task is already completed.\n      done = False\n      if hasattr(env, \"_is_done\"):\n          try:\n              done = env._is_done()\n          except Exception:\n              done = False\n      if done:\n          break\n\n      # Sample a random action from the available actions.\n      action = np.random.choice(action_space)\n      actions.append(int(action))\n\n      # Perform the action; step may return (reward, done, obs) or (reward, done, info, obs)\n      try:\n          result = env.step(action)\n      except Exception:\n          # If step signature differs, ignore and continue.\n          continue\n\n      # Normalize the result to extract the 'done' flag.\n      if isinstance(result, tuple):\n          if len(result) == 3:\n              _, done, _ = result\n          elif len(result) == 4:\n              _, done, _, _ = result\n          else:\n              done = False\n      else:\n          done = False\n\n      if done:\n          break\n\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-11-04T12:15:01.699121", "function_name": "break_func", "function_body": "  # Reset the environment to start a new episode and obtain the initial observation.\n  env.reset()\n\n  # Retrieve the list of possible action indices from the environment's specification.\n  possible_actions = list(env.action_specs().values())\n\n  actions_taken = []\n  done = False\n\n  # Keep acting until the environment signals that the episode is finished\n  # (i.e., the goal has been achieved or the maximum number of steps was reached).\n  while not done:\n      # Choose an action uniformly at random from the admissible actions.\n      action = np.random.choice(possible_actions)\n      # Execute the selected action.\n      _, done, _ = env.step(action)\n      # Record the action for later return.\n      actions_taken.append(int(action))\n      # Safety break to avoid infinite loops in pathological cases.\n      if len(actions_taken) > 10000:\n          break\n\n  return actions_taken", "env_interactions": 0, "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-11-04T12:15:02.809517", "function_name": "break_func", "function_body": "  # Return a zero\u2011filled action vector matching the environment's action space.\n  # If the environment or its action count cannot be determined, fall back to an empty array.\n  if not hasattr(env, \"world\") or not hasattr(env.world, \"n_actions\"):\n      return np.array([], dtype=np.int32)\n  return np.zeros(env.world.n_actions, dtype=np.int32)", "env_interactions": 5, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-11-04T12:15:14.229752", "function_name": "break_func", "function_body": "  # Map direction strings to action indices (as defined in CraftLab)\n  dir_to_action = {\n      \"down\": 0,\n      \"up\": 1,\n      \"left\": 2,\n      \"right\": 3,\n  }\n\n  # Normalize input\n  dir_key = dir.lower()\n  if dir_key not in dir_to_action:\n      raise ValueError(f\"Invalid direction '{dir}'. Expected one of {list(dir_to_action)}.\")\n\n  # Action to face the obstacle (moving in that direction also orients the agent)\n  move_action = dir_to_action[dir_key]\n\n  # The USE action (index 4) attempts to interact with the cell the agent is facing.\n  use_action = 4\n\n  # Return the sequence: first orient/move, then use.\n  return [move_action, use_action]", "env_interactions": 0, "island_id": 8, "scores": {"3": -1}}
