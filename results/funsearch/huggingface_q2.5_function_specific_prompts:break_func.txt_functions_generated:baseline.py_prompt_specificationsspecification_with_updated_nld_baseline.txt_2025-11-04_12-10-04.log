{"timestamp": "2025-11-04T13:32:21.906457", "function_name": "break_func", "function_body": "  return []", "env_interactions": 0, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-11-04T13:32:23.037461", "function_name": "break_func", "function_body": "  import numpy as np\n\n  # helper: map relative position to movement action (DOWN=0, UP=1, LEFT=2, RIGHT=3)\n  def _action_towards(pos, target):\n      dx = target[0] - pos[0]\n      dy = target[1] - pos[1]\n      if abs(dx) > abs(dy):\n          return 0 if dx > 0 else 1  # DOWN or UP\n      else:\n          return 3 if dy > 0 else 2  # RIGHT or LEFT\n\n  # reset environment and obtain initial state\n  env.reset()\n  state = env._current_state\n  goal_idx = env.task.goal\n  max_steps = env.task.steps\n\n  executed_actions = []\n  steps_done = 0\n\n  # main loop \u2013 keep acting until goal satisfied or step limit reached\n  while not state.satisfies(None, goal_idx) and steps_done < max_steps:\n      # ------------------------------------------------------------------\n      # 1. Determine which primitive resources are still missing for the goal\n      # ------------------------------------------------------------------\n      needed_prims = env.world.cookbook.primitives_for(goal_idx)  # dict {prim_idx: count}\n      missing = {}\n      for prim_idx, req_cnt in needed_prims.items():\n          have = int(state.inventory[prim_idx])\n          if have < req_cnt:\n              missing[prim_idx] = req_cnt - have\n\n      # ------------------------------------------------------------------\n      # 2. If some primitive is missing, go collect it\n      # ------------------------------------------------------------------\n      if missing:\n          # pick an arbitrary missing primitive (the first)\n          prim_idx, _ = next(iter(missing.items()))\n          # locate all cells that contain this primitive\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] == 1)\n          if prim_cells.size == 0:\n              # primitive not present on the map \u2013 give up\n              break\n\n          # choose the closest occurrence\n          agent_pos = np.array(state.pos)\n          dists = np.linalg.norm(prim_cells - agent_pos, axis=1)\n          target_cell = tuple(prim_cells[dists.argmin()])\n\n          # compute Manhattan distance to target\n          manh_dist = abs(state.pos[0] - target_cell[0]) + abs(state.pos[1] - target_cell[1])\n\n          if manh_dist == 1:\n              # we are adjacent \u2013 face the primitive then USE\n              act = _action_towards(state.pos, target_cell)\n              # turn/move towards the cell (this also aligns direction)\n              reward, state = env.step(act)\n              executed_actions.append(act)\n              steps_done += 1\n              if steps_done >= max_steps:\n                  break\n              # now collect\n              reward, state = env.step(4)  # USE\n              executed_actions.append(4)\n              steps_done += 1\n          else:\n              # move one step towards the target\n              act = _action_towards(state.pos, target_cell)\n              reward, state = env.step(act)\n              executed_actions.append(act)\n              steps_done += 1\n          continue  # go to next iteration\n\n      # ------------------------------------------------------------------\n      # 3. All primitives are collected \u2013 try to craft the goal at its workshop\n      # ------------------------------------------------------------------\n      recipe = env.world.cookbook.recipes.get(goal_idx, {})\n      workshop_kind = recipe.get('_at')  # may be None if no specific workshop\n\n      if workshop_kind is not None:\n          # find any workshop of the required kind\n          workshop_cells = np.argwhere(state.grid[:, :, workshop_kind] == 1)\n          if workshop_cells.size == 0:\n              # no workshop present \u2013 cannot craft\n              break\n          # choose closest workshop\n          agent_pos = np.array(state.pos)\n          dists = np.linalg.norm(workshop_cells - agent_pos, axis=1)\n          target_ws = tuple(workshop_cells[dists.argmin()])\n\n          manh_dist = abs(state.pos[0] - target_ws[0]) + abs(state.pos[1] - target_ws[1])\n\n          if manh_dist == 1:\n              # adjacent \u2013 face it then USE to attempt crafting\n              act = _action_towards(state.pos, target_ws)\n              reward, state = env.step(act)\n              executed_actions.append(act)\n              steps_done += 1\n              if steps_done >= max_steps:\n                  break\n              reward, state = env.step(4)  # USE (craft)\n              executed_actions.append(4)\n              steps_done += 1\n          else:\n              # move towards workshop\n              act = _action_towards(state.pos, target_ws)\n              reward, state = env.step(act)\n              executed_actions.append(act)\n              steps_done += 1\n          continue\n      else:\n          # No specific workshop \u2013 simply try USE (may succeed if inventory sufficient)\n          reward, state = env.step(4)\n          executed_actions.append(4)\n          steps_done += 1\n          continue\n\n  # Return the sequence of actions taken (may be empty if nothing could be done)\n  return executed_actions", "env_interactions": 0, "island_id": 8, "scores": {"3": -1}}
