{"timestamp": "2025-11-04T13:42:57.928559", "function_name": "break_func", "function_body": "  # Reset the environment to start a new episode\n  env.reset()\n  actions = []\n  # Determine a reasonable step limit\n  max_steps = getattr(env, \"max_steps\", 1000)\n\n  # Main loop: keep acting until the goal is satisfied or we hit the step limit\n  for _ in range(max_steps):\n      # Access the internal CraftState (available after reset)\n      state = env._current_state\n\n      # Check if the goal has been achieved\n      if state.satisfies(\"\", env.task.goal):\n          break\n\n      # ------------------------------------------------------------------\n      # 1) If a grabbable item is adjacent (including the current cell),\n      #    use the USE action to pick it up or interact.\n      # ------------------------------------------------------------------\n      used = False\n      for kind in state.world.grabbable_indices:\n          if state.next_to(kind):\n              actions.append(4)          # USE action\n              env.step(4)\n              used = True\n              break\n      if used:\n          continue\n\n      # ------------------------------------------------------------------\n      # 2) Locate the nearest cell that currently holds a grabbable item.\n      # ------------------------------------------------------------------\n      grid = state.grid\n      # Sum over all grabbable kinds to get a binary mask of cells containing any\n      mask = grid[:, :, state.world.grabbable_indices].sum(axis=2) > 0\n      positions = np.argwhere(mask)\n\n      # If no items are present in the world, wander randomly\n      if positions.size == 0:\n          act = np.random.choice([0, 1, 2, 3])   # DOWN, UP, LEFT, RIGHT\n          actions.append(act)\n          env.step(act)\n          continue\n\n      # Find the closest item (Manhattan distance)\n      cur_pos = np.array(state.pos)\n      dists = np.abs(positions - cur_pos).sum(axis=1)\n      target = positions[dists.argmin()]\n\n      # Determine a step that moves towards the target\n      dx = int(target[0] - cur_pos[0])\n      dy = int(target[1] - cur_pos[1])\n\n      if abs(dx) >= abs(dy):\n          # Prefer vertical movement\n          if dx > 0:\n              act = 0   # DOWN\n          elif dx < 0:\n              act = 1   # UP\n          else:\n              # Already aligned vertically; fallback to horizontal\n              act = 3 if dy > 0 else 2\n      else:\n          # Prefer horizontal movement\n          if dy > 0:\n              act = 3   # RIGHT\n          elif dy < 0:\n              act = 2   # LEFT\n          else:\n              # Already aligned horizontally; fallback to vertical\n              act = 0 if dx > 0 else 1\n\n      actions.append(act)\n      env.step(act)\n\n  # Return the list of actions taken (may be shorter than max_steps)\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": -1}}
