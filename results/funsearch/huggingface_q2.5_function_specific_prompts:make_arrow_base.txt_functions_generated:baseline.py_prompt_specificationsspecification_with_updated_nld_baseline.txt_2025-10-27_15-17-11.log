{"timestamp": "2025-10-27T15:46:10.483195", "function_name": "make_arrow", "function_body": "  # Reset the environment and obtain the initial state.\n  obs = env.reset()\n  # Mapping from action names to integer codes.\n  act = env.action_specs()\n  # World configuration (recipes, primitives, etc.).\n  world = env.world\n  # Goal item index for the current task.\n  goal = env.task.goal\n\n  # Primitive requirements for the goal (may be empty if the goal is primitive).\n  primitive_needs = world.cookbook.primitives_for(goal).copy()\n\n  # Current state and inventory.\n  state = env._current_state\n  inventory = state.inventory\n\n  # Maximum number of steps allowed (fallback to a large number if not present).\n  max_steps = getattr(env, \"max_steps\", 1000)\n\n  actions_taken = []\n  steps = 0\n\n  while steps < max_steps:\n      # Check if the goal has been achieved.\n      if state.satisfies(None, goal):\n          break\n\n      # Determine which primitives are still missing.\n      missing = {k: v - inventory[k] for k, v in primitive_needs.items() if inventory[k] < v}\n\n      if missing:\n          # Choose a needed primitive (first one in the dict).\n          target_kind = next(iter(missing))\n          # Find all cells containing this primitive.\n          positions = np.argwhere(state.grid[:, :, target_kind] > 0)\n          if positions.size == 0:\n              # No more of this primitive on the map \u2013 abort.\n              break\n          # Pick the closest occurrence (Manhattan distance).\n          agent_pos = np.array(state.pos)\n          dists = np.sum(np.abs(positions - agent_pos), axis=1)\n          target_pos = positions[dists.argmin()]\n          dy, dx = target_pos - agent_pos\n\n          # If adjacent, attempt to collect it.\n          if abs(dy) + abs(dx) == 1:\n              action = act[\"USE\"]\n              reward, new_state = env.step(action)\n              actions_taken.append(action)\n              state = new_state\n              inventory = state.inventory\n              steps += 1\n              continue\n\n          # Otherwise move one step towards the target.\n          if abs(dy) > abs(dx):\n              move_dir = \"DOWN\" if dy > 0 else \"UP\"\n          else:\n              move_dir = \"RIGHT\" if dx > 0 else \"LEFT\"\n          action = act[move_dir]\n      else:\n          # All required primitives are collected \u2013 go to the workshop.\n          recipe = world.cookbook.recipes.get(goal, {})\n          workshop_kind = recipe.get(\"_at\")\n          if workshop_kind is None:\n              # No workshop needed; break to avoid infinite loop.\n              break\n          positions = np.argwhere(state.grid[:, :, workshop_kind] > 0)\n          if positions.size == 0:\n              break\n          agent_pos = np.array(state.pos)\n          dists = np.sum(np.abs(positions - agent_pos), axis=1)\n          target_pos = positions[dists.argmin()]\n          dy, dx = target_pos - agent_pos\n\n          if abs(dy) + abs(dx) == 1:\n              action = act[\"USE\"]\n              reward, new_state = env.step(action)\n              actions_taken.append(action)\n              state = new_state\n              inventory = state.inventory\n              steps += 1\n              continue\n\n          if abs(dy) > abs(dx):\n              move_dir = \"DOWN\" if dy > 0 else \"UP\"\n          else:\n              move_dir = \"RIGHT\" if dx > 0 else \"LEFT\"\n          action = act[move_dir]\n\n      # Execute the chosen movement action.\n      reward, new_state = env.step(action)\n      actions_taken.append(action)\n      state = new_state\n      inventory = state.inventory\n      steps += 1\n\n  return actions_taken", "env_interactions": 0, "island_id": 9, "scores": {"3": -1}}
