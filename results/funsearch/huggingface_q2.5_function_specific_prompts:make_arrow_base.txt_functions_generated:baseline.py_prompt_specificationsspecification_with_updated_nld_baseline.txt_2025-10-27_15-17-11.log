{"timestamp": "2025-10-27T17:36:57.507570", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # reset environment and get current state/world\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world\n  cookbook = world.cookbook\n\n  # --------------------------------------------------------------\n  # Identify goal (arrow) and its recipe\n  # --------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n  if goal_idx is None:\n      return []                     # unknown goal\n  primitive_needs = cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  if \"_at\" in recipe:\n      workshop_idx = cookbook.index[recipe[\"_at\"]]\n\n  # --------------------------------------------------------------\n  # Helper utilities\n  # --------------------------------------------------------------\n  def bfs_path(start, goal, occupied):\n      \"\"\"Return a list of positions from start (excluded) to goal (included).\"\"\"\n      w, h = occupied.shape\n      visited = np.zeros((w, h), dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start] = True\n      while q:\n          x, y = q.popleft()\n          if (x, y) == goal:\n              break\n          for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):\n              if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:\n                  # allow stepping onto the goal even if occupied\n                  if (nx, ny) == goal or not occupied[nx, ny]:\n                      visited[nx, ny] = True\n                      prev[(nx, ny)] = (x, y)\n                      q.append((nx, ny))\n      if not visited[goal]:\n          return None\n      path = []\n      cur = goal\n      while cur != start:\n          path.append(cur)\n          cur = prev[cur]\n      path.reverse()\n      return path\n\n  def delta_to_action(dx, dy):\n      \"\"\"Translate a movement delta into an action index.\"\"\"\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise ValueError(\"Invalid delta\")\n\n  actions = []\n  cur_pos = tuple(state.pos)\n  # mutable copy of the grid to keep track of collected primitives\n  grid = state.grid.copy()\n\n  # --------------------------------------------------------------\n  # Collect all required primitives\n  # --------------------------------------------------------------\n  for kind_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          # locate remaining cells containing this primitive\n          locations = np.argwhere(grid[:, :, kind_idx] > 0)\n          if locations.size == 0:\n              break\n          # order by Manhattan distance from current position\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n          occupied_mask = np.any(grid, axis=2)\n          target = None\n          path = None\n          for idx in order:\n              cand = tuple(locations[idx])\n              p = bfs_path(cur_pos, cand, occupied_mask)\n              if p is not None:\n                  target = cand\n                  path = p\n                  break\n          if path is None:\n              continue          # cannot reach any remaining instance\n          for step in path:\n              dx = step[0] - cur_pos[0]\n              dy = step[1] - cur_pos[1]\n              actions.append(delta_to_action(dx, dy))\n              cur_pos = step\n          actions.append(4)      # USE to pick up\n          grid[target[0], target[1], kind_idx] = 0   # remove from copy\n\n  # --------------------------------------------------------------\n  # Move to workshop (if required) and craft the arrow\n  # --------------------------------------------------------------\n  if workshop_idx is not None:\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          dists = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n          occupied_mask = np.any(state.grid, axis=2)   # original occupancy (workshops are occupied)\n          for idx in order:\n              cand = tuple(workshop_cells[idx])\n              p = bfs_path(cur_pos, cand, occupied_mask)\n              if p is not None:\n                  for step in p:\n                      dx = step[0] - cur_pos[0]\n                      dy = step[1] - cur_pos[1]\n                      actions.append(delta_to_action(dx, dy))\n                      cur_pos = step\n                  actions.append(4)   # USE to trigger crafting\n                  break\n\n  return actions", "env_interactions": 26, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T17:37:35.229040", "function_name": "make_arrow", "function_body": "  # Helper mappings for actions\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  # Shortcut references\n  world = env.world                      # CraftWorld instance\n  scenario = env.scenario                # CraftScenario instance\n  grid = scenario.init_grid.copy()       # (W, H, n_kinds) uint8 array\n  pos = tuple(scenario.init_pos)         # (x, y)\n\n  # Identify the goal index for the item \"arrow\"\n  try:\n      goal_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      # If the environment does not expose the index mapping, fall back to name lookup\n      goal_idx = None\n      for name, idx in world.cookbook.index.contents.items():\n          if name.lower() == \"arrow\":\n              goal_idx = idx\n              break\n  if goal_idx is None:\n      return []  # cannot determine goal\n\n  # Determine primitive requirements for one arrow\n  primitive_req = world.cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n  if not primitive_req:\n      # Arrow might be a primitive itself; just need to craft at its workshop\n      primitive_req = {}\n\n  # ----------------------------------------------------------------------\n  # Utility functions\n  # ----------------------------------------------------------------------\n  def is_empty(cell_x, cell_y):\n      \"\"\"Return True if the cell at (cell_x, cell_y) has no entities.\"\"\"\n      return grid[cell_x, cell_y, :].sum() == 0\n\n  def nearest_position(start, candidates):\n      \"\"\"Return the candidate position (x, y) with minimal Manhattan distance.\"\"\"\n      if not candidates:\n          return None\n      sx, sy = start\n      best = None\n      best_dist = None\n      for (cx, cy) in candidates:\n          d = abs(sx - cx) + abs(sy - cy)\n          if best_dist is None or d < best_dist:\n              best_dist, best = d, (cx, cy)\n      return best\n\n  def move_to(cur_pos, target_pos):\n      \"\"\"Generate actions to move from cur_pos to target_pos using Manhattan moves.\"\"\"\n      actions = []\n      x, y = cur_pos\n      tx, ty = target_pos\n      while x < tx:\n          actions.append(ACTION_RIGHT)\n          x += 1\n      while x > tx:\n          actions.append(ACTION_LEFT)\n          x -= 1\n      while y < ty:\n          actions.append(ACTION_DOWN)\n          y += 1\n      while y > ty:\n          actions.append(ACTION_UP)\n          y -= 1\n      return actions, (x, y)\n\n  def adjacent_free_cells(px, py):\n      \"\"\"Return a list of free neighbour cells (including staying on the same cell if free).\"\"\"\n      neighbours = []\n      for dx, dy in [(0, 0), (1, 0), (-1, 0), (0, 1), (0, -1)]:\n          nx, ny = px + dx, py + dy\n          if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and is_empty(nx, ny):\n              neighbours.append((nx, ny))\n      return neighbours\n\n  # ----------------------------------------------------------------------\n  # Collect primitives\n  # ----------------------------------------------------------------------\n  plan_actions = []\n\n  for prim_idx, needed in primitive_req.items():\n      while needed > 0:\n          # Locate all cells that currently contain this primitive\n          locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not locations:\n              # No more primitives of this type on the map \u2013 abort planning\n              return plan_actions\n          # Choose the nearest location\n          target_cell = nearest_position(pos, locations)\n          if target_cell is None:\n              return plan_actions\n\n          # Find a free adjacent cell to stand on before using\n          free_adj = adjacent_free_cells(*target_cell)\n          if not free_adj:\n              # Can't reach this primitive; skip it\n              # Mark it as unavailable by zeroing its count to avoid infinite loop\n              grid[target_cell[0], target_cell[1], prim_idx] = 0\n              continue\n\n          # Choose the free adjacent cell closest to current position\n          stand_cell = nearest_position(pos, free_adj)\n\n          # Move to the standing cell\n          moves, pos = move_to(pos, stand_cell)\n          plan_actions.extend(moves)\n\n          # Use action to pick up the primitive (assumes facing is irrelevant)\n          plan_actions.append(ACTION_USE)\n\n          # Update the grid to reflect the collected primitive\n          grid[target_cell[0], target_cell[1], prim_idx] -= 1\n          needed -= 1\n\n  # ----------------------------------------------------------------------\n  # Move to the appropriate workshop and craft the arrow\n  # ----------------------------------------------------------------------\n  # Identify the workshop kind required for the goal (if any)\n  workshop_kind = None\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  if \"_at\" in recipe:\n      workshop_kind = recipe[\"_at\"]\n\n  if workshop_kind is not None:\n      # Find all workshop cells\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n      if workshop_cells:\n          # Choose the nearest workshop\n          target_workshop = nearest_position(pos, workshop_cells)\n          # Find a free adjacent cell to the workshop\n          free_adj = adjacent_free_cells(*target_workshop)\n          if free_adj:\n              stand_cell = nearest_position(pos, free_adj)\n              moves, pos = move_to(pos, stand_cell)\n              plan_actions.extend(moves)\n              # Use action to craft at the workshop\n              plan_actions.append(ACTION_USE)\n\n  return plan_actions", "env_interactions": 0, "island_id": 9, "scores": {"3": -1}}
