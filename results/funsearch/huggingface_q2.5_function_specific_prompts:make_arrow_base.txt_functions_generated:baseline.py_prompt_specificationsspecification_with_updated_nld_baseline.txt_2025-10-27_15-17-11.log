{"timestamp": "2025-10-27T16:58:30.266297", "function_name": "make_arrow", "function_body": "  # Reset the environment if possible.\n  try:\n      env.reset()\n  except Exception:\n      pass\n\n  # Access the underlying scenario and world objects.\n  scenario = getattr(env, \"scenario\", None) or getattr(env, \"scn\", None)\n  world = getattr(env, \"world\", None) or getattr(env, \"wrld\", None)\n  if scenario is None or world is None:\n      raise RuntimeError(\"Unable to locate scenario or world in the environment.\")\n\n  # Current agent position.\n  pos = tuple(scenario.init_pos)\n\n  # Copy of the initial grid layout.\n  grid = np.array(scenario.init_grid, copy=True)\n\n  # Determine the index for the \"arrow\" goal.\n  if hasattr(env, \"task\") and hasattr(env.task, \"goal\"):\n      goal_idx = env.task.goal\n  else:\n      goal_idx = world.cookbook.index.get(\"arrow\")\n      if goal_idx is None:\n          raise ValueError(\"Arrow item not found in the cookbook.\")\n\n  # Primitives required to craft the arrow.\n  primitives_needed = world.cookbook.primitives_for(goal_idx)\n\n  # Locate all instances of each required primitive on the map.\n  primitive_locs = {}\n  for kind in primitives_needed:\n      ys, xs = np.where(grid[:, :, kind] > 0)  # ys: x\u2011indices, xs: y\u2011indices\n      primitive_locs[kind] = list(zip(xs.tolist(), ys.tolist()))  # (x, y) tuples\n\n  # Locate workshop(s) where the arrow can be crafted.\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  workshop_positions = []\n  if workshop_kind is not None:\n      wy, wx = np.where(grid[:, :, workshop_kind] > 0)\n      workshop_positions = list(zip(wx.tolist(), wy.tolist()))\n  if not workshop_positions:\n      workshop_positions = [pos]  # fallback to current location\n\n  actions = []\n\n  def _move(cur, target):\n      \"\"\"Return a list of actions to move from cur to target (Manhattan moves).\"\"\"\n      act = []\n      x, y = cur\n      tx, ty = target\n      while x < tx:\n          act.append(3)  # RIGHT\n          x += 1\n      while x > tx:\n          act.append(2)  # LEFT\n          x -= 1\n      while y < ty:\n          act.append(0)  # DOWN\n          y += 1\n      while y > ty:\n          act.append(1)  # UP\n          y -= 1\n      return act, (x, y)\n\n  def _pop_nearest(cur, locs):\n      \"\"\"Remove and return the location nearest to cur.\"\"\"\n      if not locs:\n          return None\n      dists = [abs(cur[0] - lx) + abs(cur[1] - ly) for (lx, ly) in locs]\n      idx = int(np.argmin(dists))\n      return locs.pop(idx)\n\n  # Collect each required primitive the necessary number of times.\n  for kind, count in primitives_needed.items():\n      for _ in range(count):\n          target = _pop_nearest(pos, primitive_locs.get(kind, []))\n          if target is None:\n              continue  # no more of this primitive on the map\n          move_seq, pos = _move(pos, target)\n          actions.extend(move_seq)\n          actions.append(4)  # USE to pick up the primitive\n          # Update the grid to reflect the collected item.\n          grid[target[0], target[1], kind] = 0\n\n  # Move to the nearest workshop and craft the arrow.\n  workshop_target = _pop_nearest(pos, workshop_positions)\n  if workshop_target is not None:\n      move_seq, pos = _move(pos, workshop_target)\n      actions.extend(move_seq)\n      actions.append(4)  # USE to craft the arrow\n\n  return actions", "env_interactions": 1, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T16:59:01.491170", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  # Goal definition\n  goal_name = \"arrow\"\n  goal_idx = idx[goal_name]\n\n  # Primitives needed for one arrow\n  primitive_counts = world.cookbook.primitives_for(goal_idx)\n\n  # Workshop required for crafting (if any)\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else idx[wk]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  def find_locations(kind):\n      \"\"\"Return list of (x, y) positions where the grid contains the given kind.\"\"\"\n      occ = np.where(state.grid[:, :, kind] > 0)\n      return list(zip(occ[0].tolist(), occ[1].tolist()))\n\n  def move_action(cur, nxt):\n      \"\"\"Translate a step between adjacent cells into a direction action index.\"\"\"\n      dx = nxt[0] - cur[0]\n      dy = nxt[1] - cur[1]\n      if dx == 1:\n          return 3   # RIGHT\n      if dx == -1:\n          return 2   # LEFT\n      if dy == 1:\n          return 0   # DOWN\n      if dy == -1:\n          return 1   # UP\n      raise ValueError(\"Non\u2011adjacent move requested\")\n\n  def bfs(start, goal):\n      \"\"\"Shortest path (list of positions) from start to goal avoiding non\u2011grabbable cells.\"\"\"\n      if start == goal:\n          return [start]\n      W, H = state.grid.shape[:2]\n\n      # Cells occupied by non\u2011grabbable entities are blocked\n      blocked = set()\n      for ng in world.non_grabbable_indices:\n          occ = np.where(state.grid[:, :, ng] > 0)\n          blocked.update(zip(occ[0].tolist(), occ[1].tolist()))\n\n      q = collections.deque([start])\n      prev = {start: None}\n      while q:\n          cur = q.popleft()\n          for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:\n                  nxt = (nx, ny)\n                  if nxt not in prev:\n                      prev[nxt] = cur\n                      if nxt == goal:\n                          # reconstruct path\n                          path = [goal]\n                          while path[-1] != start:\n                              path.append(prev[path[-1]])\n                          path.reverse()\n                          return path\n                      q.append(nxt)\n      # No path found \u2013 stay where we are\n      return [start]\n\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = state.pos\n\n  # --------------------------------------------------------------\n  # Collect required primitives (nearest first)\n  for prim_idx, needed in primitive_counts.items():\n      for _ in range(needed):\n          locations = find_locations(prim_idx)\n          if not locations:\n              # Assume already in inventory; skip\n              continue\n\n          # Find nearest location via BFS distance\n          best_path = None\n          for loc in locations:\n              path = bfs(cur_pos, loc)\n              if len(path) == 1:   # unreachable\n                  continue\n              if best_path is None or len(path) < len(best_path):\n                  best_path = path\n                  if len(best_path) == 2:   # cannot get shorter than 1 step\n                      break\n\n          if best_path is None:\n              # No reachable primitive; abort further collection\n              continue\n\n          # Follow the path\n          for step in best_path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n\n          # Pick up the primitive\n          actions.append(4)   # USE\n\n  # --------------------------------------------------------------\n  # Move to workshop (if required) and craft\n  if workshop_kind is not None:\n      wk_locations = find_locations(workshop_kind)\n      if wk_locations:\n          best_path = None\n          for loc in wk_locations:\n              path = bfs(cur_pos, loc)\n              if len(path) == 1:\n                  continue\n              if best_path is None or len(path) < len(best_path):\n                  best_path = path\n                  if len(best_path) == 2:\n                      break\n          if best_path is not None:\n              for step in best_path[1:]:\n                  actions.append(move_action(cur_pos, step))\n                  cur_pos = step\n      # Craft at the workshop\n      actions.append(4)   # USE\n  else:\n      # No specific workshop \u2013 craft in place\n      actions.append(4)   # USE\n\n  return actions", "env_interactions": 19, "island_id": 3, "scores": {"3": 0.0}}
