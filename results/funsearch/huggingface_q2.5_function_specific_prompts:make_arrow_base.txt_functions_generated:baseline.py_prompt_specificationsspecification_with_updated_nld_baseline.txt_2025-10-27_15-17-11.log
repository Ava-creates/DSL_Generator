ur = prev[cur]\n      path.reverse()\n      return path\n\n  def delta_to_action(dx, dy):\n      \"\"\"Map a movement delta to the corresponding action index.\"\"\"\n      if dx == 1:\n          return 3   # RIGHT\n      if dx == -1:\n          return 2   # LEFT\n      if dy == 1:\n          return 0   # DOWN\n      if dy == -1:\n          return 1   # UP\n      raise ValueError(\"Invalid movement delta\")\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # Work on a mutable copy of the grid to keep track of collected primitives\n  grid = state.grid.copy()\n\n  # ------------------------------------------------------------------\n  # Collect all required primitives\n  # ------------------------------------------------------------------\n  for kind_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          # locate remaining cells containing this primitive\n          locations = np.argwhere(grid[:, :, kind_idx] > 0)\n          if locations.size == 0:\n              break  # no more of this primitive left\n          # order candidates by Manhattan distance from current position\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n          occupied_mask = np.any(grid, axis=2)  # treat all entities as obstacles\n          target = None\n          path = None\n          for idx in order:\n              cand = tuple(locations[idx])\n              p = bfs_path(cur_pos, cand, occupied_mask)\n              if p is not None:\n                  target = cand\n                  path = p\n                  break\n          if path is None:\n              continue  # cannot reach any remaining instance\n          # follow the path\n          for step in path:\n              dx = step[0] - cur_pos[0]\n              dy = step[1] - cur_pos[1]\n              actions.append(delta_to_action(dx, dy))\n              cur_pos = step\n          # pick up the primitive\n          actions.append(4)  # USE\n          grid[target[0], target[1], kind_idx] = 0  # remove from copy\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          dists = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n          occupied_mask = np.any(state.grid, axis=2)  # original occupancy (workshops are occupied)\n          for idx in order:\n              cand = tuple(workshop_cells[idx])\n              p = bfs_path(cur_pos, cand, occupied_mask)\n              if p is not None:\n                  for step in p:\n                      dx = step[0] - cur_pos[0]\n                      dy = step[1] - cur_pos[1]\n                      actions.append(delta_to_action(dx, dy))\n                      cur_pos = step\n                  actions.append(4)  # USE to trigger crafting\n                  break\n\n  return actions", "env_interactions": 26, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T17:50:06.938766", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Reset the environment to a fresh episode and fetch the initial state.\n  env.reset()\n  state = env._current_state          # type: CraftState\n  world = env.world\n\n  # Identify the goal item index and its primitive requirements.\n  goal_idx = env.task.goal\n  needed = world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n\n  # Determine if the recipe requires a specific workshop.\n  workshop_idx = None\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper utilities.\n  # ------------------------------------------------------------------\n  def locate(kind):\n      \"\"\"Return a list of (x, y) positions where `kind` exists on the grid.\"\"\"\n      inds = np.argwhere(state.grid[:, :, kind] > 0)\n      return [tuple(p) for p in inds]\n\n  def bfs_path(start, target):\n      \"\"\"\n      Compute a shortest sequence of movement actions (0\u2011DOWN,1\u2011UP,2\u2011LEFT,3\u2011RIGHT)\n      from `start` to `target`.  Cells occupied by any entity are treated as\n      blocked, except the target cell itself (which may hold the primitive or\n      workshop we intend to interact with).\n      \"\"\"\n      occ = np.any(state.grid > 0, axis=2)          # True where blocked.\n      w, h = occ.shape\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          pos, path = q.popleft()\n          if pos == target:\n              return path\n          x, y = pos\n          for act, (dx, dy) in ((0, (0, 1)), (1, (0, -1)),\n                                (2, (-1, 0)), (3, (1, 0))):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h:\n                  if not occ[nx, ny] or (nx, ny) == target:\n                      if (nx, ny) not in visited:\n                          visited.add((nx, ny))\n                          q.append(((nx, ny), path + [act]))\n      # No path found \u2013 return empty list.\n      return []\n\n  def move_to(target):\n      \"\"\"Move the agent from its current location to `target`, recording actions.\"\"\"\n      nonlocal state\n      for act in bfs_path(state.pos, target):\n          actions.append(act)\n          _, state = state.step(act)\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives.\n  # ------------------------------------------------------------------\n  for kind, count in needed.items():\n      for _ in range(count):\n          positions = locate(kind)\n          if not positions:\n              # Primitive missing \u2013 abort planning.\n              return actions\n          # Choose the nearest occurrence (Manhattan distance) to reduce travel.\n          target = min(positions,\n                       key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))\n          move_to(target)\n          # Pick up the primitive.\n          actions.append(4)          # USE action.\n          _, state = state.step(4)\n\n  # ------------------------------------------------------------------\n  # 2. Go to the required workshop (if any) and craft the goal.\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_positions = locate(workshop_idx)\n      if ws_positions:\n          target_ws = min(ws_positions,\n                         key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))\n          move_to(target_ws)\n          actions.append(4)          # USE to trigger crafting.\n          _, state = state.step(4)\n  else:\n      # No specific workshop \u2013 attempt to craft at the current location.\n      actions.append(4)\n      _, state = state.step(4)\n\n  return actions", "env_interactions": 1, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T17:50:08.066799", "function_name": "make_arrow", "function_body": "  # Reset the environment and obtain the initial state.\n  env.reset()\n  state = env._current_state          # type: CraftState\n  world = env.world\n\n  # Goal index and primitive requirements.\n  goal_idx = env.task.goal\n  needed = world.cookbook.primitives_for(goal_idx).copy()\n\n  # Identify required workshop (if any).\n  workshop_idx = None\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper utilities.\n  # ------------------------------------------------------------------\n  def locate(kind):\n      \"\"\"Return a list of (x, y) positions where `kind` is present on the grid.\"\"\"\n      inds = np.argwhere(state.grid[:, :, kind] > 0)\n      return [tuple(p) for p in inds]\n\n  def bfs_path(start, target):\n      \"\"\"\n      Bread\u2011first search returning a list of movement actions (0\u2011DOWN,1\u2011UP,2\u2011LEFT,3\u2011RIGHT)\n      that brings the agent from `start` to `target`. Cells occupied by any entity are\n      considered blocked, except the target cell itself.\n      \"\"\"\n      occ = np.any(state.grid > 0, axis=2)          # True where blocked.\n      w, h = occ.shape\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          pos, path = q.popleft()\n          if pos == target:\n              return path\n          x, y = pos\n          for act, (dx, dy) in ((0, (0, 1)), (1, (0, -1)),\n                                (2, (-1, 0)), (3, (1, 0))):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h:\n                  if not occ[nx, ny] or (nx, ny) == target:\n                      if (nx, ny) not in visited:\n                          visited.add((nx, ny))\n                          q.append(((nx, ny), path + [act]))\n      return []  # No path found.\n\n  def move_to(target):\n      \"\"\"Move the agent from its current location to `target`, recording actions.\"\"\"\n      nonlocal state\n      for act in bfs_path(state.pos, target):\n          actions.append(act)\n          _, state = state.step(act)\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives.\n  # ------------------------------------------------------------------\n  for kind, count in needed.items():\n      for _ in range(count):\n          positions = locate(kind)\n          if not positions:\n              # Primitive missing \u2013 abort planning.\n              return actions\n          # Choose the nearest occurrence (Manhattan distance).\n          target = min(positions,\n                       key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))\n          move_to(target)\n          # Pick up the primitive.\n          actions.append(4)          # USE action.\n          _, state = state.step(4)\n\n  # ------------------------------------------------------------------\n  # 2. Go to the required workshop (if any) and craft the goal.\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_positions = locate(workshop_idx)\n      if ws_positions:\n          target_ws = min(ws_positions,\n                         key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))\n          move_to(target_ws)\n          actions.append(4)          # USE to craft.\n          _, state = state.step(4)\n  else:\n      # No specific workshop \u2013 attempt to craft at current location.\n      actions.append(4)\n      _, state = state.step(4)\n\n  return actions", "env_interactions": 1, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T17:50:46.856474", "function_name": "make_arrow", "function_body": "  # Reset the environment to start fresh\n  env.reset()\n  world = env.world\n  scenario = env.scenario\n  state = env._current_state\n\n  # Goal index and primitive requirements\n  goal_idx = env.task.goal\n  needed = world.cookbook.primitives_for(goal_idx)          # {primitive_kind: count}\n\n  # Determine if the final recipe must be performed at a specific workshop\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else world.cookbook.index[wk]\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # ------------------------------------------------------------------\n  # Helper: Manhattan move sequence (DOWN=0, UP=1, LEFT=2, RIGHT=3)\n  # ------------------------------------------------------------------\n  def moves_to(start, target):\n      x, y = start\n      tx, ty = target\n      seq = []\n      while x < tx:\n          seq.append(3)   # RIGHT\n          x += 1\n      while x > tx:\n          seq.append(2)   # LEFT\n          x -= 1\n      while y < ty:\n          seq.append(0)   # DOWN\n          y += 1\n      while y > ty:\n          seq.append(1)   # UP\n          y -= 1\n      return seq, (x, y)\n\n  # ------------------------------------------------------------------\n  # Helper: locate nearest cell that still contains the required kind\n  # ------------------------------------------------------------------\n  def nearest_cell(kind, from_pos, grid):\n      cells = np.argwhere(grid[:, :, kind] > 0)\n      if cells.size == 0:\n          return None\n      dists = np.abs(cells[:, 0] - from_pos[0]) + np.abs(cells[:, 1] - from_pos[1])\n      idx = dists.argmin()\n      return tuple(cells[idx])\n\n  # Make a mutable copy of the initial grid so we can \u201cconsume\u201d items once taken\n  grid_copy = scenario.init_grid.copy()\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitive items\n  # ------------------------------------------------------------------\n  for kind, cnt in needed.items():\n      for _ in range(cnt):\n          target = nearest_cell(kind, cur_pos, grid_copy)\n          if target is None:\n              # No more of this primitive left; break early\n              break\n          move_seq, cur_pos = moves_to(cur_pos, target)\n          actions.extend(move_seq)\n          actions.append(4)                     # USE to pick up the primitive\n          # Mark the primitive as taken so we don't try to collect it again\n          grid_copy[target[0], target[1], kind] = 0\n\n  # ------------------------------------------------------------------\n  # 2) If a workshop is required, go there and craft the final item\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      workshop_target = nearest_cell(workshop_kind, cur_pos, scenario.init_grid)\n      if workshop_target is not None:\n          move_seq, cur_pos = moves_to(cur_pos, workshop_target)\n          actions.extend(move_seq)\n          actions.append(4)                     # USE to craft at the workshop\n\n  # Return the complete action list\n  return actions", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T17:50:47.987375", "function_name": "make_arrow", "function_body": "  # Reset environment and extract useful objects\n  env.reset()\n  world = env.world\n  scenario = env.scenario\n  state = env._current_state\n\n  goal_idx = env.task.goal\n  # Primitive requirements for the final goal (may be empty if goal is primitive)\n  required = world.cookbook.primitives_for(goal_idx)\n\n  # Determine if the final recipe requires a specific workshop\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else world.cookbook.index[wk]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  # Action indices (consistent with CraftWorld)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Convert a move (dx,dy) into an action index\n  def move_to_action(dx, dy):\n      if dx == 1:\n          return RIGHT\n      if dx == -1:\n          return LEFT\n      if dy == 1:\n          return DOWN\n      if dy == -1:\n          return UP\n      raise ValueError(\"Invalid move delta\")\n\n  # Manhattan BFS that treats any non\u2011empty cell as blocked,\n  # except the goal cell which is allowed even if occupied.\n  def bfs_path(start, goal, blocked):\n      from collections import deque\n      W, H = blocked.shape\n      q = deque()\n      q.append(start)\n      visited = np.full((W, H), False, dtype=bool)\n      visited[start] = True\n      parent = {}\n      while q:\n          x, y = q.popleft()\n          if (x, y) == goal:\n              # reconstruct path (including start and goal)\n              path = [(x, y)]\n              while (x, y) != start:\n                  x, y = parent[(x, y)]\n                  path.append((x, y))\n              path.reverse()\n              return path\n          for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  # allow stepping onto the goal even if blocked\n                  if (nx, ny) == goal or not blocked[nx, ny]:\n                      visited[nx, ny] = True\n                      parent[(nx, ny)] = (x, y)\n                      q.append((nx, ny))\n      return None  # no path found\n\n  # Convert a path (list of positions) into a list of actions.\n  # The path must contain at least two positions.\n  def actions_from_path(path):\n      acts = []\n      for (x0, y0), (x1, y1) in zip(path, path[1:]):\n          dx, dy = x1 - x0, y1 - y0\n          acts.append(move_to_action(dx, dy))\n      return acts\n\n  # ------------------------------------------------------------------\n  # Prepare mutable copies of the grid for bookkeeping\n  # ------------------------------------------------------------------\n  # Static grid (contains items, workshops, obstacles)\n  static_grid = scenario.init_grid\n  # Mutable copy to clear primitives once taken\n  mutable_grid = static_grid.copy()\n  # Blocked mask (True where cell is occupied)\n  blocked_mask = (static_grid.sum(axis=2) > 0)\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (handling multiplicities)\n  # ------------------------------------------------------------------\n  for kind_idx, count in required.items():\n      for _ in range(count):\n          # Find the nearest remaining primitive of this kind\n          locations = np.argwhere(mutable_grid[:, :, kind_idx] > 0)\n          if locations.size == 0:\n              # No more primitives of this kind; give up on this item\n              continue\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          target_idx = dists.argmin()\n          target = tuple(locations[target_idx])\n\n          # Plan a path to the target cell (allowed to step onto it)\n          path = bfs_path(cur_pos, target, blocked_mask)\n          if path is None:\n              # If unreachable, skip this primitive\n              continue\n          # Convert path to actions and execute\n          actions.extend(actions_from_path(path))\n\n          # After arriving on the primitive cell, step back one cell\n          # (the previous cell in the path) to be adjacent and facing it.\n          if len(path) >= 2:\n              back_step = path[-2]  # cell before the target\n              dx, dy = back_step[0] - target[0], back_step[1] - target[1]\n              actions.append(move_to_action(dx, dy))\n              cur_pos = back_step\n          else:\n              # Edge case: start already on the target; just try a dummy move\n              # Try moving RIGHT if possible, otherwise LEFT, etc.\n              moved = False\n              for dx, dy, act in [(1, 0, RIGHT), (-1, 0, LEFT), (0, 1, DOWN), (0, -1, UP)]:\n                  nx, ny = cur_pos[0] + dx, cur_pos[1] + dy\n                  if 0 <= nx < blocked_mask.shape[0] and 0 <= ny < blocked_mask.shape[1] and not blocked_mask[nx, ny]:\n                      actions.append(act)\n                      cur_pos = (nx, ny)\n                      moved = True\n                      break\n              if not moved:\n                  # No free neighbour; stay where we are\n                  cur_pos = cur_pos\n\n          # Use the USE action to pick up the primitive\n          actions.append(USE)\n\n          # Update mutable grid and blocked mask (primitive removed)\n          mutable_grid[target[0], target[1], kind_idx] = 0\n          blocked_mask[target[0], target[1]] = False\n\n  # ------------------------------------------------------------------\n  # If a workshop is required for the final crafting step, move there\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      # Locate the nearest workshop of the required kind\n      ws_locs = np.argwhere(static_grid[:, :, workshop_kind] > 0)\n      if ws_locs.size > 0:\n          dists = np.abs(ws_locs[:, 0] - cur_pos[0]) + np.abs(ws_locs[:, 1] - cur_pos[1])\n          ws_target = tuple(ws_locs[dists.argmin()])\n\n          # Path to the workshop cell (allowed to step onto it)\n          ws_path = bfs_path(cur_pos, ws_target, blocked_mask)\n          if ws_path is not None:\n              actions.extend(actions_from_path(ws_path))\n\n              # Step back one cell to be adjacent and facing the workshop\n              if len(ws_path) >= 2:\n                  back_step = ws_path[-2]\n                  dx, dy = back_step[0] - ws_target[0], back_step[1] - ws_target[1]\n                  actions.append(move_to_action(dx, dy))\n                  cur_pos = back_step\n              else:\n                  # Same fallback as above if already on workshop\n                  moved = False\n                  for dx, dy, act in [(1, 0, RIGHT), (-1, 0, LEFT), (0, 1, DOWN), (0, -1, UP)]:\n                      nx, ny = cur_pos[0] + dx, cur_pos[1] + dy\n                      if 0 <= nx < blocked_mask.shape[0] and 0 <= ny < blocked_mask.shape[1] and not blocked_mask[nx, ny]:\n                          actions.append(act)\n                          cur_pos = (nx, ny)\n                          moved = True\n                          break\n                  if not moved:\n                      cur_pos = cur_pos\n\n              # Use the workshop to craft the final item\n              actions.append(USE)\n\n  return actions", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T17:51:11.701998", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  # ------------------------------------------------------------------\n  # Identify goal (arrow) and its recipe\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n  if goal_idx is None:\n      return []\n\n  primitive_needs = cookbook.primitives_for(goal_idx)          # {kind_idx: count}\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  if \"_at\" in recipe:\n      workshop_idx = cookbook.index[recipe[\"_at\"]]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  from collections import deque\n  import numpy as np\n\n  def bfs_path(start, goal, occupied):\n      \"\"\"Return a list of positions from start (excluded) to goal (included).\"\"\"\n      w, h = occupied.shape\n      visited = np.zeros((w, h), dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start] = True\n      while q:\n          x, y = q.popleft()\n          if (x, y) == goal:\n              break\n          for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):\n              if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:\n                  if (nx, ny) == goal or not occupied[nx, ny]:\n                      visited[nx, ny] = True\n                      prev[(nx, ny)] = (x, y)\n                      q.append((nx, ny))\n      if not visited[goal]:\n          return None\n      path = []\n      cur = goal\n      while cur != start:\n          path.append(cur)\n          cur = prev[cur]\n      path.reverse()\n      return path\n\n  def delta_to_action(dx, dy):\n      \"\"\"Translate a movement delta into an environment action index.\"\"\"\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise ValueError(\"Invalid movement delta\")\n\n  actions = []\n  cur_pos = tuple(state.pos)          # (x, y)\n  grid = state.grid.copy()            # mutable copy to track collected items\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitive items\n  # ------------------------------------------------------------------\n  for kind_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          locations = np.argwhere(grid[:, :, kind_idx] > 0)\n          if locations.size == 0:\n              break\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n          occupied = np.any(grid, axis=2)          # treat any entity as blocked\n          target = None\n          path = None\n          for idx in order:\n              cand = tuple(locations[idx])\n              p = bfs_path(cur_pos, cand, occupied)\n              if p is not None:\n                  target = cand\n                  path = p\n                  break\n          if path is None:\n              continue\n          for step in path:\n              dx = step[0] - cur_pos[0]\n              dy = step[1] - cur_pos[1]\n              actions.append(delta_to_action(dx, dy))\n              cur_pos = step\n          actions.append(4)          # USE to pick up\n          grid[target[0], target[1], kind_idx] = 0   # remove from mutable copy\n\n  # ------------------------------------------------------------------\n  # 2) Move to workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size:\n          dists = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n          occupied = np.any(state.grid, axis=2)    # original occupancy (workshops are occupied but reachable)\n          for idx in order:\n              cand = tuple(workshop_cells[idx])\n              p = bfs_path(cur_pos, cand, occupied)\n              if p is not None:\n                  for step in p:\n                      dx = step[0] - cur_pos[0]\n                      dy = step[1] - cur_pos[1]\n                      actions.append(delta_to_action(dx, dy))\n                      cur_pos = step\n                  actions.append(4)               # USE to trigger crafting\n                  break\n  else:\n      actions.append(4)                           # USE on current cell if no workshop needed\n\n  return actions", "env_interactions": 26, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T17:51:12.828554", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world\n  cookbook = world.cookbook\n\n  # --------------------------------------------------------------\n  # Identify goal (arrow) and its recipe\n  # --------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n  if goal_idx is None:\n      return []                       # unknown goal\n\n  primitive_needs = cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  if \"_at\" in recipe:\n      workshop_idx = cookbook.index[recipe[\"_at\"]]\n\n  # --------------------------------------------------------------\n  # Helper utilities\n  # --------------------------------------------------------------\n  from collections import deque\n  import numpy as np\n\n  def bfs_path(start, goal, occupied):\n      \"\"\"Return list of positions from start (excluded) to goal (included).\"\"\"\n      w, h = occupied.shape\n      visited = np.zeros((w, h), dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start] = True\n      while q:\n          x, y = q.popleft()\n          if (x, y) == goal:\n              break\n          for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):\n              if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:\n                  if (nx, ny) == goal or not occupied[nx, ny]:\n                      visited[nx, ny] = True\n                      prev[(nx, ny)] = (x, y)\n                      q.append((nx, ny))\n      if not visited[goal]:\n          return None\n      path = []\n      cur = goal\n      while cur != start:\n          path.append(cur)\n          cur = prev[cur]\n      path.reverse()\n      return path\n\n  def delta_to_action(dx, dy):\n      \"\"\"Convert a movement delta to the env's action index.\"\"\"\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise ValueError(\"Invalid movement delta\")\n\n  # --------------------------------------------------------------\n  # Planning\n  # --------------------------------------------------------------\n  actions = []\n  cur_pos = tuple(state.pos)\n  grid = state.grid.copy()            # mutable copy for tracking collection\n\n  # --------------------------------------------------------------\n  # 1) Collect required primitives\n  # --------------------------------------------------------------\n  for kind_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          # locate remaining instances of this primitive\n          candidates = np.argwhere(grid[:, :, kind_idx] > 0)\n          if candidates.size == 0:\n              break\n          # order by Manhattan distance\n          dists = np.abs(candidates[:, 0] - cur_pos[0]) + np.abs(candidates[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n\n          occupied_mask = np.any(grid, axis=2)   # any entity blocks movement\n          target = None\n          path = None\n          for idx in order:\n              cand = tuple(candidates[idx])\n              p = bfs_path(cur_pos, cand, occupied_mask)\n              if p is not None:\n                  target = cand\n                  path = p\n                  break\n          if path is None:\n              continue    # cannot reach this primitive\n\n          # follow path\n          for step in path:\n              dx = step[0] - cur_pos[0]\n              dy = step[1] - cur_pos[1]\n              actions.append(delta_to_action(dx, dy))\n              cur_pos = step\n          # pick up primitive\n          actions.append(4)          # USE\n          grid[target[0], target[1], kind_idx] = 0\n\n  # --------------------------------------------------------------\n  # 2) Move to workshop (if any) and craft the arrow\n  # --------------------------------------------------------------\n  if workshop_idx is not None:\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          dists = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n          occupied_mask = np.any(state.grid, axis=2)   # original occupancy\n          for idx in order:\n              target = tuple(workshop_cells[idx])\n              p = bfs_path(cur_pos, target, occupied_mask)\n              if p is not None:\n                  for step in p:\n                      dx = step[0] - cur_pos[0]\n                      dy = step[1] - cur_pos[1]\n                      actions.append(delta_to_action(dx, dy))\n                      cur_pos = step\n                  actions.append(4)   # USE to craft\n                  break\n  else:\n      # no specific workshop required\n      actions.append(4)   # USE to craft at current location\n\n  return actions", "env_interactions": 26, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T17:51:42.677032", "function_name": "make_arrow", "function_body": "  # reset environment and get current state/world\n  env.reset()\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  # goal information\n  goal_name = \"arrow\"\n  goal_idx = idx[goal_name]\n\n  # primitives needed for one arrow (already flattened)\n  primitive_counts = world.cookbook.primitives_for(goal_idx)\n\n  # workshop required for this recipe (if any)\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else idx[wk]\n\n  # --------------------------------------------------------------\n  # helper utilities\n  # --------------------------------------------------------------\n  def find_locations(kind):\n      \"\"\"Return list of (x, y) where cells contain at least one of `kind`.\"\"\"\n      occ = np.where(state.grid[:, :, kind] > 0)\n      return list(zip(occ[0].tolist(), occ[1].tolist()))\n\n  def step_to_action(cur, nxt):\n      \"\"\"Convert an adjacent move into the corresponding action index.\"\"\"\n      dx = nxt[0] - cur[0]\n      dy = nxt[1] - cur[1]\n      if dx == 1:\n          return 3   # RIGHT\n      if dx == -1:\n          return 2   # LEFT\n      if dy == 1:\n          return 0   # DOWN\n      if dy == -1:\n          return 1   # UP\n      raise AssertionError(\"Non\u2011adjacent step supplied to step_to_action\")\n\n  def bfs(start, goal):\n      \"\"\"Shortest Manhattan path avoiding non\u2011grabbable cells.\"\"\"\n      if start == goal:\n          return [start]\n      W, H = state.grid.shape[:2]\n\n      # cells occupied by non\u2011grabbable entities are impassable\n      blocked = set()\n      for ng in world.non_grabbable_indices:\n          occ = np.where(state.grid[:, :, ng] > 0)\n          blocked.update(zip(occ[0].tolist(), occ[1].tolist()))\n\n      q = collections.deque([start])\n      prev = {start: None}\n      while q:\n          cur = q.popleft()\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:\n                  nxt = (nx, ny)\n                  if nxt not in prev:\n                      prev[nxt] = cur\n                      if nxt == goal:\n                          # reconstruct path\n                          path = [goal]\n                          while path[-1] != start:\n                              path.append(prev[path[-1]])\n                          path.reverse()\n                          return path\n                      q.append(nxt)\n      # no path found \u2013 stay where we are\n      return [start]\n\n  # --------------------------------------------------------------\n  # build the action sequence\n  # --------------------------------------------------------------\n  actions = []\n  cur_pos = state.pos\n\n  # 1) collect all required primitives\n  for prim_idx, needed in primitive_counts.items():\n      while needed > 0:\n          locations = find_locations(prim_idx)\n          if not locations:\n              # primitive not present on map \u2013 cannot continue\n              raise RuntimeError(f\"Primitive {idx.get(prim_idx, prim_idx)} not found\")\n          # choose the nearest location (Manhattan distance)\n          target = min(locations,\n                       key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1]))\n          # move to the target\n          path = bfs(cur_pos, target)\n          for step in path[1:]:\n              actions.append(step_to_action(cur_pos, step))\n              cur_pos = step\n          # pick up one unit\n          actions.append(4)   # USE\n          needed -= 1\n\n  # 2) go to workshop (if required) and craft\n  if workshop_kind is not None:\n      wk_locations = find_locations(workshop_kind)\n      if not wk_locations:\n          raise RuntimeError(\"Required workshop not found on map\")\n      target = min(wk_locations,\n                   key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1]))\n      path = bfs(cur_pos, target)\n      for step in path[1:]:\n          actions.append(step_to_action(cur_pos, step))\n          cur_pos = step\n      actions.append(4)   # USE to craft at workshop\n  else:\n      # no specific workshop \u2013 just attempt to craft at current location\n      actions.append(4)   # USE to craft\n\n  return actions", "env_interactions": 19, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T17:51:43.805176", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  goal_name = \"arrow\"\n  goal_idx = idx[goal_name]\n\n  # primitives needed for one arrow\n  primitive_counts = world.cookbook.primitives_for(goal_idx)\n\n  # workshop required for arrow (if any)\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else idx[wk]\n\n  # ------------------------------------------------------------------\n  # helper functions\n  # ------------------------------------------------------------------\n  def find_locations(kind):\n      occ = np.where(state.grid[:, :, kind] > 0)\n      return list(zip(occ[0].tolist(), occ[1].tolist()))\n\n  def move_action(cur, nxt):\n      dx = nxt[0] - cur[0]\n      dy = nxt[1] - cur[1]\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise ValueError(\"non\u2011adjacent move\")\n\n  def bfs(start, goal):\n      if start == goal:\n          return [start]\n      W, H = state.grid.shape[:2]\n\n      # cells occupied by non\u2011grabbable entities are impassable\n      blocked = set()\n      for ng in world.non_grabbable_indices:\n          occ = np.where(state.grid[:, :, ng] > 0)\n          blocked.update(zip(occ[0].tolist(), occ[1].tolist()))\n\n      q = collections.deque([start])\n      prev = {start: None}\n      while q:\n          cur = q.popleft()\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:\n                  nxt = (nx, ny)\n                  if nxt not in prev:\n                      prev[nxt] = cur\n                      if nxt == goal:\n                          # reconstruct path\n                          path = [goal]\n                          while path[-1] != start:\n                              path.append(prev[path[-1]])\n                          path.reverse()\n                          return path\n                      q.append(nxt)\n      # no path found \u2013 stay in place\n      return [start]\n\n  # ------------------------------------------------------------------\n  # build the action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = state.pos\n\n  # 1) Gather each required primitive\n  for prim_idx, needed in primitive_counts.items():\n      for _ in range(needed):\n          locations = find_locations(prim_idx)\n          if not locations:\n              raise RuntimeError(f\"Primitive {idx.get(prim_idx, prim_idx)} not found on map\")\n          # nearest primitive location (Manhattan distance)\n          target = min(locations,\n                       key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1]))\n          path = bfs(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n          actions.append(4)   # USE to pick up\n\n  # 2) Move to workshop (if required) and craft\n  if workshop_kind is not None:\n      wk_locations = find_locations(workshop_kind)\n      if not wk_locations:\n          raise RuntimeError(\"Required workshop not found on map\")\n      target = min(wk_locations,\n                   key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1]))\n      path = bfs(cur_pos, target)\n      for step in path[1:]:\n          actions.append(move_action(cur_pos, step))\n          cur_pos = step\n      actions.append(4)   # USE to craft\n\n  return actions", "env_interactions": 19, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T17:52:04.252126", "function_name": "make_arrow", "function_body": "  env.reset()\n  world = env.world\n  scenario = env.scenario\n  state = env._current_state\n\n  # Goal index (the item we need to make)\n  goal_idx = env.task.goal\n\n  # Primitive requirements for the goal (including transitive primitives)\n  required = world.cookbook.primitives_for(goal_idx)\n\n  # Determine if the goal must be crafted at a specific workshop\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else world.cookbook.index[wk]\n\n  actions: list[int] = []\n  cur_pos = tuple(state.pos)\n\n  # ------------------------------------------------------------------\n  # Helper: Manhattan move sequence (action indices)\n  #   DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n  # ------------------------------------------------------------------\n  def moves_to(start, target):\n      x, y = start\n      tx, ty = target\n      seq = []\n      while x < tx:\n          seq.append(3)   # RIGHT\n          x += 1\n      while x > tx:\n          seq.append(2)   # LEFT\n          x -= 1\n      while y < ty:\n          seq.append(0)   # DOWN\n          y += 1\n      while y > ty:\n          seq.append(1)   # UP\n          y -= 1\n      return seq, (x, y)\n\n  # ------------------------------------------------------------------\n  # Helper: locate the nearest unused cell that contains the given kind.\n  # ------------------------------------------------------------------\n  used_cells: dict[int, set[tuple[int, int]]] = {}\n\n  def nearest_cell(kind, from_pos):\n      cells = np.argwhere(scenario.init_grid[:, :, kind] > 0)\n      if cells.size == 0:\n          return None\n      used = used_cells.get(kind, set())\n      candidates = [tuple(c) for c in cells if tuple(c) not in used]\n      if not candidates:\n          return None\n      dists = [abs(c[0] - from_pos[0]) + abs(c[1] - from_pos[1]) for c in candidates]\n      idx = int(np.argmin(dists))\n      return candidates[idx]\n\n  # ------------------------------------------------------------------\n  # Collect all required primitive items.\n  # ------------------------------------------------------------------\n  for kind, cnt in required.items():\n      used_cells.setdefault(kind, set())\n      for _ in range(cnt):\n          target = nearest_cell(kind, cur_pos)\n          if target is None:\n              # No more of this primitive on the map; give up on this item.\n              break\n          move_seq, cur_pos = moves_to(cur_pos, target)\n          actions.extend(move_seq)\n          actions.append(4)                # USE to pick up the primitive\n          used_cells[kind].add(target)     # mark cell as harvested\n\n  # ------------------------------------------------------------------\n  # Move to the workshop (if required) and craft the goal.\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      target = nearest_cell(workshop_kind, cur_pos)\n      if target is not None:\n          move_seq, cur_pos = moves_to(cur_pos, target)\n          actions.extend(move_seq)\n      actions.append(4)                    # USE to craft at the workshop\n  else:\n      # If no specific workshop, a final USE attempts crafting in place.\n      actions.append(4)\n\n  return actions", "env_interactions": 1, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T17:52:05.365242", "function_name": "make_arrow", "function_body": "  # Reset environment to start fresh\n  env.reset()\n  world = env.world\n  scenario = env.scenario\n  state = env._current_state\n\n  # Index of the goal item (arrow)\n  goal_idx = env.task.goal\n\n  # Primitive requirements (including transitive) for one arrow\n  required = world.cookbook.primitives_for(goal_idx)\n\n  # Determine if a specific workshop is needed for the final craft\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else world.cookbook.index[wk]\n\n  actions: list[int] = []\n  cur_pos = tuple(state.pos)\n\n  # ------------------------------------------------------------------\n  # Helper: Manhattan moves from start to target using action indices.\n  # Encoding: DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n  # ------------------------------------------------------------------\n  def moves_to(start, target):\n      x, y = start\n      tx, ty = target\n      seq = []\n      while x < tx:\n          seq.append(3)   # RIGHT\n          x += 1\n      while x > tx:\n          seq.append(2)   # LEFT\n          x -= 1\n      while y < ty:\n          seq.append(0)   # DOWN\n          y += 1\n      while y > ty:\n          seq.append(1)   # UP\n          y -= 1\n      return seq, (x, y)\n\n  # ------------------------------------------------------------------\n  # Helper: locate the nearest cell containing the given kind that has\n  # not been harvested yet.\n  # ------------------------------------------------------------------\n  harvested: dict[int, set[tuple[int, int]]] = {}\n\n  def nearest_cell(kind, from_pos):\n      cells = np.argwhere(scenario.init_grid[:, :, kind] > 0)\n      if cells.size == 0:\n          return None\n      used = harvested.get(kind, set())\n      candidates = [tuple(c) for c in cells if tuple(c) not in used]\n      if not candidates:\n          return None\n      dists = [abs(c[0] - from_pos[0]) + abs(c[1] - from_pos[1]) for c in candidates]\n      idx = int(np.argmin(dists))\n      return candidates[idx]\n\n  # ------------------------------------------------------------------\n  # Collect all required primitive items.\n  # ------------------------------------------------------------------\n  for kind, cnt in required.items():\n      harvested.setdefault(kind, set())\n      for _ in range(cnt):\n          target = nearest_cell(kind, cur_pos)\n          if target is None:\n              # Primitive not found; skip (the task may be impossible)\n              continue\n          move_seq, cur_pos = moves_to(cur_pos, target)\n          actions.extend(move_seq)\n          actions.append(4)               # USE to pick up the primitive\n          harvested[kind].add(target)     # mark this cell as used\n\n  # ------------------------------------------------------------------\n  # If a workshop is required, move to the nearest one.\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      target = nearest_cell(workshop_kind, cur_pos)\n      if target is not None:\n          move_seq, cur_pos = moves_to(cur_pos, target)\n          actions.extend(move_seq)\n\n  # Final USE to trigger the crafting of the arrow\n  actions.append(4)\n\n  return actions", "env_interactions": 1, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T17:52:25.942050", "function_name": "make_arrow", "function_body": "  # Reset environment and grab useful references\n  env.reset()\n  state = env._current_state          # type: CraftState\n  world = env.scenario.world\n  cookbook = world.cookbook\n  index = cookbook.index\n\n  # Action IDs according to the environment spec\n  action_map = env.action_specs()\n  DOWN = action_map[\"DOWN\"]\n  UP = action_map[\"UP\"]\n  LEFT = action_map[\"LEFT\"]\n  RIGHT = action_map[\"RIGHT\"]\n  USE = action_map[\"USE\"]\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow) and the primitive ingredients required.\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  if goal_name not in index.contents:\n      return []                     # Arrow not defined in this world\n\n  goal_idx = index[goal_name]      # integer ID of the arrow item\n  primitive_needs = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n  actions = []                     # will hold the final action sequence\n\n  # ------------------------------------------------------------------\n  # Helper: BFS path finder that avoids occupied cells (except target).\n  # ------------------------------------------------------------------\n  import numpy as np\n  from collections import deque\n\n  height, width = state.grid.shape[:2]\n  moves = [(DOWN, (1, 0)),\n           (UP, (-1, 0)),\n           (LEFT, (0, -1)),\n           (RIGHT, (0, 1))]\n\n  def bfs_path(start, target):\n      \"\"\"Return a list of move actions to go from start to target.\"\"\"\n      if start == target:\n          return []\n\n      queue = deque([start])\n      visited = {start}\n      parent = {}\n\n      while queue:\n          cur = queue.popleft()\n          if cur == target:\n              break\n          for act, (dr, dc) in moves:\n              nr, nc = cur[0] + dr, cur[1] + dc\n              if not (0 <= nr < height and 0 <= nc < width):\n                  continue\n              nxt = (nr, nc)\n\n              # Allow stepping onto the target even if it is occupied.\n              if nxt != target and state.grid[nr, nc].any():\n                  continue\n              if nxt in visited:\n                  continue\n              visited.add(nxt)\n              parent[nxt] = (cur, act)\n              queue.append(nxt)\n\n      if target not in parent and start != target:\n          return []      # no path found\n\n      # Reconstruct path\n      path = []\n      cur = target\n      while cur != start:\n          prev, act = parent[cur]\n          path.append(act)\n          cur = prev\n      path.reverse()\n      return path\n\n  # ------------------------------------------------------------------\n  # 1. Collect each required primitive (respecting multiplicities).\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # Primitive not present \u2013 abort early.\n              return actions\n          tr, tc = prim_cells[0]\n\n          # Move to the primitive cell.\n          move_seq = bfs_path(state.pos, (tr, tc))\n          actions.extend(move_seq)\n          state.pos = (tr, tc)\n\n          # Pick it up.\n          actions.append(USE)\n\n          # Update our internal copy of the state.\n          state.inventory[prim_idx] += 1\n          state.grid[tr, tc, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 2. Go to the appropriate workshop and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      return actions                     # No workshop information.\n\n  workshop_idx = index[workshop_name]\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      return actions                     # No workshop cell found.\n\n  wr, wc = workshop_cells[0]\n\n  move_seq = bfs_path(state.pos, (wr, wc))\n  actions.extend(move_seq)\n  state.pos = (wr, wc)\n\n  # Craft the arrow.\n  actions.append(USE)\n\n  return actions", "env_interactions": 28, "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T17:52:27.066432", "function_name": "make_arrow", "function_body": "  # Reset environment and get references to world structures\n  env.reset()\n  state = env._current_state\n  world = env.scenario.world\n  cookbook = world.cookbook\n  index = cookbook.index\n\n  # Action identifiers (match CraftLab.action_specs)\n  act_map = env.action_specs()\n  DOWN = act_map[\"DOWN\"]\n  UP = act_map[\"UP\"]\n  LEFT = act_map[\"LEFT\"]\n  RIGHT = act_map[\"RIGHT\"]\n  USE = act_map[\"USE\"]\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow) and its primitive requirements.\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  if goal_name not in index.contents:\n      return []                     # arrow not defined in this world\n\n  goal_idx = index[goal_name]      # integer id of the arrow item\n  primitive_needs = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n  actions = []                     # list of actions to be returned\n\n  # ------------------------------------------------------------------\n  # Helper: BFS to find a path avoiding occupied cells (except target).\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  h, w = state.grid.shape[:2]\n  moves = [\n      (DOWN, (1, 0)),\n      (UP, (-1, 0)),\n      (LEFT, (0, -1)),\n      (RIGHT, (0, 1)),\n  ]\n\n  def bfs_path(start, target):\n      \"\"\"Return a list of move actions to go from start to target.\"\"\"\n      if start == target:\n          return []\n\n      queue = deque([start])\n      visited = {start}\n      parent = {}\n\n      while queue:\n          cur = queue.popleft()\n          if cur == target:\n              break\n          for act, (dr, dc) in moves:\n              nr, nc = cur[0] + dr, cur[1] + dc\n              if not (0 <= nr < h and 0 <= nc < w):\n                  continue\n              nxt = (nr, nc)\n\n              # Allow stepping onto the target even if occupied.\n              if nxt != target and state.grid[nr, nc].any():\n                  continue\n              if nxt in visited:\n                  continue\n              visited.add(nxt)\n              parent[nxt] = (cur, act)\n              queue.append(nxt)\n\n      if target not in parent and start != target:\n          return []      # no path found\n\n      # Reconstruct path.\n      path = []\n      cur = target\n      while cur != start:\n          prev, act = parent[cur]\n          path.append(act)\n          cur = prev\n      path.reverse()\n      return path\n\n  # ------------------------------------------------------------------\n  # 1. Collect each required primitive (handling multiplicities).\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # Primitive unavailable \u2013 abort early.\n              return actions\n          tr, tc = prim_cells[0]\n\n          # Move to the primitive cell.\n          move_seq = bfs_path(state.pos, (tr, tc))\n          actions.extend(move_seq)\n          state.pos = (tr, tc)\n\n          # Pick it up.\n          actions.append(USE)\n\n          # Update internal copy of the state.\n          state.inventory[prim_idx] += 1\n          state.grid[tr, tc, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 2. Go to the workshop for the arrow and craft it.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      return actions                     # No workshop info.\n\n  workshop_idx = index[workshop_name]\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      return actions                     # No workshop found.\n\n  wr, wc = workshop_cells[0]\n\n  # Move to the workshop cell.\n  move_seq = bfs_path(state.pos, (wr, wc))\n  actions.extend(move_seq)\n  state.pos = (wr, wc)\n\n  # Craft the arrow.\n  actions.append(USE)\n\n  return actions", "env_interactions": 28, "island_id": 1, "scores": {"3": 1.5}}
