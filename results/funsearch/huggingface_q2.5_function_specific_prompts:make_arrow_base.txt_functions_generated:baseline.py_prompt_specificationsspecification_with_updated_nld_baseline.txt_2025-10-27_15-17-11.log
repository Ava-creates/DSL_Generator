{"timestamp": "2025-10-27T17:00:17.507015", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state          # CraftState instance\n  world = env.world                    # CraftWorld instance\n  cookbook = world.cookbook\n\n  # Goal item index (the arrow) is stored in the task specification.\n  goal_idx = env.task.goal\n\n  # Determine the primitive resources required to craft the goal.\n  # primitives_for returns a dict {primitive_idx: count}.\n  needed = dict(cookbook.primitives_for(goal_idx))\n\n  actions = []\n  # Keep a mutable copy of the agent position.\n  pos = list(state.pos)                # [x, y]\n\n  # Helper to move the agent to a target (x, y) using Manhattan moves.\n  def move_to(target):\n      tx, ty = target\n      while pos[0] < tx:\n          actions.append(3)            # RIGHT\n          pos[0] += 1\n      while pos[0] > tx:\n          actions.append(2)            # LEFT\n          pos[0] -= 1\n      while pos[1] < ty:\n          actions.append(0)            # DOWN\n          pos[1] += 1\n      while pos[1] > ty:\n          actions.append(1)            # UP\n          pos[1] -= 1\n\n  # Helper to find an empty neighbour (including the cell itself) of a given location.\n  def find_adjacent_empty(grid, x, y):\n      h, w, _ = grid.shape\n      # Try the cell itself first (in case the item has been collected already).\n      if grid[x, y].sum() == 0:\n          return (x, y)\n      for dx in (0, 1, -1):\n          for dy in (0, 1, -1):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and grid[nx, ny].sum() == 0:\n                  return (nx, ny)\n      # Fallback: return the original location.\n      return (x, y)\n\n  grid = state.grid.copy()\n\n  # Collect each required primitive the necessary number of times.\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          # Locate the first occurrence of this primitive.\n          locations = np.argwhere(grid[:, :, prim_idx] > 0)\n          if len(locations) == 0:\n              # No more instances left; break out.\n              break\n          px, py = locations[0]\n\n          # Move to an empty cell adjacent to the primitive.\n          target = find_adjacent_empty(grid, px, py)\n          move_to(target)\n\n          # Use action to pick up the primitive.\n          actions.append(4)            # USE\n          # Simulate the pickup locally so we don't try to collect the same item again.\n          grid[px, py, prim_idx] = 0\n\n  # After gathering primitives, go to the appropriate workshop to craft the arrow.\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = recipe.get('_at')\n  if workshop_idx is not None:\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if len(workshop_cells) > 0:\n          wx, wy = workshop_cells[0]\n          target = find_adjacent_empty(state.grid, wx, wy)\n          move_to(target)\n          actions.append(4)            # USE to craft at the workshop\n\n  return actions", "env_interactions": 0, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T17:00:48.493232", "function_name": "make_arrow", "function_body": "  # Reset the environment and fetch the current state and world information\n  env.reset()\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  # ------------------------------------------------------------\n  # Identify the goal (arrow) and its requirements\n  # ------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = idx[goal_name]\n\n  # Primitive resources required for a single arrow\n  primitive_counts = world.cookbook.primitives_for(goal_idx)\n\n  # Determine if a specific workshop is required for crafting\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else idx[wk]\n\n  # ------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------\n  def find_locations(kind):\n      \"\"\"Return a list of (x, y) positions where `kind` is present on the grid.\"\"\"\n      occ = np.where(state.grid[:, :, kind] > 0)\n      return list(zip(occ[0].tolist(), occ[1].tolist()))\n\n  # Pre\u2011compute blocked cells (non\u2011grabbable entities)\n  _blocked_cells = set()\n  for ng in world.non_grabbable_indices:\n      occ = np.where(state.grid[:, :, ng] > 0)\n      _blocked_cells.update(zip(occ[0].tolist(), occ[1].tolist()))\n\n  def bfs_path(start, goal):\n      \"\"\"Return the shortest path (list of positions) from start to goal avoiding blocked cells.\"\"\"\n      if start == goal:\n          return [start]\n      W, H = state.grid.shape[:2]\n      q = collections.deque([start])\n      prev = {start: None}\n      while q:\n          cur = q.popleft()\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in _blocked_cells:\n                  nxt = (nx, ny)\n                  if nxt not in prev:\n                      prev[nxt] = cur\n                      if nxt == goal:\n                          # Reconstruct path\n                          path = [goal]\n                          while path[-1] != start:\n                              path.append(prev[path[-1]])\n                          path.reverse()\n                          return path\n                      q.append(nxt)\n      # No path found \u2013 stay in place\n      return [start]\n\n  def move_action(cur, nxt):\n      \"\"\"Translate a step between adjacent cells into the corresponding action index.\"\"\"\n      dx = nxt[0] - cur[0]\n      dy = nxt[1] - cur[1]\n      if dx == 1:\n          return 3   # RIGHT\n      if dx == -1:\n          return 2   # LEFT\n      if dy == 1:\n          return 0   # DOWN\n      if dy == -1:\n          return 1   # UP\n      raise AssertionError(\"Requested move is not between adjacent cells\")\n\n  # ------------------------------------------------------------\n  # Build the action sequence\n  # ------------------------------------------------------------\n  actions = []\n  cur_pos = state.pos\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitives (respecting current inventory)\n  # ------------------------------------------------------------------\n  inventory = state.inventory.copy()\n  for prim_idx, needed_total in primitive_counts.items():\n      needed = needed_total - int(inventory[prim_idx])\n      for _ in range(max(0, needed)):\n          locations = find_locations(prim_idx)\n          if not locations:\n              # Primitive not present on the map \u2013 assume already held\n              break\n\n          # Choose the reachable location with the shortest BFS distance\n          best_path = None\n          for loc in locations:\n              path = bfs_path(cur_pos, loc)\n              if len(path) == 1:   # unreachable\n                  continue\n              if best_path is None or len(path) < len(best_path):\n                  best_path = path\n                  if len(best_path) == 2:   # cannot be shorter than 1 step\n                      break\n\n          if best_path is None:\n              # No reachable instance; abort further collection of this primitive\n              break\n\n          # Follow the path to the primitive\n          for step in best_path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n\n          # Pick up the primitive\n          actions.append(4)   # USE\n          # Update simulated inventory for subsequent planning\n          inventory[prim_idx] += 1\n\n  # ------------------------------------------------------------------\n  # 2) Move to the required workshop (if any) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      wk_locations = find_locations(workshop_kind)\n      if wk_locations:\n          best_path = None\n          for loc in wk_locations:\n              path = bfs_path(cur_pos, loc)\n              if len(path) == 1:\n                  continue\n              if best_path is None or len(path) < len(best_path):\n                  best_path = path\n                  if len(best_path) == 2:\n                      break\n          if best_path is not None:\n              for step in best_path[1:]:\n                  actions.append(move_action(cur_pos, step))\n                  cur_pos = step\n      # Craft at the workshop\n      actions.append(4)   # USE\n  else:\n      # No specific workshop \u2013 craft where we are\n      actions.append(4)   # USE\n\n  return actions", "env_interactions": 19, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T17:00:49.644607", "function_name": "make_arrow", "function_body": "  # reset environment and fetch current state/world information\n  env.reset()\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  # target item\n  goal_name = \"arrow\"\n  goal_idx = idx[goal_name]\n\n  # primitives required for one arrow\n  primitive_counts = world.cookbook.primitives_for(goal_idx)\n\n  # workshop required for crafting (if any)\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else idx[wk]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def find_locations(kind, grid):\n      \"\"\"Return list of (x, y) where `kind` is present in `grid`.\"\"\"\n      occ = np.where(grid[:, :, kind] > 0)\n      return list(zip(occ[0].tolist(), occ[1].tolist()))\n\n  def move_action(cur, nxt):\n      \"\"\"Translate a step from cur \u2192 nxt into the corresponding action index.\"\"\"\n      dx = nxt[0] - cur[0]\n      dy = nxt[1] - cur[1]\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise AssertionError(\"non\u2011adjacent move requested\")\n\n  def bfs_path(start, goal, grid):\n      \"\"\"Shortest path from start to goal avoiding occupied cells (except goal).\"\"\"\n      if start == goal:\n          return [start]\n      W, H = grid.shape[:2]\n\n      # cells that cannot be traversed: any occupied cell that is not the goal\n      blocked = set()\n      occ = np.argwhere(grid.sum(axis=2) > 0)\n      for x, y in occ:\n          if (x, y) != goal:\n              blocked.add((x, y))\n\n      q = collections.deque([start])\n      prev = {start: None}\n      while q:\n          cur = q.popleft()\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:\n                  nxt = (nx, ny)\n                  if nxt not in prev:\n                      prev[nxt] = cur\n                      if nxt == goal:\n                          # reconstruct path\n                          path = [goal]\n                          while path[-1] != start:\n                              path.append(prev[path[-1]])\n                          path.reverse()\n                          return path\n                      q.append(nxt)\n      # no path found \u2013 stay where we are\n      return [start]\n\n  # ------------------------------------------------------------------\n  # Build the action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = state.pos\n  cur_grid = state.grid.copy()   # mutable copy that we update after pickups\n\n  # 1) Collect required primitives (nearest first)\n  for prim_idx, needed in primitive_counts.items():\n      for _ in range(needed):\n          locations = find_locations(prim_idx, cur_grid)\n          if not locations:\n              # Primitive not present \u2013 assume already in inventory\n              continue\n\n          # choose the nearest occurrence (Manhattan distance)\n          target = min(\n              locations,\n              key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1])\n          )\n          path = bfs_path(cur_pos, target, cur_grid)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n          actions.append(4)                     # USE to pick up\n          # remove the primitive from the mutable grid representation\n          cur_grid[target[0], target[1], prim_idx] = 0\n\n  # 2) Move to workshop (if required) and craft the arrow\n  if workshop_kind is not None:\n      wk_locations = find_locations(workshop_kind, cur_grid)\n      if wk_locations:\n          target = min(\n              wk_locations,\n              key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1])\n          )\n          path = bfs_path(cur_pos, target, cur_grid)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n      actions.append(4)                         # USE to craft at workshop\n  else:\n      # No specific workshop \u2013 craft at current location\n      actions.append(4)                         # USE to craft\n\n  return actions", "env_interactions": 24, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T17:01:06.937163", "function_name": "make_arrow", "function_body": "  # Reset environment and obtain references to the current state and world data.\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.scenario.world          # CraftWorld\n  cookbook = world.cookbook           # Cookbook\n  index = cookbook.index               # name \u2194 id mapping\n\n  # Resolve action indices (robust to possible changes in ordering).\n  action_map = env.action_specs()\n  DOWN = action_map[\"DOWN\"]\n  UP = action_map[\"UP\"]\n  LEFT = action_map[\"LEFT\"]\n  RIGHT = action_map[\"RIGHT\"]\n  USE = action_map[\"USE\"]\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow) and its primitive requirements.\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  if goal_name not in index.contents:\n      return []                       # Arrow not defined in this world\n  goal_idx = index[goal_name]\n\n  # primitives_for returns a dict {primitive_idx: count} needed for one goal.\n  primitive_needs = cookbook.primitives_for(goal_idx)\n\n  actions = []                         # Accumulate the final action list.\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of move actions from start to target.\n  # The target cell may be occupied (contains the needed primitive or a\n  # workshop); all other cells must be free (no entity present).\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  def _bfs_path(start, target):\n      \"\"\"Return a list of move actions (DOWN/UP/LEFT/RIGHT) to reach target.\"\"\"\n      if start == target:\n          return []\n      h, w = state.grid.shape[:2]\n      moves = [(DOWN, (1, 0)),\n               (UP, (-1, 0)),\n               (LEFT, (0, -1)),\n               (RIGHT, (0, 1))]\n      queue = deque([start])\n      visited = {start}\n      parent = {}\n\n      while queue:\n          cur = queue.popleft()\n          if cur == target:\n              break\n          for act, (dr, dc) in moves:\n              nr, nc = cur[0] + dr, cur[1] + dc\n              if not (0 <= nr < h and 0 <= nc < w):\n                  continue\n              nxt = (nr, nc)\n              # Allow stepping onto the target even if occupied.\n              if nxt != target and state.grid[nr, nc, :].sum() != 0:\n                  continue\n              if nxt in visited:\n                  continue\n              visited.add(nxt)\n              parent[nxt] = (cur, act)\n              queue.append(nxt)\n\n      if target not in parent and start != target:\n          return []      # No path found.\n\n      # Reconstruct path.\n      path = []\n      cur = target\n      while cur != start:\n          prev, act = parent[cur]\n          path.append(act)\n          cur = prev\n      path.reverse()\n      return path\n\n  # ------------------------------------------------------------------\n  # 1. Collect each required primitive (respecting multiplicities).\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          # Find cells that currently hold this primitive.\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # Primitive unavailable \u2013 abort early.\n              return actions\n\n          # Choose the nearest primitive (Manhattan distance).\n          dists = np.abs(prim_cells - np.array(state.pos)).sum(axis=1)\n          nearest = prim_cells[dists.argmin()]\n          tr, tc = nearest.tolist()\n\n          # Move to the primitive cell.\n          move_seq = _bfs_path(state.pos, (tr, tc))\n          actions.extend(move_seq)\n          state.pos = (tr, tc)\n\n          # Pick it up.\n          actions.append(USE)\n\n          # Update our internal copy of the state.\n          state.inventory[prim_idx] += 1\n          state.grid[tr, tc, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 2. Go to the workshop for the arrow and craft it.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      return actions                     # No workshop info.\n\n  workshop_idx = index[workshop_name]\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      return actions                     # No workshop on the map.\n\n  # Choose the nearest workshop cell.\n  dists = np.abs(workshop_cells - np.array(state.pos)).sum(axis=1)\n  nearest_ws = workshop_cells[dists.argmin()]\n  wr, wc = nearest_ws.tolist()\n\n  # Move to the workshop.\n  move_seq = _bfs_path(state.pos, (wr, wc))\n  actions.extend(move_seq)\n  state.pos = (wr, wc)\n\n  # Craft the arrow.\n  actions.append(USE)\n\n  return actions", "env_interactions": 24, "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T17:01:08.077231", "function_name": "make_arrow", "function_body": "  # Reset environment and grab useful references\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.scenario.world          # CraftWorld\n  cookbook = world.cookbook           # Cookbook\n  index = cookbook.index               # name \u2194 id mapping\n\n  # Resolve action indices from the env (robust to possible reordering)\n  action_map = env.action_specs()\n  DOWN = action_map[\"DOWN\"]\n  UP = action_map[\"UP\"]\n  LEFT = action_map[\"LEFT\"]\n  RIGHT = action_map[\"RIGHT\"]\n  USE = action_map[\"USE\"]\n\n  # ------------------------------------------------------------------\n  # Identify goal (arrow) and its primitive requirements.\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  if goal_name not in index.contents:\n      return []                       # arrow not defined in this world\n  goal_idx = index[goal_name]\n  primitive_needs = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n  actions = []                         # will accumulate the plan\n\n  # ------------------------------------------------------------------\n  # Helper: BFS returning a list of movement actions from start to target.\n  # All cells occupied by any entity are treated as obstacles, except the\n  # target cell itself (which may contain a primitive or a workshop).\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  def _bfs_path(start, target):\n      \"\"\"Return list of actions (DOWN/UP/LEFT/RIGHT) to reach target.\"\"\"\n      if start == target:\n          return []\n      h, w = state.grid.shape[:2]\n      moves = [(DOWN, (1, 0)),\n               (UP, (-1, 0)),\n               (LEFT, (0, -1)),\n               (RIGHT, (0, 1))]\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          for act, (dr, dc) in moves:\n              nr, nc = cur[0] + dr, cur[1] + dc\n              if not (0 <= nr < h and 0 <= nc < w):\n                  continue\n              nxt = (nr, nc)\n              # Disallow stepping on occupied cells except the target.\n              if nxt != target and state.grid[nr, nc, :].sum() != 0:\n                  continue\n              if nxt in visited:\n                  continue\n              visited.add(nxt)\n              parent[nxt] = (cur, act)\n              q.append(nxt)\n      if target not in parent and start != target:\n          return []          # no path found\n      # Reconstruct path\n      path = []\n      cur = target\n      while cur != start:\n          prev, act = parent[cur]\n          path.append(act)\n          cur = prev\n      path.reverse()\n      return path\n\n  # ------------------------------------------------------------------\n  # 1. Collect each required primitive (respecting multiplicities).\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          # Find any cell currently holding this primitive.\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # Primitive not present \u2013 abort early.\n              return actions\n          # Choose the nearest cell (Manhattan distance).\n          dists = np.abs(prim_cells - np.array(state.pos)).sum(axis=1)\n          tr, tc = prim_cells[dists.argmin()]\n\n          # Move to the primitive.\n          move_seq = _bfs_path(state.pos, (tr, tc))\n          actions.extend(move_seq)\n          state.pos = (tr, tc)\n\n          # Pick it up.\n          actions.append(USE)\n\n          # Update our internal copy of the state.\n          state.inventory[prim_idx] += 1\n          state.grid[tr, tc, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 2. Go to the workshop for the arrow and craft it.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      return actions                     # no workshop info\n\n  workshop_idx = index[workshop_name]\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      return actions                     # workshop not on map\n\n  # Choose nearest workshop cell.\n  dists = np.abs(workshop_cells - np.array(state.pos)).sum(axis=1)\n  wr, wc = workshop_cells[dists.argmin()]\n\n  # Move to workshop.\n  move_seq = _bfs_path(state.pos, (wr, wc))\n  actions.extend(move_seq)\n  state.pos = (wr, wc)\n\n  # Craft the arrow.\n  actions.append(USE)\n\n  return actions", "env_interactions": 24, "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T17:01:26.447490", "function_name": "make_arrow", "function_body": "  # Reset environment to a clean start if possible.\n  try:\n      env.reset()\n  except Exception:\n      pass\n\n  actions = []\n\n  # Identify the goal item index from the environment/task.\n  goal_idx = None\n  if hasattr(env, \"task\"):\n      task = getattr(env, \"task\")\n      if hasattr(task, \"goal\"):\n          goal_idx = task.goal\n      elif isinstance(task, (list, tuple)):\n          goal_idx = task[0]\n\n  if goal_idx is None:\n      return actions\n\n  # Primitive requirements for the target item.\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)\n\n  # Current simulated position and a mutable copy of the grid.\n  cur_pos = list(env._current_state.pos)\n  grid = env._current_state.grid.copy()\n\n  # Helper to generate movement actions (Manhattan) and update cur_pos.\n  def move_to(target):\n      nonlocal cur_pos\n      act = []\n      tx, ty = target\n      # x corresponds to first dimension (horizontal), y to second (vertical)\n      while cur_pos[0] < tx:\n          act.append(3)          # RIGHT\n          cur_pos[0] += 1\n      while cur_pos[0] > tx:\n          act.append(2)          # LEFT\n          cur_pos[0] -= 1\n      while cur_pos[1] < ty:\n          act.append(0)          # DOWN\n          cur_pos[1] += 1\n      while cur_pos[1] > ty:\n          act.append(1)          # UP\n          cur_pos[1] -= 1\n      return act\n\n  # Collect each primitive the required number of times.\n  for kind_idx, count in primitives_needed.items():\n      needed = count\n      while needed > 0:\n          # Locate all cells that currently contain this primitive.\n          positions = np.argwhere(grid[:, :, kind_idx] > 0)\n          if positions.size == 0:\n              # No more of this primitive on the map; abort collection.\n              break\n          # Choose the first available position (could be improved with nearest).\n          target = tuple(positions[0])\n          actions.extend(move_to(target))\n          actions.append(4)          # USE to pick up\n          # Simulate removal of the primitive from the grid.\n          grid[target[0], target[1], kind_idx] = 0\n          needed -= 1\n\n  # After gathering primitives, move to the appropriate workshop (if any) and craft.\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      ws_positions = np.argwhere(grid[:, :, workshop_kind] > 0)\n      if ws_positions.shape[0] > 0:\n          ws_target = tuple(ws_positions[0])\n          actions.extend(move_to(ws_target))\n          actions.append(4)          # USE to craft at workshop\n\n  return actions", "env_interactions": 0, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T17:01:27.586677", "function_name": "make_arrow", "function_body": "  # Reset environment to a known state and obtain the initial state.\n  try:\n      env.reset()\n  except Exception:\n      pass\n\n  actions = []\n\n  # Identify the goal index from the environment's task.\n  goal_idx = None\n  if hasattr(env, \"task\"):\n      task = getattr(env, \"task\")\n      if hasattr(task, \"goal\"):\n          goal_idx = task.goal\n      elif isinstance(task, (list, tuple)):\n          goal_idx = task[0]\n\n  if goal_idx is None:\n      return actions\n\n  # Determine primitive requirements for the goal.\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)\n\n  # Current agent position (mutable copy).\n  cur_pos = list(env._current_state.pos)\n\n  def move_to(target):\n      \"\"\"Generate actions to move from cur_pos to target (x, y).\"\"\"\n      nonlocal cur_pos\n      act_seq = []\n      tx, ty = target\n      # Move in x direction.\n      while cur_pos[0] < tx:\n          act_seq.append(3)          # RIGHT\n          cur_pos[0] += 1\n      while cur_pos[0] > tx:\n          act_seq.append(2)          # LEFT\n          cur_pos[0] -= 1\n      # Move in y direction.\n      while cur_pos[1] < ty:\n          act_seq.append(0)          # DOWN\n          cur_pos[1] += 1\n      while cur_pos[1] > ty:\n          act_seq.append(1)          # UP\n          cur_pos[1] -= 1\n      return act_seq\n\n  # Helper to track which primitive cells have already been used.\n  used_cells = set()\n\n  # Collect each required primitive.\n  grid = env._current_state.grid\n  for kind_idx, count in primitives_needed.items():\n      # Find all locations of this primitive kind.\n      positions = [tuple(pos) for pos in np.argwhere(grid[:, :, kind_idx] > 0)]\n      pos_idx = 0\n      while count > 0 and pos_idx < len(positions):\n          cell = positions[pos_idx]\n          if cell in used_cells:\n              pos_idx += 1\n              continue\n          # Move to the primitive and pick it up.\n          actions.extend(move_to(cell))\n          actions.append(4)          # USE to collect\n          used_cells.add(cell)\n          count -= 1\n          pos_idx += 1\n\n  # After gathering primitives, move to the workshop (if any) and craft.\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      # Locate a workshop cell of the required type.\n      ws_positions = [tuple(p) for p in np.argwhere(grid[:, :, workshop_kind] > 0)]\n      if ws_positions:\n          target_ws = ws_positions[0]\n          actions.extend(move_to(target_ws))\n          actions.append(4)          # USE to craft\n\n  return actions", "env_interactions": 0, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T17:01:51.919788", "function_name": "make_arrow", "function_body": "  # Reset environment and get references to the current state and world data.\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.scenario.world          # CraftWorld\n  cookbook = world.cookbook           # Cookbook\n  index = cookbook.index               # Name \u2194 integer ID mapping\n\n  # Action identifiers (must match CraftLab.action_specs)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow) and its primitive requirements.\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  if goal_name not in index.contents:\n      return []                     # Arrow not defined in this world\n\n  goal_idx = index[goal_name]      # Integer id of the arrow item\n  primitive_needs = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n  actions = []                     # List of actions to be returned\n\n  # ------------------------------------------------------------------\n  # Helper: BFS to find a path avoiding occupied cells (except the target).\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  h, w = state.grid.shape[:2]\n  moves = [(DOWN, (1, 0)),\n           (UP, (-1, 0)),\n           (LEFT, (0, -1)),\n           (RIGHT, (0, 1))]\n\n  def bfs_path(start, target):\n      \"\"\"Return a list of move actions to go from start to target.\"\"\"\n      if start == target:\n          return []\n\n      queue = deque([start])\n      visited = {start}\n      parent = {}\n\n      while queue:\n          cur = queue.popleft()\n          if cur == target:\n              break\n          for act, (dr, dc) in moves:\n              nr, nc = cur[0] + dr, cur[1] + dc\n              if not (0 <= nr < h and 0 <= nc < w):\n                  continue\n              nxt = (nr, nc)\n\n              # Allow stepping onto the target even if it is occupied.\n              if nxt != target and state.grid[nr, nc, :].sum() != 0:\n                  continue\n              if nxt in visited:\n                  continue\n              visited.add(nxt)\n              parent[nxt] = (cur, act)\n              queue.append(nxt)\n\n      if target not in parent and start != target:\n          return []      # No path found.\n\n      # Reconstruct path.\n      path = []\n      cur = target\n      while cur != start:\n          prev, act = parent[cur]\n          path.append(act)\n          cur = prev\n      path.reverse()\n      return path\n\n  # ------------------------------------------------------------------\n  # 1. Collect each required primitive (handling multiplicities).\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          # Find any cell currently holding this primitive.\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # Primitive unavailable \u2013 abort early.\n              return actions\n          tr, tc = prim_cells[0]\n\n          # Move to the primitive's cell.\n          move_seq = bfs_path(state.pos, (tr, tc))\n          actions.extend(move_seq)\n          state.pos = (tr, tc)\n\n          # Pick it up.\n          actions.append(USE)\n\n          # Update our internal copy of the state.\n          state.inventory[prim_idx] += 1\n          state.grid[tr, tc, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 2. Go to the workshop for the arrow and craft it.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      return actions                     # No workshop info.\n\n  workshop_idx = index[workshop_name]\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      return actions                     # No workshop found.\n\n  wr, wc = workshop_cells[0]\n\n  # Move to the workshop cell.\n  move_seq = bfs_path(state.pos, (wr, wc))\n  actions.extend(move_seq)\n  state.pos = (wr, wc)\n\n  # Craft the arrow.\n  actions.append(USE)\n\n  return actions", "env_interactions": 28, "island_id": 1, "scores": {"3": 1.5}}
