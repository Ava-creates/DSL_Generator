{"timestamp": "2025-10-27T17:41:16.494151", "function_name": "make_arrow", "function_body": "  # Reset environment and fetch relevant objects.\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.scenario.world          # CraftWorld\n  cookbook = world.cookbook           # Cookbook\n  index = cookbook.index               # name \u2194 integer id mapping\n\n  # Resolve action indices from the environment spec.\n  action_map = env.action_specs()\n  DOWN = action_map[\"DOWN\"]\n  UP = action_map[\"UP\"]\n  LEFT = action_map[\"LEFT\"]\n  RIGHT = action_map[\"RIGHT\"]\n  USE = action_map[\"USE\"]\n\n  # Identify the goal item (arrow) and its primitive requirements.\n  goal_name = \"arrow\"\n  if goal_name not in index.contents:\n      return []                       # Arrow not defined in this world.\n  goal_idx = index[goal_name]\n  primitive_needs = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n\n  actions = []                         # Accumulated action sequence.\n\n  import numpy as np\n  from collections import deque\n\n  def _bfs_path(start, target):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) from start to target.\n      Cells occupied by any entity are treated as obstacles, except the target cell.\n      \"\"\"\n      if start == target:\n          return []\n\n      h, w = state.grid.shape[:2]\n      moves = [(DOWN, (1, 0)),\n               (UP, (-1, 0)),\n               (LEFT, (0, -1)),\n               (RIGHT, (0, 1))]\n\n      q = deque([start])\n      visited = {start}\n      parent = {}\n\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          for act, (dr, dc) in moves:\n              nr, nc = cur[0] + dr, cur[1] + dc\n              if not (0 <= nr < h and 0 <= nc < w):\n                  continue\n              nxt = (nr, nc)\n              # Disallow stepping on occupied cells unless it's the target.\n              if nxt != target and state.grid[nr, nc, :].sum() != 0:\n                  continue\n              if nxt in visited:\n                  continue\n              visited.add(nxt)\n              parent[nxt] = (cur, act)\n              q.append(nxt)\n\n      # Reconstruct path.\n      if target not in parent and start != target:\n          return []  # No path found.\n      path = []\n      cur = target\n      while cur != start:\n          prev, act = parent[cur]\n          path.append(act)\n          cur = prev\n      path.reverse()\n      return path\n\n  # ------------------------------------------------------------------\n  # Phase 1: Collect each required primitive the needed number of times.\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          # Locate cells that currently hold this primitive.\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # Primitive missing; abort early.\n              return actions\n\n          # Choose the nearest primitive cell (Manhattan distance).\n          dists = np.abs(prim_cells - np.array(state.pos)).sum(axis=1)\n          tr, tc = prim_cells[dists.argmin()]\n\n          # Move to the primitive cell.\n          move_seq = _bfs_path(state.pos, (tr, tc))\n          actions.extend(move_seq)\n          state.pos = (tr, tc)\n\n          # Pick it up.\n          actions.append(USE)\n\n          # Update internal copy of the state (grid becomes empty, inventory increments).\n          state.inventory[prim_idx] += 1\n          state.grid[tr, tc, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Phase 2: Go to the appropriate workshop and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      return actions                     # No workshop info; cannot craft.\n\n  workshop_idx = index[workshop_name]\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      return actions                     # Workshop not present.\n\n  # Choose the nearest workshop cell.\n  dists = np.abs(workshop_cells - np.array(state.pos)).sum(axis=1)\n  wr, wc = workshop_cells[dists.argmin()]\n\n  # Move to the workshop.\n  move_seq = _bfs_path(state.pos, (wr, wc))\n  actions.extend(move_seq)\n  state.pos = (wr, wc)\n\n  # Craft the arrow.\n  actions.append(USE)\n\n  return actions", "env_interactions": 24, "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T17:41:17.619405", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.scenario.world\n  cookbook = world.cookbook\n  index = cookbook.index\n\n  # Resolve action indices from the environment (fallback to defaults)\n  action_map = env.action_specs()\n  DOWN = action_map.get(\"DOWN\", 0)\n  UP = action_map.get(\"UP\", 1)\n  LEFT = action_map.get(\"LEFT\", 2)\n  RIGHT = action_map.get(\"RIGHT\", 3)\n  USE = action_map.get(\"USE\", 4)\n\n  # ------------------------------------------------------------------\n  # Identify the goal item (arrow) and its primitive requirements.\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  if goal_name not in index.contents:\n      return []                     # Arrow not defined in this world.\n  goal_idx = index[goal_name]\n  primitive_needs = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  actions = []  # accumulated action sequence\n\n  from collections import deque\n\n  def _bfs_path(start, target):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) from start to target.\n      Cells occupied by any entity are considered obstacles, except the target cell.\n      \"\"\"\n      if start == target:\n          return []\n      h, w = state.grid.shape[:2]\n      moves = [(DOWN, (1, 0)),\n               (UP, (-1, 0)),\n               (LEFT, (0, -1)),\n               (RIGHT, (0, 1))]\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          for act, (dr, dc) in moves:\n              nr, nc = cur[0] + dr, cur[1] + dc\n              if not (0 <= nr < h and 0 <= nc < w):\n                  continue\n              nxt = (nr, nc)\n              # Allow stepping onto the target even if occupied.\n              if nxt != target and state.grid[nr, nc, :].sum() != 0:\n                  continue\n              if nxt in visited:\n                  continue\n              visited.add(nxt)\n              parent[nxt] = (cur, act)\n              q.append(nxt)\n\n      if target not in parent and start != target:\n          return []  # No path found.\n\n      # Reconstruct path.\n      path = []\n      cur = target\n      while cur != start:\n          prev, act = parent[cur]\n          path.append(act)\n          cur = prev\n      path.reverse()\n      return path\n\n  # ------------------------------------------------------------------\n  # Phase 1: Collect each required primitive the needed number of times.\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          # Locate all cells currently holding this primitive.\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # Primitive missing; abort early.\n              return actions\n\n          # Choose the nearest primitive cell (Manhattan distance).\n          dists = np.abs(prim_cells - np.array(state.pos)).sum(axis=1)\n          tr, tc = prim_cells[dists.argmin()]\n\n          # Move to the primitive cell.\n          move_seq = _bfs_path(state.pos, (tr, tc))\n          actions.extend(move_seq)\n          state.pos = (tr, tc)\n\n          # Pick it up.\n          actions.append(USE)\n\n          # Update our internal copy of the state.\n          state.inventory[prim_idx] += 1\n          state.grid[tr, tc, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Phase 2: Go to the appropriate workshop and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      return actions                     # No workshop info; cannot craft.\n\n  workshop_idx = index[workshop_name]\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      return actions                     # Workshop not present.\n\n  # Choose the nearest workshop cell.\n  dists = np.abs(workshop_cells - np.array(state.pos)).sum(axis=1)\n  wr, wc = workshop_cells[dists.argmin()]\n\n  # Move to the workshop.\n  move_seq = _bfs_path(state.pos, (wr, wc))\n  actions.extend(move_seq)\n  state.pos = (wr, wc)\n\n  # Craft the arrow.\n  actions.append(USE)\n\n  return actions", "env_interactions": 24, "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T17:41:39.404912", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ------------------------------------------------------------------\n  # Constants and utility functions\n  # ------------------------------------------------------------------\n  # Action mapping: 0=DOWN, 1=UP, 2=LEFT, 3=RIGHT, 4=USE\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n  USE = 4\n\n  def _bfs_adjacent(start, target, blocked):\n      \"\"\"Return a list of actions that moves the agent from *start* to any\n      free 4\u2011adjacent cell of *target*. If unreachable, returns an empty list.\"\"\"\n      h, w = blocked.shape\n      tx, ty = target\n      # admissible goal cells around the target\n      goal_cells = []\n      for a, (dx, dy) in enumerate(DIRS):\n          gx, gy = tx + dx, ty + dy\n          if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:\n              goal_cells.append((gx, gy))\n      if not goal_cells:\n          return []\n\n      q = deque([(start, [])])\n      visited = {start}\n      while q:\n          (cx, cy), path = q.popleft()\n          if (cx, cy) in goal_cells:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []\n\n  # ------------------------------------------------------------------\n  # Reset / obtain current state from the environment\n  # ------------------------------------------------------------------\n  try:\n      env.reset()\n  except Exception:\n      pass\n\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []  # cannot retrieve state; give up\n\n  world = env.world\n  idx = world.cookbook.index\n\n  # ------------------------------------------------------------------\n  # Identify goal (arrow) and its recipe\n  # ------------------------------------------------------------------\n  try:\n      goal_idx = idx[\"arrow\"]\n  except Exception:\n      return []  # arrow not defined in this world\n\n  primitives_needed = world.cookbook.primitives_for(goal_idx)\n\n  # locate workshop name in recipe (key \"_at\" or \"_key\")\n  workshop_name = None\n  for k, v in world.cookbook.recipes.get(goal_idx, {}).items():\n      if k in (\"_at\", \"_key\"):\n          workshop_name = v\n          break\n  if workshop_name is None:\n      return []  # no workshop specified\n\n  try:\n      workshop_idx = idx[workshop_name]\n  except Exception:\n      return []  # workshop not indexed\n\n  # ------------------------------------------------------------------\n  # Local mutable copies for planning simulation\n  # ------------------------------------------------------------------\n  pos = tuple(state.pos)                     # (x, y)\n  grid = state.grid.copy()                   # (W, H, n_kinds)\n  inventory = state.inventory.copy()\n  occupied = np.any(grid > 0, axis=2)        # bool matrix of blocked cells\n\n  plan = []\n\n  # ------------------------------------------------------------------\n  # Helper: navigate to a cell adjacent to *target* and USE it\n  # ------------------------------------------------------------------\n  def _move_and_use(target, kind_idx):\n      \"\"\"Navigate adjacent to *target*, issue USE, and update simulated state.\n      Returns False if movement is impossible.\"\"\"\n      nonlocal pos, plan, grid, occupied, inventory\n      path = _bfs_adjacent(pos, target, occupied)\n      if not path and pos != target:\n          return False\n\n      # simulate movement\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n      plan.extend(path)\n\n      # simulate USE action\n      plan.append(USE)\n      tx, ty = target\n      if grid[tx, ty, kind_idx] > 0:\n          grid[tx, ty, kind_idx] = 0\n          occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)\n          inventory[kind_idx] += 1\n      return True\n\n  # ------------------------------------------------------------------\n  # Collect required primitive resources\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in primitives_needed.items():\n      for _ in range(cnt):\n          locations = np.argwhere(grid[:, :, prim_idx] > 0)\n          if locations.shape[0] == 0:\n              # primitive not present; abort planning with whatever we have\n              return plan\n          # choose closest primitive (Manhattan distance)\n          dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n          target = tuple(locations[dists.argmin()])\n          if not _move_and_use(target, prim_idx):\n              return plan\n\n  # ------------------------------------------------------------------\n  # Move to the workshop and craft the arrow\n  # ------------------------------------------------------------------\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.shape[0] == 0:\n      # workshops are static; fall back to original scenario grid\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.shape[0] == 0:\n          return plan\n\n  dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])\n  workshop_target = tuple(workshop_cells[dists.argmin()])\n  _move_and_use(workshop_target, workshop_idx)\n\n  # ------------------------------------------------------------------\n  # Return the complete action sequence\n  # ------------------------------------------------------------------\n  return plan", "env_interactions": 23, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T17:41:40.530918", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Constants and helper functions\n  # ----------------------------------------------------------------------\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # 0:DOWN, 1:UP, 2:LEFT, 3:RIGHT\n  USE = 4\n\n  from collections import deque\n  import numpy as np\n\n  def bfs_adjacent(start, target, blocked):\n      \"\"\"Return a list of actions that moves the agent from *start* to any\n      free 4\u2011adjacent cell of *target*. If no such cell is reachable an empty\n      list is returned.\"\"\"\n      h, w = blocked.shape\n      tx, ty = target\n      # collect all free adjacent cells\n      goal_cells = []\n      for a, (dx, dy) in enumerate(DIRS):\n          gx, gy = tx + dx, ty + dy\n          if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:\n              goal_cells.append((gx, gy))\n      if not goal_cells:\n          return []\n\n      q = deque([(start, [])])\n      visited = {start}\n      while q:\n          (cx, cy), path = q.popleft()\n          if (cx, cy) in goal_cells:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []\n\n  # ----------------------------------------------------------------------\n  # Reset / obtain current state\n  # ----------------------------------------------------------------------\n  try:\n      env.reset()\n  except Exception:\n      pass\n\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []          # cannot retrieve state\n\n  world = env.world\n  idx = world.cookbook.index\n\n  # ----------------------------------------------------------------------\n  # Identify goal (arrow) and its recipe\n  # ----------------------------------------------------------------------\n  try:\n      goal_idx = idx[\"arrow\"]\n  except Exception:\n      return []          # arrow not defined\n\n  # Primitive requirements for a single arrow\n  primitives_needed = world.cookbook.primitives_for(goal_idx)\n\n  # Find workshop where arrow must be crafted (stored under \"_at\" or \"_key\")\n  workshop_name = None\n  for k, v in world.cookbook.recipes.get(goal_idx, {}).items():\n      if k in (\"_at\", \"_key\"):\n          workshop_name = v\n          break\n  if workshop_name is None:\n      return []          # no workshop info\n\n  try:\n      workshop_idx = idx[workshop_name]\n  except Exception:\n      return []          # workshop not indexed\n\n  # ----------------------------------------------------------------------\n  # Local mutable copies for planning simulation\n  # ----------------------------------------------------------------------\n  pos = tuple(state.pos)                     # (x, y)\n  grid = state.grid.copy()                   # (W, H, n_kinds)\n  inventory = state.inventory.copy()\n  occupied = np.any(grid > 0, axis=2)        # bool matrix: True = blocked\n\n  plan = []\n\n  # ----------------------------------------------------------------------\n  # Helper: move adjacent to a cell containing *kind_idx* and USE it\n  # ----------------------------------------------------------------------\n  def move_and_use(target, kind_idx):\n      \"\"\"Navigate to a free cell adjacent to *target*, issue USE,\n      and update the simulated world state. Returns False if movement\n      is impossible.\"\"\"\n      nonlocal pos, plan, grid, occupied, inventory\n      path = bfs_adjacent(pos, target, occupied)\n      if not path and pos != target:\n          return False\n\n      # simulate movement\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n      plan.extend(path)\n\n      # simulate USE\n      plan.append(USE)\n\n      tx, ty = target\n      if grid[tx, ty, kind_idx] > 0:\n          # pick up one unit\n          grid[tx, ty, kind_idx] = 0\n          occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)\n          inventory[kind_idx] += 1\n      return True\n\n  # ----------------------------------------------------------------------\n  # Collect all required primitive resources\n  # ----------------------------------------------------------------------\n  for prim_idx, count in primitives_needed.items():\n      for _ in range(count):\n          locations = np.argwhere(grid[:, :, prim_idx] > 0)\n          if locations.shape[0] == 0:\n              # primitive not present \u2013 abort planning\n              return plan\n          # choose closest occurrence (Manhattan distance)\n          dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n          target = tuple(locations[dists.argmin()])\n          if not move_and_use(target, prim_idx):\n              return plan\n\n  # ----------------------------------------------------------------------\n  # Move to the workshop and craft the arrow\n  # ----------------------------------------------------------------------\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.shape[0] == 0:\n      # workshops are static; fall back to original grid\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.shape[0] == 0:\n          return plan\n\n  dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])\n  workshop_target = tuple(workshop_cells[dists.argmin()])\n  move_and_use(workshop_target, workshop_idx)\n\n  # ----------------------------------------------------------------------\n  # Return the constructed action sequence\n  # ----------------------------------------------------------------------\n  return plan", "env_interactions": 23, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T17:42:11.331611", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n\n  # Identify the goal index for the arrow\n  if hasattr(env, \"task\") and hasattr(env.task, \"goal\"):\n      goal_idx = env.task.goal\n  else:\n      goal_idx = env.world.cookbook.index.get(\"arrow\")\n      if goal_idx is None:\n          raise ValueError(\"Arrow goal not found in cookbook\")\n\n  # Action constants\n  act_spec = env.action_specs()\n  ACT_DOWN = act_spec[\"DOWN\"]\n  ACT_UP = act_spec[\"UP\"]\n  ACT_LEFT = act_spec[\"LEFT\"]\n  ACT_RIGHT = act_spec[\"RIGHT\"]\n  ACT_USE = act_spec[\"USE\"]\n\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS to compute a list of actions from start to a target cell.\n  # Cells occupied in any channel are considered blocked, except the target\n  # cell itself (useful when moving onto a workshop).\n  # ----------------------------------------------------------------------\n  from collections import deque\n\n  def bfs_path(start, target):\n      grid = state.grid\n      h, w = grid.shape[:2]\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (y, x), path = q.popleft()\n          if (y, x) == target:\n              return path\n          for dy, dx, act in ((1, 0, ACT_DOWN),\n                              (-1, 0, ACT_UP),\n                              (0, 1, ACT_RIGHT),\n                              (0, -1, ACT_LEFT)):\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < h and 0 <= nx < w and (ny, nx) not in visited:\n                  # Allow stepping onto the target even if it is occupied\n                  if not grid[ny, nx, :].any() or (ny, nx) == target:\n                      visited.add((ny, nx))\n                      q.append(((ny, nx), path + [act]))\n      return []  # unreachable\n\n  # ----------------------------------------------------------------------\n  # Helper: move the agent to an absolute position using bfs_path.\n  # ----------------------------------------------------------------------\n  def move_to(target):\n      nonlocal state, actions\n      while state.pos != target:\n          path = bfs_path(state.pos, target)\n          if not path:\n              break  # cannot reach the target\n          for a in path:\n              actions.append(a)\n              env.step(a)\n              state = env._current_state\n              if state.pos == target:\n                  break\n\n  # ----------------------------------------------------------------------\n  # Helper: locate the nearest cell containing a given kind index.\n  # ----------------------------------------------------------------------\n  def find_nearest(kind_idx):\n      grid = state.grid\n      h, w = grid.shape[:2]\n      py, px = state.pos\n      best = None\n      best_dist = None\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  d = abs(i - py) + abs(j - px)\n                  if best_dist is None or d < best_dist:\n                      best_dist = d\n                      best = (i, j)\n      return best\n\n  # ----------------------------------------------------------------------\n  # Helper: find a free cell (including the cell itself) adjacent to a\n  # given location. Returns None if none found.\n  # ----------------------------------------------------------------------\n  def adjacent_free(cell):\n      y, x = cell\n      grid = state.grid\n      h, w = grid.shape[:2]\n      # Prefer the cell itself if it is free\n      if not grid[y, x, :].any():\n          return (y, x)\n      for dy in (-1, 0, 1):\n          for dx in (-1, 0, 1):\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < h and 0 <= nx < w and not grid[ny, nx, :].any():\n                  return (ny, nx)\n      return None\n\n  # ----------------------------------------------------------------------\n  # Collect all primitive resources needed for the arrow.\n  # ----------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  for kind_idx, count in primitives_needed.items():\n      for _ in range(count):\n          src = find_nearest(kind_idx)\n          if src is None:\n              continue  # resource not present\n          adj = adjacent_free(src)\n          if adj is None:\n              continue  # no free adjacent cell\n          move_to(adj)\n          actions.append(ACT_USE)\n          env.step(ACT_USE)\n          state = env._current_state\n\n  # ----------------------------------------------------------------------\n  # If the recipe requires a workshop, go there and craft the arrow.\n  # ----------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      ws_idx = env.world.cookbook.index[workshop_name]\n      ws_pos = find_nearest(ws_idx)\n      if ws_pos:\n          adj = adjacent_free(ws_pos)\n          if adj:\n              move_to(adj)\n              actions.append(ACT_USE)\n              env.step(ACT_USE)\n              state = env._current_state\n\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T17:42:12.458778", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n\n  # Determine the goal index for the arrow\n  if hasattr(env, \"task\") and hasattr(env.task, \"goal\"):\n      goal_idx = env.task.goal\n  else:\n      goal_idx = env.world.cookbook.index.get(\"arrow\")\n      if goal_idx is None:\n          raise ValueError(\"Arrow not found in cookbook\")\n\n  # Action constants\n  act_spec = env.action_specs()\n  ACT_DOWN = act_spec[\"DOWN\"]\n  ACT_UP = act_spec[\"UP\"]\n  ACT_LEFT = act_spec[\"LEFT\"]\n  ACT_RIGHT = act_spec[\"RIGHT\"]\n  ACT_USE = act_spec[\"USE\"]\n\n  from collections import deque\n\n  actions = []\n\n  def bfs_path(start, target):\n      \"\"\"Return a list of actions to move from start to target.\"\"\"\n      grid = state.grid\n      h, w, _ = grid.shape\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (y, x), path = q.popleft()\n          if (y, x) == target:\n              return path\n          for dy, dx, act in ((1, 0, ACT_DOWN),\n                              (-1, 0, ACT_UP),\n                              (0, 1, ACT_RIGHT),\n                              (0, -1, ACT_LEFT)):\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < h and 0 <= nx < w and (ny, nx) not in visited:\n                  # Allow stepping onto the target even if occupied\n                  if not grid[ny, nx, :].any() or (ny, nx) == target:\n                      visited.add((ny, nx))\n                      q.append(((ny, nx), path + [act]))\n      return []  # unreachable\n\n  def move_to(target):\n      \"\"\"Move the agent to an absolute position using bfs_path.\"\"\"\n      nonlocal state, actions\n      while state.pos != target:\n          path = bfs_path(state.pos, target)\n          if not path:\n              break  # cannot reach the target\n          for a in path:\n              actions.append(a)\n              _, _, _ = env.step(a)\n              state = env._current_state\n              if state.pos == target:\n                  break\n\n  def find_nearest(kind_idx):\n      \"\"\"Find the nearest cell containing the given kind index.\"\"\"\n      grid = state.grid\n      h, w, _ = grid.shape\n      py, px = state.pos\n      best = None\n      best_dist = None\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  d = abs(i - py) + abs(j - px)\n                  if best_dist is None or d < best_dist:\n                      best_dist = d\n                      best = (i, j)\n      return best\n\n  def adjacent_free(cell):\n      \"\"\"Return a free cell (including diagonals) adjacent to `cell`.\"\"\"\n      y, x = cell\n      grid = state.grid\n      h, w, _ = grid.shape\n      if not grid[y, x, :].any():\n          return (y, x)\n      for dy in (-1, 0, 1):\n          for dx in (-1, 0, 1):\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < h and 0 <= nx < w and not grid[ny, nx, :].any():\n                  return (ny, nx)\n      # Fallback: stay where we are (should rarely happen)\n      return state.pos\n\n  # ----------------------------------------------------------------------\n  # Collect all primitive resources required for the arrow.\n  # ----------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  for kind_idx, count in primitives_needed.items():\n      for _ in range(count):\n          src = find_nearest(kind_idx)\n          if src is None:\n              raise RuntimeError(f\"Required primitive {kind_idx} not found\")\n          adj = adjacent_free(src)\n          move_to(adj)\n          actions.append(ACT_USE)\n          _, _, _ = env.step(ACT_USE)\n          state = env._current_state\n\n  # ----------------------------------------------------------------------\n  # Go to the appropriate workshop (if any) and craft the arrow.\n  # ----------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      ws_idx = env.world.cookbook.index[workshop_name]\n      ws_pos = find_nearest(ws_idx)\n      if ws_pos is None:\n          raise RuntimeError(f\"Workshop {workshop_name} not found\")\n      adj = adjacent_free(ws_pos)\n      move_to(adj)\n      actions.append(ACT_USE)\n      _, _, _ = env.step(ACT_USE)\n      state = env._current_state\n\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T17:42:37.966679", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ------------------------------------------------------------------\n  # Reset the environment (ignore any return value)\n  try:\n      env.reset()\n  except Exception:\n      pass\n\n  # Mapping from action name (e.g. \"UP\") to integer code used by the env\n  act_map = env.action_specs()\n\n  # Directions used for movement \u2013 order does not matter as long as it\n  # matches the keys in `act_map`.\n  moves = [\n      (-1, 0, \"UP\"),\n      (1, 0, \"DOWN\"),\n      (0, -1, \"LEFT\"),\n      (0, 1, \"RIGHT\"),\n  ]\n  name_to_delta = {name: (dr, dc) for dr, dc, name in moves}\n\n  # ------------------------------------------------------------------\n  # Helper: breadth\u2011first search for a path from `start` to any empty\n  # neighbour of `target`.  Returns a list of direction names.\n  def bfs_to_adjacent(start, target, occ):\n      tr, tc = target\n      # All empty cells that are orthogonally adjacent to the target.\n      goal_cells = [\n          (tr + dr, tc + dc)\n          for dr, dc, _ in moves\n          if 0 <= tr + dr < occ.shape[0]\n          and 0 <= tc + dc < occ.shape[1]\n          and not occ[tr + dr, tc + dc]\n      ]\n      if not goal_cells:\n          return []  # No reachable adjacent cell.\n\n      # If we are already on a goal cell, no movement is needed.\n      if start in goal_cells:\n          return []\n\n      q = deque([start])\n      parent = {start: None}\n      parent_move = {}\n      while q:\n          cur = q.popleft()\n          if cur in goal_cells:\n              # Reconstruct path of direction names.\n              path = []\n              while parent[cur] is not None:\n                  path.append(parent_move[cur])\n                  cur = parent[cur]\n              path.reverse()\n              return path\n          r, c = cur\n          for dr, dc, name in moves:\n              nr, nc = r + dr, c + dc\n              if (\n                  0 <= nr < occ.shape[0]\n                  and 0 <= nc < occ.shape[1]\n                  and not occ[nr, nc]\n                  and (nr, nc) not in parent\n              ):\n                  parent[(nr, nc)] = cur\n                  parent_move[(nr, nc)] = name\n                  q.append((nr, nc))\n      return []  # No path found.\n\n  # ------------------------------------------------------------------\n  # Helper: execute a list of direction names, updating `cur_pos` and\n  # appending the corresponding integer actions.\n  def execute_path(path_dirs):\n      nonlocal cur_pos\n      for dname in path_dirs:\n          actions.append(act_map[dname])\n          dr, dc = name_to_delta[dname]\n          cur_pos = (cur_pos[0] + dr, cur_pos[1] + dc)\n\n  # ------------------------------------------------------------------\n  # Retrieve goal information.\n  goal_idx = None\n  if hasattr(env, \"task\"):\n      task = getattr(env, \"task\")\n      if hasattr(task, \"goal\"):\n          goal_idx = task.goal\n      elif isinstance(task, (list, tuple)):\n          goal_idx = task[0]\n\n  if goal_idx is None:\n      return []  # No identifiable goal.\n\n  scenario = env.scenario\n  world = scenario.world\n\n  # Primitive requirements for the goal.\n  primitives_needed = world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  # Workshop (if any) where the final crafting must happen.\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = recipe.get(\"_at\")\n\n  # Working copy of the grid and an occupancy mask (True = blocked).\n  grid = scenario.init_grid.copy()\n  occ = grid.sum(axis=2) > 0\n\n  # Current agent position.\n  cur_pos = scenario.init_pos  # (row, col)\n\n  # Accumulated list of actions to be returned.\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Collect all required primitive items.\n  for prim_idx, needed_cnt in primitives_needed.items():\n      for _ in range(needed_cnt):\n          # Locate remaining instances of this primitive.\n          prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not prim_cells:\n              # No more instances left; abort early.\n              break\n\n          # Choose the closest instance (Manhattan distance).\n          target = min(\n              prim_cells,\n              key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]),\n          )\n\n          # Move to an empty neighbour of the target.\n          path = bfs_to_adjacent(cur_pos, target, occ)\n          execute_path(path)\n\n          # Use the primitive.\n          actions.append(act_map[\"USE\"])\n\n          # Update grid and occupancy: the primitive disappears.\n          r, c = target\n          grid[r, c, :] = 0\n          occ[r, c] = False\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the goal item.\n  if workshop_idx is not None:\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))\n      if not workshop_cells:\n          # Fallback to the original scenario grid if the workshop was\n          # removed during primitive collection.\n          workshop_cells = list(\n              zip(*np.where(scenario.init_grid[:, :, workshop_idx] > 0))\n          )\n      if workshop_cells:\n          # Choose the nearest workshop.\n          target_ws = min(\n              workshop_cells,\n              key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]),\n          )\n          path = bfs_to_adjacent(cur_pos, target_ws, occ)\n          execute_path(path)\n          actions.append(act_map[\"USE\"])\n\n  # Return the compiled action sequence.\n  return actions", "env_interactions": 0, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T17:42:39.100433", "function_name": "make_arrow", "function_body": "  # Reset (or re\u2011initialize) the environment and fetch useful handles\n  try:\n      env.reset()\n  except Exception:\n      pass\n\n  # Action name \u2192 integer mapping (e.g. {\"DOWN\":0, \"UP\":1, ... ,\"USE\":4})\n  act_map = env.action_specs()\n\n  # Simple move definitions: (delta_row, delta_col, name)\n  MOVES = [\n      (1, 0, \"DOWN\"),\n      (-1, 0, \"UP\"),\n      (0, 1, \"RIGHT\"),\n      (0, -1, \"LEFT\"),\n  ]\n  name_to_delta = {n: (dr, dc) for dr, dc, n in MOVES}\n\n  # ------------------------------------------------------------------\n  # Helper: breadth\u2011first search from `src` to any walkable cell adjacent\n  # to `target`.  Returns a list of action integers (empty if unreachable).\n  def bfs_to_adjacent(src, target, occ_grid):\n      tr, tc = target\n      # candidate cells we may stand on (must be empty and inside bounds)\n      candidates = [\n          (tr + dr, tc + dc)\n          for dr, dc, _ in MOVES\n          if 0 <= tr + dr < occ_grid.shape[0]\n          and 0 <= tc + dc < occ_grid.shape[1]\n          and not occ_grid[tr + dr, tc + dc]\n      ]\n      if not candidates:\n          return []  # no reachable neighbour\n\n      from collections import deque\n\n      q = deque([src])\n      parent = {src: None}\n      parent_move = {}\n      while q:\n          cur = q.popleft()\n          if cur in candidates:\n              # reconstruct path of action names\n              path_names = []\n              while parent[cur] is not None:\n                  path_names.append(parent_move[cur])\n                  cur = parent[cur]\n              path_names.reverse()\n              return [act_map[name] for name in path_names]\n\n          r, c = cur\n          for dr, dc, name in MOVES:\n              nr, nc = r + dr, c + dc\n              if (\n                  0 <= nr < occ_grid.shape[0]\n                  and 0 <= nc < occ_grid.shape[1]\n                  and not occ_grid[nr, nc]\n                  and (nr, nc) not in parent\n              ):\n                  parent[(nr, nc)] = cur\n                  parent_move[(nr, nc)] = name\n                  q.append((nr, nc))\n      return []  # unreachable\n\n  # ------------------------------------------------------------------\n  # Gather goal information\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      # cannot determine goal \u2192 return empty plan\n      return []\n\n  # Recipe and primitive requirements\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind: count}\n\n  # Working copies of the grid and occupancy mask\n  scenario = env.scenario\n  grid = scenario.init_grid.copy()\n  occ = grid.sum(axis=2) > 0                     # True where any entity exists\n  cur_pos = scenario.init_pos                    # (row, col)\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Function to move along a list of action ints, updating cur_pos\n  def execute_actions(action_list):\n      nonlocal cur_pos\n      for a in action_list:\n          actions.append(a)\n          # update position according to action name\n          name = next(k for k, v in act_map.items() if v == a)\n          dr, dc = name_to_delta[name]\n          cur_pos = (cur_pos[0] + dr, cur_pos[1] + dc)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the required number of times\n  for prim_kind, needed in primitives_needed.items():\n      for _ in range(needed):\n          # locate all remaining instances of this primitive\n          prim_cells = list(zip(*np.where(grid[:, :, prim_kind] > 0)))\n          if not prim_cells:\n              # no more of this primitive on the map \u2013 give up early\n              break\n          # pick the closest one (Manhattan distance)\n          target = min(\n              prim_cells,\n              key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]),\n          )\n          # move to an empty neighbour of the target\n          path = bfs_to_adjacent(cur_pos, target, occ)\n          execute_actions(path)\n          # use action to pick up the primitive\n          actions.append(act_map[\"USE\"])\n          # update grid / occupancy: primitive disappears\n          r, c = target\n          grid[r, c, :] = 0\n          occ[r, c] = False\n\n  # ------------------------------------------------------------------\n  # Finally, go to the required workshop (if any) and craft the goal\n  if workshop_kind is not None:\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n      if not workshop_cells:\n          # fallback to original scenario grid if workshop was removed earlier\n          workshop_cells = list(\n              zip(*np.where(scenario.init_grid[:, :, workshop_kind] > 0))\n          )\n      if workshop_cells:\n          target_ws = workshop_cells[0]  # any workshop works\n          path = bfs_to_adjacent(cur_pos, target_ws, occ)\n          execute_actions(path)\n          actions.append(act_map[\"USE\"])\n\n  return actions", "env_interactions": 0, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T17:43:01.384441", "function_name": "make_arrow", "function_body": "  # Reset environment and get handles to the current state and world objects.\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.scenario.world\n  cookbook = world.cookbook\n  idx = cookbook.index                # name \u2194 integer id mapping\n\n  # Action identifiers \u2013 try to read from the env, otherwise fall back to defaults.\n  try:\n      spec = env.action_specs()\n      DOWN = spec[\"DOWN\"]\n      UP = spec[\"UP\"]\n      LEFT = spec[\"LEFT\"]\n      RIGHT = spec[\"RIGHT\"]\n      USE = spec[\"USE\"]\n  except Exception:\n      DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Movement directions paired with their (dr, dc) offsets.\n  moves = [(DOWN, (1, 0)),\n           (UP, (-1, 0)),\n           (LEFT, (0, -1)),\n           (RIGHT, (0, 1))]\n\n  # ----------------------------------------------------------------------\n  # Helper functions.\n  # ----------------------------------------------------------------------\n  from collections import deque\n\n  def bfs_path(start, target):\n      \"\"\"Return a list of move actions (DOWN/UP/LEFT/RIGHT) that moves\n      the agent from *start* to *target*.  The target cell may be occupied;\n      all other traversed cells must be empty.\"\"\"\n      if start == target:\n          return []\n      h, w = state.grid.shape[:2]\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          for act, (dr, dc) in moves:\n              nr, nc = cur[0] + dr, cur[1] + dc\n              if not (0 <= nr < h and 0 <= nc < w):\n                  continue\n              nxt = (nr, nc)\n              # Disallow stepping on occupied cells unless it is the target.\n              if nxt != target and state.grid[nr, nc, :].sum() != 0:\n                  continue\n              if nxt in visited:\n                  continue\n              visited.add(nxt)\n              parent[nxt] = (cur, act)\n              q.append(nxt)\n      if target not in parent and start != target:\n          return []                     # unreachable\n      # Reconstruct path.\n      path = []\n      cur = target\n      while cur != start:\n          prev, act = parent[cur]\n          path.append(act)\n          cur = prev\n      path.reverse()\n      return path\n\n  def bfs_to_nearest(kind_idx, start):\n      \"\"\"Breadth\u2011first search for the closest cell containing *kind_idx*.\n      Returns (path, cell) where *path* is a list of move actions to reach\n      *cell*.  If no such cell is reachable, returns ([], None).\"\"\"\n      if state.grid[start[0], start[1], kind_idx] > 0:\n          return [], start\n      h, w = state.grid.shape[:2]\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          cur = q.popleft()\n          for act, (dr, dc) in moves:\n              nr, nc = cur[0] + dr, cur[1] + dc\n              if not (0 <= nr < h and 0 <= nc < w):\n                  continue\n              nxt = (nr, nc)\n              if nxt in visited:\n                  continue\n              # Treat any occupied cell as blocked unless it holds the target kind.\n              if state.grid[nr, nc, :].sum() != 0 and state.grid[nr, nc, kind_idx] == 0:\n                  continue\n              visited.add(nxt)\n              parent[nxt] = (cur, act)\n              if state.grid[nr, nc, kind_idx] > 0:\n                  # Reconstruct path to this cell.\n                  path = []\n                  cur2 = nxt\n                  while cur2 != start:\n                      prev2, act2 = parent[cur2]\n                      path.append(act2)\n                      cur2 = prev2\n                  path.reverse()\n                  return path, nxt\n              q.append(nxt)\n      return [], None\n\n  # ----------------------------------------------------------------------\n  # Determine goal and required primitives.\n  # ----------------------------------------------------------------------\n  goal_name = \"arrow\"\n  if goal_name not in idx.contents:\n      return []                              # arrow not defined in this world\n  goal_idx = idx[goal_name]\n\n  # Mapping primitive kind \u2192 required count for a single arrow.\n  primitive_needs = cookbook.primitives_for(goal_idx)\n\n  actions = []                               # final action sequence\n\n  # ----------------------------------------------------------------------\n  # 1. Collect each required primitive the necessary number of times.\n  # ----------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          path, cell = bfs_to_nearest(prim_idx, state.pos)\n          if cell is None:                   # cannot find required primitive\n              return actions\n          actions.extend(path)\n          state.pos = cell\n          actions.append(USE)                # pick up\n          # Update simulated state.\n          state.inventory[prim_idx] += 1\n          state.grid[cell[0], cell[1], prim_idx] = 0\n\n  # ----------------------------------------------------------------------\n  # 2. Move to the workshop where the arrow can be crafted and craft it.\n  # ----------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      return actions                         # no workshop information\n  workshop_idx = idx[workshop_name]\n\n  path, cell = bfs_to_nearest(workshop_idx, state.pos)\n  if cell is None:\n      return actions                         # cannot reach workshop\n  actions.extend(path)\n  state.pos = cell\n  actions.append(USE)                        # craft the arrow\n\n  return actions", "env_interactions": 26, "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T17:43:02.511231", "function_name": "make_arrow", "function_body": "  # reset and obtain handles to the underlying objects\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.scenario.world          # CraftWorld\n  cookbook = world.cookbook           # Cookbook\n  idx = cookbook.index                # name \u2194 integer id mapping\n\n  # action identifiers (consistent with CraftLab.action_specs)\n  action_map = env.action_specs()\n  DOWN = action_map[\"DOWN\"]\n  UP = action_map[\"UP\"]\n  LEFT = action_map[\"LEFT\"]\n  RIGHT = action_map[\"RIGHT\"]\n  USE = action_map[\"USE\"]\n  moves = [(DOWN, (1, 0)), (UP, (-1, 0)), (LEFT, (0, -1)), (RIGHT, (0, 1))]\n\n  # ------------------------------------------------------------------\n  # Helper: shortest path (list of move actions) from start \u2192 target.\n  # The target may be occupied; all other cells on the path must be empty.\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  def _bfs_path(start, target):\n      if start == target:\n          return []\n      h, w = state.grid.shape[:2]\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          for act, (dr, dc) in moves:\n              nr, nc = cur[0] + dr, cur[1] + dc\n              if not (0 <= nr < h and 0 <= nc < w):\n                  continue\n              nxt = (nr, nc)\n              if nxt in visited:\n                  continue\n              # disallow stepping on occupied cells unless it's the target\n              if nxt != target and state.grid[nr, nc, :].sum() != 0:\n                  continue\n              visited.add(nxt)\n              parent[nxt] = (cur, act)\n              q.append(nxt)\n      if target not in parent and start != target:\n          return []  # no path found\n      # reconstruct actions\n      path = []\n      cur = target\n      while cur != start:\n          prev, act = parent[cur]\n          path.append(act)\n          cur = prev\n      path.reverse()\n      return path\n\n  # ------------------------------------------------------------------\n  # Helper: locate the closest cell containing a given kind (by BFS).\n  # Returns (action_path, cell_coords) or ([], None) if not found.\n  # ------------------------------------------------------------------\n  def _nearest_cell_of(kind_idx, start):\n      if state.grid[start[0], start[1], kind_idx] > 0:\n          return [], start\n      h, w = state.grid.shape[:2]\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          cur = q.popleft()\n          for act, (dr, dc) in moves:\n              nr, nc = cur[0] + dr, cur[1] + dc\n              if not (0 <= nr < h and 0 <= nc < w):\n                  continue\n              nxt = (nr, nc)\n              if nxt in visited:\n                  continue\n              # treat occupied cells as blocked unless they hold the target kind\n              if state.grid[nr, nc, :].sum() != 0 and state.grid[nr, nc, kind_idx] == 0:\n                  continue\n              visited.add(nxt)\n              parent[nxt] = (cur, act)\n              if state.grid[nr, nc, kind_idx] > 0:\n                  # reconstruct path to this cell\n                  path = []\n                  cur2 = nxt\n                  while cur2 != start:\n                      prev2, act2 = parent[cur2]\n                      path.append(act2)\n                      cur2 = prev2\n                  path.reverse()\n                  return path, nxt\n              q.append(nxt)\n      return [], None\n\n  # ------------------------------------------------------------------\n  # Identify goal (arrow) and required primitives.\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  if goal_name not in idx.contents:\n      return []          # arrow not defined in this world\n  goal_idx = idx[goal_name]\n\n  primitive_requirements = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n  actions = []\n\n  # ------------------------------------------------------------------\n  # 1. Collect each required primitive the necessary number of times.\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_requirements.items():\n      for _ in range(needed_cnt):\n          path, cell = _nearest_cell_of(prim_idx, state.pos)\n          if cell is None:\n              # primitive missing \u2013 abort early\n              return actions\n          actions.extend(path)\n          state.pos = cell\n          actions.append(USE)                     # pick up\n          # update simulated state\n          tr, tc = cell\n          state.inventory[prim_idx] += 1\n          state.grid[tr, tc, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 2. Move to the appropriate workshop and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      return actions  # cannot craft without a workshop\n\n  workshop_idx = idx[workshop_name]\n  path, cell = _nearest_cell_of(workshop_idx, state.pos)\n  if cell is None:\n      return actions  # no workshop reachable\n  actions.extend(path)\n  state.pos = cell\n  actions.append(USE)   # craft the arrow\n\n  return actions", "env_interactions": 26, "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T17:43:21.802052", "function_name": "make_arrow", "function_body": "  env.reset()\n  world = env.world\n  scenario = env.scenario\n  state = env._current_state\n\n  # Goal index (arrow)\n  goal_idx = env.task.goal\n\n  # Primitives required (including transitive dependencies)\n  required = world.cookbook.primitives_for(goal_idx)\n\n  # Determine required workshop (if any) for final crafting\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else world.cookbook.index[wk]\n\n  actions: list[int] = []\n  cur_pos = tuple(state.pos)\n\n  # --------------------------------------------------------------\n  # Helper: Manhattan move sequence (action indices)\n  #   Mapping: DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n  # --------------------------------------------------------------\n  def moves_to(start: tuple[int, int],\n               target: tuple[int, int]) -> tuple[list[int], tuple[int, int]]:\n      x, y = start\n      tx, ty = target\n      seq: list[int] = []\n      while x < tx:\n          seq.append(3)   # RIGHT\n          x += 1\n      while x > tx:\n          seq.append(2)   # LEFT\n          x -= 1\n      while y < ty:\n          seq.append(0)   # DOWN\n          y += 1\n      while y > ty:\n          seq.append(1)   # UP\n          y -= 1\n      return seq, (x, y)\n\n  # --------------------------------------------------------------\n  # Helper: locate nearest cell containing a given kind that\n  # hasn't been harvested yet.\n  # --------------------------------------------------------------\n  harvested: dict[int, set[tuple[int, int]]] = {}\n\n  def nearest_cell(kind: int,\n                   from_pos: tuple[int, int]) -> tuple[int, int] | None:\n      cells = np.argwhere(scenario.init_grid[:, :, kind] > 0)\n      if cells.size == 0:\n          return None\n      used = harvested.get(kind, set())\n      candidates = [tuple(c) for c in cells if tuple(c) not in used]\n      if not candidates:\n          return None\n      dists = [abs(c[0] - from_pos[0]) + abs(c[1] - from_pos[1]) for c in candidates]\n      idx = int(np.argmin(dists))\n      return candidates[idx]\n\n  # --------------------------------------------------------------\n  # Collect all required primitive items.\n  # --------------------------------------------------------------\n  for kind, cnt in required.items():\n      harvested.setdefault(kind, set())\n      for _ in range(cnt):\n          target = nearest_cell(kind, cur_pos)\n          if target is None:\n              # No more available cells of this kind; abort collection.\n              continue\n          move_seq, cur_pos = moves_to(cur_pos, target)\n          actions.extend(move_seq)\n          actions.append(4)               # USE to pick up the primitive\n          harvested[kind].add(target)     # Mark cell as consumed\n\n  # --------------------------------------------------------------\n  # Move to workshop (if required) and craft the goal.\n  # --------------------------------------------------------------\n  if workshop_kind is not None:\n      target = nearest_cell(workshop_kind, cur_pos)\n      if target is not None:\n          move_seq, cur_pos = moves_to(cur_pos, target)\n          actions.extend(move_seq)\n\n  # Final USE to trigger crafting of the arrow.\n  actions.append(4)\n\n  return actions", "env_interactions": 1, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T17:43:22.910608", "function_name": "make_arrow", "function_body": "  env.reset()\n  world = env.world\n  scenario = env.scenario\n  state = env._current_state\n\n  goal_idx = env.task.goal\n\n  # Primitive resources required (including transitive ones)\n  required = world.cookbook.primitives_for(goal_idx)\n\n  # Workshop where final crafting must happen (if any)\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else world.cookbook.index[wk]\n\n  actions: list[int] = []\n  cur_pos = tuple(state.pos)\n\n  # Helper: generate Manhattan move sequence (action indices)\n  def moves_to(start, target):\n      x, y = start\n      tx, ty = target\n      seq = []\n      while x < tx:\n          seq.append(3)   # RIGHT\n          x += 1\n      while x > tx:\n          seq.append(2)   # LEFT\n          x -= 1\n      while y < ty:\n          seq.append(0)   # DOWN\n          y += 1\n      while y > ty:\n          seq.append(1)   # UP\n          y -= 1\n      return seq, (x, y)\n\n  # Keep track of cells already harvested to avoid double\u2011use\n  harvested: dict[int, set[tuple[int, int]]] = {}\n\n  def nearest_cell(kind, from_pos):\n      cells = np.argwhere(scenario.init_grid[:, :, kind] > 0)\n      if cells.size == 0:\n          return None\n      used = harvested.get(kind, set())\n      candidates = [tuple(c) for c in cells if tuple(c) not in used]\n      if not candidates:\n          return None\n      dists = [abs(c[0] - from_pos[0]) + abs(c[1] - from_pos[1]) for c in candidates]\n      idx = int(np.argmin(dists))\n      return candidates[idx]\n\n  # Collect all required primitive items\n  for kind, cnt in required.items():\n      harvested.setdefault(kind, set())\n      for _ in range(cnt):\n          target = nearest_cell(kind, cur_pos)\n          if target is None:\n              continue  # primitive not found; skip\n          move_seq, cur_pos = moves_to(cur_pos, target)\n          actions.extend(move_seq)\n          actions.append(4)               # USE to pick up the primitive\n          harvested[kind].add(target)     # mark cell as used\n\n  # Move to the workshop (if needed) and craft the goal\n  if workshop_kind is not None:\n      target = nearest_cell(workshop_kind, cur_pos)\n      if target is not None:\n          move_seq, cur_pos = moves_to(cur_pos, target)\n          actions.extend(move_seq)\n\n  # Final USE to trigger crafting of the arrow\n  actions.append(4)\n\n  return actions", "env_interactions": 1, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T17:43:48.185440", "function_name": "make_arrow", "function_body": "  # reset environment and get references\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.scenario.world          # CraftWorld\n  cookbook = world.cookbook           # Cookbook\n  index = cookbook.index               # name \u2194 id mapping\n\n  # resolve action indices (fallback defaults)\n  action_map = env.action_specs()\n  DOWN = action_map.get(\"DOWN\", 0)\n  UP = action_map.get(\"UP\", 1)\n  LEFT = action_map.get(\"LEFT\", 2)\n  RIGHT = action_map.get(\"RIGHT\", 3)\n  USE = action_map.get(\"USE\", 4)\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow) and its primitive requirements.\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  if goal_name not in index.contents:\n      return []                       # arrow not defined in this world\n  goal_idx = index[goal_name]\n  primitive_needs = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n  actions = []                         # final action sequence\n\n  # ------------------------------------------------------------------\n  # Helper: BFS returning a list of move actions from start to target.\n  # The target cell may be occupied; all other cells must be empty.\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  def _bfs_path(start, target):\n      \"\"\"Return list of movement actions (DOWN/UP/LEFT/RIGHT) to reach target.\"\"\"\n      if start == target:\n          return []\n      h, w = state.grid.shape[:2]\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      moves = [(DOWN, (1, 0)),\n               (UP, (-1, 0)),\n               (LEFT, (0, -1)),\n               (RIGHT, (0, 1))]\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          for act, (dr, dc) in moves:\n              nr, nc = cur[0] + dr, cur[1] + dc\n              if not (0 <= nr < h and 0 <= nc < w):\n                  continue\n              nxt = (nr, nc)\n              # allow stepping onto target even if occupied\n              if nxt != target and state.grid[nr, nc, :].sum() != 0:\n                  continue\n              if nxt in visited:\n                  continue\n              visited.add(nxt)\n              parent[nxt] = (cur, act)\n              q.append(nxt)\n\n      if target not in parent and start != target:\n          return []  # no path found\n      # reconstruct path\n      path = []\n      cur = target\n      while cur != start:\n          prev, act = parent[cur]\n          path.append(act)\n          cur = prev\n      path.reverse()\n      return path\n\n  # ------------------------------------------------------------------\n  # Phase 1: Collect each required primitive the needed number of times.\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          # locate cells containing this primitive\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              return actions  # primitive missing; abort\n          # choose nearest by Manhattan distance\n          dists = np.abs(prim_cells - np.array(state.pos)).sum(axis=1)\n          tr, tc = prim_cells[dists.argmin()]\n\n          # move to primitive cell\n          move_seq = _bfs_path(state.pos, (tr, tc))\n          actions.extend(move_seq)\n          state.pos = (tr, tc)\n\n          # pick up\n          actions.append(USE)\n          state.inventory[prim_idx] += 1\n          state.grid[tr, tc, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Phase 2: Go to workshop and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      return actions  # no workshop info\n\n  workshop_idx = index[workshop_name]\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      return actions  # workshop absent\n\n  # choose nearest workshop cell\n  dists = np.abs(workshop_cells - np.array(state.pos)).sum(axis=1)\n  wr, wc = workshop_cells[dists.argmin()]\n\n  # move to workshop\n  move_seq = _bfs_path(state.pos, (wr, wc))\n  actions.extend(move_seq)\n  state.pos = (wr, wc)\n\n  # craft arrow\n  actions.append(USE)\n\n  return actions", "env_interactions": 24, "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T17:43:49.304541", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.scenario.world\n  cookbook = world.cookbook\n  index = cookbook.index\n\n  # Resolve actions (fallback to defaults if not present)\n  action_map = env.action_specs()\n  DOWN = action_map.get(\"DOWN\", 0)\n  UP = action_map.get(\"UP\", 1)\n  LEFT = action_map.get(\"LEFT\", 2)\n  RIGHT = action_map.get(\"RIGHT\", 3)\n  USE = action_map.get(\"USE\", 4)\n\n  # ------------------------------------------------------------\n  # Identify the goal (arrow) and its primitive requirements.\n  # ------------------------------------------------------------\n  goal_name = \"arrow\"\n  if goal_name not in index.contents:\n      return []                     # Arrow not defined in this world.\n  goal_idx = index[goal_name]\n  primitive_needs = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  actions = []\n\n  from collections import deque\n\n  def _bfs_path(start, target):\n      \"\"\"Return a list of movement actions from start to target.\n      All cells except the target must be empty.\n      \"\"\"\n      if start == target:\n          return []\n      h, w = state.grid.shape[:2]\n      moves = [(DOWN, (1, 0)),\n               (UP, (-1, 0)),\n               (LEFT, (0, -1)),\n               (RIGHT, (0, 1))]\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          for act, (dr, dc) in moves:\n              nr, nc = cur[0] + dr, cur[1] + dc\n              if not (0 <= nr < h and 0 <= nc < w):\n                  continue\n              nxt = (nr, nc)\n              # Allow stepping onto the target even if occupied.\n              if nxt != target and state.grid[nr, nc, :].sum() != 0:\n                  continue\n              if nxt in visited:\n                  continue\n              visited.add(nxt)\n              parent[nxt] = (cur, act)\n              q.append(nxt)\n\n      if target not in parent and start != target:\n          return []  # No path found.\n\n      # Reconstruct path.\n      path = []\n      cur = target\n      while cur != start:\n          prev, act = parent[cur]\n          path.append(act)\n          cur = prev\n      path.reverse()\n      return path\n\n  # ------------------------------------------------------------\n  # Phase 1: Collect each required primitive the needed number of times.\n  # ------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # Primitive missing; abort early.\n              return actions\n\n          # Choose the nearest primitive cell (Manhattan distance).\n          dists = np.abs(prim_cells - np.array(state.pos)).sum(axis=1)\n          tr, tc = prim_cells[dists.argmin()]\n\n          # Move to the primitive cell.\n          move_seq = _bfs_path(state.pos, (tr, tc))\n          actions.extend(move_seq)\n          state.pos = (tr, tc)\n\n          # Pick it up.\n          actions.append(USE)\n\n          # Update internal copy of the state.\n          state.inventory[prim_idx] += 1\n          state.grid[tr, tc, prim_idx] = 0\n\n  # ------------------------------------------------------------\n  # Phase 2: Go to the appropriate workshop and craft the arrow.\n  # ------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      return actions                     # No workshop info; cannot craft.\n\n  workshop_idx = index[workshop_name]\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      return actions                     # Workshop not present.\n\n  # Choose the nearest workshop cell.\n  dists = np.abs(workshop_cells - np.array(state.pos)).sum(axis=1)\n  wr, wc = workshop_cells[dists.argmin()]\n\n  # Move to the workshop.\n  move_seq = _bfs_path(state.pos, (wr, wc))\n  actions.extend(move_seq)\n  state.pos = (wr, wc)\n\n  # Craft the arrow.\n  actions.append(USE)\n\n  return actions", "env_interactions": 24, "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T17:44:20.917044", "function_name": "make_arrow", "function_body": "  # Reset environment and obtain references\n  env.reset()\n  world = env.world\n  scenario = env.scenario\n  state = env._current_state\n\n  # Goal index and required primitive counts (expanded to primitives only)\n  goal_idx = env.task.goal\n  required = world.cookbook.primitives_for(goal_idx)\n\n  # Determine if final crafting must happen at a specific workshop\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else world.cookbook.index[wk]\n\n  # Action constants (as used by CraftWorld)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Helper: convert a step between two adjacent cells into an action index\n  def _step_to_action(p_from, p_to):\n      x0, y0 = p_from\n      x1, y1 = p_to\n      if x1 == x0 + 1:\n          return RIGHT\n      if x1 == x0 - 1:\n          return LEFT\n      if y1 == y0 + 1:\n          return DOWN\n      if y1 == y0 - 1:\n          return UP\n      raise ValueError(\"Non\u2011adjacent step supplied\")\n\n  # Helper: BFS to find a path from start to any walkable cell that is\n  # orthogonally adjacent to a target cell.\n  def _bfs_to_adjacent(start, target):\n      width, height, _ = scenario.init_grid.shape\n      # candidate landing cells (orthogonal neighbours of target that are empty)\n      candidates = []\n      tx, ty = target\n      for dx, dy in [(1,0), (-1,0), (0,1), (0,-1)]:\n          nx, ny = tx + dx, ty + dy\n          if 0 <= nx < width and 0 <= ny < height:\n              if scenario.init_grid[nx, ny, :].sum() == 0:\n                  candidates.append((nx, ny))\n      if not candidates:\n          # fallback: if target cell itself is empty (unlikely) allow stepping on it\n          if scenario.init_grid[tx, ty, :].sum() == 0:\n              candidates.append((tx, ty))\n\n      # BFS over empty cells\n      queue = collections.deque([start])\n      visited = {start: None}\n      while queue:\n          cur = queue.popleft()\n          if cur in candidates:\n              # reconstruct path\n              path = []\n              while cur is not None:\n                  path.append(cur)\n                  cur = visited[cur]\n              path.reverse()\n              return path\n          x, y = cur\n          for dx, dy in [(1,0), (-1,0), (0,1), (0,-1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height:\n                  if (nx, ny) not in visited and scenario.init_grid[nx, ny, :].sum() == 0:\n                      visited[(nx, ny)] = cur\n                      queue.append((nx, ny))\n      # No reachable adjacent cell\n      return None\n\n  # Helper: locate the nearest cell that still contains a given kind\n  def _nearest_kind(kind, from_pos, grid):\n      cells = np.argwhere(grid[:, :, kind] > 0)\n      if cells.size == 0:\n          return None\n      dists = np.abs(cells[:, 0] - from_pos[0]) + np.abs(cells[:, 1] - from_pos[1])\n      idx = dists.argmin()\n      return tuple(cells[idx])\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # Work on a mutable copy of the initial grid so we can \u201cconsume\u201d resources\n  grid_copy = scenario.init_grid.copy()\n\n  # --------------------------------------------------------------\n  # Collect all required primitive resources\n  # --------------------------------------------------------------\n  for kind, cnt in required.items():\n      for _ in range(cnt):\n          target = _nearest_kind(kind, cur_pos, grid_copy)\n          if target is None:\n              # Primitive not present \u2013 skip (cannot be collected)\n              continue\n          path = _bfs_to_adjacent(cur_pos, target)\n          if path is None:\n              # No path to an adjacent cell \u2013 skip this resource\n              continue\n          # Translate path positions into actions\n          for i in range(1, len(path)):\n              actions.append(_step_to_action(path[i-1], path[i]))\n          # Perform USE to pick up the primitive\n          actions.append(USE)\n          # Update current position (we stay at the last cell of the path)\n          cur_pos = path[-1]\n          # Mark the resource as taken so we don't reuse the same cell\n          grid_copy[target[0], target[1], kind] = 0\n\n  # --------------------------------------------------------------\n  # Move to the workshop (if required) and craft the final item\n  # --------------------------------------------------------------\n  if workshop_kind is not None:\n      target = _nearest_kind(workshop_kind, cur_pos, scenario.init_grid)\n      if target is not None:\n          path = _bfs_to_adjacent(cur_pos, target)\n          if path is not None:\n              for i in range(1, len(path)):\n                  actions.append(_step_to_action(path[i-1], path[i]))\n              actions.append(USE)  # craft at the workshop\n\n  return actions", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T17:44:22.034318", "function_name": "make_arrow", "function_body": "  env.reset()\n  world = env.world\n  scenario = env.scenario\n  state = env._current_state\n\n  goal_idx = env.task.goal\n  required = world.cookbook.primitives_for(goal_idx)\n\n  # Determine if the final recipe requires a specific workshop\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else world.cookbook.index[wk]\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # ------------------------------------------------------------------\n  # Helper: Manhattan move sequence (ignores obstacles for simplicity)\n  # ------------------------------------------------------------------\n  def moves_to(start, target):\n      x, y = start\n      tx, ty = target\n      seq = []\n      while x < tx:\n          seq.append(3)   # RIGHT\n          x += 1\n      while x > tx:\n          seq.append(2)   # LEFT\n          x -= 1\n      while y < ty:\n          seq.append(0)   # DOWN\n          y += 1\n      while y > ty:\n          seq.append(1)   # UP\n          y -= 1\n      return seq, (x, y)\n\n  # ------------------------------------------------------------------\n  # Helper: locate nearest cell containing a given kind in a grid\n  # ------------------------------------------------------------------\n  def nearest_cell(kind, from_pos, grid):\n      cells = np.argwhere(grid[:, :, kind] > 0)\n      if cells.size == 0:\n          return None\n      dists = np.abs(cells[:, 0] - from_pos[0]) + np.abs(cells[:, 1] - from_pos[1])\n      idx = dists.argmin()\n      return tuple(cells[idx])\n\n  # Keep a mutable copy of the initial grid so we can \u201cremove\u201d items once taken\n  grid_copy = scenario.init_grid.copy()\n\n  # ------------------------------------------------------------------\n  # Collect all required primitive items\n  # ------------------------------------------------------------------\n  for kind, cnt in required.items():\n      for _ in range(cnt):\n          target = nearest_cell(kind, cur_pos, grid_copy)\n          if target is None:\n              continue\n          move_seq, cur_pos = moves_to(cur_pos, target)\n          actions.extend(move_seq)\n          actions.append(4)                     # USE to pick up the primitive\n          grid_copy[target[0], target[1], kind] = 0   # mark as taken\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if required) and craft the final item\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      target = nearest_cell(workshop_kind, cur_pos, scenario.init_grid)\n      if target is not None:\n          move_seq, cur_pos = moves_to(cur_pos, target)\n          actions.extend(move_seq)\n          actions.append(4)                     # USE to craft at the workshop\n\n  return actions", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T17:44:43.807191", "function_name": "make_arrow", "function_body": "  # Action constants\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Gather recipe information for the target item \u201carrow\u201d\n  # ------------------------------------------------------------------\n  world = env.world\n  arrow_idx = world.cookbook.index.index('arrow')\n  primitives_needed = world.cookbook.primitives_for(arrow_idx)\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def _cell_occupied(pos, grid):\n      \"\"\"True if any entity occupies the cell at `pos`.\"\"\"\n      x, y = pos\n      return grid[x, y, :].any()\n\n  def _bfs_path(start, goal, grid):\n      \"\"\"Shortest path (list of positions) from start to goal.\n      Goal may be occupied (e.g., a workshop). Returns None if no path.\"\"\"\n      if start == goal:\n          return [start]\n      w, h = grid.shape[:2]\n      frontier = collections.deque([start])\n      came_from = {start: None}\n      while frontier:\n          cur = frontier.popleft()\n          if cur == goal:\n              break\n          x, y = cur\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h:\n                  nxt = (nx, ny)\n                  if nxt not in came_from:\n                      # allow stepping onto goal even if occupied\n                      if not _cell_occupied(nxt, grid) or nxt == goal:\n                          came_from[nxt] = cur\n                          frontier.append(nxt)\n      else:\n          return None  # no path found\n\n      # reconstruct path\n      path = [goal]\n      while path[-1] != start:\n          path.append(came_from[path[-1]])\n      path.reverse()\n      return path\n\n  def _actions_from_path(path):\n      \"\"\"Translate consecutive positions into action indices.\"\"\"\n      acts = []\n      for (x0, y0), (x1, y1) in zip(path, path[1:]):\n          if x1 == x0 + 1:\n              acts.append(DOWN)\n          elif x1 == x0 - 1:\n              acts.append(UP)\n          elif y1 == y0 + 1:\n              acts.append(RIGHT)\n          elif y1 == y0 - 1:\n              acts.append(LEFT)\n          else:\n              raise ValueError(\"Non\u2011adjacent steps in path\")\n      return acts\n\n  def _move_actions(src, dst, grid):\n      \"\"\"Return actions moving from src to dst (BFS preferred, fallback to Manhattan).\"\"\"\n      path = _bfs_path(src, dst, grid)\n      if path is None:\n          # Manhattan fallback (may collide with obstacles)\n          acts = []\n          x, y = src\n          tx, ty = dst\n          if tx > x:\n              acts += [DOWN] * (tx - x)\n          elif tx < x:\n              acts += [UP] * (x - tx)\n          if ty > y:\n              acts += [RIGHT] * (ty - y)\n          elif ty < y:\n              acts += [LEFT] * (y - ty)\n          return acts\n      return _actions_from_path(path)\n\n  def _nearest_entity(pos, kind_idx, grid, excluded):\n      \"\"\"Find nearest cell containing `kind_idx` not in `excluded`.\"\"\"\n      candidates = np.argwhere(grid[:, :, kind_idx] > 0)\n      if candidates.size == 0:\n          return None\n      if excluded:\n          mask = np.array([tuple(c) not in excluded for c in candidates])\n          candidates = candidates[mask]\n          if candidates.size == 0:\n              return None\n      dists = np.abs(candidates[:, 0] - pos[0]) + np.abs(candidates[:, 1] - pos[1])\n      nearest = candidates[dists.argmin()]\n      return tuple(nearest.tolist())\n\n  # ------------------------------------------------------------------\n  # Planning: collect required primitives\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = env._current_state.pos\n  # copy of grid to simulate picking up items\n  sim_grid = env._current_state.grid.copy()\n  harvested = {}  # kind_idx -> set of positions already taken\n\n  for prim_idx, count in primitives_needed.items():\n      harvested.setdefault(prim_idx, set())\n      for _ in range(count):\n          target = _nearest_entity(cur_pos, prim_idx, sim_grid, harvested[prim_idx])\n          if target is None:\n              # primitive not available; abort planning\n              return actions\n          actions += _move_actions(cur_pos, target, sim_grid)\n          cur_pos = target\n          actions.append(USE)  # pick up primitive\n          # simulate removal of the primitive from the grid\n          sim_grid[cur_pos[0], cur_pos[1], prim_idx] = 0\n          harvested[prim_idx].add(cur_pos)\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  workshop_name = world.cookbook.recipes[arrow_idx].get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_pos = _nearest_entity(cur_pos, workshop_idx, sim_grid, set())\n      if ws_pos is not None:\n          actions += _move_actions(cur_pos, ws_pos, sim_grid)\n          cur_pos = ws_pos\n          actions.append(USE)  # craft at workshop\n\n  return actions", "env_interactions": 24, "island_id": 5, "scores": {"3": 0.2}}
