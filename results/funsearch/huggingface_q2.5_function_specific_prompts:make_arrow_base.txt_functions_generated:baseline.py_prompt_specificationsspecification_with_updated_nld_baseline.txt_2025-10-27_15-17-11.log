{"timestamp": "2025-10-27T15:59:00.182582", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action indices (as defined in CraftLab.action_specs)\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n  ACTIONS = {\n      (0, 1): ACTION_DOWN,\n      (0, -1): ACTION_UP,\n      (-1, 0): ACTION_LEFT,\n      (1, 0): ACTION_RIGHT,\n  }\n\n  # -------------------------------------------------------------------------\n  # Helper: compute Manhattan distance\n  def manhattan(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  # Helper: given current position and a target cell, return the direction\n  # (dx, dy) needed to face the target (orthogonal neighbours only)\n  def direction_to(src, dst):\n      dx = dst[0] - src[0]\n      dy = dst[1] - src[1]\n      if dx > 0:\n          return (1, 0)\n      if dx < 0:\n          return (-1, 0)\n      if dy > 0:\n          return (0, 1)\n      if dy < 0:\n          return (0, -1)\n      return (0, 0)  # same cell (should not happen)\n\n  # Helper: BFS that returns a list of actions moving from start to any\n  # orthogonal neighbour of target that is free (i.e. not blocked).\n  def bfs_to_adjacent(start, target, grid):\n      width, height, _ = grid.shape\n      # cells that are occupied by any kind (including primitives, workshops,\n      # water, stone, etc.) are considered blocked for movement.\n      blocked = np.any(grid > 0, axis=2)\n\n      # Determine all free cells that are orthogonal neighbours of the target.\n      neighbours = []\n      for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n          nx, ny = target[0] + dx, target[1] + dy\n          if 0 <= nx < width and 0 <= ny < height and not blocked[nx, ny]:\n              neighbours.append((nx, ny))\n\n      # If we are already on a valid neighbour, no movement needed.\n      if start in neighbours:\n          return []\n\n      # BFS over free cells.\n      q = deque()\n      q.append((start, []))\n      visited = set()\n      visited.add(start)\n\n      while q:\n          (x, y), path = q.popleft()\n          for (dx, dy), act in [((0, 1), ACTION_DOWN),\n                                ((0, -1), ACTION_UP),\n                                ((-1, 0), ACTION_LEFT),\n                                ((1, 0), ACTION_RIGHT)]:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              if blocked[nx, ny]:\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              new_path = path + [act]\n              if (nx, ny) in neighbours:\n                  return new_path\n              visited.add((nx, ny))\n              q.append(((nx, ny), new_path))\n\n      # If no path found (should not happen in well\u2011formed scenarios), return empty.\n      return []\n\n  # -------------------------------------------------------------------------\n  # Reset the environment to obtain a fresh state.\n  env.reset()\n  state = env._current_state          # CraftState instance\n  world = env.world                    # CraftWorld instance\n  cookbook = world.cookbook\n\n  # Goal: make an arrow.\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # Primitive requirements for one arrow.\n  primitive_needs = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n  # Workshop needed for the recipe (may be None).\n  workshop_idx = None\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = cookbook.index[workshop_name]\n\n  plan_actions = []   # final list of actions to return\n\n  # -------------------------------------------------------------------------\n  # Function to execute a list of actions on the internal state (so we keep\n  # the simulated state in sync with the actions we record).\n  def apply_actions(action_list):\n      nonlocal state\n      for a in action_list:\n          _, new_state = state.step(a)\n          state = new_state\n\n  # -------------------------------------------------------------------------\n  # Collect all required primitives.\n  while True:\n      # Determine which primitives are still missing.\n      missing = {}\n      for p_idx, need_cnt in primitive_needs.items():\n          have = int(state.inventory[p_idx])\n          if have < need_cnt:\n              missing[p_idx] = need_cnt - have\n\n      if not missing:\n          break   # all primitives gathered\n\n      # Pick the first missing primitive (simple greedy choice).\n      p_idx, _ = next(iter(missing.items()))\n\n      # Locate any instance of this primitive on the grid.\n      grid = state.grid\n      locations = np.argwhere(grid[:, :, p_idx] > 0)\n      if locations.shape[0] == 0:\n          # No more of this primitive on the map \u2013 cannot continue.\n          break\n\n      # Choose the nearest instance (Manhattan distance).\n      cur_pos = state.pos\n      dists = np.apply_along_axis(lambda loc: manhattan(cur_pos, (loc[0], loc[1])),\n                                  1, locations)\n      target_cell = tuple(locations[dists.argmin()])\n\n      # Move to a free neighbour of the target cell.\n      move_actions = bfs_to_adjacent(cur_pos, target_cell, grid)\n      plan_actions.extend(move_actions)\n      apply_actions(move_actions)\n\n      # After arriving, face the primitive and use the USE action.\n      # Determine direction needed to face the primitive.\n      face_dir = direction_to(state.pos, target_cell)\n      if face_dir != (0, 0):\n          # Ensure the agent's direction matches the needed one.\n          # The environment automatically sets direction to the last movement\n          # direction, so we may need a small corrective move.\n          # We simply perform a dummy move in the required direction and then\n          # step back (if the forward cell is free). This keeps us adjacent.\n          dx, dy = face_dir\n          # Attempt a forward move; if blocked, skip the correction.\n          forward_pos = (state.pos[0] + dx, state.pos[1] + dy)\n          if (0 <= forward_pos[0] < grid.shape[0] and\n              0 <= forward_pos[1] < grid.shape[1] and\n              not np.any(grid[forward_pos[0], forward_pos[1], :] > 0)):\n              corr_action = ACTIONS[(dx, dy)]\n              plan_actions.append(corr_action)\n              apply_actions([corr_action])\n              # Step back to original cell.\n              back_action = ACTIONS[(-dx, -dy)]\n              plan_actions.append(back_action)\n              apply_actions([back_action])\n\n      # Finally, collect the primitive.\n      plan_actions.append(ACTION_USE)\n      _, new_state = state.step(ACTION_USE)\n      state = new_state\n\n  # -------------------------------------------------------------------------\n  # If a workshop is required for the final crafting step, go there and use.\n  if workshop_idx is not None:\n      grid = state.grid\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.shape[0] > 0:\n          workshop_cell = tuple(workshop_cells[0])\n\n          # Move adjacent to the workshop.\n          move_actions = bfs_to_adjacent(state.pos, workshop_cell, grid)\n          plan_actions.extend(move_actions)\n          apply_actions(move_actions)\n\n          # Face the workshop (same correction logic as above).\n          face_dir = direction_to(state.pos, workshop_cell)\n          if face_dir != (0, 0):\n              dx, dy = face_dir\n              forward_pos = (state.pos[0] + dx, state.pos[1] + dy)\n              if (0 <= forward_pos[0] < grid.shape[0] and\n                  0 <= forward_pos[1] < grid.shape[1] and\n                  not np.any(grid[forward_pos[0], forward_pos[1], :] > 0)):\n                  corr_action = ACTIONS[(dx, dy)]\n                  plan_actions.append(corr_action)\n                  apply_actions([corr_action])\n                  back_action = ACTIONS[(-dx, -dy)]\n                  plan_actions.append(back_action)\n                  apply_actions([back_action])\n\n          # Use the workshop to craft the arrow.\n          plan_actions.append(ACTION_USE)\n          _, new_state = state.step(ACTION_USE)\n          state = new_state\n\n  # Return the complete action sequence.\n  return plan_actions", "env_interactions": 0, "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-10-27T15:59:27.658426", "function_name": "make_arrow", "function_body": "  # Reset environment and get initial references\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  idx = world.cookbook.index           # name \u2194 integer id\n\n  # Goal item\n  goal_name = \"arrow\"\n  goal_idx = idx[goal_name]\n\n  # Primitive requirements for one arrow\n  primitive_counts = world.cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n\n  # Workshop needed for crafting the arrow\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else idx[wk]\n\n  actions = []\n  cur_pos = state.pos\n\n  # --------------------------------------------------------------\n  # Helper utilities\n  # --------------------------------------------------------------\n  def find_locations(kind):\n      \"\"\"Return list of (x, y) cells that currently contain `kind`.\"\"\"\n      occ = np.where(state.grid[:, :, kind] > 0)\n      return list(zip(occ[0].tolist(), occ[1].tolist()))\n\n  def move_action(cur, nxt):\n      \"\"\"Convert a step from cur \u2192 nxt (adjacent) into an action index.\"\"\"\n      dx = nxt[0] - cur[0]\n      dy = nxt[1] - cur[1]\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise ValueError(\"Non\u2011adjacent move requested\")\n\n  def bfs(start, goal):\n      \"\"\"Shortest\u2011path BFS ignoring non\u2011grabbable cells.\"\"\"\n      if start == goal:\n          return [start]\n      W, H = state.grid.shape[:2]\n\n      # Build set of blocked coordinates (non\u2011grabbable entities)\n      blocked = set()\n      for ng in world.non_grabbable_indices:\n          occ = np.where(state.grid[:, :, ng] > 0)\n          blocked.update(zip(occ[0].tolist(), occ[1].tolist()))\n\n      q = collections.deque([start])\n      prev = {start: None}\n      while q:\n          cur = q.popleft()\n          for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:\n                  nxt = (nx, ny)\n                  if nxt not in prev:\n                      prev[nxt] = cur\n                      if nxt == goal:\n                          # Reconstruct path\n                          path = [goal]\n                          while path[-1] != start:\n                              path.append(prev[path[-1]])\n                          path.reverse()\n                          return path\n                      q.append(nxt)\n      # No path found \u2013 stay where we are\n      return [start]\n\n  # --------------------------------------------------------------\n  # Collect required primitives\n  # --------------------------------------------------------------\n  for prim_idx, needed in primitive_counts.items():\n      for _ in range(needed):\n          # Locate a remaining instance of the primitive\n          locations = find_locations(prim_idx)\n          if not locations:\n              # Either already in inventory or unavailable; skip\n              continue\n          target = locations[0]                       # pick first occurrence\n\n          # Move to the cell containing the primitive\n          path = bfs(cur_pos, target)\n          for step in path[1:]:                       # skip current position\n              act = move_action(cur_pos, step)\n              actions.append(act)\n              cur_pos = step\n              # Execute action to keep `state` up\u2011to\u2011date\n              env.step(act)\n              state = env._current_state\n\n          # Pick up the primitive\n          actions.append(4)                           # USE\n          env.step(4)\n          state = env._current_state\n\n  # --------------------------------------------------------------\n  # Move to workshop and craft the arrow\n  # --------------------------------------------------------------\n  if workshop_kind is not None:\n      wk_locs = find_locations(workshop_kind)\n      if wk_locs:\n          target = wk_locs[0]\n          path = bfs(cur_pos, target)\n          for step in path[1:]:\n              act = move_action(cur_pos, step)\n              actions.append(act)\n              cur_pos = step\n              env.step(act)\n              state = env._current_state\n\n          # Craft at the workshop\n          actions.append(4)          # USE\n          env.step(4)\n          state = env._current_state\n\n  return actions", "env_interactions": 21, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T15:59:28.819499", "function_name": "make_arrow", "function_body": "  # Reset environment and get current state/world information\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  idx = world.cookbook.index           # name \u2194 integer id\n\n  # Goal item\n  goal_name = \"arrow\"\n  goal_idx = idx[goal_name]\n\n  # Primitive requirements for one arrow\n  primitive_counts = world.cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n\n  # Workshop required for crafting the arrow (if any)\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else idx[wk]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  def find_locations(kind):\n      \"\"\"Return list of (x, y) positions where grid contains the given kind.\"\"\"\n      occ = np.where(state.grid[:, :, kind] > 0)\n      return list(zip(occ[0].tolist(), occ[1].tolist()))\n\n  def move_action(cur, nxt):\n      \"\"\"Convert a step from cur to nxt (adjacent) into an action index.\"\"\"\n      dx = nxt[0] - cur[0]\n      dy = nxt[1] - cur[1]\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise ValueError(\"Non\u2011adjacent move in path\")\n\n  def bfs(start, goal):\n      \"\"\"Shortest path (list of positions) from start to goal avoiding non\u2011grabbable cells.\"\"\"\n      if start == goal:\n          return [start]\n      W, H = state.grid.shape[:2]\n      blocked = set()\n      for ng in world.non_grabbable_indices:\n          occ = np.where(state.grid[:, :, ng] > 0)\n          blocked.update(zip(occ[0].tolist(), occ[1].tolist()))\n      q = collections.deque([start])\n      prev = {start: None}\n      while q:\n          cur = q.popleft()\n          for dx, dy in [(1,0), (-1,0), (0,1), (0,-1)]:\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:\n                  nxt = (nx, ny)\n                  if nxt not in prev:\n                      prev[nxt] = cur\n                      if nxt == goal:\n                          # Reconstruct path\n                          path = [goal]\n                          while path[-1] != start:\n                              path.append(prev[path[-1]])\n                          path.reverse()\n                          return path\n                      q.append(nxt)\n      # No path found \u2013 stay in place\n      return [start]\n\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = state.pos\n\n  # --------------------------------------------------------------\n  # Collect each required primitive the needed number of times\n  for prim_idx, needed in primitive_counts.items():\n      for _ in range(needed):\n          # Locate any remaining instance of this primitive on the grid\n          locations = find_locations(prim_idx)\n          if not locations:\n              # No more instances; assume already in inventory and skip\n              continue\n          target = locations[0]                     # pick first instance\n          # Plan path to the target cell\n          path = bfs(cur_pos, target)\n          for step in path[1:]:                     # skip current position\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n          # Pick up the primitive (USE action)\n          actions.append(4)                         # USE\n\n  # --------------------------------------------------------------\n  # Move to the workshop (if required) and craft the arrow\n  if workshop_kind is not None:\n      wk_locs = find_locations(workshop_kind)\n      if wk_locs:\n          target = wk_locs[0]\n          path = bfs(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n          # Use the workshop to craft\n          actions.append(4)                         # USE\n\n  return actions", "env_interactions": 21, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T15:59:53.133970", "function_name": "make_arrow", "function_body": "  # Reset the environment and get the initial state and world objects\n  env.reset()\n  state = env._current_state          # type: CraftState\n  world = env.world                    # type: CraftWorld\n\n  # Index of the goal item we need to craft\n  goal_idx = env.task.goal\n\n  # Primitive requirements for the goal (primitive_kind -> count)\n  required = world.cookbook.primitives_for(goal_idx)\n\n  # Action indices according to CraftLab's action specification\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n  move_dirs = [(1, 0, ACTION_DOWN), (-1, 0, ACTION_UP),\n               (0, -1, ACTION_LEFT), (0, 1, ACTION_RIGHT)]\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper: BFS to find a shortest path (as a list of movement actions)\n  # from the current position to any cell that contains the desired kind.\n  # The search avoids any occupied cell (any non\u2011zero kind) except the\n  # target cell itself.\n  # ------------------------------------------------------------------\n  def find_path_to(state, target_kind):\n      grid = state.grid\n      H, W, _ = grid.shape\n      start = state.pos\n      visited = {start}\n      q = collections.deque([(start, [])])\n\n      while q:\n          (x, y), path = q.popleft()\n          # If we are standing on the target kind, we have arrived\n          if grid[x, y, target_kind] > 0:\n              return path\n          for dx, dy, act in move_dirs:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < H and 0 <= ny < W):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              # Allow stepping onto the target cell even if it is occupied\n              occupied = np.any(grid[nx, ny, :] > 0)\n              if occupied and grid[nx, ny, target_kind] == 0:\n                  continue\n              visited.add((nx, ny))\n              q.append(((nx, ny), path + [act]))\n      return None\n\n  # ------------------------------------------------------------------\n  # 1) Collect every required primitive.\n  # ------------------------------------------------------------------\n  for kind, count in required.items():\n      for _ in range(count):\n          path = find_path_to(state, kind)\n          if path is None:\n              # Primitive not reachable \u2013 abort collection for this item\n              continue\n          for act in path:\n              _, state = state.step(act)\n              actions.append(act)\n          # Use (pick up) the primitive now under the agent\n          _, state = state.step(ACTION_USE)\n          actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # 2) Move to the workshop required for the goal and craft the item.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get('_at')\n  if workshop_kind is not None:\n      path = find_path_to(state, workshop_kind)\n      if path:\n          for act in path:\n              _, state = state.step(act)\n              actions.append(act)\n          # Use the workshop to craft the goal item\n          _, state = state.step(ACTION_USE)\n          actions.append(ACTION_USE)\n\n  return actions", "env_interactions": 0, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T15:59:54.293775", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state          # type: CraftState\n  world = env.world                    # type: CraftWorld\n\n  goal_idx = env.task.goal\n  required = world.cookbook.primitives_for(goal_idx)\n\n  # Action indices according to CraftLab's action_specs\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n  move_dirs = [(1, 0, ACTION_DOWN), (-1, 0, ACTION_UP),\n               (0, -1, ACTION_LEFT), (0, 1, ACTION_RIGHT)]\n\n  actions = []\n\n  from collections import deque\n\n  def find_path(state, target_kind):\n      \"\"\"BFS returning a list of movement actions to reach a cell\n      containing `target_kind`. The agent may step onto that cell even\n      though it is occupied.\"\"\"\n      grid = state.grid\n      H, W = grid.shape[:2]\n      start = state.pos\n      visited = {start}\n      q = deque([(start, [])])\n\n      while q:\n          (x, y), path = q.popleft()\n          if grid[x, y, target_kind] > 0:\n              return path\n          for dx, dy, act in move_dirs:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < H and 0 <= ny < W and (nx, ny) not in visited:\n                  # allow moving onto empty cells or the target cell itself\n                  if grid[nx, ny, :].sum() == 0 or grid[nx, ny, target_kind] > 0:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [act]))\n      return []  # fallback (should not happen in valid scenarios)\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitives.\n  # ------------------------------------------------------------------\n  for kind, count in required.items():\n      for _ in range(count):\n          path = find_path(state, kind)\n          for act in path:\n              _, state = state.step(act)\n              actions.append(act)\n          # Pick up the primitive now under the agent\n          _, state = state.step(ACTION_USE)\n          actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # 2) Move to the appropriate workshop and craft the goal item.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get('_at')\n  if workshop_kind is not None:\n      path = find_path(state, workshop_kind)\n      for act in path:\n          _, state = state.step(act)\n          actions.append(act)\n      _, state = state.step(ACTION_USE)\n      actions.append(ACTION_USE)\n\n  return actions", "env_interactions": 0, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T16:00:15.279090", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # Helper: map movement direction to action index (as defined in CraftLab)\n  DIR2ACT = {\n      (1, 0): 0,   # DOWN\n      (-1, 0): 1,  # UP\n      (0, -1): 2,  # LEFT\n      (0, 1): 3,   # RIGHT\n  }\n\n  def _move_actions(src, dst):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) to go from src to dst\n      using a simple Manhattan\u2011distance greedy strategy.\"\"\"\n      actions = []\n      r, c = src\n      tr, tc = dst\n      while r != tr:\n          dr = 1 if tr > r else -1\n          act = DIR2ACT[(dr, 0)]\n          actions.append(act)\n          r += dr\n      while c != tc:\n          dc = 1 if tc > c else -1\n          act = DIR2ACT[(0, dc)]\n          actions.append(act)\n          c += dc\n      return actions\n\n  # -------------------------------------------------------------------------\n  # 1. Resolve indices for the goal item (\"arrow\") and its recipe.\n  # -------------------------------------------------------------------------\n  world = env.world\n  cookbook = world.cookbook\n\n  # obtain the integer index for the goal name; fall back to searching the index dict\n  try:\n      goal_idx = cookbook.index[\"arrow\"]\n  except Exception:  # pragma: no cover\n      raise ValueError(\"Goal \\\"arrow\\\" not found in recipe index.\")\n\n  # primitive requirements for a single arrow (does not include intermediate items)\n  primitive_needs = cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  if not primitive_needs:\n      # no recipe \u2013 nothing to do\n      return []\n\n  # -------------------------------------------------------------------------\n  # 2. Gather current state information.\n  # -------------------------------------------------------------------------\n  state = env._current_state            # CraftState instance\n  grid = state.grid                      # (W, H, n_kinds)\n  pos = tuple(state.pos)                 # (row, col)\n\n  actions_plan = []\n\n  # -------------------------------------------------------------------------\n  # 3. Collect each required primitive.\n  # -------------------------------------------------------------------------\n  for kind, cnt in primitive_needs.items():\n      for _ in range(cnt):\n          # locate all cells that currently contain this primitive\n          locations = np.argwhere(grid[:, :, kind] > 0)\n          if locations.size == 0:\n              # primitive not present \u2013 cannot continue\n              return actions_plan\n\n          # pick the nearest location (Manhattan distance)\n          dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n          nearest_idx = np.argmin(dists)\n          target = tuple(locations[nearest_idx])\n\n          # move to the target cell\n          actions_plan.extend(_move_actions(pos, target))\n          pos = target  # update our virtual position\n\n          # use the item (the USE action is always index 4)\n          actions_plan.append(4)\n\n          # simulate the pick\u2011up so subsequent searches see the item removed\n          grid[target[0], target[1], kind] -= 1\n\n  # -------------------------------------------------------------------------\n  # 4. Move to the appropriate workshop and craft the arrow.\n  # -------------------------------------------------------------------------\n  # The workshop name is stored under the special key \"_at\" in the recipe dict.\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      # recipe does not specify a workshop \u2013 assume current cell is fine\n      actions_plan.append(4)  # just use to attempt crafting\n      return actions_plan\n\n  workshop_idx = cookbook.index.get(workshop_name)\n  if workshop_idx is None:\n      # unknown workshop \u2013 abort\n      return actions_plan\n\n  # locate any workshop cell of that type\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      # no workshop present \u2013 cannot craft\n      return actions_plan\n\n  # choose the nearest workshop\n  dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])\n  nearest_idx = np.argmin(dists)\n  workshop_pos = tuple(workshop_cells[nearest_idx])\n\n  # move to the workshop cell\n  actions_plan.extend(_move_actions(pos, workshop_pos))\n  pos = workshop_pos\n\n  # finally, perform the crafting action\n  actions_plan.append(4)\n\n  return actions_plan", "env_interactions": 0, "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-10-27T16:00:16.453653", "function_name": "make_arrow", "function_body": "  # Action indices (as defined in CraftLab.action_specs)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Helper: Manhattan move actions from src to dst\n  def _move_actions(src, dst):\n      actions = []\n      x, y = src\n      tx, ty = dst\n      dx = tx - x\n      dy = ty - y\n      # move in x direction\n      if dx > 0:\n          actions += [DOWN] * dx\n      elif dx < 0:\n          actions += [UP] * (-dx)\n      # move in y direction\n      if dy > 0:\n          actions += [RIGHT] * dy\n      elif dy < 0:\n          actions += [LEFT] * (-dy)\n      return actions\n\n  # Helper: find nearest cell containing a given kind (returns its coordinates)\n  def _nearest_kind(pos, kind_idx):\n      grid = env._current_state.grid\n      # locate all cells where this kind is present\n      locations = list(zip(*np.where(grid[:, :, kind_idx] > 0)))\n      if not locations:\n          return None\n      # choose the one with minimal Manhattan distance\n      distances = [abs(px - pos[0]) + abs(py - pos[1]) for (px, py) in locations]\n      return locations[int(np.argmin(distances))]\n\n  # ------------------------------------------------------------------\n  # 1. Identify the goal (arrow) and its recipe\n  # ------------------------------------------------------------------\n  world = env.world\n  arrow_idx = world.cookbook.index.index('arrow')\n  # primitive requirements for one arrow\n  primitives_needed = world.cookbook.primitives_for(arrow_idx)\n\n  # ------------------------------------------------------------------\n  # 2. Collect all required primitives\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = env._current_state.pos\n\n  for prim_idx, cnt in primitives_needed.items():\n      for _ in range(cnt):\n          target = _nearest_kind(cur_pos, prim_idx)\n          if target is None:\n              # primitive not present \u2013 cannot continue\n              return actions\n          # move to the primitive cell (or adjacent cell)\n          actions += _move_actions(cur_pos, target)\n          cur_pos = target\n          # pick it up\n          actions.append(USE)\n\n  # ------------------------------------------------------------------\n  # 3. Move to the appropriate workshop and craft the arrow\n  # ------------------------------------------------------------------\n  # the workshop type is stored under the special key \"_at\" in the recipe\n  workshop_name = world.cookbook.recipes[arrow_idx].get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = _nearest_kind(cur_pos, workshop_idx)\n      if workshop_pos is not None:\n          actions += _move_actions(cur_pos, workshop_pos)\n          cur_pos = workshop_pos\n          actions.append(USE)  # craft at the workshop\n\n  return actions", "env_interactions": 22, "island_id": 5, "scores": {"3": 0.2}}
{"timestamp": "2025-10-27T16:00:32.855333", "function_name": "make_arrow", "function_body": "  # Action constants\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def _move_actions(src, dst):\n      \"\"\"Return a list of actions moving Manhattan\u2011wise from src to dst.\"\"\"\n      actions = []\n      x, y = src\n      tx, ty = dst\n      dx = tx - x\n      dy = ty - y\n      if dx > 0:\n          actions += [DOWN] * dx\n      elif dx < 0:\n          actions += [UP] * (-dx)\n      if dy > 0:\n          actions += [RIGHT] * dy\n      elif dy < 0:\n          actions += [LEFT] * (-dy)\n      return actions\n\n  def _nearest_kind(pos, kind_idx):\n      \"\"\"Find the nearest cell (Manhattan distance) that contains kind_idx.\"\"\"\n      grid = env._current_state.grid\n      coords = np.argwhere(grid[:, :, kind_idx] > 0)\n      if coords.size == 0:\n          return None\n      # Compute Manhattan distances\n      dists = np.abs(coords[:, 0] - pos[0]) + np.abs(coords[:, 1] - pos[1])\n      nearest = coords[dists.argmin()]\n      return tuple(nearest.tolist())\n\n  # ------------------------------------------------------------------\n  # 1. Determine what we need to craft an arrow\n  # ------------------------------------------------------------------\n  world = env.world\n  arrow_idx = world.cookbook.index.index('arrow')\n  # Mapping primitive_kind_idx -> count needed for a single arrow\n  primitives_needed = world.cookbook.primitives_for(arrow_idx)\n\n  # ------------------------------------------------------------------\n  # 2. Collect all required primitives\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = env._current_state.pos\n\n  for prim_idx, count in primitives_needed.items():\n      for _ in range(count):\n          target = _nearest_kind(cur_pos, prim_idx)\n          if target is None:\n              # Primitive not found \u2013 abort planning\n              return actions\n          actions += _move_actions(cur_pos, target)\n          cur_pos = target\n          actions.append(USE)   # pick up the primitive\n\n  # ------------------------------------------------------------------\n  # 3. Move to the appropriate workshop and craft the arrow\n  # ------------------------------------------------------------------\n  workshop_name = world.cookbook.recipes[arrow_idx].get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = _nearest_kind(cur_pos, workshop_idx)\n      if workshop_pos is not None:\n          actions += _move_actions(cur_pos, workshop_pos)\n          cur_pos = workshop_pos\n          actions.append(USE)   # craft at the workshop\n\n  return actions", "env_interactions": 22, "island_id": 5, "scores": {"3": 0.2}}
{"timestamp": "2025-10-27T16:00:34.027449", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def _move_actions(src, dst):\n      \"\"\"Return a list of actions moving Manhattan\u2011style from src to dst.\"\"\"\n      actions = []\n      x, y = src\n      tx, ty = dst\n      dx = tx - x\n      dy = ty - y\n      if dx > 0:\n          actions += [DOWN] * dx\n      elif dx < 0:\n          actions += [UP] * (-dx)\n      if dy > 0:\n          actions += [RIGHT] * dy\n      elif dy < 0:\n          actions += [LEFT] * (-dy)\n      return actions\n\n  def _nearest_kind(pos, kind_idx):\n      \"\"\"Find the coordinates of the nearest cell containing kind_idx.\"\"\"\n      grid = env._current_state.grid\n      # locations where this kind is present (any positive count)\n      locations = list(zip(*np.where(grid[:, :, kind_idx] > 0)))\n      if not locations:\n          return None\n      # Manhattan distance to each candidate\n      dists = [abs(px - pos[0]) + abs(py - pos[1]) for (px, py) in locations]\n      return locations[int(np.argmin(dists))]\n\n  # ------------------------------------------------------------------\n  # 1. Identify the goal (arrow) and its primitive requirements\n  # ------------------------------------------------------------------\n  world = env.world\n  arrow_idx = world.cookbook.index.index('arrow')\n  primitives_needed = world.cookbook.primitives_for(arrow_idx)  # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # 2. Collect all required primitives\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = env._current_state.pos\n\n  for prim_idx, count in primitives_needed.items():\n      for _ in range(count):\n          target = _nearest_kind(cur_pos, prim_idx)\n          if target is None:\n              # Primitive missing \u2013 abort early\n              return actions\n          actions += _move_actions(cur_pos, target)\n          cur_pos = target\n          actions.append(USE)   # pick up the primitive\n\n  # ------------------------------------------------------------------\n  # 3. Go to the workshop (if any) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = _nearest_kind(cur_pos, workshop_idx)\n      if workshop_pos is not None:\n          actions += _move_actions(cur_pos, workshop_pos)\n          cur_pos = workshop_pos\n          actions.append(USE)   # craft at the workshop\n\n  return actions", "env_interactions": 22, "island_id": 5, "scores": {"3": 0.2}}
{"timestamp": "2025-10-27T16:01:04.961442", "function_name": "make_arrow", "function_body": "  # -------------------------------------------------------------\n  # Helper functions used inside the make_arrow_vn implementation\n  # -------------------------------------------------------------\n  def _bfs_path(grid, start, goal):\n      \"\"\"Return a list of movement actions (0\u20113) that moves from start to goal.\n      Movement actions are ordered as:\n          0 \u2013 DOWN, 1 \u2013 UP, 2 \u2013 LEFT, 3 \u2013 RIGHT\n      Cells that contain any entity are considered blocked.\n      \"\"\"\n      h, w = grid.shape[:2]\n      # pre\u2011compute blocked cells (any non\u2011zero entry in the kind dimension)\n      blocked = (grid.sum(axis=2) > 0)\n      # start cell is allowed even if it contains the agent\n      blocked[start] = False\n\n      dirs = [(0, 1), (0, -1), (-1, 0), (1, 0)]          # DOWN, UP, LEFT, RIGHT\n      q = collections.deque()\n      q.append((start, []))\n      seen = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for a, (dx, dy) in enumerate(dirs):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:\n                  if (nx, ny) not in seen:\n                      seen.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      # no path found \u2013 return empty list (caller will handle failure)\n      return []\n\n  # -------------------------------------------------------------\n  # Main planning logic\n  # -------------------------------------------------------------\n  # reset the environment and obtain the initial state\n  env.reset()\n  state = env._current_state                     # CraftState after reset\n\n  # index of the goal item \u201carrow\u201d\n  arrow_idx = env.world.cookbook.index.index('arrow')\n\n  # primitive requirements for a single arrow (dict {prim_idx: count})\n  needed_prims = env.world.cookbook.primitives_for(arrow_idx)\n\n  # workshop kind for arrow crafting (the \u201c_at\u201d entry in the recipe)\n  workshop_kind_name = env.world.cookbook.recipes[arrow_idx]['_at']\n  workshop_idx = env.world.cookbook.index.index(workshop_kind_name)\n\n  actions = []                                   # final action list to return\n  max_total_steps = 5000                         # safety guard\n\n  while not state.inventory[arrow_idx] > 0 and len(actions) < max_total_steps:\n      # ---------------------------------------------------------\n      # 1) Make sure we have all required primitives in inventory\n      # ---------------------------------------------------------\n      for prim_idx, req_cnt in needed_prims.items():\n          while state.inventory[prim_idx] < req_cnt:\n              # locate the nearest cell that still holds this primitive\n              prim_layer = state.grid[:, :, prim_idx]\n              positions = np.argwhere(prim_layer > 0)\n              if positions.size == 0:\n                  # no more of this primitive on the map \u2013 give up\n                  return actions\n              # choose the closest one (Manhattan distance)\n              cur_x, cur_y = state.pos\n              dists = np.abs(positions[:, 0] - cur_x) + np.abs(positions[:, 1] - cur_y)\n              target = tuple(positions[dists.argmin()])\n\n              # compute a movement plan to that cell\n              move_plan = _bfs_path(state.grid, state.pos, target)\n              for a in move_plan:\n                  actions.append(a)\n                  reward, state = env.step(a)    # update internal state\n              # now we are on the primitive cell \u2013 pick it up\n              actions.append(4)                  # USE action\n              reward, state = env.step(4)\n\n      # ---------------------------------------------------------\n      # 2) Go to the workshop that can craft an arrow and craft it\n      # ---------------------------------------------------------\n      # locate any workshop cell of the required type\n      workshop_layer = state.grid[:, :, workshop_idx]\n      ws_positions = np.argwhere(workshop_layer > 0)\n      if ws_positions.size == 0:\n          # no workshop on the map \u2013 abort\n          return actions\n      cur_x, cur_y = state.pos\n      dists = np.abs(ws_positions[:, 0] - cur_x) + np.abs(ws_positions[:, 1] - cur_y)\n      workshop_target = tuple(ws_positions[dists.argmin()])\n\n      # move to the workshop\n      move_plan = _bfs_path(state.grid, state.pos, workshop_target)\n      for a in move_plan:\n          actions.append(a)\n          reward, state = env.step(a)\n\n      # craft the arrow\n      actions.append(4)          # USE on the workshop\n      reward, state = env.step(4)\n\n      # loop will exit once the arrow appears in inventory\n\n  return actions", "env_interactions": 0, "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-10-27T16:01:06.135503", "function_name": "make_arrow", "function_body": "  # Reset the environment to obtain the initial state.\n  env.reset()\n  # Access the underlying CraftState.\n  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  # Identify the index for the goal item \"arrow\".\n  arrow_idx = cookbook.index[\"arrow\"]\n\n  # Determine which primitive resources are required for one arrow.\n  primitive_requirements = cookbook.primitives_for(arrow_idx)  # {kind_idx: count}\n\n  # Locate the workshop type required for crafting the arrow.\n  workshop_idx = None\n  recipe = cookbook.recipes[arrow_idx]\n  for key, val in recipe.items():\n      if key == \"_at\":\n          workshop_idx = cookbook.index[val]\n          break\n\n  actions = []\n\n  # Helper: move from current position to a target cell (Manhattan moves) and then USE.\n  def move_to_and_use(cur_pos, target_pos):\n      x, y = cur_pos\n      tx, ty = target_pos\n      # Horizontal moves.\n      while x < tx:\n          actions.append(3)   # RIGHT\n          x += 1\n      while x > tx:\n          actions.append(2)   # LEFT\n          x -= 1\n      # Vertical moves.\n      while y < ty:\n          actions.append(0)   # DOWN\n          y += 1\n      while y > ty:\n          actions.append(1)   # UP\n          y -= 1\n      # Interact with the cell (pick\u2011up or craft).\n      actions.append(4)       # USE\n      return (x, y)\n\n  # Current agent position.\n  cur_pos = state.pos\n\n  # Collect each required primitive the needed number of times.\n  for kind_idx, needed in primitive_requirements.items():\n      # Find all cells that contain this primitive.\n      locations = np.argwhere(state.grid[:, :, kind_idx] > 0)\n      if len(locations) == 0:\n          continue  # No such primitive on the map; skip.\n      # Repeatedly go to distinct locations (wrap around if fewer cells than needed).\n      for i in range(needed):\n          target = tuple(locations[i % len(locations)])\n          cur_pos = move_to_and_use(cur_pos, target)\n\n  # Finally, go to the appropriate workshop and craft the arrow.\n  if workshop_idx is not None:\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if len(workshop_cells) > 0:\n          cur_pos = move_to_and_use(cur_pos, tuple(workshop_cells[0]))\n          # One additional USE to trigger the crafting action.\n          actions.append(4)\n\n  return actions", "env_interactions": 25, "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T16:01:22.089862", "function_name": "make_arrow", "function_body": "  # Action indices\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  world = env.world\n  # Index of the target item (\"arrow\")\n  arrow_idx = world.cookbook.index.index('arrow')\n  # Primitive requirements for a single arrow\n  primitives_needed = world.cookbook.primitives_for(arrow_idx)\n\n  # ------------------------------------------------------------------\n  # Helper functions\n  # ------------------------------------------------------------------\n  def _move_actions(src, dst):\n      \"\"\"Return a list of actions that move Manhattan\u2011wise from src to dst.\"\"\"\n      actions = []\n      x, y = src\n      tx, ty = dst\n      dx = tx - x\n      dy = ty - y\n      if dx > 0:\n          actions += [DOWN] * dx\n      elif dx < 0:\n          actions += [UP] * (-dx)\n      if dy > 0:\n          actions += [RIGHT] * dy\n      elif dy < 0:\n          actions += [LEFT] * (-dy)\n      return actions\n\n  def _nearest_kind(pos, kind_idx):\n      \"\"\"Find the nearest cell (Manhattan distance) that contains kind_idx.\"\"\"\n      grid = env._current_state.grid\n      coords = np.argwhere(grid[:, :, kind_idx] > 0)\n      if coords.size == 0:\n          return None\n      dists = np.abs(coords[:, 0] - pos[0]) + np.abs(coords[:, 1] - pos[1])\n      nearest = coords[dists.argmin()]\n      return tuple(nearest.tolist())\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = env._current_state.pos\n\n  for prim_idx, count in primitives_needed.items():\n      for _ in range(count):\n          target = _nearest_kind(cur_pos, prim_idx)\n          if target is None:\n              # Required primitive not found \u2013 abort planning\n              return actions\n          actions += _move_actions(cur_pos, target)\n          cur_pos = target\n          actions.append(USE)   # pick up the primitive\n\n  # ------------------------------------------------------------------\n  # 2. Move to the workshop (if any) and craft the arrow\n  # ------------------------------------------------------------------\n  workshop_name = world.cookbook.recipes[arrow_idx].get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = _nearest_kind(cur_pos, workshop_idx)\n      if workshop_pos is not None:\n          actions += _move_actions(cur_pos, workshop_pos)\n          cur_pos = workshop_pos\n          actions.append(USE)   # craft at the workshop\n\n  return actions", "env_interactions": 22, "island_id": 5, "scores": {"3": 0.2}}
{"timestamp": "2025-10-27T16:01:23.269698", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def _move_actions(src, dst):\n      \"\"\"Return a list of actions moving Manhattan\u2011wise from src to dst.\"\"\"\n      actions = []\n      x, y = src\n      tx, ty = dst\n      dx = tx - x\n      dy = ty - y\n      if dx > 0:\n          actions += [DOWN] * dx\n      elif dx < 0:\n          actions += [UP] * (-dx)\n      if dy > 0:\n          actions += [RIGHT] * dy\n      elif dy < 0:\n          actions += [LEFT] * (-dy)\n      return actions\n\n  def _nearest_kind(pos, kind_idx):\n      \"\"\"Find the nearest cell (Manhattan distance) that contains kind_idx.\"\"\"\n      grid = env._current_state.grid\n      coords = np.argwhere(grid[:, :, kind_idx] > 0)\n      if coords.size == 0:\n          return None\n      dists = np.abs(coords[:, 0] - pos[0]) + np.abs(coords[:, 1] - pos[1])\n      nearest = coords[dists.argmin()]\n      return tuple(nearest.tolist())\n\n  # ------------------------------------------------------------------\n  # 1. Determine required primitives for an arrow\n  # ------------------------------------------------------------------\n  world = env.world\n  arrow_idx = world.cookbook.index.index('arrow')\n  primitives_needed = world.cookbook.primitives_for(arrow_idx)  # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # 2. Collect required primitives\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = env._current_state.pos\n\n  for prim_idx, count in primitives_needed.items():\n      for _ in range(count):\n          target = _nearest_kind(cur_pos, prim_idx)\n          if target is None:\n              # Primitive not present in the current grid; stop planning\n              return actions\n          actions += _move_actions(cur_pos, target)\n          cur_pos = target\n          actions.append(USE)   # pick up the primitive\n\n  # ------------------------------------------------------------------\n  # 3. Move to the workshop (if any) and craft the arrow\n  # ------------------------------------------------------------------\n  workshop_name = world.cookbook.recipes[arrow_idx].get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = _nearest_kind(cur_pos, workshop_idx)\n      if workshop_pos is not None:\n          actions += _move_actions(cur_pos, workshop_pos)\n          cur_pos = workshop_pos\n          actions.append(USE)   # craft at the workshop\n\n  return actions", "env_interactions": 22, "island_id": 5, "scores": {"3": 0.2}}
