{"timestamp": "2025-10-27T19:03:33.923422", "function_name": "make_arrow", "function_body": "  # Reset environment and obtain references to the underlying world objects.\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.scenario.world          # CraftWorld\n  cookbook = world.cookbook           # Cookbook\n  index = cookbook.index               # name \u2194 integer id mapping\n\n  # Action identifiers (match CraftLab.action_specs())\n  spec = env.action_specs()\n  DOWN = spec.get('DOWN', 0)\n  UP = spec.get('UP', 1)\n  LEFT = spec.get('LEFT', 2)\n  RIGHT = spec.get('RIGHT', 3)\n  USE = spec.get('USE', 4)\n\n  # ------------------------------------------------------------------\n  # Identify the target item (arrow) and the primitive ingredients required.\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  if goal_name not in index.contents:\n      return []                       # no such goal in this world\n\n  goal_idx = index[goal_name]          # integer id for the arrow\n  primitive_needs = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n  actions = []                         # final action sequence\n\n  # ------------------------------------------------------------------\n  # Helper: Bread\u2011first search returning a list of move actions from start to target.\n  # The target cell may be occupied (primitive or workshop); all other cells\n  # must be empty (i.e. no entity of any kind present).\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  def _bfs_path(start, target):\n      \"\"\"Return a list of move actions (DOWN/UP/LEFT/RIGHT) to reach target.\"\"\"\n      if start == target:\n          return []\n\n      h, w = state.grid.shape[:2]\n      queue = deque([start])\n      visited = {start}\n      parent = {}\n\n      moves = [(DOWN, (1, 0)),\n               (UP,   (-1, 0)),\n               (LEFT, (0, -1)),\n               (RIGHT,(0, 1))]\n\n      while queue:\n          cur = queue.popleft()\n          if cur == target:\n              break\n          for act, (dr, dc) in moves:\n              nr, nc = cur[0] + dr, cur[1] + dc\n              if not (0 <= nr < h and 0 <= nc < w):\n                  continue\n              nxt = (nr, nc)\n              # Allow stepping onto the target even if occupied.\n              if nxt != target and state.grid[nr, nc, :].sum() != 0:\n                  continue\n              if nxt in visited:\n                  continue\n              visited.add(nxt)\n              parent[nxt] = (cur, act)\n              queue.append(nxt)\n\n      if target not in parent and start != target:\n          return []          # no path found\n\n      # Reconstruct path.\n      path = []\n      cur = target\n      while cur != start:\n          prev, act = parent[cur]\n          path.append(act)\n          cur = prev\n      path.reverse()\n      return path\n\n  # ------------------------------------------------------------------\n  # 1. Collect each required primitive the needed number of times.\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          # Find any cell currently holding this primitive.\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # Primitive missing \u2013 abort early.\n              return actions\n          tr, tc = prim_cells[0]\n\n          # Move to the primitive cell.\n          move_seq = _bfs_path(state.pos, (tr, tc))\n          actions.extend(move_seq)\n          state.pos = (tr, tc)\n\n          # Pick it up.\n          actions.append(USE)\n\n          # Update internal copy of the state.\n          state.inventory[prim_idx] += 1\n          state.grid[tr, tc, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 2. Go to the appropriate workshop and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      return actions                     # no workshop information\n\n  workshop_idx = index[workshop_name]\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      return actions                     # workshop not present\n\n  wr, wc = workshop_cells[0]\n\n  # Move to the workshop cell.\n  move_seq = _bfs_path(state.pos, (wr, wc))\n  actions.extend(move_seq)\n  state.pos = (wr, wc)\n\n  # Craft the arrow.\n  actions.append(USE)\n\n  return actions", "env_interactions": 28, "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T19:03:56.842742", "function_name": "make_arrow", "function_body": "  # Reset environment and obtain initial references\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n\n  # Goal item index\n  goal_idx = env.task.goal\n\n  # Action indices from the environment specifications\n  act_map = env.action_specs()\n  ACTION_DOWN = act_map[\"DOWN\"]\n  ACTION_UP = act_map[\"UP\"]\n  ACTION_LEFT = act_map[\"LEFT\"]\n  ACTION_RIGHT = act_map[\"RIGHT\"]\n  ACTION_USE = act_map[\"USE\"]\n\n  # Direction vectors paired with their corresponding actions\n  move_dirs = [\n      (1, 0, ACTION_DOWN),   # down\n      (-1, 0, ACTION_UP),    # up\n      (0, -1, ACTION_LEFT),  # left\n      (0, 1, ACTION_RIGHT)   # right\n  ]\n\n  actions = []\n\n  import collections\n  import numpy as np\n\n  def find_path(cur_state, target_kind):\n      \"\"\"\n      Breadth\u2011first search that returns a list of movement actions\n      leading from the agent's current position to any cell containing\n      `target_kind`. Cells occupied by other entities are treated as\n      obstacles, except the target cell itself.\n      \"\"\"\n      grid = cur_state.grid\n      H, W, _ = grid.shape\n      start = cur_state.pos\n      visited = {start}\n      q = collections.deque([(start, [])])\n\n      while q:\n          (x, y), path = q.popleft()\n          if grid[x, y, target_kind] > 0:\n              return path\n          for dx, dy, act in move_dirs:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < H and 0 <= ny < W):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              occupied = np.any(grid[nx, ny, :] > 0)\n              # Allow stepping onto the target cell even if occupied\n              if occupied and grid[nx, ny, target_kind] == 0:\n                  continue\n              visited.add((nx, ny))\n              q.append(((nx, ny), path + [act]))\n      # No reachable cell found (should not happen for valid tasks)\n      return []\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitive resources.\n  # ------------------------------------------------------------------\n  required = world.cookbook.primitives_for(goal_idx)   # {primitive_kind: count}\n  for kind_idx, count in required.items():\n      for _ in range(count):\n          # Move to the primitive and pick it up\n          path = find_path(state, kind_idx)\n          for act in path:\n              _, state = state.step(act)\n              actions.append(act)\n          _, state = state.step(ACTION_USE)   # pick up\n          actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # 2) Move to the workshop (if any) and craft the goal item.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      path = find_path(state, workshop_kind)\n      for act in path:\n          _, state = state.step(act)\n          actions.append(act)\n      _, state = state.step(ACTION_USE)   # craft\n      actions.append(ACTION_USE)\n\n  # Return the full action sequence\n  return actions", "env_interactions": 0, "island_id": 4, "scores": {"3": 0.0}}
