{"timestamp": "2025-10-27T18:00:32.183368", "function_name": "make_arrow", "function_body": "  # Reset environment and obtain initial state\n  env.reset()\n  state = env._current_state          # type: CraftState\n  world = env.world\n\n  # Index of the goal item for this task\n  goal_idx = env.task.goal\n\n  # Primitive requirements for one unit of the goal (recursively expanded)\n  needed = world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n\n  # Determine if the goal requires a specific workshop\n  workshop_idx = None\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  if \"_at\" in recipe:\n      workshop_name = recipe[\"_at\"]\n      workshop_idx = world.cookbook.index[workshop_name]\n\n  actions = []\n\n  # ------------------------------------------------------------------ #\n  # Helper utilities\n  # ------------------------------------------------------------------ #\n  def locate(kind):\n      \"\"\"Return list of (x, y) positions where `kind` is present on the grid.\"\"\"\n      inds = np.argwhere(state.grid[:, :, kind] > 0)\n      return [tuple(p) for p in inds]\n\n  def step_action(act):\n      \"\"\"Execute an action, update the local `state`, and return nothing.\"\"\"\n      nonlocal state\n      _, new_state = state.step(act)\n      state = new_state\n\n  def go_to(target):\n      \"\"\"Move (Manhattan) from current position to `target` using the four move actions.\"\"\"\n      while state.pos != target:\n          x, y = state.pos\n          tx, ty = target\n          if x < tx:          # need to move right (increase x)\n              act = 3          # RIGHT\n          elif x > tx:        # need to move left\n              act = 2          # LEFT\n          elif y < ty:        # need to move down (increase y)\n              act = 0          # DOWN\n          else:               # need to move up\n              act = 1          # UP\n          actions.append(act)\n          step_action(act)\n\n  # ------------------------------------------------------------------ #\n  # 1) Collect all required primitives\n  # ------------------------------------------------------------------ #\n  for kind, cnt in needed.items():\n      for _ in range(cnt):\n          positions = locate(kind)\n          if not positions:          # primitive not present \u2013 abort early\n              return actions\n          # pick the nearest occurrence to reduce travel distance\n          target = min(positions,\n                       key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))\n          go_to(target)\n          # pick up the item (USE)\n          actions.append(4)          # USE\n          step_action(4)\n\n  # ------------------------------------------------------------------ #\n  # 2) Go to the required workshop (if any) and craft the goal item\n  # ------------------------------------------------------------------ #\n  if workshop_idx is not None:\n      ws_positions = locate(workshop_idx)\n      if ws_positions:\n          target = min(ws_positions,\n                       key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))\n          go_to(target)\n          actions.append(4)          # USE to craft at the workshop\n          step_action(4)\n\n  return actions", "env_interactions": 0, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T18:00:33.303917", "function_name": "make_arrow", "function_body": "  # Reset environment to start fresh\n  env.reset()\n  state = env._current_state          # type: CraftState\n  world = env.world\n\n  # Goal index (item we need to produce)\n  goal_idx = env.task.goal\n\n  # Primitive requirements for one unit of the goal (recursively expanded)\n  needed = world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n\n  # Determine workshop (if any) required to craft the goal\n  workshop_idx = None\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  if \"_at\" in recipe:\n      workshop_name = recipe[\"_at\"]\n      workshop_idx = world.cookbook.index[workshop_name]\n\n  actions = []\n\n  # ------------------------------------------------------------------ #\n  # Helper utilities\n  # ------------------------------------------------------------------ #\n  WIDTH, HEIGHT = state.grid.shape[:2]\n\n  def locate(kind):\n      \"\"\"Return list of (x, y) positions where `kind` is present on the grid.\"\"\"\n      inds = np.argwhere(state.grid[:, :, kind] > 0)\n      return [tuple(p) for p in inds]\n\n  def step_action(act):\n      \"\"\"Execute an action, update local `state`.\"\"\"\n      nonlocal state\n      _, new_state = state.step(act)\n      state = new_state\n\n  def manhattan(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  # direction mapping for movement actions\n  DIR_MAP = {\n      (0, 1): 0,   # DOWN  (y + 1)\n      (0, -1): 1,  # UP    (y - 1)\n      (-1, 0): 2,  # LEFT  (x - 1)\n      (1, 0): 3,   # RIGHT (x + 1)\n  }\n\n  def bfs(start, goal):\n      \"\"\"Return list of positions from start to goal (inclusive) using 4\u2011way moves.\"\"\"\n      q = collections.deque()\n      q.append(start)\n      came_from = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          x, y = cur\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < WIDTH and 0 <= ny < HEIGHT:\n                  # cell must be empty to step onto\n                  if state.grid[nx, ny, :].sum() == 0 and (nx, ny) not in came_from:\n                      came_from[(nx, ny)] = cur\n                      q.append((nx, ny))\n      if goal not in came_from:\n          return None\n      # reconstruct path\n      path = []\n      cur = goal\n      while cur is not None:\n          path.append(cur)\n          cur = came_from[cur]\n      path.reverse()\n      return path\n\n  def move_along(path):\n      \"\"\"Convert a path (list of positions) to actions, updating state.\"\"\"\n      for prev, nxt in zip(path, path[1:]):\n          dx = nxt[0] - prev[0]\n          dy = nxt[1] - prev[1]\n          act = DIR_MAP[(dx, dy)]\n          actions.append(act)\n          step_action(act)\n\n  def go_adjacent_to(target_pos):\n      \"\"\"\n      Move to an empty cell adjacent to `target_pos`.\n      Returns the adjacent cell chosen (or None if impossible).\n      \"\"\"\n      tx, ty = target_pos\n      # candidate adjacent cells (must be inside grid and empty)\n      candidates = []\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          cx, cy = tx + dx, ty + dy\n          if 0 <= cx < WIDTH and 0 <= cy < HEIGHT:\n              if state.grid[cx, cy, :].sum() == 0:\n                  candidates.append((cx, cy))\n      if not candidates:\n          return None\n      # pick candidate with minimal Manhattan distance from current position\n      adj = min(candidates, key=lambda p: manhattan(state.pos, p))\n      path = bfs(state.pos, adj)\n      if path is None:\n          return None\n      move_along(path)\n      return adj\n\n  def face_and_use(target_pos):\n      \"\"\"Turn towards `target_pos` (by issuing a move action) and USE.\"\"\"\n      ax, ay = state.pos\n      tx, ty = target_pos\n      dx, dy = tx - ax, ty - ay\n      # one of dx, dy should be 0 and the other +/-1\n      if (dx, dy) not in DIR_MAP:\n          # not directly adjacent \u2013 should not happen\n          return\n      turn_act = DIR_MAP[(dx, dy)]\n      actions.append(turn_act)\n      step_action(turn_act)   # may stay in place but updates direction\n      actions.append(4)       # USE\n      step_action(4)\n\n  # ------------------------------------------------------------------ #\n  # 1) Collect all required primitives\n  # ------------------------------------------------------------------ #\n  for kind, cnt in needed.items():\n      for _ in range(cnt):\n          positions = locate(kind)\n          if not positions:\n              # primitive missing \u2013 abort early\n              return actions\n          # choose the nearest occurrence\n          target = min(positions, key=lambda p: manhattan(state.pos, p))\n          adj = go_adjacent_to(target)\n          if adj is None:\n              # cannot reach \u2013 abort\n              return actions\n          face_and_use(target)\n\n  # ------------------------------------------------------------------ #\n  # 2) Go to required workshop (if any) and craft the goal item\n  # ------------------------------------------------------------------ #\n  if workshop_idx is not None:\n      ws_positions = locate(workshop_idx)\n      if ws_positions:\n          target = min(ws_positions, key=lambda p: manhattan(state.pos, p))\n          adj = go_adjacent_to(target)\n          if adj is not None:\n              face_and_use(target)\n\n  return actions", "env_interactions": 0, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T18:01:02.410004", "function_name": "make_arrow", "function_body": "  # Reset environment and obtain the initial state and world objects.\n  env.reset()\n  state = env._current_state          # type: CraftState\n  world = env.world\n\n  # Index of the goal item for this episode.\n  goal_idx = env.task.goal\n\n  # Primitive requirements for the goal (kind index -> required count).\n  needed = world.cookbook.primitives_for(goal_idx)\n\n  # Determine the workshop (if any) where the goal must be crafted.\n  workshop_idx = None\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  ws_name = recipe.get('_at')\n  if ws_name is not None:\n      workshop_idx = world.cookbook.index[ws_name]\n\n  # ------------------------------------------------------------------\n  # Helper utilities.\n  # ------------------------------------------------------------------\n  import numpy as np\n  from collections import deque\n\n  def locate(kind):\n      \"\"\"Return a list of (x, y) positions where `kind` is present on the grid.\"\"\"\n      inds = np.argwhere(state.grid[:, :, kind] > 0)\n      return [tuple(p) for p in inds]\n\n  def bfs_actions(start, target):\n      \"\"\"\n      Return a list of actions (0\u2011DOWN,1\u2011UP,2\u2011LEFT,3\u2011RIGHT) that moves the agent\n      from `start` to `target`. All occupied cells are avoided except the target\n      cell itself, which may be occupied (e.g., a primitive to pick up).\n      \"\"\"\n      occupied = np.any(state.grid > 0, axis=2)\n      w, h = occupied.shape\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          pos, path = q.popleft()\n          if pos == target:\n              return path\n          x, y = pos\n          for act, (dx, dy) in ((0, (0, 1)), (1, (0, -1)),\n                                (2, (-1, 0)), (3, (1, 0))):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h:\n                  # Allow stepping onto the target even if it is occupied.\n                  if (nx, ny) != target and occupied[nx, ny]:\n                      continue\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [act]))\n      # No path found \u2013 return empty list.\n      return []\n\n  def go_to(target):\n      \"\"\"Move the agent to `target`, recording actions and updating `state`.\"\"\"\n      nonlocal state\n      for act in bfs_actions(state.pos, target):\n          actions.append(act)\n          _, state = state.step(act)\n\n  # ------------------------------------------------------------------\n  # Build the action sequence.\n  # ------------------------------------------------------------------\n  actions = []\n\n  # 1. Collect all required primitives.\n  for kind, req_cnt in needed.items():\n      while state.inventory[kind] < req_cnt:\n          positions = locate(kind)\n          if not positions:\n              # Primitive not found; abort early.\n              return actions\n          # Choose the nearest occurrence (Manhattan distance).\n          target = min(\n              positions,\n              key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1])\n          )\n          go_to(target)\n          # Pick up the primitive.\n          actions.append(4)          # USE\n          _, state = state.step(4)\n\n  # 2. If a workshop is required, go there and craft the goal item.\n  if workshop_idx is not None:\n      ws_positions = locate(workshop_idx)\n      if ws_positions:\n          target_ws = min(\n              ws_positions,\n              key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1])\n          )\n          go_to(target_ws)\n          actions.append(4)          # USE to trigger crafting\n          _, state = state.step(4)\n\n  # Return the compiled list of actions.\n  return actions", "env_interactions": 0, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T18:01:03.547911", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ------------------------------------------------------------------\n  # Initialise environment and retrieve relevant information.\n  # ------------------------------------------------------------------\n  env.reset()\n  state = env._current_state          # type: CraftState\n  world = env.world\n\n  goal_idx = env.task.goal\n  needed = world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n\n  # Determine required workshop (if any) from the recipe.\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  ws_name = recipe.get('_at')\n  if ws_name is not None:\n      workshop_idx = world.cookbook.index[ws_name]\n\n  actions = []   # final sequence of action indices to return\n\n  # ------------------------------------------------------------------\n  # Helper utilities.\n  # ------------------------------------------------------------------\n  def locate(kind):\n      \"\"\"Return a list of (x, y) positions where `kind` exists on the grid.\"\"\"\n      inds = np.argwhere(state.grid[:, :, kind] > 0)\n      return [tuple(p) for p in inds]\n\n  def step_action(act):\n      \"\"\"Execute a single action, updating the local `state`.\"\"\"\n      nonlocal state\n      _, new_state = state.step(act)\n      state = new_state\n\n  def bfs_actions(start, target):\n      \"\"\"\n      Bread\u2011first search returning a list of movement actions (0\u2011DOWN,1\u2011UP,\n      2\u2011LEFT,3\u2011RIGHT) that moves from `start` to `target`. All cells occupied\n      by any entity are considered blocked, except the `target` cell itself.\n      \"\"\"\n      occ = np.any(state.grid > 0, axis=2)          # True where something exists\n      w, h = occ.shape\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          pos, path = q.popleft()\n          if pos == target:\n              return path\n          x, y = pos\n          for act, (dx, dy) in ((0, (0, 1)), (1, (0, -1)),\n                                (2, (-1, 0)), (3, (1, 0))):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h:\n                  # Allow moving onto the target even if occupied.\n                  if (nx, ny) != target and occ[nx, ny]:\n                      continue\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [act]))\n      # No path found.\n      return []\n\n  def go_to(target):\n      \"\"\"Move the agent from its current position to `target`.\"\"\"\n      for act in bfs_actions(state.pos, target):\n          actions.append(act)\n          step_action(act)\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitive resources.\n  # ------------------------------------------------------------------\n  for kind, required_cnt in needed.items():\n      while state.inventory[kind] < required_cnt:\n          positions = locate(kind)\n          if not positions:\n              # Primitive not present anywhere \u2013 abort early.\n              return actions\n          # Choose the nearest occurrence (Manhattan distance).\n          target = min(positions,\n                       key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))\n          go_to(target)\n          # Pick up the primitive.\n          actions.append(4)          # USE action\n          step_action(4)\n\n  # ------------------------------------------------------------------\n  # 2) Go to the required workshop (if any) and craft the goal item.\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_positions = locate(workshop_idx)\n      if ws_positions:\n          target_ws = min(ws_positions,\n                          key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))\n          go_to(target_ws)\n          actions.append(4)          # USE to trigger crafting\n          step_action(4)\n\n  # Return the compiled action list.\n  return actions", "env_interactions": 0, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T18:01:18.787618", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Reset environment and obtain the initial state.\n  env.reset()\n  state = env._current_state          # type: CraftState\n  world = env.world\n\n  # Goal index for the current task.\n  goal_idx = env.task.goal\n\n  # Determine primitive requirements for the goal.\n  needed = world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n\n  # Identify workshop (if any) where the goal must be crafted.\n  workshop_idx = None\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n\n  # ------------------------------------------------------------------\n  # Helper utilities.\n  # ------------------------------------------------------------------\n  def locate(kind):\n      \"\"\"Return list of (x, y) positions where `kind` is present.\"\"\"\n      inds = np.argwhere(state.grid[:, :, kind] > 0)\n      return [tuple(p) for p in inds]\n\n  def bfs_path(start, target):\n      \"\"\"Return a list of actions (0\u2011DOWN,1\u2011UP,2\u2011LEFT,3\u2011RIGHT) moving from start to target,\n      avoiding occupied cells (except the target cell).\"\"\"\n      occ = np.any(state.grid > 0, axis=2)          # blocked cells\n      occ[target] = False                           # allow stepping onto target\n      w, h = occ.shape\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          pos, path = q.popleft()\n          if pos == target:\n              return path\n          x, y = pos\n          for act, (dx, dy) in ((0, (0, 1)), (1, (0, -1)),\n                                (2, (-1, 0)), (3, (1, 0))):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and not occ[nx, ny] and (nx, ny) not in visited:\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [act]))\n      return []  # no path\n\n  def go_to(target):\n      \"\"\"Move agent from current position to `target`, recording actions.\"\"\"\n      nonlocal state\n      for act in bfs_path(state.pos, target):\n          actions.append(act)\n          _, state = state.step(act)\n\n  # ------------------------------------------------------------------\n  # Build action sequence.\n  # ------------------------------------------------------------------\n  actions = []\n\n  # 1. Collect all required primitives.\n  for kind, cnt in needed.items():\n      for _ in range(cnt):\n          positions = locate(kind)\n          if not positions:\n              # Primitive missing; abort early.\n              return actions\n          # Choose the nearest reachable primitive.\n          positions.sort(key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))\n          for target in positions:\n              path = bfs_path(state.pos, target)\n              if path:\n                  go_to(target)\n                  actions.append(4)          # USE to pick up\n                  _, state = state.step(4)\n                  break\n          else:\n              # No reachable instance of this primitive.\n              return actions\n\n  # 2. Go to workshop (if required) and craft the goal.\n  if workshop_idx is not None:\n      ws_positions = locate(workshop_idx)\n      if not ws_positions:\n          # No workshop found; abort.\n          return actions\n      ws_positions.sort(key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))\n      go_to(ws_positions[0])\n  # Craft / use at current location.\n  actions.append(4)          # USE to trigger crafting\n  _, state = state.step(4)\n\n  return actions", "env_interactions": 1, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T18:01:19.909350", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Initialise the episode.\n  env.reset()\n  state = env._current_state          # type: CraftState\n  world = env.world\n\n  goal_idx = env.task.goal\n\n  # Primitive requirements for the goal.\n  needed = world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n\n  # Determine the workshop (if any) where the goal must be crafted.\n  workshop_idx = None\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n\n  # ------------------------------------------------------------------\n  # Helper utilities.\n  # ------------------------------------------------------------------\n  def locate(kind):\n      \"\"\"Return a list of (x, y) positions where `kind` occurs in the grid.\"\"\"\n      inds = np.argwhere(state.grid[:, :, kind] > 0)\n      return [tuple(p) for p in inds]\n\n  def bfs_path(start, target):\n      \"\"\"Return a list of actions (0\u2011DOWN,1\u2011UP,2\u2011LEFT,3\u2011RIGHT) moving from start to target,\n      avoiding occupied cells. The target cell may be occupied (contains the item).\"\"\"\n      occ = np.any(state.grid > 0, axis=2)          # blocked cells\n      # allow stepping onto the target even if occupied\n      occ[target] = False\n      w, h = occ.shape\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          pos, path = q.popleft()\n          if pos == target:\n              return path\n          x, y = pos\n          for act, (dx, dy) in ((0, (0, 1)), (1, (0, -1)), (2, (-1, 0)), (3, (1, 0))):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and not occ[nx, ny] and (nx, ny) not in visited:\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [act]))\n      return []  # no path found\n\n  def go_to(target):\n      \"\"\"Move the agent to `target`, recording the actions taken.\"\"\"\n      nonlocal state\n      for act in bfs_path(state.pos, target):\n          actions.append(act)\n          _, state = state.step(act)\n\n  # ------------------------------------------------------------------\n  # Build the action sequence.\n  # ------------------------------------------------------------------\n  actions = []\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives.\n  # ------------------------------------------------------------------\n  for kind, cnt in needed.items():\n      for _ in range(cnt):\n          positions = locate(kind)\n          if not positions:\n              # Primitive absent \u2013 abort early.\n              return actions\n          # Sort by Manhattan distance to current position.\n          positions.sort(key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))\n          # Find the first reachable instance.\n          for target in positions:\n              if bfs_path(state.pos, target):\n                  go_to(target)\n                  actions.append(4)          # USE to pick up\n                  _, state = state.step(4)\n                  break\n          else:\n              # No reachable instance of this primitive.\n              return actions\n\n  # ------------------------------------------------------------------\n  # 2. Move to the workshop (if required) and craft the goal.\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_positions = locate(workshop_idx)\n      if ws_positions:\n          ws_positions.sort(key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))\n          go_to(ws_positions[0])\n          actions.append(4)          # USE to craft\n          _, state = state.step(4)\n  else:\n      # No specific workshop \u2013 attempt to craft at current location.\n      actions.append(4)\n      _, state = state.step(4)\n\n  return actions", "env_interactions": 1, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T18:01:38.100228", "function_name": "make_arrow", "function_body": "  # Reset environment and fetch useful references\n  env.reset()\n  world = env.world\n  scenario = env.scenario\n  state = env._current_state\n\n  # Goal index for the arrow (or whatever item the task requires)\n  goal_idx = env.task.goal\n\n  # Primitive ingredients required for the goal (kind_index -> count)\n  required = world.cookbook.primitives_for(goal_idx)\n\n  # Determine if the recipe requires a specific workshop\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  wk = recipe.get('_at')\n  workshop_kind = None\n  if wk is not None:\n      workshop_kind = wk if isinstance(wk, int) else world.cookbook.index[wk]\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # ------------------------------------------------------------------\n  # Helper: Manhattan moves from start to target (ignores obstacles)\n  # Action IDs: DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n  # ------------------------------------------------------------------\n  def moves_to(start, target):\n      x, y = start\n      tx, ty = target\n      seq = []\n      while x < tx:\n          seq.append(3)   # RIGHT\n          x += 1\n      while x > tx:\n          seq.append(2)   # LEFT\n          x -= 1\n      while y < ty:\n          seq.append(0)   # DOWN\n          y += 1\n      while y > ty:\n          seq.append(1)   # UP\n          y -= 1\n      return seq, (x, y)\n\n  # ------------------------------------------------------------------\n  # Helper: locate the nearest cell containing at least one entity of `kind`\n  # Returns (row, col) tuple or None if not found.\n  # ------------------------------------------------------------------\n  def nearest_cell(kind, from_pos):\n      cells = np.argwhere(scenario.init_grid[:, :, kind] > 0)\n      if cells.size == 0:\n          return None\n      dists = np.abs(cells[:, 0] - from_pos[0]) + np.abs(cells[:, 1] - from_pos[1])\n      idx = dists.argmin()\n      return tuple(cells[idx])\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the necessary number of times\n  # ------------------------------------------------------------------\n  for kind, cnt in required.items():\n      for _ in range(cnt):\n          target = nearest_cell(kind, cur_pos)\n          if target is None:\n              # Primitive missing from the map; skip collection.\n              continue\n          move_seq, cur_pos = moves_to(cur_pos, target)\n          actions.extend(move_seq)\n          actions.append(4)   # USE to pick up the primitive\n\n  # ------------------------------------------------------------------\n  # Move to the workshop (if any) and perform final crafting\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      target = nearest_cell(workshop_kind, cur_pos)\n      if target is not None:\n          move_seq, cur_pos = moves_to(cur_pos, target)\n          actions.extend(move_seq)\n  # Final USE to craft the goal at the current location (or wherever the\n  # workshop was, if applicable).\n  actions.append(4)\n\n  return actions", "env_interactions": 1, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T18:01:39.217887", "function_name": "make_arrow", "function_body": "  env.reset()\n  world = env.world\n  scenario = env.scenario\n  state = env._current_state\n\n  # Goal index (arrow)\n  goal_idx = env.task.goal\n\n  # Primitive requirements for the goal (primitive_kind -> count)\n  required = world.cookbook.primitives_for(goal_idx)\n\n  # Determine workshop (if any) needed for final crafting\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else world.cookbook.index[wk]\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # ------------------------------------------------------------------\n  # Helper: Manhattan moves from start to target (returns seq, new_pos)\n  # ------------------------------------------------------------------\n  def moves_to(start, target):\n      x, y = start\n      tx, ty = target\n      seq = []\n      while x < tx:\n          seq.append(3)   # RIGHT\n          x += 1\n      while x > tx:\n          seq.append(2)   # LEFT\n          x -= 1\n      while y < ty:\n          seq.append(0)   # DOWN\n          y += 1\n      while y > ty:\n          seq.append(1)   # UP\n          y -= 1\n      return seq, (x, y)\n\n  # ------------------------------------------------------------------\n  # Helper: find nearest cell containing at least one entity of `kind`\n  # ------------------------------------------------------------------\n  def nearest_cell(kind, from_pos):\n      cells = np.argwhere(scenario.init_grid[:, :, kind] > 0)\n      if cells.size == 0:\n          return None\n      dists = np.abs(cells[:, 0] - from_pos[0]) + np.abs(cells[:, 1] - from_pos[1])\n      idx = dists.argmin()\n      return tuple(cells[idx])\n\n  # ------------------------------------------------------------------\n  # Collect required primitives\n  # ------------------------------------------------------------------\n  for kind, cnt in required.items():\n      for _ in range(cnt):\n          target = nearest_cell(kind, cur_pos)\n          if target is None:\n              # Primitive not present on the map; skip\n              continue\n          move_seq, cur_pos = moves_to(cur_pos, target)\n          actions.extend(move_seq)\n          actions.append(4)   # USE to pick up the primitive\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if needed) and craft the goal\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      target = nearest_cell(workshop_kind, cur_pos)\n      if target is not None:\n          move_seq, cur_pos = moves_to(cur_pos, target)\n          actions.extend(move_seq)\n      actions.append(4)   # USE to craft at workshop\n  else:\n      # No specific workshop; craft anywhere after gathering\n      actions.append(4)\n\n  return actions", "env_interactions": 1, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T18:02:05.869445", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action mapping (matches CraftLab.action_specs)\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # 0:DOWN, 1:UP, 2:LEFT, 3:RIGHT\n  USE = 4\n\n  def bfs_adjacent(start, target, blocked):\n      \"\"\"Find a sequence of movement actions that brings the agent from *start*\n      to any empty cell that is 4\u2011connected to *target*.\n      Returns an empty list if no such path exists.\"\"\"\n      h, w = blocked.shape\n      tx, ty = target\n      goal_cells = []\n      for a, (dx, dy) in enumerate(DIRS):\n          gx, gy = tx + dx, ty + dy\n          if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:\n              goal_cells.append((gx, gy))\n      if not goal_cells:\n          return []\n      q = deque([(start, [])])\n      visited = {start}\n      while q:\n          (cx, cy), path = q.popleft()\n          if (cx, cy) in goal_cells:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []\n\n  # ----------------------------------------------------------------------\n  # Reset / obtain current state\n  # ----------------------------------------------------------------------\n  try:\n      env.reset()\n  except Exception:\n      pass\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []\n\n  world = env.world\n  idx = world.cookbook.index\n\n  # ----------------------------------------------------------------------\n  # Identify arrow goal and its recipe\n  # ----------------------------------------------------------------------\n  try:\n      goal_idx = idx[\"arrow\"]\n  except Exception:\n      return []                     # no arrow defined in the recipe set\n\n  # Primitives required for a single arrow\n  primitives = world.cookbook.primitives_for(goal_idx)\n\n  # Workshop where the arrow must be crafted (stored under \"_at\" or \"_key\")\n  workshop_name = None\n  for k, v in world.cookbook.recipes.get(goal_idx, {}).items():\n      if k in (\"_at\", \"_key\"):\n          workshop_name = v\n          break\n  if workshop_name is None:\n      return []\n  try:\n      workshop_idx = idx[workshop_name]\n  except Exception:\n      return []\n\n  # ----------------------------------------------------------------------\n  # Local mutable copies for planning\n  # ----------------------------------------------------------------------\n  pos = tuple(state.pos)                     # (x, y)\n  grid = state.grid.copy()                   # (W, H, n_kinds)\n  inventory = state.inventory.copy()\n  occupied = np.any(grid > 0, axis=2)        # bool matrix of blocked cells\n\n  plan = []\n\n  # ----------------------------------------------------------------------\n  # Helper: move adjacent to a cell containing *kind_idx* and USE it\n  # ----------------------------------------------------------------------\n  def move_and_use(target, kind_idx):\n      \"\"\"Move adjacent to *target* (which contains *kind_idx*) and issue USE.\n      Updates simulated pos, grid, occupied, inventory.\n      Returns False on failure.\"\"\"\n      nonlocal pos, plan, grid, occupied, inventory\n      path = bfs_adjacent(pos, target, occupied)\n      if not path and pos != target:\n          return False\n      # Execute movement actions in the simulated state\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n      plan.extend(path)\n\n      # Perform the USE action\n      plan.append(USE)\n\n      tx, ty = target\n      if grid[tx, ty, kind_idx] > 0:\n          # Pick up the primitive (or interact with workshop)\n          grid[tx, ty, kind_idx] = 0\n          occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)\n          inventory[kind_idx] += 1\n      return True\n\n  # ----------------------------------------------------------------------\n  # Collect all required primitives\n  # ----------------------------------------------------------------------\n  for prim_idx, cnt in primitives.items():\n      for _ in range(cnt):\n          locations = np.argwhere(grid[:, :, prim_idx] > 0)\n          if locations.size == 0:\n              # No more of this primitive on the map \u2013 abort planning\n              return plan\n          # Choose the nearest instance (Manhattan distance)\n          dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n          target = tuple(locations[dists.argmin()])\n          if not move_and_use(target, prim_idx):\n              return plan\n\n  # ----------------------------------------------------------------------\n  # Move to the workshop and craft the arrow\n  # ----------------------------------------------------------------------\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      # Workshops are static; fall back to the original grid if needed\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          return plan\n  dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])\n  workshop_target = tuple(workshop_cells[dists.argmin()])\n  move_and_use(workshop_target, workshop_idx)\n\n  return plan", "env_interactions": 23, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T18:02:06.994443", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Helpers\n  # ----------------------------------------------------------------------\n  # Action ordering matches CraftLab.action_specs\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # 0:DOWN, 1:UP, 2:LEFT, 3:RIGHT\n  USE = 4\n\n  from collections import deque\n  import numpy as np\n\n  def bfs_adjacent(start, target, blocked):\n      \"\"\"Return a list of movement actions that brings the agent from *start*\n      to any empty cell that is 4\u2011connected to *target*.\n      If unreachable, return empty list.\"\"\"\n      h, w = blocked.shape\n      tx, ty = target\n      goal_cells = []\n      for a, (dx, dy) in enumerate(DIRS):\n          gx, gy = tx + dx, ty + dy\n          if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:\n              goal_cells.append((gx, gy))\n      if not goal_cells:\n          return []\n      q = deque([(start, [])])\n      visited = {start}\n      while q:\n          (cx, cy), path = q.popleft()\n          if (cx, cy) in goal_cells:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []\n\n  # ----------------------------------------------------------------------\n  # Reset / obtain current state\n  # ----------------------------------------------------------------------\n  try:\n      env.reset()\n  except Exception:\n      pass\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []\n\n  world = env.world\n  idx = world.cookbook.index\n\n  # ----------------------------------------------------------------------\n  # Identify arrow goal and its recipe\n  # ----------------------------------------------------------------------\n  try:\n      goal_idx = idx[\"arrow\"]\n  except Exception:\n      return []                     # no arrow defined\n\n  # primitives needed for one arrow\n  primitives = world.cookbook.primitives_for(goal_idx)\n\n  # workshop required for arrow (stored under \"_at\" or \"_key\")\n  workshop_name = None\n  for k, v in world.cookbook.recipes.get(goal_idx, {}).items():\n      if k in (\"_at\", \"_key\"):\n          workshop_name = v\n          break\n  if workshop_name is None:\n      return []\n  try:\n      workshop_idx = idx[workshop_name]\n  except Exception:\n      return []\n\n  # ----------------------------------------------------------------------\n  # Local mutable copies for planning\n  # ----------------------------------------------------------------------\n  pos = tuple(state.pos)                     # (x, y)\n  grid = state.grid.copy()                   # (W, H, n_kinds)\n  inventory = state.inventory.copy()\n  occupied = np.any(grid > 0, axis=2)        # bool matrix of blocked cells\n\n  plan = []\n\n  # ----------------------------------------------------------------------\n  # Helper to move adjacent to a cell and USE it\n  # ----------------------------------------------------------------------\n  def move_and_use(target, kind_idx):\n      \"\"\"Move adjacent to *target* (contains *kind_idx*) and issue USE.\n      Updates simulated pos, grid, occupied, inventory. Returns False on failure.\"\"\"\n      nonlocal pos, plan, grid, occupied, inventory\n      path = bfs_adjacent(pos, target, occupied)\n      if not path and pos != target:\n          return False\n      # execute movement actions in simulation\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n      plan.extend(path)\n\n      # perform USE\n      plan.append(USE)\n\n      tx, ty = target\n      if grid[tx, ty, kind_idx] > 0:\n          # pick up primitive or interact with workshop\n          grid[tx, ty, kind_idx] = 0\n          occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)\n          inventory[kind_idx] += 1\n      return True\n\n  # ----------------------------------------------------------------------\n  # Collect required primitives\n  # ----------------------------------------------------------------------\n  for prim_idx, cnt in primitives.items():\n      for _ in range(cnt):\n          locations = np.argwhere(grid[:, :, prim_idx] > 0)\n          if locations.size == 0:\n              # primitive not present; abort planning\n              return plan\n          # choose nearest by Manhattan distance\n          dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n          target = tuple(locations[dists.argmin()])\n          if not move_and_use(target, prim_idx):\n              return plan\n\n  # ----------------------------------------------------------------------\n  # Go to workshop and craft the arrow\n  # ----------------------------------------------------------------------\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      # workshops are static; fall back to original grid\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          return plan\n  dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])\n  workshop_target = tuple(workshop_cells[dists.argmin()])\n  move_and_use(workshop_target, workshop_idx)\n\n  return plan", "env_interactions": 23, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T18:02:39.162304", "function_name": "make_arrow", "function_body": "  # Reset the environment and obtain handles to the current state and world data.\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.scenario.world          # CraftWorld\n  cookbook = world.cookbook           # Cookbook\n  idx = cookbook.index                # name \u2194 integer id mapping\n\n  # Action identifiers (consistent with CraftLab.action_specs()).\n  action_map = env.action_specs()\n  DOWN = action_map[\"DOWN\"]\n  UP = action_map[\"UP\"]\n  LEFT = action_map[\"LEFT\"]\n  RIGHT = action_map[\"RIGHT\"]\n  USE = action_map[\"USE\"]\n  moves = [(DOWN, (1, 0)), (UP, (-1, 0)), (LEFT, (0, -1)), (RIGHT, (0, 1))]\n\n  # ------------------------------------------------------------------\n  # Helper: BFS shortest path from start to target (target may be occupied).\n  # Returns a list of action indices.\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  def _bfs_path(start, target):\n      if start == target:\n          return []\n      h, w = state.grid.shape[:2]\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          for act, (dr, dc) in moves:\n              nr, nc = cur[0] + dr, cur[1] + dc\n              if not (0 <= nr < h and 0 <= nc < w):\n                  continue\n              nxt = (nr, nc)\n              if nxt in visited:\n                  continue\n              occupied = state.grid[nr, nc, :].any()\n              # allow stepping onto the target even if occupied\n              if occupied and nxt != target:\n                  continue\n              visited.add(nxt)\n              parent[nxt] = (cur, act)\n              q.append(nxt)\n      if target not in parent and start != target:\n          return []  # no path found\n      # reconstruct action list\n      path = []\n      cur = target\n      while cur != start:\n          prev, act = parent[cur]\n          path.append(act)\n          cur = prev\n      path.reverse()\n      return path\n\n  # ------------------------------------------------------------------\n  # Helper: find the nearest cell containing a given kind (primitive or workshop).\n  # Returns (action_path, cell_coords) or ([], None) if not found.\n  # ------------------------------------------------------------------\n  def _nearest_kind(kind_idx, start):\n      if state.grid[start[0], start[1], kind_idx] > 0:\n          return [], start\n      h, w = state.grid.shape[:2]\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          cur = q.popleft()\n          for act, (dr, dc) in moves:\n              nr, nc = cur[0] + dr, cur[1] + dc\n              if not (0 <= nr < h and 0 <= nc < w):\n                  continue\n              nxt = (nr, nc)\n              if nxt in visited:\n                  continue\n              occupied = state.grid[nr, nc, :].any()\n              # we may step onto a cell that holds the target kind\n              if occupied and state.grid[nr, nc, kind_idx] == 0:\n                  continue\n              visited.add(nxt)\n              parent[nxt] = (cur, act)\n              if state.grid[nr, nc, kind_idx] > 0:\n                  # reconstruct path to this cell\n                  path = []\n                  cur2 = nxt\n                  while cur2 != start:\n                      prev2, act2 = parent[cur2]\n                      path.append(act2)\n                      cur2 = prev2\n                  path.reverse()\n                  return path, nxt\n              q.append(nxt)\n      return [], None  # not found\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow) and the primitives required to craft it.\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  if goal_name not in idx.contents:\n      return []  # arrow not defined in this world\n  goal_idx = idx[goal_name]\n\n  primitive_needs = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n  plan = []\n\n  # ------------------------------------------------------------------\n  # 1. Collect each required primitive the necessary number of times.\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          path, cell = _nearest_kind(prim_idx, state.pos)\n          if cell is None:\n              # Primitive missing or unreachable \u2013 abort early.\n              return plan\n          plan.extend(path)\n          state.pos = cell\n          plan.append(USE)  # pick up the primitive\n          # Update simulated state.\n          r, c = cell\n          state.inventory[prim_idx] += 1\n          state.grid[r, c, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 2. Move to the appropriate workshop and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      return plan  # cannot craft without a workshop\n\n  workshop_idx = idx[workshop_name]\n  path, cell = _nearest_kind(workshop_idx, state.pos)\n  if cell is None:\n      return plan  # no reachable workshop\n  plan.extend(path)\n  state.pos = cell\n  plan.append(USE)  # craft the arrow at the workshop\n\n  return plan", "env_interactions": 26, "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T18:02:40.301290", "function_name": "make_arrow", "function_body": "  # Reset environment and obtain references\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.scenario.world          # CraftWorld\n  cookbook = world.cookbook           # Cookbook\n  idx = cookbook.index                # name \u2194 integer id mapping\n\n  # Action indices (consistent with CraftLab.action_specs)\n  action_map = env.action_specs()\n  DOWN = action_map[\"DOWN\"]\n  UP = action_map[\"UP\"]\n  LEFT = action_map[\"LEFT\"]\n  RIGHT = action_map[\"RIGHT\"]\n  USE = action_map[\"USE\"]\n  moves = [(DOWN, (1, 0)), (UP, (-1, 0)), (LEFT, (0, -1)), (RIGHT, (0, 1))]\n\n  from collections import deque\n\n  # ------------------------------------------------------------------\n  # Helper: BFS shortest path (list of actions) from start \u2192 target.\n  # The target cell may be occupied; all intermediate cells must be empty.\n  # ------------------------------------------------------------------\n  def _bfs_path(start, target):\n      if start == target:\n          return []\n      h, w = state.grid.shape[:2]\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          for act, (dr, dc) in moves:\n              nr, nc = cur[0] + dr, cur[1] + dc\n              if not (0 <= nr < h and 0 <= nc < w):\n                  continue\n              nxt = (nr, nc)\n              if nxt in visited:\n                  continue\n              # Disallow stepping on occupied cells unless it is the target\n              if nxt != target and state.grid[nr, nc, :].sum() != 0:\n                  continue\n              visited.add(nxt)\n              parent[nxt] = (cur, act)\n              q.append(nxt)\n      if target not in parent and start != target:\n          return []  # No path found\n      # Reconstruct action list\n      path = []\n      cur = target\n      while cur != start:\n          prev, act = parent[cur]\n          path.append(act)\n          cur = prev\n      path.reverse()\n      return path\n\n  # ------------------------------------------------------------------\n  # Helper: locate the nearest cell containing a given kind.\n  # Returns (action_path, cell_coords) or ([], None) if not found.\n  # ------------------------------------------------------------------\n  def _nearest_cell_of(kind_idx, start):\n      # If already on the desired cell\n      if state.grid[start[0], start[1], kind_idx] > 0:\n          return [], start\n      h, w = state.grid.shape[:2]\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          cur = q.popleft()\n          for act, (dr, dc) in moves:\n              nr, nc = cur[0] + dr, cur[1] + dc\n              if not (0 <= nr < h and 0 <= nc < w):\n                  continue\n              nxt = (nr, nc)\n              if nxt in visited:\n                  continue\n              # Treat occupied cells as blocked unless they hold the target kind\n              if state.grid[nr, nc, :].sum() != 0 and state.grid[nr, nc, kind_idx] == 0:\n                  continue\n              visited.add(nxt)\n              parent[nxt] = (cur, act)\n              if state.grid[nr, nc, kind_idx] > 0:\n                  # Reconstruct path to this cell\n                  path = []\n                  cur2 = nxt\n                  while cur2 != start:\n                      prev2, act2 = parent[cur2]\n                      path.append(act2)\n                      cur2 = prev2\n                  path.reverse()\n                  return path, nxt\n              q.append(nxt)\n      return [], None\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow) and its primitive requirements.\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  if goal_name not in idx.contents:\n      return []  # Arrow not defined in this world\n  goal_idx = idx[goal_name]\n\n  primitive_requirements = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n  actions = []\n\n  # ------------------------------------------------------------------\n  # 1. Collect each required primitive the needed number of times.\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_requirements.items():\n      for _ in range(needed_cnt):\n          path, cell = _nearest_cell_of(prim_idx, state.pos)\n          if cell is None:\n              # Primitive missing / unreachable; abort early.\n              return actions\n          actions.extend(path)\n          state.pos = cell\n          actions.append(USE)                     # Pick up the primitive\n          tr, tc = cell\n          state.inventory[prim_idx] += 1\n          state.grid[tr, tc, prim_idx] = 0        # Remove from map\n\n  # ------------------------------------------------------------------\n  # 2. Move to the appropriate workshop and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      return actions  # No workshop information; cannot craft.\n\n  workshop_idx = idx[workshop_name]\n  path, cell = _nearest_cell_of(workshop_idx, state.pos)\n  if cell is None:\n      return actions  # No reachable workshop.\n  actions.extend(path)\n  state.pos = cell\n  actions.append(USE)   # Craft the arrow at the workshop\n\n  return actions", "env_interactions": 26, "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T18:03:00.589866", "function_name": "make_arrow", "function_body": "  # ------------------------------------------------------------------\n  # Constants and helper utilities\n  # ------------------------------------------------------------------\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # 0:DOWN, 1:UP, 2:LEFT, 3:RIGHT\n  USE = 4\n\n  from collections import deque\n  import numpy as np\n\n  def _bfs_adjacent(start, target, blocked):\n      \"\"\"Return a list of actions that moves the agent from *start* to any\n      free 4\u2011adjacent cell of *target*.  If none reachable, returns [].\"\"\"\n      h, w = blocked.shape\n      tx, ty = target\n      # admissible cells around the target\n      goal_cells = []\n      for a, (dx, dy) in enumerate(DIRS):\n          gx, gy = tx + dx, ty + dy\n          if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:\n              goal_cells.append((gx, gy))\n      if not goal_cells:\n          return []\n\n      q = deque([(start, [])])\n      visited = {start}\n      while q:\n          (cx, cy), path = q.popleft()\n          if (cx, cy) in goal_cells:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []\n\n  # ------------------------------------------------------------------\n  # Reset / obtain current state from the environment\n  # ------------------------------------------------------------------\n  try:\n      env.reset()\n  except Exception:\n      pass\n\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []                     # cannot retrieve state \u2192 give up\n\n  world = env.world\n  idx = world.cookbook.index\n\n  # ------------------------------------------------------------------\n  # Identify goal (arrow) and its recipe\n  # ------------------------------------------------------------------\n  try:\n      goal_idx = idx[\"arrow\"]\n  except Exception:\n      return []                     # arrow not defined in this world\n\n  # primitive requirements for ONE arrow\n  primitives_needed = world.cookbook.primitives_for(goal_idx)\n\n  # locate workshop name in the recipe (key \"_at\" or \"_key\")\n  workshop_name = None\n  for k, v in world.cookbook.recipes.get(goal_idx, {}).items():\n      if k in (\"_at\", \"_key\"):\n          workshop_name = v\n          break\n  if workshop_name is None:\n      return []                     # recipe does not specify a workshop\n\n  try:\n      workshop_idx = idx[workshop_name]\n  except Exception:\n      return []                     # workshop not indexed\n\n  # ------------------------------------------------------------------\n  # Local mutable copies for planning simulation\n  # ------------------------------------------------------------------\n  pos = tuple(state.pos)                     # (x, y)\n  grid = state.grid.copy()                   # (W, H, n_kinds)\n  inventory = state.inventory.copy()\n  occupied = np.any(grid > 0, axis=2)        # bool matrix: True = blocked\n\n  plan = []\n\n  # ------------------------------------------------------------------\n  # Helper: navigate to a cell adjacent to *target* and USE it,\n  # updating the simulated world state.\n  # ------------------------------------------------------------------\n  def _move_and_use(target, kind_idx):\n      \"\"\"Move adjacent to *target*, issue USE, and update simulation.\n      Returns False if movement is impossible.\"\"\"\n      nonlocal pos, plan, grid, occupied, inventory\n      path = _bfs_adjacent(pos, target, occupied)\n      if not path and pos != target:\n          return False\n\n      # simulate movement\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n      plan.extend(path)\n\n      # simulate USE\n      plan.append(USE)\n      tx, ty = target\n      if grid[tx, ty, kind_idx] > 0:\n          grid[tx, ty, kind_idx] = 0\n          occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)\n          inventory[kind_idx] += 1\n      return True\n\n  # ------------------------------------------------------------------\n  # Collect all required primitive resources\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      for _ in range(needed_cnt):\n          locations = np.argwhere(grid[:, :, prim_idx] > 0)\n          if locations.shape[0] == 0:\n              # primitive not present on the map \u2013 abort planning\n              return plan\n          # choose the closest occurrence (Manhattan distance)\n          dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n          target = tuple(locations[dists.argmin()])\n          if not _move_and_use(target, prim_idx):\n              return plan\n\n  # ------------------------------------------------------------------\n  # Move to the workshop and craft the arrow\n  # ------------------------------------------------------------------\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.shape[0] == 0:\n      # workshops are static; fall back to the original scenario grid\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.shape[0] == 0:\n          return plan\n\n  dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])\n  workshop_target = tuple(workshop_cells[dists.argmin()])\n  _move_and_use(workshop_target, workshop_idx)\n\n  # ------------------------------------------------------------------\n  # Return the assembled action sequence\n  # ------------------------------------------------------------------\n  return plan", "env_interactions": 23, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T18:03:01.722231", "function_name": "make_arrow", "function_body": "  # Constants for actions\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # DOWN, UP, LEFT, RIGHT\n  USE = 4\n\n  from collections import deque\n  import numpy as np\n\n  def _bfs_adjacent(start, target, blocked):\n      \"\"\"Return a list of actions that moves the agent from *start* to any\n      free 4\u2011adjacent cell of *target*.  Returns empty list if unreachable.\"\"\"\n      h, w = blocked.shape\n      tx, ty = target\n      # admissible cells around the target\n      goal_cells = []\n      for a, (dx, dy) in enumerate(DIRS):\n          gx, gy = tx + dx, ty + dy\n          if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:\n              goal_cells.append((gx, gy))\n      if not goal_cells:\n          return []\n\n      q = deque([(start, [])])\n      visited = {start}\n      while q:\n          (cx, cy), path = q.popleft()\n          if (cx, cy) in goal_cells:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []\n\n  # ------------------------------------------------------------------\n  # Get current state (reset environment first)\n  # ------------------------------------------------------------------\n  try:\n      env.reset()\n  except Exception:\n      pass\n\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []   # cannot obtain state\n\n  world = env.world\n  idx = world.cookbook.index\n\n  # ------------------------------------------------------------------\n  # Identify goal (arrow) and its recipe\n  # ------------------------------------------------------------------\n  try:\n      goal_idx = idx[\"arrow\"]\n  except Exception:\n      return []   # no arrow in this world\n\n  primitives_needed = world.cookbook.primitives_for(goal_idx)\n\n  # Find workshop name in the recipe (key \"_at\" or \"_key\")\n  workshop_name = None\n  for k, v in world.cookbook.recipes.get(goal_idx, {}).items():\n      if k in (\"_at\", \"_key\"):\n          workshop_name = v\n          break\n  if workshop_name is None:\n      return []   # recipe does not specify a workshop\n\n  try:\n      workshop_idx = idx[workshop_name]\n  except Exception:\n      return []   # workshop not indexed\n\n  # ------------------------------------------------------------------\n  # Local mutable copies for planning simulation\n  # ------------------------------------------------------------------\n  pos = tuple(state.pos)                     # (x, y)\n  grid = state.grid.copy()                   # (W, H, n_kinds)\n  inventory = state.inventory.copy()\n  occupied = np.any(grid > 0, axis=2)        # bool matrix: True = blocked\n\n  plan = []\n\n  # ------------------------------------------------------------------\n  # Helper: move adjacent to *target* and USE it, updating simulated state\n  # ------------------------------------------------------------------\n  def _move_and_use(target, kind_idx):\n      \"\"\"Navigate to a free cell adjacent to *target*, issue USE, and update\n      simulated world state.  Returns False if movement is impossible.\"\"\"\n      nonlocal pos, plan, grid, occupied, inventory\n      path = _bfs_adjacent(pos, target, occupied)\n      if not path and pos != target:\n          return False\n\n      # simulate movement\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n      plan.extend(path)\n\n      # simulate USE\n      plan.append(USE)\n      tx, ty = target\n      if grid[tx, ty, kind_idx] > 0:\n          grid[tx, ty, kind_idx] = 0\n          occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)\n          inventory[kind_idx] += 1\n      return True\n\n  # ------------------------------------------------------------------\n  # Collect all required primitive resources\n  # ------------------------------------------------------------------\n  for prim_idx, count in primitives_needed.items():\n      for _ in range(count):\n          locations = np.argwhere(grid[:, :, prim_idx] > 0)\n          if locations.shape[0] == 0:\n              # Primitive not present on the map \u2013 stop planning\n              return plan\n          # Choose the closest occurrence (Manhattan distance)\n          dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n          target = tuple(locations[dists.argmin()])\n          if not _move_and_use(target, prim_idx):\n              return plan\n\n  # ------------------------------------------------------------------\n  # Move to the workshop and craft the arrow\n  # ------------------------------------------------------------------\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.shape[0] == 0:\n      # Workshops are static; fall back to original scenario grid\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.shape[0] == 0:\n          return plan\n\n  dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])\n  workshop_target = tuple(workshop_cells[dists.argmin()])\n  _move_and_use(workshop_target, workshop_idx)\n\n  # ------------------------------------------------------------------\n  # Return the full action sequence\n  # ------------------------------------------------------------------\n  return plan", "env_interactions": 23, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T18:03:33.394409", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  goal_name = \"arrow\"\n  goal_idx = idx[goal_name]\n\n  # primitives needed to craft one arrow\n  needed = world.cookbook.primitives_for(goal_idx)\n\n  # workshop required for the final crafting step (if any)\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else idx[wk]\n\n  # ------------------------------------------------------------------\n  # helper utilities\n  # ------------------------------------------------------------------\n  def find_locations(kind):\n      \"\"\"Return list of (x, y) coordinates where `kind` is present.\"\"\"\n      occ = np.where(state.grid[:, :, kind] > 0)\n      return list(zip(occ[0].tolist(), occ[1].tolist()))\n\n  def bfs(start, goal):\n      \"\"\"Return shortest path (list of positions) from start to goal.\"\"\"\n      if start == goal:\n          return [start]\n      W, H = state.grid.shape[:2]\n\n      # cells occupied by non\u2011grabbable entities are blocked\n      blocked = set()\n      for ng in world.non_grabbable_indices:\n          occ = np.where(state.grid[:, :, ng] > 0)\n          blocked.update(zip(occ[0].tolist(), occ[1].tolist()))\n\n      q = collections.deque([start])\n      prev = {start: None}\n      while q:\n          cur = q.popleft()\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:\n                  nxt = (nx, ny)\n                  if nxt not in prev:\n                      prev[nxt] = cur\n                      if nxt == goal:\n                          # reconstruct path\n                          path = [goal]\n                          while path[-1] != start:\n                              path.append(prev[path[-1]])\n                          path.reverse()\n                          return path\n                      q.append(nxt)\n      # no path found \u2013 stay put\n      return [start]\n\n  def move_action(cur, nxt):\n      \"\"\"Translate a step from cur to adjacent nxt into an action index.\"\"\"\n      dx = nxt[0] - cur[0]\n      dy = nxt[1] - cur[1]\n      if dx == 1:\n          return 3   # RIGHT\n      if dx == -1:\n          return 2   # LEFT\n      if dy == 1:\n          return 0   # DOWN\n      if dy == -1:\n          return 1   # UP\n      raise AssertionError(\"non\u2011adjacent move requested\")\n\n  # ------------------------------------------------------------------\n  # build the action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = state.pos\n\n  # 1) collect all required primitives\n  for prim_idx, count_needed in needed.items():\n      while state.inventory[prim_idx] < count_needed:\n          locations = find_locations(prim_idx)\n          if not locations:\n              # cannot find more of this primitive \u2013 abort loop\n              break\n          # pick the nearest instance (Manhattan distance)\n          target = min(\n              locations,\n              key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1])\n          )\n          path = bfs(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n          # pick up the primitive\n          actions.append(4)   # USE\n          state.inventory[prim_idx] += 1\n          state.grid[target[0], target[1], prim_idx] = 0  # remove from map\n\n  # 2) go to the required workshop (if any) and craft\n  if workshop_kind is not None:\n      wk_locs = find_locations(workshop_kind)\n      if wk_locs:\n          target = min(\n              wk_locs,\n              key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1])\n          )\n          path = bfs(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n      actions.append(4)   # USE to craft at the workshop\n  else:\n      actions.append(4)   # USE to craft in place\n\n  return actions", "env_interactions": 19, "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T18:03:34.523030", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  # Goal definition\n  goal_name = \"arrow\"\n  goal_idx = idx[goal_name]\n\n  # Primitives needed for one arrow\n  primitive_counts = world.cookbook.primitives_for(goal_idx)\n\n  # Workshop (if any) required for crafting\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else idx[wk]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def find_locations(kind):\n      \"\"\"Return a list of (x, y) positions where `kind` occurs on the grid.\"\"\"\n      occ = np.where(state.grid[:, :, kind] > 0)\n      return list(zip(occ[0].tolist(), occ[1].tolist()))\n\n  def bfs_path(start, goal):\n      \"\"\"Return the shortest path (list of positions) from start to goal, avoiding non\u2011grabbable cells.\"\"\"\n      if start == goal:\n          return [start]\n      W, H = state.grid.shape[:2]\n\n      # Build set of blocked cells (non\u2011grabbable entities)\n      blocked = set()\n      for ng in world.non_grabbable_indices:\n          occ = np.where(state.grid[:, :, ng] > 0)\n          blocked.update(zip(occ[0].tolist(), occ[1].tolist()))\n\n      q = collections.deque([start])\n      prev = {start: None}\n      while q:\n          cur = q.popleft()\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:\n                  nxt = (nx, ny)\n                  if nxt not in prev:\n                      prev[nxt] = cur\n                      if nxt == goal:\n                          # Reconstruct path\n                          path = [goal]\n                          while path[-1] != start:\n                              path.append(prev[path[-1]])\n                          path.reverse()\n                          return path\n                      q.append(nxt)\n      # No path found \u2013 stay where we are\n      return [start]\n\n  def move_action(cur, nxt):\n      \"\"\"Translate a step from cur to adjacent nxt into an action index.\"\"\"\n      dx, dy = nxt[0] - cur[0], nxt[1] - cur[1]\n      if dx == 1:\n          return 3   # RIGHT\n      if dx == -1:\n          return 2   # LEFT\n      if dy == 1:\n          return 0   # DOWN\n      if dy == -1:\n          return 1   # UP\n      raise AssertionError(\"Requested move is not adjacent\")\n\n  # ------------------------------------------------------------------\n  # Build the action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = state.pos\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitive_counts.items():\n      while state.inventory[prim_idx] < needed:\n          locations = find_locations(prim_idx)\n          if not locations:\n              # No more of this primitive on the map \u2013 abort collection loop\n              break\n\n          # Choose the nearest instance (Manhattan distance)\n          target = min(\n              locations,\n              key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1])\n          )\n\n          # Move to the target\n          path = bfs_path(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n\n          # Pick it up\n          actions.append(4)   # USE\n          state.inventory[prim_idx] += 1\n          state.grid[target[0], target[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 2) Move to the workshop (if required) and craft\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      wk_locs = find_locations(workshop_kind)\n      if wk_locs:\n          target = min(\n              wk_locs,\n              key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1])\n          )\n          path = bfs_path(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n      # Craft at the workshop\n      actions.append(4)   # USE\n  else:\n      # No specific workshop \u2013 craft wherever we are\n      actions.append(4)   # USE\n\n  return actions", "env_interactions": 19, "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T18:03:55.010065", "function_name": "make_arrow", "function_body": "  # Reset environment to start fresh and obtain task information\n  _ = env.reset()\n  act_map = env.action_specs()                     # mapping from action name to int code\n\n  # Directions and their deltas for movement\n  moves = [\n      (\"DOWN\", (1, 0)),\n      (\"UP\", (-1, 0)),\n      (\"RIGHT\", (0, 1)),\n      (\"LEFT\", (0, -1)),\n  ]\n  dir_to_delta = {name: delta for name, delta in moves}\n\n  # --------------------------------------------------------------\n  # Helper: BFS that finds a path (as a list of direction names) from\n  # start position to any empty cell adjacent to the target cell.\n  # --------------------------------------------------------------\n  def bfs_to_adjacent(start, target, occupied):\n      tr, tc = target\n      # All walkable neighbours of the target\n      neighbours = [\n          (tr + dr, tc + dc)\n          for _, (dr, dc) in moves\n          if 0 <= tr + dr < occupied.shape[0]\n          and 0 <= tc + dc < occupied.shape[1]\n          and not occupied[tr + dr, tc + dc]\n      ]\n      if not neighbours:\n          return []  # no reachable adjacent cell\n\n      from collections import deque\n      q = deque([start])\n      parent = {start: None}\n      parent_move = {}\n\n      while q:\n          cur = q.popleft()\n          if cur in neighbours:\n              # reconstruct path\n              path = []\n              while parent[cur] is not None:\n                  path.append(parent_move[cur])\n                  cur = parent[cur]\n              path.reverse()\n              return path\n\n          r, c = cur\n          for name, (dr, dc) in moves:\n              nr, nc = r + dr, c + dc\n              if (\n                  0 <= nr < occupied.shape[0]\n                  and 0 <= nc < occupied.shape[1]\n                  and not occupied[nr, nc]\n                  and (nr, nc) not in parent\n              ):\n                  parent[(nr, nc)] = cur\n                  parent_move[(nr, nc)] = name\n                  q.append((nr, nc))\n      return []  # no path found\n\n  # --------------------------------------------------------------\n  # Helper: execute a list of direction names, updating the running\n  # position and appending the corresponding action codes.\n  # --------------------------------------------------------------\n  def execute_path(path_dirs):\n      nonlocal cur_pos\n      for dname in path_dirs:\n          actions.append(act_map[dname])\n          dr, dc = dir_to_delta[dname]\n          cur_pos = (cur_pos[0] + dr, cur_pos[1] + dc)\n\n  # --------------------------------------------------------------\n  # Gather scenario / world information\n  # --------------------------------------------------------------\n  scenario = env.scenario\n  world = scenario.world\n  goal_idx = env.task.goal                         # integer index of the desired item\n\n  # Primitive requirements (flattened) and workshop location (if any)\n  primitives_needed = world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n\n  # Working copies of the grid and occupancy mask\n  grid = scenario.init_grid.copy()\n  occupied = grid.sum(axis=2) > 0                 # True where any entity occupies the cell\n\n  # Current agent state\n  cur_pos = scenario.init_pos                     # (row, col)\n\n  # Action list to be returned\n  actions = []\n\n  # --------------------------------------------------------------\n  # Collect each required primitive the required number of times\n  # --------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      for _ in range(needed_cnt):\n          # Find all remaining cells containing this primitive\n          prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not prim_cells:\n              # No more of this primitive left; abort early\n              break\n\n          # Choose the closest instance (Manhattan distance)\n          target = min(\n              prim_cells,\n              key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]),\n          )\n\n          # Move to an empty neighbour of the target\n          path = bfs_to_adjacent(cur_pos, target, occupied)\n          execute_path(path)\n\n          # Pick up the primitive\n          actions.append(act_map[\"USE\"])\n\n          # Update grid/occupancy: primitive disappears after pickup\n          r, c = target\n          grid[r, c, :] = 0\n          occupied[r, c] = False\n\n  # --------------------------------------------------------------\n  # Move to the workshop (if required) and craft the goal item\n  # --------------------------------------------------------------\n  if workshop_kind is not None:\n      # Locate a workshop cell of the appropriate kind\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n      if not workshop_cells:\n          # If the workshop was removed during collection, fall back to original grid\n          workshop_cells = list(\n              zip(*np.where(scenario.init_grid[:, :, workshop_kind] > 0))\n          )\n      if workshop_cells:\n          target = workshop_cells[0]  # any workshop works\n          path = bfs_to_adjacent(cur_pos, target, occupied)\n          execute_path(path)\n          actions.append(act_map[\"USE\"])\n\n  return actions", "env_interactions": 0, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T18:03:56.123558", "function_name": "make_arrow", "function_body": "  # Reset environment to obtain fresh scenario/state\n  _ = env.reset()\n\n  # Mapping from action names to integer codes used by the environment\n  act_map = env.action_specs()\n\n  # Define movement directions and their deltas\n  moves = [\n      (\"DOWN\", (1, 0)),\n      (\"UP\", (-1, 0)),\n      (\"RIGHT\", (0, 1)),\n      (\"LEFT\", (0, -1)),\n  ]\n  dir_to_delta = {name: delta for name, delta in moves}\n\n  # ------------------------------------------------------------------\n  # Helper: breadth\u2011first search for a path (as a list of action names)\n  # that brings the agent to any empty cell adjacent to the target cell.\n  # ------------------------------------------------------------------\n  def bfs_to_adjacent(start, target, occupied):\n      tr, tc = target\n      # Gather empty neighbours of the target that can be stood on\n      adjacent = [\n          (tr + dr, tc + dc)\n          for _, (dr, dc) in moves\n          if 0 <= tr + dr < occupied.shape[0]\n          and 0 <= tc + dc < occupied.shape[1]\n          and not occupied[tr + dr, tc + dc]\n      ]\n      if not adjacent:\n          return []  # No reachable neighbour\n\n      from collections import deque\n\n      q = deque([start])\n      parent = {start: None}\n      parent_move = {}\n\n      while q:\n          cur = q.popleft()\n          if cur in adjacent:\n              # Reconstruct the path of action names\n              path = []\n              while parent[cur] is not None:\n                  path.append(parent_move[cur])\n                  cur = parent[cur]\n              path.reverse()\n              return path\n\n          r, c = cur\n          for name, (dr, dc) in moves:\n              nr, nc = r + dr, c + dc\n              if (\n                  0 <= nr < occupied.shape[0]\n                  and 0 <= nc < occupied.shape[1]\n                  and not occupied[nr, nc]\n                  and (nr, nc) not in parent\n              ):\n                  parent[(nr, nc)] = cur\n                  parent_move[(nr, nc)] = name\n                  q.append((nr, nc))\n      return []  # No path found\n\n  # ------------------------------------------------------------------\n  # Shortcut to execute a list of direction names, updating position.\n  # ------------------------------------------------------------------\n  def execute_path(path_dirs):\n      nonlocal cur_pos\n      for dname in path_dirs:\n          actions.append(act_map[dname])\n          dr, dc = dir_to_delta[dname]\n          cur_pos = (cur_pos[0] + dr, cur_pos[1] + dc)\n\n  # ------------------------------------------------------------------\n  # Gather task\u2011specific information from the environment\n  # ------------------------------------------------------------------\n  scenario = env.scenario\n  world = scenario.world\n  goal_idx = env.task.goal  # integer index of the desired item\n\n  # Determine which primitive resources are needed for the goal\n  primitives_needed = world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n\n  # Working copies of the grid and an occupancy mask (True = blocked)\n  grid = scenario.init_grid.copy()\n  occupied = grid.sum(axis=2) > 0\n\n  # Current agent state\n  cur_pos = scenario.init_pos  # (row, col)\n\n  # List that will accumulate the actions to return\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the required number of times\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      for _ in range(needed_cnt):\n          # Find all remaining cells that contain this primitive\n          prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not prim_cells:\n              # No more instances left; break early\n              break\n\n          # Choose the closest instance (Manhattan distance)\n          target = min(\n              prim_cells,\n              key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]),\n          )\n\n          # Move to an empty neighbour of the target cell\n          path = bfs_to_adjacent(cur_pos, target, occupied)\n          execute_path(path)\n\n          # Pick up the primitive\n          actions.append(act_map[\"USE\"])\n\n          # Update grid/occupancy to reflect the collected primitive\n          r, c = target\n          grid[r, c, :] = 0\n          occupied[r, c] = False\n\n  # ------------------------------------------------------------------\n  # If the recipe requires a specific workshop, move there and craft\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      # Locate workshop cells (they are static, so also check original grid)\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n      if not workshop_cells:\n          workshop_cells = list(\n              zip(*np.where(scenario.init_grid[:, :, workshop_kind] > 0))\n          )\n      if workshop_cells:\n          target = workshop_cells[0]  # any workshop will do\n          path = bfs_to_adjacent(cur_pos, target, occupied)\n          execute_path(path)\n          actions.append(act_map[\"USE\"])\n\n  # Return the complete action sequence\n  return actions", "env_interactions": 0, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T18:04:17.017916", "function_name": "make_arrow", "function_body": "", "env_interactions": 0, "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-10-27T18:04:18.132451", "function_name": "make_arrow", "function_body": "  # reset environment and get handles\n  env.reset()\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  # goal definition\n  goal_name = \"arrow\"\n  goal_idx = idx[goal_name]\n\n  # primitives required for one arrow\n  needed_prims = world.cookbook.primitives_for(goal_idx)\n\n  # workshop required for final crafting (if any)\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else idx[wk]\n\n  # ------------------------------------------------------------------\n  # helper utilities\n  # ------------------------------------------------------------------\n  def find_positions(kind):\n      \"\"\"Return list of (x, y) where `kind` is present on the grid.\"\"\"\n      occ = np.where(state.grid[:, :, kind] > 0)\n      return list(zip(occ[0].tolist(), occ[1].tolist()))\n\n  def bfs(start, goal):\n      \"\"\"Shortest path (list of positions) from start to goal avoiding non\u2011grabbable cells.\"\"\"\n      if start == goal:\n          return [start]\n      W, H = state.grid.shape[:2]\n\n      blocked = set()\n      for ng in world.non_grabbable_indices:\n          occ = np.where(state.grid[:, :, ng] > 0)\n          blocked.update(zip(occ[0].tolist(), occ[1].tolist()))\n\n      q = collections.deque([start])\n      prev = {start: None}\n      while q:\n          cur = q.popleft()\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:\n                  nxt = (nx, ny)\n                  if nxt not in prev:\n                      prev[nxt] = cur\n                      if nxt == goal:\n                          # reconstruct path\n                          path = [goal]\n                          while path[-1] != start:\n                              path.append(prev[path[-1]])\n                          path.reverse()\n                          return path\n                      q.append(nxt)\n      return [start]  # no path found\n\n  def move_action(cur, nxt):\n      \"\"\"Convert a step from cur to adjacent nxt into an action index.\"\"\"\n      dx, dy = nxt[0] - cur[0], nxt[1] - cur[1]\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise AssertionError(\"Non\u2011adjacent move requested\")\n\n  # ------------------------------------------------------------------\n  # construct action list\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = state.pos\n\n  # 1) collect each needed primitive\n  for prim_idx, cnt_needed in needed_prims.items():\n      while state.inventory[prim_idx] < cnt_needed:\n          locations = find_positions(prim_idx)\n          if not locations:\n              # cannot find more of this primitive \u2013 break out\n              break\n          # choose nearest location (Manhattan distance)\n          target = min(\n              locations,\n              key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1])\n          )\n          # move to target\n          path = bfs(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n          # pick up the primitive\n          actions.append(4)               # USE\n          state.inventory[prim_idx] += 1\n          state.grid[target[0], target[1], prim_idx] = 0\n\n  # 2) go to workshop (if required) and craft\n  if workshop_kind is not None:\n      wk_locs = find_positions(workshop_kind)\n      if wk_locs:\n          target = min(\n              wk_locs,\n              key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1])\n          )\n          path = bfs(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n      actions.append(4)   # USE to craft at workshop\n  else:\n      actions.append(4)   # USE to craft in place\n\n  return actions", "env_interactions": 19, "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T18:04:40.733796", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ----------------------------------------------------------------------\n  # Constants (match CraftLab.action_specs)\n  # ----------------------------------------------------------------------\n  # 0:DOWN, 1:UP, 2:LEFT, 3:RIGHT, 4:USE\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n  USE = 4\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS that stops on any empty cell adjacent to *target*\n  # ----------------------------------------------------------------------\n  def bfs_adjacent(start, target, blocked):\n      \"\"\"Return a list of actions moving from *start* to a free cell\n      that is 4\u2011connected to *target*.  ``blocked`` is a bool matrix where\n      True means the cell cannot be entered.  Empty list if no path.\"\"\"\n      h, w = blocked.shape\n      tx, ty = target\n\n      # all admissible goal cells (empty and adjacent to target)\n      goal_cells = []\n      for a, (dx, dy) in enumerate(DIRS):\n          gx, gy = tx + dx, ty + dy\n          if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:\n              goal_cells.append((gx, gy))\n      if not goal_cells:\n          return []\n\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (cx, cy), path = q.popleft()\n          if (cx, cy) in goal_cells:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []\n\n  # ----------------------------------------------------------------------\n  # Reset environment and obtain the underlying CraftState\n  # ----------------------------------------------------------------------\n  try:\n      env.reset()\n  except Exception:\n      pass\n\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []  # cannot obtain state\n\n  world = env.world\n  idx = world.cookbook.index\n\n  # ----------------------------------------------------------------------\n  # Identify the goal (arrow) and its recipe\n  # ----------------------------------------------------------------------\n  try:\n      goal_idx = idx[\"arrow\"]\n  except Exception:\n      return []  # arrow not defined in this world\n\n  # primitives required for a single arrow\n  primitives_needed = world.cookbook.primitives_for(goal_idx)\n\n  # locate required workshop (key \"_at\" or \"_key\")\n  workshop_idx = None\n  for k, v in world.cookbook.recipes.get(goal_idx, {}).items():\n      if k in (\"_at\", \"_key\"):\n          workshop_idx = idx.get(v, None)\n          break\n  if workshop_idx is None:\n      return []  # no workshop info\n\n  # ----------------------------------------------------------------------\n  # Local mutable copies for planning simulation\n  # ----------------------------------------------------------------------\n  pos = tuple(state.pos)                     # (x, y)\n  grid = state.grid.copy()                   # (W, H, n_kinds)\n  inventory = state.inventory.copy()\n  occupied = np.any(grid > 0, axis=2)        # bool matrix of blocked cells\n\n  plan = []                                   # actions to return\n\n  # ----------------------------------------------------------------------\n  # Helper: move adjacent to *target* and issue a USE action\n  # ----------------------------------------------------------------------\n  def move_and_use(target, kind_idx):\n      \"\"\"Move next to *target* (which contains an entity of *kind_idx*)\n      and perform USE.  Updates simulated pos, grid, occupied, inventory.\n      Returns True on success, False otherwise.\"\"\"\n      nonlocal pos, plan, grid, occupied, inventory\n\n      path = bfs_adjacent(pos, target, occupied)\n      if not path and pos != target:\n          return False\n\n      # execute movement actions in simulation\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n      plan.extend(path)\n\n      # perform USE\n      plan.append(USE)\n\n      tx, ty = target\n      if grid[tx, ty, kind_idx] > 0:\n          grid[tx, ty, kind_idx] = 0\n          occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)\n          inventory[kind_idx] += 1\n      return True\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive (respecting multiplicities)\n  # ----------------------------------------------------------------------\n  for prim_idx, count in primitives_needed.items():\n      for _ in range(count):\n          locations = np.argwhere(grid[:, :, prim_idx] > 0)\n          if locations.size == 0:\n              return plan  # primitive missing; return what we have\n          # choose nearest by Manhattan distance\n          dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n          target = tuple(locations[dists.argmin()])\n          if not move_and_use(target, prim_idx):\n              return plan\n\n  # ----------------------------------------------------------------------\n  # Go to the workshop and craft the arrow\n  # ----------------------------------------------------------------------\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      # workshops are static; fall back to original grid\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          return plan  # no workshop found\n\n  dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])\n  workshop_target = tuple(workshop_cells[dists.argmin()])\n\n  move_and_use(workshop_target, workshop_idx)\n\n  return plan", "env_interactions": 0, "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-10-27T18:04:41.871233", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Reset environment and obtain the current CraftState\n  # ----------------------------------------------------------------------\n  try:\n      env.reset()\n  except Exception:\n      pass\n\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []   # cannot retrieve state\n\n  world = env.world\n  idx = world.cookbook.index\n\n  # ----------------------------------------------------------------------\n  # Identify the goal item (arrow) and its recipe\n  # ----------------------------------------------------------------------\n  try:\n      goal_idx = idx[\"arrow\"]\n  except Exception:\n      return []   # arrow not defined in this world\n\n  # Primitive requirements for a single arrow\n  primitives_needed = world.cookbook.primitives_for(goal_idx)\n\n  # Locate the workshop required for the arrow recipe (stored under \"_at\" or \"_key\")\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = None\n  for k, v in recipe.items():\n      if k in (\"_at\", \"_key\"):\n          workshop_name = v\n          break\n  if workshop_name is None:\n      return []   # no workshop information\n  try:\n      workshop_idx = idx[workshop_name]\n  except Exception:\n      return []   # unknown workshop name\n\n  # ----------------------------------------------------------------------\n  # Local mutable copies for planning\n  # ----------------------------------------------------------------------\n  pos = tuple(state.pos)                     # (x, y)\n  grid = state.grid.copy()                   # (W, H, n_kinds)\n  inventory = state.inventory.copy()\n  occupied = np.any(grid > 0, axis=2)        # bool matrix of occupied cells\n\n  plan = []                                   # list of actions to return\n\n  # ----------------------------------------------------------------------\n  # Helper constants and functions\n  # ----------------------------------------------------------------------\n  # Action ordering matches CraftLab.action_specs: 0=DOWN,1=UP,2=LEFT,3=RIGHT,4=USE\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n  USE = 4\n\n  from collections import deque\n\n  def bfs_adjacent(start, target, blocked):\n      \"\"\"Return a list of movement actions that brings the agent from *start*\n      to any empty cell that is 4\u2011connected to *target*. Returns [] if impossible.\"\"\"\n      h, w = blocked.shape\n      tx, ty = int(target[0]), int(target[1])\n\n      # admissible goal cells (empty and adjacent to target)\n      goal_cells = []\n      for a, (dx, dy) in enumerate(DIRS):\n          gx, gy = tx + dx, ty + dy\n          if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:\n              goal_cells.append((gx, gy))\n      if not goal_cells:\n          return []\n\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (cx, cy), path = q.popleft()\n          if (cx, cy) in goal_cells:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []\n\n  def move_to_and_use(target, kind_idx):\n      \"\"\"Move adjacent to *target* (which contains an entity of *kind_idx*)\n      and issue a USE action. Updates simulated pos, grid, occupied,\n      inventory accordingly. Returns True on success, False otherwise.\"\"\"\n      nonlocal pos, plan, grid, occupied, inventory\n\n      path = bfs_adjacent(pos, target, occupied)\n      if not path and pos != target:\n          return False\n\n      # Apply movement actions\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n      plan.extend(path)\n\n      # Perform USE\n      plan.append(USE)\n\n      tx, ty = int(target[0]), int(target[1])\n      if grid[tx, ty, kind_idx] > 0:\n          # Pick up one unit\n          grid[tx, ty, kind_idx] = 0\n          occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)\n          inventory[kind_idx] += 1\n      return True\n\n  # ----------------------------------------------------------------------\n  # Collect all required primitives\n  # ----------------------------------------------------------------------\n  for prim_idx, count in primitives_needed.items():\n      for _ in range(count):\n          locations = np.argwhere(grid[:, :, prim_idx] > 0)\n          if locations.shape[0] == 0:\n              # Primitive not found; abort planning\n              return plan\n          # Choose the nearest instance (Manhattan distance)\n          dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n          target = locations[dists.argmin()]\n          if not move_to_and_use(target, prim_idx):\n              return plan\n\n  # ----------------------------------------------------------------------\n  # Move to the appropriate workshop and craft the arrow\n  # ----------------------------------------------------------------------\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.shape[0] == 0:\n      # Workshops are static; fall back to the original scenario grid\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.shape[0] == 0:\n          return plan\n\n  dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])\n  workshop_target = workshop_cells[dists.argmin()]\n\n  move_to_and_use(workshop_target, workshop_idx)\n\n  return plan", "env_interactions": 23, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T18:05:14.802858", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n\n  # Determine goal index for arrow\n  if hasattr(env, \"task\") and hasattr(env.task, \"goal\"):\n      goal_idx = env.task.goal\n  else:\n      goal_idx = env.world.cookbook.index.get(\"arrow\")\n      if goal_idx is None:\n          raise ValueError(\"Arrow goal not found in cookbook\")\n\n  # Action constants\n  act_spec = env.action_specs()\n  ACT_DOWN = act_spec[\"DOWN\"]\n  ACT_UP = act_spec[\"UP\"]\n  ACT_LEFT = act_spec[\"LEFT\"]\n  ACT_RIGHT = act_spec[\"RIGHT\"]\n  ACT_USE = act_spec[\"USE\"]\n\n  actions = []\n\n  from collections import deque\n\n  def bfs_path(start, target):\n      \"\"\"Return list of actions to move from start to target (both (y,x)).\"\"\"\n      grid = state.grid\n      h, w, _ = grid.shape\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (y, x), path = q.popleft()\n          if (y, x) == target:\n              return path\n          for dy, dx, act in ((1, 0, ACT_DOWN),\n                              (-1, 0, ACT_UP),\n                              (0, 1, ACT_RIGHT),\n                              (0, -1, ACT_LEFT)):\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < h and 0 <= nx < w and (ny, nx) not in visited:\n                  # allow stepping onto target even if occupied\n                  if not grid[ny, nx, :].any() or (ny, nx) == target:\n                      visited.add((ny, nx))\n                      q.append(((ny, nx), path + [act]))\n      return []\n\n  def move_to(pos):\n      nonlocal state\n      while state.pos != pos:\n          path = bfs_path(state.pos, pos)\n          if not path:\n              break\n          for a in path:\n              actions.append(a)\n              env.step(a)\n              state = env._current_state\n              if state.pos == pos:\n                  break\n\n  def nearest_of_kind(kind_idx):\n      grid = state.grid\n      h, w, _ = grid.shape\n      py, px = state.pos\n      best = None\n      best_dist = None\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  d = abs(i - py) + abs(j - px)\n                  if best_dist is None or d < best_dist:\n                      best_dist = d\n                      best = (i, j)\n      return best\n\n  def adjacent_free(cell):\n      y, x = cell\n      h, w, _ = state.grid.shape\n      # Prefer the cell itself if free\n      if not state.grid[y, x, :].any():\n          return (y, x)\n      for dy in (-1, 0, 1):\n          for dx in (-1, 0, 1):\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < h and 0 <= nx < w:\n                  if not state.grid[ny, nx, :].any():\n                      return (ny, nx)\n      return None\n\n  # Collect required primitives\n  needed = env.world.cookbook.primitives_for(goal_idx)  # dict {kind_idx: count}\n  for kind_idx, cnt in needed.items():\n      for _ in range(cnt):\n          src = nearest_of_kind(kind_idx)\n          if src is None:\n              continue\n          adj = adjacent_free(src)\n          if adj is None:\n              continue\n          move_to(adj)\n          actions.append(ACT_USE)\n          env.step(ACT_USE)\n          state = env._current_state\n\n  # Go to workshop if recipe specifies one\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      ws_idx = env.world.cookbook.index[workshop_name]\n      ws_pos = nearest_of_kind(ws_idx)\n      if ws_pos:\n          adj = adjacent_free(ws_pos)\n          if adj:\n              move_to(adj)\n              actions.append(ACT_USE)\n              env.step(ACT_USE)\n              state = env._current_state\n\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T18:05:15.918916", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  actions = []\n\n  # goal index\n  if hasattr(env, \"task\") and hasattr(env.task, \"goal\"):\n      goal_idx = env.task.goal\n  else:\n      goal_idx = env.world.cookbook.index.get(\"arrow\")\n      if goal_idx is None:\n          raise ValueError(\"arrow not found in cookbook\")\n\n  act_spec = env.action_specs()\n  ACT_DOWN = act_spec[\"DOWN\"]\n  ACT_UP = act_spec[\"UP\"]\n  ACT_LEFT = act_spec[\"LEFT\"]\n  ACT_RIGHT = act_spec[\"RIGHT\"]\n  ACT_USE = act_spec[\"USE\"]", "env_interactions": 0, "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-10-27T18:05:40.197498", "function_name": "make_arrow", "function_body": "  # Reset the environment and fetch useful references\n  env.reset()\n  state = env._current_state\n  world = env.scenario.world\n  cookbook = world.cookbook\n  index = cookbook.index\n\n  # Action indices from the environment spec\n  action_spec = env.action_specs()\n  DOWN = action_spec[\"DOWN\"]\n  UP = action_spec[\"UP\"]\n  LEFT = action_spec[\"LEFT\"]\n  RIGHT = action_spec[\"RIGHT\"]\n  USE = action_spec[\"USE\"]\n\n  # Goal we want to achieve\n  goal_name = \"arrow\"\n  if goal_name not in index.contents:\n      return []\n\n  goal_idx = index[goal_name]\n\n  # Primitive requirements for the goal (including multiplicities)\n  primitive_needs = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  from collections import deque\n  h, w = state.grid.shape[:2]\n\n  # Movement directions\n  moves = [\n      (DOWN, (1, 0)),\n      (UP, (-1, 0)),\n      (LEFT, (0, -1)),\n      (RIGHT, (0, 1)),\n  ]\n\n  def bfs_path(start, target):\n      \"\"\"Return a list of move actions that brings the agent from `start` to `target`.\"\"\"\n      if start == target:\n          return []\n\n      queue = deque([start])\n      visited = {start}\n      parent = {}\n\n      while queue:\n          cur = queue.popleft()\n          if cur == target:\n              break\n          for act, (dr, dc) in moves:\n              nr, nc = cur[0] + dr, cur[1] + dc\n              if not (0 <= nr < h and 0 <= nc < w):\n                  continue\n              nxt = (nr, nc)\n              # Allow stepping onto the target even if it is occupied\n              if nxt != target and state.grid[nr, nc].any():\n                  continue\n              if nxt in visited:\n                  continue\n              visited.add(nxt)\n              parent[nxt] = (cur, act)\n              queue.append(nxt)\n\n      if target not in parent and start != target:\n          return []   # unreachable\n\n      # Reconstruct path\n      path = []\n      cur = target\n      while cur != start:\n          prev, act = parent[cur]\n          path.append(act)\n          cur = prev\n      path.reverse()\n      return path\n\n  def nearest_cell(kind_idx):\n      \"\"\"Return coordinates of the closest cell containing `kind_idx`, or None.\"\"\"\n      cells = np.argwhere(state.grid[:, :, kind_idx] > 0)\n      if cells.size == 0:\n          return None\n      # Pick the cell with smallest Manhattan distance (good enough heuristic)\n      best = None\n      best_dist = None\n      for r, c in cells:\n          dist = abs(r - state.pos[0]) + abs(c - state.pos[1])\n          if best_dist is None or dist < best_dist:\n              best, best_dist = (r, c), dist\n      return best\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # 1. Collect required primitives (respect multiplicities)\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          target = nearest_cell(prim_idx)\n          if target is None:\n              # Primitive missing \u2013 abort early\n              return actions\n          # Move to the primitive\n          move_seq = bfs_path(state.pos, target)\n          actions.extend(move_seq)\n          state.pos = target\n          # Pick it up\n          actions.append(USE)\n          # Update our internal copy of the state\n          state.inventory[prim_idx] += 1\n          state.grid[target[0], target[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 2. Go to the workshop for the goal and craft the item\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      return actions\n\n  workshop_idx = index[workshop_name]\n  workshop_pos = nearest_cell(workshop_idx)\n  if workshop_pos is None:\n      return actions\n\n  move_seq = bfs_path(state.pos, workshop_pos)\n  actions.extend(move_seq)\n  state.pos = workshop_pos\n\n  # Craft the goal item\n  actions.append(USE)\n\n  return actions", "env_interactions": 24, "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T18:05:41.476309", "function_name": "make_arrow", "function_body": "  # Reset environment and get references to world structures\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.scenario.world          # CraftWorld\n  cookbook = world.cookbook           # Cookbook\n  index = cookbook.index               # name \u2194 integer id mapping\n\n  # Action identifiers from the environment specification\n  action_map = env.action_specs()\n  DOWN = action_map[\"DOWN\"]\n  UP = action_map[\"UP\"]\n  LEFT = action_map[\"LEFT\"]\n  RIGHT = action_map[\"RIGHT\"]\n  USE = action_map[\"USE\"]\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow) and its primitive requirements.\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  if goal_name not in index.contents:\n      return []                       # arrow not defined in this world\n\n  goal_idx = index[goal_name]          # integer id for the arrow item\n  primitive_needs = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n  actions = []                         # final action sequence\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of move actions from start to target.\n  # The target cell may be occupied (primitive or workshop); all other\n  # cells must be empty.\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  def _bfs_path(start, target):\n      \"\"\"Return list of move actions (DOWN/UP/LEFT/RIGHT) to reach target.\"\"\"\n      if start == target:\n          return []\n\n      h, w = state.grid.shape[:2]\n      moves = [\n          (DOWN, (1, 0)),\n          (UP, (-1, 0)),\n          (LEFT, (0, -1)),\n          (RIGHT, (0, 1)),\n      ]\n\n      queue = deque([start])\n      visited = {start}\n      parent = {}\n\n      while queue:\n          cur = queue.popleft()\n          if cur == target:\n              break\n          for act, (dr, dc) in moves:\n              nr, nc = cur[0] + dr, cur[1] + dc\n              if not (0 <= nr < h and 0 <= nc < w):\n                  continue\n              nxt = (nr, nc)\n              # Allow stepping onto the target even if occupied.\n              if nxt != target and state.grid[nr, nc].any():\n                  continue\n              if nxt in visited:\n                  continue\n              visited.add(nxt)\n              parent[nxt] = (cur, act)\n              queue.append(nxt)\n\n      if target not in parent and start != target:\n          return []  # no path found\n\n      # Reconstruct path\n      path = []\n      cur = target\n      while cur != start:\n          prev, act = parent[cur]\n          path.append(act)\n          cur = prev\n      path.reverse()\n      return path\n\n  # ------------------------------------------------------------------\n  # 1. Collect each required primitive the needed number of times.\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          # Locate any cell currently holding this primitive.\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # Primitive missing \u2013 abort early.\n              return actions\n          tr, tc = prim_cells[0]\n\n          # Move to the primitive cell.\n          move_seq = _bfs_path(state.pos, (tr, tc))\n          actions.extend(move_seq)\n          state.pos = (tr, tc)\n\n          # Pick it up.\n          actions.append(USE)\n\n          # Update our internal copy of the state.\n          state.inventory[prim_idx] += 1\n          state.grid[tr, tc, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 2. Go to the workshop for the arrow and craft it.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      return actions                     # no workshop info\n\n  workshop_idx = index[workshop_name]\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      return actions                     # workshop not present\n\n  wr, wc = workshop_cells[0]\n\n  # Move to the workshop cell.\n  move_seq = _bfs_path(state.pos, (wr, wc))\n  actions.extend(move_seq)\n  state.pos = (wr, wc)\n\n  # Craft the arrow.\n  actions.append(USE)\n\n  return actions", "env_interactions": 28, "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T18:06:03.229938", "function_name": "make_arrow", "function_body": "  # Reset environment and obtain initial objects\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n\n  # Goal index we need to craft\n  goal_idx = env.task.goal\n\n  # Action indices from environment spec\n  act_map = env.action_specs()\n  ACTION_DOWN = act_map['DOWN']\n  ACTION_UP = act_map['UP']\n  ACTION_LEFT = act_map['LEFT']\n  ACTION_RIGHT = act_map['RIGHT']\n  ACTION_USE = act_map['USE']\n\n  # Directions paired with movement actions\n  move_dirs = [\n      (1, 0, ACTION_DOWN),   # down\n      (-1, 0, ACTION_UP),    # up\n      (0, -1, ACTION_LEFT),  # left\n      (0, 1, ACTION_RIGHT),  # right\n  ]\n\n  import collections\n  import numpy as np\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of movement actions leading to a cell\n  # that contains `target_kind`. The agent may step onto empty cells or\n  # directly onto the target cell; any other occupied cell is treated as\n  # an obstacle.\n  # ------------------------------------------------------------------\n  def find_path(cur_state, target_kind):\n      grid = cur_state.grid\n      H, W, _ = grid.shape\n      start = cur_state.pos\n\n      # Already on a target cell\n      if grid[start[0], start[1], target_kind] > 0:\n          return []\n\n      visited = {start}\n      q = collections.deque([(start, [])])\n\n      while q:\n          (x, y), path = q.popleft()\n          for dx, dy, act in move_dirs:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < H and 0 <= ny < W):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n\n              cell = grid[nx, ny, :]\n              occupied = np.any(cell > 0)\n\n              # Traversable if empty or contains the target\n              if occupied and cell[target_kind] == 0:\n                  continue\n\n              if cell[target_kind] > 0:\n                  return path + [act]\n\n              visited.add((nx, ny))\n              q.append(((nx, ny), path + [act]))\n      # No reachable target (should not happen in valid scenarios)\n      return []\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitive items.\n  # ------------------------------------------------------------------\n  required = world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n  for kind_idx, count in required.items():\n      for _ in range(count):\n          path = find_path(state, kind_idx)\n          for a in path:\n              _, state = state.step(a)\n              actions.append(a)\n          # Pick up the primitive using the USE action\n          _, state = state.step(ACTION_USE)\n          actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # 2) Move to the workshop (if any) and craft the goal item.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get('_at')\n  if workshop_kind is not None:\n      path = find_path(state, workshop_kind)\n      for a in path:\n          _, state = state.step(a)\n          actions.append(a)\n      # Use the workshop to craft\n      _, state = state.step(ACTION_USE)\n      actions.append(ACTION_USE)\n\n  return actions", "env_interactions": 0, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T18:06:04.352468", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n  goal_idx = env.task.goal\n  act_map = env.action_specs()\n  ACTION_DOWN = act_map['DOWN']\n  ACTION_UP = act_map['UP']\n  ACTION_LEFT = act_map['LEFT']\n  ACTION_RIGHT = act_map['RIGHT']\n  ACTION_USE = act_map['USE']\n  move_dirs = [(1, 0, ACTION_DOWN), (-1, 0, ACTION_UP), (0, -1, ACTION_LEFT), (0, 1, ACTION_RIGHT)]\n\n  import collections\n  import numpy as np\n\n  actions = []\n\n  def find_path(cur_state, target_kind):\n      grid = cur_state.grid\n      H, W, _ = grid.shape\n      start = cur_state.pos\n      visited = {start}\n      q = collections.deque([(start, [])])\n      while q:\n          (x, y), path = q.popleft()\n          if grid[x, y, target_kind] > 0:\n              return path\n          for dx, dy, act in move_dirs:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < H and 0 <= ny < W):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              cell = grid[nx, ny, :]\n              if cell.sum() != 0 and cell[target_kind] == 0:\n                  continue\n              visited.add((nx, ny))\n              q.append(((nx, ny), path + [act]))\n      return []\n\n  required = world.cookbook.primitives_for(goal_idx)\n  for kind_idx, count in required.items():\n      for _ in range(count):\n          path = find_path(state, kind_idx)\n          for a in path:\n              _, state = state.step(a)\n              actions.append(a)\n          _, state = state.step(ACTION_USE)\n          actions.append(ACTION_USE)\n\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get('_at')\n  if workshop_kind is not None:\n      path = find_path(state, workshop_kind)\n      for a in path:\n          _, state = state.step(a)\n          actions.append(a)\n      _, state = state.step(ACTION_USE)\n      actions.append(ACTION_USE)\n\n  return actions", "env_interactions": 0, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T18:06:27.171992", "function_name": "make_arrow", "function_body": "  # Reset environment and get references to the underlying objects.\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.scenario.world          # CraftWorld\n  cookbook = world.cookbook           # Cookbook\n  index = cookbook.index               # name \u2194 integer id mapping\n\n  # Resolve action indices from the environment's specification.\n  action_map = env.action_specs()\n  DOWN = action_map[\"DOWN\"]\n  UP = action_map[\"UP\"]\n  LEFT = action_map[\"LEFT\"]\n  RIGHT = action_map[\"RIGHT\"]\n  USE = action_map[\"USE\"]\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow) and its primitive requirements.\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  if goal_name not in index.contents:\n      return []                       # Arrow not defined in this world\n  goal_idx = index[goal_name]         # Integer id of the arrow item\n  primitive_needs = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  actions = []                         # List of actions to return\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of move actions from start to target.\n  # The target cell may be occupied (e.g., a workshop or a primitive),\n  # but all other cells must be empty.\n  # ------------------------------------------------------------------\n  from collections import deque\n  h, w = state.grid.shape[:2]\n  moves = [(DOWN, (1, 0)),\n           (UP, (-1, 0)),\n           (LEFT, (0, -1)),\n           (RIGHT, (0, 1))]\n\n  def _bfs_path(start, target):\n      \"\"\"Return a list of movement actions to reach `target` from `start`.\"\"\"\n      if start == target:\n          return []\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          for act, (dr, dc) in moves:\n              nr, nc = cur[0] + dr, cur[1] + dc\n              if not (0 <= nr < h and 0 <= nc < w):\n                  continue\n              nxt = (nr, nc)\n              # Disallow stepping on occupied cells except the target.\n              if nxt != target and state.grid[nr, nc, :].sum() != 0:\n                  continue\n              if nxt in visited:\n                  continue\n              visited.add(nxt)\n              parent[nxt] = (cur, act)\n              q.append(nxt)\n      if target not in parent and start != target:\n          return []      # No path found\n      # Reconstruct path.\n      path = []\n      cur = target\n      while cur != start:\n          prev, act = parent[cur]\n          path.append(act)\n          cur = prev\n      path.reverse()\n      return path\n\n  # ------------------------------------------------------------------\n  # Helper: locate the nearest cell containing a given kind index.\n  # Returns (row, col) tuple or None if none found.\n  # ------------------------------------------------------------------\n  def _nearest_cell(kind_idx):\n      cells = np.argwhere(state.grid[:, :, kind_idx] > 0)\n      if cells.size == 0:\n          return None\n      dists = np.abs(cells - np.array(state.pos)).sum(axis=1)\n      return tuple(cells[dists.argmin()])\n\n  # ------------------------------------------------------------------\n  # 1. Collect each required primitive the needed number of times.\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          target = _nearest_cell(prim_idx)\n          if target is None:\n              # Primitive not present on the map \u2013 abort early.\n              return actions\n          # Move to the primitive.\n          move_seq = _bfs_path(state.pos, target)\n          actions.extend(move_seq)\n          state.pos = target\n          # Pick it up.\n          actions.append(USE)\n          # Update simulated state.\n          state.inventory[prim_idx] += 1\n          tr, tc = target\n          state.grid[tr, tc, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 2. Go to the workshop for the arrow and craft it.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      return actions                     # No workshop info\n  workshop_idx = index[workshop_name]\n  workshop_target = _nearest_cell(workshop_idx)\n  if workshop_target is None:\n      return actions                     # No workshop on the map\n\n  move_seq = _bfs_path(state.pos, workshop_target)\n  actions.extend(move_seq)\n  state.pos = workshop_target\n\n  # Craft the arrow.\n  actions.append(USE)\n\n  return actions", "env_interactions": 24, "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T18:06:28.308467", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.scenario.world\n  cookbook = world.cookbook\n  index = cookbook.index\n\n  # Resolve action identifiers from the environment.\n  action_map = env.action_specs()\n  DOWN = action_map[\"DOWN\"]\n  UP = action_map[\"UP\"]\n  LEFT = action_map[\"LEFT\"]\n  RIGHT = action_map[\"RIGHT\"]\n  USE = action_map[\"USE\"]\n\n  goal_name = \"arrow\"\n  if goal_name not in index.contents:\n      return []\n  goal_idx = index[goal_name]\n  primitive_needs = cookbook.primitives_for(goal_idx)\n\n  actions = []\n\n  from collections import deque\n\n  def _bfs_path(start, target):\n      \"\"\"Return a list of movement actions from `start` to `target`\n      avoiding occupied cells (except the target cell itself).\"\"\"\n      if start == target:\n          return []\n      h, w = state.grid.shape[:2]\n      moves = [(DOWN, (1, 0)),\n               (UP, (-1, 0)),\n               (LEFT, (0, -1)),\n               (RIGHT, (0, 1))]\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          for act, (dr, dc) in moves:\n              nr, nc = cur[0] + dr, cur[1] + dc\n              if not (0 <= nr < h and 0 <= nc < w):\n                  continue\n              nxt = (nr, nc)\n              # Treat any non\u2011empty cell as an obstacle unless it is the target.\n              if nxt != target and state.grid[nr, nc, :].sum() != 0:\n                  continue\n              if nxt in visited:\n                  continue\n              visited.add(nxt)\n              parent[nxt] = (cur, act)\n              q.append(nxt)\n      if target not in parent and start != target:\n          return []  # No path found.\n      # Reconstruct path.\n      path = []\n      cur = target\n      while cur != start:\n          prev, act = parent[cur]\n          path.append(act)\n          cur = prev\n      path.reverse()\n      return path\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitive items.\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # Primitive not present on the map \u2013 abort early.\n              return actions\n          # Choose the closest primitive cell.\n          dists = np.abs(prim_cells - np.array(state.pos)).sum(axis=1)\n          tr, tc = prim_cells[dists.argmin()]\n          # Move to the primitive.\n          move_seq = _bfs_path(state.pos, (tr, tc))\n          actions.extend(move_seq)\n          state.pos = (tr, tc)\n          # Pick it up.\n          actions.append(USE)\n          state.inventory[prim_idx] += 1\n          state.grid[tr, tc, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 2. Go to the appropriate workshop and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      return actions\n  workshop_idx = index[workshop_name]\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      return actions\n  # Choose the nearest workshop.\n  dists = np.abs(workshop_cells - np.array(state.pos)).sum(axis=1)\n  wr, wc = workshop_cells[dists.argmin()]\n  move_seq = _bfs_path(state.pos, (wr, wc))\n  actions.extend(move_seq)\n  state.pos = (wr, wc)\n  # Craft the arrow.\n  actions.append(USE)\n\n  return actions", "env_interactions": 24, "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T18:06:51.315879", "function_name": "make_arrow", "function_body": "  # Reset environment and get references to core objects\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.scenario.world\n  cookbook = world.cookbook\n  index = cookbook.index\n\n  # Action identifiers (match the environment's spec)\n  action_map = env.action_specs()\n  DOWN = action_map[\"DOWN\"]\n  UP = action_map[\"UP\"]\n  LEFT = action_map[\"LEFT\"]\n  RIGHT = action_map[\"RIGHT\"]\n  USE = action_map[\"USE\"]\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow) and the primitive ingredients required.\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  if goal_name not in index.contents:\n      return []                         # Arrow not defined in this world\n\n  goal_idx = index[goal_name]           # integer ID of the arrow item\n  primitive_needs = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n  actions = []                          # final action sequence\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of move actions from start to target.\n  # Occupied cells are avoided except for the target cell itself.\n  # ------------------------------------------------------------------\n  from collections import deque\n  import numpy as np\n\n  h, w = state.grid.shape[:2]\n  moves = [(DOWN, (1, 0)),\n           (UP,   (-1, 0)),\n           (LEFT, (0, -1)),\n           (RIGHT,(0, 1))]\n\n  def _bfs_path(start, target):\n      \"\"\"Return a list of move actions to reach `target` from `start`.\"\"\"\n      if start == target:\n          return []\n\n      queue = deque([start])\n      visited = {start}\n      parent = {}\n\n      while queue:\n          cur = queue.popleft()\n          if cur == target:\n              break\n          for act, (dr, dc) in moves:\n              nr, nc = cur[0] + dr, cur[1] + dc\n              if not (0 <= nr < h and 0 <= nc < w):\n                  continue\n              nxt = (nr, nc)\n              # Allow stepping onto the target even if occupied.\n              if nxt != target and state.grid[nr, nc, :].any():\n                  continue\n              if nxt in visited:\n                  continue\n              visited.add(nxt)\n              parent[nxt] = (cur, act)\n              queue.append(nxt)\n\n      if target not in parent and start != target:\n          return []                     # No path found\n\n      # Reconstruct path backwards.\n      path = []\n      cur = target\n      while cur != start:\n          prev, act = parent[cur]\n          path.append(act)\n          cur = prev\n      path.reverse()\n      return path\n\n  # ------------------------------------------------------------------\n  # 1. Collect each required primitive the needed number of times.\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          # Locate any cell that currently holds this primitive.\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # Primitive not present \u2013 abort early.\n              return actions\n          tr, tc = prim_cells[0]\n\n          # Move to the primitive's cell.\n          move_seq = _bfs_path(state.pos, (tr, tc))\n          actions.extend(move_seq)\n          state.pos = (tr, tc)\n\n          # Pick it up.\n          actions.append(USE)\n\n          # Update internal copy of the state.\n          state.inventory[prim_idx] += 1\n          state.grid[tr, tc, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 2. Go to the workshop for the arrow and craft it.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      return actions                     # No workshop information.\n\n  workshop_idx = index[workshop_name]\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      return actions                     # No workshop cell found.\n\n  wr, wc = workshop_cells[0]\n\n  # Move to the workshop cell.\n  move_seq = _bfs_path(state.pos, (wr, wc))\n  actions.extend(move_seq)\n  state.pos = (wr, wc)\n\n  # Craft the arrow.\n  actions.append(USE)\n\n  return actions", "env_interactions": 28, "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T18:06:52.438195", "function_name": "make_arrow", "function_body": "  # Reset environment and retrieve useful objects\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.scenario.world\n  cookbook = world.cookbook\n  index = cookbook.index\n\n  # Action identifiers (match the environment's spec)\n  action_map = env.action_specs()\n  DOWN = action_map[\"DOWN\"]\n  UP = action_map[\"UP\"]\n  LEFT = action_map[\"LEFT\"]\n  RIGHT = action_map[\"RIGHT\"]\n  USE = action_map[\"USE\"]\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow) and its primitive requirements.\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  if goal_name not in index.contents:\n      return []                       # Arrow not defined in this world\n  goal_idx = index[goal_name]         # integer ID of the arrow item\n  primitive_needs = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  actions = []                         # final action sequence\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of move actions from start to target.\n  # It treats any occupied cell as blocked, except the target cell itself.\n  # ------------------------------------------------------------------\n  from collections import deque\n  height, width = state.grid.shape[:2]\n  moves = [(DOWN, (1, 0)),\n           (UP, (-1, 0)),\n           (LEFT, (0, -1)),\n           (RIGHT, (0, 1))]\n\n  def _bfs_path(start, target):\n      \"\"\"Return a list of move actions to go from start to target.\"\"\"\n      if start == target:\n          return []\n      queue = deque([start])\n      visited = {start}\n      parent = {}\n      while queue:\n          cur = queue.popleft()\n          if cur == target:\n              break\n          for act, (dr, dc) in moves:\n              nr, nc = cur[0] + dr, cur[1] + dc\n              if not (0 <= nr < height and 0 <= nc < width):\n                  continue\n              nxt = (nr, nc)\n              # Allow stepping onto the target even if occupied.\n              if nxt != target and state.grid[nr, nc].any():\n                  continue\n              if nxt in visited:\n                  continue\n              visited.add(nxt)\n              parent[nxt] = (cur, act)\n              queue.append(nxt)\n\n      if target not in parent and start != target:\n          return []   # No path found\n\n      # Reconstruct path\n      path = []\n      cur = target\n      while cur != start:\n          prev, act = parent[cur]\n          path.append(act)\n          cur = prev\n      path.reverse()\n      return path\n\n  # ------------------------------------------------------------------\n  # 1. Collect each required primitive (respecting multiplicities).\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      # Collect until we have enough in inventory.\n      while state.inventory[prim_idx] < needed_cnt:\n          # Find any cell that currently holds this primitive.\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # Primitive not present on the map \u2013 give up.\n              return actions\n          tr, tc = prim_cells[0]  # take the first occurrence\n\n          # Move to the primitive's cell.\n          move_seq = _bfs_path(state.pos, (tr, tc))\n          actions.extend(move_seq)\n          state.pos = (tr, tc)\n\n          # Pick it up.\n          actions.append(USE)\n\n          # Update our internal copy of the state.\n          state.inventory[prim_idx] += 1\n          state.grid[tr, tc, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 2. Go to the appropriate workshop and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      return actions                     # No workshop information.\n\n  workshop_idx = index[workshop_name]\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      return actions                     # No workshop on the map.\n\n  wr, wc = workshop_cells[0]\n\n  # Move to the workshop.\n  move_seq = _bfs_path(state.pos, (wr, wc))\n  actions.extend(move_seq)\n  state.pos = (wr, wc)\n\n  # Craft the arrow.\n  actions.append(USE)\n\n  return actions", "env_interactions": 28, "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T18:07:34.407952", "function_name": "make_arrow", "function_body": "  # Reset / obtain current state\n  try:\n      env.reset()\n  except Exception:\n      pass\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []\n\n  world = env.world\n  idx = world.cookbook.index\n\n  # Identify arrow goal and its recipe\n  try:\n      goal_idx = idx[\"arrow\"]\n  except Exception:\n      return []\n\n  primitives = world.cookbook.primitives_for(goal_idx)\n\n  workshop_name = None\n  for k, v in world.cookbook.recipes.get(goal_idx, {}).items():\n      if k in (\"_at\", \"_key\"):\n          workshop_name = v\n          break\n  if workshop_name is None:\n      return []\n  try:\n      workshop_idx = idx[workshop_name]\n  except Exception:\n      return []\n\n  # Local mutable copies for planning\n  pos = tuple(state.pos)                     # (x, y)\n  grid = state.grid.copy()                   # (W, H, n_kinds)\n  inventory = state.inventory.copy()\n  occupied = np.any(grid > 0, axis=2)        # bool matrix of blocked cells\n\n  plan = []\n\n  # Directions and action mapping (matches CraftLab.action_specs)\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # 0:DOWN, 1:UP, 2:LEFT, 3:RIGHT\n  USE = 4\n\n  from collections import deque\n\n  def bfs_adjacent(start, target, blocked):\n      \"\"\"Find a sequence of movement actions that brings the agent from *start*\n      to any empty cell that is 4\u2011connected to *target*.\n      Returns an empty list if no such path exists.\"\"\"\n      h, w = blocked.shape\n      tx, ty = target\n      goal_cells = []\n      for a, (dx, dy) in enumerate(DIRS):\n          gx, gy = tx + dx, ty + dy\n          if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:\n              goal_cells.append((gx, gy))\n      if not goal_cells:\n          return []\n      q = deque([(start, [])])\n      visited = {start}\n      while q:\n          (cx, cy), path = q.popleft()\n          if (cx, cy) in goal_cells:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []\n\n  def move_and_use(target, kind_idx):\n      \"\"\"Move adjacent to *target* (which contains *kind_idx*) and issue USE.\n      Updates simulated pos, grid, occupied, inventory.\n      Returns False on failure.\"\"\"\n      nonlocal pos, plan, grid, occupied, inventory\n      path = bfs_adjacent(pos, target, occupied)\n      if not path and pos != target:\n          return False\n      # Execute movement actions in the simulated state\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n      plan.extend(path)\n\n      # Perform the USE action\n      plan.append(USE)\n\n      tx, ty = target\n      if grid[tx, ty, kind_idx] > 0:\n          # Pick up the primitive or interact with workshop\n          grid[tx, ty, kind_idx] = 0\n          occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)\n          inventory[kind_idx] += 1\n      return True\n\n  # ----------------------------------------------------------------------\n  # Collect all required primitives\n  # ----------------------------------------------------------------------\n  for prim_idx, count in primitives.items():\n      for _ in range(count):\n          locations = np.argwhere(grid[:, :, prim_idx] > 0)\n          if locations.size == 0:\n              # Primitive not found; abort planning\n              return plan\n          # Choose the nearest instance (Manhattan distance)\n          dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n          target = tuple(locations[dists.argmin()])\n          if not move_and_use(target, prim_idx):\n              return plan\n\n  # ----------------------------------------------------------------------\n  # Move to the appropriate workshop and craft the arrow\n  # ----------------------------------------------------------------------\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      # Workshops are static; fall back to the original scenario grid\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          return plan\n\n  dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])\n  workshop_target = tuple(workshop_cells[dists.argmin()])\n\n  move_and_use(workshop_target, workshop_idx)\n\n  return plan", "env_interactions": 23, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T18:07:35.526809", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Ensure the environment is reset to obtain a fresh state\n  try:\n      env.reset()\n  except Exception:\n      pass\n\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []\n\n  world = env.world\n  idx = world.cookbook.index\n\n  # Identify the goal item \"arrow\"\n  try:\n      goal_idx = idx[\"arrow\"]\n  except Exception:\n      return []  # Arrow not defined in this world\n\n  # Primitive requirements for a single arrow\n  primitives_needed = world.cookbook.primitives_for(goal_idx)\n\n  # Determine the workshop required for crafting the arrow\n  workshop_name = None\n  for k, v in world.cookbook.recipes.get(goal_idx, {}).items():\n      if k.startswith(\"_\"):\n          workshop_name = v\n          break\n  if workshop_name is None:\n      return []\n  try:\n      workshop_idx = idx[workshop_name]\n  except Exception:\n      return []\n\n  # Local mutable copies for planning\n  pos = tuple(state.pos)                     # (x, y)\n  grid = state.grid.copy()                   # (W, H, n_kinds)\n  inventory = state.inventory.copy()\n  occupied = np.any(grid > 0, axis=2)        # bool matrix of blocked cells\n  plan = []\n\n  # Action mapping (matches CraftLab.action_specs)\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # 0:DOWN, 1:UP, 2:LEFT, 3:RIGHT\n  USE = 4\n\n  primitives_set = world.cookbook.primitives\n\n  def bfs_adjacent(start, target, blocked):\n      \"\"\"Find a sequence of movement actions that brings the agent from *start*\n      to any empty cell that is 4\u2011connected to *target*.\"\"\"\n      h, w = blocked.shape\n      tx, ty = target\n      goal_cells = []\n      for a, (dx, dy) in enumerate(DIRS):\n          gx, gy = tx + dx, ty + dy\n          if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:\n              goal_cells.append((gx, gy))\n      if not goal_cells:\n          return []\n      q = deque([(start, [])])\n      visited = {start}\n      while q:\n          (cx, cy), path = q.popleft()\n          if (cx, cy) in goal_cells:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []\n\n  def move_and_use(target, kind_idx):\n      \"\"\"Move adjacent to *target* (which contains *kind_idx*) and issue USE.\n      Updates simulated position, grid, occupied, and inventory.\n      Returns False on failure.\"\"\"\n      nonlocal pos, plan, grid, occupied, inventory\n      path = bfs_adjacent(pos, target, occupied)\n      if not path and pos != target:\n          return False\n      # Execute movement actions\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n      plan.extend(path)\n\n      # Perform USE action\n      plan.append(USE)\n\n      tx, ty = target\n      if grid[tx, ty, kind_idx] > 0:\n          if kind_idx in primitives_set:\n              # Pick up primitive (consume from the world)\n              grid[tx, ty, kind_idx] = 0\n              occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)\n              inventory[kind_idx] += 1\n          # Workshops or other non\u2011primitive entities are not removed\n      return True\n\n  # ----------------------------------------------------------------------\n  # Collect all required primitives\n  # ----------------------------------------------------------------------\n  for prim_idx, count in primitives_needed.items():\n      for _ in range(count):\n          locations = np.argwhere(grid[:, :, prim_idx] > 0)\n          if locations.size == 0:\n              # Primitive not found \u2013 abort planning\n              return plan\n          # Choose the nearest instance (Manhattan distance)\n          dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n          target = tuple(locations[dists.argmin()])\n          if not move_and_use(target, prim_idx):\n              return plan\n\n  # ----------------------------------------------------------------------\n  # Move to the workshop and craft the arrow\n  # ----------------------------------------------------------------------\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      # Workshops are static; fall back to original scenario grid\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          return plan\n  dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])\n  workshop_target = tuple(workshop_cells[dists.argmin()])\n  move_and_use(workshop_target, workshop_idx)\n\n  return plan", "env_interactions": 0, "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-10-27T18:08:02.530230", "function_name": "make_arrow", "function_body": "  # Reset environment and obtain state/world information\n  env.reset()\n  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  # Identify the goal item and its recipe\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n  if goal_idx is None:\n      return []\n  primitive_needs = cookbook.primitives_for(goal_idx)          # {kind_idx: count}\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  if \"_at\" in recipe:\n      workshop_idx = cookbook.index[recipe[\"_at\"]]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  from collections import deque\n  import numpy as np\n\n  def bfs_path(start, goal, occupied):\n      \"\"\"Return a list of positions from start (excluded) to goal (included) or None.\"\"\"\n      w, h = occupied.shape\n      visited = np.zeros((w, h), dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start] = True\n      while q:\n          x, y = q.popleft()\n          if (x, y) == goal:\n              break\n          for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):\n              if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:\n                  # Allow stepping onto the goal even if occupied\n                  if (nx, ny) == goal or not occupied[nx, ny]:\n                      visited[nx, ny] = True\n                      prev[(nx, ny)] = (x, y)\n                      q.append((nx, ny))\n      if not visited[goal]:\n          return None\n      path = []\n      cur = goal\n      while cur != start:\n          path.append(cur)\n          cur = prev[cur]\n      path.reverse()\n      return path\n\n  def delta_to_action(dx, dy):\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise ValueError(\"Invalid movement delta\")\n\n  # ------------------------------------------------------------------\n  # Planning: collect primitives, then craft at workshop (if any)\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = tuple(state.pos)\n  grid = state.grid.copy()          # mutable copy to track collected items\n\n  # --- Collect required primitives -------------------------------------------------\n  for kind_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          locations = np.argwhere(grid[:, :, kind_idx] > 0)\n          if locations.size == 0:\n              break\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n          occupied_mask = np.any(grid, axis=2)\n          target = None\n          path = None\n          for idx in order:\n              cand = tuple(locations[idx])\n              p = bfs_path(cur_pos, cand, occupied_mask)\n              if p is not None:\n                  target = cand\n                  path = p\n                  break\n          if target is None:\n              continue\n          for step in path:\n              dx = step[0] - cur_pos[0]\n              dy = step[1] - cur_pos[1]\n              actions.append(delta_to_action(dx, dy))\n              cur_pos = step\n          actions.append(4)                     # USE to pick up\n          grid[target[0], target[1], kind_idx] = 0\n\n  # --- Move to workshop (if required) and craft -----------------------------------\n  if workshop_idx is not None:\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          dists = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n          occupied_mask = np.any(state.grid, axis=2)   # original grid (workshops are occupied)\n          for idx in order:\n              cand = tuple(workshop_cells[idx])\n              p = bfs_path(cur_pos, cand, occupied_mask)\n              if p is not None:\n                  for step in p:\n                      dx = step[0] - cur_pos[0]\n                      dy = step[1] - cur_pos[1]\n                      actions.append(delta_to_action(dx, dy))\n                      cur_pos = step\n                  actions.append(4)                 # USE to craft\n                  break\n  else:\n      actions.append(4)  # USE at current location if no workshop needed\n\n  return actions", "env_interactions": 26, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T18:08:03.650183", "function_name": "make_arrow", "function_body": "  # Reset environment and get current state/world information\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world\n  cookbook = world.cookbook\n\n  # Identify the goal item (\"arrow\") and its recipe\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n  if goal_idx is None:\n      return []\n  primitive_needs = cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  if \"_at\" in recipe:\n      workshop_idx = cookbook.index[recipe[\"_at\"]]\n\n  # Helper: BFS to find a walkable path from start to goal (allow stepping onto goal)\n  def bfs_path(start, goal, occupied):\n      w, h = occupied.shape\n      visited = np.full((w, h), False, dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start] = True\n      while q:\n          x, y = q.popleft()\n          if (x, y) == goal:\n              break\n          for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):\n              if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:\n                  # Goal cell may be occupied; treat it as walkable\n                  if (nx, ny) == goal or not occupied[nx, ny]:\n                      visited[nx, ny] = True\n                      prev[(nx, ny)] = (x, y)\n                      q.append((nx, ny))\n      if not visited[goal]:\n          return None\n      # reconstruct path (list of positions, excluding start, including goal)\n      path = []\n      cur = goal\n      while cur != start:\n          path.append(cur)\n          cur = prev[cur]\n      path.reverse()\n      return path\n\n  # Helper: translate a step delta into an action index\n  def step_to_action(dx, dy):\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise ValueError(\"Invalid step delta\")\n\n  actions = []\n  cur_pos = tuple(state.pos)\n  # mutable copy of the grid to keep track of collected primitives\n  grid = state.grid.copy()\n\n  # ----------------------------------------------------------------------\n  # Collect all required primitives\n  # ----------------------------------------------------------------------\n  for kind_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          # locate remaining cells containing this primitive\n          locations = np.argwhere(grid[:, :, kind_idx] > 0)\n          if locations.size == 0:\n              break  # nothing left of this kind\n          # sort by Manhattan distance from current position\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n          occupied_mask = np.any(grid, axis=2)   # cells occupied by any entity\n          target = None\n          path = None\n          for idx in order:\n              cand = tuple(locations[idx])\n              p = bfs_path(cur_pos, cand, occupied_mask)\n              if p is not None:\n                  target = cand\n                  path = p\n                  break\n          if target is None:\n              continue  # cannot reach any remaining instance\n          # follow the path\n          for step in path:\n              dx = step[0] - cur_pos[0]\n              dy = step[1] - cur_pos[1]\n              actions.append(step_to_action(dx, dy))\n              cur_pos = step\n          # pick up the primitive\n          actions.append(4)                     # USE\n          grid[target[0], target[1], kind_idx] = 0\n\n  # ----------------------------------------------------------------------\n  # Go to the workshop (if required) and craft the arrow\n  # ----------------------------------------------------------------------\n  if workshop_idx is not None:\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          dists = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n          occupied_mask = np.any(state.grid, axis=2)   # original grid (workshops are occupied)\n          for idx in order:\n              cand = tuple(workshop_cells[idx])\n              p = bfs_path(cur_pos, cand, occupied_mask)\n              if p is not None:\n                  for step in p:\n                      dx = step[0] - cur_pos[0]\n                      dy = step[1] - cur_pos[1]\n                      actions.append(step_to_action(dx, dy))\n                      cur_pos = step\n                  actions.append(4)                 # USE to craft\n                  break\n  else:\n      # No specific workshop required; just use at current location\n      actions.append(4)  # USE\n\n  return actions", "env_interactions": 0, "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-10-27T18:08:27.222170", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  # target item\n  goal_name = \"arrow\"\n  goal_idx = idx[goal_name]\n\n  # primitives needed for one instance\n  prim_counts = world.cookbook.primitives_for(goal_idx)\n\n  # workshop (if any) required for crafting\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else idx[wk]\n\n  # ------------------------------------------------------------------\n  # helper utilities\n  # ------------------------------------------------------------------\n  def find_locs(kind):\n      \"\"\"Return list of (x, y) where `kind` appears on the current grid.\"\"\"\n      occ = np.where(state.grid[:, :, kind] > 0)\n      return list(zip(occ[0].tolist(), occ[1].tolist()))\n\n  def bfs(start, goal):\n      \"\"\"Shortest path (list of positions) from start to goal avoiding non\u2011grabbable cells.\"\"\"\n      if start == goal:\n          return [start]\n      W, H = state.grid.shape[:2]\n\n      # blocked cells = non\u2011grabbable entities\n      blocked = set()\n      for ng in world.non_grabbable_indices:\n          occ = np.where(state.grid[:, :, ng] > 0)\n          blocked.update(zip(occ[0].tolist(), occ[1].tolist()))\n\n      q = collections.deque([start])\n      prev = {start: None}\n      while q:\n          cur = q.popleft()\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:\n                  nxt = (nx, ny)\n                  if nxt not in prev:\n                      prev[nxt] = cur\n                      if nxt == goal:\n                          # reconstruct\n                          path = [goal]\n                          while path[-1] != start:\n                              path.append(prev[path[-1]])\n                          path.reverse()\n                          return path\n                      q.append(nxt)\n      # no path \u2013 stay put\n      return [start]\n\n  def move_act(cur, nxt):\n      \"\"\"Translate a step from cur to adjacent nxt into an action index.\"\"\"\n      dx, dy = nxt[0] - cur[0], nxt[1] - cur[1]\n      if dx == 1:\n          return 3   # RIGHT\n      if dx == -1:\n          return 2   # LEFT\n      if dy == 1:\n          return 0   # DOWN\n      if dy == -1:\n          return 1   # UP\n      raise AssertionError(\"Non\u2011adjacent move requested\")\n\n  # ------------------------------------------------------------------\n  # build action list\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = state.pos\n\n  # 1) collect needed primitives\n  for p_idx, needed in prim_counts.items():\n      while state.inventory[p_idx] < needed:\n          locations = find_locs(p_idx)\n          if not locations:\n              # cannot find more \u2013 abort loop to avoid infinite wait\n              break\n          # nearest by Manhattan distance\n          target = min(locations,\n                       key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1]))\n          path = bfs(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_act(cur_pos, step))\n              cur_pos = step\n          # pick up\n          actions.append(4)   # USE\n          state.inventory[p_idx] += 1\n          state.grid[target[0], target[1], p_idx] = 0\n\n  # 2) go to workshop (if any) and craft\n  if workshop_kind is not None:\n      wk_locs = find_locs(workshop_kind)\n      if wk_locs:\n          target = min(wk_locs,\n                       key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1]))\n          path = bfs(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_act(cur_pos, step))\n              cur_pos = step\n      actions.append(4)   # USE to craft\n  else:\n      actions.append(4)   # USE to craft at current spot\n\n  return actions", "env_interactions": 19, "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T18:08:28.342644", "function_name": "make_arrow", "function_body": "  # Reset environment and obtain current state/world information\n  env.reset()\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  # Goal definition (arrow)\n  goal_name = \"arrow\"\n  goal_idx = idx[goal_name]\n\n  # Primitive resources required for one arrow\n  primitive_counts = world.cookbook.primitives_for(goal_idx)\n\n  # Workshop required for crafting the arrow (if any)\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else idx[wk]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def find_locations(kind):\n      \"\"\"Return a list of (x, y) positions where `kind` is present on the grid.\"\"\"\n      occ = np.where(state.grid[:, :, kind] > 0)\n      return list(zip(occ[0].tolist(), occ[1].tolist()))\n\n  def bfs_path(start, goal):\n      \"\"\"Return the shortest path (list of positions) from start to goal,\n      avoiding non\u2011grabbable cells.\"\"\"\n      if start == goal:\n          return [start]\n      W, H = state.grid.shape[:2]\n\n      # Build set of blocked cells (non\u2011grabbable entities)\n      blocked = set()\n      for ng in world.non_grabbable_indices:\n          occ = np.where(state.grid[:, :, ng] > 0)\n          blocked.update(zip(occ[0].tolist(), occ[1].tolist()))\n\n      q = collections.deque([start])\n      prev = {start: None}\n      while q:\n          cur = q.popleft()\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:\n                  nxt = (nx, ny)\n                  if nxt not in prev:\n                      prev[nxt] = cur\n                      if nxt == goal:\n                          # Reconstruct path\n                          path = [goal]\n                          while path[-1] != start:\n                              path.append(prev[path[-1]])\n                          path.reverse()\n                          return path\n                      q.append(nxt)\n      # No path found \u2013 stay where we are\n      return [start]\n\n  def move_action(cur, nxt):\n      \"\"\"Translate a step from `cur` to adjacent `nxt` into an action index.\"\"\"\n      dx, dy = nxt[0] - cur[0], nxt[1] - cur[1]\n      if dx == 1:\n          return 3   # RIGHT\n      if dx == -1:\n          return 2   # LEFT\n      if dy == 1:\n          return 0   # DOWN\n      if dy == -1:\n          return 1   # UP\n      raise AssertionError(\"Requested move is not adjacent\")\n\n  # ------------------------------------------------------------------\n  # Build the action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = state.pos\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitive_counts.items():\n      while state.inventory[prim_idx] < needed:\n          locations = find_locations(prim_idx)\n          if not locations:\n              # No more of this primitive on the map \u2013 abort collection loop\n              break\n\n          # Choose the nearest instance (Manhattan distance)\n          target = min(\n              locations,\n              key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1])\n          )\n\n          # Move to the target\n          path = bfs_path(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n\n          # Pick it up\n          actions.append(4)   # USE\n          # Update simulated inventory and grid to avoid revisiting\n          state.inventory[prim_idx] += 1\n          state.grid[target[0], target[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 2) Move to the workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      wk_locations = find_locations(workshop_kind)\n      if wk_locations:\n          target = min(\n              wk_locations,\n              key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1])\n          )\n          path = bfs_path(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n      # Craft at the workshop\n      actions.append(4)   # USE\n  else:\n      # No specific workshop \u2013 craft wherever we are\n      actions.append(4)   # USE\n\n  return actions", "env_interactions": 19, "island_id": 3, "scores": {"3": 1.5}}
