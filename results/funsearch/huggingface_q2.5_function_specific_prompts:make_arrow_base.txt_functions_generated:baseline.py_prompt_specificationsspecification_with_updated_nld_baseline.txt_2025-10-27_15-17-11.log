{"timestamp": "2025-10-27T17:45:08.840502", "function_name": "make_arrow", "function_body": "  # Reset environment and gather core objects\n  _ = env.reset()\n  scenario = env.scenario\n  world = scenario.world\n  state = env._current_state\n\n  # Action mapping (name \u2192 integer)\n  act_map = env.action_specs()\n\n  # Directions and their deltas (row, col)\n  moves = [\n      (\"DOWN\", (1, 0)),\n      (\"UP\", (-1, 0)),\n      (\"RIGHT\", (0, 1)),\n      (\"LEFT\", (0, -1)),\n  ]\n  dir_to_delta = {name: delta for name, delta in moves}\n\n  # Goal index for the task\n  goal_idx = env.task.goal\n\n  # Primitive requirements and workshop (if any)\n  primitives_needed = world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n\n  # Working copy of the grid and occupancy mask\n  grid = state.grid.copy()                     # shape (W, H, n_kinds)\n  occupied = grid.sum(axis=2) > 0              # True where any entity occupies\n\n  # Current agent position (row, col)\n  cur_pos = state.pos\n\n  # Accumulate actions to return\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper: BFS to any empty neighbour of a target cell\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  def bfs_to_adjacent(start, target):\n      tr, tc = target\n      # All empty neighbour cells of the target\n      adjacent = [\n          (tr + dr, tc + dc)\n          for _, (dr, dc) in moves\n          if 0 <= tr + dr < occupied.shape[0]\n          and 0 <= tc + dc < occupied.shape[1]\n          and not occupied[tr + dr, tc + dc]\n      ]\n      if not adjacent:\n          return []  # no reachable adjacent cell\n\n      q = deque([start])\n      parent = {start: None}\n      parent_move = {}\n\n      while q:\n          cur = q.popleft()\n          if cur in adjacent:\n              # reconstruct path of direction names\n              path = []\n              while parent[cur] is not None:\n                  path.append(parent_move[cur])\n                  cur = parent[cur]\n              path.reverse()\n              return path\n\n          r, c = cur\n          for name, (dr, dc) in moves:\n              nr, nc = r + dr, c + dc\n              if (\n                  0 <= nr < occupied.shape[0]\n                  and 0 <= nc < occupied.shape[1]\n                  and not occupied[nr, nc]\n                  and (nr, nc) not in parent\n              ):\n                  parent[(nr, nc)] = cur\n                  parent_move[(nr, nc)] = name\n                  q.append((nr, nc))\n      return []  # unreachable\n\n  # ------------------------------------------------------------------\n  # Helper: append actions for a list of direction names and update pos\n  # ------------------------------------------------------------------\n  def follow_path(path_dirs):\n      nonlocal cur_pos\n      for dname in path_dirs:\n          actions.append(act_map[dname])\n          dr, dc = dir_to_delta[dname]\n          cur_pos = (cur_pos[0] + dr, cur_pos[1] + dc)\n\n  # ------------------------------------------------------------------\n  # Collect required primitives\n  # ------------------------------------------------------------------\n  for kind_idx, needed_cnt in primitives_needed.items():\n      for _ in range(needed_cnt):\n          # locate remaining instances of this primitive\n          cells = list(zip(*np.where(grid[:, :, kind_idx] > 0)))\n          if not cells:\n              # nothing left \u2013 abort early\n              break\n\n          # choose the closest by Manhattan distance\n          target = min(cells, key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))\n\n          # move to an empty neighbour of the primitive\n          path = bfs_to_adjacent(cur_pos, target)\n          follow_path(path)\n\n          # pick it up\n          actions.append(act_map[\"USE\"])\n\n          # update grid/occupancy: primitive disappears\n          r, c = target\n          grid[r, c, :] = 0\n          occupied[r, c] = False\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if required) and craft the goal item\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      # locate a workshop cell (prefer one still present in the mutable grid)\n      ws_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n      if not ws_cells:\n          # fall back to original scenario grid\n          ws_cells = list(zip(*np.where(scenario.init_grid[:, :, workshop_kind] > 0)))\n      if ws_cells:\n          target_ws = ws_cells[0]\n          path = bfs_to_adjacent(cur_pos, target_ws)\n          follow_path(path)\n          actions.append(act_map[\"USE\"])\n\n  return actions", "env_interactions": 0, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T17:45:09.959809", "function_name": "make_arrow", "function_body": "  # Reset the environment to a fresh state.\n  env.reset()\n\n  # Mapping from action names (e.g., \"DOWN\") to integer action codes used by the env.\n  act_map = env.action_specs()\n\n  # Direction vectors used for movement.\n  moves = [\n      (\"DOWN\", (1, 0)),\n      (\"UP\", (-1, 0)),\n      (\"RIGHT\", (0, 1)),\n      (\"LEFT\", (0, -1)),\n  ]\n  dir_to_delta = {name: delta for name, delta in moves}\n\n  # ----------------------------------------------------------------------\n  # Helper: breadth\u2011first search that returns a list of action names moving\n  # the agent from `start` to any empty cell adjacent to `target`.\n  # ----------------------------------------------------------------------\n  def bfs_adjacent(start, target, occupied):\n      tr, tc = target\n      # All empty neighbours of the target cell.\n      adjacent = [\n          (tr + dr, tc + dc)\n          for _, (dr, dc) in moves\n          if 0 <= tr + dr < occupied.shape[0]\n          and 0 <= tc + dc < occupied.shape[1]\n          and not occupied[tr + dr, tc + dc]\n      ]\n      if not adjacent:\n          return []  # No reachable neighbour.\n\n      from collections import deque\n\n      q = deque([start])\n      parent = {start: None}\n      parent_move = {}\n\n      while q:\n          cur = q.popleft()\n          if cur in adjacent:\n              # Reconstruct the path of action names.\n              path = []\n              while parent[cur] is not None:\n                  path.append(parent_move[cur])\n                  cur = parent[cur]\n              path.reverse()\n              return path\n\n          r, c = cur\n          for name, (dr, dc) in moves:\n              nr, nc = r + dr, c + dc\n              if (\n                  0 <= nr < occupied.shape[0]\n                  and 0 <= nc < occupied.shape[1]\n                  and not occupied[nr, nc]\n                  and (nr, nc) not in parent\n              ):\n                  parent[(nr, nc)] = cur\n                  parent_move[(nr, nc)] = name\n                  q.append((nr, nc))\n      return []  # No path found.\n\n  # ----------------------------------------------------------------------\n  # Helper: execute a sequence of direction names, updating `cur_pos`\n  # and appending the corresponding integer actions to `actions`.\n  # ----------------------------------------------------------------------\n  def follow(path_dirs):\n      nonlocal cur_pos\n      for dname in path_dirs:\n          actions.append(act_map[dname])\n          dr, dc = dir_to_delta[dname]\n          cur_pos = (cur_pos[0] + dr, cur_pos[1] + dc)\n\n  # ----------------------------------------------------------------------\n  # Gather task\u2011specific information from the environment.\n  # ----------------------------------------------------------------------\n  scenario = env.scenario\n  world = scenario.world\n  goal_idx = env.task.goal  # integer index of the desired item.\n\n  # Primitive requirements and optional workshop for the goal.\n  primitives_needed = world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n\n  # Working copies of the grid and a boolean occupancy mask.\n  grid = scenario.init_grid.copy()\n  occupied = grid.sum(axis=2) > 0  # True where any entity occupies the cell.\n\n  # Current agent state.\n  cur_pos = scenario.init_pos  # (row, col)\n\n  # List that will hold the final action sequence.\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # 1) Collect each required primitive the necessary number of times.\n  # ----------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      for _ in range(needed_cnt):\n          # Locate remaining instances of this primitive.\n          prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not prim_cells:\n              # No more of this primitive left; abort early.\n              break\n\n          # Choose the closest instance (Manhattan distance).\n          target = min(\n              prim_cells,\n              key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]),\n          )\n\n          # Move to an empty neighbour of the target cell.\n          path = bfs_adjacent(cur_pos, target, occupied)\n          follow(path)\n\n          # Pick up the primitive.\n          actions.append(act_map[\"USE\"])\n\n          # Update the grid and occupancy mask: the primitive disappears.\n          r, c = target\n          grid[r, c, :] = 0\n          occupied[r, c] = False\n\n  # ----------------------------------------------------------------------\n  # 2) If the recipe requires a workshop, move there and craft the item.\n  # ----------------------------------------------------------------------\n  if workshop_kind is not None:\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n      if not workshop_cells:\n          # Fallback to the original scenario grid if the workshop was removed.\n          workshop_cells = list(\n              zip(*np.where(scenario.init_grid[:, :, workshop_kind] > 0))\n          )\n      if workshop_cells:\n          target_ws = workshop_cells[0]  # any workshop will do.\n          path = bfs_adjacent(cur_pos, target_ws, occupied)\n          follow(path)\n          actions.append(act_map[\"USE\"])\n\n  return actions", "env_interactions": 0, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T17:45:38.465588", "function_name": "make_arrow", "function_body": "  # Reset environment to start fresh\n  env.reset()\n  world = env.world\n  scenario = env.scenario\n  state = env._current_state\n\n  # Goal index (the item we ultimately want to craft)\n  goal_idx = env.task.goal\n\n  # ------------------------------------------------------------------\n  # Helper to compute Manhattan move sequence (actions: 0=DOWN,1=UP,2=LEFT,3=RIGHT)\n  # ------------------------------------------------------------------\n  def moves_to(start, target):\n      x, y = start\n      tx, ty = target\n      seq = []\n      while x < tx:\n          seq.append(3)   # RIGHT\n          x += 1\n      while x > tx:\n          seq.append(2)   # LEFT\n          x -= 1\n      while y < ty:\n          seq.append(0)   # DOWN\n          y += 1\n      while y > ty:\n          seq.append(1)   # UP\n          y -= 1\n      return seq, (x, y)\n\n  # ------------------------------------------------------------------\n  # Helper to locate the nearest cell containing a given kind.\n  # For primitives we avoid cells already harvested; for workshops we ignore that.\n  # ------------------------------------------------------------------\n  harvested = {}\n\n  def nearest_cell(kind, from_pos, avoid_harvested=True):\n      cells = np.argwhere(scenario.init_grid[:, :, kind] > 0)\n      if cells.size == 0:\n          return None\n      if avoid_harvested:\n          used = harvested.get(kind, set())\n          candidates = [tuple(c) for c in cells if tuple(c) not in used]\n      else:\n          candidates = [tuple(c) for c in cells]\n      if not candidates:\n          return None\n      dists = [abs(c[0] - from_pos[0]) + abs(c[1] - from_pos[1]) for c in candidates]\n      return candidates[int(np.argmin(dists))]\n\n  # ------------------------------------------------------------------\n  # 1) Gather all primitive resources needed for the final goal\n  # ------------------------------------------------------------------\n  required_prims = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n  cur_pos = tuple(state.pos)\n  actions = []\n\n  for prim_kind, cnt in required_prims.items():\n      harvested.setdefault(prim_kind, set())\n      for _ in range(cnt):\n          target = nearest_cell(prim_kind, cur_pos)\n          if target is None:\n              # No remaining primitive of this kind on the map \u2013 give up\n              continue\n          move_seq, cur_pos = moves_to(cur_pos, target)\n          actions.extend(move_seq)\n          actions.append(4)                     # USE to pick up\n          harvested[prim_kind].add(target)      # mark as consumed\n\n  # ------------------------------------------------------------------\n  # 2) Determine crafting order (post\u2011order DFS over recipe graph)\n  # ------------------------------------------------------------------\n  recipes = world.cookbook.recipes\n  primitives_set = world.cookbook.primitives\n\n  order = []\n  visited = set()\n\n  def dfs(item):\n      if item in visited:\n          return\n      visited.add(item)\n      rec = recipes.get(item, {})\n      for ing, _ in rec.items():\n          if ing == \"_at\":\n              continue\n          if ing not in primitives_set:\n              dfs(ing)\n      order.append(item)\n\n  dfs(goal_idx)          # order now contains intermediates then goal\n\n  # ------------------------------------------------------------------\n  # 3) Execute crafting steps following the order\n  # ------------------------------------------------------------------\n  for item in order:\n      rec = recipes.get(item, {})\n      wk_kind = None\n      if \"_at\" in rec:\n          wk = rec[\"_at\"]\n          wk_kind = wk if isinstance(wk, int) else world.cookbook.index[wk]\n\n      if wk_kind is not None:\n          # Move to nearest workshop of the required type\n          target = nearest_cell(wk_kind, cur_pos, avoid_harvested=False)\n          if target is not None:\n              move_seq, cur_pos = moves_to(cur_pos, target)\n              actions.extend(move_seq)\n\n      # Perform the craft (or final craft) with a USE action\n      actions.append(4)\n\n  return actions", "env_interactions": 1, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T17:45:39.589906", "function_name": "make_arrow", "function_body": "  env.reset()\n  world = env.world\n  scenario = env.scenario\n  state = env._current_state\n\n  # index of the item we need to craft (arrow)\n  goal_idx = env.task.goal\n\n  # primitive resources (including transitive) needed for the goal\n  required = world.cookbook.primitives_for(goal_idx)\n\n  # determine if the final crafting must happen at a specific workshop\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else world.cookbook.index[wk]\n\n  actions: list[int] = []\n  cur_pos = tuple(state.pos)\n\n  # ------------------------------------------------------------------\n  # Helper: generate a Manhattan move sequence (DOWN=0, UP=1, LEFT=2, RIGHT=3)\n  # ------------------------------------------------------------------\n  def moves_to(start: tuple[int, int], target: tuple[int, int]) -> tuple[list[int], tuple[int, int]]:\n      x, y = start\n      tx, ty = target\n      seq: list[int] = []\n      while x < tx:\n          seq.append(3)   # RIGHT\n          x += 1\n      while x > tx:\n          seq.append(2)   # LEFT\n          x -= 1\n      while y < ty:\n          seq.append(0)   # DOWN\n          y += 1\n      while y > ty:\n          seq.append(1)   # UP\n          y -= 1\n      return seq, (x, y)\n\n  # ------------------------------------------------------------------\n  # Helper: locate the nearest cell that currently contains at least one\n  # instance of `kind`.  We ignore cells that have already been harvested.\n  # ------------------------------------------------------------------\n  harvested: dict[int, set[tuple[int, int]]] = {}\n\n  def nearest_cell(kind: int, from_pos: tuple[int, int]) -> tuple[int, int] | None:\n      cells = np.argwhere(scenario.init_grid[:, :, kind] > 0)\n      if cells.size == 0:\n          return None\n      used = harvested.get(kind, set())\n      candidates = [tuple(c) for c in cells if tuple(c) not in used]\n      if not candidates:\n          return None\n      dists = [abs(c[0] - from_pos[0]) + abs(c[1] - from_pos[1]) for c in candidates]\n      return candidates[int(np.argmin(dists))]\n\n  # ------------------------------------------------------------------\n  # Collect all required primitive items\n  # ------------------------------------------------------------------\n  for kind, cnt in required.items():\n      harvested.setdefault(kind, set())\n      for _ in range(cnt):\n          target = nearest_cell(kind, cur_pos)\n          if target is None:\n              # No more of this primitive on the map \u2013 skip\n              continue\n          move_seq, cur_pos = moves_to(cur_pos, target)\n          actions.extend(move_seq)\n          actions.append(4)               # USE to pick up the primitive\n          harvested[kind].add(target)     # mark cell as consumed\n\n  # ------------------------------------------------------------------\n  # Move to the workshop (if required) and perform the final craft\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      target = nearest_cell(workshop_kind, cur_pos)\n      if target is not None:\n          move_seq, cur_pos = moves_to(cur_pos, target)\n          actions.extend(move_seq)\n\n  # Final USE triggers the crafting of the goal item\n  actions.append(4)\n\n  return actions", "env_interactions": 1, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T17:45:58.831909", "function_name": "make_arrow", "function_body": "  # Reset environment and obtain initial state/world\n  env.reset()\n  state = env._current_state\n  world = env.world\n\n  # Goal index and primitive requirements\n  goal_idx = env.task.goal\n  required = world.cookbook.primitives_for(goal_idx)\n\n  # Action mapping\n  act_map = env.action_specs()\n  ACTION_DOWN = act_map['DOWN']\n  ACTION_UP = act_map['UP']\n  ACTION_LEFT = act_map['LEFT']\n  ACTION_RIGHT = act_map['RIGHT']\n  ACTION_USE = act_map['USE']\n\n  # Directions paired with corresponding movement actions\n  move_dirs = [\n      (1, 0, ACTION_DOWN),   # down\n      (-1, 0, ACTION_UP),    # up\n      (0, -1, ACTION_LEFT),  # left\n      (0, 1, ACTION_RIGHT),  # right\n  ]\n\n  actions = []\n\n  from collections import deque\n\n  def find_path(cur_state, target_kind):\n      \"\"\"Breadth\u2011first search returning a list of movement actions that leads\n      the agent to any cell containing `target_kind`. The agent may step onto\n      that cell even if it is occupied; otherwise it may only step onto empty\n      cells.\"\"\"\n      grid = cur_state.grid\n      H, W, _ = grid.shape\n      start = cur_state.pos\n      visited = {start}\n      q = deque([(start, [])])\n\n      while q:\n          (x, y), path = q.popleft()\n          if grid[x, y, target_kind] > 0:\n              return path\n          for dx, dy, act in move_dirs:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < H and 0 <= ny < W):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              cell = grid[nx, ny, :]\n              # Allow moving onto empty cells or directly onto the target cell\n              if cell.sum() == 0 or cell[target_kind] > 0:\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [act]))\n      # Unreachable (should not happen in valid scenarios)\n      return []\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitive items.\n  # ------------------------------------------------------------------\n  for kind, cnt in required.items():\n      for _ in range(cnt):\n          path = find_path(state, kind)\n          for a in path:\n              _, state = state.step(a)\n              actions.append(a)\n          # Pick up the primitive\n          _, state = state.step(ACTION_USE)\n          actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # 2) Go to the workshop (if any) and craft the goal item.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get('_at')\n  if workshop_kind is not None:\n      path = find_path(state, workshop_kind)\n      for a in path:\n          _, state = state.step(a)\n          actions.append(a)\n      # Use the workshop to craft\n      _, state = state.step(ACTION_USE)\n      actions.append(ACTION_USE)\n\n  return actions", "env_interactions": 0, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T17:45:59.967140", "function_name": "make_arrow", "function_body": "  # Reset the environment and get the initial state/world objects\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n\n  # Goal item index and the primitive requirements for crafting it\n  goal_idx = env.task.goal\n  required = world.cookbook.primitives_for(goal_idx)\n\n  # Action indices (consistent with CraftLab's action_specs)\n  # If action_specs is available, use it to be safe; otherwise fall back to defaults.\n  try:\n      act_map = env.action_specs()\n      ACTION_DOWN = act_map['DOWN']\n      ACTION_UP = act_map['UP']\n      ACTION_LEFT = act_map['LEFT']\n      ACTION_RIGHT = act_map['RIGHT']\n      ACTION_USE = act_map['USE']\n  except Exception:\n      ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  # Directions paired with the corresponding movement action\n  move_dirs = [\n      (1, 0, ACTION_DOWN),\n      (-1, 0, ACTION_UP),\n      (0, -1, ACTION_LEFT),\n      (0, 1, ACTION_RIGHT),\n  ]\n\n  actions = []\n\n  from collections import deque\n\n  def find_path(cur_state, target_kind):\n      \"\"\"\n      Breadth\u2011first search that returns a list of movement actions leading\n      the agent to any cell containing `target_kind`. The agent may step\n      onto empty cells or directly onto the target cell; all other cells\n      are considered blocked.\n      \"\"\"\n      grid = cur_state.grid\n      H, W, _ = grid.shape\n      start = cur_state.pos\n      visited = {start}\n      q = deque([(start, [])])\n\n      while q:\n          (x, y), path = q.popleft()\n          if grid[x, y, target_kind] > 0:\n              return path\n          for dx, dy, act in move_dirs:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < H and 0 <= ny < W):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              # Allow moving onto empty cells or the cell that already holds the target kind\n              if grid[nx, ny, :].sum() == 0 or grid[nx, ny, target_kind] > 0:\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [act]))\n      # Should not happen in a well\u2011formed scenario; return empty path as fallback\n      return []\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitive items.\n  # ------------------------------------------------------------------\n  for kind, cnt in required.items():\n      for _ in range(cnt):\n          path = find_path(state, kind)\n          for act in path:\n              _, state = state.step(act)\n              actions.append(act)\n          # Use the primitive (pick it up / interact)\n          _, state = state.step(ACTION_USE)\n          actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # 2) Go to the appropriate workshop (if any) and craft the goal item.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get('_at')\n  if workshop_kind is not None:\n      path = find_path(state, workshop_kind)\n      for act in path:\n          _, state = state.step(act)\n          actions.append(act)\n      # Use the workshop to perform the crafting action\n      _, state = state.step(ACTION_USE)\n      actions.append(ACTION_USE)\n\n  # Return the complete action sequence that solves the task\n  return actions", "env_interactions": 0, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T17:46:26.613319", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Ensure a fresh episode.\n  env.reset()\n  state = env._current_state          # type: CraftState\n  world = env.world\n\n  # Goal index and required primitive counts.\n  goal_idx = env.task.goal\n  needed = world.cookbook.primitives_for(goal_idx).copy()\n\n  # Determine if a specific workshop is required.\n  workshop_idx = None\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  if \"_at\" in recipe:\n      workshop_name = recipe[\"_at\"]\n      workshop_idx = world.cookbook.index[workshop_name]\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper utilities.\n  # ------------------------------------------------------------------\n  def locate(kind):\n      \"\"\"Return a list of (x, y) positions where `kind` is present on the grid.\"\"\"\n      inds = np.argwhere(state.grid[:, :, kind] > 0)\n      return [tuple(p) for p in inds]\n\n  def bfs_path(start, target):\n      \"\"\"\n      Bread\u2011first search returning a list of movement actions (0\u2011DOWN,1\u2011UP,2\u2011LEFT,3\u2011RIGHT)\n      that brings the agent from `start` to `target`.  Cells occupied by any entity are\n      considered blocked, except the target cell itself (which may hold the primitive or\n      workshop we want to interact with).\n      \"\"\"\n      occ = np.any(state.grid > 0, axis=2)          # True where blocked.\n      w, h = occ.shape\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          pos, path = q.popleft()\n          if pos == target:\n              return path\n          x, y = pos\n          for act, (dx, dy) in ((0, (0, 1)), (1, (0, -1)),\n                                (2, (-1, 0)), (3, (1, 0))):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h:\n                  # Allow stepping onto the target even if it is currently occupied.\n                  if not occ[nx, ny] or (nx, ny) == target:\n                      if (nx, ny) not in visited:\n                          visited.add((nx, ny))\n                          q.append(((nx, ny), path + [act]))\n      # No path found \u2013 return empty list (caller may decide what to do).\n      return []\n\n  def move_to(target):\n      \"\"\"Move the agent from its current location to `target`, recording actions.\"\"\"\n      nonlocal state\n      for act in bfs_path(state.pos, target):\n          actions.append(act)\n          _, state = state.step(act)\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives.\n  # ------------------------------------------------------------------\n  for kind, count in needed.items():\n      for _ in range(count):\n          positions = locate(kind)\n          if not positions:\n              # Primitive missing \u2013 abort planning early.\n              return actions\n          # Choose the nearest occurrence (Manhattan distance) to reduce travel.\n          target = min(positions,\n                       key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))\n          move_to(target)\n          # Pick up the primitive.\n          actions.append(4)          # USE action.\n          _, state = state.step(4)\n\n  # ------------------------------------------------------------------\n  # 2. Go to the required workshop (if any) and craft the goal.\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_positions = locate(workshop_idx)\n      if ws_positions:\n          target_ws = min(ws_positions,\n                         key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))\n          move_to(target_ws)\n          actions.append(4)          # USE to trigger crafting.\n          _, state = state.step(4)\n  else:\n      # No specific workshop \u2013 attempt to craft at the current location.\n      actions.append(4)\n      _, state = state.step(4)\n\n  return actions", "env_interactions": 1, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T17:46:27.746102", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Grab current state and world information\n  state = env._current_state          # CraftState\n  world = env.world\n  goal_idx = env.task.goal\n\n  # Determine primitive requirements for the goal\n  needed = world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  if \"_at\" in recipe:\n      workshop_idx = world.cookbook.index[recipe[\"_at\"]]\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def locate(kind):\n      \"\"\"Return a list of (x, y) positions where `kind` is present.\"\"\"\n      inds = np.argwhere(state.grid[:, :, kind] > 0)\n      return [tuple(p) for p in inds]\n\n  def bfs_path(start, target):\n      \"\"\"\n      Bread\u2011first search returning a list of movement actions (0\u2011DOWN,1\u2011UP,2\u2011LEFT,3\u2011RIGHT)\n      that moves the agent from `start` to `target`. The target cell may be occupied\n      (e.g., a primitive to pick up); all other cells must be free.\n      \"\"\"\n      occ = np.any(state.grid > 0, axis=2)          # True where any entity exists\n      width, height = occ.shape\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          pos, path = q.popleft()\n          if pos == target:\n              return path\n          x, y = pos\n          for act, (dx, dy) in ((0, (0, 1)), (1, (0, -1)),\n                                (2, (-1, 0)), (3, (1, 0))):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height:\n                  if not occ[nx, ny] or (nx, ny) == target:\n                      if (nx, ny) not in visited:\n                          visited.add((nx, ny))\n                          q.append(((nx, ny), path + [act]))\n      # No path found \u2013 return empty list (caller will stay put)\n      return []\n\n  def move_to(target):\n      \"\"\"Move agent from its current position to `target`, recording actions.\"\"\"\n      nonlocal state\n      for act in bfs_path(state.pos, target):\n          actions.append(act)\n          _, state = state.step(act)\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives\n  # ------------------------------------------------------------------\n  for kind, count in needed.items():\n      for _ in range(count):\n          positions = locate(kind)\n          if not positions:\n              # Primitive missing \u2013 abort early\n              return actions\n          # Choose the nearest occurrence to reduce travel distance\n          target = min(\n              positions,\n              key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1])\n          )\n          move_to(target)\n          # Pick up the primitive\n          actions.append(4)          # USE\n          _, state = state.step(4)\n\n  # ------------------------------------------------------------------\n  # 2. Go to workshop (if any) and craft the goal\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_positions = locate(workshop_idx)\n      if ws_positions:\n          target_ws = min(\n              ws_positions,\n              key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1])\n          )\n          move_to(target_ws)\n\n  # Trigger crafting (or simply use if no workshop is required)\n  actions.append(4)          # USE\n  _, state = state.step(4)\n\n  return actions", "env_interactions": 1, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T17:46:47.384420", "function_name": "make_arrow", "function_body": "  # Reset the environment and get handles to state and world objects\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n\n  # Identify the goal index and the primitive requirements for that goal\n  goal_idx = env.task.goal\n  required = world.cookbook.primitives_for(goal_idx)   # {primitive_kind: count}\n\n  # Action indices from the environment specification\n  act_map = env.action_specs()\n  ACTION_DOWN = act_map['DOWN']\n  ACTION_UP = act_map['UP']\n  ACTION_LEFT = act_map['LEFT']\n  ACTION_RIGHT = act_map['RIGHT']\n  ACTION_USE = act_map['USE']\n\n  # Direction vectors paired with their corresponding action ids\n  move_dirs = [\n      (1, 0, ACTION_DOWN),\n      (-1, 0, ACTION_UP),\n      (0, -1, ACTION_LEFT),\n      (0, 1, ACTION_RIGHT),\n  ]\n\n  import collections\n  import numpy as np\n\n  def find_path(cur_state, target_kind):\n      \"\"\"\n      Breadth\u2011first search returning a list of movement actions that brings\n      the agent to a cell containing `target_kind`. The search may step onto\n      empty cells or directly onto the target cell, but avoids any other\n      occupied cells.\n      \"\"\"\n      grid = cur_state.grid\n      H, W, _ = grid.shape\n      start = cur_state.pos\n      visited = {start}\n      q = collections.deque([(start, [])])\n\n      while q:\n          (x, y), path = q.popleft()\n          if grid[x, y, target_kind] > 0:\n              return path\n          for dx, dy, act in move_dirs:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < H and 0 <= ny < W):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              # Allow stepping onto the target cell even if occupied.\n              occupied = np.any(grid[nx, ny, :] > 0)\n              if occupied and grid[nx, ny, target_kind] == 0:\n                  continue\n              visited.add((nx, ny))\n              q.append(((nx, ny), path + [act]))\n      # If unreachable (should not happen in well\u2011formed scenarios), return empty.\n      return []\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitives the necessary number of times.\n  # ------------------------------------------------------------------\n  for prim_kind, count in required.items():\n      for _ in range(count):\n          path = find_path(state, prim_kind)\n          for a in path:\n              _, state = state.step(a)\n              actions.append(a)\n          # Pick up the primitive now under the agent.\n          _, state = state.step(ACTION_USE)\n          actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # 2) Move to the workshop (if any) and craft the goal item.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get('_at')\n  if workshop_kind is not None:\n      path = find_path(state, workshop_kind)\n      for a in path:\n          _, state = state.step(a)\n          actions.append(a)\n      # Use the workshop to craft the item.\n      _, state = state.step(ACTION_USE)\n      actions.append(ACTION_USE)\n\n  return actions", "env_interactions": 0, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T17:46:48.496001", "function_name": "make_arrow", "function_body": "  import collections\n  import numpy as np\n\n  # ------------------------------------------------------------------\n  # Reset environment and obtain handles to the current state and world.\n  # ------------------------------------------------------------------\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n\n  # ------------------------------------------------------------------\n  # Identify the goal index and the primitive requirements for that goal.\n  # ------------------------------------------------------------------\n  goal_idx = env.task.goal\n  required = world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n\n  # ------------------------------------------------------------------\n  # Action indices (consistent with CraftLab).\n  # ------------------------------------------------------------------\n  act_map = env.action_specs()\n  ACTION_DOWN  = act_map['DOWN']\n  ACTION_UP    = act_map['UP']\n  ACTION_LEFT  = act_map['LEFT']\n  ACTION_RIGHT = act_map['RIGHT']\n  ACTION_USE   = act_map['USE']\n\n  move_dirs = [\n      (1, 0, ACTION_DOWN),\n      (-1, 0, ACTION_UP),\n      (0, -1, ACTION_LEFT),\n      (0, 1, ACTION_RIGHT),\n  ]\n\n  # ------------------------------------------------------------------\n  # Helper: BFS returning a list of movement actions that brings the\n  # agent to a cell containing `target_kind`. The search can step onto\n  # empty cells or the target cell itself, but avoids any other occupied\n  # cells.\n  # ------------------------------------------------------------------\n  def find_path(cur_state, target_kind):\n      grid = cur_state.grid\n      H, W, _ = grid.shape\n      start = cur_state.pos\n      visited = {start}\n      q = collections.deque([(start, [])])\n\n      while q:\n          (x, y), path = q.popleft()\n          if grid[x, y, target_kind] > 0:\n              return path\n          for dx, dy, act in move_dirs:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < H and 0 <= ny < W):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              # Allow stepping onto the target cell even if occupied.\n              occupied = np.any(grid[nx, ny, :] > 0)\n              if occupied and grid[nx, ny, target_kind] == 0:\n                  continue\n              visited.add((nx, ny))\n              q.append(((nx, ny), path + [act]))\n      # If unreachable (should not happen in well\u2011formed scenarios) return empty.\n      return []\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # 1) Collect required primitives (or the goal itself if it has no recipe).\n  # ------------------------------------------------------------------\n  if required:\n      # Goal is a crafted item; gather its primitive ingredients.\n      for prim_kind, count in required.items():\n          for _ in range(count):\n              path = find_path(state, prim_kind)\n              for a in path:\n                  _, state = state.step(a)\n                  actions.append(a)\n              # Pick up the primitive now under the agent.\n              _, state = state.step(ACTION_USE)\n              actions.append(ACTION_USE)\n  else:\n      # Goal is a primitive; just go to it and pick it up.\n      path = find_path(state, goal_idx)\n      for a in path:\n          _, state = state.step(a)\n          actions.append(a)\n      _, state = state.step(ACTION_USE)\n      actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # 2) If the recipe requires a workshop, move there and use it to craft.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get('_at')\n  if workshop_kind is not None:\n      path = find_path(state, workshop_kind)\n      for a in path:\n          _, state = state.step(a)\n          actions.append(a)\n      _, state = state.step(ACTION_USE)\n      actions.append(ACTION_USE)\n\n  return actions", "env_interactions": 0, "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-10-27T17:47:23.884106", "function_name": "make_arrow", "function_body": "  # Reset environment and fetch useful handles\n  env.reset()\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  # --------------------------------------------------------------\n  # Goal definition and recipe information\n  # --------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = idx[goal_name]\n\n  # Primitive requirements for a single arrow\n  primitive_counts = world.cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n\n  # Workshop required for crafting (if any)\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else idx[wk]\n\n  # --------------------------------------------------------------\n  # Helper utilities\n  # --------------------------------------------------------------\n  def find_locations(kind, grid):\n      \"\"\"Return list of (x, y) where `kind` is present in `grid`.\"\"\"\n      occ = np.where(grid[:, :, kind] > 0)\n      return list(zip(occ[0].tolist(), occ[1].tolist()))\n\n  def move_action(cur, nxt):\n      \"\"\"Translate a step from cur \u2192 nxt into the corresponding action index.\"\"\"\n      dx = nxt[0] - cur[0]\n      dy = nxt[1] - cur[1]\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise AssertionError(\"non\u2011adjacent move requested\")\n\n  def bfs_path(start, goal, grid):\n      \"\"\"Shortest path from start to goal avoiding blocked cells.\"\"\"\n      if start == goal:\n          return [start]\n      W, H = grid.shape[:2]\n\n      # Cells that cannot be traversed: non\u2011grabbable entities and any occupied cell\n      blocked = set()\n      for ng in world.non_grabbable_indices:\n          occ = np.where(grid[:, :, ng] > 0)\n          blocked.update(zip(occ[0].tolist(), occ[1].tolist()))\n      occ = np.argwhere(grid.sum(axis=2) > 0)\n      for x, y in occ:\n          if (x, y) != goal:\n              blocked.add((x, y))\n\n      q = collections.deque([start])\n      prev = {start: None}\n      while q:\n          cur = q.popleft()\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:\n                  nxt = (nx, ny)\n                  if nxt not in prev:\n                      prev[nxt] = cur\n                      if nxt == goal:\n                          # Reconstruct path\n                          path = [goal]\n                          while path[-1] != start:\n                              path.append(prev[path[-1]])\n                          path.reverse()\n                          return path\n                      q.append(nxt)\n      # No path found \u2013 stay in place\n      return [start]\n\n  # --------------------------------------------------------------\n  # Build the action sequence\n  # --------------------------------------------------------------\n  actions = []\n  cur_pos = state.pos\n  cur_grid = state.grid.copy()          # mutable copy reflecting pickups\n  inventory = state.inventory.copy()\n\n  # 1) Collect all required primitives (use inventory first if possible)\n  for prim_idx, total_needed in primitive_counts.items():\n      needed = total_needed\n      while needed > 0:\n          if inventory[prim_idx] > 0:\n              inventory[prim_idx] -= 1\n              needed -= 1\n              continue\n\n          locations = find_locations(prim_idx, cur_grid)\n          if not locations:\n              raise RuntimeError(\n                  f\"Required primitive {idx.get(prim_idx, prim_idx)} not found on the map\"\n              )\n          # Choose the nearest occurrence (Manhattan distance)\n          target = min(\n              locations,\n              key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1]),\n          )\n          path = bfs_path(cur_pos, target, cur_grid)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n          actions.append(4)                     # USE to pick up\n          # Update mutable world state\n          inventory[prim_idx] += 1              # now have it\n          inventory[prim_idx] -= 1              # consume for crafting\n          cur_grid[target[0], target[1], prim_idx] = 0\n          needed -= 1\n\n  # 2) Move to workshop (if required) and craft the arrow\n  if workshop_kind is not None:\n      wk_locations = find_locations(workshop_kind, cur_grid)\n      if not wk_locations:\n          raise RuntimeError(\"Required workshop for crafting arrow not found on the map\")\n      target = min(\n          wk_locations,\n          key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1]),\n      )\n      path = bfs_path(cur_pos, target, cur_grid)\n      for step in path[1:]:\n          actions.append(move_action(cur_pos, step))\n          cur_pos = step\n      actions.append(4)                         # USE to craft at workshop\n  else:\n      # No specific workshop \u2013 craft at current location\n      actions.append(4)                         # USE to craft\n\n  return actions", "env_interactions": 21, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T17:47:25.011645", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  goal_name = \"arrow\"\n  goal_idx = idx[goal_name]\n\n  primitive_counts = world.cookbook.primitives_for(goal_idx)\n\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else idx[wk]\n\n  def find_locations(kind, grid):\n      occ = np.where(grid[:, :, kind] > 0)\n      return list(zip(occ[0].tolist(), occ[1].tolist()))\n\n  def move_action(cur, nxt):\n      dx = nxt[0] - cur[0]\n      dy = nxt[1] - cur[1]\n      if dx == 1:\n          return 3   # RIGHT\n      if dx == -1:\n          return 2   # LEFT\n      if dy == 1:\n          return 0   # DOWN\n      if dy == -1:\n          return 1   # UP\n      raise AssertionError(\"non\u2011adjacent move\")\n\n  def bfs_path(start, goal, grid):\n      if start == goal:\n          return [start]\n      W, H = grid.shape[:2]\n\n      blocked = set()\n      for ng in world.non_grabbable_indices:\n          occ = np.where(grid[:, :, ng] > 0)\n          blocked.update(zip(occ[0].tolist(), occ[1].tolist()))\n      occupied = np.argwhere(grid.sum(axis=2) > 0)\n      for x, y in occupied:\n          if (x, y) != goal:\n              blocked.add((x, y))\n\n      q = collections.deque([start])\n      prev = {start: None}\n      while q:\n          cur = q.popleft()\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:\n                  nxt = (nx, ny)\n                  if nxt not in prev:\n                      prev[nxt] = cur\n                      if nxt == goal:\n                          path = [goal]\n                          while path[-1] != start:\n                              path.append(prev[path[-1]])\n                          path.reverse()\n                          return path\n                      q.append(nxt)\n      return [start]\n\n  actions = []\n  cur_pos = state.pos\n  cur_grid = state.grid.copy()\n  inventory = state.inventory.copy()\n\n  for prim_idx, total_needed in primitive_counts.items():\n      needed = total_needed\n      while needed > 0:\n          if inventory[prim_idx] > 0:\n              inventory[prim_idx] -= 1\n              needed -= 1\n              continue\n\n          locations = find_locations(prim_idx, cur_grid)\n          if not locations:\n              raise RuntimeError(f\"Primitive {idx.get(prim_idx, prim_idx)} not found on map\")\n          target = min(\n              locations,\n              key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1])\n          )\n          path = bfs_path(cur_pos, target, cur_grid)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n          actions.append(4)  # USE to pick up\n          inventory[prim_idx] += 1\n          inventory[prim_idx] -= 1\n          cur_grid[target[0], target[1], prim_idx] = 0\n          needed -= 1\n\n  if workshop_kind is not None:\n      wk_locations = find_locations(workshop_kind, cur_grid)\n      if not wk_locations:\n          raise RuntimeError(\"Workshop required for arrow not found on map\")\n      target = min(\n          wk_locations,\n          key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1])\n      )\n      path = bfs_path(cur_pos, target, cur_grid)\n      for step in path[1:]:\n          actions.append(move_action(cur_pos, step))\n          cur_pos = step\n      actions.append(4)  # USE to craft\n  else:\n      actions.append(4)  # USE to craft at current location\n\n  return actions", "env_interactions": 21, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T17:47:44.246984", "function_name": "make_arrow", "function_body": "  # Reset environment and fetch core objects\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.scenario.world          # CraftWorld\n  cookbook = world.cookbook           # Cookbook\n  index = cookbook.index               # name \u2194 integer id mapping\n\n  # Resolve action indices dynamically from the environment spec\n  action_map = env.action_specs()\n  DOWN = action_map[\"DOWN\"]\n  UP = action_map[\"UP\"]\n  LEFT = action_map[\"LEFT\"]\n  RIGHT = action_map[\"RIGHT\"]\n  USE = action_map[\"USE\"]\n\n  # Goal item\n  goal_name = \"arrow\"\n  if goal_name not in index.contents:\n      return []                       # Arrow not defined in this world\n  goal_idx = index[goal_name]\n\n  # Primitive requirements for the goal\n  primitive_needs = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n  actions = []                         # Final action sequence\n\n  from collections import deque\n\n  def _bfs_path(start, target):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) from start to target.\n      Cells occupied by any entity are treated as obstacles, except the target cell itself.\n      \"\"\"\n      if start == target:\n          return []\n      h, w = state.grid.shape[:2]\n      moves = [(DOWN, (1, 0)),\n               (UP, (-1, 0)),\n               (LEFT, (0, -1)),\n               (RIGHT, (0, 1))]\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          for act, (dr, dc) in moves:\n              nr, nc = cur[0] + dr, cur[1] + dc\n              if not (0 <= nr < h and 0 <= nc < w):\n                  continue\n              nxt = (nr, nc)\n              # Occupied cells are obstacles unless they are the target.\n              if nxt != target and state.grid[nr, nc, :].sum() != 0:\n                  continue\n              if nxt in visited:\n                  continue\n              visited.add(nxt)\n              parent[nxt] = (cur, act)\n              q.append(nxt)\n      # If target unreachable, return empty list.\n      if target not in parent and start != target:\n          return []\n      # Reconstruct path.\n      path = []\n      cur = target\n      while cur != start:\n          prev, act = parent[cur]\n          path.append(act)\n          cur = prev\n      path.reverse()\n      return path\n\n  # ------------------------------------------------------------------\n  # 1. Collect each required primitive the needed number of times.\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          # Locate all cells currently containing this primitive.\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # Primitive not present; abort early.\n              return actions\n          # Choose the nearest primitive (Manhattan distance).\n          dists = np.abs(prim_cells - np.array(state.pos)).sum(axis=1)\n          tr, tc = prim_cells[dists.argmin()]\n\n          # Move to the primitive cell.\n          move_seq = _bfs_path(state.pos, (tr, tc))\n          actions.extend(move_seq)\n          state.pos = (tr, tc)\n\n          # Pick up the primitive.\n          actions.append(USE)\n          state.inventory[prim_idx] += 1\n          state.grid[tr, tc, prim_idx] = 0   # Cell becomes empty.\n\n  # ------------------------------------------------------------------\n  # 2. Go to the workshop and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      return actions                     # No workshop info; cannot craft.\n\n  workshop_idx = index[workshop_name]\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      return actions                     # No workshop present in this scenario.\n\n  # Choose nearest workshop.\n  dists = np.abs(workshop_cells - np.array(state.pos)).sum(axis=1)\n  wr, wc = workshop_cells[dists.argmin()]\n\n  # Move to the workshop.\n  move_seq = _bfs_path(state.pos, (wr, wc))\n  actions.extend(move_seq)\n  state.pos = (wr, wc)\n\n  # Craft the arrow.\n  actions.append(USE)\n\n  return actions", "env_interactions": 24, "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T17:47:45.375574", "function_name": "make_arrow", "function_body": "  # Reset the environment and fetch useful references\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.scenario.world          # CraftWorld\n  cookbook = world.cookbook           # Cookbook\n  index = cookbook.index               # name \u2194 integer id mapping\n\n  # Resolve action indices dynamically from the environment spec\n  action_map = env.action_specs()\n  DOWN = action_map[\"DOWN\"]\n  UP = action_map[\"UP\"]\n  LEFT = action_map[\"LEFT\"]\n  RIGHT = action_map[\"RIGHT\"]\n  USE = action_map[\"USE\"]\n\n  # Identify the goal item (\"arrow\")\n  goal_name = \"arrow\"\n  if goal_name not in index.contents:\n      return []                       # Goal not present in this world\n  goal_idx = index[goal_name]\n\n  # Determine primitive requirements for the goal\n  primitive_needs = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n  actions = []                         # Final action sequence\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of movement actions from start to target.\n  # The target cell may be occupied (primitive or workshop); all other\n  # cells must be empty (i.e., sum over kinds == 0).\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  def _bfs_path(start, target):\n      \"\"\"Return list of movement actions (DOWN/UP/LEFT/RIGHT) to reach target.\"\"\"\n      if start == target:\n          return []\n\n      h, w = state.grid.shape[:2]\n      moves = [(DOWN, (1, 0)),\n               (UP, (-1, 0)),\n               (LEFT, (0, -1)),\n               (RIGHT, (0, 1))]\n\n      q = deque([start])\n      visited = {start}\n      parent = {}\n\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          for act, (dr, dc) in moves:\n              nr, nc = cur[0] + dr, cur[1] + dc\n              if not (0 <= nr < h and 0 <= nc < w):\n                  continue\n              nxt = (nr, nc)\n              # Treat any occupied cell as obstacle, except the target itself.\n              if nxt != target and state.grid[nr, nc, :].sum() != 0:\n                  continue\n              if nxt in visited:\n                  continue\n              visited.add(nxt)\n              parent[nxt] = (cur, act)\n              q.append(nxt)\n\n      # If target was never reached, return empty list.\n      if target not in parent and start != target:\n          return []\n\n      # Reconstruct path.\n      path = []\n      cur = target\n      while cur != start:\n          prev, act = parent[cur]\n          path.append(act)\n          cur = prev\n      path.reverse()\n      return path\n\n  # ------------------------------------------------------------------\n  # 1. Collect each required primitive the needed number of times.\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          # Locate all cells that currently contain this primitive.\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # Primitive not present \u2013 abort early.\n              return actions\n\n          # Choose the nearest primitive (Manhattan distance).\n          dists = np.abs(prim_cells - np.array(state.pos)).sum(axis=1)\n          tr, tc = prim_cells[dists.argmin()]\n\n          # Move to the primitive cell.\n          move_seq = _bfs_path(state.pos, (tr, tc))\n          actions.extend(move_seq)\n          state.pos = (tr, tc)\n\n          # Pick up the primitive.\n          actions.append(USE)\n          state.inventory[prim_idx] += 1\n          state.grid[tr, tc, prim_idx] = 0   # cell becomes empty\n\n  # ------------------------------------------------------------------\n  # 2. Go to the appropriate workshop and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      return actions                     # No workshop information\n\n  workshop_idx = index[workshop_name]\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      return actions                     # Workshop not present in this scenario\n\n  # Choose the nearest workshop.\n  dists = np.abs(workshop_cells - np.array(state.pos)).sum(axis=1)\n  wr, wc = workshop_cells[dists.argmin()]\n\n  # Move to the workshop.\n  move_seq = _bfs_path(state.pos, (wr, wc))\n  actions.extend(move_seq)\n  state.pos = (wr, wc)\n\n  # Craft the arrow.\n  actions.append(USE)\n\n  return actions", "env_interactions": 24, "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T17:48:00.323539", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Reset environment and obtain the current state and world information\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world\n  cookbook = world.cookbook\n\n  # Goal identification\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n  primitive_needs = cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  if \"_at\" in recipe:\n      workshop_idx = cookbook.index[recipe[\"_at\"]]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def bfs_path(start, goal, occupied):\n      \"\"\"Return a list of positions from start (excluded) to goal (included)\n      moving only on cells where occupied==False, except the goal cell.\n      \"\"\"\n      w, h = occupied.shape\n      visited = np.full((w, h), False, dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start] = True\n      while q:\n          x, y = q.popleft()\n          if (x, y) == goal:\n              break\n          for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):\n              if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:\n                  # Allow stepping onto the goal even if occupied\n                  if (nx, ny) == goal or not occupied[nx, ny]:\n                      visited[nx, ny] = True\n                      prev[(nx, ny)] = (x, y)\n                      q.append((nx, ny))\n      if not visited[goal]:\n          return None\n      # reconstruct path\n      path = []\n      cur = goal\n      while cur != start:\n          path.append(cur)\n          cur = prev[cur]\n      path.reverse()\n      return path\n\n  def delta_to_action(dx, dy):\n      \"\"\"Map a movement delta to the corresponding action index.\"\"\"\n      if dx == 1:\n          return 3   # RIGHT\n      if dx == -1:\n          return 2   # LEFT\n      if dy == 1:\n          return 0   # DOWN\n      if dy == -1:\n          return 1   # UP\n      raise ValueError(\"Invalid movement delta\")\n\n  actions = []\n  cur_pos = tuple(state.pos)\n  # mutable copy of the grid to keep track of collected primitives\n  grid = state.grid.copy()\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitives (handle multiplicities)\n  # ------------------------------------------------------------------\n  for kind_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          # locate remaining instances of this primitive\n          locations = np.argwhere(grid[:, :, kind_idx] > 0)\n          if locations.size == 0:\n              break  # nothing left of this kind\n          # sort by Manhattan distance from current position\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n\n          occupied_mask = np.any(grid, axis=2)   # cells that are currently blocked\n          chosen_path = None\n          target_cell = None\n          for idx in order:\n              cand = tuple(locations[idx])\n              path = bfs_path(cur_pos, cand, occupied_mask)\n              if path is not None:\n                  chosen_path = path\n                  target_cell = cand\n                  break\n\n          if chosen_path is None:\n              # cannot reach any remaining instance; give up on this primitive\n              continue\n\n          # follow the path, emitting movement actions\n          for step in chosen_path:\n              dx = step[0] - cur_pos[0]\n              dy = step[1] - cur_pos[1]\n              actions.append(delta_to_action(dx, dy))\n              cur_pos = step\n\n          # pick up the primitive\n          actions.append(4)   # USE\n          # remove it from the mutable grid so future paths treat the cell as empty\n          grid[target_cell[0], target_cell[1], kind_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 2) Move to the required workshop (if any) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          dists = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n          # workshops occupy their cells; we still allow stepping onto the target cell\n          occupied_mask = np.any(state.grid, axis=2)\n          for idx in order:\n              cand = tuple(workshop_cells[idx])\n              path = bfs_path(cur_pos, cand, occupied_mask)\n              if path is not None:\n                  for step in path:\n                      dx = step[0] - cur_pos[0]\n                      dy = step[1] - cur_pos[1]\n                      actions.append(delta_to_action(dx, dy))\n                      cur_pos = step\n                  actions.append(4)   # USE to trigger crafting\n                  break\n\n  return actions", "env_interactions": 26, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T17:48:01.443028", "function_name": "make_arrow", "function_body": "  # Reuse the implementation from make_arrow_v1 to generate the action sequence.\n  return make_arrow_v1(env)", "env_interactions": 0, "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-10-27T17:48:31.483908", "function_name": "make_arrow", "function_body": "  # Reset environment and get references\n  env.reset()\n  world = env.world\n  scenario = env.scenario\n  state = env._current_state\n\n  # Goal item index (arrow)\n  goal_idx = env.task.goal\n\n  # Primitive requirements (including transitive)\n  required = world.cookbook.primitives_for(goal_idx)\n\n  # Determine workshop kind for final crafting (if any)\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else world.cookbook.index[wk]\n\n  # Copy of the initial grid that we will update as we harvest items\n  grid = scenario.init_grid.copy()\n\n  # Set of non\u2011walkable entity indices (obstacles)\n  non_walkable = set(world.non_grabbable_indices)\n\n  # Helper: check if a cell is walkable (allow stepping on a target cell)\n  def is_walkable(x: int, y: int, target: tuple[int, int] | None = None) -> bool:\n      if target is not None and (x, y) == target:\n          # Always allow moving onto the goal cell (it may contain a grabbable item or workshop)\n          return True\n      # Cell is walkable if none of the non\u2011walkable kinds are present\n      return all(grid[x, y, idx] == 0 for idx in non_walkable)\n\n  # Helper: A* / BFS path finder returning a list of action indices\n  def find_path(start: tuple[int, int], goal: tuple[int, int]) -> list[int]:\n      if start == goal:\n          return []\n      from collections import deque\n\n      width, height = grid.shape[0], grid.shape[1]\n      q = deque([start])\n      visited = {start}\n      parent: dict[tuple[int, int], tuple[tuple[int, int], int]] = {}\n\n      # Action order matches env: 0=DOWN,1=UP,2=LEFT,3=RIGHT\n      moves = [(0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)]\n\n      while q:\n          cx, cy = q.popleft()\n          if (cx, cy) == goal:\n              break\n          for dx, dy, act in moves:\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < width and 0 <= ny < height:\n                  nxt = (nx, ny)\n                  if nxt not in visited and is_walkable(nx, ny, target=goal):\n                      visited.add(nxt)\n                      parent[nxt] = ((cx, cy), act)\n                      q.append(nxt)\n\n      # Reconstruct actions\n      if goal not in parent:\n          return []  # No path found\n      actions_rev: list[int] = []\n      cur = goal\n      while cur != start:\n          prev, act = parent[cur]\n          actions_rev.append(act)\n          cur = prev\n      actions_rev.reverse()\n      return actions_rev\n\n  # Helper: locate the nearest cell that currently contains at least one of `kind`\n  def nearest_cell_of_kind(kind: int, from_pos: tuple[int, int]) -> tuple[int, int] | None:\n      cells = np.argwhere(grid[:, :, kind] > 0)\n      if cells.size == 0:\n          return None\n      # Compute Manhattan distances\n      dists = np.abs(cells[:, 0] - from_pos[0]) + np.abs(cells[:, 1] - from_pos[1])\n      idx = int(np.argmin(dists))\n      return tuple(cells[idx].tolist())\n\n  actions: list[int] = []\n  cur_pos = tuple(state.pos)\n\n  # ----------------------------------------------------------------------\n  # Collect all required primitive items\n  # ----------------------------------------------------------------------\n  for kind, count in required.items():\n      for _ in range(count):\n          target = nearest_cell_of_kind(kind, cur_pos)\n          if target is None:\n              # Primitive not available; skip this instance\n              continue\n          move_seq = find_path(cur_pos, target)\n          actions.extend(move_seq)\n          actions.append(4)  # USE to pick up the primitive\n          # Mark the cell as empty after harvesting\n          grid[target[0], target[1], :] = 0\n          cur_pos = target\n\n  # ----------------------------------------------------------------------\n  # Move to workshop (if required) and craft the final item\n  # ----------------------------------------------------------------------\n  if workshop_kind is not None:\n      workshop_target = nearest_cell_of_kind(workshop_kind, cur_pos)\n      if workshop_target is not None:\n          move_seq = find_path(cur_pos, workshop_target)\n          actions.extend(move_seq)\n          cur_pos = workshop_target\n\n  # Final USE triggers crafting of the goal item\n  actions.append(4)\n\n  return actions", "env_interactions": 1, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T17:48:32.608102", "function_name": "make_arrow", "function_body": "  env.reset()\n  world = env.world\n  scenario = env.scenario\n  state = env._current_state\n\n  # index of the goal item (arrow)\n  goal_idx = env.task.goal\n\n  # primitive resources (including transitive) required to craft the goal\n  required = world.cookbook.primitives_for(goal_idx)\n\n  # workshop where the final crafting must occur (if any)\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else world.cookbook.index[wk]\n\n  actions: list[int] = []\n  cur_pos = tuple(state.pos)\n\n  # ------------------------------------------------------------------\n  # Helper: Manhattan move sequence (DOWN=0, UP=1, LEFT=2, RIGHT=3)\n  # ------------------------------------------------------------------\n  def moves_to(start: tuple[int, int], target: tuple[int, int]) -> tuple[list[int], tuple[int, int]]:\n      x, y = start\n      tx, ty = target\n      seq: list[int] = []\n      while x < tx:\n          seq.append(3)   # RIGHT\n          x += 1\n      while x > tx:\n          seq.append(2)   # LEFT\n          x -= 1\n      while y < ty:\n          seq.append(0)   # DOWN\n          y += 1\n      while y > ty:\n          seq.append(1)   # UP\n          y -= 1\n      return seq, (x, y)\n\n  # ------------------------------------------------------------------\n  # Helper: locate nearest cell containing at least one of `kind`,\n  #         ignoring cells already harvested for that kind.\n  # ------------------------------------------------------------------\n  harvested: dict[int, set[tuple[int, int]]] = {}\n\n  def nearest_cell(kind: int, from_pos: tuple[int, int]) -> tuple[int, int] | None:\n      cells = np.argwhere(scenario.init_grid[:, :, kind] > 0)\n      if cells.size == 0:\n          return None\n      used = harvested.get(kind, set())\n      candidates = [tuple(c) for c in cells if tuple(c) not in used]\n      if not candidates:\n          return None\n      dists = [abs(c[0] - from_pos[0]) + abs(c[1] - from_pos[1]) for c in candidates]\n      return candidates[int(np.argmin(dists))]\n\n  # ------------------------------------------------------------------\n  # Collect all required primitive items\n  # ------------------------------------------------------------------\n  for kind, cnt in required.items():\n      harvested.setdefault(kind, set())\n      for _ in range(cnt):\n          target = nearest_cell(kind, cur_pos)\n          if target is None:\n              # primitive not found; skip this instance\n              continue\n          move_seq, cur_pos = moves_to(cur_pos, target)\n          actions.extend(move_seq)\n          actions.append(4)               # USE to pick up the primitive\n          harvested[kind].add(target)     # mark cell as consumed\n\n  # ------------------------------------------------------------------\n  # Move to the workshop (if required) and perform the final craft\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      target = nearest_cell(workshop_kind, cur_pos)\n      if target is not None:\n          move_seq, cur_pos = moves_to(cur_pos, target)\n          actions.extend(move_seq)\n\n  # Final USE triggers the crafting of the goal item (arrow)\n  actions.append(4)\n\n  return actions", "env_interactions": 1, "island_id": 2, "scores": {"3": 0.0}}
