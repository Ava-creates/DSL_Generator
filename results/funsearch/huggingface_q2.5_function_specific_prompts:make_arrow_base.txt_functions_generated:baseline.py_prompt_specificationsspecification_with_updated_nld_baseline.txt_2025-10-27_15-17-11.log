{"timestamp": "2025-10-27T19:17:17.810353", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  goal_name = \"arrow\"\n  goal_idx = idx[goal_name]\n\n  prim_counts = world.cookbook.primitives_for(goal_idx)\n\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else idx[wk]\n\n  def find_locs(kind):\n      occ = np.where(state.grid[:, :, kind] > 0)\n      return list(zip(occ[0].tolist(), occ[1].tolist()))\n\n  def bfs(start, goal):\n      if start == goal:\n          return [start]\n      W, H = state.grid.shape[:2]\n\n      blocked = set()\n      for ng in world.non_grabbable_indices:\n          occ = np.where(state.grid[:, :, ng] > 0)\n          blocked.update(zip(occ[0].tolist(), occ[1].tolist()))\n\n      q = collections.deque([start])\n      prev = {start: None}\n      while q:\n          cur = q.popleft()\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:\n                  nxt = (nx, ny)\n                  if nxt not in prev:\n                      prev[nxt] = cur\n                      if nxt == goal:\n                          path = [goal]\n                          while path[-1] != start:\n                              path.append(prev[path[-1]])\n                          path.reverse()\n                          return path\n                      q.append(nxt)\n      return [start]\n\n  def move_act(cur, nxt):\n      dx, dy = nxt[0] - cur[0], nxt[1] - cur[1]\n      if dx == 1:\n          return 3   # RIGHT\n      if dx == -1:\n          return 2   # LEFT\n      if dy == 1:\n          return 0   # DOWN\n      if dy == -1:\n          return 1   # UP\n      raise AssertionError(\"Requested move is not adjacent\")\n\n  actions = []\n  cur_pos = state.pos\n\n  # Collect required primitives\n  for p_idx, needed in prim_counts.items():\n      while state.inventory[p_idx] < needed:\n          locations = find_locs(p_idx)\n          if not locations:\n              break\n          target = min(\n              locations,\n              key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1])\n          )\n          path = bfs(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_act(cur_pos, step))\n              cur_pos = step\n          actions.append(4)                     # USE to pick up\n          state.inventory[p_idx] += 1\n          state.grid[target[0], target[1], p_idx] = 0\n\n  # Move to workshop if needed\n  if workshop_kind is not None:\n      wk_locs = find_locs(workshop_kind)\n      if wk_locs:\n          target = min(\n              wk_locs,\n              key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1])\n          )\n          path = bfs(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_act(cur_pos, step))\n              cur_pos = step\n\n  # Craft the arrow\n  actions.append(4)  # USE\n\n  return actions", "env_interactions": 19, "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T19:17:18.932399", "function_name": "make_arrow", "function_body": "  # Reset environment to a fresh state\n  env.reset()\n  state = env._current_state          # type: CraftState\n  world = env.world\n  idx = world.cookbook.index\n\n  # --------------------------------------------------------------\n  # Identify the goal (arrow) and its requirements\n  # --------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = idx[goal_name]\n\n  # Primitive counts needed to craft one arrow (recursively expanded)\n  needed_prims = world.cookbook.primitives_for(goal_idx)  # dict {kind_idx: count}\n\n  # Determine if a specific workshop is required for crafting the arrow\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else idx[wk]\n\n  # --------------------------------------------------------------\n  # Helper utilities\n  # --------------------------------------------------------------\n  def find_positions(kind):\n      \"\"\"Return a list of (x, y) coordinates where `kind` is present on the grid.\"\"\"\n      occ = np.where(state.grid[:, :, kind] > 0)\n      return list(zip(occ[0].tolist(), occ[1].tolist()))\n\n  def bfs(start, goal):\n      \"\"\"Return the shortest 4\u2011connected path from `start` to `goal`\n      avoiding cells occupied by non\u2011grabbable entities.\"\"\"\n      if start == goal:\n          return [start]\n      w, h = state.grid.shape[:2]\n\n      # Build a set of blocked cells (non\u2011grabbable entities)\n      blocked = set()\n      for ng in world.non_grabbable_indices:\n          occ = np.where(state.grid[:, :, ng] > 0)\n          blocked.update(zip(occ[0].tolist(), occ[1].tolist()))\n\n      q = collections.deque([start])\n      prev = {start: None}\n      while q:\n          cur = q.popleft()\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in blocked:\n                  nxt = (nx, ny)\n                  if nxt not in prev:\n                      prev[nxt] = cur\n                      if nxt == goal:\n                          # reconstruct path\n                          path = [goal]\n                          while path[-1] != start:\n                              path.append(prev[path[-1]])\n                          path.reverse()\n                          return path\n                      q.append(nxt)\n      # No reachable path \u2013 stay in place\n      return [start]\n\n  def to_action(cur, nxt):\n      \"\"\"Convert a step from `cur` to adjacent `nxt` into a DMLab action index.\"\"\"\n      dx, dy = nxt[0] - cur[0], nxt[1] - cur[1]\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise AssertionError(\"Step is not adjacent\")\n\n  # --------------------------------------------------------------\n  # Build the action sequence\n  # --------------------------------------------------------------\n  actions = []\n  cur_pos = state.pos\n\n  # 1) Collect all required primitive resources\n  for prim_idx, required_qty in needed_prims.items():\n      while state.inventory[prim_idx] < required_qty:\n          # Locate all remaining instances of this primitive on the map\n          candidates = find_positions(prim_idx)\n          if not candidates:\n              # No more of this primitive available \u2013 abort collection loop\n              break\n\n          # Choose the nearest instance (Manhattan distance)\n          target = min(\n              candidates,\n              key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1])\n          )\n\n          # Move to the selected primitive\n          path = bfs(cur_pos, target)\n          for step in path[1:]:\n              actions.append(to_action(cur_pos, step))\n              cur_pos = step\n\n          # Pick it up\n          actions.append(4)                      # USE\n          state.inventory[prim_idx] += 1\n          state.grid[target[0], target[1], prim_idx] = 0\n\n  # 2) If a workshop is required, move to the nearest one\n  if workshop_kind is not None:\n      wk_locations = find_positions(workshop_kind)\n      if wk_locations:\n          target = min(\n              wk_locations,\n              key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1])\n          )\n          path = bfs(cur_pos, target)\n          for step in path[1:]:\n              actions.append(to_action(cur_pos, step))\n              cur_pos = step\n\n  # 3) Craft the arrow (USE at current location)\n  actions.append(4)  # USE\n\n  return actions", "env_interactions": 19, "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T19:17:53.960727", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action constants (match CraftLab.action_specs)\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # DOWN, UP, LEFT, RIGHT\n  USE = 4\n\n  # ------------------------------------------------------------------\n  # Helper: BFS to any free cell adjacent (4\u2011connected) to a target cell\n  # ------------------------------------------------------------------\n  def bfs_to_adjacent(start, target, blocked):\n      \"\"\"Return a list of movement actions that brings the agent from *start*\n      to any empty cell that is 4\u2011connected to *target*.\n      If no such path exists, returns an empty list.\"\"\"\n      h, w = blocked.shape\n      tx, ty = target\n      goal_cells = []\n      for a, (dx, dy) in enumerate(DIRS):\n          gx, gy = tx + dx, ty + dy\n          if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:\n              goal_cells.append((gx, gy))\n      if not goal_cells:\n          return []          # target completely surrounded\n\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (cx, cy), path = q.popleft()\n          if (cx, cy) in goal_cells:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []  # unreachable\n\n  # ------------------------------------------------------------------\n  # Reset / obtain current state\n  # ------------------------------------------------------------------\n  try:\n      env.reset()\n  except Exception:\n      pass\n\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []   # cannot obtain a state\n\n  world = env.world\n  idx = world.cookbook.index\n\n  # ------------------------------------------------------------------\n  # Identify goal (arrow) and its recipe\n  # ------------------------------------------------------------------\n  try:\n      goal_idx = idx[\"arrow\"]\n  except Exception:\n      return []   # arrow not defined\n\n  primitives_needed = world.cookbook.primitives_for(goal_idx)\n\n  # locate workshop name from recipe\n  workshop_name = None\n  for k, v in world.cookbook.recipes.get(goal_idx, {}).items():\n      if k in (\"_at\", \"_key\"):\n          workshop_name = v\n          break\n  if workshop_name is None:\n      return []   # no workshop info\n\n  try:\n      workshop_idx = idx[workshop_name]\n  except Exception:\n      return []   # workshop not indexed\n\n  # ------------------------------------------------------------------\n  # Local mutable copies for planning\n  # ------------------------------------------------------------------\n  pos = tuple(state.pos)                     # (x, y)\n  grid = state.grid.copy()                   # (W, H, n_kinds)\n  inventory = state.inventory.copy()\n  occupied = np.any(grid > 0, axis=2)        # bool matrix of occupied cells\n\n  plan = []\n\n  # ------------------------------------------------------------------\n  # Helper: move to a free cell adjacent to *target*\n  # ------------------------------------------------------------------\n  def move_to(target):\n      \"\"\"Move (and record actions) to a free cell adjacent to *target*.\n      Updates *pos* and *plan*.\"\"\"\n      nonlocal pos, plan\n      path = bfs_to_adjacent(pos, target, occupied)\n      if not path and pos != target:\n          return False\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n      plan.extend(path)\n      return True\n\n  # ------------------------------------------------------------------\n  # Helper: collect a primitive located at *cell* (kind_idx)\n  # ------------------------------------------------------------------\n  def collect(cell, kind_idx):\n      \"\"\"Move next to *cell*, issue USE, and update simulated state.\"\"\"\n      nonlocal grid, occupied, inventory, plan, pos\n      if not move_to(cell):\n          return False\n      plan.append(USE)\n      x, y = cell\n      if grid[x, y, kind_idx] > 0:\n          grid[x, y, kind_idx] = 0\n          occupied[x, y] = np.any(grid[x, y, :] > 0)\n          inventory[kind_idx] += 1\n      return True\n\n  # ------------------------------------------------------------------\n  # Collect all required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in primitives_needed.items():\n      for _ in range(cnt):\n          locations = np.argwhere(grid[:, :, prim_idx] > 0)\n          if locations.size == 0:\n              # No more of this primitive on the map \u2013 abort planning\n              return plan\n          # Choose the closest instance (Manhattan distance)\n          dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n          target = tuple(locations[dists.argmin()])\n          if not collect(target, prim_idx):\n              return plan\n\n  # ------------------------------------------------------------------\n  # Move to workshop and craft the arrow (just USE while adjacent)\n  # ------------------------------------------------------------------\n  # Workshop cells are static; use original scenario grid to locate them\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      return plan\n  dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])\n  workshop_target = tuple(workshop_cells[dists.argmin()])\n  if not move_to(workshop_target):\n      return plan\n  plan.append(USE)   # crafting action\n\n  return plan", "env_interactions": 23, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T19:17:55.093812", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Setup and obtain current state\n  # ----------------------------------------------------------------------\n  try:\n      env.reset()\n  except Exception:\n      pass\n\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []\n\n  world = env.world\n  idx = world.cookbook.index\n\n  # ----------------------------------------------------------------------\n  # Identify goal (arrow) and its recipe\n  # ----------------------------------------------------------------------\n  try:\n      goal_idx = idx[\"arrow\"]\n  except Exception:\n      return []                     # no arrow defined\n\n  primitives_needed = world.cookbook.primitives_for(goal_idx)\n\n  # locate workshop name from recipe\n  workshop_name = None\n  for k, v in world.cookbook.recipes.get(goal_idx, {}).items():\n      if k in (\"_at\", \"_key\"):\n          workshop_name = v\n          break\n  if workshop_name is None:\n      return []                     # no workshop info\n\n  try:\n      workshop_idx = idx[workshop_name]\n  except Exception:\n      return []                     # workshop not indexed\n\n  # ----------------------------------------------------------------------\n  # Local mutable copies for planning\n  # ----------------------------------------------------------------------\n  pos = tuple(state.pos)                     # (x, y)\n  grid = state.grid.copy()                   # (W, H, n_kinds)\n  inventory = state.inventory.copy()\n  occupied = np.any(grid > 0, axis=2)        # bool matrix of blocked cells\n\n  plan = []\n\n  # ----------------------------------------------------------------------\n  # Constants and helpers\n  # ----------------------------------------------------------------------\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # DOWN, UP, LEFT, RIGHT\n  USE = 4\n\n  from collections import deque\n\n  def bfs_to_adjacent(start, target, blocked):\n      \"\"\"Return a list of movement actions that brings the agent from *start*\n      to any empty cell that is 4\u2011connected to *target*.\n      If unreachable, returns an empty list.\"\"\"\n      h, w = blocked.shape\n      tx, ty = target\n      goal_cells = []\n      for a, (dx, dy) in enumerate(DIRS):\n          gx, gy = tx + dx, ty + dy\n          if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:\n              goal_cells.append((gx, gy))\n      if not goal_cells:\n          return []          # target completely surrounded\n\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (cx, cy), path = q.popleft()\n          if (cx, cy) in goal_cells:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []  # unreachable\n\n  def move_and_use(target, kind_idx):\n      \"\"\"Move adjacent to *target* (contains *kind_idx*) and issue USE.\n      Updates simulated pos, grid, occupied, inventory. Returns False on failure.\"\"\"\n      nonlocal pos, plan, grid, occupied, inventory\n      path = bfs_to_adjacent(pos, target, occupied)\n      if not path and pos != target:\n          return False\n      # execute movement actions in simulation\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n      plan.extend(path)\n\n      # perform USE\n      plan.append(USE)\n\n      tx, ty = target\n      if grid[tx, ty, kind_idx] > 0:\n          # pick up primitive or interact with workshop\n          grid[tx, ty, kind_idx] = 0\n          occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)\n          inventory[kind_idx] += 1\n      return True\n\n  # ----------------------------------------------------------------------\n  # Collect required primitives\n  # ----------------------------------------------------------------------\n  for prim_idx, cnt in primitives_needed.items():\n      for _ in range(cnt):\n          locations = np.argwhere(grid[:, :, prim_idx] > 0)\n          if locations.size == 0:\n              # primitive not present; abort planning\n              return plan\n          # choose nearest by Manhattan distance\n          dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n          target = tuple(locations[dists.argmin()])\n          if not move_and_use(target, prim_idx):\n              return plan\n\n  # ----------------------------------------------------------------------\n  # Go to workshop and craft the arrow\n  # ----------------------------------------------------------------------\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      return plan\n  dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])\n  workshop_target = tuple(workshop_cells[dists.argmin()])\n  move_and_use(workshop_target, workshop_idx)\n\n  return plan", "env_interactions": 23, "island_id": 8, "scores": {"3": 0.5}}
