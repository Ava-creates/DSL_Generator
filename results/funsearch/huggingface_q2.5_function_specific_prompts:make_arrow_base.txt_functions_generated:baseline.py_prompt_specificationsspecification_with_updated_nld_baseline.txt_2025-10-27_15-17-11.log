{"timestamp": "2025-10-27T16:06:47.138936", "function_name": "make_arrow", "function_body": "  # Access world and recipe information\n  world = env.world\n  idx = world.cookbook.index\n  arrow_idx = idx[\"arrow\"]\n\n  # Primitive requirements for one arrow\n  needed = world.cookbook.primitives_for(arrow_idx)\n\n  # Workshop where the arrow must be crafted (if specified)\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  workshop_idx = idx[workshop_name] if workshop_name else None\n\n  actions = []\n\n  # Obtain the current CraftState; reset the environment if needed\n  if hasattr(env, \"_current_state\") and env._current_state is not None:\n      state = env._current_state\n  else:\n      env.reset()\n      state = env._current_state\n\n  # Helper to move the agent to a target cell using Manhattan moves\n  def move_to(target):\n      nonlocal state, actions\n      while state.pos != target:\n          y, x = state.pos\n          ty, tx = target\n          if y < ty:\n              act = 0          # DOWN\n              new_pos = (y + 1, x)\n          elif y > ty:\n              act = 1          # UP\n              new_pos = (y - 1, x)\n          elif x < tx:\n              act = 3          # RIGHT\n              new_pos = (y, x + 1)\n          else:\n              act = 2          # LEFT\n              new_pos = (y, x - 1)\n\n          actions.append(act)\n          _, state = state.step(act)\n\n  # Collect each required primitive the needed number of times\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          # Locate any cell that currently holds the primitive\n          positions = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if positions.size == 0:\n              raise RuntimeError(f\"Primitive {idx.get(prim_idx, prim_idx)} not found on the map.\")\n          # Choose the first occurrence (could be improved with nearest search)\n          prim_pos = tuple(positions[0])\n\n          # Move onto the primitive cell\n          move_to(prim_pos)\n\n          # Pick it up (USE action). The environment interprets USE on the cell the\n          # agent is standing on as a pickup.\n          actions.append(4)       # USE\n          _, state = state.step(4)\n\n  # Finally move to the workshop (if any) and craft the arrow\n  if workshop_idx is not None:\n      ws_positions = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if ws_positions.size == 0:\n          raise RuntimeError(f\"Workshop {workshop_name} not found on the map.\")\n      ws_pos = tuple(ws_positions[0])\n      move_to(ws_pos)\n\n      # Use the workshop to craft the arrow\n      actions.append(4)           # USE\n      _, state = state.step(4)\n\n  return actions", "env_interactions": 0, "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-10-27T16:07:08.672135", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state          # type: CraftState\n  world = env.world                    # type: CraftWorld\n\n  # Goal item index\n  goal_idx = env.task.goal\n\n  # Primitive requirements for the goal (primitive_kind -> count)\n  required = world.cookbook.primitives_for(goal_idx)\n\n  # Action indices according to CraftLab's specification\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n  move_dirs = [(1, 0, ACTION_DOWN), (-1, 0, ACTION_UP),\n               (0, -1, ACTION_LEFT), (0, 1, ACTION_RIGHT)]\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper: BFS to find a shortest path (as a list of movement actions)\n  # from the current position to any cell that contains the desired kind.\n  # The search avoids any occupied cell (any non\u2011zero kind) except the\n  # target cell itself.\n  # ------------------------------------------------------------------\n  def find_path(state, target_kind):\n      grid = state.grid\n      H, W, _ = grid.shape\n      start = state.pos\n      visited = {start}\n      q = collections.deque([(start, [])])\n\n      while q:\n          (x, y), path = q.popleft()\n          # Arrived at a cell containing the target kind\n          if grid[x, y, target_kind] > 0:\n              return path\n          for dx, dy, act in move_dirs:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < H and 0 <= ny < W):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              # Allow stepping onto the target cell even if occupied\n              occupied = np.any(grid[nx, ny, :] > 0)\n              if occupied and grid[nx, ny, target_kind] == 0:\n                  continue\n              visited.add((nx, ny))\n              q.append(((nx, ny), path + [act]))\n      # If not found (should not happen), return empty list\n      return []\n\n  # ------------------------------------------------------------------\n  # 1) Collect every required primitive.\n  # ------------------------------------------------------------------\n  for kind, count in required.items():\n      for _ in range(count):\n          path = find_path(state, kind)\n          for act in path:\n              _, state = state.step(act)\n              actions.append(act)\n          # Pick up the primitive now under the agent\n          _, state = state.step(ACTION_USE)\n          actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # 2) Move to the workshop required for the goal and craft the item.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get('_at')\n  if workshop_kind is not None:\n      path = find_path(state, workshop_kind)\n      for act in path:\n          _, state = state.step(act)\n          actions.append(act)\n      # Use the workshop to craft the goal item\n      _, state = state.step(ACTION_USE)\n      actions.append(ACTION_USE)\n\n  return actions", "env_interactions": 0, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T16:07:09.846846", "function_name": "make_arrow", "function_body": "  # Reset environment and obtain initial state/world references\n  env.reset()\n  state = env._current_state          # type: CraftState\n  world = env.world                    # type: CraftWorld\n\n  # Goal item index\n  goal_idx = env.task.goal\n\n  # Primitive requirements for the goal (primitive_kind -> count)\n  required = world.cookbook.primitives_for(goal_idx)\n\n  # Action indices as defined by CraftLab\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n  move_dirs = [(1, 0, ACTION_DOWN), (-1, 0, ACTION_UP),\n               (0, -1, ACTION_LEFT), (0, 1, ACTION_RIGHT)]\n\n  actions = []\n\n  def find_path(cur_state, target_kind):\n      \"\"\"\n      Breadth\u2011first search returning a list of movement actions that leads\n      from the agent's current position to any cell containing `target_kind`.\n      The search may step onto empty cells or the target cell itself,\n      but avoids other occupied cells.\n      \"\"\"\n      grid = cur_state.grid\n      H, W = grid.shape[:2]\n      start = cur_state.pos\n      visited = {start}\n      q = collections.deque([(start, [])])\n\n      while q:\n          (x, y), path = q.popleft()\n          if grid[x, y, target_kind] > 0:\n              return path\n          for dx, dy, act in move_dirs:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < H and 0 <= ny < W):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              # Allow stepping onto the target cell even if it is occupied\n              occupied = np.any(grid[nx, ny, :] > 0)\n              if occupied and grid[nx, ny, target_kind] == 0:\n                  continue\n              visited.add((nx, ny))\n              q.append(((nx, ny), path + [act]))\n      # If not found (should not happen in valid scenarios) return empty list\n      return []\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitives.\n  # ------------------------------------------------------------------\n  for kind, count in required.items():\n      for _ in range(count):\n          path = find_path(state, kind)\n          for act in path:\n              _, state = state.step(act)\n              actions.append(act)\n          # Pick up the primitive now under the agent\n          _, state = state.step(ACTION_USE)\n          actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # 2) Move to the workshop (if any) and craft the goal item.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get('_at')\n  if workshop_kind is not None:\n      path = find_path(state, workshop_kind)\n      for act in path:\n          _, state = state.step(act)\n          actions.append(act)\n      # Use the workshop to craft the item\n      _, state = state.step(ACTION_USE)\n      actions.append(ACTION_USE)\n\n  return actions", "env_interactions": 0, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T16:07:30.235496", "function_name": "make_arrow", "function_body": "  # Reset the environment to a fresh state\n  env.reset()\n  world = env.world\n  scenario = env.scenario\n  state = env._current_state\n\n  # Index of the goal item (arrow)\n  goal_idx = env.task.goal\n\n  # Primitive ingredients required (including transitive ones)\n  required = world.cookbook.primitives_for(goal_idx)\n\n  # Determine workshop (if any) where the final crafting must happen\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else world.cookbook.index[wk]\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # ------------------------------------------------------------------\n  # Helper: Manhattan move sequence (action indices)\n  #   DOWN=0, UP=1, LEFT=2, RIGHT=3\n  # ------------------------------------------------------------------\n  def moves_to(start, target):\n      x, y = start\n      tx, ty = target\n      seq = []\n      while x < tx:\n          seq.append(3)   # RIGHT\n          x += 1\n      while x > tx:\n          seq.append(2)   # LEFT\n          x -= 1\n      while y < ty:\n          seq.append(0)   # DOWN\n          y += 1\n      while y > ty:\n          seq.append(1)   # UP\n          y -= 1\n      return seq, (x, y)\n\n  # ------------------------------------------------------------------\n  # Helper: locate the nearest cell containing at least one of `kind`\n  # ------------------------------------------------------------------\n  def nearest_cell(kind, from_pos):\n      cells = np.argwhere(scenario.init_grid[:, :, kind] > 0)\n      if cells.size == 0:\n          return None\n      dists = np.abs(cells[:, 0] - from_pos[0]) + np.abs(cells[:, 1] - from_pos[1])\n      idx = dists.argmin()\n      return tuple(cells[idx])\n\n  # ------------------------------------------------------------------\n  # Collect all required primitive items\n  # ------------------------------------------------------------------\n  for kind, cnt in required.items():\n      for _ in range(cnt):\n          target = nearest_cell(kind, cur_pos)\n          if target is None:\n              # Primitive not present on the map \u2013 skip this instance\n              continue\n          move_seq, cur_pos = moves_to(cur_pos, target)\n          actions.extend(move_seq)\n          actions.append(4)   # USE to pick up the primitive\n\n  # ------------------------------------------------------------------\n  # Move to the workshop (if required) and craft the final item\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      target = nearest_cell(workshop_kind, cur_pos)\n      if target is not None:\n          move_seq, cur_pos = moves_to(cur_pos, target)\n          actions.extend(move_seq)\n          actions.append(4)   # USE to craft at the workshop\n\n  return actions", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T16:07:31.410579", "function_name": "make_arrow", "function_body": "  # Reset environment and extract useful references\n  env.reset()\n  world = env.world\n  scenario = env.scenario\n  state = env._current_state\n\n  # Index of the goal item (arrow)\n  goal_idx = env.task.goal\n\n  # Primitive requirements (including transitive ones)\n  required = world.cookbook.primitives_for(goal_idx)\n\n  # Workshop required for final crafting (if any)\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else world.cookbook.index[wk]\n\n  # ------------------------------------------------------------------\n  # Helpers\n  # ------------------------------------------------------------------\n  ACTIONS = {\"DOWN\": 0, \"UP\": 1, \"LEFT\": 2, \"RIGHT\": 3, \"USE\": 4}\n  DIRS = [(0, 1, ACTIONS[\"DOWN\"]), (0, -1, ACTIONS[\"UP\"]),\n          (-1, 0, ACTIONS[\"LEFT\"]), (1, 0, ACTIONS[\"RIGHT\"])]\n\n  def bfs_path(start, target, allow_target_kind=None):\n      \"\"\"Return a list of positions from start to target using BFS.\n      Cells occupied by any non\u2011grabbable entity are treated as blocked,\n      except the target cell if it contains `allow_target_kind`.\"\"\"\n      W, H = scenario.init_grid.shape[:2]\n      q = collections.deque()\n      q.append(start)\n      visited = {start: None}\n      while q:\n          x, y = q.popleft()\n          if (x, y) == target:\n              # reconstruct path\n              path = []\n              cur = target\n              while cur != start:\n                  path.append(cur)\n                  cur = visited[cur]\n              path.append(start)\n              return list(reversed(path))\n          for dx, dy, _ in DIRS:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < W and 0 <= ny < H):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              # check blockage\n              blocked = False\n              for idx in world.non_grabbable_indices:\n                  if scenario.init_grid[nx, ny, idx] > 0:\n                      blocked = True\n                      break\n              if blocked:\n                  # allow stepping onto the target if it holds the needed kind\n                  if (nx, ny) == target and allow_target_kind is not None:\n                      if scenario.init_grid[nx, ny, allow_target_kind] > 0:\n                          blocked = False\n              if not blocked:\n                  visited[(nx, ny)] = (x, y)\n                  q.append((nx, ny))\n      return None  # no path found\n\n  def positions_to_actions(path):\n      \"\"\"Convert a list of positions (including start) to action indices.\"\"\"\n      acts = []\n      for (x0, y0), (x1, y1) in zip(path, path[1:]):\n          if x1 == x0 + 1:\n              acts.append(ACTIONS[\"RIGHT\"])\n          elif x1 == x0 - 1:\n              acts.append(ACTIONS[\"LEFT\"])\n          elif y1 == y0 + 1:\n              acts.append(ACTIONS[\"DOWN\"])\n          elif y1 == y0 - 1:\n              acts.append(ACTIONS[\"UP\"])\n      return acts\n\n  def nearest_cell(kind, from_pos):\n      \"\"\"Find the nearest cell that contains at least one of `kind`.\"\"\"\n      cells = np.argwhere(scenario.init_grid[:, :, kind] > 0)\n      if cells.size == 0:\n          return None\n      dists = np.abs(cells[:, 0] - from_pos[0]) + np.abs(cells[:, 1] - from_pos[1])\n      idx = dists.argmin()\n      return tuple(cells[idx])\n\n  # ------------------------------------------------------------------\n  # Main plan: collect primitives then craft at workshop\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # Collect each required primitive the required number of times\n  for kind, cnt in required.items():\n      for _ in range(cnt):\n          target = nearest_cell(kind, cur_pos)\n          if target is None:\n              continue  # primitive not present; skip\n          path = bfs_path(cur_pos, target, allow_target_kind=kind)\n          if path is None:\n              continue  # cannot reach; skip\n          actions.extend(positions_to_actions(path))\n          actions.append(ACTIONS[\"USE\"])  # pick up\n          cur_pos = target\n\n  # Move to workshop (if needed) and craft the final item\n  if workshop_kind is not None:\n      target = nearest_cell(workshop_kind, cur_pos)\n      if target is not None:\n          path = bfs_path(cur_pos, target, allow_target_kind=workshop_kind)\n          if path is not None:\n              actions.extend(positions_to_actions(path))\n              actions.append(ACTIONS[\"USE\"])  # craft at workshop\n\n  return actions", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T16:08:25.780592", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # Action identifiers (as defined in the environment)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  MOVE_DELTA = {\n      DOWN:  (0, 1),\n      UP:    (0, -1),\n      LEFT:  (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  def _adjacent(p1, p2):\n      \"\"\"Return True if p1 and p2 are orthogonally adjacent.\"\"\"\n      return (abs(p1[0] - p2[0]) + abs(p1[1] - p2[1])) == 1\n\n  def _move_towards(src, dst):\n      \"\"\"Generate a list of movement actions that brings src next to dst.\n      The last movement direction will be towards dst, so a subsequent USE\n      will act on the cell containing dst.\"\"\"\n      actions = []\n      cur = list(src)\n      while not _adjacent(tuple(cur), dst):\n          dx = dst[0] - cur[0]\n          dy = dst[1] - cur[1]\n          if dx != 0:\n              act = RIGHT if dx > 0 else LEFT\n          else:\n              act = DOWN if dy > 0 else UP\n          actions.append(act)\n          delta = MOVE_DELTA[act]\n          cur[0] += delta[0]\n          cur[1] += delta[1]\n      return actions\n\n  # ------------------------------------------------------------------\n  # 1. Resolve goal index for the arrow\n  # ------------------------------------------------------------------\n  try:\n      goal_idx = env.world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []  # cannot locate the goal\n\n  # ------------------------------------------------------------------\n  # 2. Shortcut: already have the goal in inventory?\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      # Try to obtain a fresh state via reset (if available)\n      try:\n          obs = env.reset()\n          state = env._current_state\n      except Exception:\n          return []  # no access to state\n  if state.inventory[goal_idx] > 0:\n      return []  # nothing to do\n\n  # ------------------------------------------------------------------\n  # 3. Determine all primitive requirements (recursive expansion)\n  # ------------------------------------------------------------------\n  cookbook = env.world.cookbook\n  primitive_set = cookbook.primitives\n  recipe_cache = {}\n\n  def _expand(goal):\n      \"\"\"Return a dict {primitive_idx: count} needed for goal.\"\"\"\n      if goal in primitive_set:\n          return {goal: 1}\n      if goal in recipe_cache:\n          return recipe_cache[goal].copy()\n      rec = cookbook.recipes.get(goal, {})\n      needed = {}\n      for ing, cnt in rec.items():\n          if ing == \"_at\":\n              continue\n          sub = _expand(ing)\n          for k, v in sub.items():\n              needed[k] = needed.get(k, 0) + v * cnt\n      recipe_cache[goal] = needed.copy()\n      return needed\n\n  needed_prims = _expand(goal_idx)\n\n  # ------------------------------------------------------------------\n  # 4. Build a plan: collect primitives then craft at workshop\n  # ------------------------------------------------------------------\n  actions_plan = []\n  cur_pos = tuple(state.pos)\n\n  # Helper to locate the first occurrence of a kind on the grid\n  def _find_one(kind):\n      coords = np.argwhere(state.grid[:, :, kind] > 0)\n      if coords.shape[0] == 0:\n          return None\n      # pick the closest to current position (Manhattan)\n      dists = np.abs(coords[:, 0] - cur_pos[0]) + np.abs(coords[:, 1] - cur_pos[1])\n      best = coords[dists.argmin()]\n      return (int(best[0]), int(best[1]))\n\n  # Collect each required primitive (respecting required count)\n  for prim_idx, cnt in needed_prims.items():\n      for _ in range(cnt):\n          target = _find_one(prim_idx)\n          if target is None:\n              # primitive not present on the map \u2013 abort planning\n              return []\n          # move adjacent to the primitive and use\n          actions_plan.extend(_move_towards(cur_pos, target))\n          actions_plan.append(USE)  # pick up\n          # update simulated position (after last move)\n          # The last movement direction points toward the primitive,\n          # so after the move we are adjacent; we stay in that cell.\n          # Re\u2011compute position after the sequence:\n          for act in actions_plan[-(len(_move_towards(cur_pos, target))):]:\n              delta = MOVE_DELTA[act]\n              cur_pos = (cur_pos[0] + delta[0], cur_pos[1] + delta[1])\n          # After USE we remain in the same cell\n          # Remove the collected primitive from the grid copy so that\n          # subsequent searches do not pick the same instance.\n          state.grid[target[0], target[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 5. Move to the workshop for the final crafting step\n  # ------------------------------------------------------------------\n  final_recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_idx = final_recipe.get(\"_at\")\n  if workshop_idx is None:\n      # No specific workshop \u2013 assume crafting can happen anywhere.\n      return actions_plan\n\n  # locate a workshop cell\n  workshop_pos = _find_one(workshop_idx)\n  if workshop_pos is None:\n      return actions_plan  # cannot find workshop, return what we have\n\n  actions_plan.extend(_move_towards(cur_pos, workshop_pos))\n  actions_plan.append(USE)  # craft the arrow\n\n  return actions_plan", "env_interactions": 0, "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-10-27T16:08:26.960543", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Helper utilities (local to this function)\n  # ----------------------------------------------------------------------\n  # Action indices as defined by the environment\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  # movement vectors corresponding to the action indices\n  _DIRS = {\n      DOWN: (1, 0),\n      UP: (-1, 0),\n      LEFT: (0, -1),\n      RIGHT: (0, 1),\n  }\n\n  def _in_bounds(p, shape):\n      \"\"\"Check if a position lies within the grid.\"\"\"\n      x, y = p\n      return 0 <= x < shape[0] and 0 <= y < shape[1]\n\n  def _cell_empty(pos, grid):\n      \"\"\"Return True if the cell at `pos` contains no entities.\"\"\"\n      return grid[pos[0], pos[1], :].sum() == 0\n\n  def _adjacent_empty(target, grid):\n      \"\"\"Find an empty neighbour of `target`. Returns None if none exist.\"\"\"\n      w, h = grid.shape[:2]\n      for dx, dy in [( -1, 0), (1, 0), (0, -1), (0, 1)]:\n          nb = (target[0] + dx, target[1] + dy)\n          if 0 <= nb[0] < w and 0 <= nb[1] < h and _cell_empty(nb, grid):\n              return nb\n      return None\n\n  def _manhattan_path(start, goal):\n      \"\"\"Yield a list of actions that moves from `start` to `goal`\n      using a simple Manhattan walk (ignoring obstacles).\"\"\"\n      actions = []\n      x, y = start\n      gx, gy = goal\n      # vertical moves\n      while x < gx:\n          actions.append(DOWN); x += 1\n      while x > gx:\n          actions.append(UP);   x -= 1\n      # horizontal moves\n      while y < gy:\n          actions.append(RIGHT); y += 1\n      while y > gy:\n          actions.append(LEFT);  y -= 1\n      return actions\n\n  def _ensure_facing(pos, neighbor, target, actions):\n      \"\"\"\n      After arriving at `neighbor`, make sure the agent is facing `target`.\n      If the last movement already points to the target, nothing is added.\n      Otherwise a small bounce (step away then back) is performed to set\n      the direction correctly.\n      Returns the (possibly updated) position after the bounce.\n      \"\"\"\n      # Desired direction from neighbor towards target\n      dx = target[0] - neighbor[0]\n      dy = target[1] - neighbor[1]\n      if dx == 1:\n          desired = DOWN\n      elif dx == -1:\n          desired = UP\n      elif dy == 1:\n          desired = RIGHT\n      elif dy == -1:\n          desired = LEFT\n      else:\n          # target is not orthogonal \u2013 should not happen\n          return neighbor\n\n      # What direction did we just move in?\n      last_dir = actions[-1] if actions else None\n      if last_dir == desired:\n          return neighbor\n\n      # Try to step one cell opposite to `desired` (if possible) and back.\n      opp = {DOWN: UP, UP: DOWN, LEFT: RIGHT, RIGHT: LEFT}[desired]\n      ox, oy = _DIRS[opp]\n      w, h = grid.shape[:2]\n      away = (neighbor[0] + ox, neighbor[1] + oy)\n      if 0 <= away[0] < w and 0 <= away[1] < h and _cell_empty(away, grid):\n          actions.append(opp)          # step away\n          actions.append(desired)      # step back (now facing target)\n          return neighbor  # position unchanged after bounce\n      else:\n          # If we cannot bounce, simply add the desired direction; the\n          # agent will move onto the target cell (which is blocked) but\n          # the environment will ignore the move \u2013 we still get the\n          # correct facing for the upcoming USE.\n          actions.append(desired)\n          return neighbor\n\n  # ----------------------------------------------------------------------\n  # Begin planning\n  # ----------------------------------------------------------------------\n  # Retrieve the index of the goal item (\"arrow\")\n  try:\n      goal_idx = env.world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []   # cannot locate the goal in this environment\n\n  # Access the current state (assumes the environment has already been reset)\n  cur_state = getattr(env, \"_current_state\", None)\n  if cur_state is None:\n      return []\n\n  # Quick exit if we already have the goal\n  if cur_state.inventory[goal_idx] > 0:\n      return []\n\n  # Local copies that we will update while planning\n  pos = tuple(cur_state.pos)\n  grid = cur_state.grid.copy()\n  inventory = cur_state.inventory.copy()\n  actions = []\n\n  # Obtain the recipe for the arrow (may be empty if primitive)\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  if not recipe:\n      # Arrow is a primitive \u2013 nothing to craft, just need to collect it\n      # (handled below as a generic collection step)\n      needed = {goal_idx: 1}\n      workshop_kind = None\n  else:\n      workshop_kind = recipe.get(\"_at\", None)\n      needed = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required ingredients (primitives or intermediate items)\n  # ------------------------------------------------------------------\n  for kind, count in needed.items():\n      # How many more of this kind we still need?\n      missing = count - inventory[kind]\n      while missing > 0:\n          # Locate the nearest instance of this kind on the grid\n          locations = np.argwhere(grid[:, :, kind] > 0)\n          if locations.size == 0:\n              # No more items of this kind \u2013 abort planning\n              return actions\n          dists = np.abs(locations - np.array(pos)).sum(axis=1)\n          target = tuple(locations[dists.argmin()])\n\n          # Find an empty neighbour from which we can interact\n          neighbor = _adjacent_empty(target, grid)\n          if neighbor is None:\n              # Cannot reach this item \u2013 abort\n              return actions\n\n          # Move to that neighbour\n          move_seq = _manhattan_path(pos, neighbor)\n          actions.extend(move_seq)\n          pos = neighbor\n\n          # Ensure we are facing the target cell\n          _ensure_facing(pos, neighbor, target, actions)\n\n          # Perform USE to pick up the item\n          actions.append(USE)\n\n          # Simulate the effect on inventory and grid\n          inventory[kind] += 1\n          grid[target[0], target[1], kind] = 0\n          missing -= 1\n\n  # ------------------------------------------------------------------\n  # 2) Craft the final item at its workshop (if a workshop is required)\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      # Locate the nearest workshop of the required type\n      locations = np.argwhere(grid[:, :, workshop_kind] > 0)\n      if locations.size == 0:\n          return actions\n      dists = np.abs(locations - np.array(pos)).sum(axis=1)\n      target = tuple(locations[dists.argmin()])\n\n      neighbor = _adjacent_empty(target, grid)\n      if neighbor is None:\n          return actions\n\n      move_seq = _manhattan_path(pos, neighbor)\n      actions.extend(move_seq)\n      pos = neighbor\n\n      _ensure_facing(pos, neighbor, target, actions)\n\n      # Use the workshop to craft the item\n      actions.append(USE)\n\n      # Simulate crafting: consume ingredients and produce the goal\n      for k, v in needed.items():\n          inventory[k] = max(0, inventory[k] - v)\n      inventory[goal_idx] += 1\n\n  # Return the complete action list\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T16:08:50.242854", "function_name": "make_arrow", "function_body": "  # Reset environment to obtain initial state and task information\n  env.reset()\n  # Goal index for the item to be crafted (arrow)\n  goal_idx = getattr(env, \"task\", None)\n  if goal_idx is None:\n      # Fallback: try to get from task attribute if it's a namedtuple\n      goal_idx = getattr(env, \"task\", None)\n      if isinstance(goal_idx, tuple):\n          goal_idx = goal_idx[0]\n  if isinstance(goal_idx, tuple):\n      goal_idx = goal_idx[0]\n  # If still not an int, try to read from the current state (may store goal elsewhere)\n  if not isinstance(goal_idx, int):\n      raise ValueError(\"Unable to determine goal index from environment.\")\n\n  # Obtain the primitive requirements for the goal\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # dict {prim_idx: count}\n  # Determine the workshop index where the goal must be crafted\n  workshop_idx = None\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  if \"_at\" in recipe:\n      workshop_idx = recipe[\"_at\"]\n  else:\n      # Some recipes may use the key \"_key\" for workshop location\n      workshop_idx = recipe.get(\"_key\", None)\n  if workshop_idx is None:\n      raise ValueError(\"Workshop index for goal not found in recipe.\")\n\n  actions = []\n\n  # Helper to move the agent towards a target coordinate using Manhattan steps\n  def move_to(target):\n      while env._current_state.pos != target:\n          cur_x, cur_y = env._current_state.pos\n          tgt_x, tgt_y = target\n          if cur_x < tgt_x:\n              act = 3  # RIGHT\n          elif cur_x > tgt_x:\n              act = 2  # LEFT\n          elif cur_y < tgt_y:\n              act = 0  # DOWN (y grows downwards)\n          else:\n              act = 1  # UP\n          actions.append(act)\n          # Execute action; ignore reward/done/obs\n          env.step(act)\n\n  # Collect each required primitive the necessary number of times\n  for prim_idx, needed_cnt in primitives_needed.items():\n      for _ in range(needed_cnt):\n          # Locate all cells that currently contain this primitive\n          grid_layer = env._current_state.grid[:, :, prim_idx]\n          ys, xs = np.where(grid_layer > 0)\n          if len(xs) == 0:\n              raise RuntimeError(f\"Primitive {prim_idx} not found on the grid.\")\n          # Choose the nearest primitive cell (Manhattan distance)\n          cur_x, cur_y = env._current_state.pos\n          dists = np.abs(xs - cur_x) + np.abs(ys - cur_y)\n          nearest_idx = int(np.argmin(dists))\n          target_pos = (int(xs[nearest_idx]), int(ys[nearest_idx]))\n          # Move to the primitive\n          move_to(target_pos)\n          # Pick it up using the USE action (index 4)\n          actions.append(4)\n          env.step(4)\n\n  # After gathering all primitives, move to any workshop cell of the required type\n  workshop_layer = env._current_state.grid[:, :, workshop_idx]\n  ys, xs = np.where(workshop_layer > 0)\n  if len(xs) == 0:\n      raise RuntimeError(\"No workshop of the required type found on the grid.\")\n  # Choose the nearest workshop\n  cur_x, cur_y = env._current_state.pos\n  dists = np.abs(xs - cur_x) + np.abs(ys - cur_y)\n  nearest_idx = int(np.argmin(dists))\n  workshop_pos = (int(xs[nearest_idx]), int(ys[nearest_idx]))\n  move_to(workshop_pos)\n\n  # Craft the goal item at the workshop\n  actions.append(4)\n  env.step(4)\n\n  # Return the complete action sequence\n  return actions", "env_interactions": 0, "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-10-27T16:08:51.408129", "function_name": "make_arrow", "function_body": "  # Simple stochastic planner: keep taking random actions until the task is done\n  # or a hard step limit is reached. This works for most CraftWorld levels where\n  # the goal is reachable with unrestricted movement and use actions.\n  # The environment is assumed to be a CraftLab instance (as described above).\n\n  # Reset the environment to start a fresh episode\n  env.reset()\n  actions = []\n  rng = np.random.RandomState(0)          # deterministic randomness\n  max_steps = getattr(env, \"max_steps\", 500)  # fallback if attribute missing\n\n  # Loop until the environment signals completion or we exceed the step budget\n  while not env._is_done() and len(actions) < max_steps:\n      act = int(rng.randint(0, 5))        # action IDs: 0\u20114 (DOWN, UP, LEFT, RIGHT, USE)\n      _, _ = env.step(act)                # step returns (reward, done) but we ignore reward\n      actions.append(act)\n\n  return actions", "env_interactions": 0, "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-10-27T16:09:34.615721", "function_name": "make_arrow", "function_body": "  \"\"\"Generate a sequence of actions to craft an arrow in the given CraftWorld environment.\"\"\"\n  # Reset the environment to a clean start\n  env.reset()\n  state = env._current_state\n\n  # Determine the goal index for the arrow item\n  if hasattr(env, \"task\") and hasattr(env.task, \"goal\"):\n      goal_idx = env.task.goal\n  else:\n      goal_idx = env.world.cookbook.index[\"arrow\"]\n\n  # Primitive requirements for the goal (arrow)\n  primitives = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n\n  # Map action names to integer codes\n  act_spec = env.action_specs()\n  ACT_DOWN = act_spec[\"DOWN\"]\n  ACT_UP = act_spec[\"UP\"]\n  ACT_LEFT = act_spec[\"LEFT\"]\n  ACT_RIGHT = act_spec[\"RIGHT\"]\n  ACT_USE = act_spec[\"USE\"]\n\n  actions = []\n\n  # -------------------------------------------------------------------------\n  # Helper: move the agent to an absolute grid position (ignoring obstacles)\n  # -------------------------------------------------------------------------\n  def move_to(target_pos):\n      nonlocal actions, state\n      while state.pos != target_pos:\n          y, x = state.pos\n          ty, tx = target_pos\n          if y < ty:\n              act = ACT_DOWN\n          elif y > ty:\n              act = ACT_UP\n          elif x < tx:\n              act = ACT_RIGHT\n          else:\n              act = ACT_LEFT\n          actions.append(act)\n          _, _, _ = env.step(act)          # ignore reward/done/obs\n          state = env._current_state\n\n  # -------------------------------------------------------------------------\n  # Helper: locate the nearest cell that contains a given kind index\n  # -------------------------------------------------------------------------\n  def find_nearest(kind_idx):\n      grid = state.grid\n      h, w, _ = grid.shape\n      best = None\n      best_dist = None\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  dist = abs(i - state.pos[0]) + abs(j - state.pos[1])\n                  if best_dist is None or dist < best_dist:\n                      best_dist = dist\n                      best = (i, j)\n      return best\n\n  # -------------------------------------------------------------------------\n  # Helper: given a target cell, pick an adjacent free cell (or stay if none)\n  # -------------------------------------------------------------------------\n  def adjacent_free(target):\n      grid = state.grid\n      h, w, _ = grid.shape\n      for dy in (-1, 0, 1):\n          for dx in (-1, 0, 1):\n              ny, nx = target[0] + dy, target[1] + dx\n              if 0 <= ny < h and 0 <= nx < w:\n                  if not grid[ny, nx, :].any():\n                      return (ny, nx)\n      return target\n\n  # -------------------------------------------------------------------------\n  # Collect all required primitives\n  # -------------------------------------------------------------------------\n  for kind_idx, needed in primitives.items():\n      for _ in range(needed):\n          pos = find_nearest(kind_idx)\n          if pos is None:\n              # Primitive not present; cannot continue\n              continue\n          adj = adjacent_free(pos)\n          move_to(adj)\n          actions.append(ACT_USE)\n          _, _, _ = env.step(ACT_USE)\n          state = env._current_state\n\n  # -------------------------------------------------------------------------\n  # Move to the appropriate workshop and craft the goal item\n  # -------------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      ws_pos = find_nearest(workshop_idx)\n      if ws_pos:\n          adj = adjacent_free(ws_pos)\n          move_to(adj)\n          actions.append(ACT_USE)          # use at workshop to craft\n          _, _, _ = env.step(ACT_USE)\n          state = env._current_state\n\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T16:09:35.778933", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n\n  # Determine goal index for \"arrow\"\n  if hasattr(env, \"task\") and hasattr(env.task, \"goal\"):\n      goal_idx = env.task.goal\n  else:\n      goal_idx = env.world.cookbook.index[\"arrow\"]\n\n  # Primitive requirements for the goal\n  primitives = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n\n  # Action spec mapping\n  act_spec = env.action_specs()\n  ACT_DOWN = act_spec[\"DOWN\"]\n  ACT_UP = act_spec[\"UP\"]\n  ACT_LEFT = act_spec[\"LEFT\"]\n  ACT_RIGHT = act_spec[\"RIGHT\"]\n  ACT_USE = act_spec[\"USE\"]\n\n  # Direction \u2194 action helpers\n  delta_to_act = {\n      (1, 0): ACT_DOWN,\n      (-1, 0): ACT_UP,\n      (0, -1): ACT_LEFT,\n      (0, 1): ACT_RIGHT,\n  }\n\n  actions = []\n\n  # -------------------------------------------------------------------------\n  # Helper: BFS pathfinding on the current grid (ignoring the target cell)\n  # -------------------------------------------------------------------------\n  def bfs(start, goal):\n      \"\"\"Return a list of actions to move from start to goal (both free cells).\"\"\"\n      from collections import deque\n\n      h, w, _ = state.grid.shape\n      visited = np.full((h, w), False, dtype=bool)\n      prev = {}\n      q = deque()\n      q.append(start)\n      visited[start] = True\n\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          y, x = cur\n          for dy, dx in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < h and 0 <= nx < w and not visited[ny, nx]:\n                  # allow stepping onto the goal even if it is occupied\n                  if not state.grid[ny, nx, :].any() or (ny, nx) == goal:\n                      visited[ny, nx] = True\n                      prev[(ny, nx)] = (y, x)\n                      q.append((ny, nx))\n\n      if start == goal:\n          return []\n\n      if goal not in prev:\n          # No path found \u2013 return empty list (will be ignored)\n          return []\n\n      # Reconstruct actions\n      path_actions = []\n      cur = goal\n      while cur != start:\n          p = prev[cur]\n          dy, dx = cur[0] - p[0], cur[1] - p[1]\n          path_actions.append(delta_to_act[(dy, dx)])\n          cur = p\n      path_actions.reverse()\n      return path_actions\n\n  # -------------------------------------------------------------------------\n  # Helper: move agent to a free target cell using BFS\n  # -------------------------------------------------------------------------\n  def move_to(target):\n      nonlocal actions, state\n      for act in bfs(state.pos, target):\n          actions.append(act)\n          _, _, _ = env.step(act)\n          state = env._current_state\n\n  # -------------------------------------------------------------------------\n  # Helper: locate the nearest cell containing a given kind index\n  # -------------------------------------------------------------------------\n  def find_nearest(kind_idx):\n      grid = state.grid\n      h, w, _ = grid.shape\n      py, px = state.pos\n      best = None\n      best_dist = None\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  dist = abs(i - py) + abs(j - px)\n                  if best_dist is None or dist < best_dist:\n                      best_dist = dist\n                      best = (i, j)\n      return best\n\n  # -------------------------------------------------------------------------\n  # Helper: pick a free cell adjacent (including diagonal) to a given cell\n  # -------------------------------------------------------------------------\n  def adjacent_free(cell):\n      y, x = cell\n      h, w, _ = state.grid.shape\n      # Prefer the cell itself if it is free\n      if not state.grid[y, x, :].any():\n          return (y, x)\n      for dy in (-1, 0, 1):\n          for dx in (-1, 0, 1):\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < h and 0 <= nx < w:\n                  if not state.grid[ny, nx, :].any():\n                      return (ny, nx)\n      # Fallback: stay where we are\n      return state.pos\n\n  # -------------------------------------------------------------------------\n  # Collect all required primitives\n  # -------------------------------------------------------------------------\n  for kind_idx, needed in primitives.items():\n      for _ in range(needed):\n          pos = find_nearest(kind_idx)\n          if pos is None:\n              continue  # primitive not present \u2013 skip\n          adj = adjacent_free(pos)\n          move_to(adj)\n          actions.append(ACT_USE)\n          _, _, _ = env.step(ACT_USE)\n          state = env._current_state\n\n  # -------------------------------------------------------------------------\n  # Move to the workshop (if any) and craft the goal item\n  # -------------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      ws_pos = find_nearest(workshop_idx)\n      if ws_pos:\n          adj = adjacent_free(ws_pos)\n          move_to(adj)\n          actions.append(ACT_USE)\n          _, _, _ = env.step(ACT_USE)\n          state = env._current_state\n\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T16:09:58.084690", "function_name": "make_arrow", "function_body": "  # action indices as defined by CraftLab\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # reset the environment to obtain a fresh state\n  env.reset()\n  state = env._current_state          # type: CraftState\n  world = env.scenario.world          # type: CraftWorld\n  cookbook = world.cookbook            # type: Cookbook\n  index = cookbook.index               # maps names \u2194 integer ids\n\n  # ------------------------------------------------------------------\n  # 1. Identify the goal (arrow) and the primitive ingredients required.\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  if goal_name not in index.contents:\n      return []                       # arrow not defined in this world\n\n  goal_idx = index[goal_name]          # integer id of the arrow item\n  primitive_needs = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n  actions = []                         # list of actions to return\n\n  # ------------------------------------------------------------------\n  # Helper: generate a simple Manhattan path from current to target.\n  # ------------------------------------------------------------------\n  def _move_to(start, target):\n      \"\"\"Return a list of move actions (DOWN/UP/RIGHT/LEFT) that walks\n      from start (r,c) to target (r,c) using a greedy Manhattan approach.\n      Also returns the final position after executing those moves.\"\"\"\n      r, c = start\n      tr, tc = target\n      seq = []\n      while (r, c) != (tr, tc):\n          if r < tr:\n              seq.append(DOWN)\n              r += 1\n          elif r > tr:\n              seq.append(UP)\n              r -= 1\n          elif c < tc:\n              seq.append(RIGHT)\n              c += 1\n          else:  # c > tc\n              seq.append(LEFT)\n              c -= 1\n      return seq, (r, c)\n\n  # ------------------------------------------------------------------\n  # 2. Collect each required primitive.\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          # locate any cell that currently contains this primitive\n          primitive_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if primitive_cells.size == 0:\n              # No more of this primitive on the map \u2013 give up.\n              return actions\n          target_r, target_c = primitive_cells[0]\n\n          # move next to the primitive cell (greedy Manhattan)\n          move_seq, new_pos = _move_to(state.pos, (target_r, target_c))\n          actions.extend(move_seq)\n          state.pos = new_pos\n\n          # pick it up (USE).  In the default CraftWorld implementation,\n          # using on the same cell works for picking up items.\n          actions.append(USE)\n\n          # Update our internal copy of the state so that subsequent\n          # planning steps see the primitive as consumed.\n          state.inventory[prim_idx] += 1\n          state.grid[target_r, target_c, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 3. Go to the appropriate workshop and craft the arrow.\n  # ------------------------------------------------------------------\n  # The workshop name is stored under the special key \"_at\" in the recipe.\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      return actions                     # no workshop information\n\n  workshop_idx = index[workshop_name]\n\n  # locate a workshop cell (any will do)\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      return actions                     # cannot find a workshop\n\n  w_r, w_c = workshop_cells[0]\n\n  # move to the workshop cell\n  move_seq, new_pos = _move_to(state.pos, (w_r, w_c))\n  actions.extend(move_seq)\n  state.pos = new_pos\n\n  # craft the arrow (USE while standing on the workshop)\n  actions.append(USE)\n\n  return actions", "env_interactions": 24, "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T16:09:59.241963", "function_name": "make_arrow", "function_body": "  # Placeholder implementation: return an empty action sequence.\n  return []", "env_interactions": 0, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T16:10:24.371492", "function_name": "make_arrow", "function_body": "  # Helper: breadth\u2011first search on the current grid.\n  from collections import deque\n\n  def bfs(start, goals, grid):\n      \"\"\"Return a list of actions (0\u20114) moving from start to any cell in goals.\"\"\"\n      # movement deltas correspond to action indices: 0\u2011DOWN, 1\u2011UP, 2\u2011LEFT, 3\u2011RIGHT\n      deltas = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n      visited = {start}\n      q = deque([(start, [])])\n      while q:\n          pos, path = q.popleft()\n          if pos in goals:\n              return path\n          for a, (dx, dy) in enumerate(deltas):\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if nx < 0 or ny < 0 or nx >= grid.shape[0] or ny >= grid.shape[1]:\n                  continue\n              # a cell is traversable if it is empty or it is one of the goal cells\n              if not grid[nx, ny].any() or (nx, ny) in goals:\n                  npos = (nx, ny)\n                  if npos not in visited:\n                      visited.add(npos)\n                      q.append((npos, path + [a]))\n      return None\n\n  # ----------------------------------------------------------------------\n  # Main planning loop\n  # ----------------------------------------------------------------------\n  state = env._current_state               # current CraftState\n  world = state.world                       # reference to CraftWorld\n  cookbook = world.cookbook\n\n  # index of the target item (arrow)\n  arrow_idx = cookbook.index.get(\"arrow\")\n  if arrow_idx is None:\n      # fallback: try capitalised name\n      arrow_idx = cookbook.index.get(\"Arrow\")\n  if arrow_idx is None:\n      return []  # cannot find recipe \u2013 nothing to do\n\n  # primitive requirements for a single arrow\n  primitive_req = cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n  actions = []\n\n  # repeat until we have at least one arrow in inventory\n  while state.inventory[arrow_idx] == 0:\n      # ------------------------------------------------------------------\n      # Determine which primitives we still need\n      # ------------------------------------------------------------------\n      missing = {\n          p_idx: cnt - state.inventory[p_idx]\n          for p_idx, cnt in primitive_req.items()\n          if state.inventory[p_idx] < cnt\n      }\n\n      if missing:\n          # --------------------------------------------------------------\n          # Find the nearest cell that contains any missing primitive\n          # --------------------------------------------------------------\n          target_cells = set()\n          for p_idx in missing:\n              xs, ys = np.where(state.grid[:, :, p_idx] > 0)\n              for x, y in zip(xs, ys):\n                  target_cells.add((int(x), int(y)))\n\n          # BFS to the closest such cell\n          path = bfs(state.pos, target_cells, state.grid)\n          if path is None:\n              # no reachable primitive \u2013 give up\n              break\n\n          # Execute the movement actions\n          for a in path:\n              actions.append(a)\n              _, state = state.step(a)\n\n          # Use action to pick up the primitive (action index 4)\n          actions.append(4)\n          _, state = state.step(4)\n      else:\n          # --------------------------------------------------------------\n          # All primitives are collected \u2013 go to the required workshop\n          # --------------------------------------------------------------\n          recipe = cookbook.recipes.get(arrow_idx, {})\n          workshop_name = recipe.get(\"_at\")\n          if not workshop_name:\n              break\n          workshop_idx = cookbook.index.get(workshop_name)\n          if workshop_idx is None:\n              break\n\n          xs, ys = np.where(state.grid[:, :, workshop_idx] > 0)\n          if len(xs) == 0:\n              break\n          workshop_pos = (int(xs[0]), int(ys[0]))\n\n          path = bfs(state.pos, {workshop_pos}, state.grid)\n          if path is None:\n              break\n\n          for a in path:\n              actions.append(a)\n              _, state = state.step(a)\n\n          # Use action to craft the arrow\n          actions.append(4)\n          _, state = state.step(4)\n\n  return actions", "env_interactions": 0, "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-10-27T16:10:25.546827", "function_name": "make_arrow", "function_body": "  # Reset the environment to start a fresh episode.\n  # Some environments may require a seed argument; try without and with seed=0.\n  try:\n      _ = env.reset()\n  except Exception:  # pragma: no cover\n      _ = env.reset(seed=0)\n\n  # Obtain the list of possible action indices from the environment.\n  # `action_specs` returns a dict like {'DOWN': 0, 'UP': 1, ...}.\n  action_dict = env.action_specs()\n  possible_actions = list(action_dict.values())\n\n  # Determine a reasonable step limit.  Many CraftWorld environments expose\n  # `max_steps`; fall back to a default if it is missing.\n  max_steps = getattr(env, \"max_steps\", 500)\n\n  # Record the sequence of actions we issue.\n  plan = []\n\n  # Walk the episode, picking random actions until the task is done\n  # (or we hit the step limit).  The `step` method returns\n  # (reward, done, observation) according to the CraftLab API.\n  done = False\n  for _ in range(max_steps):\n      if done:\n          break\n      # Sample a random action from the available set.\n      act = int(np.random.choice(possible_actions))\n      plan.append(act)\n\n      # Execute the action.\n      _, done, _ = env.step(act)\n\n      # If the environment reports completion, stop early.\n      if done:\n          break\n\n  # Return the collected action sequence.\n  return plan", "env_interactions": 0, "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-10-27T16:10:42.309976", "function_name": "make_arrow", "function_body": "  # reset the environment and grab handy references\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n\n  # --------------------------------------------------------------\n  # 1. Identify goal and required primitive resources\n  # --------------------------------------------------------------\n  goal_idx = env.task.goal\n  required = world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n\n  # --------------------------------------------------------------\n  # 2. Action indices (consistent with CraftLab)\n  # --------------------------------------------------------------\n  act_map = env.action_specs()\n  ACTION_DOWN = act_map['DOWN']\n  ACTION_UP   = act_map['UP']\n  ACTION_LEFT = act_map['LEFT']\n  ACTION_RIGHT= act_map['RIGHT']\n  ACTION_USE  = act_map['USE']\n  move_dirs = [(1, 0, ACTION_DOWN), (-1, 0, ACTION_UP),\n               (0, -1, ACTION_LEFT), (0, 1, ACTION_RIGHT)]\n\n  # --------------------------------------------------------------\n  # 3. Helper: BFS that returns a list of movement actions that\n  #    brings the agent onto a cell containing `target_kind`.\n  # --------------------------------------------------------------\n  from collections import deque\n  def find_path(cur_state, target_kind):\n      grid = cur_state.grid\n      H, W = grid.shape[:2]\n      start = cur_state.pos\n      visited = {start}\n      q = deque([(start, [])])\n\n      while q:\n          (x, y), path = q.popleft()\n          # reached a cell that holds the target (could be multiple copies)\n          if grid[x, y, target_kind] > 0:\n              return path\n          for dx, dy, act in move_dirs:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < H and 0 <= ny < W and (nx, ny) not in visited:\n                  # we may step on empty cells or the target cell itself\n                  if grid[nx, ny, :].sum() == 0 or grid[nx, ny, target_kind] > 0:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [act]))\n      # No reachable cell \u2013 return empty list (should not happen)\n      return []\n\n  actions = []\n\n  # --------------------------------------------------------------\n  # 4. Collect every required primitive (repeat for the needed count)\n  # --------------------------------------------------------------\n  for kind_idx, cnt in required.items():\n      for _ in range(cnt):\n          # move to a cell that holds this primitive\n          path = find_path(state, kind_idx)\n          for a in path:\n              _, state = state.step(a)\n              actions.append(a)\n          # pick it up\n          _, state = state.step(ACTION_USE)\n          actions.append(ACTION_USE)\n\n  # --------------------------------------------------------------\n  # 5. Move to the workshop (if any) and craft the goal item.\n  # --------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get('_at')\n  if workshop_kind is not None:\n      path = find_path(state, workshop_kind)\n      for a in path:\n          _, state = state.step(a)\n          actions.append(a)\n      # perform the craft action\n      _, state = state.step(ACTION_USE)\n      actions.append(ACTION_USE)\n\n  # --------------------------------------------------------------\n  # 6. Return the complete action sequence.\n  # --------------------------------------------------------------\n  return actions", "env_interactions": 0, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T16:10:43.500807", "function_name": "make_arrow", "function_body": "  # Reset environment and get handles to state/world\n  env.reset()\n  state = env._current_state          # type: CraftState\n  world = env.world                    # type: CraftWorld\n\n  # Goal index and required primitive counts\n  goal_idx = env.task.goal\n  required = world.cookbook.primitives_for(goal_idx)\n\n  # Action indices (consistent with CraftLab)\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n  move_dirs = [\n      (1, 0, ACTION_DOWN),\n      (-1, 0, ACTION_UP),\n      (0, -1, ACTION_LEFT),\n      (0, 1, ACTION_RIGHT),\n  ]\n\n  actions = []\n\n  from collections import deque\n\n  def find_path(cur_state, target_kind):\n      \"\"\"Breadth\u2011first search returning a list of movement actions that\n      leads the agent to any cell containing `target_kind`. The agent may\n      step onto that cell even if it is occupied; otherwise it may only\n      step onto empty cells.\"\"\"\n      grid = cur_state.grid\n      H, W = grid.shape[:2]\n      start = cur_state.pos\n      visited = {start}\n      q = deque([(start, [])])\n\n      while q:\n          (x, y), path = q.popleft()\n          if grid[x, y, target_kind] > 0:\n              return path\n          for dx, dy, act in move_dirs:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < H and 0 <= ny < W and (nx, ny) not in visited:\n                  # Can move onto empty cells or directly onto the target cell\n                  if grid[nx, ny, :].sum() == 0 or grid[nx, ny, target_kind] > 0:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [act]))\n      # Should never happen if the scenario is solvable\n      return []\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitive items.\n  # ------------------------------------------------------------------\n  for kind, cnt in required.items():\n      for _ in range(cnt):\n          # Move to the nearest cell that has this primitive\n          path = find_path(state, kind)\n          for act in path:\n              _, state = state.step(act)\n              actions.append(act)\n          # Use action to pick it up\n          _, state = state.step(ACTION_USE)\n          actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # 2) Go to the workshop (if any) and craft the goal item.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get('_at')\n  if workshop_kind is not None:\n      path = find_path(state, workshop_kind)\n      for act in path:\n          _, state = state.step(act)\n          actions.append(act)\n      # Use the workshop to craft\n      _, state = state.step(ACTION_USE)\n      actions.append(ACTION_USE)\n\n  return actions", "env_interactions": 0, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T16:16:12.299226", "function_name": "make_arrow", "function_body": "  # Reset the environment to obtain the initial internal state.\n  env.reset()\n  # Shortcut references.\n  world = env.world\n  state = env._current_state          # type: CraftState\n  goal = env.task.goal                # integer index of the desired item\n\n  # ------------------------------------------------------------------\n  # 1. Determine which primitive resources are required to craft the goal.\n  # ------------------------------------------------------------------\n  # cookbook.primitives_for returns a dict {primitive_index: count}\n  needed = dict(world.cookbook.primitives_for(goal))\n\n  actions = []  # list of action indices to be returned\n\n  # Helper to issue an action and update the local state reference.\n  def _step(act):\n      \"\"\"Execute action `act` in the environment and refresh `state`.\"\"\"\n      nonlocal state\n      _, _, _ = env.step(act)          # ignore reward / done / obs\n      state = env._current_state\n\n  # ------------------------------------------------------------------\n  # 2. Collect all required primitives.\n  # ------------------------------------------------------------------\n  while any(cnt > 0 for cnt in needed.values()):\n      # Find the nearest primitive that we still need.\n      best_kind = None\n      best_pos = None\n      best_dist = None\n      for kind, cnt in needed.items():\n          if cnt <= 0:\n              continue\n          # Locate all cells containing this kind.\n          positions = np.argwhere(state.grid[:, :, kind] > 0)\n          for (x, y) in positions:\n              dist = abs(x - state.pos[0]) + abs(y - state.pos[1])\n              if (best_dist is None) or (dist < best_dist):\n                  best_dist = dist\n                  best_kind = kind\n                  best_pos = (int(x), int(y))\n\n      # Move step\u2011by\u2011step towards the target cell.\n      while state.pos != best_pos:\n          px, py = state.pos\n          tx, ty = best_pos\n          if px < tx:\n              act = 0          # DOWN\n          elif px > tx:\n              act = 1          # UP\n          elif py < ty:\n              act = 3          # RIGHT\n          else:\n              act = 2          # LEFT\n          actions.append(act)\n          _step(act)\n\n      # Pick up the primitive.\n      actions.append(4)          # USE\n      _step(4)\n      needed[best_kind] -= 1\n\n  # ------------------------------------------------------------------\n  # 3. Move to a workshop that can craft the goal.\n  # ------------------------------------------------------------------\n  # The recipe dictionary may contain a special key \"_at\" that stores the\n  # workshop name. We need to translate that name to the corresponding kind\n  # index using the world's index mapping.\n  workshop_kind = None\n  recipe = world.cookbook.recipes.get(goal, {})\n  for key, val in recipe.items():\n      if isinstance(key, str) and key.startswith('_'):\n          # The key is something like \"_at\" and the value is the workshop name.\n          workshop_name = val\n          workshop_kind = world.cookbook.index[workshop_name]\n          break\n  # Fallback: if we could not infer the specific workshop, pick any workshop.\n  if workshop_kind is None:\n      if world.workshop_indices:\n          workshop_kind = world.workshop_indices[0]\n\n  # Locate the nearest cell that contains the chosen workshop.\n  positions = np.argwhere(state.grid[:, :, workshop_kind] > 0)\n  # If for any reason the workshop is not present, skip the movement.\n  if positions.size > 0:\n      dists = np.abs(positions - np.array(state.pos)).sum(axis=1)\n      nearest_idx = int(dists.argmin())\n      target_ws = tuple(positions[nearest_idx].tolist())\n\n      # Move to the workshop.\n      while state.pos != target_ws:\n          px, py = state.pos\n          tx, ty = target_ws\n          if px < tx:\n              act = 0          # DOWN\n          elif px > tx:\n              act = 1          # UP\n          elif py < ty:\n              act = 3          # RIGHT\n          else:\n              act = 2          # LEFT\n          actions.append(act)\n          _step(act)\n\n  # ------------------------------------------------------------------\n  # 4. Craft the goal item at the workshop.\n  # ------------------------------------------------------------------\n  # Keep using the workshop until the goal appears in the inventory.\n  while state.inventory[goal] == 0:\n      actions.append(4)          # USE (craft)\n      _step(4)\n\n  # Return the complete action list.\n  return actions", "env_interactions": 0, "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-10-27T16:16:13.699768", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # Reset environment to obtain a fresh state.\n  env.reset()\n  state = env._current_state          # type: CraftState\n  world = env.world\n\n  # Goal index for the current task.\n  goal_idx = env.task.goal\n\n  # Determine which primitive items are needed for the goal.\n  needed = world.cookbook.primitives_for(goal_idx)   # dict {kind_idx: count}\n\n  # Identify the workshop (if any) required for crafting this item.\n  workshop_idx = None\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n\n  # Helper: locate all grid positions that contain a given kind.\n  def locate(kind):\n      grid = state.grid\n      inds = np.argwhere(grid[:, :, kind] > 0)\n      return [tuple(p) for p in inds]\n\n  # Helper: move from the current position to a target cell using\n  # Manhattan steps.  Action ordering follows the convention used in\n  # CraftWorld: 0=DOWN, 1=UP, 2=LEFT, 3=RIGHT, 4=USE.\n  def go_to(target):\n      nonlocal state\n      while state.pos != target:\n          x, y = state.pos\n          tx, ty = target\n          if x < tx:          # need to move right\n              act = 3\n              new_pos = (x + 1, y)\n          elif x > tx:        # need to move left\n              act = 2\n              new_pos = (x - 1, y)\n          elif y < ty:        # need to move down\n              act = 0\n              new_pos = (x, y + 1)\n          else:               # need to move up\n              act = 1\n              new_pos = (x, y - 1)\n\n          actions.append(act)\n          _, state = state.step(act)   # apply action, update state\n\n  actions = []\n\n  # Gather each required primitive the required number of times.\n  for kind, cnt in needed.items():\n      for _ in range(cnt):\n          positions = locate(kind)\n          if not positions:\n              # Primitive not present \u2013 abort early.\n              return actions\n          # Choose the first occurrence (could be improved with nearest\u2011search).\n          target_pos = positions[0]\n          go_to(target_pos)\n          # Pick up the item.\n          actions.append(4)          # USE\n          _, state = state.step(4)\n\n  # Finally, go to the appropriate workshop (if any) and craft.\n  if workshop_idx is not None:\n      ws_positions = locate(workshop_idx)\n      if ws_positions:\n          go_to(ws_positions[0])\n          actions.append(4)          # USE to craft\n          _, state = state.step(4)\n\n  return actions", "env_interactions": 0, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T16:16:29.458013", "function_name": "make_arrow", "function_body": "  # Action indices\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def _move_actions(src, dst):\n      \"\"\"Return a list of actions that move Manhattan\u2011wise from src to dst.\"\"\"\n      actions = []\n      x, y = src\n      tx, ty = dst\n      dx = tx - x\n      dy = ty - y\n      if dx > 0:\n          actions += [DOWN] * dx\n      elif dx < 0:\n          actions += [UP] * (-dx)\n      if dy > 0:\n          actions += [RIGHT] * dy\n      elif dy < 0:\n          actions += [LEFT] * (-dy)\n      return actions\n\n  def _nearest_kind(pos, kind_idx):\n      \"\"\"Find the nearest cell (Manhattan distance) that contains kind_idx.\"\"\"\n      grid = env._current_state.grid\n      coords = np.argwhere(grid[:, :, kind_idx] > 0)\n      if coords.size == 0:\n          return None\n      dists = np.abs(coords[:, 0] - pos[0]) + np.abs(coords[:, 1] - pos[1])\n      nearest = coords[dists.argmin()]\n      return tuple(nearest.tolist())\n\n  # ------------------------------------------------------------------\n  # 1. Determine the primitives needed to craft an arrow\n  # ------------------------------------------------------------------\n  world = env.world\n  arrow_idx = world.cookbook.index.index('arrow')\n  primitives_needed = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # 2. Collect all required primitives\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = env._current_state.pos\n\n  for prim_idx, count in primitives_needed.items():\n      for _ in range(count):\n          target = _nearest_kind(cur_pos, prim_idx)\n          if target is None:\n              # Primitive not present \u2013 abort planning\n              return actions\n          actions += _move_actions(cur_pos, target)\n          cur_pos = target\n          actions.append(USE)          # PICKUP primitive\n\n  # ------------------------------------------------------------------\n  # 3. Move to the workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  workshop_name = world.cookbook.recipes[arrow_idx].get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = _nearest_kind(cur_pos, workshop_idx)\n      if workshop_pos is not None:\n          actions += _move_actions(cur_pos, workshop_pos)\n          cur_pos = workshop_pos\n          actions.append(USE)          # CRAFT at workshop\n\n  return actions", "env_interactions": 22, "island_id": 5, "scores": {"3": 0.2}}
{"timestamp": "2025-10-27T16:16:30.631264", "function_name": "make_arrow", "function_body": "  # Action indices (as defined in the environment)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def _is_walkable(pos):\n      \"\"\"A cell is walkable if it contains no entities (including primitives).\"\"\"\n      x, y = pos\n      # any non\u2011zero in the kind dimension means occupied\n      return not env._current_state.grid[x, y, :].any()\n\n  def _bfs_path(start, goal):\n      \"\"\"Return a list of positions from start to goal using BFS (4\u2011connected).\"\"\"\n      if start == goal:\n          return [start]\n      width, height = env._current_state.grid.shape[:2]\n      frontier = collections.deque([start])\n      came_from = {start: None}\n      while frontier:\n          cur = frontier.popleft()\n          if cur == goal:\n              break\n          x, y = cur\n          for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height:\n                  nxt = (nx, ny)\n                  if nxt not in came_from and _is_walkable(nxt):\n                      came_from[nxt] = cur\n                      frontier.append(nxt)\n      else:\n          # No path found\n          return None\n\n      # reconstruct path\n      path = [goal]\n      while path[-1] != start:\n          path.append(came_from[path[-1]])\n      path.reverse()\n      return path\n\n  def _actions_from_path(path):\n      \"\"\"Convert a list of positions (including start) to action indices.\"\"\"\n      if not path or len(path) < 2:\n          return []\n      act = []\n      for (x0, y0), (x1, y1) in zip(path, path[1:]):\n          if x1 == x0 + 1:\n              act.append(DOWN)\n          elif x1 == x0 - 1:\n              act.append(UP)\n          elif y1 == y0 + 1:\n              act.append(RIGHT)\n          elif y1 == y0 - 1:\n              act.append(LEFT)\n          else:\n              raise ValueError(\"Non\u2011adjacent steps in path\")\n      return act\n\n  def _move_actions(src, dst):\n      \"\"\"Return actions to move from src to dst using BFS path\u2011finding.\"\"\"\n      path = _bfs_path(src, dst)\n      if path is None:\n          # fallback to Manhattan moves (may hit obstacles)\n          return _manhattan_actions(src, dst)\n      return _actions_from_path(path)\n\n  def _manhattan_actions(src, dst):\n      \"\"\"Simple Manhattan moves (ignores obstacles). Used as a fallback.\"\"\"\n      actions = []\n      x, y = src\n      tx, ty = dst\n      dx = tx - x\n      dy = ty - y\n      if dx > 0:\n          actions += [DOWN] * dx\n      elif dx < 0:\n          actions += [UP] * (-dx)\n      if dy > 0:\n          actions += [RIGHT] * dy\n      elif dy < 0:\n          actions += [LEFT] * (-dy)\n      return actions\n\n  def _nearest_kind(pos, kind_idx):\n      \"\"\"Find the nearest cell (Manhattan distance) that currently contains kind_idx.\"\"\"\n      grid = env._current_state.grid\n      coords = np.argwhere(grid[:, :, kind_idx] > 0)\n      if coords.size == 0:\n          return None\n      dists = np.abs(coords[:, 0] - pos[0]) + np.abs(coords[:, 1] - pos[1])\n      nearest = coords[dists.argmin()]\n      return tuple(nearest.tolist())\n\n  # ------------------------------------------------------------------\n  # 1. Determine required primitives for the target item (arrow)\n  # ------------------------------------------------------------------\n  world = env.world\n  arrow_idx = world.cookbook.index.index('arrow')\n  primitives_needed = world.cookbook.primitives_for(arrow_idx)  # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # 2. Collect all required primitives\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = env._current_state.pos\n\n  for prim_idx, cnt in primitives_needed.items():\n      for _ in range(cnt):\n          target = _nearest_kind(cur_pos, prim_idx)\n          if target is None:\n              # Primitive not present \u2013 abort planning\n              return actions\n          actions += _move_actions(cur_pos, target)\n          cur_pos = target\n          actions.append(USE)   # pick up the primitive\n\n  # ------------------------------------------------------------------\n  # 3. Move to the appropriate workshop (if any) and craft the item\n  # ------------------------------------------------------------------\n  workshop_name = world.cookbook.recipes[arrow_idx].get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = _nearest_kind(cur_pos, workshop_idx)\n      if workshop_pos is not None:\n          actions += _move_actions(cur_pos, workshop_pos)\n          cur_pos = workshop_pos\n          actions.append(USE)   # craft at the workshop\n\n  return actions", "env_interactions": 22, "island_id": 5, "scores": {"3": 0.2}}
{"timestamp": "2025-10-27T16:16:59.180180", "function_name": "make_arrow", "function_body": "  # Reset environment to a clean start\n  env.reset()\n  state = env._current_state          # current CraftState\n  world = env.world                    # CraftWorld instance\n  index = world.cookbook.index         # name \u2194 integer id\n\n  # ------------------------------------------------------------------\n  # Identify goal and its requirements\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = index[goal_name]\n\n  # Primitive counts needed for one arrow (recursively expanded)\n  primitive_counts = world.cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n\n  # Workshop required to craft the arrow (if any)\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else index[wk]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def find_locations(kind):\n      \"\"\"Return list of (x, y) where grid contains at least one of `kind`.\"\"\"\n      occ = np.where(state.grid[:, :, kind] > 0)\n      return list(zip(occ[0].tolist(), occ[1].tolist()))\n\n  def move_action(cur, nxt):\n      \"\"\"Convert a step from cur \u2192 nxt into an action index.\"\"\"\n      dx = nxt[0] - cur[0]\n      dy = nxt[1] - cur[1]\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise ValueError(\"Non\u2011adjacent move requested\")\n\n  def bfs(start, goal):\n      \"\"\"Shortest path (list of positions) from start to goal avoiding non\u2011grabbable cells.\"\"\"\n      if start == goal:\n          return [start]\n      W, H = state.grid.shape[:2]\n\n      # Cells that cannot be entered (non\u2011grabbable entities)\n      blocked = set()\n      for ng in world.non_grabbable_indices:\n          occ = np.where(state.grid[:, :, ng] > 0)\n          blocked.update(zip(occ[0].tolist(), occ[1].tolist()))\n\n      q = collections.deque([start])\n      prev = {start: None}\n      while q:\n          cur = q.popleft()\n          for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:\n                  nxt = (nx, ny)\n                  if nxt not in prev:\n                      prev[nxt] = cur\n                      if nxt == goal:\n                          # reconstruct path\n                          path = [goal]\n                          while path[-1] != start:\n                              path.append(prev[path[-1]])\n                          path.reverse()\n                          return path\n                      q.append(nxt)\n      # No path found \u2013 stay where we are\n      return [start]\n\n  # ------------------------------------------------------------------\n  # Build the action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = state.pos\n\n  # 1. Collect required primitives\n  for prim_idx, needed in primitive_counts.items():\n      for _ in range(needed):\n          locations = find_locations(prim_idx)\n          if not locations:\n              # Primitive already in inventory or not present on map\n              continue\n          target = locations[0]                       # pick first occurrence\n          path = bfs(cur_pos, target)\n          for step in path[1:]:                       # skip current position\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n          actions.append(4)                           # USE to pick up\n\n  # 2. Go to workshop (if needed) and craft the arrow\n  if workshop_kind is not None:\n      wk_locs = find_locations(workshop_kind)\n      if wk_locs:\n          target = wk_locs[0]\n          path = bfs(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n          actions.append(4)                           # USE to craft\n\n  return actions", "env_interactions": 21, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T16:17:00.363496", "function_name": "make_arrow", "function_body": "  import numpy as np, collections\n\n  # Reset the environment to a clean start\n  env.reset()\n  state = env._current_state          # current CraftState\n  world = env.world                    # CraftWorld instance\n  index = world.cookbook.index         # name \u2194 integer id mapping\n\n  # Goal specification\n  goal_name = \"arrow\"\n  goal_idx = index[goal_name]\n\n  # Primitive requirements for a single arrow\n  primitive_counts = world.cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n\n  # Workshop required for crafting the arrow (if any)\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else index[wk]\n\n  # --------------------------------------------------------------\n  # Helper utilities\n  # --------------------------------------------------------------\n\n  def find_locations(kind):\n      \"\"\"Return list of (x, y) positions where `kind` is present on the grid.\"\"\"\n      occ = np.where(state.grid[:, :, kind] > 0)\n      return list(zip(occ[0].tolist(), occ[1].tolist()))\n\n  def move_action(cur, nxt):\n      \"\"\"Convert a step between adjacent cells into an action index.\"\"\"\n      dx = nxt[0] - cur[0]\n      dy = nxt[1] - cur[1]\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise ValueError(\"Non\u2011adjacent step in path\")\n\n  def bfs(start, goal):\n      \"\"\"Shortest path (as list of positions) avoiding non\u2011grabbable cells.\"\"\"\n      if start == goal:\n          return [start]\n      W, H = state.grid.shape[:2]\n\n      # Cells that cannot be entered (water, stone, etc.)\n      blocked = set()\n      for ng in world.non_grabbable_indices:\n          occ = np.where(state.grid[:, :, ng] > 0)\n          blocked.update(zip(occ[0].tolist(), occ[1].tolist()))\n\n      q = collections.deque([start])\n      prev = {start: None}\n      while q:\n          cur = q.popleft()\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:\n                  nxt = (nx, ny)\n                  if nxt not in prev:\n                      prev[nxt] = cur\n                      if nxt == goal:\n                          # reconstruct path\n                          path = [goal]\n                          while path[-1] != start:\n                              path.append(prev[path[-1]])\n                          path.reverse()\n                          return path\n                      q.append(nxt)\n      # No path found \u2013 stay in place\n      return [start]\n\n  # --------------------------------------------------------------\n  # Planning\n  # --------------------------------------------------------------\n\n  actions = []\n  cur_pos = state.pos\n\n  # Remember which primitive cells have already been targeted\n  used_cells = set()\n\n  # Collect each required primitive the necessary number of times\n  for prim_idx, needed in primitive_counts.items():\n      for _ in range(needed):\n          # Find a still\u2011available instance of the primitive\n          locs = [loc for loc in find_locations(prim_idx) if loc not in used_cells]\n          if not locs:\n              # Assume we already have it in inventory; skip\n              continue\n          target = locs[0]\n          used_cells.add(target)\n\n          # Move to the primitive\n          path = bfs(cur_pos, target)\n          for step in path[1:]:          # skip the current position\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n\n          # Pick it up\n          actions.append(4)               # USE\n\n  # Move to the workshop (if required) and craft the arrow\n  if workshop_kind is not None:\n      wk_locs = find_locations(workshop_kind)\n      if wk_locs:\n          target = wk_locs[0]\n          path = bfs(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n          actions.append(4)               # USE to craft\n\n  return actions", "env_interactions": 21, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T16:17:30.446802", "function_name": "make_arrow", "function_body": "  # Reset environment and fetch current state/world\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  idx = world.cookbook.index           # name \u2194 integer id\n\n  # ------------------------------------------------------------------\n  # Identify goal (arrow) and its recipe\n  goal_name = \"arrow\"\n  goal_idx = idx[goal_name]\n\n  # Primitive requirements for a single arrow\n  primitive_counts = world.cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n\n  # Workshop required for crafting (if any)\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else idx[wk]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  def find_locations(kind):\n      \"\"\"Return list of (x, y) positions where the grid contains the given kind.\"\"\"\n      occ = np.where(state.grid[:, :, kind] > 0)\n      return list(zip(occ[0].tolist(), occ[1].tolist()))\n\n  def move_action(cur, nxt):\n      \"\"\"Translate a step between adjacent cells into a USE\u2011free action index.\"\"\"\n      dx = nxt[0] - cur[0]\n      dy = nxt[1] - cur[1]\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise ValueError(\"Non\u2011adjacent movement requested\")\n\n  def bfs(start, goal):\n      \"\"\"Shortest path (list of positions) from start to goal avoiding non\u2011grabbable cells.\"\"\"\n      if start == goal:\n          return [start]\n      W, H = state.grid.shape[:2]\n\n      # Cells occupied by non\u2011grabbable entities are blocked\n      blocked = set()\n      for ng in world.non_grabbable_indices:\n          occ = np.where(state.grid[:, :, ng] > 0)\n          blocked.update(zip(occ[0].tolist(), occ[1].tolist()))\n\n      q = collections.deque([start])\n      prev = {start: None}\n      while q:\n          cur = q.popleft()\n          for dx, dy in [(1,0), (-1,0), (0,1), (0,-1)]:\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:\n                  nxt = (nx, ny)\n                  if nxt not in prev:\n                      prev[nxt] = cur\n                      if nxt == goal:\n                          # reconstruct path\n                          path = [goal]\n                          while path[-1] != start:\n                              path.append(prev[path[-1]])\n                          path.reverse()\n                          return path\n                      q.append(nxt)\n      # No path found \u2013 stay where we are\n      return [start]\n\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = state.pos\n\n  # --------------------------------------------------------------\n  # Collect each required primitive the needed number of times\n  for prim_idx, needed in primitive_counts.items():\n      for _ in range(needed):\n          # Locate any remaining instance of this primitive on the grid\n          locations = find_locations(prim_idx)\n          if not locations:\n              # Assume already in inventory; skip\n              continue\n          target = locations[0]                     # pick first occurrence\n          path = bfs(cur_pos, target)\n          for step in path[1:]:                     # skip current position\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n          # Pick up the primitive\n          actions.append(4)                         # USE\n\n  # --------------------------------------------------------------\n  # Move to the workshop (if required) and craft the arrow\n  if workshop_kind is not None:\n      wk_locs = find_locations(workshop_kind)\n      if wk_locs:\n          target = wk_locs[0]\n          path = bfs(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n          # Use the workshop to craft the arrow\n          actions.append(4)                         # USE\n\n  return actions", "env_interactions": 21, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T16:17:31.623302", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  goal_name = \"arrow\"\n  goal_idx = idx[goal_name]\n\n  primitive_counts = world.cookbook.primitives_for(goal_idx)\n\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else idx[wk]\n\n  def find_locations(kind):\n      occ = np.where(state.grid[:, :, kind] > 0)\n      return list(zip(occ[0].tolist(), occ[1].tolist()))\n\n  def move_action(cur, nxt):\n      dx = nxt[0] - cur[0]\n      dy = nxt[1] - cur[1]\n      if dx == 1:\n          return 3   # RIGHT\n      if dx == -1:\n          return 2   # LEFT\n      if dy == 1:\n          return 0   # DOWN\n      if dy == -1:\n          return 1   # UP\n      raise ValueError(\"Non\u2011adjacent move\")\n\n  def bfs(start, goal):\n      if start == goal:\n          return [start]\n      W, H = state.grid.shape[:2]\n      blocked = set()\n      for ng in world.non_grabbable_indices:\n          occ = np.where(state.grid[:, :, ng] > 0)\n          blocked.update(zip(occ[0].tolist(), occ[1].tolist()))\n      q = collections.deque([start])\n      prev = {start: None}\n      while q:\n          cur = q.popleft()\n          for dx, dy in [(1,0), (-1,0), (0,1), (0,-1)]:\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:\n                  nxt = (nx, ny)\n                  if nxt not in prev:\n                      prev[nxt] = cur\n                      if nxt == goal:\n                          path = [goal]\n                          while path[-1] != start:\n                              path.append(prev[path[-1]])\n                          path.reverse()\n                          return path\n                      q.append(nxt)\n      return [start]\n\n  actions = []\n  cur_pos = state.pos\n\n  for prim_idx, needed in primitive_counts.items():\n      for _ in range(needed):\n          locs = find_locations(prim_idx)\n          if not locs:\n              continue\n          target = locs[0]\n          path = bfs(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n          actions.append(4)   # USE\n\n  if workshop_kind is not None:\n      wk_locs = find_locations(workshop_kind)\n      if wk_locs:\n          target = wk_locs[0]\n          path = bfs(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n          actions.append(4)   # USE\n\n  return actions", "env_interactions": 21, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T16:17:57.346169", "function_name": "make_arrow", "function_body": "  # Reset the environment to a fresh start\n  env.reset()\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  # Goal we want to achieve\n  goal_name = \"arrow\"\n  goal_idx = idx[goal_name]\n\n  # How many of each primitive are required for one arrow?\n  primitive_counts = world.cookbook.primitives_for(goal_idx)\n\n  # Determine the workshop (if any) where the arrow must be crafted\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else idx[wk]\n\n  # ----------------------------------------------------------------------\n  # Helper utilities\n  # ----------------------------------------------------------------------\n  def find_locations(kind):\n      \"\"\"Return a list of (x, y) positions where `kind` is present on the grid.\"\"\"\n      occ = np.where(state.grid[:, :, kind] > 0)\n      return list(zip(occ[0].tolist(), occ[1].tolist()))\n\n  def move_action(cur, nxt):\n      \"\"\"Translate a step from cur -> nxt into the corresponding action index.\"\"\"\n      dx = nxt[0] - cur[0]\n      dy = nxt[1] - cur[1]\n      if dx == 1:\n          return 3  # RIGHT\n      if dx == -1:\n          return 2  # LEFT\n      if dy == 1:\n          return 0  # DOWN\n      if dy == -1:\n          return 1  # UP\n      raise ValueError(\"Attempted to move between non\u2011adjacent cells\")\n\n  def bfs(start, goal):\n      \"\"\"Return a list of positions from start to goal using BFS (including start).\"\"\"\n      if start == goal:\n          return [start]\n      W, H = state.grid.shape[:2]\n\n      # Cells that cannot be entered (non\u2011grabbable entities)\n      blocked = set()\n      for ng in world.non_grabbable_indices:\n          occ = np.where(state.grid[:, :, ng] > 0)\n          blocked.update(zip(occ[0].tolist(), occ[1].tolist()))\n\n      q = collections.deque([start])\n      prev = {start: None}\n      while q:\n          cur = q.popleft()\n          for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:\n                  nxt = (nx, ny)\n                  if nxt not in prev:\n                      prev[nxt] = cur\n                      if nxt == goal:\n                          # Reconstruct path\n                          path = [goal]\n                          while path[-1] != start:\n                              path.append(prev[path[-1]])\n                          path.reverse()\n                          return path\n                      q.append(nxt)\n      # If no path found, just stay where we are\n      return [start]\n\n  # ----------------------------------------------------------------------\n  # Build the action sequence\n  # ----------------------------------------------------------------------\n  actions = []\n  cur_pos = state.pos\n\n  # --- Collect all required primitives ------------------------------------\n  for prim_idx, needed in primitive_counts.items():\n      for _ in range(needed):\n          # Refresh locations after each collection (grid changes)\n          locations = find_locations(prim_idx)\n          if not locations:\n              # Primitive not present; abort early\n              continue\n          target = locations[0]  # pick the first occurrence\n          path = bfs(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n          actions.append(4)  # USE to pick up the primitive\n\n  # --- Move to the workshop (if required) and craft the arrow ------------\n  if workshop_kind is not None:\n      wk_locations = find_locations(workshop_kind)\n      if wk_locations:\n          target = wk_locations[0]\n          path = bfs(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n          actions.append(4)  # USE to craft the arrow at the workshop\n\n  return actions", "env_interactions": 21, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T16:17:58.530548", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  goal_name = \"arrow\"\n  goal_idx = idx[goal_name]\n\n  # primitives required to craft one arrow\n  primitive_counts = world.cookbook.primitives_for(goal_idx)\n\n  # locate workshop (if recipe specifies one)\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else idx[wk]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def find_locations(kind):\n      \"\"\"Return list of (x, y) where `kind` is present on the grid.\"\"\"\n      occ = np.where(state.grid[:, :, kind] > 0)\n      return list(zip(occ[0].tolist(), occ[1].tolist()))\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of coordinates from start to goal avoiding non\u2011grabbable cells.\"\"\"\n      if start == goal:\n          return [start]\n      W, H = state.grid.shape[:2]\n\n      # cells occupied by non\u2011grabbable entities are treated as blocked\n      blocked = set()\n      for ng in world.non_grabbable_indices:\n          occ = np.where(state.grid[:, :, ng] > 0)\n          blocked.update(zip(occ[0].tolist(), occ[1].tolist()))\n\n      q = collections.deque([start])\n      prev = {start: None}\n      while q:\n          cur = q.popleft()\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:\n                  nxt = (nx, ny)\n                  if nxt not in prev:\n                      prev[nxt] = cur\n                      if nxt == goal:\n                          # reconstruct path\n                          path = [goal]\n                          while path[-1] != start:\n                              path.append(prev[path[-1]])\n                          path.reverse()\n                          return path\n                      q.append(nxt)\n      # fallback \u2013 no path found\n      return [start]\n\n  def move_action(cur, nxt):\n      \"\"\"Translate a step from cur \u2192 nxt into the corresponding action index.\"\"\"\n      dx = nxt[0] - cur[0]\n      dy = nxt[1] - cur[1]\n      if dx == 1:\n          return 3   # RIGHT\n      if dx == -1:\n          return 2   # LEFT\n      if dy == 1:\n          return 0   # DOWN\n      if dy == -1:\n          return 1   # UP\n      raise AssertionError(\"non\u2011adjacent move requested\")\n\n  # ------------------------------------------------------------------\n  # Build the action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = state.pos\n\n  # 1) Collect required primitives\n  for prim_idx, needed in primitive_counts.items():\n      for _ in range(needed):\n          locations = find_locations(prim_idx)\n          if not locations:\n              raise RuntimeError(f\"Primitive {idx.get(prim_idx, prim_idx)} not found on map\")\n          # choose the nearest occurrence (Manhattan distance)\n          target = min(locations, key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1]))\n          path = bfs_path(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n          actions.append(4)   # USE to pick up the primitive\n\n  # 2) Move to workshop (if required) and craft the arrow\n  if workshop_kind is not None:\n      wk_locations = find_locations(workshop_kind)\n      if not wk_locations:\n          raise RuntimeError(\"Workshop for arrow not found on map\")\n      target = min(wk_locations, key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1]))\n      path = bfs_path(cur_pos, target)\n      for step in path[1:]:\n          actions.append(move_action(cur_pos, step))\n          cur_pos = step\n      actions.append(4)   # USE to craft at the workshop\n\n  return actions", "env_interactions": 19, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T16:19:18.246413", "function_name": "make_arrow", "function_body": "  # Reset the environment and get the initial state.\n  obs = env.reset()\n  state = env._current_state\n\n  # Identify the goal item index (the task stores a tuple (name, index)).\n  goal_name, goal_idx = env.task.goal\n\n  # Primitive requirements for the goal (primitive kind index -> count).\n  required = env.world.cookbook.primitives_for(goal_idx).copy()\n\n  # Action indices as defined by the environment.\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # -------------------------------------------------------------------------\n  # Helper functions (local to this method)\n  # -------------------------------------------------------------------------\n  def _vec_to_action(dx, dy):\n      \"\"\"Convert a direction vector to the corresponding action index.\"\"\"\n      if dx == 0 and dy == 1:\n          return ACTION_DOWN\n      if dx == 0 and dy == -1:\n          return ACTION_UP\n      if dx == -1 and dy == 0:\n          return ACTION_LEFT\n      if dx == 1 and dy == 0:\n          return ACTION_RIGHT\n      raise ValueError(\"Invalid direction vector\")\n\n  def _empty_adjacent(pos, grid):\n      \"\"\"Return an empty neighbouring cell of `pos` (or None).\"\"\"\n      x, y = pos\n      w, h = grid.shape[:2]\n      for dx, dy in [(0, 1), (0, -1), (-1, 0), (1, 0)]:\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < w and 0 <= ny < h:\n              if not grid[nx, ny, :].any():\n                  return (nx, ny)\n      return None\n\n  def _bfs_path(start, targets, blocked):\n      \"\"\"Bread\u2011first search returning a list of actions from start to any target.\"\"\"\n      w, h = blocked.shape\n      queue = collections.deque()\n      queue.append((start, []))\n      visited = {start}\n      while queue:\n          (x, y), path = queue.popleft()\n          if (x, y) in targets:\n              return path\n          for dx, dy, act in [(0, 1, ACTION_DOWN), (0, -1, ACTION_UP),\n                              (-1, 0, ACTION_LEFT), (1, 0, ACTION_RIGHT)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and not blocked[nx, ny] and (nx, ny) not in visited:\n                  visited.add((nx, ny))\n                  queue.append(((nx, ny), path + [act]))\n      return None\n\n  def _orient_towards(agent_pos, agent_dir, target):\n      \"\"\"\n      Produce actions that make the agent face `target`.\n      If already facing, returns empty list; otherwise tries to turn by stepping\n      one cell away and back.\n      \"\"\"\n      ax, ay = agent_pos\n      tx, ty = target\n      dx, dy = tx - ax, ty - ay\n      needed = _vec_to_action(dx, dy)\n      if agent_dir == needed:\n          return []\n      # Try to turn by moving one cell opposite to the needed direction and back.\n      ox, oy = ax - dx, ay - dy\n      w, h = state.grid.shape[:2]\n      if 0 <= ox < w and 0 <= oy < h and not state.grid[ox, oy, :].any():\n          return [_vec_to_action(-dx, -dy), needed]\n      # Fallback: just attempt the needed direction (may be blocked).\n      return [needed]\n\n  actions = []\n\n  # -------------------------------------------------------------------------\n  # Main planning loop: collect missing primitives, then craft at a workshop.\n  # -------------------------------------------------------------------------\n  while True:\n      # Goal achieved?\n      if state.inventory[goal_idx] > 0:\n          break\n\n      # Determine which primitives are still missing.\n      missing = {k: v - state.inventory[k] for k, v in required.items()\n                 if state.inventory[k] < v}\n\n      if missing:\n          # Choose a missing primitive (arbitrary selection).\n          prim_idx = next(iter(missing))\n\n          # Locate an instance of this primitive on the grid.\n          prim_positions = list(zip(*np.where(state.grid[:, :, prim_idx] > 0)))\n          if not prim_positions:\n              # No more instances left; give up on this primitive.\n              required.pop(prim_idx, None)\n              continue\n\n          # Pick the closest instance.\n          px, py = min(prim_positions,\n                       key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))\n\n          # Find an empty cell adjacent to the primitive.\n          adj = _empty_adjacent((px, py), state.grid)\n          if adj is None:\n              # Cannot approach this instance; try another primitive later.\n              required.pop(prim_idx, None)\n              continue\n\n          # Cells that are occupied (any non\u2011zero kind).\n          blocked = state.grid.any(axis=2)\n\n          # Compute a path to the adjacent cell.\n          path = _bfs_path(state.pos, {adj}, blocked)\n          if path is None:\n              # Unreachable; discard this primitive.\n              required.pop(prim_idx, None)\n              continue\n\n          # Execute movement actions.\n          for a in path:\n              _, _ = env.step(a)\n              actions.append(a)\n              state = env._current_state\n\n          # Face the primitive and collect it.\n          orient = _orient_towards(state.pos, state.dir, (px, py))\n          for a in orient:\n              _, _ = env.step(a)\n              actions.append(a)\n              state = env._current_state\n\n          _, _ = env.step(ACTION_USE)\n          actions.append(ACTION_USE)\n          state = env._current_state\n          continue\n\n      # All required primitives are in inventory \u2013 go to a workshop to craft.\n      workshop_idx = None\n      for w_idx in env.world.workshop_indices:\n          if state.grid[:, :, w_idx].any():\n              workshop_idx = w_idx\n              break\n      if workshop_idx is None:\n          # No workshop present; cannot craft.\n          break\n\n      workshop_pos = list(zip(*np.where(state.grid[:, :, workshop_idx] > 0)))[0]\n      adj = _empty_adjacent(workshop_pos, state.grid)\n      if adj is None:\n          break\n\n      blocked = state.grid.any(axis=2)\n      path = _bfs_path(state.pos, {adj}, blocked)\n      if path is None:\n          break\n\n      for a in path:\n          _, _ = env.step(a)\n          actions.append(a)\n          state = env._current_state\n\n      orient = _orient_towards(state.pos, state.dir, workshop_pos)\n      for a in orient:\n          _, _ = env.step(a)\n          actions.append(a)\n          state = env._current_state\n\n      # Craft the goal item.\n      _, _ = env.step(ACTION_USE)\n      actions.append(ACTION_USE)\n      state = env._current_state\n\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-10-27T16:19:19.388345", "function_name": "make_arrow", "function_body": "  # Constants for actions as defined in the environment\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  actions = []\n\n  # Reset the environment to start a fresh episode\n  env.reset()\n  state = env._current_state\n  world = env.world\n\n  # Goal item index (the arrow)\n  goal_idx = env.task.goal\n\n  # Determine primitive requirements for the goal\n  needed_primitives = world.cookbook.primitives_for(goal_idx)\n\n  # Helper to move towards a target coordinate using Manhattan steps\n  def move_towards(pos, target):\n      px, py = pos\n      tx, ty = target\n      if px < tx:\n          return ACTION_RIGHT\n      if px > tx:\n          return ACTION_LEFT\n      if py < ty:\n          return ACTION_DOWN\n      if py > ty:\n          return ACTION_UP\n      return None\n\n  # Collect each required primitive\n  for prim_idx, required_cnt in needed_primitives.items():\n      while state.inventory[prim_idx] < required_cnt:\n          # Find any remaining instance of this primitive on the grid\n          locs = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if locs.size == 0:\n              # No more primitives of this type; break to avoid infinite loop\n              break\n          target_pos = tuple(locs[0][:2].tolist())\n\n          # Navigate to the primitive location\n          while state.pos != target_pos:\n              act = move_towards(state.pos, target_pos)\n              if act is None:\n                  break\n              reward, done, _ = env.step(act)\n              actions.append(act)\n              state = env._current_state\n              if done:\n                  return actions\n\n          # Pick up the primitive\n          reward, done, _ = env.step(ACTION_USE)\n          actions.append(ACTION_USE)\n          state = env._current_state\n          if done:\n              return actions\n\n  # After gathering primitives, go to the appropriate workshop and craft\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get('_at')\n  if workshop_kind is not None:\n      # Locate a workshop of the required type\n      workshop_locs = np.argwhere(state.grid[:, :, workshop_kind] > 0)\n      if workshop_locs.size > 0:\n          workshop_pos = tuple(workshop_locs[0][:2].tolist())\n\n          # Navigate to the workshop\n          while state.pos != workshop_pos:\n              act = move_towards(state.pos, workshop_pos)\n              if act is None:\n                  break\n              reward, done, _ = env.step(act)\n              actions.append(act)\n              state = env._current_state\n              if done:\n                  return actions\n\n          # Craft the final item\n          reward, done, _ = env.step(ACTION_USE)\n          actions.append(ACTION_USE)\n\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T16:19:38.932588", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  # Goal item name \u2013 assume we want to craft an \"arrow\".\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # Primitive requirements for one unit of the goal.\n  primitive_reqs = cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n\n  # Identify the workshop required for this recipe.\n  workshop_idx = None\n  recipe = cookbook.recipes.get(goal_idx, {})\n  if \"_at\" in recipe:\n      workshop_idx = cookbook.index[recipe[\"_at\"]]\n\n  actions = []\n\n  def move_and_use(cur, target):\n      \"\"\"Move from cur (x,y) to target (x,y) using Manhattan moves and append USE.\"\"\"\n      x, y = cur\n      tx, ty = target\n      # horizontal\n      while x < tx:\n          actions.append(3)   # RIGHT\n          x += 1\n      while x > tx:\n          actions.append(2)   # LEFT\n          x -= 1\n      # vertical\n      while y < ty:\n          actions.append(0)   # DOWN\n          y += 1\n      while y > ty:\n          actions.append(1)   # UP\n          y -= 1\n      # interact\n      actions.append(4)       # USE\n      return (x, y)\n\n  cur_pos = tuple(state.pos)\n\n  # Collect each required primitive the necessary number of times.\n  for kind_idx, needed in primitive_reqs.items():\n      # Locations where this primitive is present.\n      locations = np.argwhere(state.grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          continue\n      # Walk to locations, cycling if fewer distinct cells than needed.\n      for i in range(needed):\n          target = tuple(locations[i % len(locations)])\n          cur_pos = move_and_use(cur_pos, target)\n\n  # Go to the workshop and craft the goal item.\n  if workshop_idx is not None:\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          cur_pos = move_and_use(cur_pos, tuple(workshop_cells[0]))\n          # One extra USE to trigger crafting (some implementations need it).\n          actions.append(4)\n\n  return actions", "env_interactions": 25, "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T16:19:40.083811", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  arrow_idx = cookbook.index[\"arrow\"]\n  primitive_requirements = cookbook.primitives_for(arrow_idx)\n\n  workshop_idx = None\n  recipe = cookbook.recipes.get(arrow_idx, {})\n  for key, val in recipe.items():\n      if key == \"_at\":\n          workshop_idx = cookbook.index[val]\n          break\n\n  actions = []\n\n  def move_to_and_use(cur_pos, target_pos):\n      x, y = cur_pos\n      tx, ty = target_pos\n      while x < tx:\n          actions.append(3)   # RIGHT\n          x += 1\n      while x > tx:\n          actions.append(2)   # LEFT\n          x -= 1\n      while y < ty:\n          actions.append(0)   # DOWN\n          y += 1\n      while y > ty:\n          actions.append(1)   # UP\n          y -= 1\n      actions.append(4)       # USE\n      return (x, y)\n\n  cur_pos = state.pos\n\n  for kind_idx, needed in primitive_requirements.items():\n      locations = np.argwhere(state.grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          continue\n      for i in range(needed):\n          target = tuple(locations[i % len(locations)])\n          cur_pos = move_to_and_use(cur_pos, target)\n\n  if workshop_idx is not None:\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          cur_pos = move_to_and_use(cur_pos, tuple(workshop_cells[0]))\n          actions.append(4)\n\n  return actions", "env_interactions": 25, "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T16:20:04.715885", "function_name": "make_arrow", "function_body": "  # reset environment and get initial state\n  env.reset()\n  state = env._current_state\n\n  # -------------------------------------------------------------------------\n  # Identify the goal index (arrow)\n  # -------------------------------------------------------------------------\n  if hasattr(env, \"task\") and hasattr(env.task, \"goal\"):\n      goal_idx = env.task.goal\n  else:\n      goal_idx = env.world.cookbook.index.get(\"arrow\")\n      if goal_idx is None:\n          raise ValueError(\"Goal 'arrow' not found in cookbook\")\n\n  # -------------------------------------------------------------------------\n  # Action mapping\n  # -------------------------------------------------------------------------\n  act_spec = env.action_specs()\n  ACT_DOWN = act_spec[\"DOWN\"]\n  ACT_UP = act_spec[\"UP\"]\n  ACT_LEFT = act_spec[\"LEFT\"]\n  ACT_RIGHT = act_spec[\"RIGHT\"]\n  ACT_USE = act_spec[\"USE\"]\n\n  actions = []\n\n  # -------------------------------------------------------------------------\n  # Helper: BFS pathfinding on free cells (ignores orientation)\n  # -------------------------------------------------------------------------\n  def bfs_path(start, goal):\n      \"\"\"Return a list of actions to move from start to goal avoiding occupied cells.\"\"\"\n      grid = state.grid\n      h, w, _ = grid.shape\n      q = collections.deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (y, x), path = q.popleft()\n          if (y, x) == goal:\n              return path\n          for act, dy, dx in (\n              (ACT_DOWN, 1, 0),\n              (ACT_UP, -1, 0),\n              (ACT_RIGHT, 0, 1),\n              (ACT_LEFT, 0, -1),\n          ):\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < h and 0 <= nx < w and (ny, nx) not in visited:\n                  # cell must be completely empty\n                  if not grid[ny, nx, :].any():\n                      visited.add((ny, nx))\n                      q.append(((ny, nx), path + [act]))\n      return []  # unreachable\n\n  # -------------------------------------------------------------------------\n  # Helper: move agent to a target free cell using bfs_path\n  # -------------------------------------------------------------------------\n  def move_to(target):\n      nonlocal actions, state\n      while state.pos != target:\n          path = bfs_path(state.pos, target)\n          if not path:\n              break  # cannot reach target\n          for act in path:\n              actions.append(act)\n              env.step(act)\n              state = env._current_state\n              if state.pos == target:\n                  break\n\n  # -------------------------------------------------------------------------\n  # Helper: locate nearest cell containing a given kind index\n  # -------------------------------------------------------------------------\n  def find_nearest(kind_idx):\n      grid = state.grid\n      h, w, _ = grid.shape\n      py, px = state.pos\n      best = None\n      best_dist = None\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  d = abs(i - py) + abs(j - px)\n                  if best_dist is None or d < best_dist:\n                      best_dist = d\n                      best = (i, j)\n      return best\n\n  # -------------------------------------------------------------------------\n  # Helper: pick a free cell orthogonal/diagonal adjacent to a target cell\n  # -------------------------------------------------------------------------\n  def adjacent_free(cell):\n      grid = state.grid\n      h, w, _ = grid.shape\n      y, x = cell\n      # check neighbours (including diagonals)\n      for dy in (-1, 0, 1):\n          for dx in (-1, 0, 1):\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < h and 0 <= nx < w and not grid[ny, nx, :].any():\n                  return (ny, nx)\n      # fallback: if the cell itself is free\n      if not grid[y, x, :].any():\n          return (y, x)\n      return None\n\n  # -------------------------------------------------------------------------\n  # Collect all required primitives for the goal\n  # -------------------------------------------------------------------------\n  needed_prims = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  for kind_idx, cnt in needed_prims.items():\n      for _ in range(cnt):\n          src = find_nearest(kind_idx)\n          if src is None:\n              continue  # primitive not present\n          adj = adjacent_free(src)\n          if adj is None:\n              continue  # no free adjacent cell\n          move_to(adj)\n          actions.append(ACT_USE)\n          env.step(ACT_USE)\n          state = env._current_state\n\n  # -------------------------------------------------------------------------\n  # Move to the workshop (if required) and craft the goal item\n  # -------------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      ws = find_nearest(workshop_idx)\n      if ws:\n          adj = adjacent_free(ws)\n          if adj:\n              move_to(adj)\n              actions.append(ACT_USE)\n              env.step(ACT_USE)\n              state = env._current_state\n\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T16:20:05.864511", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n\n  # identify goal index (arrow)\n  if hasattr(env, \"task\") and hasattr(env.task, \"goal\"):\n      goal_idx = env.task.goal\n  else:\n      goal_idx = env.world.cookbook.index.get(\"arrow\")\n      if goal_idx is None:\n          raise ValueError(\"arrow not found\")\n\n  act_spec = env.action_specs()\n  ACT_DOWN = act_spec[\"DOWN\"]\n  ACT_UP = act_spec[\"UP\"]\n  ACT_LEFT = act_spec[\"LEFT\"]\n  ACT_RIGHT = act_spec[\"RIGHT\"]\n  ACT_USE = act_spec[\"USE\"]\n\n  # mapping delta to action\n  delta_act = {(1,0):ACT_DOWN, (-1,0):ACT_UP, (0,1):ACT_RIGHT, (0,-1):ACT_LEFT}\n\n  actions = []\n\n  # bfs path\n  def bfs_path(start, goal):\n      from collections import deque\n      h,w,_ = state.grid.shape\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (y,x), path = q.popleft()\n          if (y,x)==goal:\n              return path\n          for dy,dx,act in ((1,0,ACT_DOWN),(-1,0,ACT_UP),(0,1,ACT_RIGHT),(0,-1,ACT_LEFT)):\n              ny, nx = y+dy, x+dx\n              if 0<=ny<h and 0<=nx<w and (ny,nx) not in visited:\n                  if not state.grid[ny,nx,:].any() or (ny,nx)==goal:\n                      visited.add((ny,nx))\n                      q.append(((ny,nx), path+[act]))\n      return []\n\n  def move_to(target):\n      nonlocal actions, state\n      while state.pos != target:\n          path = bfs_path(state.pos, target)\n          if not path:\n              break\n          for act in path:\n              actions.append(act)\n              env.step(act)\n              state = env._current_state\n              if state.pos == target:\n                  break\n\n  def find_nearest(kind_idx):\n      grid = state.grid\n      h,w,_ = grid.shape\n      py,px = state.pos\n      best = None\n      best_d = None\n      for i in range(h):\n          for j in range(w):\n              if grid[i,j,kind_idx] > 0:\n                  d = abs(i-py)+abs(j-px)\n                  if best_d is None or d<best_d:\n                      best_d = d\n                      best = (i,j)\n      return best\n\n  def adjacent_free(cell):\n      y,x = cell\n      h,w,_ = state.grid.shape\n      # check the cell itself first\n      if not state.grid[y,x,:].any():\n          return (y,x)\n      for dy in (-1,0,1):\n          for dx in (-1,0,1):\n              ny, nx = y+dy, x+dx\n              if 0<=ny<h and 0<=nx<w and not state.grid[ny,nx,:].any():\n                  return (ny,nx)\n      return state.pos\n\n  # collect primitives\n  needed = env.world.cookbook.primitives_for(goal_idx)\n  for kind_idx, cnt in needed.items():\n      for _ in range(cnt):\n          src = find_nearest(kind_idx)\n          if src is None:\n              continue\n          adj = adjacent_free(src)\n          move_to(adj)\n          actions.append(ACT_USE)\n          env.step(ACT_USE)\n          state = env._current_state\n\n  # go to workshop if needed\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      ws_idx = env.world.cookbook.index[workshop_name]\n      ws_pos = find_nearest(ws_idx)\n      if ws_pos:\n          adj = adjacent_free(ws_pos)\n          move_to(adj)\n          actions.append(ACT_USE)\n          env.step(ACT_USE)\n          state = env._current_state\n\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T16:20:26.829024", "function_name": "make_arrow", "function_body": "  # Reset environment and get handles to core objects\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.scenario.world          # CraftWorld\n  cookbook = world.cookbook           # Cookbook\n  index = cookbook.index               # name \u2194 id mapping\n\n  # Action constants\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow) and the primitive requirements.\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  if goal_name not in index.contents:\n      return []                       # arrow not defined in this world\n\n  goal_idx = index[goal_name]          # integer id of the arrow item\n  primitive_needs = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n  actions = []                         # will hold the final action list\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of move actions from start to target,\n  # allowing the target cell to be occupied (so we can step onto a workshop\n  # or a primitive cell).  Movement is blocked by any non\u2011empty cell.\n  # ------------------------------------------------------------------\n  def _bfs_path(start, target):\n      \"\"\"Return list of move actions (DOWN/UP/LEFT/RIGHT) to reach target.\"\"\"\n      from collections import deque\n\n      if start == target:\n          return []\n\n      h, w = state.grid.shape[:2]\n      queue = deque([start])\n      visited = {start}\n      parent = {}\n\n      move_dirs = [(DOWN, (1, 0)),\n                   (UP, (-1, 0)),\n                   (LEFT, (0, -1)),\n                   (RIGHT, (0, 1))]\n\n      while queue:\n          cur = queue.popleft()\n          if cur == target:\n              break\n          for act, (dr, dc) in move_dirs:\n              nr, nc = cur[0] + dr, cur[1] + dc\n              if not (0 <= nr < h and 0 <= nc < w):\n                  continue\n              nxt = (nr, nc)\n              # Allow stepping onto the target even if it is occupied.\n              if nxt != target and state.grid[nr, nc, :].sum() != 0:\n                  continue\n              if nxt in visited:\n                  continue\n              visited.add(nxt)\n              parent[nxt] = (cur, act)\n              queue.append(nxt)\n\n      # Reconstruct path\n      if target not in parent and start != target:\n          return []          # no path found\n      path = []\n      cur = target\n      while cur != start:\n          prev, act = parent[cur]\n          path.append(act)\n          cur = prev\n      path.reverse()\n      return path\n\n  # ------------------------------------------------------------------\n  # 2. Collect each required primitive.\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          # Find any cell that currently contains this primitive.\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # No more of this primitive on the map \u2013 abort.\n              return actions\n          tr, tc = prim_cells[0]\n\n          # Move to the primitive cell (or adjacent, BFS handles occupancy).\n          move_seq = _bfs_path(state.pos, (tr, tc))\n          actions.extend(move_seq)\n          state.pos = (tr, tc)\n\n          # Pick it up.\n          actions.append(USE)\n\n          # Update our internal copy of the state.\n          state.inventory[prim_idx] += 1\n          state.grid[tr, tc, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 3. Go to the workshop for the arrow and craft it.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      return actions                     # no workshop information\n\n  workshop_idx = index[workshop_name]\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      return actions                     # cannot find a workshop\n\n  wr, wc = workshop_cells[0]\n\n  # Move to the workshop cell.\n  move_seq = _bfs_path(state.pos, (wr, wc))\n  actions.extend(move_seq)\n  state.pos = (wr, wc)\n\n  # Craft the arrow.\n  actions.append(USE)\n\n  return actions", "env_interactions": 28, "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T16:20:27.956532", "function_name": "make_arrow", "function_body": "  # Reset environment and get references to internal structures\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.scenario.world          # CraftWorld\n  cookbook = world.cookbook            # Cookbook\n  index = cookbook.index               # name \u2194 id mapping\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow) and its primitive requirements.\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  if goal_name not in index.contents:\n      return []                       # arrow not defined\n\n  goal_idx = index[goal_name]          # integer id of the arrow item\n  primitive_needs = cookbook.primitives_for(goal_idx)   # {prim_id: count}\n  actions = []                         # result list\n\n  # ------------------------------------------------------------------\n  # Helper: generate a Manhattan move sequence from start to target.\n  # ------------------------------------------------------------------\n  def _move_to(start, target):\n      \"\"\"Return a list of move actions (DOWN/UP/RIGHT/LEFT) that walk\n      from start (row, col) to target (row, col) using a greedy Manhattan\n      approach. Also returns the final position after the moves.\"\"\"\n      r, c = start\n      tr, tc = target\n      seq = []\n      while (r, c) != (tr, tc):\n          if r < tr:\n              seq.append(DOWN)\n              r += 1\n          elif r > tr:\n              seq.append(UP)\n              r -= 1\n          elif c < tc:\n              seq.append(RIGHT)\n              c += 1\n          else:  # c > tc\n              seq.append(LEFT)\n              c -= 1\n      return seq, (r, c)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive.\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          # Find any cell that currently contains this primitive.\n          cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if cells.size == 0:\n              # No more of this primitive on the map \u2013 give up early.\n              return actions\n          target_r, target_c = cells[0]\n\n          # Move to the primitive cell.\n          move_seq, new_pos = _move_to(state.pos, (target_r, target_c))\n          actions.extend(move_seq)\n          state.pos = new_pos\n\n          # Pick it up.\n          actions.append(USE)\n\n          # Update our internal copy of the state.\n          state.inventory[prim_idx] += 1\n          state.grid[target_r, target_c, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Go to the workshop required for crafting the arrow and craft it.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      return actions                     # no workshop info\n\n  workshop_idx = index[workshop_name]\n\n  # Locate a workshop cell.\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      return actions                     # cannot find a workshop\n\n  w_r, w_c = workshop_cells[0]\n\n  # Move to the workshop.\n  move_seq, new_pos = _move_to(state.pos, (w_r, w_c))\n  actions.extend(move_seq)\n  state.pos = new_pos\n\n  # Craft the arrow.\n  actions.append(USE)\n\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-10-27T16:20:49.076233", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  world = env.world\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed = world.cookbook.primitives_for(arrow_idx)\n\n  def manhattan_path(src, dst):\n      actions = []\n      x, y = src\n      tx, ty = dst\n      dx = tx - x\n      dy = ty - y\n      if dx > 0:\n          actions += [DOWN] * dx\n      elif dx < 0:\n          actions += [UP] * (-dx)\n      if dy > 0:\n          actions += [RIGHT] * dy\n      elif dy < 0:\n          actions += [LEFT] * (-dy)\n      return actions\n\n  def nearest(pos, kind):\n      grid = env._current_state.grid\n      cells = np.argwhere(grid[:, :, kind] > 0)\n      if cells.size == 0:\n          return None\n      dists = np.abs(cells[:, 0] - pos[0]) + np.abs(cells[:, 1] - pos[1])\n      idx = dists.argmin()\n      return tuple(cells[idx].tolist())\n\n  actions = []\n  cur = env._current_state.pos\n\n  for k, cnt in needed.items():\n      for _ in range(cnt):\n          target = nearest(cur, k)\n          if target is None:\n              return actions\n          actions += manhattan_path(cur, target)\n          cur = target\n          actions.append(USE)\n\n  workshop = world.cookbook.recipes[arrow_idx].get('_at')\n  if workshop is not None:\n      w_idx = world.cookbook.index.index(workshop)\n      w_pos = nearest(cur, w_idx)\n      if w_pos is not None:\n          actions += manhattan_path(cur, w_pos)\n          cur = w_pos\n          actions.append(USE)\n\n  return actions", "env_interactions": 22, "island_id": 5, "scores": {"3": 0.2}}
{"timestamp": "2025-10-27T16:20:50.211861", "function_name": "make_arrow", "function_body": "  # Action indices\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  world = env.world\n  # Index of the goal item \"arrow\"\n  arrow_idx = world.cookbook.index.index('arrow')\n  # Primitive requirements for one arrow (dict {primitive_idx: count})\n  primitives_needed = world.cookbook.primitives_for(arrow_idx)\n\n  actions = []\n  cur_pos = env._current_state.pos\n  grid = env._current_state.grid\n\n  # ------------------------------------------------------------------\n  # Helper: Manhattan move actions from src to dst\n  # ------------------------------------------------------------------\n  def _move_actions(src, dst):\n      acts = []\n      x, y = src\n      tx, ty = dst\n      dx = tx - x\n      dy = ty - y\n      if dx > 0:\n          acts += [DOWN] * dx\n      elif dx < 0:\n          acts += [UP] * (-dx)\n      if dy > 0:\n          acts += [RIGHT] * dy\n      elif dy < 0:\n          acts += [LEFT] * (-dy)\n      return acts\n\n  # ------------------------------------------------------------------\n  # Helper: find the nearest cell that contains a given kind\n  # ------------------------------------------------------------------\n  def _nearest_kind(pos, kind_idx):\n      coords = np.argwhere(grid[:, :, kind_idx] > 0)\n      if coords.size == 0:\n          return None\n      dists = np.abs(coords[:, 0] - pos[0]) + np.abs(coords[:, 1] - pos[1])\n      nearest = coords[dists.argmin()]\n      return tuple(nearest.tolist())\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, count in primitives_needed.items():\n      for _ in range(count):\n          target = _nearest_kind(cur_pos, prim_idx)\n          if target is None:\n              # Primitive not present \u2013 abort planning\n              return actions\n          actions += _move_actions(cur_pos, target)\n          cur_pos = target\n          actions.append(USE)   # pick up the primitive\n\n  # ------------------------------------------------------------------\n  # 2. Move to the workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  workshop_name = world.cookbook.recipes[arrow_idx].get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = _nearest_kind(cur_pos, workshop_idx)\n      if workshop_pos is not None:\n          actions += _move_actions(cur_pos, workshop_pos)\n          cur_pos = workshop_pos\n          actions.append(USE)   # craft at the workshop\n\n  return actions", "env_interactions": 22, "island_id": 5, "scores": {"3": 0.2}}
{"timestamp": "2025-10-27T16:21:07.509334", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state          # type: CraftState\n  world = env.world                    # type: CraftWorld\n\n  # Goal index and required primitive counts\n  goal_idx = env.task.goal\n  required = world.cookbook.primitives_for(goal_idx)\n\n  # Action indices (consistent with CraftLab)\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n  move_dirs = [\n      (1, 0, ACTION_DOWN),\n      (-1, 0, ACTION_UP),\n      (0, -1, ACTION_LEFT),\n      (0, 1, ACTION_RIGHT),\n  ]\n\n  actions = []\n\n  from collections import deque\n\n  def find_path(cur_state, target_kind):\n      \"\"\"Breadth\u2011first search returning a list of movement actions that leads\n      the agent to any cell containing `target_kind`. The agent may step onto\n      that cell even if it is occupied; otherwise it may only step onto empty\n      cells.\"\"\"\n      grid = cur_state.grid\n      H, W, _ = grid.shape\n      start = cur_state.pos\n      visited = {start}\n      q = deque([(start, [])])\n\n      while q:\n          (x, y), path = q.popleft()\n          if grid[x, y, target_kind] > 0:\n              return path\n          for dx, dy, act in move_dirs:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < H and 0 <= ny < W and (nx, ny) not in visited:\n                  # Move onto empty cells or directly onto the target cell\n                  if grid[nx, ny, :].sum() == 0 or grid[nx, ny, target_kind] > 0:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [act]))\n      # If not reachable (should not happen in a valid scenario)\n      return []\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitive items.\n  # ------------------------------------------------------------------\n  for kind, cnt in required.items():\n      for _ in range(cnt):\n          path = find_path(state, kind)\n          for act in path:\n              _, state = state.step(act)\n              actions.append(act)\n          # Pick up the primitive\n          _, state = state.step(ACTION_USE)\n          actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # 2) Go to the workshop (if any) and craft the goal item.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get('_at')\n  if workshop_kind is not None:\n      path = find_path(state, workshop_kind)\n      for act in path:\n          _, state = state.step(act)\n          actions.append(act)\n      # Use the workshop to craft\n      _, state = state.step(ACTION_USE)\n      actions.append(ACTION_USE)\n\n  return actions", "env_interactions": 0, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T16:21:08.648056", "function_name": "make_arrow", "function_body": "  # Reset environment and grab useful handles\n  env.reset()\n  state = env._current_state          # type: CraftState\n  world = env.world                    # type: CraftWorld\n\n  # Goal item index and its primitive requirements\n  goal_idx = env.task.goal\n  required = world.cookbook.primitives_for(goal_idx)   # {primitive_idx: count}\n\n  # Action indices (as defined by CraftLab)\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n  move_dirs = [\n      (1, 0, ACTION_DOWN),   # down  (increase row)\n      (-1, 0, ACTION_UP),    # up\n      (0, -1, ACTION_LEFT),  # left  (decrease col)\n      (0, 1, ACTION_RIGHT),  # right (increase col)\n  ]\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of movement actions leading from the\n  # current position to any cell that contains `target_kind`. The agent\n  # may step onto empty cells or directly onto the target cell.\n  # ------------------------------------------------------------------\n  def find_path(cur_state, target_kind):\n      from collections import deque\n\n      grid = cur_state.grid\n      H, W, _ = grid.shape\n      start = cur_state.pos\n      visited = {start}\n      q = deque([(start, [])])\n\n      while q:\n          (x, y), path = q.popleft()\n          # If the current cell already holds the desired kind, we are done\n          if grid[x, y, target_kind] > 0:\n              return path\n          for dx, dy, act in move_dirs:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < H and 0 <= ny < W and (nx, ny) not in visited:\n                  # Allow moving onto empty cells or the target cell itself\n                  if grid[nx, ny, :].sum() == 0 or grid[nx, ny, target_kind] > 0:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [act]))\n      # No path found (should not happen in a solvable scenario)\n      return []\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitive items.\n  # ------------------------------------------------------------------\n  for prim_kind, needed in required.items():\n      for _ in range(needed):\n          # Find shortest path to a cell containing this primitive\n          path = find_path(state, prim_kind)\n          for act in path:\n              _, state = state.step(act)\n              actions.append(act)\n          # Pick up the primitive (USE action)\n          _, state = state.step(ACTION_USE)\n          actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # 2) Move to the appropriate workshop (if any) and craft the goal.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get('_at')\n  if workshop_kind is not None:\n      path = find_path(state, workshop_kind)\n      for act in path:\n          _, state = state.step(act)\n          actions.append(act)\n      # Use the workshop to craft the item\n      _, state = state.step(ACTION_USE)\n      actions.append(ACTION_USE)\n\n  return actions", "env_interactions": 0, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T16:21:29.291714", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n\n  goal_idx = env.task.goal\n  required = world.cookbook.primitives_for(goal_idx)\n\n  # Action indices (consistent with CraftLab)\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n  move_dirs = [\n      (1, 0, ACTION_DOWN),\n      (-1, 0, ACTION_UP),\n      (0, -1, ACTION_LEFT),\n      (0, 1, ACTION_RIGHT),\n  ]\n\n  actions = []\n\n  from collections import deque\n\n  def find_path(cur_state, target_kind):\n      \"\"\"Breadth\u2011first search that returns a list of movement actions\n      leading the agent to any cell containing `target_kind`.\"\"\"\n      grid = cur_state.grid\n      H, W, _ = grid.shape\n      start = cur_state.pos\n      visited = {start}\n      q = deque([(start, [])])\n\n      while q:\n          (x, y), path = q.popleft()\n          if grid[x, y, target_kind] > 0:\n              return path\n          for dx, dy, act in move_dirs:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < H and 0 <= ny < W and (nx, ny) not in visited:\n                  # Move onto empty cells or directly onto the target cell\n                  if grid[nx, ny, :].sum() == 0 or grid[nx, ny, target_kind] > 0:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [act]))\n      # Unreachable (should not happen in a valid scenario)\n      return []\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitive items.\n  # ------------------------------------------------------------------\n  for kind, cnt in required.items():\n      for _ in range(cnt):\n          path = find_path(state, kind)\n          for act in path:\n              _, state = state.step(act)\n              actions.append(act)\n          # Pick up the primitive\n          _, state = state.step(ACTION_USE)\n          actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # 2) Go to the workshop (if any) and craft the goal item.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get('_at')\n  if workshop_kind is not None:\n      path = find_path(state, workshop_kind)\n      for act in path:\n          _, state = state.step(act)\n          actions.append(act)\n      # Use the workshop to craft\n      _, state = state.step(ACTION_USE)\n      actions.append(ACTION_USE)\n\n  return actions", "env_interactions": 0, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T16:21:30.425991", "function_name": "make_arrow", "function_body": "  # Reset environment to start fresh\n  env.reset()\n  state = env._current_state          # type: CraftState\n  world = env.world                    # type: CraftWorld\n\n  # Action constants (consistent with CraftLab)\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n  move_dirs = [\n      (1, 0, ACTION_DOWN),\n      (-1, 0, ACTION_UP),\n      (0, -1, ACTION_LEFT),\n      (0, 1, ACTION_RIGHT),\n  ]\n\n  actions = []\n\n  from collections import deque\n\n  def find_path(cur_state, target_kind):\n      \"\"\"\n      Breadth\u2011first search returning a list of movement actions that leads\n      the agent to any cell containing `target_kind`. The agent may step onto\n      that cell even if it is occupied; otherwise it may only step onto empty\n      cells.\n      \"\"\"\n      grid = cur_state.grid\n      H, W, _ = grid.shape\n      start = cur_state.pos\n      visited = {start}\n      q = deque([(start, [])])\n\n      while q:\n          (x, y), path = q.popleft()\n          if grid[x, y, target_kind] > 0:\n              return path\n          for dx, dy, act in move_dirs:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < H and 0 <= ny < W and (nx, ny) not in visited:\n                  # Allow movement onto empty cells or directly onto the target cell\n                  if grid[nx, ny, :].sum() == 0 or grid[nx, ny, target_kind] > 0:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [act]))\n      # Not reachable \u2013 return empty list (should not happen in a valid scenario)\n      return []\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitive items.\n  # ------------------------------------------------------------------\n  goal_idx = env.task.goal\n  required = world.cookbook.primitives_for(goal_idx)  # {primitive_idx: count}\n  for kind, cnt in required.items():\n      for _ in range(cnt):\n          path = find_path(state, kind)\n          for act in path:\n              _, state = state.step(act)\n              actions.append(act)\n          # Pick up the primitive\n          _, state = state.step(ACTION_USE)\n          actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # 2) Go to the workshop (if any) and craft the goal item.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get('_at')\n  if workshop_kind is not None:\n      path = find_path(state, workshop_kind)\n      for act in path:\n          _, state = state.step(act)\n          actions.append(act)\n      # Use the workshop to craft the goal\n      _, state = state.step(ACTION_USE)\n      actions.append(ACTION_USE)\n\n  return actions", "env_interactions": 0, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T16:21:49.656783", "function_name": "make_arrow", "function_body": "  # action identifiers\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def _move_actions(src, dst):\n      \"\"\"Return a list of actions moving Manhattan\u2011style from src to dst.\"\"\"\n      actions = []\n      x, y = src\n      tx, ty = dst\n      dx = tx - x\n      dy = ty - y\n      if dx > 0:\n          actions.extend([DOWN] * dx)\n      elif dx < 0:\n          actions.extend([UP] * (-dx))\n      if dy > 0:\n          actions.extend([RIGHT] * dy)\n      elif dy < 0:\n          actions.extend([LEFT] * (-dy))\n      return actions\n\n  def _nearest_kind(pos, kind_idx):\n      \"\"\"Find the coordinates of the nearest cell containing kind_idx.\"\"\"\n      grid = env._current_state.grid\n      locations = list(zip(*np.where(grid[:, :, kind_idx] > 0)))\n      if not locations:\n          return None\n      dists = [abs(px - pos[0]) + abs(py - pos[1]) for (px, py) in locations]\n      return locations[int(np.argmin(dists))]\n\n  # ------------------------------------------------------------------\n  # 1. Identify the goal (arrow) and its primitive requirements\n  # ------------------------------------------------------------------\n  world = env.world\n  arrow_idx = world.cookbook.index.index('arrow')\n  primitives_needed = world.cookbook.primitives_for(arrow_idx)  # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # 2. Collect all required primitives\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = env._current_state.pos\n\n  for prim_idx, count in primitives_needed.items():\n      for _ in range(count):\n          target = _nearest_kind(cur_pos, prim_idx)\n          if target is None:\n              # Primitive missing \u2013 abort early\n              return actions\n          actions.extend(_move_actions(cur_pos, target))\n          cur_pos = target\n          actions.append(USE)   # pick up the primitive\n\n  # ------------------------------------------------------------------\n  # 3. Go to the workshop (if any) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = _nearest_kind(cur_pos, workshop_idx)\n      if workshop_pos is not None:\n          actions.extend(_move_actions(cur_pos, workshop_pos))\n          cur_pos = workshop_pos\n          actions.append(USE)   # craft at the workshop\n\n  return actions", "env_interactions": 22, "island_id": 5, "scores": {"3": 0.2}}
{"timestamp": "2025-10-27T16:21:50.798813", "function_name": "make_arrow", "function_body": "  # Action constants (matching CraftLab action specs)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def _move_actions(src, dst):\n      \"\"\"Return a list of actions that moves Manhattan\u2011style from src to dst.\"\"\"\n      actions = []\n      x, y = src\n      tx, ty = dst\n      dx = tx - x\n      dy = ty - y\n      if dx > 0:\n          actions += [DOWN] * dx\n      elif dx < 0:\n          actions += [UP] * (-dx)\n      if dy > 0:\n          actions += [RIGHT] * dy\n      elif dy < 0:\n          actions += [LEFT] * (-dy)\n      return actions\n\n  def _nearest_kind(pos, kind_idx):\n      \"\"\"Find the coordinates of the nearest cell containing the given kind.\"\"\"\n      grid = env._current_state.grid\n      # locations where this kind is present (any positive count)\n      locations = list(zip(*np.where(grid[:, :, kind_idx] > 0)))\n      if not locations:\n          return None\n      # Manhattan distance to each candidate\n      dists = [abs(px - pos[0]) + abs(py - pos[1]) for (px, py) in locations]\n      return locations[int(np.argmin(dists))]\n\n  # ------------------------------------------------------------------\n  # 1. Identify the goal (arrow) and its primitive requirements\n  # ------------------------------------------------------------------\n  world = env.world\n  arrow_idx = world.cookbook.index.index('arrow')\n  primitives_needed = world.cookbook.primitives_for(arrow_idx)  # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # 2. Collect all required primitives\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = env._current_state.pos\n\n  for prim_idx, count in primitives_needed.items():\n      for _ in range(count):\n          target = _nearest_kind(cur_pos, prim_idx)\n          if target is None:\n              # Primitive not found \u2013 abort early\n              return actions\n          actions += _move_actions(cur_pos, target)\n          cur_pos = target\n          actions.append(USE)   # pick up the primitive at the current cell\n\n  # ------------------------------------------------------------------\n  # 3. Go to the workshop (if any) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = _nearest_kind(cur_pos, workshop_idx)\n      if workshop_pos is not None:\n          actions += _move_actions(cur_pos, workshop_pos)\n          cur_pos = workshop_pos\n          actions.append(USE)   # craft at the workshop\n\n  return actions", "env_interactions": 22, "island_id": 5, "scores": {"3": 0.2}}
{"timestamp": "2025-10-27T16:22:22.848105", "function_name": "make_arrow", "function_body": "  import collections\n  import numpy as np\n\n  # reset environment and grab handles\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n\n  # --------------------------------------------------------------\n  # Identify the goal and its primitive requirements\n  # --------------------------------------------------------------\n  goal_idx = env.task.goal\n  required = world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n\n  # --------------------------------------------------------------\n  # Action indices (consistent with CraftLab)\n  # --------------------------------------------------------------\n  act_map = env.action_specs()\n  ACTION_DOWN = act_map['DOWN']\n  ACTION_UP   = act_map['UP']\n  ACTION_LEFT = act_map['LEFT']\n  ACTION_RIGHT= act_map['RIGHT']\n  ACTION_USE  = act_map['USE']\n  move_dirs = [(1, 0, ACTION_DOWN), (-1, 0, ACTION_UP),\n               (0, -1, ACTION_LEFT), (0, 1, ACTION_RIGHT)]\n\n  # --------------------------------------------------------------\n  # Helper: BFS that returns a list of movement actions leading to a\n  # cell that contains `target_kind`.  The search may step onto empty\n  # cells or the target cell itself, but avoids any other occupied\n  # cells.\n  # --------------------------------------------------------------\n  def find_path(cur_state, target_kind):\n      grid = cur_state.grid\n      H, W, _ = grid.shape\n      start = cur_state.pos\n      visited = {start}\n      q = collections.deque([(start, [])])\n\n      while q:\n          (x, y), path = q.popleft()\n          if grid[x, y, target_kind] > 0:\n              return path\n          for dx, dy, act in move_dirs:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < H and 0 <= ny < W):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              # allow stepping onto the target cell even if occupied\n              occupied = np.any(grid[nx, ny, :] > 0)\n              if occupied and grid[nx, ny, target_kind] == 0:\n                  continue\n              visited.add((nx, ny))\n              q.append(((nx, ny), path + [act]))\n      # No reachable cell \u2013 return empty list (should not happen)\n      return []\n\n  actions = []\n\n  # --------------------------------------------------------------\n  # 1) Collect each required primitive the necessary number of times\n  # --------------------------------------------------------------\n  for kind_idx, count in required.items():\n      for _ in range(count):\n          path = find_path(state, kind_idx)\n          for a in path:\n              _, state = state.step(a)\n              actions.append(a)\n          # pick up the primitive under the agent\n          _, state = state.step(ACTION_USE)\n          actions.append(ACTION_USE)\n\n  # --------------------------------------------------------------\n  # 2) Move to the workshop (if any) and craft the goal item\n  # --------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get('_at')\n  if workshop_kind is not None:\n      path = find_path(state, workshop_kind)\n      for a in path:\n          _, state = state.step(a)\n          actions.append(a)\n      # use the workshop to craft the item\n      _, state = state.step(ACTION_USE)\n      actions.append(ACTION_USE)\n\n  # --------------------------------------------------------------\n  # Return the full action sequence\n  # --------------------------------------------------------------\n  return actions", "env_interactions": 0, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T16:22:23.971643", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n\n  # Goal item index\n  goal_idx = env.task.goal\n\n  # Primitive requirements for the goal (primitive_kind -> count)\n  required = world.cookbook.primitives_for(goal_idx)\n\n  # Action indices according to CraftLab's specification\n  act_map = env.action_specs()\n  ACTION_DOWN = act_map['DOWN']\n  ACTION_UP = act_map['UP']\n  ACTION_LEFT = act_map['LEFT']\n  ACTION_RIGHT = act_map['RIGHT']\n  ACTION_USE = act_map['USE']\n\n  move_dirs = [(1, 0, ACTION_DOWN), (-1, 0, ACTION_UP),\n               (0, -1, ACTION_LEFT), (0, 1, ACTION_RIGHT)]\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper: BFS to find a shortest sequence of movement actions that\n  # brings the agent onto a cell containing `target_kind`.  The search\n  # may step on empty cells or directly on the target cell; any other\n  # occupied cell is treated as an obstacle.\n  # ------------------------------------------------------------------\n  import collections\n  import numpy as np\n\n  def find_path(cur_state, target_kind):\n      grid = cur_state.grid\n      H, W, _ = grid.shape\n      start = cur_state.pos\n      visited = {start}\n      q = collections.deque([(start, [])])\n\n      while q:\n          (x, y), path = q.popleft()\n          if grid[x, y, target_kind] > 0:\n              return path\n          for dx, dy, act in move_dirs:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < H and 0 <= ny < W):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              occupied = np.any(grid[nx, ny, :] > 0)\n              if occupied and grid[nx, ny, target_kind] == 0:\n                  continue\n              visited.add((nx, ny))\n              q.append(((nx, ny), path + [act]))\n      # No path found \u2013 return empty list (should not happen for valid tasks)\n      return []\n\n  # ------------------------------------------------------------------\n  # 1) Collect every required primitive (respecting the needed count).\n  # ------------------------------------------------------------------\n  for kind_idx, cnt in required.items():\n      for _ in range(cnt):\n          path = find_path(state, kind_idx)\n          for act in path:\n              _, state = state.step(act)\n              actions.append(act)\n          # pick up the primitive located under the agent\n          _, state = state.step(ACTION_USE)\n          actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # 2) Move to the workshop (if the recipe specifies one) and craft.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get('_at')\n  if workshop_kind is not None:\n      path = find_path(state, workshop_kind)\n      for act in path:\n          _, state = state.step(act)\n          actions.append(act)\n      # use the workshop to craft the goal item\n      _, state = state.step(ACTION_USE)\n      actions.append(ACTION_USE)\n\n  # Return the full action sequence that solves the task.\n  return actions", "env_interactions": 0, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T16:22:38.701097", "function_name": "make_arrow", "function_body": "  # Reset environment and grab useful handles\n  env.reset()\n  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  # Index of the goal item (\"arrow\") and its primitive requirements\n  arrow_idx = cookbook.index[\"arrow\"]\n  primitive_requirements = cookbook.primitives_for(arrow_idx)\n\n  # Determine the workshop (if any) where the arrow must be crafted\n  workshop_idx = None\n  recipe = cookbook.recipes.get(arrow_idx, {})\n  if \"_at\" in recipe:\n      workshop_idx = cookbook.index[recipe[\"_at\"]]\n\n  actions = []\n\n  # Helper: append actions that move from cur_pos to target_pos (Manhattan moves)\n  def _move_and_use(cur_pos, target_pos):\n      x, y = cur_pos\n      tx, ty = target_pos\n      # horizontal moves (x axis)\n      while x < tx:\n          actions.append(3)   # RIGHT\n          x += 1\n      while x > tx:\n          actions.append(2)   # LEFT\n          x -= 1\n      # vertical moves (y axis)\n      while y < ty:\n          actions.append(0)   # DOWN\n          y += 1\n      while y > ty:\n          actions.append(1)   # UP\n          y -= 1\n      # interact with the cell (pick up / craft)\n      actions.append(4)       # USE\n      return (x, y)\n\n  cur_pos = tuple(state.pos)\n\n  # ----------------------------------------------------------------------\n  # 1. Collect all required primitive items\n  # ----------------------------------------------------------------------\n  for kind_idx, needed in primitive_requirements.items():\n      # Locate all cells that currently contain this primitive\n      locations = [tuple(pos) for pos in np.argwhere(state.grid[:, :, kind_idx] > 0)]\n      if not locations:\n          continue  # nothing to collect; should not happen for a valid scenario\n\n      # Simple greedy nearest\u2011neighbor collection\n      for _ in range(needed):\n          # find the nearest location (Manhattan distance)\n          dists = [abs(cur_pos[0] - lx) + abs(cur_pos[1] - ly) for (lx, ly) in locations]\n          nearest_idx = int(np.argmin(dists))\n          target = locations.pop(nearest_idx)  # remove so we don't reuse it\n          cur_pos = _move_and_use(cur_pos, target)\n\n  # ----------------------------------------------------------------------\n  # 2. Go to the appropriate workshop (if required) and craft the arrow\n  # ----------------------------------------------------------------------\n  if workshop_idx is not None:\n      workshop_cells = [tuple(pos) for pos in np.argwhere(state.grid[:, :, workshop_idx] > 0)]\n      if workshop_cells:\n          cur_pos = _move_and_use(cur_pos, workshop_cells[0])\n          # second USE actually performs the crafting at the workshop\n          actions.append(4)\n\n  return actions", "env_interactions": 23, "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T16:22:39.835580", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # Reset environment to get initial state\n  env.reset()\n  state = env._current_state          # CraftState instance\n  world = env.world\n  cookbook = world.cookbook\n\n  # Index of the target item \"arrow\"\n  arrow_idx = cookbook.index[\"arrow\"]\n  # Primitive requirements for one arrow\n  primitive_needs = cookbook.primitives_for(arrow_idx)\n\n  # Workshop where the arrow must be crafted (if any)\n  workshop_idx = None\n  recipe = cookbook.recipes.get(arrow_idx, {})\n  if \"_at\" in recipe:\n      workshop_idx = cookbook.index[recipe[\"_at\"]]\n\n  actions = []\n\n  # Helper: move from cur_pos to a target cell (Manhattan moves) and then USE\n  def move_and_use(cur_pos, target_pos):\n      x, y = cur_pos\n      tx, ty = target_pos\n      # move horizontally\n      while x < tx:\n          actions.append(3)   # RIGHT\n          x += 1\n      while x > tx:\n          actions.append(2)   # LEFT\n          x -= 1\n      # move vertically\n      while y < ty:\n          actions.append(0)   # DOWN\n          y += 1\n      while y > ty:\n          actions.append(1)   # UP\n          y -= 1\n      # use action on the cell we are standing on (assumes item can be taken)\n      actions.append(4)       # USE\n      return (x, y)\n\n  cur_pos = tuple(state.pos)\n\n  # Collect each required primitive\n  for kind_idx, count in primitive_needs.items():\n      # Find all locations of this primitive on the grid\n      locations = np.argwhere(state.grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          continue  # no such primitive; skip (should not happen in a valid scenario)\n\n      # Gather the needed amount, cycling through available locations if necessary\n      for i in range(count):\n          target = tuple(locations[i % len(locations)])\n          cur_pos = move_and_use(cur_pos, target)\n\n  # After having all primitives, go to the workshop (if defined) and craft\n  if workshop_idx is not None:\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          cur_pos = move_and_use(cur_pos, tuple(workshop_cells[0]))\n          actions.append(4)   # final USE to craft the arrow\n\n  return actions", "env_interactions": 25, "island_id": 6, "scores": {"3": 0.0}}
