{"timestamp": "2025-10-27T18:51:35.748752", "function_name": "make_arrow", "function_body": "  # Reset environment and get current state/world\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world\n\n  # Goal item index and its primitive requirements\n  goal_idx = env.task.goal\n  needed = world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n\n  # Determine required workshop (if any)\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  if \"_at\" in recipe:\n      workshop_idx = world.cookbook.index[recipe[\"_at\"]]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  import numpy as np\n  from collections import deque\n\n  def locate(kind):\n      \"\"\"Return list of (x, y) positions where `kind` is present on the grid.\"\"\"\n      inds = np.argwhere(state.grid[:, :, kind] > 0)\n      return [tuple(p) for p in inds]\n\n  def bfs_path(start, target):\n      \"\"\"\n      Compute a shortest 4\u2011connected path from `start` to `target`,\n      avoiding occupied cells (except the target cell itself).\n      Returns a list of positions (excluding `start`) or [] if unreachable.\n      \"\"\"\n      w, h = state.grid.shape[:2]\n      occupied = np.any(state.grid > 0, axis=2)\n      occupied[target] = False          # allow stepping onto target\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          pos, path = q.popleft()\n          if pos == target:\n              return path\n          x, y = pos\n          for dx, dy in ((0, 1), (0, -1), (-1, 0), (1, 0)):\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < w and 0 <= ny < h):\n                  continue\n              npos = (nx, ny)\n              if npos in visited:\n                  continue\n              if occupied[nx, ny]:\n                  continue\n              visited.add(npos)\n              q.append((npos, path + [npos]))\n      return []\n\n  def follow_path(path):\n      \"\"\"Convert a list of positions into actions, update `state`, and record actions.\"\"\"\n      nonlocal state, actions\n      for nxt in path:\n          x, y = state.pos\n          nx, ny = nxt\n          if nx > x:\n              act = 3          # RIGHT\n          elif nx < x:\n              act = 2          # LEFT\n          elif ny > y:\n              act = 0          # DOWN\n          else:\n              act = 1          # UP\n          actions.append(act)\n          _, state = state.step(act)\n\n  # ------------------------------------------------------------------\n  # Build action sequence\n  # ------------------------------------------------------------------\n  actions = []\n\n  # 1) Collect all required primitives\n  for kind_idx, req_cnt in needed.items():\n      while state.inventory[kind_idx] < req_cnt:\n          positions = locate(kind_idx)\n          if not positions:                     # primitive not on map\n              return actions\n          # Find the reachable instance with the shortest path\n          best_path = None\n          for pos in positions:\n              path = bfs_path(state.pos, pos)\n              if path and (best_path is None or len(path) < len(best_path)):\n                  best_path = path\n          if best_path is None:                 # none reachable\n              return actions\n          follow_path(best_path)\n          # Pick up the primitive\n          actions.append(4)                     # USE\n          _, state = state.step(4)\n\n  # 2) If a specific workshop is needed, move to it\n  if workshop_idx is not None:\n      ws_positions = locate(workshop_idx)\n      if ws_positions:\n          # Choose the closest reachable workshop\n          best_path = None\n          for pos in ws_positions:\n              path = bfs_path(state.pos, pos)\n              if path and (best_path is None or len(path) < len(best_path)):\n                  best_path = path\n          if best_path:\n              follow_path(best_path)\n\n  # 3) Perform the crafting action (USE)\n  actions.append(4)                     # USE\n  _, state = state.step(4)\n\n  return actions", "env_interactions": 1, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T18:51:57.336250", "function_name": "make_arrow", "function_body": "  # Reset environment and get references to core objects.\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.scenario.world          # CraftWorld\n  cookbook = world.cookbook           # Cookbook\n  idx = cookbook.index                # name \u2194 id mapping\n\n  # Resolve action indices.\n  action_map = env.action_specs()\n  DOWN = action_map.get(\"DOWN\", 0)\n  UP = action_map.get(\"UP\", 1)\n  LEFT = action_map.get(\"LEFT\", 2)\n  RIGHT = action_map.get(\"RIGHT\", 3)\n  USE = action_map.get(\"USE\", 4)\n\n  # BFS helper to compute a sequence of movement actions from start to target.\n  moves = [(DOWN, (1, 0)),\n           (UP, (-1, 0)),\n           (LEFT, (0, -1)),\n           (RIGHT, (0, 1))]\n\n  from collections import deque\n  import numpy as np\n\n  def _bfs_path(start, target):\n      \"\"\"Return list of movement actions to reach `target` from `start`,\n      treating any occupied cell as blocked (except the target itself).\"\"\"\n      if start == target:\n          return []\n      h, w = state.grid.shape[:2]\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          for act, (dr, dc) in moves:\n              nr, nc = cur[0] + dr, cur[1] + dc\n              if not (0 <= nr < h and 0 <= nc < w):\n                  continue\n              nxt = (nr, nc)\n              if nxt in visited:\n                  continue\n              # Allow stepping onto the target even if occupied.\n              if nxt != target and state.grid[nr, nc, :].sum() != 0:\n                  continue\n              visited.add(nxt)\n              parent[nxt] = (cur, act)\n              q.append(nxt)\n      if target not in parent and start != target:\n          return []  # No path found.\n      # Reconstruct path.\n      path = []\n      cur = target\n      while cur != start:\n          prev, act = parent[cur]\n          path.append(act)\n          cur = prev\n      path.reverse()\n      return path\n\n  # ------------------------------------------------------------------\n  # Identify the goal item (arrow) and its primitive requirements.\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  if goal_name not in idx.contents:\n      return []  # Arrow not defined in this world.\n  goal_idx = idx[goal_name]\n  primitive_needs = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n  actions = []  # Final action list.\n\n  # ------------------------------------------------------------------\n  # Phase 1: Collect required primitives.\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          # Find all cells currently containing this primitive.\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # Primitive missing \u2013 abort early.\n              return actions\n          # Choose the nearest primitive cell (Manhattan distance).\n          dists = np.abs(prim_cells - np.array(state.pos)).sum(axis=1)\n          tr, tc = prim_cells[dists.argmin()]\n          # Move to the primitive.\n          move_seq = _bfs_path(state.pos, (tr, tc))\n          actions.extend(move_seq)\n          state.pos = (tr, tc)\n          # Pick it up.\n          actions.append(USE)\n          state.inventory[prim_idx] += 1\n          state.grid[tr, tc, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Phase 2: Go to the appropriate workshop and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      return actions  # No workshop info; cannot craft.\n  workshop_idx = idx[workshop_name]\n\n  # Locate workshop cells.\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      return actions  # Workshop not present.\n  # Choose nearest workshop.\n  dists = np.abs(workshop_cells - np.array(state.pos)).sum(axis=1)\n  wr, wc = workshop_cells[dists.argmin()]\n\n  # Move to workshop.\n  move_seq = _bfs_path(state.pos, (wr, wc))\n  actions.extend(move_seq)\n  state.pos = (wr, wc)\n\n  # Craft the arrow.\n  actions.append(USE)\n\n  return actions", "env_interactions": 24, "island_id": 1, "scores": {"3": 1.5}}
