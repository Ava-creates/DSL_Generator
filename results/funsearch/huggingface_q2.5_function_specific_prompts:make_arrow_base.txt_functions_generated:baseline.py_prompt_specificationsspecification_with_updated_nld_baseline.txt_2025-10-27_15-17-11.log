{"timestamp": "2025-10-27T17:16:08.190411", "function_name": "make_arrow", "function_body": "  # Reset the environment to a fresh state if possible\n  try:\n      env.reset()\n  except Exception:\n      pass\n\n  # ------------------------------------------------------------------\n  # Identify the goal index (the item we need to craft, e.g., \"arrow\")\n  # ------------------------------------------------------------------\n  goal_idx = None\n  if hasattr(env, \"task\"):\n      task = getattr(env, \"task\")\n      if hasattr(task, \"goal\"):\n          goal_idx = task.goal\n      elif isinstance(task, (list, tuple)):\n          goal_idx = task[0]\n\n  # If we cannot determine the goal, return an empty plan\n  if goal_idx is None:\n      return []\n\n  # ------------------------------------------------------------------\n  # Determine which primitive resources are needed for this goal\n  # ------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # dict {kind_idx: count}\n  if not primitives_needed:\n      # No recipe \u2013 nothing to collect; just try to craft at current location\n      primitives_needed = {}\n\n  # ------------------------------------------------------------------\n  # Get a mutable copy of the current grid and the agent's position\n  # ------------------------------------------------------------------\n  state = env._current_state\n  cur_pos = list(state.pos)                 # [x, y]\n  grid = state.grid.copy()                  # shape (W, H, n_kinds)\n\n  actions = []                              # List of action integers to return\n\n  # ------------------------------------------------------------------\n  # Helper: generate Manhattan moves from cur_pos to target (x, y)\n  # ------------------------------------------------------------------\n  def move_to(target):\n      \"\"\"Append actions to move from cur_pos to target and update cur_pos.\"\"\"\n      nonlocal cur_pos\n      seq = []\n      tx, ty = target\n      # Move in x direction\n      while cur_pos[0] < tx:\n          seq.append(3)          # RIGHT\n          cur_pos[0] += 1\n      while cur_pos[0] > tx:\n          seq.append(2)          # LEFT\n          cur_pos[0] -= 1\n      # Move in y direction\n      while cur_pos[1] < ty:\n          seq.append(0)          # DOWN\n          cur_pos[1] += 1\n      while cur_pos[1] > ty:\n          seq.append(1)          # UP\n          cur_pos[1] -= 1\n      return seq\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive, one unit at a time\n  # ------------------------------------------------------------------\n  for kind_idx, total_needed in primitives_needed.items():\n      needed = total_needed\n      while needed > 0:\n          # Locate all cells containing this primitive\n          positions = np.argwhere(grid[:, :, kind_idx] > 0)\n          if positions.size == 0:\n              # No more of this primitive on the map \u2013 abort collection\n              break\n\n          # Choose the closest primitive (Manhattan distance) to current position\n          dists = np.abs(positions[:, 0] - cur_pos[0]) + np.abs(positions[:, 1] - cur_pos[1])\n          nearest_idx = int(np.argmin(dists))\n          target = tuple(positions[nearest_idx])\n\n          # Move to the primitive's cell\n          actions.extend(move_to(target))\n          # Use (collect) the primitive\n          actions.append(4)            # USE\n          # Simulate removal of the primitive from the grid copy\n          grid[target[0], target[1], kind_idx] = 0\n          needed -= 1\n\n  # ------------------------------------------------------------------\n  # After gathering primitives, go to the required workshop (if any) and craft\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      # Find any workshop cell of the required type\n      ws_positions = np.argwhere(grid[:, :, workshop_kind] > 0)\n      if ws_positions.shape[0] > 0:\n          ws_target = tuple(ws_positions[0])\n          actions.extend(move_to(ws_target))\n          actions.append(4)            # USE to craft at the workshop\n      else:\n          # No workshop found; attempt to craft at current location anyway\n          actions.append(4)\n  else:\n      # No specific workshop \u2013 attempt to craft at current location\n      actions.append(4)\n\n  return actions", "env_interactions": 1, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T17:16:23.963138", "function_name": "make_arrow", "function_body": "  env.reset()\n  world = env.world\n  scenario = env.scenario\n  state = env._current_state\n\n  # goal index for \u201carrow\u201d\n  goal_idx = env.task.goal\n\n  # all primitive kinds (and required counts) needed for one arrow\n  required = world.cookbook.primitives_for(goal_idx)\n\n  # workshop kind where the final crafting must happen (if any)\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else world.cookbook.index[wk]\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # ------------------------------------------------------------------\n  # Helpers\n  # ------------------------------------------------------------------\n  def moves_to(start, target):\n      \"\"\"Manhattan move sequence from start (x,y) to target (x,y).\"\"\"\n      x, y = start\n      tx, ty = target\n      seq = []\n      while x < tx:\n          seq.append(3)   # RIGHT\n          x += 1\n      while x > tx:\n          seq.append(2)   # LEFT\n          x -= 1\n      while y < ty:\n          seq.append(0)   # DOWN\n          y += 1\n      while y > ty:\n          seq.append(1)   # UP\n          y -= 1\n      return seq, (x, y)\n\n  def nearest_cell(kind, from_pos):\n      \"\"\"Return coordinates of the nearest cell containing `kind`.\"\"\"\n      cells = np.argwhere(scenario.init_grid[:, :, kind] > 0)\n      if cells.size == 0:\n          return None\n      dists = np.abs(cells[:, 0] - from_pos[0]) + np.abs(cells[:, 1] - from_pos[1])\n      idx = dists.argmin()\n      return tuple(cells[idx])\n\n  # ------------------------------------------------------------------\n  # Collect required primitives\n  # ------------------------------------------------------------------\n  for kind, cnt in required.items():\n      for _ in range(cnt):\n          target = nearest_cell(kind, cur_pos)\n          if target is None:\n              # primitive not present on map \u2013 skip this instance\n              continue\n          move_seq, cur_pos = moves_to(cur_pos, target)\n          actions.extend(move_seq)\n          actions.append(4)   # USE to pick up the primitive\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if needed) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      target = nearest_cell(workshop_kind, cur_pos)\n      if target is not None:\n          move_seq, cur_pos = moves_to(cur_pos, target)\n          actions.extend(move_seq)\n          actions.append(4)   # USE to craft at the workshop\n\n  return actions", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T17:16:25.084332", "function_name": "make_arrow", "function_body": "  # Reset environment and fetch useful references\n  env.reset()\n  world = env.world\n  scenario = env.scenario\n  state = env._current_state\n\n  # Goal index (arrow) and primitive requirements (including transitive ones)\n  goal_idx = env.task.goal\n  required = world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n\n  # Determine if the final recipe requires a specific workshop\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else world.cookbook.index[wk]\n\n  # We'll work on a mutable copy of the initial grid so we can \u201cremove\u201d primitives\n  mutable_grid = scenario.init_grid.copy()\n\n  actions = []\n  cur_pos = tuple(state.pos)   # (x, y)\n\n  # ----------------------------------------------------------------------\n  # Helper: generate Manhattan move actions from start to target.\n  # Action order: DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n  # ----------------------------------------------------------------------\n  def moves_to(start, target):\n      x, y = start\n      tx, ty = target\n      seq = []\n      while x < tx:\n          seq.append(3)   # RIGHT\n          x += 1\n      while x > tx:\n          seq.append(2)   # LEFT\n          x -= 1\n      while y < ty:\n          seq.append(0)   # DOWN\n          y += 1\n      while y > ty:\n          seq.append(1)   # UP\n          y -= 1\n      return seq, (x, y)\n\n  # ----------------------------------------------------------------------\n  # Helper: locate nearest cell that still contains at least one of `kind`.\n  # Returns None if no such cell exists.\n  # ----------------------------------------------------------------------\n  def nearest_cell(kind, from_pos):\n      cells = np.argwhere(mutable_grid[:, :, kind] > 0)\n      if cells.size == 0:\n          return None\n      dists = np.abs(cells[:, 0] - from_pos[0]) + np.abs(cells[:, 1] - from_pos[1])\n      idx = dists.argmin()\n      return tuple(cells[idx])\n\n  # ----------------------------------------------------------------------\n  # Collect all required primitive items.\n  # ----------------------------------------------------------------------\n  for kind, cnt in required.items():\n      for _ in range(cnt):\n          target = nearest_cell(kind, cur_pos)\n          if target is None:\n              # Primitive not present on map \u2013 cannot collect further.\n              continue\n          move_seq, cur_pos = moves_to(cur_pos, target)\n          actions.extend(move_seq)\n          actions.append(4)                     # USE to pick up\n          # Mark the primitive as taken so we don't target it again.\n          mutable_grid[target[0], target[1], kind] = 0\n\n  # ----------------------------------------------------------------------\n  # Move to the workshop (if required) and craft the final item.\n  # ----------------------------------------------------------------------\n  if workshop_kind is not None:\n      target = nearest_cell(workshop_kind, cur_pos)\n      if target is not None:\n          move_seq, cur_pos = moves_to(cur_pos, target)\n          actions.extend(move_seq)\n          actions.append(4)                     # USE to craft at workshop\n  else:\n      # No specific workshop: just USE at current location to craft.\n      actions.append(4)\n\n  return actions", "env_interactions": 1, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T17:16:43.011339", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Reset the environment and fetch the initial state/world.\n  env.reset()\n  state = env._current_state          # type: CraftState\n  world = env.world\n\n  # Goal index for the current task.\n  goal_idx = env.task.goal\n\n  # Primitive requirements for the goal (recursively expanded).\n  needed = world.cookbook.primitives_for(goal_idx)   # dict {kind_idx: count}\n\n  # Determine workshop (if any) where the goal must be crafted.\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n\n  # ----------------------------------------------------------------------\n  # Helper utilities.\n  # ----------------------------------------------------------------------\n  def locate(kind):\n      \"\"\"Return a list of (x, y) positions where `kind` occurs in the grid.\"\"\"\n      inds = np.argwhere(state.grid[:, :, kind] > 0)\n      return [tuple(p) for p in inds]\n\n  def bfs_actions(start, target):\n      \"\"\"\n      Breadth\u2011first search returning a list of actions (0\u2011DOWN,1\u2011UP,2\u2011LEFT,3\u2011RIGHT)\n      that moves from `start` to `target` while avoiding occupied cells.\n      \"\"\"\n      occ = np.any(state.grid > 0, axis=2)          # True where blocked\n      width, height = occ.shape\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          pos, path = q.popleft()\n          if pos == target:\n              return path\n          x, y = pos\n          for act, (dx, dy) in ((0, (0, 1)), (1, (0, -1)),\n                                (2, (-1, 0)), (3, (1, 0))):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height:\n                  if not occ[nx, ny] and (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [act]))\n      # No path found \u2013 return empty list.\n      return []\n\n  def go_to(target):\n      \"\"\"Move the agent from its current position to `target`, recording actions.\"\"\"\n      nonlocal state\n      for act in bfs_actions(state.pos, target):\n          actions.append(act)\n          _, state = state.step(act)\n\n  # ----------------------------------------------------------------------\n  # Action list to be returned.\n  # ----------------------------------------------------------------------\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # 1. Collect all required primitives.\n  # ----------------------------------------------------------------------\n  for kind, cnt in needed.items():\n      for _ in range(cnt):\n          positions = locate(kind)\n          if not positions:\n              # Primitive missing \u2013 abort early.\n              return actions\n          # Choose the nearest occurrence (Manhattan distance).\n          target = min(positions,\n                       key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))\n          go_to(target)\n          # Pick up the item.\n          actions.append(4)          # USE\n          _, state = state.step(4)\n\n  # ----------------------------------------------------------------------\n  # 2. Go to the workshop (if required) and craft the goal.\n  # ----------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_positions = locate(workshop_idx)\n      if ws_positions:\n          target_ws = min(ws_positions,\n                          key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))\n          go_to(target_ws)\n          actions.append(4)          # USE to trigger crafting\n          _, state = state.step(4)\n\n  # Return the compiled action sequence.\n  return actions", "env_interactions": 0, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T17:16:44.135120", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Reset environment and get initial state/world.\n  env.reset()\n  state = env._current_state          # type: CraftState\n  world = env.world\n\n  # Goal index for the current task.\n  goal_idx = env.task.goal\n\n  # Primitive requirements for the goal.\n  needed = world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n\n  # Determine workshop index if recipe specifies one.\n  workshop_idx = None\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  ws_name = recipe.get('_at')\n  if ws_name is not None:\n      workshop_idx = world.cookbook.index[ws_name]\n\n  # ------------------------------------------------------------------\n  # Helper utilities.\n  # ------------------------------------------------------------------\n  def locate(kind):\n      \"\"\"Return list of (x, y) positions where `kind` is present.\"\"\"\n      inds = np.argwhere(state.grid[:, :, kind] > 0)\n      return [tuple(p) for p in inds]\n\n  def bfs_actions(start, target):\n      \"\"\"Return list of actions (0\u2011DOWN,1\u2011UP,2\u2011LEFT,3\u2011RIGHT) to move from start to target.\"\"\"\n      occ = np.any(state.grid > 0, axis=2)          # blocked cells\n      w, h = occ.shape\n      q = deque([(start, [])])\n      visited = {start}\n      while q:\n          pos, path = q.popleft()\n          if pos == target:\n              return path\n          x, y = pos\n          for act, (dx, dy) in ((0, (0, 1)), (1, (0, -1)), (2, (-1, 0)), (3, (1, 0))):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and not occ[nx, ny] and (nx, ny) not in visited:\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [act]))\n      return []  # no path found\n\n  def go_to(target):\n      \"\"\"Move agent to target, recording actions and updating state.\"\"\"\n      nonlocal state\n      for act in bfs_actions(state.pos, target):\n          actions.append(act)\n          _, state = state.step(act)\n\n  # ------------------------------------------------------------------\n  # Build action sequence.\n  # ------------------------------------------------------------------\n  actions = []\n\n  # 1. Collect required primitives.\n  for kind, cnt in needed.items():\n      for _ in range(cnt):\n          # Re\u2011locate the kind after each pickup because the grid changes.\n          positions = locate(kind)\n          if not positions:\n              # Primitive not found \u2013 abort early.\n              return actions\n          # Choose nearest occurrence (Manhattan distance).\n          target = min(positions,\n                       key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))\n          go_to(target)\n          # Pick up the item.\n          actions.append(4)          # USE\n          _, state = state.step(4)\n\n  # 2. If a workshop is required, go there and craft.\n  if workshop_idx is not None:\n      ws_positions = locate(workshop_idx)\n      if ws_positions:\n          target_ws = min(ws_positions,\n                          key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))\n          go_to(target_ws)\n          actions.append(4)          # USE to trigger crafting\n          _, state = state.step(4)\n\n  # Return the compiled action list.\n  return actions", "env_interactions": 0, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T17:17:24.404701", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Mapping of movement deltas to action indices (DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4)\n  _delta_to_action = {\n      (0, 1): 0,   # DOWN\n      (0, -1): 1,  # UP\n      (-1, 0): 2,  # LEFT\n      (1, 0): 3,   # RIGHT\n  }\n\n  def _is_free(grid, x, y):\n      \"\"\"Return True if the cell at (x, y) has no entities.\"\"\"\n      return grid[x, y, :].sum() == 0\n\n  def _neighbors(pos, width, height):\n      \"\"\"Yield (next_pos, delta) for orthogonal neighbours.\"\"\"\n      x, y = pos\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < width and 0 <= ny < height:\n              yield (nx, ny), (dx, dy)\n\n  def _bfs_path(grid, start, goal_cond):\n      \"\"\"Bread\u2011first search returning list of actions to reach a cell satisfying goal_cond.\"\"\"\n      width, height = grid.shape[0], grid.shape[1]\n      q = deque([start])\n      came_from = {start: None}\n      move_from = {}\n      while q:\n          cur = q.popleft()\n          if goal_cond(cur):\n              # reconstruct actions\n              actions = []\n              while came_from[cur] is not None:\n                  dx, dy = move_from[cur]\n                  actions.append(_delta_to_action[(dx, dy)])\n                  cur = came_from[cur]\n              actions.reverse()\n              return actions\n          for nxt, delta in _neighbors(cur, width, height):\n              if nxt in came_from:\n                  continue\n              # Allow stepping onto the goal cell even if occupied.\n              if goal_cond(nxt) or _is_free(grid, *nxt):\n                  came_from[nxt] = cur\n                  move_from[nxt] = delta\n                  q.append(nxt)\n      return []  # no path found\n\n  # ------------------------------------------------------------------\n  # Gather environment information.\n  # ------------------------------------------------------------------\n  state = env._current_state          # CraftState\n  world = env.world\n  goal_idx = env.task.goal\n\n  # Primitive requirements for the goal.\n  needed_prims = world.cookbook.primitives_for(goal_idx).copy()\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  if \"_at\" in recipe:\n      workshop_name = recipe[\"_at\"]\n      workshop_idx = world.cookbook.index[workshop_name]\n\n  # Work on mutable copies of grid and inventory.\n  grid = state.grid.copy()\n  inventory = state.inventory.copy()\n  cur_pos = tuple(state.pos)\n\n  plan = []\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitives.\n  # ------------------------------------------------------------------\n  for prim_idx, req_cnt in needed_prims.items():\n      while inventory[prim_idx] < req_cnt:\n          # Locate all cells that currently contain this primitive.\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # Primitive not available \u2013 abort planning.\n              return plan\n          # Choose the closest primitive (Manhattan distance).\n          dists = np.abs(prim_cells[:, 0] - cur_pos[0]) + np.abs(prim_cells[:, 1] - cur_pos[1])\n          target = tuple(prim_cells[dists.argmin()])\n\n          # Move to the chosen primitive.\n          moves = _bfs_path(grid, cur_pos, lambda p, t=target: p == t)\n          plan.extend(moves)\n          cur_pos = target\n\n          # Pick up the primitive.\n          plan.append(4)   # USE\n          grid[cur_pos[0], cur_pos[1], prim_idx] = 0\n          inventory[prim_idx] += 1\n\n  # ------------------------------------------------------------------\n  # 2) Go to the required workshop (if any) and craft the goal.\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      # Find all workshop cells.\n      ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_cells.size == 0:\n          return plan\n\n      width, height = grid.shape[0], grid.shape[1]\n      best_path = None\n      best_target = None\n\n      # Try to stand on a free neighbour of a workshop (or the workshop cell itself if free).\n      for wx, wy in ws_cells:\n          candidates = [(wx, wy),\n                        (wx - 1, wy), (wx + 1, wy),\n                        (wx, wy - 1), (wx, wy + 1)]\n          for cx, cy in candidates:\n              if 0 <= cx < width and 0 <= cy < height and _is_free(grid, cx, cy):\n                  path = _bfs_path(grid, cur_pos, lambda p, t=(cx, cy): p == t)\n                  if best_path is None or len(path) < len(best_path):\n                      best_path = path\n                      best_target = (cx, cy)\n\n      if best_path is None:\n          return plan\n\n      plan.extend(best_path)\n      cur_pos = best_target\n\n      # Use at the workshop to craft.\n      plan.append(4)   # USE\n  else:\n      # No specific workshop \u2013 just use at current location.\n      plan.append(4)   # USE\n\n  return plan", "env_interactions": 1, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T17:17:25.523289", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Mapping from movement delta to action index (DOWN=0, UP=1, LEFT=2, RIGHT=3)\n  _delta_to_action = {\n      (0, 1): 0,   # DOWN\n      (0, -1): 1,  # UP\n      (-1, 0): 2,  # LEFT\n      (1, 0): 3,   # RIGHT\n  }\n  _USE = 4\n\n  def _is_free(grid, x, y):\n      \"\"\"A cell is free if no entity occupies any channel.\"\"\"\n      return grid[x, y, :].sum() == 0\n\n  def _neighbors(pos, width, height):\n      \"\"\"Yield orthogonal neighbours and their deltas.\"\"\"\n      x, y = pos\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < width and 0 <= ny < height:\n              yield (nx, ny), (dx, dy)\n\n  def _bfs_path(grid, start, goal_cond):\n      \"\"\"\n      Bread\u2011first search that returns a list of actions moving the agent\n      from ``start`` to any cell satisfying ``goal_cond``.\n      \"\"\"\n      width, height = grid.shape[0], grid.shape[1]\n      q = deque([start])\n      came_from = {start: None}\n      move_from = {}\n      while q:\n          cur = q.popleft()\n          if goal_cond(cur):\n              # reconstruct actions\n              actions = []\n              while came_from[cur] is not None:\n                  dx, dy = move_from[cur]\n                  actions.append(_delta_to_action[(dx, dy)])\n                  cur = came_from[cur]\n              actions.reverse()\n              return actions\n          for nxt, delta in _neighbors(cur, width, height):\n              if nxt not in came_from and _is_free(grid, *nxt):\n                  came_from[nxt] = cur\n                  move_from[nxt] = delta\n                  q.append(nxt)\n      # no path found\n      return []\n\n  # ------------------------------------------------------------------\n  # Gather static information from the environment.\n  # ------------------------------------------------------------------\n  state = env._current_state          # CraftState\n  world = env.world                   # CraftWorld\n  goal_idx = env.task.goal            # integer index of the desired item\n\n  # Primitive requirements for the goal (and required counts).\n  needed_prims = world.cookbook.primitives_for(goal_idx).copy()\n\n  # Determine if the recipe needs a specific workshop.\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  if \"_at\" in recipe:\n      workshop_idx = world.cookbook.index[recipe[\"_at\"]]\n\n  # Make mutable copies that we will update while planning.\n  grid = state.grid.copy()\n  inventory = state.inventory.copy()\n  cur_pos = tuple(state.pos)\n\n  plan = []\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitives.\n  # ------------------------------------------------------------------\n  for prim_idx, req_cnt in needed_prims.items():\n      while inventory[prim_idx] < req_cnt:\n          # Locate all cells containing this primitive.\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # Primitive not present \u2013 abort planning.\n              return plan\n\n          # Choose the closest primitive (Manhattan distance).\n          dists = np.abs(prim_cells[:, 0] - cur_pos[0]) + np.abs(prim_cells[:, 1] - cur_pos[1])\n          target = tuple(prim_cells[dists.argmin()])\n\n          # Move to the chosen primitive.\n          moves = _bfs_path(grid, cur_pos, lambda p, t=target: p == t)\n          plan.extend(moves)\n          cur_pos = target\n\n          # Pick it up.\n          plan.append(_USE)\n          grid[cur_pos[0], cur_pos[1], prim_idx] = 0\n          inventory[prim_idx] += 1\n\n  # ------------------------------------------------------------------\n  # 2) Go to the required workshop (if any) and craft the goal.\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_cells.size == 0:\n          return plan\n\n      width, height = grid.shape[0], grid.shape[1]\n      best_path = None\n      best_target = None\n\n      # Try to stand on the workshop cell itself or any free orthogonal neighbour.\n      for wx, wy in ws_cells:\n          candidates = [(wx, wy),\n                        (wx - 1, wy), (wx + 1, wy),\n                        (wx, wy - 1), (wx, wy + 1)]\n          for cx, cy in candidates:\n              if 0 <= cx < width and 0 <= cy < height and _is_free(grid, cx, cy):\n                  path = _bfs_path(grid, cur_pos,\n                                   lambda p, t=(cx, cy): p == t)\n                  if best_path is None or len(path) < len(best_path):\n                      best_path = path\n                      best_target = (cx, cy)\n\n      if best_path is not None:\n          plan.extend(best_path)\n          cur_pos = best_target\n          plan.append(_USE)  # craft at the workshop\n  else:\n      # No workshop needed \u2013 simply use at the current location.\n      plan.append(_USE)\n\n  return plan", "env_interactions": 1, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T17:17:47.882768", "function_name": "make_arrow", "function_body": "  # Reset environment to obtain initial state.\n  _ = env.reset()\n  act_map = env.action_specs()  # mapping from action name to integer\n\n  # Directions and helper deltas.\n  moves = [(1, 0, \"DOWN\"), (-1, 0, \"UP\"), (0, 1, \"RIGHT\"), (0, -1, \"LEFT\")]\n  dir_to_delta = {name: (dr, dc) for dr, dc, name in moves}\n\n  # ------------------------------------------------------------------\n  # Bread\u2011first search that returns a list of direction names leading\n  # from `start` to any free cell adjacent to `target`.\n  from collections import deque\n\n  def bfs_adj(start, target, occ):\n      tr, tc = target\n      # cells we are allowed to stand on (free neighbours of target)\n      adj = [\n          (tr + dr, tc + dc)\n          for dr, dc, _ in moves\n          if 0 <= tr + dr < occ.shape[0]\n          and 0 <= tc + dc < occ.shape[1]\n          and not occ[tr + dr, tc + dc]\n      ]\n      if not adj:\n          return []  # no reachable neighbour\n\n      q = deque([start])\n      parent = {start: None}\n      parent_move = {}\n\n      while q:\n          cur = q.popleft()\n          if cur in adj:\n              # reconstruct path of direction names\n              path = []\n              while parent[cur] is not None:\n                  path.append(parent_move[cur])\n                  cur = parent[cur]\n              path.reverse()\n              return path\n\n          r, c = cur\n          for dr, dc, name in moves:\n              nr, nc = r + dr, c + dc\n              if (\n                  0 <= nr < occ.shape[0]\n                  and 0 <= nc < occ.shape[1]\n                  and not occ[nr, nc]\n                  and (nr, nc) not in parent\n              ):\n                  parent[(nr, nc)] = cur\n                  parent_move[(nr, nc)] = name\n                  q.append((nr, nc))\n      return []  # no path found\n\n  # ------------------------------------------------------------------\n  # Extract world / recipe information.\n  scenario = env.scenario\n  world = scenario.world\n  goal_idx = env.task.goal  # integer index of the desired item\n\n  # Primitive requirements for the goal.\n  primitives_needed = world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  # Workshop location (if any) for the goal.\n  workshop_idx = world.cookbook.recipes.get(goal_idx, {}).get(\"_at\")\n\n  # Working copies of the initial grid and occupancy mask.\n  grid = scenario.init_grid.copy()\n  occ = grid.sum(axis=2) > 0  # True where any entity occupies the cell.\n  cur_pos = scenario.init_pos  # (row, col)\n\n  actions = []\n\n  # Helper to execute a list of direction names, updating position & actions.\n  def follow(path_dirs):\n      nonlocal cur_pos\n      for dname in path_dirs:\n          actions.append(act_map[dname])\n          dr, dc = dir_to_delta[dname]\n          cur_pos = (cur_pos[0] + dr, cur_pos[1] + dc)\n\n  # ------------------------------------------------------------------\n  # Collect all required primitives.\n  for prim_idx, needed in primitives_needed.items():\n      for _ in range(needed):\n          # Find all remaining cells that still contain this primitive.\n          prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not prim_cells:\n              break  # nothing left (should not happen in a solvable scenario)\n\n          # Choose the closest instance (Manhattan distance).\n          target = min(\n              prim_cells,\n              key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]),\n          )\n\n          # Move to an empty neighbour of the target cell.\n          path = bfs_adj(cur_pos, target, occ)\n          follow(path)\n\n          # Use action to pick up the primitive.\n          actions.append(act_map[\"USE\"])\n\n          # Update grid / occupancy: primitive disappears after pickup.\n          r, c = target\n          grid[r, c, :] = 0\n          occ[r, c] = False\n\n  # ------------------------------------------------------------------\n  # Move to the workshop (if required) and craft the goal item.\n  if workshop_idx is not None:\n      # Locate workshop cells (they are static in the original scenario grid).\n      workshop_cells = list(zip(*np.where(scenario.init_grid[:, :, workshop_idx] > 0)))\n      if workshop_cells:\n          target = workshop_cells[0]  # any workshop cell suffices\n          path = bfs_adj(cur_pos, target, occ)\n          follow(path)\n          # Craft by using the workshop.\n          actions.append(act_map[\"USE\"])\n\n  # Return the complete action sequence.\n  return actions", "env_interactions": 0, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T17:17:48.995317", "function_name": "make_arrow", "function_body": "  # Reset the environment and obtain the mapping from action names to indices.\n  _ = env.reset()\n  act_map = env.action_specs()\n\n  # Direction vectors and helper dictionaries.\n  moves = [(1, 0, \"DOWN\"), (-1, 0, \"UP\"), (0, 1, \"RIGHT\"), (0, -1, \"LEFT\")]\n  dir_to_delta = {name: (dr, dc) for dr, dc, name in moves}\n\n  from collections import deque\n\n  # Bread\u2011first search that returns a list of direction names leading from\n  # `start` to any free neighbour of `target`.  The occupancy mask `occ`\n  # is True on blocked cells.\n  def bfs_adj(start, target, occ):\n      tr, tc = target\n      # All free cells adjacent to the target that the agent could stand on.\n      adj = [\n          (tr + dr, tc + dc)\n          for dr, dc, _ in moves\n          if 0 <= tr + dr < occ.shape[0]\n          and 0 <= tc + dc < occ.shape[1]\n          and not occ[tr + dr, tc + dc]\n      ]\n      if not adj:\n          return []\n\n      q = deque([start])\n      parent = {start: None}\n      parent_move = {}\n\n      while q:\n          cur = q.popleft()\n          if cur in adj:\n              # Reconstruct the path of direction names.\n              path = []\n              while parent[cur] is not None:\n                  path.append(parent_move[cur])\n                  cur = parent[cur]\n              path.reverse()\n              return path\n\n          r, c = cur\n          for dr, dc, name in moves:\n              nr, nc = r + dr, c + dc\n              if (\n                  0 <= nr < occ.shape[0]\n                  and 0 <= nc < occ.shape[1]\n                  and not occ[nr, nc]\n                  and (nr, nc) not in parent\n              ):\n                  parent[(nr, nc)] = cur\n                  parent_move[(nr, nc)] = name\n                  q.append((nr, nc))\n      return []\n\n  # ----------------------------------------------------------------------\n  # Extract scenario / world information.\n  scenario = env.scenario\n  world = scenario.world\n  goal_idx = env.task.goal  # integer index of the item we need to make.\n\n  # Recipe information.\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = recipe.get(\"_at\")\n  primitives_needed = world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n\n  # Working copies of the grid and a binary occupancy mask.\n  grid = scenario.init_grid.copy()\n  occ = grid.sum(axis=2) > 0  # True where any entity occupies the cell.\n  cur_pos = scenario.init_pos  # (row, col)\n\n  actions = []\n\n  # Helper that executes a list of direction names, updating `cur_pos`\n  # and appending the corresponding action indices to `actions`.\n  def follow(path_dirs):\n      nonlocal cur_pos\n      for dname in path_dirs:\n          actions.append(act_map[dname])\n          dr, dc = dir_to_delta[dname]\n          cur_pos = (cur_pos[0] + dr, cur_pos[1] + dc)\n\n  # ----------------------------------------------------------------------\n  # 1) Collect every required primitive the needed number of times.\n  for prim_idx, needed_cnt in primitives_needed.items():\n      for _ in range(needed_cnt):\n          # Locate all remaining instances of this primitive.\n          prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not prim_cells:\n              # No more instances left \u2013 break early.\n              break\n\n          # Choose the closest instance (Manhattan distance).\n          target = min(\n              prim_cells,\n              key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]),\n          )\n\n          # Move to a free neighbour of the target cell.\n          path = bfs_adj(cur_pos, target, occ)\n          follow(path)\n\n          # Pick up the primitive.\n          actions.append(act_map[\"USE\"])\n\n          # Update the grid / occupancy mask to reflect the collected item.\n          r, c = target\n          grid[r, c, :] = 0\n          occ[r, c] = False\n\n  # ----------------------------------------------------------------------\n  # 2) Go to the workshop (if the recipe requires one) and craft the goal.\n  if workshop_idx is not None:\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))\n      if not workshop_cells:\n          # The workshop might have been overwritten in `grid`; fall back\n          # to the original scenario grid.\n          workshop_cells = list(\n              zip(*np.where(scenario.init_grid[:, :, workshop_idx] > 0))\n          )\n      if workshop_cells:\n          target = workshop_cells[0]  # Any workshop cell suffices.\n          path = bfs_adj(cur_pos, target, occ)\n          follow(path)\n          # Craft by using the workshop.\n          actions.append(act_map[\"USE\"])\n\n  # Return the complete action sequence.\n  return actions", "env_interactions": 0, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T17:18:07.095558", "function_name": "make_arrow", "function_body": "  # Reset environment and get initial state/world\n  env.reset()\n  state = env._current_state          # type: CraftState\n  world = env.world\n\n  # Goal index and primitive requirements\n  goal_idx = env.task.goal\n  needed = world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n\n  # Determine required workshop (if any)\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  import numpy as np\n  from collections import deque\n\n  def locate(kind):\n      \"\"\"Return list of (x, y) positions where `kind` is present on the grid.\"\"\"\n      inds = np.argwhere(state.grid[:, :, kind] > 0)\n      return [tuple(p) for p in inds]\n\n  def step_action(act):\n      \"\"\"Execute an action, updating the local `state`.\"\"\"\n      nonlocal state\n      _, new_state = state.step(act)\n      state = new_state\n\n  def bfs_actions(start, target):\n      \"\"\"\n      Bread\u2011first search returning a list of actions (0\u2011DOWN,1\u2011UP,2\u2011LEFT,3\u2011RIGHT)\n      that moves from `start` to `target` while avoiding occupied cells.\n      The target cell may be occupied (e.g., holding a primitive), which we\n      allow to step onto.\n      \"\"\"\n      occ = np.any(state.grid > 0, axis=2)  # True where any entity exists\n      width, height = occ.shape\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          pos, path = q.popleft()\n          if pos == target:\n              return path\n          x, y = pos\n          for act, (dx, dy) in ((0, (0, 1)), (1, (0, -1)),\n                                (2, (-1, 0)), (3, (1, 0))):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height:\n                  # Allow stepping on the target even if occupied\n                  if (nx, ny) != target and occ[nx, ny]:\n                      continue\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [act]))\n      # No path found \u2013 return empty list\n      return []\n\n  def go_to(target):\n      \"\"\"Move from current position to `target`, recording actions.\"\"\"\n      for act in bfs_actions(state.pos, target):\n          actions.append(act)\n          step_action(act)\n\n  # ------------------------------------------------------------------\n  # 1) Collect required primitives (taking inventory into account)\n  # ------------------------------------------------------------------\n  for kind, req_cnt in needed.items():\n      while state.inventory[kind] < req_cnt:\n          positions = locate(kind)\n          if not positions:\n              # Primitive not available; abort early\n              return actions\n          # Choose the nearest occurrence (Manhattan distance)\n          target = min(positions,\n                       key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))\n          go_to(target)\n          # Pick up the primitive\n          actions.append(4)          # USE\n          step_action(4)\n\n  # ------------------------------------------------------------------\n  # 2) Go to workshop (if required) and craft the goal item\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_positions = locate(workshop_idx)\n      if ws_positions:\n          target_ws = min(ws_positions,\n                          key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))\n          go_to(target_ws)\n          actions.append(4)          # USE to trigger crafting\n          step_action(4)\n\n  return actions", "env_interactions": 0, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T17:18:08.220105", "function_name": "make_arrow", "function_body": "  # Reset environment and obtain initial state/world.\n  env.reset()\n  state = env._current_state          # type: CraftState\n  world = env.world\n\n  # Goal item index.\n  goal_idx = env.task.goal\n\n  # Primitive requirements for one unit of the goal (expanded recursively).\n  needed = world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n\n  # Determine required workshop (if any) for crafting the goal.\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  if \"_at\" in recipe:\n      workshop_name = recipe[\"_at\"]\n      workshop_idx = world.cookbook.index[workshop_name]\n\n  # ------------------------------------------------------------------\n  # Helper utilities.\n  # ------------------------------------------------------------------\n  def locate(kind):\n      \"\"\"Return list of (x, y) coordinates where `kind` is present on the grid.\"\"\"\n      inds = np.argwhere(state.grid[:, :, kind] > 0)\n      return [tuple(p) for p in inds]\n\n  def bfs_actions(start, target):\n      \"\"\"\n      Bread\u2011first search returning a list of actions (0\u2011DOWN,1\u2011UP,2\u2011LEFT,3\u2011RIGHT)\n      that moves from `start` to `target` while avoiding occupied cells.\n      \"\"\"\n      occ = np.any(state.grid > 0, axis=2)          # True where blocked\n      w, h = occ.shape\n      q = collections.deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          pos, path = q.popleft()\n          if pos == target:\n              return path\n          x, y = pos\n          for act, (dx, dy) in ((0, (0, 1)), (1, (0, -1)),\n                                (2, (-1, 0)), (3, (1, 0))):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and not occ[nx, ny]:\n                  nxt = (nx, ny)\n                  if nxt not in visited:\n                      visited.add(nxt)\n                      q.append((nxt, path + [act]))\n      return []   # No path found (should not happen in valid scenarios)\n\n  def go_to(target):\n      \"\"\"Move agent from its current position to `target`, recording actions.\"\"\"\n      nonlocal state\n      for act in bfs_actions(state.pos, target):\n          actions.append(act)\n          _, state = state.step(act)\n\n  # ------------------------------------------------------------------\n  # Build action sequence.\n  # ------------------------------------------------------------------\n  actions = []\n\n  # 1) Collect all required primitives.\n  for kind, cnt in needed.items():\n      for _ in range(cnt):\n          positions = locate(kind)\n          if not positions:          # Primitive missing \u2013 abort early.\n              return actions\n          # Choose nearest occurrence (Manhattan distance).\n          target = min(positions,\n                       key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))\n          go_to(target)\n          actions.append(4)          # USE to pick up the item.\n          _, state = state.step(4)\n\n  # 2) If a workshop is required, go there and craft the goal.\n  if workshop_idx is not None:\n      ws_positions = locate(workshop_idx)\n      if ws_positions:\n          target_ws = min(ws_positions,\n                          key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))\n          go_to(target_ws)\n          actions.append(4)          # USE to trigger crafting.\n          _, state = state.step(4)\n\n  return actions", "env_interactions": 0, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T17:18:34.566315", "function_name": "make_arrow", "function_body": "  # Reset environment and obtain initial state and world objects\n  env.reset()\n  state = env._current_state          # type: CraftState\n  world = env.world                    # type: CraftWorld\n\n  # Goal item index (arrow)\n  goal_idx = env.task.goal\n\n  # Action indices from the environment's specification\n  action_map = env.action_specs()\n  ACTION_DOWN = action_map[\"DOWN\"]\n  ACTION_UP = action_map[\"UP\"]\n  ACTION_LEFT = action_map[\"LEFT\"]\n  ACTION_RIGHT = action_map[\"RIGHT\"]\n  ACTION_USE = action_map[\"USE\"]\n\n  # Direction vectors paired with corresponding actions\n  move_dirs = [\n      (1, 0, ACTION_DOWN),   # down\n      (-1, 0, ACTION_UP),    # up\n      (0, -1, ACTION_LEFT),  # left\n      (0, 1, ACTION_RIGHT)   # right\n  ]\n\n  actions = []\n\n  def find_path(cur_state, target_kind):\n      \"\"\"\n      Breadth\u2011first search that returns a list of movement actions\n      leading from the agent's current position to any cell containing\n      `target_kind`. Cells occupied by other entities are treated as\n      obstacles, except the target cell itself.\n      \"\"\"\n      grid = cur_state.grid\n      H, W, _ = grid.shape\n      start = cur_state.pos\n      visited = {start}\n      q = collections.deque([(start, [])])\n\n      while q:\n          (x, y), path = q.popleft()\n          if grid[x, y, target_kind] > 0:\n              return path\n          for dx, dy, act in move_dirs:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < H and 0 <= ny < W):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              occupied = np.any(grid[nx, ny, :] > 0)\n              # Allow stepping onto the target cell even if occupied\n              if occupied and grid[nx, ny, target_kind] == 0:\n                  continue\n              visited.add((nx, ny))\n              q.append(((nx, ny), path + [act]))\n      # No reachable cell found (should not happen in valid scenarios)\n      return []\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitive resources.\n  # ------------------------------------------------------------------\n  required = world.cookbook.primitives_for(goal_idx)   # {primitive_kind: count}\n  for kind, count in required.items():\n      for _ in range(count):\n          path = find_path(state, kind)\n          for act in path:\n              _, state = state.step(act)\n              actions.append(act)\n          # Pick up the primitive under the agent\n          _, state = state.step(ACTION_USE)\n          actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # 2) Move to the appropriate workshop (if any) and craft the goal.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get('_at')\n  if workshop_kind is not None:\n      path = find_path(state, workshop_kind)\n      for act in path:\n          _, state = state.step(act)\n          actions.append(act)\n      # Use the workshop to craft the arrow\n      _, state = state.step(ACTION_USE)\n      actions.append(ACTION_USE)\n\n  return actions", "env_interactions": 0, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T17:18:35.688655", "function_name": "make_arrow", "function_body": "  import collections\n\n  # reset environment and get handles\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n\n  # goal index and action mapping\n  goal_idx = env.task.goal\n  action_map = env.action_specs()\n  ACTION_DOWN = action_map[\"DOWN\"]\n  ACTION_UP = action_map[\"UP\"]\n  ACTION_LEFT = action_map[\"LEFT\"]\n  ACTION_RIGHT = action_map[\"RIGHT\"]\n  ACTION_USE = action_map[\"USE\"]\n  move_dirs = [(1, 0, ACTION_DOWN), (-1, 0, ACTION_UP),\n               (0, -1, ACTION_LEFT), (0, 1, ACTION_RIGHT)]\n\n  actions = []\n\n  def find_path(cur_state, target_kind):\n      \"\"\"BFS returning a list of movement actions to reach any cell\n      containing `target_kind`.  Non\u2011grabbable entities are treated as\n      obstacles unless they are the target itself (e.g., a workshop).\"\"\"\n      grid = cur_state.grid\n      H, W, _ = grid.shape\n      start = cur_state.pos\n      visited = {start}\n      q = collections.deque([(start, [])])\n\n      while q:\n          (x, y), path = q.popleft()\n          if grid[x, y, target_kind] > 0:\n              return path\n          for dx, dy, act in move_dirs:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < H and 0 <= ny < W):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              # check obstacles: any non\u2011grabbable entity blocks movement\n              blocked = any(grid[nx, ny, idx] > 0 for idx in world.non_grabbable_indices)\n              # allow stepping onto target if it itself is non\u2011grabbable (e.g., workshop)\n              if blocked and target_kind not in world.non_grabbable_indices:\n                  continue\n              visited.add((nx, ny))\n              q.append(((nx, ny), path + [act]))\n      # target not reachable \u2013 return empty path\n      return []\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitives.\n  # ------------------------------------------------------------------\n  required = world.cookbook.primitives_for(goal_idx)\n  for kind, cnt in required.items():\n      for _ in range(cnt):\n          path = find_path(state, kind)\n          for act in path:\n              _, state = state.step(act)\n              actions.append(act)\n          # pick up the primitive\n          _, state = state.step(ACTION_USE)\n          actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # 2) Go to the workshop (if any) and craft the goal item.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      path = find_path(state, workshop_kind)\n      for act in path:\n          _, state = state.step(act)\n          actions.append(act)\n      # use the workshop to craft\n      _, state = state.step(ACTION_USE)\n      actions.append(ACTION_USE)\n\n  return actions", "env_interactions": 0, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T17:19:00.102209", "function_name": "make_arrow", "function_body": "  # Reset environment and obtain action mapping\n  _ = env.reset()\n  act_map = env.action_specs()\n\n  # Define movement directions\n  moves = [(1, 0, \"DOWN\"), (-1, 0, \"UP\"), (0, 1, \"RIGHT\"), (0, -1, \"LEFT\")]\n  dir_to_delta = {name: (dr, dc) for dr, dc, name in moves}\n  from collections import deque\n\n  # Bread\u2011first search for a path that ends on an empty cell adjacent to `target`\n  def bfs_adj(start, target, occ):\n      tr, tc = target\n      # All free neighbours of the target that can be stood on\n      adj = [\n          (tr + dr, tc + dc)\n          for dr, dc, _ in moves\n          if 0 <= tr + dr < occ.shape[0]\n          and 0 <= tc + dc < occ.shape[1]\n          and not occ[tr + dr, tc + dc]\n      ]\n      if not adj:\n          return []\n      q = deque([start])\n      parent = {start: None}\n      parent_move = {}\n      while q:\n          cur = q.popleft()\n          if cur in adj:\n              # Reconstruct path of direction names\n              path = []\n              while parent[cur] is not None:\n                  path.append(parent_move[cur])\n                  cur = parent[cur]\n              path.reverse()\n              return path\n          r, c = cur\n          for dr, dc, name in moves:\n              nr, nc = r + dr, c + dc\n              if (\n                  0 <= nr < occ.shape[0]\n                  and 0 <= nc < occ.shape[1]\n                  and not occ[nr, nc]\n                  and (nr, nc) not in parent\n              ):\n                  parent[(nr, nc)] = cur\n                  parent_move[(nr, nc)] = name\n                  q.append((nr, nc))\n      return []\n\n  # ----------------------------------------------------------------------\n  # Access scenario / world information\n  scenario = env.scenario\n  world = scenario.world\n  goal_idx = env.task.goal  # integer index of the desired item\n\n  # Recipe data\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = recipe.get(\"_at\")\n  primitives_needed = world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n\n  # Working copies of the grid and occupancy mask\n  grid = scenario.init_grid.copy()\n  occ = grid.sum(axis=2) > 0  # True where any entity occupies the cell\n  cur_pos = scenario.init_pos  # (row, col)\n\n  actions = []\n\n  # Helper to follow a list of direction names, updating position and actions\n  def follow(path_dirs):\n      nonlocal cur_pos\n      for dname in path_dirs:\n          actions.append(act_map[dname])\n          dr, dc = dir_to_delta[dname]\n          cur_pos = (cur_pos[0] + dr, cur_pos[1] + dc)\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive the needed number of times\n  for prim_idx, needed_cnt in primitives_needed.items():\n      for _ in range(needed_cnt):\n          # Locate remaining instances of this primitive\n          prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not prim_cells:\n              break  # No more of this primitive left\n\n          # Choose the closest one (Manhattan distance)\n          target = min(\n              prim_cells,\n              key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]),\n          )\n\n          # Move to an empty neighbour of the target\n          path = bfs_adj(cur_pos, target, occ)\n          follow(path)\n\n          # Use to pick up the primitive\n          actions.append(act_map[\"USE\"])\n\n          # Update grid / occupancy: primitive disappears\n          r, c = target\n          grid[r, c, :] = 0\n          occ[r, c] = False\n\n  # ----------------------------------------------------------------------\n  # Move to the workshop (if any) and craft the goal item\n  if workshop_idx is not None:\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))\n      if not workshop_cells:\n          # Fall back to the original scenario grid if the workshop was removed\n          workshop_cells = list(\n              zip(*np.where(scenario.init_grid[:, :, workshop_idx] > 0))\n          )\n      if workshop_cells:\n          target = workshop_cells[0]  # Any workshop cell will do\n          path = bfs_adj(cur_pos, target, occ)\n          follow(path)\n          # Craft by using the workshop\n          actions.append(act_map[\"USE\"])\n\n  # Return the compiled action sequence\n  return actions", "env_interactions": 0, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T17:19:01.230916", "function_name": "make_arrow", "function_body": "  # Reset environment and obtain useful handles.\n  _ = env.reset()\n  act_map = env.action_specs()                     # e.g. {\"DOWN\":0,...}\n  scenario = env.scenario\n  world = scenario.world\n  goal_idx = env.task.goal                         # integer index of the goal item\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of direction names to reach any free\n  # neighbour of a target cell.\n  moves = [(1, 0, \"DOWN\"), (-1, 0, \"UP\"), (0, 1, \"RIGHT\"), (0, -1, \"LEFT\")]\n  dir_to_delta = {name: (dr, dc) for dr, dc, name in moves}\n  from collections import deque\n\n  def bfs_adj(start, target, occ):\n      tr, tc = target\n      # all free cells adjacent to the target\n      adj = [\n          (tr + dr, tc + dc)\n          for dr, dc, _ in moves\n          if 0 <= tr + dr < occ.shape[0]\n          and 0 <= tc + dc < occ.shape[1]\n          and not occ[tr + dr, tc + dc]\n      ]\n      if not adj:\n          return []                                 # cannot stand next to it\n\n      q = deque([start])\n      parent = {start: None}\n      parent_move = {}\n\n      while q:\n          cur = q.popleft()\n          if cur in adj:                            # reached a valid neighbour\n              path = []\n              while parent[cur] is not None:\n                  path.append(parent_move[cur])\n                  cur = parent[cur]\n              path.reverse()\n              return path\n\n          r, c = cur\n          for dr, dc, name in moves:\n              nr, nc = r + dr, c + dc\n              if (\n                  0 <= nr < occ.shape[0]\n                  and 0 <= nc < occ.shape[1]\n                  and not occ[nr, nc]\n                  and (nr, nc) not in parent\n              ):\n                  parent[(nr, nc)] = cur\n                  parent_move[(nr, nc)] = name\n                  q.append((nr, nc))\n      return []                                     # no reachable neighbour\n\n  # ------------------------------------------------------------------\n  # Gather recipe information.\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = recipe.get(\"_at\")                  # may be None\n  primitives_needed = world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n\n  # Working copies of the grid and occupancy mask.\n  grid = scenario.init_grid.copy()\n  occ = grid.sum(axis=2) > 0                        # True where any entity occupies the cell\n  cur_pos = scenario.init_pos                       # (row, col)\n\n  actions = []\n\n  # Helper to walk a list of direction names, updating cur_pos and actions.\n  def walk(path_dirs):\n      nonlocal cur_pos\n      for dname in path_dirs:\n          actions.append(act_map[dname])\n          dr, dc = dir_to_delta[dname]\n          cur_pos = (cur_pos[0] + dr, cur_pos[1] + dc)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the required number of times.\n  for prim_idx, needed in primitives_needed.items():\n      for _ in range(needed):\n          # Locate remaining instances of the primitive.\n          prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not prim_cells:\n              # nothing left \u2013 break early\n              break\n\n          # Choose the closest instance (Manhattan distance).\n          target = min(\n              prim_cells,\n              key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]),\n          )\n\n          # Move to a free neighbour of the primitive.\n          path = bfs_adj(cur_pos, target, occ)\n          walk(path)\n\n          # Use action to pick it up.\n          actions.append(act_map[\"USE\"])\n\n          # Update our internal model of the world.\n          r, c = target\n          grid[r, c, :] = 0\n          occ[r, c] = False\n\n  # ------------------------------------------------------------------\n  # Go to the workshop (if any) and craft the goal item.\n  if workshop_idx is not None:\n      # Find a workshop cell (use the original scenario grid if the\n      # workshop was removed during collection).\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))\n      if not workshop_cells:\n          workshop_cells = list(\n              zip(*np.where(scenario.init_grid[:, :, workshop_idx] > 0))\n          )\n      if workshop_cells:\n          target = workshop_cells[0]                # any workshop cell works\n          path = bfs_adj(cur_pos, target, occ)\n          walk(path)\n          actions.append(act_map[\"USE\"])            # craft by using the workshop\n\n  # Return the assembled action sequence.\n  return actions", "env_interactions": 0, "island_id": 9, "scores": {"3": 0.0}}
