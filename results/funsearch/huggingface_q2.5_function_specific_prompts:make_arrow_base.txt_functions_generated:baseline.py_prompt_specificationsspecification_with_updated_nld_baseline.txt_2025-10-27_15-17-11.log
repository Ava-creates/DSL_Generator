{"timestamp": "2025-10-27T17:11:39.998265", "function_name": "make_arrow", "function_body": "  # Reset the environment to obtain a fresh state.\n  _ = env.reset()\n  act_map = env.action_specs()\n\n  # Movement directions.\n  moves = [(1, 0, \"DOWN\"), (-1, 0, \"UP\"), (0, 1, \"RIGHT\"), (0, -1, \"LEFT\")]\n  dir_to_delta = {name: (dr, dc) for dr, dc, name in moves}\n\n  # Bread\u2011first search for a path that ends on an empty cell adjacent to `target`.\n  from collections import deque\n\n  def bfs_adj(start, target, occ):\n      tr, tc = target\n      # All free neighbours of the target that can be stood on.\n      adj_cells = [\n          (tr + dr, tc + dc)\n          for dr, dc, _ in moves\n          if 0 <= tr + dr < occ.shape[0]\n          and 0 <= tc + dc < occ.shape[1]\n          and not occ[tr + dr, tc + dc]\n      ]\n      if not adj_cells:\n          return []\n\n      q = deque([start])\n      parent = {start: None}\n      parent_move = {}\n\n      while q:\n          cur = q.popleft()\n          if cur in adj_cells:\n              # Reconstruct the list of direction names.\n              path = []\n              while parent[cur] is not None:\n                  path.append(parent_move[cur])\n                  cur = parent[cur]\n              path.reverse()\n              return path\n\n          r, c = cur\n          for dr, dc, name in moves:\n              nr, nc = r + dr, c + dc\n              if (\n                  0 <= nr < occ.shape[0]\n                  and 0 <= nc < occ.shape[1]\n                  and not occ[nr, nc]\n                  and (nr, nc) not in parent\n              ):\n                  parent[(nr, nc)] = cur\n                  parent_move[(nr, nc)] = name\n                  q.append((nr, nc))\n      return []\n\n  # ----------------------------------------------------------------------\n  # Access scenario / world information.\n  scenario = env.scenario\n  world = scenario.world\n  goal_idx = env.task.goal  # integer index of the desired item.\n\n  # Recipe data.\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = recipe.get(\"_at\")\n  primitives_needed = world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n\n  # Working copies of the grid and occupancy mask.\n  grid = scenario.init_grid.copy()\n  occ = grid.sum(axis=2) > 0  # True where any entity occupies the cell.\n  cur_pos = scenario.init_pos  # (row, col)\n\n  actions = []\n\n  # Helper to follow a list of direction names, updating position and actions.\n  def follow(path_dirs):\n      nonlocal cur_pos\n      for dname in path_dirs:\n          actions.append(act_map[dname])\n          dr, dc = dir_to_delta[dname]\n          cur_pos = (cur_pos[0] + dr, cur_pos[1] + dc)\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive the needed number of times.\n  for prim_idx, needed_cnt in primitives_needed.items():\n      for _ in range(needed_cnt):\n          # Locate remaining instances of this primitive.\n          prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not prim_cells:\n              break  # No more of this primitive left.\n\n          # Choose the closest one (Manhattan distance).\n          target = min(\n              prim_cells,\n              key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]),\n          )\n\n          # Move to an empty neighbour of the target.\n          path = bfs_adj(cur_pos, target, occ)\n          follow(path)\n\n          # Use to pick up the primitive.\n          actions.append(act_map[\"USE\"])\n\n          # Update grid / occupancy: primitive disappears.\n          r, c = target\n          grid[r, c, :] = 0\n          occ[r, c] = False\n\n  # ----------------------------------------------------------------------\n  # Move to the workshop (if any) and craft the goal item.\n  if workshop_idx is not None:\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))\n      if not workshop_cells:\n          # Fall back to the original scenario grid if the workshop was removed.\n          workshop_cells = list(\n              zip(*np.where(scenario.init_grid[:, :, workshop_idx] > 0))\n          )\n      if workshop_cells:\n          target = workshop_cells[0]  # Any workshop cell will do.\n          path = bfs_adj(cur_pos, target, occ)\n          follow(path)\n          # Craft by using the workshop.\n          actions.append(act_map[\"USE\"])\n\n  # Return the compiled action sequence.\n  return actions", "env_interactions": 0, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T17:11:41.127368", "function_name": "make_arrow", "function_body": "  # Reset environment to ensure fresh state\n  _ = env.reset()\n  act_map = env.action_specs()\n  moves = [\n      (1, 0, \"DOWN\"),\n      (-1, 0, \"UP\"),\n      (0, 1, \"RIGHT\"),\n      (0, -1, \"LEFT\"),\n  ]\n  from collections import deque\n\n  def bfs_to_adjacent(start, target, occ):\n      tr, tc = target\n      # cells adjacent to target that are free\n      goal_cells = [\n          (tr + dr, tc + dc)\n          for dr, dc, _ in moves\n          if 0 <= tr + dr < occ.shape[0]\n          and 0 <= tc + dc < occ.shape[1]\n          and not occ[tr + dr, tc + dc]\n      ]\n      if not goal_cells:\n          return []\n      q = deque([start])\n      parent = {start: None}\n      parent_move = {}\n      while q:\n          cur = q.popleft()\n          if cur in goal_cells:\n              path = []\n              while parent[cur] is not None:\n                  path.append(parent_move[cur])\n                  cur = parent[cur]\n              path.reverse()\n              return path\n          r, c = cur\n          for dr, dc, name in moves:\n              nr, nc = r + dr, c + dc\n              if (\n                  0 <= nr < occ.shape[0]\n                  and 0 <= nc < occ.shape[1]\n                  and not occ[nr, nc]\n                  and (nr, nc) not in parent\n              ):\n                  parent[(nr, nc)] = cur\n                  parent_move[(nr, nc)] = name\n                  q.append((nr, nc))\n      return []\n\n  dir_to_delta = {name: (dr, dc) for dr, dc, name in moves}\n\n  scenario = env.scenario\n  world = scenario.world\n  goal_idx = env.task.goal\n\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = recipe.get(\"_at\")\n  primitives_needed = world.cookbook.primitives_for(goal_idx)\n\n  grid = scenario.init_grid.copy()\n  occ = grid.sum(axis=2) > 0\n\n  cur_pos = scenario.init_pos\n  actions = []\n\n  def execute_path(path_dirs):\n      nonlocal cur_pos\n      for dname in path_dirs:\n          actions.append(act_map[dname])\n          dr, dc = dir_to_delta[dname]\n          cur_pos = (cur_pos[0] + dr, cur_pos[1] + dc)\n\n  # Collect required primitives\n  for prim_idx, count in primitives_needed.items():\n      for _ in range(count):\n          prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not prim_cells:\n              break\n          target = min(\n              prim_cells,\n              key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]),\n          )\n          path = bfs_to_adjacent(cur_pos, target, occ)\n          execute_path(path)\n          actions.append(act_map[\"USE\"])\n          r, c = target\n          grid[r, c, :] = 0\n          occ[r, c] = False\n\n  # Move to workshop and craft\n  if workshop_idx is not None:\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))\n      if not workshop_cells:\n          workshop_cells = list(\n              zip(*np.where(scenario.init_grid[:, :, workshop_idx] > 0))\n          )\n      if workshop_cells:\n          target = workshop_cells[0]\n          path = bfs_to_adjacent(cur_pos, target, occ)\n          execute_path(path)\n          actions.append(act_map[\"USE\"])\n\n  return actions", "env_interactions": 0, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T17:12:03.541493", "function_name": "make_arrow", "function_body": "  # Reset environment and fetch core objects\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n\n  # Identify goal and required primitive items\n  goal_idx = env.task.goal\n  required = world.cookbook.primitives_for(goal_idx)   # {primitive_idx: count}\n\n  # Map actions from the environment spec\n  act_map = env.action_specs()\n  ACTION_DOWN = act_map['DOWN']\n  ACTION_UP = act_map['UP']\n  ACTION_LEFT = act_map['LEFT']\n  ACTION_RIGHT = act_map['RIGHT']\n  ACTION_USE = act_map['USE']\n\n  # Direction vectors paired with their action ids\n  move_dirs = [\n      (1, 0, ACTION_DOWN),\n      (-1, 0, ACTION_UP),\n      (0, -1, ACTION_LEFT),\n      (0, 1, ACTION_RIGHT),\n  ]\n\n  actions = []\n\n  def find_path(cur_state, target_kind):\n      \"\"\"Bread\u2011first search returning a list of movement actions that brings\n      the agent to a cell containing `target_kind`. The agent may step onto\n      empty cells or the target cell itself; all other occupied cells are\n      treated as obstacles.\"\"\"\n      grid = cur_state.grid\n      H, W = grid.shape[:2]\n      start = cur_state.pos\n      visited = {start}\n      from collections import deque\n      q = deque([(start, [])])\n\n      while q:\n          (x, y), path = q.popleft()\n          if grid[x, y, target_kind] > 0:\n              return path\n          for dx, dy, act in move_dirs:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < H and 0 <= ny < W):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              # allow moving onto empty cells or directly onto the target cell\n              if grid[nx, ny, :].sum() == 0 or grid[nx, ny, target_kind] > 0:\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [act]))\n      # If unreachable (should not happen in a valid scenario) return empty list\n      return []\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitive items.\n  # ------------------------------------------------------------------\n  for prim_kind, cnt in required.items():\n      for _ in range(cnt):\n          path = find_path(state, prim_kind)\n          for a in path:\n              _, state = state.step(a)\n              actions.append(a)\n          # Pick up the primitive under the agent\n          _, state = state.step(ACTION_USE)\n          actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # 2) Move to the workshop (if any) and craft the goal item.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get('_at')\n  if workshop_kind is not None:\n      path = find_path(state, workshop_kind)\n      for a in path:\n          _, state = state.step(a)\n          actions.append(a)\n      # Use the workshop to craft the item\n      _, state = state.step(ACTION_USE)\n      actions.append(ACTION_USE)\n\n  return actions", "env_interactions": 0, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T17:12:04.661351", "function_name": "make_arrow", "function_body": "  # reset and fetch core objects\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n\n  # goal item index and its primitive requirements\n  goal_idx = env.task.goal\n  required = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # action mapping from the environment\n  act_map = env.action_specs()\n  ACTION_DOWN = act_map.get('DOWN')\n  ACTION_UP = act_map.get('UP')\n  ACTION_LEFT = act_map.get('LEFT')\n  ACTION_RIGHT = act_map.get('RIGHT')\n  ACTION_USE = act_map.get('USE')\n\n  # direction vectors paired with their action ids\n  move_dirs = [\n      (1, 0, ACTION_DOWN),\n      (-1, 0, ACTION_UP),\n      (0, -1, ACTION_LEFT),\n      (0, 1, ACTION_RIGHT),\n  ]\n\n  actions = []\n\n  def find_path(cur_state, target_kind):\n      \"\"\"BFS returning a list of movement actions that brings the agent to a cell\n      containing `target_kind`. The agent may step onto empty cells or the target\n      cell itself; all other occupied cells are treated as obstacles.\"\"\"\n      grid = cur_state.grid\n      H, W = grid.shape[:2]\n      start = cur_state.pos\n      visited = {start}\n      q = collections.deque([(start, [])])\n\n      while q:\n          (x, y), path = q.popleft()\n          if grid[x, y, target_kind] > 0:\n              return path\n          for dx, dy, act in move_dirs:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < H and 0 <= ny < W):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              # allow stepping onto empty cells or directly onto the target cell\n              if grid[nx, ny, :].sum() == 0 or grid[nx, ny, target_kind] > 0:\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [act]))\n      # unreachable in a well\u2011formed scenario\n      return []\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitives.\n  # ------------------------------------------------------------------\n  for prim_kind, cnt in required.items():\n      for _ in range(cnt):\n          path = find_path(state, prim_kind)\n          for a in path:\n              _, state = state.step(a)\n              actions.append(a)\n          # pick up the primitive now under the agent\n          _, state = state.step(ACTION_USE)\n          actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # 2) Move to the workshop (if any) and craft the goal item.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get('_at')\n  if workshop_kind is not None:\n      path = find_path(state, workshop_kind)\n      for a in path:\n          _, state = state.step(a)\n          actions.append(a)\n      # use the workshop to craft the item\n      _, state = state.step(ACTION_USE)\n      actions.append(ACTION_USE)\n\n  return actions", "env_interactions": 0, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T17:12:20.287838", "function_name": "make_arrow", "function_body": "  # Reset environment and obtain core objects\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n\n  # Goal index and primitive requirements\n  goal_idx = env.task.goal\n  required = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # Action identifiers (handles possible custom ordering)\n  act_map = env.action_specs()\n  ACTION_DOWN = act_map.get('DOWN')\n  ACTION_UP = act_map.get('UP')\n  ACTION_LEFT = act_map.get('LEFT')\n  ACTION_RIGHT = act_map.get('RIGHT')\n  ACTION_USE = act_map.get('USE')\n\n  # Direction vectors paired with their action IDs\n  move_dirs = [\n      (1, 0, ACTION_DOWN),\n      (-1, 0, ACTION_UP),\n      (0, -1, ACTION_LEFT),\n      (0, 1, ACTION_RIGHT),\n  ]\n\n  actions = []\n\n  def find_path(cur_state, target_kind):\n      \"\"\"\n      Bread\u2011first search that returns a list of movement actions leading\n      from the agent's current position to any cell containing `target_kind`.\n      The agent may step onto empty cells or the target cell itself; all\n      other occupied cells are treated as obstacles.\n      \"\"\"\n      import collections\n      grid = cur_state.grid\n      H, W = grid.shape[:2]\n      start = cur_state.pos\n      visited = {start}\n      q = collections.deque([(start, [])])\n\n      while q:\n          (x, y), path = q.popleft()\n          if grid[x, y, target_kind] > 0:\n              return path\n          for dx, dy, act in move_dirs:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < H and 0 <= ny < W):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              # Allow moving onto empty cells or directly onto the target cell\n              if grid[nx, ny, :].sum() == 0 or grid[nx, ny, target_kind] > 0:\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [act]))\n      # If unreachable (should not happen in a well\u2011formed scenario)\n      return []\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitives.\n  # ------------------------------------------------------------------\n  for prim_kind, cnt in required.items():\n      for _ in range(cnt):\n          # If we already have the primitive in inventory, skip collection\n          if state.inventory[prim_kind] > 0:\n              continue\n          path = find_path(state, prim_kind)\n          for a in path:\n              _, state = state.step(a)\n              actions.append(a)\n          # Pick up the primitive now under the agent\n          _, state = state.step(ACTION_USE)\n          actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # 2) Move to the workshop (if any) and craft the goal item.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get('_at')\n  if workshop_kind is not None:\n      path = find_path(state, workshop_kind)\n      for a in path:\n          _, state = state.step(a)\n          actions.append(a)\n      # Use the workshop to craft the item\n      _, state = state.step(ACTION_USE)\n      actions.append(ACTION_USE)\n\n  return actions", "env_interactions": 0, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T17:12:21.400111", "function_name": "make_arrow", "function_body": "  import collections\n  import numpy as np\n\n  # reset environment and fetch core objects\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n\n  # goal item index and its primitive requirements\n  goal_idx = env.task.goal\n  required = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # map action names to indices\n  act_map = env.action_specs()\n  ACTION_DOWN = act_map.get('DOWN')\n  ACTION_UP = act_map.get('UP')\n  ACTION_LEFT = act_map.get('LEFT')\n  ACTION_RIGHT = act_map.get('RIGHT')\n  ACTION_USE = act_map.get('USE')\n\n  # movement directions paired with their action ids\n  move_dirs = [\n      (1, 0, ACTION_DOWN),\n      (-1, 0, ACTION_UP),\n      (0, -1, ACTION_LEFT),\n      (0, 1, ACTION_RIGHT),\n  ]\n\n  actions = []\n\n  def find_path(cur_state, target_kind):\n      \"\"\"\n      Bread\u2011first search returning a list of movement actions that brings the\n      agent to a cell containing `target_kind`. The agent may step onto empty\n      cells or directly onto the target cell; other occupied cells are treated\n      as obstacles.\n      \"\"\"\n      grid = cur_state.grid\n      H, W = grid.shape[:2]\n      start = cur_state.pos\n      visited = {start}\n      q = collections.deque([(start, [])])\n\n      while q:\n          (x, y), path = q.popleft()\n          if grid[x, y, target_kind] > 0:\n              return path\n          for dx, dy, act in move_dirs:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < H and 0 <= ny < W):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              # allow stepping onto empty cells or the target cell itself\n              if grid[nx, ny, :].sum() == 0 or grid[nx, ny, target_kind] > 0:\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [act]))\n      # Should not happen in a valid scenario\n      return []\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitives.\n  # ------------------------------------------------------------------\n  for prim_kind, cnt in required.items():\n      for _ in range(cnt):\n          path = find_path(state, prim_kind)\n          for a in path:\n              _, state = state.step(a)\n              actions.append(a)\n          # pick up the primitive now under the agent\n          _, state = state.step(ACTION_USE)\n          actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # 2) Move to the workshop (if any) and craft the goal item.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get('_at')\n  if workshop_kind is not None:\n      path = find_path(state, workshop_kind)\n      for a in path:\n          _, state = state.step(a)\n          actions.append(a)\n      # use the workshop to craft the item\n      _, state = state.step(ACTION_USE)\n      actions.append(ACTION_USE)\n\n  return actions", "env_interactions": 0, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T17:12:51.160424", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Reset environment and fetch useful objects\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world\n  cookbook = world.cookbook\n\n  # ----------------------------------------------------------------------\n  # Identify goal (arrow) and its recipe details\n  # ----------------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n  if goal_idx is None:\n      return []                      # unknown goal, nothing to do\n\n  primitive_needs = cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  if \"_at\" in recipe:\n      workshop_idx = cookbook.index[recipe[\"_at\"]]\n\n  # ----------------------------------------------------------------------\n  # Helper utilities\n  # ----------------------------------------------------------------------\n  def bfs_path(start, goal, occupied):\n      \"\"\"Return list of positions from start (excluded) to goal (included)\n      moving only through cells where occupied is False. Goal may be occupied.\"\"\"\n      w, h = occupied.shape\n      visited = np.zeros((w, h), dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start] = True\n      while q:\n          x, y = q.popleft()\n          if (x, y) == goal:\n              break\n          for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):\n              if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:\n                  # Goal cell may be occupied; treat it as walkable.\n                  if (nx, ny) == goal or not occupied[nx, ny]:\n                      visited[nx, ny] = True\n                      prev[(nx, ny)] = (x, y)\n                      q.append((nx, ny))\n      if not visited[goal]:\n          return None\n      # reconstruct path (exclude start, include goal)\n      path = []\n      cur = goal\n      while cur != start:\n          path.append(cur)\n          cur = prev[cur]\n      path.reverse()\n      return path\n\n  def delta_to_action(dx, dy):\n      \"\"\"Map a movement delta to the env's action index.\"\"\"\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise ValueError(\"Invalid movement delta\")\n\n  # ----------------------------------------------------------------------\n  # Planning: collect primitives then craft at workshop (if any)\n  # ----------------------------------------------------------------------\n  actions = []\n  cur_pos = tuple(state.pos)          # current (x, y)\n  grid = state.grid.copy()            # mutable copy to track collected items\n\n  # --------------------------------------------------------------\n  # 1) Gather required primitive resources\n  # --------------------------------------------------------------\n  for kind_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          # Find all remaining cells containing this primitive\n          locations = np.argwhere(grid[:, :, kind_idx] > 0)\n          if locations.size == 0:\n              break  # no more of this primitive on the map\n          # Sort by Manhattan distance from current position\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n\n          occupied_mask = np.any(grid, axis=2)   # treat any entity as blocked\n          target = None\n          path = None\n          for idx in order:\n              cand = tuple(locations[idx])\n              p = bfs_path(cur_pos, cand, occupied_mask)\n              if p is not None:\n                  target = cand\n                  path = p\n                  break\n          if target is None:\n              # Could not reach any remaining instance; abort this primitive\n              continue\n\n          # Follow the path, emitting movement actions\n          for step in path:\n              dx = step[0] - cur_pos[0]\n              dy = step[1] - cur_pos[1]\n              actions.append(delta_to_action(dx, dy))\n              cur_pos = step\n          # Pick up the primitive\n          actions.append(4)          # USE\n          grid[target[0], target[1], kind_idx] = 0   # mark as collected\n\n  # --------------------------------------------------------------\n  # 2) Move to workshop (if required) and craft the arrow\n  # --------------------------------------------------------------\n  if workshop_idx is not None:\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          dists = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n          occupied_mask = np.any(state.grid, axis=2)   # original grid (workshop cells are occupied)\n          for idx in order:\n              cand = tuple(workshop_cells[idx])\n              p = bfs_path(cur_pos, cand, occupied_mask)\n              if p is not None:\n                  for step in p:\n                      dx = step[0] - cur_pos[0]\n                      dy = step[1] - cur_pos[1]\n                      actions.append(delta_to_action(dx, dy))\n                      cur_pos = step\n                  actions.append(4)   # USE to trigger crafting\n                  break\n  else:\n      # No specific workshop; simply use the current cell to craft\n      actions.append(4)\n\n  return actions", "env_interactions": 26, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T17:12:52.290277", "function_name": "make_arrow", "function_body": "  # Reset the environment and fetch the current state\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world\n  cookbook = world.cookbook\n\n  # Target item\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n  if goal_idx is None:\n      return []\n\n  # Primitive requirements (expanded recursively)\n  primitive_needs = cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  if \"_at\" in recipe:\n      workshop_idx = cookbook.index[recipe[\"_at\"]]\n\n  # ----------------------------------------------------------------------\n  # Helper utilities\n  # ----------------------------------------------------------------------\n  from collections import deque\n  import numpy as np\n\n  def bfs_path(start, goal, occupied):\n      \"\"\"Return a list of positions (excluding start, including goal) that\n      leads from start to goal moving only through cells where occupied==False.\n      The goal cell may be occupied (e.g., a resource or workshop).\"\"\"\n      w, h = occupied.shape\n      visited = np.zeros((w, h), dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start] = True\n      while q:\n          x, y = q.popleft()\n          if (x, y) == goal:\n              break\n          for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):\n              if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:\n                  if (nx, ny) == goal or not occupied[nx, ny]:\n                      visited[nx, ny] = True\n                      prev[(nx, ny)] = (x, y)\n                      q.append((nx, ny))\n      if not visited[goal]:\n          return None\n      # reconstruct path backwards\n      path = []\n      cur = goal\n      while cur != start:\n          path.append(cur)\n          cur = prev[cur]\n      path.reverse()\n      return path\n\n  def delta_to_action(dx, dy):\n      \"\"\"Convert a movement delta into an action index used by the env.\"\"\"\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise ValueError(\"Invalid movement delta\")\n\n  # ----------------------------------------------------------------------\n  # Main planning\n  # ----------------------------------------------------------------------\n  actions = []\n  cur_pos = tuple(state.pos)          # current (x, y) of the agent\n  grid = state.grid.copy()            # mutable copy to track collected items\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitive items\n  # ------------------------------------------------------------------\n  for kind_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          # Locate all remaining cells that contain this primitive\n          candidates = np.argwhere(grid[:, :, kind_idx] > 0)\n          if candidates.size == 0:\n              break  # no more of this primitive on the map\n          # Order candidates by Manhattan distance from current position\n          dists = np.abs(candidates[:, 0] - cur_pos[0]) + np.abs(candidates[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n\n          occupied_mask = np.any(grid, axis=2)   # treat any existing entity as blocked\n          target = None\n          path = None\n          for idx in order:\n              cand = tuple(candidates[idx])\n              p = bfs_path(cur_pos, cand, occupied_mask)\n              if p is not None:\n                  target = cand\n                  path = p\n                  break\n          if target is None:\n              continue   # could not reach any remaining instance\n\n          # Follow the path, emitting movement actions\n          for step in path:\n              dx = step[0] - cur_pos[0]\n              dy = step[1] - cur_pos[1]\n              actions.append(delta_to_action(dx, dy))\n              cur_pos = step\n          # Use action to pick up the primitive\n          actions.append(4)          # USE\n          # Remove the primitive from our mutable copy\n          grid[target[0], target[1], kind_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 2) Move to the required workshop (if any) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          dists = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n          occupied_mask = np.any(state.grid, axis=2)   # original grid (workshops are occupied)\n          for idx in order:\n              target = tuple(workshop_cells[idx])\n              p = bfs_path(cur_pos, target, occupied_mask)\n              if p is not None:\n                  for step in p:\n                      dx = step[0] - cur_pos[0]\n                      dy = step[1] - cur_pos[1]\n                      actions.append(delta_to_action(dx, dy))\n                      cur_pos = step\n                  actions.append(4)   # USE to trigger crafting\n                  break\n\n  return actions", "env_interactions": 26, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T17:13:23.877779", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action mapping: DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n  _delta_to_action = {\n      (0, 1): 0,   # DOWN\n      (0, -1): 1,  # UP\n      (-1, 0): 2,  # LEFT\n      (1, 0): 3,   # RIGHT\n  }\n\n  def _is_free(grid, x, y):\n      \"\"\"A cell is free if it contains no entities.\"\"\"\n      return grid[x, y, :].sum() == 0\n\n  def _neighbors(pos, width, height):\n      x, y = pos\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < width and 0 <= ny < height:\n              yield (nx, ny), (dx, dy)\n\n  def _bfs_path(grid, start, goal_cond):\n      \"\"\"\n      Bread\u2011first search returning a list of actions that moves the agent\n      from ``start`` to any cell satisfying ``goal_cond``.\n      \"\"\"\n      width, height = grid.shape[0], grid.shape[1]\n      q = deque([start])\n      came_from = {start: None}\n      move_from = {}\n\n      while q:\n          cur = q.popleft()\n          if goal_cond(cur):\n              # reconstruct path\n              actions = []\n              while came_from[cur] is not None:\n                  dx, dy = move_from[cur]\n                  actions.append(_delta_to_action[(dx, dy)])\n                  cur = came_from[cur]\n              actions.reverse()\n              return actions\n\n          for nxt, delta in _neighbors(cur, width, height):\n              if nxt not in came_from and _is_free(grid, *nxt):\n                  came_from[nxt] = cur\n                  move_from[nxt] = delta\n                  q.append(nxt)\n\n      # No path found\n      return []\n\n  # ------------------------------------------------------------------\n  # Begin planning\n  # ------------------------------------------------------------------\n  state = env._current_state          # type: CraftState\n  world = env.world                   # type: CraftWorld\n  goal_idx = env.task.goal            # integer index of the desired item\n\n  # Primitive requirements for the goal\n  needed = world.cookbook.primitives_for(goal_idx).copy()  # {prim_idx: count}\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')   # may be None\n  workshop_idx = None\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n\n  # Working copies that we update as we simulate actions\n  grid = state.grid.copy()\n  inventory = state.inventory.copy()\n  cur_pos = tuple(state.pos)\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, required_cnt in needed.items():\n      while inventory[prim_idx] < required_cnt:\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # No more primitives left \u2013 abort\n              return actions\n\n          # Choose the closest primitive (Manhattan distance)\n          dists = np.abs(prim_cells[:, 0] - cur_pos[0]) + np.abs(prim_cells[:, 1] - cur_pos[1])\n          target = tuple(prim_cells[dists.argmin()])\n\n          # Move to the primitive\n          move_actions = _bfs_path(grid, cur_pos, lambda p, t=target: p == t)\n          actions.extend(move_actions)\n          cur_pos = target\n\n          # Pick it up\n          actions.append(4)   # USE\n          grid[cur_pos[0], cur_pos[1], prim_idx] = 0\n          inventory[prim_idx] += 1\n\n  # ------------------------------------------------------------------\n  # 2) Go to the workshop (if any) and craft the goal\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_cells.size == 0:\n          return actions\n\n      width, height = grid.shape[0], grid.shape[1]\n      best_path = None\n      best_target = None\n\n      for wx, wy in ws_cells:\n          # Consider the workshop cell itself and its 4 orthogonal neighbours\n          candidates = [(wx, wy)] + [(wx + dx, wy + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n          for cx, cy in candidates:\n              if 0 <= cx < width and 0 <= cy < height and _is_free(grid, cx, cy):\n                  path = _bfs_path(grid, cur_pos, lambda p, t=(cx, cy): p == t)\n                  if best_path is None or len(path) < len(best_path):\n                      best_path = path\n                      best_target = (cx, cy)\n\n      if best_path is not None:\n          actions.extend(best_path)\n          cur_pos = best_target\n          actions.append(4)   # USE to craft\n\n  # Return the assembled action list\n  return actions", "env_interactions": 0, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T17:13:25.003117", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Map movement deltas to action indices (DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4)\n  _delta_to_action = {\n      (0, 1): 0,   # DOWN\n      (0, -1): 1,  # UP\n      (-1, 0): 2,  # LEFT\n      (1, 0): 3,   # RIGHT\n  }\n\n  def _is_free(grid, x, y):\n      \"\"\"A cell is free if it contains no entities.\"\"\"\n      return grid[x, y, :].sum() == 0\n\n  def _neighbors(pos, width, height):\n      \"\"\"Yield orthogonal neighbour positions and their deltas.\"\"\"\n      x, y = pos\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < width and 0 <= ny < height:\n              yield (nx, ny), (dx, dy)\n\n  def _bfs_path(grid, start, goal_cond):\n      \"\"\"\n      Bread\u2011first search returning a list of actions that moves the agent\n      from ``start`` to any cell satisfying ``goal_cond``.\n      \"\"\"\n      width, height = grid.shape[0], grid.shape[1]\n      q = deque([start])\n      came_from = {start: None}\n      move_from = {start: None}\n      while q:\n          cur = q.popleft()\n          if goal_cond(cur):\n              # Reconstruct action list.\n              actions = []\n              while came_from[cur] is not None:\n                  dx, dy = move_from[cur]\n                  actions.append(_delta_to_action[(dx, dy)])\n                  cur = came_from[cur]\n              actions.reverse()\n              return actions\n          for nxt, delta in _neighbors(cur, width, height):\n              if nxt not in came_from and _is_free(grid, *nxt):\n                  came_from[nxt] = cur\n                  move_from[nxt] = delta\n                  q.append(nxt)\n      # No path found.\n      return []\n\n  # ------------------------------------------------------------------\n  # Access current environment state.\n  # ------------------------------------------------------------------\n  state = env._current_state          # CraftState\n  world = env.world                   # CraftWorld\n  goal_idx = env.task.goal\n\n  # Primitive requirements for the goal.\n  needed_prims = world.cookbook.primitives_for(goal_idx).copy()\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = None\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n\n  # Local mutable copies for planning.\n  grid = state.grid.copy()\n  inventory = state.inventory.copy()\n  cur_pos = tuple(state.pos)\n\n  plan = []\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitives.\n  # ------------------------------------------------------------------\n  for prim_idx, req_cnt in needed_prims.items():\n      while inventory[prim_idx] < req_cnt:\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # No more of this primitive on the map \u2013 abort planning.\n              return plan\n          # Choose the closest primitive (Manhattan distance).\n          dists = np.abs(prim_cells[:, 0] - cur_pos[0]) + np.abs(prim_cells[:, 1] - cur_pos[1])\n          target = tuple(prim_cells[dists.argmin()])\n\n          # Move to the chosen primitive.\n          moves = _bfs_path(grid, cur_pos, lambda p, t=target: p == t)\n          plan.extend(moves)\n          cur_pos = target\n\n          # Use (pick up) the primitive.\n          plan.append(4)   # USE\n          grid[cur_pos[0], cur_pos[1], prim_idx] = 0\n          inventory[prim_idx] += 1\n\n  # ------------------------------------------------------------------\n  # 2) Go to the workshop (if required) and craft the goal.\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_cells.size == 0:\n          return plan\n\n      width, height = grid.shape[0], grid.shape[1]\n      best_path = None\n      best_target = None\n\n      for wx, wy in ws_cells:\n          # Consider the workshop cell itself and its orthogonal neighbours.\n          candidates = [(wx, wy),\n                        (wx - 1, wy), (wx + 1, wy),\n                        (wx, wy - 1), (wx, wy + 1)]\n          for cx, cy in candidates:\n              if 0 <= cx < width and 0 <= cy < height and _is_free(grid, cx, cy):\n                  path = _bfs_path(grid, cur_pos,\n                                   lambda p, t=(cx, cy): p == t)\n                  if best_path is None or len(path) < len(best_path):\n                      best_path = path\n                      best_target = (cx, cy)\n\n      if best_path is None:\n          return plan\n\n      plan.extend(best_path)\n      cur_pos = best_target\n      plan.append(4)   # USE to craft at the workshop\n\n  return plan", "env_interactions": 0, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T17:14:01.139248", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.scenario.world\n  cookbook = world.cookbook\n  index = cookbook.index\n\n  # Action identifiers (match CraftLab.action_specs)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow) and its primitive requirements.\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  if goal_name not in index.contents:\n      return []                       # arrow not defined in this world\n  goal_idx = index[goal_name]         # integer id of the arrow item\n  primitive_needs = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n  actions = []                         # will accumulate the action sequence\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of move actions from start to target.\n  # The target cell may be occupied (e.g., a workshop or a primitive), but\n  # all other cells must be empty.\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  def _bfs_path(start, target):\n      \"\"\"Return a list of move actions (DOWN/UP/LEFT/RIGHT) to reach target.\"\"\"\n      if start == target:\n          return []\n      h, w = state.grid.shape[:2]\n      queue = deque([start])\n      visited = {start}\n      parent = {}\n      moves = [(DOWN, (1, 0)),\n               (UP, (-1, 0)),\n               (LEFT, (0, -1)),\n               (RIGHT, (0, 1))]\n      while queue:\n          cur = queue.popleft()\n          if cur == target:\n              break\n          for act, (dr, dc) in moves:\n              nr, nc = cur[0] + dr, cur[1] + dc\n              if not (0 <= nr < h and 0 <= nc < w):\n                  continue\n              nxt = (nr, nc)\n              # Disallow stepping on any occupied cell except the target.\n              if nxt != target and state.grid[nr, nc, :].sum() != 0:\n                  continue\n              if nxt in visited:\n                  continue\n              visited.add(nxt)\n              parent[nxt] = (cur, act)\n              queue.append(nxt)\n\n      if target not in parent and start != target:\n          return []          # no path found\n      # Reconstruct path backwards.\n      path = []\n      cur = target\n      while cur != start:\n          prev, act = parent[cur]\n          path.append(act)\n          cur = prev\n      path.reverse()\n      return path\n\n  # ------------------------------------------------------------------\n  # 1. Collect each required primitive the needed number of times.\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          # Locate any cell that currently holds this primitive.\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # Primitive not present \u2013 abort early.\n              return actions\n          tr, tc = prim_cells[0]\n\n          # Move to the primitive's cell (BFS respects obstacles).\n          move_seq = _bfs_path(state.pos, (tr, tc))\n          actions.extend(move_seq)\n          state.pos = (tr, tc)\n\n          # Pick it up.\n          actions.append(USE)\n\n          # Update our internal copy of the state.\n          state.inventory[prim_idx] += 1\n          state.grid[tr, tc, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 2. Go to the workshop for the arrow and craft it.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      return actions                     # workshop info missing\n\n  workshop_idx = index[workshop_name]\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      return actions                     # no workshop on the map\n\n  wr, wc = workshop_cells[0]\n\n  # Move to the workshop cell.\n  move_seq = _bfs_path(state.pos, (wr, wc))\n  actions.extend(move_seq)\n  state.pos = (wr, wc)\n\n  # Craft the arrow.\n  actions.append(USE)\n\n  return actions", "env_interactions": 28, "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T17:14:02.271105", "function_name": "make_arrow", "function_body": "  # Reset environment and grab useful references.\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.scenario.world          # CraftWorld\n  cookbook = world.cookbook           # Cookbook\n  index = cookbook.index               # name \u2194 integer id mapping\n\n  # Action identifiers (match CraftLab.action_specs).\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow) and the primitives required to craft it.\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  if goal_name not in index.contents:\n      return []                       # no arrow defined in this world\n  goal_idx = index[goal_name]         # integer id of the arrow item\n  primitive_needs = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n  actions = []                         # will accumulate the action sequence\n\n  # ------------------------------------------------------------------\n  # Helper utilities.\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  # (action, (dr, dc))\n  moves = [(DOWN, (1, 0)),\n           (UP, (-1, 0)),\n           (LEFT, (0, -1)),\n           (RIGHT, (0, 1))]\n\n  def _bfs_path(start, target):\n      \"\"\"Return a list of move actions (DOWN/UP/LEFT/RIGHT) from start \u2192 target.\n      The target cell may be occupied; all other cells must be empty.\"\"\"\n      if start == target:\n          return []\n      h, w = state.grid.shape[:2]\n      queue = deque([start])\n      visited = {start}\n      parent = {}\n      while queue:\n          cur = queue.popleft()\n          if cur == target:\n              break\n          for act, (dr, dc) in moves:\n              nr, nc = cur[0] + dr, cur[1] + dc\n              if not (0 <= nr < h and 0 <= nc < w):\n                  continue\n              nxt = (nr, nc)\n              # Disallow stepping on occupied cells unless it's the target.\n              if nxt != target and state.grid[nr, nc, :].sum() != 0:\n                  continue\n              if nxt in visited:\n                  continue\n              visited.add(nxt)\n              parent[nxt] = (cur, act)\n              queue.append(nxt)\n\n      if target not in parent and start != target:\n          return []  # no path found\n\n      # Reconstruct path.\n      path = []\n      cur = target\n      while cur != start:\n          prev, act = parent[cur]\n          path.append(act)\n          cur = prev\n      path.reverse()\n      return path\n\n  def _nearest_cell(cells, start):\n      \"\"\"Pick the cell with the smallest Manhattan distance to *start*.\"\"\"\n      best = None\n      best_dist = None\n      for r, c in cells:\n          d = abs(r - start[0]) + abs(c - start[1])\n          if best is None or d < best_dist:\n              best = (r, c)\n              best_dist = d\n      return best\n\n  # ------------------------------------------------------------------\n  # 1. Collect each required primitive the needed number of times.\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          # Find any remaining cell that holds this primitive.\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # Primitive missing \u2013 abort early.\n              return actions\n          target = _nearest_cell(prim_cells, state.pos)\n\n          # Move to the primitive.\n          move_seq = _bfs_path(state.pos, target)\n          actions.extend(move_seq)\n          state.pos = target\n\n          # Pick it up.\n          actions.append(USE)\n\n          # Update our simulated copy of the state.\n          tr, tc = target\n          state.inventory[prim_idx] += 1\n          state.grid[tr, tc, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 2. Move to the workshop for the arrow and craft it.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      return actions                     # workshop info missing\n\n  workshop_idx = index[workshop_name]\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      return actions                     # no workshop on the map\n\n  wr, wc = workshop_cells[0]            # pick the first workshop cell\n\n  # Move to the workshop.\n  move_seq = _bfs_path(state.pos, (wr, wc))\n  actions.extend(move_seq)\n  state.pos = (wr, wc)\n\n  # Craft the arrow.\n  actions.append(USE)\n\n  return actions", "env_interactions": 24, "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T17:14:22.876006", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world\n  cookbook = world.cookbook\n\n  # ----------------------------------------------------------------------\n  # Identify goal and its recipe\n  # ----------------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n  if goal_idx is None:\n      return []  # unknown goal\n\n  # Primitive ingredients needed (may be empty)\n  primitive_needs = cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  if \"_at\" in recipe:\n      workshop_idx = cookbook.index[recipe[\"_at\"]]\n\n  # ----------------------------------------------------------------------\n  # Helper utilities\n  # ----------------------------------------------------------------------\n  from collections import deque\n  import numpy as np\n\n  def bfs_path(start, goal, occupied):\n      \"\"\"Return a list of positions (excluding start, including goal) that\n      leads from start to goal moving only through cells where occupied==False.\n      The goal cell may be occupied (resource or workshop).\"\"\"\n      w, h = occupied.shape\n      visited = np.zeros((w, h), dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start] = True\n      while q:\n          x, y = q.popleft()\n          if (x, y) == goal:\n              break\n          for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):\n              if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:\n                  if (nx, ny) == goal or not occupied[nx, ny]:\n                      visited[nx, ny] = True\n                      prev[(nx, ny)] = (x, y)\n                      q.append((nx, ny))\n      if not visited[goal]:\n          return None\n      # reconstruct path backwards\n      path = []\n      cur = goal\n      while cur != start:\n          path.append(cur)\n          cur = prev[cur]\n      path.reverse()\n      return path\n\n  def delta_to_action(dx, dy):\n      \"\"\"Convert a movement delta into the environment's action index.\"\"\"\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise ValueError(\"Invalid movement delta\")\n\n  # ----------------------------------------------------------------------\n  # Planning\n  # ----------------------------------------------------------------------\n  actions = []\n  cur_pos = tuple(state.pos)          # current (x, y) of the agent\n  grid = state.grid.copy()            # mutable copy to track collected items\n\n  # ------------------------------------------------------------------\n  # 1) Collect required primitives\n  # ------------------------------------------------------------------\n  for kind_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          # locate remaining instances of this primitive\n          candidates = np.argwhere(grid[:, :, kind_idx] > 0)\n          if candidates.size == 0:\n              break  # none left on the map\n          # order by Manhattan distance from current position\n          dists = np.abs(candidates[:, 0] - cur_pos[0]) + np.abs(candidates[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n\n          occupied_mask = np.any(grid, axis=2)   # treat any entity as blocked\n          target = None\n          path = None\n          for idx in order:\n              cand = tuple(candidates[idx])\n              path = bfs_path(cur_pos, cand, occupied_mask)\n              if path is not None:\n                  target = cand\n                  break\n          if target is None:\n              continue   # could not reach any remaining instance\n\n          # follow the path\n          for step in path:\n              dx = step[0] - cur_pos[0]\n              dy = step[1] - cur_pos[1]\n              actions.append(delta_to_action(dx, dy))\n              cur_pos = step\n          # pick up the primitive\n          actions.append(4)          # USE\n          grid[target[0], target[1], kind_idx] = 0   # remove from mutable copy\n\n  # ------------------------------------------------------------------\n  # 2) Move to workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          dists = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n          occupied_mask = np.any(state.grid, axis=2)   # workshops are occupied cells\n          for idx in order:\n              target = tuple(workshop_cells[idx])\n              path = bfs_path(cur_pos, target, occupied_mask)\n              if path is not None:\n                  for step in path:\n                      dx = step[0] - cur_pos[0]\n                      dy = step[1] - cur_pos[1]\n                      actions.append(delta_to_action(dx, dy))\n                      cur_pos = step\n                  actions.append(4)   # USE to trigger crafting\n                  break\n  else:\n      # no specific workshop, craft at current location\n      actions.append(4)   # USE\n\n  return actions", "env_interactions": 26, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T17:14:24.151528", "function_name": "make_arrow", "function_body": "  # Reset environment and get current state and world information\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world\n  cookbook = world.cookbook\n\n  # --------------------------------------------------------------\n  # Identify the goal (\"arrow\") and retrieve its recipe information\n  # --------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n  if goal_idx is None:\n      return []                       # unknown goal, nothing to do\n\n  # Primitive ingredients required (may be empty)\n  primitive_needs = cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  if \"_at\" in recipe:\n      workshop_idx = cookbook.index[recipe[\"_at\"]]\n\n  # --------------------------------------------------------------\n  # Helper utilities\n  # --------------------------------------------------------------\n  from collections import deque\n  import numpy as np\n\n  def bfs_path(start, goal, occupied):\n      \"\"\"Return a list of positions (excluding start, including goal) that\n      leads from start to goal moving only through cells where occupied==False.\n      The goal cell may be occupied (e.g., a resource or workshop).\"\"\"\n      w, h = occupied.shape\n      visited = np.zeros((w, h), dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start] = True\n      while q:\n          x, y = q.popleft()\n          if (x, y) == goal:\n              break\n          for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):\n              if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:\n                  # Allow stepping onto the goal even if occupied\n                  if (nx, ny) == goal or not occupied[nx, ny]:\n                      visited[nx, ny] = True\n                      prev[(nx, ny)] = (x, y)\n                      q.append((nx, ny))\n      if not visited[goal]:\n          return None\n      # reconstruct path backwards\n      path = []\n      cur = goal\n      while cur != start:\n          path.append(cur)\n          cur = prev[cur]\n      path.reverse()\n      return path\n\n  def delta_to_action(dx, dy):\n      \"\"\"Convert a movement delta into an action index used by the env.\"\"\"\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise ValueError(\"Invalid movement delta\")\n\n  # --------------------------------------------------------------\n  # Planning: collect primitives, move to workshop, craft\n  # --------------------------------------------------------------\n  actions = []\n  cur_pos = tuple(state.pos)          # current (x, y) of the agent\n  grid = state.grid.copy()            # mutable copy to track collected items\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitive items\n  # ------------------------------------------------------------------\n  for kind_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          # Find all remaining cells containing this primitive\n          candidates = np.argwhere(grid[:, :, kind_idx] > 0)\n          if candidates.size == 0:\n              break  # no more of this primitive on the map\n          # Order candidates by Manhattan distance from current position\n          dists = np.abs(candidates[:, 0] - cur_pos[0]) + np.abs(candidates[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n\n          occupied_mask = np.any(grid, axis=2)   # treat any entity as blocked\n          target = None\n          path = None\n          for idx in order:\n              cand = tuple(candidates[idx])\n              path = bfs_path(cur_pos, cand, occupied_mask)\n              if path is not None:\n                  target = cand\n                  break\n          if target is None:\n              continue   # could not reach any remaining instance\n\n          # Follow the path, emitting movement actions\n          for step in path:\n              dx = step[0] - cur_pos[0]\n              dy = step[1] - cur_pos[1]\n              actions.append(delta_to_action(dx, dy))\n              cur_pos = step\n          # Use action to pick up the primitive\n          actions.append(4)          # USE\n          # Remove the primitive from our mutable copy\n          grid[target[0], target[1], kind_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 2) Move to the required workshop (if any) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          dists = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n          occupied_mask = np.any(state.grid, axis=2)   # workshops are occupied but reachable\n          for idx in order:\n              target = tuple(workshop_cells[idx])\n              path = bfs_path(cur_pos, target, occupied_mask)\n              if path is not None:\n                  for step in path:\n                      dx = step[0] - cur_pos[0]\n                      dy = step[1] - cur_pos[1]\n                      actions.append(delta_to_action(dx, dy))\n                      cur_pos = step\n                  actions.append(4)   # USE to trigger crafting\n                  break\n  else:\n      # No specific workshop required; craft at current location\n      actions.append(4)   # USE to trigger crafting\n\n  return actions", "env_interactions": 26, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T17:14:52.898175", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ----------------------------------------------------------------------\n  # Helpers\n  # ----------------------------------------------------------------------\n  # Action ordering matches CraftLab.action_specs\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # 0:DOWN, 1:UP, 2:LEFT, 3:RIGHT\n  USE = 4\n\n  def bfs_adjacent(start, target, blocked):\n      \"\"\"Return a list of movement actions that brings the agent from *start*\n      to any empty cell that is 4\u2011connected to *target*.\n      If unreachable, return empty list.\"\"\"\n      h, w = blocked.shape\n      tx, ty = target\n      goal_cells = []\n      for a, (dx, dy) in enumerate(DIRS):\n          gx, gy = tx + dx, ty + dy\n          if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:\n              goal_cells.append((gx, gy))\n      if not goal_cells:\n          return []\n      q = deque([(start, [])])\n      visited = {start}\n      while q:\n          (cx, cy), path = q.popleft()\n          if (cx, cy) in goal_cells:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []\n\n  # ----------------------------------------------------------------------\n  # Reset / obtain current state\n  # ----------------------------------------------------------------------\n  try:\n      env.reset()\n  except Exception:\n      pass\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []\n\n  world = env.world\n  idx = world.cookbook.index\n\n  # ----------------------------------------------------------------------\n  # Identify arrow goal and its recipe\n  # ----------------------------------------------------------------------\n  try:\n      goal_idx = idx[\"arrow\"]\n  except Exception:\n      return []                     # no arrow defined\n\n  # primitives needed for one arrow\n  primitives = world.cookbook.primitives_for(goal_idx)\n\n  # workshop required for arrow (stored under \"_at\" or \"_key\")\n  workshop_name = None\n  for k, v in world.cookbook.recipes.get(goal_idx, {}).items():\n      if k in (\"_at\", \"_key\"):\n          workshop_name = v\n          break\n  if workshop_name is None:\n      return []\n  try:\n      workshop_idx = idx[workshop_name]\n  except Exception:\n      return []\n\n  # ----------------------------------------------------------------------\n  # Local mutable copies for planning\n  # ----------------------------------------------------------------------\n  pos = tuple(state.pos)                     # (x, y)\n  grid = state.grid.copy()                   # (W, H, n_kinds)\n  inventory = state.inventory.copy()\n  occupied = np.any(grid > 0, axis=2)        # bool matrix of blocked cells\n\n  plan = []\n\n  # ----------------------------------------------------------------------\n  # Helper to move adjacent to a cell and USE it\n  # ----------------------------------------------------------------------\n  def move_and_use(target, kind_idx):\n      \"\"\"Move adjacent to *target* (contains *kind_idx*) and issue USE.\n      Updates simulated pos, grid, occupied, inventory. Returns False on failure.\"\"\"\n      nonlocal pos, plan, grid, occupied, inventory\n      path = bfs_adjacent(pos, target, occupied)\n      if not path and pos != target:\n          return False\n      # execute movement actions in simulation\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n      plan.extend(path)\n\n      # perform USE\n      plan.append(USE)\n\n      tx, ty = target\n      if grid[tx, ty, kind_idx] > 0:\n          # pick up primitive\n          grid[tx, ty, kind_idx] = 0\n          occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)\n          inventory[kind_idx] += 1\n      return True\n\n  # ----------------------------------------------------------------------\n  # Collect required primitives\n  # ----------------------------------------------------------------------\n  for prim_idx, cnt in primitives.items():\n      for _ in range(cnt):\n          locations = np.argwhere(grid[:, :, prim_idx] > 0)\n          if locations.size == 0:\n              return plan\n          # choose nearest by Manhattan distance\n          dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n          target = tuple(locations[dists.argmin()])\n          if not move_and_use(target, prim_idx):\n              return plan\n\n  # ----------------------------------------------------------------------\n  # Go to workshop and craft the arrow\n  # ----------------------------------------------------------------------\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      # fall back to original grid (workshops are static)\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          return plan\n  dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])\n  workshop_target = tuple(workshop_cells[dists.argmin()])\n  move_and_use(workshop_target, workshop_idx)\n\n  return plan", "env_interactions": 23, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T17:14:54.024097", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ----------------------------------------------------------------------\n  # Constants and helper functions\n  # ----------------------------------------------------------------------\n  # Action order matches CraftLab.action_specs: DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # (dx, dy) for each move\n  USE = 4\n\n  def bfs_to_adjacent(start, target, blocked):\n      \"\"\"Return a list of movement actions that brings the agent from *start*\n      to any empty cell that is 4\u2011connected to *target*.\n      If no such path exists, returns an empty list.\"\"\"\n      h, w = blocked.shape\n      tx, ty = int(target[0]), int(target[1])\n      goal_cells = []\n      for a, (dx, dy) in enumerate(DIRS):\n          gx, gy = tx + dx, ty + dy\n          if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:\n              goal_cells.append((gx, gy))\n      if not goal_cells:\n          return []          # target completely surrounded\n\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (cx, cy), path = q.popleft()\n          if (cx, cy) in goal_cells:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []              # no reachable adjacent cell\n\n  # ----------------------------------------------------------------------\n  # Initialise / reset the environment\n  # ----------------------------------------------------------------------\n  try:\n      env.reset()\n  except Exception:\n      pass\n\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []                     # cannot obtain a state, give up\n\n  world = env.world\n  idx = world.cookbook.index\n\n  # ----------------------------------------------------------------------\n  # Identify the goal (arrow) and its recipe\n  # ----------------------------------------------------------------------\n  try:\n      goal_idx = idx[\"arrow\"]\n  except Exception:\n      return []                     # arrow not defined in this world\n\n  # Primitive requirements for one arrow\n  primitives_needed = world.cookbook.primitives_for(goal_idx)\n\n  # Workshop name (stored under the special key \"_at\" or \"_key\" in the recipe)\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = None\n  for k, v in recipe.items():\n      if k == \"_at\" or k == \"_key\":\n          workshop_name = v\n          break\n  if workshop_name is None:\n      return []                     # cannot locate a workshop for arrow\n\n  try:\n      workshop_idx = idx[workshop_name]\n  except Exception:\n      return []                     # workshop name not in index\n\n  # ----------------------------------------------------------------------\n  # Local mutable copies of position, grid and inventory for planning\n  # ----------------------------------------------------------------------\n  pos = tuple(state.pos)                       # (x, y)\n  grid = state.grid.copy()                     # (W, H, n_kinds)\n  inventory = state.inventory.copy()\n  occupied = np.any(grid > 0, axis=2)          # bool matrix of occupied cells\n\n  # ----------------------------------------------------------------------\n  # Build the action plan\n  # ----------------------------------------------------------------------\n  plan = []\n\n  def move_and_use(target_coord, kind_idx):\n      \"\"\"Move next to *target_coord* (which contains an entity of *kind_idx*)\n      and issue a USE action. Updates *pos*, *grid*, *occupied* and *inventory*.\"\"\"\n      nonlocal pos, plan, grid, occupied, inventory\n      path = bfs_to_adjacent(pos, target_coord, occupied)\n      if not path and pos != target_coord:\n          # unreachable\n          return False\n      # Apply movement actions to our simulated state\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n      plan.extend(path)\n      # Perform USE\n      plan.append(USE)\n      tx, ty = int(target_coord[0]), int(target_coord[1])\n      if grid[tx, ty, kind_idx] > 0:\n          # Pick up one unit of the requested kind\n          grid[tx, ty, kind_idx] = 0\n          occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)\n          inventory[kind_idx] += 1\n      return True\n\n  # ----------------------------------------------------------------------\n  # Collect all required primitives\n  # ----------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      for _ in range(needed_cnt):\n          candidates = np.argwhere(grid[:, :, prim_idx] > 0)\n          if candidates.shape[0] == 0:\n              # No more of this primitive on the map \u2013 abort planning\n              return plan\n          # Choose the closest instance (Manhattan distance)\n          dists = np.abs(candidates[:, 0] - pos[0]) + np.abs(candidates[:, 1] - pos[1])\n          target = candidates[dists.argmin()]\n          if not move_and_use(target, prim_idx):\n              return plan\n\n  # ----------------------------------------------------------------------\n  # Move to the workshop and craft the arrow\n  # ----------------------------------------------------------------------\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.shape[0] == 0:\n      # Fallback to original scenario grid (workshops are static)\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.shape[0] == 0:\n          return plan\n\n  dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])\n  workshop_target = workshop_cells[dists.argmin()]\n  move_and_use(workshop_target, workshop_idx)\n\n  # ----------------------------------------------------------------------\n  # Return the constructed action list\n  # ----------------------------------------------------------------------\n  return plan", "env_interactions": 23, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T17:15:16.809033", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ----------------------------------------------------------------------\n  # Helpers\n  # ----------------------------------------------------------------------\n  # Action ordering matches CraftLab.action_specs: DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # (dx, dy) for each move\n  USE = 4\n\n  def bfs_adjacent(start, target, blocked):\n      \"\"\"Return a list of movement actions that brings the agent from *start*\n      to any empty cell that is 4\u2011connected to *target*. If unreachable, return [].\n      \"\"\"\n      h, w = blocked.shape\n      tx, ty = target\n      goal_cells = []\n      for a, (dx, dy) in enumerate(DIRS):\n          gx, gy = tx + dx, ty + dy\n          if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:\n              goal_cells.append((gx, gy))\n      if not goal_cells:\n          return []\n      q = deque([(start, [])])\n      visited = {start}\n      while q:\n          (cx, cy), path = q.popleft()\n          if (cx, cy) in goal_cells:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []\n\n  # ----------------------------------------------------------------------\n  # Reset / obtain current state\n  # ----------------------------------------------------------------------\n  try:\n      env.reset()\n  except Exception:\n      pass\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []\n\n  world = env.world\n  idx = world.cookbook.index\n\n  # ----------------------------------------------------------------------\n  # Identify arrow goal and its recipe\n  # ----------------------------------------------------------------------\n  try:\n      goal_idx = idx[\"arrow\"]\n  except Exception:\n      return []                     # no arrow defined\n\n  # Primitive (or sub\u2011component) counts required for one arrow\n  needed = world.cookbook.primitives_for(goal_idx)\n\n  # Locate workshop required for crafting the arrow (stored under \"_at\" or \"_key\")\n  workshop_name = None\n  for k, v in world.cookbook.recipes.get(goal_idx, {}).items():\n      if k in (\"_at\", \"_key\"):\n          workshop_name = v\n          break\n  if workshop_name is None:\n      return []\n  try:\n      workshop_idx = idx[workshop_name]\n  except Exception:\n      return []\n\n  # ----------------------------------------------------------------------\n  # Local mutable copies for planning\n  # ----------------------------------------------------------------------\n  pos = tuple(state.pos)                     # (x, y)\n  grid = state.grid.copy()                   # (W, H, n_kinds)\n  inventory = state.inventory.copy()\n  occupied = np.any(grid > 0, axis=2)        # bool matrix of blocked cells\n\n  plan = []\n\n  # ----------------------------------------------------------------------\n  # Helper to move adjacent to a cell and USE it\n  # ----------------------------------------------------------------------\n  def move_and_use(target, kind_idx):\n      \"\"\"Move adjacent to *target* (contains *kind_idx*) and issue USE.\n      Updates simulated pos, grid, occupied, inventory. Returns False on failure.\"\"\"\n      nonlocal pos, plan, grid, occupied, inventory\n      path = bfs_adjacent(pos, target, occupied)\n      if not path and pos != target:\n          return False\n      # Execute movement actions in the simulated state\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n      plan.extend(path)\n\n      # Perform USE\n      plan.append(USE)\n\n      tx, ty = target\n      if grid[tx, ty, kind_idx] > 0:\n          # Pick up one unit of the requested kind\n          grid[tx, ty, kind_idx] = 0\n          occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)\n          inventory[kind_idx] += 1\n      return True\n\n  # ----------------------------------------------------------------------\n  # Collect all required items (primitives or already\u2011crafted components)\n  # ----------------------------------------------------------------------\n  for kind_idx, cnt in needed.items():\n      for _ in range(cnt):\n          # Find all cells that currently contain the needed kind\n          locations = np.argwhere(grid[:, :, kind_idx] > 0)\n          if locations.size == 0:\n              # No more of this kind on the map \u2013 abort planning\n              return plan\n          # Choose the nearest instance (Manhattan distance)\n          dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n          target = tuple(locations[dists.argmin()])\n          if not move_and_use(target, kind_idx):\n              return plan\n\n  # ----------------------------------------------------------------------\n  # Move to the workshop and craft the arrow\n  # ----------------------------------------------------------------------\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      # Fallback to original scenario grid (workshops are static)\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          return plan\n  dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])\n  workshop_target = tuple(workshop_cells[dists.argmin()])\n  move_and_use(workshop_target, workshop_idx)\n\n  # ----------------------------------------------------------------------\n  # Return the constructed action sequence\n  # ----------------------------------------------------------------------\n  return plan", "env_interactions": 23, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T17:15:17.937976", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ----------------------------------------------------------------------\n  # Action constants (match CraftLab.action_specs)\n  # ----------------------------------------------------------------------\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # 0:DOWN, 1:UP, 2:LEFT, 3:RIGHT\n  USE = 4\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS to any free cell adjacent to a target cell\n  # ----------------------------------------------------------------------\n  def bfs_adjacent(start, target, blocked):\n      \"\"\"Return list of actions moving from *start* to a free 4\u2011adjacent cell of *target*.\n      If none reachable, return empty list.\"\"\"\n      h, w = blocked.shape\n      tx, ty = target\n      # all possible adjacent cells that are inside the grid and not blocked\n      goal_cells = []\n      for a, (dx, dy) in enumerate(DIRS):\n          gx, gy = tx + dx, ty + dy\n          if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:\n              goal_cells.append((gx, gy))\n      if not goal_cells:\n          return []                     # target completely surrounded\n\n      q = deque([(start, [])])\n      visited = {start}\n      while q:\n          (cx, cy), path = q.popleft()\n          if (cx, cy) in goal_cells:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []                         # unreachable\n\n  # ----------------------------------------------------------------------\n  # Reset / fetch current state\n  # ----------------------------------------------------------------------\n  try:\n      env.reset()\n  except Exception:\n      pass\n\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []                         # cannot obtain state\n\n  world = env.world\n  idx = world.cookbook.index\n\n  # ----------------------------------------------------------------------\n  # Identify goal (arrow) and its recipe\n  # ----------------------------------------------------------------------\n  try:\n      goal_idx = idx[\"arrow\"]\n  except Exception:\n      return []                         # arrow not defined\n\n  # primitives needed for one arrow\n  primitives_needed = world.cookbook.primitives_for(goal_idx)\n\n  # workshop required for arrow (stored under \"_at\" or \"_key\")\n  workshop_name = None\n  for k, v in world.cookbook.recipes.get(goal_idx, {}).items():\n      if k in (\"_at\", \"_key\"):\n          workshop_name = v\n          break\n  if workshop_name is None:\n      return []                         # no workshop info\n\n  try:\n      workshop_idx = idx[workshop_name]\n  except Exception:\n      return []                         # workshop not indexed\n\n  # ----------------------------------------------------------------------\n  # Local mutable copies for planning\n  # ----------------------------------------------------------------------\n  pos = tuple(state.pos)                 # (x, y)\n  grid = state.grid.copy()               # (W, H, n_kinds)\n  inventory = state.inventory.copy()\n  occupied = np.any(grid > 0, axis=2)    # bool matrix of blocked cells\n\n  plan = []\n\n  # ----------------------------------------------------------------------\n  # Helper: move adjacent to a cell containing *kind_idx* and USE it\n  # ----------------------------------------------------------------------\n  def move_and_use(target, kind_idx):\n      \"\"\"Navigate adjacent to *target* and issue USE.\n      Updates simulated pos, grid, occupied, inventory.\n      Returns False if movement impossible.\"\"\"\n      nonlocal pos, plan, grid, occupied, inventory\n      path = bfs_adjacent(pos, target, occupied)\n      if not path and pos != target:\n          return False\n      # simulate movements\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n      plan.extend(path)\n\n      # USE action\n      plan.append(USE)\n\n      tx, ty = target\n      if grid[tx, ty, kind_idx] > 0:\n          # pick up one unit\n          grid[tx, ty, kind_idx] = 0\n          occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)\n          inventory[kind_idx] += 1\n      return True\n\n  # ----------------------------------------------------------------------\n  # Collect all required primitives\n  # ----------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      for _ in range(needed_cnt):\n          candidates = np.argwhere(grid[:, :, prim_idx] > 0)\n          if candidates.shape[0] == 0:\n              # no more of this primitive on the map \u2013 abort planning\n              return plan\n          # choose the closest by Manhattan distance\n          dists = np.abs(candidates[:, 0] - pos[0]) + np.abs(candidates[:, 1] - pos[1])\n          target = tuple(candidates[dists.argmin()])\n          if not move_and_use(target, prim_idx):\n              return plan\n\n  # ----------------------------------------------------------------------\n  # Move to the workshop and craft the arrow\n  # ----------------------------------------------------------------------\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.shape[0] == 0:\n      # fall back to static scenario grid (workshops never disappear)\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.shape[0] == 0:\n          return plan\n  dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])\n  workshop_target = tuple(workshop_cells[dists.argmin()])\n  move_and_use(workshop_target, workshop_idx)\n\n  # ----------------------------------------------------------------------\n  # Return the constructed action list\n  # ----------------------------------------------------------------------\n  return plan", "env_interactions": 23, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T17:15:40.283572", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n\n  # ------------------------------------------------------------------\n  # Identify the goal index for the item \"arrow\".\n  # ------------------------------------------------------------------\n  if hasattr(env, \"task\") and hasattr(env.task, \"goal\"):\n      goal_idx = env.task.goal\n  else:\n      goal_idx = env.world.cookbook.index.get(\"arrow\")\n      if goal_idx is None:\n          raise ValueError(\"Goal 'arrow' not found in cookbook\")\n\n  # ------------------------------------------------------------------\n  # Action constants.\n  # ------------------------------------------------------------------\n  act_spec = env.action_specs()\n  ACT_DOWN = act_spec[\"DOWN\"]\n  ACT_UP = act_spec[\"UP\"]\n  ACT_LEFT = act_spec[\"LEFT\"]\n  ACT_RIGHT = act_spec[\"RIGHT\"]\n  ACT_USE = act_spec[\"USE\"]\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper: BFS to obtain a list of actions from start to target,\n  # navigating only through empty cells.\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  def bfs_path(start, target):\n      h, w, _ = state.grid.shape\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (y, x), path = q.popleft()\n          if (y, x) == target:\n              return path\n          for dy, dx, act in ((1, 0, ACT_DOWN),\n                              (-1, 0, ACT_UP),\n                              (0, 1, ACT_RIGHT),\n                              (0, -1, ACT_LEFT)):\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < h and 0 <= nx < w and (ny, nx) not in visited:\n                  # allow stepping onto the target even if occupied\n                  if not state.grid[ny, nx, :].any() or (ny, nx) == target:\n                      visited.add((ny, nx))\n                      q.append(((ny, nx), path + [act]))\n      return []  # no path found\n\n  # ------------------------------------------------------------------\n  # Helper: move the agent to an absolute position using bfs_path.\n  # ------------------------------------------------------------------\n  def move_to(target):\n      nonlocal state, actions\n      while state.pos != target:\n          path = bfs_path(state.pos, target)\n          if not path:\n              break  # cannot reach target\n          for a in path:\n              actions.append(a)\n              env.step(a)\n              state = env._current_state\n              if state.pos == target:\n                  break\n\n  # ------------------------------------------------------------------\n  # Helper: locate the nearest cell containing a given kind index.\n  # ------------------------------------------------------------------\n  def find_nearest(kind_idx):\n      grid = state.grid\n      h, w, _ = grid.shape\n      py, px = state.pos\n      best = None\n      best_dist = None\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  d = abs(i - py) + abs(j - px)\n                  if best_dist is None or d < best_dist:\n                      best_dist = d\n                      best = (i, j)\n      return best\n\n  # ------------------------------------------------------------------\n  # Helper: pick a free cell (including diagonals) adjacent to a target.\n  # Returns the target itself if it is free.\n  # ------------------------------------------------------------------\n  def adjacent_free(cell):\n      y, x = cell\n      h, w, _ = state.grid.shape\n      # Prefer the cell itself if free\n      if not state.grid[y, x, :].any():\n          return (y, x)\n      for dy in (-1, 0, 1):\n          for dx in (-1, 0, 1):\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < h and 0 <= nx < w:\n                  if not state.grid[ny, nx, :].any():\n                      return (ny, nx)\n      return None\n\n  # ------------------------------------------------------------------\n  # Collect all required primitive resources for the arrow.\n  # ------------------------------------------------------------------\n  needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  for kind_idx, count in needed.items():\n      for _ in range(count):\n          src = find_nearest(kind_idx)\n          if src is None:\n              continue  # primitive not present; skip\n          adj = adjacent_free(src)\n          if adj is None:\n              continue  # no free adjacent cell; skip\n          move_to(adj)\n          actions.append(ACT_USE)\n          env.step(ACT_USE)\n          state = env._current_state\n\n  # ------------------------------------------------------------------\n  # If the recipe requires a specific workshop, go there and use.\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      ws_idx = env.world.cookbook.index[workshop_name]\n      ws_pos = find_nearest(ws_idx)\n      if ws_pos:\n          adj = adjacent_free(ws_pos)\n          if adj:\n              move_to(adj)\n              actions.append(ACT_USE)\n              env.step(ACT_USE)\n              state = env._current_state\n\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T17:15:41.419851", "function_name": "make_arrow", "function_body": "  # Reset environment and get initial state\n  env.reset()\n  state = env._current_state\n\n  # Identify the goal index for the arrow\n  if hasattr(env, \"task\") and hasattr(env.task, \"goal\"):\n      goal_idx = env.task.goal\n  else:\n      goal_idx = env.world.cookbook.index.get(\"arrow\")\n      if goal_idx is None:\n          raise ValueError(\"Arrow goal not found in cookbook\")\n\n  # Action constants\n  act_spec = env.action_specs()\n  ACT_DOWN = act_spec[\"DOWN\"]\n  ACT_UP = act_spec[\"UP\"]\n  ACT_LEFT = act_spec[\"LEFT\"]\n  ACT_RIGHT = act_spec[\"RIGHT\"]\n  ACT_USE = act_spec[\"USE\"]\n\n  # ------------------------------------------------------------------\n  # Helper: BFS to find a path of actions from start to target,\n  # avoiding any occupied cell (any non\u2011zero channel in the grid).\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  def bfs_path(start, target):\n      grid = state.grid\n      h, w, _ = grid.shape\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (y, x), path = q.popleft()\n          if (y, x) == target:\n              return path\n          for dy, dx, act in ((1, 0, ACT_DOWN),\n                              (-1, 0, ACT_UP),\n                              (0, 1, ACT_RIGHT),\n                              (0, -1, ACT_LEFT)):\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < h and 0 <= nx < w and (ny, nx) not in visited:\n                  # allow moving onto the target even if occupied (e.g., a workshop)\n                  if not grid[ny, nx, :].any() or (ny, nx) == target:\n                      visited.add((ny, nx))\n                      q.append(((ny, nx), path + [act]))\n      return []  # no path found\n\n  # ------------------------------------------------------------------\n  # Helper: move the agent to an absolute position using bfs_path.\n  # ------------------------------------------------------------------\n  actions = []\n\n  def move_to(target):\n      nonlocal state, actions\n      while state.pos != target:\n          path = bfs_path(state.pos, target)\n          if not path:\n              # cannot reach target; abort\n              break\n          for a in path:\n              actions.append(a)\n              _, _, _ = env.step(a)\n              state = env._current_state\n              if state.pos == target:\n                  break\n\n  # ------------------------------------------------------------------\n  # Helper: locate the nearest cell that contains a given kind index.\n  # ------------------------------------------------------------------\n  def find_nearest(kind_idx):\n      grid = state.grid\n      h, w, _ = grid.shape\n      py, px = state.pos\n      best = None\n      best_dist = None\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  d = abs(i - py) + abs(j - px)\n                  if best_dist is None or d < best_dist:\n                      best_dist = d\n                      best = (i, j)\n      return best\n\n  # ------------------------------------------------------------------\n  # Helper: find a free cell adjacent (including diagonals) to a given cell.\n  # Returns the cell itself if it is free.\n  # ------------------------------------------------------------------\n  def adjacent_free(cell):\n      y, x = cell\n      grid = state.grid\n      h, w, _ = grid.shape\n      # Prefer the cell itself if free\n      if not grid[y, x, :].any():\n          return (y, x)\n      for dy in (-1, 0, 1):\n          for dx in (-1, 0, 1):\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < h and 0 <= nx < w:\n                  if not grid[ny, nx, :].any():\n                      return (ny, nx)\n      # Fallback to current position (should not happen often)\n      return state.pos\n\n  # ------------------------------------------------------------------\n  # Collect all required primitive resources for the arrow.\n  # ------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  for kind_idx, count in primitives_needed.items():\n      for _ in range(count):\n          src = find_nearest(kind_idx)\n          if src is None:\n              continue  # primitive not present in the world\n          adj = adjacent_free(src)\n          move_to(adj)\n          actions.append(ACT_USE)\n          _, _, _ = env.step(ACT_USE)\n          state = env._current_state\n\n  # ------------------------------------------------------------------\n  # Go to the appropriate workshop (if any) and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      ws_idx = env.world.cookbook.index[workshop_name]\n      ws_pos = find_nearest(ws_idx)\n      if ws_pos:\n          adj = adjacent_free(ws_pos)\n          move_to(adj)\n          actions.append(ACT_USE)\n          _, _, _ = env.step(ACT_USE)\n          state = env._current_state\n\n  # Return the compiled action sequence\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": 0.0}}
