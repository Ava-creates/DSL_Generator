{"timestamp": "2025-10-27T19:22:58.166966", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def _move_actions(src, dst):\n      \"\"\"Return a list of movement actions (Manhattan) from src to dst.\"\"\"\n      actions = []\n      x, y = src\n      tx, ty = dst\n      dx = tx - x\n      dy = ty - y\n      if dx > 0:\n          actions += [DOWN] * dx\n      elif dx < 0:\n          actions += [UP] * (-dx)\n      if dy > 0:\n          actions += [RIGHT] * dy\n      elif dy < 0:\n          actions += [LEFT] * (-dy)\n      return actions\n\n  def _nearest_kind(pos, kind_idx, grid):\n      \"\"\"Find the coordinates of the nearest cell containing kind_idx.\"\"\"\n      locations = list(zip(*np.where(grid[:, :, kind_idx] > 0)))\n      if not locations:\n          return None\n      distances = [abs(px - pos[0]) + abs(py - pos[1]) for (px, py) in locations]\n      return locations[int(np.argmin(distances))]\n\n  # ------------------------------------------------------------------\n  # 1. Determine goal (arrow) and required primitives\n  # ------------------------------------------------------------------\n  world = env.world\n  arrow_idx = world.cookbook.index.index('arrow')\n  primitives_needed = world.cookbook.primitives_for(arrow_idx)\n\n  # ------------------------------------------------------------------\n  # 2. Collect required primitives\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = env._current_state.pos\n  grid = env._current_state.grid\n\n  for prim_idx, count in primitives_needed.items():\n      for _ in range(count):\n          target = _nearest_kind(cur_pos, prim_idx, grid)\n          if target is None:\n              # primitive missing; abort planning\n              return actions\n          actions += _move_actions(cur_pos, target)\n          cur_pos = target\n          actions.append(USE)\n          # simulate pickup locally to avoid revisiting same cell\n          grid = grid.copy()\n          grid[target[0], target[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 3. Move to workshop (if any) and craft the arrow\n  # ------------------------------------------------------------------\n  workshop_name = world.cookbook.recipes[arrow_idx].get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = _nearest_kind(cur_pos, workshop_idx, grid)\n      if workshop_pos is not None:\n          actions += _move_actions(cur_pos, workshop_pos)\n          cur_pos = workshop_pos\n          actions.append(USE)  # craft at workshop\n\n  return actions", "env_interactions": 22, "island_id": 2, "scores": {"3": 0.2}}
{"timestamp": "2025-10-27T19:22:59.290147", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper functions\n  # ------------------------------------------------------------------\n  def _move_actions(src, dst):\n      \"\"\"Return a list of movement actions to go from src to dst (Manhattan).\"\"\"\n      actions = []\n      x, y = src\n      tx, ty = dst\n      dx = tx - x\n      dy = ty - y\n      if dx > 0:\n          actions += [DOWN] * dx\n      elif dx < 0:\n          actions += [UP] * (-dx)\n      if dy > 0:\n          actions += [RIGHT] * dy\n      elif dy < 0:\n          actions += [LEFT] * (-dy)\n      return actions\n\n  def _nearest_kind(pos, kind_idx):\n      \"\"\"Find the nearest cell that contains the given kind (Manhattan distance).\"\"\"\n      grid = env._current_state.grid\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n      best = int(dists.argmin())\n      return tuple(locations[best].tolist())\n\n  # ------------------------------------------------------------------\n  # 1. Identify goal and its recipe\n  # ------------------------------------------------------------------\n  world = env.world\n  arrow_idx = world.cookbook.index.index('arrow')\n  primitives_needed = world.cookbook.primitives_for(arrow_idx)\n\n  # ------------------------------------------------------------------\n  # 2. Collect required primitives\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = env._current_state.pos\n\n  for prim_idx, count in primitives_needed.items():\n      for _ in range(count):\n          target = _nearest_kind(cur_pos, prim_idx)\n          if target is None:          # primitive not present \u2013 abort early\n              return actions\n          actions += _move_actions(cur_pos, target)\n          cur_pos = target\n          actions.append(USE)          # pick up the primitive\n\n  # ------------------------------------------------------------------\n  # 3. Move to workshop and craft the arrow\n  # ------------------------------------------------------------------\n  workshop_name = world.cookbook.recipes[arrow_idx].get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = _nearest_kind(cur_pos, workshop_idx)\n      if workshop_pos is not None:\n          actions += _move_actions(cur_pos, workshop_pos)\n          cur_pos = workshop_pos\n          actions.append(USE)          # craft at the workshop\n\n  return actions", "env_interactions": 22, "island_id": 2, "scores": {"3": 0.2}}
{"timestamp": "2025-10-27T19:23:33.266603", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action indices: 0 DOWN, 1 UP, 2 LEFT, 3 RIGHT, 4 USE\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n  USE = 4\n\n  # ------------------------------------------------------------------\n  # Reset / obtain the current state\n  # ------------------------------------------------------------------\n  try:\n      env.reset()\n  except Exception:\n      pass\n\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      # some environments return the observation dict on reset\n      try:\n          env.reset()\n          state = getattr(env, \"_current_state\", None)\n      except Exception:\n          pass\n  if state is None:\n      return []\n\n  world = env.world\n  idx = world.cookbook.index\n\n  # ------------------------------------------------------------------\n  # Identify goal (arrow) and its recipe\n  # ------------------------------------------------------------------\n  try:\n      goal_idx = idx[\"arrow\"]\n  except Exception:\n      return []\n\n  # Primitive requirements for a single arrow\n  primitives_needed = world.cookbook.primitives_for(goal_idx)\n\n  # Workshop required for the arrow (stored under \"_at\" or \"_key\")\n  recipe_dict = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = None\n  for k, v in recipe_dict.items():\n      if k == \"_at\" or k == \"_key\":\n          workshop_name = v\n          break\n  if workshop_name is None:\n      return []\n\n  try:\n      workshop_idx = idx[workshop_name]\n  except Exception:\n      return []\n\n  # ------------------------------------------------------------------\n  # Local mutable copies for planning\n  # ------------------------------------------------------------------\n  pos = tuple(state.pos)                     # (x, y)\n  grid = state.grid.copy()                   # (W, H, n_kinds)\n  inventory = state.inventory.copy()\n  occupied = np.any(grid > 0, axis=2)        # bool matrix of blocked cells\n\n  plan_actions = []\n\n  # ------------------------------------------------------------------\n  # Helper: BFS to any empty neighbour of a target cell\n  # ------------------------------------------------------------------\n  def bfs_to_adjacent(start, target, blocked):\n      \"\"\"Return list of movement actions that bring the agent from *start*\n      to a free cell adjacent (4\u2011connected) to *target*.\"\"\"\n      h, w = blocked.shape\n      tx, ty = target\n      goal_cells = []\n      for a, (dx, dy) in enumerate(DIRS):\n          gx, gy = tx + dx, ty + dy\n          if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:\n              goal_cells.append((gx, gy))\n      if not goal_cells:\n          return []  # target completely surrounded\n\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (cx, cy), path = q.popleft()\n          if (cx, cy) in goal_cells:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []  # unreachable\n\n  # ------------------------------------------------------------------\n  # Helper: move next to a target cell and issue USE\n  # ------------------------------------------------------------------\n  def move_and_use(target_coord, kind_idx):\n      \"\"\"Move adjacent to *target_coord* (which contains an entity of\n      *kind_idx*) and perform a USE action. Updates planning state.\"\"\"\n      nonlocal pos, plan_actions, grid, occupied, inventory\n\n      path = bfs_to_adjacent(pos, target_coord, occupied)\n      if not path and pos != target_coord:\n          return False  # cannot reach a neighbour\n\n      # apply movement actions to simulated position\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n      plan_actions.extend(path)\n\n      # perform USE\n      plan_actions.append(USE)\n\n      tx, ty = target_coord\n      if grid[tx, ty, kind_idx] > 0:\n          # pick up the primitive\n          grid[tx, ty, kind_idx] = 0\n          occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)\n          inventory[kind_idx] += 1\n      return True\n\n  # ------------------------------------------------------------------\n  # Collect required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      for _ in range(needed_cnt):\n          locations = np.argwhere(grid[:, :, prim_idx] > 0)\n          if locations.shape[0] == 0:\n              # no more of this primitive on the map\n              return plan_actions\n          # choose the closest one (Manhattan distance)\n          dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n          target = tuple(locations[dists.argmin()])\n          if not move_and_use(target, prim_idx):\n              return plan_actions\n\n  # ------------------------------------------------------------------\n  # Move to workshop and craft the arrow\n  # ------------------------------------------------------------------\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.shape[0] == 0:\n      # fallback to static locations from the original scenario\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.shape[0] == 0:\n          return plan_actions\n\n  dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])\n  workshop_target = tuple(workshop_cells[dists.argmin()])\n\n  move_and_use(workshop_target, workshop_idx)\n\n  # ------------------------------------------------------------------\n  # Return the planned action sequence\n  # ------------------------------------------------------------------\n  return plan_actions", "env_interactions": 23, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T19:23:34.402579", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ----------------------------------------------------------------------\n  # Action constants (match CraftLab.action_specs order)\n  # ----------------------------------------------------------------------\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # 0:DOWN, 1:UP, 2:LEFT, 3:RIGHT\n  USE = 4\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS to any empty cell adjacent to a target cell\n  # ----------------------------------------------------------------------\n  def bfs_to_adjacent(start, target, blocked):\n      \"\"\"Return a list of actions moving from *start* to a free neighbour of *target*.\n      If unreachable, returns an empty list.\"\"\"\n      h, w = blocked.shape\n      tx, ty = int(target[0]), int(target[1])\n      goal_cells = []\n      for a, (dx, dy) in enumerate(DIRS):\n          gx, gy = tx + dx, ty + dy\n          if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:\n              goal_cells.append((gx, gy))\n      if not goal_cells:\n          return []\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (cx, cy), path = q.popleft()\n          if (cx, cy) in goal_cells:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []\n\n  # ----------------------------------------------------------------------\n  # Reset / obtain current state\n  # ----------------------------------------------------------------------\n  try:\n      env.reset()\n  except Exception:\n      pass\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []\n\n  world = env.world\n  idx = world.cookbook.index\n\n  # ----------------------------------------------------------------------\n  # Identify arrow goal and its recipe\n  # ----------------------------------------------------------------------\n  try:\n      arrow_idx = idx[\"arrow\"]\n  except Exception:\n      return []\n  primitives_needed = world.cookbook.primitives_for(arrow_idx)\n\n  recipe_dict = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe_dict.get(\"_at\") or recipe_dict.get(\"_key\")\n  if workshop_name is None:\n      return []\n  try:\n      workshop_idx = idx[workshop_name]\n  except Exception:\n      return []\n\n  # ----------------------------------------------------------------------\n  # Local mutable copies for planning\n  # ----------------------------------------------------------------------\n  pos = tuple(state.pos)                     # (x, y)\n  grid = state.grid.copy()                    # (W, H, n_kinds)\n  inventory = state.inventory.copy()\n  occupied = np.any(grid > 0, axis=2)         # bool matrix: any entity present\n\n  plan_actions = []\n\n  # ----------------------------------------------------------------------\n  # Helper: move adjacent to *target_coord* and issue a USE action\n  # ----------------------------------------------------------------------\n  def move_and_use(target_coord, kind_idx):\n      \"\"\"Navigate next to *target_coord* (which contains *kind_idx*) and USE.\n      Updates simulated pos, grid, occupied, inventory. Returns False on failure.\"\"\"\n      nonlocal pos, plan_actions, grid, occupied, inventory\n\n      path = bfs_to_adjacent(pos, target_coord, occupied)\n      if not path and pos != target_coord:\n          return False\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n      plan_actions.extend(path)\n\n      # Perform USE\n      plan_actions.append(USE)\n\n      tx, ty = int(target_coord[0]), int(target_coord[1])\n      if grid[tx, ty, kind_idx] > 0:\n          # Pick up one unit of the primitive\n          grid[tx, ty, kind_idx] = 0\n          occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)\n          inventory[kind_idx] += 1\n      return True\n\n  # ----------------------------------------------------------------------\n  # Collect required primitives\n  # ----------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      for _ in range(needed_cnt):\n          candidates = np.argwhere(grid[:, :, prim_idx] > 0)\n          if candidates.shape[0] == 0:\n              # No more instances of this primitive on the map\n              return plan_actions\n          dists = np.abs(candidates[:, 0] - pos[0]) + np.abs(candidates[:, 1] - pos[1])\n          target = candidates[dists.argmin()]\n          if not move_and_use(target, prim_idx):\n              return plan_actions\n\n  # ----------------------------------------------------------------------\n  # Move to a workshop and craft the arrow\n  # ----------------------------------------------------------------------\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.shape[0] == 0:\n      # Fallback to original scenario grid (workshops are static)\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.shape[0] == 0:\n          return plan_actions\n\n  dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])\n  workshop_target = workshop_cells[dists.argmin()]\n\n  move_and_use(workshop_target, workshop_idx)\n\n  return plan_actions", "env_interactions": 23, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T19:23:56.905160", "function_name": "make_arrow", "function_body": "  # Reset environment to ensure a fresh state\n  try:\n      env.reset()\n  except Exception:\n      pass\n\n  # Obtain the current CraftState from the environment\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []\n\n  world = env.world\n  idx = world.cookbook.index\n\n  # --------------------------------------------------------------\n  # Identify the goal item ('arrow') and its recipe\n  # --------------------------------------------------------------\n  try:\n      goal_idx = idx[\"arrow\"]\n  except Exception:\n      return []                     # no arrow defined in the cookbook\n\n  # Primitive requirements for a single arrow\n  primitives_needed = world.cookbook.primitives_for(goal_idx)\n\n  # Determine the workshop required for crafting the arrow\n  workshop_name = None\n  for k, v in world.cookbook.recipes.get(goal_idx, {}).items():\n      if k in (\"_at\", \"_key\"):\n          workshop_name = v\n          break\n  if workshop_name is None:\n      return []                     # recipe lacks workshop information\n  try:\n      workshop_idx = idx[workshop_name]\n  except Exception:\n      return []                     # workshop name not indexed\n\n  # --------------------------------------------------------------\n  # Local mutable copies for planning / simulation\n  # --------------------------------------------------------------\n  pos = tuple(state.pos)                     # (x, y) agent position\n  grid = state.grid.copy()                   # (W, H, n_kinds) occupancy\n  inventory = state.inventory.copy()\n  occupied = np.any(grid > 0, axis=2)        # bool matrix of blocked cells\n\n  plan = []                                   # list of action indices to return\n\n  # --------------------------------------------------------------\n  # Constants & helper utilities\n  # --------------------------------------------------------------\n  # Action ordering follows CraftLab.action_specs\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # 0:DOWN, 1:UP, 2:LEFT, 3:RIGHT\n  USE = 4\n\n  from collections import deque\n\n  def bfs_adjacent(start, target, blocked):\n      \"\"\"Return a list of movement actions that brings the agent from *start*\n      to any empty cell that is 4\u2011connected to *target*.\n      If unreachable, returns an empty list.\"\"\"\n      h, w = blocked.shape\n      tx, ty = target\n      goal_cells = []\n      for a, (dx, dy) in enumerate(DIRS):\n          gx, gy = tx + dx, ty + dy\n          if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:\n              goal_cells.append((gx, gy))\n      if not goal_cells:\n          return []          # target completely surrounded by obstacles\n      q = deque([(start, [])])\n      visited = {start}\n      while q:\n          (cx, cy), path = q.popleft()\n          if (cx, cy) in goal_cells:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []  # unreachable\n\n  def move_and_use(target, kind_idx):\n      \"\"\"Move adjacent to *target* (which contains *kind_idx*) and issue USE.\n      Updates simulated position, grid, occupied map and inventory.\n      Returns False if movement to an adjacent cell is impossible.\"\"\"\n      nonlocal pos, plan, grid, occupied, inventory\n      path = bfs_adjacent(pos, target, occupied)\n      if not path and pos != target:\n          return False\n      # Simulate movement actions\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n      plan.extend(path)\n\n      # Perform USE action\n      plan.append(USE)\n\n      tx, ty = target\n      if grid[tx, ty, kind_idx] > 0:\n          # Pick up the primitive (or interact with workshop)\n          grid[tx, ty, kind_idx] = 0\n          occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)\n          inventory[kind_idx] += 1\n      return True\n\n  # --------------------------------------------------------------\n  # Collect all required primitives\n  # --------------------------------------------------------------\n  for prim_idx, count in primitives_needed.items():\n      for _ in range(count):\n          locations = np.argwhere(grid[:, :, prim_idx] > 0)\n          if locations.size == 0:\n              # Primitive not present on the map \u2013 abort planning\n              return plan\n          # Choose the nearest instance (Manhattan distance)\n          dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n          target = tuple(locations[dists.argmin()])\n          if not move_and_use(target, prim_idx):\n              return plan\n\n  # --------------------------------------------------------------\n  # Move to the workshop and craft the arrow\n  # --------------------------------------------------------------\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      # Workshops are static; fall back to original grid if they were cleared in simulation\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          return plan\n  dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])\n  workshop_target = tuple(workshop_cells[dists.argmin()])\n  move_and_use(workshop_target, workshop_idx)\n\n  return plan", "env_interactions": 23, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T19:23:58.027855", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Reset / obtain current state\n  # ----------------------------------------------------------------------\n  try:\n      env.reset()\n  except Exception:\n      pass\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []\n\n  world = env.world\n  idx = world.cookbook.index\n\n  # ----------------------------------------------------------------------\n  # Identify the goal (arrow) and extract its recipe\n  # ----------------------------------------------------------------------\n  try:\n      goal_idx = idx[\"arrow\"]\n  except Exception:\n      return []                     # no arrow defined in the index\n\n  # Primitive requirements for a single arrow\n  primitives_needed = world.cookbook.primitives_for(goal_idx)\n\n  # Determine which workshop is required (stored under \"_at\" or \"_key\")\n  workshop_name = None\n  for k, v in world.cookbook.recipes.get(goal_idx, {}).items():\n      if k in (\"_at\", \"_key\"):\n          workshop_name = v\n          break\n  if workshop_name is None:\n      return []                     # recipe lacks workshop information\n  try:\n      workshop_idx = idx[workshop_name]\n  except Exception:\n      return []                     # workshop not indexed\n\n  # ----------------------------------------------------------------------\n  # Local mutable copies for planning simulation\n  # ----------------------------------------------------------------------\n  pos = tuple(state.pos)                     # (x, y) agent position\n  grid = state.grid.copy()                   # (W, H, n_kinds) occupancy\n  inventory = state.inventory.copy()\n  occupied = np.any(grid > 0, axis=2)        # bool matrix of blocked cells\n  plan = []                                   # list of action indices to return\n\n  # ----------------------------------------------------------------------\n  # Action constants and movement helpers\n  # ----------------------------------------------------------------------\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # 0:DOWN, 1:UP, 2:LEFT, 3:RIGHT\n  USE = 4\n\n  def bfs_adjacent(start, target, blocked):\n      \"\"\"Return a list of movement actions that brings the agent from *start*\n      to any empty cell that is 4\u2011connected to *target*.\n      If unreachable, returns an empty list.\"\"\"\n      h, w = blocked.shape\n      tx, ty = target\n      goal_cells = []\n      for a, (dx, dy) in enumerate(DIRS):\n          gx, gy = tx + dx, ty + dy\n          if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:\n              goal_cells.append((gx, gy))\n      if not goal_cells:\n          return []          # target completely surrounded by obstacles\n      q = deque([(start, [])])\n      visited = {start}\n      while q:\n          (cx, cy), path = q.popleft()\n          if (cx, cy) in goal_cells:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []  # unreachable\n\n  def move_and_use(target, kind_idx):\n      \"\"\"Move adjacent to *target* (which contains *kind_idx*) and issue USE.\n      Updates simulated position, grid, occupied map and inventory.\n      Returns False on failure, True otherwise.\"\"\"\n      nonlocal pos, plan, grid, occupied, inventory\n      path = bfs_adjacent(pos, target, occupied)\n      if not path and pos != target:\n          return False\n      # Execute movement actions in the simulated world\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n      plan.extend(path)\n\n      # Perform the USE action\n      plan.append(USE)\n\n      tx, ty = target\n      if grid[tx, ty, kind_idx] > 0:\n          # Pick up the primitive / interact with workshop\n          grid[tx, ty, kind_idx] = 0\n          occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)\n          inventory[kind_idx] += 1\n      return True\n\n  # ----------------------------------------------------------------------\n  # Collect all required primitives (may need multiple of each)\n  # ----------------------------------------------------------------------\n  for prim_idx, count in primitives_needed.items():\n      for _ in range(count):\n          locations = np.argwhere(grid[:, :, prim_idx] > 0)\n          if locations.size == 0:\n              # Primitive not present anywhere \u2013 abort planning\n              return plan\n          # Choose the nearest instance (Manhattan distance)\n          dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n          target = tuple(locations[dists.argmin()])\n          if not move_and_use(target, prim_idx):\n              return plan\n\n  # ----------------------------------------------------------------------\n  # Move to the appropriate workshop and craft the arrow\n  # ----------------------------------------------------------------------\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      return plan\n  dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])\n  workshop_target = tuple(workshop_cells[dists.argmin()])\n  move_and_use(workshop_target, workshop_idx)\n\n  return plan", "env_interactions": 0, "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-10-27T19:24:15.330259", "function_name": "make_arrow", "function_body": "  # actions indices\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def _move_actions(src, dst):\n      \"\"\"Return a list of actions that move Manhattan\u2011wise from src to dst.\"\"\"\n      actions = []\n      sr, sc = src\n      dr, dc = dst\n      dr_diff = dr - sr\n      dc_diff = dc - sc\n      if dr_diff > 0:\n          actions.extend([DOWN] * dr_diff)\n      elif dr_diff < 0:\n          actions.extend([UP] * (-dr_diff))\n      if dc_diff > 0:\n          actions.extend([RIGHT] * dc_diff)\n      elif dc_diff < 0:\n          actions.extend([LEFT] * (-dc_diff))\n      return actions\n\n  def _nearest_kind(pos, kind_idx, grid):\n      \"\"\"Find the nearest cell (Manhattan distance) that contains `kind_idx`.\"\"\"\n      coords = np.argwhere(grid[:, :, kind_idx] > 0)\n      if coords.size == 0:\n          return None\n      dists = np.abs(coords[:, 0] - pos[0]) + np.abs(coords[:, 1] - pos[1])\n      nearest = coords[dists.argmin()]\n      return tuple(nearest.tolist())\n\n  # ------------------------------------------------------------------\n  # 1. Identify the goal (arrow) and its primitive requirements\n  # ------------------------------------------------------------------\n  world = env.world\n  arrow_idx = world.cookbook.index.index('arrow')\n  primitives_needed = world.cookbook.primitives_for(arrow_idx)  # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # 2. Collect all required primitives\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = tuple(env._current_state.pos)\n  # work on a local copy of the grid so we don't try to pick the same item twice\n  grid = env._current_state.grid.copy()\n\n  for prim_idx, count in primitives_needed.items():\n      for _ in range(count):\n          target = _nearest_kind(cur_pos, prim_idx, grid)\n          if target is None:\n              # required primitive not present \u2013 stop planning\n              return actions\n          actions += _move_actions(cur_pos, target)\n          cur_pos = target\n          actions.append(USE)                     # pick up the primitive\n          grid[target[0], target[1], prim_idx] = 0  # remove it from our local view\n\n  # ------------------------------------------------------------------\n  # 3. Go to the workshop (if any) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = _nearest_kind(cur_pos, workshop_idx, grid)\n      if workshop_pos is not None:\n          actions += _move_actions(cur_pos, workshop_pos)\n          cur_pos = workshop_pos\n          actions.append(USE)   # craft at the workshop\n\n  return actions", "env_interactions": 22, "island_id": 5, "scores": {"3": 0.2}}
{"timestamp": "2025-10-27T19:24:16.470443", "function_name": "make_arrow", "function_body": "  # Action indices\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def _move_actions(src, dst):\n      \"\"\"Return a list of actions that move Manhattan\u2011wise from src to dst.\"\"\"\n      actions = []\n      sr, sc = src\n      dr, dc = dst\n      dr_diff = dr - sr\n      dc_diff = dc - sc\n      if dr_diff > 0:\n          actions.extend([DOWN] * dr_diff)\n      elif dr_diff < 0:\n          actions.extend([UP] * (-dr_diff))\n      if dc_diff > 0:\n          actions.extend([RIGHT] * dc_diff)\n      elif dc_diff < 0:\n          actions.extend([LEFT] * (-dc_diff))\n      return actions\n\n  def _nearest_kind(pos, kind_idx, grid):\n      \"\"\"Find the nearest cell (Manhattan distance) that contains `kind_idx`.\"\"\"\n      coords = np.argwhere(grid[:, :, kind_idx] > 0)\n      if coords.size == 0:\n          return None\n      dists = np.abs(coords[:, 0] - pos[0]) + np.abs(coords[:, 1] - pos[1])\n      nearest = coords[dists.argmin()]\n      return tuple(nearest.tolist())\n\n  # ------------------------------------------------------------------\n  # 1. Determine the recipe for an arrow\n  # ------------------------------------------------------------------\n  world = env.world\n  arrow_idx = world.cookbook.index.index('arrow')\n  # primitives_needed: {primitive_kind_idx: count}\n  primitives_needed = world.cookbook.primitives_for(arrow_idx)\n\n  # ------------------------------------------------------------------\n  # 2. Collect required primitives\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = tuple(env._current_state.pos)\n  grid = env._current_state.grid.copy()\n\n  for prim_idx, cnt in primitives_needed.items():\n      for _ in range(cnt):\n          target = _nearest_kind(cur_pos, prim_idx, grid)\n          if target is None:\n              # Primitive missing \u2013 abort planning\n              return actions\n          actions += _move_actions(cur_pos, target)\n          cur_pos = target\n          actions.append(USE)          # pick up the primitive\n          # remove the primitive from our local copy of the grid\n          grid[target[0], target[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 3. Move to the workshop (if any) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = _nearest_kind(cur_pos, workshop_idx, grid)\n      if workshop_pos is not None:\n          actions += _move_actions(cur_pos, workshop_pos)\n          cur_pos = workshop_pos\n          actions.append(USE)          # craft at the workshop\n\n  return actions", "env_interactions": 22, "island_id": 5, "scores": {"3": 0.2}}
{"timestamp": "2025-10-27T19:24:35.958815", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def _move_actions(src, dst):\n      \"\"\"Generate a list of actions that moves the agent from src to dst\n      using Manhattan moves (ignoring obstacles).\"\"\"\n      actions = []\n      x, y = src\n      tx, ty = dst\n      dx = tx - x\n      dy = ty - y\n      if dx > 0:\n          actions += [DOWN] * dx\n      elif dx < 0:\n          actions += [UP] * (-dx)\n      if dy > 0:\n          actions += [RIGHT] * dy\n      elif dy < 0:\n          actions += [LEFT] * (-dy)\n      return actions\n\n  def _nearest_kind(pos, kind_idx):\n      \"\"\"Find the nearest cell that contains the given kind index.\n      Returns None if the kind does not appear in the grid.\"\"\"\n      grid = env._current_state.grid\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      # Manhattan distances from current position\n      dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n      best = int(dists.argmin())\n      return tuple(locations[best].tolist())\n\n  # ------------------------------------------------------------------\n  # 1. Determine the goal (arrow) and its required primitives\n  # ------------------------------------------------------------------\n  world = env.world\n  arrow_idx = world.cookbook.index.index('arrow')\n  # Mapping {primitive_index: count} needed for a single arrow\n  primitives_needed = world.cookbook.primitives_for(arrow_idx)\n\n  # ------------------------------------------------------------------\n  # 2. Collect all required primitives\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = env._current_state.pos\n\n  for prim_idx, needed_cnt in primitives_needed.items():\n      for _ in range(needed_cnt):\n          target = _nearest_kind(cur_pos, prim_idx)\n          if target is None:\n              # Primitive not present in the current scenario \u2013 abort early\n              return actions\n          actions += _move_actions(cur_pos, target)\n          cur_pos = target\n          actions.append(USE)   # pick up the primitive\n\n  # ------------------------------------------------------------------\n  # 3. Move to the appropriate workshop and craft the arrow\n  # ------------------------------------------------------------------\n  workshop_name = world.cookbook.recipes[arrow_idx].get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = _nearest_kind(cur_pos, workshop_idx)\n      if workshop_pos is not None:\n          actions += _move_actions(cur_pos, workshop_pos)\n          cur_pos = workshop_pos\n          actions.append(USE)   # craft at the workshop\n\n  return actions", "env_interactions": 22, "island_id": 2, "scores": {"3": 0.2}}
{"timestamp": "2025-10-27T19:24:37.080580", "function_name": "make_arrow", "function_body": "  # define action indices\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # helper to compute Manhattan movement actions\n  def _move_actions(src, dst):\n      actions = []\n      x, y = src\n      tx, ty = dst\n      dx = tx - x\n      dy = ty - y\n      if dx > 0:\n          actions += [DOWN] * dx\n      elif dx < 0:\n          actions += [UP] * (-dx)\n      if dy > 0:\n          actions += [RIGHT] * dy\n      elif dy < 0:\n          actions += [LEFT] * (-dy)\n      return actions\n\n  # helper to locate nearest cell containing a given kind\n  def _nearest_kind(pos, kind_idx):\n      grid = env._current_state.grid\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      # compute Manhattan distances\n      dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n      nearest_idx = int(dists.argmin())\n      return tuple(locations[nearest_idx].tolist())\n\n  world = env.world\n  cookbook = world.cookbook\n  # index of the target item 'arrow'\n  arrow_idx = cookbook.index.index('arrow')\n  # primitive requirements for one arrow\n  primitives_needed = cookbook.primitives_for(arrow_idx)\n\n  actions = []\n  cur_pos = env._current_state.pos\n\n  # collect each required primitive the required number of times\n  for prim_idx, qty in primitives_needed.items():\n      for _ in range(qty):\n          target = _nearest_kind(cur_pos, prim_idx)\n          if target is None:\n              # primitive not present in the current grid; abort early\n              return actions\n          actions += _move_actions(cur_pos, target)\n          cur_pos = target\n          actions.append(USE)  # pick up / interact with the primitive\n\n  # move to the appropriate workshop and craft the arrow\n  workshop_name = cookbook.recipes[arrow_idx].get('_at')\n  if workshop_name is not None:\n      workshop_idx = cookbook.index.index(workshop_name)\n      workshop_pos = _nearest_kind(cur_pos, workshop_idx)\n      if workshop_pos is not None:\n          actions += _move_actions(cur_pos, workshop_pos)\n          cur_pos = workshop_pos\n          actions.append(USE)  # craft at the workshop\n\n  return actions", "env_interactions": 22, "island_id": 2, "scores": {"3": 0.2}}
{"timestamp": "2025-10-27T19:25:05.652567", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ----- reset and grab references -----\n  env.reset()\n  state = env._current_state               # CraftState\n  world = env.scenario.world                # CraftWorld\n  cookbook = world.cookbook                 # Cookbook\n  index = cookbook.index                    # name \u2194 id mapping\n\n  # ----- constants for actions -----\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  action_from_delta = {\n      (1, 0): DOWN,\n      (-1, 0): UP,\n      (0, -1): LEFT,\n      (0, 1): RIGHT,\n  }\n\n  # ----- helper: BFS path planning -----\n  width, height = state.grid.shape[0], state.grid.shape[1]\n  non_grabbable = set(world.non_grabbable_indices)\n\n  def is_blocked(r, c):\n      \"\"\"Return True if cell (r,c) contains any non\u2011grabbable entity.\"\"\"\n      return any(state.grid[r, c, idx] > 0 for idx in non_grabbable)\n\n  def bfs_path(start, targets):\n      \"\"\"Find shortest path from start to any cell in targets.\n      Returns list of positions (r,c) *excluding* start, inclusive of target.\n      If no path exists, returns None.\"\"\"\n      q = deque([start])\n      visited = {start}\n      parent = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur in targets:\n              # reconstruct path\n              path = []\n              while parent[cur] is not None:\n                  path.append(cur)\n                  cur = parent[cur]\n              path.reverse()\n              return path\n          r, c = cur\n          for dr, dc in [(1,0),(-1,0),(0,1),(0,-1)]:\n              nr, nc = r+dr, c+dc\n              if 0 <= nr < width and 0 <= nc < height:\n                  if (nr, nc) not in visited and not is_blocked(nr, nc):\n                      visited.add((nr, nc))\n                      parent[(nr, nc)] = cur\n                      q.append((nr, nc))\n      return None\n\n  # ----- identify goal (arrow) -----\n  goal_name = \"arrow\"\n  if goal_name not in index.contents:\n      return []                     # arrow not defined in this world\n  goal_idx = index[goal_name]\n\n  # ----- primitive requirements -----\n  primitive_needs = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n  actions = []\n\n  # ----- collect each required primitive -----\n  for prim_idx, need_cnt in primitive_needs.items():\n      for _ in range(need_cnt):\n          # locate all cells that currently hold this primitive\n          cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if cells.size == 0:\n              return actions          # cannot find required primitive\n          target_set = {tuple(cell) for cell in cells}\n\n          # plan path to the nearest such cell\n          path = bfs_path(state.pos, target_set)\n          if path is None:\n              return actions          # unreachable primitive\n\n          # translate path into actions\n          cur = state.pos\n          for nxt in path:\n              dr, dc = nxt[0] - cur[0], nxt[1] - cur[1]\n              actions.append(action_from_delta[(dr, dc)])\n              cur = nxt\n          state.pos = cur               # update internal position\n\n          # pick up the primitive\n          actions.append(USE)\n          state.inventory[prim_idx] += 1\n          r, c = cur\n          state.grid[r, c, prim_idx] = 0\n\n  # ----- go to workshop and craft -----\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      return actions                 # no workshop info, cannot craft\n\n  workshop_idx = index[workshop_name]\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      return actions                 # no workshop present\n\n  target_set = {tuple(cell) for cell in workshop_cells}\n  path = bfs_path(state.pos, target_set)\n  if path is None:\n      return actions                 # cannot reach workshop\n\n  cur = state.pos\n  for nxt in path:\n      dr, dc = nxt[0] - cur[0], nxt[1] - cur[1]\n      actions.append(action_from_delta[(dr, dc)])\n      cur = nxt\n  state.pos = cur\n\n  # craft the arrow\n  actions.append(USE)\n\n  return actions", "env_interactions": 18, "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T19:25:06.789837", "function_name": "make_arrow", "function_body": "  # Reset environment and get references\n  env.reset()\n  state = env._current_state               # CraftState\n  world = env.scenario.world                # CraftWorld\n  cookbook = world.cookbook                 # Cookbook\n  index = cookbook.index                    # name \u2194 id mapping\n\n  # Goal identification\n  goal_name = \"arrow\"\n  if goal_name not in index.contents:\n      return []  # arrow not defined\n\n  goal_idx = index[goal_name]\n\n  # Primitive requirements for one arrow\n  primitive_needs = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper: BFS path finder returning a list of actions.\n  # Allows stepping onto the goal cell even if it is occupied.\n  # ------------------------------------------------------------------\n  def _bfs_path(start, goal, allow_goal_occupied=True):\n      \"\"\"Return list of actions (DOWN,UP,LEFT,RIGHT) to move from start to goal.\n      Returns None if no path is found.\"\"\"\n      w, h = state.grid.shape[:2]\n      visited = np.full((w, h), False, dtype=bool)\n      q = collections.deque()\n      q.append(start)\n      visited[start] = True\n      parent = {}\n\n      # direction vectors and corresponding action indices\n      dirs = [(1, 0, 0),   # DOWN\n              (-1, 0, 1),  # UP\n              (0, -1, 2),  # LEFT\n              (0, 1, 3)]   # RIGHT\n\n      while q:\n          r, c = q.popleft()\n          if (r, c) == goal:\n              break\n          for dr, dc, act in dirs:\n              nr, nc = r + dr, c + dc\n              if not (0 <= nr < w and 0 <= nc < h):\n                  continue\n              if visited[nr, nc]:\n                  continue\n              occupied = state.grid[nr, nc, :].any()\n              if occupied and not (allow_goal_occupied and (nr, nc) == goal):\n                  continue\n              visited[nr, nc] = True\n              parent[(nr, nc)] = ((r, c), act)\n              q.append((nr, nc))\n      else:\n          return None  # no path found\n\n      # reconstruct actions\n      path = []\n      cur = goal\n      while cur != start:\n          prev, act = parent[cur]\n          path.append(act)\n          cur = prev\n      path.reverse()\n      return path\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives.\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          # locate any remaining cell containing this primitive\n          cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if cells.size == 0:\n              return actions  # cannot find required primitive\n\n          tr, tc = cells[0]  # pick the first occurrence\n\n          # plan movement to the primitive cell (standing on it is fine)\n          move_seq = _bfs_path(state.pos, (tr, tc), allow_goal_occupied=True)\n          if move_seq is None:\n              return actions  # no reachable path\n\n          actions.extend(move_seq)\n          state.pos = (tr, tc)\n\n          # pick up the primitive\n          actions.append(4)  # USE action\n\n          # update internal state representation\n          state.inventory[prim_idx] += 1\n          state.grid[tr, tc, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 2. Go to the appropriate workshop and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      return actions  # workshop information missing\n\n  workshop_idx = index[workshop_name]\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      return actions  # no workshop found on the map\n\n  wr, wc = workshop_cells[0]\n\n  move_seq = _bfs_path(state.pos, (wr, wc), allow_goal_occupied=True)\n  if move_seq is None:\n      return actions  # cannot reach workshop\n\n  actions.extend(move_seq)\n  state.pos = (wr, wc)\n\n  # craft the arrow\n  actions.append(4)  # USE at the workshop\n\n  return actions", "env_interactions": 28, "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T19:25:29.100720", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action constants (match CraftLab.action_specs order)\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # 0:DOWN, 1:UP, 2:LEFT, 3:RIGHT\n  USE = 4\n\n  def bfs_to_adjacent(start, target, blocked):\n      \"\"\"Return a list of movement actions that brings the agent from *start*\n      to any empty cell that is 4\u2011connected to *target*.\n      If no such path exists, returns an empty list.\"\"\"\n      h, w = blocked.shape\n      goal_cells = []\n      tx, ty = int(target[0]), int(target[1])\n      for a, (dx, dy) in enumerate(DIRS):\n          gx, gy = tx + dx, ty + dy\n          if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:\n              goal_cells.append((gx, gy))\n      if not goal_cells:\n          return []\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (cx, cy), path = q.popleft()\n          if (cx, cy) in goal_cells:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []\n\n  # ----------------------------------------------------------------------\n  # Initialise / reset environment\n  try:\n      env.reset()\n  except Exception:\n      pass\n\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []\n\n  world = env.world\n  idx = world.cookbook.index\n\n  # ----------------------------------------------------------------------\n  # Identify goal (arrow) and its recipe\n  try:\n      arrow_idx = idx[\"arrow\"]\n  except Exception:\n      return []\n\n  primitives_needed = world.cookbook.primitives_for(arrow_idx)\n\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\") or recipe.get(\"_key\")\n  if workshop_name is None:\n      return []\n  try:\n      workshop_idx = idx[workshop_name]\n  except Exception:\n      return []\n\n  # ----------------------------------------------------------------------\n  # Local mutable copies of the world state\n  pos = tuple(state.pos)                     # (x, y)\n  grid = state.grid.copy()                   # (W, H, n_kinds)\n  inventory = state.inventory.copy()         # (n_kinds,)\n  occupied = np.any(grid > 0, axis=2)        # (W, H) bool\n\n  plan_actions = []\n\n  def move_and_use(target_coord, kind_idx):\n      \"\"\"Move adjacent to *target_coord* (which holds *kind_idx*) and USE.\n      Updates local copies of pos, grid, occupied and inventory.\"\"\"\n      nonlocal pos, plan_actions, grid, occupied, inventory\n      path = bfs_to_adjacent(pos, target_coord, occupied)\n      if not path and pos != target_coord:\n          return False\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n      plan_actions.extend(path)\n      plan_actions.append(USE)\n\n      tx, ty = int(target_coord[0]), int(target_coord[1])\n      if grid[tx, ty, kind_idx] > 0:\n          grid[tx, ty, kind_idx] = 0\n          occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)\n          inventory[kind_idx] += 1\n      return True\n\n  # ----------------------------------------------------------------------\n  # Collect required primitives (may need multiple of same kind)\n  for prim_idx, needed_cnt in primitives_needed.items():\n      for _ in range(needed_cnt):\n          candidates = np.argwhere(grid[:, :, prim_idx] > 0)\n          if candidates.shape[0] == 0:\n              # No more of this primitive left on the map; abort early\n              return plan_actions\n          # Choose the nearest candidate (Manhattan distance)\n          dists = np.abs(candidates[:, 0] - pos[0]) + np.abs(candidates[:, 1] - pos[1])\n          target = candidates[dists.argmin()]\n          if not move_and_use(target, prim_idx):\n              return plan_actions\n\n  # ----------------------------------------------------------------------\n  # Move to a workshop cell and craft the arrow\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.shape[0] == 0:\n      # If the workshop cell was cleared during collection (unlikely), fall back to original grid\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.shape[0] == 0:\n          return plan_actions\n  dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])\n  workshop_target = workshop_cells[dists.argmin()]\n  move_and_use(workshop_target, workshop_idx)\n\n  return plan_actions", "env_interactions": 23, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T19:25:30.231050", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS to any empty cell adjacent to a target cell.\n  # Returns a list of movement actions (0:DOWN,1:UP,2:LEFT,3:RIGHT)\n  # ----------------------------------------------------------------------\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # 0:DOWN, 1:UP, 2:LEFT, 3:RIGHT\n  USE = 4\n\n  def bfs_to_adjacent(start, target, blocked):\n      \"\"\"Find a shortest path from start to any 4\u2011connected empty cell next to target.\"\"\"\n      h, w = blocked.shape\n      # cells that are valid destinations (adjacent and free)\n      goal_cells = []\n      tx, ty = target\n      for a, (dx, dy) in enumerate(DIRS):\n          gx, gy = tx + dx, ty + dy\n          if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:\n              goal_cells.append((gx, gy))\n      if not goal_cells:\n          return []                     # no reachable neighbour\n\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (cx, cy), path = q.popleft()\n          if (cx, cy) in goal_cells:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []                         # unreachable\n\n  # ----------------------------------------------------------------------\n  # Initialise / reset environment\n  # ----------------------------------------------------------------------\n  try:\n      env.reset()\n  except Exception:\n      pass\n\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []\n\n  world = env.world\n  idx = world.cookbook.index\n\n  # ----------------------------------------------------------------------\n  # Identify goal (arrow) and its recipe\n  # ----------------------------------------------------------------------\n  try:\n      arrow_idx = idx[\"arrow\"]\n  except Exception:\n      return []\n\n  # primitive requirements for ONE arrow\n  primitives_needed = world.cookbook.primitives_for(arrow_idx)\n\n  # workshop where arrow is crafted\n  recipe_dict = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe_dict.get(\"_at\") or recipe_dict.get(\"_key\")\n  if workshop_name is None:\n      return []\n  try:\n      workshop_idx = idx[workshop_name]\n  except Exception:\n      return []\n\n  # ----------------------------------------------------------------------\n  # Local mutable copies of the world state\n  # ----------------------------------------------------------------------\n  pos = tuple(state.pos)                     # (x, y)\n  grid = state.grid.copy()                   # (W, H, n_kinds)\n  occupied = np.any(grid > 0, axis=2)        # bool matrix of blocked cells\n  inventory = state.inventory.copy()\n\n  plan_actions = []\n\n  # ----------------------------------------------------------------------\n  # Helper: move next to a cell containing kind_idx and USE it.\n  # Updates the simulated local state.\n  # ----------------------------------------------------------------------\n  def move_and_use(target_coord, kind_idx):\n      nonlocal pos, plan_actions, grid, occupied, inventory\n      path = bfs_to_adjacent(pos, target_coord, occupied)\n      if not path and pos != target_coord:\n          return False\n      # execute movement actions\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n      plan_actions.extend(path)\n      # USE action\n      plan_actions.append(USE)\n      tx, ty = target_coord\n      if grid[tx, ty, kind_idx] > 0:\n          # pick up / craft\n          grid[tx, ty, kind_idx] = 0\n          occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)\n          inventory[kind_idx] += 1\n      return True\n\n  # ----------------------------------------------------------------------\n  # Collect all required primitives\n  # ----------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      for _ in range(needed_cnt):\n          # locate nearest remaining primitive of this kind\n          candidates = np.argwhere(grid[:, :, prim_idx] > 0)\n          if candidates.size == 0:\n              # nothing left \u2013 abort and return current plan\n              return plan_actions\n          dists = np.abs(candidates[:, 0] - pos[0]) + np.abs(candidates[:, 1] - pos[1])\n          target = tuple(candidates[dists.argmin()])\n          if not move_and_use(target, prim_idx):\n              return plan_actions\n\n  # ----------------------------------------------------------------------\n  # Move to a workshop cell and craft the arrow\n  # ----------------------------------------------------------------------\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      # fallback to original grid (workshop may be empty after pickups)\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          return plan_actions\n  dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])\n  workshop_target = tuple(workshop_cells[dists.argmin()])\n  move_and_use(workshop_target, workshop_idx)\n\n  return plan_actions", "env_interactions": 23, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T19:25:59.448021", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  def _manhattan_path(src, dst):\n      \"\"\"Return a list of actions that move from src to dst using Manhattan moves.\"\"\"\n      actions = []\n      x, y = src\n      tx, ty = dst\n      # vertical movement (row index)\n      while x < tx:\n          actions.append(DOWN)\n          x += 1\n      while x > tx:\n          actions.append(UP)\n          x -= 1\n      # horizontal movement (column index)\n      while y < ty:\n          actions.append(RIGHT)\n          y += 1\n      while y > ty:\n          actions.append(LEFT)\n          y -= 1\n      return actions\n\n  def _nearest_entity(pos, kind_idx):\n      \"\"\"Find the closest cell (Manhattan distance) that contains the given kind.\"\"\"\n      grid = env._current_state.grid\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n      best = int(np.argmin(dists))\n      return tuple(locations[best])\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow) and its recipe\n  # ------------------------------------------------------------------\n  world = env.world\n  idx_arrow = world.cookbook.index.index('arrow')\n  primitives_needed = world.cookbook.primitives_for(idx_arrow)  # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Collect all required primitives\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = env._current_state.pos\n\n  for prim_idx, required_cnt in primitives_needed.items():\n      for _ in range(required_cnt):\n          target = _nearest_entity(cur_pos, prim_idx)\n          if target is None:\n              # Primitive not present \u2013 abort early\n              return actions\n          actions += _manhattan_path(cur_pos, target)\n          cur_pos = target\n          actions.append(USE)   # pick up the primitive\n\n  # ------------------------------------------------------------------\n  # Move to the appropriate workshop (if any) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(idx_arrow, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = _nearest_entity(cur_pos, workshop_idx)\n      if workshop_pos is not None:\n          actions += _manhattan_path(cur_pos, workshop_pos)\n          cur_pos = workshop_pos\n          actions.append(USE)   # craft at the workshop\n\n  return actions", "env_interactions": 22, "island_id": 0, "scores": {"3": 0.2}}
{"timestamp": "2025-10-27T19:26:00.568956", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  world = env.world\n  idx_arrow = world.cookbook.index.index('arrow')\n  primitives_needed = world.cookbook.primitives_for(idx_arrow)\n\n  actions = []\n  cur_pos = env._current_state.pos\n  grid = env._current_state.grid.copy()\n\n  def bfs_path(start, goal, grid):\n      if start == goal:\n          return []\n      H, W = grid.shape[:2]\n      visited = np.full((H, W), False, dtype=bool)\n      prev = {}\n      q = deque()\n      q.append(start)\n      visited[start] = True\n      while q:\n          x, y = q.popleft()\n          for dx, dy, act in ((1, 0, DOWN), (-1, 0, UP), (0, 1, RIGHT), (0, -1, LEFT)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < H and 0 <= ny < W and not visited[nx, ny]:\n                  if (nx, ny) != goal and grid[nx, ny, :].sum() > 0:\n                      continue\n                  visited[nx, ny] = True\n                  prev[(nx, ny)] = ((x, y), act)\n                  if (nx, ny) == goal:\n                      path = []\n                      cur = goal\n                      while cur != start:\n                          (p, a) = prev[cur]\n                          path.append(a)\n                          cur = p\n                      path.reverse()\n                      return path\n                  q.append((nx, ny))\n      return None\n\n  def find_nearest(pos, kind_idx, grid):\n      locs = np.argwhere(grid[:, :, kind_idx] > 0)\n      best_path = None\n      best_loc = None\n      for loc in locs:\n          loc_tup = (int(loc[0]), int(loc[1]))\n          path = bfs_path(pos, loc_tup, grid)\n          if path is None:\n              continue\n          if best_path is None or len(path) < len(best_path):\n              best_path = path\n              best_loc = loc_tup\n      return best_loc, best_path\n\n  # Collect required primitives\n  for prim_idx, cnt in primitives_needed.items():\n      for _ in range(cnt):\n          target, path = find_nearest(cur_pos, prim_idx, grid)\n          if target is None:\n              return actions\n          actions.extend(path)\n          actions.append(USE)\n          cur_pos = target\n          if grid[target[0], target[1], prim_idx] > 0:\n              grid[target[0], target[1], prim_idx] -= 1\n\n  # Move to workshop (if required) and craft\n  recipe = world.cookbook.recipes.get(idx_arrow, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      target, path = find_nearest(cur_pos, workshop_idx, grid)\n      if target is not None:\n          actions.extend(path)\n          actions.append(USE)\n\n  return actions", "env_interactions": 26, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T19:26:14.811179", "function_name": "make_arrow", "function_body": "  # action indices\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  world = env.world\n  cookbook = world.cookbook\n\n  # target item (arrow) index\n  goal_idx = cookbook.index.index('arrow')\n  # primitive requirements for a single arrow\n  primitives_needed = cookbook.primitives_for(goal_idx)\n\n  actions = []\n  cur_pos = env._current_state.pos\n\n  def _move_actions(src, dst):\n      \"\"\"Manhattan moves from src to dst (ignores obstacles).\"\"\"\n      x, y = src\n      tx, ty = dst\n      acts = []\n      dx = tx - x\n      dy = ty - y\n      if dx > 0:\n          acts += [DOWN] * dx\n      elif dx < 0:\n          acts += [UP] * (-dx)\n      if dy > 0:\n          acts += [RIGHT] * dy\n      elif dy < 0:\n          acts += [LEFT] * (-dy)\n      return acts\n\n  def _nearest_kind(pos, kind_idx):\n      \"\"\"Return coordinates of the nearest cell containing kind_idx.\"\"\"\n      grid = env._current_state.grid\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n      nearest = int(dists.argmin())\n      return tuple(locations[nearest].tolist())\n\n  # ------------------------------------------------------------\n  # 1. Collect required primitives\n  # ------------------------------------------------------------\n  for prim_idx, qty in primitives_needed.items():\n      for _ in range(qty):\n          target = _nearest_kind(cur_pos, prim_idx)\n          if target is None:\n              # primitive not present \u2013 abort early\n              return actions\n          actions += _move_actions(cur_pos, target)\n          cur_pos = target\n          actions.append(USE)   # pick up / interact\n\n  # ------------------------------------------------------------\n  # 2. Move to the workshop and craft the arrow\n  # ------------------------------------------------------------\n  workshop_name = cookbook.recipes[goal_idx].get('_at')\n  if workshop_name is not None:\n      workshop_idx = cookbook.index.index(workshop_name)\n      workshop_pos = _nearest_kind(cur_pos, workshop_idx)\n      if workshop_pos is not None:\n          actions += _move_actions(cur_pos, workshop_pos)\n          cur_pos = workshop_pos\n          actions.append(USE)   # craft at workshop\n\n  return actions", "env_interactions": 22, "island_id": 2, "scores": {"3": 0.2}}
{"timestamp": "2025-10-27T19:26:15.929752", "function_name": "make_arrow", "function_body": "  # Action indices (standard for CraftWorld)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def _move_actions(src, dst):\n      \"\"\"Return a list of actions that moves from src to dst using\n      Manhattan moves.  This ignores obstacles \u2013 it is a simple\n      heuristic that works for most generated scenarios.\"\"\"\n      actions = []\n      x, y = src\n      tx, ty = dst\n      dx = tx - x\n      dy = ty - y\n      if dx > 0:\n          actions += [DOWN] * dx\n      elif dx < 0:\n          actions += [UP] * (-dx)\n      if dy > 0:\n          actions += [RIGHT] * dy\n      elif dy < 0:\n          actions += [LEFT] * (-dy)\n      return actions\n\n  def _nearest_kind(pos, kind_idx):\n      \"\"\"Find the nearest cell (Manhattan distance) that contains the\n      requested kind index.  Returns None if the kind does not appear.\"\"\"\n      grid = env._current_state.grid\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n      nearest = int(dists.argmin())\n      return tuple(locations[nearest].tolist())\n\n  # ------------------------------------------------------------------\n  # 1. Identify the goal (arrow) and its primitive requirements\n  # ------------------------------------------------------------------\n  world = env.world\n  cookbook = world.cookbook\n  arrow_idx = cookbook.index.index('arrow')\n  # Mapping {primitive_index: count} needed for a single arrow\n  primitives_needed = cookbook.primitives_for(arrow_idx)\n\n  # ------------------------------------------------------------------\n  # 2. Collect all required primitives\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = env._current_state.pos\n\n  for prim_idx, qty in primitives_needed.items():\n      for _ in range(qty):\n          target = _nearest_kind(cur_pos, prim_idx)\n          if target is None:\n              # Primitive missing \u2013 cannot complete the task; return what we have\n              return actions\n          actions += _move_actions(cur_pos, target)\n          cur_pos = target\n          actions.append(USE)   # pick up / interact with the primitive\n\n  # ------------------------------------------------------------------\n  # 3. Move to the workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  workshop_name = cookbook.recipes[arrow_idx].get('_at')\n  if workshop_name is not None:\n      workshop_idx = cookbook.index.index(workshop_name)\n      workshop_pos = _nearest_kind(cur_pos, workshop_idx)\n      if workshop_pos is not None:\n          actions += _move_actions(cur_pos, workshop_pos)\n          cur_pos = workshop_pos\n          actions.append(USE)   # craft at the workshop\n\n  return actions", "env_interactions": 22, "island_id": 2, "scores": {"3": 0.2}}
{"timestamp": "2025-10-27T19:26:49.764332", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Reset environment and obtain current state/world objects\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world\n  cookbook = world.cookbook\n\n  # Identify goal (\"arrow\") and its recipe\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n  if goal_idx is None:\n      return []                       # unknown goal\n\n  primitive_needs = cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  if \"_at\" in recipe:\n      workshop_idx = cookbook.index[recipe[\"_at\"]]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def bfs_path(start, goal, occupied):\n      \"\"\"Bread\u2011first search returning a list of positions from start (excluded) to goal (included).\"\"\"\n      w, h = occupied.shape\n      visited = np.zeros((w, h), dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start] = True\n      while q:\n          x, y = q.popleft()\n          if (x, y) == goal:\n              break\n          for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):\n              if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:\n                  # Allow stepping onto the goal even if occupied\n                  if (nx, ny) == goal or not occupied[nx, ny]:\n                      visited[nx, ny] = True\n                      prev[(nx, ny)] = (x, y)\n                      q.append((nx, ny))\n      if not visited[goal]:\n          return None\n      # Reconstruct path (exclude start, include goal)\n      path = []\n      cur = goal\n      while cur != start:\n          path.append(cur)\n          cur = prev[cur]\n      path.reverse()\n      return path\n\n  def delta_to_action(dx, dy):\n      \"\"\"Convert a movement delta into the corresponding action index.\"\"\"\n      if dx == 1:\n          return 3   # RIGHT\n      if dx == -1:\n          return 2   # LEFT\n      if dy == 1:\n          return 0   # DOWN\n      if dy == -1:\n          return 1   # UP\n      raise ValueError(\"Invalid movement delta\")\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # Work on a mutable copy of the grid to keep track of collected primitives\n  grid = state.grid.copy()\n  occupied = lambda g: np.any(g, axis=2)   # any non\u2011empty cell is an obstacle\n\n  # ------------------------------------------------------------------\n  # Collect all required primitives\n  # ------------------------------------------------------------------\n  for kind_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          # Locate remaining cells containing this primitive\n          locations = np.argwhere(grid[:, :, kind_idx] > 0)\n          if locations.size == 0:\n              break\n          # Order candidates by Manhattan distance from current position\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n\n          target = None\n          path = None\n          for idx in order:\n              cand = tuple(locations[idx])\n              p = bfs_path(cur_pos, cand, occupied(grid))\n              if p is not None:\n                  target = cand\n                  path = p\n                  break\n          if path is None:\n              continue    # cannot reach any remaining instance\n\n          # Follow the path to the primitive\n          for step in path:\n              dx = step[0] - cur_pos[0]\n              dy = step[1] - cur_pos[1]\n              actions.append(delta_to_action(dx, dy))\n              cur_pos = step\n\n          # Pick up the primitive\n          actions.append(4)   # USE\n          grid[target[0], target[1], kind_idx] = 0   # Remove from copy\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size:\n          dists = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n          for idx in order:\n              cand = tuple(workshop_cells[idx])\n              p = bfs_path(cur_pos, cand, occupied(state.grid))\n              if p is not None:\n                  for step in p:\n                      dx = step[0] - cur_pos[0]\n                      dy = step[1] - cur_pos[1]\n                      actions.append(delta_to_action(dx, dy))\n                      cur_pos = step\n                  actions.append(4)   # USE to trigger crafting\n                  break\n\n  return actions", "env_interactions": 26, "island_id": 6, "scores": {"3": 0.5}}
