{"timestamp": "2025-10-27T19:00:32.382388", "function_name": "make_arrow", "function_body": "  try:\n      env.reset()\n  except Exception:\n      pass\n\n  # Determine the goal index from the environment's task description\n  goal_idx = None\n  if hasattr(env, \"task\"):\n      task = getattr(env, \"task\")\n      if hasattr(task, \"goal\"):\n          goal_idx = task.goal\n      elif isinstance(task, (list, tuple)):\n          goal_idx = task[0]\n  if goal_idx is None:\n      return []\n\n  # Map action names to their integer codes\n  action_map = env.action_specs()\n  DOWN = action_map.get(\"DOWN\", 0)\n  UP = action_map.get(\"UP\", 1)\n  LEFT = action_map.get(\"LEFT\", 2)\n  RIGHT = action_map.get(\"RIGHT\", 3)\n  USE = action_map.get(\"USE\", 4)\n\n  # Current mutable position (x, y)\n  cur_pos = list(env._current_state.pos)\n\n  # Helper: generate Manhattan moves from cur_pos to target and update cur_pos\n  def move_to(target):\n      tx, ty = target\n      moves = []\n      while cur_pos[0] < tx:\n          moves.append(RIGHT)\n          cur_pos[0] += 1\n      while cur_pos[0] > tx:\n          moves.append(LEFT)\n          cur_pos[0] -= 1\n      while cur_pos[1] < ty:\n          moves.append(DOWN)\n          cur_pos[1] += 1\n      while cur_pos[1] > ty:\n          moves.append(UP)\n          cur_pos[1] -= 1\n      return moves\n\n  import numpy as np\n  # Work on a copy of the grid to simulate pickups\n  grid = env._current_state.grid.copy()\n\n  plan = []\n\n  # ------------------------------------------------------------------\n  # 1. Collect all primitive resources required for the goal item\n  # ------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)\n  for kind_idx, count_needed in primitives_needed.items():\n      remaining = count_needed\n      while remaining > 0:\n          # Locate all cells that currently contain this primitive\n          positions = np.argwhere(grid[:, :, kind_idx] > 0)\n          if positions.size == 0:\n              # No more of this primitive on the map; abort collection\n              break\n          # Choose the nearest instance (Manhattan distance)\n          dists = np.abs(positions[:, 0] - cur_pos[0]) + np.abs(positions[:, 1] - cur_pos[1])\n          nearest = int(dists.argmin())\n          target = tuple(positions[nearest])\n          # Move to the primitive and pick it up\n          plan.extend(move_to(target))\n          plan.append(USE)\n          # Simulate the pickup in our local copy of the grid\n          grid[target[0], target[1], kind_idx] = 0\n          remaining -= 1\n\n  # ------------------------------------------------------------------\n  # 2. Go to the appropriate workshop (if any) and craft the item\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      ws_positions = np.argwhere(grid[:, :, workshop_kind] > 0)\n      if ws_positions.shape[0] > 0:\n          dists = np.abs(ws_positions[:, 0] - cur_pos[0]) + np.abs(ws_positions[:, 1] - cur_pos[1])\n          nearest_ws = int(dists.argmin())\n          ws_target = tuple(ws_positions[nearest_ws])\n          plan.extend(move_to(ws_target))\n\n  # Final USE action to trigger crafting at the current location\n  plan.append(USE)\n\n  return plan", "env_interactions": 1, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T19:00:33.503084", "function_name": "make_arrow", "function_body": "  # Reset the environment if possible\n  try:\n      env.reset()\n  except Exception:\n      pass\n\n  # ----------------------------------------------------------------------\n  # Identify the goal item index\n  # ----------------------------------------------------------------------\n  goal_idx = None\n  if hasattr(env, \"task\"):\n      task = getattr(env, \"task\")\n      if hasattr(task, \"goal\"):\n          goal_idx = task.goal\n  if goal_idx is None:\n      return []  # cannot determine goal\n\n  # ----------------------------------------------------------------------\n  # Action indices (consistent with CraftLab.action_specs)\n  # ----------------------------------------------------------------------\n  action_map = env.action_specs()\n  DOWN = action_map.get(\"DOWN\", 0)\n  UP = action_map.get(\"UP\", 1)\n  LEFT = action_map.get(\"LEFT\", 2)\n  RIGHT = action_map.get(\"RIGHT\", 3)\n  USE = action_map.get(\"USE\", 4)\n\n  # ----------------------------------------------------------------------\n  # Helper to generate Manhattan moves from current position to target\n  # ----------------------------------------------------------------------\n  cur_pos = list(env._current_state.pos)          # mutable [x, y]\n\n  def move_to(target):\n      tx, ty = target\n      moves = []\n      # X direction\n      while cur_pos[0] < tx:\n          moves.append(RIGHT)\n          cur_pos[0] += 1\n      while cur_pos[0] > tx:\n          moves.append(LEFT)\n          cur_pos[0] -= 1\n      # Y direction\n      while cur_pos[1] < ty:\n          moves.append(DOWN)\n          cur_pos[1] += 1\n      while cur_pos[1] > ty:\n          moves.append(UP)\n          cur_pos[1] -= 1\n      return moves\n\n  # ----------------------------------------------------------------------\n  # Planning \u2013 copy grid so we can simulate pickups\n  # ----------------------------------------------------------------------\n  import numpy as np\n  grid = env._current_state.grid.copy()   # shape (W, H, n_kinds)\n  plan = []\n\n  # ----------------------------------------------------------------------\n  # Gather required primitives (recursively flattened)\n  # ----------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)\n  for kind_idx, count_needed in primitives_needed.items():\n      remaining = count_needed\n      while remaining > 0:\n          # Locate all cells that currently hold this primitive\n          positions = np.argwhere(grid[:, :, kind_idx] > 0)\n          if positions.size == 0:\n              # No more of this primitive on the map \u2013 abort collection\n              break\n          # Choose the nearest primitive by Manhattan distance\n          dists = np.abs(positions[:, 0] - cur_pos[0]) + np.abs(positions[:, 1] - cur_pos[1])\n          nearest = int(dists.argmin())\n          target = tuple(positions[nearest])\n          # Move to the primitive and pick it up\n          plan.extend(move_to(target))\n          plan.append(USE)\n          # Simulate the pickup so we don't revisit the same cell\n          grid[target[0], target[1], kind_idx] = 0\n          remaining -= 1\n\n  # ----------------------------------------------------------------------\n  # Move to the appropriate workshop (if the recipe specifies one) and craft\n  # ----------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      ws_positions = np.argwhere(grid[:, :, workshop_kind] > 0)\n      if ws_positions.shape[0] > 0:\n          dists = np.abs(ws_positions[:, 0] - cur_pos[0]) + np.abs(ws_positions[:, 1] - cur_pos[1])\n          nearest_ws = int(dists.argmin())\n          ws_target = tuple(ws_positions[nearest_ws])\n          plan.extend(move_to(ws_target))\n\n  # Final USE to trigger the crafting action\n  plan.append(USE)\n\n  return plan", "env_interactions": 1, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T19:01:27.918394", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.scenario.world\n  cookbook = world.cookbook\n  idx = cookbook.index\n\n  act_map = env.action_specs()\n  DOWN = act_map[\"DOWN\"]\n  UP = act_map[\"UP\"]\n  LEFT = act_map[\"LEFT\"]\n  RIGHT = act_map[\"RIGHT\"]\n  USE = act_map[\"USE\"]\n  moves = [(DOWN, (1, 0)), (UP, (-1, 0)), (LEFT, (0, -1)), (RIGHT, (0, 1))]\n\n  from collections import deque\n\n  h, w = state.grid.shape[:2]\n\n  def bfs_path(start, target):\n      \"\"\"Shortest path from start to target avoiding occupied cells (except target).\"\"\"\n      if start == target:\n          return []\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          for act, (dr, dc) in moves:\n              nr, nc = cur[0] + dr, cur[1] + dc\n              if not (0 <= nr < h and 0 <= nc < w):\n                  continue\n              nxt = (nr, nc)\n              if nxt in visited:\n                  continue\n              occupied = state.grid[nr, nc, :].any()\n              if occupied and nxt != target:\n                  continue\n              visited.add(nxt)\n              parent[nxt] = (cur, act)\n              q.append(nxt)\n      if target not in parent and start != target:\n          return []  # no path found\n      path = []\n      cur = target\n      while cur != start:\n          prev, act = parent[cur]\n          path.append(act)\n          cur = prev\n      path.reverse()\n      return path\n\n  def find_nearest(kind_idx, start):\n      \"\"\"BFS to the closest cell containing kind_idx.\"\"\"\n      if state.grid[start[0], start[1], kind_idx] > 0:\n          return [], start\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          cur = q.popleft()\n          for act, (dr, dc) in moves:\n              nr, nc = cur[0] + dr, cur[1] + dc\n              if not (0 <= nr < h and 0 <= nc < w):\n                  continue\n              nxt = (nr, nc)\n              if nxt in visited:\n                  continue\n              occupied = state.grid[nr, nc, :].any()\n              # can step onto the target cell even if occupied\n              if occupied and state.grid[nr, nc, kind_idx] == 0:\n                  continue\n              visited.add(nxt)\n              parent[nxt] = (cur, act)\n              if state.grid[nr, nc, kind_idx] > 0:\n                  # reconstruct path\n                  path = []\n                  cur2 = nxt\n                  while cur2 != start:\n                      prev2, act2 = parent[cur2]\n                      path.append(act2)\n                      cur2 = prev2\n                  path.reverse()\n                  return path, nxt\n              q.append(nxt)\n      return None, None\n\n  goal_name = \"arrow\"\n  if goal_name not in idx.contents:\n      return []\n  goal_idx = idx[goal_name]\n  primitive_needs = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n\n  plan = []\n  cur_pos = tuple(state.pos)\n\n  # 1. Collect required primitives\n  for prim_idx, count in primitive_needs.items():\n      for _ in range(count):\n          path, cell = find_nearest(prim_idx, cur_pos)\n          if cell is None:\n              return plan  # cannot find required primitive\n          plan.extend(path)\n          cur_pos = cell\n          plan.append(USE)  # pick up\n          r, c = cell\n          state.inventory[prim_idx] += 1\n          state.grid[r, c, prim_idx] = 0\n\n  # 2. Move to the workshop and craft the arrow\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      return plan\n  workshop_idx = idx[workshop_name]\n  path, cell = find_nearest(workshop_idx, cur_pos)\n  if cell is None:\n      return plan\n  plan.extend(path)\n  cur_pos = cell\n  plan.append(USE)  # craft\n\n  return plan", "env_interactions": 26, "island_id": 1, "scores": {"3": 1.5}}
