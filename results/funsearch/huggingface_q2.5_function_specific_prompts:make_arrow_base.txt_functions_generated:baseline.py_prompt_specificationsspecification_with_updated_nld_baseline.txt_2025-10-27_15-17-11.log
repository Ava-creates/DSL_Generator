{"timestamp": "2025-10-27T18:52:20.088844", "function_name": "make_arrow", "function_body": "  # Reset the environment and fetch core objects\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world\n  cookbook = world.cookbook\n\n  # ------------------------------------------------------------------\n  # Identify the goal item (\"arrow\") and its recipe requirements\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n  if goal_idx is None:\n      return []                       # unknown goal, cannot plan\n\n  # Primitive ingredients needed (may be empty if arrow is primitive)\n  primitive_needs = cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  if \"_at\" in recipe:\n      workshop_idx = cookbook.index[recipe[\"_at\"]]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  from collections import deque\n  import numpy as np\n\n  def bfs_path(start, goal, occupied):\n      \"\"\"\n      Return a list of positions (excluding *start*, including *goal*)\n      that leads from start to goal moving only through cells where\n      occupied == False. The goal cell may be occupied (e.g., a resource or\n      workshop).\n      \"\"\"\n      w, h = occupied.shape\n      visited = np.zeros((w, h), dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start] = True\n      while q:\n          x, y = q.popleft()\n          if (x, y) == goal:\n              break\n          for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):\n              if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:\n                  # Allow stepping onto the goal even if occupied\n                  if (nx, ny) == goal or not occupied[nx, ny]:\n                      visited[nx, ny] = True\n                      prev[(nx, ny)] = (x, y)\n                      q.append((nx, ny))\n      if not visited[goal]:\n          return None\n      # Reconstruct path backwards\n      path = []\n      cur = goal\n      while cur != start:\n          path.append(cur)\n          cur = prev[cur]\n      path.reverse()\n      return path\n\n  def delta_to_action(dx, dy):\n      \"\"\"Map a movement delta to the environment's action index.\"\"\"\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise ValueError(\"Invalid movement delta\")\n\n  # ------------------------------------------------------------------\n  # Planning: collect primitives then craft at workshop (if any)\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = tuple(state.pos)          # current (x, y) of the agent\n  # Make a mutable copy of the grid to keep track of collected items\n  grid = state.grid.copy()\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitive items\n  # ------------------------------------------------------------------\n  for kind_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          # Find all remaining cells that contain this primitive\n          candidates = np.argwhere(grid[:, :, kind_idx] > 0)\n          if candidates.size == 0:\n              break  # no more instances left on the map\n          # Order candidates by Manhattan distance from current position\n          dists = np.abs(candidates[:, 0] - cur_pos[0]) + np.abs(candidates[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n\n          occupied_mask = np.any(grid, axis=2)   # treat any entity as blocked\n          target = None\n          path = None\n          for idx in order:\n              cand = tuple(candidates[idx])\n              p = bfs_path(cur_pos, cand, occupied_mask)\n              if p is not None:\n                  target = cand\n                  path = p\n                  break\n          if target is None:\n              # Could not reach any remaining instance; skip this primitive\n              continue\n\n          # Follow the path, emitting movement actions\n          for step in path:\n              dx = step[0] - cur_pos[0]\n              dy = step[1] - cur_pos[1]\n              actions.append(delta_to_action(dx, dy))\n              cur_pos = step\n          # Use action to pick up the primitive\n          actions.append(4)          # USE\n          # Mark the primitive as collected in our mutable grid copy\n          grid[target[0], target[1], kind_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 2) Move to the required workshop (if any) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          dists = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n          occupied_mask = np.any(state.grid, axis=2)   # original grid (workshops occupy cells)\n          for idx in order:\n              cand = tuple(workshop_cells[idx])\n              p = bfs_path(cur_pos, cand, occupied_mask)\n              if p is not None:\n                  for step in p:\n                      dx = step[0] - cur_pos[0]\n                      dy = step[1] - cur_pos[1]\n                      actions.append(delta_to_action(dx, dy))\n                      cur_pos = step\n                  actions.append(4)   # USE to trigger crafting\n                  break\n  else:\n      # No specific workshop required; simply use the current cell to craft\n      actions.append(4)\n\n  return actions", "env_interactions": 26, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T18:52:21.217097", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Reset environment and fetch core objects\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world\n  cookbook = world.cookbook\n\n  # --------------------------------------------------------------\n  # Identify goal (arrow) and its recipe\n  # --------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n  if goal_idx is None:\n      return []                       # unknown goal\n\n  # Primitive ingredients required to craft the goal\n  primitive_needs = cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  if \"_at\" in recipe:\n      workshop_idx = cookbook.index[recipe[\"_at\"]]\n\n  # --------------------------------------------------------------\n  # Helper utilities\n  # --------------------------------------------------------------\n  def bfs_path(start, goal, occupied):\n      \"\"\"Return a list of positions from start (excluded) to goal (included)\n      moving only through cells where `occupied` is False. The goal cell may be occupied.\"\"\"\n      w, h = occupied.shape\n      visited = np.zeros((w, h), dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start] = True\n      while q:\n          x, y = q.popleft()\n          if (x, y) == goal:\n              break\n          for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):\n              if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:\n                  if (nx, ny) == goal or not occupied[nx, ny]:\n                      visited[nx, ny] = True\n                      prev[(nx, ny)] = (x, y)\n                      q.append((nx, ny))\n      if not visited[goal]:\n          return None\n      # reconstruct path (exclude start, include goal)\n      path = []\n      cur = goal\n      while cur != start:\n          path.append(cur)\n          cur = prev[cur]\n      path.reverse()\n      return path\n\n  def delta_to_action(dx, dy):\n      \"\"\"Map a movement delta to the environment's action index.\"\"\"\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise ValueError(\"Invalid movement delta\")\n\n  # --------------------------------------------------------------\n  # Planning: collect primitives then craft at workshop (if any)\n  # --------------------------------------------------------------\n  actions = []\n  cur_pos = tuple(state.pos)          # current (x, y)\n  # mutable copy of the grid to keep track of collected resources\n  grid = state.grid.copy()\n\n  # --------------------------------------------------------------\n  # 1) Gather required primitive resources\n  # --------------------------------------------------------------\n  for kind_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          # Locate remaining instances of this primitive\n          locations = np.argwhere(grid[:, :, kind_idx] > 0)\n          if locations.size == 0:\n              break  # no more of this primitive on the map\n          # Order by Manhattan distance from current position\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n\n          occupied_mask = np.any(grid, axis=2)   # treat any entity as blocked\n          target = None\n          path = None\n          for idx in order:\n              cand = tuple(locations[idx])\n              p = bfs_path(cur_pos, cand, occupied_mask)\n              if p is not None:\n                  target = cand\n                  path = p\n                  break\n          if target is None:\n              # Could not reach any remaining instance; skip this primitive\n              continue\n\n          # Follow the path, emitting movement actions\n          for step in path:\n              dx = step[0] - cur_pos[0]\n              dy = step[1] - cur_pos[1]\n              actions.append(delta_to_action(dx, dy))\n              cur_pos = step\n          # Pick up the primitive\n          actions.append(4)          # USE\n          grid[target[0], target[1], kind_idx] = 0   # mark as collected\n\n  # --------------------------------------------------------------\n  # 2) Move to workshop (if required) and craft the arrow\n  # --------------------------------------------------------------\n  if workshop_idx is not None:\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          dists = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n          occupied_mask = np.any(state.grid, axis=2)   # original grid (workshops occupy cells)\n          for idx in order:\n              cand = tuple(workshop_cells[idx])\n              p = bfs_path(cur_pos, cand, occupied_mask)\n              if p is not None:\n                  for step in p:\n                      dx = step[0] - cur_pos[0]\n                      dy = step[1] - cur_pos[1]\n                      actions.append(delta_to_action(dx, dy))\n                      cur_pos = step\n                  actions.append(4)   # USE to trigger crafting\n                  break\n  else:\n      # No specific workshop required; use current cell to craft\n      actions.append(4)\n\n  return actions", "env_interactions": 26, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T18:52:45.635607", "function_name": "make_arrow", "function_body": "  import collections\n  import numpy as np\n\n  # reset the environment and get handles to the current state and world\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  idx = world.cookbook.index           # name \u2192 integer id\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow) and its recipe requirements\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = idx[goal_name]\n\n  # primitive resources needed for ONE arrow\n  primitive_needs = world.cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n\n  # workshop (if any) where the arrow must be crafted\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else idx[wk]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def locate(kind, grid):\n      \"\"\"Return list of (x, y) where `kind` occurs on `grid`.\"\"\"\n      occ = np.where(grid[:, :, kind] > 0)\n      return list(zip(occ[0].tolist(), occ[1].tolist()))\n\n  def bfs(start, goal, blocked):\n      \"\"\"Return shortest 4\u2011connected path from start to goal avoiding `blocked` cells.\"\"\"\n      if start == goal:\n          return [start]\n      W, H = state.grid.shape[:2]\n      q = collections.deque([start])\n      prev = {start: None}\n      while q:\n          cur = q.popleft()\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:\n                  nxt = (nx, ny)\n                  if nxt not in prev:\n                      prev[nxt] = cur\n                      if nxt == goal:\n                          # reconstruct path\n                          path = [goal]\n                          while path[-1] != start:\n                              path.append(prev[path[-1]])\n                          path.reverse()\n                          return path\n                      q.append(nxt)\n      # unreachable \u2013 stay put\n      return [start]\n\n  def move_action(cur, nxt):\n      \"\"\"Translate a step between adjacent cells into a DMLab action index.\"\"\"\n      dx, dy = nxt[0] - cur[0], nxt[1] - cur[1]\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise AssertionError(\"Requested move is not to an adjacent cell\")\n\n  # ------------------------------------------------------------------\n  # Prepare mutable copies of grid and inventory for planning\n  # ------------------------------------------------------------------\n  grid = state.grid.copy()\n  inventory = state.inventory.copy()\n  cur_pos = state.pos\n  actions = []\n\n  # cells occupied by non\u2011grabbable entities are blocked for movement\n  blocked_cells = set()\n  for ng in world.non_grabbable_indices:\n      occ = np.where(grid[:, :, ng] > 0)\n      blocked_cells.update(zip(occ[0].tolist(), occ[1].tolist()))\n\n  # ------------------------------------------------------------------\n  # 1) Gather all required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitive_needs.items():\n      while inventory[prim_idx] < needed:\n          # find remaining instances of this primitive\n          candidates = locate(prim_idx, grid)\n          if not candidates:\n              # cannot satisfy the recipe \u2013 break to avoid infinite loop\n              break\n          # choose the closest one (Manhattan distance)\n          target = min(candidates,\n                       key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))\n          # move to the target\n          path = bfs(cur_pos, target, blocked_cells)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n          # pick up the primitive\n          actions.append(4)          # USE\n          inventory[prim_idx] += 1\n          grid[target[0], target[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 2) Go to workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      wk_locs = locate(workshop_kind, grid)\n      if wk_locs:\n          target = min(wk_locs,\n                       key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))\n          path = bfs(cur_pos, target, blocked_cells)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n  # craft (USE at current location)\n  actions.append(4)          # USE\n\n  return actions", "env_interactions": 19, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T18:52:46.764402", "function_name": "make_arrow", "function_body": "  # Reset the environment and fetch the current state and world objects.\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  idx = world.cookbook.index           # name \u2192 integer id\n\n  # ------------------------------------------------------------------\n  # Identify the goal (\"arrow\") and its recipe requirements.\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = idx[goal_name]\n\n  # Primitive resources required for ONE arrow.\n  primitive_needs = world.cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n\n  # Workshop kind required for crafting (may be None).\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else idx[wk]\n\n  # ------------------------------------------------------------------\n  # Helper utilities.\n  # ------------------------------------------------------------------\n  def locate(kind):\n      \"\"\"Return a list of (x, y) positions where `kind` appears on the grid.\"\"\"\n      occ = np.where(state.grid[:, :, kind] > 0)\n      return list(zip(occ[0].tolist(), occ[1].tolist()))\n\n  def blocked_cells():\n      \"\"\"Set of positions occupied by non\u2011grabbable entities.\"\"\"\n      blocked = set()\n      for ng in world.non_grabbable_indices:\n          occ = np.where(state.grid[:, :, ng] > 0)\n          blocked.update(zip(occ[0].tolist(), occ[1].tolist()))\n      return blocked\n\n  def bfs(start, goal):\n      \"\"\"Return a shortest 4\u2011connected path from `start` to `goal` (list of positions).\"\"\"\n      if start == goal:\n          return [start]\n      W, H = state.grid.shape[:2]\n      blocked = blocked_cells()\n\n      q = collections.deque([start])\n      prev = {start: None}\n      while q:\n          cur = q.popleft()\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:\n                  nxt = (nx, ny)\n                  if nxt not in prev:\n                      prev[nxt] = cur\n                      if nxt == goal:\n                          # reconstruct path\n                          path = [goal]\n                          while path[-1] != start:\n                              path.append(prev[path[-1]])\n                          path.reverse()\n                          return path\n                      q.append(nxt)\n      # No path found \u2013 stay where we are.\n      return [start]\n\n  def move_action(cur, nxt):\n      \"\"\"Translate a step between adjacent cells into a DMLab action index.\"\"\"\n      dx, dy = nxt[0] - cur[0], nxt[1] - cur[1]\n      if dx == 1:\n          return 3   # RIGHT\n      if dx == -1:\n          return 2   # LEFT\n      if dy == 1:\n          return 0   # DOWN\n      if dy == -1:\n          return 1   # UP\n      raise AssertionError(\"Requested move is not between adjacent cells\")\n\n  # ------------------------------------------------------------------\n  # Build the action sequence.\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = state.pos\n\n  # ------------------------------------------------------------------\n  # 1) Gather all required primitives.\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitive_needs.items():\n      while state.inventory[prim_idx] < needed:\n          candidates = locate(prim_idx)\n          if not candidates:\n              # No more instances of this primitive on the map \u2013 give up.\n              break\n\n          # Choose the closest candidate by Manhattan distance.\n          target = min(\n              candidates,\n              key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1])\n          )\n\n          # Move to the target cell.\n          path = bfs(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n\n          # Pick up the primitive.\n          actions.append(4)                     # USE\n          state.inventory[prim_idx] += 1\n          state.grid[target[0], target[1], prim_idx] = 0  # remove from world\n\n  # ------------------------------------------------------------------\n  # 2) Go to the workshop (if required) and craft the arrow.\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      wk_locs = locate(workshop_kind)\n      if wk_locs:\n          target = min(\n              wk_locs,\n              key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1])\n          )\n          path = bfs(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n\n  # Craft the arrow (USE at current location).\n  actions.append(4)   # USE\n\n  return actions", "env_interactions": 19, "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T18:53:14.101418", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Reset environment and obtain current state and world information\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world\n  cookbook = world.cookbook\n\n  # --------------------------------------------------------------\n  # Identify goal (arrow) and its recipe\n  # --------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n  if goal_idx is None:\n      return []                       # unknown goal\n\n  # Primitive requirements for one arrow\n  primitive_needs = cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  if \"_at\" in recipe:\n      workshop_idx = cookbook.index[recipe[\"_at\"]]\n\n  # --------------------------------------------------------------\n  # Helper utilities\n  # --------------------------------------------------------------\n  def bfs_path(start, goal, occupied):\n      \"\"\"Return a list of positions from start (excluded) to goal (included)\n      using 4\u2011directional movement, avoiding occupied cells.\"\"\"\n      w, h = occupied.shape\n      visited = np.zeros((w, h), dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start] = True\n      while q:\n          x, y = q.popleft()\n          if (x, y) == goal:\n              break\n          for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):\n              if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:\n                  if (nx, ny) == goal or not occupied[nx, ny]:\n                      visited[nx, ny] = True\n                      prev[(nx, ny)] = (x, y)\n                      q.append((nx, ny))\n      if not visited[goal]:\n          return None\n      path = []\n      cur = goal\n      while cur != start:\n          path.append(cur)\n          cur = prev[cur]\n      path.reverse()\n      return path\n\n  def delta_to_action(dx, dy):\n      \"\"\"Convert a movement delta to the environment's action index.\"\"\"\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise ValueError(\"Invalid movement delta\")\n\n  # --------------------------------------------------------------\n  # Planning\n  # --------------------------------------------------------------\n  actions = []\n  cur_pos = tuple(state.pos)                     # current (x, y)\n  grid = state.grid.copy()                       # mutable copy for tracking pickups\n  occupied_mask = np.any(grid, axis=2)           # cells that block movement\n\n  # --------------------------------------------------------------\n  # 1) Collect required primitives\n  # --------------------------------------------------------------\n  for kind_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          # Find remaining instances of this primitive on the map\n          candidates = np.argwhere(grid[:, :, kind_idx] > 0)\n          if candidates.size == 0:\n              break\n\n          # Sort candidates by Manhattan distance from current position\n          dists = np.abs(candidates[:, 0] - cur_pos[0]) + np.abs(candidates[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n\n          target = None\n          path = None\n          for idx in order:\n              cand = tuple(candidates[idx])\n              p = bfs_path(cur_pos, cand, occupied_mask)\n              if p is not None:\n                  target = cand\n                  path = p\n                  break\n\n          if path is None:\n              continue    # cannot reach any remaining instance\n\n          # Follow the path to the primitive\n          for step in path:\n              dx = step[0] - cur_pos[0]\n              dy = step[1] - cur_pos[1]\n              actions.append(delta_to_action(dx, dy))\n              cur_pos = step\n\n          # Pick up the primitive\n          actions.append(4)          # USE\n          grid[target[0], target[1], kind_idx] = 0\n          occupied_mask = np.any(grid, axis=2)\n\n  # --------------------------------------------------------------\n  # 2) Move to the required workshop (if any) and craft the arrow\n  # --------------------------------------------------------------\n  if workshop_idx is not None:\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          dists = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n          for idx in order:\n              target = tuple(workshop_cells[idx])\n              p = bfs_path(cur_pos, target, occupied_mask)\n              if p is not None:\n                  for step in p:\n                      dx = step[0] - cur_pos[0]\n                      dy = step[1] - cur_pos[1]\n                      actions.append(delta_to_action(dx, dy))\n                      cur_pos = step\n                  actions.append(4)   # USE to craft at the workshop\n                  break\n  else:\n      # No specific workshop required; craft at current location\n      actions.append(4)   # USE to craft\n\n  return actions", "env_interactions": 26, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T18:53:15.227894", "function_name": "make_arrow", "function_body": "  # Reset environment and get current state and world information\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world\n  cookbook = world.cookbook\n\n  # --------------------------------------------------------------\n  # Identify the goal (arrow) and its recipe\n  # --------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n  if goal_idx is None:\n      return []                       # unknown goal\n\n  # Primitive requirements for one arrow\n  primitive_needs = cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  if \"_at\" in recipe:\n      workshop_idx = cookbook.index[recipe[\"_at\"]]\n\n  # --------------------------------------------------------------\n  # Helper utilities\n  # --------------------------------------------------------------\n  from collections import deque\n  import numpy as np\n\n  def bfs_path(start, goal, occupied):\n      \"\"\"Find a walkable path from start to goal on the grid.\n      `occupied` is a 2\u2011D boolean mask where True means the cell blocks movement.\n      Returns list of positions (excluding start, including goal) or None if no path.\"\"\"\n      w, h = occupied.shape\n      visited = np.zeros((w, h), dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start] = True\n      while q:\n          x, y = q.popleft()\n          if (x, y) == goal:\n              break\n          for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):\n              if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:\n                  if (nx, ny) == goal or not occupied[nx, ny]:\n                      visited[nx, ny] = True\n                      prev[(nx, ny)] = (x, y)\n                      q.append((nx, ny))\n      if not visited[goal]:\n          return None\n      # reconstruct path\n      path = []\n      cur = goal\n      while cur != start:\n          path.append(cur)\n          cur = prev[cur]\n      path.reverse()\n      return path\n\n  def delta_to_action(dx, dy):\n      \"\"\"Convert a movement delta into the environment's action index.\"\"\"\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise ValueError(\"Invalid movement delta\")\n\n  # --------------------------------------------------------------\n  # Planning\n  # --------------------------------------------------------------\n  actions = []\n  cur_pos = tuple(state.pos)\n  # Make a mutable copy of the grid to keep track of which primitives have been taken\n  grid = state.grid.copy()\n\n  # --------------------------------------------------------------\n  # 1) Collect all required primitives\n  # --------------------------------------------------------------\n  for kind_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          # Find all remaining cells containing this primitive\n          candidates = np.argwhere(grid[:, :, kind_idx] > 0)\n          if candidates.size == 0:\n              # No more of this primitive left \u2013 cannot fulfill the task\n              return actions\n          # Sort candidates by Manhattan distance from current position\n          dists = np.abs(candidates[:, 0] - cur_pos[0]) + np.abs(candidates[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n\n          occupied_mask = np.any(grid, axis=2)   # any entity (including other primitives) blocks movement\n          target = None\n          path = None\n          for idx in order:\n              cand = tuple(candidates[idx])\n              p = bfs_path(cur_pos, cand, occupied_mask)\n              if p is not None:\n                  target = cand\n                  path = p\n                  break\n          if path is None:\n              # Unable to reach any remaining instance of this primitive\n              return actions\n\n          # Follow the path to the target primitive\n          for step in path:\n              dx = step[0] - cur_pos[0]\n              dy = step[1] - cur_pos[1]\n              actions.append(delta_to_action(dx, dy))\n              cur_pos = step\n\n          # Pick up the primitive\n          actions.append(4)          # USE\n          # Remove it from the mutable grid so it no longer blocks movement\n          grid[target[0], target[1], kind_idx] = 0\n\n  # --------------------------------------------------------------\n  # 2) Move to the appropriate workshop (if required) and craft\n  # --------------------------------------------------------------\n  if workshop_idx is not None:\n      # Locate all workshop cells of the required type\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          dists = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n          # Use the original static occupancy (items we have already collected are already cleared)\n          occupied_mask = np.any(state.grid, axis=2)\n          for idx in order:\n              target = tuple(workshop_cells[idx])\n              p = bfs_path(cur_pos, target, occupied_mask)\n              if p is not None:\n                  for step in p:\n                      dx = step[0] - cur_pos[0]\n                      dy = step[1] - cur_pos[1]\n                      actions.append(delta_to_action(dx, dy))\n                      cur_pos = step\n                  actions.append(4)   # USE to craft at the workshop\n                  break\n  else:\n      # No specific workshop required \u2013 craft at current location\n      actions.append(4)   # USE\n\n  return actions", "env_interactions": 26, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T18:53:40.491405", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n\n  # ------------------------------------------------------------\n  # Identify the goal index for the \"arrow\" item.\n  # ------------------------------------------------------------\n  if hasattr(env, \"task\") and hasattr(env.task, \"goal\"):\n      goal_idx = env.task.goal\n  else:\n      goal_idx = env.world.cookbook.index.get(\"arrow\")\n      if goal_idx is None:\n          raise ValueError(\"Goal item 'arrow' not found in cookbook\")\n\n  # ------------------------------------------------------------\n  # Action constants.\n  # ------------------------------------------------------------\n  act_spec = env.action_specs()\n  ACT_DOWN = act_spec[\"DOWN\"]\n  ACT_UP = act_spec[\"UP\"]\n  ACT_LEFT = act_spec[\"LEFT\"]\n  ACT_RIGHT = act_spec[\"RIGHT\"]\n  ACT_USE = act_spec[\"USE\"]\n\n  actions = []\n\n  from collections import deque\n\n  # ------------------------------------------------------------\n  # Helper: BFS to compute a sequence of actions from start to target.\n  # ------------------------------------------------------------\n  def bfs_path(start, target):\n      \"\"\"Return a list of actions to move from start to target (both (y,x)).\"\"\"\n      h, w, _ = state.grid.shape\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (y, x), path = q.popleft()\n          if (y, x) == target:\n              return path\n          for dy, dx, act in ((1, 0, ACT_DOWN),\n                              (-1, 0, ACT_UP),\n                              (0, 1, ACT_RIGHT),\n                              (0, -1, ACT_LEFT)):\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < h and 0 <= nx < w and (ny, nx) not in visited:\n                  # Allow stepping onto the target even if occupied.\n                  if not state.grid[ny, nx, :].any() or (ny, nx) == target:\n                      visited.add((ny, nx))\n                      q.append(((ny, nx), path + [act]))\n      return []  # unreachable\n\n  # ------------------------------------------------------------\n  # Helper: Move the agent to an absolute position using bfs_path.\n  # ------------------------------------------------------------\n  def move_to(pos):\n      nonlocal state\n      while state.pos != pos:\n          path = bfs_path(state.pos, pos)\n          if not path:\n              break  # cannot reach target\n          for a in path:\n              actions.append(a)\n              env.step(a)\n              state = env._current_state\n              if state.pos == pos:\n                  break\n\n  # ------------------------------------------------------------\n  # Helper: Find the nearest cell containing a given kind index.\n  # ------------------------------------------------------------\n  def nearest_of_kind(kind_idx):\n      grid = state.grid\n      h, w, _ = grid.shape\n      py, px = state.pos\n      best = None\n      best_dist = None\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  d = abs(i - py) + abs(j - px)\n                  if best_dist is None or d < best_dist:\n                      best_dist = d\n                      best = (i, j)\n      return best\n\n  # ------------------------------------------------------------\n  # Helper: Return a free cell (including the cell itself) adjacent\n  # to the given location. Returns None if no free cell found.\n  # ------------------------------------------------------------\n  def adjacent_free(cell):\n      y, x = cell\n      h, w, _ = state.grid.shape\n      # Prefer the cell itself if it's free.\n      if not state.grid[y, x, :].any():\n          return (y, x)\n      for dy in (-1, 0, 1):\n          for dx in (-1, 0, 1):\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < h and 0 <= nx < w:\n                  if not state.grid[ny, nx, :].any():\n                      return (ny, nx)\n      return None\n\n  # ------------------------------------------------------------\n  # 1) Collect all primitive resources required for the arrow.\n  # ------------------------------------------------------------\n  needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  for kind_idx, count in needed.items():\n      for _ in range(count):\n          src = nearest_of_kind(kind_idx)\n          if src is None:\n              continue  # resource not present\n          adj = adjacent_free(src)\n          if adj is None:\n              continue  # no free adjacent cell\n          move_to(adj)\n          actions.append(ACT_USE)\n          env.step(ACT_USE)\n          state = env._current_state\n\n  # ------------------------------------------------------------\n  # 2) If the recipe requires a workshop, go there and craft.\n  # ------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      ws_idx = env.world.cookbook.index[workshop_name]\n      ws_pos = nearest_of_kind(ws_idx)\n      if ws_pos:\n          adj_ws = adjacent_free(ws_pos)\n          if adj_ws:\n              move_to(adj_ws)\n              actions.append(ACT_USE)\n              env.step(ACT_USE)\n              state = env._current_state\n\n  # Return the computed action sequence.\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": 0.0}}
