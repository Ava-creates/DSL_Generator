{"timestamp": "2025-10-27T19:27:12.851811", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ------------------------------------------------------------------\n  # Initialise environment and retrieve world information\n  # ------------------------------------------------------------------\n  env.reset()\n  state = env._current_state          # CraftState instance\n  world = env.world\n  cookbook = world.cookbook\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow) and its recipe\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n  if goal_idx is None:\n      return []                      # unknown goal, nothing to do\n\n  primitive_needs = cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  if \"_at\" in recipe:\n      workshop_idx = cookbook.index[recipe[\"_at\"]]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def bfs_path(start, goal, occupied):\n      \"\"\"Return a list of positions from start (excluded) to goal (included)\n      moving only through cells where `occupied` is False. Goal cell may be occupied.\"\"\"\n      w, h = occupied.shape\n      visited = np.zeros((w, h), dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start] = True\n      while q:\n          x, y = q.popleft()\n          if (x, y) == goal:\n              break\n          for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):\n              if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:\n                  # Goal cell may be occupied; treat it as walkable.\n                  if (nx, ny) == goal or not occupied[nx, ny]:\n                      visited[nx, ny] = True\n                      prev[(nx, ny)] = (x, y)\n                      q.append((nx, ny))\n      if not visited[goal]:\n          return None\n      # reconstruct path (exclude start, include goal)\n      path = []\n      cur = goal\n      while cur != start:\n          path.append(cur)\n          cur = prev[cur]\n      path.reverse()\n      return path\n\n  def delta_to_action(dx, dy):\n      \"\"\"Convert a movement delta into the corresponding action index.\"\"\"\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise ValueError(\"Invalid movement delta\")\n\n  # ------------------------------------------------------------------\n  # Planning state\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = tuple(state.pos)          # (x, y)\n  grid = state.grid.copy()            # mutable copy to track collected primitives\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitive resources\n  # ------------------------------------------------------------------\n  for kind_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          # Find all remaining cells that contain this primitive\n          locations = np.argwhere(grid[:, :, kind_idx] > 0)\n          if locations.size == 0:\n              break  # no more of this primitive on the map\n\n          # Sort candidates by Manhattan distance from current position\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n\n          occupied_mask = np.any(grid, axis=2)   # any entity blocks movement\n          target = None\n          path = None\n          for idx in order:\n              cand = tuple(locations[idx])\n              p = bfs_path(cur_pos, cand, occupied_mask)\n              if p is not None:\n                  target = cand\n                  path = p\n                  break\n\n          if target is None:\n              # Could not reach any remaining instance; abort further collection of this kind\n              break\n\n          # Follow the path to the primitive\n          for step in path:\n              dx = step[0] - cur_pos[0]\n              dy = step[1] - cur_pos[1]\n              actions.append(delta_to_action(dx, dy))\n              cur_pos = step\n\n          # Pick up the primitive\n          actions.append(4)          # USE\n          grid[target[0], target[1], kind_idx] = 0   # mark as collected\n\n  # ------------------------------------------------------------------\n  # 2) Move to the required workshop (if any) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      # locate workshop cells in the original grid (workshops are static)\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size:\n          dists = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n          occupied_mask = np.any(state.grid, axis=2)   # original occupancy (workshops block movement)\n          for idx in order:\n              cand = tuple(workshop_cells[idx])\n              p = bfs_path(cur_pos, cand, occupied_mask)\n              if p is not None:\n                  for step in p:\n                      dx = step[0] - cur_pos[0]\n                      dy = step[1] - cur_pos[1]\n                      actions.append(delta_to_action(dx, dy))\n                      cur_pos = step\n                  actions.append(4)   # USE at workshop to craft\n                  break\n  else:\n      # No specific workshop required; craft at current location\n      actions.append(4)   # USE\n\n  return actions", "env_interactions": 26, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T19:27:13.982038", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # reset environment and fetch current state / world info\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world\n  cookbook = world.cookbook\n\n  # --------------------------------------------------------------\n  # Identify goal (arrow) and its recipe\n  # --------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n  if goal_idx is None:\n      return []   # unknown goal\n\n  primitive_needs = cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  if \"_at\" in recipe:\n      workshop_idx = cookbook.index[recipe[\"_at\"]]\n\n  # --------------------------------------------------------------\n  # Helper utilities\n  # --------------------------------------------------------------\n  def bfs_path(start, goal, occupied):\n      \"\"\"Return a list of positions from start (excluded) to goal (included)\n      using 4\u2011directional moves, avoiding cells where occupied is True.\n      The goal cell itself may be occupied (e.g., a workshop).\"\"\"\n      w, h = occupied.shape\n      visited = np.zeros((w, h), dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start] = True\n      while q:\n          x, y = q.popleft()\n          if (x, y) == goal:\n              break\n          for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):\n              if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:\n                  if (nx, ny) == goal or not occupied[nx, ny]:\n                      visited[nx, ny] = True\n                      prev[(nx, ny)] = (x, y)\n                      q.append((nx, ny))\n      if not visited[goal]:\n          return None\n      # reconstruct path (exclude start, include goal)\n      path = []\n      cur = goal\n      while cur != start:\n          path.append(cur)\n          cur = prev[cur]\n      path.reverse()\n      return path\n\n  def delta_to_action(dx, dy):\n      \"\"\"Map a movement delta to the environment's action index.\"\"\"\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise ValueError(\"Invalid movement delta\")\n\n  # --------------------------------------------------------------\n  # Planning\n  # --------------------------------------------------------------\n  actions = []\n  cur_pos = tuple(state.pos)                     # (x, y)\n  grid = state.grid.copy()                       # mutable copy for tracking pickups\n\n  # --------------------------------------------------------------\n  # 1) Collect required primitives\n  # --------------------------------------------------------------\n  for kind_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          # locate remaining instances of this primitive\n          candidates = np.argwhere(grid[:, :, kind_idx] > 0)\n          if candidates.size == 0:\n              break\n\n          # sort by Manhattan distance from current position\n          dists = np.abs(candidates[:, 0] - cur_pos[0]) + np.abs(candidates[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n\n          occupied_mask = np.any(grid, axis=2)   # cells blocking movement\n          target = None\n          path = None\n          for idx in order:\n              cand = tuple(candidates[idx])\n              p = bfs_path(cur_pos, cand, occupied_mask)\n              if p is not None:\n                  target = cand\n                  path = p\n                  break\n          if path is None:\n              continue    # cannot reach any remaining instance\n\n          # follow path\n          for step in path:\n              dx = step[0] - cur_pos[0]\n              dy = step[1] - cur_pos[1]\n              actions.append(delta_to_action(dx, dy))\n              cur_pos = step\n\n          # pick up primitive\n          actions.append(4)          # USE\n          grid[target[0], target[1], kind_idx] = 0   # mark as collected\n\n  # --------------------------------------------------------------\n  # 2) Move to workshop (if required) and craft the arrow\n  # --------------------------------------------------------------\n  if workshop_idx is not None:\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size:\n          dists = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n          occupied_mask = np.any(state.grid, axis=2)   # original occupancy (workshops block)\n          for idx in order:\n              target = tuple(workshop_cells[idx])\n              p = bfs_path(cur_pos, target, occupied_mask)\n              if p is not None:\n                  for step in p:\n                      dx = step[0] - cur_pos[0]\n                      dy = step[1] - cur_pos[1]\n                      actions.append(delta_to_action(dx, dy))\n                      cur_pos = step\n                  actions.append(4)   # USE to craft at workshop\n                  break\n  else:\n      # no specific workshop needed; craft at current location\n      actions.append(4)   # USE\n\n  return actions", "env_interactions": 26, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T19:27:32.990585", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  def _manhattan_path(src, dst):\n      \"\"\"Return a list of actions that move from src to dst using Manhattan moves.\"\"\"\n      actions = []\n      x, y = src\n      tx, ty = dst\n      while x < tx:\n          actions.append(DOWN)\n          x += 1\n      while x > tx:\n          actions.append(UP)\n          x -= 1\n      while y < ty:\n          actions.append(RIGHT)\n          y += 1\n      while y > ty:\n          actions.append(LEFT)\n          y -= 1\n      return actions\n\n  def _nearest_entity(pos, kind_idx):\n      \"\"\"Find the closest cell (Manhattan distance) that contains the given kind.\"\"\"\n      grid = env._current_state.grid\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n      best = int(np.argmin(dists))\n      return tuple(locations[best])\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow) and its recipe\n  # ------------------------------------------------------------------\n  world = env.world\n  idx_arrow = world.cookbook.index.index('arrow')\n  primitives_needed = world.cookbook.primitives_for(idx_arrow)  # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Collect all required primitives\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = env._current_state.pos\n\n  for prim_idx, cnt in primitives_needed.items():\n      for _ in range(cnt):\n          target = _nearest_entity(cur_pos, prim_idx)\n          if target is None:\n              # Primitive not present \u2013 abort early\n              return actions\n          actions += _manhattan_path(cur_pos, target)\n          cur_pos = target\n          actions.append(USE)   # pick up the primitive\n\n  # ------------------------------------------------------------------\n  # Move to the appropriate workshop (if any) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(idx_arrow, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = _nearest_entity(cur_pos, workshop_idx)\n      if workshop_pos is not None:\n          actions += _manhattan_path(cur_pos, workshop_pos)\n          cur_pos = workshop_pos\n          actions.append(USE)   # craft at the workshop\n  else:\n      # No specific workshop required; craft at current location\n      actions.append(USE)\n\n  return actions", "env_interactions": 22, "island_id": 0, "scores": {"3": 0.2}}
{"timestamp": "2025-10-27T19:27:34.147479", "function_name": "make_arrow", "function_body": "  # Action indices (assumed standard in CraftWorld)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper functions\n  # ------------------------------------------------------------------\n  def _manhattan_path(src, dst):\n      \"\"\"Return a list of actions moving from src to dst using Manhattan moves.\"\"\"\n      actions = []\n      x, y = src\n      tx, ty = dst\n      # vertical movement (row index)\n      while x < tx:\n          actions.append(DOWN)\n          x += 1\n      while x > tx:\n          actions.append(UP)\n          x -= 1\n      # horizontal movement (col index)\n      while y < ty:\n          actions.append(RIGHT)\n          y += 1\n      while y > ty:\n          actions.append(LEFT)\n          y -= 1\n      return actions\n\n  def _nearest_entity(pos, kind_idx):\n      \"\"\"Find the closest cell (Manhattan distance) containing the given kind.\"\"\"\n      grid = env._current_state.grid\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n      best = int(np.argmin(dists))\n      return tuple(locations[best])\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow) and its recipe\n  # ------------------------------------------------------------------\n  world = env.world\n  arrow_idx = world.cookbook.index.index('arrow')\n  primitives_needed = world.cookbook.primitives_for(arrow_idx)  # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Collect all required primitives\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = env._current_state.pos\n\n  for prim_idx, required_cnt in primitives_needed.items():\n      for _ in range(required_cnt):\n          target = _nearest_entity(cur_pos, prim_idx)\n          if target is None:\n              # Primitive not present \u2013 abort early\n              return actions\n          actions += _manhattan_path(cur_pos, target)\n          cur_pos = target\n          actions.append(USE)   # pick up the primitive\n\n  # ------------------------------------------------------------------\n  # Move to the appropriate workshop (if any) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = _nearest_entity(cur_pos, workshop_idx)\n      if workshop_pos is not None:\n          actions += _manhattan_path(cur_pos, workshop_pos)\n          cur_pos = workshop_pos\n          actions.append(USE)   # craft at the workshop\n\n  return actions", "env_interactions": 22, "island_id": 0, "scores": {"3": 0.2}}
{"timestamp": "2025-10-27T19:28:09.396695", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Identify goal and its requirements\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n  if goal_idx is None:\n      return actions\n\n  primitive_needs = cookbook.primitives_for(goal_idx)          # {kind_idx: count}\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  if \"_at\" in recipe:\n      workshop_idx = cookbook.index[recipe[\"_at\"]]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  from collections import deque\n  import numpy as np\n\n  def bfs_path(start, goal, occupied):\n      \"\"\"Return a list of positions from start (excluded) to goal (included)\n      moving only through cells where occupied==False.  The goal cell may be\n      occupied (e.g., a resource or workshop).\"\"\"\n      w, h = occupied.shape\n      visited = np.zeros((w, h), dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start] = True\n      while q:\n          x, y = q.popleft()\n          if (x, y) == goal:\n              break\n          for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):\n              if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:\n                  if (nx, ny) == goal or not occupied[nx, ny]:\n                      visited[nx, ny] = True\n                      prev[(nx, ny)] = (x, y)\n                      q.append((nx, ny))\n      if not visited[goal]:\n          return None\n      # reconstruct path\n      path = []\n      cur = goal\n      while cur != start:\n          path.append(cur)\n          cur = prev[cur]\n      path.reverse()\n      return path\n\n  def delta_to_action(dx, dy):\n      \"\"\"Map a movement delta to the environment's action index.\"\"\"\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise ValueError(\"Invalid movement delta\")\n\n  # ------------------------------------------------------------------\n  # Planning\n  # ------------------------------------------------------------------\n  cur_pos = tuple(state.pos)            # current (x, y)\n  grid = state.grid.copy()              # mutable copy for tracking pickups\n\n  # --------------------------------------------------------------\n  # 1) Collect all required primitive resources\n  # --------------------------------------------------------------\n  for kind_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          # locate remaining instances of this primitive\n          candidates = np.argwhere(grid[:, :, kind_idx] > 0)\n          if candidates.size == 0:\n              break\n\n          # order candidates by Manhattan distance for efficiency\n          dists = np.abs(candidates[:, 0] - cur_pos[0]) + np.abs(candidates[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n\n          occupied = np.any(grid, axis=2)        # treat any entity as blocked\n          target = None\n          path = None\n          for idx in order:\n              cand = tuple(candidates[idx])\n              p = bfs_path(cur_pos, cand, occupied)\n              if p is not None:\n                  target = cand\n                  path = p\n                  break\n          if target is None:\n              # cannot reach any remaining instance of this primitive\n              break\n\n          # follow the path\n          for step in path:\n              dx = step[0] - cur_pos[0]\n              dy = step[1] - cur_pos[1]\n              actions.append(delta_to_action(dx, dy))\n              cur_pos = step\n\n          # pick up the primitive\n          actions.append(4)                     # USE\n          grid[target[0], target[1], kind_idx] = 0\n\n  # --------------------------------------------------------------\n  # 2) Move to the required workshop (if any) and craft the arrow\n  # --------------------------------------------------------------\n  if workshop_idx is not None:\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          occupied = np.any(state.grid, axis=2)   # original grid occupancy\n          dists = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n          for idx in order:\n              cand = tuple(workshop_cells[idx])\n              p = bfs_path(cur_pos, cand, occupied)\n              if p is not None:\n                  for step in p:\n                      dx = step[0] - cur_pos[0]\n                      dy = step[1] - cur_pos[1]\n                      actions.append(delta_to_action(dx, dy))\n                      cur_pos = step\n                  actions.append(4)                 # USE to craft\n                  break\n  else:\n      # No specific workshop; craft at current location\n      actions.append(4)                         # USE\n\n  return actions", "env_interactions": 26, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T19:28:10.523674", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  # Target item\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n  if goal_idx is None:\n      return []\n\n  # Primitives required (recursive)\n  primitive_needs = cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  if \"_at\" in recipe:\n      workshop_idx = cookbook.index[recipe[\"_at\"]]\n\n  from collections import deque\n  import numpy as np\n\n  def bfs_path(start, goal, occupied):\n      \"\"\"Return a list of positions from start (excluded) to goal (included).\"\"\"\n      w, h = occupied.shape\n      visited = np.zeros((w, h), dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start] = True\n      while q:\n          x, y = q.popleft()\n          if (x, y) == goal:\n              break\n          for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):\n              if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:\n                  # allow stepping onto goal even if occupied\n                  if (nx, ny) == goal or not occupied[nx, ny]:\n                      visited[nx, ny] = True\n                      prev[(nx, ny)] = (x, y)\n                      q.append((nx, ny))\n      if not visited[goal]:\n          return None\n      # reconstruct path\n      path = []\n      cur = goal\n      while cur != start:\n          path.append(cur)\n          cur = prev[cur]\n      path.reverse()\n      return path\n\n  def delta_to_action(dx, dy):\n      \"\"\"Convert a movement delta into the environment's action index.\"\"\"\n      if dx == 1:\n          return 3  # RIGHT\n      if dx == -1:\n          return 2  # LEFT\n      if dy == 1:\n          return 0  # DOWN\n      if dy == -1:\n          return 1  # UP\n      raise ValueError(\"Invalid movement delta\")\n\n  actions = []\n  cur_pos = tuple(state.pos)\n  # mutable copy to track collected primitives\n  grid = state.grid.copy()\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitive resources\n  # ------------------------------------------------------------------\n  for kind_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          locations = np.argwhere(grid[:, :, kind_idx] > 0)\n          if locations.size == 0:\n              break\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n\n          occupied_mask = np.any(grid, axis=2)  # any entity blocks movement\n          target = None\n          path = None\n          for idx in order:\n              cand = tuple(locations[idx])\n              p = bfs_path(cur_pos, cand, occupied_mask)\n              if p is not None:\n                  target = cand\n                  path = p\n                  break\n          if target is None:\n              continue  # cannot reach this primitive\n\n          for step in path:\n              dx = step[0] - cur_pos[0]\n              dy = step[1] - cur_pos[1]\n              actions.append(delta_to_action(dx, dy))\n              cur_pos = step\n          actions.append(4)  # USE to pick up\n          grid[target[0], target[1], kind_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 2) Move to workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          dists = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n          occupied_mask = np.any(state.grid, axis=2)  # original grid (workshops occupied)\n          for idx in order:\n              wpos = tuple(workshop_cells[idx])\n              p = bfs_path(cur_pos, wpos, occupied_mask)\n              if p is not None:\n                  for step in p:\n                      dx = step[0] - cur_pos[0]\n                      dy = step[1] - cur_pos[1]\n                      actions.append(delta_to_action(dx, dy))\n                      cur_pos = step\n                  actions.append(4)  # USE to craft\n                  break\n  else:\n      # No specific workshop needed; craft at current location\n      actions.append(4)\n\n  return actions", "env_interactions": 26, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T19:28:41.483146", "function_name": "make_arrow", "function_body": "  # Reset the environment (ignore errors if already reset)\n  try:\n      env.reset()\n  except Exception:\n      pass\n\n  # Get the current CraftState\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []\n\n  # Shortcut references\n  world = env.world\n  idx = world.cookbook.index\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow) and its recipe\n  # ------------------------------------------------------------------\n  try:\n      goal_idx = idx[\"arrow\"]\n  except Exception:\n      return []                     # no arrow defined in the index\n\n  # Primitive requirements for a single arrow\n  primitives_needed = world.cookbook.primitives_for(goal_idx)\n\n  # Find the workshop name required for crafting the arrow\n  workshop_name = None\n  for k, v in world.cookbook.recipes.get(goal_idx, {}).items():\n      if k in (\"_at\", \"_key\"):\n          workshop_name = v\n          break\n  if workshop_name is None:\n      return []                     # recipe missing workshop info\n\n  try:\n      workshop_idx = idx[workshop_name]\n  except Exception:\n      return []                     # workshop not indexed\n\n  # ------------------------------------------------------------------\n  # Local mutable copies for planning simulation\n  # ------------------------------------------------------------------\n  pos = tuple(state.pos)                     # current (x, y) position\n  grid = state.grid.copy()                   # (W, H, n_kinds) occupancy\n  inventory = state.inventory.copy()\n  occupied = np.any(grid > 0, axis=2)        # bool matrix of blocked cells\n  plan = []                                   # list of actions to return\n\n  # ------------------------------------------------------------------\n  # Constants and helper functions\n  # ------------------------------------------------------------------\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # DOWN, UP, LEFT, RIGHT\n  USE = 4\n\n  from collections import deque\n\n  def bfs_adjacent(start, target, blocked):\n      \"\"\"Return a list of actions moving from *start* to any empty cell\n      that is 4\u2011connected to *target*. Empty list if unreachable.\"\"\"\n      h, w = blocked.shape\n      tx, ty = target\n      goal_cells = []\n      for a, (dx, dy) in enumerate(DIRS):\n          gx, gy = tx + dx, ty + dy\n          if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:\n              goal_cells.append((gx, gy))\n      if not goal_cells:\n          return []                     # target completely surrounded\n\n      q = deque([(start, [])])\n      visited = {start}\n      while q:\n          (cx, cy), path = q.popleft()\n          if (cx, cy) in goal_cells:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []                         # unreachable\n\n  def move_and_use(target, kind_idx):\n      \"\"\"Move adjacent to *target* (containing *kind_idx*) and issue USE.\n      Updates simulated position, grid, occupied mask and inventory.\n      Returns False if movement is impossible.\"\"\"\n      nonlocal pos, plan, grid, occupied, inventory\n      path = bfs_adjacent(pos, target, occupied)\n      if not path and pos != target:\n          return False\n      # Simulate movement\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n      plan.extend(path)\n\n      # Issue USE\n      plan.append(USE)\n\n      tx, ty = target\n      if grid[tx, ty, kind_idx] > 0:\n          grid[tx, ty, kind_idx] = 0\n          occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)\n          inventory[kind_idx] += 1\n      return True\n\n  # ------------------------------------------------------------------\n  # Collect all required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      for _ in range(needed_cnt):\n          locations = np.argwhere(grid[:, :, prim_idx] > 0)\n          if locations.size == 0:\n              # Primitive not present \u2013 abort planning\n              return plan\n          # Choose the nearest instance (Manhattan distance)\n          dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n          target = tuple(locations[dists.argmin()])\n          if not move_and_use(target, prim_idx):\n              return plan\n\n  # ------------------------------------------------------------------\n  # Move to the workshop and craft the arrow\n  # ------------------------------------------------------------------\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      # Fallback to original grid in case workshop cell became hidden\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          return plan\n  dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])\n  workshop_target = tuple(workshop_cells[dists.argmin()])\n  move_and_use(workshop_target, workshop_idx)\n\n  # ------------------------------------------------------------------\n  # Return the planned action sequence\n  # ------------------------------------------------------------------\n  return plan", "env_interactions": 23, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T19:28:42.608192", "function_name": "make_arrow", "function_body": "  # Reset environment to obtain a fresh state\n  try:\n      env.reset()\n  except Exception:\n      pass\n\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []                     # cannot obtain state\n\n  world = env.world\n  idx = world.cookbook.index\n\n  # ------------------------------------------------------------------\n  # Identify goal (arrow) and its recipe\n  # ------------------------------------------------------------------\n  try:\n      goal_idx = idx[\"arrow\"]\n  except Exception:\n      return []                     # arrow not defined\n\n  # Primitive requirements for one arrow\n  primitives_needed = world.cookbook.primitives_for(goal_idx)\n\n  # Find workshop name from the recipe (key \"_at\" or \"_key\")\n  workshop_name = None\n  for k, v in world.cookbook.recipes.get(goal_idx, {}).items():\n      if k in (\"_at\", \"_key\"):\n          workshop_name = v\n          break\n  if workshop_name is None:\n      return []                     # no workshop info\n\n  try:\n      workshop_idx = idx[workshop_name]\n  except Exception:\n      return []                     # workshop not indexed\n\n  # ------------------------------------------------------------------\n  # Local mutable copies for planning simulation\n  # ------------------------------------------------------------------\n  pos = tuple(state.pos)                 # (x, y)\n  grid = state.grid.copy()               # (W, H, n_kinds)\n  inventory = state.inventory.copy()\n  occupied = np.any(grid > 0, axis=2)    # bool matrix of blocked cells\n\n  plan = []\n\n  # ------------------------------------------------------------------\n  # Movement helpers\n  # ------------------------------------------------------------------\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # DOWN, UP, LEFT, RIGHT\n  USE = 4\n\n  from collections import deque\n\n  def bfs_adjacent(start, target, blocked):\n      \"\"\"\n      Return a list of actions moving from *start* to any free cell that is\n      4\u2011adjacent to *target*. Empty list if unreachable.\n      \"\"\"\n      h, w = blocked.shape\n      tx, ty = target\n      goal_cells = []\n      for a, (dx, dy) in enumerate(DIRS):\n          gx, gy = tx + dx, ty + dy\n          if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:\n              goal_cells.append((gx, gy))\n      if not goal_cells:\n          return []                     # target completely surrounded\n\n      q = deque([(start, [])])\n      visited = {start}\n      while q:\n          (cx, cy), path = q.popleft()\n          if (cx, cy) in goal_cells:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []                         # unreachable\n\n  def move_and_use(target, kind_idx):\n      \"\"\"\n      Move adjacent to *target* (which contains *kind_idx*) and issue USE.\n      Updates simulated position, grid, occupied mask and inventory.\n      Returns False if movement is impossible.\n      \"\"\"\n      nonlocal pos, plan, grid, occupied, inventory\n      path = bfs_adjacent(pos, target, occupied)\n      if not path and pos != target:\n          return False\n      # Simulate movement\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n      plan.extend(path)\n\n      # Issue USE\n      plan.append(USE)\n\n      tx, ty = target\n      if grid[tx, ty, kind_idx] > 0:\n          grid[tx, ty, kind_idx] = 0\n          occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)\n          inventory[kind_idx] += 1\n      return True\n\n  # ------------------------------------------------------------------\n  # Collect required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in primitives_needed.items():\n      for _ in range(cnt):\n          locations = np.argwhere(grid[:, :, prim_idx] > 0)\n          if locations.size == 0:\n              # Primitive not present; abort planning\n              return plan\n          # Choose nearest primitive by Manhattan distance\n          dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n          target = tuple(locations[dists.argmin()])\n          if not move_and_use(target, prim_idx):\n              return plan\n\n  # ------------------------------------------------------------------\n  # Move to workshop and craft the arrow\n  # ------------------------------------------------------------------\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      # fallback to original grid if we already cleared some cells\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          return plan\n  dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])\n  workshop_target = tuple(workshop_cells[dists.argmin()])\n  move_and_use(workshop_target, workshop_idx)\n\n  return plan", "env_interactions": 23, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T19:29:08.168728", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ----------------------------------------------------------------------\n  # Action constants (match CraftLab.action_specs)\n  # ----------------------------------------------------------------------\n  # 0:DOWN, 1:UP, 2:LEFT, 3:RIGHT, 4:USE\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n  USE = 4\n\n  # ----------------------------------------------------------------------\n  # Helper: shortest path (BFS) to any free cell adjacent to a target cell\n  # ----------------------------------------------------------------------\n  def bfs_adjacent(start, target, blocked):\n      \"\"\"Return a list of action indices that moves from *start* to a free\n      cell 4\u2011connected to *target*. If no such path exists, return [].\n\n      *blocked* is a bool ndarray where True means the cell is occupied.\n      \"\"\"\n      h, w = blocked.shape\n      tx, ty = target\n      # admissible goal cells (free and adjacent)\n      goal_cells = []\n      for a, (dx, dy) in enumerate(DIRS):\n          gx, gy = tx + dx, ty + dy\n          if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:\n              goal_cells.append((gx, gy))\n      if not goal_cells:\n          return []\n\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (cx, cy), path = q.popleft()\n          if (cx, cy) in goal_cells:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []\n\n  # ----------------------------------------------------------------------\n  # Reset environment and fetch current state\n  # ----------------------------------------------------------------------\n  try:\n      env.reset()\n  except Exception:\n      pass\n\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []                     # cannot obtain state \u2192 nothing to do\n\n  world = env.world\n  idx = world.cookbook.index\n\n  # ----------------------------------------------------------------------\n  # Determine goal item (arrow) and its recipe\n  # ----------------------------------------------------------------------\n  try:\n      goal_idx = idx[\"arrow\"]\n  except Exception:\n      return []                     # arrow not defined in this world\n\n  # Primitive requirements for ONE arrow\n  primitives_needed = world.cookbook.primitives_for(goal_idx)\n\n  # Workshop needed for the goal (look for special key \"_at\" or \"_key\")\n  workshop_name = None\n  for k, v in world.cookbook.recipes.get(goal_idx, {}).items():\n      if k in (\"_at\", \"_key\"):\n          workshop_name = v\n          break\n  if workshop_name is None:\n      return []                     # no workshop information\n\n  try:\n      workshop_idx = idx[workshop_name]\n  except Exception:\n      return []                     # unknown workshop name\n\n  # ----------------------------------------------------------------------\n  # Mutable copies for planning (so we can simulate pickups)\n  # ----------------------------------------------------------------------\n  pos = tuple(state.pos)                       # (x, y)\n  grid = state.grid.copy()                     # (W, H, n_kinds)\n  inventory = state.inventory.copy()\n  occupied = np.any(grid > 0, axis=2)          # bool matrix of blocked cells\n\n  plan = []                                     # final list of actions\n\n  # ----------------------------------------------------------------------\n  # Helper: move next to a cell containing *kind_idx* and USE it.\n  # Updates the simulated world state.\n  # ----------------------------------------------------------------------\n  def move_and_use(target, kind_idx):\n      \"\"\"Navigate to a free cell adjacent to *target*, issue USE and\n      update the simulated world state. Returns False if movement is\n      impossible.\"\"\"\n      nonlocal pos, plan, grid, occupied, inventory\n      path = bfs_adjacent(pos, target, occupied)\n      if not path and pos != target:\n          return False\n      # execute movement actions\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n      plan.extend(path)\n\n      # USE action\n      plan.append(USE)\n\n      tx, ty = target\n      if grid[tx, ty, kind_idx] > 0:\n          # pick up a single unit\n          grid[tx, ty, kind_idx] = 0\n          occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)\n          inventory[kind_idx] += 1\n      return True\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive (respecting the needed count)\n  # ----------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      for _ in range(needed_cnt):\n          # locate all cells that still contain this primitive\n          locations = np.argwhere(grid[:, :, prim_idx] > 0)\n          if locations.shape[0] == 0:\n              # primitive not present \u2192 abort planning, return what we have\n              return plan\n          # pick the closest one (Manhattan distance)\n          dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n          target = tuple(locations[dists.argmin()])\n          if not move_and_use(target, prim_idx):\n              return plan\n\n  # ----------------------------------------------------------------------\n  # Move to the workshop and craft the arrow\n  # ----------------------------------------------------------------------\n  # Workshops are static; if they disappeared from *grid* (because we\n  # cleared a cell that happened to host the workshop), fall back to\n  # the original scenario grid.\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.shape[0] == 0:\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.shape[0] == 0:\n          return plan                     # no workshop found\n\n  dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])\n  workshop_target = tuple(workshop_cells[dists.argmin()])\n  move_and_use(workshop_target, workshop_idx)\n\n  return plan", "env_interactions": 23, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T19:29:09.309623", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ----------------------------------------------------------------------\n  # Action constants (match CraftLab.action_specs)\n  # ----------------------------------------------------------------------\n  # 0:DOWN, 1:UP, 2:LEFT, 3:RIGHT, 4:USE\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n  USE = 4\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS to a free cell adjacent to a target cell\n  # ----------------------------------------------------------------------\n  def bfs_adjacent(start, target, blocked):\n      \"\"\"Return a list of action indices that moves from *start* to a free\n      cell 4\u2011connected to *target*. If no such path exists, return [].\n\n      *start* and *target* are (x, y) tuples.\n      *blocked* is a bool ndarray where True means the cell is occupied.\n      \"\"\"\n      h, w = blocked.shape\n      tx, ty = target\n\n      # all admissible goal cells (free and adjacent)\n      goal_cells = []\n      for a, (dx, dy) in enumerate(DIRS):\n          gx, gy = tx + dx, ty + dy\n          if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:\n              goal_cells.append((gx, gy))\n      if not goal_cells:\n          return []\n\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (cx, cy), path = q.popleft()\n          if (cx, cy) in goal_cells:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []\n\n  # ----------------------------------------------------------------------\n  # Reset environment and obtain the current state\n  # ----------------------------------------------------------------------\n  try:\n      env.reset()\n  except Exception:\n      pass\n\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []                     # cannot obtain state\n\n  world = env.world\n  idx = world.cookbook.index\n\n  # ----------------------------------------------------------------------\n  # Identify the goal (arrow) and its recipe\n  # ----------------------------------------------------------------------\n  try:\n      goal_idx = idx[\"arrow\"]\n  except Exception:\n      return []                     # arrow not defined\n\n  primitives_needed = world.cookbook.primitives_for(goal_idx)\n\n  # find workshop name from recipe (keys \"_at\" or \"_key\")\n  workshop_name = None\n  for k, v in world.cookbook.recipes.get(goal_idx, {}).items():\n      if k in (\"_at\", \"_key\"):\n          workshop_name = v\n          break\n  if workshop_name is None:\n      return []                     # no workshop info\n\n  try:\n      workshop_idx = idx[workshop_name]\n  except Exception:\n      return []                     # unknown workshop\n\n  # ----------------------------------------------------------------------\n  # Mutable copies for planning (simulate pickups)\n  # ----------------------------------------------------------------------\n  pos = tuple(state.pos)               # (x, y)\n  grid = state.grid.copy()             # (W, H, n_kinds)\n  inventory = state.inventory.copy()\n  occupied = np.any(grid > 0, axis=2)  # bool matrix of blocked cells\n\n  plan = []                             # final action list\n\n  # ----------------------------------------------------------------------\n  # Helper: move adjacent to a cell containing *kind_idx* and USE it.\n  # Updates simulated world state.\n  # ----------------------------------------------------------------------\n  def move_and_use(target, kind_idx):\n      \"\"\"Navigate to a free cell adjacent to *target*, issue USE and\n      update the simulated state. Returns False if movement impossible.\"\"\"\n      nonlocal pos, plan, grid, occupied, inventory\n      path = bfs_adjacent(pos, target, occupied)\n      if not path and pos != target:\n          return False\n\n      # execute movement actions\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n      plan.extend(path)\n\n      # USE action\n      plan.append(USE)\n\n      tx, ty = target\n      if grid[tx, ty, kind_idx] > 0:\n          # pick up one unit\n          grid[tx, ty, kind_idx] = 0\n          occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)\n          inventory[kind_idx] += 1\n      return True\n\n  # ----------------------------------------------------------------------\n  # Collect all required primitives (respecting counts)\n  # ----------------------------------------------------------------------\n  for prim_idx, count in primitives_needed.items():\n      for _ in range(count):\n          locations = np.argwhere(grid[:, :, prim_idx] > 0)\n          if locations.shape[0] == 0:\n              # primitive missing \u2013 abort planning\n              return plan\n          # choose closest by Manhattan distance\n          dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n          target = tuple(locations[dists.argmin()])\n          if not move_and_use(target, prim_idx):\n              return plan\n\n  # ----------------------------------------------------------------------\n  # Move to a workshop cell and craft the arrow\n  # ----------------------------------------------------------------------\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.shape[0] == 0:\n      # workshops are static; fall back to original grid if they were cleared\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.shape[0] == 0:\n          return plan  # no workshop found\n\n  dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])\n  workshop_target = tuple(workshop_cells[dists.argmin()])\n  move_and_use(workshop_target, workshop_idx)\n\n  return plan", "env_interactions": 23, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T19:29:29.566218", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  def _manhattan_path(src, dst):\n      \"\"\"Return a list of actions that move from src to dst using Manhattan moves.\"\"\"\n      actions = []\n      x, y = src\n      tx, ty = dst\n      while x < tx:\n          actions.append(DOWN)\n          x += 1\n      while x > tx:\n          actions.append(UP)\n          x -= 1\n      while y < ty:\n          actions.append(RIGHT)\n          y += 1\n      while y > ty:\n          actions.append(LEFT)\n          y -= 1\n      return actions\n\n  def _nearest_entity(pos, kind_idx):\n      \"\"\"Find the closest cell (Manhattan distance) that contains the given kind.\"\"\"\n      grid = env._current_state.grid\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n      best = int(np.argmin(dists))\n      return tuple(locations[best])\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow) and its recipe\n  # ------------------------------------------------------------------\n  world = env.world\n  idx_arrow = world.cookbook.index.index('arrow')\n  primitives_needed = world.cookbook.primitives_for(idx_arrow)  # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Collect all required primitives\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = env._current_state.pos\n\n  for prim_idx, cnt in primitives_needed.items():\n      for _ in range(cnt):\n          target = _nearest_entity(cur_pos, prim_idx)\n          if target is None:\n              # Primitive not present \u2013 abort early\n              return actions\n          actions += _manhattan_path(cur_pos, target)\n          cur_pos = target\n          actions.append(USE)   # pick up the primitive\n\n  # ------------------------------------------------------------------\n  # Move to the appropriate workshop (if any) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(idx_arrow, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = _nearest_entity(cur_pos, workshop_idx)\n      if workshop_pos is not None:\n          actions += _manhattan_path(cur_pos, workshop_pos)\n          cur_pos = workshop_pos\n          actions.append(USE)   # craft at the workshop\n  else:\n      # No specific workshop required; craft at current location\n      actions.append(USE)\n\n  return actions", "env_interactions": 22, "island_id": 0, "scores": {"3": 0.2}}
{"timestamp": "2025-10-27T19:29:30.690343", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  def _manhattan_path(src, dst):\n      \"\"\"Return a list of actions moving from src to dst using Manhattan moves.\"\"\"\n      actions = []\n      x, y = src\n      tx, ty = dst\n      dx = tx - x\n      dy = ty - y\n      if dx > 0:\n          actions += [DOWN] * dx\n      elif dx < 0:\n          actions += [UP] * (-dx)\n      if dy > 0:\n          actions += [RIGHT] * dy\n      elif dy < 0:\n          actions += [LEFT] * (-dy)\n      return actions\n\n  def _nearest_entity(pos, kind_idx):\n      \"\"\"Find the nearest cell (Manhattan distance) that contains the given kind.\"\"\"\n      grid = env._current_state.grid\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n      best = int(np.argmin(dists))\n      return tuple(locations[best])\n\n  # ------------------------------------------------------------------\n  # Identify goal and required primitives\n  # ------------------------------------------------------------------\n  world = env.world\n  idx_arrow = world.cookbook.index.index('arrow')\n  primitives_needed = world.cookbook.primitives_for(idx_arrow)  # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Collect all required primitives\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = env._current_state.pos\n\n  for prim_idx, count in primitives_needed.items():\n      for _ in range(count):\n          target = _nearest_entity(cur_pos, prim_idx)\n          if target is None:\n              # Primitive not present \u2013 abort early\n              return actions\n          actions += _manhattan_path(cur_pos, target)\n          cur_pos = target\n          actions.append(USE)   # pick up the primitive\n\n  # ------------------------------------------------------------------\n  # Move to the appropriate workshop (if any) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(idx_arrow, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = _nearest_entity(cur_pos, workshop_idx)\n      if workshop_pos is not None:\n          actions += _manhattan_path(cur_pos, workshop_pos)\n          cur_pos = workshop_pos\n\n  # Final craft action (USE works both as pickup and crafting)\n  actions.append(USE)\n\n  return actions", "env_interactions": 22, "island_id": 0, "scores": {"3": 0.2}}
{"timestamp": "2025-10-27T19:29:58.314444", "function_name": "make_arrow", "function_body": "  # reset environment and get current state/world references\n  env.reset()\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  # goal definition\n  goal_name = \"arrow\"\n  goal_idx = idx[goal_name]\n\n  # primitive requirements for a single arrow (recursively expanded)\n  primitive_counts = world.cookbook.primitives_for(goal_idx)\n\n  # workshop required for crafting (if any)\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else idx[wk]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def find_locations(kind):\n      \"\"\"Return list of (x, y) where `kind` appears on the current grid.\"\"\"\n      occ = np.where(state.grid[:, :, kind] > 0)\n      return list(zip(occ[0].tolist(), occ[1].tolist()))\n\n  def bfs_path(start, goal):\n      \"\"\"Return shortest path (list of positions) from start to goal\n      avoiding non\u2011grabbable cells. If no path exists, returns [start].\"\"\"\n      if start == goal:\n          return [start]\n      W, H = state.grid.shape[:2]\n\n      # cells occupied by non\u2011grabbable entities are blocked\n      blocked = set()\n      for ng in world.non_grabbable_indices:\n          occ = np.where(state.grid[:, :, ng] > 0)\n          blocked.update(zip(occ[0].tolist(), occ[1].tolist()))\n\n      q = collections.deque([start])\n      prev = {start: None}\n      while q:\n          cur = q.popleft()\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:\n                  nxt = (nx, ny)\n                  if nxt not in prev:\n                      prev[nxt] = cur\n                      if nxt == goal:\n                          # reconstruct path\n                          path = [goal]\n                          while path[-1] != start:\n                              path.append(prev[path[-1]])\n                          path.reverse()\n                          return path\n                      q.append(nxt)\n      # no reachable path\n      return [start]\n\n  def move_action(cur, nxt):\n      \"\"\"Convert a move from cur to adjacent nxt into action index.\"\"\"\n      dx, dy = nxt[0] - cur[0], nxt[1] - cur[1]\n      if dx == 1:\n          return 3   # RIGHT\n      if dx == -1:\n          return 2   # LEFT\n      if dy == 1:\n          return 0   # DOWN\n      if dy == -1:\n          return 1   # UP\n      raise AssertionError(\"Requested move is not adjacent\")\n\n  # ------------------------------------------------------------------\n  # Build action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = state.pos\n\n  # ------------------------------------------------------------------\n  # 1) Gather all required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitive_counts.items():\n      while state.inventory[prim_idx] < needed:\n          # locate remaining instances of this primitive\n          locations = find_locations(prim_idx)\n          if not locations:\n              # nothing left to collect \u2013 break to avoid infinite loop\n              break\n\n          # pick the nearest one (Manhattan distance heuristic)\n          target = min(\n              locations,\n              key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1])\n          )\n\n          # move to the target\n          path = bfs_path(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n\n          # pick it up\n          actions.append(4)   # USE\n          # update planning snapshot\n          state.inventory[prim_idx] += 1\n          state.grid[target[0], target[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 2) Move to workshop (if needed) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      wk_locations = find_locations(workshop_kind)\n      if wk_locations:\n          target = min(\n              wk_locations,\n              key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1])\n          )\n          path = bfs_path(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n      actions.append(4)   # USE to craft at workshop\n  else:\n      actions.append(4)   # USE to craft at current location\n\n  return actions", "env_interactions": 19, "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T19:29:59.427188", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  ...\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-10-27T19:30:20.284968", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def _is_walkable(grid, pos, ignore_kind=None):\n      \"\"\"Check if a cell can be stepped on.  If ``ignore_kind`` is given,\n      the cell is considered walkable when it only contains that kind.\"\"\"\n      x, y = pos\n      cell = grid[x, y, :]\n      if ignore_kind is not None and cell[ignore_kind] > 0:\n          # allow stepping onto the target primitive (and nothing else)\n          return np.count_nonzero(cell) == 1\n      return not cell.any()\n\n  def _bfs_path(grid, start, goal, ignore_kind=None):\n      \"\"\"Return a shortest 4\u2011connected path from ``start`` to ``goal`` as a list\n      of positions (including both endpoints) or ``None`` if unreachable.\"\"\"\n      if start == goal:\n          return [start]\n      w, h = grid.shape[:2]\n      frontier = collections.deque([start])\n      came_from = {start: None}\n      while frontier:\n          cur = frontier.popleft()\n          if cur == goal:\n              break\n          x, y = cur\n          for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h:\n                  nxt = (nx, ny)\n                  if nxt not in came_from and _is_walkable(grid, nxt, ignore_kind):\n                      came_from[nxt] = cur\n                      frontier.append(nxt)\n      else:\n          return None  # no path found\n\n      # reconstruct path\n      path = [goal]\n      while path[-1] != start:\n          path.append(came_from[path[-1]])\n      path.reverse()\n      return path\n\n  def _actions_from_path(path):\n      \"\"\"Translate a list of adjacent positions into action indices.\"\"\"\n      if not path or len(path) < 2:\n          return []\n      acts = []\n      for (x0, y0), (x1, y1) in zip(path, path[1:]):\n          if x1 == x0 + 1:\n              acts.append(DOWN)\n          elif x1 == x0 - 1:\n              acts.append(UP)\n          elif y1 == y0 + 1:\n              acts.append(RIGHT)\n          elif y1 == y0 - 1:\n              acts.append(LEFT)\n          else:\n              raise ValueError(\"Non\u2011adjacent positions in path\")\n      return acts\n\n  def _move_actions(grid, src, dst, ignore_kind=None):\n      \"\"\"Return actions to move from ``src`` to ``dst`` using BFS; fall back\n      to Manhattan moves if BFS fails (which may collide with obstacles but\n      guarantees progress).\"\"\"\n      path = _bfs_path(grid, src, dst, ignore_kind)\n      if path is None:\n          # Manhattan fallback\n          acts = []\n          sx, sy = src\n          dx, dy = dst[0] - sx, dst[1] - sy\n          if dx > 0:\n              acts += [DOWN] * dx\n          elif dx < 0:\n              acts += [UP] * (-dx)\n          if dy > 0:\n              acts += [RIGHT] * dy\n          elif dy < 0:\n              acts += [LEFT] * (-dy)\n          return acts\n      return _actions_from_path(path)\n\n  def _nearest_kind(grid, pos, kind_idx):\n      \"\"\"Find the nearest cell (Manhattan distance) containing ``kind_idx``.\"\"\"\n      cells = np.argwhere(grid[:, :, kind_idx] > 0)\n      if cells.size == 0:\n          return None\n      dists = np.abs(cells[:, 0] - pos[0]) + np.abs(cells[:, 1] - pos[1])\n      nearest = cells[dists.argmin()]\n      return tuple(nearest.tolist())\n\n  # ------------------------------------------------------------------\n  # 1. Determine required primitives for the target item (arrow)\n  # ------------------------------------------------------------------\n  world = env.world\n  arrow_idx = world.cookbook.index.index('arrow')\n  primitives_needed = world.cookbook.primitives_for(arrow_idx)  # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # 2. Collect all required primitives\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = tuple(env._current_state.pos)\n  grid = env._current_state.grid.copy()  # mutable copy for planning\n\n  for prim_idx, cnt in primitives_needed.items():\n      for _ in range(cnt):\n          target = _nearest_kind(grid, cur_pos, prim_idx)\n          if target is None:\n              # Primitive missing \u2013 stop planning early\n              return actions\n          actions += _move_actions(grid, cur_pos, target, ignore_kind=prim_idx)\n          cur_pos = target\n          actions.append(USE)                     # pick up primitive\n          grid[cur_pos[0], cur_pos[1], prim_idx] = 0  # remove from planning grid\n\n  # ------------------------------------------------------------------\n  # 3. Move to workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = _nearest_kind(grid, cur_pos, workshop_idx)\n      if workshop_pos is not None:\n          actions += _move_actions(grid, cur_pos, workshop_pos)\n          cur_pos = workshop_pos\n          actions.append(USE)                     # craft at workshop\n\n  return actions", "env_interactions": 24, "island_id": 5, "scores": {"3": 0.2}}
{"timestamp": "2025-10-27T19:30:21.418834", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def _is_walkable(grid, pos, ignore_kind=None):\n      \"\"\"Return True if `pos` can be stepped on.\n      All non\u2011zero entries block movement except when the cell only\n      contains the `ignore_kind` entity (used when we intend to pick it up).\"\"\"\n      x, y = pos\n      cell = grid[x, y, :]\n      if ignore_kind is not None and cell[ignore_kind] > 0:\n          # allow stepping onto the target primitive (but no other entities)\n          return np.count_nonzero(cell) == 1\n      return not cell.any()\n\n  def _bfs_path(grid, start, goal, ignore_kind=None):\n      \"\"\"Find a shortest 4\u2011connected path from `start` to `goal`.\n      Returns a list of positions (including both endpoints) or None if unreachable.\"\"\"\n      if start == goal:\n          return [start]\n      w, h = grid.shape[:2]\n      frontier = collections.deque([start])\n      came_from = {start: None}\n      while frontier:\n          cur = frontier.popleft()\n          if cur == goal:\n              break\n          x, y = cur\n          for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h:\n                  nxt = (nx, ny)\n                  if nxt not in came_from and _is_walkable(grid, nxt, ignore_kind):\n                      came_from[nxt] = cur\n                      frontier.append(nxt)\n      else:\n          return None  # no path found\n\n      # reconstruct path\n      path = [goal]\n      while path[-1] != start:\n          path.append(came_from[path[-1]])\n      path.reverse()\n      return path\n\n  def _actions_from_path(path):\n      \"\"\"Convert a list of adjacent positions into action indices.\"\"\"\n      if not path or len(path) < 2:\n          return []\n      acts = []\n      for (x0, y0), (x1, y1) in zip(path, path[1:]):\n          if x1 == x0 + 1:\n              acts.append(DOWN)\n          elif x1 == x0 - 1:\n              acts.append(UP)\n          elif y1 == y0 + 1:\n              acts.append(RIGHT)\n          elif y1 == y0 - 1:\n              acts.append(LEFT)\n          else:\n              raise ValueError(\"Non\u2011adjacent positions in path\")\n      return acts\n\n  def _move_actions(grid, src, dst, ignore_kind=None):\n      \"\"\"Return actions to move from src to dst using BFS; fall back to Manhattan.\"\"\"\n      path = _bfs_path(grid, src, dst, ignore_kind)\n      if path is None:\n          # Manhattan fallback (may collide with obstacles but guarantees progress)\n          acts = []\n          sx, sy = src\n          dx, dy = dst[0] - sx, dst[1] - sy\n          if dx > 0:\n              acts += [DOWN] * dx\n          elif dx < 0:\n              acts += [UP] * (-dx)\n          if dy > 0:\n              acts += [RIGHT] * dy\n          elif dy < 0:\n              acts += [LEFT] * (-dy)\n          return acts\n      return _actions_from_path(path)\n\n  def _nearest_kind(grid, pos, kind_idx):\n      \"\"\"Find the nearest cell (Manhattan distance) that currently contains `kind_idx`.\"\"\"\n      cells = np.argwhere(grid[:, :, kind_idx] > 0)\n      if cells.size == 0:\n          return None\n      dists = np.abs(cells[:, 0] - pos[0]) + np.abs(cells[:, 1] - pos[1])\n      nearest = cells[dists.argmin()]\n      return tuple(nearest.tolist())\n\n  # ------------------------------------------------------------------\n  # 1. Determine required primitives for the target item (arrow)\n  # ------------------------------------------------------------------\n  world = env.world\n  arrow_idx = world.cookbook.index.index('arrow')\n  primitives_needed = world.cookbook.primitives_for(arrow_idx)  # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # 2. Collect all required primitives\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = tuple(env._current_state.pos)          # current agent position\n  grid = env._current_state.grid.copy()            # mutable copy for planning\n\n  for prim_idx, count in primitives_needed.items():\n      for _ in range(count):\n          target = _nearest_kind(grid, cur_pos, prim_idx)\n          if target is None:\n              # Primitive missing \u2013 abort planning early\n              return actions\n          # Move to the primitive, allowing stepping onto it\n          actions += _move_actions(grid, cur_pos, target, ignore_kind=prim_idx)\n          cur_pos = target\n          actions.append(USE)                       # pick up primitive\n          # Update local grid: primitive is now removed\n          grid[cur_pos[0], cur_pos[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 3. Move to the appropriate workshop (if any) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = _nearest_kind(grid, cur_pos, workshop_idx)\n      if workshop_pos is not None:\n          actions += _move_actions(grid, cur_pos, workshop_pos)\n          cur_pos = workshop_pos\n          actions.append(USE)                       # craft at workshop\n\n  return actions", "env_interactions": 24, "island_id": 5, "scores": {"3": 0.2}}
{"timestamp": "2025-10-27T19:30:49.646357", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action constants (match CraftLab.action_specs order)\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # 0:DOWN, 1:UP, 2:LEFT, 3:RIGHT\n  USE = 4\n\n  def bfs_to_adjacent(start, target, blocked):\n      \"\"\"Return a list of movement actions that brings the agent from *start*\n      to any empty cell that is 4\u2011connected to *target*.\n      If no such path exists, returns an empty list.\"\"\"\n      h, w = blocked.shape\n      goal_cells = []\n      tx, ty = int(target[0]), int(target[1])\n      for a, (dx, dy) in enumerate(DIRS):\n          gx, gy = tx + dx, ty + dy\n          if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:\n              goal_cells.append((gx, gy))\n      if not goal_cells:\n          return []\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (cx, cy), path = q.popleft()\n          if (cx, cy) in goal_cells:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []\n\n  # Initialise / reset environment\n  try:\n      env.reset()\n  except Exception:\n      pass\n\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []\n\n  world = env.world\n  idx = world.cookbook.index\n\n  # Identify goal (arrow) and its recipe\n  try:\n      arrow_idx = idx[\"arrow\"]\n  except Exception:\n      return []\n\n  primitives_needed = world.cookbook.primitives_for(arrow_idx)\n\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\") or recipe.get(\"_key\")\n  if workshop_name is None:\n      return []\n  try:\n      workshop_idx = idx[workshop_name]\n  except Exception:\n      return []\n\n  # Local mutable copies of the world state\n  pos = tuple(state.pos)                     # (x, y)\n  grid = state.grid.copy()                   # (W, H, n_kinds)\n  inventory = state.inventory.copy()         # (n_kinds,)\n  occupied = np.any(grid > 0, axis=2)        # (W, H) bool\n\n  plan_actions = []\n\n  def move_and_use(target_coord, kind_idx):\n      \"\"\"Move adjacent to *target_coord* (which holds *kind_idx*) and USE.\n      Updates local copies of pos, grid, occupied and inventory.\"\"\"\n      nonlocal pos, plan_actions, grid, occupied, inventory\n      path = bfs_to_adjacent(pos, target_coord, occupied)\n      if not path and pos != target_coord:\n          return False\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n      plan_actions.extend(path)\n      plan_actions.append(USE)\n\n      tx, ty = int(target_coord[0]), int(target_coord[1])\n      if grid[tx, ty, kind_idx] > 0:\n          grid[tx, ty, kind_idx] = 0\n          occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)\n          inventory[kind_idx] += 1\n      return True\n\n  # Collect required primitives (may need multiple of same kind)\n  for prim_idx, needed_cnt in primitives_needed.items():\n      for _ in range(needed_cnt):\n          candidates = np.argwhere(grid[:, :, prim_idx] > 0)\n          if candidates.shape[0] == 0:\n              # No more of this primitive left on the map; abort early\n              return plan_actions\n          # Choose the nearest candidate (Manhattan distance)\n          dists = np.abs(candidates[:, 0] - pos[0]) + np.abs(candidates[:, 1] - pos[1])\n          target = candidates[dists.argmin()]\n          if not move_and_use(target, prim_idx):\n              return plan_actions\n\n  # Move to a workshop cell and craft the arrow\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.shape[0] == 0:\n      # If the workshop cell was cleared during collection (unlikely), fall back to original grid\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.shape[0] == 0:\n          return plan_actions\n  dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])\n  workshop_target = workshop_cells[dists.argmin()]\n  move_and_use(workshop_target, workshop_idx)\n\n  return plan_actions", "env_interactions": 23, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T19:30:50.783459", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ----------------------------------------------------------------------\n  # Action constants (match CraftLab.action_specs order)\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # 0:DOWN, 1:UP, 2:LEFT, 3:RIGHT\n  USE = 4\n\n  # ----------------------------------------------------------------------\n  def bfs_to_adjacent(start, target, blocked):\n      \"\"\"Return a list of movement actions that brings the agent from *start*\n      to any empty cell that is 4\u2011connected to *target*.\n      If no such path exists, returns an empty list.\"\"\"\n      h, w = blocked.shape\n      goal_cells = []\n      tx, ty = int(target[0]), int(target[1])\n      for a, (dx, dy) in enumerate(DIRS):\n          gx, gy = tx + dx, ty + dy\n          if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:\n              goal_cells.append((gx, gy))\n      if not goal_cells:\n          return []\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (cx, cy), path = q.popleft()\n          if (cx, cy) in goal_cells:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []\n\n  # ----------------------------------------------------------------------\n  # Reset / initialise environment\n  try:\n      env.reset()\n  except Exception:\n      pass\n\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []\n\n  world = env.world\n  idx = world.cookbook.index\n\n  # ----------------------------------------------------------------------\n  # Identify goal (arrow) and its recipe\n  try:\n      goal_idx = idx[\"arrow\"]\n  except Exception:\n      return []\n\n  primitives_needed = world.cookbook.primitives_for(goal_idx)\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\") or recipe.get(\"_key\")\n  if workshop_name is None:\n      return []\n  try:\n      workshop_idx = idx[workshop_name]\n  except Exception:\n      return []\n\n  # ----------------------------------------------------------------------\n  # Local mutable copies of the world state\n  pos = tuple(state.pos)                     # (x, y)\n  grid = state.grid.copy()                   # (W, H, n_kinds)\n  inventory = state.inventory.copy()         # (n_kinds,)\n  occupied = np.any(grid > 0, axis=2)        # (W, H) bool\n\n  plan_actions = []\n\n  def move_and_use(target_coord, kind_idx):\n      \"\"\"Move adjacent to *target_coord* (which holds *kind_idx*) and USE.\n      Updates local copies of pos, grid, occupied and inventory.\"\"\"\n      nonlocal pos, plan_actions, grid, occupied, inventory\n      path = bfs_to_adjacent(pos, target_coord, occupied)\n      if not path and pos != target_coord:\n          return False\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n      plan_actions.extend(path)\n      plan_actions.append(USE)\n\n      tx, ty = int(target_coord[0]), int(target_coord[1])\n      if grid[tx, ty, kind_idx] > 0:\n          grid[tx, ty, kind_idx] = 0\n          occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)\n          inventory[kind_idx] += 1\n      return True\n\n  # ----------------------------------------------------------------------\n  # Collect required primitives (may need multiple of same kind)\n  for prim_idx, needed_cnt in primitives_needed.items():\n      for _ in range(needed_cnt):\n          candidates = np.argwhere(grid[:, :, prim_idx] > 0)\n          if candidates.shape[0] == 0:\n              # No more of this primitive left on the map; abort early\n              return plan_actions\n          # Choose the nearest candidate (Manhattan distance)\n          dists = np.abs(candidates[:, 0] - pos[0]) + np.abs(candidates[:, 1] - pos[1])\n          target = candidates[dists.argmin()]\n          if not move_and_use(target, prim_idx):\n              return plan_actions\n\n  # ----------------------------------------------------------------------\n  # Move to a workshop cell and craft the goal item\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.shape[0] == 0:\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.shape[0] == 0:\n          return plan_actions\n  dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])\n  workshop_target = workshop_cells[dists.argmin()]\n  move_and_use(workshop_target, workshop_idx)\n\n  return plan_actions", "env_interactions": 23, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T19:31:18.006590", "function_name": "make_arrow", "function_body": "  # Reset environment and fetch useful references\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.scenario.world          # CraftWorld\n  cookbook = world.cookbook           # Cookbook\n  index = cookbook.index               # Name \u2194 integer ID mapping\n\n  # Resolve action indices from the environment spec\n  action_map = env.action_specs()\n  DOWN = action_map.get(\"DOWN\", 0)\n  UP = action_map.get(\"UP\", 1)\n  LEFT = action_map.get(\"LEFT\", 2)\n  RIGHT = action_map.get(\"RIGHT\", 3)\n  USE = action_map.get(\"USE\", 4)\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow) and its primitive requirements.\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  if goal_name not in index.contents:\n      return []                     # Arrow not defined in this world\n  goal_idx = index[goal_name]      # Integer id of the arrow item\n\n  # Primitive requirements for crafting one arrow (empty if arrow is primitive)\n  primitive_needs = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n  actions = []                     # List of actions to be returned\n\n  # ------------------------------------------------------------------\n  # Helper: BFS to find a path avoiding occupied cells (except the target).\n  # ------------------------------------------------------------------\n  from collections import deque\n  import numpy as np\n\n  h, w = state.grid.shape[:2]\n  moves = [(DOWN, (1, 0)),\n           (UP, (-1, 0)),\n           (LEFT, (0, -1)),\n           (RIGHT, (0, 1))]\n\n  def bfs_path(start, target):\n      \"\"\"Return a list of movement actions from start to target.\"\"\"\n      if start == target:\n          return []\n      queue = deque([start])\n      visited = {start}\n      parent = {}\n      while queue:\n          cur = queue.popleft()\n          if cur == target:\n              break\n          for act, (dr, dc) in moves:\n              nr, nc = cur[0] + dr, cur[1] + dc\n              if not (0 <= nr < h and 0 <= nc < w):\n                  continue\n              nxt = (nr, nc)\n              # Allow stepping onto the target even if occupied.\n              if nxt != target and state.grid[nr, nc, :].sum() != 0:\n                  continue\n              if nxt in visited:\n                  continue\n              visited.add(nxt)\n              parent[nxt] = (cur, act)\n              queue.append(nxt)\n      if target not in parent and start != target:\n          return []      # No path found.\n      # Reconstruct path.\n      path = []\n      cur = target\n      while cur != start:\n          prev, act = parent[cur]\n          path.append(act)\n          cur = prev\n      path.reverse()\n      return path\n\n  # ------------------------------------------------------------------\n  # Phase 1: Collect required primitives (respecting multiplicities).\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # Primitive missing; abort early.\n              return actions\n          # Choose the nearest primitive cell (Manhattan distance).\n          dists = np.abs(prim_cells - np.array(state.pos)).sum(axis=1)\n          tr, tc = tuple(prim_cells[dists.argmin()])\n          # Move to that cell.\n          actions.extend(bfs_path(state.pos, (tr, tc)))\n          state.pos = (tr, tc)\n          # Pick it up.\n          actions.append(USE)\n          # Update internal copy of the state.\n          state.inventory[prim_idx] += 1\n          state.grid[tr, tc, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Phase 2: Craft the arrow at its workshop (if any), otherwise pick up.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      # Arrow must be crafted at a specific workshop.\n      workshop_idx = index[workshop_name]\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          return actions          # No workshop found; cannot craft.\n      wr, wc = tuple(workshop_cells[0])\n      actions.extend(bfs_path(state.pos, (wr, wc)))\n      state.pos = (wr, wc)\n      actions.append(USE)          # Craft at the workshop.\n  else:\n      # No workshop required \u2013 arrow is a primitive item itself.\n      arrow_cells = np.argwhere(state.grid[:, :, goal_idx] > 0)\n      if arrow_cells.size == 0:\n          return actions          # Arrow not present anywhere.\n      tr, tc = tuple(arrow_cells[0])\n      actions.extend(bfs_path(state.pos, (tr, tc)))\n      state.pos = (tr, tc)\n      actions.append(USE)          # Pick up the arrow.\n\n  return actions", "env_interactions": 24, "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T19:31:19.130026", "function_name": "make_arrow", "function_body": "  # Reset environment and fetch useful references\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.scenario.world          # CraftWorld\n  cookbook = world.cookbook           # Cookbook\n  index = cookbook.index               # Name \u2194 integer ID mapping\n\n  # Resolve action indices from the environment specification\n  action_map = env.action_specs()\n  DOWN = action_map.get(\"DOWN\", 0)\n  UP = action_map.get(\"UP\", 1)\n  LEFT = action_map.get(\"LEFT\", 2)\n  RIGHT = action_map.get(\"RIGHT\", 3)\n  USE = action_map.get(\"USE\", 4)\n\n  # Goal item name\n  goal_name = \"arrow\"\n  if goal_name not in index.contents:\n      return []   # Arrow not defined in this world\n  goal_idx = index[goal_name]\n\n  # Primitive requirements for the goal (including multiplicities)\n  primitive_needs = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper: BFS pathfinder that avoids occupied cells (except target)\n  # ------------------------------------------------------------------\n  from collections import deque\n  h, w = state.grid.shape[:2]\n  moves = [(DOWN, (1, 0)),\n           (UP, (-1, 0)),\n           (LEFT, (0, -1)),\n           (RIGHT, (0, 1))]\n\n  def bfs_path(start, target):\n      \"\"\"Return a list of movement actions from start to target.\"\"\"\n      if start == target:\n          return []\n\n      queue = deque([start])\n      visited = {start}\n      parent = {}\n\n      while queue:\n          cur = queue.popleft()\n          if cur == target:\n              break\n          for act, (dr, dc) in moves:\n              nr, nc = cur[0] + dr, cur[1] + dc\n              if not (0 <= nr < h and 0 <= nc < w):\n                  continue\n              nxt = (nr, nc)\n\n              # Allow stepping onto the target even if it is occupied.\n              if nxt != target and state.grid[nr, nc, :].sum() != 0:\n                  continue\n              if nxt in visited:\n                  continue\n              visited.add(nxt)\n              parent[nxt] = (cur, act)\n              queue.append(nxt)\n\n      if target not in parent and start != target:\n          return []   # No path found\n\n      # Reconstruct path\n      path = []\n      cur = target\n      while cur != start:\n          prev, act = parent[cur]\n          path.append(act)\n          cur = prev\n      path.reverse()\n      return path\n\n  # ------------------------------------------------------------------\n  # Phase 1: Collect all required primitives (respecting counts)\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          # Locate cells that currently contain this primitive.\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # Primitive unavailable \u2013 abort early.\n              return actions\n\n          # Choose the nearest primitive cell (Manhattan distance).\n          dists = np.abs(prim_cells - np.array(state.pos)).sum(axis=1)\n          tr, tc = prim_cells[dists.argmin()]\n\n          # Move to the primitive.\n          move_seq = bfs_path(state.pos, (tr, tc))\n          actions.extend(move_seq)\n          state.pos = (tr, tc)\n\n          # Pick it up.\n          actions.append(USE)\n\n          # Update internal copy of state.\n          state.inventory[prim_idx] += 1\n          state.grid[tr, tc, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Phase 2: Go to the appropriate workshop and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      return actions   # No workshop information; cannot craft.\n\n  workshop_idx = index[workshop_name]\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      return actions   # No workshop present in the world.\n\n  # Choose nearest workshop.\n  dists = np.abs(workshop_cells - np.array(state.pos)).sum(axis=1)\n  wr, wc = workshop_cells[dists.argmin()]\n\n  # Move to workshop.\n  move_seq = bfs_path(state.pos, (wr, wc))\n  actions.extend(move_seq)\n  state.pos = (wr, wc)\n\n  # Craft the arrow.\n  actions.append(USE)\n\n  return actions", "env_interactions": 24, "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T19:31:46.485595", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Setup and helpers\n  # ----------------------------------------------------------------------\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # reset env and pull useful references\n  env.reset()\n  state = env._current_state               # CraftState\n  world = env.scenario.world                # CraftWorld\n  cookbook = world.cookbook                 # Cookbook\n  index = cookbook.index                    # name \u2194 id mapping\n\n  # ----------------------------------------------------------------------\n  # Goal identification\n  # ----------------------------------------------------------------------\n  goal_name = \"arrow\"\n  if goal_name not in index.contents:\n      return []  # arrow not defined in this world\n  goal_idx = index[goal_name]\n\n  # ----------------------------------------------------------------------\n  # Primitive requirements for one arrow\n  # ----------------------------------------------------------------------\n  primitive_needs = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # Simple BFS path\u2011finder that treats any occupied cell as blocked,\n  # except the target cell itself (so we can step onto a primitive / workshop).\n  # ----------------------------------------------------------------------\n  def bfs(start, target):\n      \"\"\"Return a list of positions from start to target (inclusive) using\n      4\u2011connected Manhattan moves. Returns None if target unreachable.\"\"\"\n      h, w = state.grid.shape[:2]\n      occupied = np.any(state.grid > 0, axis=2)          # True where blocked\n      # allow stepping onto the target even if it is occupied\n      occupied[target] = False\n      q = collections.deque()\n      q.append(start)\n      came_from = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          r, c = cur\n          for dr, dc in [(1,0), (-1,0), (0,1), (0,-1)]:\n              nr, nc = r+dr, c+dc\n              if 0 <= nr < h and 0 <= nc < w:\n                  if not occupied[nr, nc] and (nr, nc) not in came_from:\n                      came_from[(nr, nc)] = cur\n                      q.append((nr, nc))\n      else:\n          return None  # never reached target\n\n      # reconstruct path\n      path = []\n      cur = target\n      while cur is not None:\n          path.append(cur)\n          cur = came_from[cur]\n      path.reverse()\n      return path\n\n  # ----------------------------------------------------------------------\n  # Translate a step (delta) into an action index.\n  # ----------------------------------------------------------------------\n  delta_to_action = {\n      (1, 0): DOWN,\n      (-1, 0): UP,\n      (0, 1): RIGHT,\n      (0, -1): LEFT,\n  }\n\n  # ----------------------------------------------------------------------\n  # 1. Collect all required primitives.\n  # ----------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          # locate any remaining instance of this primitive\n          cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if cells.size == 0:\n              # nothing left \u2013 abort planning\n              return actions\n\n          target_r, target_c = cells[0]\n\n          # find path to that cell\n          path = bfs(state.pos, (target_r, target_c))\n          if path is None:\n              # unreachable \u2013 abort\n              return actions\n\n          # convert path (list of positions) to actions\n          for (r0, c0), (r1, c1) in zip(path, path[1:]):\n              act = delta_to_action[(r1 - r0, c1 - c0)]\n              actions.append(act)\n              state.pos = (r1, c1)\n\n          # pick up the primitive\n          actions.append(USE)\n          state.inventory[prim_idx] += 1\n          state.grid[target_r, target_c, prim_idx] = 0\n\n  # ----------------------------------------------------------------------\n  # 2. Go to the workshop and craft the arrow.\n  # ----------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      return actions  # no workshop info \u2013 cannot craft\n\n  workshop_idx = index[workshop_name]\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      return actions  # no workshop cell found\n\n  w_r, w_c = workshop_cells[0]\n\n  path = bfs(state.pos, (w_r, w_c))\n  if path is None:\n      return actions  # unreachable\n\n  for (r0, c0), (r1, c1) in zip(path, path[1:]):\n      act = delta_to_action[(r1 - r0, c1 - c0)]\n      actions.append(act)\n      state.pos = (r1, c1)\n\n  # craft the arrow at the workshop\n  actions.append(USE)\n\n  return actions", "env_interactions": 28, "island_id": 4, "scores": {"3": 2.0}}
{"timestamp": "2025-10-27T19:31:47.616158", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Reset environment and obtain references\n  env.reset()\n  state = env._current_state               # CraftState\n  world = env.scenario.world                # CraftWorld\n  cookbook = world.cookbook                 # Cookbook\n  index = cookbook.index                    # name \u2194 id mapping\n\n  # Goal item name\n  goal_name = \"arrow\"\n  if goal_name not in index.contents:\n      return []  # arrow not defined\n\n  goal_idx = index[goal_name]\n\n  # Primitives needed for one arrow\n  primitive_needs = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n  actions = []\n\n  # Simple Manhattan movement helper\n  def _move_to(start, target):\n      \"\"\"Return list of move actions from start to target (row,col).\"\"\"\n      r, c = start\n      tr, tc = target\n      seq = []\n      while (r, c) != (tr, tc):\n          if r < tr:\n              seq.append(DOWN)\n              r += 1\n          elif r > tr:\n              seq.append(UP)\n              r -= 1\n          elif c < tc:\n              seq.append(RIGHT)\n              c += 1\n          else:  # c > tc\n              seq.append(LEFT)\n              c -= 1\n      return seq, (r, c)\n\n  # ------------------------------------------------------------------\n  # 1. Collect required primitives.\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          # Locate a cell that currently holds this primitive\n          cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if cells.size == 0:\n              # Primitive missing \u2013 abort planning.\n              return actions\n          target_r, target_c = cells[0]\n\n          # Move next to the primitive cell\n          move_seq, new_pos = _move_to(state.pos, (target_r, target_c))\n          actions.extend(move_seq)\n          state.pos = new_pos\n\n          # Pick it up\n          actions.append(USE)\n\n          # Update internal copy of state\n          state.inventory[prim_idx] += 1\n          state.grid[target_r, target_c, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 2. Go to the workshop and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      return actions  # No workshop info\n\n  workshop_idx = index[workshop_name]\n\n  # Find a workshop cell\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      return actions  # No workshop cell\n\n  w_r, w_c = workshop_cells[0]\n\n  # Move to workshop\n  move_seq, new_pos = _move_to(state.pos, (w_r, w_c))\n  actions.extend(move_seq)\n  state.pos = new_pos\n\n  # Craft the arrow\n  actions.append(USE)\n\n  return actions", "env_interactions": 24, "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T19:32:04.141098", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  world = env.world\n  cookbook = world.cookbook\n\n  # index of the target item (arrow)\n  goal_idx = cookbook.index.index('arrow')\n  # primitive requirements for a single arrow (expanded to primitives)\n  primitives_needed = cookbook.primitives_for(goal_idx)\n\n  actions = []\n  cur_pos = env._current_state.pos\n\n  def _move_actions(src, dst):\n      \"\"\"Generate Manhattan movement actions from src to dst (ignores obstacles).\"\"\"\n      x, y = src\n      tx, ty = dst\n      acts = []\n      dx = tx - x\n      dy = ty - y\n      if dx > 0:\n          acts += [DOWN] * dx\n      elif dx < 0:\n          acts += [UP] * (-dx)\n      if dy > 0:\n          acts += [RIGHT] * dy\n      elif dy < 0:\n          acts += [LEFT] * (-dy)\n      return acts\n\n  def _nearest_kind(pos, kind_idx):\n      \"\"\"Find the nearest cell containing the given kind index.\"\"\"\n      grid = env._current_state.grid\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n      nearest = int(dists.argmin())\n      return tuple(locations[nearest].tolist())\n\n  # ------------------------------------------------------------\n  # 1. Collect all required primitives\n  # ------------------------------------------------------------\n  for prim_idx, qty in primitives_needed.items():\n      for _ in range(qty):\n          target = _nearest_kind(cur_pos, prim_idx)\n          if target is None:\n              # Primitive not present in the current scenario; abort early.\n              return actions\n          actions += _move_actions(cur_pos, target)\n          cur_pos = target\n          actions.append(USE)   # pick up / interact with the primitive\n\n  # ------------------------------------------------------------\n  # 2. Move to the appropriate workshop and craft the arrow\n  # ------------------------------------------------------------\n  workshop_name = cookbook.recipes[goal_idx].get('_at')\n  if workshop_name is not None:\n      workshop_idx = cookbook.index.index(workshop_name)\n      workshop_pos = _nearest_kind(cur_pos, workshop_idx)\n      if workshop_pos is not None:\n          actions += _move_actions(cur_pos, workshop_pos)\n          cur_pos = workshop_pos\n          actions.append(USE)   # craft at the workshop\n\n  return actions", "env_interactions": 22, "island_id": 2, "scores": {"3": 0.2}}
{"timestamp": "2025-10-27T19:32:05.269776", "function_name": "make_arrow", "function_body": "  # Action constants\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def _manhattan_actions(src, dst):\n      \"\"\"Fallback simple Manhattan moves (ignores obstacles).\"\"\"\n      x, y = src\n      tx, ty = dst\n      acts = []\n      dx = tx - x\n      dy = ty - y\n      if dx > 0:\n          acts += [DOWN] * dx\n      elif dx < 0:\n          acts += [UP] * (-dx)\n      if dy > 0:\n          acts += [RIGHT] * dy\n      elif dy < 0:\n          acts += [LEFT] * (-dy)\n      return acts\n\n  def _bfs_actions(src, dst):\n      \"\"\"Find a shortest path avoiding non\u2011grabbable cells using BFS.\n      Returns a list of actions (DOWN, UP, LEFT, RIGHT). If no path is found,\n      falls back to Manhattan moves.\"\"\"\n      grid = env._current_state.grid\n      h, w, _ = grid.shape\n      blocked = np.any(grid[:, :, list(env.world.non_grabbable_indices)] > 0, axis=2)\n\n      # Simple bounds check\n      if not (0 <= dst[0] < h and 0 <= dst[1] < w):\n          return _manhattan_actions(src, dst)\n\n      # BFS\n      from collections import deque\n      q = deque()\n      q.append(src)\n      visited = np.full((h, w), False, dtype=bool)\n      visited[src] = True\n      parent = dict()\n\n      while q:\n          cur = q.popleft()\n          if cur == dst:\n              break\n          for move, (dx, dy) in [(DOWN, (1, 0)), (UP, (-1, 0)),\n                                 (RIGHT, (0, 1)), (LEFT, (0, -1))]:\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < h and 0 <= ny < w and not visited[nx, ny] and not blocked[nx, ny]:\n                  visited[nx, ny] = True\n                  parent[(nx, ny)] = (cur, move)\n                  q.append((nx, ny))\n\n      if dst not in parent and src != dst:\n          # No path found \u2013 use Manhattan fallback\n          return _manhattan_actions(src, dst)\n\n      # Reconstruct actions\n      actions_rev = []\n      cur = dst\n      while cur != src:\n          prev, move = parent[cur]\n          actions_rev.append(move)\n          cur = prev\n      actions_rev.reverse()\n      return actions_rev\n\n  def _move_actions(src, dst):\n      \"\"\"Choose BFS path if possible, otherwise Manhattan.\"\"\"\n      return _bfs_actions(src, dst)\n\n  def _nearest_kind(pos, kind_idx):\n      \"\"\"Return coordinates of the nearest cell containing the given kind.\n      Uses Manhattan distance for tie\u2011breaking.\"\"\"\n      grid = env._current_state.grid\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n      nearest = int(dists.argmin())\n      return tuple(locations[nearest].tolist())\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow) and its recipe\n  # ------------------------------------------------------------------\n  world = env.world\n  cookbook = world.cookbook\n  arrow_idx = cookbook.index.index('arrow')\n  primitives_needed = cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Collect all required primitives\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = env._current_state.pos\n\n  for prim_idx, qty in primitives_needed.items():\n      for _ in range(qty):\n          target = _nearest_kind(cur_pos, prim_idx)\n          if target is None:\n              # Primitive missing \u2013 stop early\n              return actions\n          actions += _move_actions(cur_pos, target)\n          cur_pos = target\n          actions.append(USE)   # pick up the primitive\n\n  # ------------------------------------------------------------------\n  # Move to the appropriate workshop and craft the arrow\n  # ------------------------------------------------------------------\n  workshop_name = cookbook.recipes[arrow_idx].get('_at')\n  if workshop_name is not None:\n      workshop_idx = cookbook.index.index(workshop_name)\n      workshop_pos = _nearest_kind(cur_pos, workshop_idx)\n      if workshop_pos is not None:\n          actions += _move_actions(cur_pos, workshop_pos)\n          cur_pos = workshop_pos\n          actions.append(USE)   # craft at the workshop\n\n  return actions", "env_interactions": 22, "island_id": 2, "scores": {"3": 0.2}}
{"timestamp": "2025-10-27T19:32:32.241068", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Direction vectors: 0=DOWN, 1=UP, 2=LEFT, 3=RIGHT\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n  USE = 4\n\n  def bfs_to_adjacent(start, target, blocked):\n      \"\"\"Shortest path to any empty cell adjacent to target.\"\"\"\n      h, w = blocked.shape\n      goal_cells = []\n      tx, ty = target\n      for a, (dx, dy) in enumerate(DIRS):\n          gx, gy = tx + dx, ty + dy\n          if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:\n              goal_cells.append((gx, gy))\n      if not goal_cells:\n          return []\n\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (cx, cy), path = q.popleft()\n          if (cx, cy) in goal_cells:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []\n\n  # Reset the environment if possible.\n  try:\n      env.reset()\n  except Exception:\n      pass\n\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []\n\n  world = env.world\n  idx = world.cookbook.index\n\n  # Identify the goal (arrow) and its recipe.\n  try:\n      goal_idx = idx[\"arrow\"]\n  except Exception:\n      return []\n\n  primitives_needed = world.cookbook.primitives_for(goal_idx)\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\") or recipe.get(\"_key\")\n  if workshop_name is None:\n      return []\n  try:\n      workshop_idx = idx[workshop_name]\n  except Exception:\n      return []\n\n  # Local mutable copies of the state.\n  pos = tuple(state.pos)\n  grid = state.grid.copy()\n  occupied = np.any(grid > 0, axis=2)\n  inventory = state.inventory.copy()\n\n  plan_actions = []\n\n  def move_and_use(target_coord, kind_idx):\n      \"\"\"Move next to target cell, USE it, and update local simulation.\"\"\"\n      nonlocal pos, plan_actions, grid, occupied, inventory\n      path = bfs_to_adjacent(pos, target_coord, occupied)\n      if not path and pos != target_coord:\n          return False\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n      plan_actions.extend(path)\n      plan_actions.append(USE)\n      tx, ty = target_coord\n      if grid[tx, ty, kind_idx] > 0:\n          grid[tx, ty, kind_idx] = 0\n          occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)\n          inventory[kind_idx] += 1\n      return True\n\n  # Collect all required primitives.\n  for prim_idx, cnt in primitives_needed.items():\n      for _ in range(cnt):\n          candidates = np.argwhere(grid[:, :, prim_idx] > 0)\n          if candidates.size == 0:\n              return plan_actions\n          dists = np.abs(candidates[:, 0] - pos[0]) + np.abs(candidates[:, 1] - pos[1])\n          target = tuple(candidates[dists.argmin()])\n          if not move_and_use(target, prim_idx):\n              return plan_actions\n\n  # Move to a workshop and craft the arrow.\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          return plan_actions\n  dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])\n  workshop_target = tuple(workshop_cells[dists.argmin()])\n  move_and_use(workshop_target, workshop_idx)\n\n  return plan_actions", "env_interactions": 23, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T19:32:33.352384", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ------------------------------------------------------------------\n  # Helper: BFS to a free cell adjacent to a target location.\n  # Returns list of movement actions (0:DOWN, 1:UP, 2:LEFT, 3:RIGHT)\n  # ------------------------------------------------------------------\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # DOWN, UP, LEFT, RIGHT\n  USE = 4\n\n  def bfs_to_adjacent(start, target, blocked):\n      \"\"\"Shortest path from start to any empty neighbour of target.\"\"\"\n      h, w = blocked.shape\n      # all admissible destination cells (adjacent & free)\n      goal_cells = []\n      tx, ty = target\n      for a, (dx, dy) in enumerate(DIRS):\n          gx, gy = tx + dx, ty + dy\n          if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:\n              goal_cells.append((gx, gy))\n      if not goal_cells:\n          return []                     # nowhere to stand next to target\n\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (cx, cy), path = q.popleft()\n          if (cx, cy) in goal_cells:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []                         # unreachable\n\n  # ------------------------------------------------------------------\n  # Reset / obtain current state\n  # ------------------------------------------------------------------\n  try:\n      env.reset()\n  except Exception:\n      pass\n\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []\n\n  world = env.world\n  idx = world.cookbook.index\n\n  # ------------------------------------------------------------------\n  # Identify arrow goal and its recipe\n  # ------------------------------------------------------------------\n  arrow_idx = idx.get(\"arrow\")\n  if arrow_idx is None:\n      return []\n\n  # primitive requirements for a single arrow\n  primitives_needed = world.cookbook.primitives_for(arrow_idx)\n\n  # workshop where arrow must be crafted\n  recipe_dict = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe_dict.get(\"_at\") or recipe_dict.get(\"_key\")\n  if workshop_name is None:\n      return []\n  workshop_idx = idx.get(workshop_name)\n  if workshop_idx is None:\n      return []\n\n  # ------------------------------------------------------------------\n  # Local mutable copies of the world state\n  # ------------------------------------------------------------------\n  pos = tuple(state.pos)                     # (x, y)\n  grid = state.grid.copy()                   # (W, H, n_kinds)\n  occupied = np.any(grid > 0, axis=2)        # bool matrix of blocked cells\n  inventory = state.inventory.copy()\n\n  plan_actions = []\n\n  # ------------------------------------------------------------------\n  # Helper: move next to a cell containing `kind_idx` and USE it.\n  # Updates the simulated local state.\n  # ------------------------------------------------------------------\n  def move_and_use(target_coord, kind_idx):\n      nonlocal pos, plan_actions, grid, occupied, inventory\n      path = bfs_to_adjacent(pos, target_coord, occupied)\n      if not path and pos != target_coord:\n          return False\n      # execute movement actions\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n      plan_actions.extend(path)\n      # USE action\n      plan_actions.append(USE)\n      tx, ty = target_coord\n      if grid[tx, ty, kind_idx] > 0:\n          # pick\u2011up / craft consumes the entity\n          grid[tx, ty, kind_idx] = 0\n          occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)\n          inventory[kind_idx] += 1\n      return True\n\n  # ------------------------------------------------------------------\n  # Collect all required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      for _ in range(needed_cnt):\n          # locate nearest remaining primitive of this kind\n          candidates = np.argwhere(grid[:, :, prim_idx] > 0)\n          if candidates.size == 0:\n              # no more primitives of this type \u2013 abort early\n              return plan_actions\n          # Manhattan distance to current position\n          dists = np.abs(candidates[:, 0] - pos[0]) + np.abs(candidates[:, 1] - pos[1])\n          target = tuple(candidates[dists.argmin()])\n          if not move_and_use(target, prim_idx):\n              return plan_actions\n\n  # ------------------------------------------------------------------\n  # Move to a workshop cell and craft the arrow\n  # ------------------------------------------------------------------\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      # workshop may have been cleared in the simulated copy; fall back to original grid\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          return plan_actions\n  dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])\n  workshop_target = tuple(workshop_cells[dists.argmin()])\n  move_and_use(workshop_target, workshop_idx)\n\n  return plan_actions", "env_interactions": 0, "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-10-27T19:32:57.622322", "function_name": "make_arrow", "function_body": "  # Action indices\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  world = env.world\n  # Index of the goal item \"arrow\"\n  arrow_idx = world.cookbook.index.index('arrow')\n  # Primitive requirements for one arrow (primitive_idx -> count)\n  primitives_needed = world.cookbook.primitives_for(arrow_idx)\n\n  # Current state information\n  state = env._current_state\n  cur_pos = tuple(state.pos)\n  # Work on a mutable copy of the grid to track consumed resources\n  grid = state.grid.copy()\n\n  def _manhattan_actions(src, dst):\n      \"\"\"Return a list of movement actions from src to dst using Manhattan steps.\"\"\"\n      actions = []\n      sx, sy = src\n      dx, dy = dst\n      if dx > sx:\n          actions += [DOWN] * (dx - sx)\n      elif dx < sx:\n          actions += [UP] * (sx - dx)\n      if dy > sy:\n          actions += [RIGHT] * (dy - sy)\n      elif dy < sy:\n          actions += [LEFT] * (sy - dy)\n      return actions\n\n  def _nearest(pos, kind_idx):\n      \"\"\"Find the nearest cell containing the given kind index; return None if not found.\"\"\"\n      cells = np.argwhere(grid[:, :, kind_idx] > 0)\n      if cells.size == 0:\n          return None\n      dists = np.abs(cells[:, 0] - pos[0]) + np.abs(cells[:, 1] - pos[1])\n      nearest_idx = dists.argmin()\n      return tuple(cells[nearest_idx].tolist())\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitives for the arrow\n  # ------------------------------------------------------------------\n  for prim_idx, count in primitives_needed.items():\n      for _ in range(count):\n          target = _nearest(cur_pos, prim_idx)\n          if target is None:\n              # Required primitive not present \u2013 abort planning\n              return actions\n          actions += _manhattan_actions(cur_pos, target)\n          cur_pos = target\n          actions.append(USE)               # pick up the primitive\n          # Mark the primitive as consumed in our local view\n          grid[target[0], target[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 2) Move to the workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = _nearest(cur_pos, workshop_idx)\n      if workshop_pos is not None:\n          actions += _manhattan_actions(cur_pos, workshop_pos)\n          cur_pos = workshop_pos\n          actions.append(USE)               # craft at the workshop\n\n  return actions", "env_interactions": 22, "island_id": 5, "scores": {"3": 0.2}}
{"timestamp": "2025-10-27T19:32:58.742534", "function_name": "make_arrow", "function_body": "  # Action indices\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  world = env.world\n  # Index of the goal item \"arrow\"\n  arrow_idx = world.cookbook.index.index('arrow')\n  # Primitive requirements for one arrow\n  primitives_needed = world.cookbook.primitives_for(arrow_idx)\n\n  # Local mutable copy of the grid to keep track of consumed items\n  grid = env._current_state.grid.copy()\n  cur_pos = tuple(env._current_state.pos)  # (row, col)\n\n  def manhattan_path(src, dst):\n      \"\"\"Return a list of movement actions to go from src to dst (Manhattan distance).\"\"\"\n      actions = []\n      sr, sc = src\n      dr, dc = dst\n      if dr > sr:\n          actions += [DOWN] * (dr - sr)\n      elif dr < sr:\n          actions += [UP] * (sr - dr)\n      if dc > sc:\n          actions += [RIGHT] * (dc - sc)\n      elif dc < sc:\n          actions += [LEFT] * (sc - dc)\n      return actions\n\n  def nearest(pos, kind_idx):\n      \"\"\"Find the nearest cell that contains the given kind index.\"\"\"\n      cells = np.argwhere(grid[:, :, kind_idx] > 0)\n      if cells.size == 0:\n          return None\n      dists = np.abs(cells[:, 0] - pos[0]) + np.abs(cells[:, 1] - pos[1])\n      best = cells[dists.argmin()]\n      return tuple(best.tolist())\n\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # 1) Collect all required primitives for the arrow\n  # ----------------------------------------------------------------------\n  for prim_idx, count in primitives_needed.items():\n      for _ in range(count):\n          target = nearest(cur_pos, prim_idx)\n          if target is None:\n              # Required primitive not found \u2013 abort planning\n              return actions\n          actions += manhattan_path(cur_pos, target)\n          cur_pos = target\n          actions.append(USE)          # pick up the primitive\n          # Remove the primitive from our local view so we don't pick it again\n          grid[target[0], target[1], prim_idx] = 0\n\n  # ----------------------------------------------------------------------\n  # 2) Go to the appropriate workshop (if any) and craft the arrow\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = nearest(cur_pos, workshop_idx)\n      if workshop_pos is not None:\n          actions += manhattan_path(cur_pos, workshop_pos)\n          cur_pos = workshop_pos\n          actions.append(USE)   # craft at the workshop\n\n  return actions", "env_interactions": 22, "island_id": 5, "scores": {"3": 0.2}}
{"timestamp": "2025-10-27T19:33:25.944785", "function_name": "make_arrow", "function_body": "  # action indices\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  world = env.world\n  goal_name = \"arrow\"\n  goal_idx = world.cookbook.index.index(goal_name)\n\n  # primitive requirements for one arrow\n  prim_req = world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n\n  # mutable copies of grid and current position\n  grid = env._current_state.grid.copy()\n  cur_pos = tuple(env._current_state.pos)\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def is_walkable(pos):\n      \"\"\"A cell is walkable if it contains no non\u2011grabbable entity.\"\"\"\n      x, y = pos\n      cell = grid[x, y, :]\n      for idx in world.non_grabbable_indices:\n          if cell[idx] > 0:\n              return False\n      return True\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of positions from start to goal using BFS.\"\"\"\n      if start == goal:\n          return [start]\n      w, h = grid.shape[:2]\n      frontier = collections.deque([start])\n      came_from = {start: None}\n      while frontier:\n          cur = frontier.popleft()\n          if cur == goal:\n              break\n          x, y = cur\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h:\n                  nxt = (nx, ny)\n                  if nxt in came_from:\n                      continue\n                  # allow stepping onto the goal even if occupied\n                  if nxt != goal and not is_walkable(nxt):\n                      continue\n                  came_from[nxt] = cur\n                  frontier.append(nxt)\n      else:\n          return None  # no path found\n\n      # reconstruct path\n      path = [goal]\n      while path[-1] != start:\n          path.append(came_from[path[-1]])\n      path.reverse()\n      return path\n\n  def actions_from_path(path):\n      \"\"\"Translate a list of positions into action indices.\"\"\"\n      if not path or len(path) < 2:\n          return []\n      acts = []\n      for (x0, y0), (x1, y1) in zip(path, path[1:]):\n          if x1 == x0 + 1:\n              acts.append(DOWN)\n          elif x1 == x0 - 1:\n              acts.append(UP)\n          elif y1 == y0 + 1:\n              acts.append(RIGHT)\n          elif y1 == y0 - 1:\n              acts.append(LEFT)\n          else:\n              raise ValueError(\"Non\u2011adjacent steps in path\")\n      return acts\n\n  def move_to(src, dst):\n      \"\"\"Return actions moving from src to dst, preferring BFS shortest path.\"\"\"\n      p = bfs_path(src, dst)\n      if p is None:\n          # fallback to Manhattan moves (may collide with obstacles)\n          acts = []\n          sx, sy = src\n          dx, dy = dst\n          if dx > sx:\n              acts += [DOWN] * (dx - sx)\n          elif dx < sx:\n              acts += [UP] * (sx - dx)\n          if dy > sy:\n              acts += [RIGHT] * (dy - sy)\n          elif dy < sy:\n              acts += [LEFT] * (sy - dy)\n          return acts\n      return actions_from_path(p)\n\n  def nearest_of_kind(pos, kind_idx, forbidden=set()):\n      \"\"\"Find the nearest cell containing kind_idx not in forbidden.\"\"\"\n      candidates = np.argwhere(grid[:, :, kind_idx] > 0)\n      if candidates.size == 0:\n          return None\n      if forbidden:\n          mask = np.array([tuple(c) not in forbidden for c in candidates])\n          candidates = candidates[mask]\n          if candidates.size == 0:\n              return None\n      dists = np.abs(candidates[:, 0] - pos[0]) + np.abs(candidates[:, 1] - pos[1])\n      nearest = candidates[dists.argmin()]\n      return tuple(nearest.tolist())\n\n  # ------------------------------------------------------------------\n  # Planning\n  # ------------------------------------------------------------------\n  actions = []\n  harvested = {k: set() for k in prim_req}\n\n  # 1. Collect required primitives\n  for kind_idx, needed in prim_req.items():\n      for _ in range(needed):\n          target = nearest_of_kind(cur_pos, kind_idx, harvested[kind_idx])\n          if target is None:\n              # primitive missing \u2013 abort planning\n              return actions\n          actions += move_to(cur_pos, target)\n          cur_pos = target\n          actions.append(USE)                     # pick up\n          harvested[kind_idx].add(target)\n          grid[target[0], target[1], kind_idx] = 0   # consume locally\n\n  # 2. Move to workshop (if recipe specifies one) and craft\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_target = nearest_of_kind(cur_pos, workshop_idx, set())\n      if ws_target is not None:\n          actions += move_to(cur_pos, ws_target)\n          cur_pos = ws_target\n          actions.append(USE)                     # craft at workshop\n\n  return actions", "env_interactions": 22, "island_id": 5, "scores": {"3": 0.2}}
{"timestamp": "2025-10-27T19:33:27.086857", "function_name": "make_arrow", "function_body": "  # action indices (match CraftWorld definition)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Access world information\n  # ------------------------------------------------------------------\n  world = env.world\n  # index of the goal item \"arrow\"\n  goal_idx = world.cookbook.index.index(\"arrow\")\n  # primitive requirements for a single arrow: {prim_idx: count}\n  prim_req = world.cookbook.primitives_for(goal_idx)\n\n  # mutable copies of the grid and agent position\n  grid = env._current_state.grid.copy()\n  cur_pos = tuple(env._current_state.pos)   # (row, col)\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  import collections\n  import numpy as np\n\n  def _is_walkable(pos):\n      \"\"\"A cell is walkable if it does not contain any non\u2011grabbable entity.\"\"\"\n      x, y = pos\n      cell = grid[x, y, :]\n      for idx in world.non_grabbable_indices:\n          if cell[idx] > 0:\n              return False\n      return True\n\n  def _bfs_path(start, goal):\n      \"\"\"Return a list of positions from start to goal using BFS (4\u2011connected).\"\"\"\n      if start == goal:\n          return [start]\n      w, h = grid.shape[:2]\n      frontier = collections.deque([start])\n      came_from = {start: None}\n      while frontier:\n          cur = frontier.popleft()\n          if cur == goal:\n              break\n          x, y = cur\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h:\n                  nxt = (nx, ny)\n                  if nxt in came_from:\n                      continue\n                  if not _is_walkable(nxt):\n                      continue\n                  came_from[nxt] = cur\n                  frontier.append(nxt)\n      else:\n          return None   # no path found\n\n      # reconstruct path\n      path = [goal]\n      while path[-1] != start:\n          path.append(came_from[path[-1]])\n      path.reverse()\n      return path\n\n  def _actions_from_path(path):\n      \"\"\"Convert a list of positions (including start) to action indices.\"\"\"\n      if not path or len(path) < 2:\n          return []\n      acts = []\n      for (x0, y0), (x1, y1) in zip(path, path[1:]):\n          if x1 == x0 + 1:\n              acts.append(DOWN)\n          elif x1 == x0 - 1:\n              acts.append(UP)\n          elif y1 == y0 + 1:\n              acts.append(RIGHT)\n          elif y1 == y0 - 1:\n              acts.append(LEFT)\n          else:\n              raise ValueError(\"Non\u2011adjacent steps in path\")\n      return acts\n\n  def _move_actions(src, dst):\n      \"\"\"Return actions to move from src to dst, preferring BFS shortest path.\"\"\"\n      path = _bfs_path(src, dst)\n      if path is None:\n          # fallback to Manhattan moves (may collide with obstacles)\n          acts = []\n          sx, sy = src\n          dx, dy = dst\n          if dx > sx:\n              acts += [DOWN] * (dx - sx)\n          elif dx < sx:\n              acts += [UP] * (sx - dx)\n          if dy > sy:\n              acts += [RIGHT] * (dy - sy)\n          elif dy < sy:\n              acts += [LEFT] * (sy - dy)\n          return acts\n      return _actions_from_path(path)\n\n  def _nearest_kind(pos, kind_idx, excluded=None):\n      \"\"\"Find the nearest cell containing `kind_idx` (Manhattan distance).\"\"\"\n      candidates = np.argwhere(grid[:, :, kind_idx] > 0)\n      if candidates.size == 0:\n          return None\n      if excluded:\n          mask = np.array([tuple(c) not in excluded for c in candidates])\n          candidates = candidates[mask]\n          if candidates.size == 0:\n              return None\n      dists = np.abs(candidates[:, 0] - pos[0]) + np.abs(candidates[:, 1] - pos[1])\n      nearest = candidates[dists.argmin()]\n      return tuple(nearest.tolist())\n\n  # ------------------------------------------------------------------\n  # Planning: collect primitives\n  # ------------------------------------------------------------------\n  actions = []\n  taken = {k: set() for k in prim_req}   # remember which cells have been harvested\n\n  for kind_idx, needed in prim_req.items():\n      for _ in range(needed):\n          target = _nearest_kind(cur_pos, kind_idx, taken[kind_idx])\n          if target is None:\n              # Primitive missing \u2013 stop planning\n              return actions\n          actions += _move_actions(cur_pos, target)\n          cur_pos = target\n          actions.append(USE)                     # pick up primitive\n          taken[kind_idx].add(target)\n          grid[target[0], target[1], kind_idx] = 0   # consume locally\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if recipe specifies one) and craft\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = _nearest_kind(cur_pos, workshop_idx)\n      if workshop_pos is not None:\n          actions += _move_actions(cur_pos, workshop_pos)\n          cur_pos = workshop_pos\n          actions.append(USE)                     # craft at workshop\n\n  return actions", "env_interactions": 22, "island_id": 5, "scores": {"3": 0.2}}
{"timestamp": "2025-10-27T19:34:01.504420", "function_name": "make_arrow", "function_body": "  # Reset environment and get references to world components\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.scenario.world          # CraftWorld\n  cookbook = world.cookbook           # Cookbook\n  idx = cookbook.index                # name \u2194 integer id mapping\n\n  # Resolve action indices from the environment specification\n  action_map = env.action_specs()\n  DOWN = action_map[\"DOWN\"]\n  UP = action_map[\"UP\"]\n  LEFT = action_map[\"LEFT\"]\n  RIGHT = action_map[\"RIGHT\"]\n  USE = action_map[\"USE\"]\n  moves = [(DOWN, (1, 0)), (UP, (-1, 0)), (LEFT, (0, -1)), (RIGHT, (0, 1))]\n\n  # ------------------------------------------------------------------\n  # Helper: BFS shortest path from start to target (target may be occupied).\n  # Returns a list of movement actions (indices) to reach the target.\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  def _bfs_path(start, target):\n      if start == target:\n          return []\n      h, w = state.grid.shape[:2]\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          for act, (dr, dc) in moves:\n              nr, nc = cur[0] + dr, cur[1] + dc\n              if not (0 <= nr < h and 0 <= nc < w):\n                  continue\n              nxt = (nr, nc)\n              if nxt in visited:\n                  continue\n              # Allow stepping onto the target even if occupied.\n              if nxt != target and state.grid[nr, nc, :].sum() != 0:\n                  continue\n              visited.add(nxt)\n              parent[nxt] = (cur, act)\n              q.append(nxt)\n\n      if target not in parent and start != target:\n          return []  # unreachable\n\n      # Reconstruct path.\n      path = []\n      cur = target\n      while cur != start:\n          prev, act = parent[cur]\n          path.append(act)\n          cur = prev\n      path.reverse()\n      return path\n\n  # ------------------------------------------------------------------\n  # Helper: Locate the nearest cell that contains a given kind (primitive\n  # or workshop). Returns (action_path, cell_coords) or ([], None) if not\n  # found.\n  # ------------------------------------------------------------------\n  def _nearest_kind(kind_idx, start):\n      # Already on a cell of the desired kind.\n      if state.grid[start[0], start[1], kind_idx] > 0:\n          return [], start\n      h, w = state.grid.shape[:2]\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          cur = q.popleft()\n          for act, (dr, dc) in moves:\n              nr, nc = cur[0] + dr, cur[1] + dc\n              if not (0 <= nr < h and 0 <= nc < w):\n                  continue\n              nxt = (nr, nc)\n              if nxt in visited:\n                  continue\n              occupied = state.grid[nr, nc, :].sum() != 0\n              # We may step onto a cell that holds the target kind even if occupied.\n              if occupied and state.grid[nr, nc, kind_idx] == 0:\n                  continue\n              visited.add(nxt)\n              parent[nxt] = (cur, act)\n              if state.grid[nr, nc, kind_idx] > 0:\n                  # Reconstruct path to this cell.\n                  path = []\n                  cur2 = nxt\n                  while cur2 != start:\n                      prev2, act2 = parent[cur2]\n                      path.append(act2)\n                      cur2 = prev2\n                  path.reverse()\n                  return path, nxt\n              q.append(nxt)\n      return [], None  # not found\n\n  # ------------------------------------------------------------------\n  # Identify the goal item ('arrow') and the primitive requirements.\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  if goal_name not in idx.contents:\n      return []  # arrow not defined in this world\n  goal_idx = idx[goal_name]\n\n  primitive_needs = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n  plan = []\n\n  # ------------------------------------------------------------------\n  # 1. Collect each required primitive the necessary number of times.\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          path, cell = _nearest_kind(prim_idx, state.pos)\n          if cell is None:\n              # Primitive missing or unreachable \u2013 abort early.\n              return plan\n          plan.extend(path)\n          state.pos = cell\n          plan.append(USE)  # pick up the primitive\n          # Update simulated state.\n          r, c = cell\n          state.inventory[prim_idx] += 1\n          state.grid[r, c, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 2. Move to the appropriate workshop and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      return plan  # no workshop information; cannot craft\n\n  workshop_idx = idx[workshop_name]\n  path, cell = _nearest_kind(workshop_idx, state.pos)\n  if cell is None:\n      return plan  # workshop unreachable\n  plan.extend(path)\n  state.pos = cell\n  plan.append(USE)  # craft the arrow at the workshop\n\n  return plan", "env_interactions": 26, "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T19:34:02.625692", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.scenario.world\n  cookbook = world.cookbook\n  index = cookbook.index\n\n  action_map = env.action_specs()\n  DOWN = action_map[\"DOWN\"]\n  UP = action_map[\"UP\"]\n  LEFT = action_map[\"LEFT\"]\n  RIGHT = action_map[\"RIGHT\"]\n  USE = action_map[\"USE\"]\n\n  moves = [(DOWN, (1, 0)),\n           (UP, (-1, 0)),\n           (LEFT, (0, -1)),\n           (RIGHT, (0, 1))]\n\n  from collections import deque\n\n  def _bfs_path(start, target):\n      \"\"\"Return list of movement actions from start to target.\"\"\"\n      if start == target:\n          return []\n      h, w = state.grid.shape[:2]\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          for act, (dr, dc) in moves:\n              nr, nc = cur[0] + dr, cur[1] + dc\n              if not (0 <= nr < h and 0 <= nc < w):\n                  continue\n              nxt = (nr, nc)\n              if nxt in visited:\n                  continue\n              # allow stepping onto target even if occupied\n              if nxt != target and state.grid[nr, nc, :].any():\n                  continue\n              visited.add(nxt)\n              parent[nxt] = (cur, act)\n              q.append(nxt)\n      if target not in parent and start != target:\n          return []  # no path found\n      # reconstruct path\n      path = []\n      cur = target\n      while cur != start:\n          prev, act = parent[cur]\n          path.append(act)\n          cur = prev\n      path.reverse()\n      return path\n\n  goal_name = \"arrow\"\n  if goal_name not in index.contents:\n      return []\n  goal_idx = index[goal_name]\n\n  primitive_needs = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n  plan = []\n\n  # Collect required primitives\n  for prim_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if cells.size == 0:\n              return plan  # primitive missing\n          dists = np.abs(cells - np.array(state.pos)).sum(axis=1)\n          target = tuple(cells[dists.argmin()])\n          move_seq = _bfs_path(state.pos, target)\n          plan.extend(move_seq)\n          state.pos = target\n          plan.append(USE)\n          r, c = target\n          state.inventory[prim_idx] += 1\n          state.grid[r, c, prim_idx] = 0\n\n  # Move to workshop and craft\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      return plan\n  workshop_idx = index[workshop_name]\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      return plan\n  dists = np.abs(workshop_cells - np.array(state.pos)).sum(axis=1)\n  workshop_target = tuple(workshop_cells[dists.argmin()])\n  move_seq = _bfs_path(state.pos, workshop_target)\n  plan.extend(move_seq)\n  state.pos = workshop_target\n  plan.append(USE)\n\n  return plan", "env_interactions": 24, "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T19:34:24.070794", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  world = env.world\n  cookbook = world.cookbook\n\n  # index of the target item \"arrow\"\n  goal_idx = cookbook.index.index('arrow')\n  # primitive requirements for a single arrow\n  primitives_needed = cookbook.primitives_for(goal_idx)\n\n  actions = []\n  cur_pos = env._current_state.pos\n\n  def _move_actions(src, dst):\n      \"\"\"Generate Manhattan moves from src to dst (ignores obstacles).\"\"\"\n      x, y = src\n      tx, ty = dst\n      acts = []\n      dx = tx - x\n      dy = ty - y\n      if dx > 0:\n          acts += [DOWN] * dx\n      elif dx < 0:\n          acts += [UP] * (-dx)\n      if dy > 0:\n          acts += [RIGHT] * dy\n      elif dy < 0:\n          acts += [LEFT] * (-dy)\n      return acts\n\n  def _nearest_kind(pos, kind_idx):\n      \"\"\"Return coordinates of the nearest cell containing kind_idx.\"\"\"\n      grid = env._current_state.grid\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n      nearest = int(dists.argmin())\n      return tuple(locations[nearest].tolist())\n\n  # ------------------------------------------------------------------\n  # 1. Collect required primitives\n  # ------------------------------------------------------------------\n  for kind_idx, qty in primitives_needed.items():\n      for _ in range(qty):\n          target = _nearest_kind(cur_pos, kind_idx)\n          if target is None:\n              # Primitive not present; abort early.\n              return actions\n          actions += _move_actions(cur_pos, target)\n          cur_pos = target\n          actions.append(USE)   # pick up / interact\n\n  # ------------------------------------------------------------------\n  # 2. Move to the workshop (if any) and craft the arrow\n  # ------------------------------------------------------------------\n  workshop_name = cookbook.recipes[goal_idx].get('_at')\n  if workshop_name is not None:\n      workshop_idx = cookbook.index.index(workshop_name)\n      workshop_pos = _nearest_kind(cur_pos, workshop_idx)\n      if workshop_pos is not None:\n          actions += _move_actions(cur_pos, workshop_pos)\n          cur_pos = workshop_pos\n          actions.append(USE)   # craft at the workshop\n\n  return actions", "env_interactions": 22, "island_id": 2, "scores": {"3": 0.2}}
{"timestamp": "2025-10-27T19:34:25.177507", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  world = env.world\n  cookbook = world.cookbook\n\n  # index of the target item 'arrow'\n  goal_idx = cookbook.index.index('arrow')\n  # primitive requirements for a single arrow\n  primitives_needed = cookbook.primitives_for(goal_idx)\n\n  actions = []\n  cur_pos = env._current_state.pos\n\n  def _move_actions(src, dst):\n      \"\"\"Generate Manhattan move actions from src to dst (ignores obstacles).\"\"\"\n      x, y = src\n      tx, ty = dst\n      acts = []\n      dx = tx - x\n      dy = ty - y\n      if dx > 0:\n          acts += [DOWN] * dx\n      elif dx < 0:\n          acts += [UP] * (-dx)\n      if dy > 0:\n          acts += [RIGHT] * dy\n      elif dy < 0:\n          acts += [LEFT] * (-dy)\n      return acts\n\n  def _nearest_kind(pos, kind_idx):\n      \"\"\"Find the closest cell containing the given kind index.\"\"\"\n      grid = env._current_state.grid\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n      nearest = int(dists.argmin())\n      return tuple(locations[nearest].tolist())\n\n  # ------------------------------------------------------------\n  # 1. Collect required primitives\n  # ------------------------------------------------------------\n  for prim_idx, qty in primitives_needed.items():\n      for _ in range(qty):\n          target = _nearest_kind(cur_pos, prim_idx)\n          if target is None:\n              # Primitive not present \u2013 abort early\n              return actions\n          actions += _move_actions(cur_pos, target)\n          cur_pos = target\n          actions.append(USE)   # pick up / interact\n\n  # ------------------------------------------------------------\n  # 2. Move to the workshop and craft the arrow\n  # ------------------------------------------------------------\n  workshop_name = cookbook.recipes[goal_idx].get('_at')\n  if workshop_name is not None:\n      workshop_idx = cookbook.index.index(workshop_name)\n      workshop_pos = _nearest_kind(cur_pos, workshop_idx)\n      if workshop_pos is not None:\n          actions += _move_actions(cur_pos, workshop_pos)\n          cur_pos = workshop_pos\n          actions.append(USE)   # craft at workshop\n\n  return actions", "env_interactions": 22, "island_id": 2, "scores": {"3": 0.2}}
{"timestamp": "2025-10-27T19:34:54.401662", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  # Define goal\n  goal_name = \"arrow\"\n  goal_idx = idx[goal_name]\n\n  # Get primitive requirements\n  primitive_counts = world.cookbook.primitives_for(goal_idx)\n\n  # Determine workshop if needed\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else idx[wk]\n\n  # Helper functions\n  def find_locations(kind):\n      occ = np.where(state.grid[:, :, kind] > 0)\n      return list(zip(occ[0].tolist(), occ[1].tolist()))\n\n  def bfs_path(start, goal):\n      if start == goal:\n          return [start]\n      W, H = state.grid.shape[:2]\n\n      blocked = set()\n      for ng in world.non_grabbable_indices:\n          occ = np.where(state.grid[:, :, ng] > 0)\n          blocked.update(zip(occ[0].tolist(), occ[1].tolist()))\n\n      q = collections.deque([start])\n      prev = {start: None}\n      while q:\n          cur = q.popleft()\n          for dx, dy in ((1,0),(-1,0),(0,1),(0,-1)):\n              nx, ny = cur[0]+dx, cur[1]+dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:\n                  nxt = (nx, ny)\n                  if nxt not in prev:\n                      prev[nxt] = cur\n                      if nxt == goal:\n                          path = [goal]\n                          while path[-1] != start:\n                              path.append(prev[path[-1]])\n                          path.reverse()\n                          return path\n                      q.append(nxt)\n      return [start]\n\n  def move_action(cur, nxt):\n      dx, dy = nxt[0]-cur[0], nxt[1]-cur[1]\n      if dx == 1:\n          return 3   # RIGHT\n      if dx == -1:\n          return 2   # LEFT\n      if dy == 1:\n          return 0   # DOWN\n      if dy == -1:\n          return 1   # UP\n      raise AssertionError(\"Non\u2011adjacent move\")\n\n  actions = []\n  cur_pos = state.pos\n\n  # Collect primitives\n  for prim_idx, needed in primitive_counts.items():\n      while state.inventory[prim_idx] < needed:\n          locations = find_locations(prim_idx)\n          if not locations:\n              break\n          target = min(locations, key=lambda p: abs(p[0]-cur_pos[0]) + abs(p[1]-cur_pos[1]))\n          path = bfs_path(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n          actions.append(4)   # USE to pick up\n          state.inventory[prim_idx] += 1\n          state.grid[target[0], target[1], prim_idx] = 0\n\n  # Move to workshop and craft\n  if workshop_kind is not None:\n      wk_locs = find_locations(workshop_kind)\n      if wk_locs:\n          target = min(wk_locs, key=lambda p: abs(p[0]-cur_pos[0]) + abs(p[1]-cur_pos[1]))\n          path = bfs_path(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n      actions.append(4)   # USE to craft\n  else:\n      actions.append(4)   # USE to craft\n\n  return actions", "env_interactions": 19, "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T19:34:55.513128", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  # target item\n  goal_name = \"arrow\"\n  goal_idx = idx[goal_name]\n\n  # primitives needed (recursively expanded)\n  primitive_counts = world.cookbook.primitives_for(goal_idx)\n\n  # workshop required for crafting, if any\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else idx[wk]\n\n  # ------------------------------------------------------------------\n  # helper utilities\n  # ------------------------------------------------------------------\n  def find_locations(kind):\n      \"\"\"Return list of (x, y) where `kind` appears on the current grid.\"\"\"\n      occ = np.where(state.grid[:, :, kind] > 0)\n      return list(zip(occ[0].tolist(), occ[1].tolist()))\n\n  def bfs_path(start, goal):\n      \"\"\"Shortest path from start to goal avoiding non\u2011grabbable cells.\"\"\"\n      if start == goal:\n          return [start]\n      W, H = state.grid.shape[:2]\n\n      # cells occupied by non\u2011grabbable entities are blocked\n      blocked = set()\n      for ng in world.non_grabbable_indices:\n          occ = np.where(state.grid[:, :, ng] > 0)\n          blocked.update(zip(occ[0].tolist(), occ[1].tolist()))\n\n      q = collections.deque([start])\n      prev = {start: None}\n      while q:\n          cur = q.popleft()\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:\n                  nxt = (nx, ny)\n                  if nxt not in prev:\n                      prev[nxt] = cur\n                      if nxt == goal:\n                          # reconstruct path\n                          path = [goal]\n                          while path[-1] != start:\n                              path.append(prev[path[-1]])\n                          path.reverse()\n                          return path\n                      q.append(nxt)\n      # no reachable path\n      return [start]\n\n  def move_action(cur, nxt):\n      \"\"\"Convert an adjacent step into a DMLab action index.\"\"\"\n      dx, dy = nxt[0] - cur[0], nxt[1] - cur[1]\n      if dx == 1:\n          return 3   # RIGHT\n      if dx == -1:\n          return 2   # LEFT\n      if dy == 1:\n          return 0   # DOWN\n      if dy == -1:\n          return 1   # UP\n      raise AssertionError(\"Requested move is not adjacent\")\n\n  # ------------------------------------------------------------------\n  # build the plan\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = state.pos\n\n  # 1) collect all required primitives\n  for prim_idx, needed in primitive_counts.items():\n      while state.inventory[prim_idx] < needed:\n          locations = find_locations(prim_idx)\n          if not locations:\n              break  # cannot find more of this primitive\n          # choose the nearest instance (Manhattan distance)\n          target = min(\n              locations,\n              key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1])\n          )\n          # move to the target\n          path = bfs_path(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n          # pick it up\n          actions.append(4)   # USE\n          state.inventory[prim_idx] += 1\n          state.grid[target[0], target[1], prim_idx] = 0\n\n  # 2) go to workshop (if needed) and craft the arrow\n  if workshop_kind is not None:\n      wk_locs = find_locations(workshop_kind)\n      if wk_locs:\n          target = min(\n              wk_locs,\n              key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1])\n          )\n          path = bfs_path(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n      actions.append(4)   # USE to craft at workshop\n  else:\n      actions.append(4)   # USE to craft in place\n\n  return actions", "env_interactions": 19, "island_id": 3, "scores": {"3": 1.5}}
