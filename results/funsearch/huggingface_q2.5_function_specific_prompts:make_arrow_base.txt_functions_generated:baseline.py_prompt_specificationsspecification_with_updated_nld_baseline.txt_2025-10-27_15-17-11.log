{"timestamp": "2025-10-27T17:03:44.644902", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Reset environment and obtain current state and world information\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world\n  cookbook = world.cookbook\n\n  # Target item and its recipe information\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n  primitive_needs = cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  if \"_at\" in recipe:\n      workshop_idx = cookbook.index[recipe[\"_at\"]]\n\n  # --------------------------------------------------------------\n  # Helper: BFS path finder (allows stepping onto the goal cell)\n  # --------------------------------------------------------------\n  def bfs_path(start, goal, occupied):\n      w, h = occupied.shape\n      visited = np.full((w, h), False, dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start] = True\n      while q:\n          x, y = q.popleft()\n          if (x, y) == goal:\n              break\n          for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):\n              if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:\n                  if (nx, ny) == goal or not occupied[nx, ny]:\n                      visited[nx, ny] = True\n                      prev[(nx, ny)] = (x, y)\n                      q.append((nx, ny))\n      if not visited[goal]:\n          return None\n      # reconstruct path (list of positions, excluding start, including goal)\n      path = []\n      cur = goal\n      while cur != start:\n          path.append(cur)\n          cur = prev[cur]\n      path.reverse()\n      return path\n\n  # Helper: translate a movement delta into an action index\n  def delta_to_action(dx, dy):\n      if dx == 1:\n          return 3   # RIGHT\n      if dx == -1:\n          return 2   # LEFT\n      if dy == 1:\n          return 0   # DOWN\n      if dy == -1:\n          return 1   # UP\n      raise ValueError(\"Invalid movement delta\")\n\n  actions = []\n  cur_pos = tuple(state.pos)\n  # mutable copy of the grid to keep track of collected primitives\n  grid = state.grid.copy()\n\n  # --------------------------------------------------------------\n  # Collect all required primitives\n  # --------------------------------------------------------------\n  for kind_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          locations = np.argwhere(grid[:, :, kind_idx] > 0)\n          if locations.size == 0:\n              break\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n          occupied_mask = np.any(grid, axis=2)\n          chosen_path = None\n          target_cell = None\n          for idx in order:\n              cand = tuple(locations[idx])\n              path = bfs_path(cur_pos, cand, occupied_mask)\n              if path is not None:\n                  chosen_path = path\n                  target_cell = cand\n                  break\n          if chosen_path is None:\n              continue\n          for step in chosen_path:\n              dx = step[0] - cur_pos[0]\n              dy = step[1] - cur_pos[1]\n              actions.append(delta_to_action(dx, dy))\n              cur_pos = step\n          actions.append(4)   # USE to pick up\n          grid[target_cell[0], target_cell[1], kind_idx] = 0\n\n  # --------------------------------------------------------------\n  # Move to workshop (if required) and craft the arrow\n  # --------------------------------------------------------------\n  if workshop_idx is not None:\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          dists = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n          occupied_mask = np.any(state.grid, axis=2)   # original grid (workshops are occupied)\n          for idx in order:\n              cand = tuple(workshop_cells[idx])\n              path = bfs_path(cur_pos, cand, occupied_mask)\n              if path is not None:\n                  for step in path:\n                      dx = step[0] - cur_pos[0]\n                      dy = step[1] - cur_pos[1]\n                      actions.append(delta_to_action(dx, dy))\n                      cur_pos = step\n                  actions.append(4)   # USE to craft\n                  break\n\n  return actions", "env_interactions": 26, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T17:03:45.793195", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Reset the environment and obtain the current state and world information\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world\n  cookbook = world.cookbook\n\n  # Identify the target item (\"arrow\") and its recipe\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n  primitive_needs = cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  if \"_at\" in recipe:\n      workshop_idx = cookbook.index[recipe[\"_at\"]]\n\n  # Helper: BFS to find a walkable path from start to goal (allow stepping onto goal)\n  def bfs_path(start, goal, occupied):\n      w, h = occupied.shape\n      visited = np.full((w, h), False, dtype=bool)\n      prev = {}\n      q = deque()\n      q.append(start)\n      visited[start] = True\n      while q:\n          x, y = q.popleft()\n          if (x, y) == goal:\n              break\n          for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):\n              if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:\n                  # Goal cell may be occupied; treat it as walkable\n                  if (nx, ny) == goal or not occupied[nx, ny]:\n                      visited[nx, ny] = True\n                      prev[(nx, ny)] = (x, y)\n                      q.append((nx, ny))\n      if not visited[goal]:\n          return None\n      # Reconstruct path (list of positions, excluding start, including goal)\n      path = []\n      cur = goal\n      while cur != start:\n          path.append(cur)\n          cur = prev[cur]\n      path.reverse()\n      return path\n\n  # Helper: translate a step delta into an action index\n  def step_to_action(dx, dy):\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise ValueError(\"Invalid step delta\")\n\n  actions = []\n  cur_pos = tuple(state.pos)\n  # Keep a mutable copy of the grid to track collected primitives\n  grid = state.grid.copy()\n\n  # ----------------------------------------------------------------------\n  # Collect all required primitives\n  # ----------------------------------------------------------------------\n  for kind_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          # Find all remaining cells containing this primitive\n          locations = np.argwhere(grid[:, :, kind_idx] > 0)\n          if locations.size == 0:\n              break  # No more of this primitive left\n          # Sort locations by Manhattan distance from current position\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n\n          occupied_mask = np.any(grid, axis=2)\n          path_found = None\n          target_cell = None\n          for idx in order:\n              cand = tuple(locations[idx])\n              path = bfs_path(cur_pos, cand, occupied_mask)\n              if path is not None:\n                  path_found = path\n                  target_cell = cand\n                  break\n          if path_found is None:\n              continue  # Could not reach any remaining instance\n\n          # Follow the path, emitting movement actions\n          for step in path_found:\n              dx = step[0] - cur_pos[0]\n              dy = step[1] - cur_pos[1]\n              actions.append(step_to_action(dx, dy))\n              cur_pos = step\n          # Pick up the primitive\n          actions.append(4)                     # USE\n          grid[target_cell[0], target_cell[1], kind_idx] = 0\n\n  # ----------------------------------------------------------------------\n  # Go to the workshop (if required) and craft the arrow\n  # ----------------------------------------------------------------------\n  if workshop_idx is not None:\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          dists = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n          occupied_mask = np.any(state.grid, axis=2)   # Original grid (workshop cells are occupied)\n          for idx in order:\n              cand = tuple(workshop_cells[idx])\n              path = bfs_path(cur_pos, cand, occupied_mask)\n              if path is not None:\n                  for step in path:\n                      dx = step[0] - cur_pos[0]\n                      dy = step[1] - cur_pos[1]\n                      actions.append(step_to_action(dx, dy))\n                      cur_pos = step\n                  actions.append(4)                 # USE to trigger crafting\n                  break\n\n  return actions", "env_interactions": 26, "island_id": 6, "scores": {"3": 0.5}}
