cur\n                      if nxt == goal:\n                          # reconstruct path\n                          path = [goal]\n                          while path[-1] != start:\n                              path.append(prev[path[-1]])\n                          path.reverse()\n                          return path\n                      queue.append(nxt)\n      # No path found \u2013 stay where we are\n      return [start]\n\n  def move_action(cur, nxt):\n      \"\"\"Translate a step into an action index (DOWN=0, UP=1, LEFT=2, RIGHT=3).\"\"\"\n      dx = nxt[0] - cur[0]\n      dy = nxt[1] - cur[1]\n      if dx == 1:\n          return 3   # RIGHT\n      if dx == -1:\n          return 2   # LEFT\n      if dy == 1:\n          return 0   # DOWN\n      if dy == -1:\n          return 1   # UP\n      raise AssertionError(\"Requested move is not to an adjacent cell\")\n\n  # ------------------------------------------------------------\n  # Build the action sequence\n  # ------------------------------------------------------------\n  actions = []\n  cur_pos = state.pos\n\n  # 1) Collect all required primitives\n  for prim_idx, needed in primitive_counts.items():\n      while state.inventory[prim_idx] < needed:\n          locations = find_locations(prim_idx)\n          if not locations:\n              # No more copies available \u2013 abort collection for this primitive\n              break\n\n          # Choose the nearest instance (Manhattan distance)\n          target = min(\n              locations,\n              key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1])\n          )\n\n          # Navigate to the target cell\n          path = bfs_path(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n\n          # Pick up the primitive (USE)\n          actions.append(4)   # USE\n          # Update the planning snapshot\n          state.inventory[prim_idx] += 1\n          state.grid[target[0], target[1], prim_idx] = 0\n\n  # 2) Move to the required workshop (if any) and craft\n  if workshop_kind is not None:\n      wk_locations = find_locations(workshop_kind)\n      if wk_locations:\n          target = min(\n              wk_locations,\n              key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1])\n          )\n          path = bfs_path(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n\n  # 3) Craft the arrow (USE at current location)\n  actions.append(4)   # USE\n\n  return actions", "env_interactions": 19, "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T19:45:56.884493", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Reset environment and get references\n  env.reset()\n  state = env._current_state\n  world = env.scenario.world\n  cookbook = world.cookbook\n  index = cookbook.index\n\n  # Resolve action indices\n  action_map = env.action_specs()\n  DOWN = action_map.get(\"DOWN\", 0)\n  UP = action_map.get(\"UP\", 1)\n  LEFT = action_map.get(\"LEFT\", 2)\n  RIGHT = action_map.get(\"RIGHT\", 3)\n  USE = action_map.get(\"USE\", 4)\n\n  # Goal item\n  goal_name = \"arrow\"\n  if goal_name not in index.contents:\n      return []\n  goal_idx = index[goal_name]\n\n  # Primitive requirements for the goal\n  primitive_needs = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n\n  # Movement directions\n  moves = [(DOWN, (1, 0)), (UP, (-1, 0)), (LEFT, (0, -1)), (RIGHT, (0, 1))]\n\n  def bfs_path(start, target):\n      \"\"\"Return a list of movement actions from start to target (target may be occupied).\"\"\"\n      if start == target:\n          return []\n      h, w = state.grid.shape[:2]\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          for act, (dr, dc) in moves:\n              nr, nc = cur[0] + dr, cur[1] + dc\n              if not (0 <= nr < h and 0 <= nc < w):\n                  continue\n              nxt = (nr, nc)\n              # Allow stepping onto the target even if occupied.\n              if nxt != target and state.grid[nr, nc, :].sum() != 0:\n                  continue\n              if nxt in visited:\n                  continue\n              visited.add(nxt)\n              parent[nxt] = (cur, act)\n              q.append(nxt)\n      if target not in parent and start != target:\n          return []  # No path found\n      # Reconstruct path\n      path = []\n      cur = target\n      while cur != start:\n          prev, act = parent[cur]\n          path.append(act)\n          cur = prev\n      path.reverse()\n      return path\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Phase 1: Collect all required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          # Locate nearest cell containing this primitive\n          cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if cells.size == 0:\n              # Primitive not present; abort early\n              return actions\n          dists = np.abs(cells - np.array(state.pos)).sum(axis=1)\n          tr, tc = cells[dists.argmin()]\n\n          # Move to the primitive\n          move_seq = bfs_path(state.pos, (tr, tc))\n          actions.extend(move_seq)\n          state.pos = (tr, tc)\n\n          # Pick it up\n          actions.append(USE)\n          state.inventory[prim_idx] += 1\n          state.grid[tr, tc, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Phase 2: Move to the appropriate workshop and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      return actions  # No workshop information available\n\n  workshop_idx = index[workshop_name]\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      return actions  # No workshop present in the grid\n\n  # Choose nearest workshop cell\n  dists = np.abs(workshop_cells - np.array(state.pos)).sum(axis=1)\n  wr, wc = workshop_cells[dists.argmin()]\n\n  # Move to the workshop\n  move_seq = bfs_path(state.pos, (wr, wc))\n  actions.extend(move_seq)\n  state.pos = (wr, wc)\n\n  # Craft the arrow\n  actions.append(USE)\n\n  return actions", "env_interactions": 24, "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T19:45:58.008321", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.scenario.world\n  cookbook = world.cookbook\n  idx = cookbook.index\n\n  # Resolve action indices.\n  action_map = env.action_specs()\n  DOWN = action_map.get(\"DOWN\", 0)\n  UP = action_map.get(\"UP\", 1)\n  LEFT = action_map.get(\"LEFT\", 2)\n  RIGHT = action_map.get(\"RIGHT\", 3)\n  USE = action_map.get(\"USE\", 4)\n\n  moves = [(DOWN, (1, 0)), (UP, (-1, 0)), (LEFT, (0, -1)), (RIGHT, (0, 1))]\n\n  goal_name = \"arrow\"\n  if goal_name not in idx.contents:\n      return []\n  goal_idx = idx[goal_name]\n\n  # Primitive requirements for the goal.\n  primitive_needs = cookbook.primitives_for(goal_idx)  # dict {prim_idx: count}\n  actions = []\n\n  from collections import deque\n\n  def bfs_path(start, target):\n      \"\"\"Return list of move actions from start to target (target may be occupied).\"\"\"\n      if start == target:\n          return []\n      h, w = state.grid.shape[:2]\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          for act, (dr, dc) in moves:\n              nr, nc = cur[0] + dr, cur[1] + dc\n              if not (0 <= nr < h and 0 <= nc < w):\n                  continue\n              nxt = (nr, nc)\n              # Treat occupied cells as obstacles unless it's the destination.\n              if nxt != target and state.grid[nr, nc, :].sum() != 0:\n                  continue\n              if nxt in visited:\n                  continue\n              visited.add(nxt)\n              parent[nxt] = (cur, act)\n              q.append(nxt)\n      if target not in parent and start != target:\n          return []  # No path found.\n      # Reconstruct path.\n      path = []\n      cur = target\n      while cur != start:\n          prev, act = parent[cur]\n          path.append(act)\n          cur = prev\n      path.reverse()\n      return path\n\n  def nearest_cell(start, kind_idx):\n      \"\"\"Find the closest cell containing `kind_idx` using BFS.\"\"\"\n      if state.grid[start[0], start[1], kind_idx] > 0:\n          return [], start\n      h, w = state.grid.shape[:2]\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          cur = q.popleft()\n          for act, (dr, dc) in moves:\n              nr, nc = cur[0] + dr, cur[1] + dc\n              if not (0 <= nr < h and 0 <= nc < w):\n                  continue\n              nxt = (nr, nc)\n              if nxt in visited:\n                  continue\n              # Block cells unless they contain the desired kind.\n              if state.grid[nr, nc, :].sum() != 0 and state.grid[nr, nc, kind_idx] == 0:\n                  continue\n              visited.add(nxt)\n              parent[nxt] = (cur, act)\n              if state.grid[nr, nc, kind_idx] > 0:\n                  # Reconstruct path to this cell.\n                  path = []\n                  cur2 = nxt\n                  while cur2 != start:\n                      prev2, act2 = parent[cur2]\n                      path.append(act2)\n                      cur2 = prev2\n                  path.reverse()\n                  return path, nxt\n              q.append(nxt)\n      return [], None\n\n  # Phase 1: Collect required primitives.\n  for prim_idx, cnt in primitive_needs.items():\n      for _ in range(cnt):\n          path, cell = nearest_cell(state.pos, prim_idx)\n          if cell is None:\n              return actions\n          actions.extend(path)\n          state.pos = cell\n          actions.append(USE)\n          # Update our internal copy of inventory and grid.\n          state.inventory[prim_idx] += 1\n          state.grid[cell[0], cell[1], prim_idx] = 0\n\n  # Phase 2: Move to the workshop and craft the arrow.\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      return actions\n  workshop_idx = idx[workshop_name]\n  path, cell = nearest_cell(state.pos, workshop_idx)\n  if cell is not None:\n      actions.extend(path)\n      state.pos = cell\n      actions.append(USE)\n\n  return actions", "env_interactions": 26, "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T19:46:24.788875", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  world = env.world\n  idx_arrow = world.cookbook.index.index('arrow')\n  primitives_needed = world.cookbook.primitives_for(idx_arrow)\n\n  actions = []\n  cur_pos = env._current_state.pos\n  grid = env._current_state.grid.copy()\n  H, W = grid.shape[:2]\n\n  def bfs(start, goal):\n      \"\"\"Return a list of actions to move from start to goal, or None if unreachable.\"\"\"\n      if start == goal:\n          return []\n      visited = np.full((H, W), False, dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start] = True\n      while q:\n          x, y = q.popleft()\n          for dx, dy, act in ((1, 0, DOWN), (-1, 0, UP), (0, 1, RIGHT), (0, -1, LEFT)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < H and 0 <= ny < W and not visited[nx, ny]:\n                  # allow stepping onto the goal even if occupied\n                  if (nx, ny) != goal and grid[nx, ny, :].sum() > 0:\n                      continue\n                  visited[nx, ny] = True\n                  prev[(nx, ny)] = ((x, y), act)\n                  if (nx, ny) == goal:\n                      path = []\n                      cur = goal\n                      while cur != start:\n                          cur, act = prev[cur]\n                          path.append(act)\n                      path.reverse()\n                      return path\n                  q.append((nx, ny))\n      return None\n\n  def nearest_kind(pos, kind_idx):\n      \"\"\"Find the reachable cell containing kind_idx with the shortest path.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      best_path = None\n      best_loc = None\n      for loc in locations:\n          loc_tup = (int(loc[0]), int(loc[1]))\n          path = bfs(pos, loc_tup)\n          if path is None:\n              continue\n          if best_path is None or len(path) < len(best_path):\n              best_path = path\n              best_loc = loc_tup\n      return best_loc, best_path\n\n  # Collect required primitives\n  for prim_idx, cnt in primitives_needed.items():\n      for _ in range(cnt):\n          target, path = nearest_kind(cur_pos, prim_idx)\n          if target is None:\n              return actions  # cannot find required primitive\n          actions.extend(path)\n          actions.append(USE)          # pick up the primitive\n          cur_pos = target\n          if grid[target[0], target[1], prim_idx] > 0:\n              grid[target[0], target[1], prim_idx] -= 1\n\n  # Move to workshop (if recipe specifies one) and craft\n  recipe = world.cookbook.recipes.get(idx_arrow, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      target, path = nearest_kind(cur_pos, workshop_idx)\n      if target is not None:\n          actions.extend(path)\n          actions.append(USE)  # craft at the workshop\n\n  return actions", "env_interactions": 26, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T19:46:26.048067", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action constants (match CraftState step implementation)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  world = env.world\n  # index of the goal item \"arrow\"\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  # primitive requirements for a single arrow\n  primitives_needed = world.cookbook.primitives_for(arrow_idx)\n\n  # current mutable state while planning\n  cur_pos = tuple(env._current_state.pos)\n  grid = env._current_state.grid.copy()\n\n  # ------------------------------------------------------------------\n  # Helper: BFS returning a list of actions to reach a target cell.\n  # ------------------------------------------------------------------\n  def bfs_path(start, goal, grid):\n      \"\"\"Return list of actions (DOWN/UP/LEFT/RIGHT) from start to goal.\n      start/goal are (x, y) tuples. Cells that contain any entity are\n      treated as blocked unless they are the goal cell itself.\n      \"\"\"\n      if start == goal:\n          return []\n      H, W = grid.shape[:2]\n      visited = np.zeros((H, W), dtype=bool)\n      prev = {}  # (x, y) -> ((px, py), action)\n      q = deque()\n      q.append(start)\n      visited[start] = True\n      while q:\n          x, y = q.popleft()\n          for dx, dy, act in ((1, 0, DOWN), (-1, 0, UP),\n                              (0, 1, RIGHT), (0, -1, LEFT)):\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < H and 0 <= ny < W):\n                  continue\n              if visited[nx, ny]:\n                  continue\n              # allow stepping onto the goal even if blocked\n              if (nx, ny) != goal and grid[nx, ny, :].sum() > 0:\n                  continue\n              visited[nx, ny] = True\n              prev[(nx, ny)] = ((x, y), act)\n              if (nx, ny) == goal:\n                  # reconstruct path\n                  actions = []\n                  cur = goal\n                  while cur != start:\n                      (p, a) = prev[cur]\n                      actions.append(a)\n                      cur = p\n                  actions.reverse()\n                  return actions\n              q.append((nx, ny))\n      # no path found\n      return None\n\n  # ------------------------------------------------------------------\n  # Helper: locate nearest cell containing a given kind index.\n  # ------------------------------------------------------------------\n  def find_nearest(pos, kind_idx, grid):\n      \"\"\"Return (target_cell, path_actions) for the closest entity of kind.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      best_path = None\n      best_loc = None\n      for loc in locations:\n          target = (int(loc[0]), int(loc[1]))\n          path = bfs_path(pos, target, grid)\n          if path is None:\n              continue\n          if best_path is None or len(path) < len(best_path):\n              best_path = path\n              best_loc = target\n      return best_loc, best_path\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives (respecting required counts).\n  # ------------------------------------------------------------------\n  for prim_idx, count in primitives_needed.items():\n      for _ in range(count):\n          target, path = find_nearest(cur_pos, prim_idx, grid)\n          if target is None or path is None:\n              # cannot reach required primitive \u2013 abort planning\n              return actions\n          actions.extend(path)          # move to primitive cell\n          actions.append(USE)           # pick it up\n          # update mutable grid state (remove one instance)\n          if grid[target[0], target[1], prim_idx] > 0:\n              grid[target[0], target[1], prim_idx] -= 1\n          cur_pos = target\n\n  # ------------------------------------------------------------------\n  # 2. Move to the workshop (if recipe specifies one) and craft.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      target, path = find_nearest(cur_pos, workshop_idx, grid)\n      if target is not None and path is not None:\n          actions.extend(path)\n          actions.append(USE)   # craft at the workshop\n\n  return actions", "env_interactions": 26, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T19:46:45.604404", "function_name": "make_arrow", "function_body": "  # Reset the environment to obtain a fresh state (ignore errors if already reset)\n  try:\n      env.reset()\n  except Exception:\n      pass\n\n  # Retrieve the current CraftState from the environment\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []\n\n  world = env.world\n  idx = world.cookbook.index\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow) and its recipe\n  # ------------------------------------------------------------------\n  try:\n      goal_idx = idx[\"arrow\"]\n  except Exception:\n      return []                     # Arrow not defined in the index\n\n  # Primitive (or sub\u2011component) counts required for one arrow\n  needed = world.cookbook.primitives_for(goal_idx)\n\n  # Locate the workshop required for crafting the arrow (stored under \"_at\" or \"_key\")\n  workshop_name = None\n  for k, v in world.cookbook.recipes.get(goal_idx, {}).items():\n      if k in (\"_at\", \"_key\"):\n          workshop_name = v\n          break\n  if workshop_name is None:\n      return []                     # No workshop info in recipe\n\n  try:\n      workshop_idx = idx[workshop_name]\n  except Exception:\n      return []                     # Workshop not indexed\n\n  # ------------------------------------------------------------------\n  # Local mutable copies for planning simulation\n  # ------------------------------------------------------------------\n  pos = tuple(state.pos)                     # (x, y) current position\n  grid = state.grid.copy()                   # (W, H, n_kinds) occupancy\n  inventory = state.inventory.copy()\n  occupied = np.any(grid > 0, axis=2)        # bool matrix of blocked cells\n  plan = []                                   # actions to be returned\n\n  # ------------------------------------------------------------------\n  # Constants and helper functions\n  # ------------------------------------------------------------------\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # DOWN, UP, LEFT, RIGHT\n  USE = 4\n\n  from collections import deque\n\n  def bfs_adjacent(start, target, blocked):\n      \"\"\"Return a list of actions moving from *start* to any empty cell\n      that is 4\u2011connected to *target*. Empty list if unreachable.\"\"\"\n      h, w = blocked.shape\n      tx, ty = target\n      goal_cells = []\n      for a, (dx, dy) in enumerate(DIRS):\n          gx, gy = tx + dx, ty + dy\n          if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:\n              goal_cells.append((gx, gy))\n      if not goal_cells:\n          return []                     # target completely surrounded\n\n      q = deque([(start, [])])\n      visited = {start}\n      while q:\n          (cx, cy), path = q.popleft()\n          if (cx, cy) in goal_cells:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []                         # unreachable\n\n  def move_and_use(target, kind_idx):\n      \"\"\"Move adjacent to *target* (containing *kind_idx*) and issue USE.\n      Updates simulated position, grid, occupied mask and inventory.\n      Returns False if movement is impossible.\"\"\"\n      nonlocal pos, plan, grid, occupied, inventory\n      path = bfs_adjacent(pos, target, occupied)\n      if not path and pos != target:\n          return False\n      # Simulate movement\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n      plan.extend(path)\n\n      # Issue USE\n      plan.append(USE)\n\n      tx, ty = target\n      if grid[tx, ty, kind_idx] > 0:\n          grid[tx, ty, kind_idx] = 0\n          occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)\n          inventory[kind_idx] += 1\n      return True\n\n  # ------------------------------------------------------------------\n  # Collect all required primitives / components\n  # ------------------------------------------------------------------\n  for kind_idx, cnt in needed.items():\n      for _ in range(cnt):\n          locations = np.argwhere(grid[:, :, kind_idx] > 0)\n          if locations.size == 0:\n              # Required item not present on the map \u2013 abort planning\n              return plan\n          # Choose the nearest instance (Manhattan distance)\n          dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n          target = tuple(locations[dists.argmin()])\n          if not move_and_use(target, kind_idx):\n              return plan\n\n  # ------------------------------------------------------------------\n  # Move to the workshop and craft the arrow\n  # ------------------------------------------------------------------\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      # Fallback to original scenario grid (workshops are static)\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          return plan\n  dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])\n  workshop_target = tuple(workshop_cells[dists.argmin()])\n  move_and_use(workshop_target, workshop_idx)\n\n  # ------------------------------------------------------------------\n  # Return the constructed action sequence\n  # ------------------------------------------------------------------\n  return plan", "env_interactions": 23, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T19:46:46.739336", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Reset environment and fetch current CraftState\n  # ----------------------------------------------------------------------\n  try:\n      env.reset()\n  except Exception:\n      pass\n\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []\n\n  world = env.world\n  idx = world.cookbook.index\n\n  # ----------------------------------------------------------------------\n  # Identify the goal (arrow) and its recipe\n  # ----------------------------------------------------------------------\n  try:\n      goal_idx = idx[\"arrow\"]\n  except Exception:\n      return []                     # no arrow defined\n\n  # Primitive (or sub\u2011component) counts required for one arrow\n  needed = world.cookbook.primitives_for(goal_idx)\n\n  # Locate the workshop required for crafting the arrow\n  workshop_idx = None\n  for k, v in world.cookbook.recipes.get(goal_idx, {}).items():\n      if k in (\"_at\", \"_key\"):\n          try:\n              workshop_idx = idx[v]\n          except Exception:\n              workshop_idx = None\n          break\n  if workshop_idx is None:\n      return []                     # recipe missing workshop info\n\n  # ----------------------------------------------------------------------\n  # Local mutable copies for simulation\n  # ----------------------------------------------------------------------\n  pos = tuple(state.pos)                     # (x, y)\n  grid = state.grid.copy()                   # (W, H, n_kinds)\n  inventory = state.inventory.copy()\n  occupied = np.any(grid > 0, axis=2)        # bool mask of blocked cells\n  plan = []                                   # list of actions to return\n\n  # ----------------------------------------------------------------------\n  # Constants and helper functions\n  # ----------------------------------------------------------------------\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # DOWN, UP, LEFT, RIGHT\n  USE = 4\n\n  from collections import deque\n\n  def bfs_adjacent(start, target, blocked):\n      \"\"\"Return a list of actions moving from *start* to any empty\n      cell that is 4\u2011connected to *target*. Empty list if unreachable.\"\"\"\n      h, w = blocked.shape\n      tx, ty = target\n      goal_cells = []\n      for a, (dx, dy) in enumerate(DIRS):\n          gx, gy = tx + dx, ty + dy\n          if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:\n              goal_cells.append((gx, gy))\n      if not goal_cells:\n          return []                     # target completely surrounded\n\n      q = deque([(start, [])])\n      visited = {start}\n      while q:\n          (cx, cy), path = q.popleft()\n          if (cx, cy) in goal_cells:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []                         # unreachable\n\n  def move_and_use(target, kind_idx):\n      \"\"\"Move adjacent to *target* (containing *kind_idx*) and issue USE.\n      Updates simulated position, grid, occupied mask and inventory.\n      Returns False if movement is impossible.\"\"\"\n      nonlocal pos, plan, grid, occupied, inventory\n      path = bfs_adjacent(pos, target, occupied)\n      if not path and pos != target:\n          return False\n      # Simulate movement\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n      plan.extend(path)\n\n      # Issue USE\n      plan.append(USE)\n\n      tx, ty = target\n      if grid[tx, ty, kind_idx] > 0:\n          grid[tx, ty, kind_idx] = 0\n          occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)\n          inventory[kind_idx] += 1\n      return True\n\n  # ----------------------------------------------------------------------\n  # Collect all required primitives / sub\u2011components\n  # ----------------------------------------------------------------------\n  for kind_idx, cnt in needed.items():\n      for _ in range(cnt):\n          locations = np.argwhere(grid[:, :, kind_idx] > 0)\n          if locations.size == 0:\n              # No more of this kind on the map \u2013 abort planning\n              return plan\n          # Choose the nearest instance (Manhattan distance)\n          dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n          target = tuple(locations[dists.argmin()])\n          if not move_and_use(target, kind_idx):\n              return plan\n\n  # ----------------------------------------------------------------------\n  # Move to the workshop and craft the arrow\n  # ----------------------------------------------------------------------\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      # Fallback to original grid (workshops are static)\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          return plan\n  dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])\n  workshop_target = tuple(workshop_cells[dists.argmin()])\n  move_and_use(workshop_target, workshop_idx)\n\n  # ----------------------------------------------------------------------\n  # Return the constructed action sequence\n  # ----------------------------------------------------------------------\n  return plan", "env_interactions": 23, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T19:47:10.449616", "function_name": "make_arrow", "function_body": "  # Action indices (consistent with CraftWorld)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def _manhattan_actions(src, dst):\n      \"\"\"Return a list of actions that move from src to dst using Manhattan moves.\"\"\"\n      actions = []\n      x, y = src\n      tx, ty = dst\n      dx = tx - x\n      dy = ty - y\n      if dx > 0:\n          actions += [DOWN] * dx\n      elif dx < 0:\n          actions += [UP] * (-dx)\n      if dy > 0:\n          actions += [RIGHT] * dy\n      elif dy < 0:\n          actions += [LEFT] * (-dy)\n      return actions\n\n  def _blocked_cells(grid):\n      \"\"\"Boolean mask of cells that are occupied (any kind > 0).\"\"\"\n      return np.any(grid > 0, axis=2)\n\n  def _nearest_entity(pos, kind_idx, grid):\n      \"\"\"Find the nearest cell containing the given kind.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n      best = np.argmin(dists)\n      return tuple(locations[best])\n\n  def _adjacent_empty(target, cur_pos, blocked):\n      \"\"\"Choose an empty cell adjacent (or equal) to target that is closest to cur_pos.\"\"\"\n      tx, ty = target\n      candidates = []\n      # include the target itself in case it is already empty\n      if not blocked[tx, ty]:\n          candidates.append((tx, ty))\n      # four orthogonal neighbours\n      for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n          nx, ny = tx + dx, ty + dy\n          if 0 <= nx < blocked.shape[0] and 0 <= ny < blocked.shape[1]:\n              if not blocked[nx, ny]:\n                  candidates.append((nx, ny))\n      if not candidates:\n          return None\n      # pick the candidate with smallest Manhattan distance to cur_pos\n      return min(candidates, key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow) and its recipe\n  # ------------------------------------------------------------------\n  world = env.world\n  arrow_idx = world.cookbook.index.index('arrow')\n  primitives_needed = world.cookbook.primitives_for(arrow_idx)  # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Collect required primitives\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = env._current_state.pos\n  grid = env._current_state.grid\n  blocked = _blocked_cells(grid)\n\n  for prim_idx, count in primitives_needed.items():\n      for _ in range(count):\n          target = _nearest_entity(cur_pos, prim_idx, grid)\n          if target is None:\n              # primitive not found; abort planning\n              return actions\n          # find a walkable cell adjacent to the primitive\n          walk_target = _adjacent_empty(target, cur_pos, blocked)\n          if walk_target is None:\n              # no accessible neighbour; abort\n              return actions\n          actions += _manhattan_actions(cur_pos, walk_target)\n          cur_pos = walk_target\n          actions.append(USE)  # pick up the primitive\n          # simulate removal of the primitive for subsequent planning\n          grid[target[0], target[1], prim_idx] = 0\n          blocked = _blocked_cells(grid)\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      target = _nearest_entity(cur_pos, workshop_idx, grid)\n      if target is not None:\n          walk_target = _adjacent_empty(target, cur_pos, blocked)\n          if walk_target is not None:\n              actions += _manhattan_actions(cur_pos, walk_target)\n              cur_pos = walk_target\n              actions.append(USE)  # craft at the workshop\n\n  return actions", "env_interactions": 23, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T19:47:11.574086", "function_name": "make_arrow", "function_body": "  # actions to make an arrow in the given CraftLab environment\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def _manhattan_path(src, dst):\n      \"\"\"Return a list of actions that move from src to dst using Manhattan moves.\"\"\"\n      actions = []\n      x, y = src\n      tx, ty = dst\n      dx = tx - x\n      dy = ty - y\n      if dx > 0:\n          actions += [DOWN] * dx\n      elif dx < 0:\n          actions += [UP] * (-dx)\n      if dy > 0:\n          actions += [RIGHT] * dy\n      elif dy < 0:\n          actions += [LEFT] * (-dy)\n      return actions\n\n  def _nearest_entity(pos, kind_idx):\n      \"\"\"Find the nearest cell (including the current one) that contains the given kind.\"\"\"\n      grid = env._current_state.grid\n      locs = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - pos[0]) + np.abs(locs[:, 1] - pos[1])\n      best = np.argmin(dists)\n      return tuple(locs[best])\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow) and its recipe\n  # ------------------------------------------------------------------\n  world = env.world\n  arrow_idx = world.cookbook.index.index('arrow')\n  # mapping from primitive kind index -> required count for ONE arrow\n  primitives_needed = world.cookbook.primitives_for(arrow_idx)\n\n  # ------------------------------------------------------------------\n  # Collect all required primitives\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = env._current_state.pos\n\n  for prim_idx, count in primitives_needed.items():\n      for _ in range(count):\n          target = _nearest_entity(cur_pos, prim_idx)\n          if target is None:\n              # primitive not present \u2013 abort early\n              return actions\n          actions += _manhattan_path(cur_pos, target)\n          cur_pos = target\n          actions.append(USE)   # pick up the primitive\n\n  # ------------------------------------------------------------------\n  # Move to the workshop (if any) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = _nearest_entity(cur_pos, workshop_idx)\n      if workshop_pos is not None:\n          actions += _manhattan_path(cur_pos, workshop_pos)\n          cur_pos = workshop_pos\n          actions.append(USE)   # craft at the workshop\n\n  return actions", "env_interactions": 22, "island_id": 0, "scores": {"3": 0.2}}
{"timestamp": "2025-10-27T19:47:33.435489", "function_name": "make_arrow", "function_body": "  # Action indices\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  world = env.world\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def _cell_blocked(pos, g):\n      \"\"\"Return True if the cell contains any entity (i.e. is not empty).\"\"\"\n      x, y = pos\n      return g[x, y, :].any()\n\n  def _bfs(start, goal, g):\n      \"\"\"Bread\u2011first search returning a list of positions from start to goal.\n      Cells occupied by any entity are treated as obstacles, except the goal\n      cell itself which is always considered walkable.\"\"\"\n      if start == goal:\n          return [start]\n      w, h = g.shape[:2]\n      q = collections.deque([start])\n      came_from = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          x, y = cur\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h:\n                  nxt = (nx, ny)\n                  if nxt in came_from:\n                      continue\n                  # allow stepping onto the goal even if occupied\n                  if _cell_blocked(nxt, g) and nxt != goal:\n                      continue\n                  came_from[nxt] = cur\n                  q.append(nxt)\n      else:\n          return None  # no path found\n\n      # reconstruct path\n      path = [goal]\n      while path[-1] != start:\n          path.append(came_from[path[-1]])\n      path.reverse()\n      return path\n\n  def _path_to_actions(path):\n      \"\"\"Convert a position path to a list of action indices.\"\"\"\n      if not path or len(path) < 2:\n          return []\n      acts = []\n      for (x0, y0), (x1, y1) in zip(path, path[1:]):\n          if x1 == x0 + 1:\n              acts.append(DOWN)\n          elif x1 == x0 - 1:\n              acts.append(UP)\n          elif y1 == y0 + 1:\n              acts.append(RIGHT)\n          elif y1 == y0 - 1:\n              acts.append(LEFT)\n          else:\n              raise ValueError(\"Non\u2011adjacent cells in path\")\n      return acts\n\n  def _move(src, dst, g):\n      \"\"\"Return actions moving from src to dst using BFS, falling back to Manhattan.\"\"\"\n      p = _bfs(src, dst, g)\n      if p is None:\n          # Manhattan fallback (ignores obstacles)\n          acts = []\n          sx, sy = src\n          tx, ty = dst\n          if tx > sx:\n              acts += [DOWN] * (tx - sx)\n          elif tx < sx:\n              acts += [UP] * (sx - tx)\n          if ty > sy:\n              acts += [RIGHT] * (ty - sy)\n          elif ty < sy:\n              acts += [LEFT] * (sy - ty)\n          return acts\n      return _path_to_actions(p)\n\n  def _nearest(pos, kind_idx, g, banned):\n      \"\"\"Find nearest cell containing `kind_idx` not in `banned` set.\"\"\"\n      cells = np.argwhere(g[:, :, kind_idx] > 0)\n      if cells.size == 0:\n          return None\n      if banned:\n          mask = np.array([tuple(c) not in banned for c in cells])\n          cells = cells[mask]\n          if cells.size == 0:\n              return None\n      dists = np.abs(cells[:, 0] - pos[0]) + np.abs(cells[:, 1] - pos[1])\n      nearest = cells[dists.argmin()]\n      return tuple(nearest.tolist())\n\n  # ------------------------------------------------------------------\n  # Planning\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = tuple(env._current_state.pos)\n  grid = env._current_state.grid.copy()          # mutable copy for planning\n\n  # 1) Determine primitive requirements for the goal item (arrow)\n  goal_idx = world.cookbook.index.index('arrow')\n  prim_req = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # Track which locations of each primitive have already been harvested\n  harvested = {k: set() for k in prim_req.keys()}\n\n  # 2) Collect each required primitive\n  for kind_idx, needed in prim_req.items():\n      for _ in range(needed):\n          target = _nearest(cur_pos, kind_idx, grid, harvested[kind_idx])\n          if target is None:\n              # Primitive not available \u2013 abort planning\n              return actions\n          actions += _move(cur_pos, target, grid)\n          cur_pos = target\n          actions.append(USE)                     # pick up primitive\n          grid[target[0], target[1], kind_idx] = 0\n          harvested[kind_idx].add(target)\n\n  # 3) Move to the workshop (if the recipe specifies one) and craft\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_target = _nearest(cur_pos, workshop_idx, grid, set())\n      if ws_target is not None:\n          actions += _move(cur_pos, ws_target, grid)\n          cur_pos = ws_target\n          actions.append(USE)   # craft at the workshop\n\n  return actions", "env_interactions": 24, "island_id": 5, "scores": {"3": 0.2}}
{"timestamp": "2025-10-27T19:47:34.571437", "function_name": "make_arrow", "function_body": "  # Action indices (as defined in the environment)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  world = env.world\n\n  # --------------------------------------------------------------\n  # Helper utilities\n  # --------------------------------------------------------------\n  def _bfs_path(start, goal, grid):\n      \"\"\"Return a list of positions from start to goal using BFS.\n      The goal cell is considered walkable even if occupied.\n      \"\"\"\n      if start == goal:\n          return [start]\n      w, h = grid.shape[:2]\n      from collections import deque\n      frontier = deque([start])\n      came_from = {start: None}\n      while frontier:\n          cur = frontier.popleft()\n          if cur == goal:\n              break\n          x, y = cur\n          for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):\n              if 0 <= nx < w and 0 <= ny < h:\n                  nxt = (nx, ny)\n                  if nxt in came_from:\n                      continue\n                  # treat the goal cell as walkable even if occupied\n                  if (grid[nx, ny, :].any() and nxt != goal):\n                      continue\n                  came_from[nxt] = cur\n                  frontier.append(nxt)\n      else:\n          return None  # no path found\n\n      # reconstruct path\n      path = [goal]\n      while path[-1] != start:\n          path.append(came_from[path[-1]])\n      path.reverse()\n      return path\n\n  def _actions_from_path(path):\n      \"\"\"Convert a list of adjacent positions to a list of actions.\"\"\"\n      if not path or len(path) < 2:\n          return []\n      acts = []\n      for (x0, y0), (x1, y1) in zip(path, path[1:]):\n          if x1 == x0 + 1:\n              acts.append(DOWN)\n          elif x1 == x0 - 1:\n              acts.append(UP)\n          elif y1 == y0 + 1:\n              acts.append(RIGHT)\n          elif y1 == y0 - 1:\n              acts.append(LEFT)\n          else:\n              raise ValueError(\"Non\u2011adjacent steps in path\")\n      return acts\n\n  def _move_actions(src, dst, grid):\n      \"\"\"Move from src to dst using BFS; fall back to Manhattan moves.\"\"\"\n      path = _bfs_path(src, dst, grid)\n      if path is None:\n          # Manhattan fallback (ignores obstacles)\n          acts = []\n          sx, sy = src\n          tx, ty = dst\n          if tx > sx:\n              acts += [DOWN] * (tx - sx)\n          elif tx < sx:\n              acts += [UP] * (sx - tx)\n          if ty > sy:\n              acts += [RIGHT] * (ty - sy)\n          elif ty < sy:\n              acts += [LEFT] * (sy - ty)\n          return acts\n      return _actions_from_path(path)\n\n  def _nearest_cell(pos, kind_idx, grid, excluded):\n      \"\"\"Find the nearest cell containing `kind_idx` not in `excluded`.\"\"\"\n      cells = np.argwhere(grid[:, :, kind_idx] > 0)\n      if cells.size == 0:\n          return None\n      if excluded:\n          mask = np.array([tuple(c) not in excluded for c in cells])\n          cells = cells[mask]\n          if cells.size == 0:\n              return None\n      dists = np.abs(cells[:, 0] - pos[0]) + np.abs(cells[:, 1] - pos[1])\n      nearest = cells[dists.argmin()]\n      return tuple(nearest.tolist())\n\n  # --------------------------------------------------------------\n  # 1) Determine goal and its primitive requirements\n  # --------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = world.cookbook.index.index(goal_name)\n  prim_req = world.cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n\n  # --------------------------------------------------------------\n  # 2) Collect all required primitives\n  # --------------------------------------------------------------\n  actions = []\n  cur_pos = tuple(env._current_state.pos)\n  grid = env._current_state.grid.copy()   # mutable copy for planning\n  harvested = {k: set() for k in prim_req.keys()}\n\n  for kind_idx, needed in prim_req.items():\n      for _ in range(needed):\n          target = _nearest_cell(cur_pos, kind_idx, grid, harvested[kind_idx])\n          if target is None:\n              # Primitive not reachable; abort planning\n              return actions\n          actions += _move_actions(cur_pos, target, grid)\n          cur_pos = target\n          actions.append(USE)                     # pick up primitive\n          grid[target[0], target[1], kind_idx] = 0\n          harvested[kind_idx].add(target)\n\n  # --------------------------------------------------------------\n  # 3) Go to the appropriate workshop (if any) and craft the goal\n  # --------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = _nearest_cell(cur_pos, workshop_idx, grid, set())\n      if workshop_pos is not None:\n          actions += _move_actions(cur_pos, workshop_pos, grid)\n          cur_pos = workshop_pos\n          actions.append(USE)   # craft at the workshop\n\n  return actions", "env_interactions": 24, "island_id": 5, "scores": {"3": 0.2}}
{"timestamp": "2025-10-27T19:48:03.139919", "function_name": "make_arrow", "function_body": "  # Action identifiers (order matches the environment's definition)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def _bfs_actions(src, dst):\n      \"\"\"Return a shortest sequence of movement actions from src to dst\n      while avoiding cells occupied by non\u2011grabbable entities.\n      Falls back to Manhattan moves if no path exists.\"\"\"\n      if src == dst:\n          return []\n\n      grid = env._current_state.grid\n      h, w = grid.shape[:2]\n\n      # Cells that are blocked for movement (any non\u2011grabbable entity present)\n      non_grab = list(env.world.non_grabbable_indices)\n      if non_grab:\n          blocked = np.any(grid[:, :, non_grab] > 0, axis=2)\n      else:\n          blocked = np.zeros((h, w), dtype=bool)\n\n      # Simple bounds check for destination\n      if not (0 <= dst[0] < h and 0 <= dst[1] < w):\n          return _manhattan_actions(src, dst)\n\n      from collections import deque\n      q = deque([src])\n      visited = np.full((h, w), False, dtype=bool)\n      visited[src] = True\n      parent = {}  # (x, y) -> (prev_coord, move)\n\n      moves = [(DOWN, (1, 0)), (UP, (-1, 0)),\n               (RIGHT, (0, 1)), (LEFT, (0, -1))]\n\n      while q:\n          cur = q.popleft()\n          if cur == dst:\n              break\n          for move, (dx, dy) in moves:\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < h and 0 <= ny < w and not visited[nx, ny] and not blocked[nx, ny]:\n                  visited[nx, ny] = True\n                  parent[(nx, ny)] = (cur, move)\n                  q.append((nx, ny))\n\n      if dst not in parent:\n          # No reachable path \u2013 fallback to Manhattan moves\n          return _manhattan_actions(src, dst)\n\n      # Reconstruct path\n      actions_rev = []\n      cur = dst\n      while cur != src:\n          prev, move = parent[cur]\n          actions_rev.append(move)\n          cur = prev\n      actions_rev.reverse()\n      return actions_rev\n\n  def _manhattan_actions(src, dst):\n      \"\"\"Simple Manhattan movement (ignores obstacles).\"\"\"\n      x, y = src\n      tx, ty = dst\n      acts = []\n      dx = tx - x\n      dy = ty - y\n      if dx > 0:\n          acts += [DOWN] * dx\n      elif dx < 0:\n          acts += [UP] * (-dx)\n      if dy > 0:\n          acts += [RIGHT] * dy\n      elif dy < 0:\n          acts += [LEFT] * (-dy)\n      return acts\n\n  def _move_actions(src, dst):\n      \"\"\"Choose BFS path if possible, otherwise Manhattan.\"\"\"\n      return _bfs_actions(src, dst)\n\n  def _nearest_kind(pos, kind_idx):\n      \"\"\"Find the nearest cell (Manhattan distance) that contains the given kind.\"\"\"\n      grid = env._current_state.grid\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n      nearest = int(dists.argmin())\n      return tuple(locations[nearest].tolist())\n\n  # ------------------------------------------------------------------\n  # Identify goal (arrow) and required primitives\n  # ------------------------------------------------------------------\n  world = env.world\n  cookbook = world.cookbook\n  arrow_idx = cookbook.index.index('arrow')\n  primitives_needed = cookbook.primitives_for(arrow_idx)   # dict {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Collect all required primitives\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = env._current_state.pos\n\n  for prim_idx, qty in primitives_needed.items():\n      for _ in range(qty):\n          target = _nearest_kind(cur_pos, prim_idx)\n          if target is None:\n              # Primitive not present \u2013 abort early with whatever actions we have\n              return actions\n          actions += _move_actions(cur_pos, target)\n          cur_pos = target\n          actions.append(USE)   # pick up the primitive\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if any) and craft the arrow\n  # ------------------------------------------------------------------\n  workshop_name = cookbook.recipes[arrow_idx].get('_at')\n  if workshop_name is not None:\n      workshop_idx = cookbook.index.index(workshop_name)\n      workshop_pos = _nearest_kind(cur_pos, workshop_idx)\n      if workshop_pos is not None:\n          actions += _move_actions(cur_pos, workshop_pos)\n          cur_pos = workshop_pos\n          actions.append(USE)   # craft at the workshop\n\n  return actions", "env_interactions": 22, "island_id": 2, "scores": {"3": 0.2}}
{"timestamp": "2025-10-27T19:48:04.273582", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def _manhattan_path(start, goal):\n      \"\"\"Straight\u2011line Manhattan moves (ignores obstacles).\"\"\"\n      x, y = start\n      tx, ty = goal\n      acts = []\n      dx = tx - x\n      dy = ty - y\n      if dx > 0:\n          acts += [DOWN] * dx\n      elif dx < 0:\n          acts += [UP] * (-dx)\n      if dy > 0:\n          acts += [RIGHT] * dy\n      elif dy < 0:\n          acts += [LEFT] * (-dy)\n      return acts\n\n  def _bfs_path(start, goal):\n      \"\"\"Shortest path avoiding non\u2011grabbable cells using BFS.\n      Falls back to Manhattan moves if no path is found.\"\"\"\n      grid = env._current_state.grid\n      h, w, _ = grid.shape\n      # cells occupied by any non\u2011grabbable kind are blocked\n      blocked = np.any(grid[:, :, list(env.world.non_grabbable_indices)] > 0,\n                       axis=2)\n\n      if not (0 <= goal[0] < h and 0 <= goal[1] < w):\n          return []   # out\u2011of\u2011bounds target\n\n      from collections import deque\n      q = deque([start])\n      visited = np.zeros((h, w), dtype=bool)\n      visited[start] = True\n      parent = {}\n\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          for move, (dx, dy) in ((DOWN, (1, 0)), (UP, (-1, 0)),\n                                 (RIGHT, (0, 1)), (LEFT, (0, -1))):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < h and 0 <= ny < w and not visited[nx, ny] and not blocked[nx, ny]:\n                  visited[nx, ny] = True\n                  parent[(nx, ny)] = (cur, move)\n                  q.append((nx, ny))\n\n      # If goal unreachable, fall back to Manhattan\n      if goal not in parent and start != goal:\n          return _manhattan_path(start, goal)\n\n      # Reconstruct action list\n      actions_rev = []\n      cur = goal\n      while cur != start:\n          prev, move = parent[cur]\n          actions_rev.append(move)\n          cur = prev\n      actions_rev.reverse()\n      return actions_rev\n\n  def _move_actions(src, dst):\n      \"\"\"Choose BFS path if possible, otherwise Manhattan.\"\"\"\n      return _bfs_path(src, dst)\n\n  def _nearest(pos, kind_idx):\n      \"\"\"Return coordinates of the nearest cell containing the given kind.\"\"\"\n      grid = env._current_state.grid\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n      nearest = int(dists.argmin())\n      return tuple(locations[nearest].tolist())\n\n  # ------------------------------------------------------------------\n  # Identify goal (arrow) and its recipe\n  # ------------------------------------------------------------------\n  world = env.world\n  cookbook = world.cookbook\n  target_name = 'arrow'\n  target_idx = cookbook.index.index(target_name)\n\n  # Primitive requirements for a single arrow\n  needed = cookbook.primitives_for(target_idx)   # {prim_idx: count}\n\n  actions = []\n  cur_pos = env._current_state.pos\n\n  # ------------------------------------------------------------------\n  # Collect required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, qty in needed.items():\n      for _ in range(qty):\n          loc = _nearest(cur_pos, prim_idx)\n          if loc is None:\n              # Required primitive not present \u2013 abort early\n              return actions\n          actions += _move_actions(cur_pos, loc)\n          cur_pos = loc\n          actions.append(USE)   # pick up / interact\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if any) and craft the arrow\n  # ------------------------------------------------------------------\n  workshop_name = cookbook.recipes[target_idx].get('_at')\n  if workshop_name is not None:\n      workshop_idx = cookbook.index.index(workshop_name)\n      wloc = _nearest(cur_pos, workshop_idx)\n      if wloc is not None:\n          actions += _move_actions(cur_pos, wloc)\n          cur_pos = wloc\n          actions.append(USE)   # craft at workshop\n\n  return actions", "env_interactions": 22, "island_id": 2, "scores": {"3": 0.2}}
{"timestamp": "2025-10-27T19:48:27.902910", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Reset the environment to obtain a fresh state.\n  env.reset()\n  state = env._current_state               # CraftState\n  world = env.scenario.world                # CraftWorld\n  cookbook = world.cookbook                 # Cookbook\n  index = cookbook.index                    # name \u2194 id mapping\n\n  # --------------------------------------------------------------\n  # Identify the goal item (arrow).\n  # --------------------------------------------------------------\n  goal_name = \"arrow\"\n  if goal_name not in index.contents:\n      return []  # Arrow not defined in this world.\n  goal_idx = index[goal_name]\n\n  # --------------------------------------------------------------\n  # Determine primitive counts needed for a single arrow.\n  # --------------------------------------------------------------\n  primitive_needs = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n  actions = []\n\n  # --------------------------------------------------------------\n  # Helper: BFS that treats any occupied cell as blocked,\n  # except the target cell itself (so we can step onto a primitive or workshop).\n  # --------------------------------------------------------------\n  def bfs(start, target):\n      \"\"\"Return a list of positions from start to target (inclusive)\n      using 4\u2011connected moves, or None if unreachable.\"\"\"\n      h, w = state.grid.shape[:2]\n      occupied = np.any(state.grid > 0, axis=2)          # True where blocked\n      occupied[target] = False                           # allow stepping onto target\n\n      q = collections.deque([start])\n      came_from = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          r, c = cur\n          for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nr, nc = r + dr, c + dc\n              if 0 <= nr < h and 0 <= nc < w and not occupied[nr, nc]:\n                  nxt = (nr, nc)\n                  if nxt not in came_from:\n                      came_from[nxt] = cur\n                      q.append(nxt)\n      else:\n          return None\n\n      # Reconstruct path.\n      path = []\n      cur = target\n      while cur is not None:\n          path.append(cur)\n          cur = came_from[cur]\n      path.reverse()\n      return path\n\n  # --------------------------------------------------------------\n  # Mapping from movement delta to action index.\n  # --------------------------------------------------------------\n  delta_to_action = {\n      (1, 0): DOWN,\n      (-1, 0): UP,\n      (0, 1): RIGHT,\n      (0, -1): LEFT,\n  }\n\n  # --------------------------------------------------------------\n  # 1. Collect required primitives.\n  # --------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          # Locate any remaining instance of this primitive.\n          candidates = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if candidates.size == 0:\n              # No more of this primitive \u2013 abort planning.\n              return actions\n          tgt_r, tgt_c = candidates[0]\n\n          path = bfs(state.pos, (tgt_r, tgt_c))\n          if path is None:\n              # Unreachable \u2013 abort planning.\n              return actions\n\n          # Translate path into actions.\n          for (r0, c0), (r1, c1) in zip(path, path[1:]):\n              act = delta_to_action[(r1 - r0, c1 - c0)]\n              actions.append(act)\n              state.pos = (r1, c1)\n\n          # Pick up the primitive.\n          actions.append(USE)\n          state.inventory[prim_idx] += 1\n          state.grid[tgt_r, tgt_c, prim_idx] = 0\n\n  # --------------------------------------------------------------\n  # 2. Move to the workshop and craft the arrow.\n  # --------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      return actions  # No workshop information \u2013 cannot craft.\n\n  workshop_idx = index[workshop_name]\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      return actions  # No workshop present.\n\n  w_r, w_c = workshop_cells[0]\n  path = bfs(state.pos, (w_r, w_c))\n  if path is None:\n      return actions\n\n  for (r0, c0), (r1, c1) in zip(path, path[1:]):\n      act = delta_to_action[(r1 - r0, c1 - c0)]\n      actions.append(act)\n      state.pos = (r1, c1)\n\n  # Use the workshop to craft the arrow.\n  actions.append(USE)\n\n  return actions", "env_interactions": 28, "island_id": 4, "scores": {"3": 2.0}}
{"timestamp": "2025-10-27T19:48:29.032418", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # reset environment and obtain references\n  env.reset()\n  state = env._current_state               # CraftState\n  world = env.scenario.world                # CraftWorld\n  cookbook = world.cookbook                 # Cookbook\n  index = cookbook.index                    # name \u2194 id mapping\n\n  # ----------------------------------------------------------------------\n  # Identify the goal (arrow) and its index\n  # ----------------------------------------------------------------------\n  goal_name = \"arrow\"\n  if goal_name not in index.contents:\n      return []  # arrow not defined in this world\n  goal_idx = index[goal_name]\n\n  # ----------------------------------------------------------------------\n  # Determine primitive requirements for a single arrow\n  # ----------------------------------------------------------------------\n  primitive_needs = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # Simple BFS path\u2011finder (4\u2011connected Manhattan moves)\n  # ----------------------------------------------------------------------\n  def bfs(start, target):\n      \"\"\"Return a list of positions from start to target (inclusive).\n      Returns None if target is unreachable.\"\"\"\n      h, w = state.grid.shape[:2]\n      occupied = np.any(state.grid > 0, axis=2)          # True where blocked\n      # allow stepping onto the target even if it is occupied\n      occupied[target] = False\n      q = collections.deque([start])\n      came_from = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          r, c = cur\n          for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nr, nc = r + dr, c + dc\n              if 0 <= nr < h and 0 <= nc < w:\n                  if not occupied[nr, nc] and (nr, nc) not in came_from:\n                      came_from[(nr, nc)] = cur\n                      q.append((nr, nc))\n      else:\n          return None  # target never reached\n\n      # reconstruct path\n      path = []\n      cur = target\n      while cur is not None:\n          path.append(cur)\n          cur = came_from[cur]\n      path.reverse()\n      return path\n\n  # ----------------------------------------------------------------------\n  # Map movement deltas to action indices\n  # ----------------------------------------------------------------------\n  delta_to_action = {\n      (1, 0): DOWN,\n      (-1, 0): UP,\n      (0, 1): RIGHT,\n      (0, -1): LEFT,\n  }\n\n  # ----------------------------------------------------------------------\n  # 1. Collect all required primitives\n  # ----------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          # Find any remaining instance of this primitive\n          cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if cells.size == 0:\n              # No more instances; abort planning\n              return actions\n\n          target_r, target_c = cells[0]\n\n          # Compute path to the primitive\n          path = bfs(state.pos, (target_r, target_c))\n          if path is None:\n              # Unreachable; abort planning\n              return actions\n\n          # Convert path steps to actions\n          for (r0, c0), (r1, c1) in zip(path, path[1:]):\n              act = delta_to_action[(r1 - r0, c1 - c0)]\n              actions.append(act)\n              state.pos = (r1, c1)\n\n          # Pick up the primitive\n          actions.append(USE)\n          state.inventory[prim_idx] += 1\n          state.grid[target_r, target_c, prim_idx] = 0\n\n  # ----------------------------------------------------------------------\n  # 2. Move to the workshop and craft the arrow\n  # ----------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      return actions  # No workshop information; cannot craft\n\n  workshop_idx = index[workshop_name]\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      return actions  # No workshop cell found\n\n  w_r, w_c = workshop_cells[0]\n\n  path = bfs(state.pos, (w_r, w_c))\n  if path is None:\n      return actions  # Workshop unreachable\n\n  for (r0, c0), (r1, c1) in zip(path, path[1:]):\n      act = delta_to_action[(r1 - r0, c1 - c0)]\n      actions.append(act)\n      state.pos = (r1, c1)\n\n  # Craft the arrow at the workshop\n  actions.append(USE)\n\n  return actions", "env_interactions": 28, "island_id": 4, "scores": {"3": 2.0}}
{"timestamp": "2025-10-27T19:48:47.987657", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  world = env.world\n  cookbook = world.cookbook\n\n  # index of the target item (arrow) and its primitive requirements\n  goal_idx = cookbook.index.index('arrow')\n  primitives_needed = cookbook.primitives_for(goal_idx)\n\n  actions = []\n  cur_pos = env._current_state.pos\n  # work on a local copy of the grid so we can \u201cremove\u201d collected items\n  grid = env._current_state.grid.copy()\n\n  def _move_actions(src, dst):\n      \"\"\"Manhattan moves from src to dst (ignores obstacles).\"\"\"\n      x, y = src\n      tx, ty = dst\n      acts = []\n      if tx > x:\n          acts += [DOWN] * (tx - x)\n      elif tx < x:\n          acts += [UP] * (x - tx)\n      if ty > y:\n          acts += [RIGHT] * (ty - y)\n      elif ty < y:\n          acts += [LEFT] * (y - ty)\n      return acts\n\n  def _nearest(pos, kind_idx):\n      \"\"\"Return coordinates of the nearest cell containing `kind_idx`.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n      nearest_idx = int(dists.argmin())\n      return tuple(locations[nearest_idx].tolist())\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, count in primitives_needed.items():\n      for _ in range(count):\n          target = _nearest(cur_pos, prim_idx)\n          if target is None:\n              # primitive not found \u2013 abort planning\n              return actions\n          actions += _move_actions(cur_pos, target)\n          cur_pos = target\n          actions.append(USE)          # pick up the primitive\n          grid[target[0], target[1], prim_idx] = 0  # mark as collected\n\n  # ------------------------------------------------------------------\n  # 2. Move to the workshop (if any) and craft the arrow\n  # ------------------------------------------------------------------\n  workshop_name = cookbook.recipes[goal_idx].get('_at')\n  if workshop_name is not None:\n      workshop_idx = cookbook.index.index(workshop_name)\n      workshop_pos = _nearest(cur_pos, workshop_idx)\n      if workshop_pos is not None:\n          actions += _move_actions(cur_pos, workshop_pos)\n          cur_pos = workshop_pos\n          actions.append(USE)          # craft at the workshop\n\n  return actions", "env_interactions": 22, "island_id": 2, "scores": {"3": 0.2}}
{"timestamp": "2025-10-27T19:48:49.102920", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # Action indices (as defined in CraftWorld)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def _move_actions(src, dst):\n      \"\"\"Return a list of movement actions (Manhattan) from src to dst.\"\"\"\n      actions = []\n      x, y = src\n      tx, ty = dst\n      # vertical moves\n      if tx > x:\n          actions += [DOWN] * (tx - x)\n      elif tx < x:\n          actions += [UP] * (x - tx)\n      # horizontal moves\n      if ty > y:\n          actions += [RIGHT] * (ty - y)\n      elif ty < y:\n          actions += [LEFT] * (y - ty)\n      return actions\n\n  def _nearest_kind(pos, kind_idx, grid):\n      \"\"\"Find the coordinates of the nearest cell containing kind_idx.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      # Manhattan distance\n      dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n      nearest = locations[dists.argmin()]\n      return (int(nearest[0]), int(nearest[1]))\n\n  # ------------------------------------------------------------------\n  # 1. Identify goal (arrow) and required primitives\n  # ------------------------------------------------------------------\n  world = env.world\n  cookbook = world.cookbook\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index.index(goal_name)\n\n  # Mapping primitive kind index -> required count for a single arrow\n  primitives_needed = cookbook.primitives_for(goal_idx)\n\n  # ------------------------------------------------------------------\n  # 2. Collect all required primitives\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = env._current_state.pos\n  # Work on a local copy of the grid so we can \"remove\" collected items\n  grid = env._current_state.grid.copy()\n\n  for prim_idx, qty in primitives_needed.items():\n      for _ in range(qty):\n          target = _nearest_kind(cur_pos, prim_idx, grid)\n          if target is None:\n              # Primitive not present; abort planning\n              return actions\n          actions += _move_actions(cur_pos, target)\n          cur_pos = target\n          actions.append(USE)          # pick up the primitive\n          # Remove the primitive from the local grid copy\n          grid[target[0], target[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 3. Move to the appropriate workshop (if required) and craft\n  # ------------------------------------------------------------------\n  workshop_name = cookbook.recipes.get(goal_idx, {}).get('_at')\n  if workshop_name is not None:\n      workshop_idx = cookbook.index.index(workshop_name)\n      workshop_pos = _nearest_kind(cur_pos, workshop_idx, grid)\n      if workshop_pos is not None:\n          actions += _move_actions(cur_pos, workshop_pos)\n          cur_pos = workshop_pos\n          actions.append(USE)          # craft the arrow at the workshop\n\n  return actions", "env_interactions": 22, "island_id": 2, "scores": {"3": 0.2}}
{"timestamp": "2025-10-27T19:49:06.889814", "function_name": "make_arrow", "function_body": "  # Reset the environment and get handles to the current state and world objects\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  idx = world.cookbook.index           # name \u2192 integer id\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow) and its recipe requirements\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = idx[goal_name]\n\n  # Primitive resources needed for ONE arrow (may be empty if arrow is primitive)\n  prim_needed = world.cookbook.primitives_for(goal_idx)   # dict {prim_idx: count}\n\n  # Workshop where the arrow must be crafted (if any)\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else idx[wk]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  import numpy as np, collections\n\n  def locate(kind):\n      \"\"\"Return list of (x, y) positions where `kind` occurs on the grid.\"\"\"\n      occ = np.where(state.grid[:, :, kind] > 0)\n      return list(zip(occ[0].tolist(), occ[1].tolist()))\n\n  def blocked_cells():\n      \"\"\"Set of coordinates occupied by non\u2011grabbable entities.\"\"\"\n      blk = set()\n      for ng in world.non_grabbable_indices:\n          occ = np.where(state.grid[:, :, ng] > 0)\n          blk.update(zip(occ[0].tolist(), occ[1].tolist()))\n      return blk\n\n  def bfs(start, goal):\n      \"\"\"Return shortest 4\u2011connected path from start to goal avoiding blocked cells.\"\"\"\n      if start == goal:\n          return [start]\n      W, H = state.grid.shape[:2]\n      blocked = blocked_cells()\n      q = collections.deque([start])\n      prev = {start: None}\n      while q:\n          cur = q.popleft()\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:\n                  nxt = (nx, ny)\n                  if nxt not in prev:\n                      prev[nxt] = cur\n                      if nxt == goal:\n                          # reconstruct path\n                          path = [goal]\n                          while path[-1] != start:\n                              path.append(prev[path[-1]])\n                          path.reverse()\n                          return path\n                      q.append(nxt)\n      # No reachable path \u2013 stay put\n      return [start]\n\n  def move_action(cur, nxt):\n      \"\"\"Translate a step between adjacent cells into a DMLab action index.\"\"\"\n      dx, dy = nxt[0] - cur[0], nxt[1] - cur[1]\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise AssertionError(\"Requested move is not adjacent\")\n\n  # ------------------------------------------------------------------\n  # Build the action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = state.pos\n\n  # ------------------------------------------------------------------\n  # 1) Gather all required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, needed in prim_needed.items():\n      while state.inventory[prim_idx] < needed:\n          # Find remaining instances of this primitive on the map\n          candidates = locate(prim_idx)\n          if not candidates:\n              # No more of this primitive \u2013 cannot satisfy recipe, exit loop\n              break\n          # Choose the closest instance (Manhattan distance)\n          target = min(candidates,\n                       key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))\n          # Move to the target using shortest path\n          path = bfs(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n          # Pick up the primitive\n          actions.append(4)               # USE\n          state.inventory[prim_idx] += 1\n          state.grid[target[0], target[1], prim_idx] = 0   # remove from world\n\n  # ------------------------------------------------------------------\n  # 2) Go to the required workshop (if any) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      wk_locs = locate(workshop_kind)\n      if wk_locs:\n          target = min(wk_locs,\n                       key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))\n          path = bfs(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n  # Craft (USE at current location)\n  actions.append(4)   # USE\n\n  return actions", "env_interactions": 19, "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T19:49:08.015347", "function_name": "make_arrow", "function_body": "  import numpy as np, collections\n\n  # Reset and fetch core objects\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  idx = world.cookbook.index           # name \u2192 int id\n\n  # --------------------------------------------------------------\n  # Identify the goal (arrow) and its recipe requirements\n  # --------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = idx[goal_name]\n\n  # Primitive resources needed for ONE arrow\n  prim_needs = world.cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n\n  # Workshop where the arrow must be crafted (if any)\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else idx[wk]\n\n  # --------------------------------------------------------------\n  # Helper utilities\n  # --------------------------------------------------------------\n  def locate(kind):\n      \"\"\"Return list of (x, y) positions where `kind` occurs on the grid.\"\"\"\n      occ = np.where(state.grid[:, :, kind] > 0)\n      return list(zip(occ[0].tolist(), occ[1].tolist()))\n\n  def blocked_cells():\n      \"\"\"Set of coordinates occupied by non\u2011grabbable entities.\"\"\"\n      blk = set()\n      for ng in world.non_grabbable_indices:\n          occ = np.where(state.grid[:, :, ng] > 0)\n          blk.update(zip(occ[0].tolist(), occ[1].tolist()))\n      return blk\n\n  def bfs(start, goal):\n      \"\"\"Shortest 4\u2011connected path from start to goal avoiding blocked cells.\"\"\"\n      if start == goal:\n          return [start]\n      W, H = state.grid.shape[:2]\n      blocked = blocked_cells()\n      q = collections.deque([start])\n      prev = {start: None}\n      while q:\n          cur = q.popleft()\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:\n                  nxt = (nx, ny)\n                  if nxt not in prev:\n                      prev[nxt] = cur\n                      if nxt == goal:\n                          # reconstruct path\n                          path = [goal]\n                          while path[-1] != start:\n                              path.append(prev[path[-1]])\n                          path.reverse()\n                          return path\n                      q.append(nxt)\n      # No reachable path \u2013 stay put\n      return [start]\n\n  def move_action(cur, nxt):\n      \"\"\"Convert a step between adjacent cells into a DMLab action index.\"\"\"\n      dx, dy = nxt[0] - cur[0], nxt[1] - cur[1]\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise AssertionError(\"Requested move is not adjacent\")\n\n  # --------------------------------------------------------------\n  # Build the action sequence\n  # --------------------------------------------------------------\n  actions = []\n  cur_pos = state.pos\n\n  # 1) Collect all required primitives\n  for prim_idx, needed in prim_needs.items():\n      while state.inventory[prim_idx] < needed:\n          candidates = locate(prim_idx)\n          if not candidates:\n              # No more instances of this primitive; abort collection\n              break\n\n          # Choose the nearest instance (Manhattan distance)\n          target = min(candidates,\n                       key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))\n\n          # Move to the target using the shortest path\n          path = bfs(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n\n          # Pick up the primitive (USE action)\n          actions.append(4)   # USE\n          state.inventory[prim_idx] += 1\n          state.grid[target[0], target[1], prim_idx] = 0  # remove from world\n\n  # 2) Go to the workshop (if required) and craft the arrow\n  if workshop_kind is not None:\n      wk_locations = locate(workshop_kind)\n      if wk_locations:\n          target = min(wk_locations,\n                       key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))\n          path = bfs(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n\n  # Final craft action (USE at current location)\n  actions.append(4)   # USE\n\n  return actions", "env_interactions": 19, "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T19:49:41.119116", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  # target item\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n  if goal_idx is None:\n      return []\n\n  # primitives needed (recursive)\n  primitive_needs = cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  if \"_at\" in recipe:\n      workshop_idx = cookbook.index[recipe[\"_at\"]]\n\n  from collections import deque\n  import numpy as np\n\n  def bfs_path(start, goal, occupied):\n      \"\"\"Return a list of positions from start (excluded) to goal (included).\"\"\"\n      w, h = occupied.shape\n      visited = np.zeros((w, h), dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start] = True\n      while q:\n          x, y = q.popleft()\n          if (x, y) == goal:\n              break\n          for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):\n              if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:\n                  if (nx, ny) == goal or not occupied[nx, ny]:\n                      visited[nx, ny] = True\n                      prev[(nx, ny)] = (x, y)\n                      q.append((nx, ny))\n      if not visited[goal]:\n          return None\n      # reconstruct path\n      path = []\n      cur = goal\n      while cur != start:\n          path.append(cur)\n          cur = prev[cur]\n      path.reverse()\n      return path\n\n  def delta_to_action(dx, dy):\n      \"\"\"Convert a movement delta into the environment's action index.\"\"\"\n      if dx == 1:\n          return 3  # RIGHT\n      if dx == -1:\n          return 2  # LEFT\n      if dy == 1:\n          return 0  # DOWN\n      if dy == -1:\n          return 1  # UP\n      raise ValueError(\"Invalid movement delta\")\n\n  actions = []\n  cur_pos = tuple(state.pos)\n  # mutable copy to track collected primitives\n  grid = state.grid.copy()\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitive resources\n  # ------------------------------------------------------------------\n  for kind_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          locations = np.argwhere(grid[:, :, kind_idx] > 0)\n          if locations.size == 0:\n              break\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n\n          occupied_mask = np.any(grid, axis=2)  # any entity blocks movement\n          target = None\n          path = None\n          for idx in order:\n              cand = tuple(locations[idx])\n              p = bfs_path(cur_pos, cand, occupied_mask)\n              if p is not None:\n                  target = cand\n                  path = p\n                  break\n          if target is None:\n              continue  # cannot reach this primitive\n\n          for step in path:\n              dx = step[0] - cur_pos[0]\n              dy = step[1] - cur_pos[1]\n              actions.append(delta_to_action(dx, dy))\n              cur_pos = step\n          actions.append(4)  # USE to pick up\n          grid[target[0], target[1], kind_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 2) Move to workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          dists = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n          occupied_mask = np.any(state.grid, axis=2)  # original grid (workshops occupied)\n          for idx in order:\n              wpos = tuple(workshop_cells[idx])\n              p = bfs_path(cur_pos, wpos, occupied_mask)\n              if p is not None:\n                  for step in p:\n                      dx = step[0] - cur_pos[0]\n                      dy = step[1] - cur_pos[1]\n                      actions.append(delta_to_action(dx, dy))\n                      cur_pos = step\n                  actions.append(4)  # USE to craft\n                  break\n  else:\n      # No specific workshop needed; craft at current location\n      actions.append(4)\n\n  return actions", "env_interactions": 26, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T19:49:42.254849", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n  if goal_idx is None:\n      return []\n\n  # Primitive resources required (recursively)\n  primitive_needs = cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  if \"_at\" in recipe:\n      workshop_idx = cookbook.index[recipe[\"_at\"]]\n\n  from collections import deque\n  import numpy as np\n\n  def bfs_path(start, goal, occupied):\n      \"\"\"Return list of positions from start (excluded) to goal (included).\"\"\"\n      w, h = occupied.shape\n      visited = np.zeros((w, h), dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start] = True\n      while q:\n          x, y = q.popleft()\n          if (x, y) == goal:\n              break\n          for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):\n              if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:\n                  # allow stepping onto goal even if occupied\n                  if (nx, ny) == goal or not occupied[nx, ny]:\n                      visited[nx, ny] = True\n                      prev[(nx, ny)] = (x, y)\n                      q.append((nx, ny))\n      if not visited[goal]:\n          return None\n      path = []\n      cur = goal\n      while cur != start:\n          path.append(cur)\n          cur = prev[cur]\n      path.reverse()\n      return path\n\n  def delta_to_action(dx, dy):\n      \"\"\"Map movement delta to action index (DOWN,UP,LEFT,RIGHT).\"\"\"\n      if dx == 1:\n          return 3  # RIGHT\n      if dx == -1:\n          return 2  # LEFT\n      if dy == 1:\n          return 0  # DOWN\n      if dy == -1:\n          return 1  # UP\n      raise ValueError(\"Invalid movement delta\")\n\n  actions = []\n  cur_pos = tuple(state.pos)\n  # mutable copy of grid to reflect collected primitives\n  grid = state.grid.copy()\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitive resources\n  # ------------------------------------------------------------------\n  for kind_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          locations = np.argwhere(grid[:, :, kind_idx] > 0)\n          if locations.size == 0:\n              break\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n\n          occupied_mask = np.any(grid, axis=2)\n          target = None\n          path = None\n          for idx in order:\n              cand = tuple(locations[idx])\n              p = bfs_path(cur_pos, cand, occupied_mask)\n              if p is not None:\n                  target = cand\n                  path = p\n                  break\n          if target is None:\n              continue\n\n          for step in path:\n              dx = step[0] - cur_pos[0]\n              dy = step[1] - cur_pos[1]\n              actions.append(delta_to_action(dx, dy))\n              cur_pos = step\n\n          actions.append(4)  # USE to pick up\n          grid[target[0], target[1], kind_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 2) Move to workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          dists = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n\n          occupied_mask = np.any(state.grid, axis=2)\n          for idx in order:\n              wpos = tuple(workshop_cells[idx])\n              p = bfs_path(cur_pos, wpos, occupied_mask)\n              if p is not None:\n                  for step in p:\n                      dx = step[0] - cur_pos[0]\n                      dy = step[1] - cur_pos[1]\n                      actions.append(delta_to_action(dx, dy))\n                      cur_pos = step\n                  actions.append(4)  # USE to craft\n                  break\n  else:\n      actions.append(4)  # USE to craft at current location\n\n  return actions", "env_interactions": 26, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T19:49:56.854788", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # Action indices as defined in CraftWorld\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def _move_actions(src, dst):\n      \"\"\"Return a list of actions that move Manhattan\u2011style from src to dst.\"\"\"\n      actions = []\n      x, y = src\n      tx, ty = dst\n      # vertical moves\n      if tx > x:\n          actions += [DOWN] * (tx - x)\n      elif tx < x:\n          actions += [UP] * (x - tx)\n      # horizontal moves\n      if ty > y:\n          actions += [RIGHT] * (ty - y)\n      elif ty < y:\n          actions += [LEFT] * (y - ty)\n      return actions\n\n  def _nearest_kind(pos, kind_idx, grid):\n      \"\"\"Find the coordinates of the nearest cell containing `kind_idx`.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n      nearest = locations[dists.argmin()]\n      return int(nearest[0]), int(nearest[1])\n\n  # ------------------------------------------------------------------\n  # 1. Identify goal (arrow) and required primitives\n  # ------------------------------------------------------------------\n  world = env.world\n  cookbook = world.cookbook\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index.index(goal_name)\n\n  # Mapping from primitive kind index -> required count for a single arrow\n  primitives_needed = cookbook.primitives_for(goal_idx)\n\n  # ------------------------------------------------------------------\n  # 2. Collect all required primitives\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = env._current_state.pos\n  # Work on a local copy of the grid so we can \u201cremove\u201d collected items\n  grid = env._current_state.grid.copy()\n\n  for prim_idx, qty in primitives_needed.items():\n      for _ in range(qty):\n          target = _nearest_kind(cur_pos, prim_idx, grid)\n          if target is None:\n              # Primitive not present \u2013 abort planning\n              return actions\n          actions += _move_actions(cur_pos, target)\n          cur_pos = target\n          actions.append(USE)               # pick up the primitive\n          # Remove the primitive from the local grid copy\n          grid[target[0], target[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 3. Move to the appropriate workshop (if required) and craft\n  # ------------------------------------------------------------------\n  workshop_name = cookbook.recipes.get(goal_idx, {}).get('_at')\n  if workshop_name is not None:\n      workshop_idx = cookbook.index.index(workshop_name)\n      workshop_pos = _nearest_kind(cur_pos, workshop_idx, grid)\n      if workshop_pos is not None:\n          actions += _move_actions(cur_pos, workshop_pos)\n          cur_pos = workshop_pos\n          actions.append(USE)               # craft the arrow at the workshop\n\n  return actions", "env_interactions": 22, "island_id": 2, "scores": {"3": 0.2}}
{"timestamp": "2025-10-27T19:49:57.975938", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # Action constants as defined in CraftWorld\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def _move_actions(src, dst):\n      \"\"\"Manhattan movement actions from src (x,y) to dst (x,y).\"\"\"\n      actions = []\n      sx, sy = src\n      dx, dy = dst\n      if dx > sx:\n          actions += [DOWN] * (dx - sx)\n      elif dx < sx:\n          actions += [UP] * (sx - dx)\n      if dy > sy:\n          actions += [RIGHT] * (dy - sy)\n      elif dy < sy:\n          actions += [LEFT] * (sy - dy)\n      return actions\n\n  def _nearest_kind(pos, kind_idx, grid):\n      \"\"\"Return coordinates of the nearest cell containing `kind_idx`.\"\"\"\n      locs = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - pos[0]) + np.abs(locs[:, 1] - pos[1])\n      nearest = locs[dists.argmin()]\n      return (int(nearest[0]), int(nearest[1]))\n\n  # ------------------------------------------------------------------\n  # Identify goal (arrow) and required primitives\n  # ------------------------------------------------------------------\n  world = env.world\n  cookbook = world.cookbook\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index.index(goal_name)\n\n  # Mapping primitive kind index -> required count for a single arrow\n  primitives_needed = cookbook.primitives_for(goal_idx)\n\n  # ------------------------------------------------------------------\n  # Collect required primitives\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = env._current_state.pos\n  # Work on a mutable copy of the grid to reflect collected items\n  grid = env._current_state.grid.copy()\n\n  for prim_idx, qty in primitives_needed.items():\n      for _ in range(qty):\n          target = _nearest_kind(cur_pos, prim_idx, grid)\n          if target is None:\n              # Primitive not present \u2013 abort planning\n              return actions\n          actions += _move_actions(cur_pos, target)\n          cur_pos = target\n          actions.append(USE)                     # pick up the primitive\n          grid[target[0], target[1], prim_idx] = 0  # remove it from local view\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  workshop_name = cookbook.recipes.get(goal_idx, {}).get('_at')\n  if workshop_name is not None:\n      workshop_idx = cookbook.index.index(workshop_name)\n      workshop_pos = _nearest_kind(cur_pos, workshop_idx, grid)\n      if workshop_pos is not None:\n          actions += _move_actions(cur_pos, workshop_pos)\n          cur_pos = workshop_pos\n          actions.append(USE)                     # craft at the workshop\n\n  return actions", "env_interactions": 22, "island_id": 2, "scores": {"3": 0.2}}
{"timestamp": "2025-10-27T19:50:26.571534", "function_name": "make_arrow", "function_body": "  # Reset the environment to obtain a fresh internal state.\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.scenario.world          # CraftWorld\n  cookbook = world.cookbook           # Cookbook\n  index = cookbook.index               # Name \u2194 integer ID mapping\n\n  # Resolve action indices from the environment specification.\n  action_map = env.action_specs()\n  DOWN = action_map.get(\"DOWN\", 0)\n  UP = action_map.get(\"UP\", 1)\n  LEFT = action_map.get(\"LEFT\", 2)\n  RIGHT = action_map.get(\"RIGHT\", 3)\n  USE = action_map.get(\"USE\", 4)\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow) and its primitive requirements.\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  if goal_name not in index.contents:\n      return []                     # Arrow not defined in this world.\n  goal_idx = index[goal_name]      # Integer id of the arrow item.\n\n  # Mapping primitive_kind_index -> count required for one arrow.\n  primitive_needs = cookbook.primitives_for(goal_idx)\n\n  actions = []                     # List of actions to be returned.\n\n  # ------------------------------------------------------------------\n  # Helper: BFS pathfinder that avoids occupied cells (except the target).\n  # ------------------------------------------------------------------\n  from collections import deque\n  h, w = state.grid.shape[:2]\n  move_defs = [\n      (DOWN, (1, 0)),\n      (UP, (-1, 0)),\n      (LEFT, (0, -1)),\n      (RIGHT, (0, 1)),\n  ]\n\n  def bfs_path(start, target):\n      \"\"\"Return a list of movement actions from start to target.\"\"\"\n      if start == target:\n          return []\n      queue = deque([start])\n      visited = {start}\n      parent = {}\n      while queue:\n          cur = queue.popleft()\n          if cur == target:\n              break\n          for act, (dr, dc) in move_defs:\n              nr, nc = cur[0] + dr, cur[1] + dc\n              if not (0 <= nr < h and 0 <= nc < w):\n                  continue\n              nxt = (nr, nc)\n              # Allow stepping onto the target even if occupied.\n              if nxt != target and state.grid[nr, nc, :].sum() != 0:\n                  continue\n              if nxt in visited:\n                  continue\n              visited.add(nxt)\n              parent[nxt] = (cur, act)\n              queue.append(nxt)\n      if target not in parent and start != target:\n          return []      # No path found.\n      # Reconstruct actions.\n      path_actions = []\n      cur = target\n      while cur != start:\n          prev, act = parent[cur]\n          path_actions.append(act)\n          cur = prev\n      path_actions.reverse()\n      return path_actions\n\n  # ------------------------------------------------------------------\n  # Phase 1: Collect all required primitives (respecting multiplicities).\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          # Locate cells that currently contain the needed primitive.\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # Primitive missing; abort early.\n              return actions\n          # Choose the nearest primitive cell (Manhattan distance).\n          dists = np.abs(prim_cells - np.array(state.pos)).sum(axis=1)\n          tr, tc = tuple(prim_cells[dists.argmin()])\n          # Move to that cell.\n          move_seq = bfs_path(state.pos, (tr, tc))\n          actions.extend(move_seq)\n          state.pos = (tr, tc)\n          # Pick it up.\n          actions.append(USE)\n          # Update our internal copy of the state.\n          state.inventory[prim_idx] += 1\n          state.grid[tr, tc, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Phase 2: Craft the arrow at its required workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n\n  if workshop_name is not None:\n      # Arrow must be crafted at a specific workshop.\n      workshop_idx = index[workshop_name]\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          return actions          # No workshop found; cannot craft.\n      wr, wc = tuple(workshop_cells[0])\n      move_seq = bfs_path(state.pos, (wr, wc))\n      actions.extend(move_seq)\n      state.pos = (wr, wc)\n      actions.append(USE)          # Craft at the workshop.\n  else:\n      # Arrow is a primitive item itself; just pick it up if present.\n      arrow_cells = np.argwhere(state.grid[:, :, goal_idx] > 0)\n      if arrow_cells.size == 0:\n          return actions          # Arrow not present anywhere.\n      tr, tc = tuple(arrow_cells[0])\n      move_seq = bfs_path(state.pos, (tr, tc))\n      actions.extend(move_seq)\n      state.pos = (tr, tc)\n      actions.append(USE)          # Pick up the arrow.\n\n  return actions", "env_interactions": 24, "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T19:50:27.698305", "function_name": "make_arrow", "function_body": "  # Reset environment and fetch core objects\n  env.reset()\n  state = env._current_state                     # CraftState\n  world = env.scenario.world                     # CraftWorld\n  cookbook = world.cookbook\n  idx = cookbook.index                           # name \u2194 integer id mapping\n\n  # Resolve action indices from the environment spec\n  action_map = env.action_specs()\n  DOWN = action_map.get(\"DOWN\", 0)\n  UP = action_map.get(\"UP\", 1)\n  LEFT = action_map.get(\"LEFT\", 2)\n  RIGHT = action_map.get(\"RIGHT\", 3)\n  USE = action_map.get(\"USE\", 4)\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow) and its primitive requirements.\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  if goal_name not in idx.contents:\n      return []                                   # Arrow not defined in this world\n  goal_idx = idx[goal_name]                      # Integer id of the arrow item\n  primitive_needs = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n  actions = []                                    # List of actions to return\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that finds a walkable path (ignores the target cell's\n  # occupancy so we can step onto items or workshops).\n  # ------------------------------------------------------------------\n  from collections import deque\n  import numpy as np\n\n  h, w = state.grid.shape[:2]\n  moves = [(DOWN, (1, 0)),\n           (UP, (-1, 0)),\n           (LEFT, (0, -1)),\n           (RIGHT, (0, 1))]\n\n  def bfs_path(start, target):\n      \"\"\"Return a list of movement actions from start to target.\"\"\"\n      if start == target:\n          return []\n      queue = deque([start])\n      visited = {start}\n      parent = {}\n      while queue:\n          cur = queue.popleft()\n          if cur == target:\n              break\n          for act, (dr, dc) in moves:\n              nr, nc = cur[0] + dr, cur[1] + dc\n              if not (0 <= nr < h and 0 <= nc < w):\n                  continue\n              nxt = (nr, nc)\n              # Allow stepping onto the target even if occupied.\n              if nxt != target and state.grid[nr, nc, :].sum() != 0:\n                  continue\n              if nxt in visited:\n                  continue\n              visited.add(nxt)\n              parent[nxt] = (cur, act)\n              queue.append(nxt)\n      if target not in parent and start != target:\n          return []          # No path found.\n      # Reconstruct path.\n      path = []\n      cur = target\n      while cur != start:\n          prev, act = parent[cur]\n          path.append(act)\n          cur = prev\n      path.reverse()\n      return path\n\n  # ------------------------------------------------------------------\n  # Phase 1: Collect each required primitive (respecting multiplicities).\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # Primitive missing; abort early.\n              return actions\n          # Choose the nearest primitive cell (Manhattan distance).\n          dists = np.abs(prim_cells - np.array(state.pos)).sum(axis=1)\n          tr, tc = tuple(prim_cells[dists.argmin()])\n          # Move to that cell.\n          actions.extend(bfs_path(state.pos, (tr, tc)))\n          state.pos = (tr, tc)\n          # Pick it up.\n          actions.append(USE)\n          # Update internal copy of the state.\n          state.inventory[prim_idx] += 1\n          state.grid[tr, tc, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Phase 2: Craft the arrow at its workshop (if any), otherwise pick it up.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      # Arrow must be crafted at a specific workshop.\n      workshop_idx = idx[workshop_name]\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          return actions          # No workshop found; cannot craft.\n      wr, wc = tuple(workshop_cells[0])\n      actions.extend(bfs_path(state.pos, (wr, wc)))\n      state.pos = (wr, wc)\n      actions.append(USE)          # Craft at the workshop.\n  else:\n      # Arrow is a primitive item; just pick it up.\n      arrow_cells = np.argwhere(state.grid[:, :, goal_idx] > 0)\n      if arrow_cells.size == 0:\n          return actions          # Arrow not present anywhere.\n      tr, tc = tuple(arrow_cells[0])\n      actions.extend(bfs_path(state.pos, (tr, tc)))\n      state.pos = (tr, tc)\n      actions.append(USE)          # Pick up the arrow.\n\n  return actions", "env_interactions": 24, "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T19:50:49.700163", "function_name": "make_arrow", "function_body": "", "env_interactions": 0, "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-10-27T19:50:50.824188", "function_name": "make_arrow", "function_body": "  # Action indices\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def _manhattan_actions(src, dst):\n      \"\"\"Return a list of actions that move from src to dst using Manhattan moves.\"\"\"\n      actions = []\n      x, y = src\n      tx, ty = dst\n      # vertical movement (row index)\n      while x < tx:\n          actions.append(DOWN)\n          x += 1\n      while x > tx:\n          actions.append(UP)\n          x -= 1\n      # horizontal movement (column index)\n      while y < ty:\n          actions.append(RIGHT)\n          y += 1\n      while y > ty:\n          actions.append(LEFT)\n          y -= 1\n      return actions\n\n  def _nearest_entity(pos, kind_idx):\n      \"\"\"Find the closest cell (Manhattan distance) that contains the given kind.\"\"\"\n      grid = env._current_state.grid\n      # locations where the entity is present (any positive count)\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      # compute Manhattan distances\n      dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n      best = int(np.argmin(dists))\n      return tuple(locations[best])\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow) and its recipe\n  # ------------------------------------------------------------------\n  world = env.world\n  arrow_idx = world.cookbook.index.index('arrow')\n  # map of primitive kind index -> required count for a single arrow\n  primitives_needed = world.cookbook.primitives_for(arrow_idx)\n\n  # ------------------------------------------------------------------\n  # Collect all required primitives\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = env._current_state.pos\n\n  for prim_idx, count in primitives_needed.items():\n      for _ in range(count):\n          target = _nearest_entity(cur_pos, prim_idx)\n          if target is None:\n              # Primitive not available \u2013 abort early\n              return actions\n          actions += _manhattan_actions(cur_pos, target)\n          cur_pos = target\n          actions.append(USE)   # pick up the primitive\n\n  # ------------------------------------------------------------------\n  # Move to the workshop (if any) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = _nearest_entity(cur_pos, workshop_idx)\n      if workshop_pos is not None:\n          actions += _manhattan_actions(cur_pos, workshop_pos)\n          cur_pos = workshop_pos\n          actions.append(USE)   # craft at the workshop\n\n  return actions", "env_interactions": 22, "island_id": 0, "scores": {"3": 0.2}}
{"timestamp": "2025-10-27T19:51:16.244773", "function_name": "make_arrow", "function_body": "  # Helper functions ----------------------------------------------------\n  def is_walkable(pos, grid):\n      \"\"\"Check if a cell is free (no entities).\"\"\"\n      x, y = pos\n      return not grid[x, y].any()\n\n  def bfs(start, goal, grid):\n      \"\"\"Return the shortest path (list of positions) from start to goal.\"\"\"\n      if start == goal:\n          return [start]\n      w, h = grid.shape[:2]\n      q = collections.deque([start])\n      prev = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break", "env_interactions": 0, "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-10-27T19:51:17.375243", "function_name": "make_arrow", "function_body": "  \"\"\"Improved version of `make_arrow_v1`.\"\"\"\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def _cell_blocked(pos, grid):\n      \"\"\"Return True if the cell at `pos` contains any non\u2011empty entity.\"\"\"\n      x, y = pos\n      return grid[x, y, :].any()\n\n  def _bfs_path(start, goal, grid):\n      \"\"\"Shortest path from start to goal using BFS (allow stepping onto goal).\"\"\"\n      if start == goal:\n          return [start]\n      w, h = grid.shape[:2]\n      frontier = collections.deque([start])\n      came_from = {start: None}\n      while frontier:\n          cur = frontier.popleft()\n          if cur == goal:\n              break\n          x, y = cur\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h:\n                  nxt = (nx, ny)\n                  if nxt not in came_from:\n                      # permit moving onto the goal even if occupied\n                      if not _cell_blocked(nxt, grid) or nxt == goal:\n                          came_from[nxt] = cur\n                          frontier.append(nxt)\n      else:\n          return None  # no path found\n\n      # reconstruct path\n      path = [goal]\n      while path[-1] != start:\n          path.append(came_from[path[-1]])\n      path.reverse()\n      return path\n\n  def _actions_from_path(path):\n      \"\"\"Translate a list of positions into a list of action indices.\"\"\"\n      acts = []\n      for (x0, y0), (x1, y1) in zip(path, path[1:]):\n          if x1 == x0 + 1:\n              acts.append(DOWN)\n          elif x1 == x0 - 1:\n              acts.append(UP)\n          elif y1 == y0 + 1:\n              acts.append(RIGHT)\n          elif y1 == y0 - 1:\n              acts.append(LEFT)\n          else:\n              raise ValueError(\"Non\u2011adjacent steps in path\")\n      return acts\n\n  def _move_actions(src, dst, grid):\n      \"\"\"Return actions moving from src to dst (BFS preferred, Manhattan fallback).\"\"\"\n      path = _bfs_path(src, dst, grid)\n      if path is None:\n          # Manhattan fallback (may collide with obstacles)\n          acts = []\n          x, y = src\n          tx, ty = dst\n          if tx > x:\n              acts += [DOWN] * (tx - x)\n          elif tx < x:\n              acts += [UP] * (x - tx)\n          if ty > y:\n              acts += [RIGHT] * (ty - y)\n          elif ty < y:\n              acts += [LEFT] * (y - ty)\n          return acts\n      return _actions_from_path(path)\n\n  def _nearest_entity(pos, kind_idx, grid, excluded):\n      \"\"\"Find the nearest cell containing `kind_idx` not in `excluded`.\"\"\"\n      candidates = np.argwhere(grid[:, :, kind_idx] > 0)\n      if candidates.size == 0:\n          return None\n      if excluded:\n          mask = np.array([tuple(c) not in excluded for c in candidates])\n          candidates = candidates[mask]\n          if candidates.size == 0:\n              return None\n      dists = np.abs(candidates[:, 0] - pos[0]) + np.abs(candidates[:, 1] - pos[1])\n      nearest = candidates[dists.argmin()]\n      return tuple(nearest.tolist())\n\n  # ------------------------------------------------------------------\n  # Retrieve recipe for 'arrow'\n  # ------------------------------------------------------------------\n  world = env.world\n  arrow_idx = world.cookbook.index.index('arrow')\n  primitives_needed = world.cookbook.primitives_for(arrow_idx)\n\n  # ------------------------------------------------------------------\n  # Planning: collect required primitives\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = env._current_state.pos\n  sim_grid = env._current_state.grid.copy()          # simulate pickups\n  taken_positions = {}                               # kind_idx -> set of used cells\n\n  for prim_idx, count in primitives_needed.items():\n      taken_positions.setdefault(prim_idx, set())\n      for _ in range(count):\n          target = _nearest_entity(cur_pos, prim_idx, sim_grid,\n                                  taken_positions[prim_idx])\n          if target is None:\n              # Required primitive not present; abort planning\n              return actions\n          actions += _move_actions(cur_pos, target, sim_grid)\n          cur_pos = target\n          actions.append(USE)                         # pick up primitive\n          # simulate removal of the primitive from the grid\n          sim_grid[cur_pos[0], cur_pos[1], prim_idx] = 0\n          taken_positions[prim_idx].add(cur_pos)\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  workshop_name = world.cookbook.recipes[arrow_idx].get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_pos = _nearest_entity(cur_pos, workshop_idx, sim_grid, set())\n      if ws_pos is not None:\n          actions += _move_actions(cur_pos, ws_pos, sim_grid)\n          cur_pos = ws_pos\n          actions.append(USE)                         # craft at workshop\n\n  return actions", "env_interactions": 24, "island_id": 5, "scores": {"3": 0.2}}
{"timestamp": "2025-10-27T19:51:32.508984", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def _manhattan_path(src, dst):\n      \"\"\"Return a list of actions that walk from src to dst using Manhattan moves.\"\"\"\n      actions = []\n      x, y = src\n      tx, ty = dst\n      # vertical movement (row index)\n      while x < tx:\n          actions.append(DOWN)\n          x += 1\n      while x > tx:\n          actions.append(UP)\n          x -= 1\n      # horizontal movement (col index)\n      while y < ty:\n          actions.append(RIGHT)\n          y += 1\n      while y > ty:\n          actions.append(LEFT)\n          y -= 1\n      return actions\n\n  def _nearest_entity(pos, kind_idx):\n      \"\"\"Find the closest cell (Manhattan distance) that currently contains kind_idx.\"\"\"\n      grid = env._current_state.grid\n      # locations where the count of this kind is >0\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n      best = int(np.argmin(dists))\n      return tuple(locations[best])\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow) and its recipe\n  # ------------------------------------------------------------------\n  world = env.world\n  arrow_idx = world.cookbook.index.index('arrow')\n  primitives_needed = world.cookbook.primitives_for(arrow_idx)  # dict {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Collect all required primitives\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = env._current_state.pos\n\n  for prim_idx, needed_cnt in primitives_needed.items():\n      for _ in range(needed_cnt):\n          target = _nearest_entity(cur_pos, prim_idx)\n          if target is None:\n              # Primitive not found \u2013 abort early\n              return actions\n          actions += _manhattan_path(cur_pos, target)\n          cur_pos = target\n          actions.append(USE)   # pick up the primitive\n\n  # ------------------------------------------------------------------\n  # Move to the appropriate workshop (if any) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = _nearest_entity(cur_pos, workshop_idx)\n      if workshop_pos is not None:\n          actions += _manhattan_path(cur_pos, workshop_pos)\n          cur_pos = workshop_pos\n          actions.append(USE)   # craft at the workshop\n\n  return actions", "env_interactions": 22, "island_id": 0, "scores": {"3": 0.2}}
{"timestamp": "2025-10-27T19:51:33.632006", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def _manhattan_actions(src, dst):\n      \"\"\"Return a list of actions that moves from src to dst using Manhattan steps.\"\"\"\n      actions = []\n      x, y = src\n      tx, ty = dst\n      while x < tx:\n          actions.append(DOWN)\n          x += 1\n      while x > tx:\n          actions.append(UP)\n          x -= 1\n      while y < ty:\n          actions.append(RIGHT)\n          y += 1\n      while y > ty:\n          actions.append(LEFT)\n          y -= 1\n      return actions\n\n  def _nearest_entity(pos, kind_idx):\n      \"\"\"Find the closest cell (Manhattan distance) that contains the given kind.\"\"\"\n      grid = env._current_state.grid\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n      best = int(np.argmin(dists))\n      return tuple(locations[best])\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow) and its recipe\n  # ------------------------------------------------------------------\n  world = env.world\n  arrow_idx = world.cookbook.index.index('arrow')\n  primitives_needed = world.cookbook.primitives_for(arrow_idx)  # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Collect all required primitives\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = env._current_state.pos\n\n  for prim_idx, needed_cnt in primitives_needed.items():\n      for _ in range(needed_cnt):\n          target = _nearest_entity(cur_pos, prim_idx)\n          if target is None:\n              # Primitive missing \u2013 abort early\n              return actions\n          actions += _manhattan_actions(cur_pos, target)\n          cur_pos = target\n          actions.append(USE)   # pick up the primitive\n\n  # ------------------------------------------------------------------\n  # Move to the appropriate workshop (if any) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = _nearest_entity(cur_pos, workshop_idx)\n      if workshop_pos is not None:\n          actions += _manhattan_actions(cur_pos, workshop_pos)\n          cur_pos = workshop_pos\n          actions.append(USE)   # craft at the workshop\n\n  return actions", "env_interactions": 22, "island_id": 0, "scores": {"3": 0.2}}
{"timestamp": "2025-10-27T19:52:03.675686", "function_name": "make_arrow", "function_body": "  # reset environment and get current state/world info\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world\n  idx = world.cookbook.index\n\n  # goal definition (arrow)\n  goal_name = \"arrow\"\n  goal_idx = idx[goal_name]\n\n  # primitive requirements for one arrow (flattened)\n  primitive_counts = world.cookbook.primitives_for(goal_idx)\n\n  # workshop required for final craft (if any)\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else idx[wk]\n\n  # ------------------------------------------------------------------\n  # helper utilities\n  # ------------------------------------------------------------------\n  def find_locations(kind):\n      \"\"\"Return list of (x, y) coordinates where `kind` is present on the grid.\"\"\"\n      occ = np.where(state.grid[:, :, kind] > 0)\n      return list(zip(occ[0].tolist(), occ[1].tolist()))\n\n  def bfs(start, goal):\n      \"\"\"Return shortest path (list of positions) from start to goal using 4\u2011way moves.\"\"\"\n      if start == goal:\n          return [start]\n      W, H = state.grid.shape[:2]\n\n      # cells occupied by non\u2011grabbable entities are blocked\n      blocked = set()\n      for ng in world.non_grabbable_indices:\n          occ = np.where(state.grid[:, :, ng] > 0)\n          blocked.update(zip(occ[0].tolist(), occ[1].tolist()))\n\n      q = collections.deque([start])\n      prev = {start: None}\n      while q:\n          cur = q.popleft()\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:\n                  nxt = (nx, ny)\n                  if nxt not in prev:\n                      prev[nxt] = cur\n                      if nxt == goal:\n                          # reconstruct path\n                          path = [goal]\n                          while path[-1] != start:\n                              path.append(prev[path[-1]])\n                          path.reverse()\n                          return path\n                      q.append(nxt)\n      # no path found \u2013 stay at start\n      return [start]\n\n  def move_action(cur, nxt):\n      \"\"\"Translate a step from cur to adjacent nxt into a CraftWorld action index.\"\"\"\n      dx = nxt[0] - cur[0]\n      dy = nxt[1] - cur[1]\n      if dx == 1:\n          return 3   # RIGHT\n      if dx == -1:\n          return 2   # LEFT\n      if dy == 1:\n          return 0   # DOWN\n      if dy == -1:\n          return 1   # UP\n      raise AssertionError(\"non\u2011adjacent move requested\")\n\n  # ------------------------------------------------------------------\n  # build the action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = state.pos\n\n  # 1) collect all required primitives\n  for prim_idx, needed in primitive_counts.items():\n      while state.inventory[prim_idx] < needed:\n          locations = find_locations(prim_idx)\n          if not locations:\n              # cannot find more of this primitive \u2013 abort collection for this type\n              break\n          # choose nearest instance (Manhattan distance)\n          target = min(\n              locations,\n              key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1])\n          )\n          path = bfs(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n          # pick up the primitive\n          actions.append(4)   # USE\n          state.inventory[prim_idx] += 1\n          state.grid[target[0], target[1], prim_idx] = 0  # remove from map\n\n  # 2) go to workshop (if required) and craft the arrow\n  if workshop_kind is not None:\n      wk_locs = find_locations(workshop_kind)\n      if wk_locs:\n          target = min(\n              wk_locs,\n              key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1])\n          )\n          path = bfs(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n      actions.append(4)   # USE to craft at workshop\n  else:\n      actions.append(4)   # USE to craft in place (no workshop needed)\n\n  return actions", "env_interactions": 19, "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T19:52:04.806123", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  goal_name = \"arrow\"\n  goal_idx = idx[goal_name]\n\n  primitive_counts = world.cookbook.primitives_for(goal_idx)\n\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else idx[wk]\n\n  def find_locations(kind):\n      occ = np.where(state.grid[:, :, kind] > 0)\n      return list(zip(occ[0].tolist(), occ[1].tolist()))\n\n  def bfs_path(start, goal):\n      if start == goal:\n          return [start]\n      W, H = state.grid.shape[:2]\n\n      blocked = set()\n      for ng in world.non_grabbable_indices:\n          occ = np.where(state.grid[:, :, ng] > 0)\n          blocked.update(zip(occ[0].tolist(), occ[1].tolist()))\n\n      q = collections.deque([start])\n      prev = {start: None}\n      while q:\n          cur = q.popleft()\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:\n                  nxt = (nx, ny)\n                  if nxt not in prev:\n                      prev[nxt] = cur\n                      if nxt == goal:\n                          path = [goal]\n                          while path[-1] != start:\n                              path.append(prev[path[-1]])\n                          path.reverse()\n                          return path\n                      q.append(nxt)\n      return [start]\n\n  def move_action(cur, nxt):\n      dx = nxt[0] - cur[0]\n      dy = nxt[1] - cur[1]\n      if dx == 1:\n          return 3   # RIGHT\n      if dx == -1:\n          return 2   # LEFT\n      if dy == 1:\n          return 0   # DOWN\n      if dy == -1:\n          return 1   # UP\n      raise AssertionError(\"Non\u2011adjacent move\")\n\n  actions = []\n  cur_pos = state.pos\n\n  for prim_idx, needed in primitive_counts.items():\n      while state.inventory[prim_idx] < needed:\n          locations = find_locations(prim_idx)\n          if not locations:\n              break\n          target = min(locations, key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))\n          path = bfs_path(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n          actions.append(4)   # USE to pick up\n          state.inventory[prim_idx] += 1\n          state.grid[target[0], target[1], prim_idx] = 0\n\n  if workshop_kind is not None:\n      wk_locs = find_locations(workshop_kind)\n      if wk_locs:\n          target = min(wk_locs, key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))\n          path = bfs_path(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n      actions.append(4)   # USE to craft\n  else:\n      actions.append(4)   # USE to craft\n\n  return actions", "env_interactions": 19, "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T19:52:30.765484", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  # ------------------------------------------------------------\n  # Goal and recipe information\n  # ------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = idx[goal_name]\n\n  # Primitive requirements (recursively expanded)\n  primitive_counts = world.cookbook.primitives_for(goal_idx)\n\n  # Workshop required for the final crafting step (if any)\n  workshop_kind = None\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else idx[wk]\n\n  # ------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------\n  def find_locations(kind):\n      \"\"\"Return list of (x, y) positions where `kind` is present on the grid.\"\"\"\n      occ = np.where(state.grid[:, :, kind] > 0)\n      return list(zip(occ[0].tolist(), occ[1].tolist()))\n\n  def bfs_path(start, goal):\n      \"\"\"Return a shortest Manhattan path from `start` to `goal` avoiding non\u2011grabbable cells.\"\"\"\n      if start == goal:\n          return [start]\n      W, H = state.grid.shape[:2]\n\n      # Cells occupied by non\u2011grabbable entities are treated as blocked.\n      blocked = set()\n      for ng in world.non_grabbable_indices:\n          occ = np.where(state.grid[:, :, ng] > 0)\n          blocked.update(zip(occ[0].tolist(), occ[1].tolist()))\n\n      queue = collections.deque([start])\n      prev = {start: None}\n      while queue:\n          cur = queue.popleft()\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:\n                  nxt = (nx, ny)\n                  if nxt not in prev:\n                      prev[nxt] = cur\n                      if nxt == goal:\n                          # reconstruct path\n                          path = [goal]\n                          while path[-1] != start:\n                              path.append(prev[path[-1]])\n                          path.reverse()\n                          return path\n                      queue.append(nxt)\n      # No path found \u2013 stay where we are\n      return [start]\n\n  def move_action(cur, nxt):\n      \"\"\"Translate a step from `cur` to adjacent `nxt` into an action index.\"\"\"\n      dx = nxt[0] - cur[0]\n      dy = nxt[1] - cur[1]\n      if dx == 1:\n          return 3   # RIGHT\n      if dx == -1:\n          return 2   # LEFT\n      if dy == 1:\n          return 0   # DOWN\n      if dy == -1:\n          return 1   # UP\n      raise AssertionError(\"Non\u2011adjacent movement requested\")\n\n  # ------------------------------------------------------------\n  # Build the action sequence\n  # ------------------------------------------------------------\n  actions = []\n  cur_pos = state.pos\n\n  # 1) Collect required primitives\n  for prim_idx, needed in primitive_counts.items():\n      while state.inventory[prim_idx] < needed:\n          locations = find_locations(prim_idx)\n          if not locations:\n              # Primitive not available on the map; abort collection for this item.\n              break\n\n          # Choose the nearest instance (Manhattan distance)\n          target = min(\n              locations,\n              key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1])\n          )\n\n          # Move to the primitive\n          path = bfs_path(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n\n          # Pick it up\n          actions.append(4)   # USE\n          state.inventory[prim_idx] += 1\n          state.grid[target[0], target[1], prim_idx] = 0\n\n  # 2) Move to the required workshop (if any)\n  if workshop_kind is not None:\n      wk_locations = find_locations(workshop_kind)\n      if wk_locations:\n          target = min(\n              wk_locations,\n              key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1])\n          )\n          path = bfs_path(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n\n  # 3) Craft the arrow\n  actions.append(4)   # USE\n\n  return actions", "env_interactions": 19, "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T19:52:31.924287", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow) and its recipe requirements\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = idx[goal_name]\n\n  # Primitive counts needed to craft one arrow (recursively expanded)\n  primitive_counts = world.cookbook.primitives_for(goal_idx)\n\n  # Workshop required for the final crafting step (if any)\n  workshop_kind = None\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else idx[wk]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def find_locations(kind):\n      \"\"\"Return list of (x, y) coordinates where `kind` currently exists.\"\"\"\n      occ = np.where(state.grid[:, :, kind] > 0)\n      return list(zip(occ[0].tolist(), occ[1].tolist()))\n\n  def bfs_path(start, goal):\n      \"\"\"Shortest Manhattan path avoiding non\u2011grabbable cells.\"\"\"\n      if start == goal:\n          return [start]\n      W, H = state.grid.shape[:2]\n\n      # Cells occupied by non\u2011grabbable entities are treated as blocked.\n      blocked = set()\n      for ng in world.non_grabbable_indices:\n          occ = np.where(state.grid[:, :, ng] > 0)\n          blocked.update(zip(occ[0].tolist(), occ[1].tolist()))\n\n      queue = collections.deque([start])\n      prev = {start: None}\n      while queue:\n          cur = queue.popleft()\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:\n                  nxt = (nx, ny)\n                  if nxt not in prev:\n                      prev[nxt] = cur\n                      if nxt == goal:\n                          # Reconstruct path\n                          path = [goal]\n                          while path[-1] != start:\n                              path.append(prev[path[-1]])\n                          path.reverse()\n                          return path\n                      queue.append(nxt)\n      # No path found \u2013 stay in place\n      return [start]\n\n  def move_action(cur, nxt):\n      \"\"\"Translate a step into an action index (DOWN=0, UP=1, LEFT=2, RIGHT=3).\"\"\"\n      dx = nxt[0] - cur[0]\n      dy = nxt[1] - cur[1]\n      if dx == 1:\n          return 3   # RIGHT\n      if dx == -1:\n          return 2   # LEFT\n      if dy == 1:\n          return 0   # DOWN\n      if dy == -1:\n          return 1   # UP\n      raise AssertionError(\"Requested move is not to an adjacent cell\")\n\n  # ------------------------------------------------------------------\n  # Build the action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = state.pos\n\n  # 1) Collect all required primitives\n  for prim_idx, needed in primitive_counts.items():\n      while state.inventory[prim_idx] < needed:\n          locations = find_locations(prim_idx)\n          if not locations:\n              # No more instances of this primitive on the map; abort collection.\n              break\n\n          # Choose the nearest instance (Manhattan distance)\n          target = min(\n              locations,\n              key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1])\n          )\n\n          # Move to the chosen primitive\n          path = bfs_path(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n\n          # Pick it up\n          actions.append(4)   # USE\n          # Update planning snapshot\n          state.inventory[prim_idx] += 1\n          state.grid[target[0], target[1], prim_idx] = 0\n\n  # 2) Move to the required workshop (if any) and craft\n  if workshop_kind is not None:\n      wk_locations = find_locations(workshop_kind)\n      if wk_locations:\n          target = min(\n              wk_locations,\n              key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1])\n          )\n          path = bfs_path(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n\n  # 3) Craft the arrow (USE at current location)\n  actions.append(4)   # USE\n\n  return actions", "env_interactions": 19, "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T19:52:45.235353", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # Action constants (as defined in CraftWorld)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def _move_actions(src, dst):\n      \"\"\"Return a list of actions to move Manhattan\u2011style from src to dst.\"\"\"\n      actions = []\n      sx, sy = src\n      dx, dy = dst\n      if dx > sx:\n          actions += [DOWN] * (dx - sx)\n      elif dx < sx:\n          actions += [UP] * (sx - dx)\n      if dy > sy:\n          actions += [RIGHT] * (dy - sy)\n      elif dy < sy:\n          actions += [LEFT] * (sy - dy)\n      return actions\n\n  def _nearest_kind(pos, kind_idx, grid):\n      \"\"\"Find the nearest cell (Manhattan distance) that contains `kind_idx`.\"\"\"\n      locs = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - pos[0]) + np.abs(locs[:, 1] - pos[1])\n      nearest = locs[dists.argmin()]\n      return (int(nearest[0]), int(nearest[1]))\n\n  # ------------------------------------------------------------------\n  # Identify goal (arrow) and required primitives\n  # ------------------------------------------------------------------\n  world = env.world\n  cookbook = world.cookbook\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index.index(goal_name)\n\n  # Primitive\u2011to\u2011count mapping needed for a single arrow\n  primitives_needed = cookbook.primitives_for(goal_idx)\n\n  # ------------------------------------------------------------------\n  # Plan actions\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = env._current_state.pos\n  # Work on a local copy of the grid so we can \u201cremove\u201d items once picked\n  grid = env._current_state.grid.copy()\n\n  # 1. Collect all required primitives\n  for prim_idx, qty in primitives_needed.items():\n      for _ in range(qty):\n          target = _nearest_kind(cur_pos, prim_idx, grid)\n          if target is None:\n              # Primitive missing \u2013 abort planning; return what we have so far\n              return actions\n          actions += _move_actions(cur_pos, target)\n          cur_pos = target\n          actions.append(USE)                     # pick up the primitive\n          grid[target[0], target[1], prim_idx] = 0  # mark as collected\n\n  # 2. Move to the workshop (if the recipe specifies one) and craft\n  workshop_name = cookbook.recipes.get(goal_idx, {}).get('_at')\n  if workshop_name is not None:\n      workshop_idx = cookbook.index.index(workshop_name)\n      workshop_pos = _nearest_kind(cur_pos, workshop_idx, grid)\n      if workshop_pos is not None:\n          actions += _move_actions(cur_pos, workshop_pos)\n          cur_pos = workshop_pos\n          actions.append(USE)                     # craft at the workshop\n\n  return actions", "env_interactions": 22, "island_id": 2, "scores": {"3": 0.2}}
{"timestamp": "2025-10-27T19:52:46.356294", "function_name": "make_arrow", "function_body": "  # constants for actions (as defined in CraftWorld)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def _move_actions(src, dst):\n      \"\"\"Return a list of actions that moves Manhattan\u2011style from src to dst.\"\"\"\n      sx, sy = src\n      dx, dy = dst\n      acts = []\n      if dx > sx:\n          acts += [DOWN] * (dx - sx)\n      elif dx < sx:\n          acts += [UP] * (sx - dx)\n      if dy > sy:\n          acts += [RIGHT] * (dy - sy)\n      elif dy < sy:\n          acts += [LEFT] * (sy - dy)\n      return acts\n\n  def _nearest_kind(pos, kind_idx, grid):\n      \"\"\"Find the closest cell (Manhattan distance) that contains `kind_idx`.\"\"\"\n      locs = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - pos[0]) + np.abs(locs[:, 1] - pos[1])\n      nearest = locs[dists.argmin()]\n      return (int(nearest[0]), int(nearest[1]))\n\n  # ------------------------------------------------------------------\n  # Identify goal (arrow) and its recipe\n  # ------------------------------------------------------------------\n  world = env.world\n  cookbook = world.cookbook\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index.index(goal_name)\n\n  # Primitive requirements for a single arrow (may be empty if arrow is primitive)\n  primitives_needed = cookbook.primitives_for(goal_idx)\n\n  # ------------------------------------------------------------------\n  # Planning: collect primitives, then craft at the required workshop\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = env._current_state.pos\n  # Work on a mutable copy of the grid to keep track of items we have taken\n  grid = env._current_state.grid.copy()\n\n  # 1. Collect all required primitives\n  for prim_idx, qty in primitives_needed.items():\n      for _ in range(qty):\n          target = _nearest_kind(cur_pos, prim_idx, grid)\n          if target is None:\n              # Primitive not present in the current scenario \u2013 abort planning.\n              return actions\n          actions += _move_actions(cur_pos, target)\n          cur_pos = target\n          actions.append(USE)                     # pick up the primitive\n          grid[target[0], target[1], prim_idx] = 0  # remove from local view\n\n  # 2. Move to the workshop (if the recipe specifies one) and craft\n  workshop_name = cookbook.recipes.get(goal_idx, {}).get('_at')\n  if workshop_name is not None:\n      workshop_idx = cookbook.index.index(workshop_name)\n      workshop_pos = _nearest_kind(cur_pos, workshop_idx, grid)\n      if workshop_pos is not None:\n          actions += _move_actions(cur_pos, workshop_pos)\n          cur_pos = workshop_pos\n          actions.append(USE)                     # craft at the workshop\n\n  return actions", "env_interactions": 22, "island_id": 2, "scores": {"3": 0.2}}
{"timestamp": "2025-10-27T19:53:05.851025", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ----------------------------------------------------------------------\n  # Action constants (match CraftLab.action_specs ordering)\n  # ----------------------------------------------------------------------\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # DOWN, UP, LEFT, RIGHT\n  USE = 4\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS to a free cell adjacent to *target*\n  # ----------------------------------------------------------------------\n  def bfs_adjacent(start, target, blocked):\n      h, w = blocked.shape\n      tx, ty = target\n      goals = []\n      for a, (dx, dy) in enumerate(DIRS):\n          gx, gy = tx + dx, ty + dy\n          if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:\n              goals.append((gx, gy))\n      if not goals:\n          return []                     # target completely surrounded\n      q = deque([(start, [])])\n      visited = {start}\n      while q:\n          (cx, cy), path = q.popleft()\n          if (cx, cy) in goals:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []                         # unreachable\n\n  # ----------------------------------------------------------------------\n  # Initialise / obtain current state\n  # ----------------------------------------------------------------------\n  try:\n      env.reset()\n  except Exception:\n      pass\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []\n\n  world = env.world\n  idx = world.cookbook.index\n\n  # ----------------------------------------------------------------------\n  # Identify goal (arrow) and its recipe\n  # ----------------------------------------------------------------------\n  try:\n      goal_idx = idx[\"arrow\"]\n  except Exception:\n      return []                         # arrow not defined\n\n  needed = world.cookbook.primitives_for(goal_idx)\n\n  workshop_idx = None\n  for k, v in world.cookbook.recipes.get(goal_idx, {}).items():\n      if k in (\"_at\", \"_key\"):\n          try:\n              workshop_idx = idx[v]\n          except Exception:\n              workshop_idx = None\n          break\n  if workshop_idx is None:\n      return []                         # cannot locate workshop\n\n  # ----------------------------------------------------------------------\n  # Local mutable copies for planning\n  # ----------------------------------------------------------------------\n  pos = tuple(state.pos)                # (x, y)\n  grid = state.grid.copy()              # (W, H, n_kinds)\n  inventory = state.inventory.copy()\n  occupied = np.any(grid > 0, axis=2)   # bool matrix: True where any entity exists\n\n  plan = []\n\n  # ----------------------------------------------------------------------\n  # Helper: move adjacent to *target*, issue USE, and update simulated state\n  # ----------------------------------------------------------------------\n  def move_and_use(target, kind_idx):\n      nonlocal pos, plan, grid, occupied, inventory\n      path = bfs_adjacent(pos, target, occupied)\n      if not path and pos != target:\n          return False                  # cannot reach adjacency\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n      plan.extend(path)\n\n      plan.append(USE)                  # interact with the target cell\n\n      tx, ty = target\n      if grid[tx, ty, kind_idx] > 0:    # pick up primitive / component\n          grid[tx, ty, kind_idx] = 0\n          occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)\n          inventory[kind_idx] += 1\n      return True\n\n  # ----------------------------------------------------------------------\n  # Collect all required primitives / components\n  # ----------------------------------------------------------------------\n  for kind_idx, cnt in needed.items():\n      for _ in range(cnt):\n          locs = np.argwhere(grid[:, :, kind_idx] > 0)\n          if locs.size == 0:\n              return plan                # nothing left to collect\n          dists = np.abs(locs[:, 0] - pos[0]) + np.abs(locs[:, 1] - pos[1])\n          target = tuple(locs[dists.argmin()])\n          if not move_and_use(target, kind_idx):\n              return plan\n\n  # ----------------------------------------------------------------------\n  # Move to workshop and craft the arrow\n  # ----------------------------------------------------------------------\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      # Workshops are static; fall back to original scenario grid.\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          return plan\n  dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])\n  workshop_target = tuple(workshop_cells[dists.argmin()])\n  move_and_use(workshop_target, workshop_idx)\n\n  # ----------------------------------------------------------------------\n  # Return the constructed action sequence\n  # ----------------------------------------------------------------------\n  return plan", "env_interactions": 23, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T19:53:06.982055", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ------------------------------------------------------------\n  # Action constants (match CraftLab.action_specs ordering)\n  # ------------------------------------------------------------\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # DOWN, UP, LEFT, RIGHT\n  USE = 4\n\n  # ------------------------------------------------------------\n  # Helper: BFS that returns a list of move actions taking the agent\n  # from *start* to any empty cell adjacent (4\u2011connected) to *target*.\n  # *blocked* is a bool matrix where True means the cell cannot be entered.\n  # ------------------------------------------------------------\n  def bfs_adjacent(start, target, blocked):\n      h, w = blocked.shape\n      tx, ty = target\n      goal_cells = []\n      for a, (dx, dy) in enumerate(DIRS):\n          gx, gy = tx + dx, ty + dy\n          if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:\n              goal_cells.append((gx, gy))\n      if not goal_cells:\n          return []                     # target completely surrounded\n\n      q = deque([(start, [])])\n      visited = {start}\n      while q:\n          (cx, cy), path = q.popleft()\n          if (cx, cy) in goal_cells:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []                         # unreachable\n\n  # ------------------------------------------------------------\n  # Initialise / obtain the current state from the environment.\n  # ------------------------------------------------------------\n  try:\n      env.reset()\n  except Exception:\n      pass\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []\n\n  world = env.world\n  idx = world.cookbook.index\n\n  # ------------------------------------------------------------\n  # Identify the goal (arrow) and the workshop required to craft it.\n  # ------------------------------------------------------------\n  try:\n      goal_idx = idx[\"arrow\"]\n  except Exception:\n      return []                         # arrow not defined\n\n  needed = world.cookbook.primitives_for(goal_idx)\n\n  workshop_idx = None\n  for k, v in world.cookbook.recipes.get(goal_idx, {}).items():\n      if k in (\"_at\", \"_key\"):\n          try:\n              workshop_idx = idx[v]\n          except Exception:\n              workshop_idx = None\n          break\n  if workshop_idx is None:\n      return []                         # cannot locate workshop\n\n  # ------------------------------------------------------------\n  # Local mutable copies for planning.\n  # ------------------------------------------------------------\n  pos = tuple(state.pos)                # (x, y)\n  grid = state.grid.copy()              # (W, H, n_kinds)\n  inventory = state.inventory.copy()\n  occupied = np.any(grid > 0, axis=2)   # bool matrix: True where any entity exists\n\n  plan = []\n\n  # ------------------------------------------------------------\n  # Helper: move adjacent to *target*, issue USE, and update simulated\n  # state (grid, occupied, inventory, pos). Returns False on failure.\n  # ------------------------------------------------------------\n  def move_and_use(target, kind_idx):\n      nonlocal pos, plan, grid, occupied, inventory\n      path = bfs_adjacent(pos, target, occupied)\n      if not path and pos != target:\n          return False                  # cannot reach adjacency\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n      plan.extend(path)\n\n      plan.append(USE)                  # interact with the target cell\n\n      tx, ty = target\n      if grid[tx, ty, kind_idx] > 0:    # pick up primitive / component\n          grid[tx, ty, kind_idx] = 0\n          occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)\n          inventory[kind_idx] += 1\n      return True\n\n  # ------------------------------------------------------------\n  # Collect all required primitives / components.\n  # ------------------------------------------------------------\n  for kind_idx, cnt in needed.items():\n      for _ in range(cnt):\n          locations = np.argwhere(grid[:, :, kind_idx] > 0)\n          if locations.size == 0:\n              return plan                # nothing left to collect\n          dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n          target = tuple(locations[dists.argmin()])\n          if not move_and_use(target, kind_idx):\n              return plan\n\n  # ------------------------------------------------------------\n  # Move to the workshop and craft the arrow.\n  # ------------------------------------------------------------\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      # Workshops are static; fall back to the original scenario grid.\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          return plan\n  dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])\n  workshop_target = tuple(workshop_cells[dists.argmin()])\n  move_and_use(workshop_target, workshop_idx)\n\n  # ------------------------------------------------------------\n  # Return the constructed action sequence.\n  # ------------------------------------------------------------\n  return plan", "env_interactions": 23, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T19:53:26.013257", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ------------------------------------------------------------------\n  # Reset environment and obtain the current CraftState\n  # ------------------------------------------------------------------\n  try:\n      env.reset()\n  except Exception:\n      pass\n\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []\n\n  world = env.world\n  idx = world.cookbook.index\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow) and its recipe\n  # ------------------------------------------------------------------\n  try:\n      goal_idx = idx[\"arrow\"]\n  except Exception:\n      return []                     # arrow not defined\n\n  # Primitive/component counts required for ONE arrow\n  needed = world.cookbook.primitives_for(goal_idx)\n\n  # Find the workshop required for crafting the arrow\n  workshop_name = None\n  for k, v in world.cookbook.recipes.get(goal_idx, {}).items():\n      if k in (\"_at\", \"_key\"):\n          workshop_name = v\n          break\n  if workshop_name is None:\n      return []                     # no workshop info\n\n  try:\n      workshop_idx = idx[workshop_name]\n  except Exception:\n      return []                     # workshop not indexed\n\n  # ------------------------------------------------------------------\n  # Local mutable copies for planning simulation\n  # ------------------------------------------------------------------\n  pos = tuple(state.pos)                     # (x, y)\n  grid = state.grid.copy()                   # (W, H, n_kinds)\n  inventory = state.inventory.copy()\n  occupied = np.any(grid > 0, axis=2)        # bool matrix of blocked cells\n  plan = []                                   # actions to be returned\n\n  # ------------------------------------------------------------------\n  # Constants and helper functions\n  # ------------------------------------------------------------------\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # DOWN, UP, LEFT, RIGHT\n  USE = 4\n\n  def bfs_adjacent(start, target, blocked):\n      \"\"\"Return a list of actions moving from *start* to any empty cell\n      that is 4\u2011connected to *target*. Empty list if unreachable.\"\"\"\n      h, w = blocked.shape\n      tx, ty = target\n      goal_cells = []\n      for a, (dx, dy) in enumerate(DIRS):\n          gx, gy = tx + dx, ty + dy\n          if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:\n              goal_cells.append((gx, gy))\n      if not goal_cells:\n          return []                     # target completely surrounded\n\n      q = deque([(start, [])])\n      visited = {start}\n      while q:\n          (cx, cy), path = q.popleft()\n          if (cx, cy) in goal_cells:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []                         # unreachable\n\n  def move_and_use(target, kind_idx):\n      \"\"\"Move adjacent to *target* (containing *kind_idx*) and issue USE.\n      Updates simulated position, grid, occupied mask and inventory.\n      Returns False if movement is impossible.\"\"\"\n      nonlocal pos, plan, grid, occupied, inventory\n      path = bfs_adjacent(pos, target, occupied)\n      if not path and pos != target:\n          return False\n      # Simulate movement\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n      plan.extend(path)\n\n      # Issue USE action\n      plan.append(USE)\n\n      tx, ty = target\n      if grid[tx, ty, kind_idx] > 0:\n          grid[tx, ty, kind_idx] = 0\n          occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)\n          inventory[kind_idx] += 1\n      return True\n\n  # ------------------------------------------------------------------\n  # Collect all required primitives / components\n  # ------------------------------------------------------------------\n  for kind_idx, cnt in needed.items():\n      for _ in range(cnt):\n          locations = np.argwhere(grid[:, :, kind_idx] > 0)\n          if locations.size == 0:\n              # Required item not present on the map \u2013 abort planning\n              return plan\n          # Choose the nearest instance (Manhattan distance)\n          dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n          target = tuple(locations[dists.argmin()])\n          if not move_and_use(target, kind_idx):\n              return plan\n\n  # ------------------------------------------------------------------\n  # Move to the workshop and craft the arrow\n  # ------------------------------------------------------------------\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      # Workshops are static; fall back to original scenario grid\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          return plan\n  dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])\n  workshop_target = tuple(workshop_cells[dists.argmin()])\n  move_and_use(workshop_target, workshop_idx)\n\n  # ------------------------------------------------------------------\n  # Return the assembled action sequence\n  # ------------------------------------------------------------------\n  return plan", "env_interactions": 23, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T19:53:27.147873", "function_name": "make_arrow", "function_body": "  # Reset environment to obtain a fresh state\n  try:\n      env.reset()\n  except Exception:\n      pass\n\n  # Current CraftState\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []\n\n  world = env.world\n  idx = world.cookbook.index\n\n  # --------------------------------------------------------------\n  # Identify goal (\"arrow\") and its recipe\n  # --------------------------------------------------------------\n  try:\n      goal_idx = idx[\"arrow\"]\n  except Exception:\n      return []                     # arrow not defined\n\n  # Primitive/component requirements for ONE arrow\n  needed = world.cookbook.primitives_for(goal_idx)\n\n  # Locate required workshop (stored under \"_at\" or \"_key\")\n  workshop_name = None\n  for k, v in world.cookbook.recipes.get(goal_idx, {}).items():\n      if k in (\"_at\", \"_key\"):\n          workshop_name = v\n          break\n  if workshop_name is None:\n      return []                     # no workshop info\n  try:\n      workshop_idx = idx[workshop_name]\n  except Exception:\n      return []                     # workshop not indexed\n\n  # --------------------------------------------------------------\n  # Planning helpers\n  # --------------------------------------------------------------\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # DOWN, UP, LEFT, RIGHT\n  USE = 4\n\n  from collections import deque\n\n  def bfs_adjacent(start, target, blocked):\n      \"\"\"Return action list moving from *start* to any empty cell adjacent\n      to *target*. Empty list if unreachable.\"\"\"\n      h, w = blocked.shape\n      tx, ty = target\n      # Cells adjacent to target that are free\n      goal_cells = []\n      for a, (dx, dy) in enumerate(DIRS):\n          gx, gy = tx + dx, ty + dy\n          if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:\n              goal_cells.append((gx, gy))\n      if not goal_cells:\n          return []                     # surrounded\n\n      q = deque([(start, [])])\n      visited = {start}\n      while q:\n          (cx, cy), path = q.popleft()\n          if (cx, cy) in goal_cells:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []                         # unreachable\n\n  def move_and_use(target, kind_idx):\n      \"\"\"Move adjacent to *target* (containing *kind_idx*) and USE.\n      Updates simulated position, grid, occupied mask and inventory.\n      Returns False if movement impossible.\"\"\"\n      nonlocal pos, plan, grid, occupied, inventory\n      path = bfs_adjacent(pos, target, occupied)\n      if not path and pos != target:\n          return False\n      # Simulate movement\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n      plan.extend(path)\n\n      # USE action\n      plan.append(USE)\n\n      tx, ty = target\n      if grid[tx, ty, kind_idx] > 0:\n          grid[tx, ty, kind_idx] = 0\n          occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)\n          inventory[kind_idx] += 1\n      return True\n\n  # --------------------------------------------------------------\n  # Simulated mutable copies\n  # --------------------------------------------------------------\n  pos = tuple(state.pos)                     # (x, y)\n  grid = state.grid.copy()                   # (W, H, n_kinds)\n  inventory = state.inventory.copy()\n  occupied = np.any(grid > 0, axis=2)        # blocked cells mask\n  plan = []                                   # final action list\n\n  # --------------------------------------------------------------\n  # Collect all required primitives / components\n  # --------------------------------------------------------------\n  for kind_idx, cnt in needed.items():\n      for _ in range(cnt):\n          locations = np.argwhere(grid[:, :, kind_idx] > 0)\n          if locations.size == 0:\n              # Missing required item \u2013 abort planning\n              return plan\n          # Choose nearest instance (Manhattan distance)\n          dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n          target = tuple(locations[dists.argmin()])\n          if not move_and_use(target, kind_idx):\n              return plan\n\n  # --------------------------------------------------------------\n  # Move to the workshop and craft the arrow\n  # --------------------------------------------------------------\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      # Workshops are static; fall back to original scenario grid\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          return plan\n  dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])\n  workshop_target = tuple(workshop_cells[dists.argmin()])\n  move_and_use(workshop_target, workshop_idx)\n\n  # --------------------------------------------------------------\n  # Return the assembled action sequence\n  # --------------------------------------------------------------\n  return plan", "env_interactions": 23, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T19:53:50.578948", "function_name": "make_arrow", "function_body": "  # Reset environment and retrieve core objects\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world\n  cookbook = world.cookbook\n\n  # --------------------------------------------------------------\n  # Identify the goal (arrow) and its recipe\n  # --------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n  if goal_idx is None:\n      return []                       # unknown goal\n\n  primitive_needs = cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  if \"_at\" in recipe:\n      workshop_idx = cookbook.index[recipe[\"_at\"]]\n\n  # --------------------------------------------------------------\n  # Helper utilities\n  # --------------------------------------------------------------\n  from collections import deque\n  import numpy as np\n\n  def bfs_path(start, goal, occupied):\n      \"\"\"Return a list of positions from start (excluded) to goal (included)\n      moving only through cells where occupied is False. Goal cell may be occupied.\"\"\"\n      w, h = occupied.shape\n      visited = np.zeros((w, h), dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start] = True\n      while q:\n          x, y = q.popleft()\n          if (x, y) == goal:\n              break\n          for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):\n              if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:\n                  if (nx, ny) == goal or not occupied[nx, ny]:\n                      visited[nx, ny] = True\n                      prev[(nx, ny)] = (x, y)\n                      q.append((nx, ny))\n      if not visited[goal]:\n          return None\n      # reconstruct path (exclude start, include goal)\n      path = []\n      cur = goal\n      while cur != start:\n          path.append(cur)\n          cur = prev[cur]\n      path.reverse()\n      return path\n\n  def delta_to_action(dx, dy):\n      \"\"\"Map a movement delta to the environment's action index.\"\"\"\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise ValueError(\"Invalid movement delta\")\n\n  # --------------------------------------------------------------\n  # Planning: collect primitives then craft at workshop (if any)\n  # --------------------------------------------------------------\n  actions = []\n  cur_pos = tuple(state.pos)          # current (x, y)\n  grid = state.grid.copy()            # mutable copy to track collected items\n\n  # --------------------------------------------------------------\n  # 1) Gather required primitive resources\n  # --------------------------------------------------------------\n  for kind_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          # locate remaining instances of this primitive\n          locations = np.argwhere(grid[:, :, kind_idx] > 0)\n          if locations.size == 0:\n              break\n          # order by Manhattan distance from current position\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n\n          occupied_mask = np.any(grid, axis=2)   # treat any entity as blocked\n          target = None\n          path = None\n          for idx in order:\n              cand = tuple(locations[idx])\n              p = bfs_path(cur_pos, cand, occupied_mask)\n              if p is not None:\n                  target = cand\n                  path = p\n                  break\n          if target is None:\n              # unable to reach any remaining instance; skip this primitive\n              continue\n\n          # follow the path, emitting movement actions\n          for step in path:\n              dx = step[0] - cur_pos[0]\n              dy = step[1] - cur_pos[1]\n              actions.append(delta_to_action(dx, dy))\n              cur_pos = step\n          # pick up the primitive\n          actions.append(4)          # USE\n          grid[target[0], target[1], kind_idx] = 0   # mark as collected\n\n  # --------------------------------------------------------------\n  # 2) Move to workshop (if required) and craft the arrow\n  # --------------------------------------------------------------\n  if workshop_idx is not None:\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          dists = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n          occupied_mask = np.any(state.grid, axis=2)   # original grid (workshops occupy cells)\n          for idx in order:\n              cand = tuple(workshop_cells[idx])\n              p = bfs_path(cur_pos, cand, occupied_mask)\n              if p is not None:\n                  for step in p:\n                      dx = step[0] - cur_pos[0]\n                      dy = step[1] - cur_pos[1]\n                      actions.append(delta_to_action(dx, dy))\n                      cur_pos = step\n                  actions.append(4)   # USE to trigger crafting\n                  break\n  else:\n      # No specific workshop required; use current cell to craft\n      actions.append(4)\n\n  return actions", "env_interactions": 26, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T19:53:51.705354", "function_name": "make_arrow", "function_body": "  # Reset environment and obtain core objects\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world\n  cookbook = world.cookbook\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow) and its recipe\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n  if goal_idx is None:\n      return []                       # unknown goal\n\n  primitive_needs = cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  if \"_at\" in recipe:\n      workshop_idx = cookbook.index[recipe[\"_at\"]]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  import numpy as np\n  from collections import deque\n\n  def bfs_path(start, goal, occupied):\n      \"\"\"Return a list of positions from start (excluded) to goal (included).\n      `occupied` is a bool array where True means the cell cannot be entered.\n      The goal cell may be occupied (e.g., a workshop).\"\"\"\n      w, h = occupied.shape\n      visited = np.zeros((w, h), dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start] = True\n      while q:\n          x, y = q.popleft()\n          if (x, y) == goal:\n              break\n          for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):\n              if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:\n                  if (nx, ny) == goal or not occupied[nx, ny]:\n                      visited[nx, ny] = True\n                      prev[(nx, ny)] = (x, y)\n                      q.append((nx, ny))\n      if not visited[goal]:\n          return None\n      # reconstruct path (exclude start, include goal)\n      path = []\n      cur = goal\n      while cur != start:\n          path.append(cur)\n          cur = prev[cur]\n      path.reverse()\n      return path\n\n  def delta_to_action(dx, dy):\n      \"\"\"Map a movement delta to the environment's action index.\"\"\"\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise ValueError(\"Invalid movement delta\")\n\n  # ------------------------------------------------------------------\n  # Planning: collect primitives then craft at workshop (if any)\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = tuple(state.pos)          # current (x, y)\n  mutable_grid = state.grid.copy()    # mutable copy to track collected items\n\n  # ------------------------------------------------------------------\n  # 1) Gather required primitive resources\n  # ------------------------------------------------------------------\n  for kind_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          # locate remaining instances of this primitive\n          locations = np.argwhere(mutable_grid[:, :, kind_idx] > 0)\n          if locations.size == 0:\n              break\n          # order by Manhattan distance from current position\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n\n          occupied_mask = np.any(mutable_grid, axis=2)   # treat any entity as blocked\n          target = None\n          path = None\n          for idx in order:\n              cand = tuple(locations[idx])\n              p = bfs_path(cur_pos, cand, occupied_mask)\n              if p is not None:\n                  target = cand\n                  path = p\n                  break\n          if target is None:\n              # unable to reach any remaining instance; skip this primitive\n              continue\n\n          # follow the path, emitting movement actions\n          for step in path:\n              dx = step[0] - cur_pos[0]\n              dy = step[1] - cur_pos[1]\n              actions.append(delta_to_action(dx, dy))\n              cur_pos = step\n          # pick up the primitive\n          actions.append(4)          # USE\n          mutable_grid[target[0], target[1], kind_idx] = 0   # mark as collected\n\n  # ------------------------------------------------------------------\n  # 2) Move to workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          dists = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n          occupied_mask = np.any(state.grid, axis=2)   # original occupancy (workshops occupy cells)\n          for idx in order:\n              cand = tuple(workshop_cells[idx])\n              p = bfs_path(cur_pos, cand, occupied_mask)\n              if p is not None:\n                  for step in p:\n                      dx = step[0] - cur_pos[0]\n                      dy = step[1] - cur_pos[1]\n                      actions.append(delta_to_action(dx, dy))\n                      cur_pos = step\n                  actions.append(4)   # USE to trigger crafting\n                  break\n  else:\n      # No specific workshop required; use current cell to craft\n      actions.append(4)\n\n  return actions", "env_interactions": 26, "island_id": 6, "scores": {"3": 0.5}}
