{"timestamp": "2025-10-27T19:37:18.826452", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ----------------------------------------------------------------------\n  # Action constants \u2013 must match CraftLab.action_specs ordering\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # 0:DOWN, 1:UP, 2:LEFT, 3:RIGHT\n  USE = 4\n\n  # ----------------------------------------------------------------------\n  def bfs_to_adjacent(start, target, blocked):\n      \"\"\"Return a list of movement actions that brings the agent from *start*\n      to any empty cell that is 4\u2011connected to *target*.\n      If no such path exists, returns an empty list.\"\"\"\n      h, w = blocked.shape\n      goal_cells = []\n      tx, ty = int(target[0]), int(target[1])\n      for a, (dx, dy) in enumerate(DIRS):\n          gx, gy = tx + dx, ty + dy\n          if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:\n              goal_cells.append((gx, gy))\n      if not goal_cells:\n          return []\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (cx, cy), path = q.popleft()\n          if (cx, cy) in goal_cells:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []\n\n  # ----------------------------------------------------------------------\n  # Reset / initialise environment (ignore errors if env does not expose reset)\n  try:\n      env.reset()\n  except Exception:\n      pass\n\n  # Grab the underlying CraftState \u2013 if not present we cannot plan\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []\n\n  world = env.world\n  idx = world.cookbook.index\n\n  # ----------------------------------------------------------------------\n  # Identify the goal item (arrow) and its recipe\n  try:\n      goal_idx = idx[\"arrow\"]\n  except Exception:\n      return []\n\n  # Primitive requirements for ONE arrow\n  primitives_needed = world.cookbook.primitives_for(goal_idx)\n\n  # Locate the workshop required for crafting the arrow\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\") or recipe.get(\"_key\")\n  if workshop_name is None:\n      return []\n  try:\n      workshop_idx = idx[workshop_name]\n  except Exception:\n      return []\n\n  # ----------------------------------------------------------------------\n  # Local mutable copies of the world state (so we can simulate actions)\n  pos = tuple(state.pos)                     # current (x, y)\n  grid = state.grid.copy()                   # (W, H, n_kinds)\n  inventory = state.inventory.copy()         # (n_kinds,)\n  occupied = np.any(grid > 0, axis=2)        # bool map of blocked cells\n\n  plan_actions = []\n\n  # ----------------------------------------------------------------------\n  def move_and_use(target_coord, kind_idx):\n      \"\"\"Move adjacent to *target_coord* (which holds *kind_idx*) and USE.\n      Updates local copies of pos, grid, occupied and inventory.\"\"\"\n      nonlocal pos, plan_actions, grid, occupied, inventory\n      path = bfs_to_adjacent(pos, target_coord, occupied)\n      if not path and pos != target_coord:\n          return False\n      # execute movement actions\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n      plan_actions.extend(path)\n      # use action\n      plan_actions.append(USE)\n\n      tx, ty = int(target_coord[0]), int(target_coord[1])\n      if grid[tx, ty, kind_idx] > 0:\n          grid[tx, ty, kind_idx] = 0\n          occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)\n          inventory[kind_idx] += 1\n      return True\n\n  # ----------------------------------------------------------------------\n  # 1) Collect all required primitives (may need several of the same kind)\n  for prim_idx, needed_cnt in primitives_needed.items():\n      for _ in range(needed_cnt):\n          # locate all cells that currently contain this primitive\n          candidates = np.argwhere(grid[:, :, prim_idx] > 0)\n          if candidates.shape[0] == 0:\n              # primitive exhausted \u2013 abort early\n              return plan_actions\n          # choose the nearest candidate (Manhattan distance)\n          dists = np.abs(candidates[:, 0] - pos[0]) + np.abs(candidates[:, 1] - pos[1])\n          target = candidates[dists.argmin()]\n          if not move_and_use(target, prim_idx):\n              return plan_actions\n\n  # ----------------------------------------------------------------------\n  # 2) Move to a workshop cell and craft the arrow\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.shape[0] == 0:\n      # fallback to original grid (in case the workshop cell was overwritten)\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.shape[0] == 0:\n          return plan_actions\n  dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])\n  workshop_target = workshop_cells[dists.argmin()]\n  move_and_use(workshop_target, workshop_idx)\n\n  return plan_actions", "env_interactions": 23, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T19:37:36.665702", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  world = env.world\n  arrow_idx = world.cookbook.index.index('arrow')\n  primitives_needed = world.cookbook.primitives_for(arrow_idx)  # {prim_idx: count}\n\n  actions = []\n  cur_pos = env._current_state.pos\n  grid = env._current_state.grid\n\n  def _nearest_kind(pos, kind_idx):\n      \"\"\"Return coordinates of the nearest cell containing kind_idx.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n      nearest = locations[dists.argmin()]\n      return (int(nearest[0]), int(nearest[1]))\n\n  def _move_actions(src, dst):\n      \"\"\"Manhattan moves from src (x, y) to dst (x, y).\"\"\"\n      acts = []\n      dx = dst[0] - src[0]\n      dy = dst[1] - src[1]\n      if dx > 0:\n          acts += [DOWN] * dx\n      elif dx < 0:\n          acts += [UP] * (-dx)\n      if dy > 0:\n          acts += [RIGHT] * dy\n      elif dy < 0:\n          acts += [LEFT] * (-dy)\n      return acts\n\n  # Collect required primitives\n  for prim_idx, count in primitives_needed.items():\n      for _ in range(count):\n          target = _nearest_kind(cur_pos, prim_idx)\n          if target is None:\n              # Primitive missing; abort planning\n              return actions\n          actions += _move_actions(cur_pos, target)\n          cur_pos = target\n          actions.append(USE)   # pick up the primitive\n\n  # Move to workshop (if any) and craft the arrow\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = _nearest_kind(cur_pos, workshop_idx)\n      if workshop_pos is not None:\n          actions += _move_actions(cur_pos, workshop_pos)\n          cur_pos = workshop_pos\n          actions.append(USE)   # craft at the workshop\n\n  return actions", "env_interactions": 22, "island_id": 5, "scores": {"3": 0.2}}
{"timestamp": "2025-10-27T19:37:37.791505", "function_name": "make_arrow", "function_body": "  # Action indices\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Shortcut references\n  world = env.world\n  state = env._current_state\n  grid = state.grid\n  cur_pos = state.pos\n\n  # Identify the goal (arrow) and its primitive requirements\n  arrow_idx = world.cookbook.index.index('arrow')\n  primitives_needed = world.cookbook.primitives_for(arrow_idx)  # {prim_idx: count}\n\n  # Helper: Manhattan\u2011style move actions from src to dst\n  def _move_actions(src, dst):\n      actions = []\n      x, y = src\n      tx, ty = dst\n      dx = tx - x\n      dy = ty - y\n      if dx > 0:\n          actions.extend([DOWN] * dx)\n      elif dx < 0:\n          actions.extend([UP] * (-dx))\n      if dy > 0:\n          actions.extend([RIGHT] * dy)\n      elif dy < 0:\n          actions.extend([LEFT] * (-dy))\n      return actions\n\n  # Helper: locate the nearest cell containing a given kind index\n  def _nearest_kind(pos, kind_idx):\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n      nearest = locations[dists.argmin()]\n      return int(nearest[0]), int(nearest[1])\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitive items\n  # ------------------------------------------------------------------\n  for prim_idx, count in primitives_needed.items():\n      for _ in range(count):\n          target = _nearest_kind(cur_pos, prim_idx)\n          if target is None:\n              # Primitive not present in the world \u2013 abort planning\n              return actions\n          actions.extend(_move_actions(cur_pos, target))\n          cur_pos = target\n          actions.append(USE)   # pick up the primitive\n\n  # ------------------------------------------------------------------\n  # 2. Go to the appropriate workshop (if any) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = _nearest_kind(cur_pos, workshop_idx)\n      if workshop_pos is not None:\n          actions.extend(_move_actions(cur_pos, workshop_pos))\n          cur_pos = workshop_pos\n          actions.append(USE)   # craft at the workshop\n\n  return actions", "env_interactions": 22, "island_id": 5, "scores": {"3": 0.2}}
{"timestamp": "2025-10-27T19:38:14.394696", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.scenario.world\n  cookbook = world.cookbook\n  index = cookbook.index\n\n  # Resolve action identifiers.\n  act_map = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (act_map[\"DOWN\"], act_map[\"UP\"],\n                               act_map[\"LEFT\"], act_map[\"RIGHT\"], act_map[\"USE\"])\n  moves = [(DOWN, (1, 0)), (UP, (-1, 0)), (LEFT, (0, -1)), (RIGHT, (0, 1))]\n\n  from collections import deque\n  import numpy as np\n\n  def bfs_path(start, target):\n      \"\"\"Shortest movement actions from start to target, ignoring occupied cells except the target.\"\"\"\n      if start == target:\n          return []\n      h, w = state.grid.shape[:2]\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          for act, (dr, dc) in moves:\n              nr, nc = cur[0] + dr, cur[1] + dc\n              if not (0 <= nr < h and 0 <= nc < w):\n                  continue\n              nxt = (nr, nc)\n              if nxt in visited:\n                  continue\n              # allow stepping onto the target even if occupied\n              if nxt != target and state.grid[nr, nc].any():\n                  continue\n              visited.add(nxt)\n              parent[nxt] = (cur, act)\n              q.append(nxt)\n      if target not in parent and start != target:\n          return []  # no path found\n      # reconstruct actions\n      path = []\n      cur = target\n      while cur != start:\n          prev, act = parent[cur]\n          path.append(act)\n          cur = prev\n      path.reverse()\n      return path\n\n  def find_nearest(kind_idx, start):\n      \"\"\"Find nearest cell containing `kind_idx`; return (action_list, cell) or ([], None).\"\"\"\n      if state.grid[start[0], start[1], kind_idx] > 0:\n          return [], start\n      h, w = state.grid.shape[:2]\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          cur = q.popleft()\n          for act, (dr, dc) in moves:\n              nr, nc = cur[0] + dr, cur[1] + dc\n              if not (0 <= nr < h and 0 <= nc < w):\n                  continue\n              nxt = (nr, nc)\n              if nxt in visited:\n                  continue\n              occupied = state.grid[nr, nc].any()\n              has_target = state.grid[nr, nc, kind_idx] > 0\n              if occupied and not has_target:\n                  continue\n              visited.add(nxt)\n              parent[nxt] = (cur, act)\n              if has_target:\n                  # reconstruct path to this cell\n                  path = []\n                  cur2 = nxt\n                  while cur2 != start:\n                      prev2, act2 = parent[cur2]\n                      path.append(act2)\n                      cur2 = prev2\n                  path.reverse()\n                  return path, nxt\n              q.append(nxt)\n      return [], None\n\n  goal_name = \"arrow\"\n  if goal_name not in index.contents:\n      return []\n  goal_idx = index[goal_name]\n\n  # Primitive requirements for one arrow.\n  needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n  actions = []\n\n  # 1. Collect all required primitives.\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          path, cell = find_nearest(prim_idx, state.pos)\n          if cell is None:\n              return actions\n          actions.extend(path)\n          state.pos = cell\n          actions.append(USE)\n          state.inventory[prim_idx] += 1\n          tr, tc = cell\n          state.grid[tr, tc, prim_idx] = 0\n\n  # 2. Move to the workshop and craft the arrow.\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      return actions\n  workshop_idx = index[workshop_name]\n  path, cell = find_nearest(workshop_idx, state.pos)\n  if cell is None:\n      return actions\n  actions.extend(path)\n  state.pos = cell\n  actions.append(USE)\n\n  return actions", "env_interactions": 26, "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T19:38:15.521073", "function_name": "make_arrow", "function_body": "  # Reset the environment and fetch useful references.\n  env.reset()\n  state = env._current_state\n  world = env.scenario.world\n  cookbook = world.cookbook\n  index = cookbook.index\n\n  # Resolve action identifiers.\n  act_map = env.action_specs()\n  DOWN = act_map[\"DOWN\"]\n  UP = act_map[\"UP\"]\n  LEFT = act_map[\"LEFT\"]\n  RIGHT = act_map[\"RIGHT\"]\n  USE = act_map[\"USE\"]\n  moves = [(DOWN, (1, 0)), (UP, (-1, 0)), (LEFT, (0, -1)), (RIGHT, (0, 1))]\n\n  # Identify the goal item.\n  goal_name = \"arrow\"\n  if goal_name not in index.contents:\n      return []\n  goal_idx = index[goal_name]\n\n  # Primitive requirements for one arrow.\n  needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n  actions = []\n\n  from collections import deque\n  import numpy as np\n\n  def bfs_path(start, target):\n      \"\"\"Shortest list of move actions from start to target, avoiding occupied cells.\"\"\"\n      if start == target:\n          return []\n      h, w = state.grid.shape[:2]\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          for act, (dr, dc) in moves:\n              nr, nc = cur[0] + dr, cur[1] + dc\n              if not (0 <= nr < h and 0 <= nc < w):\n                  continue\n              nxt = (nr, nc)\n              if nxt in visited:\n                  continue\n              # Block any non\u2011empty cell unless it is the destination.\n              if nxt != target and state.grid[nr, nc].any():\n                  continue\n              visited.add(nxt)\n              parent[nxt] = (cur, act)\n              q.append(nxt)\n      if target not in parent and start != target:\n          return []  # No path found.\n      # Reconstruct the action sequence.\n      path = []\n      cur = target\n      while cur != start:\n          prev, act = parent[cur]\n          path.append(act)\n          cur = prev\n      path.reverse()\n      return path\n\n  def find_nearest(kind_idx, start):\n      \"\"\"Locate the nearest cell containing `kind_idx` and return (action_path, cell).\"\"\"\n      if state.grid[start[0], start[1], kind_idx] > 0:\n          return [], start\n      h, w = state.grid.shape[:2]\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          cur = q.popleft()\n          for act, (dr, dc) in moves:\n              nr, nc = cur[0] + dr, cur[1] + dc\n              if not (0 <= nr < h and 0 <= nc < w):\n                  continue\n              nxt = (nr, nc)\n              if nxt in visited:\n                  continue\n              # If the cell holds the target kind, we can step onto it.\n              if state.grid[nr, nc, kind_idx] > 0:\n                  parent[nxt] = (cur, act)\n                  # Build path to this cell.\n                  path = []\n                  cur2 = nxt\n                  while cur2 != start:\n                      prev2, act2 = parent[cur2]\n                      path.append(act2)\n                      cur2 = prev2\n                  path.reverse()\n                  return path, nxt\n              # Otherwise the cell must be empty to traverse.\n              if state.grid[nr, nc].any():\n                  continue\n              visited.add(nxt)\n              parent[nxt] = (cur, act)\n              q.append(nxt)\n      return [], None\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives.\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          path, cell = find_nearest(prim_idx, state.pos)\n          if cell is None:\n              return actions  # Primitive not reachable.\n          actions.extend(path)\n          state.pos = cell\n          actions.append(USE)  # Pick up the primitive.\n          # Update the simulated state.\n          state.inventory[prim_idx] += 1\n          tr, tc = cell\n          state.grid[tr, tc, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 2. Move to the workshop and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      return actions  # No workshop information.\n  workshop_idx = index[workshop_name]\n  path, cell = find_nearest(workshop_idx, state.pos)\n  if cell is None:\n      return actions  # Workshop not reachable.\n  actions.extend(path)\n  state.pos = cell\n  actions.append(USE)  # Craft the arrow.\n\n  return actions", "env_interactions": 26, "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T19:38:46.148052", "function_name": "make_arrow", "function_body": "  # Reset environment and obtain references\n  env.reset()\n  state = env._current_state\n  world = env.scenario.world\n  cookbook = world.cookbook\n  index = cookbook.index\n\n  # Action indices\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Identify goal index for \"arrow\"\n  goal_name = \"arrow\"\n  if goal_name not in index.contents:\n      return []\n  goal_idx = index[goal_name]\n\n  # Primitive requirements (including transitive ones)\n  needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n  plan_actions = []\n\n  # Helper: BFS path finder (4\u2011connected) that treats any occupied cell as blocked,\n  # except the target cell itself.\n  def bfs(start, target):\n      h, w = state.grid.shape[:2]\n      occupied = np.any(state.grid > 0, axis=2)\n      occupied[target] = False\n      q = collections.deque([start])\n      came = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          r, c = cur\n          for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nr, nc = r + dr, c + dc\n              if 0 <= nr < h and 0 <= nc < w and not occupied[nr, nc]:\n                  nxt = (nr, nc)\n                  if nxt not in came:\n                      came[nxt] = cur\n                      q.append(nxt)\n      else:\n          return None\n      # reconstruct\n      path = []\n      cur = target\n      while cur is not None:\n          path.append(cur)\n          cur = came[cur]\n      path.reverse()\n      return path\n\n  # Mapping from movement delta to action index\n  delta2act = {(1, 0): DOWN, (-1, 0): UP, (0, 1): RIGHT, (0, -1): LEFT}\n\n  # Collect each required primitive one by one\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if cells.size == 0:\n              return plan_actions\n          target = tuple(cells[0])\n\n          path = bfs(state.pos, target)\n          if path is None:\n              return plan_actions\n\n          for (r0, c0), (r1, c1) in zip(path, path[1:]):\n              act = delta2act[(r1 - r0, c1 - c0)]\n              plan_actions.append(act)\n              state.pos = (r1, c1)\n\n          plan_actions.append(USE)\n          state.inventory[prim_idx] += 1\n          state.grid[target[0], target[1], prim_idx] = 0\n\n  # Find workshop for the goal and move there\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      return plan_actions\n\n  workshop_idx = index[workshop_name]\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      return plan_actions\n  wpos = tuple(workshop_cells[0])\n\n  path = bfs(state.pos, wpos)\n  if path is None:\n      return plan_actions\n  for (r0, c0), (r1, c1) in zip(path, path[1:]):\n      act = delta2act[(r1 - r0, c1 - c0)]\n      plan_actions.append(act)\n      state.pos = (r1, c1)\n\n  # Craft the arrow\n  plan_actions.append(USE)\n\n  return plan_actions", "env_interactions": 28, "island_id": 4, "scores": {"3": 2.0}}
{"timestamp": "2025-10-27T19:38:47.276047", "function_name": "make_arrow", "function_body": "  # ------------------------------------------------------------\n  # Basic constants and environment reset\n  # ------------------------------------------------------------\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  env.reset()\n  state = env._current_state               # CraftState\n  world = env.scenario.world                # CraftWorld\n  cookbook = world.cookbook                 # Cookbook\n  idx = cookbook.index                      # name \u2194 id mapping\n\n  # ------------------------------------------------------------\n  # Identify the goal (arrow) and its primitive requirements\n  # ------------------------------------------------------------\n  goal_name = \"arrow\"\n  if goal_name not in idx.contents:\n      return []                              # arrow not defined in this world\n  goal_idx = idx[goal_name]\n\n  primitive_needs = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n  actions = []\n\n  # ------------------------------------------------------------\n  # Helper: BFS path\u2011finder (4\u2011connected Manhattan moves)\n  # ------------------------------------------------------------\n  def bfs(start, target):\n      \"\"\"Return a list of positions from start to target (inclusive)\n      using 4\u2011connected moves. Returns None if target unreachable.\"\"\"\n      h, w = state.grid.shape[:2]\n      occupied = np.any(state.grid > 0, axis=2)          # True where blocked\n      # allow stepping onto the target even if it is occupied (primitive or workshop)\n      occupied[target] = False\n      q = collections.deque([start])\n      came_from = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          r, c = cur\n          for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nr, nc = r + dr, c + dc\n              if 0 <= nr < h and 0 <= nc < w:\n                  if not occupied[nr, nc] and (nr, nc) not in came_from:\n                      came_from[(nr, nc)] = cur\n                      q.append((nr, nc))\n      else:\n          return None  # target never reached\n\n      # reconstruct path\n      path = []\n      cur = target\n      while cur is not None:\n          path.append(cur)\n          cur = came_from[cur]\n      path.reverse()\n      return path\n\n  # ------------------------------------------------------------\n  # Mapping from movement delta to action index\n  # ------------------------------------------------------------\n  delta_to_action = {\n      (1, 0): DOWN,\n      (-1, 0): UP,\n      (0, 1): RIGHT,\n      (0, -1): LEFT,\n  }\n\n  # ------------------------------------------------------------\n  # 1. Collect all required primitives.\n  # ------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          # locate the nearest remaining instance of the primitive\n          positions = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if positions.size == 0:\n              return actions  # primitive missing \u2013 abort planning\n\n          # choose nearest by Manhattan distance\n          dists = np.abs(positions[:, 0] - state.pos[0]) + np.abs(positions[:, 1] - state.pos[1])\n          nearest = positions[dists.argmin()]\n          target = (int(nearest[0]), int(nearest[1]))\n\n          # plan a path to the primitive\n          path = bfs(state.pos, target)\n          if path is None:\n              return actions  # unreachable \u2013 abort planning\n\n          # translate the path into actions and update simulated state\n          for (r0, c0), (r1, c1) in zip(path, path[1:]):\n              act = delta_to_action[(r1 - r0, c1 - c0)]\n              actions.append(act)\n              state.pos = (r1, c1)\n\n          # pick up the primitive\n          actions.append(USE)\n          state.inventory[prim_idx] += 1\n          state.grid[target[0], target[1], prim_idx] = 0\n\n  # ------------------------------------------------------------\n  # 2. Move to the appropriate workshop and craft the arrow.\n  # ------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      return actions  # no workshop information \u2013 cannot craft\n\n  workshop_idx = idx[workshop_name]\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      return actions  # workshop not present in this scenario\n\n  # pick the first workshop cell (any will do)\n  w_r, w_c = int(workshop_cells[0][0]), int(workshop_cells[0][1])\n  path = bfs(state.pos, (w_r, w_c))\n  if path is None:\n      return actions  # unreachable \u2013 abort\n\n  for (r0, c0), (r1, c1) in zip(path, path[1:]):\n      act = delta_to_action[(r1 - r0, c1 - c0)]\n      actions.append(act)\n      state.pos = (r1, c1)\n\n  # craft the arrow at the workshop\n  actions.append(USE)\n\n  return actions", "env_interactions": 24, "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T19:39:11.996414", "function_name": "make_arrow", "function_body": "  # Reset environment and get references\n  env.reset()\n  state = env._current_state\n  world = env.scenario.world\n  cookbook = world.cookbook\n  index = cookbook.index\n\n  # Action IDs\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Goal identification\n  goal_name = \"arrow\"\n  if goal_name not in index.contents:\n      return []\n  goal_idx = index[goal_name]\n\n  # Determine primitive requirements (including transitive)\n  needed = cookbook.primitives_for(goal_idx)  # dict {prim_idx: count}\n  plan = []\n\n  # Helper BFS\n  def bfs(start, target):\n      h, w = state.grid.shape[:2]\n      occupied = np.any(state.grid > 0, axis=2)\n      occupied[target] = False  # allow stepping onto target\n      q = collections.deque([start])\n      came_from = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          r, c = cur\n          for dr, dc in ((1,0), (-1,0), (0,1), (0,-1)):\n              nr, nc = r+dr, c+dc\n              if 0 <= nr < h and 0 <= nc < w and not occupied[nr, nc]:\n                  nxt = (nr, nc)\n                  if nxt not in came_from:\n                      came_from[nxt] = cur\n                      q.append(nxt)\n      else:\n          return None\n      # reconstruct path\n      path = []\n      cur = target\n      while cur is not None:\n          path.append(cur)\n          cur = came_from[cur]\n      path.reverse()\n      return path\n\n  delta2act = {(1,0): DOWN, (-1,0): UP, (0,1): RIGHT, (0,-1): LEFT}\n\n  # Collect primitives\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if cells.size == 0:\n              return plan\n          target = tuple(cells[0])\n          path = bfs(state.pos, target)\n          if path is None:\n              return plan\n          for (r0, c0), (r1, c1) in zip(path, path[1:]):\n              act = delta2act[(r1 - r0, c1 - c0)]\n              plan.append(act)\n              state.pos = (r1, c1)\n          # pick up\n          plan.append(USE)\n          state.inventory[prim_idx] += 1\n          state.grid[target[0], target[1], prim_idx] = 0\n\n  # Move to workshop and craft\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      return plan\n  workshop_idx = index[workshop_name]\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      return plan\n  wpos = tuple(workshop_cells[0])\n  path = bfs(state.pos, wpos)\n  if path is None:\n      return plan\n  for (r0, c0), (r1, c1) in zip(path, path[1:]):\n      act = delta2act[(r1 - r0, c1 - c0)]\n      plan.append(act)\n      state.pos = (r1, c1)\n\n  plan.append(USE)\n  return plan", "env_interactions": 28, "island_id": 4, "scores": {"3": 2.0}}
{"timestamp": "2025-10-27T19:39:13.124492", "function_name": "make_arrow", "function_body": "  # Reset the environment and obtain useful references\n  env.reset()\n  state = env._current_state               # CraftState\n  world = env.scenario.world                # CraftWorld\n  cookbook = world.cookbook                 # Cookbook\n  index = cookbook.index                    # name \u2194 id mapping\n\n  # Action indices (as defined in the environment)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow) index\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  if goal_name not in index.contents:\n      return []  # Arrow not defined in this world\n  goal_idx = index[goal_name]\n\n  # ------------------------------------------------------------------\n  # Determine which primitive resources are required to craft one arrow\n  # ------------------------------------------------------------------\n  primitive_needs = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper: BFS path\u2011finder (4\u2011connected Manhattan moves)\n  # ------------------------------------------------------------------\n  def bfs(start, target):\n      \"\"\"Return a list of positions from start to target (inclusive)\n      using 4\u2011connected moves, treating any occupied cell as blocked\n      except the target cell itself. Returns None if unreachable.\"\"\"\n      h, w = state.grid.shape[:2]\n      occupied = np.any(state.grid > 0, axis=2)          # True where blocked\n      occupied[target] = False                           # allow stepping onto target\n      q = collections.deque([start])\n      came_from = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          r, c = cur\n          for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nr, nc = r + dr, c + dc\n              if 0 <= nr < h and 0 <= nc < w and not occupied[nr, nc]:\n                  nxt = (nr, nc)\n                  if nxt not in came_from:\n                      came_from[nxt] = cur\n                      q.append(nxt)\n      else:\n          return None  # target never reached\n\n      # Reconstruct path from start to target\n      path = []\n      cur = target\n      while cur is not None:\n          path.append(cur)\n          cur = came_from[cur]\n      path.reverse()\n      return path\n\n  # ------------------------------------------------------------------\n  # Mapping from movement delta to action index\n  # ------------------------------------------------------------------\n  delta_to_action = {\n      (1, 0): DOWN,\n      (-1, 0): UP,\n      (0, 1): RIGHT,\n      (0, -1): LEFT,\n  }\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives.\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          # Find any remaining instance of this primitive on the map\n          cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if cells.size == 0:\n              # No more of this primitive; abort planning\n              return actions\n\n          target_r, target_c = cells[0]\n\n          # Compute a path to the primitive\n          path = bfs(state.pos, (target_r, target_c))\n          if path is None:\n              # Unreachable primitive; abort planning\n              return actions\n\n          # Convert the path into actions and update simulated state\n          for (r0, c0), (r1, c1) in zip(path, path[1:]):\n              act = delta_to_action[(r1 - r0, c1 - c0)]\n              actions.append(act)\n              state.pos = (r1, c1)\n\n          # Pick up the primitive\n          actions.append(USE)\n          state.inventory[prim_idx] += 1\n          state.grid[target_r, target_c, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 2. Move to the appropriate workshop and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      return actions  # No workshop information; cannot craft\n\n  workshop_idx = index[workshop_name]\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      return actions  # No workshop cell found\n\n  w_r, w_c = workshop_cells[0]\n\n  path = bfs(state.pos, (w_r, w_c))\n  if path is None:\n      return actions  # Workshop unreachable\n\n  for (r0, c0), (r1, c1) in zip(path, path[1:]):\n      act = delta_to_action[(r1 - r0, c1 - c0)]\n      actions.append(act)\n      state.pos = (r1, c1)\n\n  # Craft the arrow at the workshop\n  actions.append(USE)\n\n  return actions", "env_interactions": 28, "island_id": 4, "scores": {"3": 2.0}}
{"timestamp": "2025-10-27T19:39:42.081541", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  goal_name = \"arrow\"\n  goal_idx = idx[goal_name]\n\n  primitive_counts = world.cookbook.primitives_for(goal_idx)\n\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else idx[wk]\n\n  def find_locations(kind):\n      occ = np.where(state.grid[:, :, kind] > 0)\n      return list(zip(occ[0].tolist(), occ[1].tolist()))\n\n  def bfs_path(start, goal):\n      if start == goal:\n          return [start]\n      W, H = state.grid.shape[:2]\n      blocked = set()\n      for ng in world.non_grabbable_indices:\n          occ = np.where(state.grid[:, :, ng] > 0)\n          blocked.update(zip(occ[0].tolist(), occ[1].tolist()))\n      queue = collections.deque([start])\n      prev = {start: None}\n      while queue:\n          cur = queue.popleft()\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:\n                  nxt = (nx, ny)\n                  if nxt not in prev:\n                      prev[nxt] = cur\n                      if nxt == goal:\n                          path = [goal]\n                          while path[-1] != start:\n                              path.append(prev[path[-1]])\n                          path.reverse()\n                          return path\n                      queue.append(nxt)\n      return [start]\n\n  def move_action(cur, nxt):\n      dx = nxt[0] - cur[0]\n      dy = nxt[1] - cur[1]\n      if dx == 1:\n          return 3   # RIGHT\n      if dx == -1:\n          return 2   # LEFT\n      if dy == 1:\n          return 0   # DOWN\n      if dy == -1:\n          return 1   # UP\n      raise AssertionError(\"Non\u2011adjacent movement requested\")\n\n  actions = []\n  cur_pos = state.pos\n\n  # Collect required primitives\n  for prim_idx, needed in primitive_counts.items():\n      while state.inventory[prim_idx] < needed:\n          locations = find_locations(prim_idx)\n          if not locations:\n              # No more of this primitive on the grid; abort.\n              break\n          target = min(\n              locations,\n              key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1])\n          )\n          path = bfs_path(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n          actions.append(4)   # USE to pick up\n          # Update planning state\n          state.inventory[prim_idx] += 1\n          state.grid[target[0], target[1], prim_idx] = 0\n\n  # Move to workshop if required\n  if workshop_kind is not None:\n      wk_locations = find_locations(workshop_kind)\n      if wk_locations:\n          target = min(\n              wk_locations,\n              key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1])\n          )\n          path = bfs_path(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n\n  # Craft the arrow\n  actions.append(4)   # USE at current location\n\n  return actions", "env_interactions": 19, "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T19:39:43.208223", "function_name": "make_arrow", "function_body": "  # Reset environment and get current planning snapshot\n  env.reset()\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  # ------------------------------------------------------------\n  # Identify goal and its recipe\n  # ------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = idx[goal_name]\n\n  # Primitive requirements for a single arrow\n  primitive_counts = world.cookbook.primitives_for(goal_idx)\n\n  # Workshop required for crafting (if any)\n  workshop_kind = None\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else idx[wk]\n\n  # ------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------\n  def find_locations(kind):\n      \"\"\"Return list of (x, y) where `kind` exists on the grid.\"\"\"\n      occ = np.where(state.grid[:, :, kind] > 0)\n      return list(zip(occ[0].tolist(), occ[1].tolist()))\n\n  def bfs_path(start, goal):\n      \"\"\"Shortest Manhattan path avoiding non\u2011grabbable cells.\"\"\"\n      if start == goal:\n          return [start]\n      W, H = state.grid.shape[:2]\n\n      # cells occupied by non\u2011grabbable entities are blocked\n      blocked = set()\n      for ng in world.non_grabbable_indices:\n          occ = np.where(state.grid[:, :, ng] > 0)\n          blocked.update(zip(occ[0].tolist(), occ[1].tolist()))\n\n      queue = collections.deque([start])\n      prev = {start: None}\n      while queue:\n          cur = queue.popleft()\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:\n                  nxt = (nx, ny)\n                  if nxt not in prev:\n                      prev[nxt] = cur\n                      if nxt == goal:\n                          # reconstruct path\n                          path = [goal]\n                          while path[-1] != start:\n                              path.append(prev[path[-1]])\n                          path.reverse()\n                          return path\n                      queue.append(nxt)\n      # No path found \u2013 stay where we are\n      return [start]\n\n  def move_action(cur, nxt):\n      \"\"\"Translate a step into an action index (DOWN=0, UP=1, LEFT=2, RIGHT=3).\"\"\"\n      dx = nxt[0] - cur[0]\n      dy = nxt[1] - cur[1]\n      if dx == 1:\n          return 3   # RIGHT\n      if dx == -1:\n          return 2   # LEFT\n      if dy == 1:\n          return 0   # DOWN\n      if dy == -1:\n          return 1   # UP\n      raise AssertionError(\"Requested move is not to an adjacent cell\")\n\n  # ------------------------------------------------------------\n  # Build action sequence\n  # ------------------------------------------------------------\n  actions = []\n  cur_pos = state.pos\n\n  # 1) Collect all required primitives\n  for prim_idx, needed in primitive_counts.items():\n      while state.inventory[prim_idx] < needed:\n          # locate remaining copies of the primitive\n          locations = find_locations(prim_idx)\n          if not locations:\n              # cannot find more \u2013 break out of loop for this primitive\n              break\n\n          # pick the nearest instance (Manhattan distance)\n          target = min(\n              locations,\n              key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1])\n          )\n\n          # move to the target cell\n          path = bfs_path(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n\n          # pick up (USE)\n          actions.append(4)   # USE\n          # update planning snapshot\n          state.inventory[prim_idx] += 1\n          state.grid[target[0], target[1], prim_idx] = 0\n\n  # 2) Move to required workshop (if any) and craft\n  if workshop_kind is not None:\n      wk_locations = find_locations(workshop_kind)\n      if wk_locations:\n          target = min(\n              wk_locations,\n              key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1])\n          )\n          path = bfs_path(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n\n  # 3) Craft the arrow (USE at current location)\n  actions.append(4)   # USE\n\n  return actions", "env_interactions": 19, "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T19:40:09.707895", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ----------------------------------------------------------------------\n  # Action constants (match CraftLab.action_specs order)\n  # ----------------------------------------------------------------------\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # 0:DOWN, 1:UP, 2:LEFT, 3:RIGHT\n  USE = 4\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS to any empty cell adjacent to a target coordinate\n  # ----------------------------------------------------------------------\n  def bfs_to_adjacent(start, target, blocked):\n      \"\"\"Return a list of movement actions that brings the agent from *start*\n      to a free 4\u2011connected neighbour of *target*.  If no such path exists,\n      returns an empty list.\"\"\"\n      h, w = blocked.shape\n      tx, ty = int(target[0]), int(target[1])\n      goal_cells = []\n      for a, (dx, dy) in enumerate(DIRS):\n          gx, gy = tx + dx, ty + dy\n          if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:\n              goal_cells.append((gx, gy))\n      if not goal_cells:\n          return []\n\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (cx, cy), path = q.popleft()\n          if (cx, cy) in goal_cells:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []\n\n  # ----------------------------------------------------------------------\n  # Reset / initialise environment\n  # ----------------------------------------------------------------------\n  try:\n      env.reset()\n  except Exception:\n      pass\n\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []   # cannot access internal state\n\n  world = env.world\n  idx = world.cookbook.index\n\n  # ----------------------------------------------------------------------\n  # Identify goal (arrow) and its recipe\n  # ----------------------------------------------------------------------\n  try:\n      arrow_idx = idx[\"arrow\"]\n  except Exception:\n      return []   # no arrow in this world\n\n  primitives_needed = world.cookbook.primitives_for(arrow_idx)\n\n  recipe_dict = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe_dict.get(\"_at\") or recipe_dict.get(\"_key\")\n  if workshop_name is None:\n      return []   # cannot determine required workshop\n\n  try:\n      workshop_idx = idx[workshop_name]\n  except Exception:\n      return []   # workshop name not indexed\n\n  # ----------------------------------------------------------------------\n  # Local mutable copies for planning\n  # ----------------------------------------------------------------------\n  pos = tuple(state.pos)                     # (x, y)\n  grid = state.grid.copy()                   # (W, H, n_kinds)\n  inventory = state.inventory.copy()         # (n_kinds,)\n  occupied = np.any(grid > 0, axis=2)        # bool matrix of blocked cells\n\n  plan_actions = []\n\n  # ----------------------------------------------------------------------\n  # Helper: move adjacent to *target_coord* and issue a USE action\n  # ----------------------------------------------------------------------\n  def move_and_use(target_coord, kind_idx):\n      \"\"\"Navigate to a free neighbour of *target_coord*, perform USE, and\n      update the simulated world state.  Returns True on success.\"\"\"\n      nonlocal pos, plan_actions, grid, occupied, inventory\n\n      path = bfs_to_adjacent(pos, target_coord, occupied)\n      if not path and pos != target_coord:\n          return False\n\n      # apply movement actions to simulated position\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n      plan_actions.extend(path)\n\n      # perform USE\n      plan_actions.append(USE)\n\n      tx, ty = int(target_coord[0]), int(target_coord[1])\n      if grid[tx, ty, kind_idx] > 0:\n          # pick up the entity\n          grid[tx, ty, kind_idx] = 0\n          occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)\n          inventory[kind_idx] += 1\n      return True\n\n  # ----------------------------------------------------------------------\n  # Collect required primitives (use inventory if already present)\n  # ----------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      while inventory[prim_idx] < needed_cnt:\n          candidates = np.argwhere(grid[:, :, prim_idx] > 0)\n          if candidates.shape[0] == 0:\n              # No more of this primitive on the map \u2013 abort planning\n              return plan_actions\n          # Choose the nearest candidate (Manhattan distance)\n          dists = np.abs(candidates[:, 0] - pos[0]) + np.abs(candidates[:, 1] - pos[1])\n          target = candidates[dists.argmin()]\n          if not move_and_use(target, prim_idx):\n              return plan_actions\n\n  # ----------------------------------------------------------------------\n  # Move to a workshop cell and craft the arrow\n  # ----------------------------------------------------------------------\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.shape[0] == 0:\n      # Workshops are static \u2013 fall back to original scenario grid\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.shape[0] == 0:\n          return plan_actions\n\n  dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])\n  workshop_target = workshop_cells[dists.argmin()]\n\n  move_and_use(workshop_target, workshop_idx)\n\n  # ----------------------------------------------------------------------\n  # (Optional) If the crafted arrow appears on the ground, pick it up\n  # ----------------------------------------------------------------------\n  if inventory[arrow_idx] == 0:\n      # look for an arrow on the grid after crafting\n      arrow_cells = np.argwhere(grid[:, :, arrow_idx] > 0)\n      if arrow_cells.shape[0] > 0:\n          # pick the nearest one\n          dists = np.abs(arrow_cells[:, 0] - pos[0]) + np.abs(arrow_cells[:, 1] - pos[1])\n          target = arrow_cells[dists.argmin()]\n          move_and_use(target, arrow_idx)\n\n  return plan_actions", "env_interactions": 23, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T19:40:10.833604", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ------------------------------------------------------------------\n  # Action constants (match CraftLab.action_specs order)\n  # ------------------------------------------------------------------\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # 0:DOWN, 1:UP, 2:LEFT, 3:RIGHT\n  USE = 4\n\n  # ------------------------------------------------------------------\n  # Helper: BFS to any empty cell adjacent to a target coordinate\n  # ------------------------------------------------------------------\n  def bfs_to_adjacent(start, target, blocked):\n      \"\"\"Return a list of movement actions that brings the agent from *start*\n      to a free 4\u2011connected neighbour of *target*.\n      If unreachable, returns an empty list.\"\"\"\n      h, w = blocked.shape\n      tx, ty = int(target[0]), int(target[1])\n      goal_cells = []\n      for a, (dx, dy) in enumerate(DIRS):\n          gx, gy = tx + dx, ty + dy\n          if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:\n              goal_cells.append((gx, gy))\n      if not goal_cells:\n          return []\n\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (cx, cy), path = q.popleft()\n          if (cx, cy) in goal_cells:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []\n\n  # ------------------------------------------------------------------\n  # Reset / initialise environment\n  # ------------------------------------------------------------------\n  try:\n      env.reset()\n  except Exception:\n      pass\n\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []   # cannot access internal state\n\n  world = env.world\n  idx = world.cookbook.index\n\n  # ------------------------------------------------------------------\n  # Identify goal (arrow) and its recipe\n  # ------------------------------------------------------------------\n  try:\n      arrow_idx = idx[\"arrow\"]\n  except Exception:\n      return []   # arrow not present in this world\n\n  primitives_needed = world.cookbook.primitives_for(arrow_idx)\n\n  recipe_dict = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe_dict.get(\"_at\") or recipe_dict.get(\"_key\")\n  if workshop_name is None:\n      return []   # cannot find required workshop\n\n  try:\n      workshop_idx = idx[workshop_name]\n  except Exception:\n      return []   # workshop name not indexed\n\n  # ------------------------------------------------------------------\n  # Local mutable copies for planning\n  # ------------------------------------------------------------------\n  pos = tuple(state.pos)                     # (x, y)\n  grid = state.grid.copy()                   # (W, H, n_kinds)\n  inventory = state.inventory.copy()\n  occupied = np.any(grid > 0, axis=2)        # bool matrix of blocked cells\n\n  plan_actions = []\n\n  # ------------------------------------------------------------------\n  # Helper: move adjacent to a target entity cell and issue USE\n  # ------------------------------------------------------------------\n  def move_and_use(target_coord, kind_idx):\n      \"\"\"Move adjacent to *target_coord* (which holds *kind_idx*) and USE.\n      Updates simulated position, grid, occupied, inventory.\n      Returns True on success, False otherwise.\"\"\"\n      nonlocal pos, plan_actions, grid, occupied, inventory\n\n      path = bfs_to_adjacent(pos, target_coord, occupied)\n      if not path and pos != target_coord:\n          return False\n\n      # Apply movement actions to simulated state\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n      plan_actions.extend(path)\n\n      # Perform USE\n      plan_actions.append(USE)\n\n      tx, ty = int(target_coord[0]), int(target_coord[1])\n      if grid[tx, ty, kind_idx] > 0:\n          # Pick up the primitive / workshop item\n          grid[tx, ty, kind_idx] = 0\n          occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)\n          inventory[kind_idx] += 1\n      return True\n\n  # ------------------------------------------------------------------\n  # Collect required primitives (may need multiple of the same kind)\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      for _ in range(needed_cnt):\n          candidates = np.argwhere(grid[:, :, prim_idx] > 0)\n          if candidates.shape[0] == 0:\n              # No more of this primitive left on the map; abort early\n              return plan_actions\n          dists = np.abs(candidates[:, 0] - pos[0]) + np.abs(candidates[:, 1] - pos[1])\n          target = candidates[dists.argmin()]\n          if not move_and_use(target, prim_idx):\n              return plan_actions\n\n  # ------------------------------------------------------------------\n  # Move to a workshop cell and craft the arrow\n  # ------------------------------------------------------------------\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.shape[0] == 0:\n      # Workshops are static; fall back to original scenario grid\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.shape[0] == 0:\n          return plan_actions\n\n  dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])\n  workshop_target = workshop_cells[dists.argmin()]\n\n  move_and_use(workshop_target, workshop_idx)\n\n  return plan_actions", "env_interactions": 23, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T19:40:29.905936", "function_name": "make_arrow", "function_body": "  # Reset environment and obtain current state\n  try:\n      env.reset()\n  except Exception:\n      pass\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []\n\n  world = env.world\n  idx = world.cookbook.index\n\n  # Target item index for \"arrow\"\n  try:\n      goal_idx = idx[\"arrow\"]\n  except Exception:\n      return []\n\n  # Primitive requirements for ONE arrow\n  needed = world.cookbook.primitives_for(goal_idx)\n\n  # Locate workshop required for crafting the arrow\n  workshop_idx = None\n  for k, v in world.cookbook.recipes.get(goal_idx, {}).items():\n      if k in (\"_at\", \"_key\"):\n          workshop_idx = idx.get(v, None)\n          break\n  if workshop_idx is None:\n      return []\n\n  # ------------------------------------------------------------------\n  # Planning helpers\n  # ------------------------------------------------------------------\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # DOWN, UP, LEFT, RIGHT\n  USE = 4\n  from collections import deque\n\n  def bfs_adjacent(start, target, blocked):\n      \"\"\"Return actions to move from *start* to any free cell adjacent to *target*.\"\"\"\n      h, w = blocked.shape\n      tx, ty = target\n      goals = []\n      for a, (dx, dy) in enumerate(DIRS):\n          gx, gy = tx + dx, ty + dy\n          if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:\n              goals.append((gx, gy))\n      if not goals:\n          return []\n      q = deque([(start, [])])\n      visited = {start}\n      while q:\n          (cx, cy), path = q.popleft()\n          if (cx, cy) in goals:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []\n\n  # ------------------------------------------------------------------\n  # Simulated mutable copies\n  # ------------------------------------------------------------------\n  pos = tuple(state.pos)\n  grid = state.grid.copy()\n  inventory = state.inventory.copy()\n  occupied = np.any(grid > 0, axis=2)  # bool matrix of blocked cells\n  plan = []\n\n  def move_and_use(target, kind_idx):\n      \"\"\"Navigate adjacent to *target*, issue USE, and update simulated state.\"\"\"\n      nonlocal pos, plan, grid, occupied, inventory\n      path = bfs_adjacent(pos, target, occupied)\n      if not path and pos != target:\n          return False\n      for a in path:\n          dx, dy = DIRS[a]", "env_interactions": 0, "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-10-27T19:40:31.041190", "function_name": "make_arrow", "function_body": "  # Reset environment and obtain the current CraftState.\n  try:\n      env.reset()\n  except Exception:\n      pass\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []  # No state available.\n\n  world = env.world\n  idx = world.cookbook.index\n\n  # ------------------------------------------------------------------\n  # Identify the goal item (\"arrow\") and its recipe information.\n  # ------------------------------------------------------------------\n  try:\n      goal_idx = idx[\"arrow\"]\n  except Exception:\n      return []  # Arrow not defined.\n\n  # Primitive (or sub\u2011component) requirements for a single arrow.\n  needed = world.cookbook.primitives_for(goal_idx)\n\n  # Determine the workshop required for crafting the arrow.\n  workshop_idx = None\n  for k, v in world.cookbook.recipes.get(goal_idx, {}).items():\n      if k in (\"_at\", \"_key\"):\n          workshop_idx = idx.get(v, None)\n          break\n  if workshop_idx is None:\n      return []  # No workshop info.\n\n  # ------------------------------------------------------------------\n  # Prepare mutable copies of the world for planning.\n  # ------------------------------------------------------------------\n  pos = tuple(state.pos)                     # (x, y)\n  grid = state.grid.copy()                   # (W, H, n_kinds)\n  inventory = state.inventory.copy()\n  occupied = np.any(grid > 0, axis=2)        # bool matrix of blocked cells\n\n  plan = []                                   # final action list\n\n  # Action constants (match CraftLab.action_specs ordering).\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # DOWN, UP, LEFT, RIGHT\n  USE = 4\n\n  from collections import deque\n\n  # ------------------------------------------------------------------\n  # Helper: BFS to a free cell adjacent to a target cell.\n  # ------------------------------------------------------------------\n  def bfs_adjacent(start, target, blocked):\n      \"\"\"Return a list of actions moving from *start* to any empty cell\n      that is 4\u2011connected to *target*. Empty list if unreachable.\"\"\"\n      h, w = blocked.shape\n      tx, ty = target\n      goal_cells = []\n      for a, (dx, dy) in enumerate(DIRS):\n          gx, gy = tx + dx, ty + dy\n          if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:\n              goal_cells.append((gx, gy))\n      if not goal_cells:\n          return []\n      q = deque([(start, [])])\n      visited = {start}\n      while q:\n          (cx, cy), path = q.popleft()\n          if (cx, cy) in goal_cells:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []\n\n  # ------------------------------------------------------------------\n  # Helper: Move adjacent to *target* containing *kind_idx* and USE it.\n  # Simulate the effect on the planning copies.\n  # ------------------------------------------------------------------\n  def move_and_use(target, kind_idx):\n      \"\"\"Navigate to a free cell next to *target*, issue USE, and update\n      simulated world state. Returns False if movement impossible.\"\"\"\n      nonlocal pos, plan, grid, occupied, inventory\n      path = bfs_adjacent(pos, target, occupied)\n      if not path and pos != target:\n          return False\n      # Execute movement actions.\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n      plan.extend(path)\n\n      # USE action.\n      plan.append(USE)\n\n      tx, ty = target\n      if grid[tx, ty, kind_idx] > 0:\n          grid[tx, ty, kind_idx] = 0\n          occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)\n          inventory[kind_idx] += 1\n      return True\n\n  # ------------------------------------------------------------------\n  # Collect all required primitives/components.\n  # ------------------------------------------------------------------\n  for kind_idx, cnt in needed.items():\n      for _ in range(cnt):\n          locations = np.argwhere(grid[:, :, kind_idx] > 0)\n          if locations.size == 0:\n              # Primitive not present on map \u2013 stop planning.\n              return plan\n          # Choose the nearest instance (Manhattan distance).\n          dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n          target = tuple(locations[dists.argmin()])\n          if not move_and_use(target, kind_idx):\n              return plan\n\n  # ------------------------------------------------------------------\n  # Move to the workshop and craft the arrow.\n  # ------------------------------------------------------------------\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      # Fall back to original scenario grid if workshop was cleared.\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          return plan\n  dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])\n  workshop_target = tuple(workshop_cells[dists.argmin()])\n  move_and_use(workshop_target, workshop_idx)\n\n  return plan", "env_interactions": 0, "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-10-27T19:41:04.064684", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action constants (must match CraftLab.action_specs)\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]  # DOWN, UP, LEFT, RIGHT\n  USE = 4\n\n  def bfs_to_adjacent(start, target, blocked):\n      \"\"\"Return a list of movement actions that brings the agent from *start*\n      to any empty cell that is 4\u2011connected to *target*.\n      If no such path exists, returns an empty list.\"\"\"\n      h, w = blocked.shape\n      goal_cells = []\n      tx, ty = int(target[0]), int(target[1])\n      for a, (dx, dy) in enumerate(DIRS):\n          gx, gy = tx + dx, ty + dy\n          if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:\n              goal_cells.append((gx, gy))\n      if not goal_cells:\n          return []\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (cx, cy), path = q.popleft()\n          if (cx, cy) in goal_cells:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []\n\n  # Reset environment if possible\n  try:\n      env.reset()\n  except Exception:\n      pass\n\n  # Obtain the underlying CraftState\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []\n\n  world = env.world\n  idx = world.cookbook.index\n\n  # Goal item: arrow\n  try:\n      goal_idx = idx[\"arrow\"]\n  except Exception:\n      return []\n\n  # Primitives needed for one arrow\n  primitives_needed = world.cookbook.primitives_for(goal_idx)\n\n  # Workshop required for crafting the arrow\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\") or recipe.get(\"_key\")\n  if workshop_name is None:\n      return []\n  try:\n      workshop_idx = idx[workshop_name]\n  except Exception:\n      return []\n\n  # Local mutable copies of the world state\n  pos = tuple(state.pos)                     # (x, y)\n  grid = state.grid.copy()                   # (W, H, n_kinds)\n  inventory = state.inventory.copy()         # (n_kinds,)\n  occupied = np.any(grid > 0, axis=2)        # bool map of blocked cells\n\n  actions = []\n\n  def move_and_use(target_coord, kind_idx):\n      \"\"\"Move adjacent to *target_coord* (which holds *kind_idx*) and USE.\n      Updates local copies of pos, grid, occupied and inventory.\"\"\"\n      nonlocal pos, actions, grid, occupied, inventory\n      path = bfs_to_adjacent(pos, target_coord, occupied)\n      if not path and pos != target_coord:\n          return False\n      # Execute movement actions\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n      actions.extend(path)\n      # Use action\n      actions.append(USE)\n\n      tx, ty = int(target_coord[0]), int(target_coord[1])\n      if grid[tx, ty, kind_idx] > 0:\n          grid[tx, ty, kind_idx] = 0\n          occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)\n          inventory[kind_idx] += 1\n      return True\n\n  # 1) Collect all required primitives\n  for prim_idx, needed_cnt in primitives_needed.items():\n      for _ in range(needed_cnt):\n          candidates = np.argwhere(grid[:, :, prim_idx] > 0)\n          if candidates.shape[0] == 0:\n              # No more of this primitive available\n              return actions\n          dists = np.abs(candidates[:, 0] - pos[0]) + np.abs(candidates[:, 1] - pos[1])\n          target = candidates[dists.argmin()]\n          if not move_and_use(target, prim_idx):\n              return actions\n\n  # 2) Move to a workshop cell and craft the arrow\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.shape[0] == 0:\n      # Fallback to original grid if the workshop cell was overwritten\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.shape[0] == 0:\n          return actions\n  dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])\n  workshop_target = workshop_cells[dists.argmin()]\n  move_and_use(workshop_target, workshop_idx)\n\n  return actions", "env_interactions": 23, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T19:41:05.191679", "function_name": "make_arrow", "function_body": "  # Action constants \u2013 must match CraftLab.action_specs ordering\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # 0:DOWN, 1:UP, 2:LEFT, 3:RIGHT\n  USE = 4\n\n  from collections import deque\n  import numpy as np\n\n  def bfs_to_adjacent(start, target, blocked):\n      \"\"\"Return a list of movement actions that brings the agent from *start*\n      to any empty cell that is 4\u2011connected to *target*.\n      If no such path exists, returns an empty list.\"\"\"\n      h, w = blocked.shape\n      goal_cells = []\n      tx, ty = int(target[0]), int(target[1])\n      for a, (dx, dy) in enumerate(DIRS):\n          gx, gy = tx + dx, ty + dy\n          if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:\n              goal_cells.append((gx, gy))\n      if not goal_cells:\n          return []\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (cx, cy), path = q.popleft()\n          if (cx, cy) in goal_cells:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []\n\n  # Reset / initialise environment (ignore errors if env does not expose reset)\n  try:\n      env.reset()\n  except Exception:\n      pass\n\n  # Grab the underlying CraftState \u2013 if not present we cannot plan\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []\n\n  world = env.world\n  idx = world.cookbook.index\n\n  # Identify the goal item (arrow) and its recipe\n  try:\n      goal_idx = idx[\"arrow\"]\n  except Exception:\n      return []\n\n  # Primitive requirements for ONE arrow\n  primitives_needed = world.cookbook.primitives_for(goal_idx)\n\n  # Locate the workshop required for crafting the arrow\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\") or recipe.get(\"_key\")\n  if workshop_name is None:\n      return []\n  try:\n      workshop_idx = idx[workshop_name]\n  except Exception:\n      return []\n\n  # Local mutable copies of the world state (so we can simulate actions)\n  pos = tuple(state.pos)                     # current (x, y)\n  grid = state.grid.copy()                   # (W, H, n_kinds)\n  inventory = state.inventory.copy()         # (n_kinds,)\n  occupied = np.any(grid > 0, axis=2)        # bool map of blocked cells\n\n  plan_actions = []\n\n  def move_and_use(target_coord, kind_idx):\n      \"\"\"Move adjacent to *target_coord* (which holds *kind_idx*) and USE.\n      Updates local copies of pos, grid, occupied and inventory.\"\"\"\n      nonlocal pos, plan_actions, grid, occupied, inventory\n      path = bfs_to_adjacent(pos, target_coord, occupied)\n      if not path and pos != target_coord:\n          return False\n      # execute movement actions\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n      plan_actions.extend(path)\n      # use action\n      plan_actions.append(USE)\n\n      tx, ty = int(target_coord[0]), int(target_coord[1])\n      if grid[tx, ty, kind_idx] > 0:\n          grid[tx, ty, kind_idx] = 0\n          occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)\n          inventory[kind_idx] += 1\n      return True\n\n  # 1) Collect all required primitives (may need several of the same kind)\n  for prim_idx, needed_cnt in primitives_needed.items():\n      for _ in range(needed_cnt):\n          # locate all cells that currently contain this primitive\n          candidates = np.argwhere(grid[:, :, prim_idx] > 0)\n          if candidates.shape[0] == 0:\n              # primitive exhausted \u2013 abort early\n              return plan_actions\n          # choose the nearest candidate (Manhattan distance)\n          dists = np.abs(candidates[:, 0] - pos[0]) + np.abs(candidates[:, 1] - pos[1])\n          target = candidates[dists.argmin()]\n          if not move_and_use(target, prim_idx):\n              return plan_actions\n\n  # 2) Move to a workshop cell and craft the arrow\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.shape[0] == 0:\n      # fallback to original grid (in case the workshop cell was overwritten)\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.shape[0] == 0:\n          return plan_actions\n  dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])\n  workshop_target = workshop_cells[dists.argmin()]\n  move_and_use(workshop_target, workshop_idx)\n\n  return plan_actions", "env_interactions": 23, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T19:41:29.334327", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.scenario.world\n  cookbook = world.cookbook\n  index = cookbook.index\n\n  # Action indices\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Identify goal index for \"arrow\"\n  goal_name = \"arrow\"\n  if goal_name not in index.contents:\n      return []\n  goal_idx = index[goal_name]\n\n  # Primitive requirements (including transitive ones)\n  needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n  plan_actions = []\n\n  # Helper: BFS path finder (4\u2011connected) that treats any occupied cell as blocked,\n  # except the target cell itself.\n  def bfs(start, target):\n      h, w = state.grid.shape[:2]\n      occupied = np.any(state.grid > 0, axis=2)\n      occupied[target] = False\n      q = collections.deque([start])\n      came = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          r, c = cur\n          for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nr, nc = r + dr, c + dc\n              if 0 <= nr < h and 0 <= nc < w and not occupied[nr, nc]:\n                  nxt = (nr, nc)\n                  if nxt not in came:\n                      came[nxt] = cur\n                      q.append(nxt)\n      else:\n          return None\n      # reconstruct path\n      path = []\n      cur = target\n      while cur is not None:\n          path.append(cur)\n          cur = came[cur]\n      path.reverse()\n      return path\n\n  # Mapping from movement delta to action index\n  delta2act = {(1, 0): DOWN, (-1, 0): UP, (0, 1): RIGHT, (0, -1): LEFT}\n\n  # Collect each required primitive one by one, preferring the closest instance\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          # Find all remaining cells containing this primitive\n          cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if cells.size == 0:\n              return plan_actions\n\n          # Choose the nearest cell (Manhattan distance) to current position\n          distances = np.abs(cells - np.array(state.pos)).sum(axis=1)\n          nearest_idx = distances.argmin()\n          target = tuple(cells[nearest_idx])\n\n          path = bfs(state.pos, target)\n          if path is None:\n              return plan_actions\n\n          for (r0, c0), (r1, c1) in zip(path, path[1:]):\n              act = delta2act[(r1 - r0, c1 - c0)]\n              plan_actions.append(act)\n              state.pos = (r1, c1)\n\n          # Pick up the primitive\n          plan_actions.append(USE)\n          state.inventory[prim_idx] += 1\n          state.grid[target[0], target[1], prim_idx] = 0\n\n  # Locate the workshop required for crafting the goal\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      return plan_actions\n\n  workshop_idx = index[workshop_name]\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      return plan_actions\n  wpos = tuple(workshop_cells[0])\n\n  path = bfs(state.pos, wpos)\n  if path is None:\n      return plan_actions\n  for (r0, c0), (r1, c1) in zip(path, path[1:]):\n      act = delta2act[(r1 - r0, c1 - c0)]\n      plan_actions.append(act)\n      state.pos = (r1, c1)\n\n  # Craft the arrow at the workshop\n  plan_actions.append(USE)\n\n  return plan_actions", "env_interactions": 24, "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T19:41:30.458779", "function_name": "make_arrow", "function_body": "  # Reset the environment and obtain references to the current state and world objects\n  env.reset()\n  state = env._current_state               # CraftState\n  world = env.scenario.world                # CraftWorld\n  cookbook = world.cookbook                 # Cookbook\n  index = cookbook.index                    # name \u2194 id mapping\n\n  # Action indices as defined in CraftLab\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # -------------------------------------------------------------\n  # Identify the goal item (\"arrow\") and the primitive requirements\n  # -------------------------------------------------------------\n  goal_name = \"arrow\"\n  if goal_name not in index.contents:\n      # Arrow is not part of this world\u2019s recipe set\n      return []\n  goal_idx = index[goal_name]\n\n  # primitives_for returns a dict {primitive_index: count} needed for ONE goal item\n  needed_prims = cookbook.primitives_for(goal_idx)   # may be empty if goal has no recipe\n  plan = []                                            # accumulated action sequence\n\n  # -------------------------------------------------------------\n  # Helper: BFS path\u2011finder (Manhattan moves, 4\u2011connected)\n  # -------------------------------------------------------------\n  def bfs(start, target):\n      \"\"\"Return a list of positions from start to target (inclusive)\n      using 4\u2011connected moves, treating any occupied cell as blocked\n      except the target cell itself. Returns None if unreachable.\"\"\"\n      h, w = state.grid.shape[:2]\n      occupied = np.any(state.grid > 0, axis=2)          # True where any entity is present\n      occupied[target] = False                           # allow stepping onto the target\n      q = collections.deque([start])\n      came_from = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          r, c = cur\n          for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nr, nc = r + dr, c + dc\n              if 0 <= nr < h and 0 <= nc < w and not occupied[nr, nc]:\n                  nxt = (nr, nc)\n                  if nxt not in came_from:\n                      came_from[nxt] = cur\n                      q.append(nxt)\n      else:\n          return None  # target never reached\n\n      # Reconstruct path from start to target\n      path = []\n      cur = target\n      while cur is not None:\n          path.append(cur)\n          cur = came_from[cur]\n      path.reverse()\n      return path\n\n  # Mapping from movement delta to action index\n  delta_to_action = {\n      (1, 0): DOWN,\n      (-1, 0): UP,\n      (0, 1): RIGHT,\n      (0, -1): LEFT,\n  }\n\n  # -------------------------------------------------------------\n  # 1. Collect each required primitive (including multiplicities)\n  # -------------------------------------------------------------\n  for prim_idx, count in needed_prims.items():\n      for _ in range(count):\n          # Locate any remaining instance of the primitive on the map\n          candidates = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if candidates.size == 0:\n              # No more of this primitive; abort planning and return what we have\n              return plan\n          target_r, target_c = candidates[0]   # pick the first occurrence\n\n          # Find a path to the primitive\n          path = bfs(state.pos, (target_r, target_c))\n          if path is None:\n              # Unreachable primitive; abort planning\n              return plan\n\n          # Convert the path into movement actions and update the simulated state\n          for (r0, c0), (r1, c1) in zip(path, path[1:]):\n              act = delta_to_action[(r1 - r0, c1 - c0)]\n              plan.append(act)\n              state.pos = (r1, c1)\n\n          # Use the primitive (pick up)\n          plan.append(USE)\n          state.inventory[prim_idx] += 1\n          state.grid[target_r, target_c, prim_idx] = 0\n\n  # -------------------------------------------------------------\n  # 2. Move to the appropriate workshop and craft the goal item\n  # -------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      # No workshop specified for this recipe\n      return plan\n\n  workshop_idx = index[workshop_name]\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      # No workshop cell present in the current scenario\n      return plan\n  w_r, w_c = workshop_cells[0]\n\n  # Path to the workshop\n  path_to_ws = bfs(state.pos, (w_r, w_c))\n  if path_to_ws is None:\n      # Workshop unreachable\n      return plan\n\n  for (r0, c0), (r1, c1) in zip(path_to_ws, path_to_ws[1:]):\n      act = delta_to_action[(r1 - r0, c1 - c0)]\n      plan.append(act)\n      state.pos = (r1, c1)\n\n  # Craft the arrow at the workshop\n  plan.append(USE)\n\n  return plan", "env_interactions": 28, "island_id": 4, "scores": {"3": 2.0}}
{"timestamp": "2025-10-27T19:41:57.024519", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Reset the environment and get the current state and world information\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world\n  cookbook = world.cookbook\n\n  # Identify the goal (arrow) and its recipe\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n  if goal_idx is None:\n      return []  # unknown goal\n\n  primitive_needs = cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  if \"_at\" in recipe:\n      workshop_idx = cookbook.index[recipe[\"_at\"]]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def bfs_path(start, goal, occupied):\n      \"\"\"Return a list of positions from start (excluded) to goal (included).\"\"\"\n      w, h = occupied.shape\n      visited = np.zeros((w, h), dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start] = True\n      while q:\n          x, y = q.popleft()\n          if (x, y) == goal:\n              break\n          for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):\n              if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:\n                  # Allow stepping onto the goal even if it is occupied\n                  if (nx, ny) == goal or not occupied[nx, ny]:\n                      visited[nx, ny] = True\n                      prev[(nx, ny)] = (x, y)\n                      q.append((nx, ny))\n      if not visited[goal]:\n          return None\n      # reconstruct path\n      path = []\n      cur = goal\n      while cur != start:\n          path.append(cur)\n          cur = prev[cur]\n      path.reverse()\n      return path\n\n  def delta_to_action(dx, dy):\n      \"\"\"Map a movement delta to the corresponding action index.\"\"\"\n      if dx == 1:\n          return 3   # RIGHT\n      if dx == -1:\n          return 2   # LEFT\n      if dy == 1:\n          return 0   # DOWN\n      if dy == -1:\n          return 1   # UP\n      raise ValueError(\"Invalid movement delta\")\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # Work on a mutable copy of the grid to keep track of collected primitives\n  grid = state.grid.copy()\n\n  # ------------------------------------------------------------------\n  # Collect all required primitives\n  # ------------------------------------------------------------------\n  for kind_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          # locate remaining cells containing this primitive\n          locations = np.argwhere(grid[:, :, kind_idx] > 0)\n          if locations.size == 0:\n              break  # no more of this primitive left\n          # order candidates by Manhattan distance from current position\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n          occupied_mask = np.any(grid, axis=2)  # treat all entities as obstacles\n          target = None\n          path = None\n          for idx in order:\n              cand = tuple(locations[idx])\n              p = bfs_path(cur_pos, cand, occupied_mask)\n              if p is not None:\n                  target = cand\n                  path = p\n                  break\n          if path is None:\n              continue  # cannot reach any remaining instance\n          # follow the path\n          for step in path:\n              dx = step[0] - cur_pos[0]\n              dy = step[1] - cur_pos[1]\n              actions.append(delta_to_action(dx, dy))\n              cur_pos = step\n          # pick up the primitive\n          actions.append(4)  # USE\n          grid[target[0], target[1], kind_idx] = 0  # remove from copy\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          dists = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n          occupied_mask = np.any(state.grid, axis=2)  # original occupancy (workshops are occupied)\n          for idx in order:\n              cand = tuple(workshop_cells[idx])\n              p = bfs_path(cur_pos, cand, occupied_mask)\n              if p is not None:\n                  for step in p:\n                      dx = step[0] - cur_pos[0]\n                      dy = step[1] - cur_pos[1]\n                      actions.append(delta_to_action(dx, dy))\n                      cur_pos = step\n                  actions.append(4)  # USE to trigger crafting\n                  break\n  else:\n      # No specific workshop required; craft at current location\n      actions.append(4)  # USE\n\n  return actions", "env_interactions": 26, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T19:41:58.135266", "function_name": "make_arrow", "function_body": "  # Reset env and get state...\n  ...\n  return actions", "env_interactions": 0, "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-10-27T19:42:27.389033", "function_name": "make_arrow", "function_body": "  # Reset the environment and obtain the current state and world objects\n  env.reset()\n  state = env._current_state          # CraftState instance\n  world = env.world\n  cookbook = world.cookbook\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow) and retrieve its recipe information\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n  if goal_idx is None:\n      return []                       # unknown goal\n\n  # Primitive ingredients required (expanded recursively)\n  primitive_needs = cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  if \"_at\" in recipe:\n      workshop_idx = cookbook.index[recipe[\"_at\"]]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  from collections import deque\n  import numpy as np\n\n  def bfs_path(start, goal, occupied):\n      \"\"\"Return a list of positions from start (excluded) to goal (included)\n      moving only through cells where occupied==False.  The goal cell may be\n      occupied (e.g., a resource or workshop).\"\"\"\n      w, h = occupied.shape\n      q = deque([start])\n      visited = np.zeros((w, h), dtype=bool)\n      visited[start] = True\n      prev = {}\n      while q:\n          x, y = q.popleft()\n          if (x, y) == goal:\n              break\n          for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):\n              if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:\n                  if (nx, ny) == goal or not occupied[nx, ny]:\n                      visited[nx, ny] = True\n                      prev[(nx, ny)] = (x, y)\n                      q.append((nx, ny))\n      if not visited[goal]:\n          return None\n      # reconstruct path backwards\n      path = []\n      cur = goal\n      while cur != start:\n          path.append(cur)\n          cur = prev[cur]\n      path.reverse()\n      return path\n\n  def delta_to_action(dx, dy):\n      \"\"\"Convert a movement delta into an action index.\"\"\"\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise ValueError(\"Invalid movement delta\")\n\n  # ------------------------------------------------------------------\n  # Planning: collect primitives, move to workshop, craft\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = tuple(state.pos)          # current (x, y) of the agent\n  grid = state.grid.copy()            # mutable copy to track collected items\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitive items\n  # ------------------------------------------------------------------\n  for kind_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          # Locate remaining cells containing this primitive\n          locations = np.argwhere(grid[:, :, kind_idx] > 0)\n          if locations.size == 0:\n              break\n          # Order candidates by Manhattan distance from current position\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n\n          target = None\n          path = None\n          occupied_mask = np.any(grid, axis=2)   # any entity blocks movement\n          for idx in order:\n              cand = tuple(locations[idx])\n              p = bfs_path(cur_pos, cand, occupied_mask)\n              if p is not None:\n                  target = cand\n                  path = p\n                  break\n          if path is None:\n              continue   # cannot reach any remaining instance\n\n          # Follow the path, emitting movement actions\n          for step in path:\n              dx = step[0] - cur_pos[0]\n              dy = step[1] - cur_pos[1]\n              actions.append(delta_to_action(dx, dy))\n              cur_pos = step\n          # Use action to pick up the primitive\n          actions.append(4)          # USE\n          # Remove the primitive from our mutable copy\n          grid[target[0], target[1], kind_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 2) Move to the required workshop (if any) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size:\n          dists = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n          occupied_mask = np.any(state.grid, axis=2)   # workshops are occupied but reachable\n          for idx in order:\n              target = tuple(workshop_cells[idx])\n              p = bfs_path(cur_pos, target, occupied_mask)\n              if p is not None:\n                  for step in p:\n                      dx = step[0] - cur_pos[0]\n                      dy = step[1] - cur_pos[1]\n                      actions.append(delta_to_action(dx, dy))\n                      cur_pos = step\n                  actions.append(4)   # USE to trigger crafting\n                  break\n  else:\n      # No specific workshop required; craft at current location\n      actions.append(4)   # USE to trigger crafting\n\n  return actions", "env_interactions": 26, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T19:42:28.521861", "function_name": "make_arrow", "function_body": "  # Reset environment and fetch core objects\n  env.reset()\n  state = env._current_state          # CraftState instance\n  world = env.world\n  cookbook = world.cookbook\n\n  # ------------------------------------------------------------------\n  # Identify goal (\"arrow\") and retrieve its recipe information\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n  if goal_idx is None:\n      return []                       # unknown goal\n\n  primitive_needs = cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  if \"_at\" in recipe:\n      workshop_idx = cookbook.index[recipe[\"_at\"]]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  from collections import deque\n  import numpy as np\n\n  def bfs_path(start, goal, occupied):\n      \"\"\"Return a list of positions (excluding start, including goal) that\n      leads from start to goal moving only through cells where occupied==False.\n      The goal cell may be occupied (e.g., a resource or workshop).\"\"\"\n      w, h = occupied.shape\n      visited = np.zeros((w, h), dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start] = True\n      while q:\n          x, y = q.popleft()\n          if (x, y) == goal:\n              break\n          for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):\n              if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:\n                  # Allow stepping onto the goal even if occupied\n                  if (nx, ny) == goal or not occupied[nx, ny]:\n                      visited[nx, ny] = True\n                      prev[(nx, ny)] = (x, y)\n                      q.append((nx, ny))\n      if not visited[goal]:\n          return None\n      # reconstruct path backwards\n      path = []\n      cur = goal\n      while cur != start:\n          path.append(cur)\n          cur = prev[cur]\n      path.reverse()\n      return path\n\n  def delta_to_action(dx, dy):\n      \"\"\"Convert a movement delta into an action index used by the env.\"\"\"\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise ValueError(\"Invalid movement delta\")\n\n  # ------------------------------------------------------------------\n  # Planning: collect primitives, move to workshop, craft\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = tuple(state.pos)          # current (x, y) of the agent\n  grid = state.grid.copy()            # mutable copy to track collected items\n\n  # --------------------------------------------------------------\n  # 1) Collect all required primitive items\n  # --------------------------------------------------------------\n  for kind_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          # Find all remaining cells containing this primitive\n          candidates = np.argwhere(grid[:, :, kind_idx] > 0)\n          if candidates.size == 0:\n              break  # no more of this primitive on the map\n          # Order candidates by Manhattan distance from current position\n          dists = np.abs(candidates[:, 0] - cur_pos[0]) + np.abs(candidates[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n\n          occupied_mask = np.any(grid, axis=2)   # treat any entity as blocked\n          target = None\n          path = None\n          for idx in order:\n              cand = tuple(candidates[idx])\n              path = bfs_path(cur_pos, cand, occupied_mask)\n              if path is not None:\n                  target = cand\n                  break\n          if target is None:\n              continue   # could not reach any remaining instance\n\n          # Follow the path, emitting movement actions\n          for step in path:\n              dx = step[0] - cur_pos[0]\n              dy = step[1] - cur_pos[1]\n              actions.append(delta_to_action(dx, dy))\n              cur_pos = step\n          # Use action to pick up the primitive\n          actions.append(4)          # USE\n          # Remove the primitive from our mutable copy\n          grid[target[0], target[1], kind_idx] = 0\n\n  # --------------------------------------------------------------\n  # 2) Move to the required workshop (if any) and craft the arrow\n  # --------------------------------------------------------------\n  if workshop_idx is not None:\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          dists = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n          occupied_mask = np.any(state.grid, axis=2)   # workshops are occupied but reachable\n          for idx in order:\n              target = tuple(workshop_cells[idx])\n              path = bfs_path(cur_pos, target, occupied_mask)\n              if path is not None:\n                  for step in path:\n                      dx = step[0] - cur_pos[0]\n                      dy = step[1] - cur_pos[1]\n                      actions.append(delta_to_action(dx, dy))\n                      cur_pos = step\n                  actions.append(4)   # USE to trigger crafting\n                  break\n  else:\n      # No specific workshop required; craft at current location\n      actions.append(4)   # USE to trigger crafting\n\n  return actions", "env_interactions": 26, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T19:42:59.547472", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action mapping (matches CraftLab.action_specs ordering)\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # 0:DOWN, 1:UP, 2:LEFT, 3:RIGHT\n  USE = 4\n\n  def bfs_to_adjacent(start, target, blocked):\n      \"\"\"Return a list of movement actions that brings the agent from *start*\n      to any empty cell that is 4\u2011connected to *target*.\n      If no such path exists, returns an empty list.\"\"\"\n      h, w = blocked.shape\n      goal_cells = []\n      tx, ty = int(target[0]), int(target[1])\n      for a, (dx, dy) in enumerate(DIRS):\n          gx, gy = tx + dx, ty + dy\n          if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:\n              goal_cells.append((gx, gy))\n      if not goal_cells:\n          return []\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (cx, cy), path = q.popleft()\n          if (cx, cy) in goal_cells:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []\n\n  # Reset / initialise environment\n  try:\n      env.reset()\n  except Exception:\n      pass\n\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []\n\n  world = env.world\n  idx = world.cookbook.index\n\n  # Identify goal (arrow) and its recipe\n  try:\n      arrow_idx = idx[\"arrow\"]\n  except Exception:\n      return []\n\n  primitives_needed = world.cookbook.primitives_for(arrow_idx)\n\n  recipe_dict = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = None\n  for k, v in recipe_dict.items():\n      if k == \"_at\" or k == \"_key\":\n          workshop_name = v\n          break\n  if workshop_name is None:\n      return []\n\n  try:\n      workshop_idx = idx[workshop_name]\n  except Exception:\n      return []\n\n  # Local mutable copies of the simulation state\n  pos = tuple(state.pos)\n  grid = state.grid.copy()\n  inventory = state.inventory.copy()\n  occupied = np.any(grid > 0, axis=2)\n\n  plan_actions = []\n\n  def move_and_use(target_coord, kind_idx):\n      \"\"\"Move adjacent to *target_coord* (which contains *kind_idx*) and USE.\n      Updates the local simulation snapshot.\"\"\"\n      nonlocal pos, plan_actions, grid, occupied, inventory\n      path = bfs_to_adjacent(pos, target_coord, occupied)\n      if not path and pos != target_coord:\n          return False\n      # Execute movement\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n      plan_actions.extend(path)\n      # Use action\n      plan_actions.append(USE)\n      tx, ty = int(target_coord[0]), int(target_coord[1])\n      if grid[tx, ty, kind_idx] > 0:\n          # Pick up the item (or trigger workshop)\n          grid[tx, ty, kind_idx] = 0\n          occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)\n          inventory[kind_idx] += 1\n      return True\n\n  # ------------------------------------------------------------\n  # 1) Collect all required primitive items\n  # ------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      for _ in range(needed_cnt):\n          # Locate the nearest remaining primitive of this type\n          candidates = np.argwhere(grid[:, :, prim_idx] > 0)\n          if candidates.shape[0] == 0:\n              # No more items of this primitive; abort early\n              return plan_actions\n          dists = np.abs(candidates[:, 0] - pos[0]) + np.abs(candidates[:, 1] - pos[1])\n          target = candidates[dists.argmin()]\n          if not move_and_use(target, prim_idx):\n              return plan_actions\n\n  # ------------------------------------------------------------\n  # 2) Go to the workshop and craft the arrow\n  # ------------------------------------------------------------\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.shape[0] == 0:\n      # Fallback to original grid if the workshop was never modified\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.shape[0] == 0:\n          return plan_actions\n  dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])\n  workshop_target = workshop_cells[dists.argmin()]\n  move_and_use(workshop_target, workshop_idx)\n\n  return plan_actions", "env_interactions": 23, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T19:43:00.674201", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action mapping (matches CraftLab.action_specs ordering)\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # 0:DOWN, 1:UP, 2:LEFT, 3:RIGHT\n  USE = 4\n\n  def bfs_to_adjacent(start, target, blocked):\n      \"\"\"Return a list of movement actions that brings the agent from *start*\n      to any empty cell that is 4\u2011connected to *target*.\n      If no such path exists, returns an empty list.\"\"\"\n      h, w = blocked.shape\n      goal_cells = []\n      tx, ty = int(target[0]), int(target[1])\n      for a, (dx, dy) in enumerate(DIRS):\n          gx, gy = tx + dx, ty + dy\n          if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:\n              goal_cells.append((gx, gy))\n      if not goal_cells:\n          return []\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (cx, cy), path = q.popleft()\n          if (cx, cy) in goal_cells:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []\n\n  # Reset / initialise environment\n  try:\n      env.reset()\n  except Exception:\n      pass\n\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []\n\n  world = env.world\n  idx = world.cookbook.index\n\n  # Identify goal (arrow) and its recipe\n  try:\n      arrow_idx = idx[\"arrow\"]\n  except Exception:\n      return []\n\n  primitives_needed = world.cookbook.primitives_for(arrow_idx)\n\n  # Find the workshop required for the arrow recipe\n  recipe_dict = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = None\n  for k, v in recipe_dict.items():\n      if k in (\"_at\", \"_key\"):\n          workshop_name = v\n          break\n  if workshop_name is None:\n      return []\n\n  try:\n      workshop_idx = idx[workshop_name]\n  except Exception:\n      return []\n\n  # Local mutable copies of the state\n  pos = tuple(state.pos)\n  grid = state.grid.copy()\n  inventory = state.inventory.copy()\n  occupied = np.any(grid > 0, axis=2)\n\n  plan_actions = []\n\n  def move_and_use(target_coord, kind_idx):\n      \"\"\"Move next to *target_coord* (which contains *kind_idx*) and USE.\n      Updates the local simulation state.\"\"\"\n      nonlocal pos, plan_actions, grid, occupied, inventory\n      path = bfs_to_adjacent(pos, target_coord, occupied)\n      if not path and pos != target_coord:\n          return False\n      # Execute movement actions\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n      plan_actions.extend(path)\n      # Use action\n      plan_actions.append(USE)\n      tx, ty = int(target_coord[0]), int(target_coord[1])\n      if grid[tx, ty, kind_idx] > 0:\n          grid[tx, ty, kind_idx] = 0\n          occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)\n          inventory[kind_idx] += 1\n      return True\n\n  # Collect all required primitives\n  for prim_idx, needed_cnt in primitives_needed.items():\n      for _ in range(needed_cnt):\n          candidates = np.argwhere(grid[:, :, prim_idx] > 0)\n          if candidates.shape[0] == 0:\n              # No more of this primitive on the map; abort early\n              return plan_actions\n          dists = np.abs(candidates[:, 0] - pos[0]) + np.abs(candidates[:, 1] - pos[1])\n          target = candidates[dists.argmin()]\n          if not move_and_use(target, prim_idx):\n              return plan_actions\n\n  # Move to the workshop and craft the arrow\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.shape[0] == 0:\n      # Fallback to original grid if the workshop cell has become empty\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.shape[0] == 0:\n          return plan_actions\n  dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])\n  workshop_target = workshop_cells[dists.argmin()]\n  move_and_use(workshop_target, workshop_idx)\n\n  return plan_actions", "env_interactions": 23, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T19:43:18.922324", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action indices (consistent with CraftWorld)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, 1, RIGHT), (0, -1, LEFT)]\n\n  world = env.world\n  idx_arrow = world.cookbook.index.index('arrow')\n  # primitives needed to craft one arrow: {prim_idx: count}\n  needed = world.cookbook.primitives_for(idx_arrow)\n\n  # Current mutable state while planning\n  cur_pos = env._current_state.pos\n  grid = env._current_state.grid.copy()\n  actions = []\n\n  def bfs(start, goal):\n      \"\"\"Return list of actions from start to goal avoiding occupied cells.\n      Cells that have any entity (grid[..., :].sum() > 0) are treated as obstacles,\n      except the goal cell itself.\"\"\"\n      if start == goal:\n          return []\n      H, W = grid.shape[:2]\n      visited = np.zeros((H, W), dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start] = True\n      while q:\n          x, y = q.popleft()\n          for dx, dy, act in DIRS:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < H and 0 <= ny < W and not visited[nx, ny]:\n                  # Allow stepping onto goal even if occupied\n                  if (nx, ny) != goal and grid[nx, ny, :].sum() > 0:\n                      continue\n                  visited[nx, ny] = True\n                  prev[(nx, ny)] = ((x, y), act)\n                  if (nx, ny) == goal:\n                      # reconstruct path\n                      path = []\n                      cur = goal\n                      while cur != start:\n                          (p, a) = prev[cur]\n                          path.append(a)\n                          cur = p\n                      path.reverse()\n                      return path\n                  q.append((nx, ny))\n      return None  # unreachable\n\n  def nearest_entity(pos, kind_idx):\n      \"\"\"Find nearest cell containing kind_idx using BFS distance.\n      Returns (location, path) where path moves from pos to location.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      best_path = None\n      best_loc = None\n      for loc in locations:\n          loc_tup = (int(loc[0]), int(loc[1]))\n          path = bfs(pos, loc_tup)\n          if path is None:\n              continue\n          if best_path is None or len(path) < len(best_path):\n              best_path = path\n              best_loc = loc_tup\n      return best_loc, best_path\n\n  # ------------------------------------------------------------------\n  # Collect all required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target, path = nearest_entity(cur_pos, prim_idx)\n          if target is None:\n              # primitive not reachable \u2013 abort planning\n              return actions\n          actions.extend(path)\n          actions.append(USE)          # pick up the primitive\n          cur_pos = target\n          # update planning grid: remove one instance of the primitive\n          if grid[target[0], target[1], prim_idx] > 0:\n              grid[target[0], target[1], prim_idx] -= 1\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if recipe specifies one) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(idx_arrow, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos, path = nearest_entity(cur_pos, workshop_idx)\n      if workshop_pos is not None:\n          actions.extend(path)\n          actions.append(USE)      # craft at the workshop\n          cur_pos = workshop_pos\n\n  return actions", "env_interactions": 26, "island_id": 0, "scores": {"3": 0.0}}
