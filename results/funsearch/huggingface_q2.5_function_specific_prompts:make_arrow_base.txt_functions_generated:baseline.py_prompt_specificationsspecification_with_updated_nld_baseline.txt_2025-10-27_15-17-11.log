{"timestamp": "2025-10-27T19:02:23.920581", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.scenario.world\n  cookbook = world.cookbook\n  index = cookbook.index\n\n  # Action identifiers\n  act_spec = env.action_specs()\n  DOWN = act_spec[\"DOWN\"]\n  UP = act_spec[\"UP\"]\n  LEFT = act_spec[\"LEFT\"]\n  RIGHT = act_spec[\"RIGHT\"]\n  USE = act_spec[\"USE\"]\n\n  actions = []\n\n  # Goal item\n  goal_name = \"arrow\"\n  if goal_name not in index.contents:\n      return actions\n  goal_idx = index[goal_name]\n\n  # Primitive requirements for the goal\n  primitive_needs = cookbook.primitives_for(goal_idx)\n\n  from collections import deque\n\n  # (action, (dr, dc))\n  move_dirs = [\n      (DOWN, (1, 0)),\n      (UP, (-1, 0)),\n      (LEFT, (0, -1)),\n      (RIGHT, (0, 1)),\n  ]\n\n  def bfs_path(start, target):\n      \"\"\"Return list of move actions to reach `target` from `start`.\"\"\"\n      if start == target:\n          return []\n      h, w = state.grid.shape[:2]\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          for act, (dr, dc) in move_dirs:\n              nr, nc = cur[0] + dr, cur[1] + dc\n              if not (0 <= nr < h and 0 <= nc < w):\n                  continue\n              nxt = (nr, nc)\n              if nxt in visited:\n                  continue\n              # cannot step through occupied cells unless it's the target\n              if nxt != target and state.grid[nr, nc, :].any():\n                  continue\n              visited.add(nxt)\n              parent[nxt] = (cur, act)\n              q.append(nxt)\n\n      if target not in parent and start != target:\n          return []  # unreachable\n\n      # reconstruct path\n      path = []\n      cur = target\n      while cur != start:\n          prev, act = parent[cur]\n          path.append(act)\n          cur = prev\n      path.reverse()\n      return path\n\n  def nearest_cell(start, kind_idx):\n      \"\"\"Find the nearest cell containing `kind_idx`. Return (path, cell).\"\"\"\n      if state.grid[start[0], start[1], kind_idx] > 0:\n          return [], start\n      h, w = state.grid.shape[:2]\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          cur = q.popleft()\n          for act, (dr, dc) in move_dirs:\n              nr, nc = cur[0] + dr, cur[1] + dc\n              if not (0 <= nr < h and 0 <= nc < w):\n                  continue\n              nxt = (nr, nc)\n              if nxt in visited:\n                  continue\n              # block occupied cells unless they contain the desired kind\n              if state.grid[nr, nc, :].any() and state.grid[nr, nc, kind_idx] == 0:\n                  continue\n              visited.add(nxt)\n              parent[nxt] = (cur, act)\n              if state.grid[nr, nc, kind_idx] > 0:\n                  # reconstruct path to this cell\n                  path = []\n                  cur2 = nxt\n                  while cur2 != start:\n                      prev2, act2 = parent[cur2]\n                      path.append(act2)\n                      cur2 = prev2\n                  path.reverse()\n                  return path, nxt\n              q.append(nxt)\n      return [], None\n\n  # 1. Collect required primitives\n  for prim_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          path, cell = nearest_cell(state.pos, prim_idx)\n          if cell is None:\n              return actions  # primitive not reachable\n          actions.extend(path)\n          state.pos = cell\n          actions.append(USE)  # pick up\n          state.inventory[prim_idx] += 1\n          state.grid[cell[0], cell[1], prim_idx] = 0\n\n  # 2. Move to workshop and craft the goal item\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      return actions\n  workshop_idx = index[workshop_name]\n  path, cell = nearest_cell(state.pos, workshop_idx)\n  if cell is None:\n      return actions  # workshop not reachable\n  actions.extend(path)\n  state.pos = cell\n  actions.append(USE)  # craft\n\n  return actions", "env_interactions": 26, "island_id": 1, "scores": {"3": 1.5}}
