{"timestamp": "2025-10-27T19:04:53.859718", "function_name": "make_arrow", "function_body": "  # Reset the environment and obtain the current state\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world\n  cookbook = world.cookbook\n\n  # Identify the target item (\"arrow\") and its recipe\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n  if goal_idx is None:\n      return []                       # unknown goal\n\n  primitive_needs = cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  if \"_at\" in recipe:\n      workshop_idx = cookbook.index[recipe[\"_at\"]]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  from collections import deque\n  import numpy as np\n\n  def bfs_path(start, goal, occupied):\n      \"\"\"Return a list of positions (excluding start, including goal) that\n      navigates from ``start`` to ``goal`` moving only through cells where\n      ``occupied`` is False. The goal cell may be occupied.\"\"\"\n      w, h = occupied.shape\n      visited = np.zeros((w, h), dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start] = True\n      while q:\n          x, y = q.popleft()\n          if (x, y) == goal:\n              break\n          for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):\n              if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:\n                  # Allow stepping onto the goal even if it is occupied\n                  if (nx, ny) == goal or not occupied[nx, ny]:\n                      visited[nx, ny] = True\n                      prev[(nx, ny)] = (x, y)\n                      q.append((nx, ny))\n      if not visited[goal]:\n          return None\n      # Reconstruct path (exclude start, include goal)\n      path = []\n      cur = goal\n      while cur != start:\n          path.append(cur)\n          cur = prev[cur]\n      path.reverse()\n      return path\n\n  def delta_to_action(dx, dy):\n      \"\"\"Map a movement delta to the corresponding action index.\"\"\"\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise ValueError(\"Invalid movement delta\")\n\n  # ------------------------------------------------------------------\n  # Planning: collect primitives then craft at the required workshop\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = tuple(state.pos)          # current (x, y)\n  grid = state.grid.copy()            # mutable copy to track collected items\n\n  # ------------------------------------------------------------------\n  # 1) Gather all required primitive resources\n  # ------------------------------------------------------------------\n  for kind_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          # Find all remaining cells containing this primitive\n          locations = np.argwhere(grid[:, :, kind_idx] > 0)\n          if locations.size == 0:\n              break  # no more of this primitive on the map\n          # Sort by Manhattan distance from current position\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n\n          occupied_mask = np.any(grid, axis=2)   # treat any entity as blocked\n          target = None\n          path = None\n          for idx in order:\n              cand = tuple(locations[idx])\n              p = bfs_path(cur_pos, cand, occupied_mask)\n              if p is not None:\n                  target = cand\n                  path = p\n                  break\n          if target is None:\n              # Could not reach any remaining instance; skip this primitive\n              continue\n\n          # Follow the path, emitting movement actions\n          for step in path:\n              dx = step[0] - cur_pos[0]\n              dy = step[1] - cur_pos[1]\n              actions.append(delta_to_action(dx, dy))\n              cur_pos = step\n          # Pick up the primitive\n          actions.append(4)          # USE\n          grid[target[0], target[1], kind_idx] = 0   # mark as collected\n\n  # ------------------------------------------------------------------\n  # 2) Move to workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size:\n          dists = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n          occupied_mask = np.any(state.grid, axis=2)   # original occupancy (workshops block)\n          for idx in order:\n              cand = tuple(workshop_cells[idx])\n              p = bfs_path(cur_pos, cand, occupied_mask)\n              if p is not None:\n                  for step in p:\n                      dx = step[0] - cur_pos[0]\n                      dy = step[1] - cur_pos[1]\n                      actions.append(delta_to_action(dx, dy))\n                      cur_pos = step\n                  actions.append(4)   # USE to trigger crafting\n                  break\n  else:\n      # No specific workshop; use current cell to craft\n      actions.append(4)\n\n  return actions", "env_interactions": 26, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T19:04:54.993655", "function_name": "make_arrow", "function_body": "  # Reset environment and obtain current state/world information\n  env.reset()\n  state = env._current_state          # CraftState instance\n  world = env.world\n  cookbook = world.cookbook\n\n  # ----------------------------------------------------------------------\n  # Identify goal (arrow) and its recipe\n  # ----------------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n  if goal_idx is None:\n      return []                       # unknown goal, nothing to do\n\n  # Primitives required to craft one arrow\n  primitive_needs = cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  if \"_at\" in recipe:\n      workshop_idx = cookbook.index[recipe[\"_at\"]]\n\n  # ----------------------------------------------------------------------\n  # Helper utilities\n  # ----------------------------------------------------------------------\n  from collections import deque\n  import numpy as np\n\n  def bfs_path(start, goal, occupied):\n      \"\"\"Return a list of positions from start (excluded) to goal (included)\n      moving only through cells where `occupied` is False. Goal cell may be occupied.\"\"\"\n      w, h = occupied.shape\n      visited = np.zeros((w, h), dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start] = True\n      while q:\n          x, y = q.popleft()\n          if (x, y) == goal:\n              break\n          for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):\n              if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:\n                  # Goal cell may be occupied; treat it as walkable.\n                  if (nx, ny) == goal or not occupied[nx, ny]:\n                      visited[nx, ny] = True\n                      prev[(nx, ny)] = (x, y)\n                      q.append((nx, ny))\n      if not visited[goal]:\n          return None\n      # Reconstruct path (exclude start, include goal)\n      path = []\n      cur = goal\n      while cur != start:\n          path.append(cur)\n          cur = prev[cur]\n      path.reverse()\n      return path\n\n  def delta_to_action(dx, dy):\n      \"\"\"Map a movement delta to the environment's action index.\"\"\"\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise ValueError(\"Invalid movement delta\")\n\n  actions = []\n  cur_pos = tuple(state.pos)          # current (x, y)\n  grid = state.grid.copy()            # mutable copy to track collected items\n\n  # ----------------------------------------------------------------------\n  # 1) Collect all required primitive resources\n  # ----------------------------------------------------------------------\n  for kind_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          # Locate remaining cells containing this primitive\n          locations = np.argwhere(grid[:, :, kind_idx] > 0)\n          if locations.size == 0:\n              break  # no more of this primitive on the map\n          # Order candidates by Manhattan distance from current position\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n\n          occupied_mask = np.any(grid, axis=2)   # any entity blocks movement\n          target = None\n          path = None\n          for idx in order:\n              cand = tuple(locations[idx])\n              p = bfs_path(cur_pos, cand, occupied_mask)\n              if p is not None:\n                  target = cand\n                  path = p\n                  break\n          if target is None:\n              # Could not reach any remaining instance; abort this primitive\n              continue\n\n          # Follow the path, emitting movement actions\n          for step in path:\n              dx = step[0] - cur_pos[0]\n              dy = step[1] - cur_pos[1]\n              actions.append(delta_to_action(dx, dy))\n              cur_pos = step\n          # Pick up the primitive\n          actions.append(4)          # USE\n          grid[target[0], target[1], kind_idx] = 0   # mark as collected\n\n  # ----------------------------------------------------------------------\n  # 2) Move to workshop (if required) and craft the arrow\n  # ----------------------------------------------------------------------\n  if workshop_idx is not None:\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size:\n          dists = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n          occupied_mask = np.any(state.grid, axis=2)   # original occupancy (workshops block)\n          for idx in order:\n              cand = tuple(workshop_cells[idx])\n              p = bfs_path(cur_pos, cand, occupied_mask)\n              if p is not None:\n                  for step in p:\n                      dx = step[0] - cur_pos[0]\n                      dy = step[1] - cur_pos[1]\n                      actions.append(delta_to_action(dx, dy))\n                      cur_pos = step\n                  actions.append(4)   # USE at workshop to craft\n                  break\n  else:\n      # No specific workshop required; simply use current cell to craft\n      actions.append(4)\n\n  return actions", "env_interactions": 26, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T19:05:13.778793", "function_name": "make_arrow", "function_body": "  try:\n      env.reset()\n  except Exception:\n      pass\n  # get goal index\n  goal_idx = None\n  if hasattr(env, \"task\"):\n      task = getattr(env, \"task\")\n      if hasattr(task, \"goal\"):\n          goal_idx = task.goal\n  if goal_idx is None:\n      return []\n  # action map\n  act = env.action_specs()\n  DOWN = act.get(\"DOWN\", 0)\n  UP = act.get(\"UP\", 1)\n  LEFT = act.get(\"LEFT\", 2)\n  RIGHT = act.get(\"RIGHT\", 3)\n  USE = act.get(\"USE\", 4)\n  # current position mutable\n  cur_pos = list(env._current_state.pos)\n  def move_to(target):\n      tx, ty = target\n      moves = []\n      while cur_pos[0] < tx:\n          moves.append(RIGHT); cur_pos[0] += 1\n      while cur_pos[0] > tx:\n          moves.append(LEFT); cur_pos[0] -= 1\n      while cur_pos[1] < ty:\n          moves.append(DOWN); cur_pos[1] += 1\n      while cur_pos[1] > ty:\n          moves.append(UP); cur_pos[1] -= 1\n      return moves\n  import numpy as np\n  grid = env._current_state.grid.copy()\n  plan = []\n  # collect primitives\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)\n  for kind, cnt in primitives_needed.items():\n      needed = cnt\n      while needed > 0:\n          positions = np.argwhere(grid[:, :, kind] > 0)\n          if positions.size == 0:\n              break\n          dists = np.abs(positions[:,0]-cur_pos[0]) + np.abs(positions[:,1]-cur_pos[1])\n          idx = int(dists.argmin())\n          target = tuple(positions[idx])\n          plan.extend(move_to(target))\n          plan.append(USE)\n          grid[target[0], target[1], kind] = 0\n          needed -= 1\n  # go to workshop if required\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop = recipe.get(\"_at\")\n  if workshop is not None:\n      ws_pos = np.argwhere(grid[:, :, workshop] > 0)\n      if ws_pos.shape[0] > 0:\n          dists = np.abs(ws_pos[:,0]-cur_pos[0]) + np.abs(ws_pos[:,1]-cur_pos[1])\n          idx = int(dists.argmin())\n          target = tuple(ws_pos[idx])\n          plan.extend(move_to(target))\n  plan.append(USE)\n  return plan", "env_interactions": 1, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T19:05:14.907495", "function_name": "make_arrow", "function_body": "  # Reset environment (ignore errors if already reset)\n  try:\n      env.reset()\n  except Exception:\n      pass\n\n  # ----------------------------------------------------------------------\n  # Identify the goal item index\n  # ----------------------------------------------------------------------\n  goal_idx = None\n  if hasattr(env, \"task\"):\n      task = getattr(env, \"task\")\n      if hasattr(task, \"goal\"):\n          goal_idx = task.goal\n      elif isinstance(task, (list, tuple)):\n          goal_idx = task[0]\n  if goal_idx is None:\n      return []  # cannot determine goal\n\n  # ----------------------------------------------------------------------\n  # Action indices (consistent with CraftLab.action_specs)\n  # ----------------------------------------------------------------------\n  action_map = env.action_specs()\n  DOWN = action_map.get(\"DOWN\", 0)\n  UP = action_map.get(\"UP\", 1)\n  LEFT = action_map.get(\"LEFT\", 2)\n  RIGHT = action_map.get(\"RIGHT\", 3)\n  USE = action_map.get(\"USE\", 4)\n\n  # ----------------------------------------------------------------------\n  # Helper: generate Manhattan moves from current position to target\n  # ----------------------------------------------------------------------\n  cur_pos = list(env._current_state.pos)          # mutable [x, y]\n\n  def move_to(target):\n      tx, ty = target\n      moves = []\n      # X\u2011direction moves\n      while cur_pos[0] < tx:\n          moves.append(RIGHT)\n          cur_pos[0] += 1\n      while cur_pos[0] > tx:\n          moves.append(LEFT)\n          cur_pos[0] -= 1\n      # Y\u2011direction moves\n      while cur_pos[1] < ty:\n          moves.append(DOWN)\n          cur_pos[1] += 1\n      while cur_pos[1] > ty:\n          moves.append(UP)\n          cur_pos[1] -= 1\n      return moves\n\n  # ----------------------------------------------------------------------\n  # Planning \u2013 copy grid so we can simulate pickups\n  # ----------------------------------------------------------------------\n  import numpy as np\n  grid = env._current_state.grid.copy()   # shape (W, H, n_kinds)\n  plan = []\n\n  # ----------------------------------------------------------------------\n  # Gather required primitives (flattened by cookbook)\n  # ----------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)\n  for kind_idx, count_needed in primitives_needed.items():\n      remaining = count_needed\n      while remaining > 0:\n          # Find all cells containing this primitive\n          positions = np.argwhere(grid[:, :, kind_idx] > 0)\n          if positions.size == 0:\n              # No more of this primitive on the map \u2013 abort collection\n              break\n          # Choose the nearest instance (Manhattan distance)\n          dists = np.abs(positions[:, 0] - cur_pos[0]) + np.abs(positions[:, 1] - cur_pos[1])\n          nearest = int(dists.argmin())\n          target = tuple(positions[nearest])\n          # Move to the primitive and pick it up\n          plan.extend(move_to(target))\n          plan.append(USE)\n          # Simulate the pickup so we don't revisit this cell\n          grid[target[0], target[1], kind_idx] = 0\n          remaining -= 1\n\n  # ----------------------------------------------------------------------\n  # Move to the appropriate workshop (if required) and craft\n  # ----------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      ws_positions = np.argwhere(grid[:, :, workshop_kind] > 0)\n      if ws_positions.shape[0] > 0:\n          dists = np.abs(ws_positions[:, 0] - cur_pos[0]) + np.abs(ws_positions[:, 1] - cur_pos[1])\n          nearest_ws = int(dists.argmin())\n          ws_target = tuple(ws_positions[nearest_ws])\n          plan.extend(move_to(ws_target))\n\n  # Final USE to trigger crafting at the current location\n  plan.append(USE)\n\n  return plan", "env_interactions": 1, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T19:05:46.241502", "function_name": "make_arrow", "function_body": "  # Reset environment and obtain initial state\n  env.reset()\n  state = env._current_state\n\n  # -------------------------------------------------------------------------\n  # Determine the index of the goal item (\"arrow\")\n  # -------------------------------------------------------------------------\n  if hasattr(env, \"task\") and hasattr(env.task, \"goal\"):\n      goal_idx = env.task.goal\n  else:\n      goal_idx = env.world.cookbook.index.get(\"arrow\")\n      if goal_idx is None:\n          raise ValueError(\"Goal 'arrow' not found in cookbook\")\n\n  # -------------------------------------------------------------------------\n  # Action specifications\n  # -------------------------------------------------------------------------\n  act_spec = env.action_specs()\n  ACT_DOWN = act_spec[\"DOWN\"]\n  ACT_UP = act_spec[\"UP\"]\n  ACT_LEFT = act_spec[\"LEFT\"]\n  ACT_RIGHT = act_spec[\"RIGHT\"]\n  ACT_USE = act_spec[\"USE\"]\n\n  delta_to_act = {\n      (1, 0): ACT_DOWN,\n      (-1, 0): ACT_UP,\n      (0, 1): ACT_RIGHT,\n      (0, -1): ACT_LEFT,\n  }\n\n  actions = []\n\n  # -------------------------------------------------------------------------\n  # Helper: BFS to compute a short path (as actions) between two positions,\n  # allowing stepping onto the goal cell even if occupied.\n  # -------------------------------------------------------------------------\n  def bfs_path(start, goal):\n      from collections import deque\n\n      h, w, _ = state.grid.shape\n      visited = np.full((h, w), False, dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start] = True\n\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          y, x = cur\n          for dy, dx in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < h and 0 <= nx < w and not visited[ny, nx]:\n                  # Allow moving onto the goal even if something occupies it\n                  if not state.grid[ny, nx, :].any() or (ny, nx) == goal:\n                      visited[ny, nx] = True\n                      prev[(ny, nx)] = (y, x)\n                      q.append((ny, nx))\n\n      if goal not in prev and start != goal:\n          return []  # no path found\n\n      # reconstruct actions\n      cur = goal\n      path_actions = []\n      while cur != start:\n          p = prev[cur]\n          dy, dx = cur[0] - p[0], cur[1] - p[1]\n          path_actions.append(delta_to_act[(dy, dx)])\n          cur = p\n      path_actions.reverse()\n      return path_actions\n\n  # -------------------------------------------------------------------------\n  # Helper: move the agent to a target cell using the BFS planner.\n  # -------------------------------------------------------------------------\n  def move_to(target):\n      nonlocal state, actions\n      while state.pos != target:\n          step_actions = bfs_path(state.pos, target)\n          if not step_actions:  # unreachable\n              break\n          for a in step_actions:\n              actions.append(a)\n              _, _, _ = env.step(a)\n              state = env._current_state\n              if state.pos == target:\n                  break\n\n  # -------------------------------------------------------------------------\n  # Helper: locate the nearest cell containing a specific kind index.\n  # -------------------------------------------------------------------------\n  def find_nearest(kind_idx):\n      grid = state.grid\n      h, w, _ = grid.shape\n      py, px = state.pos\n      best = None\n      best_dist = None\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  d = abs(i - py) + abs(j - px)\n                  if best_dist is None or d < best_dist:\n                      best_dist = d\n                      best = (i, j)\n      return best\n\n  # -------------------------------------------------------------------------\n  # Helper: pick a free cell adjacent (including diagonals) to a given cell.\n  # Prefer the cell itself if it is free.\n  # -------------------------------------------------------------------------\n  def adjacent_free(cell):\n      y, x = cell\n      h, w, _ = state.grid.shape\n      if not state.grid[y, x, :].any():\n          return (y, x)\n      for dy in (-1, 0, 1):\n          for dx in (-1, 0, 1):\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < h and 0 <= nx < w:\n                  if not state.grid[ny, nx, :].any():\n                      return (ny, nx)\n      # fallback: stay where we are\n      return state.pos\n\n  # -------------------------------------------------------------------------\n  # Collect all primitive resources required for the arrow.\n  # -------------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  for kind_idx, count in primitives_needed.items():\n      for _ in range(count):\n          src = find_nearest(kind_idx)\n          if src is None:\n              # Primitive not present; abort collection for this item\n              continue\n          adj = adjacent_free(src)\n          move_to(adj)\n          actions.append(ACT_USE)\n          _, _, _ = env.step(ACT_USE)\n          state = env._current_state\n\n  # -------------------------------------------------------------------------\n  # Move to the workshop (if specified) and craft the arrow.\n  # -------------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      ws_pos = find_nearest(workshop_idx)\n      if ws_pos:\n          adj = adjacent_free(ws_pos)\n          move_to(adj)\n  # Use the craft action at current location (or adjacent to workshop)\n  actions.append(ACT_USE)\n  _, _, _ = env.step(ACT_USE)\n  state = env._current_state\n\n  return actions", "env_interactions": 1, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T19:05:47.372098", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n\n  # Determine the goal index for the arrow item\n  if hasattr(env, \"task\") and hasattr(env.task, \"goal\"):\n      goal_idx = env.task.goal\n  else:\n      goal_idx = env.world.cookbook.index.get(\"arrow\")\n      if goal_idx is None:\n          raise ValueError(\"Arrow goal not found in the cookbook\")\n\n  # Action specifications\n  act_spec = env.action_specs()\n  ACT_DOWN = act_spec[\"DOWN\"]\n  ACT_UP = act_spec[\"UP\"]\n  ACT_LEFT = act_spec[\"LEFT\"]\n  ACT_RIGHT = act_spec[\"RIGHT\"]\n  ACT_USE = act_spec[\"USE\"]\n  delta_to_act = {\n      (1, 0): ACT_DOWN,\n      (-1, 0): ACT_UP,\n      (0, 1): ACT_RIGHT,\n      (0, -1): ACT_LEFT,\n  }\n\n  actions = []\n\n  # -------------------------------------------------------------------------\n  # Helper: BFS to compute a sequence of actions from start to goal (free cells)\n  # -------------------------------------------------------------------------\n  def bfs_path(start, goal):\n      from collections import deque\n\n      h, w, _ = state.grid.shape\n      visited = np.full((h, w), False, dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start] = True\n\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          y, x = cur\n          for dy, dx in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < h and 0 <= nx < w and not visited[ny, nx]:\n                  # Permit stepping onto the goal even if occupied (for collect/craft)\n                  if not state.grid[ny, nx, :].any() or (ny, nx) == goal:\n                      visited[ny, nx] = True\n                      prev[(ny, nx)] = (y, x)\n                      q.append((ny, nx))\n\n      if goal not in prev and start != goal:\n          return []  # no path found\n\n      # Reconstruct action list\n      path_actions = []\n      cur = goal\n      while cur != start:\n          p = prev[cur]\n          dy, dx = cur[0] - p[0], cur[1] - p[1]\n          path_actions.append(delta_to_act[(dy, dx)])\n          cur = p\n      path_actions.reverse()\n      return path_actions\n\n  # -------------------------------------------------------------------------\n  # Helper: move the agent to an absolute position using BFS paths\n  # -------------------------------------------------------------------------\n  def move_to(target):\n      nonlocal actions, state\n      while state.pos != target:\n          step_actions = bfs_path(state.pos, target)\n          if not step_actions:\n              # Unable to reach target; abort further movement\n              break\n          for a in step_actions:\n              actions.append(a)\n              _, _, _ = env.step(a)\n              state = env._current_state\n              if state.pos == target:\n                  break\n\n  # -------------------------------------------------------------------------\n  # Helper: locate the nearest cell containing a given kind index\n  # -------------------------------------------------------------------------\n  def find_nearest(kind_idx):\n      grid = state.grid\n      h, w, _ = grid.shape\n      py, px = state.pos\n      best = None\n      best_dist = None\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  d = abs(i - py) + abs(j - px)\n                  if best_dist is None or d < best_dist:\n                      best_dist = d\n                      best = (i, j)\n      return best\n\n  # -------------------------------------------------------------------------\n  # Helper: pick a free cell adjacent (including diagonals) to a target cell\n  # -------------------------------------------------------------------------\n  def adjacent_free(cell):\n      y, x = cell\n      h, w, _ = state.grid.shape\n      # Prefer the cell itself if it is free\n      if not state.grid[y, x, :].any():\n          return (y, x)\n      for dy in (-1, 0, 1):\n          for dx in (-1, 0, 1):\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < h and 0 <= nx < w:\n                  if not state.grid[ny, nx, :].any():\n                      return (ny, nx)\n      # Fallback: stay where we are (should rarely happen)\n      return state.pos\n\n  # -------------------------------------------------------------------------\n  # Collect all primitive resources required for the goal item\n  # -------------------------------------------------------------------------\n  primitives = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  for kind_idx, needed in primitives.items():\n      for _ in range(needed):\n          src = find_nearest(kind_idx)\n          if src is None:\n              raise RuntimeError(f\"Required primitive {kind_idx} not found in the map\")\n          adj = adjacent_free(src)\n          move_to(adj)\n          actions.append(ACT_USE)\n          _, _, _ = env.step(ACT_USE)\n          state = env._current_state\n\n  # -------------------------------------------------------------------------\n  # Move to the workshop (if specified) and craft the goal item\n  # -------------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      ws_pos = find_nearest(workshop_idx)\n      if ws_pos is not None:\n          adj = adjacent_free(ws_pos)\n          move_to(adj)\n          actions.append(ACT_USE)\n          _, _, _ = env.step(ACT_USE)\n          state = env._current_state\n\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T19:06:15.346895", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n\n  # goal index\n  if hasattr(env, \"task\") and hasattr(env.task, \"goal\"):\n      goal_idx = env.task.goal\n  else:\n      goal_idx = env.world.cookbook.index.get(\"arrow\")\n      if goal_idx is None:\n          raise ValueError(\"Arrow not found in cookbook\")\n\n  act_spec = env.action_specs()\n  ACT_DOWN = act_spec[\"DOWN\"]\n  ACT_UP = act_spec[\"UP\"]\n  ACT_LEFT = act_spec[\"LEFT\"]\n  ACT_RIGHT = act_spec[\"RIGHT\"]\n  ACT_USE = act_spec[\"USE\"]\n\n  actions = []\n\n  from collections import deque\n\n  def bfs_path(start, target):\n      \"\"\"Return list of actions to move from start to target (target must be free).\"\"\"\n      grid = env._current_state.grid\n      h, w, _ = grid.shape\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (y, x), path = q.popleft()\n          if (y, x) == target:\n              return path\n          for act, dy, dx in (\n              (ACT_DOWN, 1, 0),\n              (ACT_UP, -1, 0),\n              (ACT_RIGHT, 0, 1),\n              (ACT_LEFT, 0, -1),\n          ):\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < h and 0 <= nx < w and (ny, nx) not in visited:\n                  # allow stepping onto target even if occupied (we will be adjacent)\n                  if not grid[ny, nx, :].any() or (ny, nx) == target:\n                      visited.add((ny, nx))\n                      q.append(((ny, nx), path + [act]))\n      return None\n\n  def move_to(target):\n      \"\"\"Move agent to target cell using BFS, updating env and actions.\"\"\"\n      nonlocal state\n      while state.pos != target:\n          path = bfs_path(state.pos, target)\n          if not path:\n              raise RuntimeError(f\"Cannot reach {target}\")\n          for a in path:\n              actions.append(a)\n              env.step(a)\n              state = env._current_state\n              if state.pos == target:\n                  break\n\n  def find_nearest(kind_idx):\n      \"\"\"Return coordinates of the nearest cell containing kind_idx.\"\"\"\n      grid = env._current_state.grid\n      h, w, _ = grid.shape\n      py, px = state.pos\n      best = None\n      best_dist = None\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  d = abs(i - py) + abs(j - px)\n                  if best_dist is None or d < best_dist:\n                      best_dist = d\n                      best = (i, j)\n      return best\n\n  def adjacent_free(cell):\n      \"\"\"Return a free cell (or the cell itself) adjacent to given cell.\"\"\"\n      y, x = cell\n      grid = env._current_state.grid\n      h, w, _ = grid.shape\n      if not grid[y, x, :].any():\n          return (y, x)\n      for dy in (-1, 0, 1):\n          for dx in (-1, 0, 1):\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < h and 0 <= nx < w and not grid[ny, nx, :].any():\n                  return (ny, nx)\n      return None\n\n  # ------------------------------------------------------------------\n  # Collect primitives required for the arrow\n  # ------------------------------------------------------------------\n  needed = env.world.cookbook.primitives_for(goal_idx)  # dict {kind: count}\n  for kind_idx, count in needed.items():\n      for _ in range(count):\n          src = find_nearest(kind_idx)\n          if src is None:\n              raise RuntimeError(f\"Primitive {kind_idx} not found on map\")\n          adj = adjacent_free(src)\n          if adj is None:\n              raise RuntimeError(f\"No free cell adjacent to primitive {kind_idx}\")\n          move_to(adj)\n          actions.append(ACT_USE)\n          env.step(ACT_USE)\n          state = env._current_state\n\n  # ------------------------------------------------------------------\n  # Go to workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      ws_idx = env.world.cookbook.index[workshop_name]\n      ws_pos = find_nearest(ws_idx)\n      if ws_pos is None:\n          raise RuntimeError(f\"Workshop {workshop_name} not found\")\n      adj = adjacent_free(ws_pos)\n      if adj is None:\n          raise RuntimeError(f\"No free cell adjacent to workshop {workshop_name}\")\n      move_to(adj)\n      actions.append(ACT_USE)\n      env.step(ACT_USE)\n      state = env._current_state\n\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T19:06:16.480434", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n\n  # ------------------------------------------------------------\n  # Identify the goal (arrow) index\n  # ------------------------------------------------------------\n  if hasattr(env, \"task\") and hasattr(env.task, \"goal\"):\n      goal_idx = env.task.goal\n  else:\n      goal_idx = env.world.cookbook.index.get(\"arrow\")\n      if goal_idx is None:\n          raise ValueError(\"Arrow item not found in cookbook\")\n\n  # ------------------------------------------------------------\n  # Action constants\n  # ------------------------------------------------------------\n  act_spec = env.action_specs()\n  ACT_DOWN = act_spec[\"DOWN\"]\n  ACT_UP = act_spec[\"UP\"]\n  ACT_LEFT = act_spec[\"LEFT\"]\n  ACT_RIGHT = act_spec[\"RIGHT\"]\n  ACT_USE = act_spec[\"USE\"]\n\n  actions = []\n\n  # ------------------------------------------------------------\n  # Helper: BFS path planning avoiding occupied cells\n  # ------------------------------------------------------------\n  from collections import deque\n\n  def bfs_path(start, target):\n      \"\"\"Return a list of actions to move from start to target.\"\"\"\n      grid = env._current_state.grid\n      h, w, _ = grid.shape\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (y, x), path = q.popleft()\n          if (y, x) == target:\n              return path\n          for act, dy, dx in (\n              (ACT_DOWN, 1, 0),\n              (ACT_UP, -1, 0),\n              (ACT_RIGHT, 0, 1),\n              (ACT_LEFT, 0, -1),\n          ):\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < h and 0 <= nx < w and (ny, nx) not in visited:\n                  # Allow stepping onto the target even if it contains something\n                  if not grid[ny, nx, :].any() or (ny, nx) == target:\n                      visited.add((ny, nx))\n                      q.append(((ny, nx), path + [act]))\n      raise RuntimeError(f\"No path from {start} to {target}\")\n\n  # ------------------------------------------------------------\n  # Helper: move to a free cell (uses bfs_path)\n  # ------------------------------------------------------------\n  def move_to(target):\n      nonlocal state\n      while state.pos != target:\n          path = bfs_path(state.pos, target)\n          if not path:\n              raise RuntimeError(f\"Unreachable target {target}\")\n          for a in path:\n              actions.append(a)\n              env.step(a)\n              state = env._current_state\n              if state.pos == target:\n                  break\n\n  # ------------------------------------------------------------\n  # Helper: locate nearest cell containing a given kind index\n  # ------------------------------------------------------------\n  def find_nearest(kind_idx):\n      grid = env._current_state.grid\n      h, w, _ = grid.shape\n      py, px = state.pos\n      best = None\n      best_dist = None\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  d = abs(i - py) + abs(j - px)\n                  if best_dist is None or d < best_dist:\n                      best_dist = d\n                      best = (i, j)\n      return best\n\n  # ------------------------------------------------------------\n  # Helper: find a free cell adjacent (including the cell itself)\n  # ------------------------------------------------------------\n  def adjacent_free(cell):\n      y, x = cell\n      grid = env._current_state.grid\n      h, w, _ = grid.shape\n      if not grid[y, x, :].any():\n          return (y, x)\n      for dy in (-1, 0, 1):\n          for dx in (-1, 0, 1):\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < h and 0 <= nx < w and not grid[ny, nx, :].any():\n                  return (ny, nx)\n      raise RuntimeError(f\"No free adjacent cell to {cell}\")\n\n  # ------------------------------------------------------------\n  # Collect all required primitive resources\n  # ------------------------------------------------------------\n  needed_prims = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  for kind_idx, count in needed_prims.items():\n      for _ in range(count):\n          src = find_nearest(kind_idx)\n          if src is None:\n              raise RuntimeError(f\"Primitive {kind_idx} not found on map\")\n          adj = adjacent_free(src)\n          move_to(adj)\n          actions.append(ACT_USE)\n          env.step(ACT_USE)\n          state = env._current_state\n\n  # ------------------------------------------------------------\n  # Move to workshop (if any) and craft the arrow\n  # ------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      ws_idx = env.world.cookbook.index[workshop_name]\n      ws_pos = find_nearest(ws_idx)\n      if ws_pos is None:\n          raise RuntimeError(f\"Workshop '{workshop_name}' not found on map\")\n      adj = adjacent_free(ws_pos)\n      move_to(adj)\n      actions.append(ACT_USE)\n      env.step(ACT_USE)\n      state = env._current_state\n\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T19:06:44.834317", "function_name": "make_arrow", "function_body": "  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # 0:DOWN, 1:UP, 2:LEFT, 3:RIGHT\n  USE = 4\n\n  from collections import deque\n  import numpy as np\n\n  def bfs_adjacent(start, target, blocked):\n      \"\"\"Return a list of movement actions that brings the agent from *start*\n      to any empty cell that is 4\u2011connected to *target*.\n      If unreachable, return an empty list.\"\"\"\n      h, w = blocked.shape\n      tx, ty = target\n      goal_cells = []\n      for a, (dx, dy) in enumerate(DIRS):\n          gx, gy = tx + dx, ty + dy\n          if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:\n              goal_cells.append((gx, gy))\n      if not goal_cells:\n          return []\n      q = deque([(start, [])])\n      visited = {start}\n      while q:\n          (cx, cy), path = q.popleft()\n          if (cx, cy) in goal_cells:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []\n\n  # ----------------------------------------------------------------------\n  # Reset / obtain current state\n  # ----------------------------------------------------------------------\n  try:\n      env.reset()\n  except Exception:\n      pass\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []\n\n  world = env.world\n  idx = world.cookbook.index\n\n  # ----------------------------------------------------------------------\n  # Identify arrow goal and its recipe\n  # ----------------------------------------------------------------------\n  try:\n      goal_idx = idx[\"arrow\"]\n  except Exception:\n      return []                     # no arrow defined in this world\n\n  # primitives needed for a single arrow\n  primitives_needed = world.cookbook.primitives_for(goal_idx)\n\n  # locate the workshop required for the recipe (key \"_at\" or \"_key\")\n  workshop_name = None\n  for k, v in world.cookbook.recipes.get(goal_idx, {}).items():\n      if k in (\"_at\", \"_key\"):\n          workshop_name = v\n          break\n  if workshop_name is None:\n      return []                     # recipe does not specify a workshop\n  try:\n      workshop_idx = idx[workshop_name]\n  except Exception:\n      return []                     # workshop not indexed\n\n  # ----------------------------------------------------------------------\n  # Local mutable copies for planning simulation\n  # ----------------------------------------------------------------------\n  pos = tuple(state.pos)                     # (x, y)\n  grid = state.grid.copy()                   # (W, H, n_kinds)\n  inventory = state.inventory.copy()\n  occupied = np.any(grid > 0, axis=2)        # bool matrix: True = blocked\n\n  plan = []\n\n  # ----------------------------------------------------------------------\n  # Helper: move adjacent to a target cell and USE it, updating simulation\n  # ----------------------------------------------------------------------\n  def move_and_use(target, kind_idx):\n      \"\"\"Move adjacent to *target* (which contains *kind_idx*) and issue USE.\n      Updates simulated position, grid, occupied map and inventory.\n      Returns False if movement is impossible.\"\"\"\n      nonlocal pos, plan, grid, occupied, inventory\n      path = bfs_adjacent(pos, target, occupied)\n      if not path and pos != target:\n          return False\n\n      # simulate movement\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n      plan.extend(path)\n\n      # simulate USE\n      plan.append(USE)\n      tx, ty = target\n      if grid[tx, ty, kind_idx] > 0:\n          grid[tx, ty, kind_idx] = 0\n          occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)\n          inventory[kind_idx] += 1\n      return True\n\n  # ----------------------------------------------------------------------\n  # Collect all required primitive resources\n  # ----------------------------------------------------------------------\n  for prim_idx, count in primitives_needed.items():\n      for _ in range(count):\n          locations = np.argwhere(grid[:, :, prim_idx] > 0)\n          if locations.size == 0:\n              # primitive missing from the map \u2013 abort planning\n              return plan\n          # choose the closest occurrence (Manhattan distance)\n          dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n          target = tuple(locations[dists.argmin()])\n          if not move_and_use(target, prim_idx):\n              return plan\n\n  # ----------------------------------------------------------------------\n  # Move to the workshop and craft the arrow\n  # ----------------------------------------------------------------------\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      # workshops are static; fall back to the original scenario grid\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          return plan\n  dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])\n  workshop_target = tuple(workshop_cells[dists.argmin()])\n  move_and_use(workshop_target, workshop_idx)\n\n  # ----------------------------------------------------------------------\n  # Return the assembled action sequence\n  # ----------------------------------------------------------------------\n  return plan", "env_interactions": 23, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T19:06:45.980915", "function_name": "make_arrow", "function_body": "  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # 0:DOWN, 1:UP, 2:LEFT, 3:RIGHT\n  USE = 4\n\n  from collections import deque\n  import numpy as np\n\n  def bfs_adjacent(start, target, blocked):\n      \"\"\"Return a list of movement actions that brings the agent from *start*\n      to any empty cell that is 4\u2011connected to *target*.\n      If unreachable, return empty list.\"\"\"\n      h, w = blocked.shape\n      tx, ty = target\n      goal_cells = []\n      for a, (dx, dy) in enumerate(DIRS):\n          gx, gy = tx + dx, ty + dy\n          if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:\n              goal_cells.append((gx, gy))\n      if not goal_cells:\n          return []\n      q = deque([(start, [])])\n      visited = {start}\n      while q:\n          (cx, cy), path = q.popleft()\n          if (cx, cy) in goal_cells:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []\n\n  # ----------------------------------------------------------------------\n  # Reset / obtain current state\n  # ----------------------------------------------------------------------\n  try:\n      env.reset()\n  except Exception:\n      pass\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []\n\n  world = env.world\n  idx = world.cookbook.index\n\n  # ----------------------------------------------------------------------\n  # Identify arrow goal and its recipe\n  # ----------------------------------------------------------------------\n  try:\n      goal_idx = idx[\"arrow\"]\n  except Exception:\n      return []                     # no arrow defined\n\n  # primitives needed for one arrow\n  primitives = world.cookbook.primitives_for(goal_idx)\n\n  # workshop required for arrow (stored under \"_at\" or \"_key\")\n  workshop_name = None\n  for k, v in world.cookbook.recipes.get(goal_idx, {}).items():\n      if k in (\"_at\", \"_key\"):\n          workshop_name = v\n          break\n  if workshop_name is None:\n      return []\n  try:\n      workshop_idx = idx[workshop_name]\n  except Exception:\n      return []\n\n  # ----------------------------------------------------------------------\n  # Local mutable copies for planning\n  # ----------------------------------------------------------------------\n  pos = tuple(state.pos)                     # (x, y)\n  grid = state.grid.copy()                   # (W, H, n_kinds)\n  inventory = state.inventory.copy()\n  occupied = np.any(grid > 0, axis=2)        # bool matrix of blocked cells\n\n  plan = []\n\n  # ----------------------------------------------------------------------\n  # Helper to move adjacent to a cell and USE it\n  # ----------------------------------------------------------------------\n  def move_and_use(target, kind_idx):\n      \"\"\"Move adjacent to *target* (contains *kind_idx*) and issue USE.\n      Updates simulated pos, grid, occupied, inventory. Returns False on failure.\"\"\"\n      nonlocal pos, plan, grid, occupied, inventory\n      path = bfs_adjacent(pos, target, occupied)\n      if not path and pos != target:\n          return False\n      # execute movement actions in simulation\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n      plan.extend(path)\n\n      # perform USE\n      plan.append(USE)\n\n      tx, ty = target\n      if grid[tx, ty, kind_idx] > 0:\n          # pick up primitive or interact with workshop\n          grid[tx, ty, kind_idx] = 0\n          occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)\n          inventory[kind_idx] += 1\n      return True\n\n  # ----------------------------------------------------------------------\n  # Collect required primitives\n  # ----------------------------------------------------------------------\n  for prim_idx, cnt in primitives.items():\n      for _ in range(cnt):\n          locations = np.argwhere(grid[:, :, prim_idx] > 0)\n          if locations.size == 0:\n              # primitive not present; abort planning\n              return plan\n          # choose nearest by Manhattan distance\n          dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n          target = tuple(locations[dists.argmin()])\n          if not move_and_use(target, prim_idx):\n              return plan\n\n  # ----------------------------------------------------------------------\n  # Go to workshop and craft the arrow\n  # ----------------------------------------------------------------------\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      # workshops are static; fall back to original grid\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          return plan\n  dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])\n  workshop_target = tuple(workshop_cells[dists.argmin()])\n  move_and_use(workshop_target, workshop_idx)\n\n  return plan", "env_interactions": 23, "island_id": 8, "scores": {"3": 0.5}}
