{"timestamp": "2025-10-27T19:43:45.726818", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ------------------------------------------------------------------\n  # Action constants (match CraftLab.action_specs order)\n  # ------------------------------------------------------------------\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # 0:DOWN, 1:UP, 2:LEFT, 3:RIGHT\n  USE = 4\n\n  # ------------------------------------------------------------------\n  # Helper: BFS to any free neighbour of a target cell\n  # ------------------------------------------------------------------\n  def bfs_to_adjacent(start, target, blocked):\n      \"\"\"Return a list of movement actions that brings the agent from *start*\n      to any empty cell adjacent to *target*. If no such path exists, return [].\n      \"\"\"\n      h, w = blocked.shape\n      tx, ty = int(target[0]), int(target[1])\n\n      # all possible free neighbour cells of the target\n      goal_cells = []\n      for a, (dx, dy) in enumerate(DIRS):\n          gx, gy = tx + dx, ty + dy\n          if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:\n              goal_cells.append((gx, gy))\n      if not goal_cells:\n          return []\n\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (cx, cy), path = q.popleft()\n          if (cx, cy) in goal_cells:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []\n\n  # ------------------------------------------------------------------\n  # Reset / initialise the environment\n  # ------------------------------------------------------------------\n  try:\n      env.reset()\n  except Exception:\n      pass\n\n  # Grab the internal CraftState; if unavailable, we cannot plan.\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []\n\n  world = env.world\n  idx = world.cookbook.index\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow) and its recipe\n  # ------------------------------------------------------------------\n  try:\n      arrow_idx = idx[\"arrow\"]\n  except Exception:\n      return []                     # arrow not defined in this world\n\n  primitives_needed = world.cookbook.primitives_for(arrow_idx)\n\n  recipe_dict = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe_dict.get(\"_at\") or recipe_dict.get(\"_key\")\n  if workshop_name is None:\n      return []                     # cannot locate required workshop\n\n  try:\n      workshop_idx = idx[workshop_name]\n  except Exception:\n      return []                     # workshop name not indexed\n\n  # ------------------------------------------------------------------\n  # Local mutable copies for planning\n  # ------------------------------------------------------------------\n  pos = tuple(state.pos)                     # (x, y)\n  grid = state.grid.copy()                    # (W, H, n_kinds)\n  inventory = state.inventory.copy()\n  occupied = np.any(grid > 0, axis=2)         # bool matrix: any entity present\n\n  plan_actions = []\n\n  # ------------------------------------------------------------------\n  # Helper: move adjacent to *target_coord* (which holds *kind_idx*) and USE.\n  # Updates simulated position, grid, occupied, inventory.\n  # ------------------------------------------------------------------\n  def move_and_use(target_coord, kind_idx):\n      nonlocal pos, plan_actions, grid, occupied, inventory\n\n      path = bfs_to_adjacent(pos, target_coord, occupied)\n      if not path and pos != target_coord:\n          return False\n\n      # Apply movement actions to simulated state\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n      plan_actions.extend(path)\n\n      # Issue USE action\n      plan_actions.append(USE)\n\n      tx, ty = int(target_coord[0]), int(target_coord[1])\n      if grid[tx, ty, kind_idx] > 0:\n          # Pick up one unit of the item\n          grid[tx, ty, kind_idx] = 0\n          occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)\n          inventory[kind_idx] += 1\n      return True\n\n  # ------------------------------------------------------------------\n  # Collect all required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      for _ in range(needed_cnt):\n          candidates = np.argwhere(grid[:, :, prim_idx] > 0)\n          if candidates.shape[0] == 0:\n              # No more instances of this primitive on the map; abort planning.\n              return plan_actions\n          # Choose the nearest candidate (Manhattan distance)\n          dists = np.abs(candidates[:, 0] - pos[0]) + np.abs(candidates[:, 1] - pos[1])\n          target = candidates[dists.argmin()]\n          if not move_and_use(target, prim_idx):\n              return plan_actions\n\n  # ------------------------------------------------------------------\n  # Move to a workshop and craft the arrow\n  # ------------------------------------------------------------------\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.shape[0] == 0:\n      # Workshops are static; fall back to the original scenario grid.\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.shape[0] == 0:\n          return plan_actions\n\n  dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])\n  workshop_target = workshop_cells[dists.argmin()]\n\n  move_and_use(workshop_target, workshop_idx)\n\n  return plan_actions", "env_interactions": 23, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T19:43:46.860777", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ----------------------------------------------------------------------\n  # Action constants (must match CraftLab.action_specs order)\n  # ----------------------------------------------------------------------\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # 0:DOWN, 1:UP, 2:LEFT, 3:RIGHT\n  USE = 4\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS that returns a list of movement actions leading to any\n  # free neighbour of *target* (the target cell itself may be occupied).\n  # ----------------------------------------------------------------------\n  def bfs_to_adjacent(start, target, blocked):\n      \"\"\"Return a list of actions moving from *start* to a free neighbour of *target*.\n      If no such neighbour is reachable, return an empty list.\"\"\"\n      h, w = blocked.shape\n      tx, ty = int(target[0]), int(target[1])\n\n      # collect all free neighbour cells around the target\n      goal_cells = []\n      for a, (dx, dy) in enumerate(DIRS):\n          gx, gy = tx + dx, ty + dy\n          if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:\n              goal_cells.append((gx, gy))\n      if not goal_cells:\n          return []\n\n      # BFS over free cells\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (cx, cy), path = q.popleft()\n          if (cx, cy) in goal_cells:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []\n\n  # ----------------------------------------------------------------------\n  # Initialise / reset environment and fetch the internal state\n  # ----------------------------------------------------------------------\n  try:\n      env.reset()\n  except Exception:\n      pass\n\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      # cannot obtain the underlying CraftState \u2013 give up\n      return []\n\n  world = env.world\n  idx = world.cookbook.index\n\n  # ----------------------------------------------------------------------\n  # Identify the goal (arrow) and its recipe\n  # ----------------------------------------------------------------------\n  try:\n      arrow_idx = idx[\"arrow\"]\n  except Exception:\n      # arrow not defined in this world\n      return []\n\n  # mapping primitive_kind_idx -> count needed to craft one arrow\n  primitives_needed = world.cookbook.primitives_for(arrow_idx)\n\n  # workshop where the arrow must be crafted\n  recipe_dict = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe_dict.get(\"_at\") or recipe_dict.get(\"_key\")\n  if workshop_name is None:\n      return []\n  try:\n      workshop_idx = idx[workshop_name]\n  except Exception:\n      return []\n\n  # ----------------------------------------------------------------------\n  # Local mutable copies for planning (so we can simulate actions)\n  # ----------------------------------------------------------------------\n  pos = tuple(state.pos)                     # (x, y)\n  grid = state.grid.copy()                   # (W, H, n_kinds)\n  inventory = state.inventory.copy()\n  occupied = np.any(grid > 0, axis=2)        # bool matrix: any entity present\n\n  plan_actions = []\n\n  # ----------------------------------------------------------------------\n  # Helper: move adjacent to *target_coord* (which contains *kind_idx*) and\n  # issue a USE action. Updates the simulated position, grid, occupied map\n  # and inventory. Returns True on success, False otherwise.\n  # ----------------------------------------------------------------------\n  def move_and_use(target_coord, kind_idx):\n      nonlocal pos, plan_actions, grid, occupied, inventory\n\n      path = bfs_to_adjacent(pos, target_coord, occupied)\n      if not path and pos != target_coord:\n          return False\n\n      # follow the movement actions, updating simulated position\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n      plan_actions.extend(path)\n\n      # perform the USE action\n      plan_actions.append(USE)\n\n      tx, ty = int(target_coord[0]), int(target_coord[1])\n      if grid[tx, ty, kind_idx] > 0:\n          # pick up one unit of the primitive / interact with workshop\n          grid[tx, ty, kind_idx] = 0\n          occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)\n          inventory[kind_idx] += 1\n      return True\n\n  # ----------------------------------------------------------------------\n  # Collect all required primitives according to the recipe\n  # ----------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      for _ in range(needed_cnt):\n          # locate the nearest remaining instance of the primitive\n          candidates = np.argwhere(grid[:, :, prim_idx] > 0)\n          if candidates.shape[0] == 0:\n              # no more instances on the map \u2013 abort planning\n              return plan_actions\n          dists = np.abs(candidates[:, 0] - pos[0]) + np.abs(candidates[:, 1] - pos[1])\n          target = candidates[dists.argmin()]\n          if not move_and_use(target, prim_idx):\n              # movement failed (e.g., completely surrounded); abort\n              return plan_actions\n\n  # ----------------------------------------------------------------------\n  # Move to a workshop cell and craft the arrow\n  # ----------------------------------------------------------------------\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.shape[0] == 0:\n      # workshops are static; fall back to the original scenario layout\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.shape[0] == 0:\n          return plan_actions\n\n  dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])\n  workshop_target = workshop_cells[dists.argmin()]\n\n  move_and_use(workshop_target, workshop_idx)\n\n  # The plan now contains movements and USE actions that will collect the\n  # primitives, reach the workshop and craft the arrow.\n  return plan_actions", "env_interactions": 23, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T19:44:06.180413", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Action constants (match CraftLab.action_specs)\n  # ----------------------------------------------------------------------\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # DOWN, UP, LEFT, RIGHT\n  USE = 4\n\n  # ----------------------------------------------------------------------\n  # Bread\u2011first search that returns a list of move actions leading from\n  # *start* to any empty cell orthogonally adjacent to *target*.\n  # ----------------------------------------------------------------------\n  from collections import deque\n  import numpy as np\n\n  def bfs_adjacent(start, target, blocked):\n      \"\"\"Return a list of move actions that brings the agent from *start*\n      to an empty cell orthogonally adjacent to *target*.\"\"\"\n      h, w = blocked.shape\n      tx, ty = target\n      goals = []\n      for a, (dx, dy) in enumerate(DIRS):\n          gx, gy = tx + dx, ty + dy\n          if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:\n              goals.append((gx, gy))\n      if not goals:\n          return []                     # target completely surrounded\n\n      q = deque([(start, [])])\n      visited = {start}\n      while q:\n          (cx, cy), path = q.popleft()\n          if (cx, cy) in goals:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []                         # unreachable\n\n  # ----------------------------------------------------------------------\n  # Reset / obtain the current state from the environment.\n  # ----------------------------------------------------------------------\n  try:\n      env.reset()\n  except Exception:\n      pass\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []\n\n  world = env.world\n  idx = world.cookbook.index\n\n  # ----------------------------------------------------------------------\n  # Identify the goal (arrow) and its recipe.\n  # ----------------------------------------------------------------------\n  try:\n      goal_idx = idx[\"arrow\"]\n  except Exception:\n      return []                         # arrow not defined in the recipe file\n\n  needed = world.cookbook.primitives_for(goal_idx)\n\n  # Locate the workshop required for crafting the arrow.\n  workshop_idx = None\n  for k, v in world.cookbook.recipes.get(goal_idx, {}).items():\n      if k in (\"_at\", \"_key\"):\n          try:\n              workshop_idx = idx[v]\n          except Exception:\n              workshop_idx = None\n          break\n  if workshop_idx is None:\n      return []                         # cannot find the workshop for arrow\n\n  # ----------------------------------------------------------------------\n  # Local mutable copies for planning.\n  # ----------------------------------------------------------------------\n  pos = tuple(state.pos)                # (x, y)\n  grid = state.grid.copy()              # (W, H, n_kinds)\n  inventory = state.inventory.copy()\n  occupied = np.any(grid > 0, axis=2)   # bool matrix: True where any entity exists\n\n  plan = []\n\n  # ----------------------------------------------------------------------\n  # Helper that moves adjacent to *target*, issues a USE action and\n  # updates the simulated world state. Returns False on failure.\n  # ----------------------------------------------------------------------\n  def move_and_use(target, kind_idx):\n      \"\"\"Move adjacent to *target*, USE, and update simulated state.\"\"\"\n      nonlocal pos, plan, grid, occupied, inventory\n      path = bfs_adjacent(pos, target, occupied)\n      if not path and pos != target:\n          return False                  # cannot reach adjacency\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n      plan.extend(path)\n\n      plan.append(USE)                  # interact with the cell\n\n      tx, ty = target\n      if grid[tx, ty, kind_idx] > 0:    # pick up the item\n          grid[tx, ty, kind_idx] = 0\n          occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)\n          inventory[kind_idx] += 1\n      return True\n\n  # ----------------------------------------------------------------------\n  # Collect every primitive/component required by the recipe.\n  # ----------------------------------------------------------------------\n  for kind_idx, cnt in needed.items():\n      for _ in range(cnt):\n          locations = np.argwhere(grid[:, :, kind_idx] > 0)\n          if locations.size == 0:\n              return plan                # nothing left to collect\n          # Choose the closest instance (Manhattan distance)\n          dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n          target = tuple(locations[dists.argmin()])\n          if not move_and_use(target, kind_idx):\n              return plan\n\n  # ----------------------------------------------------------------------\n  # Move to the workshop and craft the arrow.\n  # ----------------------------------------------------------------------\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      # Workshops are static; fall back to the original scenario grid.\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          return plan\n  dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])\n  workshop_target = tuple(workshop_cells[dists.argmin()])\n  move_and_use(workshop_target, workshop_idx)\n\n  # ----------------------------------------------------------------------\n  # Return the assembled action list.\n  # ----------------------------------------------------------------------\n  return plan", "env_interactions": 23, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T19:44:07.296489", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ----------------------------------------------------------------------\n  # Action constants (must match CraftLab.action_specs)\n  # ----------------------------------------------------------------------\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # DOWN, UP, LEFT, RIGHT\n  USE = 4\n\n  # ----------------------------------------------------------------------\n  # Bread\u2011first search that returns a list of move actions taking the\n  # agent from *start* to any empty cell orthogonally adjacent to *target*.\n  # *blocked* is a bool matrix where True means the cell cannot be entered.\n  # ----------------------------------------------------------------------\n  def bfs_adjacent(start, target, blocked):\n      h, w = blocked.shape\n      tx, ty = target\n      goal_cells = []\n      for a, (dx, dy) in enumerate(DIRS):\n          gx, gy = tx + dx, ty + dy\n          if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:\n              goal_cells.append((gx, gy))\n      if not goal_cells:\n          return []                         # target surrounded\n\n      q = deque([(start, [])])\n      visited = {start}\n      while q:\n          (cx, cy), path = q.popleft()\n          if (cx, cy) in goal_cells:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []                                 # unreachable\n\n  # ----------------------------------------------------------------------\n  # Reset environment (if possible) and fetch the current CraftState.\n  # ----------------------------------------------------------------------\n  try:\n      env.reset()\n  except Exception:\n      pass\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []\n\n  world = env.world\n  idx = world.cookbook.index\n\n  # ----------------------------------------------------------------------\n  # Determine goal index for \"arrow\" and its recipe.\n  # ----------------------------------------------------------------------\n  try:\n      goal_idx = idx[\"arrow\"]\n  except Exception:\n      return []                                 # no arrow in recipe set\n\n  needed = world.cookbook.primitives_for(goal_idx)\n\n  # Find the workshop required for the arrow recipe.\n  workshop_idx = None\n  for k, v in world.cookbook.recipes.get(goal_idx, {}).items():\n      if k in (\"_at\", \"_key\"):\n          workshop_idx = idx.get(v, None)\n          break\n  if workshop_idx is None:\n      return []                                 # cannot locate workshop\n\n  # ----------------------------------------------------------------------\n  # Local mutable copies for planning.\n  # ----------------------------------------------------------------------\n  pos = tuple(state.pos)                        # (x, y)\n  grid = state.grid.copy()                      # (W, H, n_kinds)\n  inventory = state.inventory.copy()\n  occupied = np.any(grid > 0, axis=2)           # bool map of blocked cells\n  plan = []\n\n  # ----------------------------------------------------------------------\n  # Helper that moves adjacent to *target*, issues a USE action,\n  # and updates the simulated world state.\n  # ----------------------------------------------------------------------\n  def move_and_use(target, kind_idx):\n      nonlocal pos, plan, grid, occupied, inventory\n      path = bfs_adjacent(pos, target, occupied)\n      if not path and pos != target:\n          return False                          # cannot reach adjacency\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n      plan.extend(path)\n\n      plan.append(USE)                          # interact with the cell\n\n      tx, ty = target\n      if grid[tx, ty, kind_idx] > 0:            # pick up primitive/component\n          grid[tx, ty, kind_idx] = 0\n          occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)\n          inventory[kind_idx] += 1\n      return True\n\n  # ----------------------------------------------------------------------\n  # Collect every primitive/component required by the recipe.\n  # ----------------------------------------------------------------------\n  for kind_idx, cnt in needed.items():\n      for _ in range(cnt):\n          locations = np.argwhere(grid[:, :, kind_idx] > 0)\n          if locations.size == 0:\n              return plan                        # nothing left to collect\n          dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n          target = tuple(locations[dists.argmin()])\n          if not move_and_use(target, kind_idx):\n              return plan\n\n  # ----------------------------------------------------------------------\n  # Move to the appropriate workshop and craft the arrow.\n  # ----------------------------------------------------------------------\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      # Workshops are static; use the original scenario grid as fallback.\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          return plan\n\n  dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])\n  workshop_target = tuple(workshop_cells[dists.argmin()])\n  move_and_use(workshop_target, workshop_idx)\n\n  # ----------------------------------------------------------------------\n  # Return the complete sequence of actions.\n  # ----------------------------------------------------------------------\n  return plan", "env_interactions": 0, "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-10-27T19:44:26.561601", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  # Goal identification\n  goal_name = \"arrow\"\n  goal_idx = idx[goal_name]\n\n  # Primitive requirements for one arrow\n  primitive_counts = world.cookbook.primitives_for(goal_idx)\n\n  # Workshop required for crafting (if any)\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else idx[wk]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def find_locations(kind):\n      \"\"\"Return list of (x, y) where `kind` is present on the grid.\"\"\"\n      occ = np.where(state.grid[:, :, kind] > 0)\n      return list(zip(occ[0].tolist(), occ[1].tolist()))\n\n  def bfs_path(start, goal):\n      \"\"\"Shortest path from start to goal avoiding non\u2011grabbable cells.\"\"\"\n      if start == goal:\n          return [start]\n      W, H = state.grid.shape[:2]\n\n      blocked = set()\n      for ng in world.non_grabbable_indices:\n          occ = np.where(state.grid[:, :, ng] > 0)\n          blocked.update(zip(occ[0].tolist(), occ[1].tolist()))\n\n      q = collections.deque([start])\n      prev = {start: None}\n      while q:\n          cur = q.popleft()\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:\n                  nxt = (nx, ny)\n                  if nxt not in prev:\n                      prev[nxt] = cur\n                      if nxt == goal:\n                          # reconstruct path\n                          path = [goal]\n                          while path[-1] != start:\n                              path.append(prev[path[-1]])\n                          path.reverse()\n                          return path\n                      q.append(nxt)\n      # No path found \u2013 stay put\n      return [start]\n\n  def move_action(cur, nxt):\n      \"\"\"Convert a step from cur to nxt into an action index.\"\"\"\n      dx = nxt[0] - cur[0]\n      dy = nxt[1] - cur[1]\n      if dx == 1:\n          return 3   # RIGHT\n      if dx == -1:\n          return 2   # LEFT\n      if dy == 1:\n          return 0   # DOWN\n      if dy == -1:\n          return 1   # UP\n      raise AssertionError(\"Requested move is not adjacent\")\n\n  # ------------------------------------------------------------------\n  # Build the action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = state.pos\n\n  # 1) Collect all required primitives\n  for prim_idx, needed in primitive_counts.items():\n      while state.inventory[prim_idx] < needed:\n          locations = find_locations(prim_idx)\n          if not locations:\n              break  # cannot find more of this primitive\n          # nearest primitive (Manhattan distance)\n          target = min(\n              locations,\n              key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1])\n          )\n          path = bfs_path(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n          # pick up\n          actions.append(4)   # USE\n          state.inventory[prim_idx] += 1\n          state.grid[target[0], target[1], prim_idx] = 0\n\n  # 2) Move to workshop (if required) and craft\n  if workshop_kind is not None:\n      wk_locs = find_locations(workshop_kind)\n      if wk_locs:\n          target = min(\n              wk_locs,\n              key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1])\n          )\n          path = bfs_path(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n\n  # final craft action\n  actions.append(4)   # USE\n  return actions", "env_interactions": 19, "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T19:44:27.683987", "function_name": "make_arrow", "function_body": "  # Reset the environment and get the current state/world objects\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  idx = world.cookbook.index           # Index mapping names \u2194 ids\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow) and its recipe information\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = idx[goal_name]\n\n  # Primitive requirements for ONE arrow (includes recursive decomposition)\n  primitive_counts = world.cookbook.primitives_for(goal_idx)\n\n  # Workshop required for crafting the arrow, if any\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else idx[wk]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def find_locations(kind):\n      \"\"\"Return a list of (x, y) positions where `kind` is present on the grid.\"\"\"\n      occ = np.where(state.grid[:, :, kind] > 0)\n      return list(zip(occ[0].tolist(), occ[1].tolist()))\n\n  def bfs_path(start, goal):\n      \"\"\"Shortest 4\u2011connected path from start to goal avoiding non\u2011grabbable cells.\"\"\"\n      if start == goal:\n          return [start]\n      W, H = state.grid.shape[:2]\n\n      # Cells that cannot be entered (non\u2011grabbable entities)\n      blocked = set()\n      for ng in world.non_grabbable_indices:\n          occ = np.where(state.grid[:, :, ng] > 0)\n          blocked.update(zip(occ[0].tolist(), occ[1].tolist()))\n\n      queue = collections.deque([start])\n      prev = {start: None}\n      while queue:\n          cur = queue.popleft()\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:\n                  nxt = (nx, ny)\n                  if nxt not in prev:\n                      prev[nxt] = cur\n                      if nxt == goal:\n                          # reconstruct path\n                          path = [goal]\n                          while path[-1] != start:\n                              path.append(prev[path[-1]])\n                          path.reverse()\n                          return path\n                      queue.append(nxt)\n      # No reachable path \u2013 stay where we are\n      return [start]\n\n  def move_action(cur, nxt):\n      \"\"\"Translate a step from cur to nxt into the corresponding action index.\"\"\"\n      dx = nxt[0] - cur[0]\n      dy = nxt[1] - cur[1]\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise AssertionError(\"Requested move is not to an adjacent cell\")\n\n  # ------------------------------------------------------------------\n  # Build the action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = state.pos\n\n  # --------------------------------------------------------------\n  # 1) Collect all required primitive items\n  # --------------------------------------------------------------\n  for prim_idx, needed in primitive_counts.items():\n      while state.inventory[prim_idx] < needed:\n          # Locate remaining instances of this primitive on the map\n          locations = find_locations(prim_idx)\n          if not locations:\n              # No more copies available \u2013 cannot satisfy the goal further\n              break\n\n          # Choose the nearest instance (Manhattan distance)\n          target = min(\n              locations,\n              key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1])\n          )\n\n          # Compute a path and translate it into actions\n          path = bfs_path(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n\n          # Pick up the primitive (USE)\n          actions.append(4)   # USE\n          # Update our planning snapshot of inventory / grid\n          state.inventory[prim_idx] += 1\n          state.grid[target[0], target[1], prim_idx] = 0\n\n  # --------------------------------------------------------------\n  # 2) Move to the required workshop (if any) and craft the arrow\n  # --------------------------------------------------------------\n  if workshop_kind is not None:\n      wk_locs = find_locations(workshop_kind)\n      if wk_locs:\n          target = min(\n              wk_locs,\n              key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1])\n          )\n          path = bfs_path(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n\n  # Finally, issue a USE action to perform the crafting\n  actions.append(4)   # USE\n\n  return actions", "env_interactions": 19, "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T19:45:00.482409", "function_name": "make_arrow", "function_body": "  # Action constants\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  world = env.world\n  idx = world.cookbook.index\n  arrow_idx = idx.index('arrow')\n  needed = world.cookbook.primitives_for(arrow_idx)  # {primitive_idx: count}\n\n  actions = []\n  cur_pos = env._current_state.pos\n  grid = env._current_state.grid\n\n  def _is_walkable(pos, goal=None):\n      \"\"\"Cell is walkable if empty or it is the goal cell.\"\"\"\n      x, y = pos\n      if goal is not None and pos == goal:\n          return True\n      return not grid[x, y, :].any()\n\n  def _bfs_path(start, goal):\n      \"\"\"Return a list of positions from start to goal using BFS.\"\"\"\n      if start == goal:\n          return [start]\n      w, h = grid.shape[:2]\n      frontier = collections.deque([start])\n      came_from = {start: None}\n      while frontier:\n          cur = frontier.popleft()\n          if cur == goal:\n              break\n          x, y = cur\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h:\n                  nxt = (nx, ny)\n                  if nxt not in came_from and _is_walkable(nxt, goal):\n                      came_from[nxt] = cur\n                      frontier.append(nxt)\n      else:\n          return None  # no path found\n\n      # reconstruct path\n      path = [goal]\n      while path[-1] != start:\n          path.append(came_from[path[-1]])\n      path.reverse()\n      return path\n\n  def _actions_from_path(path):\n      \"\"\"Translate a position path into action indices.\"\"\"\n      if not path or len(path) < 2:\n          return []\n      acts = []\n      for (x0, y0), (x1, y1) in zip(path, path[1:]):\n          if x1 == x0 + 1:\n              acts.append(DOWN)\n          elif x1 == x0 - 1:\n              acts.append(UP)\n          elif y1 == y0 + 1:\n              acts.append(RIGHT)\n          elif y1 == y0 - 1:\n              acts.append(LEFT)\n          else:\n              raise ValueError(\"Non\u2011adjacent steps in path\")\n      return acts\n\n  def _move_actions(src, dst):\n      \"\"\"Return actions to move from src to dst (BFS preferred, Manhattan fallback).\"\"\"\n      path = _bfs_path(src, dst)\n      if path is None:\n          # fallback: naive Manhattan moves (may collide with obstacles)\n          x, y = src\n          tx, ty = dst\n          acts = []\n          dx, dy = tx - x, ty - y\n          if dx > 0:\n              acts += [DOWN] * dx\n          elif dx < 0:\n              acts += [UP] * (-dx)\n          if dy > 0:\n              acts += [RIGHT] * dy\n          elif dy < 0:\n              acts += [LEFT] * (-dy)\n          return acts\n      return _actions_from_path(path)\n\n  def _nearest_kind(pos, kind_idx):\n      \"\"\"Find the nearest cell (Manhattan distance) currently containing kind_idx.\"\"\"\n      cells = np.argwhere(grid[:, :, kind_idx] > 0)\n      if cells.size == 0:\n          return None\n      dists = np.abs(cells[:, 0] - pos[0]) + np.abs(cells[:, 1] - pos[1])\n      nearest = cells[dists.argmin()]\n      return tuple(nearest.tolist())\n\n  # ------------------------------------------------------------------\n  # 1. Collect required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          target = _nearest_kind(cur_pos, prim_idx)\n          if target is None:\n              # primitive not present \u2013 abort planning\n              return actions\n          actions += _move_actions(cur_pos, target)\n          cur_pos = target\n          actions.append(USE)  # pick up primitive\n          # remove the primitive from the planning grid so we don't revisit it\n          grid[cur_pos[0], cur_pos[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 2. Move to workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  workshop_name = world.cookbook.recipes[arrow_idx].get('_at')\n  if workshop_name is not None:\n      workshop_idx = idx.index(workshop_name)\n      workshop_pos = _nearest_kind(cur_pos, workshop_idx)\n      if workshop_pos is not None:\n          actions += _move_actions(cur_pos, workshop_pos)\n          cur_pos = workshop_pos\n          actions.append(USE)  # craft at the workshop\n\n  return actions", "env_interactions": 24, "island_id": 5, "scores": {"3": 0.2}}
{"timestamp": "2025-10-27T19:45:01.621814", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helpers\n  # ------------------------------------------------------------------\n  world = env.world\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed_prims = world.cookbook.primitives_for(arrow_idx)  # {prim_idx: count}\n\n  def _grid():\n      \"\"\"Current grid of the environment.\"\"\"\n      return env._current_state.grid\n\n  def _size():\n      g = _grid()\n      return g.shape[0], g.shape[1]\n\n  def _walkable(pos, goal=None):\n      \"\"\"Cell is walkable if empty or it is the goal cell.\"\"\"\n      x, y = pos\n      if goal is not None and pos == goal:\n          return True\n      return not _grid()[x, y, :].any()\n\n  def _bfs_path(start, goal):\n      \"\"\"Return a shortest 4\u2011connected path from start to goal, avoiding occupied cells.\"\"\"\n      if start == goal:\n          return [start]\n      w, h = _size()\n      frontier = collections.deque([start])\n      came_from = {start: None}\n      while frontier:\n          cur = frontier.popleft()\n          if cur == goal:\n              break\n          x, y = cur\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h:\n                  nxt = (nx, ny)\n                  if nxt not in came_from and _walkable(nxt, goal):\n                      came_from[nxt] = cur\n                      frontier.append(nxt)\n      else:\n          return None  # no path found\n\n      # reconstruct path\n      path = [goal]\n      while path[-1] != start:\n          path.append(came_from[path[-1]])\n      path.reverse()\n      return path\n\n  def _actions_from_path(path):\n      \"\"\"Translate a list of positions into action indices.\"\"\"\n      if not path or len(path) < 2:\n          return []\n      acts = []\n      for (x0, y0), (x1, y1) in zip(path, path[1:]):\n          if x1 == x0 + 1:\n              acts.append(DOWN)\n          elif x1 == x0 - 1:\n              acts.append(UP)\n          elif y1 == y0 + 1:\n              acts.append(RIGHT)\n          elif y1 == y0 - 1:\n              acts.append(LEFT)\n          else:\n              raise ValueError(\"Non\u2011adjacent steps in path\")\n      return acts\n\n  def _move_actions(src, dst):\n      \"\"\"Return actions to move from src to dst (BFS preferred, Manhattan fallback).\"\"\"\n      path = _bfs_path(src, dst)\n      if path is None:\n          # fallback: Manhattan moves (may collide with obstacles)\n          actions = []\n          x, y = src\n          tx, ty = dst\n          dx = tx - x\n          dy = ty - y\n          if dx > 0:\n              actions += [DOWN] * dx\n          elif dx < 0:\n              actions += [UP] * (-dx)\n          if dy > 0:\n              actions += [RIGHT] * dy\n          elif dy < 0:\n              actions += [LEFT] * (-dy)\n          return actions\n      return _actions_from_path(path)\n\n  def _nearest_kind(pos, kind_idx):\n      \"\"\"Find the nearest cell containing the given kind.\"\"\"\n      grid = _grid()\n      cells = np.argwhere(grid[:, :, kind_idx] > 0)\n      if cells.size == 0:\n          return None\n      dists = np.abs(cells[:, 0] - pos[0]) + np.abs(cells[:, 1] - pos[1])\n      nearest = cells[dists.argmin()]\n      return tuple(nearest.tolist())\n\n  # ------------------------------------------------------------------\n  # Plan: collect primitives then craft at the workshop (if any)\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = env._current_state.pos\n\n  for prim_idx, count in needed_prims.items():\n      for _ in range(count):\n          target = _nearest_kind(cur_pos, prim_idx)\n          if target is None:\n              # Primitive missing \u2013 abort planning\n              return actions\n          actions += _move_actions(cur_pos, target)\n          cur_pos = target\n          actions.append(USE)  # pick up primitive\n\n  # Move to workshop (if required) and craft the arrow\n  workshop_name = world.cookbook.recipes[arrow_idx].get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = _nearest_kind(cur_pos, workshop_idx)\n      if workshop_pos is not None:\n          actions += _move_actions(cur_pos, workshop_pos)\n          cur_pos = workshop_pos\n          actions.append(USE)   # craft at the workshop\n\n  return actions", "env_interactions": 24, "island_id": 5, "scores": {"3": 0.2}}
{"timestamp": "2025-10-27T19:45:25.818511", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow) and its recipe requirements\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = idx[goal_name]\n\n  # Primitive counts needed to craft one arrow (recursively expanded)\n  primitive_counts = world.cookbook.primitives_for(goal_idx)\n\n  # Workshop required for the final crafting step (if any)\n  workshop_kind = None\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else idx[wk]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def find_locations(kind):\n      \"\"\"Return list of (x, y) coordinates where `kind` currently exists.\"\"\"\n      occ = np.where(state.grid[:, :, kind] > 0)\n      return list(zip(occ[0].tolist(), occ[1].tolist()))\n\n  def bfs_path(start, goal):\n      \"\"\"Shortest Manhattan path avoiding non\u2011grabbable cells.\"\"\"\n      if start == goal:\n          return [start]\n      W, H = state.grid.shape[:2]\n\n      # Cells occupied by non\u2011grabbable entities are treated as blocked.\n      blocked = set()\n      for ng in world.non_grabbable_indices:\n          occ = np.where(state.grid[:, :, ng] > 0)\n          blocked.update(zip(occ[0].tolist(), occ[1].tolist()))\n\n      queue = collections.deque([start])\n      prev = {start: None}\n      while queue:\n          cur = queue.popleft()\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:\n                  nxt = (nx, ny)\n                  if nxt not in prev:\n                      prev[nxt] = cur\n                      if nxt == goal:\n                          # Reconstruct path\n                          path = [goal]\n                          while path[-1] != start:\n                              path.append(prev[path[-1]])\n                          path.reverse()\n                          return path\n                      queue.append(nxt)\n      # No path found \u2013 stay in place\n      return [start]\n\n  def move_action(cur, nxt):\n      \"\"\"Translate a step into an action index (DOWN=0, UP=1, LEFT=2, RIGHT=3).\"\"\"\n      dx = nxt[0] - cur[0]\n      dy = nxt[1] - cur[1]\n      if dx == 1:\n          return 3   # RIGHT\n      if dx == -1:\n          return 2   # LEFT\n      if dy == 1:\n          return 0   # DOWN\n      if dy == -1:\n          return 1   # UP\n      raise AssertionError(\"Requested move is not to an adjacent cell\")\n\n  # ------------------------------------------------------------------\n  # Build the action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = state.pos\n\n  # 1) Collect all required primitives\n  for prim_idx, needed in primitive_counts.items():\n      while state.inventory[prim_idx] < needed:\n          locations = find_locations(prim_idx)\n          if not locations:\n              # No more instances of this primitive on the map; abort collection.\n              break\n\n          # Choose the nearest instance (Manhattan distance)\n          target = min(\n              locations,\n              key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1])\n          )\n\n          # Move to the chosen primitive\n          path = bfs_path(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n\n          # Pick it up\n          actions.append(4)   # USE\n          state.inventory[prim_idx] += 1\n          state.grid[target[0], target[1], prim_idx] = 0\n\n  # 2) Move to the required workshop (if any) and craft\n  if workshop_kind is not None:\n      wk_locations = find_locations(workshop_kind)\n      if wk_locations:\n          target = min(\n              wk_locations,\n              key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1])\n          )\n          path = bfs_path(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n\n  # 3) Craft the arrow (USE at current location)\n  actions.append(4)   # USE\n\n  return actions", "env_interactions": 19, "island_id": 7, "scores": {"3": 1.5}}
