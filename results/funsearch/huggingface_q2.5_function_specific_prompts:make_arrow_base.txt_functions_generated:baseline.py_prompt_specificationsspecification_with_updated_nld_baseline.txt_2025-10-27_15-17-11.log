{"timestamp": "2025-10-27T19:54:13.579831", "function_name": "make_arrow", "function_body": "  # Reset environment and get current state/world references\n  env.reset()\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  # Goal: arrow\n  goal_name = \"arrow\"\n  goal_idx = idx[goal_name]\n\n  # Required primitives for one arrow\n  primitive_counts = world.cookbook.primitives_for(goal_idx)\n\n  # Determine workshop (if any) needed for crafting\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else idx[wk]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def find_locations(kind):\n      \"\"\"Return list of (x, y) positions where `kind` exists on the grid.\"\"\"\n      occ = np.where(state.grid[:, :, kind] > 0)\n      return list(zip(occ[0].tolist(), occ[1].tolist()))\n\n  def bfs_path(start, goal):\n      \"\"\"Shortest path from start to goal avoiding non\u2011grabbable cells.\"\"\"\n      if start == goal:\n          return [start]\n      W, H = state.grid.shape[:2]\n\n      # cells occupied by non\u2011grabbable entities are blocked\n      blocked = set()\n      for ng in world.non_grabbable_indices:\n          occ = np.where(state.grid[:, :, ng] > 0)\n          blocked.update(zip(occ[0].tolist(), occ[1].tolist()))\n\n      q = collections.deque([start])\n      prev = {start: None}\n      while q:\n          cur = q.popleft()\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:\n                  nxt = (nx, ny)\n                  if nxt not in prev:\n                      prev[nxt] = cur\n                      if nxt == goal:\n                          # reconstruct path\n                          path = [goal]\n                          while path[-1] != start:\n                              path.append(prev[path[-1]])\n                          path.reverse()\n                          return path\n                      q.append(nxt)\n      # No path found \u2013 stay put\n      return [start]\n\n  def move_action(cur, nxt):\n      \"\"\"Convert an adjacent step into an action index.\"\"\"\n      dx, dy = nxt[0] - cur[0], nxt[1] - cur[1]\n      if dx == 1:\n          return 3   # RIGHT\n      if dx == -1:\n          return 2   # LEFT\n      if dy == 1:\n          return 0   # DOWN\n      if dy == -1:\n          return 1   # UP\n      raise AssertionError(\"Requested move is not adjacent\")\n\n  # ------------------------------------------------------------------\n  # Build the action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = state.pos\n\n  # 1) Collect all required primitives\n  for prim_idx, needed in primitive_counts.items():\n      while state.inventory[prim_idx] < needed:\n          locations = find_locations(prim_idx)\n          if not locations:\n              # Primitive missing from the map \u2013 cannot proceed further\n              break\n          # Choose nearest primitive (Manhattan distance)\n          target = min(\n              locations,\n              key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1])\n          )\n          # Move to the chosen primitive\n          path = bfs_path(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n          # Pick it up\n          actions.append(4)   # USE\n          # Update simulated state\n          state.inventory[prim_idx] += 1\n          state.grid[target[0], target[1], prim_idx] = 0\n\n  # 2) Go to workshop (if required) and craft the arrow\n  if workshop_kind is not None:\n      wk_locs = find_locations(workshop_kind)\n      if wk_locs:\n          target = min(\n              wk_locs,\n              key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1])\n          )\n          path = bfs_path(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n      actions.append(4)   # USE to craft at workshop\n  else:\n      actions.append(4)   # USE to craft in place\n\n  return actions", "env_interactions": 19, "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T19:54:32.969834", "function_name": "make_arrow", "function_body": "  # Reset the environment and get handles to core objects\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.scenario.world           # CraftWorld\n  cookbook = world.cookbook            # Cookbook\n  index = cookbook.index               # name \u2194 id mapping\n\n  # Action identifiers\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow) and its index in the recipe book\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  if goal_name not in index.contents:\n      return []                       # arrow not defined in this world\n  goal_idx = index[goal_name]\n\n  # ------------------------------------------------------------------\n  # Determine which primitive resources are needed for a single arrow\n  # ------------------------------------------------------------------\n  primitive_needs = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Simple BFS path\u2011finder (4\u2011connected Manhattan moves)\n  # ------------------------------------------------------------------\n  def bfs(start, target):\n      \"\"\"Return a list of positions from start to target (inclusive).\n      Returns None if target is unreachable.\"\"\"\n      h, w = state.grid.shape[:2]\n      occupied = np.any(state.grid > 0, axis=2)          # True where any entity sits\n      occupied[target] = False                           # we may step onto target\n      q = collections.deque([start])\n      came_from = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          r, c = cur\n          for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nr, nc = r + dr, c + dc\n              if 0 <= nr < h and 0 <= nc < w and not occupied[nr, nc]:\n                  nxt = (nr, nc)\n                  if nxt not in came_from:\n                      came_from[nxt] = cur\n                      q.append(nxt)\n      else:\n          return None  # target never reached\n\n      # reconstruct path\n      path = []\n      cur = target\n      while cur is not None:\n          path.append(cur)\n          cur = came_from[cur]\n      path.reverse()\n      return path\n\n  # ------------------------------------------------------------------\n  # Map movement deltas to action indices\n  # ------------------------------------------------------------------\n  delta_to_action = {\n      (1, 0): DOWN,\n      (-1, 0): UP,\n      (0, 1): RIGHT,\n      (0, -1): LEFT,\n  }\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitive items\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          # Locate any remaining instance of this primitive on the grid\n          cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if cells.size == 0:\n              return actions  # cannot find needed primitive, abort planning\n\n          target = tuple(cells[0])  # (row, col)\n\n          # Compute a path to the primitive\n          path = bfs(state.pos, target)\n          if path is None:\n              return actions  # unreachable primitive\n\n          # Translate path steps into actions\n          for (r0, c0), (r1, c1) in zip(path, path[1:]):\n              act = delta_to_action[(r1 - r0, c1 - c0)]\n              actions.append(act)\n              state.pos = (r1, c1)\n\n          # Pick up the primitive\n          actions.append(USE)\n          state.inventory[prim_idx] += 1\n          state.grid[target[0], target[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 2. Move to the workshop and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      return actions  # No workshop information; cannot craft\n\n  workshop_idx = index[workshop_name]\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      return actions  # No workshop cell found on the map\n\n  workshop_pos = tuple(workshop_cells[0])\n\n  path = bfs(state.pos, workshop_pos)\n  if path is None:\n      return actions  # Workshop unreachable\n\n  for (r0, c0), (r1, c1) in zip(path, path[1:]):\n      act = delta_to_action[(r1 - r0, c1 - c0)]\n      actions.append(act)\n      state.pos = (r1, c1)\n\n  # Use the workshop to craft the arrow\n  actions.append(USE)\n\n  return actions", "env_interactions": 28, "island_id": 4, "scores": {"3": 2.0}}
{"timestamp": "2025-10-27T19:54:34.103356", "function_name": "make_arrow", "function_body": "  # Reset the environment and grab useful references\n  env.reset()\n  state = env._current_state          # CraftState instance\n  world = env.scenario.world          # CraftWorld instance\n  cookbook = world.cookbook           # Cookbook instance\n  index = cookbook.index              # Name \u2194 ID mapping\n\n  # Action identifiers (consistent with CraftLab)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Identify goal (arrow) and its primitive requirements\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  if goal_name not in index.contents:\n      return []                       # arrow not defined in this world\n  goal_idx = index[goal_name]\n\n  # primitives_for returns a dict {primitive_idx: count} needed for one arrow\n  primitive_needs = cookbook.primitives_for(goal_idx)\n\n  # ------------------------------------------------------------------\n  # Helper: simple BFS path\u2011finder on the current grid\n  # ------------------------------------------------------------------\n  def bfs(start, target):\n      \"\"\"Return a list of positions from start to target (inclusive),\n      or None if target is unreachable.\"\"\"\n      h, w = state.grid.shape[:2]\n      # Cells occupied by any entity block movement\n      occupied = np.any(state.grid > 0, axis=2)\n      # Allow stepping onto the target even if it is occupied (the item to pick up)\n      occupied[target] = False\n      q = collections.deque([start])\n      came_from = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          r, c = cur\n          for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nr, nc = r + dr, c + dc\n              if 0 <= nr < h and 0 <= nc < w and not occupied[nr, nc]:\n                  nxt = (nr, nc)\n                  if nxt not in came_from:\n                      came_from[nxt] = cur\n                      q.append(nxt)\n      else:\n          return None  # target never reached\n\n      # Reconstruct path\n      path = []\n      cur = target\n      while cur is not None:\n          path.append(cur)\n          cur = came_from[cur]\n      path.reverse()\n      return path\n\n  # Map movement deltas to action IDs\n  delta_to_action = {\n      (1, 0): DOWN,\n      (-1, 0): UP,\n      (0, 1): RIGHT,\n      (0, -1): LEFT,\n  }\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          # Find any remaining instance of this primitive on the map\n          cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if cells.size == 0:\n              # No more instances; abort planning\n              return actions\n          target = tuple(cells[0])\n\n          # Compute a path to the primitive\n          path = bfs(state.pos, target)\n          if path is None:\n              # Unreachable; abort planning\n              return actions\n\n          # Convert path steps into actions and update simulated position\n          for (r0, c0), (r1, c1) in zip(path, path[1:]):\n              act = delta_to_action[(r1 - r0, c1 - c0)]\n              actions.append(act)\n              state.pos = (r1, c1)\n\n          # Pick up the primitive\n          actions.append(USE)\n          state.inventory[prim_idx] += 1\n          state.grid[target[0], target[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 2. Move to the appropriate workshop and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      # No workshop requirement; just use at current location\n      actions.append(USE)\n      return actions\n\n  workshop_idx = index[workshop_name]\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      # No workshop cell found; abort\n      return actions\n  workshop_pos = tuple(workshop_cells[0])\n\n  path = bfs(state.pos, workshop_pos)\n  if path is None:\n      # Workshop unreachable; abort\n      return actions\n\n  for (r0, c0), (r1, c1) in zip(path, path[1:]):\n      act = delta_to_action[(r1 - r0, c1 - c0)]\n      actions.append(act)\n      state.pos = (r1, c1)\n\n  # Craft the arrow at the workshop\n  actions.append(USE)\n\n  return actions", "env_interactions": 28, "island_id": 4, "scores": {"3": 2.0}}
{"timestamp": "2025-10-27T19:55:03.630448", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ------------------------------------------------------------------\n  # Action constants (match CraftLab.action_specs)\n  # ------------------------------------------------------------------\n  # 0: DOWN, 1: UP, 2: LEFT, 3: RIGHT, 4: USE\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n  USE = 4\n\n  # ------------------------------------------------------------------\n  # Helper: BFS to a free cell adjacent to a target cell\n  # ------------------------------------------------------------------\n  def bfs_adjacent(start, target, blocked):\n      \"\"\"Return a list of actions moving from *start* to any free\n      4\u2011connected cell next to *target*. Empty list if unreachable.\"\"\"\n      h, w = blocked.shape\n      tx, ty = target\n      # admissible goal cells (free and adjacent)\n      goal_cells = []\n      for a, (dx, dy) in enumerate(DIRS):\n          gx, gy = tx + dx, ty + dy\n          if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:\n              goal_cells.append((gx, gy))\n      if not goal_cells:\n          return []\n\n      q = deque([(start, [])])\n      visited = {start}\n      while q:\n          (cx, cy), path = q.popleft()\n          if (cx, cy) in goal_cells:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []\n\n  # ------------------------------------------------------------------\n  # Reset environment and obtain the current state\n  # ------------------------------------------------------------------\n  try:\n      env.reset()\n  except Exception:\n      pass\n\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []                     # cannot obtain state\n\n  world = env.world\n  idx = world.cookbook.index\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow) and its recipe\n  # ------------------------------------------------------------------\n  try:\n      goal_idx = idx[\"arrow\"]\n  except Exception:\n      return []                     # arrow not defined in recipes\n\n  primitives_needed = world.cookbook.primitives_for(goal_idx)\n\n  # locate workshop name in the recipe (keys \"_at\" or \"_key\")\n  workshop_name = None\n  for k, v in world.cookbook.recipes.get(goal_idx, {}).items():\n      if k in (\"_at\", \"_key\"):\n          workshop_name = v\n          break\n  if workshop_name is None:\n      return []                     # recipe missing workshop info\n\n  try:\n      workshop_idx = idx[workshop_name]\n  except Exception:\n      return []                     # unknown workshop\n\n  # ------------------------------------------------------------------\n  # Mutable copies for planning (simulate pickups)\n  # ------------------------------------------------------------------\n  pos = tuple(state.pos)               # (x, y)\n  grid = state.grid.copy()             # (W, H, n_kinds)\n  inventory = state.inventory.copy()\n  occupied = np.any(grid > 0, axis=2)  # bool matrix of blocked cells\n\n  plan = []                             # final action list\n\n  # ------------------------------------------------------------------\n  # Helper: move adjacent to a cell containing *kind_idx* and USE it.\n  # Updates simulated world state.\n  # ------------------------------------------------------------------\n  def move_and_use(target, kind_idx):\n      \"\"\"Navigate to a free cell adjacent to *target*, issue USE and\n      update the simulated state. Returns False if movement impossible.\"\"\"\n      nonlocal pos, plan, grid, occupied, inventory\n      path = bfs_adjacent(pos, target, occupied)\n      if not path and pos != target:\n          return False\n\n      # execute movement actions\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n      plan.extend(path)\n\n      # USE action\n      plan.append(USE)\n\n      tx, ty = target\n      if grid[tx, ty, kind_idx] > 0:\n          # pick up one unit (ignore workshops)\n          grid[tx, ty, kind_idx] = 0\n          occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)\n          inventory[kind_idx] += 1\n      return True\n\n  # ------------------------------------------------------------------\n  # Collect all required primitives (respecting counts)\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in primitives_needed.items():\n      for _ in range(cnt):\n          locations = np.argwhere(grid[:, :, prim_idx] > 0)\n          if locations.shape[0] == 0:\n              # primitive missing \u2013 abort planning, return what we have\n              return plan\n          # choose the nearest by Manhattan distance\n          dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n          target = tuple(locations[dists.argmin()])\n          if not move_and_use(target, prim_idx):\n              return plan\n\n  # ------------------------------------------------------------------\n  # Move to a workshop cell and craft the arrow\n  # ------------------------------------------------------------------\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.shape[0] == 0:\n      # fall back to original grid (workshops are static)\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.shape[0] == 0:\n          return plan\n  dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])\n  workshop_target = tuple(workshop_cells[dists.argmin()])\n  move_and_use(workshop_target, workshop_idx)\n\n  return plan", "env_interactions": 23, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T19:55:04.770122", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ------------------------------------------------------------------\n  # Action constants (match CraftLab.action_specs)\n  # ------------------------------------------------------------------\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # DOWN, UP, LEFT, RIGHT\n  USE = 4\n\n  # ------------------------------------------------------------------\n  # Helper: BFS to a free cell adjacent to a target cell\n  # ------------------------------------------------------------------\n  def bfs_adjacent(start, target, blocked):\n      \"\"\"Return a list of action indices moving from *start* to a free\n      cell 4\u2011connected to *target*. Empty list if unreachable.\"\"\"\n      h, w = blocked.shape\n      tx, ty = target\n\n      # admissible goal cells (free and adjacent)\n      goal_cells = []\n      for a, (dx, dy) in enumerate(DIRS):\n          gx, gy = tx + dx, ty + dy\n          if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:\n              goal_cells.append((gx, gy))\n      if not goal_cells:\n          return []\n\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (cx, cy), path = q.popleft()\n          if (cx, cy) in goal_cells:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []\n\n  # ------------------------------------------------------------------\n  # Reset environment and obtain the current state\n  # ------------------------------------------------------------------\n  try:\n      env.reset()\n  except Exception:\n      pass\n\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []                     # cannot obtain a state\n\n  world = env.world\n  idx = world.cookbook.index\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow) and its recipe\n  # ------------------------------------------------------------------\n  try:\n      goal_idx = idx[\"arrow\"]\n  except Exception:\n      return []                     # arrow not defined\n\n  primitives_needed = world.cookbook.primitives_for(goal_idx)\n\n  # locate workshop name in the recipe (keys \"_at\" or \"_key\")\n  workshop_name = None\n  for k, v in world.cookbook.recipes.get(goal_idx, {}).items():\n      if k in (\"_at\", \"_key\"):\n          workshop_name = v\n          break\n  if workshop_name is None:\n      return []                     # recipe missing workshop info\n\n  try:\n      workshop_idx = idx[workshop_name]\n  except Exception:\n      return []                     # unknown workshop\n\n  # ------------------------------------------------------------------\n  # Mutable copies for planning (simulate pickups)\n  # ------------------------------------------------------------------\n  pos = tuple(state.pos)               # (x, y)\n  grid = state.grid.copy()             # (W, H, n_kinds)\n  inventory = state.inventory.copy()\n  occupied = np.any(grid > 0, axis=2)  # bool matrix of blocked cells\n\n  plan = []                             # final action list\n\n  # ------------------------------------------------------------------\n  # Helper: move adjacent to a cell containing *kind_idx* and USE it.\n  # Updates simulated world state.\n  # ------------------------------------------------------------------\n  def move_and_use(target, kind_idx):\n      \"\"\"Navigate to a free cell adjacent to *target*, issue USE and\n      update the simulated state. Returns False if movement impossible.\"\"\"\n      nonlocal pos, plan, grid, occupied, inventory\n      path = bfs_adjacent(pos, target, occupied)\n      if not path and pos != target:\n          return False\n\n      # execute movement actions\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n      plan.extend(path)\n\n      # USE action\n      plan.append(USE)\n\n      tx, ty = target\n      if grid[tx, ty, kind_idx] > 0:\n          # pick up one unit\n          grid[tx, ty, kind_idx] = 0\n          occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)\n          inventory[kind_idx] += 1\n      # if it's a workshop we just assume crafting will happen later\n      return True\n\n  # ------------------------------------------------------------------\n  # Collect all required primitives (respecting counts)\n  # ------------------------------------------------------------------\n  for prim_idx, count in primitives_needed.items():\n      for _ in range(count):\n          locations = np.argwhere(grid[:, :, prim_idx] > 0)\n          if locations.shape[0] == 0:\n              # primitive missing \u2013 abort planning\n              return plan\n          # choose closest by Manhattan distance\n          dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n          target = tuple(locations[dists.argmin()])\n          if not move_and_use(target, prim_idx):\n              return plan\n\n  # ------------------------------------------------------------------\n  # Move to a workshop cell and craft the arrow\n  # ------------------------------------------------------------------\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.shape[0] == 0:\n      # fallback to original static grid if workshops were cleared during collection\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.shape[0] == 0:\n          return plan\n  dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])\n  workshop_target = tuple(workshop_cells[dists.argmin()])\n  move_and_use(workshop_target, workshop_idx)\n\n  return plan", "env_interactions": 23, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T19:55:25.303701", "function_name": "make_arrow", "function_body": "  # Reset environment and get current state/world references\n  env.reset()\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  # ------------------------------------------------------------\n  # Identify goal (arrow) and its recipe requirements\n  # ------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = idx[goal_name]\n\n  # Primitive counts needed (recursively expanded)\n  primitive_counts = world.cookbook.primitives_for(goal_idx)\n\n  # Determine required workshop for final crafting step, if any\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else idx[wk]\n\n  # ------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------\n  def find_locations(kind):\n      \"\"\"Return list of (x, y) positions where `kind` is present on the grid.\"\"\"\n      occ = np.where(state.grid[:, :, kind] > 0)\n      return list(zip(occ[0].tolist(), occ[1].tolist()))\n\n  def bfs_path(start, goal):\n      \"\"\"Return shortest path (list of positions) from start to goal avoiding non\u2011grabbable cells.\"\"\"\n      if start == goal:\n          return [start]\n      W, H = state.grid.shape[:2]\n\n      # Build set of blocked cells (non\u2011grabbable entities)\n      blocked = set()\n      for ng in world.non_grabbable_indices:\n          occ = np.where(state.grid[:, :, ng] > 0)\n          blocked.update(zip(occ[0].tolist(), occ[1].tolist()))\n\n      queue = collections.deque([start])\n      prev = {start: None}\n      while queue:\n          cur = queue.popleft()\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:\n                  nxt = (nx, ny)\n                  if nxt not in prev:\n                      prev[nxt] = cur\n                      if nxt == goal:\n                          # Reconstruct path\n                          path = [goal]\n                          while path[-1] != start:\n                              path.append(prev[path[-1]])\n                          path.reverse()\n                          return path\n                      queue.append(nxt)\n      # No path found \u2013 stay in place\n      return [start]\n\n  def move_action(cur, nxt):\n      \"\"\"Translate a step from cur to adjacent nxt into an action index.\"\"\"\n      dx = nxt[0] - cur[0]\n      dy = nxt[1] - cur[1]\n      if dx == 1:\n          return 3   # RIGHT\n      if dx == -1:\n          return 2   # LEFT\n      if dy == 1:\n          return 0   # DOWN\n      if dy == -1:\n          return 1   # UP\n      raise AssertionError(\"Non\u2011adjacent movement requested\")\n\n  # ------------------------------------------------------------\n  # Build the action sequence\n  # ------------------------------------------------------------\n  actions = []\n  cur_pos = state.pos\n\n  # 1) Collect all required primitives\n  for prim_idx, needed in primitive_counts.items():\n      while state.inventory[prim_idx] < needed:\n          locations = find_locations(prim_idx)\n          if not locations:\n              # No more instances of this primitive on the map \u2013 abort.\n              break\n\n          # Choose nearest instance (Manhattan distance)\n          target = min(\n              locations,\n              key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1])\n          )\n\n          # Move to the primitive\n          path = bfs_path(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n\n          # Pick it up\n          actions.append(4)   # USE\n          # Update planning snapshot (inventory & grid)\n          state.inventory[prim_idx] += 1\n          state.grid[target[0], target[1], prim_idx] = 0\n\n  # 2) Move to required workshop (if any)\n  if workshop_kind is not None:\n      wk_locs = find_locations(workshop_kind)\n      if wk_locs:\n          target = min(\n              wk_locs,\n              key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1])\n          )\n          path = bfs_path(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n\n  # 3) Craft the arrow (USE at current location)\n  actions.append(4)   # USE\n\n  return actions", "env_interactions": 19, "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T19:55:26.437744", "function_name": "make_arrow", "function_body": "  # Reset environment and obtain the current state/world objects\n  env.reset()\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow) and its recipe requirements\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = idx[goal_name]\n\n  # Primitive counts needed to craft one arrow (recursively expanded)\n  primitive_counts = world.cookbook.primitives_for(goal_idx)\n\n  # Workshop required for the final crafting step (if any)\n  workshop_kind = None\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else idx[wk]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def find_locations(kind):\n      \"\"\"Return a list of (x, y) positions where `kind` currently exists.\"\"\"\n      occ = np.where(state.grid[:, :, kind] > 0)\n      return list(zip(occ[0].tolist(), occ[1].tolist()))\n\n  def bfs_path(start, goal):\n      \"\"\"Return a shortest Manhattan path (list of positions) avoiding\n      non\u2011grabbable cells. If no path exists, returns [start].\"\"\"\n      if start == goal:\n          return [start]\n      W, H = state.grid.shape[:2]\n\n      # Cells occupied by non\u2011grabbable entities are treated as blocked.\n      blocked = set()\n      for ng in world.non_grabbable_indices:\n          occ = np.where(state.grid[:, :, ng] > 0)\n          blocked.update(zip(occ[0].tolist(), occ[1].tolist()))\n\n      queue = collections.deque([start])\n      prev = {start: None}\n      while queue:\n          cur = queue.popleft()\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:\n                  nxt = (nx, ny)\n                  if nxt not in prev:\n                      prev[nxt] = cur\n                      if nxt == goal:\n                          # Reconstruct path\n                          path = [goal]\n                          while path[-1] != start:\n                              path.append(prev[path[-1]])\n                          path.reverse()\n                          return path\n                      queue.append(nxt)\n      # No path found \u2013 stay where we are\n      return [start]\n\n  def move_action(cur, nxt):\n      \"\"\"Translate a step from `cur` to adjacent `nxt` into an action index.\"\"\"\n      dx = nxt[0] - cur[0]\n      dy = nxt[1] - cur[1]\n      if dx == 1:\n          return 3   # RIGHT\n      if dx == -1:\n          return 2   # LEFT\n      if dy == 1:\n          return 0   # DOWN\n      if dy == -1:\n          return 1   # UP\n      raise AssertionError(\"Requested move is not to an adjacent cell\")\n\n  # ------------------------------------------------------------------\n  # Build the action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = state.pos\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitive_counts.items():\n      while state.inventory[prim_idx] < needed:\n          locations = find_locations(prim_idx)\n          if not locations:\n              # Primitive not present anywhere \u2013 cannot proceed further.\n              break\n\n          # Choose the nearest instance (Manhattan distance)\n          target = min(\n              locations,\n              key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1])\n          )\n\n          # Move to the chosen primitive\n          path = bfs_path(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n\n          # Pick it up\n          actions.append(4)   # USE\n          # Update our planning snapshot of inventory and grid\n          state.inventory[prim_idx] += 1\n          state.grid[target[0], target[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 2) Move to the required workshop (if any) and craft\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      wk_locations = find_locations(workshop_kind)\n      if wk_locations:\n          target = min(\n              wk_locations,\n              key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1])\n          )\n          path = bfs_path(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n\n  # ------------------------------------------------------------------\n  # 3) Craft the arrow (USE at current location)\n  # ------------------------------------------------------------------\n  actions.append(4)   # USE\n\n  return actions", "env_interactions": 19, "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T19:55:54.154605", "function_name": "make_arrow", "function_body": "  # Initialise environment and retrieve world information\n  env.reset()\n  state = env._current_state          # CraftState instance\n  world = env.world\n  cookbook = world.cookbook\n\n  # Identify the goal (arrow) and its recipe\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n  if goal_idx is None:\n      return []                      # unknown goal, nothing to do\n\n  primitive_needs = cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  if \"_at\" in recipe:\n      workshop_idx = cookbook.index[recipe[\"_at\"]]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  from collections import deque\n  import numpy as np\n\n  def bfs_path(start, goal, occupied):\n      \"\"\"Return a list of positions from start (excluded) to goal (included)\n      moving only through cells where `occupied` is False. Goal cell may be occupied.\"\"\"\n      w, h = occupied.shape\n      visited = np.zeros((w, h), dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start] = True\n      while q:\n          x, y = q.popleft()\n          if (x, y) == goal:\n              break\n          for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):\n              if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:\n                  # Goal cell may be occupied; treat it as walkable.\n                  if (nx, ny) == goal or not occupied[nx, ny]:\n                      visited[nx, ny] = True\n                      prev[(nx, ny)] = (x, y)\n                      q.append((nx, ny))\n      if not visited[goal]:\n          return None\n      # reconstruct path (exclude start, include goal)\n      path = []\n      cur = goal\n      while cur != start:\n          path.append(cur)\n          cur = prev[cur]\n      path.reverse()\n      return path\n\n  def delta_to_action(dx, dy):\n      \"\"\"Convert a movement delta into the corresponding action index.\"\"\"\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise ValueError(\"Invalid movement delta\")\n\n  # ------------------------------------------------------------------\n  # Planning state\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = tuple(state.pos)          # (x, y)\n  # mutable copy of the grid to keep track of which primitives have been collected\n  grid = state.grid.copy()\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitive resources\n  # ------------------------------------------------------------------\n  for kind_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          # locate remaining instances of the primitive\n          locations = np.argwhere(grid[:, :, kind_idx] > 0)\n          if locations.size == 0:\n              break  # nothing left of this kind\n\n          # order candidates by Manhattan distance from current position\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n\n          occupied_mask = np.any(grid, axis=2)   # any entity blocks movement\n          target = None\n          path = None\n          for idx in order:\n              cand = tuple(locations[idx])\n              p = bfs_path(cur_pos, cand, occupied_mask)\n              if p is not None:\n                  target = cand\n                  path = p\n                  break\n\n          if target is None:\n              # cannot reach any remaining instance; abort further collection of this kind\n              break\n\n          # follow the path to the primitive\n          for step in path:\n              dx = step[0] - cur_pos[0]\n              dy = step[1] - cur_pos[1]\n              actions.append(delta_to_action(dx, dy))\n              cur_pos = step\n\n          # pick up the primitive\n          actions.append(4)          # USE\n          grid[target[0], target[1], kind_idx] = 0   # mark as collected\n\n  # ------------------------------------------------------------------\n  # 2) Move to the required workshop (if any) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      # locate workshop cells (they are static in the original grid)\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size:\n          dists = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n          occupied_mask = np.any(state.grid, axis=2)   # original occupancy (workshops block movement)\n          for idx in order:\n              w_target = tuple(workshop_cells[idx])\n              w_path = bfs_path(cur_pos, w_target, occupied_mask)\n              if w_path is not None:\n                  for step in w_path:\n                      dx = step[0] - cur_pos[0]\n                      dy = step[1] - cur_pos[1]\n                      actions.append(delta_to_action(dx, dy))\n                      cur_pos = step\n                  actions.append(4)   # USE to trigger crafting at workshop\n                  break\n  else:\n      # No specific workshop required \u2013 craft at current location.\n      actions.append(4)   # USE\n\n  return actions", "env_interactions": 26, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T19:55:55.277493", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n  if goal_idx is None:\n      return []\n\n  primitive_needs = cookbook.primitives_for(goal_idx)          # {kind_idx: count}\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  if \"_at\" in recipe:\n      workshop_idx = cookbook.index[recipe[\"_at\"]]\n\n  from collections import deque\n  import numpy as np\n\n  def bfs_path(start, goal, occupied):\n      \"\"\"Return a walkable path (list of positions) from start (excluded) to goal (included).\"\"\"\n      w, h = occupied.shape\n      visited = np.zeros((w, h), dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start] = True\n      while q:\n          x, y = q.popleft()\n          if (x, y) == goal:\n              break\n          for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):\n              if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:\n                  if (nx, ny) == goal or not occupied[nx, ny]:\n                      visited[nx, ny] = True\n                      prev[(nx, ny)] = (x, y)\n                      q.append((nx, ny))\n      if not visited[goal]:\n          return None\n      path = []\n      cur = goal\n      while cur != start:\n          path.append(cur)\n          cur = prev[cur]\n      path.reverse()\n      return path\n\n  def delta_to_action(dx, dy):\n      \"\"\"Map a movement delta to the environment's action index.\"\"\"\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise ValueError(\"Invalid movement delta\")\n\n  actions = []\n  cur_pos = tuple(state.pos)          # (x, y)\n  grid = state.grid.copy()            # mutable copy to track remaining primitives\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitive resources.\n  # ------------------------------------------------------------------\n  for kind_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          locations = np.argwhere(grid[:, :, kind_idx] > 0)\n          if locations.size == 0:\n              break  # none left\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n\n          occupied_mask = np.any(grid, axis=2)   # treat any entity as blocked\n          target = None\n          path = None\n          for idx in order:\n              cand = tuple(locations[idx])\n              p = bfs_path(cur_pos, cand, occupied_mask)\n              if p is not None:\n                  target = cand\n                  path = p\n                  break\n          if target is None:\n              break  # cannot reach any remaining instance\n\n          for step in path:\n              dx = step[0] - cur_pos[0]\n              dy = step[1] - cur_pos[1]\n              actions.append(delta_to_action(dx, dy))\n              cur_pos = step\n          actions.append(4)                     # USE\n          grid[target[0], target[1], kind_idx] = 0   # mark as collected\n\n  # ------------------------------------------------------------------\n  # 2) Move to the required workshop (if any) and craft the arrow.\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size:\n          dists = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n          occupied_mask = np.any(state.grid, axis=2)   # original occupancy (workshops block)\n          for idx in order:\n              w_target = tuple(workshop_cells[idx])\n              w_path = bfs_path(cur_pos, w_target, occupied_mask)\n              if w_path is not None:\n                  for step in w_path:\n                      dx = step[0] - cur_pos[0]\n                      dy = step[1] - cur_pos[1]\n                      actions.append(delta_to_action(dx, dy))\n                      cur_pos = step\n                  actions.append(4)   # USE to trigger crafting\n                  break\n  else:\n      actions.append(4)   # USE (craft at current location)\n\n  return actions", "env_interactions": 26, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T19:56:14.469209", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action indices (as defined in CraftWorld)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, 1, RIGHT), (0, -1, LEFT)]\n\n  world = env.world\n  grid = env._current_state.grid.copy()\n  cur_pos = env._current_state.pos\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions from start to goal.\n  # Cells with any entity are treated as obstacles, except the goal cell.\n  # ----------------------------------------------------------------------\n  def bfs(start, goal):\n      if start == goal:\n          return []\n      h, w = grid.shape[:2]\n      visited = np.zeros((h, w), dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start] = True\n      while q:\n          x, y = q.popleft()\n          for dx, dy, act in DIRS:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < h and 0 <= ny < w and not visited[nx, ny]:\n                  # allow stepping onto the goal even if occupied\n                  if (nx, ny) != goal and grid[nx, ny, :].sum() > 0:\n                      continue\n                  visited[nx, ny] = True\n                  prev[(nx, ny)] = ((x, y), act)\n                  if (nx, ny) == goal:\n                      # reconstruct path\n                      path = []\n                      cur = goal\n                      while cur != start:\n                          (p, a) = prev[cur]\n                          path.append(a)\n                          cur = p\n                      path.reverse()\n                      return path\n                  q.append((nx, ny))\n      return None  # unreachable\n\n  # ----------------------------------------------------------------------\n  # Helper: find nearest cell containing a given kind (by BFS distance)\n  # ----------------------------------------------------------------------\n  def nearest_entity(start, kind_idx):\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      best_path = None\n      best_loc = None\n      for loc in locations:\n          loc_tup = (int(loc[0]), int(loc[1]))\n          path = bfs(start, loc_tup)\n          if path is None:\n              continue\n          if best_path is None or len(path) < len(best_path):\n              best_path = path\n              best_loc = loc_tup\n      return best_loc, best_path\n\n  # ----------------------------------------------------------------------\n  # Determine what primitives are needed to craft an arrow\n  # ----------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed = world.cookbook.primitives_for(arrow_idx)  # {prim_idx: count}\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive\n  # ----------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target, path = nearest_entity(cur_pos, prim_idx)\n          if target is None or path is None:\n              # cannot reach required primitive \u2013 abort planning\n              return actions\n          actions.extend(path)\n          actions.append(USE)          # pick up the primitive\n          cur_pos = target\n          # update planning grid: remove one instance of the primitive\n          if grid[target[0], target[1], prim_idx] > 0:\n              grid[target[0], target[1], prim_idx] -= 1\n\n  # ----------------------------------------------------------------------\n  # If the recipe specifies a workshop, move there and craft\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos, path = nearest_entity(cur_pos, workshop_idx)\n      if workshop_pos is not None and path is not None:\n          actions.extend(path)\n          actions.append(USE)      # craft at the workshop\n          cur_pos = workshop_pos\n\n  return actions", "env_interactions": 26, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T19:56:15.598096", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action indices (consistent with CraftWorld)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, 1, RIGHT), (0, -1, LEFT)]\n\n  world = env.world\n  # Index of the target item (arrow)\n  target_idx = world.cookbook.index.index('arrow')\n  # Primitive requirements for a single arrow\n  primitives_needed = world.cookbook.primitives_for(target_idx)\n\n  # Current mutable planning state\n  cur_pos = env._current_state.pos\n  grid = env._current_state.grid.copy()\n  actions = []\n\n  def bfs(start, goal):\n      \"\"\"Return a list of actions moving from start to goal.\n      Cells with any entity are treated as obstacles, except the goal cell itself.\"\"\"\n      if start == goal:\n          return []\n      H, W = grid.shape[:2]\n      visited = np.zeros((H, W), dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start] = True\n      while q:\n          x, y = q.popleft()\n          for dx, dy, act in DIRS:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < H and 0 <= ny < W and not visited[nx, ny]:\n                  # Allow stepping onto the goal even if occupied\n                  if (nx, ny) != goal and grid[nx, ny, :].sum() > 0:\n                      continue\n                  visited[nx, ny] = True\n                  prev[(nx, ny)] = ((x, y), act)\n                  if (nx, ny) == goal:\n                      # reconstruct path\n                      path = []\n                      cur = goal\n                      while cur != start:\n                          (p, a) = prev[cur]\n                          path.append(a)\n                          cur = p\n                      path.reverse()\n                      return path\n                  q.append((nx, ny))\n      return None  # unreachable\n\n  def nearest_entity(pos, kind_idx):\n      \"\"\"Find the nearest cell containing an entity of kind_idx.\n      Returns (location, path) where path is a list of actions from pos to location.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      best_path = None\n      best_loc = None\n      for loc in locations:\n          loc_tup = (int(loc[0]), int(loc[1]))\n          path = bfs(pos, loc_tup)\n          if path is None:\n              continue\n          if best_path is None or len(path) < len(best_path):\n              best_path = path\n              best_loc = loc_tup\n      return best_loc, best_path\n\n  # ------------------------------------------------------------------\n  # Collect all required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, count in primitives_needed.items():\n      for _ in range(count):\n          target, path = nearest_entity(cur_pos, prim_idx)\n          if target is None:\n              # Primitive not reachable \u2013 abort planning\n              return actions\n          actions.extend(path)\n          actions.append(USE)          # pick up the primitive\n          cur_pos = target\n          # Update planning grid: consume one instance of the primitive\n          if grid[target[0], target[1], prim_idx] > 0:\n              grid[target[0], target[1], prim_idx] -= 1\n\n  # ------------------------------------------------------------------\n  # Move to the workshop (if the recipe specifies one) and craft\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(target_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos, path = nearest_entity(cur_pos, workshop_idx)\n      if workshop_pos is not None:\n          actions.extend(path)\n          actions.append(USE)      # craft at the workshop\n          cur_pos = workshop_pos\n\n  return actions", "env_interactions": 26, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T19:56:33.552977", "function_name": "make_arrow", "function_body": "  # Reset environment and obtain references\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.scenario.world          # CraftWorld\n  cookbook = world.cookbook           # Cookbook\n  index = cookbook.index               # name \u2194 integer id mapping\n\n  # Resolve action indices from the environment specification\n  action_map = env.action_specs()\n  DOWN = action_map.get(\"DOWN\", 0)\n  UP = action_map.get(\"UP\", 1)\n  LEFT = action_map.get(\"LEFT\", 2)\n  RIGHT = action_map.get(\"RIGHT\", 3)\n  USE = action_map.get(\"USE\", 4)\n\n  # Goal item name\n  goal_name = \"arrow\"\n  if goal_name not in index.contents:\n      return []                       # Arrow not defined in this world\n  goal_idx = index[goal_name]\n\n  # Primitive requirements for the goal (primitive index \u2192 count)\n  primitive_needs = cookbook.primitives_for(goal_idx)\n\n  actions = []                         # Final action sequence\n\n  from collections import deque\n\n  def _bfs_path(start, target):\n      \"\"\"Return a list of movement actions from start to target using BFS.\n      Cells occupied by any entity are treated as obstacles, except the target cell.\n      \"\"\"\n      if start == target:\n          return []\n      h, w = state.grid.shape[:2]\n      moves = [(DOWN, (1, 0)),\n               (UP, (-1, 0)),\n               (LEFT, (0, -1)),\n               (RIGHT, (0, 1))]\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          for act, (dr, dc) in moves:\n              nr, nc = cur[0] + dr, cur[1] + dc\n              if not (0 <= nr < h and 0 <= nc < w):\n                  continue\n              nxt = (nr, nc)\n              # Occupied cells block movement unless they are the target.\n              if nxt != target and state.grid[nr, nc, :].sum() != 0:\n                  continue\n              if nxt in visited:\n                  continue\n              visited.add(nxt)\n              parent[nxt] = (cur, act)\n              q.append(nxt)\n\n      if target not in parent and start != target:\n          return []   # No path found\n\n      # Reconstruct action sequence\n      path = []\n      cur = target\n      while cur != start:\n          prev, act = parent[cur]\n          path.append(act)\n          cur = prev\n      path.reverse()\n      return path\n\n  # ------------------------------------------------------------------\n  # 1. Collect required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          # Find all cells containing this primitive\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # Primitive missing; abort early\n              return actions\n\n          # Choose the nearest primitive (Manhattan distance)\n          dists = np.abs(prim_cells - np.array(state.pos)).sum(axis=1)\n          tr, tc = prim_cells[dists.argmin()]\n\n          # Move to the primitive cell\n          move_seq = _bfs_path(state.pos, (tr, tc))\n          actions.extend(move_seq)\n          state.pos = (tr, tc)\n\n          # Pick it up\n          actions.append(USE)\n          state.inventory[prim_idx] += 1\n          state.grid[tr, tc, prim_idx] = 0   # Cell becomes empty\n\n  # ------------------------------------------------------------------\n  # 2. Go to the appropriate workshop and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      return actions                     # No workshop info; cannot craft\n\n  workshop_idx = index[workshop_name]\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      return actions                     # Workshop not present in this scenario\n\n  # Choose the nearest workshop cell\n  dists = np.abs(workshop_cells - np.array(state.pos)).sum(axis=1)\n  wr, wc = workshop_cells[dists.argmin()]\n\n  # Move to the workshop\n  move_seq = _bfs_path(state.pos, (wr, wc))\n  actions.extend(move_seq)\n  state.pos = (wr, wc)\n\n  # Craft the arrow\n  actions.append(USE)\n\n  return actions", "env_interactions": 24, "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T19:56:34.681905", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.scenario.world\n  cookbook = world.cookbook\n  index = cookbook.index\n\n  # Resolve action indices dynamically\n  action_map = env.action_specs()\n  DOWN = action_map[\"DOWN\"]\n  UP = action_map[\"UP\"]\n  LEFT = action_map[\"LEFT\"]\n  RIGHT = action_map[\"RIGHT\"]\n  USE = action_map[\"USE\"]\n\n  # Goal item\n  goal_name = \"arrow\"\n  if goal_name not in index.contents:\n      return []  # Arrow not defined in this world\n  goal_idx = index[goal_name]\n\n  # Primitive requirements for the goal\n  primitive_needs = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n  actions = []\n\n  from collections import deque\n\n  def _bfs_path(start, target):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) from start to target.\n      Cells occupied by any entity are treated as obstacles, except the target cell itself.\n      \"\"\"\n      if start == target:\n          return []\n      h, w = state.grid.shape[:2]\n      moves = [(DOWN, (1, 0)),\n               (UP, (-1, 0)),\n               (LEFT, (0, -1)),\n               (RIGHT, (0, 1))]\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          for act, (dr, dc) in moves:\n              nr, nc = cur[0] + dr, cur[1] + dc\n              if not (0 <= nr < h and 0 <= nc < w):\n                  continue\n              nxt = (nr, nc)\n              # Occupied cells block movement unless they are the target.\n              if nxt != target and state.grid[nr, nc, :].sum() != 0:\n                  continue\n              if nxt in visited:\n                  continue\n              visited.add(nxt)\n              parent[nxt] = (cur, act)\n              q.append(nxt)\n      if target not in parent and start != target:\n          return []  # Unreachable\n      # Reconstruct path\n      path = []\n      cur = target\n      while cur != start:\n          prev, act = parent[cur]\n          path.append(act)\n          cur = prev\n      path.reverse()\n      return path\n\n  # ------------------------------------------------------------------\n  # 1. Collect each required primitive the needed number of times.\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              return actions  # Primitive missing; abort early\n          dists = np.abs(prim_cells - np.array(state.pos)).sum(axis=1)\n          tr, tc = prim_cells[dists.argmin()]\n\n          # Move to the primitive cell\n          move_seq = _bfs_path(state.pos, (tr, tc))\n          actions.extend(move_seq)\n          state.pos = (tr, tc)\n\n          # Pick it up\n          actions.append(USE)\n          state.inventory[prim_idx] += 1\n          state.grid[tr, tc, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 2. Go to the workshop and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      return actions  # No workshop info; cannot craft\n\n  workshop_idx = index[workshop_name]\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      return actions  # Workshop not present\n\n  dists = np.abs(workshop_cells - np.array(state.pos)).sum(axis=1)\n  wr, wc = workshop_cells[dists.argmin()]\n\n  move_seq = _bfs_path(state.pos, (wr, wc))\n  actions.extend(move_seq)\n  state.pos = (wr, wc)\n\n  # Craft the arrow\n  actions.append(USE)\n\n  return actions", "env_interactions": 24, "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T19:56:55.507426", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  actions = []\n  cur_pos = env._current_state.pos\n  # Work on a mutable copy of the grid so we can mark collected items as empty\n  grid = env._current_state.grid.copy()\n  world = env.world\n\n  # ------------------------------------------------------------------\n  # Helpers\n  # ------------------------------------------------------------------\n  def _bfs(start, goal, target_idx):\n      \"\"\"Breadth\u2011first search returning a list of actions (using the\n      DOWN/UP/RIGHT/LEFT constants) that moves from start to goal.\n      Cells that contain any entity are treated as blocked, except the\n      goal cell when it holds the desired target_idx.\"\"\"\n      from collections import deque\n\n      w, h = grid.shape[0], grid.shape[1]\n      visited = set()\n      prev = {}          # (x, y) -> (prev_x, prev_y, action)\n      q = deque([start])\n      visited.add(start)\n\n      # direction vectors aligned with action indices\n      dirs = [(1, 0, DOWN), (-1, 0, UP), (0, 1, RIGHT), (0, -1, LEFT)]\n\n      while q:\n          x, y = q.popleft()\n          if (x, y) == goal:\n              break\n          for dx, dy, act in dirs:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  blocked = (grid[nx, ny, :] > 0).any()\n                  # Allow stepping onto the goal even if it is otherwise blocked,\n                  # provided it contains the required target entity.\n                  if blocked and not (nx == goal[0] and ny == goal[1] and grid[nx, ny, target_idx] > 0):\n                      continue\n                  visited.add((nx, ny))\n                  prev[(nx, ny)] = (x, y, act)\n                  q.append((nx, ny))\n\n      if goal not in prev and start != goal:\n          return None\n\n      # Reconstruct action list\n      path = []\n      cur = goal\n      while cur != start:\n          px, py, act = prev[cur]\n          path.append(act)\n          cur = (px, py)\n      path.reverse()\n      return path\n\n  def _nearest_entity(pos, kind_idx):\n      \"\"\"Find the Manhattan\u2011closest cell (including current) that contains kind_idx.\"\"\"\n      locs = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - pos[0]) + np.abs(locs[:, 1] - pos[1])\n      best = int(np.argmin(dists))\n      return tuple(locs[best])\n\n  # ------------------------------------------------------------------\n  # Determine recipe for \"arrow\"\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  primitives_needed = world.cookbook.primitives_for(arrow_idx)  # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Collect required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, count in primitives_needed.items():\n      for _ in range(count):\n          target = _nearest_entity(cur_pos, prim_idx)\n          if target is None:\n              # Primitive missing \u2013 abort early\n              return actions\n          path = _bfs(cur_pos, target, prim_idx)\n          if path is None:\n              # No traversable path \u2013 abort early\n              return actions\n          actions.extend(path)\n          actions.append(USE)          # pick up the primitive\n          # Mark the primitive as collected in our local grid copy\n          grid[target[0], target[1], prim_idx] -= 1\n          cur_pos = target\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = _nearest_entity(cur_pos, workshop_idx)\n      if workshop_pos is not None:\n          path = _bfs(cur_pos, workshop_pos, workshop_idx)\n          if path is not None:\n              actions.extend(path)\n              actions.append(USE)      # craft at the workshop\n\n  return actions", "env_interactions": 24, "island_id": 0, "scores": {"3": 0.2}}
{"timestamp": "2025-10-27T19:56:56.634969", "function_name": "make_arrow", "function_body": "  # Action identifiers\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def _manhattan_path(src, dst):\n      \"\"\"Return a list of actions that move from src to dst using Manhattan moves.\"\"\"\n      actions = []\n      x, y = src\n      tx, ty = dst\n      dx = tx - x\n      dy = ty - y\n      if dx > 0:\n          actions.extend([DOWN] * dx)\n      elif dx < 0:\n          actions.extend([UP] * (-dx))\n      if dy > 0:\n          actions.extend([RIGHT] * dy)\n      elif dy < 0:\n          actions.extend([LEFT] * (-dy))\n      return actions\n\n  def _nearest_entity(pos, kind_idx):\n      \"\"\"Find the nearest cell (including current) that contains the given kind.\"\"\"\n      grid = env._current_state.grid\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n      best = int(np.argmin(dists))\n      return tuple(locations[best])\n\n  # ------------------------------------------------------------------\n  # Identify goal ('arrow') and its recipe\n  # ------------------------------------------------------------------\n  world = env.world\n  arrow_idx = world.cookbook.index.index('arrow')\n  primitives_needed = world.cookbook.primitives_for(arrow_idx)  # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Collect required primitives\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = env._current_state.pos\n\n  for prim_idx, count in primitives_needed.items():\n      for _ in range(count):\n          target = _nearest_entity(cur_pos, prim_idx)\n          if target is None:\n              # Primitive not present in the world \u2013 abort early\n              return actions\n          actions.extend(_manhattan_path(cur_pos, target))\n          cur_pos = target\n          actions.append(USE)   # pick up the primitive\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if any) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = _nearest_entity(cur_pos, workshop_idx)\n      if workshop_pos is not None:\n          actions.extend(_manhattan_path(cur_pos, workshop_pos))\n          cur_pos = workshop_pos\n          actions.append(USE)   # craft at the workshop\n\n  return actions", "env_interactions": 22, "island_id": 0, "scores": {"3": 0.2}}
{"timestamp": "2025-10-27T19:57:16.440348", "function_name": "make_arrow", "function_body": "  # Reset the environment and fetch useful handles.\n  env.reset()\n  state = env._current_state               # CraftState\n  world = env.scenario.world               # CraftWorld\n  cookbook = world.cookbook                # Cookbook\n  index = cookbook.index                   # name \u2194 integer id mapping\n\n  # Resolve action indices (fallback to default ordering if not provided).\n  action_map = env.action_specs()\n  DOWN = action_map.get(\"DOWN\", 0)\n  UP = action_map.get(\"UP\", 1)\n  LEFT = action_map.get(\"LEFT\", 2)\n  RIGHT = action_map.get(\"RIGHT\", 3)\n  USE = action_map.get(\"USE\", 4)\n\n  # ------------------------------------------------------------------\n  # Identify the target item (arrow) and the primitive ingredients required.\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  if goal_name not in index.contents:\n      return []                     # Arrow not defined in this world.\n\n  goal_idx = index[goal_name]\n  primitive_needs = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n  actions = []  # accumulated action sequence\n\n  from collections import deque\n\n  def _bfs_path(start, target):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) from start to target.\n      Cells occupied by any entity are treated as obstacles, except the target cell.\n      \"\"\"\n      if start == target:\n          return []\n      h, w = state.grid.shape[:2]\n      moves = [(DOWN, (1, 0)),\n               (UP, (-1, 0)),\n               (LEFT, (0, -1)),\n               (RIGHT, (0, 1))]\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          for act, (dr, dc) in moves:\n              nr, nc = cur[0] + dr, cur[1] + dc\n              if not (0 <= nr < h and 0 <= nc < w):\n                  continue\n              nxt = (nr, nc)\n              # Allow stepping onto the target even if occupied.\n              if nxt != target and state.grid[nr, nc, :].sum() != 0:\n                  continue\n              if nxt in visited:\n                  continue\n              visited.add(nxt)\n              parent[nxt] = (cur, act)\n              q.append(nxt)\n\n      if target not in parent and start != target:\n          return []  # No path found.\n\n      # Reconstruct path.\n      path = []\n      cur = target\n      while cur != start:\n          prev, act = parent[cur]\n          path.append(act)\n          cur = prev\n      path.reverse()\n      return path\n\n  # ------------------------------------------------------------------\n  # Phase 1: Collect each required primitive the needed number of times.\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          # Locate all cells currently holding this primitive.\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # Primitive missing; abort early.\n              return actions\n\n          # Choose the nearest primitive cell (Manhattan distance).\n          dists = np.abs(prim_cells - np.array(state.pos)).sum(axis=1)\n          tr, tc = prim_cells[dists.argmin()]\n\n          # Move to the primitive cell.\n          move_seq = _bfs_path(state.pos, (tr, tc))\n          actions.extend(move_seq)\n          state.pos = (tr, tc)\n\n          # Pick it up.\n          actions.append(USE)\n\n          # Update our internal copy of the state.\n          state.inventory[prim_idx] += 1\n          state.grid[tr, tc, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Phase 2: Go to the appropriate workshop and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      return actions                     # No workshop info; cannot craft.\n\n  workshop_idx = index[workshop_name]\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      return actions                     # Workshop not present.\n\n  # Choose the nearest workshop cell.\n  dists = np.abs(workshop_cells - np.array(state.pos)).sum(axis=1)\n  wr, wc = workshop_cells[dists.argmin()]\n\n  # Move to the workshop.\n  move_seq = _bfs_path(state.pos, (wr, wc))\n  actions.extend(move_seq)\n  state.pos = (wr, wc)\n\n  # Craft the arrow.\n  actions.append(USE)\n\n  return actions", "env_interactions": 24, "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T19:57:17.580291", "function_name": "make_arrow", "function_body": "  # Reset environment and fetch useful objects.\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.scenario.world\n  cookbook = world.cookbook\n  index = cookbook.index\n\n  # Resolve action identifiers from the environment.\n  action_map = env.action_specs()\n  DOWN = action_map.get('DOWN', 0)\n  UP = action_map.get('UP', 1)\n  LEFT = action_map.get('LEFT', 2)\n  RIGHT = action_map.get('RIGHT', 3)\n  USE = action_map.get('USE', 4)\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow) and its primitive requirements.\n  # ------------------------------------------------------------------\n  goal_name = 'arrow'\n  if goal_name not in index.contents:\n      return []                       # Arrow not defined in this world.\n  goal_idx = index[goal_name]\n  primitive_needs = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  actions = []                         # Accumulated action sequence.\n\n  from collections import deque\n  import numpy as np\n\n  def _bfs_path(start, target):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) from start to target.\n      Cells occupied by any entity are treated as obstacles, except the target cell.\n      \"\"\"\n      if start == target:\n          return []\n      h, w = state.grid.shape[:2]\n      moves = [(DOWN, (1, 0)),\n               (UP,   (-1, 0)),\n               (LEFT, (0, -1)),\n               (RIGHT,(0, 1))]\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          for act, (dr, dc) in moves:\n              nr, nc = cur[0] + dr, cur[1] + dc\n              if not (0 <= nr < h and 0 <= nc < w):\n                  continue\n              nxt = (nr, nc)\n              # Allow stepping onto the target even if occupied.\n              if nxt != target and state.grid[nr, nc, :].sum() != 0:\n                  continue\n              if nxt in visited:\n                  continue\n              visited.add(nxt)\n              parent[nxt] = (cur, act)\n              q.append(nxt)\n\n      if target not in parent and start != target:\n          return []  # No path found.\n\n      # Reconstruct path.\n      path = []\n      cur = target\n      while cur != start:\n          prev, act = parent[cur]\n          path.append(act)\n          cur = prev\n      path.reverse()\n      return path\n\n  # ------------------------------------------------------------------\n  # Phase 1: Collect each required primitive the needed number of times.\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          # Locate all cells currently holding this primitive.\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # Primitive missing; abort early.\n              return actions\n\n          # Choose the nearest primitive cell (Manhattan distance).\n          dists = np.abs(prim_cells - np.array(state.pos)).sum(axis=1)\n          tr, tc = prim_cells[dists.argmin()]\n\n          # Move to the primitive cell.\n          move_seq = _bfs_path(state.pos, (tr, tc))\n          actions.extend(move_seq)\n          state.pos = (tr, tc)\n\n          # Pick it up.\n          actions.append(USE)\n\n          # Update internal copy of the state.\n          state.inventory[prim_idx] += 1\n          state.grid[tr, tc, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Phase 2: Go to the appropriate workshop and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is None:\n      return actions                     # No workshop info; cannot craft.\n\n  workshop_idx = index[workshop_name]\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      return actions                     # Workshop not present.\n\n  # Choose the nearest workshop cell.\n  dists = np.abs(workshop_cells - np.array(state.pos)).sum(axis=1)\n  wr, wc = workshop_cells[dists.argmin()]\n\n  # Move to the workshop.\n  move_seq = _bfs_path(state.pos, (wr, wc))\n  actions.extend(move_seq)\n  state.pos = (wr, wc)\n\n  # Craft the arrow.\n  actions.append(USE)\n\n  return actions", "env_interactions": 24, "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T19:57:36.953786", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.scenario.world\n  cookbook = world.cookbook\n  idx = cookbook.index\n\n  # Action indices.\n  act_map = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (act_map[\"DOWN\"], act_map[\"UP\"],\n                               act_map[\"LEFT\"], act_map[\"RIGHT\"],\n                               act_map[\"USE\"])\n  moves = [(DOWN, (1, 0)), (UP, (-1, 0)), (LEFT, (0, -1)), (RIGHT, (0, 1))]\n\n  from collections import deque\n  import numpy as np\n\n  def bfs_path(start, target):\n      \"\"\"Return list of movement actions from start to target,\n      allowing stepping onto target even if occupied.\"\"\"\n      if start == target:\n          return []\n      h, w = state.grid.shape[:2]\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          for act, (dr, dc) in moves:\n              nr, nc = cur[0] + dr, cur[1] + dc\n              if not (0 <= nr < h and 0 <= nc < w):\n                  continue\n              nxt = (nr, nc)\n              if nxt in visited:\n                  continue\n              # Block any non\u2011empty cell unless it is the target.\n              if nxt != target and state.grid[nr, nc].any():\n                  continue\n              visited.add(nxt)\n              parent[nxt] = (cur, act)\n              q.append(nxt)\n      if target not in parent and start != target:\n          return []  # No path.\n      # Reconstruct actions.\n      path = []\n      cur = target\n      while cur != start:\n          prev, act = parent[cur]\n          path.append(act)\n          cur = prev\n      path.reverse()\n      return path\n\n  # Goal item.\n  goal_name = \"arrow\"\n  if goal_name not in idx.contents:\n      return []\n  goal_idx = idx[goal_name]\n\n  # Primitive requirements.\n  primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n  actions = []\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives.\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in primitives_needed.items():\n      for _ in range(cnt):\n          # Locate nearest cell containing the primitive.\n          cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if cells.size == 0:\n              return actions  # Primitive missing.\n          dists = np.abs(cells - np.array(state.pos)).sum(axis=1)\n          tr, tc = cells[dists.argmin()]\n          # Move there.\n          move_seq = bfs_path(state.pos, (tr, tc))\n          actions.extend(move_seq)\n          state.pos = (tr, tc)\n          # Pick it up.\n          actions.append(USE)\n          state.inventory[prim_idx] += 1\n          state.grid[tr, tc, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 2. Go to the appropriate workshop and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      return actions\n  workshop_idx = idx[workshop_name]\n\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      return actions\n  dists = np.abs(workshop_cells - np.array(state.pos)).sum(axis=1)\n  wr, wc = workshop_cells[dists.argmin()]\n  move_seq = bfs_path(state.pos, (wr, wc))\n  actions.extend(move_seq)\n  state.pos = (wr, wc)\n  actions.append(USE)  # Craft.\n\n  return actions", "env_interactions": 24, "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T19:57:38.088197", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.scenario.world\n  cookbook = world.cookbook\n  index = cookbook.index\n\n  # Resolve action identifiers.\n  act_map = env.action_specs()\n  DOWN = act_map[\"DOWN\"]\n  UP = act_map[\"UP\"]\n  LEFT = act_map[\"LEFT\"]\n  RIGHT = act_map[\"RIGHT\"]\n  USE = act_map[\"USE\"]\n  moves = [(DOWN, (1, 0)), (UP, (-1, 0)), (LEFT, (0, -1)), (RIGHT, (0, 1))]\n\n  from collections import deque\n\n  def bfs_path(start, target):\n      \"\"\"Return list of movement actions from start to target,\n      avoiding occupied cells (except the target cell).\"\"\"\n      if start == target:\n          return []\n      h, w = state.grid.shape[:2]\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          for act, (dr, dc) in moves:\n              nr, nc = cur[0] + dr, cur[1] + dc\n              if not (0 <= nr < h and 0 <= nc < w):\n                  continue\n              nxt = (nr, nc)\n              if nxt in visited:\n                  continue\n              # Allow stepping onto the target even if occupied.\n              if nxt != target and state.grid[nr, nc].any():\n                  continue\n              visited.add(nxt)\n              parent[nxt] = (cur, act)\n              q.append(nxt)\n      if target not in parent and start != target:\n          return []  # No path found.\n      # Reconstruct path.\n      path = []\n      cur = target\n      while cur != start:\n          prev, act = parent[cur]\n          path.append(act)\n          cur = prev\n      path.reverse()\n      return path\n\n  def find_nearest(kind_idx, start):\n      \"\"\"Locate the nearest cell containing `kind_idx`.\n      Returns (action_path, cell_coords) or ([], None) if not found.\"\"\"\n      if state.grid[start[0], start[1], kind_idx] > 0:\n          return [], start\n      h, w = state.grid.shape[:2]\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          cur = q.popleft()\n          for act, (dr, dc) in moves:\n              nr, nc = cur[0] + dr, cur[1] + dc\n              if not (0 <= nr < h and 0 <= nc < w):\n                  continue\n              nxt = (nr, nc)\n              if nxt in visited:\n                  continue\n              # If the cell holds the target kind we can step onto it.\n              if state.grid[nr, nc, kind_idx] > 0:\n                  parent[nxt] = (cur, act)\n                  # Reconstruct path to this cell.\n                  path = []\n                  cur2 = nxt\n                  while cur2 != start:\n                      prev2, act2 = parent[cur2]\n                      path.append(act2)\n                      cur2 = prev2\n                  path.reverse()\n                  return path, nxt\n              # Otherwise the cell must be empty to traverse.\n              if state.grid[nr, nc].any():\n                  continue\n              visited.add(nxt)\n              parent[nxt] = (cur, act)\n              q.append(nxt)\n      return [], None\n\n  # ------------------------------------------------------------------\n  # Determine goal and required primitives.\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  if goal_name not in index.contents:\n      return []\n  goal_idx = index[goal_name]\n\n  needed_prims = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n  actions = []\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives.\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed_prims.items():\n      for _ in range(count):\n          path, cell = find_nearest(prim_idx, state.pos)\n          if cell is None:\n              # Primitive not reachable; abort early.\n              return actions\n          actions.extend(path)\n          state.pos = cell\n          actions.append(USE)  # Pick up primitive.\n          # Update simulated state.\n          state.inventory[prim_idx] += 1\n          tr, tc = cell\n          state.grid[tr, tc, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 2. Move to the appropriate workshop and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None or workshop_name not in index.contents:\n      return actions\n  workshop_idx = index[workshop_name]\n\n  path, cell = find_nearest(workshop_idx, state.pos)\n  if cell is None:\n      return actions\n  actions.extend(path)\n  state.pos = cell\n  actions.append(USE)  # Craft the arrow.\n\n  return actions", "env_interactions": 26, "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T19:58:07.421369", "function_name": "make_arrow", "function_body": "  # Reset environment and get references\n  env.reset()\n  state = env._current_state               # CraftState\n  world = env.scenario.world                # CraftWorld\n  cookbook = world.cookbook                 # Cookbook\n  index = cookbook.index                    # name \u2194 id mapping\n\n  # Action identifiers (as defined in CraftLab)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow) index\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  if goal_name not in index.contents:\n      return []  # Arrow not defined in this world\n  goal_idx = index[goal_name]\n\n  # ------------------------------------------------------------------\n  # Determine primitive requirements for one arrow (transitive)\n  # ------------------------------------------------------------------\n  primitive_needs = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n  plan = []\n\n  # ------------------------------------------------------------------\n  # Helper: BFS path\u2011finder (4\u2011connected moves)\n  # ------------------------------------------------------------------\n  def bfs(start, target):\n      \"\"\"Return a list of positions from start to target (inclusive)\n      using 4\u2011connected moves, treating any occupied cell as blocked\n      except the target cell itself. Returns None if unreachable.\"\"\"\n      h, w = state.grid.shape[:2]\n      occupied = np.any(state.grid > 0, axis=2)          # any entity blocks movement\n      occupied[target] = False                           # allow stepping onto target\n      q = collections.deque([start])\n      came_from = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          r, c = cur\n          for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nr, nc = r + dr, c + dc\n              if 0 <= nr < h and 0 <= nc < w and not occupied[nr, nc]:\n                  nxt = (nr, nc)\n                  if nxt not in came_from:\n                      came_from[nxt] = cur\n                      q.append(nxt)\n      else:\n          return None  # target never reached\n\n      # Reconstruct path from start to target\n      path = []\n      cur = target\n      while cur is not None:\n          path.append(cur)\n          cur = came_from[cur]\n      path.reverse()\n      return path\n\n  # Mapping from movement delta to action index\n  delta_to_action = {\n      (1, 0): DOWN,\n      (-1, 0): UP,\n      (0, 1): RIGHT,\n      (0, -1): LEFT,\n  }\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives.\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          # Locate any remaining instance of this primitive on the map\n          cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if cells.size == 0:\n              # No more of this primitive; abort planning\n              return plan\n\n          target_r, target_c = cells[0]\n\n          # Compute a path to the primitive\n          path = bfs(state.pos, (target_r, target_c))\n          if path is None:\n              # Unreachable primitive; abort planning\n              return plan\n\n          # Translate path into actions and update simulated state\n          for (r0, c0), (r1, c1) in zip(path, path[1:]):\n              act = delta_to_action[(r1 - r0, c1 - c0)]\n              plan.append(act)\n              state.pos = (r1, c1)\n\n          # Pick up the primitive\n          plan.append(USE)\n          state.inventory[prim_idx] += 1\n          state.grid[target_r, target_c, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 2. Move to the appropriate workshop and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      return plan  # No workshop information; cannot craft\n\n  workshop_idx = index[workshop_name]\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      return plan  # No workshop cell found\n\n  w_r, w_c = workshop_cells[0]\n\n  path = bfs(state.pos, (w_r, w_c))\n  if path is None:\n      return plan  # Workshop unreachable\n\n  for (r0, c0), (r1, c1) in zip(path, path[1:]):\n      act = delta_to_action[(r1 - r0, c1 - c0)]\n      plan.append(act)\n      state.pos = (r1, c1)\n\n  # Craft the arrow at the workshop\n  plan.append(USE)\n\n  return plan", "env_interactions": 28, "island_id": 4, "scores": {"3": 2.0}}
{"timestamp": "2025-10-27T19:58:08.569568", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state               # CraftState\n  world = env.scenario.world                # CraftWorld\n  cookbook = world.cookbook                 # Cookbook\n  index = cookbook.index                    # name \u2194 id mapping\n\n  # Action IDs (as defined by the environment)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow) index\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  if goal_name not in index.contents:\n      return []  # Arrow not defined in this world\n  goal_idx = index[goal_name]\n\n  # ------------------------------------------------------------------\n  # Determine primitive requirements (including transitive ones)\n  # ------------------------------------------------------------------\n  primitive_needs = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper: BFS path\u2011finder (4\u2011connected Manhattan moves)\n  # ------------------------------------------------------------------\n  def bfs(start, target):\n      \"\"\"Return a list of positions from start to target (inclusive)\n      using 4\u2011connected moves, treating any occupied cell as blocked\n      except the target cell itself. Returns None if unreachable.\"\"\"\n      h, w = state.grid.shape[:2]\n      occupied = np.any(state.grid > 0, axis=2)          # True where blocked\n      occupied[target] = False                           # allow stepping onto target\n      q = collections.deque([start])\n      came_from = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          r, c = cur\n          for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nr, nc = r + dr, c + dc\n              if 0 <= nr < h and 0 <= nc < w and not occupied[nr, nc]:\n                  nxt = (nr, nc)\n                  if nxt not in came_from:\n                      came_from[nxt] = cur\n                      q.append(nxt)\n      else:\n          return None  # target never reached\n\n      # Reconstruct path from start to target\n      path = []\n      cur = target\n      while cur is not None:\n          path.append(cur)\n          cur = came_from[cur]\n      path.reverse()\n      return path\n\n  # Mapping from movement delta to action index\n  delta2act = {\n      (1, 0): DOWN,\n      (-1, 0): UP,\n      (0, 1): RIGHT,\n      (0, -1): LEFT,\n  }\n\n  # ------------------------------------------------------------------\n  # Utility to translate a path into actions and update simulated state\n  # ------------------------------------------------------------------\n  def follow_path(path):\n      for (r0, c0), (r1, c1) in zip(path, path[1:]):\n          act = delta2act[(r1 - r0, c1 - c0)]\n          actions.append(act)\n          state.pos = (r1, c1)\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives (nearest reachable instance each time)\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          # Find all remaining instances of this primitive on the map\n          cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if cells.size == 0:\n              # No more of this primitive; abort planning\n              return actions\n\n          # Sort candidates by Manhattan distance from current position\n          candidates = [tuple(c) for c in cells]\n          candidates.sort(key=lambda pos: abs(pos[0] - state.pos[0]) + abs(pos[1] - state.pos[1]))\n\n          # Try each candidate until a reachable one is found\n          path = None\n          target = None\n          for cand in candidates:\n              p = bfs(state.pos, cand)\n              if p is not None:\n                  path = p\n                  target = cand\n                  break\n          if path is None:\n              # Primitive exists but is unreachable; abort planning\n              return actions\n\n          # Move to the primitive and pick it up\n          follow_path(path)\n          actions.append(USE)                     # pick up\n          state.inventory[prim_idx] += 1\n          state.grid[target[0], target[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 2. Move to the appropriate workshop and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      return actions  # No workshop info; cannot craft\n\n  workshop_idx = index[workshop_name]\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      return actions  # No workshop cell found\n\n  # Choose the nearest reachable workshop cell\n  w_candidates = [tuple(c) for c in workshop_cells]\n  w_candidates.sort(key=lambda pos: abs(pos[0] - state.pos[0]) + abs(pos[1] - state.pos[1]))\n\n  path = None\n  w_target = None\n  for cand in w_candidates:\n      p = bfs(state.pos, cand)\n      if p is not None:\n          path = p\n          w_target = cand\n          break\n  if path is None:\n      return actions  # Workshop unreachable\n\n  follow_path(path)\n  actions.append(USE)  # craft at the workshop\n\n  return actions", "env_interactions": 24, "island_id": 4, "scores": {"3": 1.5}}
