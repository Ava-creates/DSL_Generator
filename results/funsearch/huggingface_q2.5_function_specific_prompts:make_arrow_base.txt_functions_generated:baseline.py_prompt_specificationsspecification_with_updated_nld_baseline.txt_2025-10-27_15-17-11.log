{"timestamp": "2025-10-27T18:58:08.647778", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Action constants (must match CraftLab.action_specs)\n  # ----------------------------------------------------------------------\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # 0:DOWN, 1:UP, 2:LEFT, 3:RIGHT\n  USE = 4\n\n  from collections import deque\n  import numpy as np\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving from *start* to any\n  # free cell that is 4\u2011adjacent to *target*.  Returns empty list if not\n  # reachable.\n  # ----------------------------------------------------------------------\n  def bfs_adjacent(start, target, blocked):\n      h, w = blocked.shape\n      tx, ty = target\n      goal_cells = []\n      for a, (dx, dy) in enumerate(DIRS):\n          gx, gy = tx + dx, ty + dy\n          if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:\n              goal_cells.append((gx, gy))\n      if not goal_cells:\n          return []                     # surrounded target\n\n      q = deque([(start, [])])\n      visited = {start}\n      while q:\n          (cx, cy), path = q.popleft()\n          if (cx, cy) in goal_cells:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []                         # unreachable\n\n  # ----------------------------------------------------------------------\n  # Reset environment and fetch the current CraftState\n  # ----------------------------------------------------------------------\n  try:\n      env.reset()\n  except Exception:\n      pass\n\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []                         # cannot obtain state\n\n  world = env.world\n  idx = world.cookbook.index\n\n  # ----------------------------------------------------------------------\n  # Identify the goal (arrow) and its recipe\n  # ----------------------------------------------------------------------\n  try:\n      goal_idx = idx[\"arrow\"]\n  except Exception:\n      return []                         # arrow not defined\n\n  primitives_needed = world.cookbook.primitives_for(goal_idx)\n\n  # locate workshop name in the recipe (key \"_at\" or \"_key\")\n  workshop_name = None\n  for k, v in world.cookbook.recipes.get(goal_idx, {}).items():\n      if k in (\"_at\", \"_key\"):\n          workshop_name = v\n          break\n  if workshop_name is None:\n      return []                         # no workshop info\n\n  try:\n      workshop_idx = idx[workshop_name]\n  except Exception:\n      return []                         # workshop not indexed\n\n  # ----------------------------------------------------------------------\n  # Local mutable copies for planning simulation\n  # ----------------------------------------------------------------------\n  pos = tuple(state.pos)                 # (x, y)\n  grid = state.grid.copy()               # (W, H, n_kinds)\n  inventory = state.inventory.copy()\n  occupied = np.any(grid > 0, axis=2)    # bool matrix of blocked cells\n\n  plan = []\n\n  # ----------------------------------------------------------------------\n  # Helper: move adjacent to a cell containing *kind_idx* and USE it.\n  # Updates simulated position, grid, occupied mask and inventory.\n  # Returns False if movement is impossible.\n  # ----------------------------------------------------------------------\n  def move_and_use(target, kind_idx):\n      nonlocal pos, plan, grid, occupied, inventory\n      path = bfs_adjacent(pos, target, occupied)\n      if not path and pos != target:\n          return False\n      # simulate movement\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n      plan.extend(path)\n\n      # issue USE\n      plan.append(USE)\n\n      tx, ty = target\n      if grid[tx, ty, kind_idx] > 0:\n          grid[tx, ty, kind_idx] = 0\n          occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)\n          inventory[kind_idx] += 1\n      return True\n\n  # ----------------------------------------------------------------------\n  # Collect all required primitives\n  # ----------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      for _ in range(needed_cnt):\n          candidates = np.argwhere(grid[:, :, prim_idx] > 0)\n          if candidates.shape[0] == 0:\n              return plan                 # missing primitive, abort\n          dists = np.abs(candidates[:, 0] - pos[0]) + np.abs(candidates[:, 1] - pos[1])\n          target = tuple(candidates[dists.argmin()])\n          if not move_and_use(target, prim_idx):\n              return plan\n\n  # ----------------------------------------------------------------------\n  # Move to the workshop and craft the arrow\n  # ----------------------------------------------------------------------\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.shape[0] == 0:\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.shape[0] == 0:\n          return plan\n  dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])\n  workshop_target = tuple(workshop_cells[dists.argmin()])\n  move_and_use(workshop_target, workshop_idx)\n\n  # ----------------------------------------------------------------------\n  # Return the planned action sequence\n  # ----------------------------------------------------------------------\n  return plan", "env_interactions": 23, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T18:58:37.083565", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ----------------------------------------------------------------------\n  # Helper definitions\n  # ----------------------------------------------------------------------\n  # Action mapping (matches CraftLab.action_specs)\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # 0:DOWN, 1:UP, 2:LEFT, 3:RIGHT\n  USE = 4\n\n  def bfs_adjacent(start, target, blocked):\n      \"\"\"\n      Return a list of movement actions that brings the agent from *start*\n      to any empty cell that is 4\u2011connected to *target*.\n      If no such path exists, return an empty list.\n      \"\"\"\n      h, w = blocked.shape\n      tx, ty = target\n      # cells that are adjacent to the target and not blocked\n      goal_cells = []\n      for a, (dx, dy) in enumerate(DIRS):\n          gx, gy = tx + dx, ty + dy\n          if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:\n              goal_cells.append((gx, gy))\n      if not goal_cells:\n          return []\n\n      q = deque([(start, [])])\n      visited = {start}\n      while q:\n          (cx, cy), path = q.popleft()\n          if (cx, cy) in goal_cells:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []\n\n  # ----------------------------------------------------------------------\n  # Reset environment and fetch the current state\n  # ----------------------------------------------------------------------\n  try:\n      env.reset()\n  except Exception:\n      pass\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []\n\n  world = env.world\n  idx = world.cookbook.index\n\n  # ----------------------------------------------------------------------\n  # Identify the goal (arrow) and obtain its recipe\n  # ----------------------------------------------------------------------\n  try:\n      goal_idx = idx[\"arrow\"]\n  except Exception:\n      return []                     # arrow not defined in the index\n\n  # Mapping primitive/component index -> required count for ONE arrow\n  needed = world.cookbook.primitives_for(goal_idx)\n\n  # Determine which workshop is required for crafting the arrow\n  workshop_name = None\n  for k, v in world.cookbook.recipes.get(goal_idx, {}).items():\n      if k in (\"_at\", \"_key\"):\n          workshop_name = v\n          break\n  if workshop_name is None:\n      return []\n  try:\n      workshop_idx = idx[workshop_name]\n  except Exception:\n      return []\n\n  # ----------------------------------------------------------------------\n  # Local mutable copies for planning simulation\n  # ----------------------------------------------------------------------\n  pos = tuple(state.pos)                     # (x, y)\n  grid = state.grid.copy()                   # (W, H, n_kinds)\n  inventory = state.inventory.copy()\n  occupied = np.any(grid > 0, axis=2)        # bool matrix: True where any entity exists\n\n  plan = []                                   # final list of actions to return\n\n  # ----------------------------------------------------------------------\n  # Helper: move adjacent to a target cell containing *kind_idx* and USE it\n  # ----------------------------------------------------------------------\n  def move_and_use(target, kind_idx):\n      \"\"\"\n      Move the simulated agent adjacent to *target* and issue a USE action.\n      Updates simulated position, grid, occupied matrix and inventory.\n      Returns True on success, False if movement is impossible.\n      \"\"\"\n      nonlocal pos, plan, grid, occupied, inventory\n      path = bfs_adjacent(pos, target, occupied)\n      if not path and pos != target:\n          return False\n      # Execute movement actions in the simulated world\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n      plan.extend(path)\n\n      # Perform the USE action\n      plan.append(USE)\n\n      tx, ty = target\n      if grid[tx, ty, kind_idx] > 0:\n          # Pick up one unit of the entity (primitive or workshop)\n          grid[tx, ty, kind_idx] = 0\n          occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)\n          inventory[kind_idx] += 1\n      return True\n\n  # ----------------------------------------------------------------------\n  # Collect all required primitives/components\n  # ----------------------------------------------------------------------\n  for kind_idx, cnt in needed.items():\n      for _ in range(cnt):\n          locations = np.argwhere(grid[:, :, kind_idx] > 0)\n          if locations.size == 0:\n              # Required item not present on the map \u2013 abort planning\n              return plan\n          # Choose the closest instance (Manhattan distance)\n          dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n          target = tuple(locations[dists.argmin()])\n          if not move_and_use(target, kind_idx):\n              return plan\n\n  # ----------------------------------------------------------------------\n  # Move to the appropriate workshop and craft the arrow\n  # ----------------------------------------------------------------------\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      # Workshops are static; fall back to original scenario grid\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          return plan\n  dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])\n  workshop_target = tuple(workshop_cells[dists.argmin()])\n  move_and_use(workshop_target, workshop_idx)\n\n  # ----------------------------------------------------------------------\n  # Return the assembled action sequence\n  # ----------------------------------------------------------------------\n  return plan", "env_interactions": 23, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T18:58:38.212046", "function_name": "make_arrow", "function_body": "  # Reset the environment and obtain the current state.\n  try:\n      env.reset()\n  except Exception:\n      pass\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []\n\n  world = env.world\n  idx = world.cookbook.index\n\n  # Identify the index for the target item \"arrow\".\n  try:\n      goal_idx = idx[\"arrow\"]\n  except Exception:\n      return []                     # no arrow defined in the recipe set\n\n  # Determine which primitive (or sub\u2011component) counts are needed for one arrow.\n  needed = world.cookbook.primitives_for(goal_idx)\n\n  # Locate the workshop required for crafting the arrow (stored under \"_at\" or \"_key\").\n  workshop_idx = None\n  for k, v in world.cookbook.recipes.get(goal_idx, {}).items():\n      if k in (\"_at\", \"_key\"):\n          try:\n              workshop_idx = idx[v]\n          except Exception:\n              workshop_idx = None\n          break\n  if workshop_idx is None:\n      return []                     # cannot find a workshop for arrow\n\n  # ----------------------------------------------------------------------\n  # Prepare mutable copies for planning.\n  # ----------------------------------------------------------------------\n  pos = tuple(state.pos)                     # current (x, y) position\n  grid = state.grid.copy()                   # (WIDTH, HEIGHT, n_kinds) occupancy\n  inventory = state.inventory.copy()\n  occupied = np.any(grid > 0, axis=2)        # bool matrix: True where any entity exists\n\n  plan = []                                   # list of action indices to return\n\n  # Direction vectors matching CraftLab.action_specs ordering.\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # DOWN, UP, LEFT, RIGHT\n  USE = 4\n\n  from collections import deque\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS to reach a free cell adjacent to a target cell.\n  # ----------------------------------------------------------------------\n  def bfs_adjacent(start, target, blocked):\n      \"\"\"Return a list of actions moving from *start* to any empty cell that is\n      4\u2011connected to *target*. If no such cell is reachable, return an empty list.\"\"\"\n      h, w = blocked.shape\n      tx, ty = target\n      goal_cells = []\n      for a, (dx, dy) in enumerate(DIRS):\n          gx, gy = tx + dx, ty + dy\n          if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:\n              goal_cells.append((gx, gy))\n      if not goal_cells:\n          return []\n      q = deque([(start, [])])\n      visited = {start}\n      while q:\n          (cx, cy), path = q.popleft()\n          if (cx, cy) in goal_cells:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []\n\n  # ----------------------------------------------------------------------\n  # Helper: move adjacent to a target cell containing *kind_idx* and USE it.\n  # ----------------------------------------------------------------------\n  def move_and_use(target, kind_idx):\n      \"\"\"Move adjacent to *target* (which holds an entity of *kind_idx*) and\n      issue a USE action. Updates simulated position, grid, occupied map and\n      inventory. Returns False if movement is impossible.\"\"\"\n      nonlocal pos, plan, grid, occupied, inventory\n      path = bfs_adjacent(pos, target, occupied)\n      if not path and pos != target:\n          return False\n      # Execute movement actions in the simulated state.\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n      plan.extend(path)\n\n      # Perform the USE action.\n      plan.append(USE)\n\n      tx, ty = target\n      if grid[tx, ty, kind_idx] > 0:\n          grid[tx, ty, kind_idx] = 0\n          occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)\n          inventory[kind_idx] += 1\n      return True\n\n  # ----------------------------------------------------------------------\n  # Collect all required primitives/components.\n  # ----------------------------------------------------------------------\n  for kind_idx, cnt in needed.items():\n      for _ in range(cnt):\n          locations = np.argwhere(grid[:, :, kind_idx] > 0)\n          if locations.size == 0:\n              # No remaining instances of this kind on the map \u2013 abort planning.\n              return plan\n          # Choose the nearest instance (Manhattan distance).\n          dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n          target = tuple(locations[dists.argmin()])\n          if not move_and_use(target, kind_idx):\n              return plan\n\n  # ----------------------------------------------------------------------\n  # Move to the workshop and craft the arrow.\n  # ----------------------------------------------------------------------\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      # Workshops are static; fall back to the original scenario grid.\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          return plan\n  dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])\n  workshop_target = tuple(workshop_cells[dists.argmin()])\n  move_and_use(workshop_target, workshop_idx)\n\n  # ----------------------------------------------------------------------\n  # Return the constructed action sequence.\n  # ----------------------------------------------------------------------\n  return plan", "env_interactions": 23, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T18:59:02.209357", "function_name": "make_arrow", "function_body": "  # Reset the environment (ignore errors if already reset)\n  try:\n      env.reset()\n  except Exception:\n      pass\n\n  actions: list[int] = []\n\n  # ------------------------------------------------------------------\n  # Identify the goal item index (the item we need to craft)\n  # ------------------------------------------------------------------\n  goal_idx = None\n  task = getattr(env, \"task\", None)\n  if task is not None:\n      goal_idx = getattr(task, \"goal\", None)\n      if goal_idx is None and isinstance(task, (list, tuple)):\n          goal_idx = task[0]\n\n  if goal_idx is None:\n      # fallback to the name \"arrow\" if the task does not expose the goal\n      try:\n          goal_idx = env.world.cookbook.index[\"arrow\"]\n      except Exception:\n          return actions\n\n  # ------------------------------------------------------------------\n  # What primitive resources are required for this goal?\n  # ------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)\n\n  # Current mutable position of the agent\n  cur_pos = list(env._current_state.pos)          # [x, y]\n\n  # Work on a copy of the grid so we can simulate pickups / removals\n  grid = env._current_state.grid.copy()\n\n  # ------------------------------------------------------------------\n  # Helper: BFS path finder that avoids non\u2011grabbable obstacles.\n  # Returns a list of action indices that move from start to any cell in targets.\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  def bfs_path(start: tuple[int, int],\n               targets: set[tuple[int, int]],\n               blocked: np.ndarray) -> list[int]:\n      \"\"\"Find shortest path (Manhattan) avoiding blocked cells.\"\"\"\n      if start in targets:\n          return []\n\n      W, H = blocked.shape\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = np.full((W, H), False, dtype=bool)\n      visited[start[0], start[1]] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for action, (dx, dy) in enumerate(((0, 1), (0, -1), (-1, 0), (1, 0))):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny] and not blocked[nx, ny]:\n                  new_path = path + [action]   # 0:DOWN,1:UP,2:LEFT,3:RIGHT\n                  if (nx, ny) in targets:\n                      return new_path\n                  visited[nx, ny] = True\n                  q.append((nx, ny, new_path))\n      # No reachable target\n      return []\n\n  # ------------------------------------------------------------------\n  # Helper: compute blocked mask from the current grid copy.\n  # ------------------------------------------------------------------\n  def compute_blocked(g: np.ndarray) -> np.ndarray:\n      \"\"\"Return a bool mask where True indicates an impassable cell.\"\"\"\n      blocked = np.zeros(g.shape[:2], dtype=bool)\n      for idx in env.world.non_grabbable_indices:\n          blocked |= (g[:, :, idx] > 0)\n      return blocked\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the necessary number of times.\n  # ------------------------------------------------------------------\n  for kind_idx, needed in primitives_needed.items():\n      remaining = needed\n      while remaining > 0:\n          # Find all cells that currently contain this primitive\n          positions = np.argwhere(grid[:, :, kind_idx] > 0)\n          if positions.size == 0:\n              # No more of this primitive on the map \u2013 abort collection for this kind\n              break\n\n          # Choose the reachable primitive with the smallest BFS distance\n          blocked_mask = compute_blocked(grid)\n          target_set = {tuple(p) for p in positions.tolist()}\n          path = bfs_path(tuple(cur_pos), target_set, blocked_mask)\n\n          if not path:\n              # No reachable primitive (perhaps surrounded by water/stone)\n              break\n\n          # Determine which target we actually arrived at by simulating the path\n          tmp_pos = cur_pos.copy()\n          for a in path:\n              if a == 0:   # DOWN\n                  tmp_pos[1] += 1\n              elif a == 1: # UP\n                  tmp_pos[1] -= 1\n              elif a == 2: # LEFT\n                  tmp_pos[0] -= 1\n              elif a == 3: # RIGHT\n                  tmp_pos[0] += 1\n          target = tuple(tmp_pos)\n\n          # Append the movement actions and the USE action to pick up\n          actions.extend(path)\n          actions.append(4)                     # USE\n          cur_pos[0], cur_pos[1] = target\n\n          # Simulate the pickup in our local copy of the grid\n          grid[target[0], target[1], kind_idx] = 0\n          remaining -= 1\n\n  # ------------------------------------------------------------------\n  # After gathering primitives, go to the appropriate workshop (if any) and craft.\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n\n  if workshop_kind is not None:\n      # Locate workshop cells on the (still current) grid\n      ws_positions = np.argwhere(grid[:, :, workshop_kind] > 0)\n      if ws_positions.size > 0:\n          blocked_mask = compute_blocked(grid)\n          ws_set = {tuple(p) for p in ws_positions.tolist()}\n          ws_path = bfs_path(tuple(cur_pos), ws_set, blocked_mask)\n          if ws_path:\n              actions.extend(ws_path)\n              # Update current position to the workshop we reached\n              for a in ws_path:\n                  if a == 0:\n                      cur_pos[1] += 1\n                  elif a == 1:\n                      cur_pos[1] -= 1\n                  elif a == 2:\n                      cur_pos[0] -= 1\n                  elif a == 3:\n                      cur_pos[0] += 1\n      # Use the workshop to craft the goal item\n      actions.append(4)   # USE\n  else:\n      # No specific workshop required \u2013 craft at the current location\n      actions.append(4)   # USE\n\n  return actions", "env_interactions": 1, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T18:59:03.334870", "function_name": "make_arrow", "function_body": "  try:\n      env.reset()\n  except Exception:\n      pass\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Identify the goal item index (the item we need to craft)\n  # ------------------------------------------------------------------\n  goal_idx = None\n  task = getattr(env, \"task\", None)\n  if task is not None:\n      goal_idx = getattr(task, \"goal\", None)\n      if goal_idx is None and isinstance(task, (list, tuple)):\n          goal_idx = task[0]\n\n  # Fallback: try to look up \"arrow\" directly in the cookbook\n  if goal_idx is None:\n      try:\n          goal_idx = env.world.cookbook.index[\"arrow\"]\n      except Exception:\n          return actions\n\n  # ------------------------------------------------------------------\n  # Determine which primitive resources are required for this goal\n  # ------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)\n\n  # Current mutable agent position (list for easy updates)\n  cur_pos = list(env._current_state.pos)          # [x, y]\n\n  # Work on a copy of the grid so we can simulate pickups without\n  # affecting the real environment.\n  grid = env._current_state.grid.copy()\n\n  # ------------------------------------------------------------------\n  # Helper: generate a Manhattan path from cur_pos to a target cell.\n  # Returns a list of action indices and updates cur_pos.\n  # ------------------------------------------------------------------\n  def move_to(target):\n      nonlocal cur_pos\n      seq = []\n      tx, ty = target\n      while cur_pos[0] < tx:\n          seq.append(3)          # RIGHT\n          cur_pos[0] += 1\n      while cur_pos[0] > tx:\n          seq.append(2)          # LEFT\n          cur_pos[0] -= 1\n      while cur_pos[1] < ty:\n          seq.append(0)          # DOWN\n          cur_pos[1] += 1\n      while cur_pos[1] > ty:\n          seq.append(1)          # UP\n          cur_pos[1] -= 1\n      return seq\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the necessary number of times.\n  # ------------------------------------------------------------------\n  for kind_idx, needed in primitives_needed.items():\n      remaining = needed\n      while remaining > 0:\n          positions = np.argwhere(grid[:, :, kind_idx] > 0)\n          if positions.size == 0:\n              # No more of this primitive on the map \u2013 give up on it.\n              break\n          # Choose the nearest primitive (Manhattan distance) to reduce travel.\n          dists = np.abs(positions[:, 0] - cur_pos[0]) + np.abs(positions[:, 1] - cur_pos[1])\n          nearest = int(np.argmin(dists))\n          target = tuple(positions[nearest])\n          actions.extend(move_to(target))\n          actions.append(4)                      # USE to pick up\n          # Simulate the pickup so we don't target the same cell again.\n          grid[target[0], target[1], kind_idx] = 0\n          remaining -= 1\n\n  # ------------------------------------------------------------------\n  # After gathering primitives, move to the appropriate workshop (if any)\n  # and craft the goal item.\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      ws_positions = np.argwhere(grid[:, :, workshop_kind] > 0)\n      if ws_positions.shape[0] > 0:\n          dists = np.abs(ws_positions[:, 0] - cur_pos[0]) + np.abs(ws_positions[:, 1] - cur_pos[1])\n          nearest = int(np.argmin(dists))\n          ws_target = tuple(ws_positions[nearest])\n          actions.extend(move_to(ws_target))\n      actions.append(4)          # USE to craft at the workshop\n  else:\n      # No specific workshop required \u2013 craft at current location.\n      actions.append(4)\n\n  return actions", "env_interactions": 1, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T18:59:37.087830", "function_name": "make_arrow", "function_body": "  # Reset environment to obtain fresh observation and task info\n  _ = env.reset()\n  act_map = env.action_specs()          # e.g. {'DOWN':0,'UP':1,'LEFT':2,'RIGHT':3,'USE':4}\n  # movement vectors and names (order does not matter)\n  moves = [\n      (1, 0, \"DOWN\"),\n      (-1, 0, \"UP\"),\n      (0, 1, \"RIGHT\"),\n      (0, -1, \"LEFT\"),\n  ]\n  # opposite direction lookup (used to ensure we face the target when using)\n  opposite = {\"UP\": \"DOWN\", \"DOWN\": \"UP\", \"LEFT\": \"RIGHT\", \"RIGHT\": \"LEFT\"}\n\n  # Helper: BFS that returns a list of direction names that brings the agent\n  # to a cell adjacent to `target` *and* leaves the agent facing `target`.\n  from collections import deque\n\n  def bfs_adjacent(start_pos, target_pos, occ_grid):\n      tr, tc = target_pos\n      # map each free neighbour of the target to the direction the agent must be\n      # facing when standing on that neighbour (i.e. direction from neighbour \u2192 target)\n      neighbour_need = {}\n      for dr, dc, name in moves:\n          nr, nc = tr + dr, tc + dc\n          if 0 <= nr < occ_grid.shape[0] and 0 <= nc < occ_grid.shape[1]:\n              if not occ_grid[nr, nc]:          # free cell\n                  neighbour_need[(nr, nc)] = opposite[name]\n\n      # BFS over free cells\n      q = deque([start_pos])\n      parent = {start_pos: None}\n      parent_move = {}\n      while q:\n          cur = q.popleft()\n          if cur in neighbour_need:\n              # we have reached a suitable neighbour; check orientation\n              need_dir = neighbour_need[cur]\n              if parent_move.get(cur) == need_dir:\n                  # reconstruct path\n                  path = []\n                  node = cur\n                  while parent[node] is not None:\n                      path.append(parent_move[node])\n                      node = parent[node]\n                  path.reverse()\n                  return path\n          # explore neighbours\n          r, c = cur\n          for dr, dc, name in moves:\n              nr, nc = r + dr, c + dc\n              if (\n                  0 <= nr < occ_grid.shape[0]\n                  and 0 <= nc < occ_grid.shape[1]\n                  and not occ_grid[nr, nc]\n                  and (nr, nc) not in parent\n              ):\n                  parent[(nr, nc)] = cur\n                  parent_move[(nr, nc)] = name\n                  q.append((nr, nc))\n      # No path found \u2013 return empty list (the caller will simply skip)\n      return []\n\n  # Mapping from direction name to delta for position updates\n  dir_to_delta = {name: (dr, dc) for dr, dc, name in moves}\n\n  # Extract world information\n  scenario = env.scenario\n  world = scenario.world\n  goal_idx = env.task.goal                     # integer index of the desired item\n\n  # Retrieve recipe for the goal and the list of required primitives\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = recipe.get(\"_at\")             # may be None for primitive goals\n  primitives_needed = world.cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n\n  # Working copies of the grid and occupancy mask\n  grid = scenario.init_grid.copy()\n  occ = grid.sum(axis=2) > 0                  # True where any entity occupies the cell\n\n  cur_pos = scenario.init_pos\n  actions = []\n\n  # Helper to execute a list of direction names: update actions list and cur_pos\n  def follow_path(dir_names):\n      nonlocal cur_pos\n      for dname in dir_names:\n          actions.append(act_map[dname])\n          dr, dc = dir_to_delta[dname]\n          cur_pos = (cur_pos[0] + dr, cur_pos[1] + dc)\n\n  # ------------------------------------------------------------\n  # 1) Collect all required primitive items\n  # ------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      for _ in range(needed_cnt):\n          # locate all cells that currently contain this primitive\n          prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not prim_cells:\n              # primitive not present any more; abort collection loop\n              break\n          # pick the closest primitive (Manhattan distance)\n          target = min(\n              prim_cells,\n              key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]),\n          )\n          # find path to a suitable adjacent cell\n          path = bfs_adjacent(cur_pos, target, occ)\n          follow_path(path)\n          # use the primitive\n          actions.append(act_map[\"USE\"])\n          # update internal grid/occupancy to reflect that the primitive was taken\n          r, c = target\n          grid[r, c, :] = 0\n          occ[r, c] = False\n\n  # ------------------------------------------------------------\n  # 2) Move to the workshop (if any) and craft the goal item\n  # ------------------------------------------------------------\n  if workshop_idx is not None:\n      # locate workshop cells (they are static in the original scenario grid)\n      workshop_cells = list(zip(*np.where(scenario.init_grid[:, :, workshop_idx] > 0)))\n      if workshop_cells:\n          target = workshop_cells[0]  # any workshop cell works\n          path = bfs_adjacent(cur_pos, target, occ)\n          follow_path(path)\n          actions.append(act_map[\"USE\"])\n\n  return actions", "env_interactions": 0, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T18:59:38.227845", "function_name": "make_arrow", "function_body": "  # Reset environment to get a fresh scenario and observation\n  _ = env.reset()\n  act_map = env.action_specs()  # maps action names to integer indices\n\n  # Define movement directions\n  moves = [\n      (1, 0, \"DOWN\"),\n      (-1, 0, \"UP\"),\n      (0, 1, \"RIGHT\"),\n      (0, -1, \"LEFT\"),\n  ]\n  dir_to_delta = {name: (dr, dc) for dr, dc, name in moves}\n  from collections import deque\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of action names moving the agent from\n  # start to any free cell adjacent to the target cell.\n  # ------------------------------------------------------------------\n  def bfs_to_adjacent(start, target, occupied):\n      tr, tc = target\n      # candidate goal cells: free neighbours of target\n      goal_cells = [\n          (tr + dr, tc + dc)\n          for dr, dc, _ in moves\n          if 0 <= tr + dr < occupied.shape[0]\n          and 0 <= tc + dc < occupied.shape[1]\n          and not occupied[tr + dr, tc + dc]\n      ]\n      if not goal_cells:\n          return []  # no reachable adjacent cell\n\n      q = deque([start])\n      parent = {start: None}\n      parent_move = {}\n\n      while q:\n          cur = q.popleft()\n          if cur in goal_cells:\n              # reconstruct path of action names\n              path = []\n              while parent[cur] is not None:\n                  path.append(parent_move[cur])\n                  cur = parent[cur]\n              path.reverse()\n              return path\n\n          r, c = cur\n          for dr, dc, name in moves:\n              nr, nc = r + dr, c + dc\n              if (\n                  0 <= nr < occupied.shape[0]\n                  and 0 <= nc < occupied.shape[1]\n                  and not occupied[nr, nc]\n                  and (nr, nc) not in parent\n              ):\n                  parent[(nr, nc)] = cur\n                  parent_move[(nr, nc)] = name\n                  q.append((nr, nc))\n      return []  # no path found\n\n  # ------------------------------------------------------------------\n  # Helper: execute a list of direction names, updating cur_pos and actions.\n  # ------------------------------------------------------------------\n  def execute_path(path_dirs):\n      nonlocal cur_pos\n      for dname in path_dirs:\n          actions.append(act_map[dname])\n          dr, dc = dir_to_delta[dname]\n          cur_pos = (cur_pos[0] + dr, cur_pos[1] + dc)\n\n  # ------------------------------------------------------------------\n  # Gather references to scenario, world and the goal index.\n  # ------------------------------------------------------------------\n  scenario = env.scenario\n  world = scenario.world\n  goal_idx = env.task.goal\n\n  # Load recipe information\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = recipe.get(\"_at\")\n  primitives_needed = world.cookbook.primitives_for(goal_idx)\n\n  # Work on a mutable copy of the initial grid\n  grid = scenario.init_grid.copy()\n  occupied = grid.sum(axis=2) > 0  # True where any entity occupies the cell\n\n  cur_pos = scenario.init_pos\n  actions = []\n\n  # ------------------------------------------------------------------\n  # 1. Collect each required primitive (respecting multiplicities).\n  # ------------------------------------------------------------------\n  for prim_idx, count in primitives_needed.items():\n      for _ in range(count):\n          # locate all cells that still contain this primitive\n          prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not prim_cells:\n              # primitive not present any more; break out\n              break\n\n          # choose the nearest primitive cell (Manhattan distance)\n          target = min(\n              prim_cells,\n              key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]),\n          )\n\n          # move adjacent to the primitive and pick it up\n          path = bfs_to_adjacent(cur_pos, target, occupied)\n          execute_path(path)\n          actions.append(act_map[\"USE\"])\n\n          # update grid / occupied after pickup\n          r, c = target\n          grid[r, c, :] = 0\n          occupied[r, c] = False\n\n  # ------------------------------------------------------------------\n  # 2. Move to the appropriate workshop (if the recipe specifies one) and craft.\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      # locate workshop cells (they stay static)\n      workshop_cells = list(zip(*np.where(scenario.init_grid[:, :, workshop_idx] > 0)))\n      if workshop_cells:\n          target = workshop_cells[0]  # any workshop cell works\n          path = bfs_to_adjacent(cur_pos, target, occupied)\n          execute_path(path)\n          actions.append(act_map[\"USE\"])\n\n  # Return the full action sequence\n  return actions", "env_interactions": 0, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T19:00:04.793851", "function_name": "make_arrow", "function_body": "  # Action indices\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  world = env.world\n  arrow_idx = world.cookbook.index.index('arrow')\n  primitives_needed = world.cookbook.primitives_for(arrow_idx)\n\n  # --------------------------------------------------------------\n  # Helper utilities\n  # --------------------------------------------------------------\n  def _cell_occupied(pos, grid):\n      \"\"\"Return True if any entity occupies the cell at `pos`.\"\"\"\n      x, y = pos\n      return grid[x, y, :].any()\n\n  def _bfs_path(start, goal, grid):\n      \"\"\"Breadth\u2011first search for a path from start to goal.\"\"\"\n      if start == goal:\n          return [start]\n      width, height = grid.shape[:2]\n      frontier = collections.deque([start])\n      came_from = {start: None}\n      while frontier:\n          cur = frontier.popleft()\n          if cur == goal:\n              break\n          x, y = cur\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height:\n                  nxt = (nx, ny)\n                  if nxt not in came_from:\n                      # Goal cell may be occupied; other cells must be free\n                      if nxt == goal or not _cell_occupied(nxt, grid):\n                          came_from[nxt] = cur\n                          frontier.append(nxt)\n      else:\n          return None  # No path found\n\n      # reconstruct path\n      path = [goal]\n      while path[-1] != start:\n          path.append(came_from[path[-1]])\n      path.reverse()\n      return path\n\n  def _actions_from_path(path):\n      \"\"\"Convert a list of positions into a list of action indices.\"\"\"\n      if not path or len(path) < 2:\n          return []\n      acts = []\n      for (x0, y0), (x1, y1) in zip(path, path[1:]):\n          if x1 == x0 + 1:\n              acts.append(DOWN)\n          elif x1 == x0 - 1:\n              acts.append(UP)\n          elif y1 == y0 + 1:\n              acts.append(RIGHT)\n          elif y1 == y0 - 1:\n              acts.append(LEFT)\n          else:\n              raise ValueError(\"Non\u2011adjacent steps in path\")\n      return acts\n\n  def _move_actions(src, dst, grid):\n      \"\"\"Return actions to move from src to dst, preferring BFS.\"\"\"\n      path = _bfs_path(src, dst, grid)\n      if path is None:\n          # Fallback to Manhattan moves (may hit obstacles but guarantees progress)\n          acts = []\n          x, y = src\n          tx, ty = dst\n          dx, dy = tx - x, ty - y\n          if dx > 0:\n              acts += [DOWN] * dx\n          elif dx < 0:\n              acts += [UP] * (-dx)\n          if dy > 0:\n              acts += [RIGHT] * dy\n          elif dy < 0:\n              acts += [LEFT] * (-dy)\n          return acts\n      return _actions_from_path(path)\n\n  def _nearest_kind(pos, kind_idx, grid):\n      \"\"\"Find nearest cell containing the given kind index.\"\"\"\n      cells = np.argwhere(grid[:, :, kind_idx] > 0)\n      if cells.size == 0:\n          return None\n      dists = np.abs(cells[:, 0] - pos[0]) + np.abs(cells[:, 1] - pos[1])\n      nearest = cells[dists.argmin()]\n      return tuple(nearest.tolist())\n\n  # --------------------------------------------------------------\n  # Planning\n  # --------------------------------------------------------------\n  actions = []\n  cur_pos = env._current_state.pos\n  sim_grid = env._current_state.grid.copy()\n\n  # 1. Collect all required primitive items\n  for prim_idx, count in primitives_needed.items():\n      for _ in range(count):\n          target = _nearest_kind(cur_pos, prim_idx, sim_grid)\n          if target is None:\n              # Primitive not available \u2013 abort planning\n              return actions\n          actions += _move_actions(cur_pos, target, sim_grid)\n          cur_pos = target\n          actions.append(USE)  # pick up primitive\n          sim_grid[target[0], target[1], prim_idx] = 0  # remove from simulated grid\n\n  # 2. Move to workshop (if recipe specifies one) and craft the arrow\n  workshop_name = world.cookbook.recipes.get(arrow_idx, {}).get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_pos = _nearest_kind(cur_pos, workshop_idx, sim_grid)\n      if ws_pos is not None:\n          actions += _move_actions(cur_pos, ws_pos, sim_grid)\n          cur_pos = ws_pos\n          actions.append(USE)  # craft at the workshop\n\n  return actions", "env_interactions": 24, "island_id": 5, "scores": {"3": 0.2}}
