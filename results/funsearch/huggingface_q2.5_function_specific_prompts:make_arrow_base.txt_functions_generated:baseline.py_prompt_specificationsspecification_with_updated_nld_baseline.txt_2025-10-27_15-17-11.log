{"timestamp": "2025-10-27T18:08:55.325172", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Reset the environment and obtain the initial state.\n  env.reset()\n  state = env._current_state          # type: CraftState\n  world = env.world\n\n  # Goal index for the current task (arrow).\n  goal_idx = env.task.goal\n\n  # Primitive requirements for the goal (recursively expanded).\n  needed = world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n\n  # Determine the workshop (if any) where the goal must be crafted.\n  workshop_idx = None\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  ws_name = recipe.get('_at')\n  if ws_name is not None:\n      workshop_idx = world.cookbook.index[ws_name]\n\n  # ------------------------------------------------------------------\n  # Helper utilities.\n  # ------------------------------------------------------------------\n  def locate(kind):\n      \"\"\"Return a list of (x, y) positions where `kind` is present on the grid.\"\"\"\n      inds = np.argwhere(state.grid[:, :, kind] > 0)\n      return [tuple(p) for p in inds]\n\n  def bfs_path(start, target):\n      \"\"\"\n      Compute a path (list of actions) from start to target avoiding blocked cells.\n      Actions: 0=DOWN, 1=UP, 2=LEFT, 3=RIGHT.\n      The target cell is considered traversable even if occupied.\n      \"\"\"\n      occ = np.any(state.grid > 0, axis=2)          # blocked cells\n      # allow stepping onto the target cell\n      occ[target] = False\n      w, h = occ.shape\n      q = deque([(start, [])])\n      visited = {start}\n      while q:\n          pos, path = q.popleft()\n          if pos == target:\n              return path\n          x, y = pos\n          for act, (dx, dy) in ((0, (0, 1)), (1, (0, -1)), (2, (-1, 0)), (3, (1, 0))):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and not occ[nx, ny] and (nx, ny) not in visited:\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [act]))\n      return []  # no path found\n\n  def go_to(target):\n      \"\"\"Move the agent to `target`, recording actions and updating `state`.\"\"\"\n      nonlocal state\n      for act in bfs_path(state.pos, target):\n          actions.append(act)\n          _, state = state.step(act)\n\n  # ------------------------------------------------------------------\n  # Build the action sequence.\n  # ------------------------------------------------------------------\n  actions = []\n\n  # 1. Collect all required primitives.\n  for kind, count in needed.items():\n      for _ in range(count):\n          # Re\u2011search for the primitive after each pickup because the grid changes.\n          positions = locate(kind)\n          if not positions:\n              # Primitive missing \u2013 abort early.\n              return actions\n          # Choose the nearest occurrence (Manhattan distance).\n          target = min(positions,\n                       key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))\n          go_to(target)\n          # Use to pick up the item.\n          actions.append(4)          # USE\n          _, state = state.step(4)\n\n  # 2. If a workshop is required, go there and craft.\n  if workshop_idx is not None:\n      ws_positions = locate(workshop_idx)\n      if ws_positions:\n          target_ws = min(ws_positions,\n                          key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))\n          go_to(target_ws)\n          actions.append(4)          # USE to trigger crafting\n          _, state = state.step(4)\n\n  # Return the compiled list of actions.\n  return actions", "env_interactions": 0, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T18:09:16.055176", "function_name": "make_arrow", "function_body": "  # Reset environment and obtain core objects\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world\n  cookbook = world.cookbook\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow) and its recipe\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n  if goal_idx is None:\n      return []                       # unknown goal, nothing to do\n\n  # Primitive requirements for one arrow\n  primitive_needs = cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  if \"_at\" in recipe:\n      workshop_idx = cookbook.index[recipe[\"_at\"]]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  from collections import deque\n  import numpy as np\n\n  def bfs_path(start, goal, occupied):\n      \"\"\"Return a list of positions from start (excluded) to goal (included)\n      moving only through cells where `occupied` is False. The goal cell may be occupied.\"\"\"\n      w, h = occupied.shape\n      visited = np.zeros((w, h), dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start] = True\n      while q:\n          x, y = q.popleft()\n          if (x, y) == goal:\n              break\n          for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):\n              if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:\n                  # The goal cell can be occupied (e.g., a workshop or resource)\n                  if (nx, ny) == goal or not occupied[nx, ny]:\n                      visited[nx, ny] = True\n                      prev[(nx, ny)] = (x, y)\n                      q.append((nx, ny))\n      if not visited[goal]:\n          return None\n      # reconstruct path (exclude start, include goal)\n      path = []\n      cur = goal\n      while cur != start:\n          path.append(cur)\n          cur = prev[cur]\n      path.reverse()\n      return path\n\n  def delta_to_action(dx, dy):\n      \"\"\"Map a movement delta to the environment's action index.\"\"\"\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise ValueError(\"Invalid movement delta\")\n\n  # ------------------------------------------------------------------\n  # Planning: collect primitives then craft at workshop (if any)\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = tuple(state.pos)          # current (x, y)\n  # mutable copy of the grid to keep track of which primitives are still present\n  grid = state.grid.copy()\n\n  # ------------------------------------------------------------------\n  # 1) Gather all required primitive resources\n  # ------------------------------------------------------------------\n  for kind_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          # locate remaining instances of this primitive on the map\n          locations = np.argwhere(grid[:, :, kind_idx] > 0)\n          if locations.size == 0:\n              break  # nothing left \u2013 should not happen in a well\u2011formed scenario\n\n          # order candidates by Manhattan distance from current position\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n\n          # occupancy mask: any non\u2011zero cell blocks movement\n          occupied_mask = np.any(grid, axis=2)\n\n          target = None\n          path = None\n          for idx in order:\n              cand = tuple(locations[idx])\n              p = bfs_path(cur_pos, cand, occupied_mask)\n              if p is not None:\n                  target = cand\n                  path = p\n                  break\n\n          if target is None:\n              # cannot reach any remaining instance \u2013 give up on this primitive\n              continue\n\n          # follow the path, emitting movement actions\n          for step in path:\n              dx = step[0] - cur_pos[0]\n              dy = step[1] - cur_pos[1]\n              actions.append(delta_to_action(dx, dy))\n              cur_pos = step\n\n          # pick up the primitive\n          actions.append(4)          # USE\n          grid[target[0], target[1], kind_idx] = 0   # mark as collected\n\n  # ------------------------------------------------------------------\n  # 2) Move to the appropriate workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      # find all workshop cells of the required type\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size:\n          dists = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n\n          # Occupancy for navigation: original grid (workshops themselves block movement)\n          occupied_mask = np.any(state.grid, axis=2)\n\n          for idx in order:\n              cand = tuple(workshop_cells[idx])\n              p = bfs_path(cur_pos, cand, occupied_mask)\n              if p is not None:\n                  for step in p:\n                      dx = step[0] - cur_pos[0]\n                      dy = step[1] - cur_pos[1]\n                      actions.append(delta_to_action(dx, dy))\n                      cur_pos = step\n                  actions.append(4)   # USE to trigger crafting\n                  break\n  else:\n      # No specific workshop needed \u2013 just use the current cell to craft\n      actions.append(4)\n\n  return actions", "env_interactions": 26, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T18:09:17.199916", "function_name": "make_arrow", "function_body": "  # reset environment and fetch core objects\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world\n  cookbook = world.cookbook\n\n  # ----------------------------------------------------------------------\n  # Identify the goal (arrow) and its recipe\n  # ----------------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n  if goal_idx is None:\n      return []                       # unknown goal\n\n  primitive_needs = cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  if \"_at\" in recipe:\n      workshop_idx = cookbook.index[recipe[\"_at\"]]\n\n  # ----------------------------------------------------------------------\n  # Helper utilities\n  # ----------------------------------------------------------------------\n  from collections import deque\n  import numpy as np\n\n  def bfs_path(start, goal, occupied):\n      \"\"\"Return a list of positions from start (excluded) to goal (included)\n      moving only through cells where `occupied` is False. The goal cell may be occupied.\"\"\"\n      w, h = occupied.shape\n      visited = np.zeros((w, h), dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start] = True\n      while q:\n          x, y = q.popleft()\n          if (x, y) == goal:\n              break\n          for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):\n              if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:\n                  # Goal cell may be occupied; treat it as walkable.\n                  if (nx, ny) == goal or not occupied[nx, ny]:\n                      visited[nx, ny] = True\n                      prev[(nx, ny)] = (x, y)\n                      q.append((nx, ny))\n      if not visited[goal]:\n          return None\n      # Reconstruct path (exclude start, include goal)\n      path = []\n      cur = goal\n      while cur != start:\n          path.append(cur)\n          cur = prev[cur]\n      path.reverse()\n      return path\n\n  def delta_to_action(dx, dy):\n      \"\"\"Map a movement delta to the environment's action index.\"\"\"\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise ValueError(\"Invalid movement delta\")\n\n  # ----------------------------------------------------------------------\n  # Planning: collect primitives then craft at workshop (if any)\n  # ----------------------------------------------------------------------\n  actions = []\n  cur_pos = tuple(state.pos)          # current (x, y)\n  grid = state.grid.copy()            # mutable copy to track collected items\n\n  # ----------------------------------------------------------------------\n  # 1) Gather required primitive resources\n  # ----------------------------------------------------------------------\n  for kind_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          # Find all remaining cells containing this primitive\n          locations = np.argwhere(grid[:, :, kind_idx] > 0)\n          if locations.size == 0:\n              break  # no more of this primitive on the map\n          # Sort by Manhattan distance from current position\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n\n          occupied_mask = np.any(grid, axis=2)   # treat any entity as blocked\n          target = None\n          path = None\n          for idx in order:\n              cand = tuple(locations[idx])\n              p = bfs_path(cur_pos, cand, occupied_mask)\n              if p is not None:\n                  target = cand\n                  path = p\n                  break\n          if target is None:\n              # Could not reach any remaining instance; abort this primitive\n              continue\n\n          # Follow the path, emitting movement actions\n          for step in path:\n              dx = step[0] - cur_pos[0]\n              dy = step[1] - cur_pos[1]\n              actions.append(delta_to_action(dx, dy))\n              cur_pos = step\n          # Pick up the primitive\n          actions.append(4)          # USE\n          grid[target[0], target[1], kind_idx] = 0   # mark as collected\n\n  # ----------------------------------------------------------------------\n  # 2) Move to workshop (if required) and craft the arrow\n  # ----------------------------------------------------------------------\n  if workshop_idx is not None:\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size:\n          dists = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n          occupied_mask = np.any(state.grid, axis=2)   # original occupancy (workshops block)\n          for idx in order:\n              cand = tuple(workshop_cells[idx])\n              p = bfs_path(cur_pos, cand, occupied_mask)\n              if p is not None:\n                  for step in p:\n                      dx = step[0] - cur_pos[0]\n                      dy = step[1] - cur_pos[1]\n                      actions.append(delta_to_action(dx, dy))\n                      cur_pos = step\n                  actions.append(4)   # USE to trigger crafting\n                  break\n  else:\n      # No specific workshop; simply use the current cell to craft\n      actions.append(4)\n\n  return actions", "env_interactions": 26, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T18:09:39.326136", "function_name": "make_arrow", "function_body": "  # Reset environment and get initial state\n  env.reset()\n  state = env._current_state\n\n  # ------------------------------------------------------------------\n  # Determine the goal index for the arrow\n  # ------------------------------------------------------------------\n  if hasattr(env, \"task\") and hasattr(env.task, \"goal\"):\n      goal_idx = env.task.goal\n  else:\n      goal_idx = env.world.cookbook.index.get(\"arrow\")\n      if goal_idx is None:\n          raise ValueError(\"Arrow not found in cookbook\")\n\n  # ------------------------------------------------------------------\n  # Action mapping\n  # ------------------------------------------------------------------\n  act_spec = env.action_specs()\n  ACT_DOWN = act_spec[\"DOWN\"]\n  ACT_UP = act_spec[\"UP\"]\n  ACT_LEFT = act_spec[\"LEFT\"]\n  ACT_RIGHT = act_spec[\"RIGHT\"]\n  ACT_USE = act_spec[\"USE\"]\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper: BFS pathfinding on free cells (allow stepping onto target)\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  def bfs_path(start, target):\n      \"\"\"Return a list of actions to move from start to target avoiding occupied cells.\"\"\"\n      grid = state.grid\n      h, w, _ = grid.shape\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (y, x), path = q.popleft()\n          if (y, x) == target:\n              return path\n          for act, dy, dx in (\n              (ACT_DOWN, 1, 0),\n              (ACT_UP, -1, 0),\n              (ACT_RIGHT, 0, 1),\n              (ACT_LEFT, 0, -1),\n          ):\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < h and 0 <= nx < w and (ny, nx) not in visited:\n                  # target may be occupied (e.g., a workshop), allow stepping onto it\n                  if not grid[ny, nx, :].any() or (ny, nx) == target:\n                      visited.add((ny, nx))\n                      q.append(((ny, nx), path + [act]))\n      return []  # unreachable\n\n  # ------------------------------------------------------------------\n  # Helper: Move the agent to a free cell\n  # ------------------------------------------------------------------\n  def move_to(target):\n      nonlocal state, actions\n      while state.pos != target:\n          path = bfs_path(state.pos, target)\n          if not path:\n              break  # cannot reach\n          for a in path:\n              actions.append(a)\n              _, _, _ = env.step(a)\n              state = env._current_state\n              if state.pos == target:\n                  break\n\n  # ------------------------------------------------------------------\n  # Helper: Find the nearest cell that contains a given kind index\n  # ------------------------------------------------------------------\n  def find_nearest(kind_idx):\n      grid = state.grid\n      h, w, _ = grid.shape\n      py, px = state.pos\n      best = None\n      best_dist = None\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  d = abs(i - py) + abs(j - px)\n                  if best_dist is None or d < best_dist:\n                      best_dist = d\n                      best = (i, j)\n      return best\n\n  # ------------------------------------------------------------------\n  # Helper: Return a free cell adjacent (including diagonal) to a target cell\n  # ------------------------------------------------------------------\n  def adjacent_free(cell):\n      y, x = cell\n      grid = state.grid\n      h, w, _ = grid.shape\n      # Prefer the cell itself if it is free\n      if not grid[y, x, :].any():\n          return (y, x)\n      for dy in (-1, 0, 1):\n          for dx in (-1, 0, 1):\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < h and 0 <= nx < w and not grid[ny, nx, :].any():\n                  return (ny, nx)\n      return None  # no free adjacent cell\n\n  # ------------------------------------------------------------------\n  # Collect all primitive resources required for the arrow\n  # ------------------------------------------------------------------\n  needed_prims = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  for kind_idx, count in needed_prims.items():\n      for _ in range(count):\n          src = find_nearest(kind_idx)\n          if src is None:\n              raise RuntimeError(f\"Required primitive {kind_idx} not found on map\")\n          adj = adjacent_free(src)\n          if adj is None:\n              raise RuntimeError(f\"No free cell adjacent to primitive {kind_idx}\")\n          move_to(adj)\n          actions.append(ACT_USE)\n          _, _, _ = env.step(ACT_USE)\n          state = env._current_state\n\n  # ------------------------------------------------------------------\n  # Move to the appropriate workshop (if any) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      ws_idx = env.world.cookbook.index[workshop_name]\n      ws_pos = find_nearest(ws_idx)\n      if ws_pos is None:\n          raise RuntimeError(f\"Workshop '{workshop_name}' not found on map\")\n      adj = adjacent_free(ws_pos)\n      if adj is None:\n          raise RuntimeError(f\"No free cell adjacent to workshop '{workshop_name}'\")\n      move_to(adj)\n      actions.append(ACT_USE)\n      _, _, _ = env.step(ACT_USE)\n      state = env._current_state\n\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T18:09:40.448684", "function_name": "make_arrow", "function_body": "  # reset environment and get initial state\n  env.reset()\n  state = env._current_state\n\n  # ------------------------------------------------------------------\n  # Identify the goal index for the arrow\n  # ------------------------------------------------------------------\n  if hasattr(env, \"task\") and hasattr(env.task, \"goal\"):\n      goal_idx = env.task.goal\n  else:\n      goal_idx = env.world.cookbook.index.get(\"arrow\")\n      if goal_idx is None:\n          raise ValueError(\"Arrow item not found in cookbook\")\n\n  # ------------------------------------------------------------------\n  # Action mapping\n  # ------------------------------------------------------------------\n  act_spec = env.action_specs()\n  ACT_DOWN = act_spec[\"DOWN\"]\n  ACT_UP = act_spec[\"UP\"]\n  ACT_LEFT = act_spec[\"LEFT\"]\n  ACT_RIGHT = act_spec[\"RIGHT\"]\n  ACT_USE = act_spec[\"USE\"]\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper: BFS pathfinding on free cells\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  def bfs_path(start, target):\n      \"\"\"Return a list of actions moving from start to target, avoiding occupied cells.\n      The target cell may be occupied (e.g., a workshop) \u2013 we allow stepping onto it.\n      \"\"\"\n      grid = env._current_state.grid\n      h, w, _ = grid.shape\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (y, x), path = q.popleft()\n          if (y, x) == target:\n              return path\n          for act, dy, dx in (\n              (ACT_DOWN, 1, 0),\n              (ACT_UP, -1, 0),\n              (ACT_RIGHT, 0, 1),\n              (ACT_LEFT, 0, -1),\n          ):\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < h and 0 <= nx < w and (ny, nx) not in visited:\n                  # allow moving onto target even if it contains something\n                  if not grid[ny, nx, :].any() or (ny, nx) == target:\n                      visited.add((ny, nx))\n                      q.append(((ny, nx), path + [act]))\n      return []  # unreachable\n\n  # ------------------------------------------------------------------\n  # Helper: move agent to a given free cell\n  # ------------------------------------------------------------------\n  def move_to(target):\n      nonlocal state\n      while state.pos != target:\n          path = bfs_path(state.pos, target)\n          if not path:\n              raise RuntimeError(f\"Cannot reach target cell {target}\")\n          for a in path:\n              actions.append(a)\n              _, _, _ = env.step(a)\n              state = env._current_state\n              if state.pos == target:\n                  break\n\n  # ------------------------------------------------------------------\n  # Helper: locate nearest cell containing a given kind index\n  # ------------------------------------------------------------------\n  def find_nearest(kind_idx):\n      grid = env._current_state.grid\n      h, w, _ = grid.shape\n      py, px = state.pos\n      best = None\n      best_dist = None\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  d = abs(i - py) + abs(j - px)\n                  if best_dist is None or d < best_dist:\n                      best_dist = d\n                      best = (i, j)\n      return best\n\n  # ------------------------------------------------------------------\n  # Helper: pick a free cell (including the cell itself) adjacent to a target cell\n  # ------------------------------------------------------------------\n  def adjacent_free(cell):\n      y, x = cell\n      grid = env._current_state.grid\n      h, w, _ = grid.shape\n      # if the cell itself is free, use it\n      if not grid[y, x, :].any():\n          return (y, x)\n      for dy in (-1, 0, 1):\n          for dx in (-1, 0, 1):\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < h and 0 <= nx < w and not grid[ny, nx, :].any():\n                  return (ny, nx)\n      return None\n\n  # ------------------------------------------------------------------\n  # Collect all primitive resources required for the arrow\n  # ------------------------------------------------------------------\n  needed_prims = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  for kind_idx, cnt in needed_prims.items():\n      for _ in range(cnt):\n          src = find_nearest(kind_idx)\n          if src is None:\n              raise RuntimeError(f\"Required primitive {kind_idx} not present on map\")\n          adj = adjacent_free(src)\n          if adj is None:\n              raise RuntimeError(f\"No free cell adjacent to primitive {kind_idx}\")\n          move_to(adj)\n          actions.append(ACT_USE)\n          _, _, _ = env.step(ACT_USE)\n          state = env._current_state\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      ws_idx = env.world.cookbook.index[workshop_name]\n      ws_pos = find_nearest(ws_idx)\n      if ws_pos is None:\n          raise RuntimeError(f\"Workshop '{workshop_name}' not found on map\")\n      adj = adjacent_free(ws_pos)\n      if adj is None:\n          raise RuntimeError(f\"No free cell adjacent to workshop '{workshop_name}'\")\n      move_to(adj)\n      actions.append(ACT_USE)\n      _, _, _ = env.step(ACT_USE)\n      state = env._current_state\n\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T18:10:00.829803", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ----------------------------------------------------------------------\n  # Constants matching CraftLab.action_specs\n  # ----------------------------------------------------------------------\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # DOWN, UP, LEFT, RIGHT\n  USE = 4\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS to any free cell adjacent to a target cell\n  # ----------------------------------------------------------------------\n  def bfs_to_adjacent(start, target, blocked):\n      \"\"\"Return a list of movement actions that brings the agent from *start*\n      to any empty cell that is 4\u2011connected to *target*.\n      If no such path exists, returns an empty list.\"\"\"\n      h, w = blocked.shape\n      tx, ty = int(target[0]), int(target[1])\n      goal_cells = []\n      for a, (dx, dy) in enumerate(DIRS):\n          gx, gy = tx + dx, ty + dy\n          if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:\n              goal_cells.append((gx, gy))\n      if not goal_cells:\n          return []          # target completely surrounded\n\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (cx, cy), path = q.popleft()\n          if (cx, cy) in goal_cells:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []              # no reachable adjacent cell\n\n  # ----------------------------------------------------------------------\n  # Reset / obtain current state\n  # ----------------------------------------------------------------------\n  try:\n      env.reset()\n  except Exception:\n      pass\n\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []                     # cannot obtain state\n\n  world = env.world\n  idx = world.cookbook.index\n\n  # ----------------------------------------------------------------------\n  # Identify goal (arrow) and its recipe\n  # ----------------------------------------------------------------------\n  try:\n      goal_idx = idx[\"arrow\"]\n  except Exception:\n      return []                     # arrow not defined\n\n  primitives_needed = world.cookbook.primitives_for(goal_idx)\n\n  # locate workshop required for arrow (key stored under \"_at\" or \"_key\")\n  workshop_name = None\n  for k, v in world.cookbook.recipes.get(goal_idx, {}).items():\n      if k in (\"_at\", \"_key\"):\n          workshop_name = v\n          break\n  if workshop_name is None:\n      return []                     # no workshop info\n\n  try:\n      workshop_idx = idx[workshop_name]\n  except Exception:\n      return []                     # workshop name not indexed\n\n  # ----------------------------------------------------------------------\n  # Local mutable copies for planning\n  # ----------------------------------------------------------------------\n  pos = tuple(state.pos)                       # (x, y)\n  grid = state.grid.copy()                     # (W, H, n_kinds)\n  inventory = state.inventory.copy()\n  occupied = np.any(grid > 0, axis=2)          # bool matrix of blocked cells\n\n  plan = []\n\n  # ----------------------------------------------------------------------\n  # Helper: move adjacent to a cell containing *kind_idx* and USE it\n  # ----------------------------------------------------------------------\n  def move_and_use(target_coord, kind_idx):\n      \"\"\"Navigate adjacent to *target_coord* and issue USE.\n      Updates simulated pos, grid, occupied, inventory.\n      Returns False if movement impossible.\"\"\"\n      nonlocal pos, plan, grid, occupied, inventory\n      path = bfs_to_adjacent(pos, target_coord, occupied)\n      if not path and pos != target_coord:\n          return False\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n      plan.extend(path)\n\n      # USE action\n      plan.append(USE)\n\n      tx, ty = int(target_coord[0]), int(target_coord[1])\n      if grid[tx, ty, kind_idx] > 0:\n          grid[tx, ty, kind_idx] = 0\n          occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)\n          inventory[kind_idx] += 1\n      return True\n\n  # ----------------------------------------------------------------------\n  # Collect all required primitives\n  # ----------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      for _ in range(needed_cnt):\n          candidates = np.argwhere(grid[:, :, prim_idx] > 0)\n          if candidates.shape[0] == 0:\n              # primitive not present any more \u2013 stop planning\n              return plan\n          dists = np.abs(candidates[:, 0] - pos[0]) + np.abs(candidates[:, 1] - pos[1])\n          target = tuple(candidates[dists.argmin()])\n          if not move_and_use(target, prim_idx):\n              return plan\n\n  # ----------------------------------------------------------------------\n  # Move to the workshop and craft the arrow\n  # ----------------------------------------------------------------------\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.shape[0] == 0:\n      # workshops are static; fall back to original scenario grid\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.shape[0] == 0:\n          return plan\n\n  dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])\n  workshop_target = tuple(workshop_cells[dists.argmin()])\n  move_and_use(workshop_target, workshop_idx)\n\n  # ----------------------------------------------------------------------\n  # Return the constructed action list\n  # ----------------------------------------------------------------------\n  return plan", "env_interactions": 23, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T18:10:01.951073", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ----------------------------------------------------------------------\n  # Action constants (match CraftLab.action_specs)\n  # ----------------------------------------------------------------------\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # 0:DOWN, 1:UP, 2:LEFT, 3:RIGHT\n  USE = 4\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS to any free cell adjacent to a target cell\n  # ----------------------------------------------------------------------\n  def bfs_adjacent(start, target, blocked):\n      \"\"\"Return list of actions moving from *start* to a free 4\u2011adjacent cell of *target*.\n      If none reachable, return empty list.\"\"\"\n      h, w = blocked.shape\n      tx, ty = target\n      goal_cells = []\n      for a, (dx, dy) in enumerate(DIRS):\n          gx, gy = tx + dx, ty + dy\n          if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:\n              goal_cells.append((gx, gy))\n      if not goal_cells:\n          return []                     # target completely surrounded\n\n      q = deque([(start, [])])\n      visited = {start}\n      while q:\n          (cx, cy), path = q.popleft()\n          if (cx, cy) in goal_cells:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []                         # unreachable\n\n  # ----------------------------------------------------------------------\n  # Reset / fetch current state\n  # ----------------------------------------------------------------------\n  try:\n      env.reset()\n  except Exception:\n      pass\n\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []                         # cannot obtain state\n\n  world = env.world\n  idx = world.cookbook.index\n\n  # ----------------------------------------------------------------------\n  # Identify goal (arrow) and its recipe\n  # ----------------------------------------------------------------------\n  try:\n      goal_idx = idx[\"arrow\"]\n  except Exception:\n      return []                         # arrow not defined\n\n  primitives_needed = world.cookbook.primitives_for(goal_idx)\n\n  # locate workshop name in recipe (key \"_at\" or \"_key\")\n  workshop_name = None\n  for k, v in world.cookbook.recipes.get(goal_idx, {}).items():\n      if k in (\"_at\", \"_key\"):\n          workshop_name = v\n          break\n  if workshop_name is None:\n      return []                         # no workshop info\n\n  try:\n      workshop_idx = idx[workshop_name]\n  except Exception:\n      return []                         # workshop not indexed\n\n  # ----------------------------------------------------------------------\n  # Local mutable copies for planning\n  # ----------------------------------------------------------------------\n  pos = tuple(state.pos)                 # (x, y)\n  grid = state.grid.copy()               # (W, H, n_kinds)\n  inventory = state.inventory.copy()\n  occupied = np.any(grid > 0, axis=2)    # bool matrix of blocked cells\n\n  plan = []\n\n  # ----------------------------------------------------------------------\n  # Helper: move adjacent to a cell containing *kind_idx* and USE it\n  # ----------------------------------------------------------------------\n  def move_and_use(target, kind_idx):\n      \"\"\"Navigate adjacent to *target* and issue USE.\n      Updates simulated pos, grid, occupied, inventory.\n      Returns False if movement impossible.\"\"\"\n      nonlocal pos, plan, grid, occupied, inventory\n      path = bfs_adjacent(pos, target, occupied)\n      if not path and pos != target:\n          return False\n      # simulate movements\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n      plan.extend(path)\n\n      # USE action\n      plan.append(USE)\n\n      tx, ty = target\n      if grid[tx, ty, kind_idx] > 0:\n          # pick up one unit\n          grid[tx, ty, kind_idx] = 0\n          occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)\n          inventory[kind_idx] += 1\n      return True\n\n  # ----------------------------------------------------------------------\n  # Collect all required primitives\n  # ----------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      for _ in range(needed_cnt):\n          candidates = np.argwhere(grid[:, :, prim_idx] > 0)\n          if candidates.shape[0] == 0:\n              # no more of this primitive on the map \u2013 abort planning\n              return plan\n          # choose the closest by Manhattan distance\n          dists = np.abs(candidates[:, 0] - pos[0]) + np.abs(candidates[:, 1] - pos[1])\n          target = tuple(candidates[dists.argmin()])\n          if not move_and_use(target, prim_idx):\n              return plan\n\n  # ----------------------------------------------------------------------\n  # Move to the workshop and craft the arrow\n  # ----------------------------------------------------------------------\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.shape[0] == 0:\n      # fall back to static scenario grid (workshops never disappear)\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.shape[0] == 0:\n          return plan\n  dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])\n  workshop_target = tuple(workshop_cells[dists.argmin()])\n  move_and_use(workshop_target, workshop_idx)\n\n  # ----------------------------------------------------------------------\n  # Return the constructed action list\n  # ----------------------------------------------------------------------\n  return plan", "env_interactions": 23, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T18:10:23.600380", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n\n  goal_idx = env.task.goal\n  action_map = env.action_specs()\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_UP = action_map['UP']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  move_dirs = [\n      (1, 0, ACTION_DOWN),\n      (-1, 0, ACTION_UP),\n      (0, -1, ACTION_LEFT),\n      (0, 1, ACTION_RIGHT),\n  ]\n\n  actions = []\n\n  def find_path(cur_state, target_kind):\n      \"\"\"BFS returning a list of movement actions that brings the agent to a cell\n      containing `target_kind`. The agent may step onto empty cells or the target\n      cell itself; all other occupied cells are treated as obstacles.\"\"\"\n      grid = cur_state.grid\n      H, W, _ = grid.shape\n      start = cur_state.pos\n      visited = {start}\n      q = collections.deque([(start, [])])\n\n      while q:\n          (x, y), path = q.popleft()\n          if grid[x, y, target_kind] > 0:\n              return path\n          for dx, dy, act in move_dirs:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < H and 0 <= ny < W):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              cell = grid[nx, ny, :]\n              # allow moving onto empty cells or directly onto the target cell\n              if cell.sum() == 0 or cell[target_kind] > 0:\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [act]))\n      # No path found \u2013 return empty list (should not happen in valid scenarios)\n      return []\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitives.\n  # ------------------------------------------------------------------\n  required = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n  for prim_kind, cnt in required.items():\n      for _ in range(cnt):\n          path = find_path(state, prim_kind)\n          for a in path:\n              _, state = state.step(a)\n              actions.append(a)\n          # Pick up the primitive now under the agent\n          _, state = state.step(ACTION_USE)\n          actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # 2) Move to the workshop (if any) and craft the goal item.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get('_at')\n  if workshop_kind is not None:\n      path = find_path(state, workshop_kind)\n      for a in path:\n          _, state = state.step(a)\n          actions.append(a)\n      # Use the workshop to craft the item\n      _, state = state.step(ACTION_USE)\n      actions.append(ACTION_USE)\n\n  return actions", "env_interactions": 0, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T18:10:24.728553", "function_name": "make_arrow", "function_body": "  # Reset environment and get current state/world\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n\n  # Goal item index\n  goal_idx = env.task.goal\n\n  # Action indices from the environment spec\n  act_map = env.action_specs()\n  ACTION_DOWN = act_map['DOWN']\n  ACTION_UP = act_map['UP']\n  ACTION_LEFT = act_map['LEFT']\n  ACTION_RIGHT = act_map['RIGHT']\n  ACTION_USE = act_map['USE']\n\n  # Direction vectors paired with their corresponding action ids\n  move_dirs = [\n      (1, 0, ACTION_DOWN),\n      (-1, 0, ACTION_UP),\n      (0, -1, ACTION_LEFT),\n      (0, 1, ACTION_RIGHT),\n  ]\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of movement actions leading to the\n  # nearest cell containing `target_kind`. Cells occupied by any\n  # non\u2011grabbable entity are treated as obstacles.\n  # ------------------------------------------------------------------\n  import collections\n\n  def bfs_path(cur_state, target_kind):\n      grid = cur_state.grid\n      H, W, _ = grid.shape\n      start = cur_state.pos\n      visited = {start}\n      q = collections.deque([(start, [])])\n\n      while q:\n          (x, y), path = q.popleft()\n          if grid[x, y, target_kind] > 0:\n              return path\n          for dx, dy, act in move_dirs:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < H and 0 <= ny < W):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              # treat any non\u2011grabbable entity as a wall\n              blocked = any(grid[nx, ny, idx] > 0 for idx in world.non_grabbable_indices)\n              if blocked:\n                  continue\n              visited.add((nx, ny))\n              q.append(((nx, ny), path + [act]))\n      return None  # unreachable\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitive resources.\n  # ------------------------------------------------------------------\n  required = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n  for prim_kind, cnt in required.items():\n      for _ in range(cnt):\n          path = bfs_path(state, prim_kind)\n          if path is None:\n              raise RuntimeError(f\"Primitive {prim_kind} not reachable\")\n          for a in path:\n              _, state = state.step(a)\n              actions.append(a)\n          # Pick up the primitive that is now under the agent\n          _, state = state.step(ACTION_USE)\n          actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # 2) Move to the workshop (if the recipe specifies one) and craft.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get('_at')\n  if workshop_kind is not None:\n      path = bfs_path(state, workshop_kind)\n      if path is None:\n          raise RuntimeError(\"Workshop not reachable\")\n      for a in path:\n          _, state = state.step(a)\n          actions.append(a)\n      # Use the workshop to craft the goal item\n      _, state = state.step(ACTION_USE)\n      actions.append(ACTION_USE)\n\n  return actions", "env_interactions": 0, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T18:10:41.267948", "function_name": "make_arrow", "function_body": "  # Reset environment to start a fresh episode\n  env.reset()\n  world = env.world\n  scenario = env.scenario\n  state = env._current_state\n\n  # Goal index (the item we need to craft, e.g. \"arrow\")\n  goal_idx = env.task.goal\n\n  # Primitive resources required (including transitive requirements)\n  required = world.cookbook.primitives_for(goal_idx)\n\n  # Determine the workshop kind where the final craft must happen (if any)\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else world.cookbook.index[wk]\n\n  actions: list[int] = []\n  cur_pos = tuple(state.pos)\n\n  # ------------------------------------------------------------------\n  # Helper: Manhattan move sequence (DOWN=0, UP=1, LEFT=2, RIGHT=3)\n  # ------------------------------------------------------------------\n  def moves_to(start: tuple[int, int], target: tuple[int, int]) -> tuple[list[int], tuple[int, int]]:\n      x, y = start\n      tx, ty = target\n      seq: list[int] = []\n      while x < tx:\n          seq.append(3)   # RIGHT\n          x += 1\n      while x > tx:\n          seq.append(2)   # LEFT\n          x -= 1\n      while y < ty:\n          seq.append(0)   # DOWN\n          y += 1\n      while y > ty:\n          seq.append(1)   # UP\n          y -= 1\n      return seq, (x, y)\n\n  # ------------------------------------------------------------------\n  # Helper: locate nearest cell containing a given kind that hasn't been harvested yet\n  # ------------------------------------------------------------------\n  harvested: dict[int, set[tuple[int, int]]] = {}\n\n  def nearest_cell(kind: int, from_pos: tuple[int, int]) -> tuple[int, int] | None:\n      cells = np.argwhere(scenario.init_grid[:, :, kind] > 0)\n      if cells.size == 0:\n          return None\n      used = harvested.get(kind, set())\n      # filter out already harvested locations\n      candidates = [tuple(c) for c in cells if tuple(c) not in used]\n      if not candidates:\n          return None\n      dists = [abs(c[0] - from_pos[0]) + abs(c[1] - from_pos[1]) for c in candidates]\n      return candidates[int(np.argmin(dists))]\n\n  # ------------------------------------------------------------------\n  # Collect all required primitive items\n  # ------------------------------------------------------------------\n  for kind, cnt in required.items():\n      harvested.setdefault(kind, set())\n      for _ in range(cnt):\n          target = nearest_cell(kind, cur_pos)\n          if target is None:\n              # Primitive not found; skip this instance\n              continue\n          move_seq, cur_pos = moves_to(cur_pos, target)\n          actions.extend(move_seq)\n          actions.append(4)               # USE to pick up the primitive\n          harvested[kind].add(target)     # mark this cell as consumed\n\n  # ------------------------------------------------------------------\n  # Move to the workshop (if needed) and perform the final craft\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      target = nearest_cell(workshop_kind, cur_pos)\n      if target is not None:\n          move_seq, cur_pos = moves_to(cur_pos, target)\n          actions.extend(move_seq)\n\n  # Final USE triggers crafting of the goal item (e.g., arrow)\n  actions.append(4)\n\n  return actions", "env_interactions": 1, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T18:10:42.402398", "function_name": "make_arrow", "function_body": "  env.reset()\n  world = env.world\n  scenario = env.scenario\n  state = env._current_state\n\n  goal_idx = env.task.goal\n  required = world.cookbook.primitives_for(goal_idx)\n\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else world.cookbook.index[wk]\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # ------------------------------------------------------------------\n  # Helper: Manhattan moves from start to target.\n  # ------------------------------------------------------------------\n  def moves_to(start, target):\n      x, y = start\n      tx, ty = target\n      seq = []\n      while x < tx:\n          seq.append(3)   # RIGHT\n          x += 1\n      while x > tx:\n          seq.append(2)   # LEFT\n          x -= 1\n      while y < ty:\n          seq.append(0)   # DOWN\n          y += 1\n      while y > ty:\n          seq.append(1)   # UP\n          y -= 1\n      return seq, (x, y)\n\n  # ------------------------------------------------------------------\n  # Helper: locate nearest cell containing a given kind that hasn't\n  # been harvested yet.\n  # ------------------------------------------------------------------\n  harvested = {}\n\n  def nearest_cell(kind, from_pos):\n      cells = np.argwhere(scenario.init_grid[:, :, kind] > 0)\n      if cells.size == 0:\n          return None\n      used = harvested.get(kind, set())\n      candidates = [tuple(c) for c in cells if tuple(c) not in used]\n      if not candidates:\n          return None\n      dists = [abs(c[0] - from_pos[0]) + abs(c[1] - from_pos[1]) for c in candidates]\n      return candidates[int(np.argmin(dists))]\n\n  # ------------------------------------------------------------------\n  # Collect all required primitive items.\n  # ------------------------------------------------------------------\n  for kind, cnt in required.items():\n      harvested.setdefault(kind, set())\n      for _ in range(cnt):\n          target = nearest_cell(kind, cur_pos)\n          if target is None:\n              continue\n          move_seq, cur_pos = moves_to(cur_pos, target)\n          actions.extend(move_seq)\n          actions.append(4)               # USE to pick up\n          harvested[kind].add(target)     # mark as harvested\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if needed) and craft the goal.\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      target = nearest_cell(workshop_kind, cur_pos)\n      if target is not None:\n          move_seq, cur_pos = moves_to(cur_pos, target)\n          actions.extend(move_seq)\n\n  # Final USE triggers crafting of the goal item.\n  actions.append(4)\n\n  return actions", "env_interactions": 1, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T18:11:11.368159", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  # target item\n  goal_name = \"arrow\"\n  goal_idx = idx[goal_name]\n\n  # primitives required for one arrow\n  required = world.cookbook.primitives_for(goal_idx)\n\n  # workshop required for crafting (if any)\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else idx[wk]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def find_locations(kind):\n      \"\"\"Return list of (x, y) cells where `kind` is present.\"\"\"\n      occ = np.where(state.grid[:, :, kind] > 0)\n      return list(zip(occ[0].tolist(), occ[1].tolist()))\n\n  def bfs_path(start, goal):\n      \"\"\"Shortest path (list of positions) from start to goal avoiding non\u2011grabbable cells.\"\"\"\n      if start == goal:\n          return [start]\n      W, H = state.grid.shape[:2]\n\n      # cells occupied by non\u2011grabbable entities are blocked\n      blocked = set()\n      for ng in world.non_grabbable_indices:\n          occ = np.where(state.grid[:, :, ng] > 0)\n          blocked.update(zip(occ[0].tolist(), occ[1].tolist()))\n\n      q = collections.deque([start])\n      prev = {start: None}\n      while q:\n          cur = q.popleft()\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:\n                  nxt = (nx, ny)\n                  if nxt not in prev:\n                      prev[nxt] = cur\n                      if nxt == goal:\n                          # reconstruct path\n                          path = [goal]\n                          while path[-1] != start:\n                              path.append(prev[path[-1]])\n                          path.reverse()\n                          return path\n                      q.append(nxt)\n      # no path found \u2013 stay in place\n      return [start]\n\n  def move_action(cur, nxt):\n      \"\"\"Translate a step from cur to adjacent nxt into an action index.\"\"\"\n      dx, dy = nxt[0] - cur[0], nxt[1] - cur[1]\n      if dx == 1:\n          return 3   # RIGHT\n      if dx == -1:\n          return 2   # LEFT\n      if dy == 1:\n          return 0   # DOWN\n      if dy == -1:\n          return 1   # UP\n      raise AssertionError(\"Non\u2011adjacent move requested\")\n\n  # ------------------------------------------------------------------\n  # Build the action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = state.pos\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in required.items():\n      while state.inventory[prim_idx] < needed_cnt:\n          prim_locs = find_locations(prim_idx)\n          if not prim_locs:\n              # primitive not available on map \u2013 give up on this item\n              break\n\n          # choose nearest instance (Manhattan distance)\n          target = min(\n              prim_locs,\n              key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1])\n          )\n\n          # move to the target\n          path = bfs_path(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n\n          # pick up the primitive\n          actions.append(4)   # USE\n          state.inventory[prim_idx] += 1\n          state.grid[target[0], target[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 2) Move to the workshop (if required) and craft\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      wk_locs = find_locations(workshop_kind)\n      if wk_locs:\n          target = min(\n              wk_locs,\n              key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1])\n          )\n          path = bfs_path(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n  # craft (USE at current location)\n  actions.append(4)   # USE\n\n  return actions", "env_interactions": 19, "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T18:11:12.491310", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  # goal definition\n  goal_name = \"arrow\"\n  goal_idx = idx[goal_name]\n\n  # primitives required for a single arrow\n  primitive_counts = world.cookbook.primitives_for(goal_idx)\n\n  # workshop required for crafting (if any)\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else idx[wk]\n\n  # ------------------------------------------------------------------\n  # helper utilities\n  # ------------------------------------------------------------------\n  def find_locations(kind):\n      \"\"\"Return list of (x, y) positions where `kind` occurs on the grid.\"\"\"\n      occ = np.where(state.grid[:, :, kind] > 0)\n      return list(zip(occ[0].tolist(), occ[1].tolist()))\n\n  def bfs_path(start, goal):\n      \"\"\"Shortest path (list of positions) from start to goal avoiding non\u2011grabbable cells.\"\"\"\n      if start == goal:\n          return [start]\n      W, H = state.grid.shape[:2]\n\n      # cells occupied by non\u2011grabbable entities are blocked\n      blocked = set()\n      for ng in world.non_grabbable_indices:\n          occ = np.where(state.grid[:, :, ng] > 0)\n          blocked.update(zip(occ[0].tolist(), occ[1].tolist()))\n\n      q = collections.deque([start])\n      prev = {start: None}\n      while q:\n          cur = q.popleft()\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:\n                  nxt = (nx, ny)\n                  if nxt not in prev:\n                      prev[nxt] = cur\n                      if nxt == goal:\n                          # reconstruct path\n                          path = [goal]\n                          while path[-1] != start:\n                              path.append(prev[path[-1]])\n                          path.reverse()\n                          return path\n                      q.append(nxt)\n      # no path found \u2013 stay in place\n      return [start]\n\n  def move_action(cur, nxt):\n      \"\"\"Convert adjacent step into action index.\"\"\"\n      dx, dy = nxt[0] - cur[0], nxt[1] - cur[1]\n      if dx == 1:\n          return 3   # RIGHT\n      if dx == -1:\n          return 2   # LEFT\n      if dy == 1:\n          return 0   # DOWN\n      if dy == -1:\n          return 1   # UP\n      raise AssertionError(\"non\u2011adjacent move requested\")\n\n  # ------------------------------------------------------------------\n  # build action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = state.pos\n\n  # 1) collect all required primitives\n  for prim_idx, needed in primitive_counts.items():\n      while state.inventory[prim_idx] < needed:\n          locations = find_locations(prim_idx)\n          if not locations:\n              break  # cannot find more of this primitive\n          # nearest primitive by Manhattan distance\n          target = min(\n              locations,\n              key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1])\n          )\n          # move to the target\n          path = bfs_path(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n          # pick it up\n          actions.append(4)   # USE\n          state.inventory[prim_idx] += 1\n          state.grid[target[0], target[1], prim_idx] = 0\n\n  # 2) go to workshop (if required) and craft\n  if workshop_kind is not None:\n      wk_locs = find_locations(workshop_kind)\n      if wk_locs:\n          target = min(\n              wk_locs,\n              key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1])\n          )\n          path = bfs_path(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n      actions.append(4)   # USE to craft at workshop\n  else:\n      actions.append(4)   # USE to craft in place\n\n  return actions", "env_interactions": 19, "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T18:11:48.498873", "function_name": "make_arrow", "function_body": "  env.reset()\n  world = env.world\n  scenario = env.scenario\n  state = env._current_state\n\n  goal_idx = env.task.goal\n  required = world.cookbook.primitives_for(goal_idx)\n\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else world.cookbook.index[wk]\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  width, height = scenario.init_grid.shape[:2]\n  grid = scenario.init_grid.copy()\n\n  def is_blocked(pos):\n      x, y = pos\n      cell = grid[x, y, :]\n      if world.non_grabbable_indices:\n          idxs = list(world.non_grabbable_indices)\n          return np.any(cell[idxs] > 0)\n      return False\n\n  def bfs_actions(start, target):\n      if start == target:\n          return []\n      from collections import deque\n      queue = deque([start])\n      visited = {start: None}\n      while queue:\n          cur = queue.popleft()\n          if cur == target:\n              break\n          x, y = cur\n          for dx, dy, act in ((0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height:\n                  nxt = (nx, ny)\n                  if nxt not in visited and not is_blocked(nxt):\n                      visited[nxt] = (cur, act)\n                      queue.append(nxt)\n      else:\n          return []\n\n      seq = []\n      cur = target\n      while cur != start:\n          prev, act = visited[cur]\n          seq.append(act)\n          cur = prev\n      seq.reverse()\n      return seq\n\n  def nearest_cell(kind, from_pos):\n      cells = np.argwhere(grid[:, :, kind] > 0)\n      if cells.size == 0:\n          return None\n      dists = np.abs(cells[:, 0] - from_pos[0]) + np.abs(cells[:, 1] - from_pos[1])\n      idx = dists.argmin()\n      return tuple(cells[idx])\n\n  for kind, cnt in required.items():\n      for _ in range(cnt):\n          target = nearest_cell(kind, cur_pos)\n          if target is None:\n              continue\n          actions.extend(bfs_actions(cur_pos, target))\n          actions.append(4)  # USE to pick up\n          grid[target[0], target[1], kind] = 0\n          cur_pos = target\n\n  if workshop_kind is not None:\n      target = nearest_cell(workshop_kind, cur_pos)\n      if target is not None:\n          actions.extend(bfs_actions(cur_pos, target))\n          cur_pos = target\n\n  actions.append(4)  # final USE to craft\n  return actions", "env_interactions": 1, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T18:11:49.611896", "function_name": "make_arrow", "function_body": "  env.reset()\n  world = env.world\n  scenario = env.scenario\n  state = env._current_state\n\n  goal_idx = env.task.goal\n  required = world.cookbook.primitives_for(goal_idx)\n\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else world.cookbook.index[wk]\n\n  actions: list[int] = []\n  cur_pos = tuple(state.pos)\n\n  def moves_to(start, target):\n      x, y = start\n      tx, ty = target\n      seq = []\n      while x < tx:\n          seq.append(3)   # RIGHT\n          x += 1\n      while x > tx:\n          seq.append(2)   # LEFT\n          x -= 1\n      while y < ty:\n          seq.append(0)   # DOWN\n          y += 1\n      while y > ty:\n          seq.append(1)   # UP\n          y -= 1\n      return seq, (x, y)\n\n  def nearest_cell(kind, from_pos, grid):\n      cells = np.argwhere(grid[:, :, kind] > 0)\n      if cells.size == 0:\n          return None\n      dists = np.abs(cells[:, 0] - from_pos[0]) + np.abs(cells[:, 1] - from_pos[1])\n      idx = int(dists.argmin())\n      return tuple(cells[idx])\n\n  grid_copy = scenario.init_grid.copy()\n\n  for kind, cnt in required.items():\n      for _ in range(cnt):\n          target = nearest_cell(kind, cur_pos, grid_copy)\n          if target is None:\n              continue\n          move_seq, cur_pos = moves_to(cur_pos, target)\n          actions.extend(move_seq)\n          actions.append(4)  # USE to pick up\n          grid_copy[target[0], target[1], kind] = 0\n\n  if workshop_kind is not None:\n      target = nearest_cell(workshop_kind, cur_pos, scenario.init_grid)\n      if target is not None:\n          move_seq, cur_pos = moves_to(cur_pos, target)\n          actions.extend(move_seq)\n\n  actions.append(4)  # final USE to craft\n\n  return actions", "env_interactions": 1, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T18:12:10.804990", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ----------------------------------------------------------------------\n  # Action constants (match CraftLab.action_specs)\n  # ----------------------------------------------------------------------\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # DOWN, UP, LEFT, RIGHT\n  USE = 4\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS to any free cell adjacent to a target cell\n  # ----------------------------------------------------------------------\n  def bfs_adjacent(start, target, blocked):\n      \"\"\"Return a list of actions moving from *start* to a free 4\u2011adjacent\n      cell of *target*. Empty list if unreachable.\"\"\"\n      h, w = blocked.shape\n      tx, ty = target\n      goal_cells = []\n      for a, (dx, dy) in enumerate(DIRS):\n          gx, gy = tx + dx, ty + dy\n          if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:\n              goal_cells.append((gx, gy))\n      if not goal_cells:\n          return []\n\n      q = deque([(start, [])])\n      visited = {start}\n      while q:\n          (cx, cy), path = q.popleft()\n          if (cx, cy) in goal_cells:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []\n\n  # ----------------------------------------------------------------------\n  # Reset / fetch current state\n  # ----------------------------------------------------------------------\n  try:\n      env.reset()\n  except Exception:\n      pass\n\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []                         # cannot obtain state\n\n  world = env.world\n  idx = world.cookbook.index\n\n  # ----------------------------------------------------------------------\n  # Identify goal (arrow) and its recipe\n  # ----------------------------------------------------------------------\n  try:\n      goal_idx = idx[\"arrow\"]\n  except Exception:\n      return []                         # arrow not defined\n\n  primitives_needed = world.cookbook.primitives_for(goal_idx)\n\n  # locate workshop name in recipe (key \"_at\" or \"_key\")\n  workshop_name = None\n  for k, v in world.cookbook.recipes.get(goal_idx, {}).items():\n      if k in (\"_at\", \"_key\"):\n          workshop_name = v\n          break\n  if workshop_name is None:\n      return []                         # no workshop info\n\n  try:\n      workshop_idx = idx[workshop_name]\n  except Exception:\n      return []                         # workshop not indexed\n\n  # ----------------------------------------------------------------------\n  # Local mutable copies for planning\n  # ----------------------------------------------------------------------\n  pos = tuple(state.pos)                 # (x, y)\n  grid = state.grid.copy()               # (W, H, n_kinds)\n  inventory = state.inventory.copy()\n  occupied = np.any(grid > 0, axis=2)    # bool matrix of blocked cells\n\n  plan = []\n\n  # ----------------------------------------------------------------------\n  # Helper: move adjacent to a cell containing *kind_idx* and USE it\n  # ----------------------------------------------------------------------\n  def move_and_use(target, kind_idx):\n      \"\"\"Navigate adjacent to *target* and issue USE.\n      Updates simulated pos, grid, occupied, inventory.\n      Returns False if movement impossible.\"\"\"\n      nonlocal pos, plan, grid, occupied, inventory\n      path = bfs_adjacent(pos, target, occupied)\n      if not path and pos != target:\n          return False\n      # simulate movements\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n      plan.extend(path)\n\n      # USE action\n      plan.append(USE)\n\n      tx, ty = target\n      if grid[tx, ty, kind_idx] > 0:\n          # pick up one unit\n          grid[tx, ty, kind_idx] = 0\n          occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)\n          inventory[kind_idx] += 1\n      return True\n\n  # ----------------------------------------------------------------------\n  # Collect all required primitives (or sub\u2011components)\n  # ----------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      for _ in range(needed_cnt):\n          candidates = np.argwhere(grid[:, :, prim_idx] > 0)\n          if candidates.shape[0] == 0:\n              # primitive not present on map \u2013 abort planning\n              return plan\n          # choose the closest by Manhattan distance\n          dists = np.abs(candidates[:, 0] - pos[0]) + np.abs(candidates[:, 1] - pos[1])\n          target = tuple(candidates[dists.argmin()])\n          if not move_and_use(target, prim_idx):\n              return plan\n\n  # ----------------------------------------------------------------------\n  # Move to the workshop and craft the arrow\n  # ----------------------------------------------------------------------\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.shape[0] == 0:\n      # fallback to static scenario grid (workshops never disappear)\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.shape[0] == 0:\n          return plan\n  dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])\n  workshop_target = tuple(workshop_cells[dists.argmin()])\n  move_and_use(workshop_target, workshop_idx)\n\n  # ----------------------------------------------------------------------\n  # Return the constructed action list\n  # ----------------------------------------------------------------------\n  return plan", "env_interactions": 23, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T18:12:11.937445", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ----------------------------------------------------------------------\n  # Action constants (match CraftLab.action_specs)\n  # ----------------------------------------------------------------------\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # 0:DOWN, 1:UP, 2:LEFT, 3:RIGHT\n  USE = 4\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS to any free cell adjacent to a target cell\n  # ----------------------------------------------------------------------\n  def bfs_adjacent(start, target, blocked):\n      \"\"\"Return a list of move actions that brings the agent from *start*\n      to a free 4\u2011adjacent cell of *target*. Empty list if unreachable.\"\"\"\n      h, w = blocked.shape\n      tx, ty = target\n      goal_cells = []\n      for a, (dx, dy) in enumerate(DIRS):\n          gx, gy = tx + dx, ty + dy\n          if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:\n              goal_cells.append((gx, gy))\n      if not goal_cells:\n          return []\n      q = deque([(start, [])])\n      visited = {start}\n      while q:\n          (cx, cy), path = q.popleft()\n          if (cx, cy) in goal_cells:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []\n\n  # ----------------------------------------------------------------------\n  # Reset / fetch current state\n  # ----------------------------------------------------------------------\n  try:\n      env.reset()\n  except Exception:\n      pass\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []                     # cannot obtain state\n\n  world = env.world\n  idx = world.cookbook.index\n\n  # ----------------------------------------------------------------------\n  # Identify goal (arrow) and its recipe\n  # ----------------------------------------------------------------------\n  try:\n      goal_idx = idx[\"arrow\"]\n  except Exception:\n      return []                     # arrow not defined\n\n  # primitives (or sub\u2011components) required for one arrow\n  needed = world.cookbook.primitives_for(goal_idx)\n\n  # locate required workshop (key \"_at\" or \"_key\")\n  workshop_name = None\n  for k, v in world.cookbook.recipes.get(goal_idx, {}).items():\n      if k in (\"_at\", \"_key\"):\n          workshop_name = v\n          break\n  if workshop_name is None:\n      return []                     # no workshop information\n  try:\n      workshop_idx = idx[workshop_name]\n  except Exception:\n      return []                     # unknown workshop\n\n  # ----------------------------------------------------------------------\n  # Local mutable copies for planning\n  # ----------------------------------------------------------------------\n  pos = tuple(state.pos)                     # (x, y)\n  grid = state.grid.copy()                   # (W, H, n_kinds)\n  inventory = state.inventory.copy()\n  occupied = np.any(grid > 0, axis=2)        # bool matrix of blocked cells\n\n  plan = []\n\n  # ----------------------------------------------------------------------\n  # Helper: move adjacent to a cell containing *kind_idx* and USE it\n  # ----------------------------------------------------------------------\n  def move_and_use(target, kind_idx):\n      \"\"\"Navigate adjacent to *target* (which holds *kind_idx*) and issue USE.\n      Updates simulated pos, grid, occupied, inventory. Returns False on failure.\"\"\"\n      nonlocal pos, plan, grid, occupied, inventory\n      path = bfs_adjacent(pos, target, occupied)\n      if not path and pos != target:\n          return False\n      # simulate movements\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n      plan.extend(path)\n\n      # USE action\n      plan.append(USE)\n\n      tx, ty = target\n      if grid[tx, ty, kind_idx] > 0:\n          grid[tx, ty, kind_idx] = 0\n          occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)\n          inventory[kind_idx] += 1\n      return True\n\n  # ----------------------------------------------------------------------\n  # Collect all required primitives / components\n  # ----------------------------------------------------------------------\n  for kind_idx, cnt in needed.items():\n      for _ in range(cnt):\n          locations = np.argwhere(grid[:, :, kind_idx] > 0)\n          if locations.size == 0:\n              # nothing left of this kind \u2013 abort planning\n              return plan\n          dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n          target = tuple(locations[dists.argmin()])\n          if not move_and_use(target, kind_idx):\n              return plan\n\n  # ----------------------------------------------------------------------\n  # Move to the workshop and craft the arrow\n  # ----------------------------------------------------------------------\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      # workshops are static; fall back to original scenario grid\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          return plan\n  dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])\n  workshop_target = tuple(workshop_cells[dists.argmin()])\n  move_and_use(workshop_target, workshop_idx)\n\n  # ----------------------------------------------------------------------\n  # Return the assembled action sequence\n  # ----------------------------------------------------------------------\n  return plan", "env_interactions": 23, "island_id": 8, "scores": {"3": 0.5}}
