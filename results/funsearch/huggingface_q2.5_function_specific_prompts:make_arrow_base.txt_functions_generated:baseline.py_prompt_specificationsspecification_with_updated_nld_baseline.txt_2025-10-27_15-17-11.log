{"timestamp": "2025-10-27T17:38:10.212455", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def _is_walkable(grid, pos, allow_kinds=None):\n      \"\"\"Return True if `pos` is traversable.\n      All occupied cells block movement except those whose kind is in `allow_kinds`.\"\"\"\n      x, y = pos\n      cell = grid[x, y, :]\n      if allow_kinds is None:\n          # no exceptions \u2013 any occupied cell blocks movement\n          return not cell.any()\n      # cell may contain only allowed kinds (or be empty)\n      mask = np.isin(np.arange(cell.shape[0]), list(allow_kinds))\n      # keep only the allowed entries\n      allowed = cell * mask\n      # walkable if after removing allowed entries nothing remains\n      return not (cell - allowed).any()\n\n  def _bfs_path(grid, start, goal, allow_kinds=None):\n      \"\"\"Shortest 4\u2011connected path from start to goal while respecting walkability.\n      Returns list of positions including both ends, or None if unreachable.\"\"\"\n      if start == goal:\n          return [start]\n      w, h = grid.shape[:2]\n      frontier = collections.deque([start])\n      came_from = {start: None}\n      while frontier:\n          cur = frontier.popleft()\n          if cur == goal:\n              break\n          x, y = cur\n          for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h:\n                  nxt = (nx, ny)\n                  if nxt not in came_from and _is_walkable(grid, nxt, allow_kinds):\n                      came_from[nxt] = cur\n                      frontier.append(nxt)\n      else:\n          return None  # unreachable\n\n      # reconstruct path\n      path = [goal]\n      while path[-1] != start:\n          path.append(came_from[path[-1]])\n      path.reverse()\n      return path\n\n  def _actions_from_path(path):\n      \"\"\"Translate a list of adjacent positions into action indices.\"\"\"\n      if not path or len(path) < 2:\n          return []\n      acts = []\n      for (x0, y0), (x1, y1) in zip(path, path[1:]):\n          if x1 == x0 + 1:\n              acts.append(DOWN)\n          elif x1 == x0 - 1:\n              acts.append(UP)\n          elif y1 == y0 + 1:\n              acts.append(RIGHT)\n          elif y1 == y0 - 1:\n              acts.append(LEFT)\n          else:\n              raise ValueError(\"Non\u2011adjacent steps in path\")\n      return acts\n\n  def _move_actions(grid, src, dst, allow_kinds=None):\n      \"\"\"Return actions to move from src to dst using BFS; fallback to Manhattan.\"\"\"\n      path = _bfs_path(grid, src, dst, allow_kinds)\n      if path is None:\n          # Manhattan fallback (might hit obstacles but guarantees progress)\n          acts = []\n          sx, sy = src\n          dx, dy = dst[0] - sx, dst[1] - sy\n          if dx > 0:\n              acts += [DOWN] * dx\n          elif dx < 0:\n              acts += [UP] * (-dx)\n          if dy > 0:\n              acts += [RIGHT] * dy\n          elif dy < 0:\n              acts += [LEFT] * (-dy)\n          return acts\n      return _actions_from_path(path)\n\n  def _nearest_kind(grid, pos, kind_idx):\n      \"\"\"Find the nearest cell (Manhattan) that currently contains `kind_idx`.\"\"\"\n      cells = np.argwhere(grid[:, :, kind_idx] > 0)\n      if cells.size == 0:\n          return None\n      dists = np.abs(cells[:, 0] - pos[0]) + np.abs(cells[:, 1] - pos[1])\n      nearest = cells[dists.argmin()]\n      return tuple(nearest.tolist())\n\n  # ------------------------------------------------------------------\n  # 1. Determine required primitives for the target item (arrow)\n  # ------------------------------------------------------------------\n  world = env.world\n  arrow_idx = world.cookbook.index.index('arrow')\n  primitives_needed = world.cookbook.primitives_for(arrow_idx)  # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # 2. Collect all required primitives\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = tuple(env._current_state.pos)\n  # work on a mutable copy of the grid so we can virtually remove picked items\n  grid = env._current_state.grid.copy()\n\n  for prim_idx, count in primitives_needed.items():\n      for _ in range(count):\n          target = _nearest_kind(grid, cur_pos, prim_idx)\n          if target is None:\n              # primitive not present \u2013 abort planning\n              return actions\n          # allow stepping onto the primitive itself\n          actions += _move_actions(grid, cur_pos, target, allow_kinds={prim_idx})\n          cur_pos = target\n          actions.append(USE)  # pick up primitive\n          # remove the primitive from our planning grid\n          grid[cur_pos[0], cur_pos[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 3. Move to the workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = _nearest_kind(grid, cur_pos, workshop_idx)\n      if workshop_pos is not None:\n          actions += _move_actions(grid, cur_pos, workshop_pos, allow_kinds={workshop_idx})\n          cur_pos = workshop_pos\n          actions.append(USE)  # craft at workshop\n\n  return actions", "env_interactions": 24, "island_id": 5, "scores": {"3": 0.2}}
