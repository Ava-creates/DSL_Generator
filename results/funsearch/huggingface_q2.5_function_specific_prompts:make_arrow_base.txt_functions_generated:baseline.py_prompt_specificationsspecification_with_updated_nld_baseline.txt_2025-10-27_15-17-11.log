{"timestamp": "2025-10-27T19:03:05.595452", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  # Goal: arrow\n  goal_name = \"arrow\"\n  goal_idx = idx[goal_name]\n\n  # Primitive requirements for one arrow\n  needed = world.cookbook.primitives_for(goal_idx)\n\n  # Determine workshop required for crafting (if any)\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else idx[wk]\n\n  # ------------------------------------------------------------------\n  # Helper functions\n  # ------------------------------------------------------------------\n  def find_locations(kind):\n      \"\"\"Return list of (x, y) positions where `kind` is present.\"\"\"\n      occ = np.where(state.grid[:, :, kind] > 0)\n      return list(zip(occ[0].tolist(), occ[1].tolist()))\n\n  def bfs_path(start, goal):\n      \"\"\"Shortest path from start to goal avoiding non\u2011grabbable cells.\"\"\"\n      if start == goal:\n          return [start]\n      W, H = state.grid.shape[:2]\n\n      # blocked cells: any non\u2011grabbable entity present\n      blocked = set()\n      for ng in world.non_grabbable_indices:\n          occ = np.where(state.grid[:, :, ng] > 0)\n          blocked.update(zip(occ[0].tolist(), occ[1].tolist()))\n\n      q = collections.deque([start])\n      prev = {start: None}\n      while q:\n          cur = q.popleft()\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:\n                  nxt = (nx, ny)\n                  if nxt not in prev:\n                      prev[nxt] = cur\n                      if nxt == goal:\n                          # reconstruct path\n                          path = [goal]\n                          while path[-1] != start:\n                              path.append(prev[path[-1]])\n                          path.reverse()\n                          return path\n                      q.append(nxt)\n      # No path found; stay put\n      return [start]\n\n  def move_action(cur, nxt):\n      \"\"\"Convert adjacent step to action index (0:DOWN,1:UP,2:LEFT,3:RIGHT).\"\"\"\n      dx, dy = nxt[0] - cur[0], nxt[1] - cur[1]\n      if dx == 1:\n          return 3   # RIGHT\n      if dx == -1:\n          return 2   # LEFT\n      if dy == 1:\n          return 0   # DOWN\n      if dy == -1:\n          return 1   # UP\n      raise AssertionError(\"non\u2011adjacent move requested\")\n\n  # ------------------------------------------------------------------\n  # Build action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = state.pos\n\n  # 1) Collect required primitives\n  for prim_idx, count_needed in needed.items():\n      while state.inventory[prim_idx] < count_needed:\n          locations = find_locations(prim_idx)\n          if not locations:\n              # primitive not available; break to avoid infinite loop\n              break\n          # Choose nearest primitive (Manhattan distance)\n          target = min(\n              locations,\n              key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1])\n          )\n          # Move to target\n          path = bfs_path(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n          # Pick up primitive\n          actions.append(4)   # USE\n          # Update simulated state\n          state.inventory[prim_idx] += 1\n          state.grid[target[0], target[1], prim_idx] = 0\n\n  # 2) Move to workshop (if required) and craft\n  if workshop_kind is not None:\n      wk_locations = find_locations(workshop_kind)\n      if wk_locations:\n          target = min(\n              wk_locations,\n              key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1])\n          )\n          path = bfs_path(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n      actions.append(4)   # USE to craft at workshop\n  else:\n      actions.append(4)   # USE to craft in place\n\n  return actions", "env_interactions": 19, "island_id": 3, "scores": {"3": 1.5}}
