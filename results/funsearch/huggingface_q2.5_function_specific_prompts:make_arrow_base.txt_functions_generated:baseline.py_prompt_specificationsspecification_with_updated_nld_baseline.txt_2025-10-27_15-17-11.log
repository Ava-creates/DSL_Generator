{"timestamp": "2025-10-27T19:10:05.639162", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  # target item\n  goal_name = \"arrow\"\n  goal_idx = idx[goal_name]\n\n  # primitives needed (expanded)\n  primitive_counts = world.cookbook.primitives_for(goal_idx)\n\n  # workshop required for crafting, if any\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else idx[wk]\n\n  # ------------------------------------------------------------------\n  # Helper functions\n  # ------------------------------------------------------------------\n  def find_positions(kind):\n      \"\"\"Return list of (x, y) where `kind` occurs on the grid.\"\"\"\n      occ = np.where(state.grid[:, :, kind] > 0)\n      return list(zip(occ[0].tolist(), occ[1].tolist()))\n\n  def bfs(start, goal):\n      \"\"\"Shortest 4\u2011connected path avoiding non\u2011grabbable cells.\"\"\"\n      if start == goal:\n          return [start]\n      w, h = state.grid.shape[:2]\n\n      # cells occupied by non\u2011grabbable entities block movement\n      blocked = set()\n      for ng in world.non_grabbable_indices:\n          occ = np.where(state.grid[:, :, ng] > 0)\n          blocked.update(zip(occ[0].tolist(), occ[1].tolist()))\n\n      q = collections.deque([start])\n      prev = {start: None}\n      while q:\n          cur = q.popleft()\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in blocked:\n                  nxt = (nx, ny)\n                  if nxt not in prev:\n                      prev[nxt] = cur\n                      if nxt == goal:\n                          # reconstruct path\n                          path = [goal]\n                          while path[-1] != start:\n                              path.append(prev[path[-1]])\n                          path.reverse()\n                          return path\n                      q.append(nxt)\n      # unreachable \u2013 stay where we are\n      return [start]\n\n  def to_action(cur, nxt):\n      \"\"\"Convert adjacent step to DMLab action index.\"\"\"\n      dx, dy = nxt[0] - cur[0], nxt[1] - cur[1]\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise AssertionError(\"Requested move is not adjacent\")\n\n  # ------------------------------------------------------------------\n  # Build action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  cur = state.pos\n\n  # 1) Collect all required primitives\n  for prim_idx, needed in primitive_counts.items():\n      while state.inventory[prim_idx] < needed:\n          candidates = find_positions(prim_idx)\n          if not candidates:\n              # no more of this primitive on the map\n              break\n          # choose the nearest instance (Manhattan distance)\n          target = min(\n              candidates,\n              key=lambda p: abs(p[0] - cur[0]) + abs(p[1] - cur[1])\n          )\n          # move to the target\n          path = bfs(cur, target)\n          for step in path[1:]:\n              actions.append(to_action(cur, step))\n              cur = step\n          # pick up the primitive\n          actions.append(4)                      # USE\n          state.inventory[prim_idx] += 1\n          state.grid[target[0], target[1], prim_idx] = 0\n\n  # 2) Move to workshop (if required) and craft the arrow\n  if workshop_kind is not None:\n      wk_locs = find_positions(workshop_kind)\n      if wk_locs:\n          target = min(\n              wk_locs,\n              key=lambda p: abs(p[0] - cur[0]) + abs(p[1] - cur[1])\n          )\n          path = bfs(cur, target)\n          for step in path[1:]:\n              actions.append(to_action(cur, step))\n              cur = step\n\n  # final crafting action\n  actions.append(4)  # USE\n\n  return actions", "env_interactions": 19, "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T19:10:31.162261", "function_name": "make_arrow", "function_body": "  env.reset()\n  world = env.world\n  scenario = env.scenario\n  state = env._current_state\n\n  goal_idx = env.task.goal\n  required = world.cookbook.primitives_for(goal_idx)\n\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else world.cookbook.index[wk]\n\n  actions: list[int] = []\n  cur_pos = tuple(state.pos)\n\n  def moves_to(start, target):\n      x, y = start\n      tx, ty = target\n      seq = []\n      while x < tx:\n          seq.append(3)  # RIGHT\n          x += 1\n      while x > tx:\n          seq.append(2)  # LEFT\n          x -= 1\n      while y < ty:\n          seq.append(0)  # DOWN\n          y += 1\n      while y > ty:\n          seq.append(1)  # UP\n          y -= 1\n      return seq, (x, y)\n\n  harvested: dict[int, set[tuple[int, int]]] = {}\n\n  def nearest_cell(kind, from_pos):\n      cells = np.argwhere(scenario.init_grid[:, :, kind] > 0)\n      if cells.size == 0:\n          return None\n      used = harvested.get(kind, set())\n      candidates = [tuple(c) for c in cells if tuple(c) not in used]\n      if not candidates:\n          return None\n      dists = [abs(c[0] - from_pos[0]) + abs(c[1] - from_pos[1]) for c in candidates]\n      idx = int(np.argmin(dists))\n      return candidates[idx]\n\n  for kind, cnt in required.items():\n      harvested.setdefault(kind, set())\n      for _ in range(cnt):\n          target = nearest_cell(kind, cur_pos)\n          if target is None:\n              continue\n          move_seq, cur_pos = moves_to(cur_pos, target)\n          actions.extend(move_seq)\n          actions.append(4)  # USE to pick up\n          harvested[kind].add(target)\n\n  if workshop_kind is not None:\n      target = nearest_cell(workshop_kind, cur_pos)\n      if target is not None:\n          move_seq, cur_pos = moves_to(cur_pos, target)\n          actions.extend(move_seq)\n\n  actions.append(4)  # final USE to craft\n  return actions", "env_interactions": 1, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T19:10:32.292977", "function_name": "make_arrow", "function_body": "  # Reset environment and fetch core objects\n  env.reset()\n  world = env.world\n  scenario = env.scenario\n  state = env._current_state\n\n  goal_idx = env.task.goal\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def moves_to(start, target):\n      \"\"\"Return a list of movement actions (0\u20114) to go from start to target.\"\"\"\n      x, y = start\n      tx, ty = target\n      seq = []\n      while x < tx:\n          seq.append(3)          # RIGHT\n          x += 1\n      while x > tx:\n          seq.append(2)          # LEFT\n          x -= 1\n      while y < ty:\n          seq.append(0)          # DOWN\n          y += 1\n      while y > ty:\n          seq.append(1)          # UP\n          y -= 1\n      return seq, (x, y)\n\n  def nearest_cell(kind, from_pos, grid, taken=None):\n      \"\"\"Find nearest cell containing at least one entity of `kind`.\n      If `taken` is provided it is a set of coordinates that should be ignored.\"\"\"\n      cells = np.argwhere(grid[:, :, kind] > 0)\n      if cells.size == 0:\n          return None\n      if taken is not None:\n          cells = np.array([c for c in cells if tuple(c) not in taken])\n          if cells.size == 0:\n              return None\n      dists = np.abs(cells[:, 0] - from_pos[0]) + np.abs(cells[:, 1] - from_pos[1])\n      idx = int(np.argmin(dists))\n      return tuple(cells[idx])\n\n  # ------------------------------------------------------------------\n  # Determine full crafting order (ingredients before products)\n  # ------------------------------------------------------------------\n  recipes = world.cookbook.recipes\n\n  def dfs(item, visited, order):\n      if item in visited:\n          return\n      visited.add(item)\n      recipe = recipes.get(item, {})\n      for ing, cnt in recipe.items():\n          if ing == \"_at\":\n              continue\n          if cnt <= 0:\n              continue\n          dfs(ing, visited, order)\n      order.append(item)\n\n  craft_order = []\n  dfs(goal_idx, set(), craft_order)          # post\u2011order: ingredients first, goal last\n\n  # ------------------------------------------------------------------\n  # Collect all required primitive resources\n  # ------------------------------------------------------------------\n  primitives_needed = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n  grid_copy = scenario.init_grid.copy()                         # mutable copy for tracking pickups\n  taken_primitives = set()                                      # cells already harvested\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  for prim_idx, cnt in primitives_needed.items():\n      for _ in range(cnt):\n          target = nearest_cell(prim_idx, cur_pos, grid_copy, taken_primitives)\n          if target is None:\n              # No more of this primitive on the map \u2013 give up on this piece\n              continue\n          move_seq, cur_pos = moves_to(cur_pos, target)\n          actions.extend(move_seq)\n          actions.append(4)          # USE to pick up\n          # Mark this cell as consumed\n          grid_copy[target[0], target[1], prim_idx] = 0\n          taken_primitives.add(target)\n\n  # ------------------------------------------------------------------\n  # Perform crafting steps following the computed order\n  # ------------------------------------------------------------------\n  for item_idx in craft_order:\n      # Skip primitives \u2013 they are already in inventory\n      if item_idx in world.cookbook.primitives:\n          continue\n      recipe = recipes.get(item_idx, {})\n      wk = recipe.get(\"_at\", None)\n      if wk is None:\n          # No specific workshop \u2013 just try to USE at current location\n          actions.append(4)\n          continue\n      # Resolve workshop kind to integer index if needed\n      if isinstance(wk, str):\n          wk_idx = world.cookbook.index[wk]\n      else:\n          wk_idx = wk\n      # Locate nearest workshop cell\n      target = nearest_cell(wk_idx, cur_pos, scenario.init_grid)\n      if target is None:\n          # No workshop found \u2013 skip\n          continue\n      move_seq, cur_pos = moves_to(cur_pos, target)\n      actions.extend(move_seq)\n      actions.append(4)              # USE to craft at this workshop\n\n  # ------------------------------------------------------------------\n  # Ensure a final USE in case the last step was just moving\n  # ------------------------------------------------------------------\n  actions.append(4)\n\n  return actions", "env_interactions": 2, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T19:11:01.107764", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Reset the environment and obtain the initial state/world.\n  env.reset()\n  state = env._current_state          # type: CraftState\n  world = env.world\n\n  # Index of the goal item for this task.\n  goal_idx = env.task.goal\n\n  # Primitive requirements for the goal (expanded recursively).\n  needed = world.cookbook.primitives_for(goal_idx)   # dict {kind_idx: count}\n\n  # Determine required workshop (if any) from the recipe.\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  if \"_at\" in recipe:\n      workshop_name = recipe[\"_at\"]\n      workshop_idx = world.cookbook.index[workshop_name]\n\n  # ------------------------------------------------------------------\n  # Helper utilities.\n  # ------------------------------------------------------------------\n  def locate(kind):\n      \"\"\"Return a list of (x, y) positions where `kind` is present on the grid.\"\"\"\n      inds = np.argwhere(state.grid[:, :, kind] > 0)\n      return [tuple(p) for p in inds]\n\n  def bfs_path(start, target):\n      \"\"\"\n      Bread\u2011first search returning a list of actions (0\u2011DOWN,1\u2011UP,2\u2011LEFT,3\u2011RIGHT)\n      that moves from `start` to `target` while avoiding occupied cells.\n      The target cell is treated as traversable even if currently occupied.\n      \"\"\"\n      occ = np.any(state.grid > 0, axis=2)          # True where any entity occupies the cell\n      occ[target[0], target[1]] = False            # allow stepping onto target\n      w, h = occ.shape\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          pos, path = q.popleft()\n          if pos == target:\n              return path\n          x, y = pos\n          for act, (dx, dy) in ((0, (0, 1)), (1, (0, -1)), (2, (-1, 0)), (3, (1, 0))):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and not occ[nx, ny] and (nx, ny) not in visited:\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [act]))\n      return []  # no path found\n\n  def go_to(target):\n      \"\"\"Move the agent from its current position to `target`, recording actions.\"\"\"\n      nonlocal state\n      for act in bfs_path(state.pos, target):\n          actions.append(act)\n          _, state = state.step(act)\n\n  # ------------------------------------------------------------------\n  # Build the action sequence.\n  # ------------------------------------------------------------------\n  actions = []\n\n  # 1. Collect all required primitives.\n  for kind, cnt in needed.items():\n      for _ in range(cnt):\n          positions = locate(kind)\n          if not positions:\n              # Required primitive not present; abort early.\n              return actions\n          # Choose the nearest occurrence (Manhattan distance).\n          target = min(positions,\n                       key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))\n          go_to(target)\n          # Pick up the item.\n          actions.append(4)          # USE\n          _, state = state.step(4)\n\n  # 2. Go to the workshop (if required) and craft the goal item.\n  if workshop_idx is not None:\n      ws_positions = locate(workshop_idx)\n      if ws_positions:\n          target_ws = min(ws_positions,\n                          key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))\n          go_to(target_ws)\n          actions.append(4)          # USE to trigger crafting\n          _, state = state.step(4)\n\n  # Return the compiled list of actions.\n  return actions", "env_interactions": 0, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T19:11:02.232607", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Reset the environment to start a new episode.\n  env.reset()\n  state = env._current_state          # type: CraftState\n  world = env.world\n\n  # Index of the goal item for this task.\n  goal_idx = env.task.goal\n\n  # Primitive requirements for the goal (expanded recursively).\n  needed = world.cookbook.primitives_for(goal_idx)   # dict {kind_idx: count}\n\n  # Determine if the goal must be crafted at a specific workshop.\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  if \"_at\" in recipe:\n      workshop_name = recipe[\"_at\"]\n      workshop_idx = world.cookbook.index[workshop_name]\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper utilities.\n  # ------------------------------------------------------------------\n  def locate(kind):\n      \"\"\"Return a list of (x, y) positions where `kind` occurs on the grid.\"\"\"\n      inds = np.argwhere(state.grid[:, :, kind] > 0)\n      return [tuple(p) for p in inds]\n\n  def bfs_path(start, target):\n      \"\"\"Bread\u2011first search returning a list of actions that moves from `start`\n      to `target` while avoiding blocked cells. The target cell is treated as\n      walkable even if it currently contains an entity.\"\"\"\n      occ = np.any(state.grid > 0, axis=2)          # occupied cells\n      occ[target[0], target[1]] = False             # allow stepping onto target\n      w, h = occ.shape\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          pos, path = q.popleft()\n          if pos == target:\n              return path\n          x, y = pos\n          for act, (dx, dy) in ((0, (0, 1)), (1, (0, -1)),\n                                (2, (-1, 0)), (3, (1, 0))):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and not occ[nx, ny] and (nx, ny) not in visited:\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [act]))\n      return []  # no path found\n\n  def go_to(target):\n      \"\"\"Move the agent from its current position to `target`,\n      recording the actions and updating the state.\"\"\"\n      nonlocal state\n      for act in bfs_path(state.pos, target):\n          actions.append(act)\n          _, state = state.step(act)\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitives.\n  # ------------------------------------------------------------------\n  for kind, count in needed.items():\n      for _ in range(count):\n          positions = locate(kind)\n          if not positions:\n              # Primitive not present; abort early.\n              return actions\n          # Choose the closest occurrence (Manhattan distance).\n          target = min(positions,\n                       key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))\n          go_to(target)\n          # Pick up the item.\n          actions.append(4)          # USE\n          _, state = state.step(4)\n\n  # ------------------------------------------------------------------\n  # 2) If a workshop is required, go there and trigger crafting.\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_positions = locate(workshop_idx)\n      if ws_positions:\n          target_ws = min(ws_positions,\n                          key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))\n          go_to(target_ws)\n          actions.append(4)          # USE to craft\n          _, state = state.step(4)\n\n  # Return the compiled sequence of actions.\n  return actions", "env_interactions": 0, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T19:11:20.186829", "function_name": "make_arrow", "function_body": "  env.reset()\n  world = env.world\n  scenario = env.scenario\n  state = env._current_state\n\n  # Index of the item we need to craft (e.g., \"arrow\")\n  goal_idx = env.task.goal\n\n  # All primitive resources (including transitive) required for the goal\n  required = world.cookbook.primitives_for(goal_idx)\n\n  # Determine if the final crafting must occur at a specific workshop\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else world.cookbook.index[wk]\n\n  actions: list[int] = []\n  cur_pos = tuple(state.pos)\n\n  # ------------------------------------------------------------------\n  # Helper: produce a Manhattan move sequence from start -> target.\n  # Action mapping: DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n  # ------------------------------------------------------------------\n  def moves_to(start: tuple[int, int],\n               target: tuple[int, int]) -> tuple[list[int], tuple[int, int]]:\n      x, y = start\n      tx, ty = target\n      seq: list[int] = []\n      while x < tx:\n          seq.append(3)   # RIGHT\n          x += 1\n      while x > tx:\n          seq.append(2)   # LEFT\n          x -= 1\n      while y < ty:\n          seq.append(0)   # DOWN\n          y += 1\n      while y > ty:\n          seq.append(1)   # UP\n          y -= 1\n      return seq, (x, y)\n\n  # ------------------------------------------------------------------\n  # Helper: locate the nearest cell that still contains a given kind.\n  # ------------------------------------------------------------------\n  harvested: dict[int, set[tuple[int, int]]] = {}\n\n  def nearest_cell(kind: int,\n                   from_pos: tuple[int, int]) -> tuple[int, int] | None:\n      cells = np.argwhere(scenario.init_grid[:, :, kind] > 0)\n      if cells.size == 0:\n          return None\n      used = harvested.get(kind, set())\n      candidates = [tuple(c) for c in cells if tuple(c) not in used]\n      if not candidates:\n          return None\n      dists = [abs(c[0] - from_pos[0]) + abs(c[1] - from_pos[1]) for c in candidates]\n      return candidates[int(np.argmin(dists))]\n\n  # ------------------------------------------------------------------\n  # Collect all required primitive items.\n  # ------------------------------------------------------------------\n  for kind, cnt in required.items():\n      harvested.setdefault(kind, set())\n      for _ in range(cnt):\n          target = nearest_cell(kind, cur_pos)\n          if target is None:\n              # No more available cells of this kind; skip this instance.\n              continue\n          move_seq, cur_pos = moves_to(cur_pos, target)\n          actions.extend(move_seq)\n          actions.append(4)               # USE to pick up the primitive\n          harvested[kind].add(target)     # Mark cell as consumed\n\n  # ------------------------------------------------------------------\n  # Move to the workshop (if required) and perform the final craft.\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      target = nearest_cell(workshop_kind, cur_pos)\n      if target is not None:\n          move_seq, cur_pos = moves_to(cur_pos, target)\n          actions.extend(move_seq)\n\n  # Final USE triggers crafting of the goal item (e.g., arrow).\n  actions.append(4)\n\n  return actions", "env_interactions": 1, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T19:11:21.304766", "function_name": "make_arrow", "function_body": "  env.reset()\n  world = env.world\n  scenario = env.scenario\n  state = env._current_state\n\n  goal_idx = env.task.goal\n  required = world.cookbook.primitives_for(goal_idx)\n\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else world.cookbook.index[wk]\n\n  actions: list[int] = []\n  cur_pos = tuple(state.pos)\n\n  def moves_to(start: tuple[int, int], target: tuple[int, int]) -> tuple[list[int], tuple[int, int]]:\n      x, y = start\n      tx, ty = target\n      seq: list[int] = []\n      while x < tx:\n          seq.append(3)   # RIGHT\n          x += 1\n      while x > tx:\n          seq.append(2)   # LEFT\n          x -= 1\n      while y < ty:\n          seq.append(0)   # DOWN\n          y += 1\n      while y > ty:\n          seq.append(1)   # UP\n          y -= 1\n      return seq, (x, y)\n\n  harvested: dict[int, set[tuple[int, int]]] = {}\n\n  def nearest_cell(kind: int, from_pos: tuple[int, int]) -> tuple[int, int] | None:\n      cells = np.argwhere(scenario.init_grid[:, :, kind] > 0)\n      if cells.size == 0:\n          return None\n      used = harvested.get(kind, set())\n      candidates = [tuple(c) for c in cells if tuple(c) not in used]\n      if not candidates:\n          return None\n      dists = [abs(c[0] - from_pos[0]) + abs(c[1] - from_pos[1]) for c in candidates]\n      return candidates[int(np.argmin(dists))]\n\n  for kind, cnt in required.items():\n      harvested.setdefault(kind, set())\n      for _ in range(cnt):\n          target = nearest_cell(kind, cur_pos)\n          if target is None:\n              continue\n          move_seq, cur_pos = moves_to(cur_pos, target)\n          actions.extend(move_seq)\n          actions.append(4)               # USE to pick up\n          harvested[kind].add(target)\n\n  if workshop_kind is not None:\n      target = nearest_cell(workshop_kind, cur_pos)\n      if target is not None:\n          move_seq, cur_pos = moves_to(cur_pos, target)\n          actions.extend(move_seq)\n\n  actions.append(4)   # final USE to craft the goal\n  return actions", "env_interactions": 1, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T19:11:51.142482", "function_name": "make_arrow", "function_body": "  # Constants for actions (assume standard ordering)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def _grid():\n      \"\"\"Current grid view.\"\"\"\n      return env._current_state.grid\n\n  def _inside(x, y):\n      \"\"\"Check whether (x, y) lies inside the world.\"\"\"\n      w, h, _ = _grid().shape\n      return 0 <= x < w and 0 <= y < h\n\n  def _is_walkable(pos, grid):\n      \"\"\"A cell is walkable if it contains no entities.\"\"\"\n      x, y = pos\n      return not grid[x, y, :].any()\n\n  def _bfs_path(start, goal, grid):\n      \"\"\"Breadth\u2011first search returning a list of positions from start to goal (inclusive).\"\"\"\n      if start == goal:\n          return [start]\n      w, h = grid.shape[:2]\n      frontier = collections.deque([start])\n      came_from = {start: None}\n      while frontier:\n          cur = frontier.popleft()\n          if cur == goal:\n              break\n          x, y = cur\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h:\n                  nxt = (nx, ny)\n                  if nxt not in came_from and _is_walkable(nxt, grid):\n                      came_from[nxt] = cur\n                      frontier.append(nxt)\n      else:\n          return None  # no path found\n\n      # reconstruct path\n      path = [goal]\n      while path[-1] != start:\n          path.append(came_from[path[-1]])\n      path.reverse()\n      return path\n\n  def _actions_from_path(path):\n      \"\"\"Translate a list of positions into action indices.\"\"\"\n      acts = []\n      for (x0, y0), (x1, y1) in zip(path, path[1:]):\n          if x1 == x0 + 1:\n              acts.append(DOWN)\n          elif x1 == x0 - 1:\n              acts.append(UP)\n          elif y1 == y0 + 1:\n              acts.append(RIGHT)\n          elif y1 == y0 - 1:\n              acts.append(LEFT)\n          else:\n              raise ValueError(\"Non\u2011adjacent steps in path\")\n      return acts\n\n  def _nearest_cell(pos, kind_idx, grid):\n      \"\"\"Find the nearest cell (Manhattan) that contains the given kind.\"\"\"\n      coords = np.argwhere(grid[:, :, kind_idx] > 0)\n      if coords.size == 0:\n          return None\n      dists = np.abs(coords[:, 0] - pos[0]) + np.abs(coords[:, 1] - pos[1])\n      nearest = coords[dists.argmin()]\n      return tuple(nearest.tolist())\n\n  def _adjacent_walkable(target, start, grid):\n      \"\"\"Return walkable neighbour of target together with path from start.\"\"\"\n      w, h = grid.shape[:2]\n      candidates = []\n      tx, ty = target\n      for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n          nx, ny = tx + dx, ty + dy\n          if 0 <= nx < w and 0 <= ny < h and _is_walkable((nx, ny), grid):\n              path = _bfs_path(start, (nx, ny), grid)\n              if path is not None:\n                  candidates.append(((nx, ny), path))\n      if not candidates:\n          return None, None\n      adj_pos, best_path = min(candidates, key=lambda x: len(x[1]))\n      return adj_pos, best_path\n\n  # ------------------------------------------------------------------\n  # Planning\n  # ------------------------------------------------------------------\n  world = env.world\n  arrow_idx = world.cookbook.index.index('arrow')\n  primitives_needed = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n\n  planning_grid = _grid().copy()\n  cur_pos = env._current_state.pos\n  plan_actions = []\n\n  # --------------------------------------------------------------\n  # 1. Collect each required primitive\n  # --------------------------------------------------------------\n  for prim_idx, cnt in primitives_needed.items():\n      for _ in range(cnt):\n          prim_cell = _nearest_cell(cur_pos, prim_idx, planning_grid)\n          if prim_cell is None:\n              # Primitive not present \u2013 abort planning\n              return plan_actions\n          adj_pos, path_to_adj = _adjacent_walkable(prim_cell, cur_pos, planning_grid)\n          if adj_pos is None:\n              # Cannot reach a neighbour \u2013 abort\n              return plan_actions\n          plan_actions += _actions_from_path(path_to_adj)\n          cur_pos = adj_pos\n          plan_actions.append(USE)   # pick up the primitive\n          # Remove the primitive from the planning grid\n          planning_grid[prim_cell[0], prim_cell[1], prim_idx] = 0\n\n  # --------------------------------------------------------------\n  # 2. Move to workshop (if required) and craft the arrow\n  # --------------------------------------------------------------\n  workshop_name = world.cookbook.recipes[arrow_idx].get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_cell = _nearest_cell(cur_pos, workshop_idx, planning_grid)\n      if workshop_cell is not None:\n          adj_pos, path_to_adj = _adjacent_walkable(workshop_cell, cur_pos, planning_grid)\n          if adj_pos is not None:\n              plan_actions += _actions_from_path(path_to_adj)\n              cur_pos = adj_pos\n              plan_actions.append(USE)   # craft at the workshop\n\n  return plan_actions", "env_interactions": 23, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T19:11:52.284218", "function_name": "make_arrow", "function_body": "  import collections, numpy as np\n\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  world = env.world\n  arrow_idx = world.cookbook.index.index('arrow')\n  primitives_needed = world.cookbook.primitives_for(arrow_idx)  # {prim_idx: count}\n\n  # mutable copy of the grid for planning (so we can \u201cremove\u201d taken items)\n  planning_grid = env._current_state.grid.copy()\n  cur_pos = env._current_state.pos\n  actions = []\n\n  def _is_walkable(pos, grid):\n      x, y = pos\n      return not grid[x, y, :].any()\n\n  def _bfs_path(start, goal, grid):\n      \"\"\"Return list of positions from start to goal (inclusive) using BFS.\"\"\"\n      if start == goal:\n          return [start]\n      w, h = grid.shape[:2]\n      frontier = collections.deque([start])\n      came_from = {start: None}\n      while frontier:\n          cur = frontier.popleft()\n          if cur == goal:\n              break\n          x, y = cur\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h:\n                  nxt = (nx, ny)\n                  if nxt not in came_from and _is_walkable(nxt, grid):\n                      came_from[nxt] = cur\n                      frontier.append(nxt)\n      else:\n          return None  # no path found\n\n      # reconstruct path\n      path = [goal]\n      while path[-1] != start:\n          path.append(came_from[path[-1]])\n      path.reverse()\n      return path\n\n  def _actions_from_path(path):\n      \"\"\"Translate a position path to action indices.\"\"\"\n      acts = []\n      for (x0, y0), (x1, y1) in zip(path, path[1:]):\n          if x1 == x0 + 1:\n              acts.append(DOWN)\n          elif x1 == x0 - 1:\n              acts.append(UP)\n          elif y1 == y0 + 1:\n              acts.append(RIGHT)\n          elif y1 == y0 - 1:\n              acts.append(LEFT)\n          else:\n              raise ValueError(\"Non\u2011adjacent steps in path\")\n      return acts\n\n  def _nearest_cell(pos, kind_idx, grid):\n      \"\"\"Return coordinates of the nearest cell containing kind_idx (Manhattan).\"\"\"\n      coords = np.argwhere(grid[:, :, kind_idx] > 0)\n      if coords.size == 0:\n          return None\n      dists = np.abs(coords[:, 0] - pos[0]) + np.abs(coords[:, 1] - pos[1])\n      nearest = coords[dists.argmin()]\n      return (int(nearest[0]), int(nearest[1]))\n\n  def _adjacent_walkable(target, start, grid):\n      \"\"\"Find a walkable neighbour of target reachable from start.\"\"\"\n      w, h = grid.shape[:2]\n      candidates = []\n      tx, ty = target\n      for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n          nx, ny = tx + dx, ty + dy\n          if 0 <= nx < w and 0 <= ny < h and _is_walkable((nx, ny), grid):\n              path = _bfs_path(start, (nx, ny), grid)\n              if path is not None:\n                  candidates.append(((nx, ny), path))\n      if not candidates:\n          return None, None\n      # choose the neighbour with the shortest path\n      adj, best_path = min(candidates, key=lambda p: len(p[1]))\n      return adj, best_path\n\n  # --------------------------------------------------------------\n  # Collect required primitives\n  # --------------------------------------------------------------\n  for prim_idx, cnt in primitives_needed.items():\n      for _ in range(cnt):\n          prim_cell = _nearest_cell(cur_pos, prim_idx, planning_grid)\n          if prim_cell is None:\n              return actions  # cannot find needed primitive\n          adj, path_to_adj = _adjacent_walkable(prim_cell, cur_pos, planning_grid)\n          if adj is None:\n              return actions  # cannot reach primitive\n          actions.extend(_actions_from_path(path_to_adj))\n          cur_pos = adj\n          actions.append(USE)  # pick up primitive\n          planning_grid[prim_cell[0], prim_cell[1], prim_idx] = 0  # remove it\n\n  # --------------------------------------------------------------\n  # Move to workshop (if required) and craft the arrow\n  # --------------------------------------------------------------\n  workshop_name = world.cookbook.recipes[arrow_idx].get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_cell = _nearest_cell(cur_pos, workshop_idx, planning_grid)\n      if workshop_cell is not None:\n          adj, path_to_adj = _adjacent_walkable(workshop_cell, cur_pos, planning_grid)\n          if adj is not None:\n              actions.extend(_actions_from_path(path_to_adj))\n              cur_pos = adj\n              actions.append(USE)  # craft at workshop\n\n  return actions", "env_interactions": 23, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T19:12:14.016472", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  ...\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-10-27T19:12:15.134400", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # reset environment and pull useful objects\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.scenario.world          # CraftWorld\n  cookbook = world.cookbook           # Cookbook\n  idx = cookbook.index                # name \u2194 integer id mapping\n\n  # resolve action indices dynamically\n  act_map = env.action_specs()\n  DOWN = act_map[\"DOWN\"]\n  UP = act_map[\"UP\"]\n  LEFT = act_map[\"LEFT\"]\n  RIGHT = act_map[\"RIGHT\"]\n  USE = act_map[\"USE\"]\n  move_defs = [(DOWN, (1, 0)),\n               (UP, (-1, 0)),\n               (LEFT, (0, -1)),\n               (RIGHT, (0, 1))]\n\n  # ------------------------------------------------------------------\n  # Helper: BFS path finder returning a list of movement actions.\n  # ------------------------------------------------------------------\n  def _bfs_path(start, target):\n      \"\"\"Return movement actions from start to target, treating any\n      occupied cell as blocked (except the target cell itself).\"\"\"\n      if start == target:\n          return []\n      h, w = state.grid.shape[:2]\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          for act, (dr, dc) in move_defs:\n              nr, nc = cur[0] + dr, cur[1] + dc\n              if not (0 <= nr < h and 0 <= nc < w):\n                  continue\n              nxt = (nr, nc)\n              if nxt in visited:\n                  continue\n              # allow stepping onto the target even if it is occupied\n              if nxt != target and state.grid[nr, nc, :].sum() != 0:\n                  continue\n              visited.add(nxt)\n              parent[nxt] = (cur, act)\n              q.append(nxt)\n      if target not in parent and start != target:\n          return []          # no path found\n      # reconstruct path\n      path = []\n      cur = target\n      while cur != start:\n          prev, act = parent[cur]\n          path.append(act)\n          cur = prev\n      path.reverse()\n      return path\n\n  # ------------------------------------------------------------------\n  # Identify goal (arrow) and its primitive requirements.\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  if goal_name not in idx.contents:\n      return []                     # arrow not defined in this world\n  goal_idx = idx[goal_name]\n  primitive_needs = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n  actions = []                     # final action list\n\n  # ------------------------------------------------------------------\n  # Phase 1: Collect each required primitive the required number of times.\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          # locate all cells currently holding this primitive\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # primitive missing \u2013 abort early\n              return actions\n          # pick nearest primitive (Manhattan distance)\n          dists = np.abs(prim_cells - np.array(state.pos)).sum(axis=1)\n          tr, tc = prim_cells[dists.argmin()]\n\n          # move to the primitive\n          move_seq = _bfs_path(state.pos, (tr, tc))\n          actions.extend(move_seq)\n          state.pos = (tr, tc)\n\n          # pick it up\n          actions.append(USE)\n          state.inventory[prim_idx] += 1\n          state.grid[tr, tc, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Phase 2: Go to the appropriate workshop and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      return actions                # no workshop info, cannot craft\n  workshop_idx = idx[workshop_name]\n\n  # locate workshop cells\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      return actions                # workshop not present\n  dists = np.abs(workshop_cells - np.array(state.pos)).sum(axis=1)\n  wr, wc = workshop_cells[dists.argmin()]\n\n  # move to workshop\n  move_seq = _bfs_path(state.pos, (wr, wc))\n  actions.extend(move_seq)\n  state.pos = (wr, wc)\n\n  # craft the arrow\n  actions.append(USE)\n\n  return actions", "env_interactions": 24, "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T19:12:45.913092", "function_name": "make_arrow", "function_body": "  import collections, numpy as np\n\n  # Action indices (match CraftWorld definition)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  world = env.world\n  goal_name = \"arrow\"\n  goal_idx = world.cookbook.index.index(goal_name)\n\n  # Required primitive kinds and their counts\n  prim_req = world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n\n  # Current mutable copies of grid and position\n  grid = env._current_state.grid.copy()\n  cur_pos = tuple(env._current_state.pos)\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def bfs(start, target, target_kind):\n      \"\"\"Bread\u2011first search that treats any occupied cell as blocked,\n      except the target cell (which may contain target_kind). Returns a list\n      of positions from start to target inclusive, or None if no path.\"\"\"\n      if start == target:\n          return [start]\n      w, h = grid.shape[:2]\n      frontier = collections.deque([start])\n      came_from = {start: None}\n      while frontier:\n          cur = frontier.popleft()\n          if cur == target:\n              break\n          x, y = cur\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h:\n                  nxt = (nx, ny)\n                  if nxt in came_from:\n                      continue\n                  # Allow stepping onto the goal even if occupied\n                  if nxt != target and grid[nx, ny, :].any():\n                      continue\n                  came_from[nxt] = cur\n                  frontier.append(nxt)\n      else:\n          return None\n      # reconstruct path\n      path = [target]\n      while path[-1] != start:\n          path.append(came_from[path[-1]])\n      path.reverse()\n      return path\n\n  def path_to_actions(path):\n      \"\"\"Translate a list of positions into action indices.\"\"\"\n      if not path or len(path) < 2:\n          return []\n      acts = []\n      for (x0, y0), (x1, y1) in zip(path, path[1:]):\n          if x1 == x0 + 1:\n              acts.append(DOWN)\n          elif x1 == x0 - 1:\n              acts.append(UP)\n          elif y1 == y0 + 1:\n              acts.append(RIGHT)\n          elif y1 == y0 - 1:\n              acts.append(LEFT)\n          else:\n              raise ValueError(\"Non\u2011adjacent steps in path\")\n      return acts\n\n  def move_to(src, dst, kind_idx):\n      \"\"\"Return actions moving from src to dst, treating dst as walkable even if occupied.\"\"\"\n      p = bfs(src, dst, kind_idx)\n      if p is None:\n          # fallback to Manhattan moves (may collide with obstacles)\n          acts = []\n          sx, sy = src\n          dx, dy = dst\n          if dx > sx:\n              acts += [DOWN] * (dx - sx)\n          elif dx < sx:\n              acts += [UP] * (sx - dx)\n          if dy > sy:\n              acts += [RIGHT] * (dy - sy)\n          elif dy < sy:\n              acts += [LEFT] * (sy - dy)\n          return acts\n      return path_to_actions(p)\n\n  def nearest_cell(pos, kind_idx, forbidden):\n      \"\"\"Find the nearest cell containing kind_idx not in forbidden set.\"\"\"\n      candidates = np.argwhere(grid[:, :, kind_idx] > 0)\n      if candidates.size == 0:\n          return None\n      if forbidden:\n          mask = np.array([tuple(c) not in forbidden for c in candidates])\n          candidates = candidates[mask]\n          if candidates.size == 0:\n              return None\n      dists = np.abs(candidates[:, 0] - pos[0]) + np.abs(candidates[:, 1] - pos[1])\n      nearest = candidates[dists.argmin()]\n      return tuple(nearest.tolist())\n\n  # ------------------------------------------------------------------\n  # Planning\n  # ------------------------------------------------------------------\n  actions = []\n  harvested = {k: set() for k in prim_req}\n\n  # 1. Collect all required primitives\n  for kind_idx, needed in prim_req.items():\n      for _ in range(needed):\n          target = nearest_cell(cur_pos, kind_idx, harvested[kind_idx])\n          if target is None:\n              # primitive missing \u2013 abort planning\n              return actions\n          actions += move_to(cur_pos, target, kind_idx)\n          cur_pos = target\n          actions.append(USE)                     # pick up\n          harvested[kind_idx].add(target)\n          grid[target[0], target[1], kind_idx] = 0   # mark as taken\n\n  # 2. Move to workshop (if recipe specifies one) and craft\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_target = nearest_cell(cur_pos, workshop_idx, set())\n      if ws_target is not None:\n          actions += move_to(cur_pos, ws_target, workshop_idx)\n          cur_pos = ws_target\n          actions.append(USE)                     # craft at workshop\n\n  return actions", "env_interactions": 24, "island_id": 5, "scores": {"3": 0.2}}
{"timestamp": "2025-10-27T19:12:47.040657", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action constants (match environment definition)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  world = env.world\n  goal_name = \"arrow\"\n  goal_idx = world.cookbook.index.index(goal_name)\n\n  # Primitive requirements for one arrow: {prim_idx: count}\n  prim_req = world.cookbook.primitives_for(goal_idx)\n\n  # Current mutable view of the grid and agent position\n  grid = env._current_state.grid\n  cur_pos = tuple(env._current_state.pos)  # (row, col)\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def bfs(start, goal, ignore_kind=None):\n      \"\"\"Bread\u2011first search returning a list of positions from start to goal.\n      Cells occupied by any entity are avoided unless they contain ignore_kind.\"\"\"\n      if start == goal:\n          return [start]\n      w, h = grid.shape[:2]\n      frontier = deque([start])\n      came_from = {start: None}\n      while frontier:\n          cur = frontier.popleft()\n          if cur == goal:\n              break\n          x, y = cur\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h:\n                  nxt = (nx, ny)\n                  if nxt in came_from:\n                      continue\n                  # Allow stepping onto the goal cell even if occupied\n                  if nxt != goal and grid[nx, ny, :].any():\n                      # If we are allowed to ignore a specific kind (e.g., the target primitive)\n                      if ignore_kind is not None and grid[nx, ny, ignore_kind] > 0:\n                          pass\n                      else:\n                          continue\n                  came_from[nxt] = cur\n                  frontier.append(nxt)\n      else:\n          return None  # no path found\n\n      # reconstruct path\n      path = [goal]\n      while path[-1] != start:\n          path.append(came_from[path[-1]])\n      path.reverse()\n      return path\n\n  def path_to_actions(path):\n      \"\"\"Convert a list of positions to action indices.\"\"\"\n      if not path or len(path) < 2:\n          return []\n      acts = []\n      for (x0, y0), (x1, y1) in zip(path, path[1:]):\n          if x1 == x0 + 1:\n              acts.append(DOWN)\n          elif x1 == x0 - 1:\n              acts.append(UP)\n          elif y1 == y0 + 1:\n              acts.append(RIGHT)\n          elif y1 == y0 - 1:\n              acts.append(LEFT)\n          else:\n              raise ValueError(\"Non\u2011adjacent positions in path\")\n      return acts\n\n  def move_to(src, dst, ignore_kind=None):\n      \"\"\"Return actions moving from src to dst using BFS; fallback to Manhattan.\"\"\"\n      p = bfs(src, dst, ignore_kind)\n      if p is None:\n          # fallback: simple Manhattan moves (may collide with obstacles)\n          sx, sy = src\n          dx, dy = dst\n          acts = []\n          if dx > sx:\n              acts += [DOWN] * (dx - sx)\n          elif dx < sx:\n              acts += [UP] * (sx - dx)\n          if dy > sy:\n              acts += [RIGHT] * (dy - sy)\n          elif dy < sy:\n              acts += [LEFT] * (sy - dy)\n          return acts\n      return path_to_actions(p)\n\n  def nearest(pos, kind_idx, banned):\n      \"\"\"Find nearest cell containing kind_idx not in banned set.\"\"\"\n      candidates = np.argwhere(grid[:, :, kind_idx] > 0)\n      if candidates.size == 0:\n          return None\n      if banned:\n          mask = np.array([tuple(c) not in banned for c in candidates])\n          candidates = candidates[mask]\n          if candidates.size == 0:\n              return None\n      dists = np.abs(candidates[:, 0] - pos[0]) + np.abs(candidates[:, 1] - pos[1])\n      nearest_idx = dists.argmin()\n      return tuple(candidates[nearest_idx].tolist())\n\n  # ------------------------------------------------------------------\n  # Planning\n  # ------------------------------------------------------------------\n  harvested = {k: set() for k in prim_req.keys()}\n\n  # 1. Collect required primitives\n  for kind_idx, count in prim_req.items():\n      for _ in range(count):\n          target = nearest(cur_pos, kind_idx, harvested[kind_idx])\n          if target is None:\n              # Primitive unavailable \u2013 abort planning early\n              return actions\n          actions += move_to(cur_pos, target, ignore_kind=kind_idx)\n          cur_pos = target\n          actions.append(USE)          # pick up primitive\n          harvested[kind_idx].add(target)\n          # Remove the primitive from the planning grid\n          grid[target[0], target[1], kind_idx] = 0\n\n  # 2. Move to workshop (if recipe specifies one) and craft\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_target = nearest(cur_pos, workshop_idx, set())\n      if ws_target is not None:\n          actions += move_to(cur_pos, ws_target)\n          cur_pos = ws_target\n          actions.append(USE)          # craft at workshop\n\n  return actions", "env_interactions": 24, "island_id": 5, "scores": {"3": 0.2}}
{"timestamp": "2025-10-27T19:13:16.379926", "function_name": "make_arrow", "function_body": "  # Reset the environment (ignore errors if already reset)\n  try:\n      env.reset()\n  except Exception:\n      pass\n\n  # ------------------------------------------------------------------\n  # Action mapping\n  # ------------------------------------------------------------------\n  action_map = env.action_specs()\n  DOWN = action_map.get(\"DOWN\")\n  UP = action_map.get(\"UP\")\n  LEFT = action_map.get(\"LEFT\")\n  RIGHT = action_map.get(\"RIGHT\")\n  USE = action_map.get(\"USE\")\n  # Fallback to typical indices if the env uses a different ordering\n  if None in (DOWN, UP, LEFT, RIGHT, USE):\n      DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Identify the goal item index\n  # ------------------------------------------------------------------\n  goal_idx = None\n  task = getattr(env, \"task\", None)\n  if task is not None:\n      goal_idx = getattr(task, \"goal\", None)\n      if goal_idx is None and isinstance(task, (list, tuple)):\n          goal_idx = task[0]\n  if goal_idx is None:\n      try:\n          goal_idx = env.world.cookbook.index[\"arrow\"]\n      except Exception:\n          return []\n\n  # ------------------------------------------------------------------\n  # Initial mutable state\n  # ------------------------------------------------------------------\n  actions: list[int] = []\n  cur_pos = list(env._current_state.pos)          # [x, y]\n  grid = env._current_state.grid.copy()           # simulate pickups locally\n\n  import numpy as np\n  from collections import deque\n\n  # ------------------------------------------------------------------\n  # Helper: compute blocked cells (non\u2011grabbable entities)\n  # ------------------------------------------------------------------\n  def compute_blocked(g: np.ndarray) -> np.ndarray:\n      blocked = np.zeros(g.shape[:2], dtype=bool)\n      for idx in env.world.non_grabbable_indices:\n          blocked |= (g[:, :, idx] > 0)\n      return blocked\n\n  # ------------------------------------------------------------------\n  # Helper: BFS shortest path avoiding blocked cells.\n  # Returns a list of movement actions that lead from start to any cell\n  # in the target set. If start is already in targets, returns [].\n  # ------------------------------------------------------------------\n  def bfs_path(start: tuple[int, int],\n               targets: set[tuple[int, int]],\n               blocked: np.ndarray) -> list[int]:\n      if start in targets:\n          return []\n      W, H = blocked.shape\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = np.full((W, H), False, dtype=bool)\n      visited[start[0], start[1]] = True\n      moves = [(DOWN, (0, 1)),\n               (UP,   (0, -1)),\n               (LEFT, (-1, 0)),\n               (RIGHT,(1, 0))]\n      while q:\n          x, y, path = q.popleft()\n          for act, (dx, dy) in moves:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny] and not blocked[nx, ny]:\n                  new_path = path + [act]\n                  if (nx, ny) in targets:\n                      return new_path\n                  visited[nx, ny] = True\n                  q.append((nx, ny, new_path))\n      return []   # unreachable\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitive resources\n  # ------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)\n  for kind_idx, needed in primitives_needed.items():\n      for _ in range(needed):\n          # locate remaining instances of this primitive\n          positions = np.argwhere(grid[:, :, kind_idx] > 0)\n          if positions.size == 0:\n              break  # none left on the map\n          blocked = compute_blocked(grid)\n          target_set = {tuple(p) for p in positions.tolist()}\n          path = bfs_path(tuple(cur_pos), target_set, blocked)\n          if not path:\n              break  # cannot reach any remaining instance\n          # move to the primitive\n          actions.extend(path)\n          for a in path:\n              if a == DOWN:\n                  cur_pos[1] += 1\n              elif a == UP:\n                  cur_pos[1] -= 1\n              elif a == LEFT:\n                  cur_pos[0] -= 1\n              elif a == RIGHT:\n                  cur_pos[0] += 1\n          # pick it up\n          actions.append(USE)\n          # simulate removal from the grid\n          grid[cur_pos[0], cur_pos[1], kind_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 2. Go to the appropriate workshop (if any) and craft\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      ws_positions = np.argwhere(grid[:, :, workshop_kind] > 0)\n      if ws_positions.size > 0:\n          blocked = compute_blocked(grid)\n          ws_set = {tuple(p) for p in ws_positions.tolist()}\n          ws_path = bfs_path(tuple(cur_pos), ws_set, blocked)\n          if ws_path:\n              actions.extend(ws_path)\n              for a in ws_path:\n                  if a == DOWN:\n                      cur_pos[1] += 1\n                  elif a == UP:\n                      cur_pos[1] -= 1\n                  elif a == LEFT:\n                      cur_pos[0] -= 1\n                  elif a == RIGHT:\n                      cur_pos[0] += 1\n  # final USE to trigger crafting\n  actions.append(USE)\n\n  return actions", "env_interactions": 1, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T19:13:17.499724", "function_name": "make_arrow", "function_body": "  # Ensure the environment is in a fresh state.\n  try:\n      env.reset()\n  except Exception:\n      pass\n\n  # ------------------------------------------------------------------\n  # Determine the goal item index (the item we need to craft).\n  # ------------------------------------------------------------------\n  goal_idx = None\n  task = getattr(env, \"task\", None)\n  if task is not None:\n      goal_idx = getattr(task, \"goal\", None)\n      if goal_idx is None and isinstance(task, (list, tuple)):\n          goal_idx = task[0]\n  if goal_idx is None:\n      # Fallback to the name \"arrow\" if the task does not expose the goal.\n      try:\n          goal_idx = env.world.cookbook.index[\"arrow\"]\n      except Exception:\n          return []\n\n  # ------------------------------------------------------------------\n  # Action mapping (may differ between environments).\n  # ------------------------------------------------------------------\n  spec = env.action_specs()\n  DOWN = spec.get(\"DOWN\", 0)\n  UP = spec.get(\"UP\", 1)\n  LEFT = spec.get(\"LEFT\", 2)\n  RIGHT = spec.get(\"RIGHT\", 3)\n  USE = spec.get(\"USE\", 4)\n\n  # ------------------------------------------------------------------\n  # Helper to generate Manhattan moves from the current mutable position\n  # to a target cell, updating the mutable position as we go.\n  # ------------------------------------------------------------------\n  cur_pos = list(env._current_state.pos)  # [x, y]\n\n  def move_to(target):\n      tx, ty = target\n      moves = []\n      while cur_pos[0] < tx:\n          moves.append(RIGHT)\n          cur_pos[0] += 1\n      while cur_pos[0] > tx:\n          moves.append(LEFT)\n          cur_pos[0] -= 1\n      while cur_pos[1] < ty:\n          moves.append(DOWN)\n          cur_pos[1] += 1\n      while cur_pos[1] > ty:\n          moves.append(UP)\n          cur_pos[1] -= 1\n      return moves\n\n  # ------------------------------------------------------------------\n  # Work on a local copy of the grid so we can simulate pickups.\n  # ------------------------------------------------------------------\n  import numpy as np\n  grid = env._current_state.grid.copy()\n\n  plan = []\n\n  # ------------------------------------------------------------------\n  # 1. Collect all primitive resources required for the goal item.\n  # ------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)\n  for kind_idx, count_needed in primitives_needed.items():\n      remaining = count_needed\n      while remaining > 0:\n          # Locate all cells that currently contain this primitive.\n          positions = np.argwhere(grid[:, :, kind_idx] > 0)\n          if positions.size == 0:\n              # No more of this primitive on the map \u2013 abort collection for this kind.\n              break\n\n          # Choose the nearest instance (Manhattan distance).\n          dists = np.abs(positions[:, 0] - cur_pos[0]) + np.abs(positions[:, 1] - cur_pos[1])\n          nearest = int(dists.argmin())\n          target = tuple(positions[nearest])\n\n          # Move to the primitive and pick it up.\n          plan.extend(move_to(target))\n          plan.append(USE)\n\n          # Simulate the pickup in the local grid copy.\n          grid[target[0], target[1], kind_idx] = 0\n          remaining -= 1\n\n  # ------------------------------------------------------------------\n  # 2. Go to the appropriate workshop (if any) and craft the item.\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      ws_positions = np.argwhere(grid[:, :, workshop_kind] > 0)\n      if ws_positions.size > 0:\n          dists = np.abs(ws_positions[:, 0] - cur_pos[0]) + np.abs(ws_positions[:, 1] - cur_pos[1])\n          nearest_ws = int(dists.argmin())\n          ws_target = tuple(ws_positions[nearest_ws])\n          plan.extend(move_to(ws_target))\n\n  # Final USE action to trigger crafting at the current location (or workshop).\n  plan.append(USE)\n\n  return plan", "env_interactions": 1, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T19:13:49.988359", "function_name": "make_arrow", "function_body": "  # Reset the environment and obtain handles to the current state and world.\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n\n  # Map action names to their integer indices.\n  act_map = env.action_specs()\n  ACTION_DOWN = act_map['DOWN']\n  ACTION_UP = act_map['UP']\n  ACTION_LEFT = act_map['LEFT']\n  ACTION_RIGHT = act_map['RIGHT']\n  ACTION_USE = act_map['USE']\n\n  # Directions used for BFS (dx, dy, corresponding action).\n  move_dirs = [\n      (1, 0, ACTION_DOWN),\n      (-1, 0, ACTION_UP),\n      (0, -1, ACTION_LEFT),\n      (0, 1, ACTION_RIGHT),\n  ]\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns the shortest list of movement actions that\n  # brings the agent onto a cell containing `target_kind`.  Cells that\n  # contain any non\u2011grabbable entity are treated as obstacles.\n  # ------------------------------------------------------------------\n  import collections\n\n  def bfs_path(cur_state, target_kind):\n      grid = cur_state.grid\n      H, W, _ = grid.shape\n      start = cur_state.pos\n      visited = {start}\n      q = collections.deque([(start, [])])\n\n      while q:\n          (x, y), path = q.popleft()\n          if grid[x, y, target_kind] > 0:\n              return path\n          for dx, dy, act in move_dirs:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < H and 0 <= ny < W):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              # Block movement onto cells occupied by non\u2011grabbable items.\n              blocked = any(grid[nx, ny, idx] > 0 for idx in world.non_grabbable_indices)\n              if blocked:\n                  continue\n              visited.add((nx, ny))\n              q.append(((nx, ny), path + [act]))\n      # Target unreachable \u2013 return None (should not happen for valid tasks).\n      return None\n\n  # ------------------------------------------------------------------\n  # 1) Collect every primitive required for the goal.\n  # ------------------------------------------------------------------\n  goal_idx = env.task.goal\n  needed_primitives = world.cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n\n  for prim_idx, cnt in needed_primitives.items():\n      for _ in range(cnt):\n          path = bfs_path(state, prim_idx)\n          if path is None:\n              continue  # Unreachable primitive; skip (unlikely in well\u2011formed scenarios).\n          for act in path:\n              _, state = state.step(act)\n              actions.append(act)\n          # Pick up the primitive located under the agent.\n          _, state = state.step(ACTION_USE)\n          actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # 2) Move to the appropriate workshop (if any) and craft the goal.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get('_at')\n  if workshop_kind is not None:\n      path = bfs_path(state, workshop_kind)\n      if path:\n          for act in path:\n              _, state = state.step(act)\n              actions.append(act)\n          # Use the workshop to craft the item.\n          _, state = state.step(ACTION_USE)\n          actions.append(ACTION_USE)\n\n  # Return the complete action sequence that solves the task.\n  return actions", "env_interactions": 0, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T19:13:51.108666", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n  goal_idx = env.task.goal\n  needed = world.cookbook.primitives_for(goal_idx)\n\n  act_map = env.action_specs()\n  DOWN = act_map['DOWN']; UP = act_map['UP']; LEFT = act_map['LEFT']; RIGHT = act_map['RIGHT']; USE = act_map['USE']\n  move_dirs = [(1,0,DOWN), (-1,0,UP), (0,-1,LEFT), (0,1,RIGHT)]\n\n  actions = []\n\n  def bfs(cur_state, target_kind):\n      grid = cur_state.grid\n      H, W, _ = grid.shape\n      start = cur_state.pos\n      q = collections.deque([(start, [])])\n      visited = {start}\n      while q:\n          (x,y), path = q.popleft()\n          if grid[x,y,target_kind] > 0:\n              return path\n          for dx,dy,act in move_dirs:\n              nx, ny = x+dx, y+dy\n              if not (0 <= nx < H and 0 <= ny < W):\n                  continue\n              if (nx,ny) in visited:\n                  continue\n              # check if cell is blocked by non\u2011grabbable entity\n              blocked = any(grid[nx,ny,idx] > 0 for idx in world.non_grabbable_indices)\n              if blocked:\n                  continue\n              visited.add((nx,ny))\n              q.append(((nx,ny), path+[act]))\n      return None\n\n  # collect primitives\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          path = bfs(state, prim_idx)\n          if path is None:\n              continue\n          for a in path:\n              _, state = state.step(a)\n              actions.append(a)\n          # pick up\n          _, state = state.step(USE)\n          actions.append(USE)\n\n  # craft at workshop if any\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop = recipe.get('_at')\n  if workshop is not None:\n      path = bfs(state, workshop)\n      if path:\n          for a in path:\n              _, state = state.step(a)\n              actions.append(a)\n          _, state = state.step(USE)\n          actions.append(USE)\n\n  return actions", "env_interactions": 0, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T19:14:23.471972", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n  if goal_idx is None:\n      return []\n\n  primitive_needs = cookbook.primitives_for(goal_idx)\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  if \"_at\" in recipe:\n      workshop_idx = cookbook.index[recipe[\"_at\"]]\n\n  from collections import deque\n  import numpy as np\n\n  def bfs_path(start, goal, occupied):\n      \"\"\"Return a list of positions from start (excluded) to goal (included).\"\"\"\n      w, h = occupied.shape\n      visited = np.zeros((w, h), dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start] = True\n      while q:\n          x, y = q.popleft()\n          if (x, y) == goal:\n              break\n          for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):\n              if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:\n                  if (nx, ny) == goal or not occupied[nx, ny]:\n                      visited[nx, ny] = True\n                      prev[(nx, ny)] = (x, y)\n                      q.append((nx, ny))\n      if not visited[goal]:\n          return None\n      path = []\n      cur = goal\n      while cur != start:\n          path.append(cur)\n          cur = prev[cur]\n      path.reverse()\n      return path\n\n  def delta_to_action(dx, dy):\n      \"\"\"Translate a movement delta into the environment's action index.\"\"\"\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise ValueError(\"Invalid movement delta\")\n\n  actions = []\n  cur_pos = tuple(state.pos)\n  grid = state.grid.copy()\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitive resources\n  # ------------------------------------------------------------------\n  for kind_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          locations = np.argwhere(grid[:, :, kind_idx] > 0)\n          if locations.size == 0:\n              break\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n\n          occupied_mask = np.any(grid, axis=2)\n          target = None\n          path = None\n          for idx in order:\n              cand = tuple(locations[idx])\n              p = bfs_path(cur_pos, cand, occupied_mask)\n              if p is not None:\n                  target = cand\n                  path = p\n                  break\n          if target is None:\n              continue\n\n          for step in path:\n              dx = step[0] - cur_pos[0]\n              dy = step[1] - cur_pos[1]\n              actions.append(delta_to_action(dx, dy))\n              cur_pos = step\n          actions.append(4)                     # USE to pick up\n          grid[target[0], target[1], kind_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 2) Move to the workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          dists = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n          occupied_mask = np.any(state.grid, axis=2)\n          for idx in order:\n              cand = tuple(workshop_cells[idx])\n              p = bfs_path(cur_pos, cand, occupied_mask)\n              if p is not None:\n                  for step in p:\n                      dx = step[0] - cur_pos[0]\n                      dy = step[1] - cur_pos[1]\n                      actions.append(delta_to_action(dx, dy))\n                      cur_pos = step\n                  actions.append(4)             # USE to craft\n                  break\n  else:\n      actions.append(4)                         # USE to craft at current location\n\n  return actions", "env_interactions": 26, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T19:14:24.601477", "function_name": "make_arrow", "function_body": "  # reset the environment and fetch core objects\n  env.reset()\n  state = env._current_state          # CraftState instance\n  world = env.world\n  cookbook = world.cookbook\n\n  # ----------------------------------------------------------------------\n  # Identify the goal (arrow) and its recipe information\n  # ----------------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n  if goal_idx is None:\n      return []                       # unknown goal\n\n  # map of primitive kind index -> how many are required for one arrow\n  needed_counts = dict(cookbook.primitives_for(goal_idx))\n\n  # where the recipe must be performed (if specified)\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  if \"_at\" in recipe:\n      workshop_idx = cookbook.index[recipe[\"_at\"]]\n\n  # ----------------------------------------------------------------------\n  # Helper utilities\n  # ----------------------------------------------------------------------\n  from collections import deque\n  import numpy as np\n\n  def bfs_path(start, goal, occupied):\n      \"\"\"Return a list of positions from start (excluded) to goal (included)\n      moving only through cells where `occupied` is False. The goal cell may be\n      occupied (e.g., contains the target primitive or a workshop).\"\"\"\n      w, h = occupied.shape\n      visited = np.zeros((w, h), dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start] = True\n      while q:\n          x, y = q.popleft()\n          if (x, y) == goal:\n              break\n          for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):\n              if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:\n                  if (nx, ny) == goal or not occupied[nx, ny]:\n                      visited[nx, ny] = True\n                      prev[(nx, ny)] = (x, y)\n                      q.append((nx, ny))\n      if not visited[goal]:\n          return None\n      # reconstruct path (exclude start, include goal)\n      path = []\n      cur = goal\n      while cur != start:\n          path.append(cur)\n          cur = prev[cur]\n      path.reverse()\n      return path\n\n  def delta_to_action(dx, dy):\n      \"\"\"Translate a movement delta to the environment's action index.\"\"\"\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise ValueError(\"Invalid movement delta\")\n\n  # ----------------------------------------------------------------------\n  # Planning: collect all needed primitives (greedy nearest\u2011first)\n  # ----------------------------------------------------------------------\n  actions = []\n  cur_pos = tuple(state.pos)          # current (x, y) location\n  grid = state.grid.copy()            # mutable copy to track what remains on map\n\n  # continue until all required primitives have been collected\n  while any(cnt > 0 for cnt in needed_counts.values()):\n      best_path = None\n      best_loc = None\n      best_kind = None\n\n      # search for the nearest reachable primitive of any still\u2011needed kind\n      for kind, cnt in needed_counts.items():\n          if cnt <= 0:\n              continue\n          locations = np.argwhere(grid[:, :, kind] > 0)\n          if locations.size == 0:\n              continue\n\n          # sort candidates by Manhattan distance to current position\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n\n          occupied_mask = np.any(grid, axis=2)   # treat any entity as blocked\n          for idx in order:\n              cand = tuple(locations[idx])\n              path = bfs_path(cur_pos, cand, occupied_mask)\n              if path is not None:\n                  best_path = path\n                  best_loc = cand\n                  best_kind = kind\n                  break\n          if best_path is not None:\n              break   # we found the nearest reachable primitive\n\n      if best_path is None:\n          # No reachable primitive left; abort to avoid infinite loop\n          break\n\n      # follow the path to the primitive, emitting movement actions\n      for step in best_path:\n          dx = step[0] - cur_pos[0]\n          dy = step[1] - cur_pos[1]\n          actions.append(delta_to_action(dx, dy))\n          cur_pos = step\n\n      # pick up the primitive\n      actions.append(4)   # USE\n      grid[best_loc[0], best_loc[1], best_kind] = 0\n      needed_counts[best_kind] -= 1\n\n  # ----------------------------------------------------------------------\n  # Move to the appropriate workshop (if required) and craft\n  # ----------------------------------------------------------------------\n  if workshop_idx is not None:\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          # choose the nearest workshop cell (ignoring other entities as obstacles)\n          dists = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n          occupied_mask = np.any(state.grid, axis=2)   # original grid, workshops occupy cells\n          for idx in order:\n              target = tuple(workshop_cells[idx])\n              path = bfs_path(cur_pos, target, occupied_mask)\n              if path is not None:\n                  for step in path:\n                      dx = step[0] - cur_pos[0]\n                      dy = step[1] - cur_pos[1]\n                      actions.append(delta_to_action(dx, dy))\n                      cur_pos = step\n                  actions.append(4)   # USE to trigger crafting\n                  break\n  else:\n      # No specific workshop needed; craft at the current location\n      actions.append(4)\n\n  return actions", "env_interactions": 26, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T19:15:01.046256", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  goal_name = \"arrow\"\n  goal_idx = idx[goal_name]\n\n  # Required primitive counts for one arrow\n  primitive_counts = world.cookbook.primitives_for(goal_idx)\n\n  # Determine required workshop (if any)\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else idx[wk]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def find_locations(kind):\n      \"\"\"Return list of (x, y) positions where `kind` appears on the grid.\"\"\"\n      occ = np.where(state.grid[:, :, kind] > 0)\n      return list(zip(occ[0].tolist(), occ[1].tolist()))\n\n  def bfs_path(start, goal):\n      \"\"\"Shortest traversable path from start to goal avoiding non\u2011grabbable cells.\"\"\"\n      if start == goal:\n          return [start]\n\n      width, height = state.grid.shape[:2]\n\n      # Cells occupied by non\u2011grabbable entities are blocked\n      blocked = set()\n      for ng in world.non_grabbable_indices:\n          occ = np.where(state.grid[:, :, ng] > 0)\n          blocked.update(zip(occ[0].tolist(), occ[1].tolist()))\n\n      q = collections.deque([start])\n      prev = {start: None}\n\n      while q:\n          cur = q.popleft()\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in blocked:\n                  nxt = (nx, ny)\n                  if nxt not in prev:\n                      prev[nxt] = cur\n                      if nxt == goal:\n                          # reconstruct path\n                          path = [goal]\n                          while path[-1] != start:\n                              path.append(prev[path[-1]])\n                          path.reverse()\n                          return path\n                      q.append(nxt)\n      # No path found \u2013 stay in place\n      return [start]\n\n  def move_action(cur, nxt):\n      \"\"\"Translate a step from cur to adjacent nxt into an action index.\"\"\"\n      dx, dy = nxt[0] - cur[0], nxt[1] - cur[1]\n      if dx == 1:\n          return 3   # RIGHT\n      if dx == -1:\n          return 2   # LEFT\n      if dy == 1:\n          return 0   # DOWN\n      if dy == -1:\n          return 1   # UP\n      raise AssertionError(\"Requested move is not adjacent\")\n\n  # ------------------------------------------------------------------\n  # Build the action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = state.pos\n\n  # 1) Collect all required primitives\n  for prim_idx, needed in primitive_counts.items():\n      while state.inventory[prim_idx] < needed:\n          locations = find_locations(prim_idx)\n          if not locations:\n              # No more of this primitive on the map\n              break\n\n          # Choose the nearest instance (Manhattan distance)\n          target = min(\n              locations,\n              key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1])\n          )\n\n          # Move to the target\n          path = bfs_path(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n\n          # Pick it up\n          actions.append(4)   # USE\n          state.inventory[prim_idx] += 1\n          state.grid[target[0], target[1], prim_idx] = 0\n\n  # 2) Go to workshop (if required) and craft\n  if workshop_kind is not None:\n      wk_locs = find_locations(workshop_kind)\n      if wk_locs:\n          target = min(\n              wk_locs,\n              key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1])\n          )\n          path = bfs_path(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n\n  # Final crafting action\n  actions.append(4)   # USE\n\n  return actions", "env_interactions": 19, "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T19:15:02.175153", "function_name": "make_arrow", "function_body": "  # reset environment and fetch useful handles\n  env.reset()\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  # goal definition (hard\u2011coded to \"arrow\")\n  goal_idx = idx[\"arrow\"]\n\n  # primitive requirements for one arrow (recursively expanded)\n  primitive_counts = world.cookbook.primitives_for(goal_idx)\n\n  # workshop required for crafting the arrow (if any)\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else idx[wk]\n\n  # ----------------------------------------------------------------------\n  # Helper utilities\n  # ----------------------------------------------------------------------\n  def find_locations(kind):\n      \"\"\"Return a list of (x, y) coordinates where `kind` is present.\"\"\"\n      occ = np.where(state.grid[:, :, kind] > 0)\n      return list(zip(occ[0].tolist(), occ[1].tolist()))\n\n  def bfs_path(start, goal):\n      \"\"\"Shortest traversable path from start to goal avoiding non\u2011grabbable cells.\"\"\"\n      if start == goal:\n          return [start]\n\n      width, height = state.grid.shape[:2]\n\n      # cells occupied by non\u2011grabbable entities block movement\n      blocked = set()\n      for ng in world.non_grabbable_indices:\n          occ = np.where(state.grid[:, :, ng] > 0)\n          blocked.update(zip(occ[0].tolist(), occ[1].tolist()))\n\n      q = collections.deque([start])\n      prev = {start: None}\n      while q:\n          cur = q.popleft()\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in blocked:\n                  nxt = (nx, ny)\n                  if nxt not in prev:\n                      prev[nxt] = cur\n                      if nxt == goal:\n                          # reconstruct path\n                          path = [goal]\n                          while path[-1] != start:\n                              path.append(prev[path[-1]])\n                          path.reverse()\n                          return path\n                      q.append(nxt)\n      # no path found \u2013 stay where we are\n      return [start]\n\n  def move_action(cur, nxt):\n      \"\"\"Translate a step from cur to an adjacent nxt into an action index.\"\"\"\n      dx, dy = nxt[0] - cur[0], nxt[1] - cur[1]\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise AssertionError(\"Requested move is not to an adjacent cell\")\n\n  # ----------------------------------------------------------------------\n  # Build the action list\n  # ----------------------------------------------------------------------\n  actions = []\n  cur_pos = state.pos\n\n  # 1) Collect all required primitives\n  for prim_idx, needed in primitive_counts.items():\n      while state.inventory[prim_idx] < needed:\n          locations = find_locations(prim_idx)\n          if not locations:\n              # primitive not present anywhere \u2013 give up on this type\n              break\n\n          # choose the nearest instance (Manhattan distance)\n          target = min(\n              locations,\n              key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1])\n          )\n\n          # move to the selected primitive\n          path = bfs_path(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n\n          # pick it up\n          actions.append(4)            # USE\n          state.inventory[prim_idx] += 1\n          state.grid[target[0], target[1], prim_idx] = 0\n\n  # 2) Move to the required workshop (if any)\n  if workshop_kind is not None:\n      wk_locs = find_locations(workshop_kind)\n      if wk_locs:\n          target = min(\n              wk_locs,\n              key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1])\n          )\n          path = bfs_path(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n\n  # 3) Craft the arrow\n  actions.append(4)    # USE to perform crafting\n\n  return actions", "env_interactions": 19, "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T19:15:16.343440", "function_name": "make_arrow", "function_body": "  \"\"\"\n  Wrapper that selects the most capable implementation of the arrow\u2011making\n  routine available in the current module.  It tries the newest version\n  (make_arrow_v2) first and falls back to earlier versions if that function\n  raises an exception (e.g., not defined or fails for the given environment).\n  \"\"\"\n  try:\n      # Preferred, most recent implementation\n      return make_arrow_v2(env)\n  except Exception:\n      try:\n          # Second\u2011best implementation\n          return make_arrow_v1(env)\n      except Exception:\n          # Baseline implementation \u2013 always defined\n          return make_arrow_v0(env)", "env_interactions": 0, "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-10-27T19:15:17.469710", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Reset environment and obtain current state & world information\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world\n  cookbook = world.cookbook\n\n  # Identify goal (arrow) and its recipe\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n  primitive_needs = cookbook.primitives_for(goal_idx)          # {kind_idx: count}\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  if \"_at\" in recipe:\n      workshop_idx = cookbook.index[recipe[\"_at\"]]\n\n  # ------------------------------------------------------------------\n  # Helper functions\n  # ------------------------------------------------------------------\n  def bfs_path(start, goal, occupied):\n      \"\"\"Return a list of positions (excluding start, including goal) that\n      leads from start to goal while avoiding occupied cells. The goal cell\n      may be occupied (e.g., a primitive or workshop) and is treated as\n      walkable.\"\"\"\n      w, h = occupied.shape\n      visited = np.zeros((w, h), dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start] = True\n      while q:\n          x, y = q.popleft()\n          if (x, y) == goal:\n              break\n          for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):\n              if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:\n                  if (nx, ny) == goal or not occupied[nx, ny]:\n                      visited[nx, ny] = True\n                      prev[(nx, ny)] = (x, y)\n                      q.append((nx, ny))\n      if not visited[goal]:\n          return None\n      # reconstruct path\n      path = []\n      cur = goal\n      while cur != start:\n          path.append(cur)\n          cur = prev[cur]\n      path.reverse()\n      return path\n\n  def delta_to_action(dx, dy):\n      \"\"\"Map a movement delta to the corresponding action index.\"\"\"\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise ValueError(\"Invalid movement delta\")\n\n  # ------------------------------------------------------------------\n  # Main planning\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = tuple(state.pos)\n  # Work on a mutable copy of the grid to track collected primitives\n  grid = state.grid.copy()\n\n  # ---- Collect all required primitives --------------------------------\n  for kind_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          # locate remaining instances of this primitive\n          locs = np.argwhere(grid[:, :, kind_idx] > 0)\n          if locs.size == 0:\n              break\n          # sort by Manhattan distance from current position\n          dists = np.abs(locs[:, 0] - cur_pos[0]) + np.abs(locs[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n          occupied_mask = np.any(grid, axis=2)\n          chosen_path = None\n          target = None\n          for idx in order:\n              cand = tuple(locs[idx])\n              path = bfs_path(cur_pos, cand, occupied_mask)\n              if path is not None:\n                  chosen_path = path\n                  target = cand\n                  break\n          if chosen_path is None:\n              continue      # cannot reach any remaining instance\n          # follow the path\n          for step in chosen_path:\n              dx = step[0] - cur_pos[0]\n              dy = step[1] - cur_pos[1]\n              actions.append(delta_to_action(dx, dy))\n              cur_pos = step\n          # pick up the primitive\n          actions.append(4)   # USE\n          grid[target[0], target[1], kind_idx] = 0\n\n  # ---- Move to workshop (if required) and craft -----------------------\n  if workshop_idx is not None:\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          dists = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n          occupied_mask = np.any(state.grid, axis=2)   # original occupancy (workshops are occupied)\n          for idx in order:\n              cand = tuple(workshop_cells[idx])\n              path = bfs_path(cur_pos, cand, occupied_mask)\n              if path is not None:\n                  for step in path:\n                      dx = step[0] - cur_pos[0]\n                      dy = step[1] - cur_pos[1]\n                      actions.append(delta_to_action(dx, dy))\n                      cur_pos = step\n                  actions.append(4)   # USE to trigger crafting\n                  break\n\n  return actions", "env_interactions": 26, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T19:15:53.590565", "function_name": "make_arrow", "function_body": "  # Reset environment and fetch useful handles\n  env.reset()\n  world = env.world\n  scenario = env.scenario\n  state = env._current_state\n\n  # Goal index and primitive requirements (including transitive ones)\n  goal_idx = env.task.goal\n  required = world.cookbook.primitives_for(goal_idx)\n\n  # Determine workshop (if any) where final crafting must happen\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else world.cookbook.index[wk]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  ACTIONS = {\"DOWN\": 0, \"UP\": 1, \"LEFT\": 2, \"RIGHT\": 3, \"USE\": 4}\n  DIRS = [(0, 1, ACTIONS[\"DOWN\"]),\n          (0, -1, ACTIONS[\"UP\"]),\n          (-1, 0, ACTIONS[\"LEFT\"]),\n          (1, 0, ACTIONS[\"RIGHT\"])]\n\n  def bfs_path(start, target, allow_target_kind=None):\n      \"\"\"Bread\u2011first search returning a list of positions from start to target.\n      Cells occupied by any non\u2011grabbable entity are treated as blocked,\n      except the target cell if `allow_target_kind` is present there.\"\"\"\n      W, H = scenario.init_grid.shape[:2]\n      q = collections.deque([start])\n      visited = {start: None}\n      while q:\n          x, y = q.popleft()\n          if (x, y) == target:\n              # reconstruct path\n              path = []\n              cur = target\n              while cur is not None:\n                  path.append(cur)\n                  cur = visited[cur]\n              return list(reversed(path))\n          for dx, dy, _ in DIRS:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < W and 0 <= ny < H):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              # check blockage by non\u2011grabbable entities\n              blocked = False\n              for idx in world.non_grabbable_indices:\n                  if scenario.init_grid[nx, ny, idx] > 0:\n                      blocked = True\n                      break\n              if blocked:\n                  # allow stepping onto the target if it holds the allowed kind\n                  if (nx, ny) == target and allow_target_kind is not None:\n                      if scenario.init_grid[nx, ny, allow_target_kind] > 0:\n                          blocked = False\n              if not blocked:\n                  visited[(nx, ny)] = (x, y)\n                  q.append((nx, ny))\n      return None  # no path found\n\n  def positions_to_actions(path):\n      \"\"\"Translate a list of positions (including start) into action ids.\"\"\"\n      acts = []\n      for (x0, y0), (x1, y1) in zip(path, path[1:]):\n          if x1 == x0 + 1:\n              acts.append(ACTIONS[\"RIGHT\"])\n          elif x1 == x0 - 1:\n              acts.append(ACTIONS[\"LEFT\"])\n          elif y1 == y0 + 1:\n              acts.append(ACTIONS[\"DOWN\"])\n          elif y1 == y0 - 1:\n              acts.append(ACTIONS[\"UP\"])\n      return acts\n\n  def nearest_cell(kind, from_pos, grid):\n      \"\"\"Find the nearest cell (Manhattan) that still contains `kind`.\"\"\"\n      cells = np.argwhere(grid[:, :, kind] > 0)\n      if cells.size == 0:\n          return None\n      dists = np.abs(cells[:, 0] - from_pos[0]) + np.abs(cells[:, 1] - from_pos[1])\n      idx = dists.argmin()\n      return tuple(cells[idx])\n\n  # ------------------------------------------------------------------\n  # Planning: collect required primitives then craft at workshop\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # Work on a mutable copy of the initial grid to mark primitives as taken\n  grid_copy = scenario.init_grid.copy()\n\n  for kind, count in required.items():\n      for _ in range(count):\n          target = nearest_cell(kind, cur_pos, grid_copy)\n          if target is None:\n              # Primitive not available; skip (environment may be unsolvable)\n              continue\n          path = bfs_path(cur_pos, target, allow_target_kind=kind)\n          if path is None:\n              # Can't reach this primitive; skip\n              continue\n          actions.extend(positions_to_actions(path))\n          actions.append(ACTIONS[\"USE\"])  # pick up primitive\n          cur_pos = target\n          # Mark primitive as collected\n          grid_copy[target[0], target[1], kind] = 0\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if required) and craft the final item\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      target = nearest_cell(workshop_kind, cur_pos, scenario.init_grid)\n      if target is not None:\n          path = bfs_path(cur_pos, target, allow_target_kind=workshop_kind)\n          if path is not None:\n              actions.extend(positions_to_actions(path))\n              actions.append(ACTIONS[\"USE\"])  # craft at workshop\n  else:\n      # No specific workshop \u2013 a USE at the current location attempts crafting\n      actions.append(ACTIONS[\"USE\"])\n\n  return actions", "env_interactions": 1, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T19:15:54.726379", "function_name": "make_arrow", "function_body": "  env.reset()\n  world = env.world\n  scenario = env.scenario\n  state = env._current_state\n\n  # Goal index\n  goal_idx = env.task.goal\n\n  # Determine primitive requirements (transitive)\n  required = world.cookbook.primitives_for(goal_idx)\n  if not required:\n      # Goal itself is a primitive we must pick up\n      required = {goal_idx: 1}\n\n  # Determine workshop for final crafting, if any\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else world.cookbook.index[wk]\n\n  # Action mapping\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n  DIRS = [(0, 1, ACTION_DOWN), (0, -1, ACTION_UP),\n          (-1, 0, ACTION_LEFT), (1, 0, ACTION_RIGHT)]\n\n  # ------------------------------------------------------------------\n  # Helper functions\n  # ------------------------------------------------------------------\n  def bfs_path(start, target, grid, allow_target_kind=None):\n      \"\"\"Return a list of positions from start to target using BFS.\n      `grid` is the current occupancy grid (numpy array). Cells that\n      contain any non\u2011grabbable entity are treated as blocked,\n      except the target cell if it holds `allow_target_kind`.\"\"\"\n      W, H = grid.shape[:2]\n      q = collections.deque([start])\n      visited = {start: None}\n      while q:\n          x, y = q.popleft()\n          if (x, y) == target:\n              # reconstruct path\n              path = []\n              cur = target\n              while cur != start:\n                  path.append(cur)\n                  cur = visited[cur]\n              path.append(start)\n              return list(reversed(path))\n          for dx, dy, _ in DIRS:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < W and 0 <= ny < H):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              blocked = False\n              for idx in world.non_grabbable_indices:\n                  if grid[nx, ny, idx] > 0:\n                      blocked = True\n                      break\n              if blocked:\n                  if (nx, ny) == target and allow_target_kind is not None:\n                      if grid[nx, ny, allow_target_kind] > 0:\n                          blocked = False\n              if not blocked:\n                  visited[(nx, ny)] = (x, y)\n                  q.append((nx, ny))\n      return None  # no path found\n\n  def positions_to_actions(path):\n      \"\"\"Translate a position path (including start) to a list of actions.\"\"\"\n      acts = []\n      for (x0, y0), (x1, y1) in zip(path, path[1:]):\n          if x1 == x0 + 1:\n              acts.append(ACTION_RIGHT)\n          elif x1 == x0 - 1:\n              acts.append(ACTION_LEFT)\n          elif y1 == y0 + 1:\n              acts.append(ACTION_DOWN)\n          elif y1 == y0 - 1:\n              acts.append(ACTION_UP)\n      return acts\n\n  def nearest_cell(kind, from_pos, grid):\n      \"\"\"Find the nearest cell that contains at least one entity of `kind`.\"\"\"\n      cells = np.argwhere(grid[:, :, kind] > 0)\n      if cells.size == 0:\n          return None\n      dists = np.abs(cells[:, 0] - from_pos[0]) + np.abs(cells[:, 1] - from_pos[1])\n      idx = dists.argmin()\n      return tuple(cells[idx])\n\n  # ------------------------------------------------------------------\n  # Planning\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = tuple(state.pos)\n  # Work on a mutable copy of the grid so we can mark primitives as taken\n  grid_copy = scenario.init_grid.copy()\n\n  # Collect required primitives\n  for kind, count in required.items():\n      for _ in range(count):\n          target = nearest_cell(kind, cur_pos, grid_copy)\n          if target is None:\n              # No more of this primitive left; abort this item\n              continue\n          path = bfs_path(cur_pos, target, grid_copy, allow_target_kind=kind)\n          if path is None:\n              continue\n          actions.extend(positions_to_actions(path))\n          actions.append(ACTION_USE)  # pick up\n          # Mark as taken\n          grid_copy[target[0], target[1], kind] = 0\n          cur_pos = target\n\n  # Move to workshop (if needed) and craft\n  if workshop_kind is not None:\n      target = nearest_cell(workshop_kind, cur_pos, scenario.init_grid)\n      if target is not None:\n          path = bfs_path(cur_pos, target, scenario.init_grid, allow_target_kind=workshop_kind)\n          if path is not None:\n              actions.extend(positions_to_actions(path))\n              actions.append(ACTION_USE)  # craft\n  else:\n      # If there is a recipe but no specific workshop, a final USE may trigger crafting\n      if world.cookbook.recipes.get(goal_idx):\n          actions.append(ACTION_USE)\n\n  return actions", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T19:16:22.188150", "function_name": "make_arrow", "function_body": "  # Reset environment and obtain current state and world reference\n  env.reset()\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  # Goal configuration\n  goal_name = \"arrow\"\n  goal_idx = idx[goal_name]\n\n  # Determine primitive requirements for a single arrow\n  required_prims = world.cookbook.primitives_for(goal_idx)\n\n  # Identify workshop required for crafting (if any)\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else idx[wk]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def find_locations(kind):\n      \"\"\"Return list of (x, y) coordinates where `kind` is present on the grid.\"\"\"\n      occ = np.where(state.grid[:, :, kind] > 0)\n      return list(zip(occ[0].tolist(), occ[1].tolist()))\n\n  def blocked_cells():\n      \"\"\"Set of coordinates occupied by non\u2011grabbable entities.\"\"\"\n      blocked = set()\n      for ng in world.non_grabbable_indices:\n          occ = np.where(state.grid[:, :, ng] > 0)\n          blocked.update(zip(occ[0].tolist(), occ[1].tolist()))\n      return blocked\n\n  def bfs_path(start, goal):\n      \"\"\"Return shortest path (list of positions) from start to goal avoiding blocked cells.\"\"\"\n      if start == goal:\n          return [start]\n      W, H = state.grid.shape[:2]\n      blocked = blocked_cells()\n      q = collections.deque([start])\n      prev = {start: None}\n      while q:\n          cur = q.popleft()\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:\n                  nxt = (nx, ny)\n                  if nxt not in prev:\n                      prev[nxt] = cur\n                      if nxt == goal:\n                          # reconstruct path\n                          path = [goal]\n                          while path[-1] != start:\n                              path.append(prev[path[-1]])\n                          path.reverse()\n                          return path\n                      q.append(nxt)\n      # No reachable path \u2013 stay in place\n      return [start]\n\n  def move_action(cur, nxt):\n      \"\"\"Translate a step from cur to adjacent nxt into an action index.\"\"\"\n      dx, dy = nxt[0] - cur[0], nxt[1] - cur[1]\n      if dx == 1:\n          return 3   # RIGHT\n      if dx == -1:\n          return 2   # LEFT\n      if dy == 1:\n          return 0   # DOWN\n      if dy == -1:\n          return 1   # UP\n      raise AssertionError(\"Requested move is not adjacent\")\n\n  # ------------------------------------------------------------------\n  # Build the action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = state.pos\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in required_prims.items():\n      while state.inventory[prim_idx] < needed_cnt:\n          prim_locations = find_locations(prim_idx)\n          if not prim_locations:\n              # Primitive missing\u2014cannot complete the task\n              return []\n          # Choose the nearest primitive (Manhattan distance)\n          target = min(\n              prim_locations,\n              key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1])\n          )\n          # Move to the target\n          path = bfs_path(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n          # Pick up the primitive\n          actions.append(4)   # USE\n          state.inventory[prim_idx] += 1\n          state.grid[target[0], target[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 2) Move to the workshop (if required) and craft\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      wk_locations = find_locations(workshop_kind)\n      if wk_locations:\n          target = min(\n              wk_locations,\n              key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1])\n          )\n          path = bfs_path(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n  # Final crafting action\n  actions.append(4)   # USE\n\n  return actions", "env_interactions": 19, "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T19:16:23.319155", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  goal_name = \"arrow\"\n  goal_idx = idx[goal_name]\n\n  primitive_needs = world.cookbook.primitives_for(goal_idx)\n\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else idx[wk]\n\n  def find_locations(kind):\n      occ = np.where(state.grid[:, :, kind] > 0)\n      return list(zip(occ[0].tolist(), occ[1].tolist()))\n\n  def blocked_cells():\n      blocked = set()\n      for ng in world.non_grabbable_indices:\n          occ = np.where(state.grid[:, :, ng] > 0)\n          blocked.update(zip(occ[0].tolist(), occ[1].tolist()))\n      return blocked\n\n  def bfs_path(start, goal):\n      if start == goal:\n          return [start]\n      W, H = state.grid.shape[:2]\n      blocked = blocked_cells()\n      q = collections.deque([start])\n      prev = {start: None}\n      while q:\n          cur = q.popleft()\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:\n                  nxt = (nx, ny)\n                  if nxt not in prev:\n                      prev[nxt] = cur\n                      if nxt == goal:\n                          path = [goal]\n                          while path[-1] != start:\n                              path.append(prev[path[-1]])\n                          path.reverse()\n                          return path\n                      q.append(nxt)\n      return [start]\n\n  def move_action(cur, nxt):\n      dx, dy = nxt[0] - cur[0], nxt[1] - cur[1]\n      if dx == 1:\n          return 3\n      if dx == -1:\n          return 2\n      if dy == 1:\n          return 0\n      if dy == -1:\n          return 1\n      raise AssertionError\n\n  actions = []\n  cur_pos = state.pos\n\n  for prim_idx, needed in primitive_needs.items():\n      while state.inventory[prim_idx] < needed:\n          locs = find_locations(prim_idx)\n          if not locs:\n              return actions\n          target = min(locs, key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))\n          path = bfs_path(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n          actions.append(4)\n          state.inventory[prim_idx] += 1\n          state.grid[target[0], target[1], prim_idx] = 0\n\n  if workshop_kind is not None:\n      wk_locs = find_locations(workshop_kind)\n      if wk_locs:\n          target = min(wk_locs, key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))\n          path = bfs_path(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n\n  actions.append(4)\n  return actions", "env_interactions": 19, "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T19:16:50.772300", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world\n\n  goal_idx = env.task.goal\n  needed = world.cookbook.primitives_for(goal_idx)\n\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  ws_name = recipe.get('_at')\n  if ws_name is not None:\n      workshop_idx = world.cookbook.index[ws_name]\n\n  import numpy as np\n  from collections import deque\n\n  def locate(kind):\n      \"\"\"Return list of (x, y) positions where kind is present.\"\"\"\n      inds = np.argwhere(state.grid[:, :, kind] > 0)\n      return [tuple(p) for p in inds]\n\n  def bfs_actions(start, target):\n      \"\"\"Return list of actions to move from start to target.\"\"\"\n      occupied = np.any(state.grid > 0, axis=2)\n      w, h = occupied.shape\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          pos, path = q.popleft()\n          if pos == target:\n              return path\n          x, y = pos\n          for act, (dx, dy) in ((0, (0, 1)), (1, (0, -1)),\n                                (2, (-1, 0)), (3, (1, 0))):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h:\n                  if (nx, ny) != target and occupied[nx, ny]:\n                      continue\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [act]))\n      return []\n\n  def go_to(target):\n      \"\"\"Move agent to target, updating state and recording actions.\"\"\"\n      nonlocal state\n      for act in bfs_actions(state.pos, target):\n          actions.append(act)\n          _, state = state.step(act)\n\n  actions = []\n\n  # Collect primitives\n  for kind, req_cnt in needed.items():\n      while state.inventory[kind] < req_cnt:\n          positions = locate(kind)\n          if not positions:\n              # Primitive not found; abort.\n              return actions\n          # Choose nearest by Manhattan distance\n          target = min(positions,\n                       key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))\n          go_to(target)\n          actions.append(4)  # USE to pick up\n          _, state = state.step(4)\n\n  # Craft at workshop if required\n  if workshop_idx is not None:\n      ws_positions = locate(workshop_idx)\n      if ws_positions:\n          target_ws = min(ws_positions,\n                          key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))\n          go_to(target_ws)\n  # Use to craft (or craft without specific workshop)\n  actions.append(4)\n  _, state = state.step(4)\n\n  return actions", "env_interactions": 1, "island_id": 7, "scores": {"3": 0.0}}
