{"timestamp": "2025-10-27T15:22:37.357300", "function_name": "make_arrow", "function_body": "  # ------------------------------------------------------------\n  #  make_arrow_vn \u2013 plan a sequence of actions that makes an arrow\n  # ------------------------------------------------------------\n  # The function works directly on the provided CraftLab environment.\n  # It queries the world\u2019s cookbook for the \u201carrow\u201d recipe, collects\n  # the required primitive items, moves to the appropriate workshop,\n  # and finally uses the workshop to craft the arrow.\n  #\n  # The returned list contains integer action IDs that can be fed\n  # back to `env.step(action)`.  The function also *executes* each\n  # action on the environment while building the plan so that the\n  # internal state stays up\u2011to\u2011date (grid, inventory, position, \u2026).\n  # ------------------------------------------------------------\n\n  import collections\n  import numpy as np\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  # Direction vectors and the corresponding action names (as returned by\n  # `env.action_specs()`).  The order matches the usual DMLab mapping.\n  DIR_VECTORS = {\n      \"UP\":    (0, -1),\n      \"DOWN\":  (0, 1),\n      \"LEFT\":  (-1, 0),\n      \"RIGHT\": (1, 0),\n  }\n\n  # ------------------------------------------------------------------\n  # Breadth\u2011first search on the current walkable mask.\n  # Returns a list of direction names that lead from `src` to any cell\n  # in `targets`.  If several targets are reachable, the closest one\n  # (in terms of BFS layers) is chosen.\n  # ------------------------------------------------------------------\n  def bfs(src, targets, walkable_mask):\n      q = collections.deque([src])\n      visited = {src: None}                     # maps pos -> (parent, move_name)\n      while q:\n          cur = q.popleft()\n          if cur in targets:\n              # reconstruct path\n              path = []\n              while visited[cur] is not None:\n                  parent, move = visited[cur]\n                  path.append(move)\n                  cur = parent\n              path.reverse()\n              return path, cur                 # cur is the reached target\n          for move_name, (dx, dy) in DIR_VECTORS.items():\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if (0 <= nx < walkable_mask.shape[0] and\n                  0 <= ny < walkable_mask.shape[1] and\n                  walkable_mask[nx, ny] and\n                  (nx, ny) not in visited):\n                  visited[(nx, ny)] = (cur, move_name)\n                  q.append((nx, ny))\n      # No reachable target\n      return None, None\n\n  # ------------------------------------------------------------------\n  # Convert a direction name (e.g. \"UP\") to the integer action ID used by\n  # the environment.\n  # ------------------------------------------------------------------\n  action_id = env.action_specs()          # e.g. {\"UP\":0, \"DOWN\":1, ...}\n  def act(name):\n      return action_id[name]\n\n  # ------------------------------------------------------------------\n  # Main planning loop\n  # ------------------------------------------------------------------\n  actions = []                                 # list to be returned\n  world = env.world\n  state = env._current_state\n\n  # Goal index (the item we have to craft)\n  goal_idx = env.task.goal\n\n  # ------------------------------------------------------------------\n  # 1. Determine which primitive resources are required for the goal.\n  # ------------------------------------------------------------------\n  # `primitives_for` returns a dict {primitive_idx: count_needed}.\n  needed_primitives = world.cookbook.primitives_for(goal_idx)\n\n  # ------------------------------------------------------------------\n  # 2. Repeatedly collect missing primitives.\n  # ------------------------------------------------------------------\n  while True:\n      # recompute missing amounts from the *current* inventory\n      inv = state.inventory\n      missing = {}\n      for prim_idx, cnt in needed_primitives.items():\n          have = int(inv[prim_idx])\n          if have < cnt:\n              missing[prim_idx] = cnt - have\n\n      if not missing:                     # all primitives are present\n          break\n\n      # pick the first missing primitive (any order works)\n      prim_idx, need_cnt = next(iter(missing.items()))\n\n      # locate all cells that still contain this primitive\n      prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n      if prim_cells.size == 0:\n          raise RuntimeError(\"Required primitive not found in the grid.\")\n\n      # choose the closest primitive cell (Manhattan distance as heuristic)\n      cur_pos = state.pos\n      dists = np.abs(prim_cells[:, 0] - cur_pos[0]) + np.abs(prim_cells[:, 1] - cur_pos[1])\n      target_cell = tuple(prim_cells[dists.argmin()])\n\n      # ------------------------------------------------------------------\n      # 3. Find a walkable neighbour of the primitive that lets us face it\n      #    after the last move (so that a single USE picks it up).\n      # ------------------------------------------------------------------\n      neigh_candidates = {}\n      for move_name, (dx, dy) in DIR_VECTORS.items():\n          cand = (target_cell[0] - dx, target_cell[1] - dy)   # cell we must step into\n          if (0 <= cand[0] < state.grid.shape[0] and\n              0 <= cand[1] < state.grid.shape[1]):\n              # cell must be empty (walkable)\n              if state.grid[cand[0], cand[1]].sum() == 0:\n                  neigh_candidates[cand] = move_name\n\n      if not neigh_candidates:\n          raise RuntimeError(\"No accessible neighbour for primitive at %s\" % (target_cell,))\n\n      # ------------------------------------------------------------------\n      # 4. Run BFS to the nearest reachable neighbour.\n      # ------------------------------------------------------------------\n      walkable = (state.grid.sum(axis=2) == 0)\n      path, reached = bfs(cur_pos, set(neigh_candidates.keys()), walkable)\n      if path is None:\n          raise RuntimeError(\"Cannot reach primitive at %s\" % (target_cell,))\n\n      # Execute the movement actions\n      for mv in path:\n          actions.append(act(mv))\n          _, _, _ = env.step(act(mv))\n          state = env._current_state\n\n      # After the moves we are on `reached`; the direction we just took\n      # points towards the primitive, so a single USE will collect it.\n      actions.append(act(\"USE\"))\n      _, _, _ = env.step(act(\"USE\"))\n      state = env._current_state\n\n  # ------------------------------------------------------------------\n  # 5. All primitives are in inventory \u2013 move to the appropriate workshop\n  #    and use it to craft the arrow.\n  # ------------------------------------------------------------------\n  # The workshop name is stored under the special key \"_at\" in the recipe.\n  recipe = world.cookbook.recipes[goal_idx]\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      raise RuntimeError(\"Goal recipe does not specify a workshop.\")\n\n  workshop_idx = world.cookbook.index[workshop_name]\n\n  # locate any workshop cell of the required type\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      raise RuntimeError(\"Workshop '%s' not found in the grid.\" % workshop_name)\n  workshop_cell = tuple(workshop_cells[0])\n\n  # find a walkable neighbour that lets us face the workshop\n  neigh_candidates = {}\n  for move_name, (dx, dy) in DIR_VECTORS.items():\n      cand = (workshop_cell[0] - dx, workshop_cell[1] - dy)\n      if (0 <= cand[0] < state.grid.shape[0] and\n          0 <= cand[1] < state.grid.shape[1] and\n          state.grid[cand[0], cand[1]].sum() == 0):\n          neigh_candidates[cand] = move_name\n\n  if not neigh_candidates:\n      raise RuntimeError(\"No accessible neighbour for workshop at %s\" % (workshop_cell,))\n\n  # BFS to the nearest neighbour\n  walkable = (state.grid.sum(axis=2) == 0)\n  cur_pos = state.pos\n  path, reached = bfs(cur_pos, set(neigh_candidates.keys()), walkable)\n  if path is None:\n      raise RuntimeError(\"Cannot reach workshop at %s\" % (workshop_cell,))\n\n  # Move to the neighbour\n  for mv in path:\n      actions.append(act(mv))\n      _, _, _ = env.step(act(mv))\n      state = env._current_state\n\n  # Use the workshop to craft the arrow\n  actions.append(act(\"USE\"))\n  _, _, _ = env.step(act(\"USE\"))\n  state = env._current_state\n\n  # ------------------------------------------------------------------\n  # 6. Return the complete action list.\n  # ------------------------------------------------------------------\n  return actions", "env_interactions": 0, "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-10-27T15:22:38.518617", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Helper: map delta to action index (DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4)\n  _delta_to_action = {\n      (0, 1): 0,   # DOWN\n      (0, -1): 1,  # UP\n      (-1, 0): 2,  # LEFT\n      (1, 0): 3,   # RIGHT\n  }\n\n  # ------------------------------------------------------------------\n  # Basic utilities working directly on the internal CraftState\n  # ------------------------------------------------------------------\n  def _is_free(grid, x, y):\n      \"\"\"A cell is free if it contains no entities.\"\"\"\n      return grid[x, y, :].sum() == 0\n\n  def _neighbors(pos, width, height):\n      x, y = pos\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < width and 0 <= ny < height:\n              yield (nx, ny), (dx, dy)\n\n  def _bfs_path(grid, start, goal_cond):\n      \"\"\"\n      Breadth\u2011first search returning a list of actions that moves the agent\n      from ``start`` to any cell satisfying ``goal_cond``.\n      ``goal_cond`` receives a position tuple (x, y) and returns True/False.\n      \"\"\"\n      width, height = grid.shape[0], grid.shape[1]\n      q = deque()\n      q.append(start)\n      came_from = {start: None}\n      move_from = {start: None}   # store (dx,dy) taken to reach a node\n\n      while q:\n          cur = q.popleft()\n          if goal_cond(cur):\n              # reconstruct path\n              actions = []\n              while came_from[cur] is not None:\n                  dx, dy = move_from[cur]\n                  actions.append(_delta_to_action[(dx, dy)])\n                  cur = came_from[cur]\n              actions.reverse()\n              return actions\n          for nxt, delta in _neighbors(cur, width, height):\n              if nxt not in came_from and _is_free(grid, *nxt):\n                  came_from[nxt] = cur\n                  move_from[nxt] = delta\n                  q.append(nxt)\n      # No path found \u2013 return empty list (will cause failure later)\n      return []\n\n  # ------------------------------------------------------------------\n  # Begin planning\n  # ------------------------------------------------------------------\n  # Access the current internal state of the environment\n  state = env._current_state          # type: CraftState\n  world = env.world                   # type: CraftWorld\n  goal_idx = env.task.goal            # integer index of the desired item\n\n  # Required primitive counts for the goal\n  needed_prims = world.cookbook.primitives_for(goal_idx).copy()  # {prim_idx: count}\n  # Recipe for the goal (to locate the workshop)\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get('_at')   # may be None for primitive goals\n\n  # Working copies that we update as we simulate actions\n  grid = state.grid.copy()\n  inventory = state.inventory.copy()\n  cur_pos = tuple(state.pos)\n\n  actions_plan = []\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, required_cnt in needed_prims.items():\n      while inventory[prim_idx] < required_cnt:\n          # Locate all cells that currently contain this primitive\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # No more primitives left on the map \u2013 cannot continue\n              return actions_plan\n          # Choose the closest one (Manhattan distance)\n          distances = np.abs(prim_cells[:, 0] - cur_pos[0]) + np.abs(prim_cells[:, 1] - cur_pos[1])\n          target_cell = tuple(prim_cells[distances.argmin()])\n\n          # Move to the primitive cell\n          move_actions = _bfs_path(grid, cur_pos, lambda p, t=target_cell: p == t)\n          actions_plan.extend(move_actions)\n          cur_pos = target_cell\n\n          # Use (collect) the primitive\n          actions_plan.append(4)   # USE action\n          # Simulate the effect on our local copies\n          grid[cur_pos[0], cur_pos[1], prim_idx] = 0\n          inventory[prim_idx] += 1\n\n  # ------------------------------------------------------------------\n  # 2) Go to the appropriate workshop and craft the item\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      # Find all workshop locations\n      workshop_cells = np.argwhere(grid[:, :, workshop_kind] > 0)\n      if workshop_cells.size == 0:\n          # No workshop on the map \u2013 cannot craft\n          return actions_plan\n\n      # Determine a free cell adjacent (including orthogonal neighbours) to any workshop\n      width, height = grid.shape[0], grid.shape[1]\n      best_path = None\n      best_target = None\n      for wx, wy in workshop_cells:\n          # Examine the four neighbouring cells (including the workshop cell itself if free)\n          candidates = [(wx, wy)] + [(wx + dx, wy + dy) for dx, dy in [(-1,0),(1,0),(0,-1),(0,1)]]\n          for cx, cy in candidates:\n              if 0 <= cx < width and 0 <= cy < height and _is_free(grid, cx, cy):\n                  # Path to this candidate\n                  path = _bfs_path(grid, cur_pos, lambda p, t=(cx, cy): p == t)\n                  if best_path is None or len(path) < len(best_path):\n                      best_path = path\n                      best_target = (cx, cy)\n\n      if best_path is None:\n          # No reachable workshop adjacency \u2013 give up\n          return actions_plan\n\n      # Move to the chosen adjacent cell\n      actions_plan.extend(best_path)\n      cur_pos = best_target\n\n      # Use (craft) at the workshop\n      actions_plan.append(4)   # USE action\n\n  # ------------------------------------------------------------------\n  # Return the complete action list\n  # ------------------------------------------------------------------\n  return actions_plan", "env_interactions": 0, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T15:23:19.376102", "function_name": "make_arrow", "function_body": "  # Get the index for the target item \u201carrow\u201d.\n  arrow_idx = env.world.cookbook.index[\"arrow\"]\n  # Retrieve its recipe and the required workshop.\n  recipe = env.world.cookbook.recipes[arrow_idx]\n  workshop_name = recipe[\"_at\"]\n  workshop_idx = env.world.cookbook.index[workshop_name]\n\n  # Start a fresh episode.\n  env.reset()\n  state = env._current_state          # CraftState instance.\n  actions = []                         # Collected action sequence.\n  max_steps = 5000\n  steps = 0\n\n  # ---------- Helper utilities ----------\n  def in_bounds(pos):\n      x, y = pos\n      w, h = state.grid.shape[:2]\n      return 0 <= x < w and 0 <= y < h\n\n  def is_free(pos):\n      x, y = pos\n      return state.grid[x, y].sum() == 0\n\n  def manhattan_path(start, goal):\n      sx, sy = start\n      gx, gy = goal\n      path = []\n      while sx < gx:\n          path.append(0)          # DOWN\n          sx += 1\n      while sx > gx:\n          path.append(1)          # UP\n          sx -= 1\n      while sy < gy:\n          path.append(3)          # RIGHT\n          sy += 1\n      while sy > gy:\n          path.append(2)          # LEFT\n          sy -= 1\n      return path\n\n  def nearest_pos(kind):\n      \"\"\"Find the closest cell that contains an entity of the given kind.\"\"\"\n      positions = np.argwhere(state.grid[:, :, kind] > 0)\n      if positions.size == 0:\n          return None\n      dists = np.sum(np.abs(positions - np.array(state.pos)), axis=1)\n      return tuple(positions[dists.argmin()])\n\n  def adjacent_free(target):\n      \"\"\"Pick a free cell next to *target* (Manhattan distance = 1).\"\"\"\n      tx, ty = target\n      for dx, dy in [(0, 1), (0, -1), (1, 0), (-1, 0)]:\n          ax, ay = tx + dx, ty + dy\n          if in_bounds((ax, ay)) and is_free((ax, ay)):\n              return (ax, ay)\n      return None\n\n  def direction_to(src, dst):\n      \"\"\"Return the action index that points from src to dst (must be adjacent).\"\"\"\n      sx, sy = src\n      dx, dy = dst[0] - sx, dst[1] - sy\n      if dx == 1:\n          return 0          # DOWN\n      if dx == -1:\n          return 1          # UP\n      if dy == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 3          # RIGHT\n      return None\n\n  def execute_path(path):\n      \"\"\"Run a list of actions, updating *state* and *steps*.\"\"\"\n      nonlocal state, steps\n      for a in path:\n          reward, done, _ = env.step(a)\n          actions.append(a)\n          steps += 1\n          state = env._current_state\n          if steps >= max_steps:\n              return False\n      return True\n  # ---------------------------------------\n\n  # Main loop: keep acting until we possess an arrow or run out of steps.\n  while state.inventory[arrow_idx] == 0 and steps < max_steps:\n      # Determine which primitive kinds are still missing.\n      missing = {}\n      for kind, cnt in recipe.items():\n          if isinstance(kind, int):\n              have = int(state.inventory[kind])\n              need = cnt - have\n              if need > 0:\n                  missing[kind] = need\n\n      # -----------------------------------------------------------------\n      # If no primitives are missing, go to the workshop and craft.\n      if not missing:\n          w_pos = nearest_pos(workshop_idx)\n          if w_pos is None:\n              break\n          a_pos = adjacent_free(w_pos)\n          if a_pos is None:\n              break\n          if not execute_path(manhattan_path(state.pos, a_pos)):\n              break\n\n          # Face the workshop.\n          needed_dir = direction_to(state.pos, w_pos)\n          if needed_dir is not None and state.dir != needed_dir:\n              # Simple turn: step one cell away and back.\n              opp = (needed_dir + 2) % 4\n              vec = {0: (1, 0), 1: (-1, 0), 2: (0, -1), 3: (0, 1)}[opp]\n              tmp = (state.pos[0] + vec[0], state.pos[1] + vec[1])\n              if in_bounds(tmp) and is_free(tmp):\n                  execute_path([opp, needed_dir])\n\n          # Craft using the workshop.\n          reward, done, _ = env.step(4)      # USE\n          actions.append(4)\n          steps += 1\n          state = env._current_state\n          continue\n      # -----------------------------------------------------------------\n\n      # Pick a primitive to collect (first missing kind).\n      kind, need_cnt = next(iter(missing.items()))\n      prim_pos = nearest_pos(kind)\n      if prim_pos is None:\n          break\n      adj = adjacent_free(prim_pos)\n      if adj is None:\n          break\n      if not execute_path(manhattan_path(state.pos, adj)):\n          break\n\n      # Face the primitive.\n      needed_dir = direction_to(state.pos, prim_pos)\n      if needed_dir is not None and state.dir != needed_dir:\n          opp = (needed_dir + 2) % 4\n          vec = {0: (1, 0), 1: (-1, 0), 2: (0, -1), 3: (0, 1)}[opp]\n          tmp = (state.pos[0] + vec[0], state.pos[1] + vec[1])\n          if in_bounds(tmp) and is_free(tmp):\n              execute_path([opp, needed_dir])\n\n      # Pick up the primitive.\n      reward, done, _ = env.step(4)          # USE\n      actions.append(4)\n      steps += 1\n      state = env._current_state\n\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T15:23:20.525480", "function_name": "make_arrow", "function_body": "  # A minimal placeholder implementation that returns an empty action list.\n  # In a full solution, this function would compute a sequence of movement\n  # and USE actions required to collect the primitives for an \"arrow\" and\n  # then craft it at the appropriate workshop. For now, we simply return\n  # an empty list to satisfy the required signature.\n  return []", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T15:23:57.642944", "function_name": "make_arrow", "function_body": "  import collections\n\n  # reset environment to start a fresh episode\n  env.reset()\n  # shortcut to the current CraftState object\n  state = env._current_state\n\n  # goal index (the item we need to craft)\n  goal_idx = env.task.goal\n\n  # cookbook provides recipes and primitive requirements\n  cookbook = env.world.cookbook\n  # primitive counts needed to craft one instance of the goal\n  needed = dict(cookbook.primitives_for(goal_idx))\n\n  # workshop kind required for the final crafting step (may be absent)\n  workshop_idx = None\n  recipe = cookbook.recipes.get(goal_idx, {})\n  if \"_at\" in recipe:\n      workshop_idx = recipe[\"_at\"]\n\n  # action indices (as defined by CraftLab.action_specs())\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n  move_dirs = [(0, 1, ACTION_DOWN),\n               (0, -1, ACTION_UP),\n               (-1, 0, ACTION_LEFT),\n               (1, 0, ACTION_RIGHT)]\n\n  # ----------------------------------------------------------------------\n  # Helper: Bread\u2011first search to the nearest cell satisfying a predicate.\n  # Returns a list of movement actions (DOWN/UP/LEFT/RIGHT) that lead to a\n  # cell where `cond(pos)` is True.  The search is performed on the current\n  # grid (blocked cells are those with any non\u2011zero kind).\n  # ----------------------------------------------------------------------\n  def bfs_to_condition(start_pos, cond):\n      H, W, _ = state.grid.shape\n      q = collections.deque()\n      q.append((start_pos, []))\n      visited = {start_pos}\n      while q:\n          (x, y), path = q.popleft()\n          if cond((x, y)):\n              return path\n          for dx, dy, act in move_dirs:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < H and 0 <= ny < W and (nx, ny) not in visited:\n                  # can step only on empty cells\n                  if state.grid[nx, ny, :].sum() == 0:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [act]))\n      return None\n\n  # ----------------------------------------------------------------------\n  # Helper: Execute a list of actions, updating the stored `state`\n  # ----------------------------------------------------------------------\n  def execute(actions):\n      nonlocal state\n      for a in actions:\n          env.step(a)               # ignore reward/done/obs\n          state = env._current_state\n\n  # ----------------------------------------------------------------------\n  # 1) Collect all required primitive resources\n  # ----------------------------------------------------------------------\n  while any(cnt > 0 for cnt in needed.values()):\n      # pick any primitive that is still needed\n      prim_kind = next(k for k, c in needed.items() if c > 0)\n\n      # find nearest cell that contains this primitive\n      start = state.pos\n      def has_prim(pos):\n          x, y = pos\n          return state.grid[x, y, prim_kind] > 0\n\n      path = bfs_to_condition(start, has_prim)\n      if path is None:\n          raise RuntimeError(\"Cannot locate required primitive.\")\n      execute(path)\n\n      # now we are standing on the primitive \u2013 pick it up\n      env.step(ACTION_USE)\n      state = env._current_state\n      needed[prim_kind] -= 1\n\n  # ----------------------------------------------------------------------\n  # 2) Move next to the appropriate workshop (if any) and craft\n  # ----------------------------------------------------------------------\n  if workshop_idx is not None:\n      # condition: being in a cell whose 3\u00d73 neighbourhood contains the workshop\n      def adjacent_to_workshop(pos):\n          x, y = pos\n          H, W, _ = state.grid.shape\n          for dx in (-1, 0, 1):\n              for dy in (-1, 0, 1):\n                  nx, ny = x + dx, y + dy\n                  if 0 <= nx < H and 0 <= ny < W:\n                      if state.grid[nx, ny, workshop_idx] > 0:\n                          return True\n          return False\n\n      start = state.pos\n      path = bfs_to_condition(start, adjacent_to_workshop)\n      if path is None:\n          raise RuntimeError(\"Cannot reach required workshop.\")\n      execute(path)\n\n      # use the workshop to craft the goal item\n      env.step(ACTION_USE)\n      state = env._current_state\n\n  # ----------------------------------------------------------------------\n  # The accumulated list of actions is stored in the local variable `actions`.\n  # ----------------------------------------------------------------------\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-10-27T15:28:57.672561", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Helper utilities (local to this function)\n  # ----------------------------------------------------------------------\n  import numpy as np\n\n  # reset the environment and obtain the initial state\n  env.reset()\n  state = env._current_state          # type: CraftState\n  world = env.world\n  cookbook = world.cookbook\n\n  # ----------------------------------------------------------------------\n  # Identify the goal (arrow) and its recipe\n  # ----------------------------------------------------------------------\n  arrow_idx = cookbook.index.index(\"arrow\")\n  # primitive requirements for one arrow (primitive_kind -> count)\n  primitive_needs = dict(cookbook.primitives_for(arrow_idx))\n\n  # ----------------------------------------------------------------------\n  # Action mapping\n  # ----------------------------------------------------------------------\n  act_map = env.action_specs()          # e.g. {'DOWN':0,'UP':1,'LEFT':2,'RIGHT':3,'USE':4}\n  ACTION_USE = act_map[\"USE\"]\n  ACTIONS_MOVE = {\n      \"LEFT\":  act_map[\"LEFT\"],\n      \"RIGHT\": act_map[\"RIGHT\"],\n      \"UP\":    act_map[\"UP\"],\n      \"DOWN\":  act_map[\"DOWN\"],\n  }\n\n  # ----------------------------------------------------------------------\n  # Utility: execute an action, record it, and refresh the state object\n  # ----------------------------------------------------------------------\n  action_sequence = []\n\n  def do_action(action):\n      \"\"\"Execute an action in the env, record it and update `state`.\"\"\"\n      nonlocal state\n      reward, done, _ = env.step(action)          # ignore reward / done here\n      action_sequence.append(action)\n      state = env._current_state\n      return reward, done\n\n  # ----------------------------------------------------------------------\n  # Utility: Manhattan distance\n  # ----------------------------------------------------------------------\n  def manhattan(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  # ----------------------------------------------------------------------\n  # Utility: find all positions of a given kind (where count > 0)\n  # ----------------------------------------------------------------------\n  def positions_of(kind_idx):\n      \"\"\"Return list of (x, y) where the grid contains `kind_idx`.\"\"\"\n      grid_slice = state.grid[:, :, kind_idx]\n      xs, ys = np.where(grid_slice > 0)\n      return list(zip(xs.tolist(), ys.tolist()))\n\n  # ----------------------------------------------------------------------\n  # Utility: pick a free (empty) neighbouring cell of a target position.\n  # ----------------------------------------------------------------------\n  def free_adjacent(target):\n      \"\"\"Return a free cell adjacent to `target` (or None if none).\"\"\"\n      tx, ty = target\n      candidates = [(tx - 1, ty), (tx + 1, ty), (tx, ty - 1), (tx, ty + 1)]\n      max_x, max_y = state.grid.shape[0] - 1, state.grid.shape[1] - 1\n      for cx, cy in candidates:\n          if 0 <= cx <= max_x and 0 <= cy <= max_y:\n              if state.grid[cx, cy, :].sum() == 0:        # completely empty cell\n                  return (cx, cy)\n      return None\n\n  # ----------------------------------------------------------------------\n  # Utility: move the agent step\u2011by\u2011step towards a destination cell.\n  # ----------------------------------------------------------------------\n  def move_to(dest):\n      \"\"\"Issue MOVE actions until the agent reaches `dest`.\"\"\"\n      while state.pos != dest:\n          px, py = state.pos\n          dx, dy = dest[0] - px, dest[1] - py\n          if dx > 0:\n              do_action(ACTIONS_MOVE[\"RIGHT\"])\n          elif dx < 0:\n              do_action(ACTIONS_MOVE[\"LEFT\"])\n          elif dy > 0:\n              do_action(ACTIONS_MOVE[\"DOWN\"])\n          elif dy < 0:\n              do_action(ACTIONS_MOVE[\"UP\"])\n          else:\n              break      # already there (should not happen)\n\n  # ----------------------------------------------------------------------\n  # Phase 1 \u2013 collect all required primitives\n  # ----------------------------------------------------------------------\n  for prim_kind, needed_cnt in list(primitive_needs.items()):\n      while needed_cnt > 0:\n          # locate all remaining instances of this primitive\n          prim_positions = positions_of(prim_kind)\n          if not prim_positions:\n              raise RuntimeError(\"Required primitive not found in the world.\")\n\n          # choose the closest one (Manhattan distance)\n          cur_pos = state.pos\n          closest = min(prim_positions, key=lambda p: manhattan(p, cur_pos))\n\n          # move to a free adjacent cell of that primitive\n          adj = free_adjacent(closest)\n          if adj is None:\n              # fallback: try to stand on the primitive cell itself (should be impossible)\n              raise RuntimeError(\"No free adjacent cell to primitive.\")\n          move_to(adj)\n\n          # now use the primitive (pick it up)\n          do_action(ACTION_USE)\n\n          # update bookkeeping\n          needed_cnt -= 1\n          primitive_needs[prim_kind] = needed_cnt\n\n  # ----------------------------------------------------------------------\n  # Phase 2 \u2013 craft the arrow at its workshop\n  # ----------------------------------------------------------------------\n  # retrieve workshop kind from the recipe\n  recipe_dict = cookbook.recipes[arrow_idx]\n  workshop_name = recipe_dict[\"_at\"]\n  workshop_kind = cookbook.index.index(workshop_name)\n\n  # locate the workshop (there should be exactly one)\n  workshop_positions = positions_of(workshop_kind)\n  if not workshop_positions:\n      raise RuntimeError(\"Workshop for arrow not found.\")\n  workshop_pos = workshop_positions[0]\n\n  # move next to the workshop\n  adj_ws = free_adjacent(workshop_pos)\n  if adj_ws is None:\n      raise RuntimeError(\"No free cell adjacent to the workshop.\")\n  move_to(adj_ws)\n\n  # issue USE to craft the arrow\n  do_action(ACTION_USE)\n\n  # ----------------------------------------------------------------------\n  # Return the compiled action list\n  # ----------------------------------------------------------------------\n  return action_sequence", "env_interactions": 0, "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-10-27T15:29:50.459117", "function_name": "make_arrow", "function_body": "  # Reset the environment and obtain references to world and index structures\n  env.reset()\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  # Goal item name and its index (hard\u2011coded for \u201carrow\u201d)\n  goal_name = \"arrow\"\n  goal_idx = idx[goal_name]\n\n  # Shortcut for action indices\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  # Useful sets from the cookbook\n  primitive_kinds = world.cookbook.primitives          # set of primitive kind indices\n  workshop_kinds = set(world.workshop_indices)          # set of workshop kind indices\n  all_recipes = world.cookbook.recipes                  # dict {output_idx: {ing_idx:cnt, ...}}\n\n  actions = []\n  max_steps = 2000\n  steps = 0\n\n  # Helper: Manhattan distance\n  def manhattan(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  # Helper: move one step towards a target cell (ignoring obstacles)\n  def move_towards(cur, target):\n      if cur[0] < target[0]:\n          return ACTION_RIGHT\n      if cur[0] > target[0]:\n          return ACTION_LEFT\n      if cur[1] < target[1]:\n          return ACTION_DOWN\n      if cur[1] > target[1]:\n          return ACTION_UP\n      # already at target (should not happen)\n      return None\n\n  # Main planning loop\n  while steps < max_steps:\n      state = env._current_state\n\n      # Goal reached?\n      if state.satisfies(\"\", goal_idx):\n          break\n\n      # ------------------------------------------------------------------\n      # 1) Try to craft anything we can, preferring the final goal.\n      # ------------------------------------------------------------------\n      crafted = False\n      # Check adjacency to any workshop\n      for wk in workshop_kinds:\n          if not state.next_to(wk):\n              continue\n          # Look for a craftable recipe that uses this workshop\n          for out_idx, recipe in all_recipes.items():\n              # recipe must specify the same workshop\n              if recipe.get(\"_at\") != wk:\n                  continue\n              # Verify we have enough ingredients\n              enough = True\n              for ing_idx, cnt in recipe.items():\n                  if ing_idx == \"_at\":\n                      continue\n                  if state.inventory[ing_idx] < cnt:\n                      enough = False\n                      break\n              if enough:\n                  # Perform the craft action\n                  actions.append(ACTION_USE)\n                  env.step(ACTION_USE)\n                  steps += 1\n                  crafted = True\n                  break\n          if crafted:\n              break\n      if crafted:\n          continue\n\n      # ------------------------------------------------------------------\n      # 2) Find the nearest primitive we still need (or any primitive if unknown).\n      # ------------------------------------------------------------------\n      # Determine which primitives we still lack for the final goal.\n      needed_primitive = None\n      goal_recipe = all_recipes.get(goal_idx, {})\n      # Count required primitives for the goal (direct primitives only)\n      required_counts = {}\n      for ing_idx, cnt in goal_recipe.items():\n          if ing_idx == \"_at\":\n              continue\n          if ing_idx in primitive_kinds:\n              required_counts[ing_idx] = cnt\n      for prim_idx, req_cnt in required_counts.items():\n          if state.inventory[prim_idx] < req_cnt:\n              needed_primitive = prim_idx\n              break\n\n      # If we have enough direct primitives but still cannot craft, just pick any primitive.\n      search_kinds = [needed_primitive] if needed_primitive is not None else list(primitive_kinds)\n\n      # Locate the closest cell containing any of the searched primitive kinds.\n      best_pos = None\n      best_kind = None\n      best_dist = None\n      grid = state.grid\n      for kind in search_kinds:\n          positions = np.argwhere(grid[:, :, kind] > 0)\n          if positions.size == 0:\n              continue\n          cur = np.array(state.pos)\n          dists = np.abs(positions - cur).sum(axis=1)\n          min_idx = int(dists.argmin())\n          dist = int(dists[min_idx])\n          if best_dist is None or dist < best_dist:\n              best_dist = dist\n              best_pos = tuple(positions[min_idx].tolist())\n              best_kind = kind\n\n      # If nothing found, fall back to a random move.\n      if best_pos is None:\n          act = np.random.choice([ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT])\n          actions.append(act)\n          env.step(act)\n          steps += 1\n          continue\n\n      # ------------------------------------------------------------------\n      # 3) Navigate to a cell adjacent to the target primitive.\n      # ------------------------------------------------------------------\n      # Move until we are Manhattan\u2011distance 1 from the primitive cell.\n      while True:\n          cur = env._current_state.pos\n          if manhattan(cur, best_pos) == 1:\n              break\n          act = move_towards(cur, best_pos)\n          if act is None:\n              break\n          actions.append(act)\n          env.step(act)\n          steps += 1\n          if steps >= max_steps:\n              break\n\n      # ------------------------------------------------------------------\n      # 4) Face the primitive and pick it up.\n      # ------------------------------------------------------------------\n      # Determine direction needed to face the primitive.\n      cur = env._current_state.pos\n      dx = best_pos[0] - cur[0]\n      dy = best_pos[1] - cur[1]\n      # The last movement direction already points towards the primitive,\n      # so a single USE should be sufficient.\n      actions.append(ACTION_USE)\n      env.step(ACTION_USE)\n      steps += 1\n\n  return actions", "env_interactions": 0, "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-10-27T15:29:51.626027", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  actions = []\n  # Start a fresh episode.\n  env.reset()\n\n  # Use the environment's step limit if it exists, otherwise fall back to a safe default.\n  max_steps = getattr(env, \"max_steps\", 1000)\n\n  for _ in range(max_steps):\n      # Stop early if the task is already satisfied.\n      if hasattr(env, \"_is_done\"):\n          try:\n              if env._is_done():\n                  break\n          except Exception:\n              pass\n\n      # Choose a random action from the discrete set {0,1,2,3,4}.\n      act = int(np.random.randint(0, 5))\n      actions.append(act)\n\n      # Apply the action so that the environment state advances.\n      _, done, _ = env.step(act)\n      if done:\n          break\n\n  return actions", "env_interactions": 0, "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-10-27T15:35:24.444325", "function_name": "make_arrow", "function_body": "  # Get references to world and cookbook\n  world = env.world\n  cookbook = world.cookbook\n  idx = cookbook.index\n\n  # Goal index for \"arrow\"\n  try:\n      goal_idx = idx[\"arrow\"]\n  except Exception:\n      # If the goal name is not present, just return empty plan\n      return []\n\n  # Primitive requirements for one arrow\n  primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n  # Workshop where arrow must be crafted\n  workshop_idx = cookbook.recipes[goal_idx].get(\"_at\", None)\n\n  # Helper to translate a movement delta into an action index\n  def delta_to_action(dx, dy):\n      # Action mapping: 0\u2011DOWN, 1\u2011UP, 2\u2011LEFT, 3\u2011RIGHT\n      if dx > 0:\n          return 0  # DOWN\n      if dx < 0:\n          return 1  # UP\n      if dy > 0:\n          return 3  # RIGHT\n      return 2      # LEFT\n\n  # Helper to move the agent until it becomes adjacent (including diagonal)\n  # to a target cell. Returns the list of actions taken.\n  def move_adjacent(state, target):\n      actions_local = []\n      while True:\n          cur_x, cur_y = state.pos\n          dx = target[0] - cur_x\n          dy = target[1] - cur_y\n          if max(abs(dx), abs(dy)) <= 1:   # already adjacent\n              break\n          act = delta_to_action(dx, dy)\n          actions_local.append(act)\n          _, _, _ = env.step(act)   # ignore reward/obs\n          state = env._current_state\n      return actions_local, state\n\n  # Main planning loop\n  plan = []\n  state = env._current_state\n\n  # Continue until the arrow appears in the inventory\n  while not state.satisfies(\"make\", goal_idx):\n      inventory = state.inventory\n      # Determine which primitives are still missing\n      missing = {p: c - inventory[p] for p, c in primitives_needed.items() if inventory[p] < c}\n\n      if missing:\n          # Choose any missing primitive (deterministically the first)\n          prim_idx = next(iter(missing))\n          # Locate all cells that contain this primitive\n          locations = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if locations.size == 0:\n              # No reachable primitive \u2013 abort planning\n              break\n          # Pick the closest location (Manhattan distance)\n          cur_pos = np.array(state.pos)\n          dists = np.sum(np.abs(locations - cur_pos), axis=1)\n          target_loc = locations[dists.argmin()]\n          # Move adjacent to the primitive\n          moves, state = move_adjacent(state, target_loc)\n          plan.extend(moves)\n          # Use action to pick it up\n          plan.append(4)               # USE\n          _, _, _ = env.step(4)\n          state = env._current_state\n      else:\n          # All primitives gathered \u2013 go to the workshop\n          if workshop_idx is None:\n              break\n          locations = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n          if locations.size == 0:\n              break\n          cur_pos = np.array(state.pos)\n          dists = np.sum(np.abs(locations - cur_pos), axis=1)\n          target_loc = locations[dists.argmin()]\n          moves, state = move_adjacent(state, target_loc)\n          plan.extend(moves)\n          # Use action to craft the arrow\n          plan.append(4)               # USE\n          _, _, _ = env.step(4)\n          state = env._current_state\n\n  return plan", "env_interactions": 0, "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-10-27T15:35:25.789786", "function_name": "make_arrow", "function_body": "  # Reset the environment to start a fresh episode\n  env.reset()\n  state = env._current_state\n  world = env.world\n\n  # Identify the index for the target item \"arrow\"\n  arrow_idx = world.cookbook.index(\"arrow\")\n\n  # Determine which primitive resources are needed to craft an arrow\n  needed_primitives = world.cookbook.primitives_for(arrow_idx)\n\n  # Helper to generate a simple Manhattan path from current to target position\n  def _path_to(cur_pos, target_pos):\n      cx, cy = cur_pos\n      tx, ty = target_pos\n      moves = []\n      # Move vertically (DOWN=0, UP=1)\n      while cy < ty:\n          moves.append(0)   # DOWN\n          cy += 1\n      while cy > ty:\n          moves.append(1)   # UP\n          cy -= 1\n      # Move horizontally (LEFT=2, RIGHT=3)\n      while cx > tx:\n          moves.append(2)   # LEFT\n          cx -= 1\n      while cx < tx:\n          moves.append(3)   # RIGHT\n          cx += 1\n      return moves\n\n  action_list = []\n\n  # ----------------------------------------------------------------------\n  # 1. Collect all required primitive items\n  # ----------------------------------------------------------------------\n  for kind_idx, qty in needed_primitives.items():\n      for _ in range(qty):\n          # Locate any cell that currently contains the required primitive\n          locs = np.argwhere(state.grid[:, :, kind_idx] == 1)\n          if locs.size == 0:\n              # Primitive not present \u2013 abort planning for this item\n              break\n          target = tuple(locs[0])  # pick the first occurrence\n\n          # Move to the primitive location\n          for act in _path_to(state.pos, target):\n              action_list.append(act)\n              env.step(act)\n              state = env._current_state\n\n          # Pick it up (USE action = 4)\n          action_list.append(4)\n          env.step(4)\n          state = env._current_state\n\n  # ----------------------------------------------------------------------\n  # 2. Go to the appropriate workshop and craft the arrow\n  # ----------------------------------------------------------------------\n  # Retrieve the recipe to discover the required workshop type\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_kind = None\n  for key, val in recipe.items():\n      if key == \"_at\":\n          workshop_kind = val\n          break\n\n  # Fallback: if the recipe does not specify a workshop, use any workshop\n  if workshop_kind is None and world.workshop_indices:\n      workshop_kind = world.workshop_indices[0]\n\n  if workshop_kind is not None:\n      # Locate a workshop cell of the required type\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_kind] == 1)\n      if workshop_cells.size > 0:\n          target_ws = tuple(workshop_cells[0])\n\n          # Move to the workshop\n          for act in _path_to(state.pos, target_ws):\n              action_list.append(act)\n              env.step(act)\n              state = env._current_state\n\n          # Craft the arrow (USE action)\n          action_list.append(4)\n          env.step(4)\n          state = env._current_state\n\n  return action_list", "env_interactions": 0, "island_id": 9, "scores": {"3": -1}}
