{"timestamp": "2025-10-27T18:45:10.563221", "function_name": "make_arrow", "function_body": "  # Reset environment and fetch references\n  env.reset()\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  # Goal: arrow\n  goal_idx = idx[\"arrow\"]\n  # Primitive requirements for one arrow\n  prim_counts = world.cookbook.primitives_for(goal_idx)\n\n  # Workshop required for crafting (if any)\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else idx[wk]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def find_locs(kind):\n      \"\"\"Return list of (x, y) where `kind` appears on the current grid.\"\"\"\n      occ = np.where(state.grid[:, :, kind] > 0)\n      return list(zip(occ[0].tolist(), occ[1].tolist()))\n\n  # Pre\u2011compute blocked cells (non\u2011grabbable entities)\n  blocked_cells = set()\n  for ng in world.non_grabbable_indices:\n      occ = np.where(state.grid[:, :, ng] > 0)\n      blocked_cells.update(zip(occ[0].tolist(), occ[1].tolist()))\n\n  def bfs(start, goal):\n      \"\"\"Shortest path (list of positions) from start to goal avoiding blocked cells.\"\"\"\n      if start == goal:\n          return [start]\n      W, H = state.grid.shape[:2]\n      q = collections.deque([start])\n      prev = {start: None}\n      while q:\n          cur = q.popleft()\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked_cells:\n                  nxt = (nx, ny)\n                  if nxt not in prev:\n                      prev[nxt] = cur\n                      if nxt == goal:\n                          # reconstruct path\n                          path = [goal]\n                          while path[-1] != start:\n                              path.append(prev[path[-1]])\n                          path.reverse()\n                          return path\n                      q.append(nxt)\n      # unreachable \u2013 stay put\n      return [start]\n\n  def move_act(cur, nxt):\n      \"\"\"Translate adjacent step into action index.\"\"\"\n      dx, dy = nxt[0] - cur[0], nxt[1] - cur[1]\n      if dx == 1:\n          return 3  # RIGHT\n      if dx == -1:\n          return 2  # LEFT\n      if dy == 1:\n          return 0  # DOWN\n      if dy == -1:\n          return 1  # UP\n      raise AssertionError(\"Non\u2011adjacent move requested\")\n\n  # ------------------------------------------------------------------\n  # Build action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = state.pos\n\n  # 1) Collect required primitives\n  for p_idx, needed in prim_counts.items():\n      while state.inventory[p_idx] < needed:\n          locations = find_locs(p_idx)\n          if not locations:\n              # No more of this primitive on the map; break to avoid infinite loop\n              break\n          # Choose nearest primitive by Manhattan distance\n          target = min(locations,\n                       key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1]))\n          # Move to the target\n          path = bfs(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_act(cur_pos, step))\n              cur_pos = step\n          # Pick up primitive\n          actions.append(4)  # USE\n          # Update simulated state\n          state.inventory[p_idx] += 1\n          state.grid[target[0], target[1], p_idx] = 0\n\n  # 2) Go to workshop (if required) and craft\n  if workshop_kind is not None:\n      wk_locs = find_locs(workshop_kind)\n      if wk_locs:\n          target = min(wk_locs,\n                       key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1]))\n          path = bfs(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_act(cur_pos, step))\n              cur_pos = step\n  # Craft the arrow\n  actions.append(4)  # USE\n\n  return actions", "env_interactions": 19, "island_id": 3, "scores": {"3": 1.5}}
