{"timestamp": "2025-10-27T19:20:07.586853", "function_name": "make_arrow", "function_body": "  # Reset environment and obtain current state/world\n  env.reset()\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  # Goal definition (hard\u2011coded for arrow)\n  goal_name = \"arrow\"\n  goal_idx = idx[goal_name]\n\n  # Primitive requirements for one arrow\n  primitive_counts = world.cookbook.primitives_for(goal_idx)\n\n  # Determine required workshop (if any)\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else idx[wk]\n\n  # Working copies of grid and inventory for planning\n  grid = state.grid.copy()\n  inv = state.inventory.copy()\n  cur = state.pos  # current simulated position\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def find_positions(kind):\n      \"\"\"Return list of (x, y) where `kind` is present on the planning grid.\"\"\"\n      occ = np.where(grid[:, :, kind] > 0)\n      return list(zip(occ[0].tolist(), occ[1].tolist()))\n\n  def bfs(start, goal):\n      \"\"\"Shortest path avoiding non\u2011grabbable cells; returns list of cells.\"\"\"\n      if start == goal:\n          return [start]\n      W, H = grid.shape[:2]\n\n      # blocked cells = any non\u2011grabbable entity\n      blocked = set()\n      for ng in world.non_grabbable_indices:\n          occ = np.where(grid[:, :, ng] > 0)\n          blocked.update(zip(occ[0].tolist(), occ[1].tolist()))\n\n      from collections import deque\n      q = deque([start])\n      prev = {start: None}\n      while q:\n          curp = q.popleft()\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = curp[0] + dx, curp[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:\n                  if (nx, ny) not in prev:\n                      prev[(nx, ny)] = curp\n                      if (nx, ny) == goal:\n                          # reconstruct path\n                          path = [goal]\n                          while path[-1] != start:\n                              path.append(prev[path[-1]])\n                          path.reverse()\n                          return path\n                      q.append((nx, ny))\n      # No path found \u2013 stay in place\n      return [start]\n\n  def move_to(target):\n      \"\"\"Generate actions to move from current `cur` to `target`.\"\"\"\n      nonlocal cur\n      actions_local = []\n      path = bfs(cur, target)\n      for step in path[1:]:\n          dx = step[0] - cur[0]\n          dy = step[1] - cur[1]\n          if dx == 1:\n              act = 3   # RIGHT\n          elif dx == -1:\n              act = 2   # LEFT\n          elif dy == 1:\n              act = 0   # DOWN\n          elif dy == -1:\n              act = 1   # UP\n          else:\n              raise AssertionError(\"Non\u2011adjacent move generated\")\n          actions_local.append(act)\n          cur = step\n      return actions_local\n\n  # ------------------------------------------------------------------\n  # Build the action sequence\n  # ------------------------------------------------------------------\n  actions = []\n\n  # 1) Collect all required primitives\n  for prim_idx, needed in primitive_counts.items():\n      while inv[prim_idx] < needed:\n          positions = find_positions(prim_idx)\n          if not positions:\n              # No more of this primitive on the map \u2013 give up collecting\n              break\n          # Choose nearest instance (Manhattan distance heuristic)\n          target = min(\n              positions,\n              key=lambda p: abs(p[0] - cur[0]) + abs(p[1] - cur[1])\n          )\n          actions.extend(move_to(target))\n          actions.append(4)                     # USE to pick up\n          inv[prim_idx] += 1\n          grid[target[0], target[1], prim_idx] = 0   # remove from planning grid\n\n  # 2) Go to the workshop (if required) and craft\n  if workshop_kind is not None:\n      wk_positions = find_positions(workshop_kind)\n      if wk_positions:\n          target = min(\n              wk_positions,\n              key=lambda p: abs(p[0] - cur[0]) + abs(p[1] - cur[1])\n          )\n          actions.extend(move_to(target))\n  # Craft (or craft at current location if no workshop needed)\n  actions.append(4)   # USE\n\n  return actions", "env_interactions": 19, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T19:20:08.715883", "function_name": "make_arrow", "function_body": "  # Reset environment and get current state/world information\n  env.reset()\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  # ------------------------------------------------------------\n  # Identify goal and its recipe\n  # ------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = idx[goal_name]\n\n  # Primitive requirements for one instance of the goal\n  primitive_counts = world.cookbook.primitives_for(goal_idx)\n\n  # Determine required workshop (if any)\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else idx[wk]\n\n  # ------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------\n  def find_locations(kind):\n      \"\"\"Return list of (x, y) coordinates where `kind` is present.\"\"\"\n      occ = np.where(state.grid[:, :, kind] > 0)\n      return list(zip(occ[0].tolist(), occ[1].tolist()))\n\n  def bfs_path(start, goal):\n      \"\"\"Shortest path from `start` to `goal` avoiding non\u2011grabbable cells.\"\"\"\n      if start == goal:\n          return [start]\n      W, H = state.grid.shape[:2]\n\n      # Build a set of blocked cells (non\u2011grabbable entities)\n      blocked = set()\n      for ng in world.non_grabbable_indices:\n          occ = np.where(state.grid[:, :, ng] > 0)\n          blocked.update(zip(occ[0].tolist(), occ[1].tolist()))\n\n      queue = collections.deque([start])\n      prev = {start: None}\n      while queue:\n          cur = queue.popleft()\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:\n                  nxt = (nx, ny)\n                  if nxt not in prev:\n                      prev[nxt] = cur\n                      if nxt == goal:\n                          # Reconstruct path\n                          path = [goal]\n                          while path[-1] != start:\n                              path.append(prev[path[-1]])\n                          path.reverse()\n                          return path\n                      queue.append(nxt)\n      # No path found \u2013 stay in place\n      return [start]\n\n  def move_action(cur, nxt):\n      \"\"\"Translate a step from `cur` to adjacent `nxt` into an action index.\"\"\"\n      dx = nxt[0] - cur[0]\n      dy = nxt[1] - cur[1]\n      if dx == 1:\n          return 3   # RIGHT\n      if dx == -1:\n          return 2   # LEFT\n      if dy == 1:\n          return 0   # DOWN\n      if dy == -1:\n          return 1   # UP\n      raise AssertionError(\"Non\u2011adjacent movement requested\")\n\n  # ------------------------------------------------------------\n  # Build the action sequence\n  # ------------------------------------------------------------\n  actions = []\n  cur_pos = state.pos\n\n  # ------------------------------------------------------------\n  # 1) Collect all required primitives\n  # ------------------------------------------------------------\n  for prim_idx, needed in primitive_counts.items():\n      while state.inventory[prim_idx] < needed:\n          # Locate remaining instances of the primitive on the grid\n          locations = find_locations(prim_idx)\n          if not locations:\n              # No more copies available \u2013 abort collection for this primitive\n              break\n\n          # Choose the nearest instance (Manhattan distance heuristic)\n          target = min(\n              locations,\n              key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1])\n          )\n\n          # Compute path and translate into actions\n          path = bfs_path(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n\n          # Pick up the primitive\n          actions.append(4)   # USE\n          # Update the planning snapshot of inventory/grid\n          state.inventory[prim_idx] += 1\n          state.grid[target[0], target[1], prim_idx] = 0\n\n  # ------------------------------------------------------------\n  # 2) Move to the required workshop (if any) and craft\n  # ------------------------------------------------------------\n  if workshop_kind is not None:\n      wk_locations = find_locations(workshop_kind)\n      if wk_locations:\n          # Choose nearest workshop\n          target = min(\n              wk_locations,\n              key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1])\n          )\n          path = bfs_path(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n  # Craft the arrow (USE at current location)\n  actions.append(4)   # USE\n\n  return actions", "env_interactions": 19, "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T19:20:44.800022", "function_name": "make_arrow", "function_body": "", "env_interactions": 0, "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-10-27T19:20:45.936744", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Reset environment and fetch current state/world information\n  env.reset()\n  state = env._current_state          # CraftState instance\n  world = env.world\n  cookbook = world.cookbook\n\n  # Identify the target item (\"arrow\") and its recipe\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n  primitive_needs = cookbook.primitives_for(goal_idx)          # {kind_idx: count}\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  if \"_at\" in recipe:\n      workshop_idx = cookbook.index[recipe[\"_at\"]]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def bfs_path(start, goal, occupied):\n      \"\"\"Return a list of positions from start (excluded) to goal (included)\n      moving only through cells where `occupied` is False. Goal cell may be occupied.\"\"\"\n      w, h = occupied.shape\n      visited = np.zeros((w, h), dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start] = True\n      while q:\n          x, y = q.popleft()\n          if (x, y) == goal:\n              break\n          for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):\n              if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:\n                  # Goal cell may be occupied; treat it as walkable.\n                  if (nx, ny) == goal or not occupied[nx, ny]:\n                      visited[nx, ny] = True\n                      prev[(nx, ny)] = (x, y)\n                      q.append((nx, ny))\n      if not visited[goal]:\n          return None\n      # Reconstruct path (exclude start, include goal)\n      path = []\n      cur = goal\n      while cur != start:\n          path.append(cur)\n          cur = prev[cur]\n      path.reverse()\n      return path\n\n  def delta_to_action(dx, dy):\n      \"\"\"Map a movement delta to the environment's action index.\"\"\"\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise ValueError(\"Invalid movement delta\")\n\n  actions = []\n  cur_pos = tuple(state.pos)          # current (x, y)\n  grid = state.grid.copy()            # mutable copy to track collected primitives\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitive resources\n  # ------------------------------------------------------------------\n  for kind_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          # Locate remaining cells containing this primitive\n          locations = np.argwhere(grid[:, :, kind_idx] > 0)\n          if locations.size == 0:\n              break  # no more of this primitive on the map\n          # Order candidates by Manhattan distance from current position\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n\n          occupied_mask = np.any(grid, axis=2)   # any entity blocks movement\n          target = None\n          path = None\n          for idx in order:\n              cand = tuple(locations[idx])\n              p = bfs_path(cur_pos, cand, occupied_mask)\n              if p is not None:\n                  target = cand\n                  path = p\n                  break\n          if target is None:\n              # Could not reach any remaining instance; skip this primitive\n              continue\n\n          # Follow the path, emitting movement actions\n          for step in path:\n              dx = step[0] - cur_pos[0]\n              dy = step[1] - cur_pos[1]\n              actions.append(delta_to_action(dx, dy))\n              cur_pos = step\n          # Pick up the primitive\n          actions.append(4)          # USE\n          grid[target[0], target[1], kind_idx] = 0   # mark as collected\n\n  # ------------------------------------------------------------------\n  # 2) Move to workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size:\n          dists = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n          occupied_mask = np.any(state.grid, axis=2)   # original occupancy (workshops block)\n          for idx in order:\n              cand = tuple(workshop_cells[idx])\n              p = bfs_path(cur_pos, cand, occupied_mask)\n              if p is not None:\n                  for step in p:\n                      dx = step[0] - cur_pos[0]\n                      dy = step[1] - cur_pos[1]\n                      actions.append(delta_to_action(dx, dy))\n                      cur_pos = step\n                  actions.append(4)   # USE at workshop to craft\n                  break\n  else:\n      # No specific workshop required; simply use current cell to craft\n      actions.append(4)\n\n  return actions", "env_interactions": 26, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T19:21:13.881218", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  goal_name = \"arrow\"\n  goal_idx = idx[goal_name]\n\n  primitive_counts = world.cookbook.primitives_for(goal_idx)\n\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else idx[wk]\n\n  def find_locations(kind):\n      occ = np.where(state.grid[:, :, kind] > 0)\n      return list(zip(occ[0].tolist(), occ[1].tolist()))\n\n  def bfs_path(start, goal):\n      if start == goal:\n          return [start]\n      W, H = state.grid.shape[:2]\n      blocked = set()\n      for ng in world.non_grabbable_indices:\n          occ = np.where(state.grid[:, :, ng] > 0)\n          blocked.update(zip(occ[0].tolist(), occ[1].tolist()))\n      queue = collections.deque([start])\n      prev = {start: None}\n      while queue:\n          cur = queue.popleft()\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:\n                  nxt = (nx, ny)\n                  if nxt not in prev:\n                      prev[nxt] = cur\n                      if nxt == goal:\n                          path = [goal]\n                          while path[-1] != start:\n                              path.append(prev[path[-1]])\n                          path.reverse()\n                          return path\n                      queue.append(nxt)\n      return [start]\n\n  def move_action(cur, nxt):\n      dx = nxt[0] - cur[0]\n      dy = nxt[1] - cur[1]\n      if dx == 1:\n          return 3   # RIGHT\n      if dx == -1:\n          return 2   # LEFT\n      if dy == 1:\n          return 0   # DOWN\n      if dy == -1:\n          return 1   # UP\n      raise AssertionError(\"Non\u2011adjacent movement requested\")\n\n  actions = []\n  cur_pos = state.pos\n\n  # 1) Collect required primitives\n  for prim_idx, needed in primitive_counts.items():\n      while state.inventory[prim_idx] < needed:\n          locations = find_locations(prim_idx)\n          if not locations:\n              break\n          target = min(\n              locations,\n              key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1])\n          )\n          path = bfs_path(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n          actions.append(4)   # USE\n          state.inventory[prim_idx] += 1\n          state.grid[target[0], target[1], prim_idx] = 0\n\n  # 2) Move to workshop (if any) and craft\n  if workshop_kind is not None:\n      wk_locations = find_locations(workshop_kind)\n      if wk_locations:\n          target = min(\n              wk_locations,\n              key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1])\n          )\n          path = bfs_path(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n\n  actions.append(4)   # USE to craft the arrow\n  return actions", "env_interactions": 19, "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T19:21:15.000837", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  # ------------------------------------------------------------\n  # Identify goal and its recipe\n  # ------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = idx[goal_name]\n\n  # Primitive requirements for one instance of the goal\n  primitive_counts = world.cookbook.primitives_for(goal_idx)\n\n  # Determine required workshop (if any)\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  if \"_at\" in recipe:\n      wk = recipe[\"_at\"]\n      workshop_kind = wk if isinstance(wk, int) else idx[wk]\n\n  # ------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------\n  def find_locations(kind):\n      \"\"\"Return list of (x, y) coordinates where `kind` is present.\"\"\"\n      occ = np.where(state.grid[:, :, kind] > 0)\n      return list(zip(occ[0].tolist(), occ[1].tolist()))\n\n  def bfs_path(start, goal):\n      \"\"\"Shortest path from `start` to `goal` avoiding non\u2011grabbable cells.\"\"\"\n      if start == goal:\n          return [start]\n      W, H = state.grid.shape[:2]\n\n      # Build a set of blocked cells (non\u2011grabbable entities)\n      blocked = set()\n      for ng in world.non_grabbable_indices:\n          occ = np.where(state.grid[:, :, ng] > 0)\n          blocked.update(zip(occ[0].tolist(), occ[1].tolist()))\n\n      queue = collections.deque([start])\n      prev = {start: None}\n      while queue:\n          cur = queue.popleft()\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:\n                  nxt = (nx, ny)\n                  if nxt not in prev:\n                      prev[nxt] = cur\n                      if nxt == goal:\n                          # Reconstruct path\n                          path = [goal]\n                          while path[-1] != start:\n                              path.append(prev[path[-1]])\n                          path.reverse()\n                          return path\n                      queue.append(nxt)\n      # No path found \u2013 stay in place\n      return [start]\n\n  def move_action(cur, nxt):\n      \"\"\"Translate a step from `cur` to adjacent `nxt` into an action index.\"\"\"\n      dx = nxt[0] - cur[0]\n      dy = nxt[1] - cur[1]\n      if dx == 1:\n          return 3   # RIGHT\n      if dx == -1:\n          return 2   # LEFT\n      if dy == 1:\n          return 0   # DOWN\n      if dy == -1:\n          return 1   # UP\n      raise AssertionError(\"Non\u2011adjacent movement requested\")\n\n  # ------------------------------------------------------------\n  # Build the action sequence\n  # ------------------------------------------------------------\n  actions = []\n  cur_pos = state.pos\n\n  # ------------------------------------------------------------\n  # 1) Collect all required primitives\n  # ------------------------------------------------------------\n  for prim_idx, needed in primitive_counts.items():\n      while state.inventory[prim_idx] < needed:\n          # Locate remaining instances of the primitive on the grid\n          locations = find_locations(prim_idx)\n          if not locations:\n              # No more copies available \u2013 abort collection for this primitive\n              break\n\n          # Choose the nearest instance (Manhattan distance heuristic)\n          target = min(\n              locations,\n              key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1])\n          )\n\n          # Compute path and translate into actions\n          path = bfs_path(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n\n          # Pick up the primitive\n          actions.append(4)   # USE\n          # Update the planning snapshot of inventory/grid\n          state.inventory[prim_idx] += 1\n          state.grid[target[0], target[1], prim_idx] = 0\n\n  # ------------------------------------------------------------\n  # 2) Move to the required workshop (if any) and craft\n  # ------------------------------------------------------------\n  if workshop_kind is not None:\n      wk_locations = find_locations(workshop_kind)\n      if wk_locations:\n          # Choose nearest workshop\n          target = min(\n              wk_locations,\n              key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1])\n          )\n          path = bfs_path(cur_pos, target)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n\n  # Craft the arrow (USE at current location)\n  actions.append(4)   # USE\n\n  return actions", "env_interactions": 19, "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T19:21:37.389136", "function_name": "make_arrow", "function_body": "  try:\n      env.reset()\n  except Exception:\n      pass\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []\n\n  world = env.world\n  idx = world.cookbook.index\n\n  try:\n      goal_idx = idx[\"arrow\"]\n  except Exception:\n      return []\n\n  needed = world.cookbook.primitives_for(goal_idx)\n\n  workshop_idx = None\n  for k, v in world.cookbook.recipes.get(goal_idx, {}).items():\n      if k in (\"_at\", \"_key\"):\n          try:\n              workshop_idx = idx[v]\n          except Exception:\n              workshop_idx = None\n          break\n  if workshop_idx is None:\n      return []\n\n  pos = tuple(state.pos)\n  grid = state.grid.copy()\n  inventory = state.inventory.copy()\n  occupied = np.any(grid > 0, axis=2)\n\n  plan = []\n\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n  USE = 4\n\n  from collections import deque\n\n  def bfs_adjacent(start, target, blocked):\n      h, w = blocked.shape\n      tx, ty = target\n      goal_cells = []\n      for a, (dx, dy) in enumerate(DIRS):\n          gx, gy = tx + dx, ty + dy\n          if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:\n              goal_cells.append((gx, gy))\n      if not goal_cells:\n          return []\n      q = deque([(start, [])])\n      visited = {start}\n      while q:\n          (cx, cy), path = q.popleft()\n          if (cx, cy) in goal_cells:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []\n\n  def move_and_use(target, kind_idx):\n      nonlocal pos, plan, grid, occupied, inventory\n      path = bfs_adjacent(pos, target, occupied)\n      if not path and pos != target:\n          return False\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n      plan.extend(path)\n\n      plan.append(USE)\n\n      tx, ty = target\n      if grid[tx, ty, kind_idx] > 0:\n          grid[tx, ty, kind_idx] = 0\n          occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)\n          inventory[kind_idx] += 1\n      return True\n\n  for kind_idx, cnt in needed.items():\n      for _ in range(cnt):\n          locations = np.argwhere(grid[:, :, kind_idx] > 0)\n          if locations.size == 0:\n              return plan\n          dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n          target = tuple(locations[dists.argmin()])\n          if not move_and_use(target, kind_idx):\n              return plan\n\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          return plan\n  dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])\n  workshop_target = tuple(workshop_cells[dists.argmin()])\n  move_and_use(workshop_target, workshop_idx)\n\n  return plan", "env_interactions": 23, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T19:21:38.517473", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ------------------------------------------------------------\n  # Action constants (match CraftLab.action_specs ordering)\n  # ------------------------------------------------------------\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # DOWN, UP, LEFT, RIGHT\n  USE = 4\n\n  # ------------------------------------------------------------\n  # Helper: BFS that returns a list of move actions taking the agent\n  # from *start* to any empty cell adjacent (4\u2011connected) to *target*.\n  # *blocked* is a bool matrix where True means the cell cannot be entered.\n  # ------------------------------------------------------------\n  def bfs_adjacent(start, target, blocked):\n      h, w = blocked.shape\n      tx, ty = target\n      goal_cells = []\n      for a, (dx, dy) in enumerate(DIRS):\n          gx, gy = tx + dx, ty + dy\n          if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:\n              goal_cells.append((gx, gy))\n      if not goal_cells:\n          return []                     # target completely surrounded\n\n      q = deque([(start, [])])\n      visited = {start}\n      while q:\n          (cx, cy), path = q.popleft()\n          if (cx, cy) in goal_cells:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []                         # unreachable\n\n  # ------------------------------------------------------------\n  # Initialise / obtain the current state from the environment.\n  # ------------------------------------------------------------\n  try:\n      env.reset()\n  except Exception:\n      pass\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []\n\n  world = env.world\n  idx = world.cookbook.index\n\n  # ------------------------------------------------------------\n  # Identify the goal (arrow) and the workshop required to craft it.\n  # ------------------------------------------------------------\n  try:\n      goal_idx = idx[\"arrow\"]\n  except Exception:\n      return []                         # arrow not defined\n\n  needed = world.cookbook.primitives_for(goal_idx)\n\n  workshop_idx = None\n  for k, v in world.cookbook.recipes.get(goal_idx, {}).items():\n      if k in (\"_at\", \"_key\"):\n          try:\n              workshop_idx = idx[v]\n          except Exception:\n              workshop_idx = None\n          break\n  if workshop_idx is None:\n      return []                         # cannot locate workshop\n\n  # ------------------------------------------------------------\n  # Local mutable copies for planning.\n  # ------------------------------------------------------------\n  pos = tuple(state.pos)                # (x, y)\n  grid = state.grid.copy()              # (W, H, n_kinds)\n  inventory = state.inventory.copy()\n  occupied = np.any(grid > 0, axis=2)   # bool matrix: True where any entity exists\n\n  plan = []\n\n  # ------------------------------------------------------------\n  # Helper: move adjacent to *target*, issue USE, and update simulated\n  # state (grid, occupied, inventory, pos). Returns False on failure.\n  # ------------------------------------------------------------\n  def move_and_use(target, kind_idx):\n      nonlocal pos, plan, grid, occupied, inventory\n      path = bfs_adjacent(pos, target, occupied)\n      if not path and pos != target:\n          return False                  # cannot reach adjacency\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n      plan.extend(path)\n\n      plan.append(USE)                  # interact with the target cell\n\n      tx, ty = target\n      if grid[tx, ty, kind_idx] > 0:    # pick up primitive / component\n          grid[tx, ty, kind_idx] = 0\n          occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)\n          inventory[kind_idx] += 1\n      return True\n\n  # ------------------------------------------------------------\n  # Collect all required primitives / components.\n  # ------------------------------------------------------------\n  for kind_idx, cnt in needed.items():\n      for _ in range(cnt):\n          locations = np.argwhere(grid[:, :, kind_idx] > 0)\n          if locations.size == 0:\n              return plan                # nothing left to collect\n          dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n          target = tuple(locations[dists.argmin()])\n          if not move_and_use(target, kind_idx):\n              return plan\n\n  # ------------------------------------------------------------\n  # Move to the workshop and craft the arrow.\n  # ------------------------------------------------------------\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      # Workshops are static; fall back to the original scenario grid.\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          return plan\n  dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])\n  workshop_target = tuple(workshop_cells[dists.argmin()])\n  move_and_use(workshop_target, workshop_idx)\n\n  # ------------------------------------------------------------\n  # Return the constructed action sequence.\n  # ------------------------------------------------------------\n  return plan", "env_interactions": 23, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T19:22:12.243379", "function_name": "make_arrow", "function_body": "", "env_interactions": 0, "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-10-27T19:22:13.380039", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Reset environment and grab useful references\n  env.reset()\n  state = env._current_state               # CraftState\n  world = env.scenario.world                # CraftWorld\n  cookbook = world.cookbook                 # Cookbook\n  index = cookbook.index                    # name \u2194 id mapping\n\n  # Identify the goal item\n  goal_name = \"arrow\"\n  if goal_name not in index.contents:\n      return []  # arrow not defined in this world\n\n  goal_idx = index[goal_name]\n\n  # Determine which primitive resources are needed for one arrow\n  primitive_needs = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n  actions = []\n\n  # Simple Manhattan path planner\n  def _move_to(start, target):\n      \"\"\"Return a list of move actions (DOWN/UP/RIGHT/LEFT) that walks\n      from start (r,c) to target (r,c) using a greedy Manhattan approach.\n      Also returns the final position after executing those moves.\"\"\"\n      r, c = start\n      tr, tc = target\n      seq = []\n      while (r, c) != (tr, tc):\n          if r < tr:\n              seq.append(DOWN)\n              r += 1\n          elif r > tr:\n              seq.append(UP)\n              r -= 1\n          elif c < tc:\n              seq.append(RIGHT)\n              c += 1\n          else:  # c > tc\n              seq.append(LEFT)\n              c -= 1\n      return seq, (r, c)\n\n  # ------------------------------------------------------------------\n  # 1. Collect each required primitive.\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          # Find any cell that currently holds this primitive\n          primitive_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if primitive_cells.size == 0:\n              # No more of this primitive on the map \u2013 abort planning.\n              return actions\n\n          target_r, target_c = primitive_cells[0]\n\n          # Move next to the primitive cell\n          move_seq, new_pos = _move_to(state.pos, (target_r, target_c))\n          actions.extend(move_seq)\n          state.pos = new_pos\n\n          # Pick it up (USE).  In the default implementation, using on the\n          # same cell works for picking up items.\n          actions.append(USE)\n\n          # Update our internal copy of the state for subsequent planning.\n          state.inventory[prim_idx] += 1\n          state.grid[target_r, target_c, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 2. Go to the appropriate workshop and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      return actions  # No workshop information; cannot craft.\n\n  workshop_idx = index[workshop_name]\n\n  # Locate a workshop cell (any will do)\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      return actions  # No workshop cell found.\n\n  w_r, w_c = workshop_cells[0]\n\n  # Move to the workshop cell\n  move_seq, new_pos = _move_to(state.pos, (w_r, w_c))\n  actions.extend(move_seq)\n  state.pos = new_pos\n\n  # Craft the arrow (USE while standing on the workshop)\n  actions.append(USE)\n\n  return actions", "env_interactions": 24, "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T19:22:38.216601", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Reset the environment and obtain the current state and world objects\n  env.reset()\n  state = env._current_state          # CraftState instance\n  world = env.world\n  cookbook = world.cookbook\n\n  # Identify the goal (arrow) and its recipe\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n  if goal_idx is None:\n      return []                       # unknown goal\n\n  primitive_needs = cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  if \"_at\" in recipe:\n      workshop_idx = cookbook.index[recipe[\"_at\"]]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def bfs_path(start, goal, occupied):\n      \"\"\"Bread\u2011first search returning a list of positions from start (excluded) to goal (included).\"\"\"\n      w, h = occupied.shape\n      q = deque([start])\n      visited = np.zeros((w, h), dtype=bool)\n      visited[start] = True\n      prev = {}\n      while q:\n          x, y = q.popleft()\n          if (x, y) == goal:\n              break\n          for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):\n              if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:\n                  # Allow stepping onto the goal even if occupied\n                  if (nx, ny) == goal or not occupied[nx, ny]:\n                      visited[nx, ny] = True\n                      prev[(nx, ny)] = (x, y)\n                      q.append((nx, ny))\n      if not visited[goal]:\n          return None\n      # Reconstruct path (exclude start, include goal)\n      path = []\n      cur = goal\n      while cur != start:\n          path.append(cur)\n          cur = prev[cur]\n      path.reverse()\n      return path\n\n  def delta_to_action(dx, dy):\n      \"\"\"Convert a movement delta into the corresponding action index.\"\"\"\n      if dx == 1:\n          return 3   # RIGHT\n      if dx == -1:\n          return 2   # LEFT\n      if dy == 1:\n          return 0   # DOWN\n      if dy == -1:\n          return 1   # UP\n      raise ValueError(\"Invalid movement delta\")\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # Work on a mutable copy of the grid to keep track of collected primitives\n  grid = state.grid.copy()\n  occupied_mask = lambda g: np.any(g, axis=2)   # any non\u2011empty cell is an obstacle\n\n  # ------------------------------------------------------------------\n  # Collect all required primitives\n  # ------------------------------------------------------------------\n  for kind_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          # Locate remaining cells containing this primitive\n          locations = np.argwhere(grid[:, :, kind_idx] > 0)\n          if locations.size == 0:\n              break\n          # Order candidates by Manhattan distance from current position\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n\n          target = None\n          path = None\n          for idx in order:\n              cand = tuple(locations[idx])\n              p = bfs_path(cur_pos, cand, occupied_mask(grid))\n              if p is not None:\n                  target = cand\n                  path = p\n                  break\n          if path is None:\n              continue    # cannot reach any remaining instance\n\n          # Follow the path to the primitive\n          for step in path:\n              dx = step[0] - cur_pos[0]\n              dy = step[1] - cur_pos[1]\n              actions.append(delta_to_action(dx, dy))\n              cur_pos = step\n\n          # Pick up the primitive\n          actions.append(4)   # USE\n          grid[target[0], target[1], kind_idx] = 0   # Remove from copy\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size:\n          dists = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])\n          order = np.argsort(dists)\n          for idx in order:\n              cand = tuple(workshop_cells[idx])\n              p = bfs_path(cur_pos, cand, occupied_mask(state.grid))\n              if p is not None:\n                  for step in p:\n                      dx = step[0] - cur_pos[0]\n                      dy = step[1] - cur_pos[1]\n                      actions.append(delta_to_action(dx, dy))\n                      cur_pos = step\n                  actions.append(4)   # USE to trigger crafting\n                  break\n\n  return actions", "env_interactions": 26, "island_id": 6, "scores": {"3": 0.5}}
