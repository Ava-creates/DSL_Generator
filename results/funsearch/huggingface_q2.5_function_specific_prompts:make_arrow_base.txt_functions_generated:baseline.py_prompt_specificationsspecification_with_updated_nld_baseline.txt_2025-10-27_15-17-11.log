{"timestamp": "2025-10-27T19:18:26.066467", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.scenario.world\n  cookbook = world.cookbook\n  idx = cookbook.index\n\n  # Resolve action indices.\n  action_map = env.action_specs()\n  DOWN = action_map[\"DOWN\"]\n  UP = action_map[\"UP\"]\n  LEFT = action_map[\"LEFT\"]\n  RIGHT = action_map[\"RIGHT\"]\n  USE = action_map[\"USE\"]\n  moves = [(DOWN, (1, 0)),\n           (UP, (-1, 0)),\n           (LEFT, (0, -1)),\n           (RIGHT, (0, 1))]\n\n  from collections import deque\n  import numpy as np\n\n  def _bfs_path(start, target):\n      \"\"\"Return a list of movement actions from start to target,\n      allowing the target cell to be occupied.\"\"\"\n      if start == target:\n          return []\n      h, w = state.grid.shape[:2]\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          for act, (dr, dc) in moves:\n              nr, nc = cur[0] + dr, cur[1] + dc\n              if not (0 <= nr < h and 0 <= nc < w):\n                  continue\n              nxt = (nr, nc)\n              if nxt in visited:\n                  continue\n              # Allow stepping onto the target even if occupied.\n              if nxt != target and state.grid[nr, nc, :].any():\n                  continue\n              visited.add(nxt)\n              parent[nxt] = (cur, act)\n              q.append(nxt)\n      if target not in parent and start != target:\n          return []  # No path found.\n      # Reconstruct path.\n      path = []\n      cur = target\n      while cur != start:\n          prev, act = parent[cur]\n          path.append(act)\n          cur = prev\n      path.reverse()\n      return path\n\n  def _nearest_cell(cells, start):\n      \"\"\"Pick the cell with smallest Manhattan distance to start.\"\"\"\n      best = None\n      best_dist = None\n      for r, c in cells:\n          d = abs(r - start[0]) + abs(c - start[1])\n          if best is None or d < best_dist:\n              best = (r, c)\n              best_dist = d\n      return best\n\n  # Identify the goal item.\n  goal_name = \"arrow\"\n  if goal_name not in idx.contents:\n      return []\n  goal_idx = idx[goal_name]\n\n  # Determine which primitive resources are required.\n  primitive_needs = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n  actions = []\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitive items.\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          # Locate all cells currently holding this primitive.\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # Primitive not present; abort early.\n              return actions\n          # Choose the nearest occurrence.\n          target = _nearest_cell(prim_cells, state.pos)\n          # Move to that cell.\n          move_seq = _bfs_path(state.pos, target)\n          actions.extend(move_seq)\n          state.pos = target\n          # Pick it up.\n          actions.append(USE)\n          tr, tc = target\n          state.inventory[prim_idx] += 1\n          state.grid[tr, tc, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 2. Move to the appropriate workshop and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      return actions\n  workshop_idx = idx[workshop_name]\n\n  # Find a workshop cell (any will do; pick the closest).\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      return actions\n  workshop_target = _nearest_cell(workshop_cells, state.pos)\n\n  move_seq = _bfs_path(state.pos, workshop_target)\n  actions.extend(move_seq)\n  state.pos = workshop_target\n\n  # Craft the arrow.\n  actions.append(USE)\n\n  return actions", "env_interactions": 24, "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T19:18:57.033892", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ----------------------------------------------------------------------\n  # Action constants (match CraftLab.action_specs order)\n  # ----------------------------------------------------------------------\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # 0:DOWN, 1:UP, 2:LEFT, 3:RIGHT\n  USE = 4\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS to any empty cell adjacent to a target coordinate\n  # ----------------------------------------------------------------------\n  def bfs_to_adjacent(start, target, blocked):\n      \"\"\"Return list of movement actions to reach a free neighbour of *target*.\n      If unreachable, returns empty list.\"\"\"\n      h, w = blocked.shape\n      tx, ty = int(target[0]), int(target[1])\n      goal_cells = []\n      for a, (dx, dy) in enumerate(DIRS):\n          gx, gy = tx + dx, ty + dy\n          if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:\n              goal_cells.append((gx, gy))\n\n      if not goal_cells:\n          return []\n\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (cx, cy), path = q.popleft()\n          if (cx, cy) in goal_cells:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []\n\n  # ----------------------------------------------------------------------\n  # Reset / initialise environment\n  # ----------------------------------------------------------------------\n  try:\n      env.reset()\n  except Exception:\n      pass\n\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []  # cannot access internal state\n\n  world = env.world\n  idx = world.cookbook.index\n\n  # ----------------------------------------------------------------------\n  # Identify goal (arrow) and its recipe\n  # ----------------------------------------------------------------------\n  try:\n      arrow_idx = idx[\"arrow\"]\n  except Exception:\n      return []  # arrow not present in this world\n\n  primitives_needed = world.cookbook.primitives_for(arrow_idx)\n\n  recipe_dict = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe_dict.get(\"_at\")\n  if workshop_name is None:\n      # fallback to other possible key\n      workshop_name = recipe_dict.get(\"_key\")\n  if workshop_name is None:\n      return []  # cannot find required workshop\n\n  try:\n      workshop_idx = idx[workshop_name]\n  except Exception:\n      return []  # workshop name not indexed\n\n  # ----------------------------------------------------------------------\n  # Local mutable copies for planning\n  # ----------------------------------------------------------------------\n  pos = tuple(state.pos)                     # (x, y)\n  grid = state.grid.copy()                   # (W, H, n_kinds)\n  inventory = state.inventory.copy()\n  occupied = np.any(grid > 0, axis=2)        # bool matrix of blocked cells\n\n  plan_actions = []\n\n  # ----------------------------------------------------------------------\n  # Helper: move to a target entity cell and issue USE\n  # ----------------------------------------------------------------------\n  def move_and_use(target_coord, kind_idx):\n      \"\"\"Move adjacent to *target_coord* (which holds *kind_idx*) and USE.\n      Updates simulated position, grid, occupied, inventory.\n      Returns True on success, False otherwise.\"\"\"\n      nonlocal pos, plan_actions, grid, occupied, inventory\n\n      path = bfs_to_adjacent(pos, target_coord, occupied)\n      if not path and pos != target_coord:\n          return False\n\n      # apply movement actions to simulated state\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n      plan_actions.extend(path)\n\n      # perform USE\n      plan_actions.append(USE)\n\n      tx, ty = int(target_coord[0]), int(target_coord[1])\n      if grid[tx, ty, kind_idx] > 0:\n          # pick up the primitive\n          grid[tx, ty, kind_idx] = 0\n          occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)\n          inventory[kind_idx] += 1\n      return True\n\n  # ----------------------------------------------------------------------\n  # Collect required primitives\n  # ----------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      for _ in range(needed_cnt):\n          candidates = np.argwhere(grid[:, :, prim_idx] > 0)\n          if candidates.shape[0] == 0:\n              # no more of this primitive on map; abort planning\n              return plan_actions\n          dists = np.abs(candidates[:, 0] - pos[0]) + np.abs(candidates[:, 1] - pos[1])\n          target = candidates[dists.argmin()]\n          if not move_and_use(target, prim_idx):\n              return plan_actions\n\n  # ----------------------------------------------------------------------\n  # Move to a workshop and craft the arrow\n  # ----------------------------------------------------------------------\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.shape[0] == 0:\n      # fallback to original scenario grid (workshops are static)\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.shape[0] == 0:\n          return plan_actions\n\n  dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])\n  workshop_target = workshop_cells[dists.argmin()]\n\n  move_and_use(workshop_target, workshop_idx)\n\n  return plan_actions", "env_interactions": 23, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T19:18:58.168832", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action mapping (matches CraftLab.action_specs ordering)\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # 0:DOWN, 1:UP, 2:LEFT, 3:RIGHT\n  USE = 4\n\n  def bfs_to_adjacent(start, target, blocked):\n      \"\"\"Return a list of movement actions that brings the agent from *start*\n      to any empty cell that is 4\u2011connected to *target*.\n      If no such path exists, returns an empty list.\"\"\"\n      h, w = blocked.shape\n      goal_cells = []\n      tx, ty = int(target[0]), int(target[1])\n      for a, (dx, dy) in enumerate(DIRS):\n          gx, gy = tx + dx, ty + dy\n          if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:\n              goal_cells.append((gx, gy))\n      if not goal_cells:\n          return []\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (cx, cy), path = q.popleft()\n          if (cx, cy) in goal_cells:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []\n\n  # Reset / initialise environment\n  try:\n      env.reset()\n  except Exception:\n      pass\n\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []\n\n  world = env.world\n  idx = world.cookbook.index\n\n  # Identify goal (arrow) and its recipe\n  try:\n      arrow_idx = idx[\"arrow\"]\n  except Exception:\n      return []\n\n  primitives_needed = world.cookbook.primitives_for(arrow_idx)\n\n  recipe_dict = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = None\n  for k, v in recipe_dict.items():\n      if k == \"_at\" or k == \"_key\":\n          workshop_name = v\n          break\n  if workshop_name is None:\n      return []\n\n  try:\n      workshop_idx = idx[workshop_name]\n  except Exception:\n      return []\n\n  # Local mutable copies\n  pos = tuple(state.pos)\n  grid = state.grid.copy()\n  inventory = state.inventory.copy()\n  occupied = np.any(grid > 0, axis=2)\n\n  plan_actions = []\n\n  def move_and_use(target_coord, kind_idx):\n      \"\"\"Move next to *target_coord* (which contains *kind_idx*) and USE.\n      Updates local simulation state.\"\"\"\n      nonlocal pos, plan_actions, grid, occupied, inventory\n      path = bfs_to_adjacent(pos, target_coord, occupied)\n      if not path and pos != target_coord:\n          return False\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n      plan_actions.extend(path)\n      plan_actions.append(USE)\n      tx, ty = int(target_coord[0]), int(target_coord[1])\n      if grid[tx, ty, kind_idx] > 0:\n          grid[tx, ty, kind_idx] = 0\n          occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)\n          inventory[kind_idx] += 1\n      return True\n\n  # Collect required primitives\n  for prim_idx, needed_cnt in primitives_needed.items():\n      for _ in range(needed_cnt):\n          candidates = np.argwhere(grid[:, :, prim_idx] > 0)\n          if candidates.shape[0] == 0:\n              return plan_actions\n          dists = np.abs(candidates[:, 0] - pos[0]) + np.abs(candidates[:, 1] - pos[1])\n          target = candidates[dists.argmin()]\n          if not move_and_use(target, prim_idx):\n              return plan_actions\n\n  # Move to workshop and craft\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.shape[0] == 0:\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.shape[0] == 0:\n          return plan_actions\n  dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])\n  workshop_target = workshop_cells[dists.argmin()]\n  move_and_use(workshop_target, workshop_idx)\n\n  return plan_actions", "env_interactions": 23, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-27T19:19:13.621226", "function_name": "make_arrow", "function_body": "  # Action constants (as used by CraftWorld)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def _manhattan(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def _move_actions(src, dst):\n      \"\"\"Return a list of movement actions that walk from src to dst\n      using only vertical then horizontal moves.\"\"\"\n      actions = []\n      x, y = src\n      tx, ty = dst\n      if tx > x:\n          actions += [DOWN] * (tx - x)\n      elif tx < x:\n          actions += [UP] * (x - tx)\n      if ty > y:\n          actions += [RIGHT] * (ty - y)\n      elif ty < y:\n          actions += [LEFT] * (y - ty)\n      return actions\n\n  def _positions_of(kind_idx):\n      \"\"\"All coordinates (row, col) where the given kind is present.\"\"\"\n      grid = env._current_state.grid\n      rows, cols = np.where(grid[:, :, kind_idx] > 0)\n      return list(zip(rows.tolist(), cols.tolist()))\n\n  def _nearest(pos, kind_idx):\n      \"\"\"Find the nearest cell containing kind_idx; return None if absent.\"\"\"\n      candidates = _positions_of(kind_idx)\n      if not candidates:\n          return None\n      dists = [_manhattan(pos, c) for c in candidates]\n      return candidates[int(np.argmin(dists))]\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow) and its recipe\n  # ------------------------------------------------------------------\n  world = env.world\n  try:\n      arrow_idx = world.cookbook.index.index('arrow')\n  except Exception:  # arrow not defined \u2013 nothing to do\n      return []\n\n  # Primitive requirements for a single arrow (may be empty if arrow is primitive)\n  primitives_needed = world.cookbook.primitives_for(arrow_idx)\n\n  actions = []\n  cur_pos = env._current_state.pos\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, qty in primitives_needed.items():\n      for _ in range(qty):\n          target = _nearest(cur_pos, prim_idx)\n          if target is None:\n              # Required primitive not on the map \u2013 abort early\n              return actions\n          # Move to the primitive's cell (or its neighbour if the cell is blocked)\n          actions += _move_actions(cur_pos, target)\n          cur_pos = target\n          # Pick it up\n          actions.append(USE)\n\n  # ------------------------------------------------------------------\n  # 2. Go to the workshop (if the recipe specifies one) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      try:\n          workshop_idx = world.cookbook.index.index(workshop_name)\n          workshop_pos = _nearest(cur_pos, workshop_idx)\n          if workshop_pos is not None:\n              actions += _move_actions(cur_pos, workshop_pos)\n              cur_pos = workshop_pos\n              actions.append(USE)   # craft at the workshop\n      except Exception:\n          # workshop name not found in index \u2013 ignore\n          pass\n\n  return actions", "env_interactions": 22, "island_id": 0, "scores": {"3": 0.2}}
{"timestamp": "2025-10-27T19:19:14.747125", "function_name": "make_arrow", "function_body": "  # Action indices (environment uses the same ordering as CraftWorld)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def _manhattan_path(src, dst):\n      \"\"\"Return a list of actions that move from src to dst using Manhattan moves.\"\"\"\n      actions = []\n      x, y = src\n      tx, ty = dst\n      dx = tx - x\n      dy = ty - y\n      if dx > 0:\n          actions += [DOWN] * dx\n      elif dx < 0:\n          actions += [UP] * (-dx)\n      if dy > 0:\n          actions += [RIGHT] * dy\n      elif dy < 0:\n          actions += [LEFT] * (-dy)\n      return actions\n\n  def _nearest_entity(pos, kind_idx):\n      \"\"\"Find the nearest cell that contains the given kind (including the cell itself).\"\"\"\n      grid = env._current_state.grid\n      # locations where the kind is present (any positive count)\n      locs = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locs.size == 0:\n          return None\n      # compute Manhattan distances\n      dists = np.abs(locs[:, 0] - pos[0]) + np.abs(locs[:, 1] - pos[1])\n      best = np.argmin(dists)\n      return tuple(locs[best])\n\n  # ------------------------------------------------------------------\n  # Identify goal and recipe\n  # ------------------------------------------------------------------\n  world = env.world\n  idx_arrow = world.cookbook.index.index('arrow')\n  # Mapping primitive index -> required count for ONE arrow\n  primitives_needed = world.cookbook.primitives_for(idx_arrow)\n\n  # ------------------------------------------------------------------\n  # Collect required primitives\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = env._current_state.pos\n\n  for prim_idx, count in primitives_needed.items():\n      for _ in range(count):\n          target = _nearest_entity(cur_pos, prim_idx)\n          if target is None:\n              # Primitive not found in the world; abort early\n              return actions\n          actions += _manhattan_path(cur_pos, target)\n          cur_pos = target\n          actions.append(USE)   # pick up the primitive\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if recipe specifies one) and craft\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(idx_arrow, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = _nearest_entity(cur_pos, workshop_idx)\n      if workshop_pos is not None:\n          actions += _manhattan_path(cur_pos, workshop_pos)\n          cur_pos = workshop_pos\n          actions.append(USE)   # craft at the workshop\n\n  return actions", "env_interactions": 22, "island_id": 0, "scores": {"3": 0.2}}
