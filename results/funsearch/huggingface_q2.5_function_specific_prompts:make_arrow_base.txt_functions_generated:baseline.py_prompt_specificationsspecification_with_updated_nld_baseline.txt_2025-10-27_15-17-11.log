{"timestamp": "2025-10-27T17:38:42.038200", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.scenario.world\n  cookbook = world.cookbook\n  index = cookbook.index\n\n  # map actions to indices using the environment spec\n  action_map = env.action_specs()\n  DOWN = action_map[\"DOWN\"]\n  UP = action_map[\"UP\"]\n  LEFT = action_map[\"LEFT\"]\n  RIGHT = action_map[\"RIGHT\"]\n  USE = action_map[\"USE\"]\n  moves = [(DOWN, (1, 0)), (UP, (-1, 0)), (LEFT, (0, -1)), (RIGHT, (0, 1))]\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow) and its primitive requirements.\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  if goal_name not in index.contents:\n      return []                     # arrow not defined in this world\n\n  goal_idx = index[goal_name]\n  primitive_needs = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of move actions from start to target.\n  # Cells with any entity are treated as obstacles, except the target\n  # cell itself (which may contain the desired primitive or workshop).\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  def _bfs_path(start, target):\n      \"\"\"Return a list of move actions to reach `target` from `start`.\"\"\"\n      if start == target:\n          return []\n\n      h, w = state.grid.shape[:2]\n      queue = deque([start])\n      visited = {start}\n      parent = {}\n\n      while queue:\n          cur = queue.popleft()\n          if cur == target:\n              break\n          for act, (dr, dc) in moves:\n              nr, nc = cur[0] + dr, cur[1] + dc\n              if not (0 <= nr < h and 0 <= nc < w):\n                  continue\n              nxt = (nr, nc)\n              # Allow stepping onto the target even if occupied.\n              if nxt != target and state.grid[nr, nc, :].sum() != 0:\n                  continue\n              if nxt in visited:\n                  continue\n              visited.add(nxt)\n              parent[nxt] = (cur, act)\n              queue.append(nxt)\n\n      if target not in parent and start != target:\n          # No path found \u2013 return empty list.\n          return []\n\n      # Reconstruct path.\n      path = []\n      cur = target\n      while cur != start:\n          prev, act = parent[cur]\n          path.append(act)\n          cur = prev\n      path.reverse()\n      return path\n\n  # ------------------------------------------------------------------\n  # 1. Collect each required primitive (respecting multiplicities).\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          # Find any cell that currently holds this primitive.\n          cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if cells.size == 0:\n              # Primitive not available \u2013 abort early.\n              return actions\n          tr, tc = cells[0]\n\n          # Move to the primitive cell.\n          move_seq = _bfs_path(state.pos, (tr, tc))\n          actions.extend(move_seq)\n          state.pos = (tr, tc)\n\n          # Pick it up.\n          actions.append(USE)\n\n          # Update our internal copy of the state.\n          state.inventory[prim_idx] += 1\n          state.grid[tr, tc, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 2. Go to the workshop for the arrow and craft it.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      return actions\n\n  workshop_idx = index[workshop_name]\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      return actions\n\n  wr, wc = workshop_cells[0]\n\n  # Move to the workshop cell.\n  move_seq = _bfs_path(state.pos, (wr, wc))\n  actions.extend(move_seq)\n  state.pos = (wr, wc)\n\n  # Craft the arrow.\n  actions.append(USE)\n\n  return actions", "env_interactions": 28, "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T17:38:43.163239", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.scenario.world\n  cookbook = world.cookbook\n  index = cookbook.index\n\n  # action indices from environment spec\n  action_map = env.action_specs()\n  DOWN = action_map[\"DOWN\"]\n  UP = action_map[\"UP\"]\n  LEFT = action_map[\"LEFT\"]\n  RIGHT = action_map[\"RIGHT\"]\n  USE = action_map[\"USE\"]\n\n  goal_name = \"arrow\"\n  if goal_name not in index.contents:\n      return []\n\n  goal_idx = index[goal_name]\n  primitive_needs = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n  actions = []\n\n  from collections import deque\n\n  def _bfs_path(start, target):\n      \"\"\"Return a list of move actions to reach `target` from `start`.\"\"\"\n      if start == target:\n          return []\n\n      h, w = state.grid.shape[:2]\n      moves = [\n          (DOWN, (1, 0)),\n          (UP, (-1, 0)),\n          (LEFT, (0, -1)),\n          (RIGHT, (0, 1)),\n      ]\n\n      queue = deque([start])\n      visited = {start}\n      parent = {}\n\n      while queue:\n          cur = queue.popleft()\n          if cur == target:\n              break\n          for act, (dr, dc) in moves:\n              nr, nc = cur[0] + dr, cur[1] + dc\n              if not (0 <= nr < h and 0 <= nc < w):\n                  continue\n              nxt = (nr, nc)\n              # allow stepping onto the target even if occupied\n              if nxt != target and state.grid[nr, nc].any():\n                  continue\n              if nxt in visited:\n                  continue\n              visited.add(nxt)\n              parent[nxt] = (cur, act)\n              queue.append(nxt)\n\n      if target not in parent and start != target:\n          return []  # no path found\n\n      # reconstruct path\n      path = []\n      cur = target\n      while cur != start:\n          prev, act = parent[cur]\n          path.append(act)\n          cur = prev\n      path.reverse()\n      return path\n\n  # --------------------------------------------------------------\n  # 1. Collect required primitives (respecting multiplicities)\n  # --------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if cells.size == 0:\n              return actions  # primitive unavailable\n          tr, tc = cells[0]\n\n          move_seq = _bfs_path(state.pos, (tr, tc))\n          actions.extend(move_seq)\n          state.pos = (tr, tc)\n\n          actions.append(USE)\n          state.inventory[prim_idx] += 1\n          state.grid[tr, tc, prim_idx] = 0\n\n  # --------------------------------------------------------------\n  # 2. Go to the workshop and craft the arrow\n  # --------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      return actions\n\n  workshop_idx = index[workshop_name]\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      return actions\n\n  wr, wc = workshop_cells[0]\n  move_seq = _bfs_path(state.pos, (wr, wc))\n  actions.extend(move_seq)\n  state.pos = (wr, wc)\n\n  actions.append(USE)\n  return actions", "env_interactions": 28, "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-10-27T17:39:13.499411", "function_name": "make_arrow", "function_body": "  # action constants\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  world = env.world\n  # index of the target item\n  arrow_idx = world.cookbook.index.index('arrow')\n  # primitive requirements for a single arrow\n  needed = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n\n  # work on a mutable copy of the grid to \u201cconsume\u201d primitives as we pick them up\n  grid = env._current_state.grid.copy()\n  cur_pos = tuple(env._current_state.pos)   # (row, col)\n\n  # ----------------------------------------------------------------------\n  # Helper utilities\n  # ----------------------------------------------------------------------\n  def _is_walkable(pos):\n      \"\"\"A cell is walkable if it does not contain any non\u2011grabbable entity.\"\"\"\n      x, y = pos\n      cell = grid[x, y, :]\n      for idx in world.non_grabbable_indices:\n          if cell[idx] > 0:\n              return False\n      return True\n\n  def _bfs_path(start, goal):\n      \"\"\"Return a list of positions from start to goal using BFS (4\u2011connected).\"\"\"\n      if start == goal:\n          return [start]\n      width, height = grid.shape[:2]\n      frontier = collections.deque([start])\n      came_from = {start: None}\n      while frontier:\n          cur = frontier.popleft()\n          if cur == goal:\n              break\n          x, y = cur\n          for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height:\n                  nxt = (nx, ny)\n                  if nxt not in came_from and _is_walkable(nxt):\n                      came_from[nxt] = cur\n                      frontier.append(nxt)\n      else:\n          return None   # no path found\n\n      # reconstruct path\n      path = [goal]\n      while path[-1] != start:\n          path.append(came_from[path[-1]])\n      path.reverse()\n      return path\n\n  def _actions_from_path(path):\n      \"\"\"Convert a list of positions (including start) to action indices.\"\"\"\n      if not path or len(path) < 2:\n          return []\n      acts = []\n      for (x0, y0), (x1, y1) in zip(path, path[1:]):\n          if x1 == x0 + 1:\n              acts.append(DOWN)\n          elif x1 == x0 - 1:\n              acts.append(UP)\n          elif y1 == y0 + 1:\n              acts.append(RIGHT)\n          elif y1 == y0 - 1:\n              acts.append(LEFT)\n          else:\n              raise ValueError(\"Non\u2011adjacent steps in path\")\n      return acts\n\n  def _move_actions(src, dst):\n      \"\"\"Return actions to move from src to dst, preferring BFS shortest path.\"\"\"\n      path = _bfs_path(src, dst)\n      if path is None:\n          # fallback to simple Manhattan moves (may collide with obstacles)\n          acts = []\n          sx, sy = src\n          dx, dy = dst\n          if dx > sx:\n              acts += [DOWN] * (dx - sx)\n          elif dx < sx:\n              acts += [UP] * (sx - dx)\n          if dy > sy:\n              acts += [RIGHT] * (dy - sy)\n          elif dy < sy:\n              acts += [LEFT] * (sy - dy)\n          return acts\n      return _actions_from_path(path)\n\n  def _nearest_kind(pos, kind_idx):\n      \"\"\"Find the nearest cell (Manhattan distance) that currently contains kind_idx.\"\"\"\n      cells = np.argwhere(grid[:, :, kind_idx] > 0)\n      if cells.size == 0:\n          return None\n      dists = np.abs(cells[:, 0] - pos[0]) + np.abs(cells[:, 1] - pos[1])\n      nearest = cells[dists.argmin()]\n      return tuple(nearest.tolist())\n\n  # ----------------------------------------------------------------------\n  # 1) Collect all required primitives\n  # ----------------------------------------------------------------------\n  actions = []\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = _nearest_kind(cur_pos, prim_idx)\n          if target is None:\n              # primitive not present \u2013 abort planning\n              return actions\n          actions += _move_actions(cur_pos, target)\n          cur_pos = target\n          actions.append(USE)               # pick up the primitive\n          grid[target[0], target[1], prim_idx] = 0   # consume it locally\n\n  # ----------------------------------------------------------------------\n  # 2) Move to the appropriate workshop (if any) and craft the arrow\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = _nearest_kind(cur_pos, workshop_idx)\n      if workshop_pos is not None:\n          actions += _move_actions(cur_pos, workshop_pos)\n          cur_pos = workshop_pos\n          actions.append(USE)   # craft at the workshop\n\n  return actions", "env_interactions": 22, "island_id": 5, "scores": {"3": 0.2}}
{"timestamp": "2025-10-27T17:39:14.630354", "function_name": "make_arrow", "function_body": "  # Action indices (consistent with CraftWorld)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  # 4\u2011connected moves and their corresponding actions\n  MOVES = [(1, 0, DOWN), (-1, 0, UP), (0, 1, RIGHT), (0, -1, LEFT)]\n\n  world = env.world\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def _walkable(pos, goal, grid):\n      \"\"\"Return True if `pos` can be stepped on.\n      All cells are walkable except those that contain any entity,\n      but the goal cell is always considered walkable (we may need to\n      step onto a primitive or workshop located there).\"\"\"\n      if pos == goal:\n          return True\n      x, y = pos\n      return not grid[x, y, :].any()\n\n  def _bfs_path(start, goal, grid):\n      \"\"\"Breadth\u2011first search returning a list of positions from start\n      to goal (inclusive). Returns None if no path exists.\"\"\"\n      if start == goal:\n          return [start]\n      width, height = grid.shape[:2]\n      frontier = collections.deque([start])\n      came_from = {start: None}\n      while frontier:\n          cur = frontier.popleft()\n          if cur == goal:\n              break\n          cx, cy = cur\n          for dx, dy, _ in MOVES:\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < width and 0 <= ny < height:\n                  nxt = (nx, ny)\n                  if nxt not in came_from and _walkable(nxt, goal, grid):\n                      came_from[nxt] = cur\n                      frontier.append(nxt)\n      else:\n          return None  # no path found\n\n      # reconstruct path\n      path = [goal]\n      while path[-1] != start:\n          path.append(came_from[path[-1]])\n      path.reverse()\n      return path\n\n  def _actions_from_path(path):\n      \"\"\"Convert a position path to a list of action indices.\"\"\"\n      if not path or len(path) < 2:\n          return []\n      acts = []\n      for (x0, y0), (x1, y1) in zip(path, path[1:]):\n          for dx, dy, a in MOVES:\n              if x0 + dx == x1 and y0 + dy == y1:\n                  acts.append(a)\n                  break\n      return acts\n\n  def _move_actions(src, dst, grid):\n      \"\"\"Return actions to move from src to dst using BFS; fall back to\n      Manhattan moves if BFS fails.\"\"\"\n      path = _bfs_path(src, dst, grid)\n      if path is None:\n          # fallback: simple Manhattan (may hit obstacles)\n          acts = []\n          sx, sy = src\n          dx, dy = dst\n          if dx > sx:\n              acts += [DOWN] * (dx - sx)\n          elif dx < sx:\n              acts += [UP] * (sx - dx)\n          if dy > sy:\n              acts += [RIGHT] * (dy - sy)\n          elif dy < sy:\n              acts += [LEFT] * (sy - dy)\n          return acts\n      return _actions_from_path(path)\n\n  def _nearest_kind(pos, kind_idx, grid):\n      \"\"\"Find the nearest cell (Manhattan distance) that currently\n      contains an entity of `kind_idx`. Returns None if not present.\"\"\"\n      cells = np.argwhere(grid[:, :, kind_idx] > 0)\n      if cells.size == 0:\n          return None\n      dists = np.abs(cells[:, 0] - pos[0]) + np.abs(cells[:, 1] - pos[1])\n      nearest = cells[dists.argmin()]\n      return tuple(nearest.tolist())\n\n  # ------------------------------------------------------------------\n  # 1. Determine primitives needed for an arrow\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  primitives_needed = world.cookbook.primitives_for(arrow_idx)  # {prim_idx: count}\n\n  # Work on a mutable copy of the grid so we can \u201cconsume\u201d items as we plan\n  planning_grid = env._current_state.grid.copy()\n  cur_pos = tuple(env._current_state.pos)\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # 2. Collect all required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in primitives_needed.items():\n      for _ in range(cnt):\n          target = _nearest_kind(cur_pos, prim_idx, planning_grid)\n          if target is None:\n              # Primitive missing \u2013 abort planning\n              return actions\n          actions += _move_actions(cur_pos, target, planning_grid)\n          cur_pos = target\n          actions.append(USE)  # pick up\n          # Remove the primitive from the planning grid\n          planning_grid[target[0], target[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 3. Move to the workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = _nearest_kind(cur_pos, workshop_idx, planning_grid)\n      if workshop_pos is not None:\n          actions += _move_actions(cur_pos, workshop_pos, planning_grid)\n          cur_pos = workshop_pos\n          actions.append(USE)   # craft at the workshop\n\n  return actions", "env_interactions": 24, "island_id": 5, "scores": {"3": 0.2}}
{"timestamp": "2025-10-27T17:39:41.177953", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  world = env.world\n  goal_idx = world.cookbook.index.index(\"arrow\")\n  prim_req = world.cookbook.primitives_for(goal_idx)\n\n  grid = env._current_state.grid.copy()\n  cur_pos = tuple(env._current_state.pos)\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def _cell_occupied(pos, ignore_kind=None):\n      \"\"\"Return True if a cell contains any entity other than ignore_kind.\"\"\"\n      x, y = pos\n      occ = grid[x, y, :].copy()\n      if ignore_kind is not None:\n          occ[ignore_kind] = 0\n      return occ.any()\n\n  def _bfs(start, goal, ignore_kind=None):\n      \"\"\"Bread\u2011first search returning a list of positions from start to goal.\"\"\"\n      if start == goal:\n          return [start]\n      w, h = grid.shape[:2]\n      frontier = collections.deque([start])\n      came_from = {start: None}\n      while frontier:\n          cur = frontier.popleft()\n          if cur == goal:\n              break\n          x, y = cur\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h:\n                  nxt = (nx, ny)\n                  if nxt not in came_from:\n                      if not _cell_occupied(nxt, ignore_kind) or nxt == goal:\n                          came_from[nxt] = cur\n                          frontier.append(nxt)\n      else:\n          return None  # no path found\n\n      # reconstruct path\n      path = [goal]\n      while path[-1] != start:\n          path.append(came_from[path[-1]])\n      path.reverse()\n      return path\n\n  def _path_to_actions(path):\n      \"\"\"Translate a list of positions into a list of action indices.\"\"\"\n      if not path or len(path) < 2:\n          return []\n      acts = []\n      for (x0, y0), (x1, y1) in zip(path, path[1:]):\n          if x1 == x0 + 1:\n              acts.append(DOWN)\n          elif x1 == x0 - 1:\n              acts.append(UP)\n          elif y1 == y0 + 1:\n              acts.append(RIGHT)\n          elif y1 == y0 - 1:\n              acts.append(LEFT)\n          else:\n              raise ValueError(\"Non\u2011adjacent steps in path\")\n      return acts\n\n  def _move(src, dst, ignore_kind=None):\n      \"\"\"Return actions moving from src to dst, falling back to Manhattan.\"\"\"\n      p = _bfs(src, dst, ignore_kind=ignore_kind)\n      if p is None:\n          # simple Manhattan fallback (may hit obstacles)\n          acts = []\n          sx, sy = src\n          dx, dy = dst\n          if dx > sx:\n              acts += [DOWN] * (dx - sx)\n          elif dx < sx:\n              acts += [UP] * (sx - dx)\n          if dy > sy:\n              acts += [RIGHT] * (dy - sy)\n          elif dy < sy:\n              acts += [LEFT] * (sy - dy)\n          return acts\n      return _path_to_actions(p)\n\n  def _nearest_reachable(pos, kind_idx, banned):\n      \"\"\"Find nearest reachable cell containing kind_idx not in banned.\"\"\"\n      candidates = np.argwhere(grid[:, :, kind_idx] > 0)\n      if candidates.size == 0:\n          return None\n      if banned:\n          mask = np.array([tuple(c) not in banned for c in candidates])\n          candidates = candidates[mask]\n          if candidates.size == 0:\n              return None\n      dists = np.abs(candidates[:, 0] - pos[0]) + np.abs(candidates[:, 1] - pos[1])\n      order = np.argsort(dists)\n      for idx in order:\n          cand = tuple(candidates[idx].tolist())\n          if _bfs(pos, cand, ignore_kind=kind_idx) is not None:\n              return cand\n      return None\n\n  # ------------------------------------------------------------------\n  # Collect required primitives\n  # ------------------------------------------------------------------\n  actions = []\n  harvested = {k: set() for k in prim_req.keys()}\n\n  for kind_idx, needed in prim_req.items():\n      for _ in range(needed):\n          target = _nearest_reachable(cur_pos, kind_idx, harvested[kind_idx])\n          if target is None:\n              # primitive missing/unreachable \u2013 stop planning\n              return actions\n          actions += _move(cur_pos, target, ignore_kind=kind_idx)\n          cur_pos = target\n          actions.append(USE)          # pick up primitive\n          harvested[kind_idx].add(target)\n          grid[target[0], target[1], kind_idx] = 0  # simulate pickup\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_target = _nearest_reachable(cur_pos, workshop_idx, set())\n      if ws_target is not None:\n          actions += _move(cur_pos, ws_target)\n          cur_pos = ws_target\n          actions.append(USE)          # craft at workshop\n\n  return actions", "env_interactions": 26, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T17:39:42.464118", "function_name": "make_arrow", "function_body": "  # Action indices (assumed standard mapping)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  world = env.world\n  goal_name = \"arrow\"\n  goal_idx = world.cookbook.index.index(goal_name)\n\n  # Primitive requirements for a single arrow: {prim_idx: count}\n  prim_req = world.cookbook.primitives_for(goal_idx)\n\n  # Local mutable copies of grid and agent position\n  grid = env._current_state.grid.copy()\n  cur_pos = tuple(env._current_state.pos)\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  import collections\n  import numpy as np\n\n  def _is_occupied(pos, g):\n      \"\"\"Return True if any entity occupies the cell at pos.\"\"\"\n      x, y = pos\n      return g[x, y, :].any()\n\n  def _bfs_path(start, goal, g):\n      \"\"\"Shortest path on grid `g` from start to goal (allow stepping onto goal).\"\"\"\n      if start == goal:\n          return [start]\n      w, h = g.shape[:2]\n      frontier = collections.deque([start])\n      came_from = {start: None}\n      while frontier:\n          cur = frontier.popleft()\n          if cur == goal:\n              break\n          x, y = cur\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h:\n                  nxt = (nx, ny)\n                  if nxt not in came_from:\n                      if not _is_occupied(nxt, g) or nxt == goal:\n                          came_from[nxt] = cur\n                          frontier.append(nxt)\n      else:\n          return None  # no path found\n\n      # reconstruct path\n      path = [goal]\n      while path[-1] != start:\n          path.append(came_from[path[-1]])\n      path.reverse()\n      return path\n\n  def _actions_from_path(path):\n      \"\"\"Translate a list of positions into action indices.\"\"\"\n      if not path or len(path) < 2:\n          return []\n      acts = []\n      for (x0, y0), (x1, y1) in zip(path, path[1:]):\n          if x1 == x0 + 1:\n              acts.append(DOWN)\n          elif x1 == x0 - 1:\n              acts.append(UP)\n          elif y1 == y0 + 1:\n              acts.append(RIGHT)\n          elif y1 == y0 - 1:\n              acts.append(LEFT)\n          else:\n              raise ValueError(\"Non\u2011adjacent steps in path\")\n      return acts\n\n  def _move_actions(src, dst, g):\n      \"\"\"Return actions to move from src to dst (BFS preferred, Manhattan fallback).\"\"\"\n      path = _bfs_path(src, dst, g)\n      if path is None:\n          # fallback: straight Manhattan moves (may collide with obstacles)\n          acts = []\n          sx, sy = src\n          dx, dy = dst\n          if dx > sx:\n              acts += [DOWN] * (dx - sx)\n          elif dx < sx:\n              acts += [UP] * (sx - dx)\n          if dy > sy:\n              acts += [RIGHT] * (dy - sy)\n          elif dy < sy:\n              acts += [LEFT] * (sy - dy)\n          return acts\n      return _actions_from_path(path)\n\n  def _nearest_kind(pos, kind_idx, g, excluded):\n      \"\"\"Find the nearest cell containing `kind_idx` not in `excluded`.\"\"\"\n      locations = np.argwhere(g[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      if excluded:\n          mask = np.array([tuple(coord) not in excluded for coord in locations])\n          locations = locations[mask]\n          if locations.size == 0:\n              return None\n      # Manhattan distance heuristic\n      dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n      nearest = locations[dists.argmin()]\n      return tuple(nearest.tolist())\n\n  # ------------------------------------------------------------------\n  # Planning: collect all required primitives\n  # ------------------------------------------------------------------\n  actions = []\n  harvested = {k: set() for k in prim_req.keys()}\n\n  for kind_idx, needed in prim_req.items():\n      for _ in range(needed):\n          target = _nearest_kind(cur_pos, kind_idx, grid, harvested[kind_idx])\n          if target is None:\n              # Primitive missing/unreachable \u2013 abort planning\n              return actions\n          actions += _move_actions(cur_pos, target, grid)\n          cur_pos = target\n          actions.append(USE)                     # pick up primitive\n          # Update local grid copy to reflect that the primitive is taken\n          grid[target[0], target[1], kind_idx] = 0\n          harvested[kind_idx].add(target)\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if recipe specifies one) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_target = _nearest_kind(cur_pos, workshop_idx, grid, set())\n      if ws_target is not None:\n          actions += _move_actions(cur_pos, ws_target, grid)\n          cur_pos = ws_target\n          actions.append(USE)                     # craft at workshop\n\n  return actions", "env_interactions": 24, "island_id": 5, "scores": {"3": 0.2}}
{"timestamp": "2025-10-27T17:40:02.703937", "function_name": "make_arrow", "function_body": "  # Reset the environment to a fresh state (ignore any errors if already reset)\n  try:\n      env.reset()\n  except Exception:\n      pass\n\n  # ----------------------------------------------------------------------\n  # Identify the goal index (the item we need to craft, e.g., \"arrow\").\n  # ----------------------------------------------------------------------\n  goal_idx = None\n  if hasattr(env, \"task\"):\n      task = getattr(env, \"task\")\n      if hasattr(task, \"goal\"):\n          goal_idx = task.goal\n      elif isinstance(task, (list, tuple)):\n          goal_idx = task[0]\n\n  if goal_idx is None:\n      # No goal information \u2013 nothing to do.\n      return []\n\n  # Action indices as defined by CraftLab.action_specs\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ----------------------------------------------------------------------\n  # Determine which primitive resources are required to craft the goal.\n  # ----------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)\n\n  # Current mutable position of the agent.\n  cur_pos = list(env._current_state.pos)          # [x, y]\n\n  # Work on a copy of the grid for planning purposes (so we can \"remove\"\n  # primitives once we plan to pick them up).\n  grid = env._current_state.grid.copy()           # shape (W, H, n_kinds)\n\n  # ----------------------------------------------------------------------\n  # Helper: generate a Manhattan move sequence from cur_pos to target.\n  # ----------------------------------------------------------------------\n  def move_to(target):\n      nonlocal cur_pos\n      seq = []\n      tx, ty = target\n      # Move in x direction first.\n      while cur_pos[0] < tx:\n          seq.append(RIGHT)\n          cur_pos[0] += 1\n      while cur_pos[0] > tx:\n          seq.append(LEFT)\n          cur_pos[0] -= 1\n      # Then move in y direction.\n      while cur_pos[1] < ty:\n          seq.append(DOWN)\n          cur_pos[1] += 1\n      while cur_pos[1] > ty:\n          seq.append(UP)\n          cur_pos[1] -= 1\n      return seq\n\n  plan = []\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive the needed number of times.\n  # ----------------------------------------------------------------------\n  for kind_idx, needed_cnt in primitives_needed.items():\n      remaining = needed_cnt\n      while remaining > 0:\n          # Find all cells that still contain this primitive.\n          positions = np.argwhere(grid[:, :, kind_idx] > 0)\n          if positions.size == 0:\n              # No more of this primitive left on the map \u2013 abort planning.\n              break\n\n          # Choose the nearest primitive (Manhattan distance) to reduce travel.\n          dists = np.abs(positions[:, 0] - cur_pos[0]) + np.abs(positions[:, 1] - cur_pos[1])\n          nearest_idx = int(dists.argmin())\n          target = tuple(positions[nearest_idx])\n\n          # Move to the primitive and pick it up.\n          plan.extend(move_to(target))\n          plan.append(USE)\n\n          # Simulate the pickup by clearing the primitive from the planning grid.\n          grid[target[0], target[1], kind_idx] = 0\n          remaining -= 1\n\n  # ----------------------------------------------------------------------\n  # After gathering all primitives, go to the appropriate workshop (if any)\n  # and perform the crafting action.\n  # ----------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      ws_positions = np.argwhere(grid[:, :, workshop_kind] > 0)\n      if ws_positions.shape[0] > 0:\n          # Choose the nearest workshop.\n          dists = np.abs(ws_positions[:, 0] - cur_pos[0]) + np.abs(ws_positions[:, 1] - cur_pos[1])\n          nearest_ws = int(dists.argmin())\n          ws_target = tuple(ws_positions[nearest_ws])\n          plan.extend(move_to(ws_target))\n          plan.append(USE)   # Use at the workshop to craft the goal item.\n\n  return plan", "env_interactions": 0, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-27T17:40:03.828384", "function_name": "make_arrow", "function_body": "  # Reset the environment to a fresh state if possible.\n  try:\n      env.reset()\n  except Exception:\n      pass\n\n  # ----------------------------------------------------------------------\n  # Identify the goal index (the item we need to craft, e.g., \"arrow\").\n  # ----------------------------------------------------------------------\n  goal_idx = None\n  if hasattr(env, \"task\"):\n      task = getattr(env, \"task\")\n      if hasattr(task, \"goal\"):\n          goal_idx = task.goal\n      elif isinstance(task, (list, tuple)) and len(task) > 0:\n          goal_idx = task[0]\n\n  if goal_idx is None:\n      return []  # Cannot determine what to craft.\n\n  # Action indices as defined by CraftLab.action_specs.\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ----------------------------------------------------------------------\n  # Determine which primitive resources are required for the goal.\n  # ----------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)\n\n  # Current agent position (mutable copy for planning).\n  cur_pos = list(env._current_state.pos)          # [x, y]\n\n  # Working copy of the grid \u2013 we will \"remove\" primitives as we plan to pick them.\n  grid = env._current_state.grid.copy()           # shape (W, H, n_kinds)\n\n  # ----------------------------------------------------------------------\n  # Helper: generate a sequence of actions that moves the agent from its\n  # current position (cur_pos) to a target cell using simple Manhattan moves.\n  # ----------------------------------------------------------------------\n  def move_to(target):\n      nonlocal cur_pos\n      actions = []\n      tx, ty = target\n      # Move in the x\u2011direction.\n      while cur_pos[0] < tx:\n          actions.append(RIGHT)\n          cur_pos[0] += 1\n      while cur_pos[0] > tx:\n          actions.append(LEFT)\n          cur_pos[0] -= 1\n      # Move in the y\u2011direction.\n      while cur_pos[1] < ty:\n          actions.append(DOWN)\n          cur_pos[1] += 1\n      while cur_pos[1] > ty:\n          actions.append(UP)\n          cur_pos[1] -= 1\n      return actions\n\n  plan = []\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive the necessary number of times.\n  # ----------------------------------------------------------------------\n  for kind_idx, needed_cnt in primitives_needed.items():\n      remaining = needed_cnt\n      while remaining > 0:\n          # Locate all cells that currently contain this primitive.\n          positions = np.argwhere(grid[:, :, kind_idx] > 0)\n          if positions.size == 0:\n              # No more of this primitive available \u2013 abort planning.\n              break\n\n          # Choose the nearest primitive (Manhattan distance).\n          dists = np.abs(positions[:, 0] - cur_pos[0]) + np.abs(positions[:, 1] - cur_pos[1])\n          nearest_idx = int(dists.argmin())\n          target = tuple(positions[nearest_idx])\n\n          # Move to the primitive and pick it up.\n          plan.extend(move_to(target))\n          plan.append(USE)\n\n          # Simulate the pickup by clearing the primitive from the planning grid.\n          grid[target[0], target[1], kind_idx] = 0\n          remaining -= 1\n\n  # ----------------------------------------------------------------------\n  # After gathering all primitives, go to the appropriate workshop (if any)\n  # and perform the crafting action.\n  # ----------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      # Find workshop locations (they are static, so we can look at the original grid).\n      ws_positions = np.argwhere(env._current_state.grid[:, :, workshop_kind] > 0)\n      if ws_positions.shape[0] > 0:\n          # Choose the nearest workshop.\n          dists = np.abs(ws_positions[:, 0] - cur_pos[0]) + np.abs(ws_positions[:, 1] - cur_pos[1])\n          nearest_ws = int(dists.argmin())\n          ws_target = tuple(ws_positions[nearest_ws])\n          plan.extend(move_to(ws_target))\n          plan.append(USE)   # Use at the workshop to craft the arrow.\n\n  return plan", "env_interactions": 0, "island_id": 9, "scores": {"3": 0.0}}
