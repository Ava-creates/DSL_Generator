{"timestamp": "2025-10-21T21:42:19.991315", "function_name": "make_stick", "function_body": "  # Obtain the list of possible action IDs\n  try:\n      action_map = env.action_specs()\n      action_ids = list(action_map.values())\n  except Exception:\n      # fallback to the default ordering (DOWN, UP, LEFT, RIGHT, USE)\n      action_ids = [0, 1, 2, 3, 4]\n\n  # Resolve the index of the target item \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      # try alternative attribute chains if the structure differs\n      stick_idx = getattr(env, \"world\", None)\n      if stick_idx is not None:\n          stick_idx = getattr(stick_idx, \"cookbook\", None)\n          if stick_idx is not None:\n              stick_idx = stick_idx.index.get(\"stick\")\n  if stick_idx is None:\n      return []  # cannot locate the stick index\n\n  # Helper to test whether a state satisfies the goal\n  def is_goal(state):\n      return state.satisfies(\"\", stick_idx)\n\n  # Get the current underlying state from the environment\n  try:\n      start_state = env._current_state\n  except AttributeError:\n      start_state = getattr(env, \"current_state\", None)\n      if start_state is None:\n          return []  # cannot access the underlying state\n\n  from collections import deque\n\n  # Encode a state for the visited\u2011set\n  def state_key(st):\n      return (st.pos, st.dir, st.inventory.tobytes())\n\n  visited = {state_key(start_state)}\n  frontier = deque()\n  frontier.append((start_state, []))\n  max_plan_len = 200  # safety ceiling on plan length\n\n  # Bread\u2011first search over the state space\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      if is_goal(cur_state):\n          return cur_plan\n\n      if len(cur_plan) >= max_plan_len:\n          continue\n\n      for a in action_ids:\n          _, nxt_state = cur_state.step(a)\n          key = state_key(nxt_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((nxt_state, cur_plan + [a]))\n\n  # No plan found within the limits\n  return []", "env_interactions": 4, "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T21:42:51.717109", "function_name": "make_stick", "function_body": "  env.reset()\n  world = env.world\n  idx = world.cookbook.index\n\n  # Map action names to indices\n  act_map = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act_map[\"DOWN\"],\n      act_map[\"UP\"],\n      act_map[\"LEFT\"],\n      act_map[\"RIGHT\"],\n      act_map[\"USE\"],\n  )\n\n  # Identify the index for the goal item \u201cstick\u201d (case\u2011insensitive fallback)\n  try:\n      stick_idx = idx[\"stick\"]\n  except Exception:\n      stick_idx = next(i for i, n in enumerate(idx.ordered_contents) if n.lower() == \"stick\")\n\n  # Determine primitive requirements (if stick is primitive treat as needing itself)\n  needed = world.cookbook.primitives_for(stick_idx)\n  if not needed:\n      needed = {stick_idx: 1}\n\n  # Current simulated state (position and grid copy for bookkeeping)\n  state = env._current_state\n  cur_pos = tuple(state.pos)\n  grid = state.grid.copy()\n\n  # Pre\u2011compute blocked cells (any non\u2011zero kind that is non\u2011grabbable)\n  non_grab = list(world.non_grabbable_indices)\n  if non_grab:\n      blocked = np.any(grid[:, :, non_grab] > 0, axis=2)\n  else:\n      blocked = np.zeros(grid.shape[:2], dtype=bool)\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper: BFS returning a list of actions from start to any target cell,\n  # avoiding blocked cells. Falls back to Manhattan moves if no path.\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  def bfs_path(start, targets):\n      if start in targets:\n          return []\n      q = deque([start])\n      parent = {start: (None, None)}  # pos -> (prev_pos, action)\n      while q:\n          cur = q.popleft()\n          for act, (dx, dy) in (\n              (DOWN, (0, 1)),\n              (UP, (0, -1)),\n              (LEFT, (-1, 0)),\n              (RIGHT, (1, 0)),\n          ):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if not (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]):\n                  continue\n              if blocked[nx, ny]:\n                  continue\n              nxt = (nx, ny)\n              if nxt in parent:\n                  continue\n              parent[nxt] = (cur, act)\n              if nxt in targets:\n                  # reconstruct path\n                  path = []\n                  node = nxt\n                  while parent[node][0] is not None:\n                      node, a = parent[node]\n                      path.append(a)\n                  return list(reversed(path))\n              q.append(nxt)\n\n      # No walkable path \u2013 use simple Manhattan moves (ignores obstacles)\n      tx, ty = next(iter(targets))\n      x, y = start\n      path = []\n      while x < tx:\n          path.append(RIGHT); x += 1\n      while x > tx:\n          path.append(LEFT); x -= 1\n      while y < ty:\n          path.append(DOWN); y += 1\n      while y > ty:\n          path.append(UP); y -= 1\n      return path\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives (respecting quantity)\n  # ------------------------------------------------------------------\n  for kind, cnt in needed.items():\n      for _ in range(int(cnt)):\n          locations = np.argwhere(grid[:, :, kind] > 0)\n          if locations.size == 0:\n              break  # primitive not present on map\n          # Choose the nearest occurrence (Manhattan distance)\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          target = tuple(locations[dists.argmin()])\n\n          # Move to the target\n          actions.extend(bfs_path(cur_pos, {target}))\n          cur_pos = target\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update local grid copy and blocked mask\n          grid[target[0], target[1], kind] -= 1\n          if non_grab:\n              blocked[target[0], target[1]] = np.any(\n                  grid[target[0], target[1], non_grab] > 0\n              )\n\n  # ------------------------------------------------------------------\n  # 2. If a workshop is required, navigate to it and craft the stick\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      ws_idx = idx[workshop_name]\n      ws_locs = np.argwhere(grid[:, :, ws_idx] > 0)\n      if ws_locs.size:\n          ws_target = tuple(ws_locs[0])\n          actions.extend(bfs_path(cur_pos, {ws_target}))\n          cur_pos = ws_target\n          actions.append(USE)  # craft at the workshop\n\n  return actions", "env_interactions": 4, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:42:52.846036", "function_name": "make_stick", "function_body": "  env.reset()\n  world = env.world\n  idx = world.cookbook.index\n\n  # map actions\n  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act[\"DOWN\"],\n      act[\"UP\"],\n      act[\"LEFT\"],\n      act[\"RIGHT\"],\n      act[\"USE\"],\n  )\n\n  # index of target item \"stick\"\n  try:\n      stick_idx = idx[\"stick\"]\n  except Exception:\n      stick_idx = next(\n          i for i, n in enumerate(idx.ordered_contents) if n.lower() == \"stick\"\n      )\n\n  # primitive requirements\n  needed = world.cookbook.primitives_for(stick_idx)\n  if not needed:\n      needed = {stick_idx: 1}\n\n  # current simulated state\n  state = env._current_state\n  cur_pos = tuple(state.pos)\n  grid = state.grid.copy()\n\n  # blocked cells (non\u2011grabbable entities)\n  non_grab = list(world.non_grabbable_indices)\n  if non_grab:\n      blocked = np.any(grid[:, :, non_grab] > 0, axis=2)\n  else:\n      blocked = np.zeros(grid.shape[:2], dtype=bool)\n\n  actions = []\n\n  from collections import deque\n\n  def bfs_path(start, targets):\n      \"\"\"Return list of actions to reach any cell in *targets*.\"\"\"\n      if start in targets:\n          return []\n      q = deque([start])\n      parent = {start: (None, None)}  # pos -> (prev_pos, action)\n      while q:\n          x, y = q.popleft()\n          for act_dir, (dx, dy) in (\n              (DOWN, (0, 1)),\n              (UP, (0, -1)),\n              (LEFT, (-1, 0)),\n              (RIGHT, (1, 0)),\n          ):\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]):\n                  continue\n              if blocked[nx, ny]:\n                  continue\n              nxt = (nx, ny)\n              if nxt in parent:\n                  continue\n              parent[nxt] = ((x, y), act_dir)\n              if nxt in targets:\n                  # reconstruct path\n                  path = []\n                  cur = nxt\n                  while parent[cur][0] is not None:\n                      cur, a = parent[cur]\n                      path.append(a)\n                  return list(reversed(path))\n              q.append(nxt)\n\n      # fallback: Manhattan moves ignoring obstacles\n      tx, ty = next(iter(targets))\n      x, y = start\n      path = []\n      while x < tx:\n          path.append(RIGHT)\n          x += 1\n      while x > tx:\n          path.append(LEFT)\n          x -= 1\n      while y < ty:\n          path.append(DOWN)\n          y += 1\n      while y > ty:\n          path.append(UP)\n          y -= 1\n      return path\n\n  # ------------------------------------------------------------------\n  # 1. Collect required primitives (or the stick itself if primitive)\n  # ------------------------------------------------------------------\n  for kind, cnt in needed.items():\n      for _ in range(int(cnt)):\n          locs = np.argwhere(grid[:, :, kind] > 0)\n          if locs.size == 0:\n              break  # item not present on map\n          dists = np.abs(locs[:, 0] - cur_pos[0]) + np.abs(locs[:, 1] - cur_pos[1])\n          target = tuple(locs[dists.argmin()])\n\n          actions.extend(bfs_path(cur_pos, {target}))\n          cur_pos = target\n\n          actions.append(USE)  # pick up\n\n          grid[target[0], target[1], kind] -= 1\n          if non_grab:\n              blocked[target[0], target[1]] = np.any(\n                  grid[target[0], target[1], non_grab] > 0\n              )\n\n  # ------------------------------------------------------------------\n  # 2. Go to workshop (if required) and craft the stick\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      ws_idx = idx[workshop_name]\n      ws_locs = np.argwhere(grid[:, :, ws_idx] > 0)\n      if ws_locs.size:\n          ws_target = tuple(ws_locs[0])\n          actions.extend(bfs_path(cur_pos, {ws_target}))\n          cur_pos = ws_target\n          actions.append(USE)  # craft at workshop\n\n  return actions", "env_interactions": 4, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:43:22.015396", "function_name": "make_stick", "function_body": "  # reset environment and get references\n  env.reset()\n  world = env.world\n  scenario = env.scenario\n\n  # action indices (as defined in CraftLab.action_specs())\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  # index of the target item \u201cstick\u201d\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # primitive requirements for a stick (empty dict means stick itself is primitive)\n  primitives_needed = world.cookbook.primitives_for(stick_idx)\n  if not primitives_needed:\n      primitives_needed = {stick_idx: 1}\n\n  # work on a local copy of the grid so we can update it as we collect items\n  grid = scenario.init_grid.copy()\n  pos = scenario.init_pos          # (x, y) current agent position\n  actions = []                     # list of actions to return\n\n  from collections import deque\n\n  def bfs(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) from start to goal.\"\"\"\n      W, H = grid.shape[:2]\n      visited = set([start])\n      q = deque([(start, [])])\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for act, (dx, dy) in (\n              (ACTION_DOWN, (0, 1)),\n              (ACTION_UP, (0, -1)),\n              (ACTION_LEFT, (-1, 0)),\n              (ACTION_RIGHT, (1, 0)),\n          ):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in visited:\n                  # a cell is walkable if it contains no entities\n                  if np.any(grid[nx, ny, :] != 0):\n                      continue\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [act]))\n      return []  # unreachable (should not happen in valid scenarios)\n\n  def direction_action(src, dst):\n      \"\"\"Return the movement action that points from src towards dst.\"\"\"\n      dx, dy = dst[0] - src[0], dst[1] - src[1]\n      if dx == -1 and dy == 0:\n          return ACTION_LEFT\n      if dx == 1 and dy == 0:\n          return ACTION_RIGHT\n      if dx == 0 and dy == -1:\n          return ACTION_UP\n      if dx == 0 and dy == 1:\n          return ACTION_DOWN\n      return None\n\n  # -----------------------------------------------------------------\n  # 1. Collect all required primitive items\n  # -----------------------------------------------------------------\n  for prim_idx, cnt in primitives_needed.items():\n      for _ in range(cnt):\n          # locate a remaining instance of the primitive\n          locations = np.argwhere(grid[:, :, prim_idx] > 0)\n          if not len(locations):\n              continue\n          target = tuple(locations[0])\n\n          # find a free adjacent cell to the primitive\n          adj_candidates = []\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              ax, ay = target[0] + dx, target[1] + dy\n              if 0 <= ax < grid.shape[0] and 0 <= ay < grid.shape[1]:\n                  if not np.any(grid[ax, ay, :] != 0):\n                      adj_candidates.append((ax, ay))\n\n          # choose the first reachable adjacent cell\n          chosen_adj = None\n          path_to_adj = None\n          for adj in adj_candidates:\n              path = bfs(pos, adj)\n              if path:\n                  chosen_adj = adj\n                  path_to_adj = path\n                  break\n          if chosen_adj is None:\n              continue  # cannot reach this primitive (should not happen)\n\n          # move to the adjacent cell\n          actions.extend(path_to_adj)\n          pos = chosen_adj\n\n          # set direction towards the primitive (may attempt to move into blocked cell)\n          dir_act = direction_action(pos, target)\n          if dir_act is not None:\n              actions.append(dir_act)\n\n          # pick up the primitive\n          actions.append(ACTION_USE)\n\n          # update local grid copy\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # -----------------------------------------------------------------\n  # 2. Craft the stick at its workshop (if required)\n  # -----------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if len(workshop_cells):\n          ws = tuple(workshop_cells[0])\n\n          # find a free adjacent cell to the workshop\n          adj_candidates = []\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              ax, ay = ws[0] + dx, ws[1] + dy\n              if 0 <= ax < grid.shape[0] and 0 <= ay < grid.shape[1]:\n                  if not np.any(grid[ax, ay, :] != 0):\n                      adj_candidates.append((ax, ay))\n\n          chosen_adj = None\n          path_to_adj = None\n          for adj in adj_candidates:\n              path = bfs(pos, adj)\n              if path:\n                  chosen_adj = adj\n                  path_to_adj = path\n                  break\n\n          if chosen_adj is not None:\n              actions.extend(path_to_adj)\n              pos = chosen_adj\n\n              dir_act = direction_action(pos, ws)\n              if dir_act is not None:\n                  actions.append(dir_act)\n\n              actions.append(ACTION_USE)\n\n  # return the compiled action list\n  return actions", "env_interactions": 7, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:43:23.143889", "function_name": "make_stick", "function_body": "  env.reset()\n  world = env.world\n  scenario = env.scenario\n\n  # Action indices (as defined in CraftLab.action_specs)\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  # Target item index\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # Required primitive ingredients (empty dict means stick itself is primitive)\n  primitives_needed = world.cookbook.primitives_for(stick_idx)\n  if not primitives_needed:\n      primitives_needed = {stick_idx: 1}\n\n  # Local copies of grid and agent position for planning\n  grid = scenario.init_grid.copy()\n  pos = scenario.init_pos  # (x, y)\n  actions = []\n\n  from collections import deque\n\n  def bfs(start, goal):\n      \"\"\"Return a list of movement actions from start to goal (walkable cells only).\"\"\"\n      W, H = grid.shape[:2]\n      visited = set([start])\n      q = deque([(start, [])])\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for act, (dx, dy) in (\n              (ACTION_DOWN, (0, 1)),\n              (ACTION_UP, (0, -1)),\n              (ACTION_LEFT, (-1, 0)),\n              (ACTION_RIGHT, (1, 0)),\n          ):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in visited:\n                  # walkable iff no entities occupy the cell\n                  if np.any(grid[nx, ny, :] != 0):\n                      continue\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [act]))\n      return []  # unreachable \u2013 should not happen in a valid scenario\n\n  def adjacent_reachable(target):\n      \"\"\"Find a walkable cell adjacent to target that is reachable from current pos.\"\"\"\n      tx, ty = target\n      candidates = []\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          ax, ay = tx + dx, ty + dy\n          if 0 <= ax < grid.shape[0] and 0 <= ay < grid.shape[1]:\n              if not np.any(grid[ax, ay, :] != 0):\n                  candidates.append((ax, ay))\n      for adj in candidates:\n          path = bfs(pos, adj)\n          if path:\n              return adj, path\n      return None, None\n\n  def direction_to(src, dst):\n      \"\"\"Return the action needed to face dst from src (must be adjacent).\"\"\"\n      sx, sy = src\n      dx, dy = dst[0] - sx, dst[1] - sy\n      if dx == -1 and dy == 0:\n          return ACTION_LEFT\n      if dx == 1 and dy == 0:\n          return ACTION_RIGHT\n      if dx == 0 and dy == -1:\n          return ACTION_UP\n      if dx == 0 and dy == 1:\n          return ACTION_DOWN\n      return None\n\n  # -----------------------------------------------------------------\n  # 1. Collect all required primitive items\n  # -----------------------------------------------------------------\n  for prim_idx, count in primitives_needed.items():\n      for _ in range(count):\n          locations = np.argwhere(grid[:, :, prim_idx] > 0)\n          if len(locations) == 0:\n              continue  # nothing left (should not happen)\n          target = tuple(locations[0])\n\n          adj, path = adjacent_reachable(target)\n          if adj is None:\n              continue  # cannot reach this primitive\n\n          # move to adjacent cell\n          actions.extend(path)\n          pos = adj\n\n          # face the primitive\n          dir_act = direction_to(pos, target)\n          if dir_act is not None:\n              actions.append(dir_act)\n\n          # pick up\n          actions.append(ACTION_USE)\n\n          # update local grid copy\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # -----------------------------------------------------------------\n  # 2. Craft the stick at its required workshop (if any)\n  # -----------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if len(workshop_cells):\n          ws_pos = tuple(workshop_cells[0])\n          adj, path = adjacent_reachable(ws_pos)\n          if adj is not None:\n              actions.extend(path)\n              pos = adj\n              dir_act = direction_to(pos, ws_pos)\n              if dir_act is not None:\n                  actions.append(dir_act)\n              actions.append(ACTION_USE)\n\n  return actions", "env_interactions": 7, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:43:59.823583", "function_name": "make_stick", "function_body": "  env.reset()\n  state = env._current_state\n  plan = []\n\n  goal_idx = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal_idx)\n\n  move_dirs = [\n      (1, 0, 0),   # DOWN\n      (-1, 0, 1),  # UP\n      (0, -1, 2),  # LEFT\n      (0, 1, 3)    # RIGHT\n  ]\n\n  def blocked_grid():\n      \"\"\"Return a boolean grid where True indicates a non\u2011traversable cell.\"\"\"\n      return np.any(state.grid > 0, axis=2)\n\n  def bfs_path(start, target, allow_target_blocked=False):\n      \"\"\"Breadth\u2011first search returning a list of actions from start to target.\"\"\"\n      rows, cols = state.grid.shape[:2]\n      blocked = blocked_grid()\n      if allow_target_blocked:\n          blocked[target] = False\n      visited = np.full((rows, cols), False, dtype=bool)\n      prev = {}\n      q = collections.deque([start])\n      visited[start] = True\n      while q:\n          r, c = q.popleft()\n          if (r, c) == target:\n              break\n          for dr, dc, act in move_dirs:\n              nr, nc = r + dr, c + dc\n              if 0 <= nr < rows and 0 <= nc < cols and not visited[nr, nc] and not blocked[nr, nc]:\n                  visited[nr, nc] = True\n                  prev[(nr, nc)] = (r, c, act)\n                  q.append((nr, nc))\n      if target not in prev and start != target:\n          return []  # no path found\n      actions = []\n      cur = target\n      while cur != start:\n          pr, pc, act = prev[cur]\n          actions.append(act)\n          cur = (pr, pc)\n      actions.reverse()\n      return actions\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives.\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          locations = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if locations.size == 0:\n              return plan  # primitive missing, abort planning\n          cur_pos = np.array(state.pos)\n          dists = np.abs(locations - cur_pos).sum(axis=1)\n          target = tuple(locations[dists.argmin()])\n\n          actions = bfs_path(state.pos, target, allow_target_blocked=True)\n          for a in actions:\n              plan.append(a)\n              _, new_state = env.step(a)\n              state = env._current_state = new_state\n\n          # pick up the primitive\n          plan.append(4)  # USE\n          _, new_state = env.step(4)\n          state = env._current_state = new_state\n\n  # ------------------------------------------------------------------\n  # 2. Craft at the required workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = recipe.get('_at')\n  if workshop_idx is not None:\n      w_locs = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if w_locs.size == 0:\n          return plan  # no workshop present, abort\n      cur_pos = np.array(state.pos)\n      dists = np.abs(w_locs - cur_pos).sum(axis=1)\n      target = tuple(w_locs[dists.argmin()])\n\n      actions = bfs_path(state.pos, target, allow_target_blocked=True)\n      for a in actions:\n          plan.append(a)\n          _, new_state = env.step(a)\n          state = env._current_state = new_state\n\n      plan.append(4)  # USE to craft\n      _, new_state = env.step(4)\n      state = env._current_state = new_state\n\n  return plan", "env_interactions": 0, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:44:00.932464", "function_name": "make_stick", "function_body": "  # Reset environment and get initial state\n  env.reset()\n  state = env._current_state\n  plan = []\n\n  # Identify goal item and its primitive requirements\n  goal_idx = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal_idx)\n\n  # Direction vectors and corresponding action indices (DOWN, UP, LEFT, RIGHT)\n  move_dirs = [\n      (1, 0, 0),   # DOWN\n      (-1, 0, 1),  # UP\n      (0, -1, 2),  # LEFT\n      (0, 1, 3)    # RIGHT\n  ]\n\n  def _blocked_grid():\n      \"\"\"Return a boolean grid where True indicates a non\u2011traversable cell.\"\"\"\n      return np.any(state.grid > 0, axis=2)\n\n  def _bfs_path(start, target, allow_target_blocked=False):\n      \"\"\"Breadth\u2011first search returning a list of actions from start to target.\"\"\"\n      rows, cols = state.grid.shape[:2]\n      blocked = _blocked_grid()\n      if allow_target_blocked:\n          blocked[target] = False\n      visited = np.full((rows, cols), False, dtype=bool)\n      prev = {}  # (r, c) -> (prev_r, prev_c, action)\n      q = collections.deque([start])\n      visited[start] = True\n      while q:\n          r, c = q.popleft()\n          if (r, c) == target:\n              break\n          for dr, dc, act in move_dirs:\n              nr, nc = r + dr, c + dc\n              if (\n                  0 <= nr < rows\n                  and 0 <= nc < cols\n                  and not visited[nr, nc]\n                  and not blocked[nr, nc]\n              ):\n                  visited[nr, nc] = True\n                  prev[(nr, nc)] = (r, c, act)\n                  q.append((nr, nc))\n      if start != target and target not in prev:\n          return []  # no path found\n      actions = []\n      cur = target\n      while cur != start:\n          pr, pc, act = prev[cur]\n          actions.append(act)\n          cur = (pr, pc)\n      actions.reverse()\n      return actions\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives.\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          # Locate all cells containing this primitive\n          locations = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if locations.size == 0:\n              return plan  # primitive missing, abort planning\n          # Choose the closest one (Manhattan distance)\n          cur_pos = np.array(state.pos)\n          dists = np.abs(locations - cur_pos).sum(axis=1)\n          target = tuple(locations[dists.argmin()])\n\n          # Move to the primitive (allow stepping onto the occupied target)\n          actions = _bfs_path(state.pos, target, allow_target_blocked=True)\n          for a in actions:\n              plan.append(a)\n              _, new_state = env.step(a)\n              state = env._current_state = new_state\n\n          # Pick it up\n          plan.append(4)  # USE\n          _, new_state = env.step(4)\n          state = env._current_state = new_state\n\n  # ------------------------------------------------------------------\n  # 2. Craft at the required workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = recipe.get(\"_at\")\n  if workshop_idx is not None:\n      # Locate workshop cells\n      w_locs = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if w_locs.size > 0:\n          cur_pos = np.array(state.pos)\n          dists = np.abs(w_locs - cur_pos).sum(axis=1)\n          target = tuple(w_locs[dists.argmin()])\n\n          # Move to workshop (allow stepping onto its occupied cell)\n          actions = _bfs_path(state.pos, target, allow_target_blocked=True)\n          for a in actions:\n              plan.append(a)\n              _, new_state = env.step(a)\n              state = env._current_state = new_state\n\n          # Craft the stick\n          plan.append(4)  # USE\n          _, new_state = env.step(4)\n          state = env._current_state = new_state\n\n  return plan", "env_interactions": 0, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:44:38.687980", "function_name": "make_stick", "function_body": "  env.reset()\n  world = env.world\n  scenario = env.scenario\n\n  # Action indices (same as CraftLab.action_specs())\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  # Index of the target item \u201cstick\u201d\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # Primitives required to craft a stick (empty if stick itself is primitive)\n  primitives_needed = world.cookbook.primitives_for(stick_idx)\n  if not primitives_needed:\n      primitives_needed = {stick_idx: 1}\n\n  # Working copies of the grid and agent position for planning\n  grid = scenario.init_grid.copy()\n  pos = scenario.init_pos          # (x, y)\n  actions = []                     # list of action indices to return\n\n  from collections import deque\n\n  def bfs(start, goal):\n      \"\"\"Return a list of movement actions from start to goal avoiding occupied cells.\"\"\"\n      W, H = grid.shape[:2]\n      visited = set([start])\n      q = deque([(start, [])])\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for act, (dx, dy) in (\n              (ACTION_DOWN, (0, 1)),\n              (ACTION_UP, (0, -1)),\n              (ACTION_LEFT, (-1, 0)),\n              (ACTION_RIGHT, (1, 0)),\n          ):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in visited:\n                  if np.any(grid[nx, ny, :] != 0):\n                      continue          # blocked cell\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [act]))\n      return None  # unreachable\n\n  def free_adjacent(cell):\n      \"\"\"Return a list of free (unoccupied) cells adjacent to `cell`.\"\"\"\n      adj = []\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          ax, ay = cell[0] + dx, cell[1] + dy\n          if 0 <= ax < grid.shape[0] and 0 <= ay < grid.shape[1]:\n              if not np.any(grid[ax, ay, :] != 0):\n                  adj.append((ax, ay))\n      return adj\n\n  def direction_action(dx, dy):\n      \"\"\"Map a delta (dx, dy) to the corresponding movement action.\"\"\"\n      if dx == -1 and dy == 0:\n          return ACTION_LEFT\n      if dx == 1 and dy == 0:\n          return ACTION_RIGHT\n      if dx == 0 and dy == -1:\n          return ACTION_UP\n      if dx == 0 and dy == 1:\n          return ACTION_DOWN\n      return None\n\n  # -----------------------------------------------------------------\n  # 1. Collect all required primitive items\n  # -----------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      for _ in range(needed_cnt):\n          locations = np.argwhere(grid[:, :, prim_idx] > 0)\n          if len(locations) == 0:\n              continue\n          target = tuple(locations[0])   # (x, y)\n\n          # Find a free adjacent cell from which we can interact with the primitive\n          adj_cells = free_adjacent(target)\n          chosen_adj = None\n          path_to_adj = None\n          for adj in adj_cells:\n              p = bfs(pos, adj)\n              if p is not None:\n                  chosen_adj = adj\n                  path_to_adj = p\n                  break\n          if path_to_adj is None:\n              continue   # cannot reach a usable position\n\n          # Move to the chosen adjacent cell\n          actions.extend(path_to_adj)\n          pos = chosen_adj\n\n          # Move onto the primitive, USE it, then step back\n          dx, dy = target[0] - pos[0], target[1] - pos[1]\n          step_act = direction_action(dx, dy)\n          if step_act is not None:\n              actions.append(step_act)          # onto primitive\n              actions.append(ACTION_USE)        # collect\n              back_act = direction_action(-dx, -dy)\n              if back_act is not None:\n                  actions.append(back_act)      # return to original cell\n          else:\n              actions.append(ACTION_USE)\n\n          # Update local copy of the grid\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # -----------------------------------------------------------------\n  # 2. Craft the stick at its workshop (if required)\n  # -----------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if len(ws_cells):\n          ws_pos = tuple(ws_cells[0])\n\n          adj_cells = free_adjacent(ws_pos)\n          chosen_adj = None\n          path_to_adj = None\n          for adj in adj_cells:\n              p = bfs(pos, adj)\n              if p is not None:\n                  chosen_adj = adj\n                  path_to_adj = p\n                  break\n\n          if path_to_adj is not None:\n              actions.extend(path_to_adj)\n              pos = chosen_adj\n\n              dx, dy = ws_pos[0] - pos[0], ws_pos[1] - pos[1]\n              step_act = direction_action(dx, dy)\n              if step_act is not None:\n                  actions.append(step_act)          # onto workshop\n                  actions.append(ACTION_USE)        # craft stick\n                  back_act = direction_action(-dx, -dy)\n                  if back_act is not None:\n                      actions.append(back_act)\n              else:\n                  actions.append(ACTION_USE)\n  else:\n      # No workshop required \u2013 just use in place\n      actions.append(ACTION_USE)\n\n  # Return the compiled action list\n  return actions", "env_interactions": 9, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:44:39.819985", "function_name": "make_stick", "function_body": "  env.reset()\n  world = env.world\n  scenario = env.scenario\n\n  # action constants (as defined in CraftLab.action_specs())\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  # target item index\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # primitives required to craft a stick (empty if stick itself is primitive)\n  primitives_needed = world.cookbook.primitives_for(stick_idx)\n  if not primitives_needed:\n      primitives_needed = {stick_idx: 1}\n\n  # mutable copies of the grid and agent position\n  grid = scenario.init_grid.copy()\n  pos = scenario.init_pos          # (x, y)\n  actions = []                     # list of action indices to return\n\n  # ----------------------------------------------------------------------\n  # Helper utilities\n  # ----------------------------------------------------------------------\n  from collections import deque\n\n  def bfs(start, goal):\n      \"\"\"Return a list of movement actions from start to goal avoiding occupied cells.\"\"\"\n      W, H = grid.shape[:2]\n      visited = set([start])\n      q = deque([(start, [])])\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for act, (dx, dy) in (\n              (ACTION_DOWN, (0, 1)),\n              (ACTION_UP, (0, -1)),\n              (ACTION_LEFT, (-1, 0)),\n              (ACTION_RIGHT, (1, 0)),\n          ):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in visited:\n                  if np.any(grid[nx, ny, :] != 0):\n                      continue          # blocked cell\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [act]))\n      return None  # unreachable\n\n  def free_adjacent(cell):\n      \"\"\"Return a list of free (unoccupied) cells adjacent to `cell`.\"\"\"\n      adj = []\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          ax, ay = cell[0] + dx, cell[1] + dy\n          if 0 <= ax < grid.shape[0] and 0 <= ay < grid.shape[1]:\n              if not np.any(grid[ax, ay, :] != 0):\n                  adj.append((ax, ay))\n      return adj\n\n  def direction_action(dx, dy):\n      \"\"\"Map a delta (dx, dy) to the corresponding movement action.\"\"\"\n      if dx == -1 and dy == 0:\n          return ACTION_LEFT\n      if dx == 1 and dy == 0:\n          return ACTION_RIGHT\n      if dx == 0 and dy == -1:\n          return ACTION_UP\n      if dx == 0 and dy == 1:\n          return ACTION_DOWN\n      return None\n\n  # ----------------------------------------------------------------------\n  # 1. Collect all required primitive items\n  # ----------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      for _ in range(needed_cnt):\n          # locate any remaining instance of this primitive\n          locations = np.argwhere(grid[:, :, prim_idx] > 0)\n          if len(locations) == 0:\n              continue\n          target = tuple(locations[0])  # (x, y)\n\n          # find a free adjacent cell from which we can USE the primitive\n          adj_cells = free_adjacent(target)\n          chosen_adj = None\n          path_to_adj = None\n          for adj in adj_cells:\n              p = bfs(pos, adj)\n              if p is not None:\n                  chosen_adj = adj\n                  path_to_adj = p\n                  break\n\n          if path_to_adj is None:\n              continue  # could not reach a usable position\n\n          # move to the chosen adjacent cell\n          actions.extend(path_to_adj)\n          pos = chosen_adj\n\n          # step onto the primitive, USE, then step back\n          dx, dy = target[0] - pos[0], target[1] - pos[1]\n          step_act = direction_action(dx, dy)\n          if step_act is not None:\n              actions.append(step_act)          # onto primitive\n              actions.append(ACTION_USE)       # collect\n              back_act = direction_action(-dx, -dy)\n              if back_act is not None:\n                  actions.append(back_act)      # return to original cell\n          else:\n              actions.append(ACTION_USE)        # already adjacent (unlikely)\n\n          # update local grid copy\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # ----------------------------------------------------------------------\n  # 2. Craft the stick at its required workshop (if any)\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_cells.size:\n          ws_pos = tuple(ws_cells[0])\n\n          # find a free adjacent cell next to the workshop\n          adj_cells = free_adjacent(ws_pos)\n          chosen_adj = None\n          path_to_adj = None\n          for adj in adj_cells:\n              p = bfs(pos, adj)\n              if p is not None:\n                  chosen_adj = adj\n                  path_to_adj = p\n                  break\n\n          if path_to_adj is not None:\n              actions.extend(path_to_adj)\n              pos = chosen_adj\n\n              # step onto the workshop, USE to craft, then step back\n              dx, dy = ws_pos[0] - pos[0], ws_pos[1] - pos[1]\n              step_act = direction_action(dx, dy)\n              if step_act is not None:\n                  actions.append(step_act)          # onto workshop\n                  actions.append(ACTION_USE)       # craft stick\n                  back_act = direction_action(-dx, -dy)\n                  if back_act is not None:\n                      actions.append(back_act)\n              else:\n                  actions.append(ACTION_USE)\n  else:\n      # No workshop required \u2013 just use in place\n      actions.append(ACTION_USE)\n\n  # ----------------------------------------------------------------------\n  # Return the compiled sequence of actions\n  # ----------------------------------------------------------------------\n  return actions", "env_interactions": 9, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:45:02.337160", "function_name": "make_stick", "function_body": "  # Reset environment to start fresh\n  env.reset()\n\n  # Shortcut references to world and index\n  world = env.world\n  idx = world.cookbook.index\n\n  # ------------------------------------------------------------------\n  # Identify the index of the goal item \u201cstick\u201d (case\u2011insensitive)\n  # ------------------------------------------------------------------\n  try:\n      goal_idx = idx[\"stick\"]\n  except Exception:  # pragma: no cover\n      goal_idx = next(\n          i for i, name in enumerate(idx.ordered_contents) if name.lower() == \"stick\"\n      )\n\n  # ------------------------------------------------------------------\n  # Determine which primitives (or the item itself) must be collected\n  # ------------------------------------------------------------------\n  required = world.cookbook.primitives_for(goal_idx)\n  if not required:                     # stick itself may be primitive\n      required = {goal_idx: 1}\n\n  # ------------------------------------------------------------------\n  # Current simulated state (grid, position, etc.)\n  # ------------------------------------------------------------------\n  state = env._current_state\n  cur_pos = tuple(state.pos)           # (x, y)\n  grid = state.grid.copy()             # local copy for bookkeeping\n\n  # Pre\u2011compute a mask of cells that are blocked because they contain\n  # non\u2011grabbable entities (e.g., water, stone, trees)\n  non_grabbable = list(world.non_grabbable_indices)\n  if non_grabbable:\n      blocked = np.any(grid[:, :, non_grabbable] > 0, axis=2)\n  else:\n      blocked = np.zeros(grid.shape[:2], dtype=bool)\n\n  # ------------------------------------------------------------------\n  # Action indices (DOWN, UP, LEFT, RIGHT, USE)\n  # ------------------------------------------------------------------\n  spec = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      spec[\"DOWN\"], spec[\"UP\"], spec[\"LEFT\"], spec[\"RIGHT\"], spec[\"USE\"]\n  )\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving from *start* to any\n  # cell in *targets* while avoiding blocked cells.\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  def bfs_path(start, targets, blocked_mask):\n      \"\"\"Return actions list from start to the nearest target.\"\"\"\n      if start in targets:\n          return []\n      q = deque([start])\n      visited = {start: (None, None)}          # pos -> (parent, action)\n      while q:\n          cur = q.popleft()\n          for act, (dx, dy) in (\n              (DOWN, (0, 1)),\n              (UP, (0, -1)),\n              (LEFT, (-1, 0)),\n              (RIGHT, (1, 0)),\n          ):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if not (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]):\n                  continue\n              if blocked_mask[nx, ny]:\n                  continue\n              nxt = (nx, ny)\n              if nxt in visited:\n                  continue\n              visited[nxt] = (cur, act)\n              if nxt in targets:\n                  # Reconstruct path\n                  path = []\n                  node = nxt\n                  while visited[node][0] is not None:\n                      parent, a = visited[node]\n                      path.append(a)\n                      node = parent\n                  return list(reversed(path))\n              q.append(nxt)\n\n      # Fallback: simple Manhattan moves (ignores obstacles)\n      target = next(iter(targets))\n      x, y = start\n      tx, ty = target\n      fallback = []\n      while x < tx:\n          fallback.append(RIGHT); x += 1\n      while x > tx:\n          fallback.append(LEFT); x -= 1\n      while y < ty:\n          fallback.append(DOWN); y += 1\n      while y > ty:\n          fallback.append(UP); y -= 1\n      return fallback\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives / items\n  # ------------------------------------------------------------------\n  for item_idx, count in required.items():\n      needed = int(count)\n      while needed > 0:\n          # Find cells that still contain the required item\n          locs = np.argwhere(grid[:, :, item_idx] > 0)\n          if locs.size == 0:\n              # No more of this item on the map \u2013 give up on this component\n              break\n          # Choose the nearest location (Manhattan distance)\n          dists = np.abs(locs[:, 0] - cur_pos[0]) + np.abs(locs[:, 1] - cur_pos[1])\n          target = tuple(locs[dists.argmin()])\n\n          # Move to the target\n          actions.extend(bfs_path(cur_pos, {target}, blocked))\n          cur_pos = target\n\n          # Pick it up\n          actions.append(USE)\n          needed -= 1\n\n          # Update simulated grid and blocked mask\n          grid[target[0], target[1], item_idx] -= 1\n          if non_grabbable:\n              blocked[target[0], target[1]] = np.any(\n                  grid[target[0], target[1], non_grabbable] > 0\n              )\n\n  # ------------------------------------------------------------------\n  # 2. If the recipe specifies a workshop, go there and craft the stick\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = idx[workshop_name]\n      ws_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_locs.size:\n          ws_target = tuple(ws_locs[0])\n          actions.extend(bfs_path(cur_pos, {ws_target}, blocked))\n          cur_pos = ws_target\n          actions.append(USE)      # craft at the workshop\n\n  # Return the complete action sequence\n  actions", "env_interactions": 0, "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-10-21T21:45:03.465826", "function_name": "make_stick", "function_body": "  # Reset environment to start fresh\n  env.reset()\n  world = env.world\n  idx = world.cookbook.index\n\n  # Action indices\n  act_spec = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act_spec[\"DOWN\"], act_spec[\"UP\"], act_spec[\"LEFT\"], act_spec[\"RIGHT\"], act_spec[\"USE\"]\n  )\n  # Mapping from delta to action\n  delta_action = {\n      (1, 0): RIGHT,\n      (-1, 0): LEFT,\n      (0, 1): DOWN,\n      (0, -1): UP,\n  }\n\n  # Locate the index for the goal item \u201cstick\u201d (case\u2011insensitive fallback)\n  try:\n      stick_idx = idx[\"stick\"]\n  except Exception:  # pragma: no cover\n      stick_idx = next(i for i, n in enumerate(idx.ordered_contents) if n.lower() == \"stick\")\n\n  # Determine which primitives (or the item itself) must be collected\n  needed = world.cookbook.primitives_for(stick_idx)\n  if not needed:\n      needed = {stick_idx: 1}\n\n  # Current simulated state (position, grid)\n  state = env._current_state\n  cur_pos = tuple(state.pos)               # (x, y)\n  grid = state.grid.copy()\n\n  # Cells occupied by non\u2011grabbable entities are blocked for movement\n  non_grabbable = list(world.non_grabbable_indices)\n  if non_grabbable:\n      blocked = np.any(grid[:, :, non_grabbable] > 0, axis=2)\n  else:\n      blocked = np.zeros(grid.shape[:2], dtype=bool)\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving from start to any target\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  def bfs_actions(start, target_set):\n      \"\"\"Return action list to reach the nearest cell in target_set.\"\"\"\n      if start in target_set:\n          return []\n      q = deque([start])\n      visited = {start: (None, None)}  # pos -> (parent, action_taken)\n      while q:\n          cur = q.popleft()\n          for act, (dx, dy) in (\n              (RIGHT, (1, 0)),\n              (LEFT, (-1, 0)),\n              (DOWN, (0, 1)),\n              (UP, (0, -1)),\n          ):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if not (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]):\n                  continue\n              if blocked[nx, ny]:\n                  continue\n              nxt = (nx, ny)\n              if nxt in visited:\n                  continue\n              visited[nxt] = (cur, act)\n              if nxt in target_set:\n                  # reconstruct actions\n                  path = []\n                  node = nxt\n                  while visited[node][0] is not None:\n                      parent, a = visited[node]\n                      path.append(a)\n                      node = parent\n                  return list(reversed(path))\n              q.append(nxt)\n      # Fallback: Manhattan moves ignoring obstacles\n      target = next(iter(target_set))\n      x, y = start\n      tx, ty = target\n      fallback = []\n      while x < tx:\n          fallback.append(RIGHT); x += 1\n      while x > tx:\n          fallback.append(LEFT); x -= 1\n      while y < ty:\n          fallback.append(DOWN); y += 1\n      while y > ty:\n          fallback.append(UP); y -= 1\n      return fallback\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives/items\n  # ------------------------------------------------------------------\n  for item_idx, cnt in needed.items():\n      remaining = int(cnt)\n      while remaining > 0:\n          # Find all locations that still contain this item\n          locs = np.argwhere(grid[:, :, item_idx] > 0)\n          if locs.size == 0:\n              break  # nothing left on map\n          # Choose the closest location (Manhattan distance)\n          dists = np.abs(locs[:, 0] - cur_pos[0]) + np.abs(locs[:, 1] - cur_pos[1])\n          target = tuple(locs[dists.argmin()])\n          # Move there\n          actions.extend(bfs_actions(cur_pos, {target}))\n          cur_pos = target\n          # Pick it up\n          actions.append(USE)\n          # Update simulated grid and blocked mask\n          grid[target[0], target[1], item_idx] -= 1\n          if non_grabbable:\n              blocked[target[0], target[1]] = np.any(\n                  grid[target[0], target[1], non_grabbable] > 0\n              )\n          remaining -= 1\n\n  # ------------------------------------------------------------------\n  # 2. Go to the required workshop (if any) and craft the stick\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = idx[workshop_name]\n      ws_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_locs.size:\n          ws_target = tuple(ws_locs[0])\n          actions.extend(bfs_actions(cur_pos, {ws_target}))\n          cur_pos = ws_target\n          actions.append(USE)  # craft at the workshop\n\n  return actions", "env_interactions": 4, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:45:28.051323", "function_name": "make_stick", "function_body": "  env.reset()\n  world = env.world\n  scenario = env.scenario\n  grid = scenario.init_grid.copy()\n  pos = list(scenario.init_pos)\n  actions = []\n  action_map = env.action_specs()\n  goal_idx = env.task.goal\n  needed = world.cookbook.primitives_for(goal_idx)\n\n  from collections import deque\n\n  def _bfs(src, tgt):\n      src_t = tuple(src)\n      tgt_t = tuple(tgt)\n      if src_t == tgt_t:\n          return []\n      q = deque([(src_t, [])])\n      visited = {src_t}\n      moves = [\n          (0, 1, action_map[\"DOWN\"]),\n          (0, -1, action_map[\"UP\"]),\n          (-1, 0, action_map[\"LEFT\"]),\n          (1, 0, action_map[\"RIGHT\"]),\n      ]\n      w, h = grid.shape[0], grid.shape[1]\n      while q:\n          (x, y), path = q.popleft()\n          for dx, dy, act in moves:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < w and 0 <= ny < h):\n                  continue\n              npos = (nx, ny)\n              if npos in visited:\n                  continue\n              # allow stepping onto the target even if occupied\n              if npos != tgt_t and grid[nx, ny, :].any():\n                  continue\n              new_path = path + [act]\n              if npos == tgt_t:\n                  return new_path\n              visited.add(npos)\n              q.append((npos, new_path))\n      # Fallback Manhattan walk\n      fallback = []\n      cx, cy = src_t\n      tx, ty = tgt_t\n      while cx < tx:\n          fallback.append(action_map[\"RIGHT\"])\n          cx += 1\n      while cx > tx:\n          fallback.append(action_map[\"LEFT\"])\n          cx -= 1\n      while cy < ty:\n          fallback.append(action_map[\"DOWN\"])\n          cy += 1\n      while cy > ty:\n          fallback.append(action_map[\"UP\"])\n          cy -= 1\n      return fallback\n\n  def _move_to(target):\n      nonlocal pos, actions\n      steps = _bfs(pos, target)\n      actions.extend(steps)\n      pos[0], pos[1] = target[0], target[1]\n\n  # 1) Collect required primitive resources\n  for kind_idx, count in needed.items():\n      for _ in range(count):\n          locations = np.argwhere(grid[:, :, kind_idx] == 1)\n          if locations.shape[0] == 0:\n              break\n          dists = np.abs(locations - np.array(pos)).sum(axis=1)\n          nearest = int(np.argmin(dists))\n          target_cell = locations[nearest].tolist()\n          _move_to(target_cell)\n          actions.append(action_map[\"USE\"])\n          grid[target_cell[0], target_cell[1], kind_idx] = 0\n\n  # 2) If a workshop is required, move there and craft\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get('_at')\n  if workshop_kind is not None:\n      workshop_cells = np.argwhere(grid[:, :, workshop_kind] == 1)\n      if workshop_cells.shape[0] > 0:\n          dists = np.abs(workshop_cells - np.array(pos)).sum(axis=1)\n          nearest_ws = int(np.argmin(dists))\n          ws_target = workshop_cells[nearest_ws].tolist()\n          _move_to(ws_target)\n          actions.append(action_map[\"USE\"])\n\n  return actions", "env_interactions": 0, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:45:29.163434", "function_name": "make_stick", "function_body": "  # Reset environment to get fresh scenario\n  env.reset()\n  world = env.world\n  scenario = env.scenario\n\n  # Local mutable copies of the grid and agent position\n  grid = scenario.init_grid.copy()\n  pos = list(scenario.init_pos)          # [x, y]\n  actions = []\n\n  # Mapping from action names to indices (e.g., {\"DOWN\":0, ...})\n  action_map = env.action_specs()\n\n  # Goal index and required primitive counts\n  goal_idx = env.task.goal\n  needed_primitives = world.cookbook.primitives_for(goal_idx)\n\n  # ------------------------------------------------------------------\n  # Helper: BFS shortest path that avoids occupied cells (except target)\n  # Returns list of action indices.\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  def _shortest_path(src, tgt):\n      src_t = tuple(src)\n      tgt_t = tuple(tgt)\n      if src_t == tgt_t:\n          return []\n\n      visited = {src_t}\n      q = deque()\n      q.append((src_t, []))\n\n      moves = [(0, 1, \"DOWN\"),\n               (0, -1, \"UP\"),\n               (-1, 0, \"LEFT\"),\n               (1, 0, \"RIGHT\")]\n\n      while q:\n          (x, y), path = q.popleft()\n          for dx, dy, name in moves:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]):\n                  continue\n              npos = (nx, ny)\n              if npos in visited:\n                  continue\n\n              # Allow stepping onto the target even if occupied.\n              if npos != tgt_t and grid[nx, ny, :].any():\n                  continue\n\n              new_path = path + [action_map[name]]\n              if npos == tgt_t:\n                  return new_path\n\n              visited.add(npos)\n              q.append((npos, new_path))\n\n      # Fallback: simple Manhattan moves (should rarely be needed)\n      fallback = []\n      cx, cy = src_t\n      tx, ty = tgt_t\n      while cx < tx:\n          fallback.append(action_map[\"RIGHT\"]); cx += 1\n      while cx > tx:\n          fallback.append(action_map[\"LEFT\"]); cx -= 1\n      while cy < ty:\n          fallback.append(action_map[\"DOWN\"]); cy += 1\n      while cy > ty:\n          fallback.append(action_map[\"UP\"]); cy -= 1\n      return fallback\n\n  # ------------------------------------------------------------------\n  # Helper: move agent to a target cell using the shortest path.\n  # ------------------------------------------------------------------\n  def _move_to(target):\n      nonlocal pos, actions\n      steps = _shortest_path(pos, target)\n      actions.extend(steps)\n      pos[0], pos[1] = target[0], target[1]\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitive resources.\n  # ------------------------------------------------------------------\n  for kind_idx, count in needed_primitives.items():\n      for _ in range(count):\n          locations = np.argwhere(grid[:, :, kind_idx] == 1)\n          if locations.shape[0] == 0:\n              # No more instances of this primitive; break.\n              break\n\n          # Choose the nearest instance (Manhattan distance).\n          dists = np.abs(locations - np.array(pos)).sum(axis=1)\n          nearest = int(np.argmin(dists))\n          target_cell = locations[nearest].tolist()\n\n          # Travel to the primitive and pick it up.\n          _move_to(target_cell)\n          actions.append(action_map[\"USE\"])\n\n          # Update our internal copy of the grid.\n          grid[target_cell[0], target_cell[1], kind_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 2) If the recipe specifies a workshop, travel there and craft.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get('_at')\n  if workshop_kind is not None:\n      workshop_cells = np.argwhere(grid[:, :, workshop_kind] == 1)\n      if workshop_cells.shape[0] > 0:\n          dists = np.abs(workshop_cells - np.array(pos)).sum(axis=1)\n          nearest_ws = int(np.argmin(dists))\n          ws_target = workshop_cells[nearest_ws].tolist()\n          _move_to(ws_target)\n          actions.append(action_map[\"USE\"])\n\n  # Return the planned sequence of actions.\n  return actions", "env_interactions": 0, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:45:48.430990", "function_name": "make_stick", "function_body": "  # Get action IDs\n  try:\n      action_map = env.action_specs()\n      action_ids = list(action_map.values())\n  except Exception:\n      action_ids = [0, 1, 2, 3, 4]  # fallback ordering\n\n  # Resolve index of target item \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = getattr(env, \"world\", None)\n      if stick_idx is not None:\n          stick_idx = getattr(stick_idx, \"cookbook\", None)\n          if stick_idx is not None:\n              stick_idx = stick_idx.index.get(\"stick\")\n  if stick_idx is None:\n      return []  # cannot find stick index\n\n  # Helper to test goal satisfaction\n  def goal_reached(state):\n      return state.satisfies(\"\", stick_idx)\n\n  # Obtain the starting CraftState\n  start_state = getattr(env, \"_current_state\", None)\n  if start_state is None:\n      start_state = getattr(env, \"current_state\", None)\n  if start_state is None:\n      return []  # cannot access underlying state\n\n  from collections import deque\n\n  # Compact hashable representation for visited set\n  def state_key(st):\n      # inventory is a numpy array; use its bytes representation\n      return (st.pos, st.dir, st.inventory.tobytes())\n\n  visited = {state_key(start_state)}\n  frontier = deque()\n  frontier.append((start_state, []))\n\n  MAX_PLAN_LENGTH = 250  # safety bound\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      if goal_reached(cur_state):\n          return cur_plan\n\n      if len(cur_plan) >= MAX_PLAN_LENGTH:\n          continue\n\n      # Expand actions; try USE first as it may craft items\n      for a in sorted(action_ids, key=lambda x: 0 if x == action_map.get(\"USE\", 4) else 1):\n          _, nxt_state = cur_state.step(a)\n          key = state_key(nxt_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((nxt_state, cur_plan + [a]))\n\n  # No plan found within limits\n  return []", "env_interactions": 4, "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T21:45:49.545529", "function_name": "make_stick", "function_body": "  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      action_ids = [0, 1, 2, 3, 4]  # fallback action IDs\n\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = None\n\n  if stick_idx is None:\n      return []\n\n  def goal_reached(state):\n      return state.satisfies(\"\", stick_idx)\n\n  start_state = getattr(env, \"_current_state\", None)\n  if start_state is None:\n      start_state = getattr(env, \"current_state\", None)\n  if start_state is None:\n      return []\n\n  from collections import deque\n\n  def state_key(st):\n      return (st.pos, st.dir, st.inventory.tobytes())\n\n  visited = {state_key(start_state)}\n  frontier = deque()\n  frontier.append((start_state, []))\n\n  MAX_PLAN_LEN = 300\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      if goal_reached(cur_state):\n          return cur_plan\n\n      if len(cur_plan) >= MAX_PLAN_LEN:\n          continue\n\n      for a in action_ids:\n          _, nxt_state = cur_state.step(a)\n          key = state_key(nxt_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((nxt_state, cur_plan + [a]))\n\n  return []", "env_interactions": 4, "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T21:46:08.540776", "function_name": "make_stick", "function_body": "  # Reset environment and obtain initial state\n  env.reset()\n  state = env._current_state\n\n  # Goal item index and its primitive requirements\n  goal_idx = env.task.goal\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)\n\n  # Action mapping (matches CraftLab ordering)\n  DIR2ACT = {(1, 0): 0, (-1, 0): 1, (0, -1): 2, (0, 1): 3}\n  USE_ACT = 4\n\n  actions = []\n\n  from collections import deque\n\n  def bfs_to_kind(start_pos, kind_idx):\n      \"\"\"Bread\u2011first search for the nearest cell containing `kind_idx`.\n      Returns a list of positions (r, c) from start to target (inclusive)\n      or None if unreachable.\"\"\"\n      w, h = state.grid.shape[:2]\n      visited = np.zeros((w, h), dtype=bool)\n      prev = np.full((w, h, 2), -1, dtype=int)\n\n      q = deque([start_pos])\n      visited[start_pos] = True\n\n      while q:\n          r, c = q.popleft()\n          if state.grid[r, c, kind_idx] > 0:\n              # reconstruct path\n              path = [(r, c)]\n              while (r, c) != start_pos:\n                  r, c = tuple(prev[r, c])\n                  path.append((r, c))\n              path.reverse()\n              return path\n\n          for dr, dc in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              nr, nc = r + dr, c + dc\n              if 0 <= nr < w and 0 <= nc < h and not visited[nr, nc]:\n                  cell = state.grid[nr, nc, :]\n                  # Walkable if empty or contains the target kind (so we can step onto it)\n                  if cell.sum() == 0 or cell[kind_idx] > 0:\n                      visited[nr, nc] = True\n                      prev[nr, nc] = (r, c)\n                      q.append((nr, nc))\n      return None\n\n  def follow_path(path):\n      \"\"\"Execute actions that follow the given path, updating `state`.\"\"\"\n      nonlocal state\n      for (r0, c0), (r1, c1) in zip(path, path[1:]):\n          dr, dc = r1 - r0, c1 - c0\n          act = DIR2ACT[(dr, dc)]\n          actions.append(act)\n          _, new_state = env.step(act)\n          state = new_state\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitive items.\n  # ------------------------------------------------------------------\n  for prim_idx, count in primitives_needed.items():\n      for _ in range(count):\n          path = bfs_to_kind(state.pos, prim_idx)\n          if path is None:\n              # Primitive unreachable \u2013 abort early.\n              return actions\n          follow_path(path)\n\n          # Pick up the primitive at the current location.\n          actions.append(USE_ACT)\n          _, new_state = env.step(USE_ACT)\n          state = new_state\n\n  # ------------------------------------------------------------------\n  # 2. Move to the workshop (if required) and craft the goal item.\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = recipe.get('_at')\n  if workshop_idx is not None:\n      path = bfs_to_kind(state.pos, workshop_idx)\n      if path is not None:\n          follow_path(path)\n          actions.append(USE_ACT)  # trigger crafting at the workshop\n          _, new_state = env.step(USE_ACT)\n          state = new_state\n\n  return actions", "env_interactions": 0, "island_id": 9, "scores": {"3": 0.0}}
