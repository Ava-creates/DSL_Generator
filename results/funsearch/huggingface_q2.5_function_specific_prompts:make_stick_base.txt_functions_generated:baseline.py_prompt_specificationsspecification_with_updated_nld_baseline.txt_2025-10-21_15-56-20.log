{"timestamp": "2025-10-21T20:07:29.501389", "function_name": "make_stick", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ----------------------------------------------------------------------\n  # Basic handles\n  # ----------------------------------------------------------------------\n  ACTION = env.action_specs()               # name \u2192 int\n  state = env._current_state                # CraftState\n  world = env.world                         # CraftWorld\n  idx = world.cookbook.index\n\n  # ----------------------------------------------------------------------\n  # Identify goal index (stick) \u2013 try task goal, fallback to name\n  # ----------------------------------------------------------------------\n  try:\n      goal = env.task.goal\n      goal_idx = goal if isinstance(goal, int) else idx[goal]\n  except Exception:\n      goal_idx = idx[\"stick\"]\n\n  # ----------------------------------------------------------------------\n  # Recipe information: required primitives and workshop (if any)\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  required = {}\n  workshop_kind = None\n  for ing, cnt in recipe.items():\n      if ing == \"_at\":\n          workshop_kind = cnt if isinstance(cnt, int) else idx[cnt]\n      else:\n          required[int(ing)] = int(cnt)\n\n  # ----------------------------------------------------------------------\n  # Helper utilities\n  # ----------------------------------------------------------------------\n  def find_all(kind, grid):\n      \"\"\"Return list of (x, y) where grid[..., kind] > 0.\"\"\"\n      coords = np.argwhere(grid[:, :, kind] > 0)\n      return [(int(x), int(y)) for x, y in coords]\n\n  # movement deltas corresponding to action integers\n  # assume standard ordering from env.action_specs()\n  # we map using the known action names\n  MOVE_DELTAS = {}\n  for name, a in ACTION.items():\n      if name == \"UP\":\n          MOVE_DELTAS[a] = (0, -1)\n      elif name == \"DOWN\":\n          MOVE_DELTAS[a] = (0, 1)\n      elif name == \"LEFT\":\n          MOVE_DELTAS[a] = (-1, 0)\n      elif name == \"RIGHT\":\n          MOVE_DELTAS[a] = (1, 0)\n\n  USE = ACTION[\"USE\"]\n\n  def bfs(start, targets, grid, avoid_kind=None):\n      \"\"\"Return (path_actions, target_cell) to a cell adjacent to any target.\n      Avoid cells occupied (grid sum >0) except those containing avoid_kind.\n      \"\"\"\n      W, H, _ = grid.shape\n      visited = np.full((W, H), False, dtype=bool)\n      q = deque()\n      q.append((start, []))\n      visited[start] = True\n\n      occupied = (grid.sum(axis=2) > 0)\n      if avoid_kind is not None:\n          occupied = occupied & (grid[:, :, avoid_kind] == 0)\n\n      while q:\n          (x, y), path = q.popleft()\n          # check adjacency\n          for tx, ty in targets:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path, (tx, ty)\n          # expand\n          for act, (dx, dy) in MOVE_DELTAS.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if not occupied[nx, ny]:\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [act]))\n      return None, None\n\n  # ----------------------------------------------------------------------\n  # Planning\n  # ----------------------------------------------------------------------\n  plan = []\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n  direction = int(state.dir)\n\n  # collect primitives\n  for prim_kind, needed in required.items():\n      collected = 0\n      while collected < needed:\n          locations = find_all(prim_kind, grid)\n          if not locations:\n              break  # cannot find more\n          # choose nearest by Manhattan distance\n          locations.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          target = locations[0]\n\n          path, _ = bfs(pos, [target], grid, avoid_kind=prim_kind)\n          if path is None:\n              break  # unreachable\n\n          # execute movement actions, updating simulated pos & direction\n          for a in path:\n              plan.append(a)\n              dx, dy = MOVE_DELTAS[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n              direction = a\n\n          # determine facing direction towards the primitive\n          px, py = target\n          if pos[0] == px and pos[1] + 1 == py:\n              face = ACTION[\"DOWN\"]\n          elif pos[0] == px and pos[1] - 1 == py:\n              face = ACTION[\"UP\"]\n          elif pos[0] + 1 == px and pos[1] == py:\n              face = ACTION[\"RIGHT\"]\n          elif pos[0] - 1 == px and pos[1] == py:\n              face = ACTION[\"LEFT\"]\n          else:\n              face = direction\n\n          if face != direction:\n              plan.append(face)\n              direction = face\n\n          # pick up primitive\n          plan.append(USE)\n          # simulate removal from grid\n          grid[px, py, prim_kind] = 0\n          collected += 1\n\n  # move to workshop and craft\n  if workshop_kind is not None:\n      wk_cells = find_all(workshop_kind, grid)\n      if wk_cells:\n          wk_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          wk_target = wk_cells[0]\n          path, _ = bfs(pos, [wk_target], grid)\n          if path is not None:\n              for a in path:\n                  plan.append(a)\n                  dx, dy = MOVE_DELTAS[a]\n                  pos = (pos[0] + dx, pos[1] + dy)\n                  direction = a\n\n          # face workshop\n          wx, wy = wk_target\n          if pos[0] == wx and pos[1] + 1 == wy:\n              face = ACTION[\"DOWN\"]\n          elif pos[0] == wx and pos[1] - 1 == wy:\n              face = ACTION[\"UP\"]\n          elif pos[0] + 1 == wx and pos[1] == wy:\n              face = ACTION[\"RIGHT\"]\n          elif pos[0] - 1 == wx and pos[1] == wy:\n              face = ACTION[\"LEFT\"]\n          else:\n              face = direction\n\n          if face != direction:\n              plan.append(face)\n              direction = face\n\n          # craft/use at workshop\n          plan.append(USE)\n\n  return plan", "env_interactions": 0, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T20:07:30.616240", "function_name": "make_stick", "function_body": "  import numpy as np\n\n  # basic handles\n  ACTION = env.action_specs()                     # action name \u2192 int\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  # target item index (stick)\n  stick_idx = idx[\"stick\"]\n  # primitives required to craft a stick\n  needed = world.cookbook.primitives_for(stick_idx)   # dict {prim_idx: count}\n\n  actions = []\n  cur_pos = tuple(state.pos)\n  grid = state.grid\n\n  def find_nearest(start, kind):\n      \"\"\"Return coordinates of nearest cell containing kind, or None.\"\"\"\n      layer = grid[:, :, kind]\n      ys, xs = np.where(layer > 0)\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - start[0]) + np.abs(ys - start[1])\n      i = int(np.argmin(dists))\n      return (int(xs[i]), int(ys[i]))\n\n  def moves_to(cur, target):\n      \"\"\"Generate movement actions from cur to target (Manhattan).\"\"\"\n      seq = []\n      x, y = cur\n      tx, ty = target\n      while x != tx:\n          if tx > x:\n              seq.append(ACTION[\"RIGHT\"])\n              x += 1\n          else:\n              seq.append(ACTION[\"LEFT\"])\n              x -= 1\n      while y != ty:\n          if ty > y:\n              seq.append(ACTION[\"DOWN\"])\n              y += 1\n          else:\n              seq.append(ACTION[\"UP\"])\n              y -= 1\n      return seq\n\n  # collect required primitives\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          tgt = find_nearest(cur_pos, prim_idx)\n          if tgt is None:\n              # primitive not found; skip\n              continue\n          actions.extend(moves_to(cur_pos, tgt))\n          actions.append(ACTION[\"USE\"])   # pick up\n          cur_pos = tgt\n\n  # move to workshop if recipe specifies one\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      wk_idx = idx[workshop_name] if isinstance(workshop_name, str) else workshop_name\n      wk_pos = find_nearest(cur_pos, wk_idx)\n      if wk_pos is not None:\n          actions.extend(moves_to(cur_pos, wk_pos))\n          cur_pos = wk_pos\n\n  # final use to craft the stick (or pick up if primitive)\n  actions.append(ACTION[\"USE\"])\n\n  return actions", "env_interactions": 4, "island_id": 4, "scores": {"3": 0.0}}
