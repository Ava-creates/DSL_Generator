{"timestamp": "2025-10-21T17:54:57.840069", "function_name": "make_stick", "function_body": "  try:\n      # Initialise environment and obtain the underlying CraftState.\n      env.reset()\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          scen = getattr(env, \"scenario\", None)\n          if scen is not None:\n              state = scen.init()\n      if state is None:\n          return []\n\n      world = state.world\n      grid = state.grid.copy()\n      h, w, _ = grid.shape\n      cur_pos = state.pos\n      actions: list[int] = []\n\n      # --------------------------------------------------------------\n      # Helper utilities.\n      # --------------------------------------------------------------\n      import numpy as np\n      from collections import deque\n\n      def find_cells(kind_idx: int) -> list[tuple[int, int]]:\n          \"\"\"Return list of (x, y) where kind_idx is present.\"\"\"\n          pts = np.argwhere(grid[:, :, kind_idx] > 0)\n          return [tuple(p) for p in pts]\n\n      # (dx, dy, action_id) \u2013 matches CraftLab action ordering.\n      DIRS = [\n          (1, 0, 0),   # DOWN\n          (-1, 0, 1),  # UP\n          (0, -1, 2),  # LEFT\n          (0, 1, 3),   # RIGHT\n      ]\n\n      def blocked(x: int, y: int) -> bool:\n          \"\"\"True if any non\u2011grabbable entity occupies (x, y).\"\"\"\n          for idx in world.non_grabbable_indices:\n              if grid[x, y, idx] > 0:\n                  return True\n          return False\n\n      def bfs(start: tuple[int, int], goal: tuple[int, int]) -> list[int]:\n          \"\"\"Bread\u2011first search returning movement actions from start to goal.\"\"\"\n          q = deque()\n          q.append((start, []))\n          visited = {start}\n          while q:\n              (cx, cy), path = q.popleft()\n              if (cx, cy) == goal:\n                  return path\n              for dx, dy, act in DIRS:\n                  nx, ny = cx + dx, cy + dy\n                  if 0 <= nx < h and 0 <= ny < w and not blocked(nx, ny):\n                      if (nx, ny) not in visited:\n                          visited.add((nx, ny))\n                          q.append(((nx, ny), path + [act]))\n          # No path \u2013 return empty list (caller will treat as failure)\n          return []\n\n      # --------------------------------------------------------------\n      # Determine recipe for \"stick\".\n      # --------------------------------------------------------------\n      stick_idx = world.cookbook.index[\"stick\"]\n      primitive_reqs = world.cookbook.primitives_for(stick_idx)\n\n      # If stick itself is primitive (no recipe), just pick one up.\n      if not primitive_reqs:\n          sticks = find_cells(stick_idx)\n          if not sticks:\n              return []\n          dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in sticks]\n          target = sticks[int(np.argmin(dists))]\n          actions.extend(bfs(cur_pos, target))\n          actions.append(4)  # USE to pick up\n          return actions\n\n      # --------------------------------------------------------------\n      # Collect required primitives.\n      # --------------------------------------------------------------\n      for prim_idx, count in primitive_reqs.items():\n          for _ in range(count):\n              cells = find_cells(prim_idx)\n              if not cells:\n                  return []  # missing primitive\n              dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in cells]\n              target = cells[int(np.argmin(dists))]\n              move_seq = bfs(cur_pos, target)\n              if not move_seq and cur_pos != target:\n                  return []  # unreachable\n              actions.extend(move_seq)\n              actions.append(4)          # USE to pick up\n              cur_pos = target\n              grid[target[0], target[1], prim_idx] = 0  # remove from local copy\n\n      # --------------------------------------------------------------\n      # Craft at required workshop (if any).\n      # --------------------------------------------------------------\n      recipe = world.cookbook.recipes.get(stick_idx, {})\n      workshop_kind = recipe.get(\"_at\")\n      if workshop_kind is not None:\n          ws_cells = find_cells(workshop_kind)\n          if not ws_cells:\n              return []\n          dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in ws_cells]\n          ws_target = ws_cells[int(np.argmin(dists))]\n          actions.extend(bfs(cur_pos, ws_target))\n          actions.append(4)  # USE to craft\n      else:\n          actions.append(4)  # USE to craft at current location\n\n      return actions\n  except Exception:\n      return []", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T17:54:58.968950", "function_name": "make_stick", "function_body": "  try:\n      # Reset environment and obtain the current CraftState\n      env.reset()\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          scenario = getattr(env, \"scenario\", None)\n          if scenario is not None:\n              state = scenario.init()\n      if state is None:\n          return []\n\n      world = state.world\n      grid = state.grid.copy()\n      h, w, _ = grid.shape\n      cur_pos = state.pos\n      actions = []\n\n      # ------------------------------------------------------------------\n      # Helper utilities\n      # ------------------------------------------------------------------\n      def find_cells(kind_idx):\n          \"\"\"Return list of (x, y) positions where `kind_idx` is present.\"\"\"\n          pts = np.argwhere(grid[:, :, kind_idx] > 0)\n          return [tuple(p) for p in pts]\n\n      # (dx, dy, action_id) \u2013 matches CraftLab ordering\n      DIRS = [\n          (1, 0, 0),   # DOWN\n          (-1, 0, 1),  # UP\n          (0, -1, 2),  # LEFT\n          (0, 1, 3),   # RIGHT\n      ]\n\n      def is_blocked(x, y):\n          \"\"\"Cell is blocked if any non\u2011grabbable entity occupies it.\"\"\"\n          for idx in world.non_grabbable_indices:\n              if grid[x, y, idx] > 0:\n                  return True\n          return False\n\n      from collections import deque\n\n      def bfs(start, goal):\n          \"\"\"Bread\u2011first search returning a list of movement actions.\"\"\"\n          q = deque()\n          q.append((start, []))\n          visited = {start}\n          while q:\n              (cx, cy), path = q.popleft()\n              if (cx, cy) == goal:\n                  return path\n              for dx, dy, act in DIRS:\n                  nx, ny = cx + dx, cy + dy\n                  if 0 <= nx < h and 0 <= ny < w and not is_blocked(nx, ny):\n                      if (nx, ny) not in visited:\n                          visited.add((nx, ny))\n                          q.append(((nx, ny), path + [act]))\n          # No path found \u2013 return empty list (caller will treat as failure)\n          return []\n\n      # ------------------------------------------------------------------\n      # Determine recipe for a stick\n      # ------------------------------------------------------------------\n      stick_idx = world.cookbook.index[\"stick\"]\n      primitive_requirements = world.cookbook.primitives_for(stick_idx)\n\n      # If there is no recipe, stick itself is a primitive \u2013 just pick it up\n      if not primitive_requirements:\n          stick_cells = find_cells(stick_idx)\n          if not stick_cells:\n              return []\n          # Choose nearest stick cell\n          dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in stick_cells]\n          target = stick_cells[int(np.argmin(dists))]\n          actions.extend(bfs(cur_pos, target))\n          actions.append(4)  # USE to pick up\n          return actions\n\n      # ------------------------------------------------------------------\n      # Collect required primitives\n      # ------------------------------------------------------------------\n      for prim_idx, needed_cnt in primitive_requirements.items():\n          for _ in range(needed_cnt):\n              prim_cells = find_cells(prim_idx)\n              if not prim_cells:\n                  return []  # missing primitive\n              # Nearest primitive (Manhattan distance)\n              dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in prim_cells]\n              target = prim_cells[int(np.argmin(dists))]\n              # Move to it\n              move_actions = bfs(cur_pos, target)\n              if not move_actions and cur_pos != target:\n                  return []  # unreachable\n              actions.extend(move_actions)\n              # Pick up\n              actions.append(4)  # USE\n              # Update local state\n              cur_pos = target\n              grid[target[0], target[1], prim_idx] = 0\n\n      # ------------------------------------------------------------------\n      # Craft the stick at the required workshop (if any)\n      # ------------------------------------------------------------------\n      recipe = world.cookbook.recipes.get(stick_idx, {})\n      workshop_kind = recipe.get(\"_at\")\n      if workshop_kind is not None:\n          ws_cells = find_cells(workshop_kind)\n          if not ws_cells:\n              return []  # no workshop present\n          dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in ws_cells]\n          ws_target = ws_cells[int(np.argmin(dists))]\n          actions.extend(bfs(cur_pos, ws_target))\n          actions.append(4)  # USE to craft\n      else:\n          # Craft at current location\n          actions.append(4)  # USE\n\n      return actions\n  except Exception:\n      # Fallback: return empty plan on any error\n      return []", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T17:55:38.218189", "function_name": "make_stick", "function_body": "  # Get the current state and world objects\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  # ----------------------------------------------------------------------\n  # Identify goal (stick) and its recipe requirements\n  # ----------------------------------------------------------------------\n  stick_idx = idx[\"stick\"]\n  # Primitive ingredients needed to craft a stick (dict {prim_idx: count})\n  needed_prims = world.cookbook.primitives_for(stick_idx)\n\n  # Workshop where the stick must be crafted (if any)\n  workshop_idx = None\n  recipe = getattr(world.cookbook, \"recipes\", {})\n  if stick_idx in recipe and \"_at\" in recipe[stick_idx]:\n      workshop_idx = recipe[stick_idx][\"_at\"]\n\n  # ----------------------------------------------------------------------\n  # Helpers\n  # ----------------------------------------------------------------------\n  blocked_kinds = world.non_grabbable_indices\n  act_map = env.action_specs()            # e.g. {\"UP\":0, \"DOWN\":1, ...}\n  inv_act = {v: k for k, v in act_map.items()}\n\n  def walkable(pos, grid):\n      \"\"\"Return True if the cell can be entered (no blocked entity).\"\"\"\n      x, y = pos\n      return not any(grid[x, y, k] > 0 for k in blocked_kinds)\n\n  def manhattan(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def adjacent_cells(target, grid):\n      \"\"\"All walkable cells orthogonal to target.\"\"\"\n      adj = []\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          ax, ay = target[0] + dx, target[1] + dy\n          if 0 <= ax < grid.shape[0] and 0 <= ay < grid.shape[1]:\n              if walkable((ax, ay), grid):\n                  adj.append((ax, ay))\n      return adj\n\n  def bfs(start, goals, grid):\n      \"\"\"Return list of positions from start to the nearest goal, or None.\"\"\"\n      from collections import deque\n      q = deque([start])\n      prev = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur in goals:\n              # reconstruct path\n              path = []\n              while cur is not None:\n                  path.append(cur)\n                  cur = prev[cur]\n              path.reverse()\n              return path\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n                  nxt = (nx, ny)\n                  if nxt not in prev and walkable(nxt, grid):\n                      prev[nxt] = cur\n                      q.append(nxt)\n      return None\n\n  def move_action(p, q):\n      \"\"\"Convert a step from p to q into an action index.\"\"\"\n      dx, dy = q[0] - p[0], q[1] - p[1]\n      if (dx, dy) == (-1, 0):\n          return act_map[\"UP\"]\n      if (dx, dy) == (1, 0):\n          return act_map[\"DOWN\"]\n      if (dx, dy) == (0, -1):\n          return act_map[\"LEFT\"]\n      if (dx, dy) == (0, 1):\n          return act_map[\"RIGHT\"]\n      raise ValueError(\"Invalid move\")\n\n  def face_and_use(target_pos, cur_state):\n      \"\"\"\n      Ensure the agent is facing `target_pos` from its current location,\n      then issue a USE action. Returns list of actions performed.\n      \"\"\"\n      actions_local = []\n      cur_x, cur_y = cur_state.pos\n      dx, dy = target_pos[0] - cur_x, target_pos[1] - cur_y\n\n      # Desired direction to face the target\n      if (dx, dy) == (-1, 0):\n          desired = act_map[\"UP\"]\n      elif (dx, dy) == (1, 0):\n          desired = act_map[\"DOWN\"]\n      elif (dx, dy) == (0, -1):\n          desired = act_map[\"LEFT\"]\n      elif (dx, dy) == (0, 1):\n          desired = act_map[\"RIGHT\"]\n      else:\n          # Already on same cell (should not happen)\n          desired = None\n\n      # If we are already facing the target (last move set that direction)\n      # we can directly USE. Otherwise we perform a small turn maneuver.\n      if desired is not None:\n          # Try to step one cell opposite direction then back to set facing.\n          opp_dir = {\"UP\": \"DOWN\", \"DOWN\": \"UP\", \"LEFT\": \"RIGHT\", \"RIGHT\": \"LEFT\"}\n          opp_act = act_map[opp_dir[inv_act[desired]]]\n          opp_dx, opp_dy = -dx, -dy\n          opp_pos = (cur_x + opp_dx, cur_y + opp_dy)\n          if (0 <= opp_pos[0] < cur_state.grid.shape[0] and\n              0 <= opp_pos[1] < cur_state.grid.shape[1] and\n              walkable(opp_pos, cur_state.grid)):\n              actions_local.append(opp_act)\n              _, cur_state = env.step(opp_act)\n              actions_local.append(desired)\n              _, cur_state = env.step(desired)\n          else:\n              # Fallback: dummy left-right turn\n              dummy = act_map[\"LEFT\"]\n              actions_local.append(dummy)\n              _, cur_state = env.step(dummy)\n              actions_local.append(desired)\n              _, cur_state = env.step(desired)\n      # Finally USE\n      actions_local.append(act_map[\"USE\"])\n      _, cur_state = env.step(act_map[\"USE\"])\n      return actions_local, cur_state\n\n  # ----------------------------------------------------------------------\n  # Main planning: collect primitives then craft at workshop (if needed)\n  # ----------------------------------------------------------------------\n  actions = []\n  cur_state = state\n  cur_pos = tuple(cur_state.pos)\n\n  # Collect each required primitive\n  for prim_idx, count in needed_prims.items():\n      for _ in range(count):\n          # Locate the primitive in the current grid\n          locs = np.argwhere(cur_state.grid[:, :, prim_idx] > 0)\n          if locs.shape[0] == 0:\n              raise RuntimeError(\"Required primitive not present in the grid.\")\n          prim_pos = tuple(locs[0].tolist())\n\n          # Choose a reachable adjacent cell\n          adj = adjacent_cells(prim_pos, cur_state.grid)\n          if not adj:\n              raise RuntimeError(\"No reachable adjacent cell to primitive.\")\n          path = bfs(cur_pos, set(adj), cur_state.grid)\n          if path is None:\n              raise RuntimeError(\"Cannot reach primitive.\")\n\n          # Follow the path (skip start)\n          for i in range(1, len(path)):\n              a = move_action(path[i - 1], path[i])\n              actions.append(a)\n              _, cur_state = env.step(a)\n              cur_pos = tuple(cur_state.pos)\n\n          # At this point we are on a cell adjacent to the primitive.\n          # Face it and USE to pick up.\n          extra, cur_state = face_and_use(prim_pos, cur_state)\n          actions.extend(extra)\n          cur_pos = tuple(cur_state.pos)\n\n  # If a workshop is required, move to it and craft\n  if workshop_idx is not None:\n      # Locate any workshop of that type\n      ws_locs = np.argwhere(cur_state.grid[:, :, workshop_idx] > 0)\n      if ws_locs.shape[0] == 0:\n          raise RuntimeError(\"Required workshop not found in the grid.\")\n      workshop_pos = tuple(ws_locs[0].tolist())\n\n      # Move adjacent to workshop\n      adj_ws = adjacent_cells(workshop_pos, cur_state.grid)\n      if not adj_ws:\n          raise RuntimeError(\"No reachable adjacent cell to workshop.\")\n      path = bfs(cur_pos, set(adj_ws), cur_state.grid)\n      if path is None:\n          raise RuntimeError(\"Cannot reach workshop.\")\n\n      for i in range(1, len(path)):\n          a = move_action(path[i - 1], path[i])\n          actions.append(a)\n          _, cur_state = env.step(a)\n          cur_pos = tuple(cur_state.pos)\n\n      # Face workshop and USE to craft the stick\n      extra, cur_state = face_and_use(workshop_pos, cur_state)\n      actions.extend(extra)\n      cur_pos = tuple(cur_state.pos)\n  else:\n      # No specific workshop: simply USE at current location (crafting occurs)\n      actions.append(act_map[\"USE\"])\n      _, cur_state = env.step(act_map[\"USE\"])\n\n  return actions", "env_interactions": 0, "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-10-21T17:55:39.338369", "function_name": "make_stick", "function_body": "  # reset environment and get initial state\n  env.reset()\n  state = env._current_state\n  world = env.world\n  act_map = env.action_specs()                     # e.g. {\"UP\":0, \"DOWN\":1, ...}\n  blocked = world.non_grabbable_indices            # kinds that block movement\n\n  # indices helper\n  idx = world.cookbook.index\n  stick_idx = idx[\"stick\"]\n\n  # recipe information\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_idx = recipe.get(\"_at\")                 # may be None\n\n  # ----------------------------------------------------------------------\n  # Helper functions\n  # ----------------------------------------------------------------------\n  def walkable(pos):\n      \"\"\"True if the cell does not contain any non\u2011grabbable entity.\"\"\"\n      x, y = pos\n      return not any(state.grid[x, y, k] > 0 for k in blocked)\n\n  def manhattan(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def bfs(start, targets):\n      \"\"\"Breadth\u2011first search from start to the nearest cell in *targets*.\n      Returns a list of positions (including start and target) or None.\"\"\"\n      from collections import deque\n      q = deque([start])\n      prev = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur in targets:\n              # reconstruct path\n              path = []\n              while cur is not None:\n                  path.append(cur)\n                  cur = prev[cur]\n              path.reverse()\n              return path\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                  nxt = (nx, ny)\n                  if nxt not in prev and walkable(nxt):\n                      prev[nxt] = cur\n                      q.append(nxt)\n      return None\n\n  def move_to_action(p, q):\n      \"\"\"Convert a step from p -> q into an action index.\"\"\"\n      dx, dy = q[0] - p[0], q[1] - p[1]\n      if (dx, dy) == (-1, 0):\n          return act_map[\"UP\"]\n      if (dx, dy) == (1, 0):\n          return act_map[\"DOWN\"]\n      if (dx, dy) == (0, -1):\n          return act_map[\"LEFT\"]\n      if (dx, dy) == (0, 1):\n          return act_map[\"RIGHT\"]\n      raise ValueError(\"Invalid move from {} to {}\".format(p, q))\n\n  # ----------------------------------------------------------------------\n  # Gather required primitive resources\n  # ----------------------------------------------------------------------\n  needed = world.cookbook.primitives_for(stick_idx)   # dict {prim_idx: count}\n  actions = []\n\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          # locate all cells containing this primitive\n          locations = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if locations.size == 0:\n              raise RuntimeError(f\"Primitive {prim_idx} not found on the map.\")\n          cur_pos = tuple(state.pos)\n          # try locations ordered by Manhattan distance until one is reachable\n          target_path = None\n          for loc in sorted([tuple(p) for p in locations],\n                            key=lambda p: manhattan(cur_pos, p)):\n              path = bfs(cur_pos, {loc})\n              if path is not None:\n                  target_path = path\n                  break\n          if target_path is None:\n              raise RuntimeError(\"No reachable primitive of required type.\")\n\n          # follow the path (skip the first node \u2013 we are already there)\n          for i in range(1, len(target_path)):\n              a = move_to_action(target_path[i - 1], target_path[i])\n              actions.append(a)\n              _, state = env.step(a)\n              env._current_state = state\n\n          # pick up the primitive (USE)\n          actions.append(act_map[\"USE\"])\n          _, state = env.step(act_map[\"USE\"])\n          env._current_state = state\n\n  # ----------------------------------------------------------------------\n  # Craft the stick at the appropriate workshop (if any)\n  # ----------------------------------------------------------------------\n  if workshop_idx is not None:\n      # find any workshop cell of the required kind\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          raise RuntimeError(\"Required workshop not present in the map.\")\n      cur_pos = tuple(state.pos)\n      target_path = None\n      for loc in sorted([tuple(p) for p in workshop_cells],\n                        key=lambda p: manhattan(cur_pos, p)):\n          path = bfs(cur_pos, {loc})\n          if path is not None:\n              target_path = path\n              break\n      if target_path is None:\n          raise RuntimeError(\"Cannot reach the required workshop.\")\n\n      # move to the workshop\n      for i in range(1, len(target_path)):\n          a = move_to_action(target_path[i - 1], target_path[i])\n          actions.append(a)\n          _, state = env.step(a)\n          env._current_state = state\n\n      # craft (USE)\n      actions.append(act_map[\"USE\"])\n      _, state = env.step(act_map[\"USE\"])\n      env._current_state = state\n  else:\n      # No specific workshop \u2013 a final USE will attempt crafting at current spot\n      actions.append(act_map[\"USE\"])\n      _, state = env.step(act_map[\"USE\"])\n      env._current_state = state\n\n  return actions", "env_interactions": 0, "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-10-21T17:56:02.819193", "function_name": "make_stick", "function_body": "  import numpy as np\n  # Reset environment to obtain initial state\n  env.reset()\n  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  # Identify the index for the target item \"stick\"\n  stick_idx = cookbook.index[\"stick\"]\n\n  # Determine which primitive resources are needed to craft a stick\n  needed_primitives = cookbook.primitives_for(stick_idx)  # {kind_idx: count}\n\n  actions = []\n  cur_pos = tuple(state.pos)  # (x, y)\n\n  # Helper to generate movement actions from cur_pos to target (updates cur_pos)\n  def move_to(target):\n      nonlocal cur_pos\n      acts = []\n      x, y = cur_pos\n      tx, ty = target\n      # move horizontally\n      while x < tx:\n          acts.append(craft.RIGHT)\n          x += 1\n      while x > tx:\n          acts.append(craft.LEFT)\n          x -= 1\n      # move vertically\n      while y < ty:\n          acts.append(craft.DOWN)\n          y += 1\n      while y > ty:\n          acts.append(craft.UP)\n          y -= 1\n      cur_pos = (x, y)\n      return acts\n\n  # Collect each required primitive\n  for kind_idx, needed_cnt in needed_primitives.items():\n      # Find all locations that currently contain this primitive\n      locations = list(zip(*np.where(state.grid[:, :, kind_idx] > 0)))\n      collected = 0\n      for loc in locations:\n          if collected >= needed_cnt:\n              break\n          # Move to the primitive location\n          actions.extend(move_to(loc))\n          # Use action to pick it up\n          actions.append(craft.USE)\n          # Simulate the USE step to keep our local state in sync\n          # (the environment will also execute these actions later)\n          # Update inventory count locally (optional, not required for path planning)\n          collected += 1\n      # If we didn't find enough instances, we simply continue; the environment\n      # will handle failures (this simplistic planner assumes enough resources exist).\n\n  # After gathering primitives, move to the appropriate workshop to craft the stick\n  workshop_kind = cookbook.recipes[stick_idx][\"_at\"]\n  workshop_locs = list(zip(*np.where(state.grid[:, :, workshop_kind] > 0)))\n  if not workshop_locs:\n      raise RuntimeError(\"No workshop found for crafting stick.\")\n  target_workshop = workshop_locs[0]\n  actions.extend(move_to(target_workshop))\n  # Use the workshop to craft the stick\n  actions.append(craft.USE)\n\n  return actions", "env_interactions": 0, "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-10-21T17:56:03.937802", "function_name": "make_stick", "function_body": "  import numpy as np\n\n  # ----------------------------------------------------------------------\n  # Helper functions\n  # ----------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions (env.DOWN/UP/LEFT/RIGHT) to go\n      from start (x, y) to goal (x, y) using a simple Manhattan walk.\"\"\"\n      x, y = start\n      gx, gy = goal\n      actions = []\n      # move in x direction\n      while x < gx:\n          actions.append(env.RIGHT)\n          x += 1\n      while x > gx:\n          actions.append(env.LEFT)\n          x -= 1\n      # move in y direction\n      while y < gy:\n          actions.append(env.DOWN)\n          y += 1\n      while y > gy:\n          actions.append(env.UP)\n          y -= 1\n      return actions\n\n  def nearest_cell(grid, kind_idx, cur_pos):\n      \"\"\"Find the nearest cell (Manhattan) that contains at least one\n      entity of kind `kind_idx`. Returns (x, y) coordinate.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          raise ValueError(f\"No cells found for kind index {kind_idx}\")\n      dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n      nearest = locations[dists.argmin()]\n      return tuple(nearest.tolist())\n\n  # ----------------------------------------------------------------------\n  # Main planning logic\n  # ----------------------------------------------------------------------\n  # Access current state and world information\n  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  # Index for the target item 'stick'\n  stick_idx = cookbook.index.index('stick')\n\n  # Determine recipe for stick (primitives + optional workshop)\n  recipe = cookbook.recipes.get(stick_idx, {})\n  # Separate the workshop spec (key \"_at\") from primitive requirements\n  workshop_kind = recipe.get('_at', None)\n  primitive_reqs = {k: v for k, v in recipe.items() if k != '_at'}\n\n  # Local copies of mutable structures for planning simulation\n  grid = state.grid.copy()\n  inventory = state.inventory.copy()\n  pos = tuple(state.pos)\n\n  plan_actions = []\n\n  # ------------------------------------------------------------------\n  # Gather all required primitive resources\n  # ------------------------------------------------------------------\n  for prim_kind, needed_cnt in primitive_reqs.items():\n      while inventory[prim_kind] < needed_cnt:\n          # locate nearest source of this primitive\n          target = nearest_cell(grid, prim_kind, pos)\n\n          # move to the primitive cell\n          plan_actions.extend(manhattan_path(pos, target))\n          pos = target\n\n          # pick it up (USE)\n          plan_actions.append(env.USE)\n\n          # Simulate the effect of USE on a primitive cell:\n          #   - increase inventory\n          #   - remove one instance from the grid\n          inventory[prim_kind] += 1\n          # find a concrete cell that actually contains the item (there may be >1)\n          # we simply decrement the first positive entry we encounter\n          cell_layer = grid[:, :, prim_kind]\n          xy = np.argwhere(cell_layer > 0)[0]  # guaranteed to exist\n          grid[xy[0], xy[1], prim_kind] -= 1\n\n  # ------------------------------------------------------------------\n  # Move to the appropriate workshop (if required) and craft the stick\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      # locate nearest workshop of the required type\n      workshop_pos = nearest_cell(grid, workshop_kind, pos)\n\n      # move to workshop\n      plan_actions.extend(manhattan_path(pos, workshop_pos))\n      pos = workshop_pos\n\n  # Use the workshop to craft the stick\n  plan_actions.append(env.USE)\n\n  # Return the complete action sequence\n  return plan_actions", "env_interactions": 0, "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-10-21T17:56:56.865371", "function_name": "make_stick", "function_body": "  import numpy as np\n\n  actions = []\n  max_steps = 2000\n  steps_taken = 0\n\n  # Get goal index from the task (CraftLab stores it in env.task.goal)\n  if not hasattr(env, \"task\") or not hasattr(env.task, \"goal\"):\n      return actions\n  goal_idx = env.task.goal\n\n  world = env.world\n  cookbook = world.cookbook\n\n  # Primitive requirements for one unit of the goal\n  needed_prims = cookbook.primitives_for(goal_idx)\n\n  # Helper: move the agent to a specific grid coordinate (ignoring obstacles)\n  def move_to(target_pos):\n      nonlocal steps_taken\n      while env._current_state.pos != target_pos and steps_taken < max_steps:\n          x, y = env._current_state.pos\n          tx, ty = target_pos\n          if x < tx:\n              act = 3  # RIGHT\n          elif x > tx:\n              act = 2  # LEFT\n          elif y < ty:\n              act = 0  # DOWN\n          elif y > ty:\n              act = 1  # UP\n          else:\n              break\n          actions.append(act)\n          env.step(act)\n          steps_taken += 1\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitive resources\n  # ------------------------------------------------------------------\n  for prim_idx, required_cnt in needed_prims.items():\n      while env._current_state.inventory[prim_idx] < required_cnt and steps_taken < max_steps:\n          # Find any cell that currently holds this primitive\n          prim_grid = env._current_state.grid[:, :, prim_idx]\n          candidates = np.argwhere(prim_grid > 0)\n          if len(candidates) == 0:\n              # No more of this primitive on the map \u2013 give up\n              break\n          # Choose the first candidate (could be improved with nearest\u2011search)\n          prim_pos = tuple(candidates[0])\n\n          # Move to the primitive cell (or adjacent \u2013 using same cell works for most maps)\n          move_to(prim_pos)\n\n          # Use the item (pick up)\n          actions.append(4)  # USE\n          env.step(4)\n          steps_taken += 1\n\n  # ------------------------------------------------------------------\n  # 2) Craft the goal at its required workshop (if any)\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  for k, v in recipe.items():\n      # non\u2011integer keys encode the workshop type (e.g., \"_key\" or \"_at\")\n      if not isinstance(k, int):\n          workshop_kind = v\n          break\n\n  if workshop_kind is not None and steps_taken < max_steps:\n      # Locate a workshop of the required type\n      wk_grid = env._current_state.grid[:, :, workshop_kind]\n      wk_candidates = np.argwhere(wk_grid > 0)\n      if len(wk_candidates) > 0:\n          wk_pos = tuple(wk_candidates[0])\n          move_to(wk_pos)\n          # Attempt to craft using USE\n          actions.append(4)  # USE\n          env.step(4)\n          steps_taken += 1\n\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T17:56:57.987141", "function_name": "make_stick", "function_body": "  # Ensure the environment is in a fresh state\n  env.reset()\n  # Access the underlying CraftState\n  state = env._current_state\n  grid = state.grid\n  pos = state.pos  # (row, col)\n\n  # Identify the index for the stick item\n  stick_name = \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[stick_name]\n  except Exception:\n      # If the name is not found, return empty plan\n      return []\n\n  # Locate all cells that contain a stick\n  stick_cells = list(zip(*np.where(grid[:, :, stick_idx] > 0)))\n  if not stick_cells:\n      return []  # No sticks present in the scenario\n\n  # Pre\u2011compute traversable cells (empty cells only)\n  traversable = np.sum(grid, axis=2) == 0\n  H, W = grid.shape[0], grid.shape[1]\n\n  # Mapping of moves: (dx, dy, action_index)\n  # Action indices follow CraftLab.action_specs: DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n  moves = [\n      (1, 0, 0),   # DOWN\n      (-1, 0, 1),  # UP\n      (0, -1, 2),  # LEFT\n      (0, 1, 3),   # RIGHT\n  ]\n\n  # Breadth\u2011first search for a path that ends adjacent to a stick\n  # with the last move facing the stick, then issue a USE action.\n  from collections import deque\n  visited = set()\n  queue = deque()\n  queue.append((pos[0], pos[1], []))\n  visited.add((pos[0], pos[1]))\n\n  while queue:\n      x, y, path = queue.popleft()\n      for dx, dy, act in moves:\n          nx, ny = x + dx, y + dy\n          if not (0 <= nx < H and 0 <= ny < W):\n              continue\n          if not traversable[nx, ny]:\n              continue\n          if (nx, ny) in visited:\n              continue\n\n          new_path = path + [act]\n\n          # Check if the new position is adjacent to any stick cell\n          for sx, sy in stick_cells:\n              if abs(nx - sx) + abs(ny - sy) == 1:\n                  # Determine which direction would face the stick from (nx, ny)\n                  needed_dir = None\n                  if nx == sx + 1 and ny == sy:\n                      needed_dir = 1   # UP\n                  elif nx == sx - 1 and ny == sy:\n                      needed_dir = 0   # DOWN\n                  elif nx == sx and ny == sy + 1:\n                      needed_dir = 2   # LEFT\n                  elif nx == sx and ny == sy - 1:\n                      needed_dir = 3   # RIGHT\n\n                  # The action that moved us to (nx, ny) is `act`.\n                  # If it already points toward the stick, we can collect.\n                  if needed_dir is not None and act == needed_dir:\n                      return new_path + [4]   # Append USE action\n\n          visited.add((nx, ny))\n          queue.append((nx, ny, new_path))\n\n  # If no suitable path was found, return an empty plan.\n  return []", "env_interactions": 0, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T17:57:28.543693", "function_name": "make_stick", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  # Get index for 'stick'\n  try:\n      goal_idx = cookbook.index[\"stick\"]\n  except Exception:\n      return []\n\n  # Determine primitive requirements (recursive)\n  prim_needed = cookbook.primitives_for(goal_idx)  # dict {prim_idx: count}\n  # If empty, stick is a primitive itself\n  act_map = env.action_specs()\n  DOWN = act_map.get(\"DOWN\", 0)\n  UP = act_map.get(\"UP\", 1)\n  LEFT = act_map.get(\"LEFT\", 2)\n  RIGHT = act_map.get(\"RIGHT\", 3)\n  USE = act_map.get(\"USE\", 4)\n\n  def _moves(start, target):\n      cx, cy = start\n      tx, ty = target\n      moves = []\n      while cx < tx:\n          moves.append(DOWN)\n          cx += 1\n      while cx > tx:\n          moves.append(UP)\n          cx -= 1\n      while cy < ty:\n          moves.append(RIGHT)\n          cy += 1\n      while cy > ty:\n          moves.append(LEFT)\n          cy -= 1\n      return moves\n\n  plan = []\n  cur_pos = state.pos\n  grid = state.grid\n\n  # Helper to collect a required primitive type\n  def _collect_primitive(p_idx, count, cur):\n      locations = [tuple(pos) for pos in np.argwhere(grid[:, :, p_idx] > 0)]\n      collected = 0\n      while collected < count and locations:\n          # choose nearest\n          dists = [abs(cur[0] - x) + abs(cur[1] - y) for (x, y) in locations]\n          nearest = int(np.argmin(dists))\n          target = locations.pop(nearest)\n          moves = _moves(cur, target)\n          cur = target\n          moves.append(USE)  # pick up\n          yield moves, cur\n          collected += 1\n\n  if prim_needed:\n      # Collect each primitive according to recipe\n      for p_idx, cnt in prim_needed.items():\n          for moves, cur_pos in _collect_primitive(p_idx, cnt, cur_pos):\n              plan.extend(moves)\n\n      # Find a suitable workshop (prefer the one required by recipe)\n      workshop_pos = None\n      recipe = cookbook.recipes.get(goal_idx, {})\n      wk_name = recipe.get(\"_at\")\n      if wk_name is not None:\n          try:\n              wk_idx = cookbook.index[wk_name]\n              cells = np.argwhere(grid[:, :, wk_idx] > 0)\n              if cells.size:\n                  workshop_pos = tuple(cells[0])\n          except Exception:\n              workshop_pos = None\n      if workshop_pos is None:\n          for wk_idx in world.workshop_indices:\n              cells = np.argwhere(grid[:, :, wk_idx] > 0)\n              if cells.size:\n                  workshop_pos = tuple(cells[0])\n                  break\n\n      if workshop_pos is not None:\n          plan.extend(_moves(cur_pos, workshop_pos))\n          cur_pos = workshop_pos\n      plan.append(USE)  # craft at workshop (or current cell)\n  else:\n      # Stick itself is a primitive; just pick it up\n      locations = [tuple(pos) for pos in np.argwhere(grid[:, :, goal_idx] > 0)]\n      if locations:\n          dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in locations]\n          nearest = int(np.argmin(dists))\n          target = locations.pop(nearest)\n          plan.extend(_moves(cur_pos, target))\n          plan.append(USE)\n\n  return plan", "env_interactions": 4, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T17:57:29.656946", "function_name": "make_stick", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  # Identify the index for the \"stick\" goal\n  try:\n      goal_idx = cookbook.index[\"stick\"]\n  except Exception:\n      return []\n\n  # Recipe and primitive requirements (may be empty if stick is a primitive)\n  recipe = cookbook.recipes.get(goal_idx, {})\n  prim_req = cookbook.primitives_for(goal_idx)          # {prim_idx: count}\n\n  # Action mapping\n  act_map = env.action_specs()\n  DOWN = act_map.get(\"DOWN\", 0)\n  UP = act_map.get(\"UP\", 1)\n  LEFT = act_map.get(\"LEFT\", 2)\n  RIGHT = act_map.get(\"RIGHT\", 3)\n  USE = act_map.get(\"USE\", 4)\n\n  # Helper: Manhattan moves from start \u2192 target\n  def _moves(start, target):\n      cx, cy = start\n      tx, ty = target\n      moves = []\n      while cx < tx:\n          moves.append(DOWN)\n          cx += 1\n      while cx > tx:\n          moves.append(UP)\n          cx -= 1\n      while cy < ty:\n          moves.append(RIGHT)\n          cy += 1\n      while cy > ty:\n          moves.append(LEFT)\n          cy -= 1\n      return moves\n\n  cur_pos = state.pos\n  plan = []\n  grid = state.grid\n\n  # ------------------------------------------------------------------\n  # Case 1: stick must be crafted from primitives\n  # ------------------------------------------------------------------\n  if prim_req:\n      # Collect each required primitive (respecting required counts)\n      for p_idx, needed in prim_req.items():\n          # Find all cells containing this primitive\n          locations = [tuple(p) for p in np.argwhere(grid[:, :, p_idx] > 0)]\n          collected = 0\n          while collected < needed and locations:\n              # Choose the nearest primitive\n              dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in locations]\n              nearest = int(np.argmin(dists))\n              target = locations.pop(nearest)\n\n              # Move to the primitive and pick it up\n              plan.extend(_moves(cur_pos, target))\n              cur_pos = target\n              plan.append(USE)          # pick\u2011up action\n              collected += 1\n\n          # If we ran out of this primitive before satisfying the count, abort\n          if collected < needed:\n              return plan\n\n      # After gathering all ingredients, go to the appropriate workshop (if any)\n      workshop_pos = None\n\n      # Prefer the workshop explicitly required by the recipe\n      wk_name = recipe.get(\"_at\")\n      if wk_name is not None:\n          try:\n              wk_idx = cookbook.index[wk_name]\n              cells = np.argwhere(grid[:, :, wk_idx] > 0)\n              if cells.size:\n                  workshop_pos = tuple(cells[0])\n          except Exception:\n              workshop_pos = None\n\n      # Fallback: any workshop present in the world\n      if workshop_pos is None:\n          for wk_idx in world.workshop_indices:\n              cells = np.argwhere(grid[:, :, wk_idx] > 0)\n              if cells.size:\n                  workshop_pos = tuple(cells[0])\n                  break\n\n      if workshop_pos is not None:\n          plan.extend(_moves(cur_pos, workshop_pos))\n          cur_pos = workshop_pos\n\n      # Final USE triggers crafting at the workshop (or at current cell)\n      plan.append(USE)\n\n  # ------------------------------------------------------------------\n  # Case 2: stick itself is a primitive \u2013 just pick it up\n  # ------------------------------------------------------------------\n  else:\n      stick_locs = [tuple(p) for p in np.argwhere(grid[:, :, goal_idx] > 0)]\n      if stick_locs:\n          dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in stick_locs]\n          nearest = int(np.argmin(dists))\n          target = stick_locs[nearest]\n          plan.extend(_moves(cur_pos, target))\n          plan.append(USE)\n\n  return plan", "env_interactions": 4, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T17:57:55.912753", "function_name": "make_stick", "function_body": "  actions = []\n  world = env.world\n  state = env._current_state\n\n  # goal index for \"stick\"\n  stick_idx = world.cookbook.index[\"stick\"]\n  if state.inventory[stick_idx] > 0:\n      return actions\n\n  # ------------------------------------------------------------------\n  # Helper functions\n  # ------------------------------------------------------------------\n  def move_action(src, dst):\n      \"\"\"Return the integer action that moves from src to dst (orthogonal).\"\"\"\n      dx = dst[0] - src[0]\n      dy = dst[1] - src[1]\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise ValueError(\"Non\u2011adjacent move\")\n\n  def bfs_to_adjacent(start, targets, grid):\n      \"\"\"\n      Breadth\u2011first search for the shortest path from start to any empty cell\n      that is orthogonally adjacent to one of the target cells.\n      Returns a list of positions (including start). Raises if unreachable.\n      \"\"\"\n      from collections import deque\n      W, H, _ = grid.shape\n      visited = np.zeros((W, H), dtype=bool)\n      q = deque()\n      q.append((start, [start]))\n      visited[start] = True\n      target_set = {tuple(t) for t in targets}\n      while q:\n          (x, y), path = q.popleft()\n          # adjacency test\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n          # explore neighbours through empty cells only\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if grid[nx, ny, :].sum() == 0:   # cell is empty\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [(nx, ny)]))\n      raise RuntimeError(\"No reachable adjacent cell found\")\n\n  # ------------------------------------------------------------------\n  # 1) Gather all primitive resources required for a stick\n  # ------------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n  cur_pos = tuple(state.pos)\n\n  for prim_idx, required_cnt in primitive_needs.items():\n      while state.inventory[prim_idx] < required_cnt:\n          # locate cells that currently contain this primitive\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(\"Required primitive not present in the world\")\n          # find shortest path to an empty cell adjacent to any primitive cell\n          path = bfs_to_adjacent(cur_pos, prim_cells, state.grid)\n          # convert the path into movement actions\n          for nxt in path[1:]:\n              actions.append(move_action(cur_pos, nxt))\n              cur_pos = nxt\n          # use (pick up) the primitive\n          actions.append(4)   # USE\n          # simulate removal so we don't target the same instance again\n          target = prim_cells[0]\n          state.grid[target[0], target[1], prim_idx] = 0\n          state.inventory[prim_idx] += 1\n\n  # ------------------------------------------------------------------\n  # 2) Move to the appropriate workshop (if any) and craft the stick\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          raise RuntimeError(\"Workshop for stick not found\")\n      path = bfs_to_adjacent(cur_pos, workshop_cells, state.grid)\n      for nxt in path[1:]:\n          actions.append(move_action(cur_pos, nxt))\n          cur_pos = nxt\n\n  # final USE to craft the stick\n  actions.append(4)   # USE\n  return actions", "env_interactions": 3, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T17:57:57.038001", "function_name": "make_stick", "function_body": "  actions = []\n  world = env.world\n  state = env._current_state\n\n  stick_idx = world.cookbook.index[\"stick\"]\n  if state.inventory[stick_idx] > 0:\n      return actions\n\n  def move_action(cur, nxt):\n      dx = nxt[0] - cur[0]\n      dy = nxt[1] - cur[1]\n      if dx == 1:\n          return 3   # RIGHT\n      if dx == -1:\n          return 2   # LEFT\n      if dy == 1:\n          return 0   # DOWN\n      if dy == -1:\n          return 1   # UP\n      raise ValueError(\"Invalid move step\")\n\n  def bfs_adjacent(start, targets, grid):\n      W, H, _ = grid.shape\n      visited = np.full((W, H), False, dtype=bool)\n      q = collections.deque()\n      q.append((start, [start]))\n      visited[start] = True\n      target_set = {tuple(t) for t in targets}\n      while q:\n          (x, y), path = q.popleft()\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n          for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if grid[nx, ny, :].sum() == 0:   # empty cell\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [(nx, ny)]))\n      raise RuntimeError(\"No reachable adjacent cell\")\n\n  # ------------------------------------------------------------\n  # 1) Collect required primitives for a stick\n  # ------------------------------------------------------------\n  primitive_req = world.cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n  cur_pos = tuple(state.pos)\n\n  for prim_idx, needed in primitive_req.items():\n      for _ in range(needed):\n          if state.inventory[prim_idx] > 0:\n              continue\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(\"Required primitive not present\")\n          path = bfs_adjacent(cur_pos, prim_cells, state.grid)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n          actions.append(4)   # USE to pick up\n          # Mark the primitive as collected so we don't target it again\n          cell = prim_cells[0]\n          state.grid[cell[0], cell[1], prim_idx] = 0\n\n  # ------------------------------------------------------------\n  # 2) Move to workshop (if needed) and craft the stick\n  # ------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          raise RuntimeError(\"Workshop for stick not found\")\n      path = bfs_adjacent(cur_pos, workshop_cells, state.grid)\n      for step in path[1:]:\n          actions.append(move_action(cur_pos, step))\n          cur_pos = step\n\n  actions.append(4)   # USE to craft the stick\n  return actions", "env_interactions": 3, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T17:58:35.794414", "function_name": "make_stick", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ----------------------------------------------------------------------\n  # Helper utilities (local to the function)\n  # ----------------------------------------------------------------------\n  # Direction indices as used by the environment\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  DIR_DELTAS = {\n      DOWN:  (0, 1),\n      UP:    (0, -1),\n      LEFT:  (-1, 0),\n      RIGHT: (1, 0),\n  }\n  OPPOSITE = {DOWN: UP, UP: DOWN, LEFT: RIGHT, RIGHT: LEFT}\n\n  def in_bounds(x, y, w, h):\n      return 0 <= x < w and 0 <= y < h\n\n  def cell_is_free(grid, x, y):\n      \"\"\"A cell is free if no entity of any kind occupies it.\"\"\"\n      return grid[x, y, :].sum() == 0\n\n  def move(pos, action):\n      dx, dy = DIR_DELTAS[action]\n      return (pos[0] + dx, pos[1] + dy)\n\n  def bfs_path(start, targets, grid):\n      \"\"\"Bread\u2011first search from start to any cell in *targets*.\n      Returns a list of actions (may be empty) that reaches the first\n      target found.  The search only walks through free cells.\n      \"\"\"\n      w, h, _ = grid.shape\n      q = deque()\n      q.append(start)\n      visited = {start: (None, None)}          # pos -> (prev_pos, action_to_here)\n\n      while q:\n          cur = q.popleft()\n          if cur in targets:\n              # reconstruct path\n              actions = []\n              while visited[cur][0] is not None:\n                  prev, act = visited[cur]\n                  actions.append(act)\n                  cur = prev\n              actions.reverse()\n              return actions, cur          # also return the reached target cell\n          for a in (DOWN, UP, LEFT, RIGHT):\n              nx, ny = move(cur, a)\n              if not in_bounds(nx, ny, w, h):\n                  continue\n              if not cell_is_free(grid, nx, ny):\n                  continue\n              nxt = (nx, ny)\n              if nxt not in visited:\n                  visited[nxt] = (cur, a)\n                  q.append(nxt)\n      # No reachable target \u2013 return empty path and original position\n      return [], start\n\n  def nearest_adjacent(target_pos, grid):\n      \"\"\"Return a set of free cells adjacent to *target_pos*.\"\"\"\n      w, h, _ = grid.shape\n      adj = set()\n      tx, ty = target_pos\n      for a in (DOWN, UP, LEFT, RIGHT):\n          nx, ny = move(target_pos, a)\n          if in_bounds(nx, ny, w, h) and cell_is_free(grid, nx, ny):\n              adj.add((nx, ny))\n      return adj\n\n  def direction_towards(src, dst):\n      \"\"\"Return the direction index that points from src to an adjacent dst.\"\"\"\n      sx, sy = src\n      dx, dy = dst[0] - sx, dst[1] - sy\n      if dx == 1:\n          return RIGHT\n      if dx == -1:\n          return LEFT\n      if dy == 1:\n          return DOWN\n      if dy == -1:\n          return UP\n      raise ValueError(\"src not adjacent to dst\")\n\n  # ----------------------------------------------------------------------\n  # Start of the actual planning logic\n  # ----------------------------------------------------------------------\n  world = env.world                       # CraftWorld instance\n  state = env._current_state              # CraftState instance\n  grid = np.copy(state.grid)              # current grid layout\n  pos = tuple(state.pos)                  # (x, y)\n  direction = int(state.dir)              # current facing direction\n\n  # ------------------------------------------------------------------\n  # Identify the goal (stick) and its recipe\n  # ------------------------------------------------------------------\n  stick_idx = world.cookbook.index[\"stick\"]\n  # Primitive requirements for a stick (may be empty if stick itself is primitive)\n  primitive_needs = world.cookbook.primitives_for(stick_idx)\n\n  # ------------------------------------------------------------------\n  # Helper to update our simulated position / direction after executing actions\n  # ------------------------------------------------------------------\n  def simulate_actions(actions, cur_pos, cur_dir):\n      for a in actions:\n          if a == USE:\n              # USE does not change position or direction\n              continue\n          # movement: update position and direction\n          nx, ny = move(cur_pos, a)\n          cur_pos = (nx, ny)\n          cur_dir = a\n      return cur_pos, cur_dir\n\n  # ------------------------------------------------------------------\n  # Collect required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, need_cnt in primitive_needs.items():\n      while need_cnt > 0:\n          # locate all cells that currently contain this primitive\n          prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not prim_cells:\n              # No more primitives of this type on the map \u2013 give up\n              return []\n\n          # pick the closest primitive (Manhattan distance)\n          prim_cells.sort(key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n          target = prim_cells[0]\n\n          # compute free adjacent cells to the primitive\n          adj_cells = nearest_adjacent(target, grid)\n          if not adj_cells:\n              # cannot approach this primitive; skip it\n              # (unlikely in standard maps)\n              need_cnt -= 1\n              continue\n\n          # plan a path to one of the adjacent cells\n          move_actions, reached_adj = bfs_path(pos, adj_cells, grid)\n\n          # after reaching the adjacent cell we must be facing the primitive\n          needed_dir = direction_towards(reached_adj, target)\n          if direction != needed_dir:\n              # try a simple turn: step one cell opposite then step back\n              opp = OPPOSITE[needed_dir]\n              # verify we can step opposite direction\n              opp_pos = move(reached_adj, opp)\n              if in_bounds(*opp_pos, *grid.shape[:2]) and cell_is_free(grid, *opp_pos):\n                  move_actions.append(opp)            # step away\n                  move_actions.append(needed_dir)     # step back (now facing target)\n              else:\n                  # fallback \u2013 just move in the needed direction (may step onto the primitive,\n                  # which is allowed for collection in the environment)\n                  move_actions.append(needed_dir)\n\n          # finally, use the tool / collect\n          move_actions.append(USE)\n\n          # Append to global action list\n          actions.extend(move_actions)\n\n          # Simulate the effect on our internal view of the world\n          pos, direction = simulate_actions(move_actions, pos, direction)\n\n          # Update grid: remove the primitive we just collected\n          # (the environment will also do this when actions are actually run)\n          grid[target[0], target[1], prim_idx] = 0\n\n          need_cnt -= 1\n\n  # ------------------------------------------------------------------\n  # If the stick itself is a primitive (no recipe), we are done\n  # ------------------------------------------------------------------\n  if not primitive_needs:\n      # just locate a stick cell and collect it\n      stick_cells = list(zip(*np.where(grid[:, :, stick_idx] > 0)))\n      if stick_cells:\n          target = stick_cells[0]\n          adj_cells = nearest_adjacent(target, grid)\n          if adj_cells:\n              move_actions, reached_adj = bfs_path(pos, adj_cells, grid)\n              needed_dir = direction_towards(reached_adj, target)\n              if direction != needed_dir:\n                  opp = OPPOSITE[needed_dir]\n                  opp_pos = move(reached_adj, opp)\n                  if in_bounds(*opp_pos, *grid.shape[:2]) and cell_is_free(grid, *opp_pos):\n                      move_actions.append(opp)\n                      move_actions.append(needed_dir)\n                  else:\n                      move_actions.append(needed_dir)\n              move_actions.append(USE)\n              actions.extend(move_actions)\n      return actions\n\n  # ------------------------------------------------------------------\n  # Craft the stick at its required workshop\n  # ------------------------------------------------------------------\n  # Identify workshop required by the recipe (key \"_at\")\n  recipe_dict = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe_dict.get(\"_at\")\n  if workshop_name is None:\n      # no specific workshop \u2013 assume crafting can be done anywhere\n      # just return the actions collected so far\n      return actions\n\n  workshop_idx = world.cookbook.index[workshop_name]\n  # locate workshop cells (there may be several)\n  workshop_cells = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))\n  if not workshop_cells:\n      # no workshop on map \u2013 cannot craft\n      return actions\n\n  # pick the nearest workshop\n  workshop_cells.sort(key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n  workshop_target = workshop_cells[0]\n\n  # move adjacent to the workshop\n  adj_cells = nearest_adjacent(workshop_target, grid)\n  if not adj_cells:\n      # cannot approach workshop; give up\n      return actions\n\n  move_actions, reached_adj = bfs_path(pos, adj_cells, grid)\n\n  # face the workshop before using\n  needed_dir = direction_towards(reached_adj, workshop_target)\n  if direction != needed_dir:\n      opp = OPPOSITE[needed_dir]\n      opp_pos = move(reached_adj, opp)\n      if in_bounds(*opp_pos, *grid.shape[:2]) and cell_is_free(grid, *opp_pos):\n          move_actions.append(opp)\n          move_actions.append(needed_dir)\n      else:\n          move_actions.append(needed_dir)\n\n  # USE to craft the stick\n  move_actions.append(USE)\n\n  actions.extend(move_actions)\n\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": -1}}
