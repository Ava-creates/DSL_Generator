{"timestamp": "2025-10-21T16:08:56.940028", "function_name": "make_stick", "function_body": "  import numpy as np\n  from collections import deque\n\n  # reset environment to obtain initial state\n  env.reset()\n  state = env._current_state\n  world = env.world\n\n  # goal item\n  goal_name = \"stick\"\n  goal_idx = world.cookbook.index[goal_name]\n\n  # recipe for the goal\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  ingredients = {k: v for k, v in recipe.items() if k != \"_at\"}\n  workshop_idx = recipe.get(\"_at\")\n\n  # indices of entities that block movement\n  non_grabbable = list(world.non_grabbable_indices)\n\n  # helper: check if a cell is blocked\n  def cell_blocked(x, y):\n      W, H = state.grid.shape[0], state.grid.shape[1]\n      if x < 0 or x >= W or y < 0 or y >= H:\n          return True\n      if non_grabbable:\n          return np.any(state.grid[x, y, non_grabbable] > 0)\n      return False\n\n  # BFS to compute a sequence of movement actions from start to goal\n  # action IDs: DOWN=0, UP=1, LEFT=2, RIGHT=3\n  moves = [(0, 1), (0, -1), (-1, 0), (1, 0)]  # (dx, dy) for actions 0..3\n\n  def bfs(start, goal):\n      if start == goal:\n          return []\n      W, H = state.grid.shape[0], state.grid.shape[1]\n      visited = np.full((W, H), False, dtype=bool)\n      parent = {}\n      q = deque([start])\n      visited[start] = True\n      while q:\n          cx, cy = q.popleft()\n          if (cx, cy) == goal:\n              break\n          for act_id, (dx, dy) in enumerate(moves):\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny] and not cell_blocked(nx, ny):\n                  visited[nx, ny] = True\n                  parent[(nx, ny)] = ((cx, cy), act_id)\n                  q.append((nx, ny))\n      if goal not in parent and start != goal:\n          return []  # unreachable\n      path = []\n      cur = goal\n      while cur != start:\n          prev, act = parent[cur]\n          path.append(act)\n          cur = prev\n      return list(reversed(path))\n\n  action_sequence = []\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitive items\n  # ------------------------------------------------------------------\n  for ing_idx, qty in ingredients.items():\n      for _ in range(qty):\n          # locate the first occurrence of the needed primitive\n          positions = np.argwhere(state.grid[:, :, ing_idx] > 0)\n          if len(positions) == 0:\n              # primitive not found \u2013 abort early\n              return action_sequence\n          target_pos = tuple(positions[0])\n\n          # move to the primitive location\n          move_actions = bfs(state.pos, target_pos)\n          action_sequence.extend(move_actions)\n          for a in move_actions:\n              _, state = env.step(a)\n\n          # use the cell to pick up the primitive\n          _, state = env.step(4)  # USE action\n          action_sequence.append(4)\n\n  # ------------------------------------------------------------------\n  # 2) Go to the appropriate workshop and craft the stick\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if len(workshop_cells) > 0:\n          workshop_pos = tuple(workshop_cells[0])\n\n          move_actions = bfs(state.pos, workshop_pos)\n          action_sequence.extend(move_actions)\n          for a in move_actions:\n              _, state = env.step(a)\n\n          # craft at the workshop\n          _, state = env.step(4)  # USE\n          action_sequence.append(4)\n\n  return action_sequence", "env_interactions": 0, "island_id": 8, "scores": {"3": -1}}
