{"timestamp": "2025-10-21T18:28:47.235600", "function_name": "make_stick", "function_body": "  # action mapping\n  amap = env.action_specs()\n  DOWN = amap.get(\"DOWN\", 0)\n  UP = amap.get(\"UP\", 1)\n  LEFT = amap.get(\"LEFT\", 2)\n  RIGHT = amap.get(\"RIGHT\", 3)\n  USE = amap.get(\"USE\", 4)\n\n  DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]\n\n  # goal index\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      return []\n\n  # world, cookbook, state\n  world = getattr(env, \"world\", None)\n  if world is None:\n      return []\n  cookbook = getattr(world, \"cookbook\", None)\n  if cookbook is None:\n      return []\n\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []\n  grid = getattr(state, \"grid\", None)\n  pos = getattr(state, \"pos\", None)\n  if grid is None or pos is None:\n      return []\n\n  H, W = grid.shape[0], grid.shape[1]\n\n  # helpers --------------------------------------------------------------\n  def in_bounds(p):\n      return 0 <= p[0] < H and 0 <= p[1] < W\n\n  non_grabbable = set(world.non_grabbable_indices)\n\n  def walkable(p):\n      if not in_bounds(p):\n          return False\n      for idx in non_grabbable:\n          if grid[p[0], p[1], idx] > 0:\n              return False\n      return True\n\n  from collections import deque\n\n  def bfs_path(start, targets):\n      \"\"\"return list of actions from start to nearest cell in targets, or None.\"\"\"\n      target_set = set(targets)\n      if start in target_set:\n          return []\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          cur, path = q.popleft()\n          for dx, dy, act in DIRS:\n              nxt = (cur[0] + dx, cur[1] + dy)\n              if not in_bounds(nxt) or not walkable(nxt):\n                  continue\n              if nxt in visited:\n                  continue\n              new_path = path + [act]\n              if nxt in target_set:\n                  return new_path\n              visited.add(nxt)\n              q.append((nxt, new_path))\n      return None\n\n  # ----------------------------------------------------------------------\n  # determine primitives we need\n  primitives_needed = cookbook.primitives_for(goal_idx)\n  if not primitives_needed:\n      primitives_needed = {goal_idx: 1}\n\n  actions = []\n  cur_pos = pos\n\n  # ----------------------------------------------------------------------\n  # collect each primitive\n  for prim_idx, needed in primitives_needed.items():\n      collected = 0\n      while collected < needed:\n          # cells containing this primitive\n          cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not cells:\n              return []  # cannot find required primitive\n          # pick reachable cell with shortest BFS distance\n          best_path = None\n          best_target = None\n          for cell in cells:\n              p = bfs_path(cur_pos, [cell])\n              if p is not None and (best_path is None or len(p) < len(best_path)):\n                  best_path = p\n                  best_target = cell\n          if best_path is None:\n              return []  # unreachable\n          actions.extend(best_path)\n          cur_pos = best_target\n          actions.append(USE)          # pick up\n          collected += 1\n          grid[cur_pos[0], cur_pos[1], prim_idx] = 0   # update internal view\n\n  # ----------------------------------------------------------------------\n  # move to workshop (if any) and craft\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n\n  if workshop_kind is not None:\n      ws_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n      if not ws_cells:\n          return []\n      best_path = None\n      best_target = None\n      for cell in ws_cells:\n          p = bfs_path(cur_pos, [cell])\n          if p is not None and (best_path is None or len(p) < len(best_path)):\n              best_path = p\n              best_target = cell\n      if best_path is None:\n          return []\n      actions.extend(best_path)\n      cur_pos = best_target\n      actions.append(USE)   # craft at workshop\n  else:\n      actions.append(USE)   # craft in place\n\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:29:09.084121", "function_name": "make_stick", "function_body": "  try:\n      env.reset()\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          scenario = getattr(env, \"scenario\", None)\n          if scenario is not None:\n              state = scenario.init()\n      if state is None:\n          return []\n\n      world = state.world\n      grid = state.grid.copy()\n      h, w, _ = grid.shape\n\n      def find_cells(kind):\n          pts = np.argwhere(grid[:, :, kind] > 0)\n          return [tuple(p) for p in pts]\n\n      dirs = [\n          (1, 0, 0),   # DOWN\n          (-1, 0, 1),  # UP\n          (0, -1, 2),  # LEFT\n          (0, 1, 3),   # RIGHT\n      ]\n\n      def is_blocked(x, y):\n          for idx in world.non_grabbable_indices:\n              if grid[x, y, idx] > 0:\n                  return True\n          return False\n\n      def bfs(start, goal):\n          from collections import deque\n          q = deque()\n          q.append((start, []))\n          visited = {start}\n          while q:\n              (cx, cy), path = q.popleft()\n              if (cx, cy) == goal:\n                  return path\n              for dx, dy, act in dirs:\n                  nx, ny = cx + dx, cy + dy\n                  if 0 <= nx < h and 0 <= ny < w and not is_blocked(nx, ny):\n                      if (nx, ny) not in visited:\n                          visited.add((nx, ny))\n                          q.append(((nx, ny), path + [act]))\n          return []\n\n      actions = []\n      cur_pos = state.pos\n\n      stick_idx = world.cookbook.index[\"stick\"]\n      prim_req = world.cookbook.primitives_for(stick_idx)\n\n      for prim_idx, cnt in prim_req.items():\n          for _ in range(cnt):\n              cells = find_cells(prim_idx)\n              if not cells:\n                  return []\n              dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in cells]\n              target = cells[int(np.argmin(dists))]\n              actions.extend(bfs(cur_pos, target))\n              actions.append(4)  # USE to pick up\n              cur_pos = target\n              grid[target[0], target[1], prim_idx] = 0\n\n      recipe = world.cookbook.recipes.get(stick_idx, {})\n      workshop = recipe.get(\"_at\")\n      if workshop is not None:\n          ws_cells = find_cells(workshop)\n          if ws_cells:\n              dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in ws_cells]\n              ws_target = ws_cells[int(np.argmin(dists))]\n              actions.extend(bfs(cur_pos, ws_target))\n              actions.append(4)  # USE to craft\n      else:\n          actions.append(4)\n\n      return actions\n  except Exception:\n      return []", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:29:10.202124", "function_name": "make_stick", "function_body": "  try:\n      # Reset environment and obtain the underlying CraftState.\n      env.reset()\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          scenario = getattr(env, \"scenario\", None)\n          if scenario is not None:\n              state = scenario.init()\n      if state is None:\n          return []\n\n      world = state.world\n      grid = state.grid.copy()\n      h, w, _ = grid.shape\n\n      # ------------------------------------------------------------------\n      # Helper utilities.\n      # ------------------------------------------------------------------\n      def find_cells(kind):\n          \"\"\"Return list of (x, y) where `kind` appears in the current grid.\"\"\"\n          pts = np.argwhere(grid[:, :, kind] > 0)\n          return [tuple(p) for p in pts]\n\n      # Action order: DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n      moves = [\n          (1, 0, 0),   # DOWN\n          (-1, 0, 1),  # UP\n          (0, -1, 2),  # LEFT\n          (0, 1, 3),   # RIGHT\n      ]\n\n      def blocked(x, y):\n          \"\"\"True if cell (x, y) contains any non\u2011grabbable entity.\"\"\"\n          for idx in world.non_grabbable_indices:\n              if grid[x, y, idx] > 0:\n                  return True\n          return False\n\n      def bfs(start, goal):\n          \"\"\"Bread\u2011first search returning a list of movement actions from start to goal.\"\"\"\n          from collections import deque\n          q = deque()\n          q.append((start, []))\n          visited = {start}\n          while q:\n              (cx, cy), path = q.popleft()\n              if (cx, cy) == goal:\n                  return path\n              for dx, dy, act in moves:\n                  nx, ny = cx + dx, cy + dy\n                  if 0 <= nx < h and 0 <= ny < w and not blocked(nx, ny):\n                      if (nx, ny) not in visited:\n                          visited.add((nx, ny))\n                          q.append(((nx, ny), path + [act]))\n          return []  # No path found (should not happen on valid maps)\n\n      actions = []\n      cur_pos = state.pos\n\n      # ------------------------------------------------------------------\n      # Determine recipe for a stick and required primitives.\n      # ------------------------------------------------------------------\n      stick_idx = world.cookbook.index[\"stick\"]\n      prim_req = world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n\n      # ------------------------------------------------------------------\n      # Collect each required primitive.\n      # ------------------------------------------------------------------\n      for prim_idx, count in prim_req.items():\n          for _ in range(count):\n              cells = find_cells(prim_idx)\n              if not cells:\n                  return []  # Primitive missing; cannot complete task\n              # Choose closest primitive (Manhattan distance)\n              dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in cells]\n              target = cells[int(np.argmin(dists))]\n              actions.extend(bfs(cur_pos, target))\n              actions.append(4)  # USE to pick up\n              # Update local state\n              cur_pos = target\n              grid[target[0], target[1], prim_idx] = 0\n\n      # ------------------------------------------------------------------\n      # Craft the stick at the appropriate workshop (if required).\n      # ------------------------------------------------------------------\n      recipe = world.cookbook.recipes.get(stick_idx, {})\n      workshop_kind = recipe.get(\"_at\")\n      if workshop_kind is not None:\n          ws_cells = find_cells(workshop_kind)\n          if not ws_cells:\n              return []  # No workshop available\n          dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in ws_cells]\n          ws_target = ws_cells[int(np.argmin(dists))]\n          actions.extend(bfs(cur_pos, ws_target))\n          actions.append(4)  # USE to craft at workshop\n      else:\n          # No specific workshop; craft at current location.\n          actions.append(4)\n\n      return actions\n  except Exception:\n      # On any unexpected error, return an empty plan.\n      return []", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:29:24.637249", "function_name": "make_stick", "function_body": "  import collections\n\n  # Retrieve the numeric IDs for the available actions.\n  try:\n      action_map = env.action_specs()\n      action_ids = list(action_map.values())\n  except Exception:\n      # Fallback to the default ordering: DOWN, UP, LEFT, RIGHT, USE\n      action_ids = [0, 1, 2, 3, 4]\n\n  # Find the index that represents a \"stick\" in the cookbook.\n  try:\n      target_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      target_idx = env.world.cookbook.index.get(\"stick\")\n  if target_idx is None:\n      return []\n\n  # Helper that checks whether a given state already satisfies the goal.\n  def is_goal(state):\n      return state.satisfies(\"\", target_idx)\n\n  # Obtain the current state without mutating the live environment.\n  start_state = getattr(env, \"_current_state\", None)\n  if start_state is None:\n      # If the attribute is missing, reset the environment to get a state.\n      env.reset()\n      start_state = env._current_state\n\n  # Bread\u2011first search over the state space.\n  frontier = collections.deque()\n  frontier.append((start_state, []))\n  visited = set()\n\n  def state_key(st):\n      # Position, direction, and inventory uniquely identify a state.\n      return (st.pos, st.dir, st.inventory.tobytes())\n\n  visited.add(state_key(start_state))\n  max_steps = 300  # safety cap on plan length\n\n  while frontier:\n      cur_state, cur_actions = frontier.popleft()\n      if is_goal(cur_state):\n          return cur_actions\n      if len(cur_actions) >= max_steps:\n          continue\n      for a in action_ids:\n          _, nxt_state = cur_state.step(a)\n          key = state_key(nxt_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((nxt_state, cur_actions + [a]))\n\n  # No plan found within the limits.\n  return []", "env_interactions": 4, "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T18:29:25.749241", "function_name": "make_stick", "function_body": "  # Retrieve the action IDs from the environment (fallback to default ordering)\n  try:\n      action_map = env.action_specs()\n      action_ids = list(action_map.values())\n  except Exception:\n      # Default ordering: DOWN, UP, LEFT, RIGHT, USE\n      action_ids = [0, 1, 2, 3, 4]\n\n  # Index of the target item \"stick\"\n  try:\n      target_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      target_idx = env.world.cookbook.index.get(\"stick\", None)\n\n  # Helper to check if a state satisfies the goal\n  def goal_reached(state):\n      return target_idx is not None and state.satisfies(\"\", target_idx)\n\n  # Starting state (do not modify the live environment)\n  start_state = env._current_state  # type: ignore[attr-defined]\n\n  # Bread\u2011first search over state space\n  from collections import deque\n  frontier = deque()\n  frontier.append((start_state, []))\n  visited = set()\n\n  def state_key(st):\n      # Position, direction, and inventory uniquely identify a state\n      return (st.pos, st.dir, st.inventory.tobytes())\n\n  visited.add(state_key(start_state))\n  max_steps = 500  # safety limit to avoid infinite search\n\n  while frontier:\n      cur_state, actions = frontier.popleft()\n      if goal_reached(cur_state):\n          return actions\n      if len(actions) >= max_steps:\n          continue\n      for a in action_ids:\n          _, nxt_state = cur_state.step(a)\n          key = state_key(nxt_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((nxt_state, actions + [a]))\n\n  # If no plan found within limits, return an empty action list\n  return []", "env_interactions": 4, "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T18:29:44.845324", "function_name": "make_stick", "function_body": "  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  cookbook = world.cookbook\n\n  # ------------------------------------------------------------------\n  # Identify the index for the target item \"stick\"\n  # ------------------------------------------------------------------\n  try:\n      stick_idx = cookbook.index[\"stick\"]\n  except Exception:\n      return []   # stick not defined in this world\n\n  # ------------------------------------------------------------------\n  # Determine primitive ingredients needed for one stick\n  # ------------------------------------------------------------------\n  prim_req = cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n  stick_is_primitive = not bool(prim_req)\n  if stick_is_primitive:\n      # If stick itself is a primitive, we just need to pick it up\n      prim_req = {stick_idx: 1}\n\n  # ------------------------------------------------------------------\n  # Action mapping (environment specific)\n  # ------------------------------------------------------------------\n  act_map = env.action_specs()\n  DOWN = act_map.get('DOWN', 0)\n  UP = act_map.get('UP', 1)\n  LEFT = act_map.get('LEFT', 2)\n  RIGHT = act_map.get('RIGHT', 3)\n  USE = act_map.get('USE', 4)\n\n  # ------------------------------------------------------------------\n  # Helper to generate movement actions between two cells\n  # ------------------------------------------------------------------\n  def moves_to(start, target):\n      \"\"\"Return a list of actions moving from start (x, y) to target (x, y).\"\"\"\n      cx, cy = start\n      tx, ty = target\n      actions = []\n      while cx < tx:\n          actions.append(DOWN); cx += 1\n      while cx > tx:\n          actions.append(UP);   cx -= 1\n      while cy < ty:\n          actions.append(RIGHT); cy += 1\n      while cy > ty:\n          actions.append(LEFT);  cy -= 1\n      return actions\n\n  # ------------------------------------------------------------------\n  # Locate all required primitives on the grid\n  # ------------------------------------------------------------------\n  grid = state.grid\n  prim_locs = {}\n  for p_idx in prim_req:\n      positions = np.argwhere(grid[:, :, p_idx] > 0)\n      prim_locs[p_idx] = [tuple(pos) for pos in positions]\n\n  # ------------------------------------------------------------------\n  # Locate a workshop (if needed) \u2013 where crafting must occur\n  # ------------------------------------------------------------------\n  workshop_pos = None\n  if not stick_is_primitive:\n      # Try to find the specific workshop required by the recipe\n      recipe = cookbook.recipes.get(stick_idx, {})\n      wk_name = recipe.get(\"_at\")\n      if wk_name is not None:\n          try:\n              wk_idx = cookbook.index[wk_name]\n              cells = np.argwhere(grid[:, :, wk_idx] > 0)\n              if cells.size:\n                  workshop_pos = tuple(cells[0])\n          except Exception:\n              workshop_pos = None\n\n      # Fallback: any workshop cell in the world\n      if workshop_pos is None:\n          for wk_idx in world.workshop_indices:\n              cells = np.argwhere(grid[:, :, wk_idx] > 0)\n              if cells.size:\n                  workshop_pos = tuple(cells[0])\n                  break\n\n  # ------------------------------------------------------------------\n  # Build the action plan\n  # ------------------------------------------------------------------\n  cur_pos = state.pos\n  plan = []\n\n  # Collect each required primitive, preferring the nearest instance\n  for p_idx, needed in prim_req.items():\n      collected = 0\n      available = prim_locs.get(p_idx, []).copy()\n      if not available:\n          # Required primitive not present on the grid \u2013 cannot succeed\n          return []\n      while collected < needed:\n          # Find nearest primitive location\n          dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in available]\n          nearest = int(np.argmin(dists))\n          target = available.pop(nearest)\n\n          # Move to the primitive and pick it up\n          plan.extend(moves_to(cur_pos, target))\n          cur_pos = target\n          plan.append(USE)          # pick up action\n          collected += 1\n\n  # If crafting is required, move to a workshop and invoke USE to craft\n  if not stick_is_primitive:\n      if workshop_pos is not None:\n          plan.extend(moves_to(cur_pos, workshop_pos))\n          cur_pos = workshop_pos\n      plan.append(USE)              # trigger crafting at the workshop (or current cell)\n\n  return plan", "env_interactions": 4, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:29:45.964237", "function_name": "make_stick", "function_body": "  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  cookbook = world.cookbook\n\n  # ------------------------------------------------------------------\n  # Identify the index for the target item \"stick\"\n  # ------------------------------------------------------------------\n  try:\n      stick_idx = cookbook.index[\"stick\"]\n  except Exception:\n      return []   # stick not defined in this world\n\n  # ------------------------------------------------------------------\n  # Determine primitive ingredients needed for one stick (recursive)\n  # ------------------------------------------------------------------\n  prim_req = cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n  stick_is_primitive = not bool(prim_req)\n  if stick_is_primitive:\n      prim_req = {stick_idx: 1}\n\n  # ------------------------------------------------------------------\n  # Action mapping (environment specific)\n  # ------------------------------------------------------------------\n  act_map = env.action_specs()\n  DOWN = act_map.get('DOWN', 0)\n  UP   = act_map.get('UP', 1)\n  LEFT = act_map.get('LEFT', 2)\n  RIGHT= act_map.get('RIGHT', 3)\n  USE  = act_map.get('USE', 4)\n\n  # ------------------------------------------------------------------\n  # Helper: Manhattan moves from a to b\n  # ------------------------------------------------------------------\n  def moves_to(start, target):\n      cx, cy = start\n      tx, ty = target\n      actions = []\n      while cx < tx:\n          actions.append(DOWN); cx += 1\n      while cx > tx:\n          actions.append(UP);   cx -= 1\n      while cy < ty:\n          actions.append(RIGHT); cy += 1\n      while cy > ty:\n          actions.append(LEFT);  cy -= 1\n      return actions\n\n  # ------------------------------------------------------------------\n  # Locate all required primitives on the current grid\n  # ------------------------------------------------------------------\n  grid = state.grid\n  prim_locs = {}\n  for p_idx in prim_req:\n      positions = np.argwhere(grid[:, :, p_idx] > 0)\n      prim_locs[p_idx] = [tuple(pos) for pos in positions]\n\n  # ------------------------------------------------------------------\n  # Locate a workshop (if crafting is required)\n  # ------------------------------------------------------------------\n  workshop_pos = None\n  if not stick_is_primitive:\n      # Prefer the workshop explicitly mentioned in the recipe, if any\n      recipe = cookbook.recipes.get(stick_idx, {})\n      wk_name = recipe.get(\"_at\")\n      if wk_name is not None:\n          try:\n              wk_idx = cookbook.index[wk_name]\n              cells = np.argwhere(grid[:, :, wk_idx] > 0)\n              if cells.size:\n                  workshop_pos = tuple(cells[0])\n          except Exception:\n              wk_idx = None\n      # Fallback: any workshop cell present in the world\n      if workshop_pos is None:\n          for wk_idx in world.workshop_indices:\n              cells = np.argwhere(grid[:, :, wk_idx] > 0)\n              if cells.size:\n                  workshop_pos = tuple(cells[0])\n                  break\n\n  # ------------------------------------------------------------------\n  # Build the action plan\n  # ------------------------------------------------------------------\n  cur_pos = state.pos\n  plan = []\n\n  for p_idx, needed in prim_req.items():\n      collected = 0\n      available = prim_locs.get(p_idx, []).copy()\n      if not available:\n          # Required primitive absent \u2013 cannot complete task\n          return []\n      while collected < needed:\n          # Choose nearest primitive\n          dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in available]\n          nearest = int(np.argmin(dists))\n          target = available.pop(nearest)\n\n          # Move to it and pick it up\n          plan.extend(moves_to(cur_pos, target))\n          cur_pos = target\n          plan.append(USE)          # pickup action\n          collected += 1\n\n  # If crafting is needed, go to a workshop and invoke USE to craft\n  if not stick_is_primitive:\n      if workshop_pos is not None:\n          plan.extend(moves_to(cur_pos, workshop_pos))\n          cur_pos = workshop_pos\n      plan.append(USE)              # trigger crafting\n\n  return plan", "env_interactions": 4, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:30:14.944758", "function_name": "make_stick", "function_body": "  try:\n      # Reset environment and obtain the underlying CraftState.\n      env.reset()\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          scenario = getattr(env, \"scenario\", None)\n          if scenario is not None:\n              state = scenario.init()\n      if state is None:\n          return []\n\n      world = state.world\n      grid = state.grid.copy()\n      height, width, _ = grid.shape\n      cur_pos = state.pos\n      actions: list[int] = []\n\n      # ------------------------------------------------------------------\n      # Helper utilities.\n      # ------------------------------------------------------------------\n      import numpy as np\n      from collections import deque\n\n      def find_cells(kind_idx: int) -> list[tuple[int, int]]:\n          \"\"\"Return list of (x, y) positions where `kind_idx` appears in the grid.\"\"\"\n          pts = np.argwhere(grid[:, :, kind_idx] > 0)\n          return [tuple(p) for p in pts]\n\n      # (dx, dy, action_id) matching CraftLab ordering.\n      DIRS = [\n          (1, 0, 0),   # DOWN\n          (-1, 0, 1),  # UP\n          (0, -1, 2),  # LEFT\n          (0, 1, 3),   # RIGHT\n      ]\n\n      def is_blocked(x: int, y: int) -> bool:\n          \"\"\"True if a non\u2011grabbable entity occupies (x, y).\"\"\"\n          for idx in world.non_grabbable_indices:\n              if grid[x, y, idx] > 0:\n                  return True\n          return False\n\n      def bfs(start: tuple[int, int], goal: tuple[int, int]) -> list[int]:\n          \"\"\"Bread\u2011first search returning movement actions from start to goal.\"\"\"\n          q = deque()\n          q.append((start, []))\n          visited = {start}\n          while q:\n              (cx, cy), path = q.popleft()\n              if (cx, cy) == goal:\n                  return path\n              for dx, dy, act in DIRS:\n                  nx, ny = cx + dx, cy + dy\n                  if 0 <= nx < height and 0 <= ny < width and not is_blocked(nx, ny):\n                      if (nx, ny) not in visited:\n                          visited.add((nx, ny))\n                          q.append(((nx, ny), path + [act]))\n          return []  # no path found\n\n      # ------------------------------------------------------------------\n      # Identify the recipe for a stick.\n      # ------------------------------------------------------------------\n      stick_idx = world.cookbook.index[\"stick\"]\n      primitive_reqs = world.cookbook.primitives_for(stick_idx)\n\n      # If stick is a primitive (no recipe), just pick one up.\n      if not primitive_reqs:\n          sticks = find_cells(stick_idx)\n          if not sticks:\n              return []\n          dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in sticks]\n          target = sticks[int(np.argmin(dists))]\n          actions.extend(bfs(cur_pos, target))\n          actions.append(4)  # USE to pick up\n          return actions\n\n      # ------------------------------------------------------------------\n      # Collect required primitives.\n      # ------------------------------------------------------------------\n      for prim_idx, count in primitive_reqs.items():\n          for _ in range(count):\n              cells = find_cells(prim_idx)\n              if not cells:\n                  return []  # missing primitive\n              dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in cells]\n              target = cells[int(np.argmin(dists))]\n              move_seq = bfs(cur_pos, target)\n              if not move_seq and cur_pos != target:\n                  return []  # unreachable\n              actions.extend(move_seq)\n              actions.append(4)  # USE to pick up\n              cur_pos = target\n              grid[target[0], target[1], prim_idx] = 0  # remove from local copy\n\n      # ------------------------------------------------------------------\n      # Craft at the required workshop (if any).\n      # ------------------------------------------------------------------\n      recipe = world.cookbook.recipes.get(stick_idx, {})\n      workshop_kind = recipe.get(\"_at\")\n      if workshop_kind is not None:\n          ws_cells = find_cells(workshop_kind)\n          if not ws_cells:\n              return []\n          dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in ws_cells]\n          ws_target = ws_cells[int(np.argmin(dists))]\n          actions.extend(bfs(cur_pos, ws_target))\n          actions.append(4)  # USE to craft\n      else:\n          actions.append(4)  # USE to craft at current location\n\n      return actions\n  except Exception:\n      return []", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:30:16.061202", "function_name": "make_stick", "function_body": "  try:\n      # Reset environment and obtain the current state.\n      env.reset()\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          scenario = getattr(env, \"scenario\", None)\n          if scenario is not None:\n              state = scenario.init()\n      if state is None:\n          return []\n\n      world = state.world\n      grid = state.grid.copy()\n      h, w, _ = grid.shape\n      cur_pos = state.pos\n      actions: list[int] = []\n\n      import numpy as np\n      from collections import deque\n\n      # ------------------------------------------------------------------\n      # Helper utilities.\n      # ------------------------------------------------------------------\n      def find_cells(kind_idx: int) -> list[tuple[int, int]]:\n          \"\"\"Return a list of (x, y) positions where `kind_idx` appears.\"\"\"\n          pts = np.argwhere(grid[:, :, kind_idx] > 0)\n          return [tuple(p) for p in pts]\n\n      # (dx, dy, action_id) \u2013 matches CraftWorld action ordering.\n      DIRS = [\n          (1, 0, 0),   # DOWN\n          (-1, 0, 1),  # UP\n          (0, -1, 2),  # LEFT\n          (0, 1, 3),   # RIGHT\n      ]\n\n      def is_blocked(x: int, y: int) -> bool:\n          \"\"\"True if any non\u2011grabbable entity occupies (x, y).\"\"\"\n          for idx in world.non_grabbable_indices:\n              if grid[x, y, idx] > 0:\n                  return True\n          return False\n\n      def bfs(start: tuple[int, int], goal: tuple[int, int]) -> list[int]:\n          \"\"\"Bread\u2011first search returning movement actions from start to goal.\"\"\"\n          q = deque()\n          q.append((start, []))\n          visited = {start}\n          while q:\n              (cx, cy), path = q.popleft()\n              if (cx, cy) == goal:\n                  return path\n              for dx, dy, act in DIRS:\n                  nx, ny = cx + dx, cy + dy\n                  if 0 <= nx < h and 0 <= ny < w and not is_blocked(nx, ny):\n                      if (nx, ny) not in visited:\n                          visited.add((nx, ny))\n                          q.append(((nx, ny), path + [act]))\n          # No path found.\n          return []\n\n      # ------------------------------------------------------------------\n      # Determine the recipe for a stick.\n      # ------------------------------------------------------------------\n      stick_idx = world.cookbook.index[\"stick\"]\n\n      # If we already have a stick, nothing to do.\n      if state.inventory[stick_idx] > 0:\n          return actions\n\n      # Primitive requirements for a stick.\n      prim_req = world.cookbook.primitives_for(stick_idx)\n\n      # If stick itself is primitive (no recipe), just pick one up.\n      if not prim_req:\n          sticks = find_cells(stick_idx)\n          if not sticks:\n              return []\n          dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in sticks]\n          target = sticks[int(np.argmin(dists))]\n          actions.extend(bfs(cur_pos, target))\n          actions.append(4)  # USE to pick up\n          return actions\n\n      # ------------------------------------------------------------------\n      # Collect required primitives.\n      # ------------------------------------------------------------------\n      for prim_idx, needed in prim_req.items():\n          for _ in range(needed):\n              cells = find_cells(prim_idx)\n              if not cells:\n                  return []  # missing primitive\n              dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in cells]\n              target = cells[int(np.argmin(dists))]\n              move_seq = bfs(cur_pos, target)\n              if not move_seq and cur_pos != target:\n                  return []  # unreachable\n              actions.extend(move_seq)\n              actions.append(4)            # USE to pick up\n              cur_pos = target\n              grid[target[0], target[1], prim_idx] = 0  # remove from local copy\n\n      # ------------------------------------------------------------------\n      # Craft at the required workshop (if any).\n      # ------------------------------------------------------------------\n      recipe = world.cookbook.recipes.get(stick_idx, {})\n      workshop_kind = recipe.get(\"_at\")\n      if workshop_kind is not None:\n          ws_cells = find_cells(workshop_kind)\n          if not ws_cells:\n              return []\n          dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in ws_cells]\n          ws_target = ws_cells[int(np.argmin(dists))]\n          actions.extend(bfs(cur_pos, ws_target))\n          actions.append(4)  # USE to craft\n      else:\n          actions.append(4)  # USE to craft at current location\n\n      return actions\n  except Exception:\n      return []", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:30:37.080110", "function_name": "make_stick", "function_body": "  env.reset()\n  state = env._current_state\n\n  goal_idx = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n\n  def _move_to(target):\n      \"\"\"Generate actions to move from current state.pos to target.\"\"\"\n      nonlocal state\n      actions = []\n      while tuple(state.pos) != tuple(target):\n          r, c = state.pos\n          tr, tc = target\n          if r < tr:\n              act = 0          # DOWN\n          elif r > tr:\n              act = 1          # UP\n          elif c < tc:\n              act = 3          # RIGHT\n          else:\n              act = 2          # LEFT\n          actions.append(act)\n          _, state = env.step(act)\n      return actions\n\n  plan = []\n\n  # 1. Gather required primitives.\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          locs = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if locs.shape[0] == 0:\n              # Primitive not present; abort early.\n              break\n          target = tuple(locs[0])\n          plan.extend(_move_to(target))\n          plan.append(4)            # USE to pick up\n          _, state = env.step(4)\n\n  # 2. Move to workshop (if required) and craft.\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = recipe.get(\"_at\", None)\n  if workshop_idx is not None:\n      w_locs = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if w_locs.shape[0] > 0:\n          w_target = tuple(w_locs[0])\n          plan.extend(_move_to(w_target))\n          plan.append(4)            # USE to craft\n          _, state = env.step(4)\n\n  return plan", "env_interactions": 0, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:30:37.109369", "function_name": "make_stick", "function_body": "  # Reset environment and obtain initial state\n  env.reset()\n  state = env._current_state\n\n  # Goal item index (e.g., stick)\n  goal_idx = env.task.goal\n\n  # Primitive requirements for the goal\n  needed = env.world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Helper: Bread\u2011first search to obtain a sequence of movement actions\n  # from the current position to a target cell, avoiding any occupied\n  # cells (except the target itself).  Returns a list of action ints.\n  # ------------------------------------------------------------------\n  def _bfs_path(start, target):\n      \"\"\"Return list of actions moving from start to target.\"\"\"\n      H, W, _ = state.grid.shape\n      # Directions: 0=DOWN,1=UP,2=LEFT,3=RIGHT\n      dirs = [(1, 0), (-1, 0), (0, -1), (0, 1)]\n      from collections import deque\n      q = deque()\n      q.append((start, []))\n      visited = set()\n      visited.add(start)\n      while q:\n          (r, c), path = q.popleft()\n          if (r, c) == target:\n              return path\n          for act, (dr, dc) in enumerate(dirs):\n              nr, nc = r + dr, c + dc\n              if not (0 <= nr < H and 0 <= nc < W):\n                  continue\n              if (nr, nc) in visited:\n                  continue\n              # Blocked if any entity occupies the cell and it is not the target\n              if (nr, nc) != target and np.any(state.grid[nr, nc, :] > 0):\n                  continue\n              visited.add((nr, nc))\n              q.append(((nr, nc), path + [act]))\n      # No path found \u2013 fall back to empty list\n      return []\n\n  # ------------------------------------------------------------------\n  # Helper: move to a given location using the BFS planner and update\n  # the environment/state accordingly.\n  # ------------------------------------------------------------------\n  def _move_to(target):\n      actions = _bfs_path(state.pos, target)\n      for a in actions:\n          _, new_state = env.step(a)\n          # Update local references\n          nonlocal state\n          state = new_state\n      return actions\n\n  plan = []   # final action list to be returned\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitive items.\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          # Find locations of the needed primitive on the current grid\n          locs = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if locs.shape[0] == 0:\n              # Primitive missing \u2013 abort collection loop\n              break\n          # Choose the first occurrence (could be improved with nearest)\n          target = tuple(locs[0])\n          # Move to the primitive cell\n          plan.extend(_move_to(target))\n          # Pick it up\n          plan.append(4)          # USE action\n          _, new_state = env.step(4)\n          state = new_state\n\n  # ------------------------------------------------------------------\n  # 2. Go to the appropriate workshop (if required) and craft the goal.\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = recipe.get(\"_at\", None)\n  if workshop_idx is not None:\n      # Locate a workshop of the required type\n      w_locs = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if w_locs.shape[0] > 0:\n          w_target = tuple(w_locs[0])\n          plan.extend(_move_to(w_target))\n          # Craft at the workshop\n          plan.append(4)          # USE action to craft\n          _, new_state = env.step(4)\n          state = new_state\n      else:\n          # No workshop found \u2013 fallback: try crafting in place\n          plan.append(4)\n          _, new_state = env.step(4)\n          state = new_state\n\n  # Return the assembled action sequence\n  return plan", "env_interactions": 0, "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-10-21T18:30:55.013250", "function_name": "make_stick", "function_body": "  actions = []\n  try:\n      # reset environment and obtain the current CraftState\n      env.reset()\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          scenario = getattr(env, \"scenario\", None)\n          if scenario is not None:\n              state = scenario.init()\n      if state is None:\n          return actions\n\n      world = state.world\n      grid = state.grid\n      h, w, _ = grid.shape\n\n      # ------------------------------------------------------------------\n      # Helper utilities\n      # ------------------------------------------------------------------\n      # movement vectors and corresponding action indices (DOWN,UP,LEFT,RIGHT)\n      dirs = [(1, 0, 0), (-1, 0, 1), (0, -1, 2), (0, 1, 3)]\n\n      def is_blocked(x, y):\n          \"\"\"True if cell (x,y) contains a non\u2011grabbable entity.\"\"\"\n          for idx in world.non_grabbable_indices:\n              if grid[x, y, idx] > 0:\n                  return True\n          return False\n\n      def bfs(start, goal):\n          \"\"\"Bread\u2011first search returning a list of actions from start\u2192goal.\"\"\"\n          from collections import deque\n\n          q = deque()\n          q.append((start, []))\n          visited = {start}\n          while q:\n              (cx, cy), path = q.popleft()\n              if (cx, cy) == goal:\n                  return path\n              for dx, dy, act in dirs:\n                  nx, ny = cx + dx, cy + dy\n                  if 0 <= nx < h and 0 <= ny < w and not is_blocked(nx, ny):\n                      if (nx, ny) not in visited:\n                          visited.add((nx, ny))\n                          q.append(((nx, ny), path + [act]))\n          return []  # fallback; should not happen in a valid map\n\n      def find_cells(kind):\n          \"\"\"Return list of (x,y) positions where `kind` is present.\"\"\"\n          pos = np.argwhere(grid[:, :, kind] > 0)\n          return [tuple(p) for p in pos]\n\n      # ------------------------------------------------------------------\n      # Determine recipe for stick\n      # ------------------------------------------------------------------\n      stick_idx = world.cookbook.index.index(\"stick\")\n      # primitives needed (may be empty if stick is primitive)\n      prim_req = world.cookbook.primitives_for(stick_idx)\n\n      # recipe may specify a workshop via \"_at\"\n      stick_recipe = world.cookbook.recipes.get(stick_idx, {})\n      workshop_idx = stick_recipe.get(\"_at\", None)\n\n      cur_pos = state.pos\n\n      # ------------------------------------------------------------------\n      # Collect all required primitives\n      # ------------------------------------------------------------------\n      for prim_idx, needed in prim_req.items():\n          for _ in range(needed):\n              cells = find_cells(prim_idx)\n              if not cells:\n                  continue  # primitive not on map; skip\n              # choose nearest occurrence (Manhattan distance)\n              dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in cells]\n              target = cells[int(np.argmin(dists))]\n              actions.extend(bfs(cur_pos, target))\n              actions.append(4)  # USE to pick up\n              cur_pos = target\n\n      # ------------------------------------------------------------------\n      # Craft at workshop if required\n      # ------------------------------------------------------------------\n      if workshop_idx is not None:\n          ws_cells = find_cells(workshop_idx)\n          if ws_cells:\n              dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in ws_cells]\n              target_ws = ws_cells[int(np.argmin(dists))]\n              actions.extend(bfs(cur_pos, target_ws))\n              actions.append(4)  # USE to craft stick\n\n      return actions\n  except Exception:\n      # fallback to empty plan on any unexpected error\n      return []", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:30:56.132096", "function_name": "make_stick", "function_body": "  actions = []\n  try:\n      # Reset environment to a fresh episode.\n      env.reset()\n      # Obtain the current CraftState (different wrappers expose it differently).\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          scenario = getattr(env, \"scenario\", None)\n          if scenario is not None:\n              state = scenario.init()\n      if state is None:\n          return actions\n\n      world = state.world\n      grid = state.grid\n      height, width, _ = grid.shape\n\n      # ------------------------------------------------------------------\n      # Helper utilities.\n      # ------------------------------------------------------------------\n      # Action indices for movement (order matches CraftWorld convention).\n      dirs = [(1, 0, 0),   # DOWN\n              (-1, 0, 1),  # UP\n              (0, -1, 2),  # LEFT\n              (0, 1, 3)]   # RIGHT\n\n      def is_blocked(x, y):\n          \"\"\"Return True if cell (x, y) contains a non\u2011grabbable entity.\"\"\"\n          for idx in world.non_grabbable_indices:\n              if grid[x, y, idx] > 0:\n                  return True\n          return False\n\n      def bfs(start, goal):\n          \"\"\"Bread\u2011first search returning a list of movement actions from start to goal.\"\"\"\n          from collections import deque\n          q = deque()\n          q.append((start, []))\n          visited = {start}\n          while q:\n              (cx, cy), path = q.popleft()\n              if (cx, cy) == goal:\n                  return path\n              for dx, dy, act in dirs:\n                  nx, ny = cx + dx, cy + dy\n                  if 0 <= nx < height and 0 <= ny < width and not is_blocked(nx, ny):\n                      if (nx, ny) not in visited:\n                          visited.add((nx, ny))\n                          q.append(((nx, ny), path + [act]))\n          return []  # should not happen on a valid map\n\n      def find_cells(kind):\n          \"\"\"Return a list of (x, y) positions where `kind` is present.\"\"\"\n          pos = np.argwhere(grid[:, :, kind] > 0)\n          return [tuple(p) for p in pos]\n\n      # ------------------------------------------------------------------\n      # Identify the stick item and its requirements.\n      # ------------------------------------------------------------------\n      stick_idx = world.cookbook.index.index(\"stick\")\n      # Primitive counts needed to craft ONE stick.\n      primitive_reqs = world.cookbook.primitives_for(stick_idx)\n\n      # Full recipe (may be empty if stick is primitive).\n      stick_recipe = world.cookbook.recipes.get(stick_idx, {})\n      workshop_idx = stick_recipe.get(\"_at\", None)\n\n      cur_pos = state.pos\n\n      # ------------------------------------------------------------------\n      # Collect all required primitives.\n      # ------------------------------------------------------------------\n      for prim_idx, needed in primitive_reqs.items():\n          for _ in range(needed):\n              cells = find_cells(prim_idx)\n              if not cells:\n                  continue  # primitive not present on the map\n              # Choose the nearest occurrence (Manhattan distance).\n              dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in cells]\n              target = cells[int(np.argmin(dists))]\n              actions.extend(bfs(cur_pos, target))\n              actions.append(4)            # USE to pick up the primitive\n              cur_pos = target\n\n      # ------------------------------------------------------------------\n      # If the stick itself is a primitive (no recipe), pick it up now.\n      # ------------------------------------------------------------------\n      if not primitive_reqs and state.inventory[stick_idx] == 0:\n          stick_cells = find_cells(stick_idx)\n          if stick_cells:\n              dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in stick_cells]\n              target = stick_cells[int(np.argmin(dists))]\n              actions.extend(bfs(cur_pos, target))\n              actions.append(4)            # USE to pick up the stick\n              cur_pos = target\n\n      # ------------------------------------------------------------------\n      # If a workshop is required, go there and craft the stick.\n      # ------------------------------------------------------------------\n      if workshop_idx is not None:\n          workshop_cells = find_cells(workshop_idx)\n          if workshop_cells:\n              dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in workshop_cells]\n              target_ws = workshop_cells[int(np.argmin(dists))]\n              actions.extend(bfs(cur_pos, target_ws))\n              actions.append(4)            # USE to perform the crafting action\n\n      return actions\n  except Exception:\n      # In case of any unexpected issue, return an empty plan.\n      return []", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:31:28.450527", "function_name": "make_stick", "function_body": "  # reset environment and obtain initial state\n  env.reset()\n  state = env._current_state\n\n  # action name \u2194 index mappings\n  act_map = env.action_specs()               # e.g. {\"UP\":0, \"DOWN\":1, ...}\n  inv_act = {v: k for k, v in act_map.items()}\n\n  # kinds that block movement (cannot be traversed)\n  blocked_kinds = env.world.non_grabbable_indices\n\n  # index of the target primitive/item \"stick\"\n  stick_idx = env.world.cookbook.index[\"stick\"]\n\n  # -----------------------------------------------------------------\n  # Helper utilities\n  # -----------------------------------------------------------------\n  def walkable(pos):\n      \"\"\"True if *pos* does not contain any non\u2011grabbable entity.\"\"\"\n      x, y = pos\n      return not any(state.grid[x, y, k] > 0 for k in blocked_kinds)\n\n  def manhattan(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def find_all(kind):\n      xs, ys = np.where(state.grid[:, :, kind] > 0)\n      return list(zip(xs.tolist(), ys.tolist()))\n\n  def bfs(start, targets):\n      \"\"\"Bread\u2011first search from *start* to any cell in *targets*.\n      Returns a list of positions (including start and goal) or None.\"\"\"\n      from collections import deque\n      q = deque([start])\n      prev = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur in targets:\n              # reconstruct path\n              path = []\n              while cur is not None:\n                  path.append(cur)\n                  cur = prev[cur]\n              path.reverse()\n              return path\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                  nxt = (nx, ny)\n                  if nxt not in prev and walkable(nxt):\n                      prev[nxt] = cur\n                      q.append(nxt)\n      return None\n\n  def move_to_action(p, q):\n      \"\"\"Convert a step from *p* \u2192 *q* into an action index.\"\"\"\n      dx, dy = q[0] - p[0], q[1] - p[1]\n      if (dx, dy) == (-1, 0):\n          return act_map[\"UP\"]\n      if (dx, dy) == (1, 0):\n          return act_map[\"DOWN\"]\n      if (dx, dy) == (0, -1):\n          return act_map[\"LEFT\"]\n      if (dx, dy) == (0, 1):\n          return act_map[\"RIGHT\"]\n      raise ValueError(\"Invalid move\")\n\n  # -----------------------------------------------------------------\n  actions = []\n\n  # Main loop: act until a stick appears in the inventory\n  while state.inventory[stick_idx] == 0:\n      # 1. locate all sticks on the map\n      stick_positions = find_all(stick_idx)\n      if not stick_positions:\n          break  # nothing to collect\n\n      # 2. pick the closest stick (Manhattan distance)\n      cur_pos = state.pos\n      target = min(stick_positions, key=lambda p: manhattan(cur_pos, p))\n\n      # 3. compute walkable adjacent cells around the target stick\n      adj_cells = []\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          ax, ay = target[0] + dx, target[1] + dy\n          if 0 <= ax < state.grid.shape[0] and 0 <= ay < state.grid.shape[1]:\n              if walkable((ax, ay)):\n                  adj_cells.append((ax, ay))\n\n      # 4. find shortest path to any adjacent cell\n      path = bfs(cur_pos, set(adj_cells))\n      if path is None:\n          break  # unreachable\n\n      # 5. follow the path (skip the first node which is the current pos)\n      for i in range(1, len(path)):\n          a = move_to_action(path[i - 1], path[i])\n          actions.append(a)\n          _, state = env.step(a)\n          env._current_state = state\n\n      # 6. we are now adjacent to the stick; face it\n      dx, dy = target[0] - state.pos[0], target[1] - state.pos[1]\n      if (dx, dy) == (-1, 0):\n          face_dir = act_map[\"UP\"]\n      elif (dx, dy) == (1, 0):\n          face_dir = act_map[\"DOWN\"]\n      elif (dx, dy) == (0, -1):\n          face_dir = act_map[\"LEFT\"]\n      elif (dx, dy) == (0, 1):\n          face_dir = act_map[\"RIGHT\"]\n      else:\n          face_dir = None\n\n      if face_dir is not None:\n          # change direction by stepping opposite then back (if possible)\n          opp_name = {\"UP\": \"DOWN\", \"DOWN\": \"UP\", \"LEFT\": \"RIGHT\", \"RIGHT\": \"LEFT\"}[inv_act[face_dir]]\n          opp_act = act_map[opp_name]\n          opp_pos = (state.pos[0] - dx, state.pos[1] - dy)\n\n          if (0 <= opp_pos[0] < state.grid.shape[0] and\n              0 <= opp_pos[1] < state.grid.shape[1] and\n              walkable(opp_pos)):\n              # step opposite\n              actions.append(opp_act)\n              _, state = env.step(opp_act)\n              env._current_state = state\n              # step back (now facing target)\n              actions.append(face_dir)\n              _, state = env.step(face_dir)\n              env._current_state = state\n          else:\n              # fallback: dummy move left then right to set direction\n              dummy = act_map[\"LEFT\"]\n              actions.append(dummy)\n              _, state = env.step(dummy)\n              env._current_state = state\n              actions.append(face_dir)\n              _, state = env.step(face_dir)\n              env._current_state = state\n\n          # 7. use the stick\n          actions.append(act_map[\"USE\"])\n          _, state = env.step(act_map[\"USE\"])\n          env._current_state = state\n\n  # return the compiled action list\n  return actions", "env_interactions": 0, "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:31:28.489829", "function_name": "make_stick", "function_body": "  # Reset environment and get initial state\n  obs = env.reset()\n  state = env._current_state\n\n  # Action mappings\n  act_map = env.action_specs()               # e.g. {\"UP\":0, \"DOWN\":1, ...}\n  inv_act = {v: k for k, v in act_map.items()}\n\n  # Blocking entity kinds (cannot be traversed)\n  blocked_kinds = env.world.non_grabbable_indices\n\n  # Index of the target item \"stick\"\n  stick_idx = env.world.cookbook.index[\"stick\"]\n\n  # Helper functions ---------------------------------------------------------\n  def walkable(pos):\n      \"\"\"True if the cell at *pos* has no non\u2011grabbable entity.\"\"\"\n      x, y = pos\n      return not any(state.grid[x, y, k] > 0 for k in blocked_kinds)\n\n  def manhattan(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def find_all(kind):\n      xs, ys = np.where(state.grid[:, :, kind] > 0)\n      return list(zip(xs.tolist(), ys.tolist()))\n\n  def bfs(start, targets):\n      \"\"\"Bread\u2011first search from *start* to any cell in *targets*.\n      Returns a list of positions (inclusive) or None.\"\"\"\n      from collections import deque\n      q = deque([start])\n      prev = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur in targets:\n              path = []\n              while cur is not None:\n                  path.append(cur)\n                  cur = prev[cur]\n              path.reverse()\n              return path\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                  nxt = (nx, ny)\n                  if nxt not in prev and walkable(nxt):\n                      prev[nxt] = cur\n                      q.append(nxt)\n      return None\n\n  def move_to_action(p, q):\n      \"\"\"Convert a step from *p* \u2192 *q* into an action index.\"\"\"\n      dx, dy = q[0] - p[0], q[1] - p[1]\n      if (dx, dy) == (-1, 0):\n          return act_map[\"UP\"]\n      if (dx, dy) == (1, 0):\n          return act_map[\"DOWN\"]\n      if (dx, dy) == (0, -1):\n          return act_map[\"LEFT\"]\n      if (dx, dy) == (0, 1):\n          return act_map[\"RIGHT\"]\n      raise ValueError(\"Invalid move\")\n\n  def face_towards(target):\n      \"\"\"Make the agent face the cell *target* (adjacent to current pos).\"\"\"\n      dx, dy = target[0] - state.pos[0], target[1] - state.pos[1]\n      if (dx, dy) == (-1, 0):\n          desired = act_map[\"UP\"]\n      elif (dx, dy) == (1, 0):\n          desired = act_map[\"DOWN\"]\n      elif (dx, dy) == (0, -1):\n          desired = act_map[\"LEFT\"]\n      elif (dx, dy) == (0, 1):\n          desired = act_map[\"RIGHT\"]\n      else:\n          return []  # not adjacent\n      # Change direction by stepping opposite then back if possible\n      opp_name = {\"UP\": \"DOWN\", \"DOWN\": \"UP\", \"LEFT\": \"RIGHT\", \"RIGHT\": \"LEFT\"}[inv_act[desired]]\n      opp_act = act_map[opp_name]\n      opp_pos = (state.pos[0] - dx, state.pos[1] - dy)\n      seq = []\n      if (0 <= opp_pos[0] < state.grid.shape[0] and\n          0 <= opp_pos[1] < state.grid.shape[1] and\n          walkable(opp_pos)):\n          seq.extend([opp_act, desired])\n      else:\n          # fallback dummy move\n          dummy = act_map[\"LEFT\"]\n          seq.extend([dummy, desired])\n      return seq\n\n  def go_to(target_cells):\n      \"\"\"Move to the nearest cell in *target_cells* (list of positions).\"\"\"\n      if not target_cells:\n          return None\n      cur = state.pos\n      path = bfs(cur, set(target_cells))\n      if path is None:\n          return None\n      # Execute moves (skip first which is current position)\n      for i in range(1, len(path)):\n          a = move_to_action(path[i - 1], path[i])\n          actions.append(a)\n          _, new_state = env.step(a)\n          env._current_state = new_state\n          # update local reference\n          nonlocal state\n          state = new_state\n      return path[-1]\n\n  # Main action list ---------------------------------------------------------\n  actions = []\n\n  # -------------------------------------------------------------------------\n  # Helper to collect a specific kind (primitive or stick) from the map\n  # -------------------------------------------------------------------------\n  def collect_kind(kind_idx, needed):\n      \"\"\"Collect at least *needed* units of *kind_idx*.\"\"\"\n      while state.inventory[kind_idx] < needed:\n          positions = find_all(kind_idx)\n          if not positions:\n              return False  # cannot find more\n          # choose closest reachable position\n          cur = state.pos\n          # find walkable adjacent cells for each candidate\n          candidate_adj = []\n          target_map = {}\n          for pos in positions:\n              for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                  adj = (pos[0] + dx, pos[1] + dy)\n                  if (0 <= adj[0] < state.grid.shape[0] and\n                      0 <= adj[1] < state.grid.shape[1] and\n                      walkable(adj)):\n                      candidate_adj.append(adj)\n                      target_map[adj] = pos\n          if not candidate_adj:\n              return False\n          dest = go_to(candidate_adj)\n          if dest is None:\n              return False\n          # now we are adjacent to the target cell\n          target_cell = target_map[dest]\n          # face the target and USE\n          actions.extend(face_towards(target_cell))\n          for act in actions[-2:]:  # apply the direction changes\n              _, new_state = env.step(act)\n              env._current_state = new_state\n              state = new_state\n          actions.append(act_map[\"USE\"])\n          _, new_state = env.step(act_map[\"USE\"])\n          env._current_state = new_state\n          state = new_state\n      return True\n\n  # -------------------------------------------------------------------------\n  # Main loop: continue until we have a stick in inventory\n  # -------------------------------------------------------------------------\n  while state.inventory[stick_idx] == 0:\n      # 1) Try to pick up any stick that already exists on the map\n      if find_all(stick_idx):\n          if not collect_kind(stick_idx, 1):\n              break\n          continue\n\n      # 2) Need to craft a stick\n      # Determine required primitives\n      prims = env.world.cookbook.primitives_for(stick_idx)  # dict {prim_idx: count}\n      # Collect each required primitive\n      all_collected = True\n      for prim_idx, cnt in prims.items():\n          if not collect_kind(prim_idx, cnt):\n              all_collected = False\n              break\n      if not all_collected:\n          break\n\n      # 3) Go to the workshop (if any) and craft\n      recipe = env.world.cookbook.recipes.get(stick_idx, {})\n      workshop_idx = recipe.get(\"_at\", None)\n      if workshop_idx is not None:\n          # locate workshop cells\n          workshop_cells = find_all(workshop_idx)\n          if not workshop_cells:\n              break\n          # find adjacent walkable cells around any workshop\n          adj_cells = []\n          for w in workshop_cells:\n              for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                  adj = (w[0] + dx, w[1] + dy)\n                  if (0 <= adj[0] < state.grid.shape[0] and\n                      0 <= adj[1] < state.grid.shape[1] and\n                      walkable(adj)):\n                      adj_cells.append(adj)\n          if not adj_cells:\n              break\n          dest = go_to(adj_cells)\n          if dest is None:\n              break\n          # face the workshop and USE to craft\n          # find which workshop we are adjacent to\n          workshop_target = None\n          for w in workshop_cells:\n              if manhattan(dest, w) == 1:\n                  workshop_target = w\n                  break\n          if workshop_target is None:\n              break\n          actions.extend(face_towards(workshop_target))\n          for act in actions[-2:]:\n              _, new_state = env.step(act)\n              env._current_state = new_state\n              state = new_state\n          # perform USE until we have a stick (usually one use is enough)\n          while state.inventory[stick_idx] == 0:\n              actions.append(act_map[\"USE\"])\n              _, new_state = env.step(act_map[\"USE\"])\n              env._current_state = new_state\n              state = new_state\n      else:\n          # No workshop required; simply USE on the location where we have primitives?\n          # In most configs, stick needs a workshop, so abort if none.\n          break\n\n  return actions", "env_interactions": 0, "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-10-21T18:31:54.691921", "function_name": "make_stick", "function_body": "  # -------------------------------------------------------------------------\n  # Basic environment information\n  # -------------------------------------------------------------------------\n  action_map = env.action_specs()\n  DOWN = action_map.get(\"DOWN\", 0)\n  UP = action_map.get(\"UP\", 1)\n  LEFT = action_map.get(\"LEFT\", 2)\n  RIGHT = action_map.get(\"RIGHT\", 3)\n  USE = action_map.get(\"USE\", 4)\n\n  # Goal item index (the item we need to obtain)\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      return []\n\n  world = getattr(env, \"world\", None)\n  if world is None:\n      return []\n\n  cookbook = getattr(world, \"cookbook\", None)\n  if cookbook is None:\n      return []\n\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []\n\n  grid = getattr(state, \"grid\", None)\n  cur_pos = getattr(state, \"pos\", None)\n  if grid is None or cur_pos is None:\n      return []\n\n  H, W = grid.shape[0], grid.shape[1]\n\n  # -------------------------------------------------------------------------\n  # Movement helpers (BFS on walkable cells)\n  # -------------------------------------------------------------------------\n  DIRS = [\n      (1, 0, DOWN),   # down  (increase x)\n      (-1, 0, UP),    # up    (decrease x)\n      (0, -1, LEFT),  # left  (decrease y)\n      (0, 1, RIGHT),  # right (increase y)\n  ]\n\n  def in_bounds(p):\n      return 0 <= p[0] < H and 0 <= p[1] < W\n\n  non_grabbable = set(world.non_grabbable_indices)\n\n  def walkable(p):\n      \"\"\"A cell is walkable if it is inside the grid and does not contain any\n      non\u2011grabbable entity.\"\"\"\n      if not in_bounds(p):\n          return False\n      for idx in non_grabbable:\n          if grid[p[0], p[1], idx] > 0:\n              return False\n      return True\n\n  from collections import deque\n\n  def bfs_path(start, targets):\n      \"\"\"Return a list of actions that moves from `start` to the nearest cell\n      in `targets`.  If none of the targets are reachable, return None.\"\"\"\n      target_set = set(targets)\n      if start in target_set:\n          return []\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          cur, path = q.popleft()\n          for dx, dy, act in DIRS:\n              nxt = (cur[0] + dx, cur[1] + dy)\n              if not in_bounds(nxt) or not walkable(nxt):\n                  continue\n              if nxt in visited:\n                  continue\n              new_path = path + [act]\n              if nxt in target_set:\n                  return new_path\n              visited.add(nxt)\n              q.append((nxt, new_path))\n      return None\n\n  # -------------------------------------------------------------------------\n  # Determine which primitives we need to collect\n  # -------------------------------------------------------------------------\n  primitives_needed = cookbook.primitives_for(goal_idx)\n  # If the goal has no recipe, it is itself a primitive we just need to pick up.\n  if not primitives_needed:\n      primitives_needed = {goal_idx: 1}\n      recipe_exists = False\n  else:\n      recipe_exists = True\n\n  actions = []\n\n  # -------------------------------------------------------------------------\n  # Collect all required primitives\n  # -------------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      collected = 0\n      while collected < needed_cnt:\n          # Find all grid cells that currently contain this primitive\n          locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not locations:\n              # Required primitive not present \u2013 abort\n              return []\n          # Compute a path to the nearest such location\n          path = bfs_path(cur_pos, locations)\n          if path is None:\n              return []  # unreachable\n          actions.extend(path)\n          cur_pos = locations[0]  # bfs_path always returns a path to the first reachable target\n          # Pick it up\n          actions.append(USE)\n          collected += 1\n          # Update our internal copy of the grid to reflect removal\n          grid[cur_pos[0], cur_pos[1], prim_idx] = 0\n\n  # -------------------------------------------------------------------------\n  # If crafting is required, move to the appropriate workshop and use\n  # -------------------------------------------------------------------------\n  if recipe_exists:\n      recipe = cookbook.recipes.get(goal_idx, {})\n      workshop_kind = recipe.get(\"_at\", None)\n      if workshop_kind is not None:\n          ws_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n          if not ws_cells:\n              return []  # no workshop present\n          path = bfs_path(cur_pos, ws_cells)\n          if path is None:\n              return []  # unreachable workshop\n          actions.extend(path)\n          cur_pos = ws_cells[0]  # nearest workshop\n          actions.append(USE)   # craft at workshop\n      else:\n          # No specific workshop \u2013 just use at current location\n          actions.append(USE)\n\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:31:55.812730", "function_name": "make_stick", "function_body": "  import numpy as np\n  from collections import deque\n\n  # -------------------------------------------------------------------------\n  # Action mapping and movement directions\n  # -------------------------------------------------------------------------\n  action_map = env.action_specs()\n  DOWN = action_map.get(\"DOWN\", 0)\n  UP = action_map.get(\"UP\", 1)\n  LEFT = action_map.get(\"LEFT\", 2)\n  RIGHT = action_map.get(\"RIGHT\", 3)\n  USE = action_map.get(\"USE\", 4)\n\n  DIRS = [\n      (1, 0, DOWN),   # down  (increase row)\n      (-1, 0, UP),    # up    (decrease row)\n      (0, -1, LEFT),  # left  (decrease col)\n      (0, 1, RIGHT),  # right (increase col)\n  ]\n\n  # -------------------------------------------------------------------------\n  # Extract essential objects from the environment\n  # -------------------------------------------------------------------------\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      return []\n\n  world = getattr(env, \"world\", None)\n  if world is None:\n      return []\n\n  cookbook = getattr(world, \"cookbook\", None)\n  if cookbook is None:\n      return []\n\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []\n\n  grid = getattr(state, \"grid\", None)\n  cur_pos = getattr(state, \"pos\", None)\n  if grid is None or cur_pos is None:\n      return []\n\n  H, W = grid.shape[0], grid.shape[1]\n\n  # -------------------------------------------------------------------------\n  # Helper utilities for navigation\n  # -------------------------------------------------------------------------\n  non_grabbable = set(world.non_grabbable_indices)\n\n  def in_bounds(p):\n      return 0 <= p[0] < H and 0 <= p[1] < W\n\n  def walkable(p):\n      if not in_bounds(p):\n          return False\n      for idx in non_grabbable:\n          if grid[p[0], p[1], idx] > 0:\n              return False\n      return True\n\n  def bfs_path(start, targets):\n      \"\"\"Return (action_list, target_cell) for the nearest reachable target.\"\"\"\n      target_set = set(targets)\n      if start in target_set:\n          return [], start\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          cur, path = q.popleft()\n          for dx, dy, act in DIRS:\n              nxt = (cur[0] + dx, cur[1] + dy)\n              if not in_bounds(nxt) or not walkable(nxt):\n                  continue\n              if nxt in visited:\n                  continue\n              new_path = path + [act]\n              if nxt in target_set:\n                  return new_path, nxt\n              visited.add(nxt)\n              q.append((nxt, new_path))\n      return None, None  # unreachable\n\n  # -------------------------------------------------------------------------\n  # Determine which primitives we need to collect\n  # -------------------------------------------------------------------------\n  primitives_needed = cookbook.primitives_for(goal_idx)\n  if not primitives_needed:\n      # The goal itself is a primitive; just collect it.\n      primitives_needed = {goal_idx: 1}\n\n  actions = []\n\n  # -------------------------------------------------------------------------\n  # Collect each required primitive\n  # -------------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      collected = 0\n      while collected < needed_cnt:\n          # Find all cells currently holding this primitive.\n          locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not locations:\n              return []  # cannot satisfy the requirement\n\n          path, target = bfs_path(cur_pos, locations)\n          if path is None:\n              return []  # unreachable primitive\n\n          actions.extend(path)\n          cur_pos = target\n          actions.append(USE)               # pick up the primitive\n          collected += 1\n\n          # Update our internal copy of the grid to reflect the pickup.\n          grid[cur_pos[0], cur_pos[1], prim_idx] = 0\n\n  # -------------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the goal item\n  # -------------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n\n  if workshop_kind is not None:\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n      if not workshop_cells:\n          return []  # no workshop present\n\n      path, target = bfs_path(cur_pos, workshop_cells)\n      if path is None:\n          return []  # unreachable workshop\n\n      actions.extend(path)\n      cur_pos = target\n      actions.append(USE)   # craft at the workshop\n  else:\n      # No specific workshop needed; just use the current cell.\n      actions.append(USE)\n\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:32:16.672702", "function_name": "make_stick", "function_body": "  # ----------------------------------------------------------------------\n  # Helper utilities (local to the function)\n  # ----------------------------------------------------------------------\n  from collections import deque\n  import numpy as np\n\n  # Action constants as defined by CraftLab\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  ACTION_DELTAS = {\n      DOWN:  (0, 1),\n      UP:    (0, -1),\n      LEFT:  (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  # ----------------------------------------------------------------------\n  # Access current state and world information\n  # ----------------------------------------------------------------------\n  state = env._current_state                # type: CraftState\n  world = env.world                         # type: CraftWorld\n  grid = state.grid.copy()                  # (W, H, n_kinds) uint8/int\n  pos = tuple(state.pos)                    # (x, y)\n  direction = int(state.dir)                # 0\u20113\n\n  # ----------------------------------------------------------------------\n  # Identify the goal (stick) index and its recipe\n  # ----------------------------------------------------------------------\n  # The task stored in the Lab contains the goal; we extract its index.\n  # If the Lab does not expose it directly we fall back to the name\n  # \u201cstick\u201d in the world\u2019s cookbook.\n  try:\n      goal_idx = env.task.goal          # may already be an integer index\n      if not isinstance(goal_idx, int):\n          goal_idx = world.cookbook.index[goal_idx]\n  except Exception:\n      goal_idx = world.cookbook.index[\"stick\"]\n\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  # ----------------------------------------------------------------------\n  # Determine required primitives and the workshop where the goal must be crafted\n  # ----------------------------------------------------------------------\n  required_primitives = {}\n  workshop_kind = None\n  for ing, cnt in recipe.items():\n      if ing == \"_at\":\n          workshop_kind = cnt               # this is an index, not a count\n      else:\n          required_primitives[int(ing)] = int(cnt)\n\n  # ----------------------------------------------------------------------\n  # Utility: find all coordinates of a given kind in the current grid\n  # ----------------------------------------------------------------------\n  def find_all(kind):\n      \"\"\"Return list of (x, y) where grid[..., kind] > 0.\"\"\"\n      coords = np.argwhere(grid[:, :, kind] > 0)\n      return [(int(x), int(y)) for x, y in coords]\n\n  # ----------------------------------------------------------------------\n  # Utility: simple BFS returning a list of actions to move from start to any\n  #          cell in the `targets` set (targets are (x, y) tuples). The BFS\n  #          avoids cells that are occupied by any non\u2011zero kind.\n  # ----------------------------------------------------------------------\n  def bfs(start, targets, avoid_kind=None):\n      \"\"\"Return list of actions to reach a cell adjacent to a target.\"\"\"\n      W, H, _ = grid.shape\n      visited = np.full((W, H), False, dtype=bool)\n      q = deque()\n      q.append((start, []))\n      visited[start] = True\n\n      # pre\u2011compute occupied mask (True = blocked)\n      occupied = (grid.sum(axis=2) > 0)\n      if avoid_kind is not None:\n          # cells that contain the avoid_kind are considered passable\n          occupied = occupied & (grid[:, :, avoid_kind] == 0)\n\n      while q:\n          (x, y), path = q.popleft()\n          # Check if we are adjacent (4\u2011neighbour) to any target cell\n          for tx, ty in targets:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  # we are next to target; also compute direction we need to face\n                  # Return path plus a final USE will be added by caller\n                  return path, (tx, ty)\n          # Expand neighbours\n          for act, (dx, dy) in ACTION_DELTAS.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if not occupied[nx, ny]:\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [act]))\n      # No path found\n      return None, None\n\n  # ----------------------------------------------------------------------\n  # Plan: collect each required primitive\n  # ----------------------------------------------------------------------\n  plan_actions = []\n\n  for prim_kind, needed in required_primitives.items():\n      # Find all locations of this primitive currently on the map\n      locations = find_all(prim_kind)\n      collected = 0\n      while collected < needed:\n          # Re\u2011search because the map changes after each pickup\n          locations = find_all(prim_kind)\n          if not locations:\n              # No more primitives of this type \u2013 break to avoid infinite loop\n              break\n          # Choose the closest location (Manhattan) to current position\n          locations.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          target = locations[0]\n\n          # BFS to a cell adjacent to the primitive\n          path, _ = bfs(pos, [target], avoid_kind=prim_kind)\n          if path is None:\n              # cannot reach \u2013 abort this primitive\n              break\n          # Execute movement actions\n          for a in path:\n              plan_actions.append(a)\n              # update simulated position & direction\n              dx, dy = ACTION_DELTAS[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n              direction = a\n\n          # Determine direction to face the primitive from current pos\n          px, py = target\n          if pos[0] == px and pos[1] + 1 == py:\n              face = DOWN\n          elif pos[0] == px and pos[1] - 1 == py:\n              face = UP\n          elif pos[0] + 1 == px and pos[1] == py:\n              face = RIGHT\n          elif pos[0] - 1 == px and pos[1] == py:\n              face = LEFT\n          else:\n              # Should not happen; default to current direction\n              face = direction\n          # Turn if needed\n          if face != direction:\n              plan_actions.append(face)\n              direction = face\n          # Use action to pick up\n          plan_actions.append(USE)\n\n          # Simulate the pickup: remove from grid and add to inventory\n          grid[px, py, prim_kind] = 0\n          # (inventory update not required for planning)\n\n          collected += 1\n          # Agent stays in the same cell after USE (position unchanged)\n\n  # ----------------------------------------------------------------------\n  # Move to the workshop where the stick must be crafted\n  # ----------------------------------------------------------------------\n  if workshop_kind is not None:\n      workshop_cells = find_all(workshop_kind)\n      if workshop_cells:\n          # choose nearest workshop\n          workshop_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          wk_target = workshop_cells[0]\n          path, _ = bfs(pos, [wk_target])\n          if path is not None:\n              for a in path:\n                  plan_actions.append(a)\n                  dx, dy = ACTION_DELTAS[a]\n                  pos = (pos[0] + dx, pos[1] + dy)\n                  direction = a\n              # Face the workshop (if not already)\n              wx, wy = wk_target\n              if pos[0] == wx and pos[1] + 1 == wy:\n                  face = DOWN\n              elif pos[0] == wx and pos[1] - 1 == wy:\n                  face = UP\n              elif pos[0] + 1 == wx and pos[1] == wy:\n                  face = RIGHT\n              elif pos[0] - 1 == wx and pos[1] == wy:\n                  face = LEFT\n              else:\n                  face = direction\n              if face != direction:\n                  plan_actions.append(face)\n                  direction = face\n              # Craft the stick\n              plan_actions.append(USE)\n\n  # ----------------------------------------------------------------------\n  # Return the computed action list\n  # ----------------------------------------------------------------------\n  return plan_actions", "env_interactions": 0, "island_id": 4, "scores": {"3": 0.0}}
