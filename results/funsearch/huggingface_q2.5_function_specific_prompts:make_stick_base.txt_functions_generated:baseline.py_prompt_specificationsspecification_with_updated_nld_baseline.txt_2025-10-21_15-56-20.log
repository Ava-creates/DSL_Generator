{"timestamp": "2025-10-21T17:22:34.697719", "function_name": "make_stick", "function_body": "  from collections import deque\n\n  # Get the list of action identifiers; fall back to the default ordering if needed.\n  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      action_ids = [0, 1, 2, 3, 4]  # DOWN, UP, LEFT, RIGHT, USE (standard order)\n\n  # Resolve the index of the target item \"stick\" in the world cookbook.\n  try:\n      goal_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      goal_idx = env.world.cookbook.index.get(\"stick\")\n  if goal_idx is None:\n      return []\n\n  # Helper that checks whether a given state satisfies the stick goal.\n  def is_goal(state):\n      return state.satisfies(\"\", goal_idx)\n\n  # Use the current internal state of the environment without mutating the live env.\n  start_state = getattr(env, \"_current_state\", None)\n  if start_state is None:\n      # If the attribute is missing, reset the env to obtain a state.\n      _ = env.reset()\n      start_state = env._current_state\n\n  # Bread\u2011first search over deterministic state transitions.\n  frontier = deque()\n  frontier.append((start_state, []))\n  visited = set()\n\n  # Encode a state uniquely for the visited set.\n  def state_key(st):\n      return (st.pos, st.dir, st.inventory.tobytes())\n\n  visited.add(state_key(start_state))\n  max_plan_len = 300  # safety bound to keep the search tractable\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n      if is_goal(cur_state):\n          return cur_plan\n      if len(cur_plan) >= max_plan_len:\n          continue\n      for a in action_ids:\n          _, nxt_state = cur_state.step(a)\n          key = state_key(nxt_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((nxt_state, cur_plan + [a]))\n\n  # No plan found within limits.\n  return []", "env_interactions": 4, "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T17:23:10.749521", "function_name": "make_stick", "function_body": "  import numpy as np\n\n  # Mapping of actions from the environment\n  ACTION = env.action_specs()\n\n  # Current state and world objects\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def find_nearest(pos, kind):\n      \"\"\"Return coordinates (x, y) of the nearest cell that contains `kind`.\"\"\"\n      layer = state.grid[:, :, kind]\n      ys, xs = np.where(layer > 0)\n      if len(xs) == 0:\n          return None\n      dists = np.abs(xs - pos[0]) + np.abs(ys - pos[1])\n      i = int(np.argmin(dists))\n      return (int(xs[i]), int(ys[i]))\n\n  def moves_to(cur, target):\n      \"\"\"Return a list of movement actions to go from cur \u2192 target (Manhattan).\"\"\"\n      seq = []\n      x, y = cur\n      tx, ty = target\n      while x != tx:\n          if tx > x:\n              seq.append(ACTION[\"RIGHT\"])\n              x += 1\n          else:\n              seq.append(ACTION[\"LEFT\"])\n              x -= 1\n      while y != ty:\n          if ty > y:\n              seq.append(ACTION[\"DOWN\"])\n              y += 1\n          else:\n              seq.append(ACTION[\"UP\"])\n              y -= 1\n      return seq\n\n  # ------------------------------------------------------------------\n  # Determine what primitives are needed for a stick\n  # ------------------------------------------------------------------\n  stick_idx = idx[\"stick\"]\n  needed = world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n  plan = []\n  cur_pos = state.pos\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          target = find_nearest(cur_pos, prim_idx)\n          if target is None:\n              continue  # Safety \u2013 should not happen in a valid scenario\n          plan.extend(moves_to(cur_pos, target))\n          plan.append(ACTION[\"USE\"])          # pick up the primitive\n          cur_pos = target\n\n  # ------------------------------------------------------------------\n  # Move to the appropriate workshop (if any) and craft the stick\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\", None)\n  if workshop_name is not None:\n      wk_idx = idx[workshop_name] if isinstance(workshop_name, str) else workshop_name\n      wk_pos = find_nearest(cur_pos, wk_idx)\n      if wk_pos is not None:\n          plan.extend(moves_to(cur_pos, wk_pos))\n          cur_pos = wk_pos\n\n  # Final USE to perform the crafting action\n  plan.append(ACTION[\"USE\"])\n\n  return plan", "env_interactions": 4, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T17:23:11.853467", "function_name": "make_stick", "function_body": "  import numpy as np\n\n  ACTION = {\"DOWN\": 0, \"UP\": 1, \"LEFT\": 2, \"RIGHT\": 3, \"USE\": 4}\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  width, height = state.grid.shape[0], state.grid.shape[1]\n\n  def in_bounds(x, y):\n      return 0 <= x < width and 0 <= y < height\n\n  def nearest_cell(start, kind):\n      \"\"\"Manhattan\u2011nearest cell that contains `kind`.\"\"\"\n      layer = state.grid[:, :, kind]\n      ys, xs = np.where(layer > 0)\n      if len(xs) == 0:\n          return None\n      dists = np.abs(xs - start[0]) + np.abs(ys - start[1])\n      i = int(np.argmin(dists))\n      return (int(xs[i]), int(ys[i]))\n\n  def bfs_path(start, goal, target_kind=None):\n      \"\"\"Shortest\u2011path actions from `start` to `goal` avoiding obstacles.\"\"\"\n      from collections import deque\n\n      moves = [\n          (1, 0, ACTION[\"RIGHT\"]),\n          (-1, 0, ACTION[\"LEFT\"]),\n          (0, 1, ACTION[\"DOWN\"]),\n          (0, -1, ACTION[\"UP\"]),\n      ]\n\n      queue = deque()\n      queue.append((start, []))\n      visited = {start}\n\n      while queue:\n          (x, y), path = queue.popleft()\n          if (x, y) == goal:\n              return path\n          for dx, dy, act in moves:\n              nx, ny = x + dx, y + dy\n              if not in_bounds(nx, ny):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              cell_sum = state.grid[nx, ny, :].sum()\n              # allow stepping onto the goal even if it currently holds the target kind\n              if cell_sum == 0 or (target_kind is not None and state.grid[nx, ny, target_kind] > 0):\n                  visited.add((nx, ny))\n                  queue.append(((nx, ny), path + [act]))\n      # fallback \u2013 should not happen in valid scenarios\n      return []\n\n  plan = []\n  cur_pos = state.pos\n\n  # ------------------------------------------------------------------\n  # Determine primitives required for a stick\n  # ------------------------------------------------------------------\n  stick_idx = idx[\"stick\"]\n  needed = world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Collect required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          target = nearest_cell(cur_pos, prim_idx)\n          if target is None:\n              continue  # safety: primitive missing\n          plan.extend(bfs_path(cur_pos, target, target_kind=prim_idx))\n          plan.append(ACTION[\"USE\"])          # pick up\n          cur_pos = target\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if the recipe specifies one) and craft\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop = recipe.get(\"_at\")\n  if workshop is not None:\n      wk_idx = idx[workshop] if isinstance(workshop, str) else workshop\n      wk_pos = nearest_cell(cur_pos, wk_idx)\n      if wk_pos is not None:\n          plan.extend(bfs_path(cur_pos, wk_pos, target_kind=wk_idx))\n          cur_pos = wk_pos\n\n  # Final USE performs the crafting action\n  plan.append(ACTION[\"USE\"])\n\n  return plan", "env_interactions": 4, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T17:23:34.866314", "function_name": "make_stick", "function_body": "  actions = []\n  world = env.world\n  state = env._current_state\n\n  # goal index for stick\n  stick_idx = world.cookbook.index[\"stick\"]\n  if state.inventory[stick_idx] > 0:\n      return actions\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def move_action(cur, nxt):\n      \"\"\"Convert a step from cur->nxt into an action index.\"\"\"\n      dx = nxt[0] - cur[0]\n      dy = nxt[1] - cur[1]\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise ValueError(\"Invalid movement\")\n\n  def bfs_adjacent(start, targets, grid):\n      \"\"\"Bread\u2011first search for the shortest path from start to an empty\n      cell that is orthogonally adjacent to any cell in ``targets``.\"\"\"\n      W, H, _ = grid.shape\n      visited = np.full((W, H), False, dtype=bool)\n      q = collections.deque()\n      q.append((start, []))\n      visited[start] = True\n      target_set = {tuple(t) for t in targets}\n\n      while q:\n          (x, y), path = q.popleft()\n          # stop if adjacent to a target\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path + [(x, y)]\n          # explore neighbours (only through empty cells)\n          for dx, dy in [(0, 1), (0, -1), (-1, 0), (1, 0)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if grid[nx, ny, :].sum() == 0:   # empty\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [(x, y)]))\n      raise RuntimeError(\"No reachable target\")\n\n  # ------------------------------------------------------------------\n  # 1) Collect required primitives for a stick.\n  # ------------------------------------------------------------------\n  primitive_requirements = world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n  cur_pos = tuple(state.pos)\n\n  for prim_idx, needed in primitive_requirements.items():\n      for _ in range(needed):\n          if state.inventory[prim_idx] > 0:\n              continue\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(\"Required primitive not present\")\n          path = bfs_adjacent(cur_pos, prim_cells, state.grid)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n          actions.append(4)   # USE to pick up\n\n  # ------------------------------------------------------------------\n  # 2) Go to the workshop and craft the stick.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      raise RuntimeError(\"Stick recipe missing workshop\")\n  workshop_idx = world.cookbook.index[workshop_name]\n\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      raise RuntimeError(\"Workshop not found in world\")\n  path = bfs_adjacent(cur_pos, workshop_cells, state.grid)\n  for step in path[1:]:\n      actions.append(move_action(cur_pos, step))\n      cur_pos = step\n  actions.append(4)   # USE to craft\n\n  return actions", "env_interactions": 5, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T17:23:35.994425", "function_name": "make_stick", "function_body": "  actions = []\n  world = env.world\n  state = env._current_state\n\n  stick_idx = world.cookbook.index[\"stick\"]\n  if state.inventory[stick_idx] > 0:\n      return actions\n\n  def move_action(cur, nxt):\n      dx, dy = nxt[0] - cur[0], nxt[1] - cur[1]\n      if dx == 1:   return 3   # RIGHT\n      if dx == -1:  return 2   # LEFT\n      if dy == 1:   return 0   # DOWN\n      if dy == -1:  return 1   # UP\n      raise ValueError(\"invalid move\")\n\n  def bfs_adjacent(start, targets, grid):\n      W, H, _ = grid.shape\n      visited = np.full((W, H), False, dtype=bool)\n      q = collections.deque()\n      q.append((start, []))\n      visited[start] = True\n      target_set = {tuple(t) for t in targets}\n      while q:\n          (x, y), path = q.popleft()\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path + [(x, y)]\n          for dx, dy in [(0, 1), (0, -1), (-1, 0), (1, 0)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if grid[nx, ny, :].sum() == 0:\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [(x, y)]))\n      raise RuntimeError(\"no reachable target\")\n\n  # collect required primitives\n  prim_req = world.cookbook.primitives_for(stick_idx)\n  cur_pos = tuple(state.pos)\n  for prim_idx, cnt in prim_req.items():\n      for _ in range(cnt):\n          if state.inventory[prim_idx] > 0:\n              continue\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(\"primitive not found\")\n          path = bfs_adjacent(cur_pos, prim_cells, state.grid)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n          actions.append(4)  # USE to pick up\n\n  # move to workshop and craft\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      raise RuntimeError(\"no workshop for stick\")\n  workshop_idx = world.cookbook.index[workshop_name]\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      raise RuntimeError(\"workshop not found\")\n  path = bfs_adjacent(cur_pos, workshop_cells, state.grid)\n  for step in path[1:]:\n      actions.append(move_action(cur_pos, step))\n      cur_pos = step\n  actions.append(4)  # USE to craft\n\n  return actions", "env_interactions": 5, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T17:24:01.376912", "function_name": "make_stick", "function_body": "", "env_interactions": 0, "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-10-21T17:24:02.491067", "function_name": "make_stick", "function_body": "  # Reset the environment to start a fresh episode\n  env.reset()\n  state = env._current_state          # current CraftState\n  world = env.world                    # reference to CraftWorld\n  goal_idx = env.task.goal             # index of the desired item (stick)\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def find_cells(kind):\n      \"\"\"Return a list of (x, y) positions where `kind` is present on the grid.\"\"\"\n      xs, ys = np.where(state.grid[:, :, kind] > 0)\n      return list(zip(xs, ys))\n\n  def move_to(target):\n      \"\"\"\n      Greedy Manhattan movement towards `target` (absolute coordinates).\n      Updates `state` after each step and records the actions.\n      \"\"\"\n      nonlocal state\n      while state.pos != target:\n          x, y = state.pos\n          tx, ty = target\n          # decide horizontal vs vertical move\n          if x < tx:\n              act = 3          # RIGHT\n              new_pos = (x + 1, y)\n          elif x > tx:\n              act = 2          # LEFT\n              new_pos = (x - 1, y)\n          elif y < ty:\n              act = 0          # DOWN\n              new_pos = (x, y + 1)\n          elif y > ty:\n              act = 1          # UP\n              new_pos = (x, y - 1)\n          else:\n              break\n          actions.append(act)\n          # env.step returns (reward, done, obs); we only need the side\u2011effects\n          env.step(act)\n          state = env._current_state\n          # safety break in case we get stuck (blocked cell)\n          if state.pos == (x, y):\n              # try a different direction (simple fallback: break)\n              break\n\n  # ------------------------------------------------------------------\n  # 1. Gather all primitive resources required for the goal item\n  # ------------------------------------------------------------------\n  primitives_needed = world.cookbook.primitives_for(goal_idx)  # dict {kind_idx: count}\n  actions = []\n\n  for kind_idx, needed_cnt in primitives_needed.items():\n      while state.inventory[kind_idx] < needed_cnt:\n          # locate the nearest cell containing this primitive\n          cells = find_cells(kind_idx)\n          if not cells:\n              raise RuntimeError(f\"Required primitive {kind_idx} not found on the map.\")\n          distances = [abs(state.pos[0] - cx) + abs(state.pos[1] - cy) for (cx, cy) in cells]\n          target_cell = cells[int(np.argmin(distances))]\n\n          # move next to (or onto) that cell\n          move_to(target_cell)\n\n          # attempt to pick it up\n          actions.append(4)            # USE\n          env.step(4)\n          state = env._current_state\n\n  # ------------------------------------------------------------------\n  # 2. Go to any workshop that can craft the goal item\n  # ------------------------------------------------------------------\n  workshop_cells = []\n  for w_idx in world.workshop_indices:\n      xs, ys = np.where(state.grid[:, :, w_idx] > 0)\n      workshop_cells.extend(list(zip(xs, ys)))\n\n  if workshop_cells:\n      distances = [abs(state.pos[0] - cx) + abs(state.pos[1] - cy) for (cx, cy) in workshop_cells]\n      nearest_ws = workshop_cells[int(np.argmin(distances))]\n      move_to(nearest_ws)\n\n  # ------------------------------------------------------------------\n  # 3. Craft the item (stick) by using the workshop\n  # ------------------------------------------------------------------\n  # Keep using the workshop until the goal appears in the inventory\n  while state.inventory[goal_idx] == 0:\n      actions.append(4)            # USE\n      env.step(4)\n      state = env._current_state\n\n  return actions", "env_interactions": 0, "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-10-21T17:24:27.910816", "function_name": "make_stick", "function_body": "  env.reset()\n  world = env.world\n  idx = world.cookbook.index\n  stick_idx = idx[\"stick\"]\n  needed = world.cookbook.primitives_for(stick_idx)\n\n  action_map = env.action_specs()\n  DOWN = action_map[\"DOWN\"]\n  UP = action_map[\"UP\"]\n  LEFT = action_map[\"LEFT\"]\n  RIGHT = action_map[\"RIGHT\"]\n  USE = action_map[\"USE\"]\n\n  state = env._current_state\n  cur_pos = tuple(state.pos)\n  grid = state.grid.copy()\n\n  def manhattan_moves(start, goal):\n      x, y = start\n      gx, gy = goal\n      moves = []\n      while x < gx:\n          moves.append(RIGHT); x += 1\n      while x > gx:\n          moves.append(LEFT); x -= 1\n      while y < gy:\n          moves.append(DOWN); y += 1\n      while y > gy:\n          moves.append(UP); y -= 1\n      return moves\n\n  actions = []\n\n  for prim_idx, cnt in needed.items():\n      for _ in range(int(cnt)):\n          locs = np.argwhere(grid[:, :, prim_idx] > 0)\n          if locs.size == 0:\n              continue\n          target = tuple(locs[0])\n          actions.extend(manhattan_moves(cur_pos, target))\n          cur_pos = target\n          actions.append(USE)\n          grid[target[0], target[1], prim_idx] = max(0, grid[target[0], target[1], prim_idx] - 1)\n\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      ws_idx = idx[workshop_name]\n      ws_locs = np.argwhere(grid[:, :, ws_idx] > 0)\n      if ws_locs.size:\n          ws_target = tuple(ws_locs[0])\n          actions.extend(manhattan_moves(cur_pos, ws_target))\n          cur_pos = ws_target\n          actions.append(USE)\n\n  return actions", "env_interactions": 4, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T17:24:29.027006", "function_name": "make_stick", "function_body": "  import numpy as np\n\n  # Reset the environment to a fresh episode\n  env.reset()\n\n  # Shortcut references to world structures and the index mapping\n  world = env.world\n  idx = world.cookbook.index\n\n  # Index of the goal item \"stick\"\n  stick_idx = idx[\"stick\"]\n\n  # Primitives required to craft a stick\n  needed_prims = world.cookbook.primitives_for(stick_idx)\n\n  # Action mapping (e.g., {\"DOWN\":0, \"UP\":1, ...})\n  action_map = env.action_specs()\n  DOWN = action_map[\"DOWN\"]\n  UP = action_map[\"UP\"]\n  LEFT = action_map[\"LEFT\"]\n  RIGHT = action_map[\"RIGHT\"]\n  USE = action_map[\"USE\"]\n\n  # Current state information\n  state = env._current_state\n  cur_pos = tuple(state.pos)          # (x, y) coordinates\n  grid = state.grid.copy()            # local copy to track pickups\n\n  # Helper: generate a Manhattan move sequence from start to goal\n  def manhattan_moves(start, goal):\n      x, y = start\n      gx, gy = goal\n      moves = []\n      while x < gx:\n          moves.append(RIGHT)\n          x += 1\n      while x > gx:\n          moves.append(LEFT)\n          x -= 1\n      while y < gy:\n          moves.append(DOWN)\n          y += 1\n      while y > gy:\n          moves.append(UP)\n          y -= 1\n      return moves\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # 1. Collect each required primitive (respecting the required count)\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed_prims.items():\n      for _ in range(int(count)):\n          # Find any cell that still contains this primitive\n          locations = np.argwhere(grid[:, :, prim_idx] > 0)\n          if locations.size == 0:\n              # No more of this primitive on the map \u2013 should not happen\n              break\n          target = tuple(locations[0])   # pick the first occurrence\n\n          # Move to the primitive's location\n          actions.extend(manhattan_moves(cur_pos, target))\n          cur_pos = target\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update our local copy of the grid to reflect the pickup\n          grid[target[0], target[1], prim_idx] = max(\n              0, grid[target[0], target[1], prim_idx] - 1\n          )\n\n  # ------------------------------------------------------------------\n  # 2. Go to the workshop (if required) and craft the stick\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = idx[workshop_name]\n      ws_locations = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_locations.size:\n          ws_target = tuple(ws_locations[0])\n          actions.extend(manhattan_moves(cur_pos, ws_target))\n          cur_pos = ws_target\n          actions.append(USE)\n\n  return actions", "env_interactions": 4, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T17:25:05.493740", "function_name": "make_stick", "function_body": "  # ----------------------------------------------------------------------\n  # 1. Extract basic information from the environment\n  # ----------------------------------------------------------------------\n  # Action indices (DOWN, UP, LEFT, RIGHT, USE)\n  action_map = env.action_specs()\n  DOWN = action_map.get(\"DOWN\", 0)\n  UP = action_map.get(\"UP\", 1)\n  LEFT = action_map.get(\"LEFT\", 2)\n  RIGHT = action_map.get(\"RIGHT\", 3)\n  USE = action_map.get(\"USE\", 4)\n\n  # Goal item index (the task is to craft a stick, but we keep it generic)\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      # No goal information \u2013 cannot plan\n      return []\n\n  # World and cookbook give us recipes and primitive information\n  world = getattr(env, \"world\", None)\n  if world is None:\n      return []\n  cookbook = getattr(world, \"cookbook\", None)\n  if cookbook is None:\n      return []\n\n  # Current state provides the grid layout and the agent's position\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []\n  grid = getattr(state, \"grid\", None)\n  pos = getattr(state, \"pos\", None)          # (x, y)\n  if grid is None or pos is None:\n      return []\n\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # 2. Determine which primitives are required for the goal\n  # ----------------------------------------------------------------------\n  # primitives_for returns a dict {primitive_idx: count} needed for ONE unit\n  primitives_needed = cookbook.primitives_for(goal_idx)\n\n  # If the goal has no recipe, treat it as a primitive that must be collected\n  if not primitives_needed:\n      primitives_needed = {goal_idx: 1}\n\n  # ----------------------------------------------------------------------\n  # Helper: Manhattan path generator (returns list of move actions)\n  # ----------------------------------------------------------------------\n  def manhattan_path(start, target):\n      \"\"\"Generate a list of move actions that walk from start to target.\"\"\"\n      sx, sy = start\n      tx, ty = target\n      path = []\n      # Move in x direction (rows)\n      while sx < tx:\n          path.append(DOWN)\n          sx += 1\n      while sx > tx:\n          path.append(UP)\n          sx -= 1\n      # Move in y direction (cols)\n      while sy < ty:\n          path.append(RIGHT)\n          sy += 1\n      while sy > ty:\n          path.append(LEFT)\n          sy -= 1\n      return path\n\n  # ----------------------------------------------------------------------\n  # 3. Collect each required primitive (respecting required counts)\n  # ----------------------------------------------------------------------\n  # We will re\u2011search the grid after each pickup because the primitive may\n  # disappear from the cell we just used.\n  current_pos = pos\n  for prim_idx, count_needed in primitives_needed.items():\n      collected = 0\n      while collected < count_needed:\n          # Locate all cells that currently contain this primitive\n          locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not locations:\n              # Primitive not present anywhere \u2013 abort planning\n              return []\n          # Choose the nearest location (Manhattan distance)\n          nearest = min(locations,\n                        key=lambda loc: abs(loc[0] - current_pos[0]) +\n                                        abs(loc[1] - current_pos[1]))\n          # Move to that cell\n          actions.extend(manhattan_path(current_pos, nearest))\n          current_pos = nearest\n          # Pick it up\n          actions.append(USE)\n          collected += 1\n          # Update our internal view of the grid: remove one unit from that cell\n          # (most environments store primitives as binary occupancy, so we clear it)\n          grid[current_pos[0], current_pos[1], prim_idx] = 0\n\n  # ----------------------------------------------------------------------\n  # 4. If the recipe specifies a workshop, move there\n  # ----------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n\n  if workshop_kind is not None:\n      # Find all workshop cells of the required kind\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n      if not workshop_cells:\n          # No workshop of the required type \u2013 cannot finish task\n          return []\n      # Move to the nearest workshop\n      nearest_ws = min(workshop_cells,\n                       key=lambda loc: abs(loc[0] - current_pos[0]) +\n                                       abs(loc[1] - current_pos[1]))\n      actions.extend(manhattan_path(current_pos, nearest_ws))\n      current_pos = nearest_ws\n\n  # ----------------------------------------------------------------------\n  # 5. Craft the goal item (USE at the workshop or at the current location)\n  # ----------------------------------------------------------------------\n  actions.append(USE)\n\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T17:25:06.630242", "function_name": "make_stick", "function_body": "  # Get action indices from the environment\n  act_spec = env.action_specs()\n  DOWN = act_spec.get(\"DOWN\", 0)\n  UP = act_spec.get(\"UP\", 1)\n  LEFT = act_spec.get(\"LEFT\", 2)\n  RIGHT = act_spec.get(\"RIGHT\", 3)\n  USE = act_spec.get(\"USE\", 4)\n\n  actions = []\n\n  # Access world and cookbook\n  world = getattr(env, \"world\", None)\n  if world is None:\n      return actions\n  cookbook = getattr(world, \"cookbook\", None)\n  if cookbook is None:\n      return actions\n\n  # Identify the stick item index\n  stick_idx = cookbook.index.get(\"stick\")\n  if stick_idx is None:\n      return actions\n\n  # Determine which primitive resources are required for a stick\n  primitives_needed = cookbook.primitives_for(stick_idx)\n  # If there is no recipe (stick is primitive) treat it as a direct collect\n  if not primitives_needed:\n      primitives_needed = {stick_idx: 1}\n\n  # Current state information\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return actions\n  grid = state.grid.copy()\n  pos = state.pos  # (row, col)\n\n  # -----------------------------------------------------------------\n  # Helper utilities\n  # -----------------------------------------------------------------\n  def move_to(target):\n      \"\"\"Append actions that move the agent from its current position\n      to *target* (row, col) using a simple Manhattan walk.\"\"\"\n      nonlocal pos\n      tr, tc = target\n      while pos[0] < tr:\n          actions.append(DOWN)\n          pos = (pos[0] + 1, pos[1])\n      while pos[0] > tr:\n          actions.append(UP)\n          pos = (pos[0] - 1, pos[1])\n      while pos[1] < tc:\n          actions.append(RIGHT)\n          pos = (pos[0], pos[1] + 1)\n      while pos[1] > tc:\n          actions.append(LEFT)\n          pos = (pos[0], pos[1] - 1)\n\n  def locations_of(kind):\n      \"\"\"Return a list of (row, col) positions where *kind* appears in *grid*.\"\"\"\n      locs = np.argwhere(grid[:, :, kind] > 0)\n      return [tuple(map(int, loc)) for loc in locs]\n\n  # -----------------------------------------------------------------\n  # Collect all required primitives\n  # -----------------------------------------------------------------\n  for prim_idx, count in primitives_needed.items():\n      for _ in range(count):\n          locs = locations_of(prim_idx)\n          if not locs:\n              # Primitive not present \u2013 cannot solve the task.\n              return []\n          # Choose the nearest location (Manhattan distance)\n          distances = [abs(pos[0] - r) + abs(pos[1] - c) for r, c in locs]\n          target = locs[int(np.argmin(distances))]\n          # Move next to the primitive and pick it up\n          move_to(target)\n          actions.append(USE)\n          # Remove the primitive from our internal copy of the grid\n          grid[target[0], target[1], prim_idx] = 0\n\n  # -----------------------------------------------------------------\n  # Move to the appropriate workshop (if the recipe specifies one)\n  # -----------------------------------------------------------------\n  recipe = cookbook.recipes.get(stick_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      ws_locs = locations_of(workshop_kind)\n      if not ws_locs:\n          return []\n      distances = [abs(pos[0] - r) + abs(pos[1] - c) for r, c in ws_locs]\n      workshop_target = ws_locs[int(np.argmin(distances))]\n      move_to(workshop_target)\n      actions.append(USE)  # craft the stick\n\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-10-21T17:25:33.960267", "function_name": "make_stick", "function_body": "  # Reset environment to a fresh state\n  env.reset()\n\n  # Shortcut references to world and index\n  world = env.world\n  idx = world.cookbook.index\n\n  # Identify the index for the goal item \"stick\"\n  try:\n      stick_idx = idx[\"stick\"]\n  except Exception:  # pragma: no cover\n      # case\u2011insensitive fallback\n      stick_idx = next(i for i, n in enumerate(idx.ordered_contents) if n.lower() == \"stick\")\n\n  # Determine primitive requirements for a stick.\n  # If the stick itself is primitive, treat it as a required primitive.\n  needed = world.cookbook.primitives_for(stick_idx)\n  if not needed:\n      needed = {stick_idx: 1}\n\n  # Action mapping (DOWN, UP, LEFT, RIGHT, USE)\n  action_map = env.action_specs()\n  DOWN = action_map[\"DOWN\"]\n  UP = action_map[\"UP\"]\n  LEFT = action_map[\"LEFT\"]\n  RIGHT = action_map[\"RIGHT\"]\n  USE = action_map[\"USE\"]\n\n  # ----------------------------------------------------------------------\n  # Helper utilities\n  # ----------------------------------------------------------------------\n  def delta_to_action(dx: int, dy: int) -> int:\n      \"\"\"Translate a step delta into the corresponding action index.\"\"\"\n      if dx == 1:\n          return RIGHT\n      if dx == -1:\n          return LEFT\n      if dy == 1:\n          return DOWN\n      if dy == -1:\n          return UP\n      raise ValueError(\"Invalid movement delta\")\n\n  def bfs_path(start, goal, grid):\n      \"\"\"Return a list of positions from start to goal using BFS,\n      or None if no walkable path exists.\"\"\"\n      w, h, _ = grid.shape\n      start = tuple(start)\n      goal = tuple(goal)\n      if start == goal:\n          return [start]\n\n      # cells blocked by any non\u2011grabbable entity\n      blocked = np.zeros((w, h), dtype=bool)\n      for k in world.non_grabbable_indices:\n          blocked |= grid[:, :, k] > 0\n\n      q = collections.deque([start])\n      came_from = {start: None}\n      while q:\n          x, y = q.popleft()\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and not blocked[nx, ny]:\n                  nxt = (nx, ny)\n                  if nxt not in came_from:\n                      came_from[nxt] = (x, y)\n                      if nxt == goal:\n                          # reconstruct path\n                          path = [goal]\n                          while path[-1] != start:\n                              path.append(came_from[path[-1]])\n                          path.reverse()\n                          return path\n                      q.append(nxt)\n      return None  # no reachable path\n\n  def positions_to_actions(path):\n      \"\"\"Convert a list of positions into a list of action indices.\"\"\"\n      acts = []\n      for (x0, y0), (x1, y1) in zip(path, path[1:]):\n          acts.append(delta_to_action(x1 - x0, y1 - y0))\n      return acts\n\n  def bfs_to_primitive(start, prim_idx, grid):\n      \"\"\"Find the nearest cell containing the given primitive using BFS.\n      Returns (path, target_pos) or (None, None) if unreachable.\"\"\"\n      w, h, _ = grid.shape\n      start = tuple(start)\n\n      # blocked cells as before\n      blocked = np.zeros((w, h), dtype=bool)\n      for k in world.non_grabbable_indices:\n          blocked |= grid[:, :, k] > 0\n\n      q = collections.deque([start])\n      came_from = {start: None}\n      while q:\n          x, y = q.popleft()\n          # check if this cell holds the primitive\n          if grid[x, y, prim_idx] > 0:\n              # reconstruct path to this cell\n              path = [(x, y)]\n              while path[-1] != start:\n                  path.append(came_from[path[-1]])\n              path.reverse()\n              return path, (x, y)\n\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and not blocked[nx, ny]:\n                  nxt = (nx, ny)\n                  if nxt not in came_from:\n                      came_from[nxt] = (x, y)\n                      q.append(nxt)\n      return None, None\n\n  # ----------------------------------------------------------------------\n  # Initialise simulation bookkeeping\n  # ----------------------------------------------------------------------\n  state = env._current_state\n  cur_pos = tuple(state.pos)          # (x, y)\n  grid = state.grid.copy()            # mutable copy for bookkeeping\n\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # 1. Collect all required primitives (respecting quantity)\n  # ----------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(int(cnt)):\n          # Locate the nearest reachable instance of the primitive\n          path, target = bfs_to_primitive(cur_pos, prim_idx, grid)\n          if path is None:\n              # Primitive not reachable \u2013 fallback to any existing location\n              locs = np.argwhere(grid[:, :, prim_idx] > 0)\n              if locs.size == 0:\n                  # No more of this primitive; abort further collection\n                  break\n              target = tuple(locs[0])\n              # Use simple Manhattan moves as a last resort\n              x, y = cur_pos\n              tx, ty = target\n              while x < tx:\n                  actions.append(RIGHT); x += 1\n              while x > tx:\n                  actions.append(LEFT);  x -= 1\n              while y < ty:\n                  actions.append(DOWN);  y += 1\n              while y > ty:\n                  actions.append(UP);    y -= 1\n              cur_pos = target\n          else:\n              # Translate the BFS path into actions\n              actions.extend(positions_to_actions(path))\n              cur_pos = target\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update local grid copy to reflect the pickup\n          grid[target[0], target[1], prim_idx] = max(\n              0, grid[target[0], target[1], prim_idx] - 1\n          )\n\n  # ----------------------------------------------------------------------\n  # 2. Navigate to the workshop (if required) and craft the stick\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = idx[workshop_name]\n      ws_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_locs.size:\n          ws_target = tuple(ws_locs[0])\n          path = bfs_path(cur_pos, ws_target, grid)\n          if path is None:\n              # fallback Manhattan moves\n              x, y = cur_pos\n              tx, ty = ws_target\n              while x < tx:\n                  actions.append(RIGHT); x += 1\n              while x > tx:\n                  actions.append(LEFT);  x -= 1\n              while y < ty:\n                  actions.append(DOWN);  y += 1\n              while y > ty:\n                  actions.append(UP);    y -= 1\n              cur_pos = ws_target\n          else:\n              actions.extend(positions_to_actions(path))\n              cur_pos = ws_target\n\n          # Use the workshop to craft the stick\n          actions.append(USE)\n\n  # Return the complete action sequence\n  return actions", "env_interactions": 4, "island_id": 0, "scores": {"3": 0.0}}
