{"timestamp": "2025-10-21T21:00:26.410030", "function_name": "make_stick", "function_body": "  ACTION = env.action_specs()\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  # index of the target item\n  stick_idx = idx[\"stick\"]\n  # primitives required to craft the stick (empty if stick is primitive)\n  needed = world.cookbook.primitives_for(stick_idx)\n\n  actions = []\n  cur_pos = tuple(state.pos)\n  grid = state.grid\n\n  def find_nearest(pos, kind):\n      \"\"\"Return (x, y) of the nearest cell that contains `kind`.\"\"\"\n      layer = grid[:, :, kind]\n      ys, xs = np.where(layer > 0)\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - pos[0]) + np.abs(ys - pos[1])\n      i = int(np.argmin(dists))\n      return (int(xs[i]), int(ys[i]))\n\n  def moves_to(start, target):\n      \"\"\"Generate a list of movement actions (Manhattan) from start to target.\"\"\"\n      seq = []\n      x, y = start\n      tx, ty = target\n      while x != tx:\n          if tx > x:\n              seq.append(ACTION[\"RIGHT\"])\n              x += 1\n          else:\n              seq.append(ACTION[\"LEFT\"])\n              x -= 1\n      while y != ty:\n          if ty > y:\n              seq.append(ACTION[\"DOWN\"])\n              y += 1\n          else:\n              seq.append(ACTION[\"UP\"])\n              y -= 1\n      return seq\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          tgt = find_nearest(cur_pos, prim_idx)\n          if tgt is None:\n              continue  # safety: primitive not present\n          actions.extend(moves_to(cur_pos, tgt))\n          actions.append(ACTION[\"USE\"])   # pick up the primitive\n          cur_pos = tgt\n\n  # ------------------------------------------------------------------\n  # Move to the appropriate workshop (if any) and craft the stick\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      wk_idx = idx[workshop_name] if isinstance(workshop_name, str) else workshop_name\n      wk_pos = find_nearest(cur_pos, wk_idx)\n      if wk_pos is not None:\n          actions.extend(moves_to(cur_pos, wk_pos))\n          cur_pos = wk_pos\n\n  # Final USE to perform the crafting action (or pick\u2011up if primitive)\n  actions.append(ACTION[\"USE\"])\n\n  return actions", "env_interactions": 4, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:00:27.515624", "function_name": "make_stick", "function_body": "  import numpy as np\n\n  # Mapping from action name to integer index\n  ACTION = env.action_specs()\n\n  # Current state and world objects\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  # ------------------------------------------------------------------\n  # Helper functions\n  # ------------------------------------------------------------------\n  def find_nearest(pos, kind):\n      \"\"\"Return (x, y) of the nearest cell containing `kind`.\"\"\"\n      layer = state.grid[:, :, kind]\n      ys, xs = np.where(layer > 0)\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - pos[0]) + np.abs(ys - pos[1])\n      i = int(np.argmin(dists))\n      return (int(xs[i]), int(ys[i]))\n\n  def moves_to(cur, target):\n      \"\"\"Return a list of movement actions from cur \u2192 target (Manhattan).\"\"\"\n      seq = []\n      x, y = cur\n      tx, ty = target\n      while x != tx:\n          if tx > x:\n              seq.append(ACTION[\"RIGHT\"])\n              x += 1\n          else:\n              seq.append(ACTION[\"LEFT\"])\n              x -= 1\n      while y != ty:\n          if ty > y:\n              seq.append(ACTION[\"DOWN\"])\n              y += 1\n          else:\n              seq.append(ACTION[\"UP\"])\n              y -= 1\n      return seq\n\n  # ------------------------------------------------------------------\n  # Determine what is needed to craft a stick\n  # ------------------------------------------------------------------\n  stick_idx = idx[\"stick\"]\n  needed = world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n  plan = []\n  cur_pos = tuple(state.pos)\n\n  # ------------------------------------------------------------------\n  # Collect required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          target = find_nearest(cur_pos, prim_idx)\n          if target is None:\n              # Primitive not present; cannot proceed, break early\n              continue\n          plan.extend(moves_to(cur_pos, target))\n          plan.append(ACTION[\"USE\"])  # pick up the primitive\n          cur_pos = target\n\n  # ------------------------------------------------------------------\n  # Move to the appropriate workshop (if any) and craft the stick\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      wk_idx = idx[workshop_name] if isinstance(workshop_name, str) else workshop_name\n      wk_pos = find_nearest(cur_pos, wk_idx)\n      if wk_pos is not None:\n          plan.extend(moves_to(cur_pos, wk_pos))\n          cur_pos = wk_pos\n\n  # Final USE to perform the crafting action (or simply pick up if primitive)\n  plan.append(ACTION[\"USE\"])\n\n  return plan", "env_interactions": 4, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:00:54.581438", "function_name": "make_stick", "function_body": "  # reset environment to start fresh\n  env.reset()\n\n  # shortcuts\n  world = env.world\n  idx = world.cookbook.index\n  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act[\"DOWN\"], act[\"UP\"], act[\"LEFT\"], act[\"RIGHT\"], act[\"USE\"]\n  )\n\n  # index of the target item \u201cstick\u201d\n  try:\n      stick_idx = idx[\"stick\"]\n  except Exception:  # pragma: no cover\n      stick_idx = next(i for i, n in enumerate(idx.ordered_contents) if n.lower() == \"stick\")\n\n  # primitive requirements for one stick\n  needed = world.cookbook.primitives_for(stick_idx)\n  if not needed:\n      needed = {stick_idx: 1}\n\n  # current simulated state (grid, position, blocked cells)\n  state = env._current_state\n  cur_pos = tuple(state.pos)               # (x, y)\n  grid = state.grid.copy()                 # mutable copy for planning\n\n  # cells occupied by non\u2011grabbable entities are blocked for movement\n  non_grabbable = list(world.non_grabbable_indices)\n  if non_grabbable:\n      blocked = np.any(grid[:, :, non_grabbable] > 0, axis=2)\n  else:\n      blocked = np.zeros(grid.shape[:2], dtype=bool)\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions from start to any target\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  def bfs_actions(start, targets, blocked_mask):\n      \"\"\"Return actions to reach the nearest cell in *targets* from *start*.\n      If no walkable path exists, fall back to Manhattan moves (ignoring obstacles).\"\"\"\n      if start in targets:\n          return []\n\n      q = deque([start])\n      # visited maps position -> (parent_position, action_to_reach)\n      visited = {start: (None, None)}\n\n      while q:\n          cur = q.popleft()\n          for act_code, (dx, dy) in (\n              (DOWN, (0, 1)),\n              (UP, (0, -1)),\n              (LEFT, (-1, 0)),\n              (RIGHT, (1, 0)),\n          ):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if not (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]):\n                  continue\n              if blocked_mask[nx, ny]:\n                  continue\n              nxt = (nx, ny)\n              if nxt in visited:\n                  continue\n              visited[nxt] = (cur, act_code)\n              if nxt in targets:\n                  # reconstruct actions\n                  rev = []\n                  node = nxt\n                  while visited[node][0] is not None:\n                      parent, a = visited[node]\n                      rev.append(a)\n                      node = parent\n                  return list(reversed(rev))\n              q.append(nxt)\n\n      # ----- fallback: Manhattan moves -----\n      target = next(iter(targets))\n      x, y = start\n      tx, ty = target\n      path = []\n      while x < tx:\n          path.append(RIGHT); x += 1\n      while x > tx:\n          path.append(LEFT);  x -= 1\n      while y < ty:\n          path.append(DOWN);  y += 1\n      while y > ty:\n          path.append(UP);    y -= 1\n      return path\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives (or the stick itself)\n  # ------------------------------------------------------------------\n  for kind_idx, count in needed.items():\n      remaining = int(count)\n      while remaining > 0:\n          # locate all cells that currently contain this kind\n          cells = np.argwhere(grid[:, :, kind_idx] > 0)\n          if cells.size == 0:\n              # nothing left on map \u2013 break to avoid infinite loop\n              break\n          # choose the nearest cell by Manhattan distance\n          dists = np.abs(cells[:, 0] - cur_pos[0]) + np.abs(cells[:, 1] - cur_pos[1])\n          target = tuple(cells[dists.argmin()])\n\n          # move to the target\n          actions += bfs_actions(cur_pos, {target}, blocked)\n          cur_pos = target\n\n          # pick it up\n          actions.append(USE)\n          remaining -= 1\n\n          # update simulated grid and blocked mask after pickup\n          grid[target[0], target[1], kind_idx] -= 1\n          if non_grabbable:\n              blocked[target[0], target[1]] = np.any(\n                  grid[target[0], target[1], non_grabbable] > 0\n              )\n\n  # ------------------------------------------------------------------\n  # 2. If a workshop is required, go there and craft the stick\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = idx[workshop_name]\n      ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_cells.size:\n          ws_target = tuple(ws_cells[0])\n          actions += bfs_actions(cur_pos, {ws_target}, blocked)\n          cur_pos = ws_target\n          actions.append(USE)   # craft at the workshop\n\n  return actions", "env_interactions": 4, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:00:55.701427", "function_name": "make_stick", "function_body": "  env.reset()\n  world = env.world\n  idx = world.cookbook.index\n  action_map = env.action_specs()\n  DOWN = action_map[\"DOWN\"]\n  UP = action_map[\"UP\"]\n  LEFT = action_map[\"LEFT\"]\n  RIGHT = action_map[\"RIGHT\"]\n  USE = action_map[\"USE\"]\n\n  # goal index for stick (case\u2011insensitive fallback)\n  try:\n      goal_idx = idx[\"stick\"]\n  except Exception:  # pragma: no cover\n      goal_idx = next(i for i, n in enumerate(idx.ordered_contents) if n.lower() == \"stick\")\n\n  # primitives required for the goal\n  needed = world.cookbook.primitives_for(goal_idx)\n  if not needed:\n      needed = {goal_idx: 1}\n\n  # snapshot of current state for planning\n  state = env._current_state\n  cur_pos = tuple(state.pos)\n  grid = state.grid.copy()\n\n  # blocked cells (non\u2011grabbable entities)\n  non_grabbable = list(world.non_grabbable_indices)\n  if non_grabbable:\n      blocked = np.any(grid[:, :, non_grabbable] > 0, axis=2)\n  else:\n      blocked = np.zeros(grid.shape[:2], dtype=bool)\n\n  actions = []\n\n  # ---------- helpers ----------\n  def delta_to_action(dx, dy):\n      if dx == 1:\n          return RIGHT\n      if dx == -1:\n          return LEFT\n      if dy == 1:\n          return DOWN\n      if dy == -1:\n          return UP\n      raise ValueError\n\n  def bfs(start, goal):\n      \"\"\"return list of positions from start to goal (inclusive) avoiding blocked cells\"\"\"\n      if start == goal:\n          return [start]\n      w, h = blocked.shape\n      q = collections.deque([start])\n      came = {start: None}\n      while q:\n          x, y = q.popleft()\n          for dx, dy in ((1,0),(-1,0),(0,1),(0,-1)):\n              nx, ny = x+dx, y+dy\n              if 0 <= nx < w and 0 <= ny < h and not blocked[nx, ny]:\n                  if (nx,ny) not in came:\n                      came[(nx,ny)] = (x,y)\n                      if (nx,ny) == goal:\n                          # reconstruct\n                          path = [goal]\n                          while path[-1] != start:\n                              path.append(came[path[-1]])\n                          path.reverse()\n                          return path\n                      q.append((nx,ny))\n      return None\n\n  def positions_to_actions(path):\n      act = []\n      for (x0,y0),(x1,y1) in zip(path, path[1:]):\n          act.append(delta_to_action(x1-x0, y1-y0))\n      return act\n\n  # ---------- collect needed items ----------\n  for kind, cnt in needed.items():\n      for _ in range(int(cnt)):\n          locs = np.argwhere(grid[:, :, kind] > 0)\n          if locs.size == 0:\n              break\n          dists = np.abs(locs[:,0]-cur_pos[0]) + np.abs(locs[:,1]-cur_pos[1])\n          target = tuple(locs[dists.argmin()])\n          path = bfs(cur_pos, target)\n          if path is None:\n              # fallback: direct Manhattan moves\n              tmp = []\n              x,y = cur_pos\n              tx,ty = target\n              while x<tx: tmp.append(RIGHT); x+=1\n              while x>tx: tmp.append(LEFT);  x-=1\n              while y<ty: tmp.append(DOWN);  y+=1\n              while y>ty: tmp.append(UP);    y-=1\n              actions.extend(tmp)\n          else:\n              actions.extend(positions_to_actions(path))\n          cur_pos = target\n          actions.append(USE)\n          grid[target[0], target[1], kind] -= 1\n          if non_grabbable:\n              blocked[target[0], target[1]] = np.any(grid[target[0], target[1], non_grabbable] > 0)\n\n  # ---------- go to workshop if needed ----------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      ws_idx = idx[workshop_name]\n      ws_locs = np.argwhere(grid[:, :, ws_idx] > 0)\n      if ws_locs.size:\n          ws_target = tuple(ws_locs[0])\n          path = bfs(cur_pos, ws_target)\n          if path is None:\n              tmp = []\n              x,y = cur_pos\n              tx,ty = ws_target\n              while x<tx: tmp.append(RIGHT); x+=1\n              while x>tx: tmp.append(LEFT);  x-=1\n              while y<ty: tmp.append(DOWN);  y+=1\n              while y>ty: tmp.append(UP);    y-=1\n              actions.extend(tmp)\n          else:\n              actions.extend(positions_to_actions(path))\n          actions.append(USE)\n\n  return actions", "env_interactions": 4, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:01:09.197957", "function_name": "make_stick", "function_body": "  import collections\n\n  # Helper to get action IDs\n  def _get_action_ids():\n      try:\n          return list(env.action_specs().values())\n      except Exception:\n          return [0, 1, 2, 3, 4]  # fallback ordering\n\n  # Helper to get stick index\n  def _get_stick_index():\n      try:\n          return env.world.cookbook.index[\"stick\"]\n      except Exception:\n          return env.world.cookbook.index.get(\"stick\")\n\n  # Compact hashable state representation\n  def _state_key(state):\n      return (state.pos, state.dir, state.inventory.tobytes(), state.grid.tobytes())\n\n  actions = _get_action_ids()\n  stick_idx = _get_stick_index()\n\n  # Obtain initial CraftState\n  start_state = getattr(env, \"_current_state\", None)\n  if start_state is None:\n      start_state = env.scenario.init()\n\n  frontier = collections.deque()\n  frontier.append((start_state, []))\n  visited = {_state_key(start_state)}\n\n  MAX_PLAN_LEN = 500\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      if stick_idx is not None and cur_state.satisfies(\"\", stick_idx):\n          return cur_plan\n\n      if len(cur_plan) >= MAX_PLAN_LEN:\n          continue\n\n      for a in actions:\n          _, nxt_state = cur_state.step(a)\n          key = _state_key(nxt_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((nxt_state, cur_plan + [a]))\n\n  return []", "env_interactions": 4, "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T21:01:10.306379", "function_name": "make_stick", "function_body": "  # Resolve the action IDs used by the environment\n  try:\n      actions = list(env.action_specs().values())\n  except Exception:\n      # Fallback to the default ordering (DOWN, UP, LEFT, RIGHT, USE)\n      actions = [0, 1, 2, 3, 4]\n\n  # Resolve the internal index for the target item \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n\n  # Obtain the initial CraftState (lab wrapper may expose it)\n  start_state = getattr(env, \"_current_state\", None)\n  if start_state is None:\n      start_state = env.scenario.init()\n\n  # Helper to create a hashable representation of a state for visited checks\n  def _state_key(st):\n      # Include position, direction, inventory and full grid layout\n      return (st.pos, st.dir, st.inventory.tobytes(), st.grid.tobytes())\n\n  from collections import deque\n  frontier = deque()\n  frontier.append((start_state, []))\n  visited = {_state_key(start_state)}\n  MAX_PLAN_LEN = 500  # safety bound on plan length\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      # Goal test: inventory already contains a stick\n      if stick_idx is not None and cur_state.satisfies(\"\", stick_idx):\n          return cur_plan\n\n      # Prune overly long plans\n      if len(cur_plan) >= MAX_PLAN_LEN:\n          continue\n\n      # Expand all possible actions\n      for a in actions:\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((next_state, cur_plan + [a]))\n\n  # No plan found within limits \u2013 return empty list\n  return []", "env_interactions": 4, "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T21:01:24.518456", "function_name": "make_stick", "function_body": "  import collections\n\n  # Determine action IDs (fallback to default ordering if unavailable)\n  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      action_ids = [0, 1, 2, 3, 4]  # DOWN, UP, LEFT, RIGHT, USE\n\n  # Resolve the integer index for the goal item \"stick\"\n  try:\n      goal_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      world = getattr(env, \"world\", None)\n      goal_idx = None\n      if world is not None:\n          cookbook = getattr(world, \"cookbook\", None)\n          if cookbook is not None:\n              goal_idx = cookbook.index.get(\"stick\")\n  if goal_idx is None:\n      return []  # cannot locate stick index\n\n  # Obtain the current CraftState (immutable, safe for simulation)\n  start_state = getattr(env, \"_current_state\", None)\n  if start_state is None:\n      start_state = getattr(env, \"current_state\", None)\n  if start_state is None:\n      return []  # cannot access the underlying state\n\n  # Helper to hash a state for visited checking\n  def state_key(st):\n      return (st.pos, st.dir, st.inventory.tobytes())\n\n  # Breadth\u2011first search planner\n  frontier = collections.deque()\n  frontier.append((start_state, []))\n  visited = {state_key(start_state)}\n  max_plan_len = 300  # safety ceiling\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      # Goal test \u2013 inventory contains at least one stick\n      if cur_state.satisfies(\"\", goal_idx):\n          return cur_plan\n\n      if len(cur_plan) >= max_plan_len:\n          continue\n\n      # Expand all possible actions\n      for a in action_ids:\n          _, nxt_state = cur_state.step(a)\n          key = state_key(nxt_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((nxt_state, cur_plan + [a]))\n\n  # No plan found within limits\n  return []", "env_interactions": 4, "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T21:01:25.630767", "function_name": "make_stick", "function_body": "  import collections\n\n  # Obtain the list of possible action IDs, falling back to defaults if needed.\n  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      action_ids = [0, 1, 2, 3, 4]  # DOWN, UP, LEFT, RIGHT, USE\n\n  # Resolve the integer index for the goal item \"stick\".\n  try:\n      goal_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      goal_idx = None\n      world = getattr(env, \"world\", None)\n      if world is not None:\n          cookbook = getattr(world, \"cookbook\", None)\n          if cookbook is not None:\n              goal_idx = cookbook.index.get(\"stick\")\n  if goal_idx is None:\n      return []  # cannot locate stick index\n\n  # Access the current CraftState (immutable, safe for simulation).\n  start_state = getattr(env, \"_current_state\", None) or getattr(env, \"current_state\", None)\n  if start_state is None:\n      return []  # cannot access the underlying state\n\n  # Helper to create a hashable representation of a state for visited checking.\n  def state_key(st):\n      return (st.pos, st.dir, st.inventory.tobytes())\n\n  # Breadth\u2011first search planner.\n  frontier = collections.deque()\n  frontier.append((start_state, []))\n  visited = {state_key(start_state)}\n  max_plan_len = 300  # safety ceiling\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      # Goal test \u2013 inventory contains at least one stick.\n      if cur_state.satisfies(\"\", goal_idx):\n          return cur_plan\n\n      if len(cur_plan) >= max_plan_len:\n          continue\n\n      # Expand all possible actions.\n      for a in action_ids:\n          _, nxt_state = cur_state.step(a)\n          key = state_key(nxt_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((nxt_state, cur_plan + [a]))\n\n  # No plan found within limits.\n  return []", "env_interactions": 4, "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T21:01:39.988016", "function_name": "make_stick", "function_body": "  # Retrieve the list of possible action IDs\n  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      # Default ordering if the environment does not expose action_specs\n      action_ids = [0, 1, 2, 3, 4]  # DOWN, UP, LEFT, RIGHT, USE\n\n  # Resolve the index for the target item \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n  if stick_idx is None:\n      return []  # stick not defined in this world\n\n  # Ensure the environment is reset and obtain the current state\n  if not hasattr(env, \"_current_state\") or env._current_state is None:\n      env.reset()\n  start_state = env._current_state\n\n  # Goal already satisfied?\n  if start_state.inventory[stick_idx] > 0:\n      return []\n\n  from collections import deque\n\n  # Helper to uniquely identify a state for the visited set\n  def _state_key(st):\n      return (st.pos, st.dir, st.inventory.tobytes())\n\n  visited = {_state_key(start_state)}\n  frontier = deque([(start_state, [])])\n  MAX_PLAN_LEN = 400  # safety bound to keep search tractable\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      # Goal test\n      if cur_state.inventory[stick_idx] > 0:\n          return cur_plan\n\n      if len(cur_plan) >= MAX_PLAN_LEN:\n          continue\n\n      # Expand all possible actions\n      for a in action_ids:\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((next_state, cur_plan + [a]))\n\n  # No plan found within limits\n  return []", "env_interactions": 4, "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T21:01:41.107705", "function_name": "make_stick", "function_body": "  # Determine action identifiers; fall back to default ordering if unavailable.\n  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      action_ids = [0, 1, 2, 3, 4]  # DOWN, UP, LEFT, RIGHT, USE\n\n  # Resolve the index corresponding to the item \"stick\".\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n  if stick_idx is None:\n      return []  # Stick not defined in this world.\n\n  # Ensure the environment has been reset and we have a current state.\n  if not hasattr(env, \"_current_state\") or env._current_state is None:\n      env.reset()\n  start_state = env._current_state\n\n  # Goal already satisfied?\n  if start_state.inventory[stick_idx] > 0:\n      return []\n\n  from collections import deque\n\n  # Helper to uniquely identify a state for visited\u2011state tracking.\n  def _state_key(st):\n      return (st.pos, st.dir, st.inventory.tobytes(), st.grid.tobytes())\n\n  visited = {_state_key(start_state)}\n  frontier = deque([(start_state, [])])\n  MAX_PLAN_LEN = 400  # safety bound to keep search tractable\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      # Goal test.\n      if cur_state.inventory[stick_idx] > 0:\n          return cur_plan\n\n      if len(cur_plan) >= MAX_PLAN_LEN:\n          continue\n\n      # Expand all possible actions.\n      for a in action_ids:\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((next_state, cur_plan + [a]))\n\n  # No plan found within limits.\n  return []", "env_interactions": 4, "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T21:02:21.221603", "function_name": "make_stick", "function_body": "  # Reset environment to obtain fresh scenario and world objects\n  env.reset()\n  world = env.world\n  scenario = env.scenario\n\n  # Action indices as defined by CraftLab.action_specs()\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  # Index of the target item (stick)\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # Determine primitive requirements for a stick\n  primitives_needed = world.cookbook.primitives_for(stick_idx)\n  if not primitives_needed:\n      # If the recipe is empty, the stick itself is a primitive\n      primitives_needed = {stick_idx: 1}\n\n  # Local mutable copy of the grid and agent position\n  grid = scenario.init_grid.copy()\n  pos = scenario.init_pos  # (x, y)\n  actions = []\n\n  # -------------------------------------------------------------------------\n  # Helper utilities\n  # -------------------------------------------------------------------------\n  from collections import deque\n\n  def bfs(start, goal):\n      \"\"\"Return a list of movement actions from start to goal, avoiding occupied cells.\"\"\"\n      W, H = grid.shape[:2]\n      visited = set()\n      q = deque()\n      q.append((start, []))\n      visited.add(start)\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for act, (dx, dy) in (\n              (ACTION_DOWN, (0, 1)),\n              (ACTION_UP, (0, -1)),\n              (ACTION_LEFT, (-1, 0)),\n              (ACTION_RIGHT, (1, 0)),\n          ):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H:\n                  # A cell is walkable iff it contains no entities of any kind\n                  if np.any(grid[nx, ny, :] != 0):\n                      continue\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [act]))\n      return None  # unreachable\n\n  def free_adjacent(cell):\n      \"\"\"Return a list of free (unoccupied) cells adjacent to `cell`.\"\"\"\n      adj = []\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          ax, ay = cell[0] + dx, cell[1] + dy\n          if 0 <= ax < grid.shape[0] and 0 <= ay < grid.shape[1]:\n              if not np.any(grid[ax, ay, :] != 0):\n                  adj.append((ax, ay))\n      return adj\n\n  def direction_action(dx, dy):\n      \"\"\"Map a delta (dx, dy) to the corresponding movement action.\"\"\"\n      if dx == -1 and dy == 0:\n          return ACTION_LEFT\n      if dx == 1 and dy == 0:\n          return ACTION_RIGHT\n      if dx == 0 and dy == -1:\n          return ACTION_UP\n      if dx == 0 and dy == 1:\n          return ACTION_DOWN\n      return None\n\n  # -------------------------------------------------------------------------\n  # 1. Collect all required primitive items\n  # -------------------------------------------------------------------------\n  for prim_idx, count in primitives_needed.items():\n      for _ in range(count):\n          # Locate any remaining instance of the primitive\n          locations = np.argwhere(grid[:, :, prim_idx] > 0)\n          if len(locations) == 0:\n              # No more of this primitive on the map \u2013 skip (should not happen)\n              continue\n          target = tuple(locations[0])  # (x, y)\n\n          # Find a free adjacent cell from which we can USE the primitive\n          adj_cells = free_adjacent(target)\n          chosen_adj = None\n          path_to_adj = None\n          for adj in adj_cells:\n              p = bfs(pos, adj)\n              if p is not None:\n                  chosen_adj = adj\n                  path_to_adj = p\n                  break\n\n          if path_to_adj is None:\n              # Unable to reach a usable position; abort this primitive\n              continue\n\n          # Move to the chosen adjacent cell\n          actions.extend(path_to_adj)\n          pos = chosen_adj\n\n          # Face the primitive (set direction via a movement action toward it)\n          dx = target[0] - pos[0]\n          dy = target[1] - pos[1]\n          dir_act = direction_action(dx, dy)\n          if dir_act is not None:\n              actions.append(dir_act)\n\n          # Use the primitive (collect it)\n          actions.append(ACTION_USE)\n\n          # Update local grid copy to reflect the collected primitive\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # -------------------------------------------------------------------------\n  # 2. Craft the stick at its required workshop (if any)\n  # -------------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      # Locate a workshop cell of the required type\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if len(workshop_cells) > 0:\n          workshop_pos = tuple(workshop_cells[0])\n\n          # Find a free adjacent cell next to the workshop\n          adj_cells = free_adjacent(workshop_pos)\n          chosen_adj = None\n          path_to_adj = None\n          for adj in adj_cells:\n              p = bfs(pos, adj)\n              if p is not None:\n                  chosen_adj = adj\n                  path_to_adj = p\n                  break\n\n          if path_to_adj is not None:\n              # Move next to the workshop\n              actions.extend(path_to_adj)\n              pos = chosen_adj\n\n              # Face the workshop\n              dx = workshop_pos[0] - pos[0]\n              dy = workshop_pos[1] - pos[1]\n              dir_act = direction_action(dx, dy)\n              if dir_act is not None:\n                  actions.append(dir_act)\n\n              # Use to craft the stick\n              actions.append(ACTION_USE)\n\n  # Return the compiled action sequence\n  return actions", "env_interactions": 7, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:02:22.335927", "function_name": "make_stick", "function_body": "  # Reset environment to get fresh scenario\n  env.reset()\n  world = env.world\n  scenario = env.scenario\n\n  # Action constants (as defined in CraftLab.action_specs)\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  # Index of the target item \"stick\"\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # Determine which primitive resources are required to craft a stick.\n  # If the recipe has no ingredients, the stick itself is a primitive.\n  primitives_needed = world.cookbook.primitives_for(stick_idx)\n  if not primitives_needed:\n      primitives_needed = {stick_idx: 1}\n\n  # Work on a local copy of the grid to keep track of what has been taken.\n  grid = scenario.init_grid.copy()\n  pos = scenario.init_pos          # current agent position (x, y)\n  actions = []                     # list of actions to return\n\n  # -------------------------------------------------------------------------\n  # Helper: simple BFS that returns a list of movement actions from start to goal\n  # -------------------------------------------------------------------------\n  from collections import deque\n\n  def bfs(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) from start to goal.\n      Cells containing any entity (grid[..., :] != 0) are considered blocked.\"\"\"\n      W, H = grid.shape[:2]\n      visited = set()\n      q = deque()\n      q.append((start, []))\n      visited.add(start)\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for act, (dx, dy) in [\n              (ACTION_DOWN, (0, 1)),\n              (ACTION_UP, (0, -1)),\n              (ACTION_LEFT, (-1, 0)),\n              (ACTION_RIGHT, (1, 0)),\n          ]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in visited:\n                  # walkable if the cell is empty (no entity)\n                  if not np.any(grid[nx, ny, :] != 0):\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [act]))\n      # No path found \u2013 return empty list (should not happen in well\u2011formed maps)\n      return []\n\n  # -------------------------------------------------------------------------\n  # 1. Collect all required primitive items\n  # -------------------------------------------------------------------------\n  for prim_idx, cnt in primitives_needed.items():\n      for _ in range(cnt):\n          # Find any remaining cell that still contains this primitive\n          locs = np.argwhere(grid[:, :, prim_idx] > 0)\n          if len(locs) == 0:\n              # Nothing left \u2013 break out (should not happen)\n              break\n          target = tuple(locs[0])\n\n          # Find a free adjacent cell from which we can USE the primitive\n          adj_cells = []\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              ax, ay = target[0] + dx, target[1] + dy\n              if 0 <= ax < grid.shape[0] and 0 <= ay < grid.shape[1]:\n                  if not np.any(grid[ax, ay, :] != 0):\n                      adj_cells.append((ax, ay))\n\n          # Choose the first reachable adjacent cell\n          path_to_adj = None\n          chosen_adj = None\n          for adj in adj_cells:\n              p = bfs(pos, adj)\n              if p:\n                  path_to_adj = p\n                  chosen_adj = adj\n                  break\n\n          if path_to_adj is None:\n              # Could not reach any adjacent cell \u2013 skip this primitive\n              continue\n\n          # Move to the chosen adjacent cell\n          actions.extend(path_to_adj)\n          pos = chosen_adj\n\n          # Face the primitive (set direction by issuing a dummy movement action)\n          dx = target[0] - pos[0]\n          dy = target[1] - pos[1]\n          if dx == -1:\n              actions.append(ACTION_UP)\n          elif dx == 1:\n              actions.append(ACTION_DOWN)\n          elif dy == -1:\n              actions.append(ACTION_LEFT)\n          elif dy == 1:\n              actions.append(ACTION_RIGHT)\n\n          # Use to pick up the primitive\n          actions.append(ACTION_USE)\n\n          # Update local grid copy (remove the primitive we just collected)\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # -------------------------------------------------------------------------\n  # 2. Craft the stick (if a workshop is required)\n  # -------------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n\n  if workshop_name is not None:\n      # Need to go to a workshop of the given type\n      workshop_idx = world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if len(workshop_cells) > 0:\n          workshop_pos = tuple(workshop_cells[0])\n\n          # Find a free adjacent cell to the workshop\n          adj_cells = []\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              ax, ay = workshop_pos[0] + dx, workshop_pos[1] + dy\n              if 0 <= ax < grid.shape[0] and 0 <= ay < grid.shape[1]:\n                  if not np.any(grid[ax, ay, :] != 0):\n                      adj_cells.append((ax, ay))\n\n          path_to_adj = None\n          chosen_adj = None\n          for adj in adj_cells:\n              p = bfs(pos, adj)\n              if p:\n                  path_to_adj = p\n                  chosen_adj = adj\n                  break\n\n          if path_to_adj is not None:\n              actions.extend(path_to_adj)\n              pos = chosen_adj\n\n              # Face the workshop\n              dx = workshop_pos[0] - pos[0]\n              dy = workshop_pos[1] - pos[1]\n              if dx == -1:\n                  actions.append(ACTION_UP)\n              elif dx == 1:\n                  actions.append(ACTION_DOWN)\n              elif dy == -1:\n                  actions.append(ACTION_LEFT)\n              elif dy == 1:\n                  actions.append(ACTION_RIGHT)\n\n              # Use to craft the stick\n              actions.append(ACTION_USE)\n  else:\n      # No workshop required \u2013 the crafting can be done in place.\n      # Simply issue a USE action (direction does not matter).\n      actions.append(ACTION_USE)\n\n  # Return the complete list of actions\n  return actions", "env_interactions": 7, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:02:49.861971", "function_name": "make_stick", "function_body": "  # reset environment and initialise state\n  env.reset()\n  state = env._current_state\n  plan = []\n\n  # goal item index (stick)\n  goal_idx = env.task.goal\n\n  # primitives required for the goal (primitive kind -> count)\n  needed = env.world.cookbook.primitives_for(goal_idx)\n\n  # mapping of movement vectors to action indices (DOWN,UP,LEFT,RIGHT)\n  move_dirs = [\n      (1, 0, 0),   # DOWN\n      (-1, 0, 1),  # UP\n      (0, -1, 2),  # LEFT\n      (0, 1, 3)    # RIGHT\n  ]\n\n  def _blocked_grid():\n      \"\"\"Boolean grid where True indicates a non\u2011traversable cell.\"\"\"\n      return np.any(state.grid > 0, axis=2)\n\n  def _bfs_path(start, target, allow_target_blocked=False):\n      \"\"\"Breadth\u2011first search returning a list of actions from start to target.\"\"\"\n      rows, cols = state.grid.shape[:2]\n      blocked = _blocked_grid()\n      if allow_target_blocked:\n          blocked[target] = False\n      visited = np.full((rows, cols), False, dtype=bool)\n      prev = {}                # (r,c) -> (prev_r, prev_c, action)\n      q = collections.deque([start])\n      visited[start] = True\n      while q:\n          r, c = q.popleft()\n          if (r, c) == target:\n              break\n          for dr, dc, act in move_dirs:\n              nr, nc = r + dr, c + dc\n              if 0 <= nr < rows and 0 <= nc < cols and not visited[nr, nc] and not blocked[nr, nc]:\n                  visited[nr, nc] = True\n                  prev[(nr, nc)] = (r, c, act)\n                  q.append((nr, nc))\n      if target not in prev and start != target:\n          return []   # no path found\n      actions = []\n      cur = target\n      while cur != start:\n          pr, pc, act = prev[cur]\n          actions.append(act)\n          cur = (pr, pc)\n      actions.reverse()\n      return actions\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives.\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          # locate all cells currently containing this primitive\n          locations = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if locations.size == 0:\n              return plan   # primitive missing, abort planning\n          # choose the closest one (Manhattan distance)\n          cur_pos = np.array(state.pos)\n          dists = np.abs(locations - cur_pos).sum(axis=1)\n          target = tuple(locations[dists.argmin()])\n\n          # move to the primitive (allow stepping onto the occupied target)\n          actions = _bfs_path(state.pos, target, allow_target_blocked=True)\n          for a in actions:\n              plan.append(a)\n              _, new_state = env.step(a)\n              state = env._current_state = new_state\n\n          # pick it up\n          plan.append(4)          # USE\n          _, new_state = env.step(4)\n          state = env._current_state = new_state\n\n  # ------------------------------------------------------------------\n  # 2. Craft at the required workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = recipe.get(\"_at\")\n  if workshop_idx is not None:\n      # locate workshop cells\n      w_locs = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if w_locs.size == 0:\n          return plan   # no workshop present, abort\n      cur_pos = np.array(state.pos)\n      dists = np.abs(w_locs - cur_pos).sum(axis=1)\n      target = tuple(w_locs[dists.argmin()])\n\n      # move to workshop (allow stepping onto its occupied cell)\n      actions = _bfs_path(state.pos, target, allow_target_blocked=True)\n      for a in actions:\n          plan.append(a)\n          _, new_state = env.step(a)\n          state = env._current_state = new_state\n\n      # craft the stick\n      plan.append(4)          # USE to craft\n      _, new_state = env.step(4)\n      state = env._current_state = new_state\n\n  return plan", "env_interactions": 0, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:02:50.983476", "function_name": "make_stick", "function_body": "  env.reset()\n  state = env._current_state\n  plan = []\n\n  # Index of the item we need to obtain (stick)\n  goal_idx = env.task.goal\n\n  # Primitive requirements for the goal (primitive_kind -> count)\n  needed = env.world.cookbook.primitives_for(goal_idx)\n\n  # Mapping of movement vectors to action indices used by CraftWorld\n  # 0: DOWN, 1: UP, 2: LEFT, 3: RIGHT, 4: USE\n  move_dirs = [\n      (1, 0, 0),   # DOWN\n      (-1, 0, 1),  # UP\n      (0, -1, 2),  # LEFT\n      (0, 1, 3)    # RIGHT\n  ]\n\n  def _blocked_grid():\n      \"\"\"Return a 2\u2011D boolean array where True means the cell is not traversable.\"\"\"\n      return np.any(state.grid > 0, axis=2)\n\n  def _bfs_path(start, target, allow_target_blocked=False):\n      \"\"\"Breadth\u2011first search returning a list of movement actions from start to target.\"\"\"\n      rows, cols = state.grid.shape[:2]\n      blocked = _blocked_grid()\n      if allow_target_blocked:\n          blocked[target] = False\n      visited = np.full((rows, cols), False, dtype=bool)\n      prev = {}                     # (r,c) -> (prev_r, prev_c, action)\n      q = collections.deque([start])\n      visited[start] = True\n\n      while q:\n          r, c = q.popleft()\n          if (r, c) == target:\n              break\n          for dr, dc, act in move_dirs:\n              nr, nc = r + dr, c + dc\n              if 0 <= nr < rows and 0 <= nc < cols and not visited[nr, nc] and not blocked[nr, nc]:\n                  visited[nr, nc] = True\n                  prev[(nr, nc)] = (r, c, act)\n                  q.append((nr, nc))\n\n      if target not in prev and start != target:\n          # No reachable path\n          return []\n\n      # Reconstruct action list\n      actions = []\n      cur = target\n      while cur != start:\n          pr, pc, act = prev[cur]\n          actions.append(act)\n          cur = (pr, pc)\n      actions.reverse()\n      return actions\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives.\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          # Locate all current cells containing the needed primitive\n          locs = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if locs.size == 0:\n              # Primitive missing \u2013 abort planning\n              return plan\n\n          # Choose the closest instance (Manhattan distance)\n          cur_pos = np.array(state.pos)\n          dists = np.abs(locs - cur_pos).sum(axis=1)\n          target = tuple(locs[dists.argmin()])\n\n          # Move to the primitive cell (allow stepping onto occupied target)\n          actions = _bfs_path(state.pos, target, allow_target_blocked=True)\n          for a in actions:\n              plan.append(a)\n              env.step(a)\n              state = env._current_state\n\n          # Pick it up\n          plan.append(4)  # USE\n          env.step(4)\n          state = env._current_state\n\n  # ------------------------------------------------------------------\n  # 2. Craft at the required workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = recipe.get(\"_at\")\n  if workshop_idx is not None:\n      # Locate workshop cells\n      w_locs = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if w_locs.size == 0:\n          # No workshop \u2013 cannot craft\n          return plan\n\n      cur_pos = np.array(state.pos)\n      dists = np.abs(w_locs - cur_pos).sum(axis=1)\n      target = tuple(w_locs[dists.argmin()])\n\n      # Move to workshop (allow stepping onto occupied target)\n      actions = _bfs_path(state.pos, target, allow_target_blocked=True)\n      for a in actions:\n          plan.append(a)\n          env.step(a)\n          state = env._current_state\n\n      # Craft the item\n      plan.append(4)  # USE to craft\n      env.step(4)\n      state = env._current_state\n\n  return plan", "env_interactions": 0, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:03:09.950673", "function_name": "make_stick", "function_body": "  ACTION = env.action_specs()\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  def find_nearest(start, kind):\n      \"\"\"Return the closest cell containing `kind` relative to `start`.\"\"\"\n      layer = state.grid[:, :, kind]\n      ys, xs = np.where(layer > 0)\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - start[0]) + np.abs(ys - start[1])\n      i = int(np.argmin(dists))\n      return (int(xs[i]), int(ys[i]))\n\n  def moves_to(cur, target):\n      \"\"\"Generate a Manhattan path from `cur` to `target` using action IDs.\"\"\"\n      seq = []\n      x, y = cur\n      tx, ty = target\n      while x != tx:\n          if tx > x:\n              seq.append(ACTION[\"RIGHT\"])\n              x += 1\n          else:\n              seq.append(ACTION[\"LEFT\"])\n              x -= 1\n      while y != ty:\n          if ty > y:\n              seq.append(ACTION[\"DOWN\"])\n              y += 1\n          else:\n              seq.append(ACTION[\"UP\"])\n              y -= 1\n      return seq\n\n  # ------------------------------------------------------------------\n  # Determine which primitives are needed to craft a stick.\n  # ------------------------------------------------------------------\n  stick_idx = idx[\"stick\"]\n  required = world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n  plan = []\n  cur_pos = state.pos\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive.\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in required.items():\n      for _ in range(cnt):\n          target = find_nearest(cur_pos, prim_idx)\n          if target is None:\n              # Primitive not found \u2013 skip (the task may become impossible).\n              continue\n          plan.extend(moves_to(cur_pos, target))\n          plan.append(ACTION[\"USE\"])\n          cur_pos = target\n\n  # ------------------------------------------------------------------\n  # If the recipe specifies a workshop, move there before crafting.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop = recipe.get(\"_at\")\n  if workshop is not None:\n      wk_idx = idx[workshop] if isinstance(workshop, str) else workshop\n      wk_pos = find_nearest(cur_pos, wk_idx)\n      if wk_pos is not None:\n          plan.extend(moves_to(cur_pos, wk_pos))\n          cur_pos = wk_pos\n\n  # ------------------------------------------------------------------\n  # Final USE to craft (or pick up) the stick.\n  # ------------------------------------------------------------------\n  plan.append(ACTION[\"USE\"])\n  return plan", "env_interactions": 4, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:03:11.064733", "function_name": "make_stick", "function_body": "  ACTION = env.action_specs()\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def nearest(pos, kind, grid):\n      \"\"\"Return (x, y) of the closest cell containing `kind` in `grid`,\n      or None if not present.\"\"\"\n      layer = grid[:, :, kind]\n      ys, xs = np.where(layer > 0)\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - pos[0]) + np.abs(ys - pos[1])\n      i = int(np.argmin(dists))\n      return int(xs[i]), int(ys[i])\n\n  def path(cur, target):\n      \"\"\"Generate a Manhattan sequence of movement actions from cur \u2192 target.\"\"\"\n      seq = []\n      x, y = cur\n      tx, ty = target\n      while x != tx:\n          if tx > x:\n              seq.append(ACTION[\"RIGHT\"])\n              x += 1\n          else:\n              seq.append(ACTION[\"LEFT\"])\n              x -= 1\n      while y != ty:\n          if ty > y:\n              seq.append(ACTION[\"DOWN\"])\n              y += 1\n          else:\n              seq.append(ACTION[\"UP\"])\n              y -= 1\n      return seq\n\n  # ------------------------------------------------------------------\n  # Determine what is needed to obtain a stick\n  # ------------------------------------------------------------------\n  stick_idx = idx[\"stick\"]\n  required = world.cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n  plan = []\n  cur_pos = state.pos\n  grid = state.grid.copy()   # mutable copy to reflect collected items\n\n  # ------------------------------------------------------------------\n  # If the stick itself is a primitive (no recipe), just pick it up.\n  # ------------------------------------------------------------------\n  if not required:\n      target = nearest(cur_pos, stick_idx, grid)\n      if target is not None:\n          plan.extend(path(cur_pos, target))\n          plan.append(ACTION[\"USE\"])\n      return plan\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive according to its count.\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in required.items():\n      for _ in range(cnt):\n          target = nearest(cur_pos, prim_idx, grid)\n          if target is None:\n              # Primitive missing \u2013 abort collection for this item.\n              continue\n          plan.extend(path(cur_pos, target))\n          plan.append(ACTION[\"USE\"])          # pick up the primitive\n          # Mark the primitive as taken so we don't target it again.\n          grid[target[0], target[1], prim_idx] = 0\n          cur_pos = target\n\n  # ------------------------------------------------------------------\n  # Move to the appropriate workshop (if the recipe specifies one)\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      wk_idx = idx[workshop_name] if isinstance(workshop_name, str) else workshop_name\n      wk_pos = nearest(cur_pos, wk_idx, grid)\n      if wk_pos is not None:\n          plan.extend(path(cur_pos, wk_pos))\n          cur_pos = wk_pos\n\n  # ------------------------------------------------------------------\n  # Final USE to perform the crafting action.\n  # ------------------------------------------------------------------\n  plan.append(ACTION[\"USE\"])\n  return plan", "env_interactions": 4, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:03:37.880034", "function_name": "make_stick", "function_body": "  actions = []\n  world = env.world\n  state = env._current_state\n\n  # action indices as defined in CraftWorld\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  def move_action(frm, to):\n      dx = to[0] - frm[0]\n      dy = to[1] - frm[1]\n      if dx == 1:\n          return RIGHT\n      if dx == -1:\n          return LEFT\n      if dy == 1:\n          return DOWN\n      if dy == -1:\n          return UP\n      raise ValueError(\"non\u2011adjacent move\")\n\n  # BFS that returns a path (list of positions) from start to a cell that is\n  # orthogonal to any target cell, together with the chosen target cell.\n  def bfs_to_adjacent(start, target_cells, grid):\n      W, H, _ = grid.shape\n      visited = np.full((W, H), False, dtype=bool)\n      q = collections.deque()\n      q.append((start, [start]))\n      visited[start] = True\n      targets = {tuple(t) for t in target_cells}\n      while q:\n          (x, y), path = q.popleft()\n          # check adjacency\n          for tx, ty in targets:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path, (tx, ty)\n          # expand neighbours\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if grid[nx, ny, :].sum() == 0:  # empty cell\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [(nx, ny)]))\n      raise RuntimeError(\"no reachable adjacent cell\")\n\n  # Produce extra moves so that the agent ends up facing `target` from `cur`\n  # and then issues a USE action.\n  def face_and_use(cur, target):\n      cx, cy = cur\n      tx, ty = target\n      dx, dy = tx - cx, ty - cy\n      if abs(dx) + abs(dy) != 1:\n          raise ValueError(\"target not orthogonal\")\n      # cell opposite target relative to agent\n      opp = (cx - dx, cy - dy)\n      W, H, _ = state.grid.shape\n\n      def empty(cell):\n          x, y = cell\n          return 0 <= x < W and 0 <= y < H and state.grid[x, y, :].sum() == 0\n\n      extra = []\n      if empty(opp):\n          extra.append(move_action((cx, cy), opp))\n          extra.append(move_action(opp, (cx, cy)))\n      else:\n          # try any other neighbouring empty cell\n          for ndx, ndy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nb = (cx + ndx, cy + ndy)\n              if empty(nb):\n                  extra.append(move_action((cx, cy), nb))\n                  extra.append(move_action(nb, (cx, cy)))\n                  break\n      extra.append(USE)\n      return extra\n\n  # -----------------------------------------------------------------\n  # 1) Gather primitives required for a stick\n  # -----------------------------------------------------------------\n  stick_idx = world.cookbook.index[\"stick\"]\n  if state.inventory[stick_idx] > 0:\n      return actions\n\n  primitives_needed = world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n  cur_pos = tuple(state.pos)\n\n  for prim_idx, count in primitives_needed.items():\n      for _ in range(count):\n          if state.inventory[prim_idx] > 0:\n              continue\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(f\"primitive {prim_idx} not found on map\")\n          path, target = bfs_to_adjacent(cur_pos, prim_cells, state.grid)\n          for nxt in path[1:]:\n              actions.append(move_action(cur_pos, nxt))\n              cur_pos = nxt\n          actions.extend(face_and_use(cur_pos, target))\n          # simulate the pickup for later planning steps\n          state.grid[target[0], target[1], prim_idx] = 0\n          state.inventory[prim_idx] += 1\n\n  # -----------------------------------------------------------------\n  # 2) Craft the stick at its workshop (if any)\n  # -----------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          raise RuntimeError(\"workshop for stick not present\")\n      path, target = bfs_to_adjacent(cur_pos, workshop_cells, state.grid)\n      for nxt in path[1:]:\n          actions.append(move_action(cur_pos, nxt))\n          cur_pos = nxt\n      actions.extend(face_and_use(cur_pos, target))\n  else:\n      # No specific workshop \u2013 just use at current location\n      actions.append(USE)\n\n  return actions", "env_interactions": 7, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:03:38.987521", "function_name": "make_stick", "function_body": "  actions = []\n  world = env.world\n  state = env._current_state\n\n  # Action indices used by CraftWorld\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def move_action(frm, to):\n      \"\"\"Convert a step from ``frm`` \u2192 ``to`` into a CraftWorld action.\"\"\"\n      dx = to[0] - frm[0]\n      dy = to[1] - frm[1]\n      if dx == 1:\n          return RIGHT\n      if dx == -1:\n          return LEFT\n      if dy == 1:\n          return DOWN\n      if dy == -1:\n          return UP\n      raise ValueError(\"non\u2011adjacent move\")\n\n  def bfs_adjacent(start, targets, grid):\n      \"\"\"\n      Bread\u2011first search for the shortest path from ``start`` to an empty\n      cell that is orthogonally adjacent to any cell in ``targets``.\n      Returns a list of positions (including ``start``) and the chosen\n      target cell.\n      \"\"\"\n      W, H, _ = grid.shape\n      visited = np.full((W, H), False, dtype=bool)\n      q = collections.deque()\n      q.append((start, [start]))\n      visited[start] = True\n      target_set = {tuple(t) for t in targets}\n\n      while q:\n          (x, y), path = q.popleft()\n          # check adjacency to any target\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path, (tx, ty)\n          # explore neighbours (only through empty cells)\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if grid[nx, ny, :].sum() == 0:  # empty cell\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [(nx, ny)]))\n      raise RuntimeError(\"No reachable adjacent cell\")\n\n  def face_and_use(cur, target, grid):\n      \"\"\"\n      Produce extra moves (if needed) so that the agent ends up\n      facing ``target`` from ``cur`` and then issues a USE action.\n      \"\"\"\n      cx, cy = cur\n      tx, ty = target\n      dx, dy = tx - cx, ty - cy\n      if abs(dx) + abs(dy) != 1:\n          raise ValueError(\"target not orthogonal to current position\")\n\n      # cell opposite the target relative to the agent\n      opp = (cx - dx, cy - dy)\n      W, H, _ = grid.shape\n\n      def empty(cell):\n          x, y = cell\n          return 0 <= x < W and 0 <= y < H and grid[x, y, :].sum() == 0\n\n      extra = []\n      if empty(opp):\n          extra.append(move_action(cur, opp))\n          extra.append(move_action(opp, cur))\n      else:\n          # fallback: any other neighbouring empty cell\n          for ndx, ndy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nb = (cx + ndx, cy + ndy)\n              if nb != target and empty(nb):\n                  extra.append(move_action(cur, nb))\n                  extra.append(move_action(nb, cur))\n                  break\n      extra.append(USE)\n      return extra\n\n  # ------------------------------------------------------------------\n  # 1) Collect primitives required for a stick\n  # ------------------------------------------------------------------\n  stick_idx = world.cookbook.index[\"stick\"]\n  if state.inventory[stick_idx] > 0:\n      return actions\n\n  primitive_requirements = world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n  cur_pos = tuple(state.pos)\n\n  for prim_idx, needed in primitive_requirements.items():\n      for _ in range(needed):\n          # skip if already in inventory (may happen after earlier loops)\n          if state.inventory[prim_idx] > 0:\n              continue\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(f\"Required primitive {prim_idx} not found on map\")\n          path, target = bfs_adjacent(cur_pos, prim_cells, state.grid)\n          # move along the path (skip the first cell which is the current position)\n          for nxt in path[1:]:\n              actions.append(move_action(cur_pos, nxt))\n              cur_pos = nxt\n          # face the primitive and use\n          actions.extend(face_and_use(cur_pos, target, state.grid))\n          # update simulated world state for subsequent planning\n          state.grid[target[0], target[1], prim_idx] = 0\n          state.inventory[prim_idx] += 1\n\n  # ------------------------------------------------------------------\n  # 2) Go to the workshop (if any) and craft the stick\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          raise RuntimeError(\"Workshop for stick not present in the world\")\n      path, target = bfs_adjacent(cur_pos, workshop_cells, state.grid)\n      for nxt in path[1:]:\n          actions.append(move_action(cur_pos, nxt))\n          cur_pos = nxt\n      actions.extend(face_and_use(cur_pos, target, state.grid))\n  else:\n      # No specific workshop \u2013 just use at current location\n      actions.append(USE)\n\n  return actions", "env_interactions": 7, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:03:58.227909", "function_name": "make_stick", "function_body": "  actions = []\n  # Ensure the environment is at its initial state\n  env.reset()\n  state = env._current_state\n  world = env.world\n\n  # Index of the target item \"stick\"\n  stick_idx = world.cookbook.index[\"stick\"]\n  if state.inventory[stick_idx] > 0:\n      return actions\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  import collections\n\n  def move_action(cur, nxt):\n      \"\"\"Convert a step from cur \u2192 nxt into a DMLab action index.\"\"\"\n      dx = nxt[0] - cur[0]\n      dy = nxt[1] - cur[1]\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise ValueError(\"Invalid move\")\n\n  def bfs_to_adjacent(start, targets, grid):\n      \"\"\"\n      Bread\u2011first search for the shortest path from start to any empty cell\n      that is orthogonally adjacent to one of the target cells.\n      Returns a list of positions (including start and the final cell).\n      \"\"\"\n      W, H, _ = grid.shape\n      visited = np.zeros((W, H), dtype=bool)\n      q = collections.deque()\n      q.append((start, [start]))\n      visited[start] = True\n      target_set = {tuple(t) for t in targets}\n      while q:\n          pos, path = q.popleft()\n          # Check if pos is adjacent to any target cell\n          for tx, ty in target_set:\n              if abs(pos[0] - tx) + abs(pos[1] - ty) == 1:\n                  return path\n          # Expand neighbours (only through empty cells)\n          for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if grid[nx, ny, :].sum() == 0:      # empty cell\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [(nx, ny)]))\n      raise RuntimeError(\"No reachable target\")\n\n  # ------------------------------------------------------------------\n  # 1) Collect required primitives for a stick.\n  # ------------------------------------------------------------------\n  primitive_reqs = world.cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n  cur_pos = tuple(state.pos)\n\n  for prim_idx, needed in primitive_reqs.items():\n      for _ in range(needed):\n          # If we already have this primitive in inventory, skip.\n          if state.inventory[prim_idx] > 0:\n              continue\n          # Locate all cells containing this primitive.\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(\"Required primitive not present in world\")\n          # Find path to a free cell adjacent to one of the primitive cells.\n          path = bfs_to_adjacent(cur_pos, prim_cells, state.grid)\n          # Convert path steps into actions.\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n          # Use action to pick up the primitive.\n          actions.append(4)   # USE\n          # Update temporary copies so planning reflects the pickup.\n          state.grid[cur_pos[0], cur_pos[1], prim_idx] = 0\n          state.inventory[prim_idx] += 1\n\n  # ------------------------------------------------------------------\n  # 2) Go to the appropriate workshop and craft the stick.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      raise RuntimeError(\"Stick recipe does not specify a workshop\")\n  workshop_idx = world.cookbook.index[workshop_name]\n\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      raise RuntimeError(\"Workshop for stick not found in the world\")\n  path = bfs_to_adjacent(cur_pos, workshop_cells, state.grid)\n  for step in path[1:]:\n      actions.append(move_action(cur_pos, step))\n      cur_pos = step\n\n  # Craft the stick at the workshop.\n  actions.append(4)   # USE\n\n  return actions", "env_interactions": 5, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-21T21:03:59.344133", "function_name": "make_stick", "function_body": "  # Initialize\n  actions = []\n  world = env.world\n  state = env._current_state\n\n  # Index of the goal item \"stick\"\n  stick_idx = world.cookbook.index[\"stick\"]\n  if state.inventory[stick_idx] > 0:\n      return actions\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  import collections\n  import numpy as np\n\n  def move_action(cur, nxt):\n      \"\"\"Translate a step from cur -> nxt into an action index.\"\"\"\n      dx = nxt[0] - cur[0]\n      dy = nxt[1] - cur[1]\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise ValueError(\"Invalid move\")\n\n  def bfs_to_adjacent(start, targets, grid):\n      \"\"\"\n      Bread\u2011first search for the shortest path from start to any empty cell\n      that is orthogonally adjacent to one of the target cells.\n      Returns a list of positions including the start and the final cell.\n      \"\"\"\n      W, H, _ = grid.shape\n      visited = np.zeros((W, H), dtype=bool)\n      q = collections.deque()\n      q.append((tuple(start), [tuple(start)]))\n      visited[start[0], start[1]] = True\n      target_set = {tuple(t) for t in targets}\n      while q:\n          pos, path = q.popleft()\n          # Check adjacency to any target\n          for tx, ty in target_set:\n              if abs(pos[0] - tx) + abs(pos[1] - ty) == 1:\n                  return path\n          # Expand neighbours (only through empty cells)\n          for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if grid[nx, ny, :].sum() == 0:      # empty cell\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [(nx, ny)]))\n      raise RuntimeError(\"No reachable target\")\n\n  # ------------------------------------------------------------------\n  # 1) Collect required primitives for a stick.\n  # ------------------------------------------------------------------\n  primitive_reqs = world.cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n  # Make local copies of grid and inventory for planning purposes\n  planning_grid = np.copy(state.grid)\n  planning_inventory = np.copy(state.inventory)\n\n  cur_pos = tuple(state.pos)\n\n  for prim_idx, needed in primitive_reqs.items():\n      for _ in range(needed):\n          # Skip if we already have the primitive in inventory\n          if planning_inventory[prim_idx] > 0:\n              continue\n          # Locate cells containing this primitive.\n          prim_cells = np.argwhere(planning_grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(\"Required primitive not present in world\")\n          # Find path to a free cell adjacent to one of the primitive cells.\n          path = bfs_to_adjacent(cur_pos, prim_cells, planning_grid)\n          # Convert path steps into actions.\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n          # Use action to pick up the primitive.\n          actions.append(4)   # USE\n          # Update planning structures: the primitive cell becomes empty,\n          # and we now hold one unit of the primitive.\n          # Find the exact primitive cell we just interacted with (adjacent).\n          # It is the unique primitive cell adjacent to cur_pos.\n          for tx, ty in prim_cells:\n              if abs(cur_pos[0] - tx) + abs(cur_pos[1] - ty) == 1:\n                  planning_grid[tx, ty, prim_idx] = 0\n                  break\n          planning_inventory[prim_idx] += 1\n\n  # ------------------------------------------------------------------\n  # 2) Go to the appropriate workshop and craft the stick.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      raise RuntimeError(\"Stick recipe does not specify a workshop\")\n  workshop_idx = world.cookbook.index[workshop_name]\n\n  workshop_cells = np.argwhere(planning_grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      raise RuntimeError(\"Workshop for stick not found in the world\")\n  path = bfs_to_adjacent(cur_pos, workshop_cells, planning_grid)\n  for step in path[1:]:\n      actions.append(move_action(cur_pos, step))\n      cur_pos = step\n\n  # Craft the stick at the workshop.\n  actions.append(4)   # USE\n\n  return actions", "env_interactions": 3, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:04:28.418856", "function_name": "make_stick", "function_body": "  # Determine action identifiers (USE is required for collecting/crafting)\n  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      # Default ordering used by CraftWorld: DOWN, UP, LEFT, RIGHT, USE\n      action_ids = [0, 1, 2, 3, 4]\n\n  # Resolve internal index for the target item \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n  if stick_idx is None:\n      # No stick recipe/item in this world \u2013 nothing to do.\n      return []\n\n  # Ensure the environment is reset and obtain the initial state\n  if not hasattr(env, \"_current_state\") or env._current_state is None:\n      env.reset()\n  start_state = env._current_state\n\n  # If we already have a stick, no actions are needed.\n  if start_state.inventory[stick_idx] > 0:\n      return []\n\n  from collections import deque\n\n  # Helper to create a hashable representation of a state.\n  def _state_key(st):\n      # Include position, direction, inventory and grid layout.\n      return (st.pos, st.dir, st.inventory.tobytes(), st.grid.tobytes())\n\n  visited = {_state_key(start_state)}\n  frontier = deque()\n  frontier.append((start_state, []))\n\n  MAX_PLAN_LENGTH = 500  # safety bound to keep search tractable\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      # Goal test: have at least one stick in inventory.\n      if cur_state.inventory[stick_idx] > 0:\n          return cur_plan\n\n      # Do not expand beyond the maximum allowed depth.\n      if len(cur_plan) >= MAX_PLAN_LENGTH:\n          continue\n\n      # Explore all possible actions from the current state.\n      for a in action_ids:\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((next_state, cur_plan + [a]))\n\n  # No feasible plan found within limits.\n  return []", "env_interactions": 4, "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T21:04:29.529988", "function_name": "make_stick", "function_body": "  import heapq\n  import numpy as np\n\n  # ------------------------------------------------------------------\n  # Action identifiers (default ordering if env does not provide specs)\n  # ------------------------------------------------------------------\n  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      action_ids = [0, 1, 2, 3, 4]  # DOWN, UP, LEFT, RIGHT, USE\n\n  # ------------------------------------------------------------------\n  # Resolve the internal index for the target item \u201cstick\u201d.\n  # ------------------------------------------------------------------\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n  if stick_idx is None:\n      return []  # no stick recipe in this world\n\n  # ------------------------------------------------------------------\n  # Ensure the environment has been reset and obtain the start state.\n  # ------------------------------------------------------------------\n  if not hasattr(env, \"_current_state\") or env._current_state is None:\n      env.reset()\n  start_state = env._current_state\n\n  # ------------------------------------------------------------------\n  # If we already have a stick, no actions are required.\n  # ------------------------------------------------------------------\n  if start_state.inventory[stick_idx] > 0:\n      return []\n\n  # ------------------------------------------------------------------\n  # Determine which primitive resources are needed to craft a stick.\n  # If the recipe returns an empty dict, the stick itself is a primitive.\n  # ------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(stick_idx)\n  if not primitives_needed:\n      primitives_needed = {stick_idx: 1}\n\n  # ------------------------------------------------------------------\n  # Identify the workshop (if any) required for crafting the stick.\n  # The workshop index is stored under the special key \u201c_key\u201d or \u201c_at\u201d.\n  # ------------------------------------------------------------------\n  workshop_idx = None\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  if isinstance(recipe, dict):\n      workshop_idx = recipe.get(\"_key\") or recipe.get(\"_at\")\n\n  # ------------------------------------------------------------------\n  # Heuristic: Manhattan distance to the nearest needed primitive cells\n  # plus distance to a workshop if crafting is still required.\n  # ------------------------------------------------------------------\n  def _heuristic(state):\n      pos = state.pos\n      total = 0\n\n      # Remaining primitive requirements.\n      for kind, req in primitives_needed.items():\n          have = state.inventory[kind]\n          need = max(0, req - have)\n          if need == 0:\n              continue\n          cells = np.argwhere(state.grid[..., kind] > 0)\n          if cells.size == 0:\n              total += 1000 * need  # heavily penalise missing resources\n              continue\n          dists = np.abs(cells[:, 0] - pos[0]) + np.abs(cells[:, 1] - pos[1])\n          total += dists.min() * need\n\n      # If we still do not possess a stick, we may need to reach a workshop.\n      if state.inventory[stick_idx] == 0 and workshop_idx is not None:\n          cells = np.argwhere(state.grid[..., workshop_idx] > 0)\n          if cells.size > 0:\n              dists = np.abs(cells[:, 0] - pos[0]) + np.abs(cells[:, 1] - pos[1])\n              total += dists.min()\n      return total\n\n  # ------------------------------------------------------------------\n  # Unique state identifier for the visited set.\n  # Includes position, direction, inventory snapshot and grid snapshot.\n  # ------------------------------------------------------------------\n  def _state_key(st):\n      return (st.pos, st.dir, st.inventory.tobytes(), st.grid.tobytes())\n\n  visited = {_state_key(start_state)}\n  # Priority queue entries: (f = g + h, g, state, action_list)\n  heap = [( _heuristic(start_state), 0, start_state, [] )]\n\n  MAX_PLAN_LENGTH = 300  # safety bound\n\n  while heap:\n      f, g, cur_state, actions = heapq.heappop(heap)\n\n      # Goal test: have at least one stick in inventory.\n      if cur_state.inventory[stick_idx] > 0:\n          return actions\n\n      if g >= MAX_PLAN_LENGTH:\n          continue\n\n      for a in action_ids:\n          _, nxt_state = cur_state.step(a)\n          key = _state_key(nxt_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          ng = g + 1\n          nf = ng + _heuristic(nxt_state)\n          heapq.heappush(heap, (nf, ng, nxt_state, actions + [a]))\n\n  # No feasible plan found within the limits.\n  return []", "env_interactions": 0, "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-10-21T21:04:40.812364", "function_name": "make_stick", "function_body": "  # ----------------------------------------------------------------------\n  # Obtain the integer IDs for the available actions (DOWN,UP,LEFT,RIGHT,USE)\n  # ----------------------------------------------------------------------\n  try:\n      action_map = env.action_specs()\n      action_ids = list(action_map.values())\n  except Exception:                     # fallback to default ordering\n      action_ids = [0, 1, 2, 3, 4]\n\n  # --------------------------------------------------------------\n  # Resolve the index of the goal item \u201cstick\u201d in the world index\n  # --------------------------------------------------------------\n  try:\n      goal_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      # try alternative attribute chains if the structure differs\n      goal_idx = getattr(env, \"world\", None)\n      if goal_idx is not None:\n          goal_idx = getattr(goal_idx, \"cookbook\", None)\n          if goal_idx is not None:\n              goal_idx = goal_idx.index.get(\"stick\")\n      if goal_idx is None:\n          return []                     # cannot locate the stick index\n\n  # --------------------------------------------------------------\n  # Helper that checks whether a state already satisfies the goal\n  # --------------------------------------------------------------\n  def is_goal(state):\n      return state.satisfies(\"\", goal_idx)\n\n  # --------------------------------------------------------------\n  # Get the current state from the environment\n  # --------------------------------------------------------------\n  try:\n      start_state = env._current_state\n  except AttributeError:\n      start_state = getattr(env, \"current_state\", None)\n      if start_state is None:\n          return []                     # cannot access the underlying state\n\n  # --------------------------------------------------------------\n  # Bread\u2011first\u2011search planner over (state, plan) tuples.\n  # The search is limited to a modest horizon to avoid infinite loops.\n  # --------------------------------------------------------------\n  from collections import deque\n  frontier = deque()\n  frontier.append((start_state, []))\n\n  # A compact key that uniquely identifies a state for visited\u2011set purposes\n  def state_key(st):\n      return (st.pos, st.dir, st.inventory.tobytes())\n\n  visited = {state_key(start_state)}\n  max_plan_len = 200                     # safety ceiling on plan length\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      if is_goal(cur_state):\n          return cur_plan\n\n      if len(cur_plan) >= max_plan_len:\n          continue\n\n      for a in action_ids:\n          _, nxt_state = cur_state.step(a)\n          key = state_key(nxt_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((nxt_state, cur_plan + [a]))\n\n  # If we exit the loop no plan was found within the limits.\n  return []", "env_interactions": 4, "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T21:04:41.917232", "function_name": "make_stick", "function_body": "  # Determine the action IDs (order may vary depending on the environment)\n  try:\n      action_map = env.action_specs()\n      action_ids = list(action_map.values())\n  except Exception:\n      # Fallback to the default ordering used in CraftWorld\n      action_ids = [0, 1, 2, 3, 4]  # DOWN, UP, LEFT, RIGHT, USE\n\n  # Resolve the integer index that corresponds to the \"stick\" item\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      # Try alternative attribute paths if the above fails\n      stick_idx = getattr(env, \"world\", None)\n      if stick_idx is not None:\n          stick_idx = getattr(stick_idx, \"cookbook\", None)\n          if stick_idx is not None:\n              stick_idx = stick_idx.index.get(\"stick\")\n      if stick_idx is None:\n          return []  # cannot locate the stick index, abort\n\n  # Helper to check whether a state already satisfies the goal\n  def goal_reached(state):\n      return state.satisfies(\"\", stick_idx)\n\n  # Obtain the current state from the environment\n  try:\n      start_state = env._current_state\n  except AttributeError:\n      start_state = getattr(env, \"current_state\", None)\n      if start_state is None:\n          return []  # cannot access the underlying state\n\n  # Bread\u2011first search over the deterministic state transition graph\n  from collections import deque\n  frontier = deque()\n  frontier.append((start_state, []))\n\n  # A compact hashable representation of a state (position, direction, inventory)\n  def state_key(st):\n      return (st.pos, st.dir, st.inventory.tobytes())\n\n  visited = {state_key(start_state)}\n  max_plan_len = 200  # safety limit to avoid infinite search\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      if goal_reached(cur_state):\n          return cur_plan\n\n      if len(cur_plan) >= max_plan_len:\n          continue\n\n      for a in action_ids:\n          _, nxt_state = cur_state.step(a)\n          key = state_key(nxt_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((nxt_state, cur_plan + [a]))\n\n  # No plan found within the allowed horizon\n  return []", "env_interactions": 4, "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T21:05:00.036037", "function_name": "make_stick", "function_body": "  state = env._current_state\n  world = env.world\n  goal_idx = env.task.goal\n\n  # map action names to integer codes\n  action_map = env.action_specs()\n\n  def _move_path(start, target):\n      \"\"\"Return a list of actions moving Manhattan-wise from start to target.\"\"\"\n      actions = []\n      x, y = start\n      tx, ty = target\n      while x < tx:\n          actions.append(action_map[\"RIGHT\"])\n          x += 1\n      while x > tx:\n          actions.append(action_map[\"LEFT\"])\n          x -= 1\n      while y < ty:\n          actions.append(action_map[\"DOWN\"])\n          y += 1\n      while y > ty:\n          actions.append(action_map[\"UP\"])\n          y -= 1\n      return actions\n\n  actions = []\n  cur_pos = state.pos\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives for the goal (stick)\n  # ------------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(goal_idx)\n  if not primitive_needs:\n      # goal itself is a primitive\n      primitive_needs = {goal_idx: 1}\n\n  for prim_kind, needed_cnt in primitive_needs.items():\n      # locate all cells containing this primitive kind\n      prim_grid = state.grid[:, :, prim_kind]\n      positions = list(zip(*np.where(prim_grid > 0)))\n      if not positions:\n          # cannot find required primitive \u2013 abort plan\n          return []\n      for _ in range(needed_cnt):\n          # choose the nearest available primitive cell\n          dists = [abs(px - cur_pos[0]) + abs(py - cur_pos[1]) for (px, py) in positions]\n          nearest_idx = int(np.argmin(dists))\n          target = positions[nearest_idx]\n          actions.extend(_move_path(cur_pos, target))\n          cur_pos = target\n          actions.append(action_map[\"USE\"])   # pick up the primitive\n          # remove this cell from future consideration (assume one item per cell)\n          positions.pop(nearest_idx)\n\n  # ------------------------------------------------------------------\n  # 2. Move to the workshop (if any) and craft the stick\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      workshop_grid = state.grid[:, :, workshop_kind]\n      workshop_positions = list(zip(*np.where(workshop_grid > 0)))\n      if workshop_positions:\n          dists = [abs(px - cur_pos[0]) + abs(py - cur_pos[1]) for (px, py) in workshop_positions]\n          nearest_idx = int(np.argmin(dists))\n          target = workshop_positions[nearest_idx]\n          actions.extend(_move_path(cur_pos, target))\n          cur_pos = target\n          actions.append(action_map[\"USE\"])   # craft at the workshop\n\n  return actions", "env_interactions": 0, "island_id": 5, "scores": {"3": 0.0}}
