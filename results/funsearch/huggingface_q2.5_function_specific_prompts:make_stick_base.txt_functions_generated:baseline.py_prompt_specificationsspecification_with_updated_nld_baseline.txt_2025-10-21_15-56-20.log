{"timestamp": "2025-10-21T21:17:10.364697", "function_name": "make_stick", "function_body": "  # Determine the integer IDs for the available actions.\n  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:  # fallback if env does not expose specs\n      action_ids = [0, 1, 2, 3, 4]          # DOWN, UP, LEFT, RIGHT, USE\n\n  # Resolve the index of the target item \"stick\".\n  try:\n      goal_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      goal_idx = env.world.cookbook.index.get(\"stick\")\n\n  if goal_idx is None:\n      return []   # cannot find the stick item in the cookbook\n\n  # Obtain the current state (use the lab's internal state if present,\n  # otherwise initialise a fresh one from the scenario).\n  start_state = getattr(env, \"_current_state\", None)\n  if start_state is None:\n      start_state = env.scenario.init()\n\n  # Quick exit if the goal is already satisfied.\n  if start_state.satisfies(\"\", goal_idx):\n      return []\n\n  from collections import deque\n\n  # Helper to create a hashable key for a state (position, direction,\n  # and inventory contents).  Using the inventory bytes is fast and\n  # unique because the inventory is a fixed\u2011size NumPy array.\n  def _state_key(st):\n      return (st.pos, st.dir, st.inventory.tobytes())\n\n  frontier = deque()\n  frontier.append((start_state, []))\n  visited = {_state_key(start_state)}\n\n  MAX_PLAN_LEN = 400   # safety bound to keep search tractable\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      # Goal test.\n      if cur_state.satisfies(\"\", goal_idx):\n          return cur_plan\n\n      # Prune overly long partial plans.\n      if len(cur_plan) >= MAX_PLAN_LEN:\n          continue\n\n      # Expand all actions.\n      for a in action_ids:\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((next_state, cur_plan + [a]))\n\n  # No plan found within the limits.\n  return []", "env_interactions": 4, "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T21:17:38.201205", "function_name": "make_stick", "function_body": "  # reset environment to a fresh start\n  env.reset()\n  world = env.world\n  scenario = env.scenario\n\n  # action indices from the environment spec\n  specs = env.action_specs()\n  ACTION_DOWN = specs[\"DOWN\"]\n  ACTION_UP = specs[\"UP\"]\n  ACTION_LEFT = specs[\"LEFT\"]\n  ACTION_RIGHT = specs[\"RIGHT\"]\n  ACTION_USE = specs[\"USE\"]\n\n  # index of the target item (stick)\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # primitives required to craft a stick (may be empty if stick is primitive)\n  primitives_needed = world.cookbook.primitives_for(stick_idx)\n  if not primitives_needed:\n      primitives_needed = {stick_idx: 1}\n\n  # local mutable copies of the grid and the agent position\n  grid = scenario.init_grid.copy()          # (W, H, n_kinds)\n  pos = scenario.init_pos                    # (x, y)\n  actions = []                               # list of action ints to return\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  def bfs(start, goal):\n      \"\"\"Return a list of movement actions from start to goal avoiding occupied cells.\"\"\"\n      W, H = grid.shape[:2]\n      visited = set()\n      q = deque()\n      q.append((start, []))\n      visited.add(start)\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for act, (dx, dy) in (\n              (ACTION_DOWN, (0, 1)),\n              (ACTION_UP, (0, -1)),\n              (ACTION_LEFT, (-1, 0)),\n              (ACTION_RIGHT, (1, 0)),\n          ):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H:\n                  # walkable iff no entity occupies the cell\n                  if np.any(grid[nx, ny, :] != 0):\n                      continue\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [act]))\n      return None  # unreachable\n\n  def free_adjacent(cell):\n      \"\"\"Return all free (unoccupied) cells adjacent to `cell`.\"\"\"\n      adj = []\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          ax, ay = cell[0] + dx, cell[1] + dy\n          if 0 <= ax < grid.shape[0] and 0 <= ay < grid.shape[1]:\n              if not np.any(grid[ax, ay, :] != 0):\n                  adj.append((ax, ay))\n      return adj\n\n  def direction_action(dx, dy):\n      \"\"\"Map a delta (dx, dy) to the corresponding movement action.\"\"\"\n      if dx == -1 and dy == 0:\n          return ACTION_LEFT\n      if dx == 1 and dy == 0:\n          return ACTION_RIGHT\n      if dx == 0 and dy == -1:\n          return ACTION_UP\n      if dx == 0 and dy == 1:\n          return ACTION_DOWN\n      return None\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitive items\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      for _ in range(needed_cnt):\n          # locate any remaining instance of the primitive on the map\n          locations = np.argwhere(grid[:, :, prim_idx] > 0)\n          if len(locations) == 0:\n              # No more of this primitive \u2013 should not happen in a valid scenario\n              continue\n          target = tuple(locations[0])  # (x, y)\n\n          # pick a free adjacent cell from which we can USE the primitive\n          adj_cells = free_adjacent(target)\n          chosen_adj = None\n          path_to_adj = None\n          for adj in adj_cells:\n              p = bfs(pos, adj)\n              if p is not None:\n                  chosen_adj = adj\n                  path_to_adj = p\n                  break\n\n          if path_to_adj is None:\n              # cannot reach a usable position; skip this primitive\n              continue\n\n          # move to the chosen adjacent cell\n          actions.extend(path_to_adj)\n          pos = chosen_adj\n\n          # face the primitive (set direction by moving one step towards it)\n          dx, dy = target[0] - pos[0], target[1] - pos[1]\n          dir_act = direction_action(dx, dy)\n          if dir_act is not None:\n              actions.append(dir_act)\n\n          # use the primitive (collect it)\n          actions.append(ACTION_USE)\n\n          # update local grid copy to reflect that the primitive was taken\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # ------------------------------------------------------------------\n  # 2. Craft the stick at its required workshop (if any)\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if len(workshop_cells) > 0:\n          workshop_pos = tuple(workshop_cells[0])\n\n          # find a free adjacent cell next to the workshop\n          adj_cells = free_adjacent(workshop_pos)\n          chosen_adj = None\n          path_to_adj = None\n          for adj in adj_cells:\n              p = bfs(pos, adj)\n              if p is not None:\n                  chosen_adj = adj\n                  path_to_adj = p\n                  break\n\n          if path_to_adj is not None:\n              actions.extend(path_to_adj)\n              pos = chosen_adj\n\n              # face the workshop\n              dx, dy = workshop_pos[0] - pos[0], workshop_pos[1] - pos[1]\n              dir_act = direction_action(dx, dy)\n              if dir_act is not None:\n                  actions.append(dir_act)\n\n              # use to craft the stick\n              actions.append(ACTION_USE)\n\n  # return the compiled sequence of actions\n  return actions", "env_interactions": 7, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:17:39.326790", "function_name": "make_stick", "function_body": "  # Reset the environment to a fresh state\n  env.reset()\n  world = env.world\n  scenario = env.scenario\n\n  # Action indices (consistent with CraftLab.action_specs())\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  # Index of the target item (stick)\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # Determine required primitives for a stick (may be empty if stick is primitive)\n  primitives_needed = world.cookbook.primitives_for(stick_idx)\n  if not primitives_needed:\n      primitives_needed = {stick_idx: 1}\n\n  # Local mutable copies of the grid and agent position\n  grid = scenario.init_grid.copy()          # shape (W, H, n_kinds)\n  pos = scenario.init_pos                    # (x, y) tuple\n  actions = []                               # list of action ints to return\n\n  # ----------------------------------------------------------------------\n  # Helper utilities\n  # ----------------------------------------------------------------------\n  from collections import deque\n\n  def bfs(start, goal):\n      \"\"\"Return a list of movement actions from start to goal avoiding occupied cells.\"\"\"\n      W, H = grid.shape[:2]\n      visited = set()\n      q = deque()\n      q.append((start, []))\n      visited.add(start)\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for act, (dx, dy) in (\n              (ACTION_DOWN, (0, 1)),\n              (ACTION_UP, (0, -1)),\n              (ACTION_LEFT, (-1, 0)),\n              (ACTION_RIGHT, (1, 0)),\n          ):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H:\n                  # Walkable iff the cell is empty (no entities of any kind)\n                  if np.any(grid[nx, ny, :] != 0):\n                      continue\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [act]))\n      return None  # unreachable\n\n  def free_adjacent(cell):\n      \"\"\"Return list of free (unoccupied) cells adjacent to `cell`.\"\"\"\n      adj = []\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          ax, ay = cell[0] + dx, cell[1] + dy\n          if 0 <= ax < grid.shape[0] and 0 <= ay < grid.shape[1]:\n              if not np.any(grid[ax, ay, :] != 0):\n                  adj.append((ax, ay))\n      return adj\n\n  def direction_action(dx, dy):\n      \"\"\"Map a delta (dx, dy) to the corresponding movement action.\"\"\"\n      if dx == -1 and dy == 0:\n          return ACTION_LEFT\n      if dx == 1 and dy == 0:\n          return ACTION_RIGHT\n      if dx == 0 and dy == -1:\n          return ACTION_UP\n      if dx == 0 and dy == 1:\n          return ACTION_DOWN\n      return None\n\n  # ----------------------------------------------------------------------\n  # 1. Collect all required primitive items\n  # ----------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      for _ in range(needed_cnt):\n          # Locate any remaining instance of this primitive on the map\n          locations = np.argwhere(grid[:, :, prim_idx] > 0)\n          if len(locations) == 0:\n              # No more of this primitive \u2013 should not happen in a valid scenario\n              continue\n          target = tuple(locations[0])  # (x, y)\n\n          # Choose a free adjacent cell from which we can USE the primitive\n          adj_cells = free_adjacent(target)\n          chosen_adj = None\n          path_to_adj = None\n          for adj in adj_cells:\n              p = bfs(pos, adj)\n              if p is not None:\n                  chosen_adj = adj\n                  path_to_adj = p\n                  break\n\n          if path_to_adj is None:\n              # Could not reach a usable position; skip this primitive\n              continue\n\n          # Move to the chosen adjacent cell\n          actions.extend(path_to_adj)\n          pos = chosen_adj\n\n          # Ensure we are facing the primitive (direction is set by the last move)\n          dx, dy = target[0] - pos[0], target[1] - pos[1]\n          dir_act = direction_action(dx, dy)\n          if dir_act is not None:\n              # Move one step in the needed direction (will step onto the primitive)\n              # then step back to keep position; this guarantees correct facing.\n              actions.append(dir_act)          # step onto primitive (temporarily)\n              actions.append(ACTION_USE)       # collect while on it\n              # Step back to original adjacent cell\n              back_dir = direction_action(-dx, -dy)\n              if back_dir is not None:\n                  actions.append(back_dir)\n              # Update position back to adjacent cell\n              pos = chosen_adj\n              # Update grid for the collected primitive\n              grid[target[0], target[1], prim_idx] -= 1\n              continue\n\n          # Fallback: just use (may work if direction already correct)\n          actions.append(ACTION_USE)\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # ----------------------------------------------------------------------\n  # 2. Craft the stick at its required workshop (if any)\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if len(workshop_cells) > 0:\n          workshop_pos = tuple(workshop_cells[0])\n\n          # Find a free adjacent cell next to the workshop\n          adj_cells = free_adjacent(workshop_pos)\n          chosen_adj = None\n          path_to_adj = None\n          for adj in adj_cells:\n              p = bfs(pos, adj)\n              if p is not None:\n                  chosen_adj = adj\n                  path_to_adj = p\n                  break\n\n          if path_to_adj is not None:\n              # Move next to the workshop\n              actions.extend(path_to_adj)\n              pos = chosen_adj\n\n              # Face the workshop (similar technique as above)\n              dx, dy = workshop_pos[0] - pos[0], workshop_pos[1] - pos[1]\n              dir_act = direction_action(dx, dy)\n              if dir_act is not None:\n                  actions.append(dir_act)          # step onto workshop cell\n                  actions.append(ACTION_USE)       # craft the stick\n                  back_dir = direction_action(-dx, -dy)\n                  if back_dir is not None:\n                      actions.append(back_dir)\n              else:\n                  actions.append(ACTION_USE)\n\n  # Return the compiled sequence of actions\n  return actions", "env_interactions": 9, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:18:22.494369", "function_name": "make_stick", "function_body": "  env.reset()\n  world = env.world\n  scenario = env.scenario\n\n  # Action indices according to CraftLab.action_specs()\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  # Index of the target item (stick)\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # Determine which primitive resources are required to craft a stick.\n  primitives_needed = world.cookbook.primitives_for(stick_idx)\n  if not primitives_needed:\n      primitives_needed = {stick_idx: 1}\n\n  # Local mutable copies of the grid and the agent position.\n  grid = scenario.init_grid.copy()          # shape (W, H, n_kinds)\n  pos = scenario.init_pos                    # (x, y) tuple\n  actions = []                               # list of action ints to return\n\n  # ----------------------------------------------------------------------\n  # Helper utilities\n  # ----------------------------------------------------------------------\n  from collections import deque\n\n  def bfs(start, goal):\n      \"\"\"Return a list of movement actions from start to goal avoiding occupied cells.\"\"\"\n      W, H = grid.shape[:2]\n      visited = set()\n      q = deque()\n      q.append((start, []))\n      visited.add(start)\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for act, (dx, dy) in (\n              (ACTION_DOWN, (0, 1)),\n              (ACTION_UP, (0, -1)),\n              (ACTION_LEFT, (-1, 0)),\n              (ACTION_RIGHT, (1, 0)),\n          ):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H:\n                  # A cell is walkable iff it contains no entities of any kind\n                  if np.any(grid[nx, ny, :] != 0):\n                      continue\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [act]))\n      return None  # unreachable\n\n  def free_adjacent(cell):\n      \"\"\"Return all free (unoccupied) cells adjacent to `cell`.\"\"\"\n      adj = []\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          ax, ay = cell[0] + dx, cell[1] + dy\n          if 0 <= ax < grid.shape[0] and 0 <= ay < grid.shape[1]:\n              if not np.any(grid[ax, ay, :] != 0):\n                  adj.append((ax, ay))\n      return adj\n\n  def direction_action(dx, dy):\n      \"\"\"Map a delta (dx, dy) to the corresponding movement action.\"\"\"\n      if dx == -1 and dy == 0:\n          return ACTION_LEFT\n      if dx == 1 and dy == 0:\n          return ACTION_RIGHT\n      if dx == 0 and dy == -1:\n          return ACTION_UP\n      if dx == 0 and dy == 1:\n          return ACTION_DOWN\n      return None\n\n  # ----------------------------------------------------------------------\n  # 1. Collect all required primitive items\n  # ----------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      for _ in range(needed_cnt):\n          # Find any remaining instance of the primitive on the map\n          locations = np.argwhere(grid[:, :, prim_idx] > 0)\n          if len(locations) == 0:\n              # No more of this primitive \u2013 should not happen in a valid scenario\n              continue\n          target = tuple(locations[0])  # (x, y)\n\n          # Choose a free adjacent cell from which we can USE the primitive\n          adj_cells = free_adjacent(target)\n          chosen_adj = None\n          path_to_adj = None\n          for adj in adj_cells:\n              p = bfs(pos, adj)\n              if p is not None:\n                  chosen_adj = adj\n                  path_to_adj = p\n                  break\n\n          if path_to_adj is None:\n              # Could not reach a usable position; skip this primitive\n              continue\n\n          # Move to the chosen adjacent cell\n          actions.extend(path_to_adj)\n          pos = chosen_adj\n\n          # Face the primitive (set direction by moving one step towards it)\n          dx, dy = target[0] - pos[0], target[1] - pos[1]\n          dir_act = direction_action(dx, dy)\n          if dir_act is not None:\n              actions.append(dir_act)\n\n          # Use the primitive (collect it)\n          actions.append(ACTION_USE)\n\n          # Update local grid copy to reflect that the primitive was taken\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # ----------------------------------------------------------------------\n  # 2. Craft the stick at its required workshop (if any)\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if len(workshop_cells) > 0:\n          workshop_pos = tuple(workshop_cells[0])\n\n          # Find a free adjacent cell next to the workshop\n          adj_cells = free_adjacent(workshop_pos)\n          chosen_adj = None\n          path_to_adj = None\n          for adj in adj_cells:\n              p = bfs(pos, adj)\n              if p is not None:\n                  chosen_adj = adj\n                  path_to_adj = p\n                  break\n\n          if path_to_adj is not None:\n              # Move next to the workshop\n              actions.extend(path_to_adj)\n              pos = chosen_adj\n\n              # Face the workshop\n              dx, dy = workshop_pos[0] - pos[0], workshop_pos[1] - pos[1]\n              dir_act = direction_action(dx, dy)\n              if dir_act is not None:\n                  actions.append(dir_act)\n\n              # Use to craft the stick\n              actions.append(ACTION_USE)\n\n  # Return the compiled sequence of actions\n  return actions", "env_interactions": 7, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:18:23.623161", "function_name": "make_stick", "function_body": "  # Reset environment to start state\n  env.reset()\n  world = env.world\n  scenario = env.scenario\n\n  # Action indices (as defined in CraftLab.action_specs())\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  # Index of the target item \"stick\"\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # Determine which primitive resources are required to craft a stick.\n  # If there is no recipe, the stick itself is a primitive.\n  primitives_needed = world.cookbook.primitives_for(stick_idx)\n  if not primitives_needed:\n      primitives_needed = {stick_idx: 1}\n\n  # Local mutable copies of the grid and agent position.\n  grid = scenario.init_grid.copy()          # shape (W, H, n_kinds)\n  pos = scenario.init_pos                    # (x, y) tuple\n  actions = []                               # list of action ints to return\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  def bfs(start, goal):\n      \"\"\"Return a list of movement actions from start to goal avoiding occupied cells.\"\"\"\n      W, H = grid.shape[:2]\n      visited = set()\n      q = deque()\n      q.append((start, []))\n      visited.add(start)\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for act, (dx, dy) in (\n              (ACTION_DOWN, (0, 1)),\n              (ACTION_UP, (0, -1)),\n              (ACTION_LEFT, (-1, 0)),\n              (ACTION_RIGHT, (1, 0)),\n          ):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H:\n                  # walkable iff no entity occupies the cell\n                  if np.any(grid[nx, ny, :] != 0):\n                      continue\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [act]))\n      return None  # unreachable\n\n  def free_adjacent(cell):\n      \"\"\"Return all free (unoccupied) cells adjacent to `cell`.\"\"\"\n      adj = []\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          ax, ay = cell[0] + dx, cell[1] + dy\n          if 0 <= ax < grid.shape[0] and 0 <= ay < grid.shape[1]:\n              if not np.any(grid[ax, ay, :] != 0):\n                  adj.append((ax, ay))\n      return adj\n\n  def direction_action(dx, dy):\n      \"\"\"Map a delta (dx, dy) to the corresponding movement action.\"\"\"\n      if dx == -1 and dy == 0:\n          return ACTION_LEFT\n      if dx == 1 and dy == 0:\n          return ACTION_RIGHT\n      if dx == 0 and dy == -1:\n          return ACTION_UP\n      if dx == 0 and dy == 1:\n          return ACTION_DOWN\n      return None\n\n  def face_and_use(target, adj):\n      \"\"\"\n      Ensure the agent is facing `target` while standing on `adj`,\n      then append ACTION_USE. Returns updated position (still adj).\n      \"\"\"\n      # Determine direction from adj to target (should be unit vector)\n      dx, dy = target[0] - adj[0], target[1] - adj[1]\n\n      # Preferred: step back one cell opposite direction, then step forward to set facing.\n      opp = (adj[0] - dx, adj[1] - dy)\n      W, H = grid.shape[:2]\n\n      def is_free(cell):\n          x, y = cell\n          return 0 <= x < W and 0 <= y < H and not np.any(grid[x, y, :] != 0)\n\n      # Try using the opposite cell if free\n      if is_free(opp):\n          # move to opposite\n          act1 = direction_action(opp[0] - adj[0], opp[1] - adj[1])\n          actions.append(act1)\n          # update position temporarily\n          nonlocal pos\n          pos = opp\n          # move back to adj (now facing target)\n          act2 = direction_action(dx, dy)\n          actions.append(act2)\n          pos = adj\n      else:\n          # Find any other free neighbor to perform a turn\n          for nb in free_adjacent(adj):\n              if nb == target:\n                  continue\n              # move to nb\n              act1 = direction_action(nb[0] - adj[0], nb[1] - adj[1])\n              actions.append(act1)\n              pos = nb\n              # move back to adj (now facing target)\n              act2 = direction_action(dx, dy)\n              actions.append(act2)\n              pos = adj\n              break\n      # Finally use the target\n      actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitive items\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      for _ in range(needed_cnt):\n          # Locate any remaining instance of the primitive on the map\n          locations = np.argwhere(grid[:, :, prim_idx] > 0)\n          if len(locations) == 0:\n              # No more of this primitive \u2013 should not happen\n              continue\n          target = tuple(locations[0])  # (x, y)\n\n          # Find a free adjacent cell from which we can interact with the primitive\n          adj_cells = free_adjacent(target)\n          chosen_adj = None\n          path_to_adj = None\n          for adj in adj_cells:\n              p = bfs(pos, adj)\n              if p is not None:\n                  chosen_adj = adj\n                  path_to_adj = p\n                  break\n\n          if path_to_adj is None:\n              # Cannot reach any usable adjacent cell; skip this primitive\n              continue\n\n          # Move to the chosen adjacent cell\n          actions.extend(path_to_adj)\n          pos = chosen_adj\n\n          # Face the primitive and use it\n          face_and_use(target, chosen_adj)\n\n          # Update local grid copy to reflect that the primitive was taken\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # ------------------------------------------------------------------\n  # 2. Craft the stick at its required workshop (if any)\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if len(workshop_cells) > 0:\n          workshop_pos = tuple(workshop_cells[0])\n\n          # Find a free adjacent cell next to the workshop\n          adj_cells = free_adjacent(workshop_pos)\n          chosen_adj = None\n          path_to_adj = None\n          for adj in adj_cells:\n              p = bfs(pos, adj)\n              if p is not None:\n                  chosen_adj = adj\n                  path_to_adj = p\n                  break\n\n          if path_to_adj is not None:\n              # Move next to the workshop\n              actions.extend(path_to_adj)\n              pos = chosen_adj\n\n              # Face the workshop and use (craft)\n              face_and_use(workshop_pos, chosen_adj)\n\n  # Return the compiled sequence of actions\n  return actions", "env_interactions": 9, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:18:40.186889", "function_name": "make_stick", "function_body": "  # get action IDs\n  try:\n      action_map = env.action_specs()\n      action_ids = list(action_map.values())\n  except Exception:\n      action_ids = [0,1,2,3,4]\n  # get goal index for \"stick\"\n  try:\n      goal_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      goal_idx = None\n      # maybe lowercase\n      try:\n          goal_idx = env.world.cookbook.index.get(\"stick\")\n      except Exception:\n          pass\n  if goal_idx is None:\n      return []\n  # get start state\n  try:\n      start_state = env._current_state\n  except Exception:\n      start_state = getattr(env, \"current_state\", None)\n  if start_state is None:\n      return []\n  # BFS\n  from collections import deque\n  frontier = deque()\n  frontier.append((start_state, []))\n  visited = set()\n  def state_key(st):\n      return (st.pos, st.dir, st.inventory.tobytes())\n  visited.add(state_key(start_state))\n  max_len = 200\n  while frontier:\n      state, plan = frontier.popleft()\n      if state.satisfies(\"\", goal_idx):\n          return plan\n      if len(plan) >= max_len:\n          continue\n      for a in action_ids:\n          _, nxt = state.step(a)\n          key = state_key(nxt)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((nxt, plan + [a]))\n  return []", "env_interactions": 4, "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T21:18:41.299192", "function_name": "make_stick", "function_body": "  # Determine the action IDs (DOWN, UP, LEFT, RIGHT, USE)\n  try:\n      action_map = env.action_specs()\n      action_ids = list(action_map.values())\n  except Exception:\n      action_ids = [0, 1, 2, 3, 4]  # fallback ordering\n\n  # Resolve the index of the target item \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      # try alternative attribute chains if the structure differs\n      stick_idx = getattr(env, \"world\", None)\n      if stick_idx is not None:\n          stick_idx = getattr(stick_idx, \"cookbook\", None)\n          if stick_idx is not None:\n              stick_idx = stick_idx.index.get(\"stick\")\n  if stick_idx is None:\n      return []  # cannot locate the stick index\n\n  # Helper to check goal satisfaction\n  def is_goal(state):\n      return state.satisfies(\"\", stick_idx)\n\n  # Obtain the current underlying state\n  try:\n      start_state = env._current_state\n  except AttributeError:\n      start_state = getattr(env, \"current_state\", None)\n      if start_state is None:\n          return []  # cannot access the underlying state\n\n  from collections import deque\n\n  # Encode a state for visited\u2011set purposes\n  def state_key(st):\n      return (st.pos, st.dir, st.inventory.tobytes())\n\n  visited = {state_key(start_state)}\n  frontier = deque()\n  frontier.append((start_state, []))\n  max_plan_len = 200  # safety ceiling on plan length\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      if is_goal(cur_state):\n          return cur_plan\n\n      if len(cur_plan) >= max_plan_len:\n          continue\n\n      for a in action_ids:\n          _, nxt_state = cur_state.step(a)\n          key = state_key(nxt_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((nxt_state, cur_plan + [a]))\n\n  # No plan found within the limits\n  return []", "env_interactions": 4, "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T21:19:03.749069", "function_name": "make_stick", "function_body": "  actions = []\n  env.reset()\n  state = env._current_state\n  world = env.world\n\n  # Index of the target item \"stick\"\n  stick_idx = world.cookbook.index[\"stick\"]\n  if state.inventory[stick_idx] > 0:\n      return actions\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def move_action(cur, nxt):\n      \"\"\"Convert a step from cur \u2192 nxt into a DMLab action index.\"\"\"\n      dx = nxt[0] - cur[0]\n      dy = nxt[1] - cur[1]\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise ValueError(\"Invalid move step\")\n\n  def bfs_to_adjacent(start, targets, grid):\n      \"\"\"\n      Bread\u2011first search for the shortest path from start to any empty cell\n      orthogonally adjacent to one of the target cells.\n      Returns a list of positions (including start and the final cell).\n      \"\"\"\n      W, H, _ = grid.shape\n      visited = np.zeros((W, H), dtype=bool)\n      q = collections.deque()\n      q.append((start, [start]))\n      visited[start] = True\n      target_set = {tuple(t) for t in targets}\n      while q:\n          pos, path = q.popleft()\n          # If adjacent to any target, stop\n          for tx, ty in target_set:\n              if abs(pos[0] - tx) + abs(pos[1] - ty) == 1:\n                  return path\n          # Expand neighbours (only through empty cells)\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if grid[nx, ny, :].sum() == 0:      # empty cell\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [(nx, ny)]))\n      raise RuntimeError(\"No reachable target found\")\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitives for a stick.\n  # ------------------------------------------------------------------\n  primitive_reqs = world.cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n  cur_pos = tuple(state.pos)\n\n  for prim_idx, needed in primitive_reqs.items():\n      for _ in range(needed):\n          # Skip if already have the primitive in inventory\n          if state.inventory[prim_idx] > 0:\n              continue\n          # Locate cells containing this primitive\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(f\"Required primitive {prim_idx} not present in world\")\n          # Find path to a cell adjacent to any primitive location\n          path = bfs_to_adjacent(cur_pos, prim_cells, state.grid)\n          # Translate path into actions\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n          # Use action to pick up the primitive\n          actions.append(4)   # USE\n          # Update temporary copies for planning of subsequent steps\n          state.grid[cur_pos[0], cur_pos[1], prim_idx] = 0\n          state.inventory[prim_idx] += 1\n\n  # ------------------------------------------------------------------\n  # 2) Move to the appropriate workshop and craft the stick.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      raise RuntimeError(\"Stick recipe does not specify a workshop\")\n  workshop_idx = world.cookbook.index[workshop_name]\n\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      raise RuntimeError(\"Workshop for stick not found in the world\")\n  path = bfs_to_adjacent(cur_pos, workshop_cells, state.grid)\n  for step in path[1:]:\n      actions.append(move_action(cur_pos, step))\n      cur_pos = step\n\n  # Final USE to craft the stick at the workshop\n  actions.append(4)   # USE\n\n  return actions", "env_interactions": 5, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-21T21:19:04.854807", "function_name": "make_stick", "function_body": "  actions = []\n  env.reset()\n  state = env._current_state\n  world = env.world\n\n  stick_idx = world.cookbook.index[\"stick\"]\n  if state.inventory[stick_idx] > 0:\n      return actions\n\n  def move_action(cur, nxt):\n      dx = nxt[0] - cur[0]\n      dy = nxt[1] - cur[1]\n      if dx == 1:\n          return 3  # RIGHT\n      if dx == -1:\n          return 2  # LEFT\n      if dy == 1:\n          return 0  # DOWN\n      if dy == -1:\n          return 1  # UP\n      raise ValueError(\"Invalid move\")\n\n  def bfs_to_adjacent(start, targets, grid):\n      W, H, _ = grid.shape\n      visited = np.zeros((W, H), dtype=bool)\n      q = collections.deque()\n      q.append((start, [start]))\n      visited[start] = True\n      target_set = {tuple(t) for t in targets}\n      while q:\n          pos, path = q.popleft()\n          for tx, ty in target_set:\n              if abs(pos[0] - tx) + abs(pos[1] - ty) == 1:\n                  return path\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if grid[nx, ny, :].sum() == 0:\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [(nx, ny)]))\n      raise RuntimeError(\"No reachable target\")\n\n  # --------------------------------------------------------------\n  # 1) Collect required primitives for a stick.\n  # --------------------------------------------------------------\n  primitive_reqs = world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n  cur_pos = tuple(state.pos)\n\n  for prim_idx, needed in primitive_reqs.items():\n      for _ in range(needed):\n          if state.inventory[prim_idx] > 0:\n              continue\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(\"Required primitive not present in world\")\n          path = bfs_to_adjacent(cur_pos, prim_cells, state.grid)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n          actions.append(4)  # USE to pick up\n          # Update temporary copies so later planning sees the item removed\n          state.grid[cur_pos[0], cur_pos[1], prim_idx] = 0\n          state.inventory[prim_idx] += 1\n\n  # --------------------------------------------------------------\n  # 2) Go to the appropriate workshop and craft the stick.\n  # --------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      raise RuntimeError(\"Stick recipe does not specify a workshop\")\n  workshop_idx = world.cookbook.index[workshop_name]\n\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      raise RuntimeError(\"Workshop for stick not found in the world\")\n  path = bfs_to_adjacent(cur_pos, workshop_cells, state.grid)\n  for step in path[1:]:\n      actions.append(move_action(cur_pos, step))\n      cur_pos = step\n\n  actions.append(4)  # USE to craft the stick\n\n  return actions", "env_interactions": 5, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-21T21:19:16.595730", "function_name": "make_stick", "function_body": "  # Determine the action IDs (order may vary depending on environment implementation)\n  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      # Fallback to the default ordering used by CraftWorld\n      action_ids = [0, 1, 2, 3, 4]\n\n  # Resolve the internal index for the target item \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n  if stick_idx is None:\n      # No stick recipe/item in this world \u2013 nothing to do.\n      return []\n\n  # Ensure the environment is reset and obtain the initial state\n  if not hasattr(env, \"_current_state\") or env._current_state is None:\n      env.reset()\n  start_state = env._current_state\n\n  # If we already have a stick, no actions are required.\n  if start_state.inventory[stick_idx] > 0:\n      return []\n\n  from collections import deque\n\n  # Helper to create a hashable representation of a state for visited tracking\n  def _state_key(st):\n      # Include position, direction, inventory and the full grid layout.\n      return (st.pos, st.dir, st.inventory.tobytes(), st.grid.tobytes())\n\n  visited = {_state_key(start_state)}\n  frontier = deque()\n  frontier.append((start_state, []))\n\n  MAX_PLAN_LENGTH = 500  # safety bound to keep search tractable\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      # Goal test: have at least one stick in inventory.\n      if cur_state.inventory[stick_idx] > 0:\n          return cur_plan\n\n      # Prune overly long plans.\n      if len(cur_plan) >= MAX_PLAN_LENGTH:\n          continue\n\n      # Explore all possible actions from the current state.\n      for a in action_ids:\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((next_state, cur_plan + [a]))\n\n  # No feasible plan found within the limits.\n  return []", "env_interactions": 4, "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T21:19:17.725034", "function_name": "make_stick", "function_body": "  # Get the list of action ids (order may differ per environment)\n  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      # default ordering used by CraftWorld: DOWN, UP, LEFT, RIGHT, USE\n      action_ids = [0, 1, 2, 3, 4]\n\n  # Resolve the internal index for the target item \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n  if stick_idx is None:\n      # Stick not defined in this world \u2013 nothing to do.\n      return []\n\n  # Ensure the environment is reset and obtain the initial state\n  if not hasattr(env, \"_current_state\") or env._current_state is None:\n      env.reset()\n  start_state = env._current_state\n\n  # If we already have a stick, no actions are required.\n  if start_state.inventory[stick_idx] > 0:\n      return []\n\n  from collections import deque\n\n  # Helper to create a hashable representation of a state for visited tracking\n  def _state_key(st):\n      # Include position, direction, inventory and full grid layout.\n      return (st.pos, st.dir, st.inventory.tobytes(), st.grid.tobytes())\n\n  visited = {_state_key(start_state)}\n  frontier = deque()\n  frontier.append((start_state, []))\n\n  MAX_PLAN_LEN = 350  # safety bound to keep search tractable\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      # Goal test: have at least one stick in inventory\n      if cur_state.inventory[stick_idx] > 0:\n          return cur_plan\n\n      # Prune overly long plans\n      if len(cur_plan) >= MAX_PLAN_LEN:\n          continue\n\n      # Expand all possible actions (try USE first as it is often the only\n      # action that changes inventory)\n      for a in sorted(action_ids, key=lambda x: 0 if x == env.action_specs().get(\"USE\", 4) else 1):\n          _, nxt_state = cur_state.step(a)\n          key = _state_key(nxt_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((nxt_state, cur_plan + [a]))\n\n  # No feasible plan found within limits.\n  return []", "env_interactions": 4, "island_id": 7, "scores": {"3": 1.5}}
