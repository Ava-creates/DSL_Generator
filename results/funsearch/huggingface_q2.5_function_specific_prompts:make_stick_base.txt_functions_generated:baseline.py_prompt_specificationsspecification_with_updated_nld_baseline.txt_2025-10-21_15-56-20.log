{"timestamp": "2025-10-21T20:58:04.631921", "function_name": "make_stick", "function_body": "  actions = []\n  world = env.world\n  state = env._current_state\n\n  # ------------------------------------------------------------------\n  # Utility helpers\n  # ------------------------------------------------------------------\n  def move_action(cur, nxt):\n      \"\"\"Return action index to move from cur -> nxt (orthogonal).\"\"\"\n      dx = nxt[0] - cur[0]\n      dy = nxt[1] - cur[1]\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise ValueError(\"non\u2011adjacent move\")\n\n  def bfs_adjacent(start, targets, grid):\n      \"\"\"\n      Bread\u2011first search for the shortest path from ``start`` to any empty\n      cell orthogonally adjacent to one of ``targets``.\n      Returns a list of positions (including ``start``). Raises if unreachable.\n      \"\"\"\n      W, H, _ = grid.shape\n      visited = np.zeros((W, H), dtype=bool)\n      q = collections.deque()\n      q.append((start, [start]))\n      visited[start] = True\n      target_set = {tuple(t) for t in targets}\n\n      while q:\n          (x, y), path = q.popleft()\n          # Check adjacency to any target cell\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n          # Expand neighbours through empty cells only\n          for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if grid[nx, ny, :].sum() == 0:   # empty cell\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [(nx, ny)]))\n      raise RuntimeError(\"No reachable cell adjacent to target\")\n\n  # ------------------------------------------------------------------\n  # Identify goal (stick) and early exit if already have it\n  # ------------------------------------------------------------------\n  stick_idx = world.cookbook.index[\"stick\"]\n  if state.inventory[stick_idx] > 0:\n      return actions\n\n  # ------------------------------------------------------------------\n  # 1) Gather required primitive resources\n  # ------------------------------------------------------------------\n  primitive_requirements = world.cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n  cur_pos = tuple(state.pos)\n  # Work on a local copy of the grid so we can \u201cremove\u201d collected items\n  grid_copy = np.copy(state.grid)\n\n  for prim_idx, needed in primitive_requirements.items():\n      for _ in range(needed):\n          # If we already hold this primitive, skip collection\n          if state.inventory[prim_idx] > 0:\n              break\n\n          # Find all cells that currently contain the primitive\n          prim_cells = np.argwhere(grid_copy[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(\"Required primitive not present in the world\")\n\n          # Plan path to an empty cell adjacent to the first available primitive\n          path = bfs_adjacent(cur_pos, prim_cells, grid_copy)\n\n          # Convert path steps into movement actions\n          for nxt in path[1:]:\n              actions.append(move_action(cur_pos, nxt))\n              cur_pos = nxt\n\n          # Use action to pick up the primitive\n          actions.append(4)   # USE\n\n          # Simulate removal of the primitive from our planning grid\n          target_cell = prim_cells[0]\n          grid_copy[target_cell[0], target_cell[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 2) Move to required workshop (if any) and craft the stick\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(grid_copy[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          raise RuntimeError(\"Workshop for stick not found in the world\")\n      path = bfs_adjacent(cur_pos, workshop_cells, grid_copy)\n      for nxt in path[1:]:\n          actions.append(move_action(cur_pos, nxt))\n          cur_pos = nxt\n\n  # Final use action to craft the stick at the workshop (or in place if none)\n  actions.append(4)   # USE\n\n  return actions", "env_interactions": 3, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T20:58:18.831629", "function_name": "make_stick", "function_body": "  import collections\n\n  # Determine action IDs, falling back to default ordering if necessary\n  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      action_ids = [0, 1, 2, 3, 4]  # DOWN, UP, LEFT, RIGHT, USE\n\n  # Resolve the integer index for the target item \"stick\"\n  try:\n      goal_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      goal_idx = env.world.cookbook.index.get(\"stick\")\n  if goal_idx is None:\n      return []\n\n  # Obtain the initial state (use the Lab's current state if present)\n  start_state = getattr(env, \"_current_state\", None)\n  if start_state is None:\n      start_state = env.scenario.init()\n\n  # Helper to create a hashable representation of a state for visited checks\n  def _state_key(st):\n      # Include position, direction, inventory, and grid layout to capture all changes\n      return (st.pos, st.dir, st.inventory.tobytes(), st.grid.tobytes())\n\n  # Bread\u2011first search over deterministic transitions\n  frontier = collections.deque()\n  frontier.append((start_state, []))\n  visited = {_state_key(start_state)}\n\n  MAX_PLAN_LEN = 500  # safety bound to avoid infinite search\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      # Goal test: inventory already contains a stick\n      if cur_state.satisfies(\"\", goal_idx):\n          return cur_plan\n\n      # Prune overly long plans\n      if len(cur_plan) >= MAX_PLAN_LEN:\n          continue\n\n      # Expand all possible actions\n      for a in action_ids:\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((next_state, cur_plan + [a]))\n\n  # No plan found within limits \u2013 return empty list\n  return []", "env_interactions": 4, "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T20:58:19.933185", "function_name": "make_stick", "function_body": "  import collections\n\n  # Determine the action IDs; fall back to the default ordering if needed.\n  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      action_ids = [0, 1, 2, 3, 4]  # DOWN, UP, LEFT, RIGHT, USE\n\n  # Resolve the integer index for the target item \u201cstick\u201d.\n  try:\n      goal_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      goal_idx = env.world.cookbook.index.get(\"stick\")\n  if goal_idx is None:\n      return []\n\n  # Obtain the initial state (use the current state if the lab wrapper exposes it).\n  start_state = getattr(env, \"_current_state\", None)\n  if start_state is None:\n      start_state = env.scenario.init()\n\n  # Helper to create a hashable representation of a state for visited\u2011set tracking.\n  def _state_key(st):\n      # Position, direction and inventory uniquely identify the reachable state\n      # for the deterministic dynamics of CraftWorld.\n      return (st.pos, st.dir, st.inventory.tobytes())\n\n  # Bread\u2011first search over deterministic transitions.\n  frontier = collections.deque()\n  frontier.append((start_state, []))\n  visited = {_state_key(start_state)}\n  MAX_PLAN_LEN = 800  # safety bound to avoid infinite search\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      # Goal test: inventory already contains a stick.\n      if cur_state.satisfies(\"\", goal_idx):\n          return cur_plan\n\n      # Prune overly long plans.\n      if len(cur_plan) >= MAX_PLAN_LEN:\n          continue\n\n      # Expand all possible actions.\n      for a in action_ids:\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((next_state, cur_plan + [a]))\n\n  # No plan found within the limits \u2013 return empty list.\n  return []", "env_interactions": 4, "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T20:58:38.885857", "function_name": "make_stick", "function_body": "  # Get useful references\n  ACTION = env.action_specs()\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  # ------------------------------------------------------------------\n  # Helper functions\n  # ------------------------------------------------------------------\n  def locate_nearest(pos, kind, grid):\n      \"\"\"Find the closest cell (Manhattan) containing `kind`.\"\"\"\n      layer = grid[:, :, kind]\n      ys, xs = np.where(layer > 0)\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - pos[0]) + np.abs(ys - pos[1])\n      i = int(np.argmin(dists))\n      return (int(xs[i]), int(ys[i]))\n\n  from collections import deque\n\n  def bfs(start, goal, grid):\n      \"\"\"Return a list of positions from start to goal avoiding occupied cells.\"\"\"\n      if start == goal:\n          return [start]\n      W, H, _ = grid.shape\n      visited = np.zeros((W, H), dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start[0], start[1]] = True\n\n      while q:\n          x, y = q.popleft()\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < W and 0 <= ny < H):\n                  continue\n              if visited[nx, ny]:\n                  continue\n              # Goal cell may be occupied (e.g., a workshop)\n              if (nx, ny) != goal and grid[nx, ny].any():\n                  continue\n              visited[nx, ny] = True\n              prev[(nx, ny)] = (x, y)\n              if (nx, ny) == goal:\n                  # reconstruct path\n                  path = [(nx, ny)]\n                  while path[-1] != start:\n                      path.append(prev[path[-1]])\n                  path.reverse()\n                  return path\n              q.append((nx, ny))\n      return None\n\n  def actions_from_path(path):\n      \"\"\"Translate a coordinate path into action indices.\"\"\"\n      seq = []\n      for (x0, y0), (x1, y1) in zip(path, path[1:]):\n          if x1 > x0:\n              seq.append(ACTION[\"RIGHT\"])\n          elif x1 < x0:\n              seq.append(ACTION[\"LEFT\"])\n          elif y1 > y0:\n              seq.append(ACTION[\"DOWN\"])\n          elif y1 < y0:\n              seq.append(ACTION[\"UP\"])\n      return seq\n\n  # ------------------------------------------------------------------\n  # Determine what primitives are needed to craft a stick\n  # ------------------------------------------------------------------\n  stick_idx = idx.get(\"stick\")\n  if stick_idx is None:\n      return []  # no stick in this world\n\n  needed = world.cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n  plan = []\n  cur_pos = state.pos\n  grid = state.grid.copy()   # simulate pickups\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          target = locate_nearest(cur_pos, prim_idx, grid)\n          if target is None:\n              return []  # primitive not present\n          path = bfs(cur_pos, target, grid)\n          if path is None:\n              return []  # unreachable\n          plan.extend(actions_from_path(path))\n          plan.append(ACTION[\"USE\"])          # pick up\n          # simulate removal\n          grid[target[0], target[1], prim_idx] = 0\n          cur_pos = target\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if recipe specifies one) and craft the stick\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      wk_idx = idx[workshop_name] if isinstance(workshop_name, str) else workshop_name\n      wk_pos = locate_nearest(cur_pos, wk_idx, grid)\n      if wk_pos is not None:\n          path = bfs(cur_pos, wk_pos, grid)\n          if path is not None:\n              plan.extend(actions_from_path(path))\n              cur_pos = wk_pos\n\n  # Final USE to actually craft the stick\n  plan.append(ACTION[\"USE\"])\n  return plan", "env_interactions": 0, "island_id": 4, "scores": {"3": -1}}
