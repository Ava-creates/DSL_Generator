{"timestamp": "2025-10-21T21:50:27.307971", "function_name": "make_stick", "function_body": "  env.reset()\n  state = env._current_state\n\n  goal_idx = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal_idx)\n\n  # action constants (match CraftLab ordering)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  def _move_to(target):\n      \"\"\"Move from current state.pos to target cell using Manhattan steps.\"\"\"\n      nonlocal state\n      actions = []\n      while tuple(state.pos) != tuple(target):\n          r, c = state.pos\n          tr, tc = target\n          if r < tr:\n              act = DOWN\n          elif r > tr:\n              act = UP\n          elif c < tc:\n              act = RIGHT\n          else:\n              act = LEFT\n          actions.append(act)\n          _, state = env.step(act)\n      return actions\n\n  plan = []\n\n  # If there are primitive requirements, collect them.\n  if needed:\n      for prim_idx, count in needed.items():\n          for _ in range(count):\n              # locate a primitive instance\n              locs = np.argwhere(state.grid[:, :, prim_idx] > 0)\n              if locs.size == 0:\n                  # cannot find required primitive; abort early\n                  continue\n              target = tuple(locs[0])\n              plan.extend(_move_to(target))\n              plan.append(USE)\n              _, state = env.step(USE)\n  else:\n      # No recipe \u2013 the goal itself is a primitive on the map.\n      # Locate it and pick it up.\n      locs = np.argwhere(state.grid[:, :, goal_idx] > 0)\n      if locs.size > 0:\n          target = tuple(locs[0])\n          plan.extend(_move_to(target))\n          plan.append(USE)\n          _, state = env.step(USE)\n\n  # After having required primitives, go to workshop (if any) and craft.\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = recipe.get('_at')\n  if workshop_idx is not None:\n      w_locs = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if w_locs.size > 0:\n          w_target = tuple(w_locs[0])\n          plan.extend(_move_to(w_target))\n          plan.append(USE)\n          _, state = env.step(USE)\n\n  return plan", "env_interactions": 0, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:50:28.412579", "function_name": "make_stick", "function_body": "  env.reset()\n  state = env._current_state\n\n  goal_idx = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal_idx)  # {primitive_idx: count}\n\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  def _nearest(kind):\n      \"\"\"Return the closest cell (row, col) containing `kind` according to Manhattan distance.\"\"\"\n      positions = np.argwhere(state.grid[:, :, kind] > 0)\n      if positions.shape[0] == 0:\n          return None\n      cur = np.array(state.pos)\n      dists = np.abs(positions - cur).sum(axis=1)\n      return tuple(positions[dists.argmin()])\n\n  def _move_to(target):\n      \"\"\"Generate actions to walk from the current position to `target`.\"\"\"\n      nonlocal state\n      actions = []\n      while tuple(state.pos) != target:\n          r, c = state.pos\n          tr, tc = target\n          if r < tr:\n              act = DOWN\n          elif r > tr:\n              act = UP\n          elif c < tc:\n              act = RIGHT\n          else:\n              act = LEFT\n          actions.append(act)\n          _, state = env.step(act)\n      return actions\n\n  plan = []\n\n  # 1. Collect all required primitives.\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          loc = _nearest(prim_idx)\n          if loc is None:          # primitive missing \u2013 should not happen in valid scenarios\n              continue\n          plan.extend(_move_to(loc))\n          plan.append(USE)         # pick up\n          _, state = env.step(USE)\n\n  # 2. Go to the workshop (if any) and craft the goal item.\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = recipe.get('_at')\n  if workshop_idx is not None:\n      w_loc = _nearest(workshop_idx)\n      if w_loc is not None:\n          plan.extend(_move_to(w_loc))\n          plan.append(USE)         # craft\n          _, state = env.step(USE)\n\n  return plan", "env_interactions": 0, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:50:41.390264", "function_name": "make_stick", "function_body": "  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      # Default ordering used by CraftWorld: DOWN, UP, LEFT, RIGHT, USE\n      action_ids = [0, 1, 2, 3, 4]\n\n  # Resolve the internal index for the target item \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n  if stick_idx is None:\n      # Stick not defined in this world \u2013 nothing to do.\n      return []\n\n  # Ensure the environment is reset and obtain the initial state\n  if not hasattr(env, \"_current_state\") or env._current_state is None:\n      env.reset()\n  start_state = env._current_state\n\n  # If we already have a stick, no actions are needed.\n  if start_state.inventory[stick_idx] > 0:\n      return []\n\n  from collections import deque\n\n  # Helper to create a hashable representation of a state.\n  def _state_key(st):\n      # Include position, direction, inventory and full grid layout.\n      return (st.pos, st.dir, st.inventory.tobytes(), st.grid.tobytes())\n\n  visited = {_state_key(start_state)}\n  frontier = deque([(start_state, [])])\n\n  MAX_PLAN_LEN = 500  # safety bound to keep search tractable\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      # Goal test: have at least one stick in inventory.\n      if cur_state.inventory[stick_idx] > 0:\n          return cur_plan\n\n      # Do not expand beyond the maximum allowed depth.\n      if len(cur_plan) >= MAX_PLAN_LEN:\n          continue\n\n      # Explore all possible actions from the current state.\n      for a in action_ids:\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((next_state, cur_plan + [a]))\n\n  # No feasible plan found within limits.\n  return []", "env_interactions": 4, "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T21:50:42.516822", "function_name": "make_stick", "function_body": "  # Determine action IDs (order may vary per environment)\n  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      # Default ordering used by CraftWorld: DOWN, UP, LEFT, RIGHT, USE\n      action_ids = [0, 1, 2, 3, 4]\n\n  # Find internal index for the target item \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n  if stick_idx is None:\n      # Stick not defined \u2013 nothing to do.\n      return []\n\n  # Ensure the environment is reset so that _current_state exists\n  if not hasattr(env, \"_current_state\") or env._current_state is None:\n      env.reset()\n  start_state = env._current_state\n\n  # If we already have a stick in inventory, no actions are needed.\n  if start_state.inventory[stick_idx] > 0:\n      return []\n\n  from collections import deque\n\n  # Helper to create a hashable representation of a state for visited checking\n  def _state_key(st):\n      # Position, direction, inventory contents, and full grid layout uniquely identify a state.\n      return (st.pos, st.dir, st.inventory.tobytes(), st.grid.tobytes())\n\n  visited = {_state_key(start_state)}\n  frontier = deque([(start_state, [])])\n\n  MAX_PLAN_LEN = 500  # safety bound to keep search tractable\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      # Goal test: have at least one stick.\n      if cur_state.inventory[stick_idx] > 0:\n          return cur_plan\n\n      if len(cur_plan) >= MAX_PLAN_LEN:\n          continue\n\n      # Expand all possible actions.\n      for a in action_ids:\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((next_state, cur_plan + [a]))\n\n  # No feasible plan found within limits.\n  return []", "env_interactions": 4, "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T21:50:56.619679", "function_name": "make_stick", "function_body": "  # Helper: retrieve action IDs (fallback to default ordering if needed)\n  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      action_ids = [0, 1, 2, 3, 4]  # DOWN, UP, LEFT, RIGHT, USE\n\n  # Resolve the integer index for the target item \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n  if stick_idx is None:\n      return []\n\n  # Obtain the initial CraftState (use the current state if already present)\n  start_state = getattr(env, \"_current_state\", None)\n  if start_state is None:\n      start_state = env.scenario.init()\n\n  # Hashable representation of a state for visited\u2011set tracking\n  def _state_key(st):\n      # Position, direction, inventory, and grid together uniquely identify the deterministic state\n      return (st.pos, st.dir, st.inventory.tobytes(), st.grid.tobytes())\n\n  from collections import deque\n\n  frontier = deque()\n  frontier.append((start_state, []))\n  visited = {_state_key(start_state)}\n  MAX_PLAN_LEN = 600  # safety bound to avoid infinite search\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      # Goal test: inventory already contains a stick.\n      if cur_state.satisfies(\"\", stick_idx):\n          return cur_plan\n\n      # Prune overly long plans.\n      if len(cur_plan) >= MAX_PLAN_LEN:\n          continue\n\n      # Expand all possible actions.\n      for a in action_ids:\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((next_state, cur_plan + [a]))\n\n  # No plan found within limits \u2013 return empty list.\n  return []", "env_interactions": 4, "island_id": 2, "scores": {"3": 1.5}}
