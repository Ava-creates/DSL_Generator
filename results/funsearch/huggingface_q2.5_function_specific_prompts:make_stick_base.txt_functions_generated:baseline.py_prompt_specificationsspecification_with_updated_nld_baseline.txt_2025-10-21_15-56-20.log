{"timestamp": "2025-10-21T17:14:33.042510", "function_name": "make_stick", "function_body": "  # Reset environment and fetch core objects\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  cookbook = world.cookbook\n\n  # ------------------------------------------------------------------\n  # Identify the index for the target item \"stick\"\n  # ------------------------------------------------------------------\n  try:\n      stick_idx = cookbook.index[\"stick\"]\n  except Exception:\n      return []   # stick not defined in this world\n\n  # ------------------------------------------------------------------\n  # Determine primitive ingredients needed for one stick\n  # ------------------------------------------------------------------\n  prim_req = cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n  # If empty, stick itself is a primitive (no crafting needed)\n  stick_is_primitive = not bool(prim_req)\n  if stick_is_primitive:\n      prim_req = {stick_idx: 1}\n\n  # ------------------------------------------------------------------\n  # Action mapping (environment specific)\n  # ------------------------------------------------------------------\n  act_map = env.action_specs()\n  DOWN = act_map.get('DOWN', 0)\n  UP   = act_map.get('UP', 1)\n  LEFT = act_map.get('LEFT', 2)\n  RIGHT= act_map.get('RIGHT', 3)\n  USE  = act_map.get('USE', 4)\n\n  # ------------------------------------------------------------------\n  # Helper to generate a list of movement actions from a to b\n  # ------------------------------------------------------------------\n  def moves_to(start, target):\n      \"\"\"Return a list of actions moving from start (x,y) to target (x,y).\"\"\"\n      cx, cy = start\n      tx, ty = target\n      actions = []\n      while cx < tx:\n          actions.append(DOWN); cx += 1\n      while cx > tx:\n          actions.append(UP);   cx -= 1\n      while cy < ty:\n          actions.append(RIGHT); cy += 1\n      while cy > ty:\n          actions.append(LEFT);  cy -= 1\n      return actions\n\n  # ------------------------------------------------------------------\n  # Locate all required primitives on the grid\n  # ------------------------------------------------------------------\n  grid = state.grid\n  prim_locs = {}\n  for p_idx in prim_req:\n      positions = np.argwhere(grid[:, :, p_idx] > 0)\n      prim_locs[p_idx] = [tuple(pos) for pos in positions]\n\n  # ------------------------------------------------------------------\n  # Locate a workshop (if any) \u2013 needed for crafting non\u2011primitive items\n  # ------------------------------------------------------------------\n  workshop_pos = None\n  if not stick_is_primitive:\n      for wk_idx in world.workshop_indices:\n          cells = np.argwhere(grid[:, :, wk_idx] > 0)\n          if cells.size:\n              workshop_pos = tuple(cells[0])\n              break\n\n  # ------------------------------------------------------------------\n  # Build the action plan\n  # ------------------------------------------------------------------\n  cur_pos = state.pos\n  plan = []\n\n  # Collect each required primitive, choosing nearest available instance\n  for p_idx, needed in prim_req.items():\n      collected = 0\n      available = prim_locs.get(p_idx, []).copy()\n      if not available:\n          # Required primitive not present \u2013 cannot complete the task\n          return []\n      while collected < needed:\n          # Find nearest primitive location\n          dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in available]\n          nearest = int(np.argmin(dists))\n          target = available.pop(nearest)\n\n          # Move to the primitive and pick it up\n          plan.extend(moves_to(cur_pos, target))\n          cur_pos = target\n          plan.append(USE)          # pick up the primitive\n          collected += 1\n\n  # If crafting is required, move to a workshop and invoke USE to craft\n  if not stick_is_primitive:\n      if workshop_pos is not None:\n          plan.extend(moves_to(cur_pos, workshop_pos))\n          cur_pos = workshop_pos\n      plan.append(USE)              # trigger crafting\n\n  return plan", "env_interactions": 4, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T17:15:02.972472", "function_name": "make_stick", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n\n  # Mapping from direction vector to action index\n  DIR_ACTION = {(1, 0): 3, (-1, 0): 2, (0, 1): 0, (0, -1): 1}\n\n  # Current mutable position\n  cur_pos = list(state.pos)  # [x, y]\n\n  actions = []\n\n  def move_axis(dx, dy):\n      \"\"\"Record a single step in the given cardinal direction.\"\"\"\n      if (dx, dy) == (0, 0):\n          return\n      actions.append(DIR_ACTION[(dx, dy)])\n      cur_pos[0] += dx\n      cur_pos[1] += dy\n\n  def go_to(target):\n      \"\"\"Append actions that move from cur_pos to target using Manhattan moves.\"\"\"\n      while cur_pos[0] < target[0]:\n          move_axis(1, 0)\n      while cur_pos[0] > target[0]:\n          move_axis(-1, 0)\n      while cur_pos[1] < target[1]:\n          move_axis(0, 1)\n      while cur_pos[1] > target[1]:\n          move_axis(0, -1)\n\n  # ------------------------------------------------------------------\n  # 1. Determine primitives needed to craft a stick.\n  # ------------------------------------------------------------------\n  stick_idx = world.cookbook.index.index('stick')\n  needed = world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # 2. Collect each required primitive.\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          # Locate a remaining instance of the primitive.\n          locs = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if locs.size == 0:\n              break  # no more of this primitive on the map\n          target = locs[0]  # (x, y)\n\n          # Choose an empty adjacent cell to stand on.\n          adj = None\n          for dx, dy in [(0, -1), (0, 1), (-1, 0), (1, 0)]:\n              nx, ny = target[0] + dx, target[1] + dy\n              if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                  if not state.grid[nx, ny].any():\n                      adj = (nx, ny)\n                      break\n          if adj is None:\n              # Fallback: stand on the primitive cell itself.\n              adj = (target[0], target[1])\n\n          go_to(adj)\n\n          # Ensure we are facing the primitive (the last move direction already does this\n          # for the chosen adjacent cell). If we fell back to the primitive cell itself,\n          # a dummy turn is not needed because USE works on the cell in front, which is\n          # the same cell.\n          actions.append(4)  # USE to pick up\n\n          # Simulate removal so later searches don't see the same item.\n          state.grid[target[0], target[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 3. Go to a workshop and craft the stick.\n  # ------------------------------------------------------------------\n  workshop_pos = None\n  for wk_idx in world.workshop_indices:\n      locs = np.argwhere(state.grid[:, :, wk_idx] > 0)\n      if locs.size:\n          workshop_pos = tuple(locs[0])\n          break\n\n  if workshop_pos is not None:\n      go_to(workshop_pos)\n      actions.append(4)  # USE to craft at the workshop\n  else:\n      # No workshop found \u2013 attempt a USE at the current location.\n      actions.append(4)\n\n  return actions", "env_interactions": 4, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T17:15:04.078921", "function_name": "make_stick", "function_body": "  # ------------------------------------------------------------------\n  # Setup\n  # ------------------------------------------------------------------\n  env.reset()\n  state = env._current_state\n  world = env.world\n\n  # Mapping from movement delta to action index (as used by CraftLab)\n  DIR_TO_ACTION = {\n      (1, 0): 3,   # RIGHT\n      (-1, 0): 2,  # LEFT\n      (0, 1): 0,   # DOWN\n      (0, -1): 1,  # UP\n  }\n\n  # Helper: shortest Manhattan\u2011free path using BFS\n  from collections import deque\n\n  def bfs(start, goal, grid, allow_idx=None):\n      \"\"\"Return list of positions from start (exclusive) to goal (inclusive).\"\"\"\n      W, H, _ = grid.shape\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = set()\n      visited.add((start[0], start[1]))\n      while q:\n          x, y, path = q.popleft()\n          if (x, y) == (goal[0], goal[1]):\n              return path  # path does NOT contain the start cell\n          for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in visited:\n                  # cell is walkable if empty OR contains the allowed index (target primitive / workshop)\n                  cell_contents = grid[nx, ny, :]\n                  blocked = cell_contents.sum() > 0\n                  if blocked and allow_idx is not None:\n                      if cell_contents[allow_idx] > 0:\n                          blocked = False\n                  if not blocked:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [(dx, dy)]))\n      # If no path found, return empty list (should not happen in well\u2011formed scenarios)\n      return []\n\n  # ------------------------------------------------------------------\n  # Determine primitives needed for a stick\n  # ------------------------------------------------------------------\n  stick_idx = world.cookbook.index.index('stick')\n  needed = world.cookbook.primitives_for(stick_idx)   # dict {prim_idx: count}\n  cur_pos = list(state.pos)   # mutable [x, y]\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          # locate a primitive of this type (take the first one found)\n          locations = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if locations.size == 0:\n              # nothing left of this primitive \u2013 break out\n              break\n          target = locations[0]                     # (x, y)\n\n          # compute path avoiding all occupied cells except the target primitive\n          path = bfs(tuple(cur_pos), tuple(target), state.grid, allow_idx=prim_idx)\n\n          # translate path deltas into actions\n          for dx, dy in path:\n              actions.append(DIR_TO_ACTION[(dx, dy)])\n              cur_pos[0] += dx\n              cur_pos[1] += dy\n\n          # pick up the primitive\n          actions.append(4)      # USE\n          # update grid to reflect that the primitive has been taken\n          state.grid[target[0], target[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Move to a workshop and craft the stick\n  # ------------------------------------------------------------------\n  workshop_pos = None\n  for wk_idx in world.workshop_indices:\n      locs = np.argwhere(state.grid[:, :, wk_idx] > 0)\n      if locs.size:\n          workshop_pos = locs[0]\n          workshop_idx = wk_idx\n          break\n\n  if workshop_pos is not None:\n      # path to workshop (allow stepping onto the workshop cell)\n      path = bfs(tuple(cur_pos), tuple(workshop_pos), state.grid, allow_idx=workshop_idx)\n      for dx, dy in path:\n          actions.append(DIR_TO_ACTION[(dx, dy)])\n          cur_pos[0] += dx\n          cur_pos[1] += dy\n      # craft stick\n      actions.append(4)   # USE\n\n  return actions", "env_interactions": 4, "island_id": 8, "scores": {"3": 0.0}}
