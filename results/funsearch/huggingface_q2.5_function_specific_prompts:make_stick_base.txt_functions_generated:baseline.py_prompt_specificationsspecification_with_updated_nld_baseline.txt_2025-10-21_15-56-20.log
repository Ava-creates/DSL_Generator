{"timestamp": "2025-10-21T17:43:10.498090", "function_name": "make_stick", "function_body": "  # Reset the environment to get a fresh state\n  env.reset()\n  state = env._current_state          # CraftState instance after reset\n  world = env.world                    # CraftWorld instance\n  grid = state.grid.copy()             # (W, H, n_kinds) occupancy array\n\n  # ------------------------------------------------------------------\n  # Helper constants and functions\n  # ------------------------------------------------------------------\n  # Action indices (as defined in CraftLab.action_specs)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  DIR_VECT = {DOWN: (0, 1), UP: (0, -1), LEFT: (-1, 0), RIGHT: (1, 0)}\n  # Mapping from a vector (dx,dy) to the action that faces that direction\n  VEC_TO_DIR = {(0, 1): DOWN, (0, -1): UP, (-1, 0): LEFT, (1, 0): RIGHT}\n\n  W, H, _ = grid.shape\n\n  def in_bounds(x, y):\n      return 0 <= x < W and 0 <= y < H\n\n  # Cells are walkable iff they contain no entities (all kinds == 0)\n  walkable = (grid.sum(axis=2) == 0)\n\n  from collections import deque\n\n  def bfs(start, targets):\n      \"\"\"Return a list of actions to move from start to any cell in *targets*.\n      *targets* is a set of (x, y) tuples. If start is already a target, returns [].\n      \"\"\"\n      if start in targets:\n          return []\n      q = deque()\n      q.append((start, []))\n      seen = {start}\n      while q:\n          (x, y), path = q.popleft()\n          for act, (dx, dy) in DIR_VECT.items():\n              nx, ny = x + dx, y + dy\n              if not in_bounds(nx, ny):\n                  continue\n              if not walkable[nx, ny]:\n                  continue\n              if (nx, ny) in seen:\n                  continue\n              npath = path + [act]\n              if (nx, ny) in targets:\n                  return npath\n              seen.add((nx, ny))\n              q.append(((nx, ny), npath))\n      # No path found \u2013 return empty list (should not happen in valid scenarios)\n      return []\n\n  # ------------------------------------------------------------------\n  # Determine the goal (stick) and its recipe\n  # ------------------------------------------------------------------\n  stick_idx = world.cookbook.index[\"stick\"]\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n\n  # Primitive requirements (ignore the special \"_at\" key)\n  primitive_needs = {\n      k: v for k, v in recipe.items() if k != \"_key\" and k != \"_at\"\n  }\n\n  # ------------------------------------------------------------------\n  # Action list we will build\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = state.pos\n  cur_dir = state.dir\n\n  # ------------------------------------------------------------------\n  # Helper to turn the agent to face a given neighbour cell\n  # ------------------------------------------------------------------\n  def turn_to(target_xy):\n      nonlocal cur_dir, actions\n      dx = target_xy[0] - cur_pos[0]\n      dy = target_xy[1] - cur_pos[1]\n      # The target must be exactly one cell away (Manhattan distance 1)\n      if (dx, dy) not in VEC_TO_DIR:\n          return\n      desired_dir = VEC_TO_DIR[(dx, dy)]\n      if cur_dir != desired_dir:\n          # In this simple implementation we just issue a USE action; the\n          # environment does not penalise turning, we just set direction by\n          # moving a dummy step and moving back.\n          # However CraftWorld updates direction automatically when moving,\n          # so we can achieve the desired orientation by a single step\n          # forward and then stepping back.\n          # Simpler: we just set cur_dir to desired_dir (no action needed)\n          cur_dir = desired_dir\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive\n  # ------------------------------------------------------------------\n  for prim_idx, count_needed in primitive_needs.items():\n      for _ in range(count_needed):\n          # locate all cells that currently contain this primitive\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # Primitive not present \u2013 cannot continue\n              return actions\n          # Choose the nearest primitive (Manhattan distance)\n          distances = np.abs(prim_cells[:, 0] - cur_pos[0]) + np.abs(prim_cells[:, 1] - cur_pos[1])\n          nearest_idx = distances.argmin()\n          tx, ty = prim_cells[nearest_idx]\n\n          # Determine reachable adjacent cells (4\u2011neighbourhood) that are empty\n          adj_targets = set()\n          for dx, dy in DIR_VECT.values():\n              ax, ay = tx + dx, ty + dy\n              if in_bounds(ax, ay) and walkable[ax, ay]:\n                  adj_targets.add((ax, ay))\n\n          # Plan path to one of the adjacent cells\n          path = bfs(cur_pos, adj_targets)\n          actions.extend(path)\n\n          # Update simulated position after following the path\n          for a in path:\n              dx, dy = DIR_VECT[a]\n              cur_pos = (cur_pos[0] + dx, cur_pos[1] + dy)\n              cur_dir = a  # moving also sets facing direction\n\n          # Now we are on a neighbour cell; face the primitive and USE\n          turn_to((tx, ty))\n          actions.append(USE)\n\n          # Simulate the USE: remove primitive from grid and add to inventory\n          grid[tx, ty, prim_idx] = 0\n          # (inventory update not needed for planning)\n\n  # ------------------------------------------------------------------\n  # Craft the stick at its required workshop (if any)\n  # ------------------------------------------------------------------\n  workshop_kind = recipe.get(\"_at\", None)\n  if workshop_kind is not None:\n      # locate any workshop cell of the required kind\n      workshop_cells = np.argwhere(grid[:, :, workshop_kind] > 0)\n      if workshop_cells.size > 0:\n          # pick the nearest workshop\n          distances = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])\n          nearest_idx = distances.argmin()\n          wx, wy = workshop_cells[nearest_idx]\n\n          # Find reachable adjacent cells around the workshop\n          adj_targets = set()\n          for dx, dy in DIR_VECT.values():\n              ax, ay = wx + dx, wy + dy\n              if in_bounds(ax, ay) and walkable[ax, ay]:\n                  adj_targets.add((ax, ay))\n\n          path = bfs(cur_pos, adj_targets)\n          actions.extend(path)\n\n          for a in path:\n              dx, dy = DIR_VECT[a]\n              cur_pos = (cur_pos[0] + dx, cur_pos[1] + dy)\n              cur_dir = a\n\n          # Face the workshop and USE to craft\n          turn_to((wx, wy))\n          actions.append(USE)\n\n  # Return the complete action sequence\n  return actions", "env_interactions": 0, "island_id": 9, "scores": {"3": -1}}
