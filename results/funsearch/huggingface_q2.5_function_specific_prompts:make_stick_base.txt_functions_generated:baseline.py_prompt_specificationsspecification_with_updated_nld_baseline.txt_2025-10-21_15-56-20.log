{"timestamp": "2025-10-21T21:19:33.739313", "function_name": "make_stick", "function_body": "  import collections\n\n  # ----------------------------------------------------------------------\n  # Obtain the list of action identifiers.  If the environment does not\n  # expose an action spec, fall back to the canonical ordering.\n  # ----------------------------------------------------------------------\n  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      # Default ordering: DOWN, UP, LEFT, RIGHT, USE\n      action_ids = [0, 1, 2, 3, 4]\n\n  # ----------------------------------------------------------------------\n  # Resolve the internal index for the target item \"stick\".\n  # ----------------------------------------------------------------------\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n  if stick_idx is None:\n      # The world does not contain a stick item \u2013 nothing we can do.\n      return []\n\n  # ----------------------------------------------------------------------\n  # Ensure we have a current state; reset the environment if necessary.\n  # ----------------------------------------------------------------------\n  if not hasattr(env, \"_current_state\") or env._current_state is None:\n      env.reset()\n  start_state = env._current_state\n\n  # If we already possess a stick, no actions are required.\n  if start_state.inventory[stick_idx] > 0:\n      return []\n\n  # ----------------------------------------------------------------------\n  # Bread\u2011first search over deterministic state transitions.\n  # ----------------------------------------------------------------------\n  frontier = collections.deque()\n  frontier.append((start_state, []))\n\n  # Encode a state uniquely for the visited set.\n  def _state_key(st):\n      # Include position, direction, inventory and the full grid because\n      # picking up or crafting modifies the grid.\n      return (\n          st.pos,\n          st.dir,\n          st.inventory.tobytes(),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_key(start_state)}\n  max_plan_len = 300  # safety bound to keep the search tractable\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      # Goal test.\n      if cur_state.inventory[stick_idx] > 0:\n          return cur_plan\n\n      # Prune overly long plans.\n      if len(cur_plan) >= max_plan_len:\n          continue\n\n      # Expand all possible actions.\n      for a in action_ids:\n          _, nxt_state = cur_state.step(a)\n          key = _state_key(nxt_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((nxt_state, cur_plan + [a]))\n\n  # No feasible plan found within the limits.\n  return []", "env_interactions": 4, "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T21:20:01.484398", "function_name": "make_stick", "function_body": "  # reset environment to get fresh state\n  env.reset()\n\n  # shortcuts\n  world = env.world\n  idx = world.cookbook.index\n\n  # index of the goal item \"stick\"\n  try:\n      stick_idx = idx[\"stick\"]\n  except Exception:  # pragma: no cover\n      stick_idx = next(i for i, n in enumerate(idx.ordered_contents) if n.lower() == \"stick\")\n\n  # primitive requirements for one stick (empty dict if stick itself is primitive)\n  needed = world.cookbook.primitives_for(stick_idx)\n  if not needed:\n      needed = {stick_idx: 1}\n\n  # action mapping\n  act_map = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act_map[\"DOWN\"],\n      act_map[\"UP\"],\n      act_map[\"LEFT\"],\n      act_map[\"RIGHT\"],\n      act_map[\"USE\"],\n  )\n  delta_to_action = {\n      (0, -1): UP,\n      (0, 1): DOWN,\n      (-1, 0): LEFT,\n      (1, 0): RIGHT,\n  }\n\n  # current state information\n  state = env._current_state\n  cur_pos = tuple(state.pos)          # (x, y)\n  grid = state.grid.copy()            # local copy for bookkeeping\n\n  # ------------------------------------------------------------------\n  # Helper: BFS pathfinder that avoids non\u2011grabbable entities.\n  # Returns a list of action ids moving from start to goal.\n  # ------------------------------------------------------------------\n  def bfs_path(start, goal):\n      \"\"\"Return list of actions to move from start to goal.\"\"\"\n      W, H = grid.shape[:2]\n      start = tuple(start)\n      goal = tuple(goal)\n      if start == goal:\n          return []\n\n      # cells blocked by any non\u2011grabbable entity\n      blocked = np.zeros((W, H), dtype=bool)\n      for k in world.non_grabbable_indices:\n          blocked |= grid[:, :, k] > 0\n\n      visited = np.full((W, H), False, dtype=bool)\n      prev = {}\n      q = collections.deque([start])\n      visited[start] = True\n\n      while q:\n          x, y = q.popleft()\n          if (x, y) == goal:\n              break\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  # allow stepping onto the goal cell even if it is blocked\n                  if blocked[nx, ny] and (nx, ny) != goal:\n                      continue\n                  visited[nx, ny] = True\n                  prev[(nx, ny)] = (x, y)\n                  q.append((nx, ny))\n\n      # reconstruct path\n      if goal not in prev and start != goal:\n          return []  # no path found\n      path = []\n      cur = goal\n      while cur != start:\n          path.append(cur)\n          cur = prev[cur]\n      path.reverse()\n\n      # translate to actions\n      actions = []\n      x, y = start\n      for nx, ny in path:\n          dx, dy = nx - x, ny - y\n          actions.append(delta_to_action[(dx, dy)])\n          x, y = nx, ny\n      return actions\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives (respecting quantities)\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(int(cnt)):\n          # locate any remaining instance of this primitive\n          locs = np.argwhere(grid[:, :, prim_idx] > 0)\n          if locs.size == 0:\n              # nothing left \u2013 give up on this primitive\n              break\n          # choose the closest one (Manhattan distance)\n          dists = np.abs(locs[:, 0] - cur_pos[0]) + np.abs(locs[:, 1] - cur_pos[1])\n          target = tuple(locs[dists.argmin()])\n\n          # move to the primitive\n          actions.extend(bfs_path(cur_pos, target))\n          cur_pos = target\n\n          # pick it up\n          actions.append(USE)\n\n          # update local grid copy\n          grid[target[0], target[1], prim_idx] = max(\n              0, grid[target[0], target[1], prim_idx] - 1\n          )\n\n  # ------------------------------------------------------------------\n  # 2. Go to the required workshop (if any) and craft the stick\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      ws_idx = idx[workshop_name]\n      ws_locs = np.argwhere(grid[:, :, ws_idx] > 0)\n      if ws_locs.size:\n          # choose nearest workshop\n          dists = np.abs(ws_locs[:, 0] - cur_pos[0]) + np.abs(ws_locs[:, 1] - cur_pos[1])\n          ws_target = tuple(ws_locs[dists.argmin()])\n\n          actions.extend(bfs_path(cur_pos, ws_target))\n          cur_pos = ws_target\n\n          # use the workshop to craft the stick\n          actions.append(USE)\n\n  # return the computed action sequence\n  return actions", "env_interactions": 4, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:20:02.605530", "function_name": "make_stick", "function_body": "  env.reset()\n\n  # shortcuts\n  world = env.world\n  idx = world.cookbook.index\n\n  # get stick index (case\u2011insensitive fallback)\n  try:\n      stick_idx = idx[\"stick\"]\n  except Exception:  # pragma: no cover\n      stick_idx = next(i for i, n in enumerate(idx.ordered_contents) if n.lower() == \"stick\")\n\n  # primitive requirements (if stick itself is primitive treat as needed)\n  needed = world.cookbook.primitives_for(stick_idx)\n  if not needed:\n      needed = {stick_idx: 1}\n\n  # action ids\n  act_map = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act_map[\"DOWN\"],\n      act_map[\"UP\"],\n      act_map[\"LEFT\"],\n      act_map[\"RIGHT\"],\n      act_map[\"USE\"],\n  )\n  # translate delta \u2192 action\n  def delta_to_action(dx, dy):\n      if dx == 1:\n          return RIGHT\n      if dx == -1:\n          return LEFT\n      if dy == 1:\n          return DOWN\n      if dy == -1:\n          return UP\n      raise ValueError(\"invalid move delta\")\n\n  # BFS pathfinder that avoids non\u2011grabbable entities;\n  # can step onto a cell that only contains `ignore_kind`\n  def bfs_path(start, goal, ignore_kind=None):\n      W, H, _ = grid.shape\n      start = tuple(start)\n      goal = tuple(goal)\n      if start == goal:\n          return []\n\n      visited = np.full((W, H), False, dtype=bool)\n      prev = {}\n      q = collections.deque([start])\n      visited[start] = True\n\n      while q:\n          x, y = q.popleft()\n          if (x, y) == goal:\n              break\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  # determine if cell is blocked\n                  blocked = False\n                  # any non\u2011grabbable entity present?\n                  for k in world.non_grabbable_indices:\n                      if grid[nx, ny, k] > 0:\n                          blocked = True\n                          break\n                  # allow stepping onto the goal cell if it only holds the ignored kind\n                  if (nx, ny) == goal and ignore_kind is not None:\n                      if grid[nx, ny, ignore_kind] > 0:\n                          other = grid[nx, ny].sum() - grid[nx, ny, ignore_kind]\n                          if other == 0:\n                              blocked = False\n                  if not blocked:\n                      visited[nx, ny] = True\n                      prev[(nx, ny)] = (x, y)\n                      q.append((nx, ny))\n\n      # reconstruct actions\n      if goal not in prev and start != goal:\n          return []  # no path found\n      actions = []\n      cur = goal\n      rev_path = []\n      while cur != start:\n          rev_path.append(cur)\n          cur = prev[cur]\n      rev_path.reverse()\n      cx, cy = start\n      for nx, ny in rev_path:\n          actions.append(delta_to_action(nx - cx, ny - cy))\n          cx, cy = nx, ny\n      return actions\n\n  # current state info\n  state = env._current_state\n  cur_pos = tuple(state.pos)\n  grid = state.grid.copy()\n\n  plan = []\n\n  # ------------------------------------------------------------------\n  # 1. Gather required primitives (respecting quantity)\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(int(cnt)):\n          # locate any remaining instance of this primitive\n          locs = np.argwhere(grid[:, :, prim_idx] > 0)\n          if locs.size == 0:\n              break  # nothing left\n          # choose the closest one (Manhattan)\n          dists = np.abs(locs[:, 0] - cur_pos[0]) + np.abs(locs[:, 1] - cur_pos[1])\n          target = tuple(locs[dists.argmin()])\n\n          # move to the primitive\n          plan.extend(bfs_path(cur_pos, target, ignore_kind=prim_idx))\n          cur_pos = target\n\n          # pick it up\n          plan.append(USE)\n\n          # update local copy\n          grid[target[0], target[1], prim_idx] = max(\n              0, grid[target[0], target[1], prim_idx] - 1\n          )\n\n  # ------------------------------------------------------------------\n  # 2. Go to the workshop (if required) and craft the stick\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      ws_idx = idx[workshop_name]\n      ws_locs = np.argwhere(grid[:, :, ws_idx] > 0)\n      if ws_locs.size:\n          dists = np.abs(ws_locs[:, 0] - cur_pos[0]) + np.abs(ws_locs[:, 1] - cur_pos[1])\n          ws_target = tuple(ws_locs[dists.argmin()])\n          plan.extend(bfs_path(cur_pos, ws_target, ignore_kind=ws_idx))\n          cur_pos = ws_target\n          plan.append(USE)  # craft at workshop\n\n  return plan", "env_interactions": 4, "island_id": 0, "scores": {"3": 0.0}}
