{"timestamp": "2025-10-21T17:01:25.276127", "function_name": "make_stick", "function_body": "  from collections import deque\n\n  # Obtain the list of possible action IDs.\n  try:\n      actions = list(env.action_specs().values())\n  except Exception:\n      # Default ordering: DOWN, UP, LEFT, RIGHT, USE\n      actions = [0, 1, 2, 3, 4]\n\n  # Index of the target item (\"stick\") in the world cookbook.\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n\n  # If the stick index cannot be resolved, return an empty plan.\n  if stick_idx is None:\n      return []\n\n  # Helper that checks whether a given state satisfies the goal.\n  def is_goal(state):\n      return state.satisfies(\"\", stick_idx)\n\n  # Starting state (do not mutate the environment's current state).\n  start_state = env._current_state\n\n  # Bread\u2011first search over deterministic state transitions.\n  frontier = deque()\n  frontier.append((start_state, []))\n  visited = set()\n\n  # Encode a state uniquely for the visited set.\n  def state_key(st):\n      return (st.pos, st.dir, st.inventory.tobytes())\n\n  visited.add(state_key(start_state))\n  max_plan_len = 300  # safety bound to keep the search tractable\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n      if is_goal(cur_state):\n          return cur_plan\n      if len(cur_plan) >= max_plan_len:\n          continue\n      for a in actions:\n          _, nxt_state = cur_state.step(a)\n          key = state_key(nxt_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((nxt_state, cur_plan + [a]))\n\n  # No plan found within the limits.\n  return []", "env_interactions": 4, "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T17:01:26.377744", "function_name": "make_stick", "function_body": "  import copy\n  from collections import deque\n\n  # Obtain action IDs from the environment; fall back to default ordering if needed\n  try:\n      action_map = env.action_specs()\n      action_ids = list(action_map.values())\n  except Exception:\n      action_ids = [0, 1, 2, 3, 4]  # DOWN, UP, LEFT, RIGHT, USE (standard order)\n\n  # Index of the target item \"stick\"\n  try:\n      goal_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      goal_idx = env.world.cookbook.index.get(\"stick\", None)\n\n  def is_goal(state):\n      return goal_idx is not None and state.satisfies(\"\", goal_idx)\n\n  # Starting state (do not modify the live environment state)\n  start_state = env._current_state  # type: ignore[attr-defined]\n\n  frontier = deque()\n  frontier.append((start_state, []))\n  visited = set()\n\n  def state_key(st):\n      return (st.pos, st.dir, st.inventory.tobytes())\n\n  visited.add(state_key(start_state))\n\n  max_steps = 200  # safety limit to prevent infinite search\n\n  while frontier:\n      cur_state, cur_actions = frontier.popleft()\n      if is_goal(cur_state):\n          return cur_actions\n      if len(cur_actions) >= max_steps:\n          continue\n      for a in action_ids:\n          _, next_state = cur_state.step(a)\n          key = state_key(next_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((next_state, cur_actions + [a]))\n\n  # No plan found within limits\n  return []", "env_interactions": 4, "island_id": 7, "scores": {"3": 1.5}}
