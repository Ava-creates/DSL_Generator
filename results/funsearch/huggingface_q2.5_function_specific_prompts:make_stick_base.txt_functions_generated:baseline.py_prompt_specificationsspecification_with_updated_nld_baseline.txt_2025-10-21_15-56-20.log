{"timestamp": "2025-10-21T20:07:48.943754", "function_name": "make_stick", "function_body": "  from collections import deque\n\n  # Obtain the list of action IDs; fall back to the standard order if unavailable.\n  try:\n      action_map = env.action_specs()\n      action_ids = list(action_map.values())\n  except Exception:\n      action_ids = [0, 1, 2, 3, 4]  # DOWN, UP, LEFT, RIGHT, USE (standard ordering)\n\n  # Index of the target item \"stick\" in the cookbook.\n  try:\n      goal_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      goal_idx = env.world.cookbook.index.get(\"stick\")\n\n  def is_goal(state):\n      \"\"\"Return True if the state's inventory already contains a stick.\"\"\"\n      return goal_idx is not None and state.satisfies(\"\", goal_idx)\n\n  # Starting state \u2013 use the current state if the lab wrapper exposes it,\n  # otherwise initialise a fresh state from the scenario.\n  start_state = getattr(env, \"_current_state\", None)\n  if start_state is None:\n      start_state = env.scenario.init()\n\n  # Bread\u2011first search over deterministic transitions.\n  frontier = deque()\n  frontier.append((start_state, []))\n  visited = set()\n\n  def state_key(st):\n      \"\"\"Compact representation for visited\u2011state tracking.\"\"\"\n      return (st.pos, st.dir, st.inventory.tobytes())\n\n  visited.add(state_key(start_state))\n\n  max_steps = 500  # safety bound on plan length\n\n  while frontier:\n      cur_state, cur_actions = frontier.popleft()\n      if is_goal(cur_state):\n          return cur_actions\n      if len(cur_actions) >= max_steps:\n          continue\n      for a in action_ids:\n          _, next_state = cur_state.step(a)\n          key = state_key(next_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((next_state, cur_actions + [a]))\n\n  # No plan found within the limits.\n  return []", "env_interactions": 4, "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T20:08:48.956274", "function_name": "make_stick", "function_body": "  # Action indices\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n  # Direction vectors corresponding to the above actions (dx, dy)\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n\n  def bfs(start, goals, occupied):\n      \"\"\"Bread\u2011first search from start to any cell in goals avoiding occupied cells.\"\"\"\n      w, h = occupied.shape\n      q = collections.deque()\n      q.append((start, []))\n      seen = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in goals:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and not occupied[nx, ny]:\n                  if (nx, ny) not in seen:\n                      seen.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return None\n\n  # ----------------------------------------------------------------------\n  # Reset environment and fetch initial state\n  # ----------------------------------------------------------------------\n  env.reset()\n  state = env._current_state\n  world = env.world\n\n  # Goal is to craft a stick\n  goal_name = \"stick\"\n  goal_idx = world.cookbook.index[goal_name]\n\n  # Primitive requirements for the goal (may be empty if goal is primitive)\n  needed = dict(world.cookbook.primitives_for(goal_idx))\n\n  # ----------------------------------------------------------------------\n  # Collect all required primitives\n  # ----------------------------------------------------------------------\n  while any(cnt > 0 for cnt in needed.values()):\n      # pick a primitive that is still needed\n      prim_idx = next(k for k, v in needed.items() if v > 0)\n\n      # locate any instance of this primitive on the current grid\n      grid = state.grid\n      prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n      if prim_cells.size == 0:\n          # no more primitives of this type \u2013 break to avoid infinite loop\n          break\n      tx, ty = prim_cells[0]  # choose the first occurrence\n\n      # occupied cells (any kind present)\n      occupied = np.any(grid, axis=2)\n\n      # cells adjacent to the primitive that are free to stand on\n      adj_free = []\n      for dx, dy in DIRS:\n          nx, ny = tx + dx, ty + dy\n          if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n              if not occupied[nx, ny]:\n                  adj_free.append((nx, ny))\n\n      # find a path to one of the free adjacent cells\n      path = bfs(state.pos, set(adj_free), occupied)\n      if path is None:\n          # cannot reach the primitive \u2013 abort\n          break\n\n      # execute the movement actions\n      for act in path:\n          _, _, _ = env.step(act)\n          state = env._current_state\n      # use (pick up) the primitive\n      _, _, _ = env.step(ACTION_USE)\n      state = env._current_state\n      needed[prim_idx] -= 1\n\n  # ----------------------------------------------------------------------\n  # Go to the appropriate workshop and craft the stick\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes[goal_idx]\n  workshop_name = recipe[\"_at\"]\n  workshop_idx = world.cookbook.index[workshop_name]\n\n  # locate a workshop cell\n  grid = state.grid\n  ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if ws_cells.size > 0:\n      wx, wy = ws_cells[0]\n\n      occupied = np.any(grid, axis=2)\n\n      # free cells adjacent to the workshop\n      adj_free_ws = []\n      for dx, dy in DIRS:\n          nx, ny = wx + dx, wy + dy\n          if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n              if not occupied[nx, ny]:\n                  adj_free_ws.append((nx, ny))\n\n      # path to a free adjacent cell\n      path = bfs(state.pos, set(adj_free_ws), occupied)\n      if path is not None:\n          for act in path:\n              _, _, _ = env.step(act)\n              state = env._current_state\n\n      # use (craft) at the workshop\n      _, _, _ = env.step(ACTION_USE)\n\n  # The sequence of actions taken is stored in the environment's internal\n  # step history; however, the function is required to return the list of\n  # action indices that were issued.\n  # Re\u2011run the episode to collect the actions while re\u2011executing them.\n  env.reset()\n  action_list = []\n  # repeat the same logic but record actions\n  state = env._current_state\n  needed = dict(world.cookbook.primitives_for(goal_idx))\n  while any(cnt > 0 for cnt in needed.values()):\n      prim_idx = next(k for k, v in needed.items() if v > 0)\n      grid = state.grid\n      prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n      tx, ty = prim_cells[0]\n      occupied = np.any(grid, axis=2)\n      adj_free = []\n      for dx, dy in DIRS:\n          nx, ny = tx + dx, ty + dy\n          if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n              if not occupied[nx, ny]:\n                  adj_free.append((nx, ny))\n      path = bfs(state.pos, set(adj_free), occupied)\n      for act in path:\n          action_list.append(act)\n          _, _, _ = env.step(act)\n          state = env._current_state\n      action_list.append(ACTION_USE)\n      _, _, _ = env.step(ACTION_USE)\n      state = env._current_state\n      needed[prim_idx] -= 1\n\n  # workshop step\n  grid = state.grid\n  ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  wx, wy = ws_cells[0]\n  occupied = np.any(grid, axis=2)\n  adj_free_ws = []\n  for dx, dy in DIRS:\n      nx, ny = wx + dx, wy + dy\n      if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n          if not occupied[nx, ny]:\n              adj_free_ws.append((nx, ny))\n  path = bfs(state.pos, set(adj_free_ws), occupied)\n  for act in path:\n      action_list.append(act)\n      _, _, _ = env.step(act)\n      state = env._current_state\n  action_list.append(ACTION_USE)\n  _, _, _ = env.step(ACTION_USE)\n\n  return action_list", "env_interactions": 5, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T20:08:50.107249", "function_name": "make_stick", "function_body": "  import collections\n  import numpy as np\n\n  # Direction constants matching the environment's action mapping\n  # 0: DOWN, 1: UP, 2: LEFT, 3: RIGHT, 4: USE\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n\n  # reset the environment to obtain a fresh state\n  _ = env.reset()\n  state = env._current_state\n  world = env.world\n\n  grid = state.grid.copy()          # (W, H, n_kinds)\n  cur_pos = tuple(state.pos)        # (x, y)\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def occupied_cells(g):\n      \"\"\"Return a boolean array (H, W) where True means the cell is blocked.\"\"\"\n      return np.any(g, axis=2)\n\n  occ = occupied_cells(grid)\n  height, width = occ.shape\n\n  def in_bounds(x, y):\n      return 0 <= x < width and 0 <= y < height\n\n  def bfs_to_adjacent(start, target):\n      \"\"\"Return a list of direction indices that moves from `start` to any\n      free cell adjacent to `target`. If no path exists, return None.\"\"\"\n      tx, ty = target\n      # all free neighbours of the target\n      neighbours = [\n          (tx + dx, ty + dy)\n          for dx, dy in DIRS\n          if in_bounds(tx + dx, ty + dy) and not occ[ty + dy, tx + dx]\n      ]\n      if not neighbours:\n          return None\n\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = set()\n      visited.add((start[0], start[1]))\n\n      while q:\n          x, y, path = q.popleft()\n          if (x, y) in neighbours:\n              return path\n          for d, (dx, dy) in enumerate(DIRS):\n              nx, ny = x + dx, y + dy\n              if (\n                  in_bounds(nx, ny)\n                  and not occ[ny, nx]\n                  and (nx, ny) not in visited\n              ):\n                  visited.add((nx, ny))\n                  q.append((nx, ny, path + [d]))\n      return None\n\n  # ------------------------------------------------------------------\n  # Identify the goal (stick) and its recipe\n  # ------------------------------------------------------------------\n  stick_idx = world.cookbook.index[\"stick\"]\n  recipe = world.cookbook.recipes[stick_idx]\n\n  # workshop required for crafting the stick\n  workshop_name = recipe[\"_at\"]\n  workshop_idx = world.cookbook.index[workshop_name]\n\n  # primitive requirements (primitive_idx -> count)\n  primitive_reqs = world.cookbook.primitives_for(stick_idx)\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Gather each required primitive\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitive_reqs.items():\n      # locate all cells that currently contain this primitive\n      prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n      # repeat until we have collected the required amount\n      for _ in range(needed):\n          # choose the closest primitive (by BFS path length)\n          best_path = None\n          best_cell = None\n          for cell in prim_cells:\n              py, px = cell  # row, col\n              path = bfs_to_adjacent(cur_pos, (px, py))\n              if path is not None and (best_path is None or len(path) < len(best_path)):\n                  best_path = path\n                  best_cell = (px, py)\n          if best_path is None:\n              # no reachable primitive \u2013 give up (return what we have)\n              return actions\n          # move to the neighbour cell\n          actions.extend(best_path)\n          # update current position according to the moves we just added\n          for d in best_path:\n              dx, dy = DIRS[d]\n              cur_pos = (cur_pos[0] + dx, cur_pos[1] + dy)\n          # pick up the primitive\n          actions.append(4)  # USE\n          # mark the primitive as removed from the grid\n          grid[best_cell[1], best_cell[0], prim_idx] = 0\n          occ[best_cell[1], best_cell[0]] = False\n          # remove this cell from future consideration\n          prim_cells = np.delete(\n              prim_cells,\n              np.where(\n                  (prim_cells[:, 0] == best_cell[1]) & (prim_cells[:, 1] == best_cell[0])\n              ),\n              axis=0,\n          )\n\n  # ------------------------------------------------------------------\n  # Move to a workshop and craft the stick\n  # ------------------------------------------------------------------\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      # no workshop found \u2013 cannot craft, return what we have so far\n      return actions\n  wy, wx = workshop_cells[0]  # take the first workshop\n  path_to_ws = bfs_to_adjacent(cur_pos, (wx, wy))\n  if path_to_ws is not None:\n      actions.extend(path_to_ws)\n  # finally, use the workshop to craft the stick\n  actions.append(4)  # USE\n\n  return actions", "env_interactions": 3, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T20:09:30.791638", "function_name": "make_stick", "function_body": "  # Get action indices from the environment\n  action_map = env.action_specs()\n  DOWN = action_map[\"DOWN\"]\n  UP = action_map[\"UP\"]\n  LEFT = action_map[\"LEFT\"]\n  RIGHT = action_map[\"RIGHT\"]\n  USE = action_map[\"USE\"]\n\n  # Current state (assumes the environment has already been reset)\n  state = env._current_state\n  grid = state.grid\n  width, height = grid.shape[0], grid.shape[1]\n\n  # Index of the \"stick\" item in the cookbook\n  stick_idx = env.world.cookbook.index(\"stick\")\n\n  # Find all locations where a stick is present on the ground\n  stick_positions = np.argwhere(grid[:, :, stick_idx] > 0)\n  if len(stick_positions) == 0:\n      # No sticks on the map \u2013 nothing to do\n      return []\n\n  # Choose the first stick we see (any will do for this simple policy)\n  stick_pos = tuple(stick_positions[0])\n\n  # Helper to test whether a cell is free (no entities)\n  def cell_is_free(x, y):\n      return 0 <= x < width and 0 <= y < height and grid[x, y, :].sum() == 0\n\n  # Find a free neighboring cell from which we can interact with the stick\n  neighbors = [\n      (stick_pos[0] - 1, stick_pos[1]),\n      (stick_pos[0] + 1, stick_pos[1]),\n      (stick_pos[0], stick_pos[1] - 1),\n      (stick_pos[0], stick_pos[1] + 1),\n  ]\n  approach = None\n  for nx, ny in neighbors:\n      if cell_is_free(nx, ny):\n          approach = (nx, ny)\n          break\n\n  # If no free neighbor exists, we cannot collect the stick\n  if approach is None:\n      return []\n\n  # Build a simple Manhattan\u2011distance path to the approach cell\n  actions = []\n  cur_x, cur_y = state.pos\n  target_x, target_y = approach\n\n  while (cur_x, cur_y) != (target_x, target_y):\n      if cur_x < target_x:\n          actions.append(RIGHT)\n          cur_x += 1\n      elif cur_x > target_x:\n          actions.append(LEFT)\n          cur_x -= 1\n      elif cur_y < target_y:\n          actions.append(DOWN)\n          cur_y += 1\n      elif cur_y > target_y:\n          actions.append(UP)\n          cur_y -= 1\n\n  # At this point we are adjacent to the stick; face it and use\n  dx = stick_pos[0] - cur_x\n  dy = stick_pos[1] - cur_y\n  if dx == 1:\n      actions.append(RIGHT)\n  elif dx == -1:\n      actions.append(LEFT)\n  elif dy == 1:\n      actions.append(DOWN)\n  elif dy == -1:\n      actions.append(UP)\n  actions.append(USE)\n\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-10-21T20:09:31.920405", "function_name": "make_stick", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ----------------------------------------------------------------------\n  # Helper: breadth\u2011first search that returns a list of action indices\n  # (0=DOWN, 1=UP, 2=LEFT, 3=RIGHT) to move from start \u2192 goal while avoiding\n  # cells that contain any non\u2011grabbable entity.\n  # ----------------------------------------------------------------------\n  def _bfs(start, goal, blocked):\n      W, H = blocked.shape\n      visited = np.full((W, H), False, dtype=bool)\n      prev = dict()                     # (x,y) \u2192 (px,py,action)\n      q = deque([start])\n      visited[start] = True\n\n      # direction vectors and corresponding action ids\n      moves = [(0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)]\n\n      while q:\n          x, y = q.popleft()\n          if (x, y) == goal:\n              # reconstruct path\n              path = []\n              while (x, y) != start:\n                  px, py, a = prev[(x, y)]\n                  path.append(a)\n                  x, y = px, py\n              return list(reversed(path))\n\n          for dx, dy, a in moves:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not blocked[nx, ny] and not visited[nx, ny]:\n                  visited[nx, ny] = True\n                  prev[(nx, ny)] = (x, y, a)\n                  q.append((nx, ny))\n      raise RuntimeError(\"No path found from {} to {}\".format(start, goal))\n\n  # ----------------------------------------------------------------------\n  # Access the current state (CraftState) \u2013 works for the standard\n  # CraftLab wrapper as well as a raw CraftScenario.\n  # ----------------------------------------------------------------------\n  if hasattr(env, \"_current_state\"):\n      state = env._current_state\n  elif hasattr(env, \"scenario\"):\n      # env may be a raw CraftScenario; initialise a state object.\n      state = env.scenario.init()\n  else:\n      raise AttributeError(\"Unable to locate CraftState inside the env object.\")\n\n  world = env.world\n  grid = state.grid.copy()                 # (W, H, K)\n  inventory = state.inventory.copy()       # length K\n  pos = tuple(state.pos)                   # (x, y)\n\n  # ----------------------------------------------------------------------\n  # Identify the index for the target item \"stick\".\n  # ----------------------------------------------------------------------\n  stick_idx = world.cookbook.index[\"stick\"]\n  # Primitive requirements for one stick (dict {prim_idx: count})\n  primitive_needs = world.cookbook.primitives_for(stick_idx)\n\n  # ----------------------------------------------------------------------\n  # Pre\u2011compute a boolean mask of blocked cells (any non\u2011grabbable entity).\n  # ----------------------------------------------------------------------\n  W, H, K = grid.shape\n  blocked = np.zeros((W, H), dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  actions = []          # final list of action ids to return\n  USE = 4               # action id for USE\n\n  # ----------------------------------------------------------------------\n  # Helper to locate the *nearest* cell that still contains a given primitive.\n  # ----------------------------------------------------------------------\n  def _nearest_primitive(cell_list, cur_pos):\n      best = None\n      best_dist = np.iinfo(np.int32).max\n      for cx, cy in cell_list:\n          if grid[cx, cy, prim_idx] == 0:\n              continue\n          d = abs(cx - cur_pos[0]) + abs(cy - cur_pos[1])\n          if d < best_dist:\n              best_dist = d\n              best = (cx, cy)\n      return best\n\n  # ----------------------------------------------------------------------\n  # Collect all required primitives (respecting required counts).\n  # ----------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      # All cells that currently hold this primitive\n      prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n\n      for _ in range(needed_cnt):\n          target = _nearest_primitive(prim_cells, pos)\n          if target is None:\n              raise RuntimeError(\"Required primitive not found on the map.\")\n\n          # Plan a path to the target cell\n          path = _bfs(pos, target, blocked)\n          actions.extend(path)\n          pos = target\n\n          # Pick it up\n          actions.append(USE)\n          # Update our local copies to reflect the pickup\n          grid[pos[0], pos[1], prim_idx] = 0\n          inventory[prim_idx] += 1\n\n  # ----------------------------------------------------------------------\n  # Determine which workshop is needed for the stick recipe.\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes[stick_idx]\n  workshop_idx = None\n  if \"_at\" in recipe:\n      workshop_idx = recipe[\"_at\"]\n  else:\n      # Fallback: use the first known workshop type\n      if world.workshop_indices:\n          workshop_idx = world.workshop_indices[0]\n      else:\n          raise RuntimeError(\"No workshop information available for stick.\")\n\n  # Locate the nearest workshop cell\n  workshop_cells = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))\n  if not workshop_cells:\n      raise RuntimeError(\"No workshop of the required type found on the map.\")\n\n  nearest_ws = min(workshop_cells,\n                   key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n\n  # Move to the workshop\n  path = _bfs(pos, nearest_ws, blocked)\n  actions.extend(path)\n  pos = nearest_ws\n\n  # Perform the crafting action\n  actions.append(USE)\n\n  # ----------------------------------------------------------------------\n  # Return the computed action sequence.\n  # ----------------------------------------------------------------------\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-10-21T20:10:16.697148", "function_name": "make_stick", "function_body": "  env.reset()\n  world = env.world\n  idx = world.cookbook.index\n  # get stick index\n  try:\n      stick_idx = idx[\"stick\"]\n  except Exception:  # pragma: no cover\n      stick_idx = next(i for i, n in enumerate(idx.ordered_contents) if n.lower() == \"stick\")\n  # primitive requirements\n  needed = world.cookbook.primitives_for(stick_idx)\n  if not needed:\n      needed = {stick_idx: 1}\n  # actions\n  action_map = env.action_specs()\n  DOWN = action_map[\"DOWN\"]\n  UP = action_map[\"UP\"]\n  LEFT = action_map[\"LEFT\"]\n  RIGHT = action_map[\"RIGHT\"]\n  USE = action_map[\"USE\"]\n  # current simulated state\n  state = env._current_state\n  cur_pos = tuple(state.pos)\n  grid = state.grid.copy()\n  # blocked mask\n  non_grabbable = list(world.non_grabbable_indices)\n  if non_grabbable:\n      blocked = np.any(grid[:, :, non_grabbable] > 0, axis=2)\n  else:\n      blocked = np.zeros(grid.shape[:2], dtype=bool)\n  # helper: bfs returning list of actions\n  import collections\n  def bfs(start, goal, blocked_mask):\n      \"\"\"Return list of actions to move from start to goal avoiding blocked cells.\"\"\"\n      if start == goal:\n          return []\n      w, h = blocked_mask.shape\n      queue = collections.deque([start])\n      came = {start: (None, None)}  # node -> (parent, action)\n      while queue:\n          cur = queue.popleft()\n          for act, (dx, dy) in ((DOWN, (1, 0)), (UP, (-1, 0)),\n                                (RIGHT, (0, 1)), (LEFT, (0, -1))):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if not (0 <= nx < w and 0 <= ny < h):\n                  continue\n              if blocked_mask[nx, ny]:\n                  continue\n              nxt = (nx, ny)\n              if nxt in came:\n                  continue\n              came[nxt] = (cur, act)\n              if nxt == goal:\n                  # reconstruct actions\n                  actions_rev = []\n                  node = nxt\n                  while came[node][0] is not None:\n                      parent, a = came[node]\n                      actions_rev.append(a)\n                      node = parent\n                  actions_rev.reverse()\n                  return actions_rev\n              queue.append(nxt)\n      # fallback: direct Manhattan moves (may hit obstacles)\n      x, y = start\n      gx, gy = goal\n      moves = []\n      while x < gx:\n          moves.append(RIGHT); x += 1\n      while x > gx:\n          moves.append(LEFT); x -= 1\n      while y < gy:\n          moves.append(DOWN); y += 1\n      while y > gy:\n          moves.append(UP); y -= 1\n      return moves\n  actions = []\n  # 1. collect primitives\n  for item_idx, cnt in needed.items():\n      cnt = int(cnt)\n      while cnt > 0:\n          locations = np.argwhere(grid[:, :, item_idx] > 0)\n          if locations.size == 0:\n              # cannot find more of this primitive\n              break\n          # choose closest by Manhattan distance\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          target = tuple(locations[dists.argmin()])\n          # move to target\n          path = bfs(cur_pos, target, blocked)\n          actions.extend(path)\n          cur_pos = target\n          # pick up\n          actions.append(USE)\n          cnt -= 1\n          # update grid and blocked mask\n          grid[target[0], target[1], item_idx] -= 1\n          if non_grabbable:\n              blocked[target[0], target[1]] = np.any(\n                  grid[target[0], target[1], non_grabbable] > 0\n              )\n          else:\n              blocked[target[0], target[1]] = False\n  # 2. go to workshop if needed and craft\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = idx[workshop_name]\n      ws_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_locs.size:\n          ws_target = tuple(ws_locs[0])\n          path = bfs(cur_pos, ws_target, blocked)\n          actions.extend(path)\n          cur_pos = ws_target\n          actions.append(USE)\n  return actions", "env_interactions": 4, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T20:10:17.815845", "function_name": "make_stick", "function_body": "  env.reset()\n  world = env.world\n  idx = world.cookbook.index\n\n  # locate stick index\n  try:\n      stick_idx = idx[\"stick\"]\n  except Exception:  # pragma: no cover\n      stick_idx = next(i for i, n in enumerate(idx.ordered_contents) if n.lower() == \"stick\")\n\n  # primitive requirements (fallback to stick itself if primitive)\n  needed = world.cookbook.primitives_for(stick_idx)\n  if not needed:\n      needed = {stick_idx: 1}\n\n  # action ids\n  action_map = env.action_specs()\n  DOWN = action_map[\"DOWN\"]\n  UP = action_map[\"UP\"]\n  LEFT = action_map[\"LEFT\"]\n  RIGHT = action_map[\"RIGHT\"]\n  USE = action_map[\"USE\"]\n\n  # current simulated state\n  state = env._current_state\n  cur_pos = tuple(state.pos)\n  grid = state.grid.copy()\n\n  # blocked cells mask (non\u2011grabbable entities)\n  nong = list(world.non_grabbable_indices)\n  if nong:\n      blocked = np.any(grid[:, :, nong] > 0, axis=2)\n  else:\n      blocked = np.zeros(grid.shape[:2], dtype=bool)\n\n  # ------------------------------------------------------------------\n  # Helper functions\n  # ------------------------------------------------------------------\n  def delta_to_action(dx, dy):\n      if dx == 1:\n          return RIGHT\n      if dx == -1:\n          return LEFT\n      if dy == 1:\n          return DOWN\n      if dy == -1:\n          return UP\n      raise ValueError(\"Invalid delta\")\n\n  def manhattan_path(start, goal):\n      \"\"\"Fallback Manhattan moves (ignores obstacles).\"\"\"\n      x, y = start\n      gx, gy = goal\n      moves = []\n      while x < gx:\n          moves.append(RIGHT)\n          x += 1\n      while x > gx:\n          moves.append(LEFT)\n          x -= 1\n      while y < gy:\n          moves.append(DOWN)\n          y += 1\n      while y > gy:\n          moves.append(UP)\n          y -= 1\n      return moves\n\n  def bfs_to_target(start, target_set, blocked_mask):\n      \"\"\"Shortest path (as list of actions) from start to any cell in target_set.\"\"\"\n      if start in target_set:\n          return []\n      q = collections.deque([start])\n      came = {start: (None, None)}  # node -> (parent, action)\n      while q:\n          x, y = q.popleft()\n          for act, (dx, dy) in ((RIGHT, (1, 0)), (LEFT, (-1, 0)),\n                                 (DOWN, (0, 1)), (UP, (0, -1))):\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < blocked_mask.shape[0] and 0 <= ny < blocked_mask.shape[1]):\n                  continue\n              if blocked_mask[nx, ny]:\n                  continue\n              nxt = (nx, ny)\n              if nxt in came:\n                  continue\n              came[nxt] = ((x, y), act)\n              if nxt in target_set:\n                  # reconstruct action list\n                  actions = []\n                  node = nxt\n                  while came[node][0] is not None:\n                      parent, a = came[node]\n                      actions.append(a)\n                      node = parent\n                  actions.reverse()\n                  return actions\n              q.append(nxt)\n      # If BFS fails, fall back to Manhattan moves toward an arbitrary target\n      tx, ty = next(iter(target_set))\n      return manhattan_path(start, (tx, ty))\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # 1. Collect required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      need = int(cnt)\n      while need > 0:\n          locations = np.argwhere(grid[:, :, prim_idx] > 0)\n          if locations.size == 0:\n              # primitive not present any more; abort collection for safety\n              break\n          target_set = {tuple(loc) for loc in locations.tolist()}\n          path = bfs_to_target(cur_pos, target_set, blocked)\n          actions.extend(path)\n          if path:\n              cur_pos = path[-1] if len(path) == 0 else (\n                  cur_pos[0] + sum(1 if a == RIGHT else -1 if a == LEFT else 0 for a in path),\n                  cur_pos[1] + sum(1 if a == DOWN else -1 if a == UP else 0 for a in path)\n              )\n          # pick up the primitive\n          actions.append(USE)\n          # update simulated grid and blocked mask\n          grid[cur_pos[0], cur_pos[1], prim_idx] -= 1\n          if nong:\n              blocked[cur_pos[0], cur_pos[1]] = np.any(\n                  grid[cur_pos[0], cur_pos[1], nong] > 0\n              )\n          need -= 1\n\n  # ------------------------------------------------------------------\n  # 2. Go to workshop (if required) and craft the stick\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      ws_idx = idx[workshop_name]\n      ws_locs = np.argwhere(grid[:, :, ws_idx] > 0)\n      if ws_locs.size:\n          ws_target = tuple(ws_locs[0])\n          path = bfs_to_target(cur_pos, {ws_target}, blocked)\n          actions.extend(path)\n          if path:\n              cur_pos = ws_target\n          actions.append(USE)   # craft at workshop\n\n  return actions", "env_interactions": 4, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T20:15:33.102277", "function_name": "make_stick", "function_body": "  # Reset the environment to start a fresh episode\n  env.reset()\n\n  # Helper shortcuts to world and cookbook\n  world = env.world\n  cookbook = world.cookbook\n\n  # Index of the target item (\"stick\") and its recipe\n  stick_idx = cookbook.index[\"stick\"]\n  stick_recipe = cookbook.recipes[stick_idx]\n\n  # Primitive requirements for a single stick\n  primitive_needs = cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n\n  # Workshop index where a stick must be crafted\n  workshop_idx = stick_recipe[\"_at\"]\n\n  # Mapping from action name to integer code\n  action_map = env.action_specs()          # e.g. {\"DOWN\":0, \"UP\":1, \"LEFT\":2, \"RIGHT\":3, \"USE\":4}\n  ACTION_USE = action_map[\"USE\"]\n  ACTION_DOWN = action_map[\"DOWN\"]\n  ACTION_UP = action_map[\"UP\"]\n  ACTION_LEFT = action_map[\"LEFT\"]\n  ACTION_RIGHT = action_map[\"RIGHT\"]\n\n  actions = []  # the sequence we will return\n\n  # -------------------------------------------------------------------------\n  # Utility functions operating on the current CraftState\n  # -------------------------------------------------------------------------\n  def cur_state():\n      \"\"\"Current CraftState (private attribute of CraftLab).\"\"\"\n      return env._current_state\n\n  def locate(kind_idx):\n      \"\"\"Return the (row, col) of the first cell that contains the given kind,\n      or None if not present.\"\"\"\n      grid = cur_state().grid\n      positions = np.argwhere(grid[:, :, kind_idx] > 0)\n      if positions.shape[0] == 0:\n          return None\n      return tuple(positions[0].tolist())\n\n  def move_one_step_towards(target):\n      \"\"\"Take a single step (and record the action) towards the target cell.\"\"\"\n      r, c = cur_state().pos\n      tr, tc = target\n      if r < tr:\n          act = ACTION_DOWN\n          new_pos = (r + 1, c)\n      elif r > tr:\n          act = ACTION_UP\n          new_pos = (r - 1, c)\n      elif c < tc:\n          act = ACTION_RIGHT\n          new_pos = (r, c + 1)\n      else:  # c > tc\n          act = ACTION_LEFT\n          new_pos = (r, c - 1)\n\n      actions.append(act)\n      env.step(act)          # advance the environment\n      return new_pos\n\n  def move_to(cell):\n      \"\"\"Move (using Manhattan steps) until the agent stands on *cell*.\"\"\"\n      while cur_state().pos != cell:\n          move_one_step_towards(cell)\n\n  def adjacent(cell):\n      \"\"\"Return a cell that is orthogonally adjacent to *cell* and inside the grid.\"\"\"\n      rows, cols, _ = cur_state().grid.shape\n      r, c = cell\n      for dr, dc in [(0, 1), (0, -1), (1, 0), (-1, 0)]:\n          nr, nc = r + dr, c + dc\n          if 0 <= nr < rows and 0 <= nc < cols:\n              return (nr, nc)\n      return None\n\n  # -------------------------------------------------------------------------\n  # 1. Collect all required primitive items\n  # -------------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          # locate the primitive on the map (may disappear after previous pickups)\n          prim_loc = locate(prim_idx)\n          if prim_loc is None:\n              # Primitive not found \u2013 give up early\n              return actions\n\n          # Move next to the primitive (we need to be adjacent to use it)\n          adj = adjacent(prim_loc)\n          if adj is None:\n              return actions\n          move_to(adj)\n\n          # Use the primitive (collect it)\n          actions.append(ACTION_USE)\n          env.step(ACTION_USE)\n\n  # -------------------------------------------------------------------------\n  # 2. Go to the appropriate workshop and craft the stick\n  # -------------------------------------------------------------------------\n  workshop_loc = locate(workshop_idx)\n  if workshop_loc is not None:\n      # Move adjacent to the workshop (crafting works from any neighboring cell)\n      adj_ws = adjacent(workshop_loc)\n      if adj_ws is not None:\n          move_to(adj_ws)\n\n          # Perform the crafting action\n          actions.append(ACTION_USE)\n          env.step(ACTION_USE)\n\n  # Return the complete action list\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": -1}}
