{"timestamp": "2025-10-21T19:45:06.446916", "function_name": "make_stick", "function_body": "  actions = []\n  world = env.world\n  state = env._current_state\n\n  # action indices (as used in CraftWorld)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  def move_action(frm, to):\n      dx = to[0] - frm[0]\n      dy = to[1] - frm[1]\n      if dx == 1:\n          return RIGHT\n      if dx == -1:\n          return LEFT\n      if dy == 1:\n          return DOWN\n      if dy == -1:\n          return UP\n      raise ValueError(\"non\u2011adjacent move\")\n\n  # BFS that returns a path (list of positions) from start to a cell that is\n  # orthogonal to any target cell, together with the chosen target cell.\n  def bfs_to_adjacent(start, target_cells, grid):\n      W, H, _ = grid.shape\n      visited = np.full((W, H), False, dtype=bool)\n      q = collections.deque()\n      q.append((start, [start]))\n      visited[start] = True\n      targets = {tuple(t) for t in target_cells}\n      while q:\n          (x, y), path = q.popleft()\n          # check adjacency\n          for tx, ty in targets:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path, (tx, ty)\n          # expand neighbours\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if grid[nx, ny, :].sum() == 0:  # empty cell\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [(nx, ny)]))\n      raise RuntimeError(\"no reachable adjacent cell\")\n\n  # Produce extra moves so that the agent ends up facing `target` from `cur`\n  # and then issues a USE action.\n  def face_and_use(cur, target):\n      cx, cy = cur\n      tx, ty = target\n      dx, dy = tx - cx, ty - cy\n      if abs(dx) + abs(dy) != 1:\n          raise ValueError(\"target not orthogonal\")\n      # cell opposite target relative to agent\n      opp = (cx - dx, cy - dy)\n      W, H, _ = state.grid.shape\n\n      def empty(cell):\n          x, y = cell\n          return 0 <= x < W and 0 <= y < H and state.grid[x, y, :].sum() == 0\n\n      extra = []\n      if empty(opp):\n          extra.append(move_action((cx, cy), opp))\n          extra.append(move_action(opp, (cx, cy)))\n      else:\n          # try any other neighbouring empty cell\n          for ndx, ndy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nb = (cx + ndx, cy + ndy)\n              if empty(nb):\n                  extra.append(move_action((cx, cy), nb))\n                  extra.append(move_action(nb, (cx, cy)))\n                  break\n      extra.append(USE)\n      return extra\n\n  # -----------------------------------------------------------------\n  # 1) Gather primitives required for a stick\n  # -----------------------------------------------------------------\n  stick_idx = world.cookbook.index[\"stick\"]\n  if state.inventory[stick_idx] > 0:\n      return actions\n\n  primitives_needed = world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n  cur_pos = tuple(state.pos)\n\n  for prim_idx, count in primitives_needed.items():\n      for _ in range(count):\n          # skip if already in inventory (could happen after previous loops)\n          if state.inventory[prim_idx] > 0:\n              continue\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(f\"primitive {prim_idx} not found on map\")\n          path, target = bfs_to_adjacent(cur_pos, prim_cells, state.grid)\n          # move along the path (skip the first cell which is current position)\n          for nxt in path[1:]:\n              actions.append(move_action(cur_pos, nxt))\n              cur_pos = nxt\n          # face the primitive and use\n          actions.extend(face_and_use(cur_pos, target))\n          # simulate pickup for subsequent planning\n          state.grid[target[0], target[1], prim_idx] = 0\n          state.inventory[prim_idx] += 1\n\n  # -----------------------------------------------------------------\n  # 2) Craft the stick at its workshop (if any)\n  # -----------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          raise RuntimeError(\"workshop for stick not present\")\n      path, target = bfs_to_adjacent(cur_pos, workshop_cells, state.grid)\n      for nxt in path[1:]:\n          actions.append(move_action(cur_pos, nxt))\n          cur_pos = nxt\n      actions.extend(face_and_use(cur_pos, target))\n  else:\n      # no specific workshop \u2013 just use at current location\n      actions.append(USE)\n\n  return actions", "env_interactions": 7, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T19:45:36.380933", "function_name": "make_stick", "function_body": "  # ----- basic setup -------------------------------------------------------\n  action_map = env.action_specs()\n  DOWN = action_map.get(\"DOWN\", 0)\n  UP = action_map.get(\"UP\", 1)\n  LEFT = action_map.get(\"LEFT\", 2)\n  RIGHT = action_map.get(\"RIGHT\", 3)\n  USE = action_map.get(\"USE\", 4)\n\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      return []\n\n  world = getattr(env, \"world\", None)\n  if world is None:\n      return []\n\n  cookbook = getattr(world, \"cookbook\", None)\n  if cookbook is None:\n      return []\n\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []\n\n  grid = getattr(state, \"grid\", None)\n  cur_pos = getattr(state, \"pos\", None)\n  if grid is None or cur_pos is None:\n      return []\n\n  H, W = grid.shape[0], grid.shape[1]\n\n  # ----- movement helpers ---------------------------------------------------\n  DIRS = [\n      (1, 0, DOWN),   # down\n      (-1, 0, UP),    # up\n      (0, -1, LEFT),  # left\n      (0, 1, RIGHT),  # right\n  ]\n\n  def in_bounds(p):\n      return 0 <= p[0] < H and 0 <= p[1] < W\n\n  non_grabbable = set(world.non_grabbable_indices)\n\n  def walkable(p):\n      if not in_bounds(p):\n          return False\n      # a cell is blocked if any non\u2011grabbable entity occupies it\n      for idx in non_grabbable:\n          if grid[p[0], p[1], idx] > 0:\n              return False\n      return True\n\n  from collections import deque\n\n  def bfs_path(start, targets):\n      \"\"\"Return a list of actions that moves from `start` to the nearest\n      cell in `targets`.  If none reachable, return None.\"\"\"\n      target_set = set(targets)\n      if start in target_set:\n          return []\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          cur, path = q.popleft()\n          for dx, dy, act in DIRS:\n              nxt = (cur[0] + dx, cur[1] + dy)\n              if not in_bounds(nxt) or not walkable(nxt):\n                  continue\n              if nxt in visited:\n                  continue\n              new_path = path + [act]\n              if nxt in target_set:\n                  return new_path\n              visited.add(nxt)\n              q.append((nxt, new_path))\n      return None\n\n  # ----- determine what we need to collect ---------------------------------\n  primitives_needed = cookbook.primitives_for(goal_idx)\n  if not primitives_needed:\n      # goal itself is a primitive we must pick up\n      primitives_needed = {goal_idx: 1}\n      recipe_exists = False\n  else:\n      recipe_exists = True\n\n  actions = []\n\n  # ----- collect required primitives ---------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      collected = 0\n      while collected < needed_cnt:\n          # locate all cells containing this primitive\n          locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not locations:\n              # cannot find required primitive \u2013 abort\n              return []\n          path = bfs_path(cur_pos, locations)\n          if path is None:\n              return []  # unreachable primitive\n          actions.extend(path)\n          # move our internal position to the chosen target (the first in locations)\n          cur_pos = locations[0]\n          # pick it up\n          actions.append(USE)\n          collected += 1\n          # update internal grid copy to reflect removal\n          grid[cur_pos[0], cur_pos[1], prim_idx] = 0\n\n  # ----- craft at the appropriate workshop ---------------------------------\n  if recipe_exists:\n      recipe = cookbook.recipes.get(goal_idx, {})\n      workshop_kind = recipe.get(\"_at\", None)\n      if workshop_kind is not None:\n          ws_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n          if not ws_cells:\n              return []  # no workshop present\n          path = bfs_path(cur_pos, ws_cells)\n          if path is None:\n              return []  # unreachable workshop\n          actions.extend(path)\n          cur_pos = ws_cells[0]\n          actions.append(USE)   # craft\n      else:\n          # no specific workshop required\n          actions.append(USE)\n\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T19:45:37.514512", "function_name": "make_stick", "function_body": "  # Map action names to indices\n  action_map = env.action_specs()\n  DOWN = action_map.get(\"DOWN\", 0)\n  UP = action_map.get(\"UP\", 1)\n  LEFT = action_map.get(\"LEFT\", 2)\n  RIGHT = action_map.get(\"RIGHT\", 3)\n  USE = action_map.get(\"USE\", 4)\n\n  # Goal item index\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      return []\n\n  # Access world, cookbook and current state\n  world = getattr(env, \"world\", None)\n  if world is None:\n      return []\n  cookbook = getattr(world, \"cookbook\", None)\n  if cookbook is None:\n      return []\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []\n\n  grid = getattr(state, \"grid\", None)\n  cur_pos = getattr(state, \"pos\", None)\n  if grid is None or cur_pos is None:\n      return []\n\n  H, W = grid.shape[0], grid.shape[1]\n\n  # -----------------------------------------------------------------\n  # Navigation helpers (BFS over walkable cells)\n  # -----------------------------------------------------------------\n  DIRS = [\n      (1, 0, DOWN),   # down\n      (-1, 0, UP),    # up\n      (0, -1, LEFT),  # left\n      (0, 1, RIGHT),  # right\n  ]\n\n  def in_bounds(p):\n      r, c = p\n      return 0 <= r < H and 0 <= c < W\n\n  non_grabbable = set(world.non_grabbable_indices)\n\n  def walkable(p):\n      \"\"\"A cell is walkable if it is inside the grid and does not contain a non\u2011grabbable entity.\"\"\"\n      if not in_bounds(p):\n          return False\n      r, c = p\n      for idx in non_grabbable:\n          if grid[r, c, idx] > 0:\n              return False\n      return True\n\n  from collections import deque\n\n  def bfs_path(start, targets):\n      \"\"\"Return a list of actions moving from `start` to the nearest cell in `targets`.\n      If none reachable, return None.\"\"\"\n      target_set = set(targets)\n      if start in target_set:\n          return []\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          cur, path = q.popleft()\n          for dr, dc, act in DIRS:\n              nxt = (cur[0] + dr, cur[1] + dc)\n              if not walkable(nxt):\n                  continue\n              if nxt in visited:\n                  continue\n              new_path = path + [act]\n              if nxt in target_set:\n                  return new_path\n              visited.add(nxt)\n              q.append((nxt, new_path))\n      return None\n\n  # -----------------------------------------------------------------\n  # Determine required primitives for the goal\n  # -----------------------------------------------------------------\n  primitives_needed = cookbook.primitives_for(goal_idx)\n  if not primitives_needed:\n      # Goal itself is a primitive; just pick it up\n      primitives_needed = {goal_idx: 1}\n      has_recipe = False\n  else:\n      has_recipe = True\n\n  actions = []\n\n  # -----------------------------------------------------------------\n  # Collect each primitive in the required quantity\n  # -----------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      collected = 0\n      while collected < needed_cnt:\n          # Find all cells that currently contain this primitive\n          locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not locations:\n              return []  # primitive not present\n          path = bfs_path(cur_pos, locations)\n          if path is None:\n              return []  # unreachable\n          actions.extend(path)\n          cur_pos = locations[0]  # assume path leads to the first reachable target\n          actions.append(USE)    # pick up\n          collected += 1\n          # Simulate removal from our copy of the grid\n          grid[cur_pos[0], cur_pos[1], prim_idx] = 0\n\n  # -----------------------------------------------------------------\n  # Craft at the appropriate workshop if needed\n  # -----------------------------------------------------------------\n  if has_recipe:\n      recipe = cookbook.recipes.get(goal_idx, {})\n      workshop_kind = recipe.get(\"_at\", None)\n      if workshop_kind is not None:\n          ws_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n          if not ws_cells:\n              return []  # no workshop on map\n          path = bfs_path(cur_pos, ws_cells)\n          if path is None:\n              return []  # unreachable workshop\n          actions.extend(path)\n          cur_pos = ws_cells[0]\n          actions.append(USE)   # craft\n      else:\n          actions.append(USE)   # craft at current location\n\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T19:46:09.084319", "function_name": "make_stick", "function_body": "  env.reset()\n  world = env.world\n  idx = world.cookbook.index\n\n  # action indices\n  act_map = env.action_specs()\n  DOWN = act_map[\"DOWN\"]\n  UP = act_map[\"UP\"]\n  LEFT = act_map[\"LEFT\"]\n  RIGHT = act_map[\"RIGHT\"]\n  USE = act_map[\"USE\"]\n\n  # target item index\n  stick_idx = idx[\"stick\"]\n\n  # primitives needed (may be empty)\n  needed = world.cookbook.primitives_for(stick_idx)\n  if not needed:\n      needed = {stick_idx: 1}\n\n  # current simulated state\n  state = env._current_state\n  cur_pos = tuple(state.pos)\n  grid = state.grid.copy()\n\n  # blocked cells (non\u2011grabbable entities)\n  non_grab = list(world.non_grabbable_indices)\n  if non_grab:\n      blocked = np.any(grid[:, :, non_grab] > 0, axis=2)\n  else:\n      blocked = np.zeros(grid.shape[:2], dtype=bool)\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions to reach any target cell\n  # while staying on walkable tiles. Falls back to Manhattan moves.\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  def bfs_path(start, targets, blocked_mask):\n      if start in targets:\n          return []\n      q = deque([start])\n      visited = {start: (None, None)}  # pos -> (parent, action)\n      while q:\n          cur = q.popleft()\n          for act, (dx, dy) in (\n              (DOWN, (0, 1)),\n              (UP, (0, -1)),\n              (LEFT, (-1, 0)),\n              (RIGHT, (1, 0)),\n          ):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if not (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]):\n                  continue\n              if blocked_mask[nx, ny]:\n                  continue\n              nxt = (nx, ny)\n              if nxt in visited:\n                  continue\n              visited[nxt] = (cur, act)\n              if nxt in targets:\n                  # reconstruct\n                  path = []\n                  node = nxt\n                  while visited[node][0] is not None:\n                      parent, a = visited[node]\n                      path.append(a)\n                      node = parent\n                  return list(reversed(path))\n              q.append(nxt)\n\n      # fallback Manhattan\n      target = next(iter(targets))\n      x, y = start\n      tx, ty = target\n      path = []\n      while x < tx:\n          path.append(RIGHT); x += 1\n      while x > tx:\n          path.append(LEFT); x -= 1\n      while y < ty:\n          path.append(DOWN); y += 1\n      while y > ty:\n          path.append(UP); y -= 1\n      return path\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives (or the stick itself)\n  # ------------------------------------------------------------------\n  for item_idx, cnt in needed.items():\n      remaining = int(cnt)\n      while remaining > 0:\n          locs = np.argwhere(grid[:, :, item_idx] > 0)\n          if locs.size == 0:\n              break  # nothing left\n          # choose nearest by Manhattan distance\n          dists = np.abs(locs[:, 0] - cur_pos[0]) + np.abs(locs[:, 1] - cur_pos[1])\n          target = tuple(locs[dists.argmin()])\n          actions.extend(bfs_path(cur_pos, {target}, blocked))\n          cur_pos = target\n          actions.append(USE)\n          remaining -= 1\n          # update simulated grid and blocked mask\n          grid[target[0], target[1], item_idx] -= 1\n          if non_grab:\n              blocked[target[0], target[1]] = np.any(\n                  grid[target[0], target[1], non_grab] > 0\n              )\n\n  # ------------------------------------------------------------------\n  # 2. Move to workshop (if required) and craft the stick\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  ws_name = recipe.get(\"_at\")\n  if ws_name is not None:\n      ws_idx = idx[ws_name]\n      ws_locs = np.argwhere(grid[:, :, ws_idx] > 0)\n      if ws_locs.size:\n          ws_target = tuple(ws_locs[0])\n          actions.extend(bfs_path(cur_pos, {ws_target}, blocked))\n          cur_pos = ws_target\n          actions.append(USE)  # craft\n\n  return actions", "env_interactions": 4, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T19:46:10.175165", "function_name": "make_stick", "function_body": "  env.reset()\n  world = env.world\n  idx = world.cookbook.index\n\n  # Action indices\n  action_map = env.action_specs()\n  DOWN = action_map[\"DOWN\"]\n  UP = action_map[\"UP\"]\n  LEFT = action_map[\"LEFT\"]\n  RIGHT = action_map[\"RIGHT\"]\n  USE = action_map[\"USE\"]\n\n  # Index of the target item \"stick\"\n  try:\n      stick_idx = idx[\"stick\"]\n  except Exception:  # fallback case\u2011insensitive\n      stick_idx = next(i for i, n in enumerate(idx.ordered_contents) if n.lower() == \"stick\")\n\n  # Primitives required to craft a stick (or the stick itself if primitive)\n  needed = world.cookbook.primitives_for(stick_idx)\n  if not needed:\n      needed = {stick_idx: 1}\n\n  # Current state information\n  state = env._current_state\n  cur_pos = tuple(state.pos)               # (x, y)\n  grid = state.grid.copy()                 # mutable copy for bookkeeping\n\n  # Cells that cannot be walked through (non\u2011grabbable entities)\n  non_grab = list(world.non_grabbable_indices)\n  if non_grab:\n      blocked = np.any(grid[:, :, non_grab] > 0, axis=2)\n  else:\n      blocked = np.zeros(grid.shape[:2], dtype=bool)\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions to reach any cell in *targets*\n  # while avoiding blocked cells. Falls back to Manhattan moves if no path.\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  def bfs_path(start, targets):\n      if start in targets:\n          return []\n      q = deque([start])\n      visited = {start: (None, None)}  # pos -> (parent, action)\n      while q:\n          cur = q.popleft()\n          for act, (dx, dy) in (\n              (DOWN, (0, 1)),\n              (UP, (0, -1)),\n              (LEFT, (-1, 0)),\n              (RIGHT, (1, 0)),\n          ):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if not (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]):\n                  continue\n              if blocked[nx, ny]:\n                  continue\n              nxt = (nx, ny)\n              if nxt in visited:\n                  continue\n              visited[nxt] = (cur, act)\n              if nxt in targets:\n                  # reconstruct path\n                  path = []\n                  node = nxt\n                  while visited[node][0] is not None:\n                      parent, a = visited[node]\n                      path.append(a)\n                      node = parent\n                  return list(reversed(path))\n              q.append(nxt)\n\n      # No walkable path found \u2013 use simple Manhattan moves (ignores obstacles)\n      tx, ty = next(iter(targets))\n      x, y = start\n      path = []\n      while x < tx:\n          path.append(RIGHT); x += 1\n      while x > tx:\n          path.append(LEFT); x -= 1\n      while y < ty:\n          path.append(DOWN); y += 1\n      while y > ty:\n          path.append(UP); y -= 1\n      return path\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives (or the stick itself if primitive)\n  # ------------------------------------------------------------------\n  for item_idx, count in needed.items():\n      for _ in range(int(count)):\n          locations = np.argwhere(grid[:, :, item_idx] > 0)\n          if locations.size == 0:\n              # No more of this item on the map \u2013 abort collection\n              break\n          # Choose the nearest occurrence (Manhattan distance)\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          target = tuple(locations[dists.argmin()])\n\n          # Move to the target cell\n          actions.extend(bfs_path(cur_pos, {target}))\n          cur_pos = target\n\n          # Pick up the item\n          actions.append(USE)\n\n          # Update simulated grid and blocked mask\n          grid[target[0], target[1], item_idx] -= 1\n          if non_grab:\n              blocked[target[0], target[1]] = np.any(\n                  grid[target[0], target[1], non_grab] > 0\n              )\n\n  # ------------------------------------------------------------------\n  # 2. If a workshop is required for the stick, move there and craft\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = idx[workshop_name]\n      ws_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_locs.size:\n          ws_target = tuple(ws_locs[0])\n          actions.extend(bfs_path(cur_pos, {ws_target}))\n          cur_pos = ws_target\n          actions.append(USE)  # craft at the workshop\n\n  return actions", "env_interactions": 4, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T19:46:35.124662", "function_name": "make_stick", "function_body": "  env.reset()\n  world = env.world\n  idx = world.cookbook.index\n\n  try:\n      stick_idx = idx[\"stick\"]\n  except Exception:\n      stick_idx = next(i for i, n in enumerate(idx.ordered_contents) if n.lower() == \"stick\")\n  stick_recipe = world.cookbook.recipes.get(stick_idx, {})\n\n  needed = world.cookbook.primitives_for(stick_idx)\n  if not needed:\n      needed = {stick_idx: 1}\n\n  action_map = env.action_specs()\n  DOWN = action_map[\"DOWN\"]\n  UP = action_map[\"UP\"]\n  LEFT = action_map[\"LEFT\"]\n  RIGHT = action_map[\"RIGHT\"]\n  USE = action_map[\"USE\"]\n\n  state = env._current_state\n  cur_pos = tuple(state.pos)\n  grid = state.grid.copy()\n\n  non_grabbable = list(world.non_grabbable_indices)\n  if non_grabbable:\n      blocked = np.any(grid[:, :, non_grabbable] > 0, axis=2)\n  else:\n      blocked = np.zeros(grid.shape[:2], dtype=bool)\n\n  import collections\n\n  def bfs_path(start, targets, blocked_mask):\n      if start in targets:\n          return []\n      q = collections.deque([start])\n      visited = {start: (None, None)}\n      while q:\n          cur = q.popleft()\n          for act, (dx, dy) in ((DOWN, (0, 1)), (UP, (0, -1)),\n                                (LEFT, (-1, 0)), (RIGHT, (1, 0))):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if not (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]):\n                  continue\n              if blocked_mask[nx, ny]:\n                  continue\n              nxt = (nx, ny)\n              if nxt in visited:\n                  continue\n              visited[nxt] = (cur, act)\n              if nxt in targets:\n                  path = []\n                  node = nxt\n                  while visited[node][0] is not None:\n                      parent, a = visited[node]\n                      path.append(a)\n                      node = parent\n                  return list(reversed(path))\n              q.append(nxt)\n      tx, ty = next(iter(targets))\n      return manhattan_moves(start, (tx, ty))\n\n  def manhattan_moves(start, goal):\n      x, y = start\n      gx, gy = goal\n      moves = []\n      while x < gx:\n          moves.append(RIGHT)\n          x += 1\n      while x > gx:\n          moves.append(LEFT)\n          x -= 1\n      while y < gy:\n          moves.append(DOWN)\n          y += 1\n      while y > gy:\n          moves.append(UP)\n          y -= 1\n      return moves\n\n  actions = []\n\n  for item_idx, total_needed in needed.items():\n      total_needed = int(total_needed)\n      while total_needed > 0:\n          locations = np.argwhere(grid[:, :, item_idx] > 0)\n          if locations.size == 0:\n              break\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          target = tuple(locations[dists.argmin()])\n\n          path = bfs_path(cur_pos, {target}, blocked)\n          actions.extend(path)\n          cur_pos = target\n\n          actions.append(USE)\n          total_needed -= 1\n\n          grid[target[0], target[1], item_idx] -= 1\n          if grid[target[0], target[1], item_idx] == 0:\n              if non_grabbable:\n                  blocked[target[0], target[1]] = np.any(\n                      grid[target[0], target[1], non_grabbable] > 0\n                  )\n              else:\n                  blocked[target[0], target[1]] = False\n\n  workshop_name = stick_recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = idx[workshop_name]\n      ws_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_locs.size > 0:\n          ws_target = tuple(ws_locs[0])\n          path = bfs_path(cur_pos, {ws_target}, blocked)\n          actions.extend(path)\n          cur_pos = ws_target\n          actions.append(USE)\n\n  return actions", "env_interactions": 4, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T19:46:36.399084", "function_name": "make_stick", "function_body": "  env.reset()\n  world = env.world\n  idx = world.cookbook.index\n\n  # Identify the stick index and its recipe\n  try:\n      stick_idx = idx[\"stick\"]\n  except Exception:  # pragma: no cover\n      stick_idx = next(i for i, n in enumerate(idx.ordered_contents) if n.lower() == \"stick\")\n  stick_recipe = world.cookbook.recipes.get(stick_idx, {})\n\n  # Determine required primitives (default to stick itself if primitive)\n  needed = world.cookbook.primitives_for(stick_idx)\n  if not needed:\n      needed = {stick_idx: 1}\n\n  # Action mapping\n  action_map = env.action_specs()\n  DOWN = action_map[\"DOWN\"]\n  UP = action_map[\"UP\"]\n  LEFT = action_map[\"LEFT\"]\n  RIGHT = action_map[\"RIGHT\"]\n  USE = action_map[\"USE\"]\n\n  # Current state snapshot for planning\n  state = env._current_state\n  cur_pos = tuple(state.pos)               # (x, y)\n  grid = state.grid.copy()                 # mutable copy of the world grid\n\n  # Cells occupied by non\u2011grabbable entities block movement\n  non_grabbable = list(world.non_grabbable_indices)\n  if non_grabbable:\n      blocked = np.any(grid[:, :, non_grabbable] > 0, axis=2)\n  else:\n      blocked = np.zeros(grid.shape[:2], dtype=bool)\n\n  # ------------------------------------------------------------------\n  # Helper functions\n  # ------------------------------------------------------------------\n  import collections\n\n  def manhattan_moves(start, goal):\n      \"\"\"Return a list of actions moving Manhattan\u2011style from start to goal.\"\"\"\n      x, y = start\n      gx, gy = goal\n      moves = []\n      while x < gx:\n          moves.append(RIGHT)\n          x += 1\n      while x > gx:\n          moves.append(LEFT)\n          x -= 1\n      while y < gy:\n          moves.append(DOWN)\n          y += 1\n      while y > gy:\n          moves.append(UP)\n          y -= 1\n      return moves\n\n  def bfs_path(start, targets, blocked_mask):\n      \"\"\"Shortest path (by BFS) from start to any cell in targets.\"\"\"\n      if start in targets:\n          return []\n      q = collections.deque([start])\n      visited = {start: (None, None)}   # node -> (parent, action)\n      while q:\n          cur = q.popleft()\n          for act, (dx, dy) in ((DOWN, (0, 1)), (UP, (0, -1)),\n                                (LEFT, (-1, 0)), (RIGHT, (1, 0))):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if not (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]):\n                  continue\n              if blocked_mask[nx, ny]:\n                  continue\n              nxt = (nx, ny)\n              if nxt in visited:\n                  continue\n              visited[nxt] = (cur, act)\n              if nxt in targets:\n                  # reconstruct path\n                  path = []\n                  node = nxt\n                  while visited[node][0] is not None:\n                      parent, a = visited[node]\n                      path.append(a)\n                      node = parent\n                  return list(reversed(path))\n              q.append(nxt)\n      # Fallback: Manhattan moves ignoring obstacles\n      tx, ty = next(iter(targets))\n      return manhattan_moves(start, (tx, ty))\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # 1. Collect required primitives\n  # ------------------------------------------------------------------\n  for item_idx, count_needed in needed.items():\n      count_needed = int(count_needed)\n      while count_needed > 0:\n          # Find all cells that currently contain the needed item\n          locations = np.argwhere(grid[:, :, item_idx] > 0)\n          if locations.size == 0:\n              # No more of this primitive on the map; break to avoid infinite loop\n              break\n          # Choose the closest location (Manhattan distance heuristic)\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          target = tuple(locations[dists.argmin()])\n\n          # Move to the target respecting obstacles\n          path = bfs_path(cur_pos, {target}, blocked)\n          actions.extend(path)\n          cur_pos = target\n\n          # Pick up the primitive\n          actions.append(USE)\n          count_needed -= 1\n\n          # Update simulated grid and blocked mask\n          grid[target[0], target[1], item_idx] -= 1\n          if grid[target[0], target[1], item_idx] == 0:\n              if non_grabbable:\n                  blocked[target[0], target[1]] = np.any(\n                      grid[target[0], target[1], non_grabbable] > 0\n                  )\n              else:\n                  blocked[target[0], target[1]] = False\n\n  # ------------------------------------------------------------------\n  # 2. Go to workshop (if required) and craft the stick\n  # ------------------------------------------------------------------\n  workshop_name = stick_recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = idx[workshop_name]\n      ws_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_locs.size > 0:\n          ws_target = tuple(ws_locs[0])\n          path = bfs_path(cur_pos, {ws_target}, blocked)\n          actions.extend(path)\n          cur_pos = ws_target\n          actions.append(USE)   # craft at the workshop\n\n  return actions", "env_interactions": 4, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T19:47:03.988362", "function_name": "make_stick", "function_body": "  DIR_VECT = {0: (0, 1), 1: (0, -1), 2: (-1, 0), 3: (1, 0)}   # DOWN,UP,LEFT,RIGHT\n  USE = 4\n\n  # shortcuts to world data\n  world = env.world\n  state = env._current_state\n  grid = state.grid\n  idx = world.cookbook.index\n\n  # ----- identify stick recipe -----\n  stick_idx = idx[\"stick\"]\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  # primitive ingredients (ignore the workshop key)\n  prim_counts = {k: v for k, v in recipe.items() if k != \"_at\"}\n  workshop_name = recipe.get(\"_at\")\n  workshop_idx = idx[workshop_name] if workshop_name is not None else None\n\n  # ----- helper utilities -----\n  def is_traversable(x, y):\n      \"\"\"Cell is traversable if inside grid and contains no entities.\"\"\"\n      if x < 0 or y < 0 or x >= grid.shape[0] or y >= grid.shape[1]:\n          return False\n      return grid[x, y].sum() == 0\n\n  from collections import deque\n  def bfs(start, goal):\n      \"\"\"Return list of move actions (0\u20113) from start to goal using 4\u2011connected moves.\"\"\"\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (cx, cy), path = q.popleft()\n          if (cx, cy) == goal:\n              return path\n          for a, (dx, dy) in DIR_VECT.items():\n              nx, ny = cx + dx, cy + dy\n              if (nx, ny) not in visited and is_traversable(nx, ny):\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [a]))\n      raise RuntimeError(f\"No path found from {start} to {goal}\")\n\n  def move_adjacent_and_face(target_x, target_y, cur_pos):\n      \"\"\"\n      Compute actions to end on a traversable neighbour of (target_x,target_y)\n      while facing the target cell. Returns (actions, new_pos, new_dir).\n      \"\"\"\n      # try each direction to find a suitable neighbour/pre\u2011cell pair\n      for a, (dx, dy) in DIR_VECT.items():\n          nbx, nby = target_x - dx, target_y - dy\n          prex, prey = target_x - 2 * dx, target_y - 2 * dy\n          if is_traversable(nbx, nby) and is_traversable(prex, prey):\n              actions = bfs(cur_pos, (prex, prey))\n              actions.append(a)  # final step into neighbour, now facing target\n              new_pos = (nbx, nby)\n              new_dir = a\n              return actions, new_pos, new_dir\n\n      # fallback: pick any traversable neighbour and then adjust facing\n      for a, (dx, dy) in DIR_VECT.items():\n          nbx, nby = target_x - dx, target_y - dy\n          if is_traversable(nbx, nby):\n              actions = bfs(cur_pos, (nbx, nby))\n              # ensure we are facing target; if not, step away and back\n              if not actions or actions[-1] != a:\n                  ox, oy = DIR_VECT[(a + 2) % 4]\n                  back_x, back_y = nbx + ox, nby + oy\n                  if is_traversable(back_x, back_y):\n                      actions += [(a + 2) % 4, a]\n                      new_dir = a\n                  else:\n                      for b in DIR_VECT:\n                          bx, by = nbx + DIR_VECT[b][0], nby + DIR_VECT[b][1]\n                          if is_traversable(bx, by):\n                              actions += [b, (b + 2) % 4]\n                              break\n                      new_dir = a\n              else:\n                  new_dir = a\n              new_pos = (nbx, nby)\n              return actions, new_pos, new_dir\n      raise RuntimeError(f\"No reachable neighbour for target ({target_x},{target_y})\")\n\n  # ----- planning -----\n  actions_plan = []\n  cur_pos = tuple(state.pos)\n  cur_dir = state.dir\n\n  # collect each required primitive\n  for prim_idx, need_cnt in prim_counts.items():\n      locs = np.argwhere(grid[:, :, prim_idx] > 0)\n      if locs.size == 0:\n          raise RuntimeError(f\"Primitive {idx.get(prim_idx, prim_idx)} not found in grid\")\n      tx, ty = locs[0]\n\n      move_actions, cur_pos, cur_dir = move_adjacent_and_face(tx, ty, cur_pos)\n      actions_plan.extend(move_actions)\n      actions_plan.extend([USE] * need_cnt)\n\n  # go to workshop (if any) and craft\n  if workshop_idx is not None:\n      wk_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if wk_locs.size == 0:\n          raise RuntimeError(\"Workshop not found in grid\")\n      wx, wy = wk_locs[0]\n\n      move_actions, cur_pos, cur_dir = move_adjacent_and_face(wx, wy, cur_pos)\n      actions_plan.extend(move_actions)\n      actions_plan.append(USE)   # craft stick\n\n  return actions_plan", "env_interactions": 11, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T19:47:05.100534", "function_name": "make_stick", "function_body": "  DIR_VECT = {0: (0, 1), 1: (0, -1), 2: (-1, 0), 3: (1, 0)}  # DOWN, UP, LEFT, RIGHT\n  USE = 4\n\n  # shortcuts to world data\n  world = env.world\n  state = env._current_state\n  grid = state.grid\n  idx = world.cookbook.index\n\n  # ----- identify stick recipe -----\n  stick_idx = idx[\"stick\"]\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  prim_counts = {k: v for k, v in recipe.items() if k != \"_at\"}\n  workshop_name = recipe.get(\"_at\")\n  workshop_idx = idx[workshop_name] if workshop_name is not None else None\n\n  # ----- helper utilities -----\n  def traversable(x, y):\n      \"\"\"Return True if (x,y) is inside the grid and contains no entities.\"\"\"\n      if x < 0 or y < 0 or x >= grid.shape[0] or y >= grid.shape[1]:\n          return False\n      return grid[x, y].sum() == 0\n\n  from collections import deque\n\n  def bfs(start, goal):\n      \"\"\"Return a list of movement actions (0\u20113) from start to goal.\"\"\"\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (cx, cy), path = q.popleft()\n          if (cx, cy) == goal:\n              return path\n          for a, (dx, dy) in DIR_VECT.items():\n              nx, ny = cx + dx, cy + dy\n              if (nx, ny) not in visited and traversable(nx, ny):\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [a]))\n      raise RuntimeError(f\"No path from {start} to {goal}\")\n\n  def move_adjacent_and_face(tx, ty, cur):\n      \"\"\"\n      Compute actions that end on a traversable neighbour of (tx,ty)\n      while facing the target cell. Returns (actions, new_pos, new_dir).\n      \"\"\"\n      # try each direction to find a suitable neighbour\n      for a, (dx, dy) in DIR_VECT.items():\n          nbx, nby = tx - dx, ty - dy\n          if traversable(nbx, nby):\n              actions = bfs(cur, (nbx, nby))\n              return actions, (nbx, nby), a\n      # fallback: any traversable neighbour (should not happen in normal maps)\n      for a, (dx, dy) in DIR_VECT.items():\n          nbx, nby = tx - dx, ty - dy\n          if traversable(nbx, nby):\n              actions = bfs(cur, (nbx, nby))\n              return actions, (nbx, nby), a\n      raise RuntimeError(f\"No reachable neighbour for target ({tx},{ty})\")\n\n  # ----- planning -----\n  actions_plan = []\n  cur_pos = tuple(state.pos)\n  cur_dir = state.dir\n\n  # collect each required primitive\n  for prim_idx, need_cnt in prim_counts.items():\n      locations = np.argwhere(grid[:, :, prim_idx] > 0)\n      if locations.size == 0:\n          raise RuntimeError(f\"Primitive {idx.get(prim_idx, prim_idx)} not found\")\n      tx, ty = locations[0]  # pick the first occurrence\n\n      move_actions, cur_pos, cur_dir = move_adjacent_and_face(tx, ty, cur_pos)\n      actions_plan.extend(move_actions)\n      actions_plan.extend([USE] * need_cnt)\n\n  # go to workshop (if any) and craft\n  if workshop_idx is not None:\n      wk_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if wk_locs.size == 0:\n          raise RuntimeError(\"Workshop not found\")\n      wx, wy = wk_locs[0]\n\n      move_actions, cur_pos, cur_dir = move_adjacent_and_face(wx, wy, cur_pos)\n      actions_plan.extend(move_actions)\n      actions_plan.append(USE)   # craft stick\n\n  return actions_plan", "env_interactions": 7, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T19:47:26.271110", "function_name": "make_stick", "function_body": "  # map action names to indices\n  action_map = env.action_specs()\n  DOWN = action_map.get(\"DOWN\", 0)\n  UP = action_map.get(\"UP\", 1)\n  LEFT = action_map.get(\"LEFT\", 2)\n  RIGHT = action_map.get(\"RIGHT\", 3)\n  USE = action_map.get(\"USE\", 4)\n\n  # movement directions with associated action\n  DIRS = [\n      (1, 0, DOWN),   # down\n      (-1, 0, UP),    # up\n      (0, -1, LEFT),  # left\n      (0, 1, RIGHT),  # right\n  ]\n\n  # -------------------------------------------------------------------------\n  # extract relevant objects from the environment\n  # -------------------------------------------------------------------------\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      return []\n\n  world = getattr(env, \"world\", None)\n  if world is None:\n      return []\n\n  cookbook = getattr(world, \"cookbook\", None)\n  if cookbook is None:\n      return []\n\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []\n\n  grid = getattr(state, \"grid\", None)\n  cur_pos = getattr(state, \"pos\", None)\n  if grid is None or cur_pos is None:\n      return []\n\n  H, W = grid.shape[0], grid.shape[1]\n\n  # -------------------------------------------------------------------------\n  # helper functions\n  # -------------------------------------------------------------------------\n  def in_bounds(p):\n      return 0 <= p[0] < H and 0 <= p[1] < W\n\n  non_grabbable = set(world.non_grabbable_indices)\n\n  def walkable(p):\n      if not in_bounds(p):\n          return False\n      for idx in non_grabbable:\n          if grid[p[0], p[1], idx] > 0:\n              return False\n      return True\n\n  from collections import deque\n\n  def bfs_path(start, targets):\n      \"\"\"Return a list of movement actions to reach any cell in targets.\"\"\"\n      target_set = set(targets)\n      if start in target_set:\n          return []\n      q = deque([(start, [])])\n      visited = {start}\n      while q:\n          cur, path = q.popleft()\n          for dx, dy, act in DIRS:\n              nxt = (cur[0] + dx, cur[1] + dy)\n              if not in_bounds(nxt) or not walkable(nxt):\n                  continue\n              if nxt in visited:\n                  continue\n              new_path = path + [act]\n              if nxt in target_set:\n                  return new_path\n              visited.add(nxt)\n              q.append((nxt, new_path))\n      return None\n\n  # -------------------------------------------------------------------------\n  # determine which primitives are needed for the goal\n  # -------------------------------------------------------------------------\n  primitives_needed = cookbook.primitives_for(goal_idx)\n  if not primitives_needed:\n      # goal itself is a primitive (no recipe)\n      primitives_needed = {goal_idx: 1}\n\n  actions = []\n\n  # -------------------------------------------------------------------------\n  # collect each required primitive\n  # -------------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      # locate all cells that currently contain this primitive\n      locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n      if not locations:\n          # cannot find required primitive \u2013 abort\n          return []\n\n      collected = 0\n      while collected < needed:\n          # pick nearest location (Manhattan distance)\n          nearest = min(locations, key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))\n          # move to that location\n          path = bfs_path(cur_pos, [nearest])\n          if path is None:\n              return []\n          actions.extend(path)\n          cur_pos = nearest\n          # pick up the primitive\n          actions.append(USE)\n          collected += 1\n          # mark it as removed in our local copy of the grid\n          grid[cur_pos[0], cur_pos[1], prim_idx] = 0\n\n  # -------------------------------------------------------------------------\n  # go to the required workshop (if any) and craft the item\n  # -------------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n\n  if workshop_kind is not None:\n      # locate workshop cells\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n      if not workshop_cells:\n          return []\n      # choose nearest workshop\n      target_ws = min(workshop_cells,\n                     key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))\n      path = bfs_path(cur_pos, [target_ws])\n      if path is None:\n          return []\n      actions.extend(path)\n      cur_pos = target_ws\n      # perform crafting action\n      actions.append(USE)\n  else:\n      # no specific workshop \u2013 just use at current location\n      actions.append(USE)\n\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T19:47:27.383225", "function_name": "make_stick", "function_body": "  # Get action mapping\n  action_map = env.action_specs()\n  DOWN = action_map.get(\"DOWN\", 0)\n  UP = action_map.get(\"UP\", 1)\n  LEFT = action_map.get(\"LEFT\", 2)\n  RIGHT = action_map.get(\"RIGHT\", 3)\n  USE = action_map.get(\"USE\", 4)\n\n  # Directions: (dx, dy, action)\n  DIRS = [\n      (1, 0, DOWN),   # down\n      (-1, 0, UP),    # up\n      (0, -1, LEFT),  # left\n      (0, 1, RIGHT),  # right\n  ]\n\n  # ---------------------------------------------------------------------\n  # Extract goal and world information\n  # ---------------------------------------------------------------------\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      return []\n\n  world = getattr(env, \"world\", None)\n  if world is None:\n      return []\n  cookbook = getattr(world, \"cookbook\", None)\n  if cookbook is None:\n      return []\n\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []\n  grid = getattr(state, \"grid\", None)\n  pos = getattr(state, \"pos\", None)\n  if grid is None or pos is None:\n      return []\n\n  H, W = grid.shape[0], grid.shape[1]\n\n  # ---------------------------------------------------------------------\n  # Helper utilities\n  # ---------------------------------------------------------------------\n  def in_bounds(p):\n      return 0 <= p[0] < H and 0 <= p[1] < W\n\n  non_grabbable = set(world.non_grabbable_indices)\n\n  def walkable(p):\n      if not in_bounds(p):\n          return False\n      for idx in non_grabbable:\n          if grid[p[0], p[1], idx] > 0:\n              return False\n      return True\n\n  from collections import deque\n\n  def bfs_path(start, targets):\n      \"\"\"Return a list of actions to reach the closest cell in targets.\"\"\"\n      target_set = set(targets)\n      if start in target_set:\n          return []\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          cur, path = q.popleft()\n          for dx, dy, act in DIRS:\n              nxt = (cur[0] + dx, cur[1] + dy)\n              if not in_bounds(nxt) or not walkable(nxt):\n                  continue\n              if nxt in visited:\n                  continue\n              new_path = path + [act]\n              if nxt in target_set:\n                  return new_path\n              visited.add(nxt)\n              q.append((nxt, new_path))\n      return None  # unreachable\n\n  # ---------------------------------------------------------------------\n  # Determine required primitives for the goal\n  # ---------------------------------------------------------------------\n  primitives_needed = cookbook.primitives_for(goal_idx)\n  if not primitives_needed:\n      # Goal itself is a primitive; need to pick up one copy\n      primitives_needed = {goal_idx: 1}\n\n  actions = []\n  cur_pos = pos\n\n  # ---------------------------------------------------------------------\n  # Collect each required primitive\n  # ---------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      # Find all cells currently containing this primitive\n      locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n      if not locations:\n          return []  # cannot satisfy task\n\n      collected = 0\n      while collected < needed:\n          # Choose nearest location (Manhattan distance) from current position\n          nearest = min(locations, key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))\n          # Move to that cell\n          path = bfs_path(cur_pos, [nearest])\n          if path is None:\n              return []  # unreachable\n          actions.extend(path)\n          cur_pos = nearest\n          # Pick up the primitive\n          actions.append(USE)\n          collected += 1\n          # Assume the primitive disappears; we keep locations unchanged because we\n          # do not simulate the grid updates here.\n\n  # ---------------------------------------------------------------------\n  # Move to workshop (if required) and craft\n  # ---------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n\n  if workshop_kind is not None:\n      # Locate workshop cells\n      ws_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n      if not ws_cells:\n          return []\n      target_ws = min(ws_cells, key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))\n      path = bfs_path(cur_pos, [target_ws])\n      if path is None:\n          return []\n      actions.extend(path)\n      cur_pos = target_ws\n      # Craft at the workshop\n      actions.append(USE)\n  else:\n      # No specific workshop needed; just use at current location\n      actions.append(USE)\n\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T19:48:03.644939", "function_name": "make_stick", "function_body": "  # Ensure the environment is at a fresh start\n  env.reset()\n  state = env._current_state\n  world = env.world\n\n  # Goal index and its primitive requirements\n  goal_idx = env.task.goal\n  primitives_needed = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # Action mapping (environment uses standard DOWN/UP/LEFT/RIGHT/USE indices)\n  action_map = env.action_specs()\n  # In case action_specs() is not a dict, fall back to typical indices\n  if not isinstance(action_map, dict):\n      action_map = {'DOWN': 0, 'UP': 1, 'LEFT': 2, 'RIGHT': 3, 'USE': 4}\n  # Helper to convert a movement delta into the corresponding action index\n  def delta_to_action(dx, dy):\n      if dx == 0 and dy == 1:\n          return action_map['DOWN']\n      if dx == 0 and dy == -1:\n          return action_map['UP']\n      if dx == -1 and dy == 0:\n          return action_map['LEFT']\n      if dx == 1 and dy == 0:\n          return action_map['RIGHT']\n      raise ValueError(f'Invalid movement delta ({dx},{dy})')\n\n  from collections import deque\n\n  # Bread\u2011first search that finds the nearest cell containing `target_idx`.\n  # Returns a list of positions (excluding the start, including the target).\n  def bfs_to_target(start, target_idx):\n      W, H = state.grid.shape[:2]\n      # Cells occupied by any entity are blocked, except the target cell itself.\n      occupied = np.any(state.grid, axis=2)\n      visited = np.full((W, H), False, dtype=bool)\n      prev = np.empty((W, H, 2), dtype=int)\n\n      q = deque()\n      q.append(start)\n      visited[start[0], start[1]] = True\n\n      while q:\n          x, y = q.popleft()\n          if state.grid[x, y, target_idx] > 0:\n              # Reconstruct path from start (exclusive) to (x, y) inclusive.\n              path = []\n              cx, cy = x, y\n              while (cx, cy) != start:\n                  path.append((cx, cy))\n                  cx, cy = tuple(prev[cx, cy])\n              path.reverse()\n              return path\n\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  # Passable if empty or contains the target kind (so we can step onto it)\n                  if not occupied[nx, ny] or state.grid[nx, ny, target_idx] > 0:\n                      visited[nx, ny] = True\n                      prev[nx, ny] = (x, y)\n                      q.append((nx, ny))\n      # Target not reachable\n      return []\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive the needed number of times\n  # ----------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      for _ in range(needed_cnt):\n          path = bfs_to_target(cur_pos, prim_idx)\n          # Follow the path, updating the environment state after each move\n          for nxt in path:\n              dx, dy = nxt[0] - cur_pos[0], nxt[1] - cur_pos[1]\n              act = delta_to_action(dx, dy)\n              actions.append(act)\n              _, state = env.step(act)          # update internal state\n              cur_pos = nxt\n\n          # Pick up the primitive\n          actions.append(action_map['USE'])\n          _, state = env.step(action_map['USE'])\n          # Position does not change after USE\n          cur_pos = tuple(state.pos)\n\n  # ----------------------------------------------------------------------\n  # Move to the appropriate workshop (if any) and craft the goal item\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n\n      # Locate the nearest workshop cell and move there\n      path = bfs_to_target(cur_pos, workshop_idx)\n      for nxt in path:\n          dx, dy = nxt[0] - cur_pos[0], nxt[1] - cur_pos[1]\n          act = delta_to_action(dx, dy)\n          actions.append(act)\n          _, state = env.step(act)\n          cur_pos = nxt\n\n      # Use the workshop to craft the item\n      actions.append(action_map['USE'])\n      _, state = env.step(action_map['USE'])\n\n  # Return the complete action sequence\n  return actions", "env_interactions": 0, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T19:48:04.759737", "function_name": "make_stick", "function_body": "  # Ensure the environment is reset and obtain the initial state\n  if getattr(env, \"_current_state\", None) is None:\n      env.reset()\n  state = env._current_state\n  world = env.world\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  # Mapping from movement delta (dx, dy) to action indices\n  _MOVE2ACT = {\n      (0, 1): 0,   # DOWN\n      (0, -1): 1,  # UP\n      (-1, 0): 2,  # LEFT\n      (1, 0): 3,   # RIGHT\n  }\n\n  # Directions used for BFS (dx, dy) \u2013 same order as _MOVE2ACT keys\n  _DIRS = list(_MOVE2ACT.keys())\n\n  from collections import deque\n\n  def _bfs_to_kind(start_pos, kind_idx):\n      \"\"\"\n      Bread\u2011first search for the nearest cell containing `kind_idx`.\n      Returns a list of positions from the start (inclusive) to the\n      target (inclusive).  Returns None if no such cell is reachable.\n      \"\"\"\n      W, H, _ = state.grid.shape\n      visited = np.zeros((W, H), dtype=bool)\n      parent = np.empty((W, H, 2), dtype=int)\n\n      q = deque()\n      q.append(start_pos)\n      visited[start_pos[0], start_pos[1]] = True\n\n      while q:\n          x, y = q.popleft()\n          # target reached?\n          if state.grid[x, y, kind_idx] > 0:\n              # reconstruct path\n              path = [(x, y)]\n              while (x, y) != start_pos:\n                  x, y = tuple(parent[x, y])\n                  path.append((x, y))\n              path.reverse()\n              return path\n\n          for dx, dy in _DIRS:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  cell = state.grid[nx, ny, :]\n                  # passable if empty OR contains the desired kind (so we can step onto it)\n                  if cell.sum() == 0 or cell[kind_idx] > 0:\n                      visited[nx, ny] = True\n                      parent[nx, ny] = (x, y)\n                      q.append((nx, ny))\n      return None\n\n  def _follow_path(path):\n      \"\"\"Execute actions that follow the given path (list of positions).\"\"\"\n      nonlocal state\n      for (x0, y0), (x1, y1) in zip(path, path[1:]):\n          act = _MOVE2ACT[(x1 - x0, y1 - y0)]\n          actions.append(act)\n          _, state = env.step(act)\n\n  # ------------------------------------------------------------------\n  # Determine the goal (stick) and its recipe\n  # ------------------------------------------------------------------\n  # Prefer the task's explicit goal if available, otherwise fall back to the name \"stick\"\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      goal_idx = world.cookbook.index.index(\"stick\")\n\n  # Primitive requirements for the goal\n  primitives_needed = world.cookbook.primitives_for(goal_idx)\n\n  # Full recipe (may contain a workshop requirement)\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  workshop_idx = None\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Collect all required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, count in primitives_needed.items():\n      for _ in range(count):\n          path = _bfs_to_kind(state.pos, prim_idx)\n          if path is None:\n              # Primitive unreachable \u2013 abort early\n              return actions\n          _follow_path(path)\n          # Pick up the primitive\n          actions.append(4)          # USE\n          _, state = env.step(4)\n\n  # ------------------------------------------------------------------\n  # Move to the workshop (if required) and craft the item\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      path = _bfs_to_kind(state.pos, workshop_idx)\n      if path is not None:\n          _follow_path(path)\n          actions.append(4)          # USE to craft at the workshop\n          _, state = env.step(4)\n\n  return actions", "env_interactions": 0, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T19:48:26.214408", "function_name": "make_stick", "function_body": "  import collections\n\n  # ----------------------------------------------------------------------\n  # Extract basic objects from the environment\n  # ----------------------------------------------------------------------\n  action_map = env.action_specs()\n  DOWN = action_map.get(\"DOWN\", 0)\n  UP = action_map.get(\"UP\", 1)\n  LEFT = action_map.get(\"LEFT\", 2)\n  RIGHT = action_map.get(\"RIGHT\", 3)\n  USE = action_map.get(\"USE\", 4)\n\n  # goal index (int) stored in env.task.goal\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      return []\n\n  world = getattr(env, \"world\", None)\n  if world is None:\n      return []\n\n  cookbook = getattr(world, \"cookbook\", None)\n  if cookbook is None:\n      return []\n\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []\n\n  grid = getattr(state, \"grid\", None)\n  cur_pos = tuple(getattr(state, \"pos\", (0, 0)))\n  if grid is None or cur_pos is None:\n      return []\n\n  H, W = grid.shape[0], grid.shape[1]\n\n  # ----------------------------------------------------------------------\n  # Navigation helpers\n  # ----------------------------------------------------------------------\n  non_grabbable = set(world.non_grabbable_indices)\n\n  def in_bounds(p):\n      return 0 <= p[0] < H and 0 <= p[1] < W\n\n  def walkable(p):\n      if not in_bounds(p):\n          return False\n      for idx in non_grabbable:\n          if grid[p[0], p[1], idx] > 0:\n              return False\n      return True\n\n  DIRS = [\n      (1, 0, DOWN),   # down\n      (-1, 0, UP),    # up\n      (0, -1, LEFT),  # left\n      (0, 1, RIGHT),  # right\n  ]\n\n  def bfs_path(start, targets):\n      \"\"\"Return (action_list, target_cell) for the nearest reachable target.\"\"\"\n      target_set = set(targets)\n      if start in target_set:\n          return [], start\n      q = collections.deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          cur, path = q.popleft()\n          for dr, dc, act in DIRS:\n              nxt = (cur[0] + dr, cur[1] + dc)\n              if not in_bounds(nxt) or not walkable(nxt):\n                  continue\n              if nxt in visited:\n                  continue\n              new_path = path + [act]\n              if nxt in target_set:\n                  return new_path, nxt\n              visited.add(nxt)\n              q.append((nxt, new_path))\n      return None, None\n\n  # ----------------------------------------------------------------------\n  # Determine which primitives we need\n  # ----------------------------------------------------------------------\n  primitives_needed = cookbook.primitives_for(goal_idx)\n  if not primitives_needed:\n      # Goal itself may be a primitive to pick up directly\n      primitives_needed = {goal_idx: 1}\n\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # Collect required primitives\n  # ----------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      collected = 0\n      while collected < needed_cnt:\n          # locate all cells currently holding this primitive\n          locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not locations:\n              return []  # cannot satisfy requirement\n          path, target = bfs_path(cur_pos, locations)\n          if path is None:\n              return []  # unreachable primitive\n          actions.extend(path)\n          cur_pos = target\n          actions.append(USE)          # pick up\n          collected += 1\n          # update internal grid copy to reflect removal\n          grid[cur_pos[0], cur_pos[1], prim_idx] = 0\n\n  # ----------------------------------------------------------------------\n  # Move to workshop (if required) and craft the goal item\n  # ----------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n\n  if workshop_kind is not None:\n      # find any workshop cell of the required kind\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n      if not workshop_cells:\n          return []  # no workshop present\n      path, target = bfs_path(cur_pos, workshop_cells)\n      if path is None:\n          return []  # unreachable workshop\n      actions.extend(path)\n      cur_pos = target\n      actions.append(USE)   # craft at workshop\n  else:\n      # no specific workshop; just use current cell to craft\n      actions.append(USE)\n\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T19:48:27.323085", "function_name": "make_stick", "function_body": "  import numpy as np\n  from collections import deque\n\n  # -------------------------------------------------------------------------\n  # Action indices\n  # -------------------------------------------------------------------------\n  action_map = env.action_specs()\n  DOWN = action_map.get(\"DOWN\", 0)\n  UP = action_map.get(\"UP\", 1)\n  LEFT = action_map.get(\"LEFT\", 2)\n  RIGHT = action_map.get(\"RIGHT\", 3)\n  USE = action_map.get(\"USE\", 4)\n\n  DIRS = [\n      (1, 0, DOWN),   # down  (increase row)\n      (-1, 0, UP),    # up    (decrease row)\n      (0, -1, LEFT),  # left  (decrease col)\n      (0, 1, RIGHT),  # right (increase col)\n  ]\n\n  # -------------------------------------------------------------------------\n  # Extract core objects from the environment\n  # -------------------------------------------------------------------------\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      return []\n\n  world = getattr(env, \"world\", None)\n  if world is None:\n      return []\n\n  cookbook = getattr(world, \"cookbook\", None)\n  if cookbook is None:\n      return []\n\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []\n\n  grid = getattr(state, \"grid\", None)\n  cur_pos = getattr(state, \"pos\", None)\n  if grid is None or cur_pos is None:\n      return []\n\n  H, W = grid.shape[0], grid.shape[1]\n\n  # -------------------------------------------------------------------------\n  # Navigation helpers\n  # -------------------------------------------------------------------------\n  non_grabbable = set(world.non_grabbable_indices)\n\n  def in_bounds(p):\n      return 0 <= p[0] < H and 0 <= p[1] < W\n\n  def walkable(p):\n      if not in_bounds(p):\n          return False\n      for idx in non_grabbable:\n          if grid[p[0], p[1], idx] > 0:\n              return False\n      return True\n\n  def bfs_path(start, targets):\n      \"\"\"Return (action_list, target_cell) for the nearest reachable target.\"\"\"\n      target_set = set(targets)\n      if start in target_set:\n          return [], start\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          cur, path = q.popleft()\n          for dx, dy, act in DIRS:\n              nxt = (cur[0] + dx, cur[1] + dy)\n              if not in_bounds(nxt) or not walkable(nxt):\n                  continue\n              if nxt in visited:\n                  continue\n              new_path = path + [act]\n              if nxt in target_set:\n                  return new_path, nxt\n              visited.add(nxt)\n              q.append((nxt, new_path))\n      return None, None  # unreachable\n\n  # -------------------------------------------------------------------------\n  # Determine required primitives\n  # -------------------------------------------------------------------------\n  primitives_needed = cookbook.primitives_for(goal_idx)\n  if not primitives_needed:\n      # Goal itself may be a primitive; just collect it.\n      primitives_needed = {goal_idx: 1}\n\n  actions = []\n\n  # -------------------------------------------------------------------------\n  # Collect each needed primitive\n  # -------------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      collected = 0\n      while collected < needed_cnt:\n          # Locate all cells currently holding this primitive.\n          locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not locations:\n              return []  # cannot satisfy requirement\n          path, target = bfs_path(cur_pos, locations)\n          if path is None:\n              return []  # unreachable primitive\n          actions.extend(path)\n          cur_pos = target\n          actions.append(USE)          # pick up primitive\n          collected += 1\n          # Update internal grid copy to reflect the pickup.\n          grid[cur_pos[0], cur_pos[1], prim_idx] = 0\n\n  # -------------------------------------------------------------------------\n  # Move to workshop (if required) and craft the goal item\n  # -------------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n\n  if workshop_kind is not None:\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n      if not workshop_cells:\n          return []  # no workshop present\n      path, target = bfs_path(cur_pos, workshop_cells)\n      if path is None:\n          return []  # unreachable workshop\n      actions.extend(path)\n      cur_pos = target\n      actions.append(USE)  # craft at workshop\n  else:\n      # No specific workshop needed; just use current cell.\n      actions.append(USE)\n\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T19:48:44.175104", "function_name": "make_stick", "function_body": "  # Resolve action identifiers; fall back to the default order if needed.\n  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      action_ids = [0, 1, 2, 3, 4]  # DOWN, UP, LEFT, RIGHT, USE\n\n  # Locate the index of the target item \"stick\" in the cookbook.\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n  if stick_idx is None:\n      # Stick not defined for this world \u2013 nothing to do.\n      return []\n\n  # Ensure the environment is reset so that `_current_state` exists.\n  if not hasattr(env, \"_current_state\") or env._current_state is None:\n      env.reset()\n  start_state = env._current_state\n\n  # If we already have a stick, no actions are required.\n  if start_state.inventory[stick_idx] > 0:\n      return []\n\n  # Determine the primitive requirements for crafting a stick.\n  # This returns a dict {primitive_index: count}.  If the recipe is empty,\n  # the stick itself is a primitive.\n  needed_prims = env.world.cookbook.primitives_for(stick_idx)\n  if not needed_prims:\n      needed_prims = {stick_idx: 1}\n\n  from collections import deque\n\n  # Helper to create a hashable representation of a state for the visited set.\n  def _state_key(st):\n      # Position, direction, inventory contents, and grid layout uniquely identify a state.\n      return (st.pos, st.dir, st.inventory.tobytes(), st.grid.tobytes())\n\n  visited = {_state_key(start_state)}\n  frontier = deque()\n  frontier.append((start_state, []))\n\n  # Upper bound on plan length to keep the search tractable.\n  MAX_PLAN_LEN = 800\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      # Goal test: have at least one stick in inventory.\n      if cur_state.inventory[stick_idx] > 0:\n          return cur_plan\n\n      if len(cur_plan) >= MAX_PLAN_LEN:\n          continue\n\n      # Expand all possible actions.\n      for a in action_ids:\n          _, nxt_state = cur_state.step(a)\n          key = _state_key(nxt_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((nxt_state, cur_plan + [a]))\n\n  # If no plan was found within the limits, return an empty list.\n  return []", "env_interactions": 4, "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T19:48:45.294682", "function_name": "make_stick", "function_body": "  # Determine the action indices; fall back to default ordering if needed.\n  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      # Default ordering used by CraftWorld: DOWN, UP, LEFT, RIGHT, USE\n      action_ids = [0, 1, 2, 3, 4]\n\n  # Locate the index of the target item \"stick\" in the cookbook.\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n  if stick_idx is None:\n      # No stick defined for this world \u2013 nothing to do.\n      return []\n\n  # Ensure the environment has been reset so that `_current_state` is valid.\n  if not hasattr(env, \"_current_state\") or env._current_state is None:\n      env.reset()\n  start_state = env._current_state\n\n  # If we already possess a stick, no actions are required.\n  if start_state.inventory[stick_idx] > 0:\n      return []\n\n  from collections import deque\n\n  # Helper to create a hashable representation of a state for the visited set.\n  def _state_key(st):\n      # Position, direction, inventory contents, and grid layout uniquely identify a state.\n      return (st.pos, st.dir, st.inventory.tobytes(), st.grid.tobytes())\n\n  visited = {_state_key(start_state)}\n  frontier = deque()\n  frontier.append((start_state, []))\n\n  # Upper bound on plan length to keep the search tractable.\n  MAX_PLAN_LEN = 500\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      # Goal test: have at least one stick in inventory.\n      if cur_state.inventory[stick_idx] > 0:\n          return cur_plan\n\n      if len(cur_plan) >= MAX_PLAN_LEN:\n          continue\n\n      # Expand all possible actions.\n      for a in action_ids:\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((next_state, cur_plan + [a]))\n\n  # If no plan found within the limits, return an empty list.\n  return []", "env_interactions": 4, "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T19:49:16.012793", "function_name": "make_stick", "function_body": "  actions = []\n  world = env.world\n  state = env._current_state\n\n  # Index of the target item (stick)\n  stick_idx = world.cookbook.index[\"stick\"]\n  if state.inventory[stick_idx] > 0:\n      return actions\n\n  # ------------------------------------------------------------------\n  # Helper: convert a move from cur \u2192 nxt into the corresponding action.\n  # ------------------------------------------------------------------\n  def move_action(cur, nxt):\n      dx = nxt[0] - cur[0]\n      dy = nxt[1] - cur[1]\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise ValueError(\"invalid move delta\")\n\n  # -------------------------------------------------------------\n  # BFS that stops when we reach a cell adjacent to any target.\n  # Returns the path (list of positions) from start to that cell.\n  # -------------------------------------------------------------\n  def bfs_adjacent(start, target_cells, grid):\n      W, H, _ = grid.shape\n      visited = np.full((W, H), False, dtype=bool)\n      q = collections.deque()\n      q.append((start, []))\n      visited[start] = True\n      target_set = {tuple(t) for t in target_cells}\n      while q:\n          (x, y), path = q.popleft()\n          # Are we adjacent (Manhattan distance 1) to any target cell?\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path + [(x, y)]\n          # Expand neighbours (4\u2011connected grid)\n          for dx, dy in ((0, 1), (0, -1), (1, 0), (-1, 0)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  # Cell is free iff no entity occupies it.\n                  if grid[nx, ny, :].sum() == 0:\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [(x, y)]))\n      raise RuntimeError(\"No reachable target adjacent cell found\")\n\n  # -------------------------------------------------\n  # 1) Gather all primitive ingredients for the stick.\n  # -------------------------------------------------\n  primitive_requirements = world.cookbook.primitives_for(stick_idx)\n  cur_pos = tuple(state.pos)\n\n  for prim_idx, needed in primitive_requirements.items():\n      for _ in range(needed):\n          # If we already have the primitive in inventory, skip.\n          if state.inventory[prim_idx] > 0:\n              continue\n          # Locate cells that contain this primitive.\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(f\"Primitive {prim_idx} not found on the map\")\n          # Find a path to a cell adjacent to one of the primitives.\n          path = bfs_adjacent(cur_pos, prim_cells, state.grid)\n          # Translate the path into movement actions.\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n          # Use the item (pick it up).\n          actions.append(4)   # USE\n\n  # -------------------------------------------------\n  # 2) Go to the appropriate workshop and craft stick.\n  # -------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      # Stick is a primitive; nothing more to do.\n      return actions\n\n  workshop_idx = world.cookbook.index[workshop_name]\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      raise RuntimeError(\"Workshop for stick not found on the map\")\n  path = bfs_adjacent(cur_pos, workshop_cells, state.grid)\n  for step in path[1:]:\n      actions.append(move_action(cur_pos, step))\n      cur_pos = step\n  # Craft at the workshop.\n  actions.append(4)   # USE\n\n  return actions", "env_interactions": 5, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T19:49:17.128514", "function_name": "make_stick", "function_body": "  actions = []\n  world = env.world\n  state = env._current_state\n\n  # Index of the target item.\n  stick_idx = world.cookbook.index[\"stick\"]\n  # If we already have it, nothing to do.\n  if state.inventory[stick_idx] > 0:\n      return actions\n\n  # Mapping from movement delta to action index.\n  def move_action(cur, nxt):\n      dx = nxt[0] - cur[0]\n      dy = nxt[1] - cur[1]\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise ValueError(\"invalid move\")\n\n  # Bread\u2011first search that stops when a cell adjacent to any target cell is reached.\n  def bfs_adjacent(start, target_cells, grid):\n      W, H, _ = grid.shape\n      visited = np.full((W, H), False, dtype=bool)\n      q = collections.deque()\n      q.append((start, []))\n      visited[start] = True\n      targets = {tuple(t) for t in target_cells}\n      while q:\n          (x, y), path = q.popleft()\n          # Check adjacency.\n          for tx, ty in targets:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path + [(x, y)]\n          # Expand neighbours.\n          for dx, dy in ((0, 1), (0, -1), (1, 0), (-1, 0)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  # Cell is free if no entity occupies it.\n                  if grid[nx, ny, :].sum() == 0:\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [(x, y)]))\n      raise RuntimeError(\"No reachable target\")\n\n  # ------------------------------------------------------------------\n  # 1. Collect all primitive ingredients required for a stick.\n  # ------------------------------------------------------------------\n  primitive_requirements = world.cookbook.primitives_for(stick_idx)\n  cur_pos = tuple(state.pos)\n\n  for prim_idx, needed in primitive_requirements.items():\n      for _ in range(needed):\n          # If we already have this primitive, skip.\n          if state.inventory[prim_idx] > 0:\n              continue\n          # Locate cells that currently contain the primitive.\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(\"Required primitive not found on the map\")\n          path = bfs_adjacent(cur_pos, prim_cells, state.grid)\n          # Translate the path into actions.\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n          # Use the item (pick it up).\n          actions.append(4)   # USE\n\n  # ------------------------------------------------------------------\n  # 2. Go to the appropriate workshop (if any) and craft the stick.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          raise RuntimeError(\"Workshop for stick not found\")\n      path = bfs_adjacent(cur_pos, workshop_cells, state.grid)\n      for step in path[1:]:\n          actions.append(move_action(cur_pos, step))\n          cur_pos = step\n      actions.append(4)   # USE to craft\n\n  return actions", "env_interactions": 5, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T19:49:34.182031", "function_name": "make_stick", "function_body": "  ACTION = env.action_specs()\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  def find_nearest(pos, kind):\n      \"\"\"Return the coordinates of the closest cell that contains `kind`.\"\"\"\n      layer = state.grid[:, :, kind]\n      ys, xs = np.where(layer > 0)\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - pos[0]) + np.abs(ys - pos[1])\n      i = int(np.argmin(dists))\n      return (int(xs[i]), int(ys[i]))\n\n  def moves_to(cur, target):\n      \"\"\"Return a list of movement actions (Manhattan) from cur to target.\"\"\"\n      seq = []\n      x, y = cur\n      tx, ty = target\n      while x != tx:\n          if tx > x:\n              seq.append(ACTION[\"RIGHT\"])\n              x += 1\n          else:\n              seq.append(ACTION[\"LEFT\"])\n              x -= 1\n      while y != ty:\n          if ty > y:\n              seq.append(ACTION[\"DOWN\"])\n              y += 1\n          else:\n              seq.append(ACTION[\"UP\"])\n              y -= 1\n      return seq\n\n  # ------------------------------------------------------------\n  # Determine which primitives are needed to craft a stick\n  # ------------------------------------------------------------\n  stick_idx = idx[\"stick\"]\n  needed = world.cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n\n  plan = []\n  cur_pos = state.pos\n\n  # ------------------------------------------------------------\n  # Collect each required primitive\n  # ------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          target = find_nearest(cur_pos, prim_idx)\n          if target is None:\n              raise ValueError(\"Required primitive not found in the world\")\n          plan.extend(moves_to(cur_pos, target))\n          plan.append(ACTION[\"USE\"])          # pick up the primitive\n          cur_pos = target\n\n  # ------------------------------------------------------------\n  # Move to the appropriate workshop (if the recipe specifies one)\n  # ------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      wk_idx = idx[workshop_name] if isinstance(workshop_name, str) else workshop_name\n      wk_pos = find_nearest(cur_pos, wk_idx)\n      if wk_pos is not None:\n          plan.extend(moves_to(cur_pos, wk_pos))\n          cur_pos = wk_pos\n\n  # ------------------------------------------------------------\n  # Final USE action to craft the stick\n  # ------------------------------------------------------------\n  plan.append(ACTION[\"USE\"])\n  return plan", "env_interactions": 4, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T19:49:35.297749", "function_name": "make_stick", "function_body": "  ACTION = env.action_specs()\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  # Helper: locate nearest cell of a given kind from a position\n  def find_nearest(pos, kind):\n      layer = state.grid[:, :, kind]\n      ys, xs = np.where(layer > 0)\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - pos[0]) + np.abs(ys - pos[1])\n      i = int(np.argmin(dists))\n      return (int(xs[i]), int(ys[i]))\n\n  # Helper: Manhattan moves from cur to target\n  def moves_to(cur, target):\n      seq = []\n      x, y = cur\n      tx, ty = target\n      while x != tx:\n          if tx > x:\n              seq.append(ACTION[\"RIGHT\"])\n              x += 1\n          else:\n              seq.append(ACTION[\"LEFT\"])\n              x -= 1\n      while y != ty:\n          if ty > y:\n              seq.append(ACTION[\"DOWN\"])\n              y += 1\n          else:\n              seq.append(ACTION[\"UP\"])\n              y -= 1\n      return seq\n\n  # Identify stick index and its primitive requirements\n  stick_idx = idx.get(\"stick\")\n  if stick_idx is None:\n      return []  # cannot find stick recipe\n\n  needed = world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n  plan = []\n  cur_pos = state.pos\n\n  # Collect required primitives\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          target = find_nearest(cur_pos, prim_idx)\n          if target is None:\n              continue  # primitive not present; skip\n          plan.extend(moves_to(cur_pos, target))\n          plan.append(ACTION[\"USE\"])  # pick up\n          cur_pos = target\n\n  # Move to workshop if recipe specifies one\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      wk_idx = idx[workshop_name] if isinstance(workshop_name, str) else workshop_name\n      wk_pos = find_nearest(cur_pos, wk_idx)\n      if wk_pos is not None:\n          plan.extend(moves_to(cur_pos, wk_pos))\n          cur_pos = wk_pos\n\n  # Final use to craft the stick\n  plan.append(ACTION[\"USE\"])\n  return plan", "env_interactions": 0, "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-10-21T19:49:57.325696", "function_name": "make_stick", "function_body": "  # Reset environment and fetch core objects\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  cookbook = world.cookbook\n\n  # --------------------------------------------------------------\n  # Identify the index for the target item \"stick\"\n  # --------------------------------------------------------------\n  try:\n      stick_idx = cookbook.index[\"stick\"]\n  except Exception:\n      return []   # stick not defined in this world\n\n  # --------------------------------------------------------------\n  # Determine primitive ingredients required for one stick\n  # --------------------------------------------------------------\n  prim_req = cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n  stick_is_primitive = not bool(prim_req)\n  if stick_is_primitive:\n      # If stick itself is a primitive, we just need to collect it\n      prim_req = {stick_idx: 1}\n\n  # --------------------------------------------------------------\n  # Action mapping (environment specific)\n  # --------------------------------------------------------------\n  act_map = env.action_specs()\n  DOWN = act_map.get(\"DOWN\", 0)\n  UP   = act_map.get(\"UP\", 1)\n  LEFT = act_map.get(\"LEFT\", 2)\n  RIGHT= act_map.get(\"RIGHT\", 3)\n  USE  = act_map.get(\"USE\", 4)\n\n  # --------------------------------------------------------------\n  # Helper: Manhattan moves (fallback when pathfinding fails)\n  # --------------------------------------------------------------\n  def _manhattan_moves(start, target):\n      cx, cy = start\n      tx, ty = target\n      moves = []\n      while cx < tx:\n          moves.append(DOWN); cx += 1\n      while cx > tx:\n          moves.append(UP);   cx -= 1\n      while cy < ty:\n          moves.append(RIGHT); cy += 1\n      while cy > ty:\n          moves.append(LEFT);  cy -= 1\n      return moves\n\n  # --------------------------------------------------------------\n  # Helper: Breadth\u2011first search avoiding blocked cells\n  # --------------------------------------------------------------\n  width, height = state.grid.shape[:2]\n\n  def _is_blocked(pos, ignore_target=None):\n      x, y = pos\n      # Outside bounds are blocked\n      if not (0 <= x < width and 0 <= y < height):\n          return True\n      # If this cell is the intended target, allow stepping on it\n      if ignore_target is not None and (x, y) == ignore_target:\n          return False\n      # Any non\u2011zero entry in any kind makes the cell blocked\n      return state.grid[x, y, :].any()\n\n  def _bfs_path(start, goal):\n      \"\"\"Return list of positions from start (exclusive) to goal (inclusive).\"\"\"\n      if start == goal:\n          return []\n      from collections import deque\n      queue = deque([start])\n      came_from = {start: None}\n      while queue:\n          cur = queue.popleft()\n          if cur == goal:\n              break\n          x, y = cur\n          for nx, ny in ((x+1, y), (x-1, y), (x, y+1), (x, y-1)):\n              nxt = (nx, ny)\n              if nxt in came_from:\n                  continue\n              if _is_blocked(nxt, ignore_target=goal):\n                  continue\n              came_from[nxt] = cur\n              queue.append(nxt)\n      else:\n          return None  # no path found\n\n      # reconstruct path\n      path = []\n      cur = goal\n      while cur != start:\n          path.append(cur)\n          cur = came_from[cur]\n      path.reverse()\n      return path\n\n  def _path_to_moves(start, path):\n      \"\"\"Convert a list of positions into action indices.\"\"\"\n      moves = []\n      cx, cy = start\n      for (nx, ny) in path:\n          if nx > cx:\n              moves.append(DOWN)\n          elif nx < cx:\n              moves.append(UP)\n          elif ny > cy:\n              moves.append(RIGHT)\n          elif ny < cy:\n              moves.append(LEFT)\n          cx, cy = nx, ny\n      return moves\n\n  # --------------------------------------------------------------\n  # Locate all required primitives on the current grid\n  # --------------------------------------------------------------\n  prim_locs = {}\n  for p_idx in prim_req:\n      positions = np.argwhere(state.grid[:, :, p_idx] > 0)\n      prim_locs[p_idx] = [tuple(pos) for pos in positions]\n\n  # --------------------------------------------------------------\n  # Locate a suitable workshop (if crafting is required)\n  # --------------------------------------------------------------\n  workshop_pos = None\n  if not stick_is_primitive:\n      # Prefer the workshop explicitly named in the recipe\n      recipe = cookbook.recipes.get(stick_idx, {})\n      wk_name = recipe.get(\"_at\")\n      if wk_name is not None:\n          try:\n              wk_idx = cookbook.index[wk_name]\n              cells = np.argwhere(state.grid[:, :, wk_idx] > 0)\n              if cells.size:\n                  workshop_pos = tuple(cells[0])\n          except Exception:\n              workshop_pos = None\n\n      # Fallback: any workshop entity present in the world\n      if workshop_pos is None:\n          for wk_idx in world.workshop_indices:\n              cells = np.argwhere(state.grid[:, :, wk_idx] > 0)\n              if cells.size:\n                  workshop_pos = tuple(cells[0])\n                  break\n\n  # --------------------------------------------------------------\n  # Build the action plan\n  # --------------------------------------------------------------\n  cur_pos = state.pos\n  plan = []\n\n  # Helper to virtually update the grid after picking up an item\n  def _remove_item_at(pos, kind_idx):\n      x, y = pos\n      state.grid[x, y, kind_idx] = 0\n\n  for p_idx, needed in prim_req.items():\n      collected = 0\n      available = prim_locs.get(p_idx, []).copy()\n      if not available:\n          # Required primitive absent \u2013 cannot finish the task\n          return []\n      while collected < needed:\n          # Choose the nearest available primitive (Manhattan distance)\n          dists = [abs(cur_pos[0]-x) + abs(cur_pos[1]-y) for (x, y) in available]\n          nearest = int(np.argmin(dists))\n          target = available.pop(nearest)\n\n          # Compute a safe path; fall back to Manhattan if no path\n          path = _bfs_path(cur_pos, target)\n          if path is None:\n              path = _manhattan_moves(cur_pos, target)\n              moves = path\n          else:\n              moves = _path_to_moves(cur_pos, path)\n\n          plan.extend(moves)\n          plan.append(USE)               # pick up action\n          cur_pos = target\n          _remove_item_at(target, p_idx) # update virtual grid\n          collected += 1\n\n  # --------------------------------------------------------------\n  # If crafting is required, move to a workshop and use\n  # --------------------------------------------------------------\n  if not stick_is_primitive:\n      if workshop_pos is not None:\n          path = _bfs_path(cur_pos, workshop_pos)\n          if path is None:\n              plan.extend(_manhattan_moves(cur_pos, workshop_pos))\n          else:\n              plan.extend(_path_to_moves(cur_pos, path))\n          cur_pos = workshop_pos\n      plan.append(USE)   # trigger crafting at the workshop\n\n  return plan", "env_interactions": 4, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T19:49:58.435933", "function_name": "make_stick", "function_body": "  # Reset environment and get handles\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  cookbook = world.cookbook\n\n  # --------------------------------------------------------------\n  # Identify the index of the target item \"stick\"\n  # --------------------------------------------------------------\n  try:\n      stick_idx = cookbook.index[\"stick\"]\n  except Exception:\n      return []   # stick not defined in this world\n\n  # --------------------------------------------------------------\n  # Determine which primitives are needed for one stick\n  # --------------------------------------------------------------\n  prim_req = cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n  # If the recipe dict is empty, the stick itself is a primitive\n  if not prim_req:\n      prim_req = {stick_idx: 1}\n\n  # --------------------------------------------------------------\n  # Action mapping (environment specific)\n  # --------------------------------------------------------------\n  act_map = env.action_specs()\n  DOWN = act_map.get('DOWN', 0)\n  UP   = act_map.get('UP', 1)\n  LEFT = act_map.get('LEFT', 2)\n  RIGHT= act_map.get('RIGHT', 3)\n  USE  = act_map.get('USE', 4)\n\n  # --------------------------------------------------------------\n  # Helper: Manhattan moves from a to b\n  # --------------------------------------------------------------\n  def moves_to(start, target):\n      cx, cy = start\n      tx, ty = target\n      acts = []\n      while cx < tx:\n          acts.append(DOWN); cx += 1\n      while cx > tx:\n          acts.append(UP);   cx -= 1\n      while cy < ty:\n          acts.append(RIGHT); cy += 1\n      while cy > ty:\n          acts.append(LEFT);  cy -= 1\n      return acts\n\n  # --------------------------------------------------------------\n  # Locate all required primitives on the current grid\n  # --------------------------------------------------------------\n  grid = state.grid\n  prim_locations = {}\n  for p_idx in prim_req:\n      pos = np.argwhere(grid[:, :, p_idx] > 0)\n      prim_locations[p_idx] = [tuple(p) for p in pos]\n\n  # --------------------------------------------------------------\n  # Locate a workshop (if crafting is required)\n  # --------------------------------------------------------------\n  workshop_pos = None\n  # recipe may specify a particular workshop name via \"_at\"\n  recipe = cookbook.recipes.get(stick_idx, {})\n  wk_name = recipe.get(\"_at\")\n  if wk_name is not None:\n      try:\n          wk_idx = cookbook.index[wk_name]\n          cells = np.argwhere(grid[:, :, wk_idx] > 0)\n          if cells.size:\n              workshop_pos = tuple(cells[0])\n      except Exception:\n          workshop_pos = None\n  # fallback: any workshop present in the world\n  if workshop_pos is None:\n      for wk_idx in world.workshop_indices:\n          cells = np.argwhere(grid[:, :, wk_idx] > 0)\n          if cells.size:\n              workshop_pos = tuple(cells[0])\n              break\n\n  # --------------------------------------------------------------\n  # Build the action plan\n  # --------------------------------------------------------------\n  cur_pos = state.pos\n  plan = []\n\n  for p_idx, needed in prim_req.items():\n      collected = 0\n      available = prim_locations.get(p_idx, []).copy()\n      if not available:\n          # primitive not present on the map \u2013 cannot finish\n          return []\n      while collected < needed:\n          # Choose the nearest primitive (Manhattan distance)\n          dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in available]\n          nearest = int(np.argmin(dists))\n          target = available.pop(nearest)\n\n          # Move to the primitive and pick it up\n          plan.extend(moves_to(cur_pos, target))\n          cur_pos = target\n          plan.append(USE)          # pickup\n          collected += 1\n\n  # If a workshop is required, go there and invoke USE to craft\n  if workshop_pos is not None:\n      plan.extend(moves_to(cur_pos, workshop_pos))\n      cur_pos = workshop_pos\n  plan.append(USE)                  # trigger crafting (or final pickup if primitive)\n\n  return plan", "env_interactions": 4, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T19:50:20.184046", "function_name": "make_stick", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ----------------------------------------------------------------------\n  # Environment utilities\n  # ----------------------------------------------------------------------\n  ACTION = env.action_specs()                     # name \u2192 int\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  # ----------------------------------------------------------------------\n  # Helper functions\n  # ----------------------------------------------------------------------\n  def find_nearest(pos, kind, grid):\n      \"\"\"Return (x, y) of the closest cell containing the given kind.\"\"\"\n      layer = grid[:, :, kind]\n      ys, xs = np.where(layer > 0)\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - pos[0]) + np.abs(ys - pos[1])\n      i = int(np.argmin(dists))\n      return (int(xs[i]), int(ys[i]))\n\n  def bfs_path(start, goal, grid):\n      \"\"\"Shortest path from start to goal avoiding occupied cells.\"\"\"\n      if start == goal:\n          return [start]\n      W, H, _ = grid.shape\n      visited = np.full((W, H), False, dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start[0], start[1]] = True\n\n      while q:\n          x, y = q.popleft()\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < W and 0 <= ny < H):\n                  continue\n              if visited[nx, ny]:\n                  continue\n              # allow stepping onto the goal even if occupied\n              if (nx, ny) != goal and grid[nx, ny].any():\n                  continue\n              visited[nx, ny] = True\n              prev[(nx, ny)] = (x, y)\n              if (nx, ny) == goal:\n                  # reconstruct path\n                  path = [(nx, ny)]\n                  while path[-1] != start:\n                      path.append(prev[path[-1]])\n                  path.reverse()\n                  return path\n              q.append((nx, ny))\n      return None\n\n  def actions_from_path(path):\n      \"\"\"Translate a list of positions into a list of action indices.\"\"\"\n      seq = []\n      for (x0, y0), (x1, y1) in zip(path, path[1:]):\n          if x1 > x0:\n              seq.append(ACTION[\"RIGHT\"])\n          elif x1 < x0:\n              seq.append(ACTION[\"LEFT\"])\n          elif y1 > y0:\n              seq.append(ACTION[\"DOWN\"])\n          elif y1 < y0:\n              seq.append(ACTION[\"UP\"])\n      return seq\n\n  # ----------------------------------------------------------------------\n  # Determine primitives required to craft a stick\n  # ----------------------------------------------------------------------\n  stick_idx = idx[\"stick\"]\n  needed = world.cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n\n  # Working copy of the grid to simulate pickups\n  grid = state.grid.copy()\n  plan = []\n  cur_pos = state.pos\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive\n  # ----------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = find_nearest(cur_pos, prim_idx, grid)\n          if target is None:\n              return []                     # primitive missing \u2192 fail\n          path = bfs_path(cur_pos, target, grid)\n          if path is None:\n              return []                     # unreachable \u2192 fail\n          plan.extend(actions_from_path(path))\n          plan.append(ACTION[\"USE\"])        # pick up the primitive\n          # simulate removal of the primitive from the world\n          grid[target[0], target[1], prim_idx] = 0\n          cur_pos = target\n\n  # ----------------------------------------------------------------------\n  # Move to workshop (if recipe specifies one) and craft the stick\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      wk_idx = idx[workshop_name] if isinstance(workshop_name, str) else workshop_name\n      wk_pos = find_nearest(cur_pos, wk_idx, grid)\n      if wk_pos is not None:\n          path = bfs_path(cur_pos, wk_pos, grid)\n          if path is not None:\n              plan.extend(actions_from_path(path))\n              cur_pos = wk_pos\n\n  # Final USE to actually craft the stick\n  plan.append(ACTION[\"USE\"])\n\n  return plan", "env_interactions": 4, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T19:50:21.301632", "function_name": "make_stick", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ----------------------------------------------------------------------\n  # Environment utilities\n  # ----------------------------------------------------------------------\n  ACTION = env.action_specs()                     # map name \u2192 int\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  # ----------------------------------------------------------------------\n  # Helper functions\n  # ----------------------------------------------------------------------\n  def find_nearest(pos, kind, grid):\n      \"\"\"Return (x, y) of the closest cell that contains the given kind.\"\"\"\n      layer = grid[:, :, kind]\n      ys, xs = np.where(layer > 0)\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - pos[0]) + np.abs(ys - pos[1])\n      i = int(np.argmin(dists))\n      return (int(xs[i]), int(ys[i]))\n\n  def bfs_path(start, goal, grid):\n      \"\"\"Shortest Manhattan path from start to goal avoiding occupied cells.\"\"\"\n      if start == goal:\n          return [start]\n\n      W, H, _ = grid.shape\n      visited = np.full((W, H), False, dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start[0], start[1]] = True\n\n      while q:\n          x, y = q.popleft()\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < W and 0 <= ny < H):\n                  continue\n              if visited[nx, ny]:\n                  continue\n              # allow stepping onto the goal even if it is occupied\n              if (nx, ny) != goal and grid[nx, ny].any():\n                  continue\n              visited[nx, ny] = True\n              prev[(nx, ny)] = (x, y)\n              if (nx, ny) == goal:\n                  # reconstruct path\n                  path = [(nx, ny)]\n                  while path[-1] != start:\n                      path.append(prev[path[-1]])\n                  path.reverse()\n                  return path\n              q.append((nx, ny))\n      return None\n\n  def actions_from_path(path):\n      \"\"\"Translate a list of positions into a list of action indices.\"\"\"\n      seq = []\n      for (x0, y0), (x1, y1) in zip(path, path[1:]):\n          if x1 > x0:\n              seq.append(ACTION[\"RIGHT\"])\n          elif x1 < x0:\n              seq.append(ACTION[\"LEFT\"])\n          elif y1 > y0:\n              seq.append(ACTION[\"DOWN\"])\n          elif y1 < y0:\n              seq.append(ACTION[\"UP\"])\n      return seq\n\n  # ----------------------------------------------------------------------\n  # Determine what we need to craft a stick\n  # ----------------------------------------------------------------------\n  stick_idx = idx[\"stick\"]\n  needed = world.cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n\n  # Working copy of the grid so we can simulate pickups\n  grid = state.grid.copy()\n  plan = []\n  cur_pos = state.pos\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive\n  # ----------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = find_nearest(cur_pos, prim_idx, grid)\n          if target is None:\n              # Primitive not present \u2013 cannot finish the task\n              return []\n          path = bfs_path(cur_pos, target, grid)\n          if path is None:\n              return []   # no reachable path\n          plan.extend(actions_from_path(path))\n          plan.append(ACTION[\"USE\"])          # pick up the primitive\n          # simulate removal of the primitive from the world\n          grid[target[0], target[1], prim_idx] = 0\n          cur_pos = target\n\n  # ----------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the stick\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      wk_idx = idx[workshop_name] if isinstance(workshop_name, str) else workshop_name\n      wk_pos = find_nearest(cur_pos, wk_idx, grid)\n      if wk_pos is not None:\n          path = bfs_path(cur_pos, wk_pos, grid)\n          if path is not None:\n              plan.extend(actions_from_path(path))\n              cur_pos = wk_pos\n\n  # Final USE to actually craft the stick\n  plan.append(ACTION[\"USE\"])\n\n  return plan", "env_interactions": 4, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T19:50:52.098280", "function_name": "make_stick", "function_body": "  # reset environment and get initial state\n  env.reset()\n  state = env._current_state\n\n  # action mappings\n  act_map = env.action_specs()                     # name -> int\n  inv_act = {v: k for k, v in act_map.items()}     # int -> name\n\n  # indices we need\n  stick_idx = env.world.cookbook.index[\"stick\"]\n  blocked_set = set(env.world.non_grabbable_indices)\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def walkable(pos):\n      x, y = pos\n      return not any(state.grid[x, y, k] > 0 for k in blocked_set)\n\n  def bfs(start, goal_set):\n      \"\"\"Bread\u2011first search from start to any position in goal_set.\"\"\"\n      from collections import deque\n      q = deque([start])\n      prev = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur in goal_set:\n              # reconstruct path\n              path = []\n              while cur is not None:\n                  path.append(cur)\n                  cur = prev[cur]\n              path.reverse()\n              return path\n          for dx, dy in ((-1, 0), (1, 0), (0, -1), (0, 1)):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                  nxt = (nx, ny)\n                  if nxt not in prev and walkable(nxt):\n                      prev[nxt] = cur\n                      q.append(nxt)\n      return None\n\n  def move_action(p, q):\n      \"\"\"Return the integer action that moves from p to q.\"\"\"\n      dx, dy = q[0] - p[0], q[1] - p[1]\n      if (dx, dy) == (-1, 0):\n          return act_map[\"UP\"]\n      if (dx, dy) == (1, 0):\n          return act_map[\"DOWN\"]\n      if (dx, dy) == (0, -1):\n          return act_map[\"LEFT\"]\n      if (dx, dy) == (0, 1):\n          return act_map[\"RIGHT\"]\n      raise ValueError(f\"Invalid move from {p} to {q}\")\n\n  def adjacent_cells(cell):\n      \"\"\"Return walkable cells adjacent to `cell`.\"\"\"\n      adj = []\n      for dx, dy in ((-1, 0), (1, 0), (0, -1), (0, 1)):\n          ax, ay = cell[0] + dx, cell[1] + dy\n          if 0 <= ax < state.grid.shape[0] and 0 <= ay < state.grid.shape[1]:\n              if walkable((ax, ay)):\n                  adj.append((ax, ay))\n      return adj\n\n  # ------------------------------------------------------------------\n  # Main planning loop\n  # ------------------------------------------------------------------\n  actions = []\n  max_steps = 2000  # safety guard\n\n  while state.inventory[stick_idx] == 0 and len(actions) < max_steps:\n      # locate all stick primitives on the map\n      xs, ys = np.where(state.grid[:, :, stick_idx] > 0)\n      stick_positions = list(zip(xs.tolist(), ys.tolist()))\n      if not stick_positions:\n          break  # no sticks left, cannot proceed\n\n      # choose the closest stick (Manhattan distance)\n      cur_pos = state.pos\n      target = min(\n          stick_positions,\n          key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]),\n      )\n\n      # find reachable adjacent cells around the target\n      reachable_adj = set(adjacent_cells(target))\n      if not reachable_adj:\n          break  # cannot approach this stick\n\n      # compute path to any reachable adjacent cell\n      path = bfs(cur_pos, reachable_adj)\n      if path is None:\n          break  # no path found\n\n      # follow the path (skip the first node which is the current position)\n      for i in range(1, len(path)):\n          a = move_action(path[i - 1], path[i])\n          actions.append(a)\n          _, state = env.step(a)\n          env._current_state = state\n\n      # we are now on a cell adjacent to the stick\n      # ensure we are facing the stick before using\n      dx, dy = target[0] - state.pos[0], target[1] - state.pos[1]\n      if (dx, dy) == (-1, 0):\n          needed = \"UP\"\n      elif (dx, dy) == (1, 0):\n          needed = \"DOWN\"\n      elif (dx, dy) == (0, -1):\n          needed = \"LEFT\"\n      elif (dx, dy) == (0, 1):\n          needed = \"RIGHT\"\n      else:\n          needed = None\n\n      if needed is not None:\n          # if we are already facing the correct direction, nothing to do\n          # otherwise perform a small back\u2011and\u2011forth to set direction\n          if inv_act[state.dir] != needed:\n              opposite = {\"UP\": \"DOWN\", \"DOWN\": \"UP\", \"LEFT\": \"RIGHT\", \"RIGHT\": \"LEFT\"}[needed]\n              # try to move opposite then back if possible\n              opp_dx, opp_dy = {\"UP\": (1, 0), \"DOWN\": (-1, 0), \"LEFT\": (0, 1), \"RIGHT\": (0, -1)}[needed]\n              opp_pos = (state.pos[0] + opp_dx, state.pos[1] + opp_dy)\n              if 0 <= opp_pos[0] < state.grid.shape[0] and 0 <= opp_pos[1] < state.grid.shape[1] and walkable(opp_pos):\n                  # move opposite\n                  act_opp = act_map[opposite]\n                  actions.append(act_opp)\n                  _, state = env.step(act_opp)\n                  env._current_state = state\n                  # move forward (now facing the stick)\n                  act_fwd = act_map[needed]\n                  actions.append(act_fwd)\n                  _, state = env.step(act_fwd)\n                  env._current_state = state\n              else:\n                  # fallback: just turn left twice (two moves) to change direction\n                  dummy = act_map[\"LEFT\"]\n                  actions.append(dummy)\n                  _, state = env.step(dummy)\n                  env._current_state = state\n                  actions.append(dummy)\n                  _, state = env.step(dummy)\n                  env._current_state = state\n\n      # collect the stick\n      actions.append(act_map[\"USE\"])\n      _, state = env.step(act_map[\"USE\"])\n      env._current_state = state\n\n  return actions", "env_interactions": 0, "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T19:50:53.218201", "function_name": "make_stick", "function_body": "  # Reset environment and get initial state\n  obs = env.reset()\n  state = env._current_state\n\n  # Mapping from action names to indices\n  act_map = env.action_specs()\n  # Inverse mapping for convenience\n  inv_act = {v: k for k, v in act_map.items()}\n\n  # Index of the target item \"stick\"\n  stick_idx = env.world.cookbook.index[\"stick\"]\n  # Set of entity kinds that cannot be traversed (e.g., water, stone)\n  blocked_set = set(env.world.non_grabbable_indices)\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def walkable(pos):\n      \"\"\"Return True if the cell at pos does not contain any blocked entity.\"\"\"\n      x, y = pos\n      return not any(state.grid[x, y, k] > 0 for k in blocked_set)\n\n  def bfs(start, target_set):\n      \"\"\"Bread\u2011first search from start to any position in target_set.\n      Returns a list of positions (including start) forming the path,\n      or None if no path exists.\"\"\"\n      from collections import deque\n      q = deque([start])\n      prev = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur in target_set:\n              # reconstruct path\n              path = []\n              while cur is not None:\n                  path.append(cur)\n                  cur = prev[cur]\n              path.reverse()\n              return path\n          for dx, dy in ((-1, 0), (1, 0), (0, -1), (0, 1)):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                  nxt = (nx, ny)\n                  if nxt not in prev and walkable(nxt):\n                      prev[nxt] = cur\n                      q.append(nxt)\n      return None\n\n  def move_action(p, q):\n      \"\"\"Return the integer action that moves from position p to q.\"\"\"\n      dx, dy = q[0] - p[0], q[1] - p[1]\n      if (dx, dy) == (-1, 0):\n          return act_map[\"UP\"]\n      if (dx, dy) == (1, 0):\n          return act_map[\"DOWN\"]\n      if (dx, dy) == (0, -1):\n          return act_map[\"LEFT\"]\n      if (dx, dy) == (0, 1):\n          return act_map[\"RIGHT\"]\n      raise ValueError(f\"Invalid move from {p} to {q}\")\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Main loop: collect a stick primitive and pick it up.\n  # ------------------------------------------------------------------\n  max_steps = 2000  # safety guard to avoid infinite loops\n  while state.inventory[stick_idx] == 0 and len(actions) < max_steps:\n      # Locate all cells that currently contain a stick primitive\n      xs, ys = np.where(state.grid[:, :, stick_idx] > 0)\n      stick_positions = list(zip(xs.tolist(), ys.tolist()))\n      if not stick_positions:\n          # No sticks available on the map \u2013 cannot proceed.\n          break\n\n      # Choose the closest stick (Manhattan distance) as the target\n      cur_pos = state.pos\n      target = min(\n          stick_positions,\n          key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]),\n      )\n\n      # Determine walkable cells adjacent to the target stick\n      adj_cells = []\n      for dx, dy in ((-1, 0), (1, 0), (0, -1), (0, 1)):\n          ax, ay = target[0] + dx, target[1] + dy\n          if (\n              0 <= ax < state.grid.shape[0]\n              and 0 <= ay < state.grid.shape[1]\n              and walkable((ax, ay))\n          ):\n              adj_cells.append((ax, ay))\n\n      # Find a path to any of the reachable adjacent cells\n      path = bfs(cur_pos, set(adj_cells))\n      if path is None:\n          # Target stick is unreachable \u2013 abort.\n          break\n\n      # Follow the path (skip the first element which is the current position)\n      for i in range(1, len(path)):\n          a = move_action(path[i - 1], path[i])\n          actions.append(a)\n          _, state = env.step(a)\n          env._current_state = state\n\n      # At this point we are on a cell adjacent to the stick.\n      # Ensure we are facing the stick before using.\n      dx, dy = target[0] - state.pos[0], target[1] - state.pos[1]\n      if (dx, dy) == (-1, 0):\n          desired_dir = act_map[\"UP\"]\n      elif (dx, dy) == (1, 0):\n          desired_dir = act_map[\"DOWN\"]\n      elif (dx, dy) == (0, -1):\n          desired_dir = act_map[\"LEFT\"]\n      elif (dx, dy) == (0, 1):\n          desired_dir = act_map[\"RIGHT\"]\n      else:\n          desired_dir = None\n\n      if desired_dir is not None and state.dir != desired_dir:\n          # No explicit turn action exists; we turn by moving one step opposite\n          # and then stepping back to the original cell, which updates the facing.\n          opp_dir_name = {\n              act_map[\"UP\"]: \"DOWN\",\n              act_map[\"DOWN\"]: \"UP\",\n              act_map[\"LEFT\"]: \"RIGHT\",\n              act_map[\"RIGHT\"]: \"LEFT\",\n          }[desired_dir]\n          opp_act = act_map[opp_dir_name]\n\n          # Verify the opposite cell is walkable; if not, perform a dummy turn\n          ox, oy = state.pos[0] - dx, state.pos[1] - dy\n          if 0 <= ox < state.grid.shape[0] and 0 <= oy < state.grid.shape[1] and walkable((ox, oy)):\n              # Move opposite\n              actions.append(opp_act)\n              _, state = env.step(opp_act)\n              env._current_state = state\n              # Move back (now facing the target)\n              actions.append(desired_dir)\n              _, state = env.step(desired_dir)\n              env._current_state = state\n          else:\n              # Perform a dummy left move and right move to change direction\n              dummy = act_map[\"LEFT\"]\n              actions.append(dummy)\n              _, state = env.step(dummy)\n              env._current_state = state\n              actions.append(desired_dir)\n              _, state = env.step(desired_dir)\n              env._current_state = state\n\n      # Use the stick (collect it)\n      actions.append(act_map[\"USE\"])\n      _, state = env.step(act_map[\"USE\"])\n      env._current_state = state\n\n  return actions", "env_interactions": 0, "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T19:51:04.744711", "function_name": "make_stick", "function_body": "  # Determine the action IDs (ensure we have all possible actions)\n  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      # Fallback ordering: DOWN, UP, LEFT, RIGHT, USE\n      action_ids = [0, 1, 2, 3, 4]\n\n  # Resolve the integer index for the target item \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n  if stick_idx is None:\n      # Stick is not defined in this world; nothing to do\n      return []\n\n  # Make sure we have a current state (reset environment if needed)\n  if not hasattr(env, \"_current_state\") or env._current_state is None:\n      env.reset()\n  start_state = env._current_state\n\n  # If we already possess a stick, no actions are required\n  if start_state.inventory[stick_idx] > 0:\n      return []\n\n  from collections import deque\n\n  # Helper to create a hashable representation of a state for visited tracking\n  def _state_key(st):\n      return (st.pos, st.dir, st.inventory.tobytes(), st.grid.tobytes())\n\n  visited = {_state_key(start_state)}\n  frontier = deque()\n  frontier.append((start_state, []))\n\n  # Upper bound on plan length to keep search tractable\n  MAX_PLAN_LEN = 400\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      # Goal test: have at least one stick in inventory\n      if cur_state.inventory[stick_idx] > 0:\n          return cur_plan\n\n      # Prune overly long plans\n      if len(cur_plan) >= MAX_PLAN_LEN:\n          continue\n\n      # Expand all possible actions\n      for a in action_ids:\n          _, nxt_state = cur_state.step(a)\n          key = _state_key(nxt_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((nxt_state, cur_plan + [a]))\n\n  # If we exit the loop, no feasible plan was found within the limits\n  return []", "env_interactions": 4, "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T19:51:05.867573", "function_name": "make_stick", "function_body": "  # Determine the integer IDs for the actions the agent can take.\n  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      # Fallback to the default ordering used in CraftWorld.\n      action_ids = [0, 1, 2, 3, 4]  # DOWN, UP, LEFT, RIGHT, USE\n\n  # Resolve the internal index for the target item \"stick\".\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n  if stick_idx is None:\n      # The world does not contain a stick recipe \u2013 nothing to do.\n      return []\n\n  # Ensure the environment is in a known initial state.\n  if not hasattr(env, \"_current_state\") or env._current_state is None:\n      env.reset()\n  start_state = env._current_state\n\n  # If we already possess a stick, no actions are required.\n  if start_state.inventory[stick_idx] > 0:\n      return []\n\n  from collections import deque\n\n  # Helper that creates a hashable representation of a state for the visited set.\n  def _state_key(st):\n      # Position (x, y) and facing direction are small integers.\n      # Inventory and grid are turned into immutable byte strings.\n      return (st.pos, st.dir, st.inventory.tobytes(), st.grid.tobytes())\n\n  visited = {_state_key(start_state)}\n  frontier = deque()\n  frontier.append((start_state, []))\n\n  # Upper bound on plan length to keep the search tractable.\n  MAX_PLAN_LENGTH = 500\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      # Goal test: have at least one stick in the inventory.\n      if cur_state.inventory[stick_idx] > 0:\n          return cur_plan\n\n      # Do not expand beyond the maximum allowed depth.\n      if len(cur_plan) >= MAX_PLAN_LENGTH:\n          continue\n\n      # Explore all possible actions from the current state.\n      for a in action_ids:\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((next_state, cur_plan + [a]))\n\n  # If we exit the loop without returning, no feasible plan was found.\n  return []", "env_interactions": 4, "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T19:51:37.120909", "function_name": "make_stick", "function_body": "  # reset environment and get shortcuts\n  env.reset()\n  world = env.world\n  idx = world.cookbook.index\n\n  # find index of the goal item \u201cstick\u201d\n  try:\n      stick_idx = idx[\"stick\"]\n  except Exception:  # fallback case\u2011insensitive\n      stick_idx = next(i for i, n in enumerate(idx.ordered_contents) if n.lower() == \"stick\")\n\n  # required primitives (or the stick itself if it is primitive)\n  needed = world.cookbook.primitives_for(stick_idx)\n  if not needed:\n      needed = {stick_idx: 1}\n\n  # action mapping\n  act_map = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act_map[\"DOWN\"],\n      act_map[\"UP\"],\n      act_map[\"LEFT\"],\n      act_map[\"RIGHT\"],\n      act_map[\"USE\"],\n  )\n\n  # current simulated state (for planning only)\n  state = env._current_state\n  cur_pos = tuple(state.pos)                     # (x, y)\n  grid = state.grid.copy()                       # mutable copy for bookkeeping\n\n  # blocked cells: any non\u2011grabbable entity present\n  non_grab = list(world.non_grabbable_indices)\n  if non_grab:\n      blocked = np.any(grid[:, :, non_grab] > 0, axis=2)\n  else:\n      blocked = np.zeros(grid.shape[:2], dtype=bool)\n\n  # ------------------------------------------------------------------\n  # Helper: BFS returning a list of actions to move from start to target\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  moves = {\n      (0, 1): DOWN,\n      (0, -1): UP,\n      (-1, 0): LEFT,\n      (1, 0): RIGHT,\n  }\n\n  def bfs_actions(start, target):\n      \"\"\"Return list of actions to reach target from start, or None.\"\"\"\n      if start == target:\n          return []\n      w, h = grid.shape[:2]\n      q = deque([start])\n      came = {start: (None, None)}  # pos -> (parent, action)\n      while q:\n          x, y = q.popleft()\n          for (dx, dy), a in moves.items():\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < w and 0 <= ny < h):\n                  continue\n              if blocked[nx, ny]:\n                  continue\n              nxt = (nx, ny)\n              if nxt in came:\n                  continue\n              came[nxt] = ((x, y), a)\n              if nxt == target:\n                  # reconstruct actions\n                  actions = []\n                  node = nxt\n                  while came[node][0] is not None:\n                      parent, act = came[node]\n                      actions.append(act)\n                      node = parent\n                  return list(reversed(actions))\n              q.append(nxt)\n      return None  # no walkable path found\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives\n  # ------------------------------------------------------------------\n  actions = []\n  for item_idx, cnt in needed.items():\n      for _ in range(int(cnt)):\n          # locate remaining instances of the item\n          locs = np.argwhere(grid[:, :, item_idx] > 0)\n          if locs.size == 0:\n              break  # none left on the map\n          # pick the nearest (Manhattan) occurrence\n          dists = np.abs(locs[:, 0] - cur_pos[0]) + np.abs(locs[:, 1] - cur_pos[1])\n          target = tuple(locs[dists.argmin()])\n\n          # plan movement\n          path_actions = bfs_actions(cur_pos, target)\n          if path_actions is None:\n              # fallback to simple Manhattan moves (ignores obstacles)\n              x, y = cur_pos\n              tx, ty = target\n              while x < tx:\n                  actions.append(RIGHT); x += 1\n              while x > tx:\n                  actions.append(LEFT); x -= 1\n              while y < ty:\n                  actions.append(DOWN); y += 1\n              while y > ty:\n                  actions.append(UP); y -= 1\n          else:\n              actions.extend(path_actions)\n          cur_pos = target\n\n          # pick up the primitive\n          actions.append(USE)\n\n          # update simulated grid and blocked mask\n          grid[target[0], target[1], item_idx] -= 1\n          if non_grab:\n              blocked[target[0], target[1]] = np.any(\n                  grid[target[0], target[1], non_grab] > 0\n              )\n\n  # ------------------------------------------------------------------\n  # 2. Move to the required workshop (if any) and craft the stick\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = idx[workshop_name]\n      ws_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_locs.size:\n          ws_target = tuple(ws_locs[0])\n          path_actions = bfs_actions(cur_pos, ws_target)\n          if path_actions is None:\n              x, y = cur_pos\n              tx, ty = ws_target\n              while x < tx:\n                  actions.append(RIGHT); x += 1\n              while x > tx:\n                  actions.append(LEFT); x -= 1\n              while y < ty:\n                  actions.append(DOWN); y += 1\n              while y > ty:\n                  actions.append(UP); y -= 1\n          else:\n              actions.extend(path_actions)\n          cur_pos = ws_target\n          actions.append(USE)  # craft at the workshop\n\n  return actions", "env_interactions": 4, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T19:51:38.241090", "function_name": "make_stick", "function_body": "  env.reset()\n  world = env.world\n  idx = world.cookbook.index\n\n  # Identify the index for the goal item \u201cstick\u201d (case\u2011insensitive fallback)\n  try:\n      stick_idx = idx[\"stick\"]\n  except Exception:\n      stick_idx = next(i for i, n in enumerate(idx.ordered_contents) if n.lower() == \"stick\")\n\n  # Determine primitive requirements (if stick is primitive treat as needing itself)\n  needed = world.cookbook.primitives_for(stick_idx)\n  if not needed:\n      needed = {stick_idx: 1}\n\n  # Action indices\n  act_map = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act_map[\"DOWN\"],\n      act_map[\"UP\"],\n      act_map[\"LEFT\"],\n      act_map[\"RIGHT\"],\n      act_map[\"USE\"],\n  )\n\n  # Helper: translate a delta into an action index\n  def delta_to_action(dx, dy):\n      if dx == 1:\n          return RIGHT\n      if dx == -1:\n          return LEFT\n      if dy == 1:\n          return DOWN\n      if dy == -1:\n          return UP\n      raise ValueError(\"Invalid move delta\")\n\n  # Helper: BFS returning a list of actions from start to goal, avoiding non\u2011grabbable cells\n  def bfs(start, goal, grid):\n      w, h, _ = grid.shape\n      # Pre\u2011compute blocked cells (any non\u2011zero kind that is non\u2011grabbable)\n      blocked = np.zeros((w, h), dtype=bool)\n      for k in world.non_grabbable_indices:\n          blocked |= grid[:, :, k] > 0\n\n      from collections import deque\n\n      q = deque([tuple(start)])\n      came = {tuple(start): None}\n      while q:\n          x, y = q.popleft()\n          if (x, y) == tuple(goal):\n              # Reconstruct actions\n              actions = []\n              cur = (x, y)\n              while came[cur] is not None:\n                  prev, act = came[cur]\n                  actions.append(act)\n                  cur = prev\n              actions.reverse()\n              return actions\n          for dx, dy, act in ((1, 0, RIGHT), (-1, 0, LEFT), (0, 1, DOWN), (0, -1, UP)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and not blocked[nx, ny]:\n                  nxt = (nx, ny)\n                  if nxt not in came:\n                      came[nxt] = ((x, y), act)\n                      q.append(nxt)\n\n      # No walkable path \u2013 fall back to Manhattan moves (ignores obstacles)\n      actions = []\n      x, y = start\n      tx, ty = goal\n      while x < tx:\n          actions.append(RIGHT)\n          x += 1\n      while x > tx:\n          actions.append(LEFT)\n          x -= 1\n      while y < ty:\n          actions.append(DOWN)\n          y += 1\n      while y > ty:\n          actions.append(UP)\n          y -= 1\n      return actions\n\n  # Current simulated state (position and grid copy for bookkeeping)\n  state = env._current_state\n  cur_pos = tuple(state.pos)\n  grid = state.grid.copy()\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives (respecting quantity)\n  # ------------------------------------------------------------------\n  for kind, cnt in needed.items():\n      for _ in range(int(cnt)):\n          locs = np.argwhere(grid[:, :, kind] > 0)\n          if locs.size == 0:\n              # Primitive not present on map \u2013 stop trying to collect it\n              break\n          # Choose the nearest occurrence (Manhattan distance)\n          dists = np.abs(locs[:, 0] - cur_pos[0]) + np.abs(locs[:, 1] - cur_pos[1])\n          target = tuple(locs[dists.argmin()])\n\n          # Move to the target\n          actions.extend(bfs(cur_pos, target, grid))\n          cur_pos = target\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update local grid copy\n          grid[target[0], target[1], kind] -= 1\n\n  # ------------------------------------------------------------------\n  # 2. If a workshop is required, navigate to it and craft the stick\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      ws_idx = idx[workshop_name]\n      ws_locs = np.argwhere(grid[:, :, ws_idx] > 0)\n      if ws_locs.size:\n          ws_target = tuple(ws_locs[0])\n          actions.extend(bfs(cur_pos, ws_target, grid))\n          cur_pos = ws_target\n          actions.append(USE)\n\n  return actions", "env_interactions": 4, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T19:52:15.059446", "function_name": "make_stick", "function_body": "  # reset environment and fetch useful objects\n  env.reset()\n  world = env.world\n  idx = world.cookbook.index\n\n  # action indices\n  act_map = env.action_specs()\n  DOWN = act_map[\"DOWN\"]\n  UP = act_map[\"UP\"]\n  LEFT = act_map[\"LEFT\"]\n  RIGHT = act_map[\"RIGHT\"]\n  USE = act_map[\"USE\"]\n\n  # ------------------------------------------------------------------\n  # identify the goal item (stick) \u2013 be tolerant to case differences\n  # ------------------------------------------------------------------\n  try:\n      stick_idx = idx[\"stick\"]\n  except Exception:  # pragma: no cover\n      stick_idx = next(i for i, n in enumerate(idx.ordered_contents) if n.lower() == \"stick\")\n\n  # ------------------------------------------------------------------\n  # what primitives (or items) are required to obtain a stick?\n  # ------------------------------------------------------------------\n  needed = world.cookbook.primitives_for(stick_idx)\n  if not needed:\n      # stick itself is a primitive \u2013 just pick one up\n      needed = {stick_idx: 1}\n\n  # ------------------------------------------------------------------\n  # helper: Manhattan moves (used as a fallback when BFS fails)\n  # ------------------------------------------------------------------\n  def manhattan_moves(start, goal):\n      sx, sy = start\n      gx, gy = goal\n      moves = []\n      while sx < gx:\n          moves.append(RIGHT)\n          sx += 1\n      while sx > gx:\n          moves.append(LEFT)\n          sx -= 1\n      while sy < gy:\n          moves.append(DOWN)\n          sy += 1\n      while sy > gy:\n          moves.append(UP)\n          sy -= 1\n      return moves\n\n  # ------------------------------------------------------------------\n  # helper: BFS that respects non\u2011grabbable obstacles\n  # ------------------------------------------------------------------\n  import collections\n\n  def bfs_path(start, targets, blocked):\n      \"\"\"Return a list of actions that reaches any cell in *targets*.\"\"\"\n      if start in targets:\n          return []\n      q = collections.deque([start])\n      visited = {start: (None, None)}          # cell -> (parent, action)\n      while q:\n          cur = q.popleft()\n          for act, (dx, dy) in [(DOWN, (0, 1)), (UP, (0, -1)),\n                                (LEFT, (-1, 0)), (RIGHT, (1, 0))]:\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if not (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]):\n                  continue\n              if blocked[nx, ny]:\n                  continue\n              nxt = (nx, ny)\n              if nxt in visited:\n                  continue\n              visited[nxt] = (cur, act)\n              if nxt in targets:\n                  # reconstruct path\n                  path = []\n                  node = nxt\n                  while visited[node][0] is not None:\n                      parent, a = visited[node]\n                      path.append(a)\n                      node = parent\n                  return list(reversed(path))\n              q.append(nxt)\n      # fallback\n      return manhattan_moves(start, next(iter(targets)))\n\n  # ------------------------------------------------------------------\n  # initialise simulation of the current grid and position\n  # ------------------------------------------------------------------\n  state = env._current_state\n  cur_pos = tuple(state.pos)\n  grid = state.grid.copy()                     # local copy we can mutate\n\n  # mask of cells that are blocked by non\u2011grabbable entities\n  non_grabbable = list(world.non_grabbable_indices)\n  if non_grabbable:\n      blocked_mask = np.any(grid[:, :, non_grabbable] > 0, axis=2)\n  else:\n      blocked_mask = np.zeros(grid.shape[:2], dtype=bool)\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # 1. Gather all required primitives / items\n  # ------------------------------------------------------------------\n  for item_idx, needed_cnt in needed.items():\n      needed_cnt = int(needed_cnt)\n      while needed_cnt > 0:\n          # locate all cells that still contain this item\n          locs = np.argwhere(grid[:, :, item_idx] > 0)\n          if locs.size == 0:\n              # nothing left \u2013 break to avoid infinite loop\n              break\n          # choose the closest one (Manhattan heuristic)\n          dists = np.abs(locs[:, 0] - cur_pos[0]) + np.abs(locs[:, 1] - cur_pos[1])\n          target = tuple(locs[dists.argmin()])\n\n          # compute a walkable path to the target cell\n          path = bfs_path(cur_pos, {target}, blocked_mask)\n          actions.extend(path)\n          cur_pos = target\n\n          # pick up the item\n          actions.append(USE)\n          needed_cnt -= 1\n\n          # update local grid / blocked mask\n          grid[target[0], target[1], item_idx] -= 1\n          if grid[target[0], target[1], item_idx] == 0:\n              if non_grabbable:\n                  blocked_mask[target[0], target[1]] = np.any(\n                      grid[target[0], target[1], non_grabbable] > 0\n                  )\n              else:\n                  blocked_mask[target[0], target[1]] = False\n\n  # ------------------------------------------------------------------\n  # 2. If a workshop is required, go there and craft the stick\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = idx[workshop_name]\n      ws_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_locs.size:\n          # pick the nearest workshop\n          dists = np.abs(ws_locs[:, 0] - cur_pos[0]) + np.abs(ws_locs[:, 1] - cur_pos[1])\n          ws_target = tuple(ws_locs[dists.argmin()])\n\n          path = bfs_path(cur_pos, {ws_target}, blocked_mask)\n          actions.extend(path)\n          cur_pos = ws_target\n          actions.append(USE)      # craft at the workshop\n\n  return actions", "env_interactions": 4, "island_id": 0, "scores": {"3": 0.0}}
