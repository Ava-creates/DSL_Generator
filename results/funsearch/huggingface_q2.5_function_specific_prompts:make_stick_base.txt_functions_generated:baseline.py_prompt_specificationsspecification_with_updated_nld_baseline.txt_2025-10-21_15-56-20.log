{"timestamp": "2025-10-21T20:56:39.444437", "function_name": "make_stick", "function_body": "  state = env._current_state\n  world = env.world\n  goal_idx = env.task.goal\n\n  # map action names to indices\n  action_map = {name: idx for idx, name in env.action_specs().items()}\n\n  def path_actions(start, target):\n      ax, ay = start\n      tx, ty = target\n      acts = []\n      # horizontal\n      while ax < tx:\n          acts.append(action_map[\"RIGHT\"])\n          ax += 1\n      while ax > tx:\n          acts.append(action_map[\"LEFT\"])\n          ax -= 1\n      # vertical\n      while ay < ty:\n          acts.append(action_map[\"DOWN\"])\n          ay += 1\n      while ay > ty:\n          acts.append(action_map[\"UP\"])\n          ay -= 1\n      return acts\n\n  actions = []\n  cur_pos = state.pos\n\n  # 1. collect primitives\n  prim_needs = world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  for kind, count in prim_needs.items():\n      # locate all cells that currently contain this kind\n      positions = list(zip(*np.where(state.grid[:, :, kind] > 0)))\n      if not positions:\n          # primitive not present; cannot fulfill task\n          continue\n      # simple nearest selection each time\n      for _ in range(count):\n          # recompute positions because grid may have changed after pickups\n          positions = list(zip(*np.where(state.grid[:, :, kind] > 0)))\n          if not positions:\n              break\n          # choose position with minimal manhattan distance\n          target = min(positions, key=lambda p: abs(p[0]-cur_pos[0]) + abs(p[1]-cur_pos[1]))\n          actions.extend(path_actions(cur_pos, target))\n          cur_pos = target\n          actions.append(action_map[\"USE\"])   # pick up\n          # after use, the cell will be empty; we don't update state.grid here\n\n  # 2. move to workshop and craft\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      # find a workshop cell\n      workshop_positions = list(zip(*np.where(state.grid[:, :, workshop_kind] > 0)))\n      if workshop_positions:\n          target = min(workshop_positions, key=lambda p: abs(p[0]-cur_pos[0]) + abs(p[1]-cur_pos[1]))\n          actions.extend(path_actions(cur_pos, target))\n          cur_pos = target\n  # finally use to craft (or if no workshop, just use at current pos)\n  actions.append(action_map[\"USE\"])\n  return actions", "env_interactions": 0, "island_id": 5, "scores": {"3": -1}}
