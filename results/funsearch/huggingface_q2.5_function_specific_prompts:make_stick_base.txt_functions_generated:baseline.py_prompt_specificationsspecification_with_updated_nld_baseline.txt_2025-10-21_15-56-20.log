{"timestamp": "2025-10-21T18:51:48.756116", "function_name": "make_stick", "function_body": "  # Determine the numeric IDs for the possible actions.\n  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      # Fallback to the default ordering used by CraftWorld.\n      action_ids = [0, 1, 2, 3, 4]  # DOWN, UP, LEFT, RIGHT, USE\n\n  # Get the internal index for the primitive/item named \"stick\".\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n  if stick_idx is None:\n      # No stick defined in this world \u2013 nothing we can do.\n      return []\n\n  # Ensure the environment has been reset and fetch the current state.\n  if not hasattr(env, \"_current_state\") or env._current_state is None:\n      env.reset()\n  start_state = env._current_state\n\n  # If the agent already holds a stick, we are done.\n  if start_state.inventory[stick_idx] > 0:\n      return []\n\n  from collections import deque\n\n  # Helper that creates a hashable representation of a state for the visited set.\n  def _state_key(st):\n      # Position, direction, inventory and the whole grid uniquely identify the world.\n      return (st.pos, st.dir, st.inventory.tobytes(), st.grid.tobytes())\n\n  visited = {_state_key(start_state)}\n  frontier = deque()\n  frontier.append((start_state, []))\n\n  # Upper bound on the length of a plan we are willing to search.\n  MAX_PLAN_LEN = 300\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      # Goal test \u2013 we have at least one stick in the inventory.\n      if cur_state.inventory[stick_idx] > 0:\n          return cur_plan\n\n      # Do not expand paths that are already too long.\n      if len(cur_plan) >= MAX_PLAN_LEN:\n          continue\n\n      # Expand all possible actions.\n      for a in action_ids:\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((next_state, cur_plan + [a]))\n\n  # If we exit the loop no plan was found within the limits.\n  return []", "env_interactions": 4, "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T18:51:49.887626", "function_name": "make_stick", "function_body": "  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      action_ids = [0, 1, 2, 3, 4]\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n  if stick_idx is None:\n      return []\n  if not hasattr(env, \"_current_state\") or env._current_state is None:\n      env.reset()\n  start_state = env._current_state\n  if start_state.inventory[stick_idx] > 0:\n      return []\n  from collections import deque\n  def _state_key(st):\n      return (st.pos, st.dir, st.inventory.tobytes(), st.grid.tobytes())\n  visited = {_state_key(start_state)}\n  frontier = deque()\n  frontier.append((start_state, []))\n  max_plan_len = 300\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n      if cur_state.inventory[stick_idx] > 0:\n          return cur_plan\n      if len(cur_plan) >= max_plan_len:\n          continue\n      for a in action_ids:\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((next_state, cur_plan + [a]))\n  return []", "env_interactions": 4, "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T18:52:20.158380", "function_name": "make_stick", "function_body": "  # reset environment to start fresh\n  env.reset()\n  world = env.world\n  idx = world.cookbook.index\n\n  # ------------------------------------------------------------------\n  # Identify the goal item (stick) and its recipe\n  # ------------------------------------------------------------------\n  try:\n      stick_idx = idx[\"stick\"]\n  except Exception:  # pragma: no cover\n      # fallback case\u2011insensitive search\n      stick_idx = next(i for i, n in enumerate(idx.ordered_contents) if n.lower() == \"stick\")\n  stick_recipe = world.cookbook.recipes.get(stick_idx, {})\n\n  # ------------------------------------------------------------------\n  # Determine which primitives are required to craft a stick\n  # ------------------------------------------------------------------\n  needed = world.cookbook.primitives_for(stick_idx)\n  if not needed:                                    # stick itself is primitive\n      needed = {stick_idx: 1}\n\n  # ------------------------------------------------------------------\n  # Action index mapping\n  # ------------------------------------------------------------------\n  action_map = env.action_specs()\n  DOWN = action_map[\"DOWN\"]\n  UP = action_map[\"UP\"]\n  LEFT = action_map[\"LEFT\"]\n  RIGHT = action_map[\"RIGHT\"]\n  USE = action_map[\"USE\"]\n\n  # ------------------------------------------------------------------\n  # Current state snapshot (used only for planning)\n  # ------------------------------------------------------------------\n  state = env._current_state\n  cur_pos = tuple(state.pos)                       # (x, y)\n  grid = state.grid.copy()                         # keep a local mutable copy\n\n  # cells occupied by non\u2011grabbable entities block movement\n  non_grabbable = list(world.non_grabbable_indices)\n  if non_grabbable:\n      blocked = np.any(grid[:, :, non_grabbable] > 0, axis=2)\n  else:\n      blocked = np.zeros(grid.shape[:2], dtype=bool)\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions to reach any target cell\n  # ------------------------------------------------------------------\n  import collections\n\n  def bfs_path(start, targets, blocked_mask):\n      \"\"\"Return list of actions from start to the nearest cell in targets.\"\"\"\n      if start in targets:\n          return []\n      q = collections.deque([start])\n      visited = {start: (None, None)}          # node -> (parent, action)\n      while q:\n          cur = q.popleft()\n          for act, (dx, dy) in ((DOWN, (0, 1)), (UP, (0, -1)),\n                                (LEFT, (-1, 0)), (RIGHT, (1, 0))):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if not (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]):\n                  continue\n              if blocked_mask[nx, ny]:\n                  continue\n              nxt = (nx, ny)\n              if nxt in visited:\n                  continue\n              visited[nxt] = (cur, act)\n              if nxt in targets:\n                  # reconstruct path\n                  path = []\n                  node = nxt\n                  while visited[node][0] is not None:\n                      parent, a = visited[node]\n                      path.append(a)\n                      node = parent\n                  return list(reversed(path))\n              q.append(nxt)\n      # Fallback: straight Manhattan moves (ignores obstacles)\n      tx, ty = next(iter(targets))\n      return manhattan_moves(start, (tx, ty))\n\n  def manhattan_moves(start, goal):\n      \"\"\"Simple Manhattan move sequence (ignores obstacles).\"\"\"\n      x, y = start\n      gx, gy = goal\n      moves = []\n      while x < gx:\n          moves.append(RIGHT)\n          x += 1\n      while x > gx:\n          moves.append(LEFT)\n          x -= 1\n      while y < gy:\n          moves.append(DOWN)\n          y += 1\n      while y > gy:\n          moves.append(UP)\n          y -= 1\n      return moves\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives\n  # ------------------------------------------------------------------\n  for item_idx, total_needed in needed.items():\n      total_needed = int(total_needed)\n      while total_needed > 0:\n          # locate all cells that currently contain the needed item\n          locations = np.argwhere(grid[:, :, item_idx] > 0)\n          if locations.size == 0:\n              # no more of this item on the map; abort collection for safety\n              break\n          # choose the closest location (Manhattan distance heuristic)\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          target = tuple(locations[dists.argmin()])\n\n          # move to the target while respecting blocked cells\n          path = bfs_path(cur_pos, {target}, blocked)\n          actions.extend(path)\n          cur_pos = target\n\n          # pick up the item\n          actions.append(USE)\n          total_needed -= 1\n\n          # update our simulated world representation\n          grid[target[0], target[1], item_idx] -= 1\n          if grid[target[0], target[1], item_idx] == 0:\n              # recompute blocked status for this cell (may become free)\n              if non_grabbable:\n                  blocked[target[0], target[1]] = np.any(\n                      grid[target[0], target[1], non_grabbable] > 0\n                  )\n              else:\n                  blocked[target[0], target[1]] = False\n\n  # ------------------------------------------------------------------\n  # 2. Move to the required workshop (if any) and craft the stick\n  # ------------------------------------------------------------------\n  workshop_name = stick_recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = idx[workshop_name]\n      ws_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_locs.size > 0:\n          ws_target = tuple(ws_locs[0])\n          path = bfs_path(cur_pos, {ws_target}, blocked)\n          actions.extend(path)\n          cur_pos = ws_target\n          actions.append(USE)      # craft at the workshop\n\n  return actions", "env_interactions": 4, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:52:21.290435", "function_name": "make_stick", "function_body": "  # reset environment to start fresh\n  env.reset()\n  world = env.world\n  idx = world.cookbook.index\n\n  # ------------------------------------------------------------\n  # identify stick goal and its recipe / required primitives\n  # ------------------------------------------------------------\n  try:\n      stick_idx = idx[\"stick\"]\n  except Exception:  # pragma: no cover\n      stick_idx = next(i for i, n in enumerate(idx.ordered_contents) if n.lower() == \"stick\")\n  stick_recipe = world.cookbook.recipes.get(stick_idx, {})\n\n  needed = world.cookbook.primitives_for(stick_idx)\n  if not needed:  # stick itself is primitive\n      needed = {stick_idx: 1}\n\n  # ------------------------------------------------------------\n  # action mapping\n  # ------------------------------------------------------------\n  act_map = env.action_specs()\n  DOWN = act_map[\"DOWN\"]\n  UP = act_map[\"UP\"]\n  LEFT = act_map[\"LEFT\"]\n  RIGHT = act_map[\"RIGHT\"]\n  USE = act_map[\"USE\"]\n\n  # ------------------------------------------------------------\n  # current simulated state (position and grid)\n  # ------------------------------------------------------------\n  state = env._current_state\n  cur_pos = tuple(state.pos)               # (x, y)\n  grid = state.grid.copy()                 # shape (W, H, n_kinds)\n\n  # ------------------------------------------------------------\n  # helper: blocked cells (any non\u2011grabbable entity present)\n  # ------------------------------------------------------------\n  non_grabbable = list(world.non_grabbable_indices)\n\n  def blocked_mask_from_grid(g):\n      if non_grabbable:\n          return np.any(g[:, :, non_grabbable] > 0, axis=2)\n      return np.zeros(g.shape[:2], dtype=bool)\n\n  blocked = blocked_mask_from_grid(grid)\n\n  # ------------------------------------------------------------\n  # helper: BFS to obtain list of actions from start to any target cell\n  # ------------------------------------------------------------\n  import collections\n\n  move_dirs = {\n      DOWN: (0, 1),\n      UP: (0, -1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  def bfs_path(start, targets, blocked_cells):\n      \"\"\"Return a list of actions moving from start to the nearest cell in targets.\"\"\"\n      if start in targets:\n          return []\n      q = collections.deque([start])\n      visited = {start: (None, None)}  # pos -> (parent, action)\n      while q:\n          cur = q.popleft()\n          for a, (dx, dy) in move_dirs.items():\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if not (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]):\n                  continue\n              if blocked_cells[nx, ny]:\n                  continue\n              nxt = (nx, ny)\n              if nxt in visited:\n                  continue\n              visited[nxt] = (cur, a)\n              if nxt in targets:\n                  # reconstruct path\n                  path = []\n                  node = nxt\n                  while visited[node][0] is not None:\n                      parent, act = visited[node]\n                      path.append(act)\n                      node = parent\n                  return list(reversed(path))\n              q.append(nxt)\n      # fallback: direct Manhattan moves (ignores obstacles)\n      tx, ty = next(iter(targets))\n      return manhattan_moves(start, (tx, ty))\n\n  def manhattan_moves(start, goal):\n      \"\"\"Simple Manhattan moves ignoring obstacles.\"\"\"\n      x, y = start\n      gx, gy = goal\n      moves = []\n      while x < gx:\n          moves.append(RIGHT); x += 1\n      while x > gx:\n          moves.append(LEFT);  x -= 1\n      while y < gy:\n          moves.append(DOWN);  y += 1\n      while y > gy:\n          moves.append(UP);    y -= 1\n      return moves\n\n  actions = []\n\n  # ------------------------------------------------------------\n  # 1. Collect all required primitives / items\n  # ------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      cnt = int(cnt)\n      while cnt > 0:\n          locations = np.argwhere(grid[:, :, prim_idx] > 0)\n          if locations.size == 0:\n              # primitive not present \u2013 break to avoid endless loop\n              break\n          # choose nearest location (Manhattan distance)\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          target = tuple(locations[dists.argmin()])\n\n          # move to target\n          path = bfs_path(cur_pos, {target}, blocked)\n          actions.extend(path)\n          cur_pos = target\n\n          # pick up\n          actions.append(USE)\n          cnt -= 1\n\n          # update simulated grid\n          grid[target[0], target[1], prim_idx] -= 1\n          # recompute blocked mask for this cell (only non\u2011grabbable matters)\n          if non_grabbable:\n              blocked[target[0], target[1]] = np.any(grid[target[0], target[1], non_grabbable] > 0)\n\n  # ------------------------------------------------------------\n  # 2. Go to workshop (if required) and craft the stick\n  # ------------------------------------------------------------\n  workshop_name = stick_recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = idx[workshop_name]\n      ws_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_locs.size > 0:\n          ws_target = tuple(ws_locs[0])\n          path = bfs_path(cur_pos, {ws_target}, blocked)\n          actions.extend(path)\n          cur_pos = ws_target\n          actions.append(USE)   # craft at workshop\n\n  return actions", "env_interactions": 4, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:52:56.830125", "function_name": "make_stick", "function_body": "", "env_interactions": 0, "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-10-21T18:52:57.959446", "function_name": "make_stick", "function_body": "  # Reset environment to start fresh\n  env.reset()\n  state = env._current_state\n  world = env.world\n\n  # Mapping from movement delta to action index used by CraftLab\n  DIR_TO_ACTION = {\n      (1, 0): 3,   # RIGHT\n      (-1, 0): 2,  # LEFT\n      (0, 1): 0,   # DOWN\n      (0, -1): 1,  # UP\n  }\n\n  # Breadth\u2011first search that returns a list of (dx, dy) moves from start to goal.\n  # Cells that contain any entity are considered blocked, except when the cell\n  # holds the allowed index (target primitive or workshop).\n  from collections import deque\n\n  def bfs(start, goal, grid, allow_idx=None):\n      \"\"\"Return list of (dx, dy) steps from start (exclusive) to goal (inclusive).\"\"\"\n      W, H, _ = grid.shape\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = {(start[0], start[1])}\n      while q:\n          x, y, path = q.popleft()\n          if (x, y) == (goal[0], goal[1]):\n              return path\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in visited:\n                  cell = grid[nx, ny, :]\n                  blocked = cell.sum() > 0\n                  if blocked and allow_idx is not None and cell[allow_idx] > 0:\n                      blocked = False\n                  if not blocked:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [(dx, dy)]))\n      # No path found \u2013 return empty list (should not happen in valid scenarios)\n      return []\n\n  # ------------------------------------------------------------------\n  # Determine primitives required to craft a stick\n  # ------------------------------------------------------------------\n  stick_idx = world.cookbook.index[\"stick\"]\n  primitive_requirements = world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n  cur_pos = list(state.pos)  # mutable current position [x, y]\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_requirements.items():\n      for _ in range(needed_cnt):\n          # Locate a remaining primitive of this type\n          locations = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if locations.size == 0:\n              # No more of this primitive on the map \u2013 break early\n              break\n          target = tuple(locations[0])  # (x, y)\n\n          # Compute path to the primitive (allow stepping onto its cell)\n          path = bfs(tuple(cur_pos), target, state.grid, allow_idx=prim_idx)\n\n          # Translate path deltas into actions and update current position\n          for dx, dy in path:\n              actions.append(DIR_TO_ACTION[(dx, dy)])\n              cur_pos[0] += dx\n              cur_pos[1] += dy\n\n          # Pick up the primitive\n          actions.append(4)  # USE\n          # Update grid to reflect that the primitive has been taken\n          state.grid[target[0], target[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Move to the appropriate workshop and craft the stick\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      wk_locations = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if wk_locations.size:\n          workshop_pos = tuple(wk_locations[0])\n          # Path to workshop (allow stepping onto workshop cell)\n          path = bfs(tuple(cur_pos), workshop_pos, state.grid, allow_idx=workshop_idx)\n          for dx, dy in path:\n              actions.append(DIR_TO_ACTION[(dx, dy)])\n              cur_pos[0] += dx\n              cur_pos[1] += dy\n\n  # Finally, use the workshop (or the current cell) to craft the stick\n  actions.append(4)  # USE\n\n  return actions", "env_interactions": 4, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:53:33.807445", "function_name": "make_stick", "function_body": "  env.reset()\n  world = env.world\n  idx = world.cookbook.index\n\n  # action indices\n  action_map = env.action_specs()\n  DOWN = action_map[\"DOWN\"]\n  UP = action_map[\"UP\"]\n  LEFT = action_map[\"LEFT\"]\n  RIGHT = action_map[\"RIGHT\"]\n  USE = action_map[\"USE\"]\n\n  # get stick index (case\u2011insensitive fallback)\n  try:\n      stick_idx = idx[\"stick\"]\n  except Exception:  # pragma: no cover\n      stick_idx = next(i for i, n in enumerate(idx.ordered_contents) if n.lower() == \"stick\")\n\n  # primitives required to craft a stick; if empty, stick itself is a primitive\n  needed = world.cookbook.primitives_for(stick_idx)\n  if not needed:\n      needed = {stick_idx: 1}\n\n  # current simulated state\n  state = env._current_state\n  cur_pos = tuple(state.pos)\n  grid = state.grid.copy()\n\n  # cells that are blocked because they contain non\u2011grabbable entities\n  non_grabbable = list(world.non_grabbable_indices)\n  if non_grabbable:\n      blocked = np.any(grid[:, :, non_grabbable] > 0, axis=2)\n  else:\n      blocked = np.zeros(grid.shape[:2], dtype=bool)\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # BFS that returns a list of actions to reach any target cell while\n  # avoiding blocked cells.\n  # ------------------------------------------------------------------\n  def bfs_path(start, targets, blocked_mask):\n      \"\"\"Return actions (list) to reach the nearest cell in *targets*.\"\"\"\n      if start in targets:\n          return []\n      from collections import deque\n\n      q = deque([start])\n      visited = {start: (None, None)}  # node -> (parent, action)\n\n      while q:\n          cur = q.popleft()\n          for act, (dx, dy) in (\n              (DOWN, (0, 1)),\n              (UP, (0, -1)),\n              (LEFT, (-1, 0)),\n              (RIGHT, (1, 0)),\n          ):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if not (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]):\n                  continue\n              if blocked_mask[nx, ny]:\n                  continue\n              nxt = (nx, ny)\n              if nxt in visited:\n                  continue\n              visited[nxt] = (cur, act)\n              if nxt in targets:\n                  # reconstruct path\n                  path = []\n                  node = nxt\n                  while visited[node][0] is not None:\n                      parent, a = visited[node]\n                      path.append(a)\n                      node = parent\n                  return list(reversed(path))\n              q.append(nxt)\n\n      # fallback: direct Manhattan moves (ignores obstacles)\n      target = next(iter(targets))\n      tx, ty = target\n      x, y = start\n      path = []\n      while x < tx:\n          path.append(RIGHT); x += 1\n      while x > tx:\n          path.append(LEFT); x -= 1\n      while y < ty:\n          path.append(DOWN); y += 1\n      while y > ty:\n          path.append(UP); y -= 1\n      return path\n\n  # ------------------------------------------------------------------\n  # 1. Collect each required primitive (or the stick itself)\n  # ------------------------------------------------------------------\n  for item_idx, cnt in needed.items():\n      remaining = int(cnt)\n      while remaining > 0:\n          # locate cells that still contain the item\n          locations = np.argwhere(grid[:, :, item_idx] > 0)\n          if locations.size == 0:\n              # nothing left on the map \u2013 give up\n              break\n          # pick the nearest location (Manhattan distance)\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          target = tuple(locations[dists.argmin()])\n\n          # move to the target\n          actions.extend(bfs_path(cur_pos, {target}, blocked))\n          cur_pos = target\n\n          # pick up one unit\n          actions.append(USE)\n          remaining -= 1\n\n          # update simulated grid and blocked mask\n          grid[target[0], target[1], item_idx] -= 1\n          if non_grabbable:\n              blocked[target[0], target[1]] = np.any(\n                  grid[target[0], target[1], non_grabbable] > 0\n              )\n\n  # ------------------------------------------------------------------\n  # 2. If a workshop is required, go there and craft\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = idx[workshop_name]\n      ws_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_locs.size:\n          ws_target = tuple(ws_locs[0])\n          actions.extend(bfs_path(cur_pos, {ws_target}, blocked))\n          cur_pos = ws_target\n          actions.append(USE)  # craft at workshop\n\n  return actions", "env_interactions": 4, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:53:34.929871", "function_name": "make_stick", "function_body": "  # Reset environment to a fresh start\n  env.reset()\n  world = env.world\n  idx = world.cookbook.index\n\n  # ------------------------------------------------------------------\n  # Action indices (environment specific)\n  # ------------------------------------------------------------------\n  action_map = env.action_specs()\n  DOWN = action_map[\"DOWN\"]\n  UP = action_map[\"UP\"]\n  LEFT = action_map[\"LEFT\"]\n  RIGHT = action_map[\"RIGHT\"]\n  USE = action_map[\"USE\"]\n\n  # ------------------------------------------------------------------\n  # Identify the index for the target item \"stick\"\n  # ------------------------------------------------------------------\n  try:\n      stick_idx = idx[\"stick\"]\n  except Exception:  # pragma: no cover\n      # fallback: case\u2011insensitive search\n      stick_idx = next(i for i, n in enumerate(idx.ordered_contents) if n.lower() == \"stick\")\n\n  # ------------------------------------------------------------------\n  # Determine which primitive items must be collected.\n  # If the recipe is empty, stick itself is a primitive.\n  # ------------------------------------------------------------------\n  needed_prims = world.cookbook.primitives_for(stick_idx)\n  if needed_prims:\n      needed_items = needed_prims          # {prim_idx: count}\n  else:\n      needed_items = {stick_idx: 1}        # just pick up a stick\n\n  # ------------------------------------------------------------------\n  # Simulated view of the grid and blocked cells (non\u2011grabbable entities)\n  # ------------------------------------------------------------------\n  state = env._current_state\n  cur_pos = tuple(state.pos)               # (x, y)\n  grid = state.grid.copy()                 # mutable copy for bookkeeping\n\n  non_grabbable = list(world.non_grabbable_indices)\n  if non_grabbable:\n      blocked_mask = np.any(grid[:, :, non_grabbable] > 0, axis=2)\n  else:\n      blocked_mask = np.zeros(grid.shape[:2], dtype=bool)\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions to reach the nearest target\n  # while avoiding blocked cells.\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  def bfs_path(start, targets, blocked):\n      \"\"\"Return a list of actions to reach any cell in *targets* from *start*.\n      If no path exists, fall back to Manhattan moves (ignoring obstacles).\"\"\"\n      if start in targets:\n          return []\n\n      q = deque([start])\n      # visited maps position -> (parent_position, action_taken_to_reach)\n      visited = {start: (None, None)}\n\n      while q:\n          cur = q.popleft()\n          for act, (dx, dy) in (\n              (DOWN, (0, 1)),\n              (UP, (0, -1)),\n              (LEFT, (-1, 0)),\n              (RIGHT, (1, 0)),\n          ):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if not (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]):\n                  continue\n              if blocked[nx, ny]:\n                  continue\n              nxt = (nx, ny)\n              if nxt in visited:\n                  continue\n              visited[nxt] = (cur, act)\n              if nxt in targets:\n                  # reconstruct path\n                  path = []\n                  node = nxt\n                  while visited[node][0] is not None:\n                      parent, a = visited[node]\n                      path.append(a)\n                      node = parent\n                  return list(reversed(path))\n              q.append(nxt)\n\n      # ------------------------------------------------------------------\n      # No walkable path found \u2013 use simple Manhattan moves (ignores obstacles)\n      # ------------------------------------------------------------------\n      target = next(iter(targets))\n      x, y = start\n      tx, ty = target\n      path = []\n      while x < tx:\n          path.append(RIGHT)\n          x += 1\n      while x > tx:\n          path.append(LEFT)\n          x -= 1\n      while y < ty:\n          path.append(DOWN)\n          y += 1\n      while y > ty:\n          path.append(UP)\n          y -= 1\n      return path\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives (or the stick itself)\n  # ------------------------------------------------------------------\n  for item_idx, need_cnt in needed_items.items():\n      remaining = int(need_cnt)\n      while remaining > 0:\n          # locate cells that currently contain the required item\n          locations = np.argwhere(grid[:, :, item_idx] > 0)\n          if locations.size == 0:\n              # nothing left on the map \u2013 abort collection for this item\n              break\n\n          # choose the nearest location (Manhattan distance heuristic)\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          target = tuple(locations[dists.argmin()])\n\n          # compute a walkable path to the target cell\n          path = bfs_path(cur_pos, {target}, blocked_mask)\n          actions.extend(path)\n          cur_pos = target\n\n          # pick up the item (USE once per unit)\n          actions.append(USE)\n          remaining -= 1\n\n          # update simulated grid and blocked mask after the pickup\n          grid[target[0], target[1], item_idx] -= 1\n          if non_grabbable:\n              blocked_mask[target[0], target[1]] = np.any(\n                  grid[target[0], target[1], non_grabbable] > 0\n              )\n\n  # ------------------------------------------------------------------\n  # 2. If a workshop is required for the stick, move there and craft\n  # ------------------------------------------------------------------\n  stick_recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = stick_recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = idx[workshop_name]\n      ws_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_locs.size:\n          ws_target = tuple(ws_locs[0])\n          path = bfs_path(cur_pos, {ws_target}, blocked_mask)\n          actions.extend(path)\n          cur_pos = ws_target\n          actions.append(USE)   # craft at the workshop\n\n  return actions", "env_interactions": 4, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:54:03.229845", "function_name": "make_stick", "function_body": "  env.reset()\n  state = env._current_state\n\n  # Index of the goal item (stick)\n  goal_idx = env.task.goal\n\n  # Mapping from primitive kind index to required counts for one stick\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)\n\n  plan = []\n\n  # Helper to move the agent to a target cell using Manhattan moves.\n  def _move_to(target):\n      actions = []\n      nonlocal state\n      while tuple(state.pos) != target:\n          r, c = state.pos\n          tr, tc = target\n          if r < tr:\n              act = 0          # DOWN\n          elif r > tr:\n              act = 1          # UP\n          elif c < tc:\n              act = 3          # RIGHT\n          else:\n              act = 2          # LEFT\n          actions.append(act)\n          _, new_state = env.step(act)\n          state = new_state\n      return actions\n\n  # 1. Collect all required primitives (in the needed quantities)\n  for prim_idx, count in primitives_needed.items():\n      for _ in range(count):\n          # Find all cells that currently contain this primitive\n          locations = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if locations.shape[0] == 0:\n              # No more instances left \u2013 should not happen in a solvable scenario\n              continue\n\n          # Choose the closest instance (Manhattan distance)\n          cur_pos = np.array(state.pos)\n          dists = np.abs(locations - cur_pos).sum(axis=1)\n          target = tuple(locations[dists.argmin()])\n\n          # Move to the primitive and pick it up (USE)\n          plan.extend(_move_to(target))\n          plan.append(4)                     # USE action\n          _, new_state = env.step(4)\n          state = new_state\n\n  # 2. Go to the required workshop (if any) and craft the stick\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = recipe.get(\"_at\", None)\n\n  if workshop_idx is not None:\n      # Locate all workshop cells of the required type\n      workshop_locs = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_locs.shape[0] > 0:\n          cur_pos = np.array(state.pos)\n          dists = np.abs(workshop_locs - cur_pos).sum(axis=1)\n          target = tuple(workshop_locs[dists.argmin()])\n\n          # Move to the workshop and use the crafting action\n          plan.extend(_move_to(target))\n          plan.append(4)                     # USE to craft\n          _, new_state = env.step(4)\n          state = new_state\n\n  # Return the complete list of action indices that will make a stick\n  return plan", "env_interactions": 0, "island_id": 9, "scores": {"3": 0.0}}
