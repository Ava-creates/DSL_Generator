{"timestamp": "2025-10-21T21:50:04.179179", "function_name": "make_stick", "function_body": "  # Reset environment and get references\n  env.reset()\n  world = env.world\n  scenario = env.scenario\n\n  # Action indices as defined by CraftLab.action_specs()\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  # Index of the target item \"stick\"\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # Determine primitive ingredients required for a stick.\n  # If the recipe has no ingredients, the stick itself is a primitive.\n  primitives_needed = world.cookbook.primitives_for(stick_idx)\n  if not primitives_needed:\n      primitives_needed = {stick_idx: 1}\n\n  # Work on a mutable copy of the initial grid for planning.\n  grid = scenario.init_grid.copy()\n  pos = scenario.init_pos          # current agent position (x, y)\n  actions = []                     # list of action indices to return\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  def bfs(start, goal):\n      \"\"\"Return a list of movement actions from start to goal avoiding occupied cells.\"\"\"\n      W, H = grid.shape[:2]\n      visited = set([start])\n      q = deque([(start, [])])\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for act, (dx, dy) in (\n              (ACTION_DOWN, (0, 1)),\n              (ACTION_UP, (0, -1)),\n              (ACTION_LEFT, (-1, 0)),\n              (ACTION_RIGHT, (1, 0)),\n          ):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in visited:\n                  # walkable if the cell is empty (no entity)\n                  if np.any(grid[nx, ny, :] != 0):\n                      continue\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [act]))\n      return []  # unreachable \u2013 should not happen on valid maps\n\n  def free_adjacent(cell):\n      \"\"\"Return list of free (unoccupied) cells adjacent to `cell`.\"\"\"\n      adj = []\n      x, y = cell\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          ax, ay = x + dx, y + dy\n          if 0 <= ax < grid.shape[0] and 0 <= ay < grid.shape[1]:\n              if not np.any(grid[ax, ay, :] != 0):\n                  adj.append((ax, ay))\n      return adj\n\n  def direction_action(dx, dy):\n      \"\"\"Map a delta (dx, dy) to the corresponding movement action.\"\"\"\n      if dx == -1 and dy == 0:\n          return ACTION_LEFT\n      if dx == 1 and dy == 0:\n          return ACTION_RIGHT\n      if dx == 0 and dy == -1:\n          return ACTION_UP\n      if dx == 0 and dy == 1:\n          return ACTION_DOWN\n      return None\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitive items\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      for _ in range(needed_cnt):\n          # Find any remaining instance of this primitive on the map\n          locations = np.argwhere(grid[:, :, prim_idx] > 0)\n          if len(locations) == 0:\n              continue  # nothing left; should not happen\n          target = tuple(locations[0])  # (x, y)\n\n          # Find a free adjacent cell from which we can interact with the primitive\n          adj_cells = free_adjacent(target)\n          chosen_adj = None\n          path_to_adj = None\n          for adj in adj_cells:\n              p = bfs(pos, adj)\n              if p:\n                  chosen_adj = adj\n                  path_to_adj = p\n                  break\n\n          if path_to_adj is None:\n              continue  # cannot reach a usable position\n\n          # Move to the chosen adjacent cell\n          actions.extend(path_to_adj)\n          pos = chosen_adj\n\n          # Move onto the primitive cell, USE, then step back\n          dx, dy = target[0] - pos[0], target[1] - pos[1]\n          step_act = direction_action(dx, dy)\n          if step_act is not None:\n              actions.append(step_act)          # step onto primitive\n              actions.append(ACTION_USE)        # collect it\n              # Step back to the adjacent cell\n              back_act = direction_action(-dx, -dy)\n              if back_act is not None:\n                  actions.append(back_act)\n              # Position ends up back at the adjacent cell (pos unchanged)\n          else:\n              # If already on the cell (unlikely), just USE\n              actions.append(ACTION_USE)\n\n          # Update local grid copy (remove the collected primitive)\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # ------------------------------------------------------------------\n  # 2. Craft the stick at its required workshop (if any)\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if len(workshop_cells) > 0:\n          workshop_pos = tuple(workshop_cells[0])\n\n          # Find a free adjacent cell next to the workshop\n          adj_cells = free_adjacent(workshop_pos)\n          chosen_adj = None\n          path_to_adj = None\n          for adj in adj_cells:\n              p = bfs(pos, adj)\n              if p:\n                  chosen_adj = adj\n                  path_to_adj = p\n                  break\n\n          if path_to_adj is not None:\n              # Move to the adjacent cell\n              actions.extend(path_to_adj)\n              pos = chosen_adj\n\n              # Step onto the workshop cell and USE to craft\n              dx, dy = workshop_pos[0] - pos[0], workshop_pos[1] - pos[1]\n              step_act = direction_action(dx, dy)\n              if step_act is not None:\n                  actions.append(step_act)      # step onto workshop\n                  actions.append(ACTION_USE)    # craft stick\n                  # Optional step back\n                  back_act = direction_action(-dx, -dy)\n                  if back_act is not None:\n                      actions.append(back_act)\n              else:\n                  actions.append(ACTION_USE)\n  else:\n      # No specific workshop \u2013 just USE in place to craft\n      actions.append(ACTION_USE)\n\n  # Return the compiled action sequence\n  return actions", "env_interactions": 9, "island_id": 1, "scores": {"3": 0.0}}
