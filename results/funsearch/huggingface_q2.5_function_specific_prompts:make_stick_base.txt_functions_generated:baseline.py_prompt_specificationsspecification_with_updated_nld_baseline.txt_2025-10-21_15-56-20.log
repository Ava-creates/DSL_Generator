{"timestamp": "2025-10-21T21:37:37.490892", "function_name": "make_stick", "function_body": "  # Determine the action identifiers (order may vary across environments)\n  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      # Default ordering used by CraftWorld: DOWN, UP, LEFT, RIGHT, USE\n      action_ids = [0, 1, 2, 3, 4]\n\n  # Resolve the internal index for the target item \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n  if stick_idx is None:\n      # Stick not defined in this world \u2013 nothing to do.\n      return []\n\n  # Ensure the environment is reset and obtain the initial state\n  if not hasattr(env, \"_current_state\") or env._current_state is None:\n      env.reset()\n  start_state = env._current_state\n\n  # If we already have a stick, no actions are needed.\n  if start_state.inventory[stick_idx] > 0:\n      return []\n\n  from collections import deque\n\n  # Helper to create a hashable representation of a state.\n  def _state_key(st):\n      # Include position, direction, inventory and full grid layout.\n      return (st.pos, st.dir, st.inventory.tobytes(), st.grid.tobytes())\n\n  visited = {_state_key(start_state)}\n  frontier = deque([(start_state, [])])\n\n  MAX_PLAN_LENGTH = 500  # safety bound to keep search tractable\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      # Goal test: have at least one stick in inventory.\n      if cur_state.inventory[stick_idx] > 0:\n          return cur_plan\n\n      # Do not expand beyond the maximum allowed depth.\n      if len(cur_plan) >= MAX_PLAN_LENGTH:\n          continue\n\n      # Explore all possible actions from the current state.\n      for a in action_ids:\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((next_state, cur_plan + [a]))\n\n  # No feasible plan found within limits.\n  return []", "env_interactions": 4, "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T21:37:51.848517", "function_name": "make_stick", "function_body": "  import collections\n  from collections import deque\n\n  # ------------------------------------------------------------------\n  # Helper: retrieve the list of action IDs from the environment.\n  # ------------------------------------------------------------------\n  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      # Fallback to the default ordering used by CraftWorld.\n      action_ids = [0, 1, 2, 3, 4]  # DOWN, UP, LEFT, RIGHT, USE\n\n  # ------------------------------------------------------------------\n  # Helper: obtain the internal index for the item \"stick\".\n  # ------------------------------------------------------------------\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n\n  # ------------------------------------------------------------------\n  # Starting state: use the current state if exposed, otherwise initialise.\n  # ------------------------------------------------------------------\n  start_state = getattr(env, \"_current_state\", None)\n  if start_state is None:\n      start_state = env.scenario.init()\n\n  # ------------------------------------------------------------------\n  # Goal test.\n  # ------------------------------------------------------------------\n  def is_goal(state):\n      return stick_idx is not None and state.satisfies(\"\", stick_idx)\n\n  # ------------------------------------------------------------------\n  # Compact representation of a state for visited\u2011state tracking.\n  # Includes position, direction, inventory and full grid layout.\n  # ------------------------------------------------------------------\n  def state_key(state):\n      return (state.pos, state.dir,\n              state.inventory.tobytes(),\n              state.grid.tobytes())\n\n  # ------------------------------------------------------------------\n  # Bread\u2011first search over deterministic transitions.\n  # ------------------------------------------------------------------\n  MAX_PLAN_LEN = 400  # safety bound on plan length\n  frontier = deque()\n  frontier.append((start_state, []))\n  visited = {state_key(start_state)}\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      if is_goal(cur_state):\n          return cur_plan\n\n      if len(cur_plan) >= MAX_PLAN_LEN:\n          continue\n\n      for a in action_ids:\n          _, nxt_state = cur_state.step(a)\n          key = state_key(nxt_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((nxt_state, cur_plan + [a]))\n\n  # If no plan was found within the limits, return an empty list.\n  return []", "env_interactions": 4, "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T21:37:52.963636", "function_name": "make_stick", "function_body": "  # Determine action IDs (fallback to default ordering if unavailable)\n  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      action_ids = [0, 1, 2, 3, 4]  # DOWN, UP, LEFT, RIGHT, USE\n\n  # Get the internal index for the target item \"stick\"\n  try:\n      goal_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      goal_idx = env.world.cookbook.index.get(\"stick\")\n\n  # Helper to test goal condition\n  def is_goal(state):\n      return goal_idx is not None and state.satisfies(\"\", goal_idx)\n\n  # Obtain the starting state (CraftLab may expose it via _current_state)\n  start_state = getattr(env, \"_current_state\", None)\n  if start_state is None:\n      start_state = env.scenario.init()\n\n  # Bread\u2011first search over deterministic transitions\n  from collections import deque\n  frontier = deque()\n  frontier.append((start_state, []))\n  visited = set()\n\n  # Compact representation for visited\u2011state tracking\n  def state_key(st):\n      return (st.pos, st.dir, st.inventory.tobytes())\n\n  visited.add(state_key(start_state))\n  MAX_PLAN_LEN = 500  # safety bound on plan length\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n      if is_goal(cur_state):\n          return cur_plan\n      if len(cur_plan) >= MAX_PLAN_LEN:\n          continue\n      for a in action_ids:\n          _, nxt_state = cur_state.step(a)\n          key = state_key(nxt_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((nxt_state, cur_plan + [a]))\n\n  # If no plan found within limits, return an empty plan\n  return []", "env_interactions": 4, "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T21:38:23.738070", "function_name": "make_stick", "function_body": "  # Get current state and world objects\n  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  # Determine the goal index (item we need to craft)\n  goal_idx = None\n  if hasattr(env, \"task\") and hasattr(env.task, \"goal\"):\n      goal_idx = env.task.goal\n  if goal_idx is None and hasattr(env, \"goal\"):\n      goal_idx = env.goal\n  if goal_idx is None:\n      # Fallback: try to find an index named \"stick\"\n      if hasattr(cookbook, \"index\"):\n          goal_idx = cookbook.index.getitem(\"stick\")\n  if goal_idx is None:\n      return []\n\n  # Find which primitive resources are required for this goal\n  required_prims = cookbook.primitives_for(goal_idx)  # dict {prim_idx: count}\n  actions = []\n  cur_pos = list(state.pos)          # mutable copy of agent position\n  collected = set()                  # positions already harvested\n\n  # Helper to move the agent to a target cell using Manhattan steps\n  def move_to(target):\n      nonlocal cur_pos, actions\n      while cur_pos[0] != target[0] or cur_pos[1] != target[1]:\n          if cur_pos[0] < target[0]:\n              actions.append(0)      # DOWN\n              cur_pos[0] += 1\n          elif cur_pos[0] > target[0]:\n              actions.append(1)      # UP\n              cur_pos[0] -= 1\n          elif cur_pos[1] < target[1]:\n              actions.append(3)      # RIGHT\n              cur_pos[1] += 1\n          elif cur_pos[1] > target[1]:\n              actions.append(2)      # LEFT\n              cur_pos[1] -= 1\n\n  # Collect each required primitive the necessary number of times\n  for prim_idx, needed in required_prims.items():\n      for _ in range(needed):\n          # Locate all instances of this primitive still present on the grid\n          positions = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          # Remove ones we have already collected\n          positions = [p for p in positions if tuple(p) not in collected]\n          if not positions:\n              # No more instances left; cannot fulfill the recipe\n              break\n          positions = np.array(positions)\n          # Choose the nearest instance (Manhattan distance)\n          dists = np.abs(positions[:, 0] - cur_pos[0]) + np.abs(positions[:, 1] - cur_pos[1])\n          nearest = positions[dists.argmin()]\n          move_to(nearest.tolist())\n          actions.append(4)            # USE to pick up\n          collected.add(tuple(nearest))\n\n  # After gathering primitives, go to the required workshop (if any) and craft\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_idx = recipe.get(\"_at\")\n  if workshop_idx is not None:\n      # Find workshop cells\n      ws_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if ws_cells.size > 0:\n          ws_cells = np.array(ws_cells)\n          dists = np.abs(ws_cells[:, 0] - cur_pos[0]) + np.abs(ws_cells[:, 1] - cur_pos[1])\n          nearest_ws = ws_cells[dists.argmin()]\n          move_to(nearest_ws.tolist())\n          actions.append(4)            # USE to craft at workshop\n  else:\n      # No specific workshop; attempt to craft at current location\n      actions.append(4)\n\n  return actions", "env_interactions": 1, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:38:24.858921", "function_name": "make_stick", "function_body": "  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  # Resolve the goal index for a stick\n  goal_idx = None\n  # Try to obtain from the environment/task if present\n  if hasattr(env, \"task\") and hasattr(env.task, \"goal\"):\n      goal_idx = env.task.goal\n  if goal_idx is None and hasattr(env, \"goal\"):\n      goal_idx = env.goal\n  # Fallback to the name \"stick\"\n  if goal_idx is None:\n      goal_idx = cookbook.index[\"stick\"] if \"stick\" in cookbook.index.contents else None\n  if goal_idx is None:\n      return []\n\n  # Determine which primitive resources are required for the goal\n  required_prims = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n  actions: list[int] = []\n  cur_pos = list(state.pos)  # mutable copy of (row, col)\n\n  # Simple Manhattan movement helper\n  def move_to(target):\n      nonlocal cur_pos, actions\n      # target is a list/tuple [row, col]\n      while cur_pos[0] != target[0] or cur_pos[1] != target[1]:\n          if cur_pos[0] < target[0]:\n              actions.append(0)   # DOWN\n              cur_pos[0] += 1\n          elif cur_pos[0] > target[0]:\n              actions.append(1)   # UP\n              cur_pos[0] -= 1\n          elif cur_pos[1] < target[1]:\n              actions.append(3)   # RIGHT\n              cur_pos[1] += 1\n          elif cur_pos[1] > target[1]:\n              actions.append(2)   # LEFT\n              cur_pos[1] -= 1\n\n  # Collect each required primitive the needed number of times\n  for prim_idx, needed in required_prims.items():\n      for _ in range(needed):\n          # Find all currently available instances of this primitive\n          positions = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if positions.size == 0:\n              # Nothing left to collect \u2013 abort early\n              break\n          # Choose the nearest instance (Manhattan distance)\n          dists = np.abs(positions[:, 0] - cur_pos[0]) + np.abs(positions[:, 1] - cur_pos[1])\n          nearest = positions[dists.argmin()]\n          move_to(nearest.tolist())\n          actions.append(4)   # USE to pick up / interact\n\n  # If the recipe requires a specific workshop, go there and craft\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_idx = recipe.get(\"_at\")\n  if workshop_idx is not None:\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          dists = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])\n          nearest_ws = workshop_cells[dists.argmin()]\n          move_to(nearest_ws.tolist())\n          actions.append(4)   # USE to craft the final item\n\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:38:50.645826", "function_name": "make_stick", "function_body": "  # Reset environment to start a fresh episode\n  env.reset()\n  world = env.world\n  idx = world.cookbook.index\n\n  # ------------------------------------------------------------------\n  # Action indices (environment uses the same mapping as CraftLab)\n  # ------------------------------------------------------------------\n  act_map = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act_map[\"DOWN\"],\n      act_map[\"UP\"],\n      act_map[\"LEFT\"],\n      act_map[\"RIGHT\"],\n      act_map[\"USE\"],\n  )\n\n  # ------------------------------------------------------------------\n  # Identify the goal item \u201cstick\u201d (case\u2011insensitive fallback)\n  # ------------------------------------------------------------------\n  try:\n      stick_idx = idx[\"stick\"]\n  except Exception:\n      stick_idx = next(i for i, n in enumerate(idx.ordered_contents) if n.lower() == \"stick\")\n\n  # ------------------------------------------------------------------\n  # Determine which primitive kinds (and how many) are required\n  # ------------------------------------------------------------------\n  needed = world.cookbook.primitives_for(stick_idx)\n  if not needed:                     # stick itself is a primitive\n      needed = {stick_idx: 1}\n\n  # ------------------------------------------------------------------\n  # Grab a copy of the current state for planning (do not modify env yet)\n  # ------------------------------------------------------------------\n  state = env._current_state\n  cur_pos = tuple(state.pos)               # (x, y) coordinates\n  grid = state.grid.copy()                 # mutable copy for bookkeeping\n\n  # Pre\u2011compute which cells are blocked for movement (non\u2011grabbable entities)\n  non_grab = list(world.non_grabbable_indices)\n  if non_grab:\n      blocked = np.any(grid[:, :, non_grab] > 0, axis=2)\n  else:\n      blocked = np.zeros(grid.shape[:2], dtype=bool)\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper: BFS returning a list of movement actions from start to the\n  # nearest cell in *targets* while avoiding blocked cells.\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  def bfs_path(start, targets):\n      \"\"\"Return actions (DOWN/UP/LEFT/RIGHT) from start to the nearest target.\"\"\"\n      if start in targets:\n          return []\n      q = deque([start])\n      parent = {start: (None, None)}   # pos -> (prev_pos, action_to_reach)\n      while q:\n          cur = q.popleft()\n          for act, (dx, dy) in (\n              (DOWN, (0, 1)),\n              (UP, (0, -1)),\n              (LEFT, (-1, 0)),\n              (RIGHT, (1, 0)),\n          ):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if not (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]):\n                  continue\n              if blocked[nx, ny]:\n                  continue\n              nxt = (nx, ny)\n              if nxt in parent:\n                  continue\n              parent[nxt] = (cur, act)\n              if nxt in targets:\n                  # reconstruct path\n                  path = []\n                  node = nxt\n                  while parent[node][0] is not None:\n                      node, a = parent[node]\n                      path.append(a)\n                  return list(reversed(path))\n              q.append(nxt)\n\n      # No walkable path \u2013 fall back to Manhattan moves (ignore obstacles)\n      tx, ty = next(iter(targets))\n      x, y = start\n      path = []\n      while x < tx:\n          path.append(RIGHT); x += 1\n      while x > tx:\n          path.append(LEFT); x -= 1\n      while y < ty:\n          path.append(DOWN); y += 1\n      while y > ty:\n          path.append(UP); y -= 1\n      return path\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives (or the stick itself if primitive)\n  # ------------------------------------------------------------------\n  for kind, count in needed.items():\n      for _ in range(int(count)):\n          # locate all cells that still contain this kind\n          locs = np.argwhere(grid[:, :, kind] > 0)\n          if locs.size == 0:\n              # nothing left on the map \u2013 give up on further collection\n              break\n\n          # choose the nearest occurrence (Manhattan distance)\n          dists = np.abs(locs[:, 0] - cur_pos[0]) + np.abs(locs[:, 1] - cur_pos[1])\n          target = tuple(locs[dists.argmin()])\n\n          # move to the target and pick it up\n          actions.extend(bfs_path(cur_pos, {target}))\n          cur_pos = target\n          actions.append(USE)\n\n          # update simulated grid and blocked mask after pickup\n          grid[target[0], target[1], kind] -= 1\n          if non_grab:\n              blocked[target[0], target[1]] = np.any(\n                  grid[target[0], target[1], non_grab] > 0\n              )\n\n  # ------------------------------------------------------------------\n  # 2. If a workshop is required for the stick, go there and craft it\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      ws_idx = idx[workshop_name]\n      ws_locs = np.argwhere(grid[:, :, ws_idx] > 0)\n      if ws_locs.size:\n          ws_target = tuple(ws_locs[0])\n          actions.extend(bfs_path(cur_pos, {ws_target}))\n          cur_pos = ws_target\n          actions.append(USE)   # craft at the workshop\n\n  return actions", "env_interactions": 4, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:38:51.780452", "function_name": "make_stick", "function_body": "  env.reset()\n  world = env.world\n  idx = world.cookbook.index\n\n  # Action mapping\n  act_map = env.action_specs()\n  DOWN = act_map[\"DOWN\"]\n  UP = act_map[\"UP\"]\n  LEFT = act_map[\"LEFT\"]\n  RIGHT = act_map[\"RIGHT\"]\n  USE = act_map[\"USE\"]\n\n  # Identify stick index (case\u2011insensitive fallback)\n  try:\n      stick_idx = idx[\"stick\"]\n  except Exception:\n      stick_idx = next(i for i, n in enumerate(idx.ordered_contents) if n.lower() == \"stick\")\n\n  # Primitive requirements (empty if stick itself is primitive)\n  needed = world.cookbook.primitives_for(stick_idx)\n  if not needed:\n      needed = {stick_idx: 1}\n\n  # Current simulated state (for planning only)\n  state = env._current_state\n  cur_pos = tuple(state.pos)\n  grid = state.grid.copy()\n\n  # Cells that block movement (non\u2011grabbable entities)\n  non_grab = list(world.non_grabbable_indices)\n  blocked = (\n      np.any(grid[:, :, non_grab] > 0, axis=2)\n      if non_grab\n      else np.zeros(grid.shape[:2], dtype=bool)\n  )\n\n  actions = []\n\n  from collections import deque\n\n  def bfs(start, goal):\n      \"\"\"Return list of movement actions from start to goal avoiding blocked cells.\"\"\"\n      if start == goal:\n          return []\n      q = deque([start])\n      parent = {start: (None, None)}  # pos -> (prev_pos, action_to_reach)\n      while q:\n          x, y = q.popleft()\n          for act, (dx, dy) in (\n              (DOWN, (0, 1)),\n              (UP, (0, -1)),\n              (LEFT, (-1, 0)),\n              (RIGHT, (1, 0)),\n          ):\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]):\n                  continue\n              if blocked[nx, ny]:\n                  continue\n              nxt = (nx, ny)\n              if nxt in parent:\n                  continue\n              parent[nxt] = ((x, y), act)\n              if nxt == goal:\n                  # reconstruct path\n                  path = []\n                  cur = nxt\n                  while parent[cur][0] is not None:\n                      cur, a = parent[cur]\n                      path.append(a)\n                  return list(reversed(path))\n              q.append(nxt)\n\n      # Fallback: straight Manhattan moves (ignores obstacles)\n      tx, ty = goal\n      x, y = start\n      path = []\n      while x < tx:\n          path.append(RIGHT)\n          x += 1\n      while x > tx:\n          path.append(LEFT)\n          x -= 1\n      while y < ty:\n          path.append(DOWN)\n          y += 1\n      while y > ty:\n          path.append(UP)\n          y -= 1\n      return path\n\n  # ------------------------------------------------------------------\n  # 1. Collect required primitives (or the stick itself if primitive)\n  # ------------------------------------------------------------------\n  for kind, cnt in needed.items():\n      for _ in range(int(cnt)):\n          locations = np.argwhere(grid[:, :, kind] > 0)\n          if locations.size == 0:\n              break  # no more of this primitive on the map\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          target = tuple(locations[dists.argmin()])\n\n          actions.extend(bfs(cur_pos, target))\n          cur_pos = target\n\n          actions.append(USE)  # pick up\n\n          # update simulated grid / blocked mask\n          grid[target[0], target[1], kind] -= 1\n          if non_grab:\n              blocked[target[0], target[1]] = np.any(\n                  grid[target[0], target[1], non_grab] > 0\n              )\n\n  # ------------------------------------------------------------------\n  # 2. Move to workshop (if recipe requires one) and craft the stick\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      ws_idx = idx[workshop_name]\n      ws_locs = np.argwhere(grid[:, :, ws_idx] > 0)\n      if ws_locs.size:\n          ws_target = tuple(ws_locs[0])\n          actions.extend(bfs(cur_pos, ws_target))\n          cur_pos = ws_target\n          actions.append(USE)  # craft at the workshop\n\n  return actions", "env_interactions": 4, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:39:11.676861", "function_name": "make_stick", "function_body": "  env.reset()\n  world = env.world\n  scenario = env.scenario\n  grid = scenario.init_grid.copy()\n  pos = list(scenario.init_pos)\n  action_map = env.action_specs()\n  actions = []\n\n  def _move_to(target):\n      nonlocal pos\n      # move horizontally (x axis)\n      while pos[0] < target[0]:\n          actions.append(action_map[\"RIGHT\"])\n          pos[0] += 1\n      while pos[0] > target[0]:\n          actions.append(action_map[\"LEFT\"])\n          pos[0] -= 1\n      # move vertically (y axis)\n      while pos[1] < target[1]:\n          actions.append(action_map[\"DOWN\"])\n          pos[1] += 1\n      while pos[1] > target[1]:\n          actions.append(action_map[\"UP\"])\n          pos[1] -= 1\n\n  # ------------------------------------------------------------------\n  # 1. Collect all primitive resources needed for the goal item.\n  # ------------------------------------------------------------------\n  goal_idx = env.task.goal\n  primitive_needs = world.cookbook.primitives_for(goal_idx)\n\n  for kind_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          # locate remaining instances of this primitive on the grid\n          locations = np.argwhere(grid[:, :, kind_idx] > 0)\n          if locations.shape[0] == 0:\n              # no more of this primitive left \u2013 break early\n              break\n          # pick the nearest instance (Manhattan distance)\n          dists = np.abs(locations - pos).sum(axis=1)\n          nearest = int(np.argmin(dists))\n          target_cell = locations[nearest].tolist()\n          _move_to(target_cell)\n          actions.append(action_map[\"USE\"])\n          # update our simulated grid so we don't try to pick it again\n          grid[target_cell[0], target_cell[1], kind_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 2. If the recipe requires a specific workshop, go there and craft.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      workshop_cells = np.argwhere(grid[:, :, workshop_kind] > 0)\n      if workshop_cells.shape[0] > 0:\n          dists = np.abs(workshop_cells - pos).sum(axis=1)\n          nearest_ws = int(np.argmin(dists))\n          ws_target = workshop_cells[nearest_ws].tolist()\n          _move_to(ws_target)\n          actions.append(action_map[\"USE\"])\n\n  return actions", "env_interactions": 0, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:39:12.785700", "function_name": "make_stick", "function_body": "  env.reset()\n  world = env.world\n  scenario = env.scenario\n  grid = scenario.init_grid.copy()\n  pos = list(scenario.init_pos)\n  action_map = env.action_specs()\n  actions = []\n\n  def _move_to(target):\n      nonlocal pos, actions\n      # Move horizontally (x direction)\n      while pos[0] < target[0]:\n          actions.append(action_map[\"RIGHT\"])\n          pos[0] += 1\n      while pos[0] > target[0]:\n          actions.append(action_map[\"LEFT\"])\n          pos[0] -= 1\n      # Move vertically (y direction)\n      while pos[1] < target[1]:\n          actions.append(action_map[\"DOWN\"])\n          pos[1] += 1\n      while pos[1] > target[1]:\n          actions.append(action_map[\"UP\"])\n          pos[1] -= 1\n\n  # Determine goal and required primitives\n  goal_idx = env.task.goal\n  primitive_needs = world.cookbook.primitives_for(goal_idx)\n\n  # Collect each required primitive\n  for kind_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          locations = np.argwhere(grid[:, :, kind_idx] > 0)\n          if locations.shape[0] == 0:\n              break  # No more of this primitive on the map\n          dists = np.abs(locations - pos).sum(axis=1)\n          nearest = int(np.argmin(dists))\n          target_cell = locations[nearest].tolist()\n          _move_to(target_cell)\n          actions.append(action_map[\"USE\"])\n          grid[target_cell[0], target_cell[1], kind_idx] = 0\n\n  # If crafting requires a workshop, go there and craft\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      workshop_cells = np.argwhere(grid[:, :, workshop_kind] > 0)\n      if workshop_cells.shape[0] > 0:\n          dists = np.abs(workshop_cells - pos).sum(axis=1)\n          nearest_ws = int(np.argmin(dists))\n          ws_target = workshop_cells[nearest_ws].tolist()\n          _move_to(ws_target)\n          actions.append(action_map[\"USE\"])\n\n  return actions", "env_interactions": 0, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:39:40.966449", "function_name": "make_stick", "function_body": "  env.reset()\n  world = env.world\n  scenario = env.scenario\n  grid = scenario.init_grid.copy()\n  pos = list(scenario.init_pos)\n  actions = []\n  action_map = env.action_specs()\n  goal_idx = env.task.goal\n  primitive_needs = world.cookbook.primitives_for(goal_idx)\n\n  from collections import deque\n\n  def _shortest_path(src, tgt):\n      src_t = tuple(src)\n      tgt_t = tuple(tgt)\n      if src_t == tgt_t:\n          return []\n      visited = {src_t}\n      q = deque()\n      q.append((src_t, []))\n      moves = [(0, 1, \"DOWN\"), (0, -1, \"UP\"),\n               (-1, 0, \"LEFT\"), (1, 0, \"RIGHT\")]\n      while q:\n          (x, y), path = q.popleft()\n          for dx, dy, name in moves:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]):\n                  continue\n              npos = (nx, ny)\n              if npos in visited:\n                  continue\n              # allow stepping onto the target even if occupied\n              if npos != tgt_t and grid[nx, ny, :].any():\n                  continue\n              new_path = path + [action_map[name]]\n              if npos == tgt_t:\n                  return new_path\n              visited.add(npos)\n              q.append((npos, new_path))\n      # Fallback to Manhattan moves if BFS fails\n      fallback = []\n      cx, cy = src_t\n      tx, ty = tgt_t\n      while cx < tx:\n          fallback.append(action_map[\"RIGHT\"]); cx += 1\n      while cx > tx:\n          fallback.append(action_map[\"LEFT\"]); cx -= 1\n      while cy < ty:\n          fallback.append(action_map[\"DOWN\"]); cy += 1\n      while cy > ty:\n          fallback.append(action_map[\"UP\"]); cy -= 1\n      return fallback\n\n  def _move_to(target):\n      nonlocal pos, actions\n      steps = _shortest_path(pos, target)\n      actions.extend(steps)\n      pos[0], pos[1] = target[0], target[1]\n\n  # Collect required primitives\n  for kind_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          locations = np.argwhere(grid[:, :, kind_idx] == 1)\n          if locations.shape[0] == 0:\n              break\n          dists = np.abs(locations - pos).sum(axis=1)\n          nearest = int(np.argmin(dists))\n          target = locations[nearest].tolist()\n          _move_to(target)\n          actions.append(action_map[\"USE\"])\n          grid[target[0], target[1], kind_idx] = 0\n\n  # If a workshop is required, move there and craft\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get('_at')\n  if workshop_kind is not None:\n      ws_cells = np.argwhere(grid[:, :, workshop_kind] == 1)\n      if ws_cells.shape[0] > 0:\n          dists = np.abs(ws_cells - pos).sum(axis=1)\n          nearest_ws = int(np.argmin(dists))\n          ws_target = ws_cells[nearest_ws].tolist()\n          _move_to(ws_target)\n          actions.append(action_map[\"USE\"])\n\n  return actions", "env_interactions": 0, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:39:42.086076", "function_name": "make_stick", "function_body": "  # Reset environment and get references\n  env.reset()\n  world = env.world\n  scenario = env.scenario\n  grid = scenario.init_grid.copy()          # mutable copy of the world layout\n  pos = list(scenario.init_pos)              # current agent position [x, y]\n  actions = []                                # list of action indices to return\n  action_map = env.action_specs()             # map action names to indices\n\n  # Goal index and required primitives\n  goal_idx = env.task.goal\n  primitives_needed = world.cookbook.primitives_for(goal_idx)\n\n  # ------------------------------------------------------------------\n  # Helper: shortest path (BFS) avoiding occupied cells (except target)\n  # ------------------------------------------------------------------\n  from collections import deque\n  move_defs = [\n      (0, 1, \"DOWN\"),\n      (0, -1, \"UP\"),\n      (-1, 0, \"LEFT\"),\n      (1, 0, \"RIGHT\")\n  ]\n\n  def _shortest_path(src, tgt):\n      src_t = tuple(src)\n      tgt_t = tuple(tgt)\n      if src_t == tgt_t:\n          return []\n      visited = {src_t}\n      q = deque([(src_t, [])])\n      while q:\n          (x, y), path = q.popleft()\n          for dx, dy, act_name in move_defs:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]):\n                  continue\n              npos = (nx, ny)\n              if npos in visited:\n                  continue\n              # allow stepping onto the target even if it's occupied\n              if npos != tgt_t and grid[nx, ny, :].any():\n                  continue\n              new_path = path + [action_map[act_name]]\n              if npos == tgt_t:\n                  return new_path\n              visited.add(npos)\n              q.append((npos, new_path))\n      # Fallback: Manhattan moves (should rarely be needed)\n      fallback = []\n      cx, cy = src_t\n      tx, ty = tgt_t\n      while cx < tx:\n          fallback.append(action_map[\"RIGHT\"]); cx += 1\n      while cx > tx:\n          fallback.append(action_map[\"LEFT\"]); cx -= 1\n      while cy < ty:\n          fallback.append(action_map[\"DOWN\"]); cy += 1\n      while cy > ty:\n          fallback.append(action_map[\"UP\"]); cy -= 1\n      return fallback\n\n  def _move_to(target):\n      nonlocal pos, actions\n      steps = _shortest_path(pos, target)\n      actions.extend(steps)\n      pos[0], pos[1] = target[0], target[1]\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitive resources.\n  # ------------------------------------------------------------------\n  for kind_idx, needed_cnt in primitives_needed.items():\n      for _ in range(needed_cnt):\n          locations = np.argwhere(grid[:, :, kind_idx] == 1)\n          if locations.shape[0] == 0:\n              break  # no more of this primitive left\n          dists = np.abs(locations - pos).sum(axis=1)\n          nearest = int(np.argmin(dists))\n          target_cell = locations[nearest].tolist()\n          _move_to(target_cell)\n          actions.append(action_map[\"USE\"])\n          grid[target_cell[0], target_cell[1], kind_idx] = 0  # mark as collected\n\n  # ------------------------------------------------------------------\n  # 2) If the recipe requires a specific workshop, go there and craft.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get('_at')\n  if workshop_kind is not None:\n      workshop_cells = np.argwhere(grid[:, :, workshop_kind] == 1)\n      if workshop_cells.shape[0] > 0:\n          dists = np.abs(workshop_cells - pos).sum(axis=1)\n          nearest_ws = int(np.argmin(dists))\n          ws_target = workshop_cells[nearest_ws].tolist()\n          _move_to(ws_target)\n          actions.append(action_map[\"USE\"])\n\n  return actions", "env_interactions": 0, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:39:51.913138", "function_name": "make_stick", "function_body": "  # Determine available action IDs (fallback to default ordering if needed)\n  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      action_ids = [0, 1, 2, 3, 4]  # DOWN, UP, LEFT, RIGHT, USE\n\n  # Resolve the internal index for the target item \"stick\"\n  try:\n      goal_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      goal_idx = env.world.cookbook.index.get(\"stick\")\n\n  # Helper to test if a state already satisfies the goal\n  def is_goal(state):\n      return goal_idx is not None and state.satisfies(\"\", goal_idx)\n\n  # Obtain the starting state (use current state if exposed, otherwise init fresh)\n  start_state = getattr(env, \"_current_state\", None)\n  if start_state is None:\n      start_state = env.scenario.init()\n\n  # BFS over deterministic transitions\n  from collections import deque\n\n  def state_key(st):\n      # Position, direction and inventory uniquely identify a reachable configuration\n      return (st.pos, st.dir, st.inventory.tobytes())\n\n  frontier = deque()\n  frontier.append((start_state, []))\n  visited = {state_key(start_state)}\n\n  MAX_PLAN_LEN = 800  # safety limit to avoid infinite search\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      if is_goal(cur_state):\n          return cur_plan\n\n      if len(cur_plan) >= MAX_PLAN_LEN:\n          continue\n\n      for a in action_ids:\n          _, nxt = cur_state.step(a)\n          key = state_key(nxt)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((nxt, cur_plan + [a]))\n\n  # No plan found within limits \u2013 return empty list\n  return []", "env_interactions": 4, "island_id": 2, "scores": {"3": 1.5}}
