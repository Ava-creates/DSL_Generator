{"timestamp": "2025-10-21T21:56:44.138257", "function_name": "make_stick", "function_body": "  actions = []\n  # Reset the environment to start fresh\n  env.reset()\n  state = env._current_state\n  world = env.world\n\n  # Index of the target item \"stick\"\n  stick_idx = world.cookbook.index[\"stick\"]\n  if state.inventory[stick_idx] > 0:\n      return actions\n\n  # Helper to translate a step into a DMLab action index\n  def move_action(cur, nxt):\n      dx = nxt[0] - cur[0]\n      dy = nxt[1] - cur[1]\n      if dx == 1:\n          return 3  # RIGHT\n      if dx == -1:\n          return 2  # LEFT\n      if dy == 1:\n          return 0  # DOWN\n      if dy == -1:\n          return 1  # UP\n      raise ValueError(\"Invalid move step\")\n\n  # Bread\u2011first search for a path to any empty cell adjacent to a target cell\n  def bfs_to_adjacent(start, targets, grid):\n      W, H, _ = grid.shape\n      visited = np.zeros((W, H), dtype=bool)\n      q = collections.deque()\n      q.append((tuple(start), [tuple(start)]))\n      visited[start] = True\n      target_set = {tuple(t) for t in targets}\n      while q:\n          pos, path = q.popleft()\n          # Stop if adjacent to any target cell\n          for tx, ty in target_set:\n              if abs(pos[0] - tx) + abs(pos[1] - ty) == 1:\n                  return path\n          # Expand neighbours through empty cells only\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if grid[nx, ny, :].sum() == 0:   # empty cell\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [(nx, ny)]))\n      raise RuntimeError(\"No reachable adjacent cell found\")\n\n  # ------------------------------------------------------------------\n  # 1) Gather all primitives required to craft a stick.\n  # ------------------------------------------------------------------\n  primitive_reqs = world.cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n  cur_pos = tuple(state.pos)\n\n  for prim_idx, needed in primitive_reqs.items():\n      for _ in range(needed):\n          # If we already have this primitive in inventory, skip\n          if state.inventory[prim_idx] > 0:\n              continue\n          # Locate all cells containing the primitive\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(f\"Primitive {prim_idx} not found in the world\")\n          # Plan a path to a free cell adjacent to one of those locations\n          path = bfs_to_adjacent(cur_pos, prim_cells, state.grid)\n          # Convert the path into actions\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n          # Pick up the primitive\n          actions.append(4)   # USE\n          # Update the temporary planning state\n          state.grid[cur_pos[0], cur_pos[1], prim_idx] = 0\n          state.inventory[prim_idx] += 1\n\n  # ------------------------------------------------------------------\n  # 2) Move to the appropriate workshop and craft the stick.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      raise RuntimeError(\"Stick recipe missing workshop specification\")\n  workshop_idx = world.cookbook.index[workshop_name]\n\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      raise RuntimeError(\"Workshop cell for stick not present in world\")\n  path = bfs_to_adjacent(cur_pos, workshop_cells, state.grid)\n  for step in path[1:]:\n      actions.append(move_action(cur_pos, step))\n      cur_pos = step\n\n  # Final USE to craft the stick at the workshop\n  actions.append(4)   # USE\n\n  return actions", "env_interactions": 5, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-21T21:56:45.266117", "function_name": "make_stick", "function_body": "  actions = []\n  env.reset()\n  state = env._current_state\n  world = env.world\n\n  # Index of the target item \"stick\".\n  stick_idx = world.cookbook.index[\"stick\"]\n  if state.inventory[stick_idx] > 0:\n      return actions\n\n  # Helper to convert a movement step to a DMLab action index.\n  def move_action(cur, nxt):\n      dx = nxt[0] - cur[0]\n      dy = nxt[1] - cur[1]\n      if dx == 1:\n          return 3  # RIGHT\n      if dx == -1:\n          return 2  # LEFT\n      if dy == 1:\n          return 0  # DOWN\n      if dy == -1:\n          return 1  # UP\n      raise ValueError(\"Invalid move step\")\n\n  # BFS to find a path to any empty cell adjacent to a target location.\n  def bfs_to_adjacent(start, targets, grid):\n      W, H, _ = grid.shape\n      visited = np.zeros((W, H), dtype=bool)\n      q = collections.deque()\n      q.append((tuple(start), [tuple(start)]))\n      visited[start[0], start[1]] = True\n      target_set = {tuple(t) for t in targets}\n      while q:\n          pos, path = q.popleft()\n          # Stop if adjacent to any target cell.\n          for tx, ty in target_set:\n              if abs(pos[0] - tx) + abs(pos[1] - ty) == 1:\n                  return path\n          # Expand neighbours (only through empty cells).\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if grid[nx, ny, :].sum() == 0:  # empty cell\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [(nx, ny)]))\n      raise RuntimeError(\"No reachable adjacent cell found\")\n\n  # ------------------------------------------------------------------\n  # 1) Gather all primitives required for a stick.\n  # ------------------------------------------------------------------\n  primitive_reqs = world.cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n  cur_pos = tuple(state.pos)\n\n  for prim_idx, needed in primitive_reqs.items():\n      for _ in range(needed):\n          # Skip if we already have this primitive.\n          if state.inventory[prim_idx] > 0:\n              continue\n          # Locate all cells currently containing the primitive.\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(\"Required primitive not present in the world\")\n          # Plan a path to a free cell adjacent to any of those locations.\n          path = bfs_to_adjacent(cur_pos, prim_cells, state.grid)\n          # Convert the path into actions.\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n          # Pick up the primitive.\n          actions.append(4)   # USE\n          # Update the temporary planning state.\n          state.grid[cur_pos[0], cur_pos[1], prim_idx] = 0\n          state.inventory[prim_idx] += 1\n\n  # ------------------------------------------------------------------\n  # 2) Move to the appropriate workshop and craft the stick.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      raise RuntimeError(\"Stick recipe missing workshop specification\")\n  workshop_idx = world.cookbook.index[workshop_name]\n\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      raise RuntimeError(\"Workshop cell for stick not present in world\")\n  path = bfs_to_adjacent(cur_pos, workshop_cells, state.grid)\n  for step in path[1:]:\n      actions.append(move_action(cur_pos, step))\n      cur_pos = step\n\n  # Final USE to craft the stick at the workshop.\n  actions.append(4)   # USE\n\n  return actions", "env_interactions": 5, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-21T21:56:59.313681", "function_name": "make_stick", "function_body": "  # Determine the integer IDs for actions and the target item \"stick\"\n  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      # Fallback ordering: DOWN, UP, LEFT, RIGHT, USE\n      action_ids = [0, 1, 2, 3, 4]\n\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n  if stick_idx is None:\n      # No stick defined in this world \u2192 nothing to do\n      return []\n\n  # Ensure the environment has been reset so that a current state exists\n  if not hasattr(env, \"_current_state\") or env._current_state is None:\n      env.reset()\n  start_state = env._current_state\n\n  # Goal shortcut: already hold a stick\n  if start_state.inventory[stick_idx] > 0:\n      return []\n\n  from collections import deque\n\n  # Encode a state uniquely for visited\u2011set tracking\n  def _state_key(st):\n      # Position, direction, inventory contents, and grid layout define the state\n      return (st.pos, st.dir, st.inventory.tobytes(), st.grid.tobytes())\n\n  visited = {_state_key(start_state)}\n  frontier = deque()\n  frontier.append((start_state, []))\n\n  MAX_PLAN_LEN = 600  # safety bound to keep search tractable\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      # Goal test\n      if cur_state.inventory[stick_idx] > 0:\n          return cur_plan\n\n      if len(cur_plan) >= MAX_PLAN_LEN:\n          continue\n\n      # Expand all possible actions\n      for a in action_ids:\n          _, nxt_state = cur_state.step(a)\n          key = _state_key(nxt_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((nxt_state, cur_plan + [a]))\n\n  # No plan found within limits \u2013 return empty list\n  return []", "env_interactions": 4, "island_id": 7, "scores": {"3": 1.5}}
