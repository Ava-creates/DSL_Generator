{"timestamp": "2025-10-21T18:01:10.347997", "function_name": "make_stick", "function_body": "  try:\n      # Reset the environment and obtain the initial CraftState\n      env.reset()\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          scenario = getattr(env, \"scenario\", None)\n          if scenario is not None:\n              state = scenario.init()\n      if state is None:\n          return []\n\n      # Shortcut references\n      world = state.world\n      grid = state.grid.copy()\n      h, w, _ = grid.shape\n      cur_pos = state.pos\n      actions = []\n\n      # ------------------------------------------------------------------\n      # Helper functions\n      # ------------------------------------------------------------------\n      def find_cells(kind_idx):\n          \"\"\"Return list of (x, y) positions where `kind_idx` appears.\"\"\"\n          pts = np.argwhere(grid[:, :, kind_idx] > 0)\n          return [tuple(p) for p in pts]\n\n      # (dx, dy, action_id) \u2013 order matches CraftLab action mapping\n      DIRS = [\n          (1, 0, 0),   # DOWN\n          (-1, 0, 1),  # UP\n          (0, -1, 2),  # LEFT\n          (0, 1, 3),   # RIGHT\n      ]\n\n      def is_blocked(x, y):\n          \"\"\"A cell is blocked if any non\u2011grabbable entity occupies it.\"\"\"\n          for idx in world.non_grabbable_indices:\n              if grid[x, y, idx] > 0:\n                  return True\n          return False\n\n      from collections import deque\n\n      def bfs(start, goal):\n          \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) from start to goal.\"\"\"\n          q = deque()\n          q.append((start, []))\n          visited = {start}\n          while q:\n              (cx, cy), path = q.popleft()\n              if (cx, cy) == goal:\n                  return path\n              for dx, dy, act in DIRS:\n                  nx, ny = cx + dx, cy + dy\n                  if 0 <= nx < h and 0 <= ny < w and not is_blocked(nx, ny):\n                      if (nx, ny) not in visited:\n                          visited.add((nx, ny))\n                          q.append(((nx, ny), path + [act]))\n          # No path found\n          return []\n\n      # ------------------------------------------------------------------\n      # Determine the recipe for a stick\n      # ------------------------------------------------------------------\n      stick_idx = world.cookbook.index[\"stick\"]\n      primitive_requirements = world.cookbook.primitives_for(stick_idx)\n\n      # If there is no recipe, stick is a primitive \u2013 just fetch it\n      if not primitive_requirements:\n          stick_cells = find_cells(stick_idx)\n          if not stick_cells:\n              return []\n          # Choose the nearest stick cell (Manhattan distance)\n          dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in stick_cells]\n          target = stick_cells[int(np.argmin(dists))]\n          actions.extend(bfs(cur_pos, target))\n          actions.append(4)  # USE to pick up\n          return actions\n\n      # ------------------------------------------------------------------\n      # Collect each required primitive (respecting required counts)\n      # ------------------------------------------------------------------\n      for prim_idx, needed_cnt in primitive_requirements.items():\n          for _ in range(needed_cnt):\n              prim_cells = find_cells(prim_idx)\n              if not prim_cells:\n                  return []  # missing primitive\n              # Nearest primitive (Manhattan distance)\n              dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in prim_cells]\n              target = prim_cells[int(np.argmin(dists))]\n              # Move to the primitive\n              move_actions = bfs(cur_pos, target)\n              if not move_actions and cur_pos != target:\n                  return []  # unreachable\n              actions.extend(move_actions)\n              # Pick it up\n              actions.append(4)  # USE\n              # Update simulated local state\n              cur_pos = target\n              grid[target[0], target[1], prim_idx] = 0\n\n      # ------------------------------------------------------------------\n      # Craft the stick at the required workshop (if any)\n      # ------------------------------------------------------------------\n      recipe = world.cookbook.recipes.get(stick_idx, {})\n      workshop_kind = recipe.get(\"_at\")\n      if workshop_kind is not None:\n          ws_cells = find_cells(workshop_kind)\n          if not ws_cells:\n              return []  # no workshop present\n          dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in ws_cells]\n          ws_target = ws_cells[int(np.argmin(dists))]\n          actions.extend(bfs(cur_pos, ws_target))\n          actions.append(4)  # USE to craft at workshop\n      else:\n          # No specific workshop \u2013 craft at current location\n          actions.append(4)  # USE\n\n      return actions\n  except Exception:\n      # On any unexpected error, return an empty plan\n      return []", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:06:54.011042", "function_name": "make_stick", "function_body": "  import numpy as np\n  from collections import deque\n\n  # reset environment and get initial state\n  env.reset()\n  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  # helper to get index of a name (returns None if not present)\n  def _idx(name):\n      try:\n          return cookbook.index[name]\n      except Exception:\n          return None\n\n  # ------------------------------------------------------------------\n  # BFS helper: find path of movement actions (0\u20113) that ends adjacent to a\n  # target cell and faces it, then append the USE action (4).\n  # Returns list of actions or None if not reachable.\n  # ------------------------------------------------------------------\n  def _bfs_to_adjacent(start_pos, target_positions, traversable):\n      H, W = traversable.shape\n      moves = [(1, 0, 0),   # DOWN\n               (-1, 0, 1),  # UP\n               (0, -1, 2),  # LEFT\n               (0, 1, 3)]   # RIGHT\n      q = deque()\n      visited = set()\n      q.append((start_pos[0], start_pos[1], []))\n      visited.add((start_pos[0], start_pos[1]))\n\n      # pre\u2011compute a set for fast adjacency checks\n      target_set = set(target_positions)\n\n      while q:\n          x, y, path = q.popleft()\n          for dx, dy, act in moves:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < H and 0 <= ny < W):\n                  continue\n              if not traversable[nx, ny]:\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              new_path = path + [act]\n\n              # check if (nx,ny) is adjacent to any target cell\n              for tx, ty in target_positions:\n                  if abs(nx - tx) + abs(ny - ty) == 1:\n                      # direction we need to face the target from (nx,ny)\n                      needed_dir = None\n                      if nx == tx + 1 and ny == ty:\n                          needed_dir = 1          # UP\n                      elif nx == tx - 1 and ny == ty:\n                          needed_dir = 0          # DOWN\n                      elif nx == tx and ny == ty + 1:\n                          needed_dir = 2          # LEFT\n                      elif nx == tx and ny == ty - 1:\n                          needed_dir = 3          # RIGHT\n                      if needed_dir is not None and act == needed_dir:\n                          return new_path + [4]   # append USE\n              visited.add((nx, ny))\n              q.append((nx, ny, new_path))\n      return None\n\n  # ------------------------------------------------------------------\n  # Determine goal index for \"stick\"\n  # ------------------------------------------------------------------\n  goal_name = \"stick\"\n  goal_idx = _idx(goal_name)\n  if goal_idx is None:\n      return []  # unknown goal\n\n  # ------------------------------------------------------------------\n  # Main planning loop\n  # ------------------------------------------------------------------\n  plan_actions = []\n\n  while True:\n      # check if we already have the goal in inventory\n      if state.inventory[goal_idx] > 0:\n          break\n\n      # obtain recipe (if any) for the goal\n      recipe = cookbook.recipes.get(goal_idx, None)\n\n      if recipe is None:\n          # stick is a primitive; just collect one from the world\n          target_cells = list(zip(*np.where(state.grid[:, :, goal_idx] > 0)))\n          if not target_cells:\n              break\n          traversable = np.sum(state.grid, axis=2) == 0\n          actions = _bfs_to_adjacent(state.pos, target_cells, traversable)\n          if actions is None:\n              break\n          for a in actions:\n              reward, state = env.step(a)\n              plan_actions.append(a)\n          continue\n\n      # --------------------------------------------------------------\n      # Goal has a recipe: first gather required primitives\n      # --------------------------------------------------------------\n      # compute how many of each primitive we still need\n      needed = {}\n      for ing_idx, cnt in recipe.items():\n          if ing_idx == \"_at\":\n              continue\n          have = int(state.inventory[ing_idx])\n          need = max(0, cnt - have)\n          if need > 0:\n              needed[ing_idx] = need\n\n      if needed:\n          # pick the first primitive that is still missing\n          prim_idx, need_cnt = next(iter(needed.items()))\n          # locate cells containing this primitive\n          prim_cells = list(zip(*np.where(state.grid[:, :, prim_idx] > 0)))\n          if not prim_cells:\n              # cannot find required primitive \u2013 abort\n              break\n          # we may need to collect multiple copies; repeat until satisfied\n          while need_cnt > 0:\n              traversable = np.sum(state.grid, axis=2) == 0\n              actions = _bfs_to_adjacent(state.pos, prim_cells, traversable)\n              if actions is None:\n                  # no reachable primitive left\n                  break\n              for a in actions:\n                  reward, state = env.step(a)\n                  plan_actions.append(a)\n              need_cnt -= 1\n              # refresh list of primitive cells (the picked one disappears)\n              prim_cells = list(zip(*np.where(state.grid[:, :, prim_idx] > 0)))\n              if not prim_cells:\n                  break\n          continue  # re\u2011evaluate inventory after gathering\n\n      # --------------------------------------------------------------\n      # All primitives are ready \u2013 go to workshop and craft\n      # --------------------------------------------------------------\n      workshop_name = recipe.get(\"_at\", None)\n      if workshop_name is None:\n          # no workshop specified; assume using USE at current cell works\n          # just try a USE action\n          reward, state = env.step(4)\n          plan_actions.append(4)\n          continue\n\n      workshop_idx = _idx(workshop_name)\n      if workshop_idx is None:\n          break\n\n      workshop_cells = list(zip(*np.where(state.grid[:, :, workshop_idx] > 0)))\n      if not workshop_cells:\n          break\n\n      traversable = np.sum(state.grid, axis=2) == 0\n      actions = _bfs_to_adjacent(state.pos, workshop_cells, traversable)\n      if actions is None:\n          break\n      for a in actions:\n          reward, state = env.step(a)\n          plan_actions.append(a)\n      # after crafting, loop will detect the goal in inventory\n      continue\n\n  return plan_actions", "env_interactions": 0, "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-10-21T18:06:55.294680", "function_name": "make_stick", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ----- helper: plan path to adjacent cell of any target and USE -----\n  def _plan_to_adjacent_and_use(state, target_idx, target_cells):\n      \"\"\"Return list of actions to move adjacent to a target cell and USE.\n      Uses BFS on empty cells; ensures the final move faces the target.\n      \"\"\"\n      grid = state.grid\n      H, W = grid.shape[0], grid.shape[1]\n      # empty cells are those with no entities\n      traversable = np.sum(grid, axis=2) == 0\n\n      # movement actions: (dx, dy, action_index)\n      moves = [(1, 0, 0),   # DOWN\n               (-1, 0, 1),  # UP\n               (0, -1, 2),  # LEFT\n               (0, 1, 3)]   # RIGHT\n\n      start_x, start_y = state.pos\n      visited = {(start_x, start_y)}\n      queue = deque()\n      queue.append((start_x, start_y, []))\n\n      # set of target coordinates for fast lookup\n      target_set = {tuple(cell) for cell in target_cells}\n\n      while queue:\n          x, y, path = queue.popleft()\n          for dx, dy, act in moves:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < H and 0 <= ny < W):\n                  continue\n              if not traversable[nx, ny]:\n                  continue\n              if (nx, ny) in visited:\n                  continue\n\n              new_path = path + [act]\n\n              # check if (nx,ny) is adjacent to any target cell\n              for tx, ty in target_set:\n                  if abs(nx - tx) + abs(ny - ty) == 1:\n                      # determine which direction we must be facing to hit the target\n                      needed_dir = None\n                      if nx == tx + 1 and ny == ty:\n                          needed_dir = 1   # UP\n                      elif nx == tx - 1 and ny == ty:\n                          needed_dir = 0   # DOWN\n                      elif nx == tx and ny == ty + 1:\n                          needed_dir = 2   # LEFT\n                      elif nx == tx and ny == ty - 1:\n                          needed_dir = 3   # RIGHT\n\n                      if needed_dir is not None and act == needed_dir:\n                          return new_path + [4]   # append USE action\n\n              visited.add((nx, ny))\n              queue.append((nx, ny, new_path))\n      return []   # no reachable target\n\n  # ----- start of main logic -----\n  env.reset()\n  state = env._current_state\n  grid = state.grid\n\n  # obtain index for \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      return []   # stick not defined in this world\n\n  # if we already have a stick in inventory, nothing to do\n  if state.inventory[stick_idx] > 0:\n      return []\n\n  actions_plan = []\n\n  # 1. If a stick lies on the ground, just collect it\n  stick_cells = np.argwhere(grid[:, :, stick_idx] > 0)\n  if stick_cells.size > 0:\n      path = _plan_to_adjacent_and_use(state, stick_idx, stick_cells)\n      return path\n\n  # 2. Need to craft a stick: gather required primitives\n  primitive_requirements = env.world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n  # if no recipe (stick is primitive) we cannot craft; return empty\n  if not primitive_requirements:\n      return []\n\n  # helper to update state after executing a list of actions\n  def _apply_actions(state_obj, acts):\n      for a in acts:\n          _, state_obj = state_obj.step(a)\n      return state_obj\n\n  # collect each required primitive\n  for prim_idx, needed_cnt in primitive_requirements.items():\n      while state.inventory[prim_idx] < needed_cnt:\n          # locate nearest primitive cell (any will do)\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # cannot find required primitive; abort\n              return actions_plan\n          path = _plan_to_adjacent_and_use(state, prim_idx, prim_cells)\n          if not path:\n              return actions_plan\n          # execute path to update the state for the next iteration\n          state = _apply_actions(state, path)\n          actions_plan.extend(path)\n\n  # 3. After having primitives, go to the appropriate workshop and craft\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  workshop_idx = recipe.get(\"_at\")\n  if workshop_idx is None:\n      # no workshop required (should not happen for a crafted item)\n      return actions_plan\n\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      return actions_plan\n  path = _plan_to_adjacent_and_use(state, workshop_idx, workshop_cells)\n  if path:\n      actions_plan.extend(path)\n\n  return actions_plan", "env_interactions": 0, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:07:20.325207", "function_name": "make_stick", "function_body": "  # Reset environment and fetch current state/world information\n  env.reset()\n  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  # Mapping from action names to indices\n  act_map = env.action_specs()\n  DOWN = act_map.get('DOWN', 0)\n  UP = act_map.get('UP', 1)\n  LEFT = act_map.get('LEFT', 2)\n  RIGHT = act_map.get('RIGHT', 3)\n  USE = act_map.get('USE', 4)\n\n  # Helper: translate a step delta into the corresponding action index\n  def delta_to_action(dx, dy):\n      if dx == 1 and dy == 0:\n          return DOWN\n      if dx == -1 and dy == 0:\n          return UP\n      if dx == 0 and dy == -1:\n          return LEFT\n      if dx == 0 and dy == 1:\n          return RIGHT\n      raise ValueError(\"Invalid movement delta\")\n\n  # Helper: BFS that returns a list of positions from start to goal (inclusive)\n  # Cells containing any entity are considered blocked, except the goal cell itself.\n  def bfs_path(start, goal, grid):\n      from collections import deque\n      h, w = grid.shape[:2]\n      blocked = (grid.sum(axis=2) > 0).astype(np.uint8)\n      # allow stepping onto the goal cell even if blocked\n      blocked[goal[0], goal[1]] = 0\n      visited = np.full((h, w), False, dtype=bool)\n      prev = dict()\n      q = deque()\n      q.append(start)\n      visited[start[0], start[1]] = True\n      while q:\n          x, y = q.popleft()\n          if (x, y) == goal:\n              break\n          for dx, dy in [(1,0), (-1,0), (0,1), (0,-1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < h and 0 <= ny < w and not visited[nx, ny] and blocked[nx, ny] == 0:\n                  visited[nx, ny] = True\n                  prev[(nx, ny)] = (x, y)\n                  q.append((nx, ny))\n      else:\n          # goal not reachable\n          return None\n\n      # reconstruct path\n      path = [goal]\n      while path[-1] != start:\n          path.append(prev[path[-1]])\n      path.reverse()\n      return path\n\n  # Helper: generate action list to move from cur_pos to target_pos using bfs_path\n  def move_actions(cur_pos, target_pos, grid):\n      if cur_pos == target_pos:\n          return [], cur_pos\n      path = bfs_path(cur_pos, target_pos, grid)\n      if path is None:\n          # fallback to Manhattan moves (may hit obstacles)\n          actions = []\n          cx, cy = cur_pos\n          tx, ty = target_pos\n          while cx < tx:\n              actions.append(DOWN); cx += 1\n          while cx > tx:\n              actions.append(UP); cx -= 1\n          while cy < ty:\n              actions.append(RIGHT); cy += 1\n          while cy > ty:\n              actions.append(LEFT); cy -= 1\n          return actions, (cx, cy)\n      actions = []\n      for (x0, y0), (x1, y1) in zip(path, path[1:]):\n          dx, dy = x1 - x0, y1 - y0\n          actions.append(delta_to_action(dx, dy))\n      return actions, target_pos\n\n  # --------------------------------------------------------------\n  # Identify the goal index for a stick\n  try:\n      goal_idx = cookbook.index[\"stick\"]\n  except Exception:\n      return []  # stick not defined in this world\n\n  # If stick is a primitive (no recipe), just collect it if needed\n  if goal_idx in cookbook.primitives:\n      # Check if already in inventory\n      if state.inventory[goal_idx] > 0:\n          return []\n      # Locate a stick on the map\n      stick_cells = np.argwhere(state.grid[:, :, goal_idx] > 0)\n      if stick_cells.size == 0:\n          return []  # no stick present\n      target = tuple(stick_cells[0])\n      plan, cur_pos = move_actions(state.pos, target, state.grid)\n      plan.append(USE)  # pick up the stick\n      return plan\n\n  # --------------------------------------------------------------\n  # Otherwise we need to craft the stick from its primitive ingredients\n  prim_req = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n  if not prim_req:\n      return []  # no recipe and not a primitive -> cannot craft\n\n  # Locate all primitive instances on the map\n  prim_locations = {}\n  for p_idx in prim_req.keys():\n      locs = np.argwhere(state.grid[:, :, p_idx] > 0)\n      prim_locations[p_idx] = [tuple(pos) for pos in locs]\n\n  # Locate a workshop (any workshop type)\n  workshop_pos = None\n  for wk_idx in world.workshop_indices:\n      cells = np.argwhere(state.grid[:, :, wk_idx] > 0)\n      if cells.size:\n          workshop_pos = tuple(cells[0])\n          break\n  if workshop_pos is None:\n      return []  # cannot craft without a workshop\n\n  cur_pos = state.pos\n  plan = []\n\n  # Collect each required primitive (may need multiple of the same kind)\n  for p_idx, needed in prim_req.items():\n      collected = 0\n      available = prim_locations.get(p_idx, []).copy()\n      while collected < needed:\n          if not available:\n              return []  # not enough primitives on the map\n          # Choose the nearest available primitive (by Manhattan distance)\n          dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in available]\n          nearest_i = int(np.argmin(dists))\n          target = available.pop(nearest_i)\n\n          # Move to the primitive and pick it up\n          actions, cur_pos = move_actions(cur_pos, target, state.grid)\n          plan.extend(actions)\n          plan.append(USE)  # collect\n          collected += 1\n\n  # After gathering all ingredients, move to a workshop and craft\n  actions, cur_pos = move_actions(cur_pos, workshop_pos, state.grid)\n  plan.extend(actions)\n  plan.append(USE)  # craft the stick\n\n  return plan", "env_interactions": 4, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:07:21.446951", "function_name": "make_stick", "function_body": "  # Reset environment and get current state and world objects\n  env.reset()\n  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  # Action mapping\n  act_map = env.action_specs()\n  DOWN = act_map.get('DOWN', 0)\n  UP = act_map.get('UP', 1)\n  LEFT = act_map.get('LEFT', 2)\n  RIGHT = act_map.get('RIGHT', 3)\n  USE = act_map.get('USE', 4)\n\n  # Helper to generate Manhattan moves from one cell to another\n  def _moves(src, dst):\n      x, y = src\n      tx, ty = dst\n      moves = []\n      while x < tx:\n          moves.append(DOWN); x += 1\n      while x > tx:\n          moves.append(UP); x -= 1\n      while y < ty:\n          moves.append(RIGHT); y += 1\n      while y > ty:\n          moves.append(LEFT); y -= 1\n      return moves\n\n  # Identify goal index for \"stick\"\n  try:\n      goal_idx = cookbook.index[\"stick\"]\n  except Exception:\n      # Unknown goal \u2013 return empty plan\n      return []\n\n  # Determine which primitives are needed to craft a stick\n  needed_prims = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n  plan = []\n  cur_pos = state.pos\n\n  # If the recipe reports no primitives, the stick is likely a primitive itself.\n  # In that case we simply locate a stick on the map and pick it up.\n  if not needed_prims:\n      locs = np.argwhere(state.grid[:, :, goal_idx] > 0)\n      if locs.size == 0:\n          return []  # no stick present\n      target = tuple(locs[0])\n      plan.extend(_moves(cur_pos, target))\n      plan.append(USE)\n      return plan\n\n  # Locate all required primitive instances on the map\n  prim_locations = {}\n  for prim_idx in needed_prims:\n      pts = np.argwhere(state.grid[:, :, prim_idx] > 0)\n      prim_locations[prim_idx] = [tuple(p) for p in pts]\n\n  # Find any workshop cell (the first one we encounter)\n  workshop_pos = None\n  for wk_idx in world.workshop_indices:\n      wk_cells = np.argwhere(state.grid[:, :, wk_idx] > 0)\n      if wk_cells.size:\n          workshop_pos = tuple(wk_cells[0])\n          break\n  if workshop_pos is None:\n      # No workshop \u2013 cannot craft\n      return []\n\n  # Collect each required primitive\n  for prim_idx, count_needed in needed_prims.items():\n      collected = 0\n      available = prim_locations.get(prim_idx, []).copy()\n      while collected < count_needed:\n          if not available:\n              # Not enough primitives on the map\n              return []\n          # Choose the nearest primitive (Manhattan distance)\n          dists = [abs(cur_pos[0] - p[0]) + abs(cur_pos[1] - p[1]) for p in available]\n          nearest_i = int(np.argmin(dists))\n          target = available.pop(nearest_i)\n\n          plan.extend(_moves(cur_pos, target))\n          plan.append(USE)          # pick up the primitive\n          cur_pos = target\n          collected += 1\n\n  # After gathering all primitives, move to the workshop and craft\n  plan.extend(_moves(cur_pos, workshop_pos))\n  plan.append(USE)                  # use at workshop = craft stick\n\n  return plan", "env_interactions": 4, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:07:32.687762", "function_name": "make_stick", "function_body": "  # Determine the integer IDs for possible actions\n  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      action_ids = [0, 1, 2, 3, 4]  # fallback: DOWN, UP, LEFT, RIGHT, USE\n\n  # Resolve the index of the target item \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n  if stick_idx is None:\n      return []  # stick not defined in this world\n\n  # Ensure the environment is reset and obtain the current state object\n  if not hasattr(env, \"_current_state\") or env._current_state is None:\n      env.reset()\n  start_state = env._current_state\n\n  # If we already have a stick, no actions are required\n  if start_state.inventory[stick_idx] > 0:\n      return []\n\n  from collections import deque\n\n  # Helper that creates a hashable representation of a state\n  def _state_key(st):\n      return (st.pos, st.dir, st.inventory.tobytes(), st.grid.tobytes())\n\n  visited = {_state_key(start_state)}\n  frontier = deque()\n  frontier.append((start_state, []))\n\n  max_plan_len = 400  # safety bound to keep the search tractable\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      # Goal test: have at least one stick in inventory\n      if cur_state.inventory[stick_idx] > 0:\n          return cur_plan\n\n      if len(cur_plan) >= max_plan_len:\n          continue\n\n      # Expand all possible actions\n      for a in action_ids:\n          _, nxt_state = cur_state.step(a)\n          key = _state_key(nxt_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((nxt_state, cur_plan + [a]))\n\n  # No feasible plan found within limits\n  return []", "env_interactions": 4, "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T18:07:33.813955", "function_name": "make_stick", "function_body": "  # Determine action IDs (order may vary)\n  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      action_ids = [0, 1, 2, 3, 4]  # fallback: DOWN,UP,LEFT,RIGHT,USE\n\n  # Resolve the index for the target item \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n  if stick_idx is None:\n      return []  # stick not defined in this world\n\n  # Ensure there is a current state (reset if needed)\n  if not hasattr(env, \"_current_state\") or env._current_state is None:\n      env.reset()\n  start_state = env._current_state\n\n  # Goal already satisfied?\n  if start_state.inventory[stick_idx] > 0:\n      return []\n\n  from collections import deque\n\n  # Helper to uniquely identify a state for visited\u2011set tracking\n  def _state_key(st):\n      return (st.pos, st.dir, st.inventory.tobytes(), st.grid.tobytes())\n\n  visited = {_state_key(start_state)}\n  frontier = deque()\n  frontier.append((start_state, []))\n\n  max_plan_len = 300  # safety bound\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      # Goal test\n      if cur_state.inventory[stick_idx] > 0:\n          return cur_plan\n\n      if len(cur_plan) >= max_plan_len:\n          continue\n\n      # Expand possible actions\n      for a in action_ids:\n          _, nxt_state = cur_state.step(a)\n          key = _state_key(nxt_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((nxt_state, cur_plan + [a]))\n\n  # No feasible plan found within limits\n  return []", "env_interactions": 4, "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T18:08:18.172344", "function_name": "make_stick", "function_body": "  import numpy as np\n\n  # Helper to translate movement deltas into action indices\n  def _move_actions(src, dst):\n      actions = []\n      r0, c0 = src\n      r1, c1 = dst\n      dr = r1 - r0\n      if dr > 0:\n          actions.extend([0] * dr)   # DOWN\n      elif dr < 0:\n          actions.extend([1] * (-dr))  # UP\n      dc = c1 - c0\n      if dc > 0:\n          actions.extend([3] * dc)   # RIGHT\n      elif dc < 0:\n          actions.extend([2] * (-dc))  # LEFT\n      return actions\n\n  # Access the underlying world and current state\n  world = env.world\n  state = env._current_state\n  grid = state.grid\n  cur_pos = state.pos\n\n  # Resolve indices via the cookbook's index mapping\n  idx = world.cookbook.index\n  stick_idx = idx.get(\"stick\")\n  if stick_idx is None:\n      return []  # No stick defined in this world\n\n  # Retrieve the recipe for a stick\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  # Separate primitive requirements from the workshop specification\n  primitives = {k: v for k, v in recipe.items() if k != \"_at\"}\n  workshop_name = recipe.get(\"_at\")\n\n  plan = []\n\n  # Collect each required primitive (ignoring counts >1 for simplicity)\n  for prim_idx, needed in primitives.items():\n      # Find all cells that contain this primitive\n      positions = np.argwhere(grid[:, :, prim_idx] > 0)\n      if positions.size == 0:\n          continue  # primitive not present; skip\n      # Choose the first occurrence (could be improved with nearest\u2011search)\n      target = tuple(positions[0])\n      plan.extend(_move_actions(cur_pos, target))\n      cur_pos = target\n      # Use the primitive (one USE per primitive type; assumes it grabs all needed)\n      plan.append(4)  # USE\n\n  # Move to the appropriate workshop and craft the stick\n  if workshop_name:\n      workshop_idx = idx.get(workshop_name)\n      if workshop_idx is not None:\n          ws_positions = np.argwhere(grid[:, :, workshop_idx] > 0)\n          if ws_positions.size > 0:\n              ws_target = tuple(ws_positions[0])\n              plan.extend(_move_actions(cur_pos, ws_target))\n              cur_pos = ws_target\n              plan.append(4)  # USE to craft\n\n  return plan", "env_interactions": 0, "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-10-21T18:08:19.297366", "function_name": "make_stick", "function_body": "  # ----------------------------------------------------------------------\n  # Helper functions (BFS path finding, move conversion, etc.)\n  # ----------------------------------------------------------------------\n  from collections import deque\n\n  # Mapping from movement vector to action index (will be filled later)\n  _vec_to_action = {}\n\n  def _init_action_maps():\n      \"\"\"Initialise the global vector\u2011to\u2011action mapping using the env.\"\"\"\n      nonlocal _vec_to_action\n      specs = env.action_specs()          # e.g. {'DOWN':0,'UP':1,'LEFT':2,'RIGHT':3,'USE':4}\n      # Assume standard orientation: rows increase downwards, cols increase rightwards\n      _vec_to_action = {\n          (-1, 0): specs['UP'],\n          ( 1, 0): specs['DOWN'],\n          ( 0,-1): specs['LEFT'],\n          ( 0, 1): specs['RIGHT'],\n      }\n      return specs['USE']\n\n  _use_action = _init_action_maps()\n\n  def _in_bounds(pos, shape):\n      x, y = pos\n      return 0 <= x < shape[0] and 0 <= y < shape[1]\n\n  def _is_blocked(pos, grid):\n      \"\"\"A cell is blocked if any kind occupies it (except the agent).\"\"\"\n      x, y = pos\n      return grid[x, y, :].any()\n\n  def _bfs_to_adjacent(start, target, grid):\n      \"\"\"\n      BFS from start to any cell orthogonally adjacent to target that is free.\n      Returns the list of positions (including start) forming the path.\n      \"\"\"\n      H, W = grid.shape[:2]\n      visited = np.zeros((H, W), dtype=bool)\n      parent = dict()\n      q = deque()\n      q.append(start)\n      visited[start] = True\n\n      # Helper to test adjacency\n      def adjacent(p):\n          return abs(p[0] - target[0]) + abs(p[1] - target[1]) == 1\n\n      while q:\n          cur = q.popleft()\n          if adjacent(cur) and not _is_blocked(cur, grid):\n              # reconstruct path\n              path = [cur]\n              while cur != start:\n                  cur = parent[cur]\n                  path.append(cur)\n              return path[::-1]          # from start to goal\n          for dx, dy in [(-1,0),(1,0),(0,-1),(0,1)]:\n              nxt = (cur[0] + dx, cur[1] + dy)\n              if not _in_bounds(nxt, (H, W)):\n                  continue\n              if visited[nxt]:\n                  continue\n              if _is_blocked(nxt, grid):\n                  continue\n              visited[nxt] = True\n              parent[nxt] = cur\n              q.append(nxt)\n      # No reachable adjacent cell\n      return None\n\n  def _positions_to_actions(path):\n      \"\"\"Convert a list of positions to a list of movement actions.\"\"\"\n      actions = []\n      for a, b in zip(path, path[1:]):\n          vec = (b[0] - a[0], b[1] - a[1])\n          actions.append(_vec_to_action[vec])\n      return actions\n\n  def _move_adjacent_and_face(state, target_pos):\n      \"\"\"\n      Move the agent to a free cell adjacent to target_pos and ensure the\n      final facing direction points towards the target (so that a USE will act\n      on it). Returns the list of actions required.\n      \"\"\"\n      actions = []\n\n      # 1) Find path to an adjacent free cell\n      path = _bfs_to_adjacent(state.pos, target_pos, state.grid)\n      if path is None:\n          return actions  # give up silently\n\n      # 2) Convert path to actions and execute them (updating state)\n      move_actions = _positions_to_actions(path)\n      for act in move_actions:\n          actions.append(act)\n          _, _ = env.step(act)\n          state = env._current_state\n\n      # 3) At this point we are on an adjacent cell `state.pos`.\n      #    Determine direction to the target.\n      tx, ty = target_pos\n      cx, cy = state.pos\n      dir_vec = (tx - cx, ty - cy)   # one of the four unit vectors\n\n      # If the last movement already points to the target we are fine.\n      if move_actions:\n          last_move = (path[-1][0] - path[-2][0], path[-1][1] - path[-2][1])\n      else:\n          last_move = None\n\n      if last_move != dir_vec:\n          # Need a tiny detour: step one cell away (if possible) and step back.\n          opp = (-dir_vec[0], -dir_vec[1])\n          away = (cx + opp[0], cy + opp[1])\n          H, W = state.grid.shape[:2]\n          if _in_bounds(away, (H, W)) and not _is_blocked(away, state.grid):\n              # move away\n              actions.append(_vec_to_action[opp])\n              _, _ = env.step(_vec_to_action[opp])\n              state = env._current_state\n              # move back towards target (now facing correctly)\n              actions.append(_vec_to_action[dir_vec])\n              _, _ = env.step(_vec_to_action[dir_vec])\n              state = env._current_state\n          else:\n              # fallback: just move in the correct direction from current cell\n              actions.append(_vec_to_action[dir_vec])\n              _, _ = env.step(_vec_to_action[dir_vec])\n              state = env._current_state\n\n      return actions\n\n  # ----------------------------------------------------------------------\n  # Main logic for making a stick\n  # ----------------------------------------------------------------------\n  # Reset environment to obtain a fresh state\n  env.reset()\n  state = env._current_state\n\n  # Indices and recipe information\n  idx = env.world.cookbook.index\n  stick_idx = idx.index('stick')\n  stick_recipe = env.world.cookbook.recipes.get(stick_idx, {})\n\n  # ------------------------------------------------------------------\n  # 1) Gather required primitive resources\n  # ------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n  for prim_idx, cnt in primitives_needed.items():\n      while cnt > 0:\n          # Locate any remaining instance of the primitive on the map\n          locations = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if locations.size == 0:\n              # Nothing left \u2013 give up\n              break\n          target = tuple(locations[0])   # pick the first occurrence\n          # Move next to it and face it\n          actions = _move_adjacent_and_face(state, target)\n          # Use action to pick it up\n          actions.append(_use_action)\n          _, _ = env.step(_use_action)\n          state = env._current_state\n          cnt -= 1\n      # update the count in the dict (optional)\n      primitives_needed[prim_idx] = cnt\n\n  # ------------------------------------------------------------------\n  # 2) Go to the appropriate workshop and craft the stick\n  # ------------------------------------------------------------------\n  workshop_name = stick_recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = idx.index(workshop_name)\n      # Find a workshop cell (assume at least one exists)\n      ws_locs = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if ws_locs.size > 0:\n          workshop_pos = tuple(ws_locs[0])\n          # Move adjacent and face the workshop\n          actions = _move_adjacent_and_face(state, workshop_pos)\n          # Use to craft\n          actions.append(_use_action)\n          _, _ = env.step(_use_action)\n          state = env._current_state\n\n  # ------------------------------------------------------------------\n  # Return the full list of actions that have been executed\n  # ------------------------------------------------------------------\n  # The actions have already been sent to the environment during the\n  # planning steps.  We reconstruct the list by reading the environment\u2019s\n  # internal action history \u2013 however the simplest approach is to keep a\n  # running list while we were issuing actions.\n  # (The helper functions above already appended actions to a local list,\n  #  but we discarded them after each call.  To provide the required output,\n  #  we rebuild the list by replaying the steps we performed.)\n  # For clarity and correctness we store actions as we go:\n  # (Re\u2011run the whole plan while recording actions.)\n\n  # ---- Re\u2011run with recording ------------------------------------------------\n  env.reset()\n  state = env._current_state\n  recorded = []\n\n  # Re\u2011collect primitives\n  for prim_idx, cnt in env.world.cookbook.primitives_for(stick_idx).items():\n      while cnt > 0:\n          locs = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          target = tuple(locs[0])\n          # move & face\n          path = _bfs_to_adjacent(state.pos, target, state.grid)\n          for a in _positions_to_actions(path):\n              recorded.append(a)\n              _, _ = env.step(a)\n              state = env._current_state\n          # ensure facing\n          cx, cy = state.pos\n          tx, ty = target\n          dir_vec = (tx - cx, ty - cy)\n          # adjust if needed\n          if path and (path[-1][0] - path[-2][0], path[-1][1] - path[-2][1]) != dir_vec:\n              opp = (-dir_vec[0], -dir_vec[1])\n              away = (cx + opp[0], cy + opp[1])\n              H, W = state.grid.shape[:2]\n              if _in_bounds(away, (H, W)) and not _is_blocked(away, state.grid):\n                  recorded.append(_vec_to_action[opp])\n                  _, _ = env.step(_vec_to_action[opp])\n                  state = env._current_state\n                  recorded.append(_vec_to_action[dir_vec])\n                  _, _ = env.step(_vec_to_action[dir_vec])\n                  state = env._current_state\n              else:\n                  recorded.append(_vec_to_action[dir_vec])\n                  _, _ = env.step(_vec_to_action[dir_vec])\n                  state = env._current_state\n          # pick up\n          recorded.append(_use_action)\n          _, _ = env.step(_use_action)\n          state = env._current_state\n          cnt -= 1\n\n  # Move to workshop and craft\n  if workshop_name is not None:\n      ws_idx = idx.index(workshop_name)\n      ws_loc = tuple(np.argwhere(state.grid[:, :, ws_idx] > 0)[0])\n      path = _bfs_to_adjacent(state.pos, ws_loc, state.grid)\n      for a in _positions_to_actions(path):\n          recorded.append(a)\n          _, _ = env.step(a)\n          state = env._current_state\n      # Ensure facing (same logic as above)\n      cx, cy = state.pos\n      tx, ty = ws_loc\n      dir_vec = (tx - cx, ty - cy)\n      if path and (path[-1][0] - path[-2][0], path[-1][1] - path[-2][1]) != dir_vec:\n          opp = (-dir_vec[0], -dir_vec[1])\n          away = (cx + opp[0], cy + opp[1])\n          H, W = state.grid.shape[:2]\n          if _in_bounds(away, (H, W)) and not _is_blocked(away, state.grid):\n              recorded.append(_vec_to_action[opp])\n              _, _ = env.step(_vec_to_action[opp])\n              state = env._current_state\n              recorded.append(_vec_to_action[dir_vec])\n              _, _ = env.step(_vec_to_action[dir_vec])\n              state = env._current_state\n          else:\n              recorded.append(_vec_to_action[dir_vec])\n              _, _ = env.step(_vec_to_action[dir_vec])\n              state = env._current_state\n      # craft\n      recorded.append(_use_action)\n      _, _ = env.step(_use_action)\n      state = env._current_state\n\n  return recorded", "env_interactions": 0, "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-10-21T18:08:40.967387", "function_name": "make_stick", "function_body": "  # Reset environment and get current state/world\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  cookbook = world.cookbook\n\n  # -------------------------------------------------------------\n  # Identify index of the target item \"stick\"\n  # -------------------------------------------------------------\n  try:\n      stick_idx = cookbook.index[\"stick\"]\n  except Exception:\n      return []   # stick not defined in this world\n\n  # -------------------------------------------------------------\n  # Determine the primitive ingredients required for one stick\n  # -------------------------------------------------------------\n  prim_req = cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n  stick_is_primitive = not bool(prim_req)          # if no recipe, stick itself is primitive\n  if stick_is_primitive:\n      prim_req = {stick_idx: 1}\n\n  # -------------------------------------------------------------\n  # Action mapping (environment specific)\n  # -------------------------------------------------------------\n  act_map = env.action_specs()\n  DOWN = act_map.get('DOWN', 0)\n  UP = act_map.get('UP', 1)\n  LEFT = act_map.get('LEFT', 2)\n  RIGHT = act_map.get('RIGHT', 3)\n  USE = act_map.get('USE', 4)\n\n  # -------------------------------------------------------------\n  # Helper: generate movement actions from a start to a target cell\n  # -------------------------------------------------------------\n  def moves_to(start, target):\n      \"\"\"Return a list of actions moving from start (x,y) to target (x,y).\"\"\"\n      cx, cy = start\n      tx, ty = target\n      actions = []\n      while cx < tx:\n          actions.append(DOWN); cx += 1\n      while cx > tx:\n          actions.append(UP); cx -= 1\n      while cy < ty:\n          actions.append(RIGHT); cy += 1\n      while cy > ty:\n          actions.append(LEFT); cy -= 1\n      return actions\n\n  # -------------------------------------------------------------\n  # Locate all required primitives on the grid\n  # -------------------------------------------------------------\n  grid = state.grid\n  prim_locs = {}\n  for p_idx in prim_req:\n      positions = np.argwhere(grid[:, :, p_idx] > 0)\n      prim_locs[p_idx] = [tuple(pos) for pos in positions]\n\n  # -------------------------------------------------------------\n  # Locate a workshop (if crafting is required)\n  # -------------------------------------------------------------\n  workshop_pos = None\n  if not stick_is_primitive:\n      for wk_idx in world.workshop_indices:\n          cells = np.argwhere(grid[:, :, wk_idx] > 0)\n          if cells.size:\n              workshop_pos = tuple(cells[0])\n              break\n\n  # -------------------------------------------------------------\n  # Build the action plan\n  # -------------------------------------------------------------\n  cur_pos = state.pos\n  plan = []\n\n  # Collect each required primitive, preferring the nearest instance\n  for p_idx, needed in prim_req.items():\n      collected = 0\n      available = prim_locs.get(p_idx, []).copy()\n      if len(available) < needed:\n          # Not enough of this primitive on the map \u2013 cannot finish task\n          return []\n      while collected < needed:\n          # Find nearest primitive location\n          dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in available]\n          nearest = int(np.argmin(dists))\n          target = available.pop(nearest)\n\n          # Move to the primitive and pick it up\n          plan.extend(moves_to(cur_pos, target))\n          cur_pos = target\n          plan.append(USE)          # pick up the primitive\n          collected += 1\n\n  # If crafting is required, move to a workshop and invoke USE to craft\n  if not stick_is_primitive:\n      if workshop_pos is not None:\n          plan.extend(moves_to(cur_pos, workshop_pos))\n          cur_pos = workshop_pos\n      plan.append(USE)              # trigger crafting at the workshop\n\n  return plan", "env_interactions": 4, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:08:42.097916", "function_name": "make_stick", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  # Identify the index for the target item \"stick\"\n  try:\n      stick_idx = cookbook.index[\"stick\"]\n  except Exception:\n      return []  # stick not defined\n\n  # Determine primitive ingredients needed for one stick\n  prim_req = cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n  stick_is_primitive = not bool(prim_req)\n  if stick_is_primitive:\n      prim_req = {stick_idx: 1}\n\n  # Action mapping\n  act_map = env.action_specs()\n  DOWN = act_map.get('DOWN', 0)\n  UP = act_map.get('UP', 1)\n  LEFT = act_map.get('LEFT', 2)\n  RIGHT = act_map.get('RIGHT', 3)\n  USE = act_map.get('USE', 4)\n\n  # Helper to generate movement actions between two cells\n  def moves_to(start, target):\n      cx, cy = start\n      tx, ty = target\n      actions = []\n      while cx < tx:\n          actions.append(DOWN)\n          cx += 1\n      while cx > tx:\n          actions.append(UP)\n          cx -= 1\n      while cy < ty:\n          actions.append(RIGHT)\n          cy += 1\n      while cy > ty:\n          actions.append(LEFT)\n          cy -= 1\n      return actions\n\n  # Locate all required primitives on the grid\n  grid = state.grid\n  prim_locs = {}\n  for p_idx in prim_req:\n      positions = np.argwhere(grid[:, :, p_idx] > 0)\n      prim_locs[p_idx] = [tuple(pos) for pos in positions]\n\n  # Locate a workshop if crafting is required\n  workshop_pos = None\n  if not stick_is_primitive:\n      for wk_idx in world.workshop_indices:\n          cells = np.argwhere(grid[:, :, wk_idx] > 0)\n          if cells.size:\n              workshop_pos = tuple(cells[0])\n              break\n\n  # Build the action plan\n  cur_pos = state.pos\n  plan = []\n\n  # Collect each required primitive, preferring the nearest instance\n  for p_idx, needed in prim_req.items():\n      collected = 0\n      available = prim_locs.get(p_idx, []).copy()\n      if len(available) < needed:\n          return []  # not enough primitives available\n      while collected < needed:\n          dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in available]\n          nearest = int(np.argmin(dists))\n          target = available.pop(nearest)\n\n          plan.extend(moves_to(cur_pos, target))\n          cur_pos = target\n          plan.append(USE)  # pick up the primitive\n          collected += 1\n\n  # If crafting is required, move to a workshop and invoke USE to craft\n  if not stick_is_primitive:\n      if workshop_pos is not None:\n          plan.extend(moves_to(cur_pos, workshop_pos))\n          cur_pos = workshop_pos\n      plan.append(USE)  # trigger crafting\n\n  return plan", "env_interactions": 4, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:09:01.012240", "function_name": "make_stick", "function_body": "  env.reset()\n  state = env._current_state\n\n  act_spec = env.action_specs()\n  ACTION_USE = act_spec[\"USE\"]\n  ACTIONS_MOVE = {k: act_spec[k] for k in (\"UP\", \"DOWN\", \"LEFT\", \"RIGHT\")}\n  DIR_VECT = {\"UP\": (-1, 0), \"DOWN\": (1, 0), \"LEFT\": (0, -1), \"RIGHT\": (0, 1)}\n\n  from collections import deque\n\n  def bfs_path(start, targets):\n      h, w = state.grid.shape[:2]\n      visited = set()\n      q = deque([(start, [])])\n      while q:\n          pos, path = q.popleft()\n          if pos in visited:\n              continue\n          visited.add(pos)\n          if pos in targets:\n              return path\n          x, y = pos\n          for name, (dx, dy) in DIR_VECT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < h and 0 <= ny < w:\n                  if not state.grid[nx, ny].any():\n                      q.append(((nx, ny), path + [ACTIONS_MOVE[name]]))\n      return None\n\n  idx = state.world.cookbook.index\n  stick_idx = idx.index(\"stick\")\n  primitive_needs = state.world.cookbook.primitives_for(stick_idx)\n\n  actions = []\n\n  for prim_idx, needed_cnt in primitive_needs.items():\n      while state.inventory[prim_idx] < needed_cnt:\n          h, w = state.grid.shape[:2]\n          prim_locs = [\n              (i, j)\n              for i in range(h)\n              for j in range(w)\n              if state.grid[i, j, prim_idx] > 0\n          ]\n          if not prim_locs:\n              break\n          path = bfs_path(state.pos, set(prim_locs))\n          if path is None:\n              break\n          for a in path:\n              _, state = state.step(a)\n              actions.append(a)\n          _, state = state.step(ACTION_USE)\n          actions.append(ACTION_USE)\n\n  recipe = state.world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\") if isinstance(recipe, dict) else None\n  if workshop_name:\n      workshop_idx = idx.index(workshop_name)\n      h, w = state.grid.shape[:2]\n      workshop_cells = [\n          (i, j)\n          for i in range(h)\n          for j in range(w)\n          if state.grid[i, j, workshop_idx] > 0\n      ]\n      if workshop_cells:\n          path = bfs_path(state.pos, set(workshop_cells))\n          if path:\n              for a in path:\n                  _, state = state.step(a)\n                  actions.append(a)\n              _, state = state.step(ACTION_USE)\n              actions.append(ACTION_USE)\n\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:09:02.135575", "function_name": "make_stick", "function_body": "  # Reset environment and get initial state\n  env.reset()\n  state = env._current_state  # type: CraftState\n\n  # ------------------------------------------------------------------\n  # Action utilities\n  # ------------------------------------------------------------------\n  act_spec = env.action_specs()\n  ACTION_USE = act_spec[\"USE\"]\n  ACTIONS_MOVE = {k: act_spec[k] for k in (\"UP\", \"DOWN\", \"LEFT\", \"RIGHT\")}\n  DIR_VECT = {\n      \"UP\": (-1, 0),\n      \"DOWN\": (1, 0),\n      \"LEFT\": (0, -1),\n      \"RIGHT\": (0, 1),\n  }\n\n  from collections import deque\n\n  # Breadth\u2011first search that returns a list of action IDs moving from\n  # ``start`` to the nearest cell in ``targets`` (if reachable).\n  def bfs_path(start, targets):\n      h, w = state.grid.shape[:2]\n      visited = set()\n      q = deque([(start, [])])\n      while q:\n          pos, path = q.popleft()\n          if pos in visited:\n              continue\n          visited.add(pos)\n          if pos in targets:\n              return path\n          x, y = pos\n          for name, (dx, dy) in DIR_VECT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < h and 0 <= ny < w:\n                  # Cell is walkable if it contains no entities.\n                  if not state.grid[nx, ny].any():\n                      q.append(((nx, ny), path + [ACTIONS_MOVE[name]]))\n      return None\n\n  # ------------------------------------------------------------------\n  # Identify stick and its primitive requirements.\n  # ------------------------------------------------------------------\n  idx = state.world.cookbook.index\n  stick_idx = idx.index(\"stick\")\n  primitive_needs = state.world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive.\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      while state.inventory[prim_idx] < needed_cnt:\n          # Locate all current instances of the primitive on the map.\n          h, w = state.grid.shape[:2]\n          prim_cells = [\n              (i, j)\n              for i in range(h)\n              for j in range(w)\n              if state.grid[i, j, prim_idx] > 0\n          ]\n          if not prim_cells:\n              # No more primitives left; abort collection loop.\n              break\n\n          # Find shortest path to any of them.\n          path = bfs_path(state.pos, set(prim_cells))\n          if path is None:\n              # Unreachable primitive; abort.\n              break\n\n          # Execute movement actions.\n          for a in path:\n              _, state = state.step(a)\n              actions.append(a)\n\n          # Use (collect) the primitive.\n          _, state = state.step(ACTION_USE)\n          actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # Craft at workshop if the recipe specifies one.\n  # ------------------------------------------------------------------\n  recipe = state.world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\") if isinstance(recipe, dict) else None\n  if workshop_name:\n      workshop_idx = idx.index(workshop_name)\n      h, w = state.grid.shape[:2]\n      workshop_cells = [\n          (i, j)\n          for i in range(h)\n          for j in range(w)\n          if state.grid[i, j, workshop_idx] > 0\n      ]\n      if workshop_cells:\n          path = bfs_path(state.pos, set(workshop_cells))\n          if path:\n              for a in path:\n                  _, state = state.step(a)\n                  actions.append(a)\n              # Use (craft) at the workshop.\n              _, state = state.step(ACTION_USE)\n              actions.append(ACTION_USE)\n\n  # Return the full action sequence.\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:09:25.394580", "function_name": "make_stick", "function_body": "  import numpy as np\n\n  actions = []\n\n  # Goal index\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      return actions\n\n  # World, cookbook, and current state\n  world = getattr(env, \"world\", None)\n  if world is None:\n      return actions\n  cookbook = getattr(world, \"cookbook\", None)\n  if cookbook is None:\n      return actions\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return actions\n\n  grid = getattr(state, \"grid\", None)\n  pos = getattr(state, \"pos\", None)\n  if grid is None or pos is None:\n      return actions\n\n  # Action indices\n  spec = env.action_specs()\n  DOWN = spec.get(\"DOWN\")\n  UP = spec.get(\"UP\")\n  LEFT = spec.get(\"LEFT\")\n  RIGHT = spec.get(\"RIGHT\")\n  USE = spec.get(\"USE\")\n\n  # Helper functions\n  def manhattan(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def nearest(targets, src):\n      if not targets:\n          return None\n      return min(targets, key=lambda t: manhattan(t, src))\n\n  def move_to(target):\n      nonlocal pos\n      # vertical movement (row index)\n      while pos[0] < target[0]:\n          actions.append(DOWN)\n          pos = (pos[0] + 1, pos[1])\n      while pos[0] > target[0]:\n          actions.append(UP)\n          pos = (pos[0] - 1, pos[1])\n      # horizontal movement (col index)\n      while pos[1] < target[1]:\n          actions.append(RIGHT)\n          pos = (pos[0], pos[1] + 1)\n      while pos[1] > target[1]:\n          actions.append(LEFT)\n          pos = (pos[0], pos[1] - 1)\n\n  # Determine required primitives for the goal\n  primitives_needed = cookbook.primitives_for(goal_idx)\n  if not primitives_needed:\n      # Goal itself may be a primitive that must be collected\n      primitives_needed = {goal_idx: 1}\n\n  # Collect each required primitive\n  for prim_idx, needed in primitives_needed.items():\n      # Find all cells containing this primitive\n      locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n      if not locations:\n          # Required primitive not present in the world\n          return actions\n      collected = 0\n      while collected < needed:\n          target = nearest(locations, pos)\n          if target is None:\n              return actions\n          move_to(target)\n          actions.append(USE)            # pick up the primitive\n          collected += 1\n          # Assume the primitive disappears after pickup\n          if target in locations:\n              locations.remove(target)\n\n  # Move to the appropriate workshop if the recipe specifies one\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      ws_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n      if ws_cells:\n          ws_target = nearest(ws_cells, pos)\n          if ws_target is not None:\n              move_to(ws_target)\n\n  # Final crafting action\n  actions.append(USE)\n\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:09:26.520674", "function_name": "make_stick", "function_body": "  # Initialize empty action list\n  actions = []\n\n  # ----- Extract essential objects -----\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      return actions\n\n  world = getattr(env, \"world\", None)\n  if world is None:\n      return actions\n\n  cookbook = getattr(world, \"cookbook\", None)\n  if cookbook is None:\n      return actions\n\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return actions\n\n  grid = getattr(state, \"grid\", None)\n  pos = tuple(getattr(state, \"pos\", (0, 0)))\n  if grid is None or pos is None:\n      return actions\n\n  # ----- Action indices -----\n  action_map = env.action_specs()\n  DOWN = action_map.get(\"DOWN\", 0)\n  UP = action_map.get(\"UP\", 1)\n  LEFT = action_map.get(\"LEFT\", 2)\n  RIGHT = action_map.get(\"RIGHT\", 3)\n  USE = action_map.get(\"USE\", 4)\n\n  # ----- Helper utilities -----\n  def manhattan(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def nearest_target(targets, src):\n      if not targets:\n          return None\n      return min(targets, key=lambda t: manhattan(t, src))\n\n  def move_to(target):\n      nonlocal pos\n      # vertical movement (row index)\n      while pos[0] < target[0]:\n          actions.append(DOWN)\n          pos = (pos[0] + 1, pos[1])\n      while pos[0] > target[0]:\n          actions.append(UP)\n          pos = (pos[0] - 1, pos[1])\n      # horizontal movement (col index)\n      while pos[1] < target[1]:\n          actions.append(RIGHT)\n          pos = (pos[0], pos[1] + 1)\n      while pos[1] > target[1]:\n          actions.append(LEFT)\n          pos = (pos[0], pos[1] - 1)\n\n  # ----- Determine required primitives -----\n  primitives_needed = cookbook.primitives_for(goal_idx)\n  if not primitives_needed:\n      # Goal may itself be a primitive to collect\n      primitives_needed = {goal_idx: 1}\n\n  # ----- Collect each primitive -----\n  for prim_idx, needed in primitives_needed.items():\n      # Locate all cells currently holding this primitive\n      locations = [tuple(coord) for coord in np.argwhere(grid[:, :, prim_idx] > 0)]\n      if not locations:\n          # Primitive not present in the world \u2013 abort\n          return []\n      collected = 0\n      while collected < needed:\n          target = nearest_target(locations, pos)\n          if target is None:\n              return []\n          move_to(target)\n          actions.append(USE)          # pick up the primitive\n          collected += 1\n          # Assume the primitive disappears after collection\n          if target in locations:\n              locations.remove(target)\n\n  # ----- Move to workshop (if required) -----\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      workshop_cells = [tuple(coord) for coord in np.argwhere(grid[:, :, workshop_kind] > 0)]\n      if workshop_cells:\n          ws_target = nearest_target(workshop_cells, pos)\n          if ws_target is not None:\n              move_to(ws_target)\n\n  # ----- Final crafting action -----\n  actions.append(USE)\n\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:09:55.329980", "function_name": "make_stick", "function_body": "  env.reset()\n  world = env.world\n  idx = world.cookbook.index\n\n  # action indices\n  action_map = env.action_specs()\n  DOWN = action_map[\"DOWN\"]\n  UP = action_map[\"UP\"]\n  LEFT = action_map[\"LEFT\"]\n  RIGHT = action_map[\"RIGHT\"]\n  USE = action_map[\"USE\"]\n\n  # get stick index\n  stick_idx = idx[\"stick\"]\n\n  # compute required primitives (or stick itself if primitive)\n  needed = world.cookbook.primitives_for(stick_idx)\n  if not needed:\n      needed = {stick_idx: 1}\n\n  # current simulated state\n  state = env._current_state\n  cur_pos = tuple(state.pos)\n  grid = state.grid.copy()\n\n  # blocked cells mask (any non\u2011grabbable entity present)\n  non_grabbable = list(world.non_grabbable_indices)\n  if non_grabbable:\n      blocked = np.any(grid[:, :, non_grabbable] > 0, axis=2)\n  else:\n      blocked = np.zeros(grid.shape[:2], dtype=bool)\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # helper: BFS that returns a list of actions to reach any target cell\n  # ------------------------------------------------------------------\n  def bfs(start, targets, blocked_mask):\n      if start in targets:\n          return []\n      from collections import deque\n      q = deque([start])\n      came = {start: (None, None)}  # node -> (parent, action)\n      while q:\n          cur = q.popleft()\n          for act, (dx, dy) in ((DOWN, (0, 1)), (UP, (0, -1)),\n                                (LEFT, (-1, 0)), (RIGHT, (1, 0))):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if not (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]):\n                  continue\n              if blocked_mask[nx, ny]:\n                  continue\n              nxt = (nx, ny)\n              if nxt in came:\n                  continue\n              came[nxt] = (cur, act)\n              if nxt in targets:\n                  # reconstruct path\n                  path = []\n                  node = nxt\n                  while came[node][0] is not None:\n                      parent, a = came[node]\n                      path.append(a)\n                      node = parent\n                  return list(reversed(path))\n              q.append(nxt)\n      # fallback: direct Manhattan moves ignoring obstacles\n      target = next(iter(targets))\n      x, y = start\n      tx, ty = target\n      path = []\n      while x < tx:\n          path.append(RIGHT); x += 1\n      while x > tx:\n          path.append(LEFT); x -= 1\n      while y < ty:\n          path.append(DOWN); y += 1\n      while y > ty:\n          path.append(UP); y -= 1\n      return path\n\n  # ------------------------------------------------------------------\n  # 1. Collect required items\n  # ------------------------------------------------------------------\n  for item_idx, count in needed.items():\n      remaining = int(count)\n      while remaining > 0:\n          locs = np.argwhere(grid[:, :, item_idx] > 0)\n          if locs.size == 0:\n              # cannot find more, break to avoid infinite loop\n              break\n          # choose nearest location by Manhattan distance\n          dists = np.abs(locs[:, 0] - cur_pos[0]) + np.abs(locs[:, 1] - cur_pos[1])\n          target = tuple(locs[dists.argmin()])\n          # move there\n          actions += bfs(cur_pos, {target}, blocked)\n          cur_pos = target\n          # pick up\n          actions.append(USE)\n          remaining -= 1\n          # update simulated grid and blocked mask\n          grid[target[0], target[1], item_idx] -= 1\n          if non_grabbable:\n              blocked[target[0], target[1]] = np.any(\n                  grid[target[0], target[1], non_grabbable] > 0\n              )\n\n  # ------------------------------------------------------------------\n  # 2. Go to workshop (if any) and craft\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = idx[workshop_name]\n      ws_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_locs.size:\n          # pick nearest workshop\n          dists = np.abs(ws_locs[:, 0] - cur_pos[0]) + np.abs(ws_locs[:, 1] - cur_pos[1])\n          ws_target = tuple(ws_locs[dists.argmin()])\n          actions += bfs(cur_pos, {ws_target}, blocked)\n          cur_pos = ws_target\n          actions.append(USE)\n\n  return actions", "env_interactions": 4, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:09:56.465548", "function_name": "make_stick", "function_body": "  # reset environment to start fresh\n  env.reset()\n  world = env.world\n  idx = world.cookbook.index\n\n  # ------------------------------------------------------------------\n  # Action indices\n  # ------------------------------------------------------------------\n  action_map = env.action_specs()\n  DOWN = action_map[\"DOWN\"]\n  UP = action_map[\"UP\"]\n  LEFT = action_map[\"LEFT\"]\n  RIGHT = action_map[\"RIGHT\"]\n  USE = action_map[\"USE\"]\n\n  # ------------------------------------------------------------------\n  # Identify the stick item index (fallback in case of case mismatch)\n  # ------------------------------------------------------------------\n  try:\n      stick_idx = idx[\"stick\"]\n  except Exception:  # pragma: no cover\n      stick_idx = next(i for i, n in enumerate(idx.ordered_contents) if n.lower() == \"stick\")\n\n  # ------------------------------------------------------------------\n  # Determine which primitives (or the stick itself) need to be collected\n  # ------------------------------------------------------------------\n  needed_prims = world.cookbook.primitives_for(stick_idx)\n  if needed_prims:\n      needed_items = needed_prims\n  else:\n      # stick is itself a primitive \u2013 we just need one stick\n      needed_items = {stick_idx: 1}\n\n  # ------------------------------------------------------------------\n  # Simulated view of the grid and blocked cells (non\u2011grabbable entities)\n  # ------------------------------------------------------------------\n  state = env._current_state\n  cur_pos = tuple(state.pos)\n  grid = state.grid.copy()\n  non_grabbable = list(world.non_grabbable_indices)\n  if non_grabbable:\n      blocked_mask = np.any(grid[:, :, non_grabbable] > 0, axis=2)\n  else:\n      blocked_mask = np.zeros(grid.shape[:2], dtype=bool)\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper: Breadth\u2011first search returning a list of actions to reach\n  # any cell in *targets* from *start* while avoiding *blocked* cells.\n  # ------------------------------------------------------------------\n  def bfs_path(start, targets, blocked):\n      \"\"\"Return a list of actions to reach the nearest target.\"\"\"\n      if start in targets:\n          return []\n      from collections import deque\n\n      q = deque([start])\n      visited = {start: (None, None)}  # node -> (parent, action)\n\n      while q:\n          cur = q.popleft()\n          for act, (dx, dy) in (\n              (DOWN, (0, 1)),\n              (UP, (0, -1)),\n              (LEFT, (-1, 0)),\n              (RIGHT, (1, 0)),\n          ):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if not (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]):\n                  continue\n              if blocked[nx, ny]:\n                  continue\n              nxt = (nx, ny)\n              if nxt in visited:\n                  continue\n              visited[nxt] = (cur, act)\n              if nxt in targets:\n                  # reconstruct path\n                  path = []\n                  node = nxt\n                  while visited[node][0] is not None:\n                      parent, a = visited[node]\n                      path.append(a)\n                      node = parent\n                  return list(reversed(path))\n              q.append(nxt)\n\n      # Fallback: straight Manhattan moves (ignores obstacles)\n      target = next(iter(targets))\n      x, y = start\n      tx, ty = target\n      path = []\n      while x < tx:\n          path.append(RIGHT)\n          x += 1\n      while x > tx:\n          path.append(LEFT)\n          x -= 1\n      while y < ty:\n          path.append(DOWN)\n          y += 1\n      while y > ty:\n          path.append(UP)\n          y -= 1\n      return path\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives (or the stick itself)\n  # ------------------------------------------------------------------\n  for item_idx, need_cnt in needed_items.items():\n      remaining = int(need_cnt)\n      while remaining > 0:\n          # locate all cells that currently contain the required item\n          locations = np.argwhere(grid[:, :, item_idx] > 0)\n          if locations.size == 0:\n              # No more of this item on the map \u2013 abort collection loop\n              break\n\n          # pick the nearest location (Manhattan distance as heuristic)\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          target = tuple(locations[dists.argmin()])\n\n          # compute a walkable path to the target cell\n          path = bfs_path(cur_pos, {target}, blocked_mask)\n          actions.extend(path)\n          cur_pos = target\n\n          # pick up the item (USE once per unit)\n          actions.append(USE)\n          remaining -= 1\n\n          # update simulated grid and blocked mask\n          grid[target[0], target[1], item_idx] -= 1\n          if non_grabbable:\n              blocked_mask[target[0], target[1]] = np.any(\n                  grid[target[0], target[1], non_grabbable] > 0\n              )\n\n  # ------------------------------------------------------------------\n  # 2. If a workshop is required for the stick, move there and craft\n  # ------------------------------------------------------------------\n  stick_recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = stick_recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = idx[workshop_name]\n      ws_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_locs.size:\n          ws_target = tuple(ws_locs[0])\n          path = bfs_path(cur_pos, {ws_target}, blocked_mask)\n          actions.extend(path)\n          cur_pos = ws_target\n          actions.append(USE)  # craft at the workshop\n\n  return actions", "env_interactions": 4, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:11:09.638024", "function_name": "make_stick", "function_body": "  # Initialise references\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n  stick_idx = idx.index('stick')\n  act_map = env.action_specs()                     # e.g. {\"UP\":0, \"DOWN\":1, ...}\n  inv_act = {v: k for k, v in act_map.items()}\n\n  # Mapping from movement delta to action index\n  delta_to_action = {\n      (-1, 0): act_map[\"UP\"],\n      (1, 0): act_map[\"DOWN\"],\n      (0, -1): act_map[\"LEFT\"],\n      (0, 1): act_map[\"RIGHT\"],\n  }\n\n  actions = []\n\n  # -------------------------------------------------------------------------\n  # Helper utilities (use current `state` and `world` inside)\n  # -------------------------------------------------------------------------\n  def walkable(pos, grid):\n      \"\"\"Return True if cell `pos` is empty (no entity occupies it).\"\"\"\n      x, y = pos\n      return not np.any(grid[x, y, :])\n\n  def bfs(start, goals, grid):\n      \"\"\"Bread\u2011first search from `start` to any position in `goals`.\"\"\"\n      from collections import deque\n      q = deque([start])\n      prev = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur in goals:\n              # reconstruct path\n              path = []\n              while cur is not None:\n                  path.append(cur)\n                  cur = prev[cur]\n              path.reverse()\n              return path\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n                  nxt = (nx, ny)\n                  if nxt not in prev and walkable(nxt, grid):\n                      prev[nxt] = cur\n                      q.append(nxt)\n      return None\n\n  def move_to_action(p, q):\n      \"\"\"Convert a step from p -> q into the appropriate action index.\"\"\"\n      dx, dy = q[0] - p[0], q[1] - p[1]\n      return delta_to_action[(dx, dy)]\n\n  def adjacent_walkable(target, grid):\n      \"\"\"List of empty cells adjacent to `target`.\"\"\"\n      x, y = target\n      adj = []\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n              if walkable((nx, ny), grid):\n                  adj.append((nx, ny))\n      return adj\n\n  def execute_path(path, grid):\n      \"\"\"Run actions following `path` (list of positions).\"\"\"\n      nonlocal actions, state, env\n      for i in range(1, len(path)):\n          act = move_to_action(path[i - 1], path[i])\n          actions.append(act)\n          _, state = env.step(act)\n          env._current_state = state\n          grid = state.grid\n      return grid\n\n  def face_target_and_use(agent_pos, target_pos):\n      \"\"\"Ensure the agent faces `target_pos` and performs USE.\"\"\"\n      nonlocal actions, state, env\n      dx = target_pos[0] - agent_pos[0]\n      dy = target_pos[1] - agent_pos[1]\n      face_act = delta_to_action[(dx, dy)]\n\n      # Step back then forward to set direction (if possible)\n      # we are guaranteed to have arrived from some previous cell unless we started adjacent.\n      # Use the previous cell from the last executed path if available.\n      # Here we simply move one step opposite if that cell is walkable, else perform a dummy left\u2011right pair.\n      opp_dx, opp_dy = -dx, -dy\n      opp_pos = (agent_pos[0] + opp_dx, agent_pos[1] + opp_dy)\n      if (0 <= opp_pos[0] < state.grid.shape[0] and\n          0 <= opp_pos[1] < state.grid.shape[1] and\n          walkable(opp_pos, state.grid)):\n          # move opposite\n          actions.append(delta_to_action[(opp_dx, opp_dy)])\n          _, state = env.step(delta_to_action[(opp_dx, opp_dy)])\n          env._current_state = state\n          # move forward (now facing target)\n          actions.append(face_act)\n          _, state = env.step(face_act)\n          env._current_state = state\n      else:\n          # dummy left\u2011right to reset direction\n          dummy = act_map[\"LEFT\"]\n          actions.append(dummy)\n          _, state = env.step(dummy)\n          env._current_state = state\n          actions.append(face_act)\n          _, state = env.step(face_act)\n          env._current_state = state\n\n      # finally USE\n      actions.append(act_map[\"USE\"])\n      _, state = env.step(act_map[\"USE\"])\n      env._current_state = state\n\n  def collect_item(item_idx):\n      \"\"\"Navigate to the nearest instance of `item_idx` and pick it up.\"\"\"\n      nonlocal state\n      grid = state.grid\n      locations = np.argwhere(grid[:, :, item_idx] > 0)\n      if locations.size == 0:\n          raise RuntimeError(f\"Item index {item_idx} not found on map.\")\n      cur = tuple(state.pos)\n\n      best_path = None\n      best_target = None\n\n      for loc in locations:\n          tx, ty = int(loc[0]), int(loc[1])\n          adj_cells = adjacent_walkable((tx, ty), grid)\n          for adj in adj_cells:\n              path = bfs(cur, {adj}, grid)\n              if path is not None:\n                  if best_path is None or len(path) < len(best_path):\n                      best_path = path\n                      best_target = (tx, ty)\n\n      if best_path is None:\n          raise RuntimeError(\"Cannot reach required item.\")\n\n      # Move to adjacent cell\n      grid = execute_path(best_path, grid)\n\n      # Face the item and use\n      face_target_and_use(best_path[-1], best_target)\n\n  def go_to_workshop_and_use(workshop_idx):\n      \"\"\"Navigate to a workshop cell and invoke USE (craft).\"\"\"\n      nonlocal state\n      grid = state.grid\n      locations = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if locations.size == 0:\n          raise RuntimeError(\"Workshop not found on map.\")\n      cur = tuple(state.pos)\n\n      best_path = None\n      best_target = None\n\n      for loc in locations:\n          wx, wy = int(loc[0]), int(loc[1])\n          adj_cells = adjacent_walkable((wx, wy), grid)\n          for adj in adj_cells:\n              path = bfs(cur, {adj}, grid)\n              if path is not None:\n                  if best_path is None or len(path) < len(best_path):\n                      best_path = path\n                      best_target = (wx, wy)\n\n      if best_path is None:\n          raise RuntimeError(\"Cannot reach workshop.\")\n\n      # Move to adjacent cell\n      grid = execute_path(best_path, grid)\n\n      # Face workshop and use (craft)\n      face_target_and_use(best_path[-1], best_target)\n\n  # -------------------------------------------------------------------------\n  # Main planning loop\n  # -------------------------------------------------------------------------\n  while state.inventory[stick_idx] == 0:\n      # Determine which primitive ingredients are still missing\n      needed = world.cookbook.primitives_for(stick_idx)  # dict {prim_idx: count}\n      missing = {}\n      for prim_idx, cnt in needed.items():\n          have = state.inventory[prim_idx]\n          if have < cnt:\n              missing[prim_idx] = cnt - have\n\n      if missing:\n          # Collect one missing primitive at a time\n          prim_idx, need_cnt = next(iter(missing.items()))\n          for _ in range(need_cnt):\n              collect_item(prim_idx)\n      else:\n          # All ingredients are present \u2013 perform crafting\n          recipe = world.cookbook.recipes.get(stick_idx, {})\n          workshop_idx = recipe.get('_at')\n          if workshop_idx is not None:\n              go_to_workshop_and_use(workshop_idx)\n          else:\n              # No specific workshop required \u2013 just USE to craft\n              actions.append(act_map[\"USE\"])\n              _, state = env.step(act_map[\"USE\"])\n              env._current_state = state\n          # After a crafting attempt the loop will exit if successful\n  # Return the accumulated action list\n  return actions", "env_interactions": 0, "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-10-21T18:11:10.748075", "function_name": "make_stick", "function_body": "", "env_interactions": 0, "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-10-21T18:11:50.414933", "function_name": "make_stick", "function_body": "  # reset environment and get the underlying state\n  env.reset()\n  state = env._current_state\n\n  # action indices according to the environment spec\n  act_spec = env.action_specs()\n  ACTION_USE = act_spec[\"USE\"]\n  ACTIONS_MOVE = {\n      \"UP\": act_spec[\"UP\"],\n      \"DOWN\": act_spec[\"DOWN\"],\n      \"LEFT\": act_spec[\"LEFT\"],\n      \"RIGHT\": act_spec[\"RIGHT\"],\n  }\n  DIR_VECT = {\n      \"UP\": (-1, 0),\n      \"DOWN\": (1, 0),\n      \"LEFT\": (0, -1),\n      \"RIGHT\": (0, 1),\n  }\n\n  # helper: breadth\u2011first search returning a list of actions that moves\n  # from start to any cell in `targets`.  Only empty cells are traversable.\n  from collections import deque\n\n  def bfs_path(start, targets):\n      h, w = state.grid.shape[:2]\n      visited = set()\n      q = deque([(start, [])])\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in visited:\n              continue\n          visited.add((x, y))\n          if (x, y) in targets:\n              return path\n          for name, (dx, dy) in DIR_VECT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < h and 0 <= ny < w:\n                  # traversable iff no entity occupies the cell\n                  if not state.grid[nx, ny].any():\n                      q.append(((nx, ny), path + [ACTIONS_MOVE[name]]))\n      return None\n\n  # -----------------------------------------------------------------\n  # 1. Determine what primitives are needed to craft a stick.\n  # -----------------------------------------------------------------\n  idx = state.world.cookbook.index\n  stick_idx = idx.index(\"stick\")\n  primitive_needs = state.world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n  actions = []\n\n  # -----------------------------------------------------------------\n  # 2. Collect each required primitive.\n  # -----------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      while state.inventory[prim_idx] < needed_cnt:\n          # locate all cells that currently hold this primitive\n          h, w = state.grid.shape[:2]\n          prim_cells = [(i, j)\n                        for i in range(h)\n                        for j in range(w)\n                        if state.grid[i, j, prim_idx] > 0]\n          if not prim_cells:\n              # no more of this primitive on the map \u2013 abort\n              return actions\n          # find shortest path to any of them\n          path = bfs_path(state.pos, set(prim_cells))\n          if path is None:\n              return actions\n          # execute the moves\n          for a in path:\n              _, state = state.step(a)\n              actions.append(a)\n          # pick up the primitive\n          _, state = state.step(ACTION_USE)\n          actions.append(ACTION_USE)\n\n  # -----------------------------------------------------------------\n  # 3. If the recipe requires a workshop, go there and craft.\n  # -----------------------------------------------------------------\n  recipe = state.world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\") if isinstance(recipe, dict) else None\n  if workshop_name:\n      workshop_idx = idx.index(workshop_name)\n      h, w = state.grid.shape[:2]\n      workshop_cells = [(i, j)\n                        for i in range(h)\n                        for j in range(w)\n                        if state.grid[i, j, workshop_idx] > 0]\n      if workshop_cells:\n          path = bfs_path(state.pos, set(workshop_cells))\n          if path:\n              for a in path:\n                  _, state = state.step(a)\n                  actions.append(a)\n              # craft at the workshop\n              _, state = state.step(ACTION_USE)\n              actions.append(ACTION_USE)\n\n  # -----------------------------------------------------------------\n  # 4. Return the accumulated action list.\n  # -----------------------------------------------------------------\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:16:50.541436", "function_name": "make_stick", "function_body": "  import numpy as np\n  from collections import deque\n\n  # reset environment and get initial state\n  env.reset()\n  state = env._current_state\n  grid = state.grid\n  H, W = grid.shape[:2]\n\n  # action specifications\n  act_spec = env.action_specs()\n  ACTION_USE = act_spec[\"USE\"]\n  ACTIONS = {\n      \"UP\": act_spec[\"UP\"],\n      \"DOWN\": act_spec[\"DOWN\"],\n      \"LEFT\": act_spec[\"LEFT\"],\n      \"RIGHT\": act_spec[\"RIGHT\"],\n  }\n  DIR_VECT = {\n      \"UP\": (-1, 0),\n      \"DOWN\": (1, 0),\n      \"LEFT\": (0, -1),\n      \"RIGHT\": (0, 1),\n  }\n\n  # convenience: cells that are empty (traversable)\n  traversable = np.sum(grid, axis=2) == 0\n\n  # helper BFS that also tracks facing direction\n  def bfs(start_pos, start_dir, goal_states):\n      \"\"\"Return (path, final_state) where path is list of actions.\n      goal_states is a set of tuples (x, y, dir) where dir can be None\n      meaning any facing direction is acceptable.\"\"\"\n      q = deque()\n      q.append((start_pos[0], start_pos[1], start_dir, []))\n      visited = set()\n      visited.add((start_pos[0], start_pos[1], start_dir))\n      while q:\n          x, y, cur_dir, path = q.popleft()\n          # check goal\n          if (x, y, cur_dir) in goal_states or (x, y, None) in goal_states:\n              return path, (x, y, cur_dir)\n          for name, act in ACTIONS.items():\n              dx, dy = DIR_VECT[name]\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < H and 0 <= ny < W and traversable[nx, ny]:\n                  ndir = act\n                  key = (nx, ny, ndir)\n                  if key not in visited:\n                      visited.add(key)\n                      q.append((nx, ny, ndir, path + [act]))\n      return None, None\n\n  # Identify stick index\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      return []  # stick not defined\n\n  # Determine primitive requirements for one stick\n  prim_req = env.world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n  actions = []\n\n  # Collect each required primitive\n  for prim_idx, needed_cnt in prim_req.items():\n      while state.inventory[prim_idx] < needed_cnt:\n          # locate all remaining primitives of this kind\n          prim_cells = [(i, j) for i in range(H) for j in range(W) if grid[i, j, prim_idx] > 0]\n          if not prim_cells:\n              # cannot find more, abort collection for this primitive\n              break\n\n          # build set of goal states: adjacent empty cell with correct facing direction\n          goal_states = set()\n          for (px, py) in prim_cells:\n              for name, (dx, dy) in DIR_VECT.items():\n                  ax, ay = px - dx, py - dy  # cell from which we would move towards the primitive\n                  if 0 <= ax < H and 0 <= ay < W and traversable[ax, ay]:\n                      needed_dir = ACTIONS[name]  # direction we must be facing after the move\n                      goal_states.add((ax, ay, needed_dir))\n\n          path, _ = bfs(state.pos, state.dir, goal_states)\n          if path is None:\n              # no reachable primitive, abort loop\n              break\n\n          # execute movement actions\n          for a in path:\n              _, state = state.step(a)\n              actions.append(a)\n          # use to pick up the primitive\n          _, state = state.step(ACTION_USE)\n          actions.append(ACTION_USE)\n\n  # After gathering primitives, attempt to craft stick at its workshop (if any)\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\") if isinstance(recipe, dict) else None\n  if workshop_name:\n      try:\n          workshop_idx = env.world.cookbook.index[workshop_name]\n      except Exception:\n          workshop_idx = None\n\n      if workshop_idx is not None:\n          # locate workshop cells\n          workshop_cells = [(i, j) for i in range(H) for j in range(W) if grid[i, j, workshop_idx] > 0]\n          if workshop_cells:\n              # goal: be adjacent (any direction) to a workshop cell\n              goal_states = set()\n              for (wx, wy) in workshop_cells:\n                  for name, (dx, dy) in DIR_VECT.items():\n                      ax, ay = wx + dx, wy + dy\n                      if 0 <= ax < H and 0 <= ay < W and traversable[ax, ay]:\n                          goal_states.add((ax, ay, None))\n              path, _ = bfs(state.pos, state.dir, goal_states)\n              if path is not None:\n                  for a in path:\n                      _, state = state.step(a)\n                      actions.append(a)\n                  # use at the workshop to craft the stick\n                  _, state = state.step(ACTION_USE)\n                  actions.append(ACTION_USE)\n\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-10-21T18:17:12.268740", "function_name": "make_stick", "function_body": "", "env_interactions": 0, "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-10-21T18:17:13.384978", "function_name": "make_stick", "function_body": "  try:\n      # Reset environment and obtain the current state\n      env.reset()\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          scenario = getattr(env, \"scenario\", None)\n          if scenario is not None:\n              state = scenario.init()\n      if state is None:\n          return []\n\n      world = state.world\n      grid = state.grid.copy()\n      h, w, _ = grid.shape\n      cur_pos = state.pos\n      actions = []\n\n      # ------------------------------------------------------------------\n      # Helper utilities\n      # ------------------------------------------------------------------\n      def find_cells(kind_idx):\n          \"\"\"Return list of (x, y) positions where `kind_idx` is present.\"\"\"\n          pts = np.argwhere(grid[:, :, kind_idx] > 0)\n          return [tuple(p) for p in pts]\n\n      # (dx, dy, action_id) \u2013 order matches CraftLab action indices\n      DIRS = [\n          (1, 0, 0),   # DOWN\n          (-1, 0, 1),  # UP\n          (0, -1, 2),  # LEFT\n          (0, 1, 3),   # RIGHT\n      ]\n\n      def is_blocked(x, y):\n          \"\"\"Cell is blocked if any non\u2011grabbable entity occupies it.\"\"\"\n          for idx in world.non_grabbable_indices:\n              if grid[x, y, idx] > 0:\n                  return True\n          return False\n\n      from collections import deque\n\n      def bfs(start, goal):\n          \"\"\"Bread\u2011first search returning a list of movement actions.\"\"\"\n          if start == goal:\n              return []\n          q = deque()\n          q.append((start, []))\n          visited = {start}\n          while q:\n              (cx, cy), path = q.popleft()\n              for dx, dy, act in DIRS:\n                  nx, ny = cx + dx, cy + dy\n                  if 0 <= nx < h and 0 <= ny < w and not is_blocked(nx, ny):\n                      if (nx, ny) not in visited:\n                          if (nx, ny) == goal:\n                              return path + [act]\n                          visited.add((nx, ny))\n                          q.append(((nx, ny), path + [act]))\n          # Unreachable\n          return []\n\n      # ------------------------------------------------------------------\n      # Determine recipe for a stick\n      # ------------------------------------------------------------------\n      stick_idx = world.cookbook.index[\"stick\"]\n      primitive_requirements = world.cookbook.primitives_for(stick_idx)\n\n      # If stick is itself a primitive, just go pick it up\n      if not primitive_requirements:\n          stick_cells = find_cells(stick_idx)\n          if not stick_cells:\n              return []\n          dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in stick_cells]\n          target = stick_cells[int(np.argmin(dists))]\n          actions.extend(bfs(cur_pos, target))\n          actions.append(4)  # USE to pick up\n          return actions\n\n      # ------------------------------------------------------------------\n      # Collect each required primitive\n      # ------------------------------------------------------------------\n      for prim_idx, needed_cnt in primitive_requirements.items():\n          for _ in range(needed_cnt):\n              prim_cells = find_cells(prim_idx)\n              if not prim_cells:\n                  return []  # missing primitive in the world\n              dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in prim_cells]\n              target = prim_cells[int(np.argmin(dists))]\n              move_actions = bfs(cur_pos, target)\n              if move_actions is None:\n                  return []  # unreachable\n              actions.extend(move_actions)\n              actions.append(4)  # USE to pick up\n              # Update simulated local state\n              cur_pos = target\n              grid[target[0], target[1], prim_idx] = 0\n\n      # ------------------------------------------------------------------\n      # Craft the stick at its workshop (if required)\n      # ------------------------------------------------------------------\n      recipe = world.cookbook.recipes.get(stick_idx, {})\n      workshop = recipe.get(\"_at\")\n      if workshop is not None:\n          # Convert possible string name to index\n          if isinstance(workshop, str):\n              workshop_idx = world.cookbook.index[workshop]\n          else:\n              workshop_idx = workshop\n          ws_cells = find_cells(workshop_idx)\n          if not ws_cells:\n              return []  # no workshop present\n          dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in ws_cells]\n          ws_target = ws_cells[int(np.argmin(dists))]\n          actions.extend(bfs(cur_pos, ws_target))\n          actions.append(4)  # USE to craft\n      else:\n          # Craft at current location\n          actions.append(4)  # USE\n\n      return actions\n  except Exception:\n      # On any unexpected condition, return an empty plan\n      return []", "env_interactions": 3, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:17:42.638494", "function_name": "make_stick", "function_body": "  actions = []\n  world = env.world\n  state = env._current_state\n\n  # Goal: stick\n  stick_idx = world.cookbook.index[\"stick\"]\n  if state.inventory[stick_idx] > 0:\n      return actions\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def move_action(cur, nxt):\n      \"\"\"Return the action index that moves from cur -> nxt.\"\"\"\n      dx = nxt[0] - cur[0]\n      dy = nxt[1] - cur[1]\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise ValueError(\"Invalid move step\")\n\n  def bfs_adjacent(start, targets, grid):\n      \"\"\"\n      Bread\u2011first search for the shortest path from ``start`` to any empty cell\n      that is orthogonally adjacent to one of ``targets``.\n      Returns a list of positions (including ``start``).\n      \"\"\"\n      W, H, _ = grid.shape\n      visited = np.full((W, H), False, dtype=bool)\n      q = collections.deque()\n      q.append((start, [start]))\n      visited[start] = True\n      target_set = {tuple(t) for t in targets}\n\n      while q:\n          (x, y), path = q.popleft()\n          # Adjacent to a target?\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n          # Expand neighbours (only through empty cells)\n          for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if grid[nx, ny, :].sum() == 0:   # empty\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [(nx, ny)]))\n      raise RuntimeError(\"No reachable adjacent cell to target\")\n\n  # ------------------------------------------------------------------\n  # 1) Collect all primitive resources required for a stick\n  # ------------------------------------------------------------------\n  primitive_requirements = world.cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n  cur_pos = tuple(state.pos)\n\n  for prim_idx, needed in primitive_requirements.items():\n      for _ in range(needed):\n          # Skip if we already have this primitive in inventory\n          if state.inventory[prim_idx] > 0:\n              continue\n\n          # Find all cells that contain the primitive\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(\"Required primitive not present in the world\")\n\n          # Plan a path to an empty cell adjacent to the primitive\n          path = bfs_adjacent(cur_pos, prim_cells, state.grid)\n\n          # Translate the path into movement actions\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n\n          # Pick up the primitive\n          actions.append(4)   # USE\n\n          # Simulate removal of the primitive so we don't target it again\n          cell = prim_cells[0]\n          state.grid[cell[0], cell[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 2) Move to the required workshop (if any) and craft the stick\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          raise RuntimeError(\"Workshop for stick not found in the world\")\n      path = bfs_adjacent(cur_pos, workshop_cells, state.grid)\n      for step in path[1:]:\n          actions.append(move_action(cur_pos, step))\n          cur_pos = step\n\n  # Final use action to craft the stick\n  actions.append(4)   # USE\n\n  return actions", "env_interactions": 3, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:17:43.751592", "function_name": "make_stick", "function_body": "  actions = []\n  world = env.world\n  state = env._current_state\n\n  # Index of the stick item\n  stick_idx = world.cookbook.index[\"stick\"]\n  if state.inventory[stick_idx] > 0:\n      return actions\n\n  def move_action(cur, nxt):\n      dx = nxt[0] - cur[0]\n      dy = nxt[1] - cur[1]\n      if dx == 1:\n          return 3  # RIGHT\n      if dx == -1:\n          return 2  # LEFT\n      if dy == 1:\n          return 0  # DOWN\n      if dy == -1:\n          return 1  # UP\n      raise ValueError(\"Invalid move step\")\n\n  def bfs_adjacent(start, targets, grid):\n      \"\"\"Shortest path from start to any empty cell adjacent to a target.\"\"\"\n      W, H, _ = grid.shape\n      visited = np.full((W, H), False, dtype=bool)\n      q = collections.deque()\n      q.append((start, [start]))\n      visited[start] = True\n      target_set = {tuple(t) for t in targets}\n      while q:\n          (x, y), path = q.popleft()\n          # Adjacent to any target?\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n          # Explore neighbours through empty cells only\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if grid[nx, ny, :].sum() == 0:  # empty\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [(nx, ny)]))\n      raise RuntimeError(\"No reachable cell adjacent to target\")\n\n  # ------------------------------------------------------------------\n  # 1) Gather all primitive resources needed for a stick\n  # ------------------------------------------------------------------\n  primitive_reqs = world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n  cur_pos = tuple(state.pos)\n\n  for prim_idx, count in primitive_reqs.items():\n      for _ in range(count):\n          if state.inventory[prim_idx] > 0:\n              continue\n          # Find all cells that currently contain this primitive\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(f\"Primitive {world.cookbook.index.get(prim_idx, prim_idx)} not found\")\n          # Compute path to an adjacent empty cell\n          path = bfs_adjacent(cur_pos, prim_cells, state.grid)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n          # Use (pick up) the primitive\n          actions.append(4)  # USE\n          # Remove the primitive from the simulated grid so we don't target it again\n          cell = prim_cells[0]\n          state.grid[cell[0], cell[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 2) Go to the workshop (if required) and craft the stick\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          raise RuntimeError(f\"Workshop {workshop_name} not found\")\n      path = bfs_adjacent(cur_pos, workshop_cells, state.grid)\n      for step in path[1:]:\n          actions.append(move_action(cur_pos, step))\n          cur_pos = step\n\n  # Final USE to craft the stick\n  actions.append(4)  # USE\n  return actions", "env_interactions": 3, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:18:11.556024", "function_name": "make_stick", "function_body": "  # reset environment and obtain initial state / world references\n  env.reset()\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  # target item index\n  stick_idx = idx[\"stick\"]\n\n  # primitive requirements for one stick (may be empty if stick is primitive)\n  needed = world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n\n  # action mapping (name -> int)\n  act_map = env.action_specs()\n  DOWN = act_map[\"DOWN\"]\n  UP = act_map[\"UP\"]\n  LEFT = act_map[\"LEFT\"]\n  RIGHT = act_map[\"RIGHT\"]\n  USE = act_map[\"USE\"]\n\n  # set of entities that block movement\n  blocked_set = set(world.non_grabbable_indices)\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def walkable(pos):\n      \"\"\"Return True if the cell at pos does not contain any blocked kind.\"\"\"\n      x, y = pos\n      return not any(state.grid[x, y, k] > 0 for k in blocked_set)\n\n  def bfs(start, goals):\n      \"\"\"Bread\u2011first search from start to any cell in goals.\n      Returns list of positions (including start) forming the path, or None.\"\"\"\n      from collections import deque\n      q = deque([start])\n      prev = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur in goals:\n              # reconstruct path\n              path = []\n              while cur is not None:\n                  path.append(cur)\n                  cur = prev[cur]\n              path.reverse()\n              return path\n          for dx, dy in ((-1, 0), (1, 0), (0, -1), (0, 1)):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                  nxt = (nx, ny)\n                  if nxt not in prev and walkable(nxt):\n                      prev[nxt] = cur\n                      q.append(nxt)\n      return None\n\n  def move_action(p, q):\n      \"\"\"Return the integer action that moves from p to q (adjacent cells).\"\"\"\n      dx, dy = q[0] - p[0], q[1] - p[1]\n      if (dx, dy) == (-1, 0):\n          return UP\n      if (dx, dy) == (1, 0):\n          return DOWN\n      if (dx, dy) == (0, -1):\n          return LEFT\n      if (dx, dy) == (0, 1):\n          return RIGHT\n      raise ValueError(f\"Invalid adjacent move from {p} to {q}\")\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # ------------------------------------------------------------------\n  # Collect required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          # locate all cells containing this primitive\n          xs, ys = np.where(state.grid[:, :, prim_idx] > 0)\n          prim_positions = list(zip(xs.tolist(), ys.tolist()))\n          if not prim_positions:\n              raise RuntimeError(f\"Primitive {idx.get(prim_idx)} not found on map.\")\n\n          # pick the closest reachable primitive (Manhattan distance as heuristic)\n          # we will attempt each in order of distance until a path is found\n          prim_positions.sort(key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))\n          path = None\n          target_adj = None\n          for tgt in prim_positions:\n              # compute reachable adjacent cells around the primitive\n              adj = []\n              for dx, dy in ((-1, 0), (1, 0), (0, -1), (0, 1)):\n                  ax, ay = tgt[0] + dx, tgt[1] + dy\n                  if (0 <= ax < state.grid.shape[0] and\n                      0 <= ay < state.grid.shape[1] and\n                      walkable((ax, ay))):\n                      adj.append((ax, ay))\n              if not adj:\n                  continue\n              # BFS to any adjacent cell\n              p = bfs(cur_pos, set(adj))\n              if p is not None:\n                  path = p\n                  target_adj = adj\n                  break\n\n          if path is None:\n              raise RuntimeError(\"Unable to reach required primitive.\")\n\n          # follow the path (skip first position which is current)\n          for i in range(1, len(path)):\n              a = move_action(path[i - 1], path[i])\n              actions.append(a)\n              _, state = env.step(a)\n              env._current_state = state\n          cur_pos = path[-1]\n\n          # after moving adjacent, turn towards the primitive and USE\n          # we assume the last move direction already faces the primitive;\n          # otherwise we simply issue a USE (the environment checks adjacency)\n          actions.append(USE)\n          _, state = env.step(USE)\n          env._current_state = state\n\n  # ------------------------------------------------------------------\n  # Craft the stick (if it is not a primitive)\n  # ------------------------------------------------------------------\n  if needed:\n      # after gathering all ingredients, a final USE triggers crafting\n      actions.append(USE)\n      _, state = env.step(USE)\n      env._current_state = state\n\n  return actions", "env_interactions": 0, "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-10-21T18:18:12.817842", "function_name": "make_stick", "function_body": "  # Reset environment and grab initial state\n  env.reset()\n  state = env._current_state\n\n  # Action mapping (name \u2192 integer)\n  act_map = env.action_specs()\n  DOWN = act_map[\"DOWN\"]\n  UP = act_map[\"UP\"]\n  LEFT = act_map[\"LEFT\"]\n  RIGHT = act_map[\"RIGHT\"]\n  USE = act_map[\"USE\"]\n  # Helper to translate a direction vector into an action\n  def vec_to_action(dx, dy):\n      if (dx, dy) == (0, -1):\n          return UP\n      if (dx, dy) == (0, 1):\n          return DOWN\n      if (dx, dy) == (-1, 0):\n          return LEFT\n      if (dx, dy) == (1, 0):\n          return RIGHT\n      raise ValueError(f\"Invalid direction {(dx, dy)}\")\n\n  # Index of the target item \u201cstick\u201d and its recipe\u2019s primitive requirements\n  stick_idx = env.world.cookbook.index[\"stick\"]\n  needed = env.world.cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n\n  # Set of indices that make a cell non\u2011walkable (any occupied cell is blocked)\n  def walkable(pos):\n      x, y = pos\n      return not state.grid[x, y].any()\n\n  # ------------------------------------------------------------------\n  # Bread\u2011first search to any of a set of goal positions\n  # ------------------------------------------------------------------\n  from collections import deque\n  def bfs(start, goals):\n      \"\"\"Return a list of positions from start to the first reachable goal.\"\"\"\n      q = deque([start])\n      prev = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur in goals:\n              # reconstruct path\n              path = []\n              while cur is not None:\n                  path.append(cur)\n                  cur = prev[cur]\n              path.reverse()\n              return path\n          for dx, dy in ((-1, 0), (1, 0), (0, -1), (0, 1)):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                  nxt = (nx, ny)\n                  if nxt not in prev and walkable(nxt):\n                      prev[nxt] = cur\n                      q.append(nxt)\n      return None\n\n  # ------------------------------------------------------------------\n  # Core routine: collect all required primitives one by one\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  for prim_idx, need_cnt in needed.items():\n      for _ in range(need_cnt):\n          # Locate all cells that contain this primitive\n          xs, ys = np.where(state.grid[:, :, prim_idx] > 0)\n          prim_positions = list(zip(xs.tolist(), ys.tolist()))\n          if not prim_positions:\n              raise RuntimeError(f\"Primitive {prim_idx} not found on the grid.\")\n\n          # Choose the closest occurrence (Manhattan distance)\n          target = min(\n              prim_positions,\n              key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]),\n          )\n\n          # Determine walkable adjacent cells around the target\n          adj_cells = []\n          for dx, dy in ((-1, 0), (1, 0), (0, -1), (0, 1)):\n              ax, ay = target[0] + dx, target[1] + dy\n              if 0 <= ax < state.grid.shape[0] and 0 <= ay < state.grid.shape[1]:\n                  if walkable((ax, ay)):\n                      adj_cells.append((ax, ay))\n\n          # Find a path to any reachable adjacent cell\n          path = bfs(cur_pos, set(adj_cells))\n          if path is None:\n              raise RuntimeError(\"No reachable path to required primitive.\")\n\n          # Follow the path (skip the first element \u2013 current position)\n          for i in range(1, len(path)):\n              a = vec_to_action(path[i][0] - path[i - 1][0],\n                               path[i][1] - path[i - 1][1])\n              actions.append(a)\n              _, state = env.step(a)\n              env._current_state = state\n          cur_pos = path[-1]\n\n          # Ensure we are facing the primitive before using\n          dx, dy = target[0] - cur_pos[0], target[1] - cur_pos[1]\n          needed_dir = vec_to_action(dx, dy)\n\n          # If current direction (the last move) is not the needed one,\n          # perform a back\u2011and\u2011forth move to set the direction.\n          if actions and actions[-1] != needed_dir:\n              # move opposite\n              opposite = {UP: DOWN, DOWN: UP, LEFT: RIGHT, RIGHT: LEFT}[needed_dir]\n              actions.append(opposite)\n              _, state = env.step(opposite)\n              env._current_state = state\n              # move forward again (now facing the primitive)\n              actions.append(needed_dir)\n              _, state = env.step(needed_dir)\n              env._current_state = state\n              cur_pos = (cur_pos[0] + (needed_dir == RIGHT) - (needed_dir == LEFT),\n                         cur_pos[1] + (needed_dir == DOWN) - (needed_dir == UP))\n\n          # Collect the primitive\n          actions.append(USE)\n          _, state = env.step(USE)\n          env._current_state = state\n          cur_pos = tuple(state.pos)   # position does not change after USE\n\n  # ------------------------------------------------------------------\n  # All primitives are now in inventory \u2013 craft the stick.\n  # ------------------------------------------------------------------\n  actions.append(USE)          # crafting is triggered by a USE action\n  # (We do not need to step the environment again; the returned action list\n  # is sufficient for the caller to execute.)\n\n  return actions", "env_interactions": 0, "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-10-21T18:18:50.858820", "function_name": "make_stick", "function_body": "  # Initialize environment and retrieve initial state\n  env.reset()\n  state = env._current_state\n\n  # Action mappings\n  act_map = env.action_specs()               # e.g. {\"UP\":0, \"DOWN\":1, ...}\n  inv_act = {v: k for k, v in act_map.items()}\n\n  # Blocking entity kinds (cannot walk through)\n  blocked_kinds = env.world.non_grabbable_indices\n\n  # Index of the target item \"stick\"\n  stick_idx = env.world.cookbook.index[\"stick\"]\n\n  # Helper functions -------------------------------------------------------\n  def walkable(pos):\n      \"\"\"Return True if the cell at pos has no blocking entity.\"\"\"\n      x, y = pos\n      return not any(state.grid[x, y, k] > 0 for k in blocked_kinds)\n\n  def manhattan(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def find_all(kind):\n      xs, ys = np.where(state.grid[:, :, kind] > 0)\n      return list(zip(xs.tolist(), ys.tolist()))\n\n  def bfs(start, targets):\n      \"\"\"Bread\u2011first search from start to any cell in targets.\n      Returns list of positions from start to goal (inclusive) or None.\"\"\"\n      from collections import deque\n      q = deque([start])\n      prev = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur in targets:\n              path = []\n              while cur is not None:\n                  path.append(cur)\n                  cur = prev[cur]\n              path.reverse()\n              return path\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                  nxt = (nx, ny)\n                  if nxt not in prev and walkable(nxt):\n                      prev[nxt] = cur\n                      q.append(nxt)\n      return None\n\n  def move_to_action(p, q):\n      \"\"\"Convert a step from p -> q into an action index.\"\"\"\n      dx, dy = q[0] - p[0], q[1] - p[1]\n      if (dx, dy) == (-1, 0):\n          return act_map[\"UP\"]\n      if (dx, dy) == (1, 0):\n          return act_map[\"DOWN\"]\n      if (dx, dy) == (0, -1):\n          return act_map[\"LEFT\"]\n      if (dx, dy) == (0, 1):\n          return act_map[\"RIGHT\"]\n      raise ValueError(\"Invalid move\")\n\n  def face_towards(target_pos):\n      \"\"\"Adjust direction to face target_pos from current state.pos.\"\"\"\n      dx, dy = target_pos[0] - state.pos[0], target_pos[1] - state.pos[1]\n      if (dx, dy) == (-1, 0):\n          desired = act_map[\"UP\"]\n      elif (dx, dy) == (1, 0):\n          desired = act_map[\"DOWN\"]\n      elif (dx, dy) == (0, -1):\n          desired = act_map[\"LEFT\"]\n      elif (dx, dy) == (0, 1):\n          desired = act_map[\"RIGHT\"]\n      else:\n          return None\n      # Perform a small back\u2011and\u2011forth to set direction correctly\n      opp_name = {\"UP\": \"DOWN\", \"DOWN\": \"UP\", \"LEFT\": \"RIGHT\", \"RIGHT\": \"LEFT\"}[inv_act[desired]]\n      opp_act = act_map[opp_name]\n      # Check opposite cell is walkable\n      opp_pos = (state.pos[0] - dx, state.pos[1] - dy)\n      if (0 <= opp_pos[0] < state.grid.shape[0] and\n          0 <= opp_pos[1] < state.grid.shape[1] and\n          walkable(opp_pos)):\n          actions.append(opp_act)\n          _, s = env.step(opp_act)\n          state_update(s)\n          actions.append(desired)\n          _, s = env.step(desired)\n          state_update(s)\n      else:\n          # fallback dummy move\n          dummy = act_map[\"LEFT\"]\n          actions.append(dummy)\n          _, s = env.step(dummy)\n          state_update(s)\n          actions.append(desired)\n          _, s = env.step(desired)\n          state_update(s)\n      return desired\n\n  def state_update(new_state):\n      nonlocal state\n      state = new_state\n      env._current_state = new_state\n\n  # ------------------------------------------------------------------------\n  actions = []\n\n  # Determine primitive requirements for a stick\n  primitive_requirements = env.world.cookbook.primitives_for(stick_idx)\n\n  # Collect each required primitive\n  for prim_idx, needed in primitive_requirements.items():\n      while state.inventory[prim_idx] < needed:\n          # Locate all instances of this primitive on the map\n          prim_positions = find_all(prim_idx)\n          if not prim_positions:\n              # No more primitives available; cannot continue\n              break\n          # Choose closest\n          cur_pos = state.pos\n          target = min(prim_positions, key=lambda p: manhattan(cur_pos, p))\n          # Find walkable adjacent cells around target\n          adj_cells = []\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              ax, ay = target[0] + dx, target[1] + dy\n              if 0 <= ax < state.grid.shape[0] and 0 <= ay < state.grid.shape[1]:\n                  if walkable((ax, ay)):\n                      adj_cells.append((ax, ay))\n          # Path to an adjacent cell\n          path = bfs(cur_pos, set(adj_cells))\n          if path is None:\n              break\n          # Follow path\n          for i in range(1, len(path)):\n              a = move_to_action(path[i - 1], path[i])\n              actions.append(a)\n              _, s = env.step(a)\n              state_update(s)\n          # Face the primitive and use\n          face_towards(target)\n          actions.append(act_map[\"USE\"])\n          _, s = env.step(act_map[\"USE\"])\n          state_update(s)\n\n  # After gathering primitives, craft the stick at its workshop\n  # Find workshop name from recipe\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      # Locate any workshop cell\n      workshop_positions = find_all(workshop_idx)\n      if workshop_positions:\n          # Choose closest workshop\n          cur_pos = state.pos\n          target_ws = min(workshop_positions, key=lambda p: manhattan(cur_pos, p))\n          # Adjacent cells around workshop\n          adj_cells = []\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              ax, ay = target_ws[0] + dx, target_ws[1] + dy\n              if 0 <= ax < state.grid.shape[0] and 0 <= ay < state.grid.shape[1]:\n                  if walkable((ax, ay)):\n                      adj_cells.append((ax, ay))\n          path = bfs(cur_pos, set(adj_cells))\n          if path is not None:\n              for i in range(1, len(path)):\n                  a = move_to_action(path[i - 1], path[i])\n                  actions.append(a)\n                  _, s = env.step(a)\n                  state_update(s)\n              # Face the workshop and use to craft\n              face_towards(target_ws)\n              actions.append(act_map[\"USE\"])\n              _, s = env.step(act_map[\"USE\"])\n              state_update(s)\n\n  return actions", "env_interactions": 0, "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-10-21T18:18:51.960934", "function_name": "make_stick", "function_body": "  # reset env, get state\n  env.reset()\n  state = env._current_state\n\n  act_map = env.action_specs()\n  inv_act = {v:k for k,v in act_map.items()}\n\n  # indices\n  stick_idx = env.world.cookbook.index[\"stick\"]\n  blocked = env.world.non_grabbable_indices", "env_interactions": 0, "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-10-21T18:19:21.098333", "function_name": "make_stick", "function_body": "  import numpy as np\n\n  # reset environment and fetch useful objects\n  env.reset()\n  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  # try to obtain the internal index of the target item \u201cstick\u201d\n  try:\n      goal_idx = cookbook.index[\"stick\"]\n  except Exception:\n      return []\n\n  # primitive ingredients required to craft a stick (empty dict means stick is primitive)\n  prim_needed = cookbook.primitives_for(goal_idx)\n\n  # map action names to integer codes used by the environment\n  act_map = env.action_specs()\n  DOWN = act_map.get(\"DOWN\", 0)\n  UP = act_map.get(\"UP\", 1)\n  LEFT = act_map.get(\"LEFT\", 2)\n  RIGHT = act_map.get(\"RIGHT\", 3)\n  USE = act_map.get(\"USE\", 4)\n\n  # simple Manhattan\u2011distance path planner (ignores obstacles)\n  def _moves(start, target):\n      cx, cy = start\n      tx, ty = target\n      moves = []\n      while cx < tx:\n          moves.append(DOWN)\n          cx += 1\n      while cx > tx:\n          moves.append(UP)\n          cx -= 1\n      while cy < ty:\n          moves.append(RIGHT)\n          cy += 1\n      while cy > ty:\n          moves.append(LEFT)\n          cy -= 1\n      return moves\n\n  plan = []\n  cur_pos = state.pos\n  grid = state.grid\n\n  if prim_needed:\n      # --------------------------------------------------------------\n      # 1) Gather all required primitive resources\n      # --------------------------------------------------------------\n      for p_idx, needed_cnt in prim_needed.items():\n          # locate all cells that currently contain this primitive\n          locations = [tuple(pos) for pos in np.argwhere(grid[:, :, p_idx] > 0)]\n          collected = 0\n          while collected < needed_cnt and locations:\n              # choose the nearest primitive (Manhattan distance)\n              dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in locations]\n              nearest = int(np.argmin(dists))\n              target = locations.pop(nearest)\n\n              # move to the primitive and pick it up\n              plan.extend(_moves(cur_pos, target))\n              plan.append(USE)\n\n              # update current position and count\n              cur_pos = target\n              collected += 1\n\n      # --------------------------------------------------------------\n      # 2) Go to the appropriate workshop and craft the stick\n      # --------------------------------------------------------------\n      workshop_pos = None\n      recipe = cookbook.recipes.get(goal_idx, {})\n      wk_name = recipe.get(\"_at\")\n      if wk_name is not None:\n          try:\n              wk_idx = cookbook.index[wk_name]\n              cells = np.argwhere(grid[:, :, wk_idx] > 0)\n              if cells.size:\n                  workshop_pos = tuple(cells[0])\n          except Exception:\n              workshop_pos = None\n\n      # fallback: any workshop present in the world\n      if workshop_pos is None:\n          for wk_idx in world.workshop_indices:\n              cells = np.argwhere(grid[:, :, wk_idx] > 0)\n              if cells.size:\n                  workshop_pos = tuple(cells[0])\n                  break\n\n      if workshop_pos is not None:\n          plan.extend(_moves(cur_pos, workshop_pos))\n          cur_pos = workshop_pos\n\n      # use the workshop to craft the stick\n      plan.append(USE)\n\n  else:\n      # --------------------------------------------------------------\n      # Stick itself is a primitive \u2013 just go pick it up\n      # --------------------------------------------------------------\n      locations = [tuple(pos) for pos in np.argwhere(grid[:, :, goal_idx] > 0)]\n      if locations:\n          dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in locations]\n          nearest = int(np.argmin(dists))\n          target = locations[nearest]\n          plan.extend(_moves(cur_pos, target))\n          plan.append(USE)\n\n  return plan", "env_interactions": 4, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:19:22.214366", "function_name": "make_stick", "function_body": "  # Reset environment and fetch useful references\n  env.reset()\n  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  # Index of the goal item (\"stick\")\n  try:\n      goal_idx = cookbook.index[\"stick\"]\n  except Exception:\n      return []\n\n  # Primitive requirements for a single stick (empty if stick is primitive)\n  prim_needed = cookbook.primitives_for(goal_idx)\n\n  # Action mapping\n  act_map = env.action_specs()\n  DOWN = act_map.get(\"DOWN\", 0)\n  UP = act_map.get(\"UP\", 1)\n  LEFT = act_map.get(\"LEFT\", 2)\n  RIGHT = act_map.get(\"RIGHT\", 3)\n  USE = act_map.get(\"USE\", 4)\n\n  # Helper: shortest Manhattan moves from src to dst\n  def _moves(src, dst):\n      x, y = src\n      tx, ty = dst\n      moves = []\n      while x < tx:\n          moves.append(DOWN)\n          x += 1\n      while x > tx:\n          moves.append(UP)\n          x -= 1\n      while y < ty:\n          moves.append(RIGHT)\n          y += 1\n      while y > ty:\n          moves.append(LEFT)\n          y -= 1\n      return moves\n\n  # Helper: find index of nearest location (Manhattan distance)\n  def _nearest(locations, cur):\n      dists = [abs(cur[0] - p[0]) + abs(cur[1] - p[1]) for p in locations]\n      return int(np.argmin(dists))\n\n  plan = []\n  cur_pos = state.pos\n  grid = state.grid\n\n  # ----------------------------------------------------------------------\n  # 1) Collect all required primitive resources\n  # ----------------------------------------------------------------------\n  if prim_needed:\n      for p_idx, count in prim_needed.items():\n          for _ in range(count):\n              # Find all cells currently containing this primitive\n              locations = [tuple(pos) for pos in np.argwhere(grid[:, :, p_idx] > 0)]\n              if not locations:\n                  # No more of this primitive on the map \u2013 abort planning\n                  return plan\n              nearest_i = _nearest(locations, cur_pos)\n              target = locations.pop(nearest_i)\n\n              # Move to the primitive and pick it up\n              plan.extend(_moves(cur_pos, target))\n              plan.append(USE)\n              cur_pos = target\n\n      # ------------------------------------------------------------------\n      # 2) Go to the appropriate workshop and craft the stick\n      # ------------------------------------------------------------------\n      recipe = cookbook.recipes.get(goal_idx, {})\n      wk_name = recipe.get(\"_at\")\n      workshop_pos = None\n\n      # Prefer the workshop explicitly required by the recipe\n      if wk_name is not None:\n          wk_idx = cookbook.index.get(wk_name)\n          if wk_idx is not None:\n              cells = np.argwhere(grid[:, :, wk_idx] > 0)\n              if cells.size:\n                  workshop_pos = tuple(cells[0])\n\n      # Fallback: any workshop present in the world\n      if workshop_pos is None:\n          for wk_idx in world.workshop_indices:\n              cells = np.argwhere(grid[:, :, wk_idx] > 0)\n              if cells.size:\n                  workshop_pos = tuple(cells[0])\n                  break\n\n      if workshop_pos is not None:\n          plan.extend(_moves(cur_pos, workshop_pos))\n          cur_pos = workshop_pos\n\n      # Use action to craft at the workshop (or current cell if none)\n      plan.append(USE)\n\n  else:\n      # ------------------------------------------------------------------\n      # Stick is itself a primitive \u2013 just pick it up\n      # ------------------------------------------------------------------\n      locations = [tuple(pos) for pos in np.argwhere(grid[:, :, goal_idx] > 0)]\n      if locations:\n          nearest_i = _nearest(locations, cur_pos)\n          target = locations[nearest_i]\n          plan.extend(_moves(cur_pos, target))\n          plan.append(USE)\n\n  return plan", "env_interactions": 0, "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-10-21T18:19:53.042041", "function_name": "make_stick", "function_body": "  # Reset the environment to obtain a fresh state.\n  env.reset()\n  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  # Index of the target item (\"stick\").\n  stick_idx = cookbook.index[\"stick\"]\n\n  # Primitive requirements for one stick (dict {prim_idx: count}).\n  prim_req = cookbook.primitives_for(stick_idx)\n\n  actions = []\n  cur_pos = list(state.pos)  # [x, y]\n\n  # Helper to move from the current position to a target cell using Manhattan moves.\n  def move_to(target):\n      nonlocal cur_pos, actions\n      tx, ty = target\n      while cur_pos[0] < tx:\n          actions.append(3)   # RIGHT\n          cur_pos[0] += 1\n      while cur_pos[0] > tx:\n          actions.append(2)   # LEFT\n          cur_pos[0] -= 1\n      while cur_pos[1] < ty:\n          actions.append(0)   # DOWN\n          cur_pos[1] += 1\n      while cur_pos[1] > ty:\n          actions.append(1)   # UP\n          cur_pos[1] -= 1\n\n  # Collect each required primitive.\n  for prim_idx, needed in prim_req.items():\n      # Locate all cells containing this primitive.\n      locations = np.argwhere(state.grid[:, :, prim_idx] > 0)\n      if len(locations) == 0:\n          # Primitive not present in the scenario \u2013 cannot solve.\n          return []\n      # Sort locations by Manhattan distance from the current position.\n      locations = sorted(locations,\n                         key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))\n      loc_iter = iter(locations)\n      for _ in range(needed):\n          try:\n              target = next(loc_iter)\n          except StopIteration:\n              # Reuse the first location if we run out of distinct cells.\n              target = locations[0]\n          move_to(target.tolist())\n          actions.append(4)   # USE to pick up the primitive.\n\n  # Finally, attempt to craft the stick.  In many setups the workshop is\n  # either at the current location or adjacent; a single USE is sufficient.\n  actions.append(4)   # USE to craft the stick.\n\n  return actions", "env_interactions": 3, "island_id": 3, "scores": {"3": 0.0}}
