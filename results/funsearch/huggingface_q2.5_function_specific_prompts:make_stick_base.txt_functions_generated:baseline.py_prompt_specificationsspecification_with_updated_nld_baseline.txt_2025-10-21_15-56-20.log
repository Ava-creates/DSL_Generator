{"timestamp": "2025-10-21T21:05:26.841833", "function_name": "make_stick", "function_body": "  # Reset the environment to start a fresh episode.\n  env.reset()\n\n  # Handy shortcuts to the world configuration and the scenario layout.\n  world = env.world\n  scenario = env.scenario\n\n  # Copy of the initial grid (one\u2011hot per kind) that we will update as we\n  # virtually pick up items, so we never try to collect the same cell twice.\n  grid = scenario.init_grid.copy()\n\n  # Index of the item we are asked to produce (e.g. the \u201cstick\u201d kind).\n  goal_idx = env.task.goal\n\n  # Primitive resources required for the goal (kind \u2192 count).\n  primitive_needs = world.cookbook.primitives_for(goal_idx)\n\n  # Current agent position \u2013 mutable list so we can update it while planning.\n  pos = list(scenario.init_pos)\n\n  # The list that will contain the planned actions (indices).\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # Helper: move from the current position to an absolute target cell.\n  # Uses Manhattan moves (LEFT/RIGHT then UP/DOWN) \u2013 sufficient for open\n  # layouts; the environment guarantees reachability for the primitive cells.\n  # ----------------------------------------------------------------------\n  def _move_to(target):\n      nonlocal pos, actions\n      # Horizontal movement.\n      while pos[0] < target[0]:\n          actions.append(3)          # RIGHT\n          pos[0] += 1\n      while pos[0] > target[0]:\n          actions.append(2)          # LEFT\n          pos[0] -= 1\n      # Vertical movement.\n      while pos[1] < target[1]:\n          actions.append(0)          # DOWN\n          pos[1] += 1\n      while pos[1] > target[1]:\n          actions.append(1)          # UP\n          pos[1] -= 1\n\n  # ----------------------------------------------------------------------\n  # 1) Collect each required primitive in turn, always heading for the\n  #    nearest remaining instance to minimise travel distance.\n  # ----------------------------------------------------------------------\n  for kind_idx, needed_cnt in primitive_needs.items():\n      # Locate all cells that currently contain this primitive.\n      locations = np.argwhere(grid[:, :, kind_idx] == 1)\n\n      for _ in range(needed_cnt):\n          if locations.shape[0] == 0:\n              # No more instances left \u2013 break early (should not happen in\n              # a well\u2011formed scenario).\n              break\n\n          # Choose the nearest instance (Manhattan distance).\n          dists = np.sum(np.abs(locations - pos), axis=1)\n          nearest_idx = int(np.argmin(dists))\n          target_cell = locations[nearest_idx].tolist()\n\n          # Move there and pick the item up.\n          _move_to(target_cell)\n          actions.append(4)          # USE to pick up\n\n          # Update our internal copy of the grid so we don't revisit.\n          grid[target_cell[0], target_cell[1], kind_idx] = 0\n          locations = np.delete(locations, nearest_idx, axis=0)\n\n  # ----------------------------------------------------------------------\n  # 2) If the recipe specifies a workshop, travel to the nearest such\n  #    workshop and issue a USE action to craft the goal item.\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get('_at')\n  if workshop_kind is not None:\n      workshop_cells = np.argwhere(grid[:, :, workshop_kind] == 1)\n      if workshop_cells.shape[0] > 0:\n          dists = np.sum(np.abs(workshop_cells - pos), axis=1)\n          nearest_ws = int(np.argmin(dists))\n          ws_target = workshop_cells[nearest_ws].tolist()\n          _move_to(ws_target)\n          actions.append(4)          # USE to craft\n\n  # Return the complete sequence of planned actions.\n  return actions", "env_interactions": 0, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:05:27.972393", "function_name": "make_stick", "function_body": "  # Reset environment to start fresh\n  env.reset()\n\n  # Convenient references\n  world = env.world\n  scenario = env.scenario\n  grid = scenario.init_grid.copy()          # mutable copy of the layout\n  goal_idx = env.task.goal                   # index of the desired item\n  primitives_needed = world.cookbook.primitives_for(goal_idx)\n\n  # Agent state\n  pos = list(scenario.init_pos)              # [x, y]\n  actions = []                               # planned action sequence\n\n  # ------------------------------------------------------------------\n  # Helper: shortest path (BFS) avoiding any occupied cell except the\n  # target cell itself (which may contain the primitive / workshop).\n  # Returns a list of action indices to move from `src` to `tgt`.\n  # ------------------------------------------------------------------\n  def _shortest_path(src, tgt):\n      src_t = tuple(src)\n      tgt_t = tuple(tgt)\n      if src_t == tgt_t:\n          return []\n\n      visited = {src_t}\n      q = collections.deque()\n      q.append((src_t, []))\n\n      # (dx, dy, action_index) respecting the convention used elsewhere\n      moves = [(1, 0, 3),   # RIGHT\n               (-1, 0, 2),  # LEFT\n               (0, 1, 0),   # DOWN\n               (0, -1, 1)]  # UP\n\n      while q:\n          (x, y), path = q.popleft()\n          for dx, dy, act in moves:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]):\n                  continue\n              npos = (nx, ny)\n              if npos in visited:\n                  continue\n\n              # Allow stepping onto the goal cell even if occupied;\n              # otherwise the cell must be completely empty.\n              if npos != tgt_t and grid[nx, ny, :].any():\n                  continue\n\n              if npos == tgt_t:\n                  return path + [act]\n\n              visited.add(npos)\n              q.append((npos, path + [act]))\n\n      # If BFS fails (should not happen in well\u2011formed scenarios), fall back\n      # to a simple Manhattan walk (may hit obstacles).\n      fallback = []\n      cx, cy = src_t\n      tx, ty = tgt_t\n      while cx < tx:\n          fallback.append(3); cx += 1\n      while cx > tx:\n          fallback.append(2); cx -= 1\n      while cy < ty:\n          fallback.append(0); cy += 1\n      while cy > ty:\n          fallback.append(1); cy -= 1\n      return fallback\n\n  # ------------------------------------------------------------------\n  # Helper: move agent to a target cell using the shortest path.\n  # ------------------------------------------------------------------\n  def _move_to(target):\n      nonlocal pos, actions\n      steps = _shortest_path(pos, target)\n      actions.extend(steps)\n      pos[0], pos[1] = target[0], target[1]\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitive resources.\n  # ------------------------------------------------------------------\n  for kind_idx, cnt in primitives_needed.items():\n      # Find all cells that currently host this primitive.\n      locations = np.argwhere(grid[:, :, kind_idx] == 1)\n\n      for _ in range(cnt):\n          if locations.shape[0] == 0:\n              break  # no more instances left\n\n          # Choose the nearest instance (Manhattan distance is fine for ranking)\n          dists = np.sum(np.abs(locations - pos), axis=1)\n          nearest = int(np.argmin(dists))\n          target_cell = locations[nearest].tolist()\n\n          # Travel to the primitive and pick it up.\n          _move_to(target_cell)\n          actions.append(4)                     # USE to pick up\n\n          # Update internal grid copy so we don't revisit the same cell.\n          grid[target_cell[0], target_cell[1], kind_idx] = 0\n          locations = np.delete(locations, nearest, axis=0)\n\n  # ------------------------------------------------------------------\n  # 2) If the recipe specifies a workshop, travel there and craft.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get('_at')\n  if workshop_kind is not None:\n      workshop_cells = np.argwhere(grid[:, :, workshop_kind] == 1)\n      if workshop_cells.shape[0] > 0:\n          dists = np.sum(np.abs(workshop_cells - pos), axis=1)\n          nearest_ws = int(np.argmin(dists))\n          ws_target = workshop_cells[nearest_ws].tolist()\n          _move_to(ws_target)\n          actions.append(4)                     # USE to craft the item\n\n  # Return the complete plan.\n  return actions", "env_interactions": 0, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:05:40.496578", "function_name": "make_stick", "function_body": "  # Helper to obtain action ids from the environment\n  def _action_ids():\n      try:\n          return list(env.action_specs().values())\n      except Exception:\n          # fallback ordering: DOWN, UP, LEFT, RIGHT, USE\n          return [0, 1, 2, 3, 4]\n\n  # Helper to obtain the integer index of the target item \"stick\"\n  def _goal_index():\n      try:\n          return env.world.cookbook.index[\"stick\"]\n      except Exception:\n          return env.world.cookbook.index.get(\"stick\")\n\n  # Helper to create a hashable key for a state (position, direction, inventory)\n  def _state_key(st):\n      return (st.pos, st.dir, st.inventory.tobytes())\n\n  # ------------------------------------------------------------------\n  # Initialise start state\n  goal_idx = _goal_index()\n  if goal_idx is None:\n      return []  # cannot find stick in cookbook\n\n  start_state = getattr(env, \"_current_state\", None)\n  if start_state is None:\n      # scenario may be stored under env.scenario\n      try:\n          start_state = env.scenario.init()\n      except Exception:\n          return []  # unable to obtain a starting state\n\n  # Quick check: already have the goal\n  if start_state.satisfies(\"\", goal_idx):\n      return []\n\n  actions = _action_ids()\n  # Prioritise USE action (commonly index 4) to encourage crafting/interacting early\n  if 4 in actions:\n      actions.remove(4)\n      actions = [4] + actions\n\n  # Breadth\u2011first search over state\u2011action sequences\n  from collections import deque\n  frontier = deque()\n  frontier.append((start_state, []))\n  visited = {_state_key(start_state)}\n  MAX_PLAN_LEN = 300  # safety cap\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      if cur_state.satisfies(\"\", goal_idx):\n          return cur_plan\n\n      if len(cur_plan) >= MAX_PLAN_LEN:\n          continue\n\n      for a in actions:\n          _, nxt_state = cur_state.step(a)\n          key = _state_key(nxt_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((nxt_state, cur_plan + [a]))\n\n  # No feasible plan found within limits\n  return []", "env_interactions": 4, "island_id": 2, "scores": {"3": 1.5}}
