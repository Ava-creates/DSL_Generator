{"timestamp": "2025-10-21T19:43:47.269742", "function_name": "make_stick", "function_body": "  env.reset()\n  world = env.world\n  idx = world.cookbook.index\n\n  # action indices\n  spec = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      spec[\"DOWN\"], spec[\"UP\"], spec[\"LEFT\"], spec[\"RIGHT\"], spec[\"USE\"]\n  )\n\n  # goal item index (stick)\n  try:\n      goal_idx = idx[\"stick\"]\n  except Exception:  # pragma: no cover\n      goal_idx = next(i for i, n in enumerate(idx.ordered_contents) if n.lower() == \"stick\")\n\n  # required primitives (or the stick itself if primitive)\n  prims = world.cookbook.primitives_for(goal_idx)\n  required = prims if prims else {goal_idx: 1}\n\n  # current simulated state\n  state = env._current_state\n  cur_pos = tuple(state.pos)\n  grid = state.grid.copy()\n\n  # cells blocked by non\u2011grabbable entities\n  non_grabbable = list(world.non_grabbable_indices)\n  if non_grabbable:\n      blocked = np.any(grid[:, :, non_grabbable] > 0, axis=2)\n  else:\n      blocked = np.zeros(grid.shape[:2], dtype=bool)\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # BFS path finder avoiding blocked cells\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  def bfs_path(start, targets, blocked_mask):\n      \"\"\"Return a list of actions to reach any cell in *targets* from *start*.\"\"\"\n      if start in targets:\n          return []\n      q = deque([start])\n      visited = {start: (None, None)}  # pos -> (parent, action)\n      while q:\n          cur = q.popleft()\n          for act, (dx, dy) in (\n              (DOWN, (0, 1)),\n              (UP, (0, -1)),\n              (LEFT, (-1, 0)),\n              (RIGHT, (1, 0)),\n          ):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if not (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]):\n                  continue\n              if blocked_mask[nx, ny]:\n                  continue\n              nxt = (nx, ny)\n              if nxt in visited:\n                  continue\n              visited[nxt] = (cur, act)\n              if nxt in targets:\n                  # reconstruct path\n                  path = []\n                  node = nxt\n                  while visited[node][0] is not None:\n                      parent, a = visited[node]\n                      path.append(a)\n                      node = parent\n                  return list(reversed(path))\n              q.append(nxt)\n\n      # fallback: straight Manhattan moves (ignores obstacles)\n      target = next(iter(targets))\n      x, y = start\n      tx, ty = target\n      path = []\n      while x < tx:\n          path.append(RIGHT); x += 1\n      while x > tx:\n          path.append(LEFT); x -= 1\n      while y < ty:\n          path.append(DOWN); y += 1\n      while y > ty:\n          path.append(UP); y -= 1\n      return path\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required items\n  # ------------------------------------------------------------------\n  for item_idx, count in required.items():\n      remaining = int(count)\n      while remaining > 0:\n          locs = np.argwhere(grid[:, :, item_idx] > 0)\n          if locs.size == 0:\n              break  # nothing left on map\n          dists = np.abs(locs[:, 0] - cur_pos[0]) + np.abs(locs[:, 1] - cur_pos[1])\n          target = tuple(locs[dists.argmin()])\n          actions.extend(bfs_path(cur_pos, {target}, blocked))\n          cur_pos = target\n          actions.append(USE)\n          remaining -= 1\n          # update simulated grid / blocked mask\n          grid[target[0], target[1], item_idx] -= 1\n          if non_grabbable:\n              blocked[target[0], target[1]] = np.any(\n                  grid[target[0], target[1], non_grabbable] > 0\n              )\n\n  # ------------------------------------------------------------------\n  # 2. Move to workshop (if any) and craft the stick\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = idx[workshop_name]\n      ws_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_locs.size:\n          ws_target = tuple(ws_locs[0])\n          actions.extend(bfs_path(cur_pos, {ws_target}, blocked))\n          cur_pos = ws_target\n          actions.append(USE)  # craft at workshop\n\n  return actions", "env_interactions": 4, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T19:44:19.245624", "function_name": "make_stick", "function_body": "  # Reset environment and get initial state\n  env.reset()\n  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  # Identify goal index (stick) from the current task\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      # fallback to name lookup\n      try:\n          goal_idx = cookbook.index[\"stick\"]\n      except Exception:\n          return []\n\n  # Determine primitive requirements for the goal\n  prim_req = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n  if not prim_req:\n      return []\n\n  # Action mapping\n  act_map = env.action_specs()\n  ACTIONS = {\n      \"RIGHT\": act_map[\"RIGHT\"],\n      \"LEFT\":  act_map[\"LEFT\"],\n      \"DOWN\":  act_map[\"DOWN\"],\n      \"UP\":    act_map[\"UP\"],\n      \"USE\":   act_map[\"USE\"],\n  }\n\n  # ------------------------------------------------------------------\n  # Helper: BFS pathfinder that avoids blocked cells.\n  # Returns a list of action ints leading from start to goal.\n  # ------------------------------------------------------------------\n  def bfs_path(start, goal, grid):\n      W, H, _ = grid.shape\n      # Cells with any entity are blocked, except the goal cell itself\n      blocked = grid.sum(axis=2) > 0\n      blocked[goal[0], goal[1]] = False\n\n      queue = collections.deque()\n      queue.append((start, []))\n      visited = {start}\n      while queue:\n          (x, y), path = queue.popleft()\n          if (x, y) == goal:\n              return path\n          # Explore neighbours in deterministic order\n          for name, (dx, dy) in [\n              (\"RIGHT\", (1, 0)),\n              (\"LEFT\",  (-1, 0)),\n              (\"DOWN\",  (0, 1)),\n              (\"UP\",    (0, -1)),\n          ]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not blocked[nx, ny]:\n                  nxt = (nx, ny)\n                  if nxt not in visited:\n                      visited.add(nxt)\n                      queue.append((nxt, path + [ACTIONS[name]]))\n      # If no path found (unlikely), fall back to empty list\n      return []\n\n  # ------------------------------------------------------------------\n  # Collect required primitives\n  # ------------------------------------------------------------------\n  actions = []\n  for prim_idx, needed in prim_req.items():\n      while state.inventory[prim_idx] < needed:\n          # Locate remaining instances of this primitive\n          locations = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if locations.size == 0:\n              # Primitive not present \u2013 cannot complete task\n              return actions\n          # Choose the nearest location (Manhattan distance)\n          cur_pos = state.pos\n          dists = np.abs(locations - np.array(cur_pos)).sum(axis=1)\n          target = tuple(locations[dists.argmin()])\n\n          # Plan movement to the target cell\n          move_actions = bfs_path(cur_pos, target, state.grid)\n          actions.extend(move_actions)\n          for a in move_actions:\n              _, _, _ = env.step(a)\n              state = env._current_state\n\n          # Pick up the primitive\n          actions.append(ACTIONS[\"USE\"])\n          _, _, _ = env.step(ACTIONS[\"USE\"])\n          state = env._current_state\n\n  # ------------------------------------------------------------------\n  # Move to appropriate workshop and craft the goal item\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  for key, val in recipe.items():\n      if isinstance(key, str) and key.startswith(\"_\"):\n          # key like \"_at\"\n          if isinstance(val, str):\n              workshop_idx = cookbook.index[val]\n          else:\n              workshop_idx = int(val)\n          break\n\n  if workshop_idx is not None:\n      # Locate a workshop cell\n      wk_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if wk_cells.size == 0:\n          # No workshop found; cannot craft\n          return actions\n      cur_pos = state.pos\n      dists = np.abs(wk_cells - np.array(cur_pos)).sum(axis=1)\n      wk_target = tuple(wk_cells[dists.argmin()])\n\n      # Move to workshop\n      move_actions = bfs_path(cur_pos, wk_target, state.grid)\n      actions.extend(move_actions)\n      for a in move_actions:\n          _, _, _ = env.step(a)\n          state = env._current_state\n\n      # Craft (USE at workshop)\n      actions.append(ACTIONS[\"USE\"])\n      env.step(ACTIONS[\"USE\"])\n      # state update not required after final action\n\n  return actions", "env_interactions": 0, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T19:44:20.367898", "function_name": "make_stick", "function_body": "  # Reset environment and obtain initial state/action map\n  env.reset()\n  state = env._current_state\n  act_map = env.action_specs()\n\n  # Goal index for the current task\n  goal_idx = env.task.goal\n\n  # Mapping from primitive indices to required counts for the goal\n  prim_req = env.world.cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n\n  actions = []\n\n  # Helper to move the agent stepwise to a target cell (tx, ty)\n  def move_to(target):\n      nonlocal state\n      tx, ty = target\n      while (state.pos[0], state.pos[1]) != (tx, ty):\n          cx, cy = state.pos\n          if cx < tx:\n              act = act_map[\"DOWN\"]\n          elif cx > tx:\n              act = act_map[\"UP\"]\n          elif cy < ty:\n              act = act_map[\"RIGHT\"]\n          else:  # cy > ty\n              act = act_map[\"LEFT\"]\n          actions.append(act)\n          _, _, _ = env.step(act)\n          state = env._current_state\n\n  # ------------------------------------------------------------------\n  # Collect all required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, needed in prim_req.items():\n      while state.inventory[prim_idx] < needed:\n          # Locate all cells containing the primitive\n          cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if cells.size == 0:\n              # No more of this primitive on the map; abort\n              raise RuntimeError(\"Required primitive not found on the grid.\")\n          # Choose the closest primitive cell (Manhattan distance)\n          cur = np.array(state.pos)\n          dists = np.abs(cells - cur).sum(axis=1)\n          target = tuple(cells[dists.argmin()])\n          # Move to the primitive and pick it up\n          move_to(target)\n          actions.append(act_map[\"USE\"])\n          _, _, _ = env.step(act_map[\"USE\"])\n          state = env._current_state\n\n  # ------------------------------------------------------------------\n  # Locate the appropriate workshop and craft the item\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  for key, val in recipe.items():\n      if isinstance(key, str) and key.startswith(\"_\"):\n          # Key like \"_at\" indicates the required workshop\n          if isinstance(val, str):\n              workshop_idx = env.world.cookbook.index[val]\n          else:\n              workshop_idx = int(val)\n          break\n\n  if workshop_idx is not None:\n      # Find a workshop cell on the grid\n      cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if cells.size == 0:\n          raise RuntimeError(\"Workshop for crafting not found on the grid.\")\n      cur = np.array(state.pos)\n      dists = np.abs(cells - cur).sum(axis=1)\n      target = tuple(cells[dists.argmin()])\n      move_to(target)\n      # Use the workshop to craft the goal item\n      actions.append(act_map[\"USE\"])\n      env.step(act_map[\"USE\"])\n      state = env._current_state\n\n  return actions", "env_interactions": 0, "island_id": 5, "scores": {"3": 0.0}}
