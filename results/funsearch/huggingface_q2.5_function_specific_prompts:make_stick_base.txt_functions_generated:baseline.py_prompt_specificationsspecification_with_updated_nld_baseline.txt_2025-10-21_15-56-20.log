{"timestamp": "2025-10-21T19:30:12.482592", "function_name": "make_stick", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Reset the environment and obtain the underlying CraftState.\n  env.reset()\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      scenario = getattr(env, \"scenario\", None)\n      if scenario is not None:\n          state = scenario.init()\n  if state is None:\n      return []\n\n  world = state.world\n  grid = state.grid.copy()\n  h, w, _ = grid.shape\n  cur_pos = state.pos\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper utilities.\n  # ------------------------------------------------------------------\n  DIRS = [\n      (1, 0, 0),   # DOWN\n      (-1, 0, 1),  # UP\n      (0, -1, 2),  # LEFT\n      (0, 1, 3),   # RIGHT\n  ]\n\n  def is_blocked(x: int, y: int) -> bool:\n      for idx in world.non_grabbable_indices:\n          if grid[x, y, idx] > 0:\n              return True\n      return False\n\n  def bfs(start: tuple[int, int], goal: tuple[int, int]) -> list[int]:\n      if start == goal:\n          return []\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (cx, cy), path = q.popleft()\n          for dx, dy, act in DIRS:\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < h and 0 <= ny < w and not is_blocked(nx, ny):\n                  if (nx, ny) not in visited:\n                      if (nx, ny) == goal:\n                          return path + [act]\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [act]))\n      return []  # no path found\n\n  def find_cells(kind_idx: int) -> list[tuple[int, int]]:\n      pts = np.argwhere(grid[:, :, kind_idx] > 0)\n      return [tuple(p) for p in pts]\n\n  # ------------------------------------------------------------------\n  # Identify the stick item and its recipe.\n  # ------------------------------------------------------------------\n  stick_idx = world.cookbook.index.get(\"stick\")\n  if stick_idx is None:\n      return []\n\n  primitive_req = world.cookbook.primitives_for(stick_idx)\n\n  # ------------------------------------------------------------------\n  # If stick is a primitive, just pick up one instance.\n  # ------------------------------------------------------------------\n  if not primitive_req:\n      cells = find_cells(stick_idx)\n      if not cells:\n          return []\n      dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in cells]\n      target = cells[int(np.argmin(dists))]\n      actions.extend(bfs(cur_pos, target))\n      actions.append(4)  # USE to pick up\n      return actions\n\n  # ------------------------------------------------------------------\n  # Collect all required primitive items.\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitive_req.items():\n      for _ in range(needed):\n          cells = find_cells(prim_idx)\n          if not cells:\n              return []  # missing primitive\n          dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in cells]\n          target = cells[int(np.argmin(dists))]\n          move_seq = bfs(cur_pos, target)\n          if not move_seq and cur_pos != target:\n              return []  # unreachable\n          actions.extend(move_seq)\n          actions.append(4)  # USE to pick up primitive\n          cur_pos = target\n          grid[target[0], target[1], prim_idx] = 0  # remove from local copy\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if required) and craft the stick.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_idx = recipe.get(\"_at\")\n  if workshop_idx is not None:\n      ws_cells = find_cells(workshop_idx)\n      if not ws_cells:\n          return actions\n      dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in ws_cells]\n      ws_target = ws_cells[int(np.argmin(dists))]\n      actions.extend(bfs(cur_pos, ws_target))\n      actions.append(4)  # USE to craft at workshop\n  else:\n      actions.append(4)  # USE to craft at current location\n\n  return actions", "env_interactions": 0, "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-10-21T19:30:13.607218", "function_name": "make_stick", "function_body": "  try:\n      env.reset()\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          scenario = getattr(env, \"scenario\", None)\n          if scenario is not None:\n              state = scenario.init()\n      if state is None:\n          return []\n\n      world = state.world\n      grid = state.grid.copy()\n      h, w, _ = grid.shape\n      cur_pos = state.pos\n      actions: list[int] = []\n\n      # ---------- helpers ----------\n      def find_cells(kind_idx: int) -> list[tuple[int, int]]:\n          pts = np.argwhere(grid[:, :, kind_idx] > 0)\n          return [tuple(p) for p in pts]\n\n      def is_blocked(x: int, y: int) -> bool:\n          for idx in world.non_grabbable_indices:\n              if grid[x, y, idx] > 0:\n                  return True\n          return False\n\n      dirs = [(1, 0, 0), (-1, 0, 1), (0, -1, 2), (0, 1, 3)]\n\n      from collections import deque\n\n      def bfs(start: tuple[int, int], goal: tuple[int, int]) -> list[int]:\n          if start == goal:\n              return []\n          q = deque()\n          q.append((start, []))\n          visited = {start}\n          while q:\n              (cx, cy), path = q.popleft()\n              for dx, dy, act in dirs:\n                  nx, ny = cx + dx, cy + dy\n                  if 0 <= nx < h and 0 <= ny < w and not is_blocked(nx, ny):\n                      if (nx, ny) not in visited:\n                          if (nx, ny) == goal:\n                              return path + [act]\n                          visited.add((nx, ny))\n                          q.append(((nx, ny), path + [act]))\n          return []  # unreachable\n\n      # ---------- stick recipe ----------\n      stick_idx = world.cookbook.index.get(\"stick\")\n      if stick_idx is None:\n          return []\n\n      primitive_req = world.cookbook.primitives_for(stick_idx)\n\n      # If stick is itself a primitive, just pick one up.\n      if not primitive_req:\n          cells = find_cells(stick_idx)\n          if not cells:\n              return []\n          dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in cells]\n          target = cells[int(np.argmin(dists))]\n          actions.extend(bfs(cur_pos, target))\n          actions.append(4)  # USE to pick up\n          return actions\n\n      # ---------- collect primitives ----------\n      for prim_idx, needed in primitive_req.items():\n          for _ in range(needed):\n              cells = find_cells(prim_idx)\n              if not cells:\n                  return []  # missing primitive\n              dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in cells]\n              target = cells[int(np.argmin(dists))]\n              actions.extend(bfs(cur_pos, target))\n              actions.append(4)  # USE to pick up\n              cur_pos = target\n              grid[target[0], target[1], prim_idx] = 0\n\n      # ---------- craft at workshop ----------\n      recipe = world.cookbook.recipes.get(stick_idx, {})\n      workshop_kind = recipe.get(\"_at\")\n      if workshop_kind is not None:\n          ws_cells = find_cells(workshop_kind)\n          if not ws_cells:\n              return actions\n          dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in ws_cells]\n          ws_target = ws_cells[int(np.argmin(dists))]\n          actions.extend(bfs(cur_pos, ws_target))\n          actions.append(4)  # USE to craft\n      else:\n          actions.append(4)  # USE to craft at current location\n\n      return actions\n  except Exception:\n      return []", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T19:30:36.089782", "function_name": "make_stick", "function_body": "  ACTION = env.action_specs()\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  def find_nearest(pos, kind):\n      \"\"\"Return coordinates of the nearest cell containing `kind`.\"\"\"\n      layer = state.grid[:, :, kind]\n      ys, xs = np.where(layer > 0)\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - pos[0]) + np.abs(ys - pos[1])\n      i = int(np.argmin(dists))\n      return (int(xs[i]), int(ys[i]))\n\n  def moves_to(cur, target):\n      \"\"\"Return a list of movement actions (Manhattan) from cur to target.\"\"\"\n      seq = []\n      x, y = cur\n      tx, ty = target\n      while x != tx:\n          if tx > x:\n              seq.append(ACTION[\"RIGHT\"])\n              x += 1\n          else:\n              seq.append(ACTION[\"LEFT\"])\n              x -= 1\n      while y != ty:\n          if ty > y:\n              seq.append(ACTION[\"DOWN\"])\n              y += 1\n          else:\n              seq.append(ACTION[\"UP\"])\n              y -= 1\n      return seq\n\n  # Identify stick index and its primitive requirements\n  stick_idx = idx[\"stick\"]\n  needed = world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n\n  plan = []\n  cur_pos = state.pos\n\n  # Collect each required primitive\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          target = find_nearest(cur_pos, prim_idx)\n          if target is None:\n              continue  # primitive missing; skip (should not happen in valid scenario)\n          plan.extend(moves_to(cur_pos, target))\n          plan.append(ACTION[\"USE\"])   # pick up the primitive\n          cur_pos = target\n\n  # Move to workshop (if required) and craft the stick\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      wk_idx = idx[workshop_name] if isinstance(workshop_name, str) else workshop_name\n      wk_pos = find_nearest(cur_pos, wk_idx)\n      if wk_pos is not None:\n          plan.extend(moves_to(cur_pos, wk_pos))\n          cur_pos = wk_pos\n\n  # Final use to craft the stick\n  plan.append(ACTION[\"USE\"])\n  return plan", "env_interactions": 4, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T19:30:37.217169", "function_name": "make_stick", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ----------------------------------------------------------------------\n  # Environment utilities\n  # ----------------------------------------------------------------------\n  ACTION = env.action_specs()                     # map name \u2192 int\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  # ----------------------------------------------------------------------\n  # Helper functions\n  # ----------------------------------------------------------------------\n  def find_nearest(pos, kind, grid):\n      \"\"\"Return (x, y) of the closest cell that contains the given kind.\"\"\"\n      layer = grid[:, :, kind]\n      ys, xs = np.where(layer > 0)\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - pos[0]) + np.abs(ys - pos[1])\n      i = int(np.argmin(dists))\n      return (int(xs[i]), int(ys[i]))\n\n  def bfs_path(start, goal, grid):\n      \"\"\"Shortest Manhattan path from start to goal avoiding occupied cells.\"\"\"\n      if start == goal:\n          return [start]\n\n      W, H, _ = grid.shape\n      visited = np.full((W, H), False, dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start[0], start[1]] = True\n\n      while q:\n          x, y = q.popleft()\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < W and 0 <= ny < H):\n                  continue\n              if visited[nx, ny]:\n                  continue\n              # allow stepping onto the goal even if it is occupied\n              if (nx, ny) != goal and grid[nx, ny].any():\n                  continue\n              visited[nx, ny] = True\n              prev[(nx, ny)] = (x, y)\n              if (nx, ny) == goal:\n                  # reconstruct path\n                  path = [(nx, ny)]\n                  while path[-1] != start:\n                      path.append(prev[path[-1]])\n                  path.reverse()\n                  return path\n              q.append((nx, ny))\n      return None\n\n  def actions_from_path(path):\n      \"\"\"Translate a list of positions into a list of action indices.\"\"\"\n      seq = []\n      for (x0, y0), (x1, y1) in zip(path, path[1:]):\n          if x1 > x0:\n              seq.append(ACTION[\"RIGHT\"])\n          elif x1 < x0:\n              seq.append(ACTION[\"LEFT\"])\n          elif y1 > y0:\n              seq.append(ACTION[\"DOWN\"])\n          elif y1 < y0:\n              seq.append(ACTION[\"UP\"])\n      return seq\n\n  # ----------------------------------------------------------------------\n  # Determine what we need to craft a stick\n  # ----------------------------------------------------------------------\n  stick_idx = idx[\"stick\"]\n  needed = world.cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n\n  # Working copy of the grid so we can simulate pickups\n  grid = state.grid.copy()\n  plan = []\n  cur_pos = state.pos\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive\n  # ----------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = find_nearest(cur_pos, prim_idx, grid)\n          if target is None:\n              # primitive not present \u2013 cannot finish the task\n              return []\n          path = bfs_path(cur_pos, target, grid)\n          if path is None:\n              return []   # no reachable path\n          plan.extend(actions_from_path(path))\n          plan.append(ACTION[\"USE\"])          # pick up the primitive\n          # simulate removal of the primitive from the world\n          grid[target[0], target[1], prim_idx] = 0\n          cur_pos = target\n\n  # ----------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the stick\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      wk_idx = idx[workshop_name] if isinstance(workshop_name, str) else workshop_name\n      wk_pos = find_nearest(cur_pos, wk_idx, grid)\n      if wk_pos is not None:\n          path = bfs_path(cur_pos, wk_pos, grid)\n          if path is not None:\n              plan.extend(actions_from_path(path))\n              cur_pos = wk_pos\n\n  # Final USE to actually craft the stick\n  plan.append(ACTION[\"USE\"])\n\n  return plan", "env_interactions": 4, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T19:30:57.895385", "function_name": "make_stick", "function_body": "  actions = []\n  world = env.world\n  state = env._current_state\n\n  # Index of the target item\n  stick_idx = world.cookbook.index[\"stick\"]\n  if state.inventory[stick_idx] > 0:\n      return actions\n\n  # --------------------------------------------------------------\n  # Helper utilities\n  # --------------------------------------------------------------\n  import numpy as np\n  import collections\n\n  # Action mapping (matches CraftLab.action_specs)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  def move_action(cur, nxt):\n      \"\"\"Return the action that moves from cur \u2192 nxt (one step).\"\"\"\n      dx = nxt[0] - cur[0]\n      dy = nxt[1] - cur[1]\n      if dx == 1:\n          return RIGHT\n      if dx == -1:\n          return LEFT\n      if dy == 1:\n          return DOWN\n      if dy == -1:\n          return UP\n      raise ValueError(\"Non\u2011adjacent step supplied to move_action\")\n\n  def bfs_adjacent(start, targets, grid):\n      \"\"\"\n      Breadth\u2011first search for the shortest path from start to any empty cell\n      that is orthogonally adjacent to one of the target cells.\n      Returns a list of positions including the start and the goal cell.\n      \"\"\"\n      W, H, _ = grid.shape\n      visited = np.zeros((W, H), dtype=bool)\n      q = collections.deque()\n      q.append((tuple(start), []))\n      visited[start] = True\n      target_set = {tuple(t) for t in targets}\n\n      while q:\n          (x, y), path = q.popleft()\n          # Check adjacency to any target\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path + [(x, y)]\n          # Expand neighbours (4\u2011connectivity)\n          for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  # Cell must be completely empty to walk through\n                  if grid[nx, ny, :].sum() == 0:\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [(x, y)]))\n      raise RuntimeError(\"No reachable adjacent cell found\")\n\n  # --------------------------------------------------------------\n  # 1) Collect required primitive resources\n  # --------------------------------------------------------------\n  primitives_needed = world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n  cur_pos = tuple(state.pos)\n\n  for prim_idx, count in primitives_needed.items():\n      for _ in range(count):\n          # If we already have this primitive, skip\n          if state.inventory[prim_idx] > 0:\n              continue\n\n          # Locate all cells that contain the primitive\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(f\"Primitive {world.cookbook.index.get(prim_idx, prim_idx)} not present\")\n\n          # Find path to an empty cell adjacent to one of those primitives\n          path = bfs_adjacent(cur_pos, prim_cells, state.grid)\n\n          # Translate path into actions (skip the first position \u2013 we are already there)\n          for nxt in path[1:]:\n              actions.append(move_action(cur_pos, nxt))\n              cur_pos = nxt\n\n          # Use action to pick up the primitive\n          actions.append(USE)\n\n  # --------------------------------------------------------------\n  # 2) Move to the appropriate workshop and craft the stick\n  # --------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      raise RuntimeError(\"Stick recipe does not specify a workshop\")\n  workshop_idx = world.cookbook.index[workshop_name]\n\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      raise RuntimeError(f\"Workshop '{workshop_name}' not found in the world\")\n\n  path = bfs_adjacent(cur_pos, workshop_cells, state.grid)\n  for nxt in path[1:]:\n      actions.append(move_action(cur_pos, nxt))\n      cur_pos = nxt\n\n  # Final USE to craft the stick at the workshop\n  actions.append(USE)\n\n  return actions", "env_interactions": 5, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T19:30:59.017054", "function_name": "make_stick", "function_body": "  actions = []\n  world = env.world\n  state = env._current_state\n\n  # Index of the goal item \"stick\"\n  stick_idx = world.cookbook.index[\"stick\"]\n  if state.inventory[stick_idx] > 0:\n      return actions\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  import collections\n\n  def move_action(cur, nxt):\n      \"\"\"Translate a step from cur -> nxt into an action index.\"\"\"\n      dx = nxt[0] - cur[0]\n      dy = nxt[1] - cur[1]\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise ValueError(\"Invalid move\")\n\n  def bfs_to_adjacent(start, targets, grid):\n      \"\"\"\n      Bread\u2011first search for the shortest path from start to any empty cell\n      that is orthogonally adjacent to one of the target cells.\n      Returns a list of positions including the start and the final cell.\n      \"\"\"\n      W, H, _ = grid.shape\n      visited = np.zeros((W, H), dtype=bool)\n      q = collections.deque()\n      q.append((start, [start]))\n      visited[start] = True\n      target_set = {tuple(t) for t in targets}\n      while q:\n          pos, path = q.popleft()\n          # Check adjacency to any target\n          for tx, ty in target_set:\n              if abs(pos[0] - tx) + abs(pos[1] - ty) == 1:\n                  return path\n          # Expand neighbours (only through empty cells)\n          for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if grid[nx, ny, :].sum() == 0:      # empty cell\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [(nx, ny)]))\n      raise RuntimeError(\"No reachable target\")\n\n  # ------------------------------------------------------------------\n  # 1) Collect required primitives for a stick.\n  # ------------------------------------------------------------------\n  primitive_reqs = world.cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n  cur_pos = tuple(state.pos)\n\n  for prim_idx, needed in primitive_reqs.items():\n      for _ in range(needed):\n          # If we already have the primitive in inventory, skip.\n          if state.inventory[prim_idx] > 0:\n              continue\n          # Locate cells containing this primitive.\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(\"Required primitive not present in world\")\n          # Find path to a free cell adjacent to one of the primitive cells.\n          path = bfs_to_adjacent(cur_pos, prim_cells, state.grid)\n          # Convert path steps into actions.\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n          # Use action to pick up the primitive.\n          actions.append(4)   # USE\n          # Update temporary state to reflect the pickup (so subsequent searches see the cell empty).\n          # This is optional for planning but helps avoid re\u2011visiting the same cell.\n          state.grid[cur_pos[0], cur_pos[1], prim_idx] = 0\n          state.inventory[prim_idx] += 1\n\n  # ------------------------------------------------------------------\n  # 2) Go to the workshop and craft the stick.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      raise RuntimeError(\"Stick recipe does not specify a workshop\")\n  workshop_idx = world.cookbook.index[workshop_name]\n\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      raise RuntimeError(\"Workshop for stick not found in the world\")\n  path = bfs_to_adjacent(cur_pos, workshop_cells, state.grid)\n  for step in path[1:]:\n      actions.append(move_action(cur_pos, step))\n      cur_pos = step\n\n  # Craft the stick at the workshop.\n  actions.append(4)   # USE\n\n  return actions", "env_interactions": 5, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T19:31:15.410257", "function_name": "make_stick", "function_body": "  # Determine the action IDs (fallback to default order if needed)\n  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      # Default ordering: DOWN, UP, LEFT, RIGHT, USE\n      action_ids = [0, 1, 2, 3, 4]\n\n  # Resolve the index of the target item \"stick\" in the cookbook\n  try:\n      goal_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      goal_idx = env.world.cookbook.index.get(\"stick\")\n  if goal_idx is None:\n      return []\n\n  # Helper to check if a state satisfies the stick goal\n  def is_goal(state):\n      return state.satisfies(\"\", goal_idx)\n\n  # Obtain the current internal state without mutating the live environment\n  start_state = getattr(env, \"_current_state\", None)\n  if start_state is None:\n      # If the attribute is missing, reset the environment to obtain one\n      env.reset()\n      start_state = env._current_state\n\n  from collections import deque\n\n  # Bread\u2011first search over deterministic state transitions\n  frontier = deque()\n  frontier.append((start_state, []))\n  visited = set()\n\n  # Encode a state uniquely for the visited set\n  def state_key(st):\n      return (st.pos, st.dir, st.inventory.tobytes())\n\n  visited.add(state_key(start_state))\n\n  max_plan_len = 300  # safety bound to keep the search tractable\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n      if is_goal(cur_state):\n          return cur_plan\n      if len(cur_plan) >= max_plan_len:\n          continue\n      for a in action_ids:\n          _, nxt_state = cur_state.step(a)\n          key = state_key(nxt_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((nxt_state, cur_plan + [a]))\n\n  # No plan found within limits \u2013 return empty list\n  return []", "env_interactions": 4, "island_id": 7, "scores": {"3": 1.5}}
