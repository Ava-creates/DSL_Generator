{"timestamp": "2025-10-21T17:53:06.005604", "function_name": "make_stick", "function_body": "  actions = []\n  world = env.world\n  state = env._current_state\n\n  stick_idx = world.cookbook.index[\"stick\"]\n  if state.inventory[stick_idx] > 0:\n      return actions\n\n  # Convert a move from cur -> nxt into the corresponding action index.\n  def move_action(cur, nxt):\n      dx = nxt[0] - cur[0]\n      dy = nxt[1] - cur[1]\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise ValueError(\"invalid move delta\")\n\n  # Bread\u2011first search that stops when it reaches a cell adjacent to any target.\n  def bfs_adjacent(start, target_cells, grid):\n      W, H, _ = grid.shape\n      visited = np.full((W, H), False, dtype=bool)\n      q = collections.deque()\n      q.append((start, []))\n      visited[start] = True\n      targets = {tuple(t) for t in target_cells}\n      while q:\n          (x, y), path = q.popleft()\n          # Adjacent to a target?\n          for tx, ty in targets:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path + [(x, y)]\n          # Expand neighbours.\n          for dx, dy in ((0, 1), (0, -1), (1, 0), (-1, 0)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if grid[nx, ny, :].sum() == 0:   # free cell\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [(x, y)]))\n      raise RuntimeError(\"No reachable target\")\n\n  # ----------- Gather primitive ingredients -----------\n  prim_req = world.cookbook.primitives_for(stick_idx)\n  cur_pos = tuple(state.pos)\n\n  for prim_idx, count in prim_req.items():\n      for _ in range(count):\n          if state.inventory[prim_idx] > 0:\n              continue\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(\"Required primitive not present on the map\")\n          path = bfs_adjacent(cur_pos, prim_cells, state.grid)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n          actions.append(4)   # USE to pick up\n\n  # ----------- Go to workshop and craft the stick -----------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      # Stick is a primitive; nothing else to do.\n      return actions\n\n  workshop_idx = world.cookbook.index[workshop_name]\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      raise RuntimeError(\"Workshop for stick not found\")\n  path = bfs_adjacent(cur_pos, workshop_cells, state.grid)\n  for step in path[1:]:\n      actions.append(move_action(cur_pos, step))\n      cur_pos = step\n  actions.append(4)   # USE to craft\n\n  return actions", "env_interactions": 5, "island_id": 8, "scores": {"3": 0.0}}
