{"timestamp": "2025-10-21T17:20:25.807249", "function_name": "make_stick", "function_body": "  import re\n  import numpy as np\n\n  # Reset the environment and obtain the initial observation.\n  obs = env.reset()\n  actions = []\n\n  # Extract the goal name from the task description, e.g. \"make[stick]\".\n  task_name = obs.get('task_name', '')\n  m = re.search(r'\\[(\\w+)\\]', task_name)\n  goal_name = m.group(1) if m else None\n\n  # If we cannot determine the goal, return an empty plan.\n  if goal_name is None:\n      return actions\n\n  # Access world information and the recipe book.\n  world = env.world\n  cookbook = world.cookbook\n\n  # Convert the textual goal into the internal integer index.\n  goal_idx = cookbook.index[goal_name]\n\n  # Determine which primitive items are required for this goal.\n  # The dictionary maps primitive indices to the required count.\n  needed_prims = cookbook.primitives_for(goal_idx)\n\n  # Safety limit on the number of steps we will try.\n  max_steps = 500\n\n  for _ in range(max_steps):\n      # Current internal state of the environment.\n      state = env._current_state\n\n      # If the goal item is already in the inventory, we are done.\n      if state.satisfies('', goal_idx):\n          break\n\n      # Try to USE (action 4) if any needed primitive is in the 3\u00d73 neighbourhood.\n      chosen_action = None\n      for prim_idx, cnt in needed_prims.items():\n          if cnt <= 0:\n              continue\n          if state.next_to(prim_idx):\n              chosen_action = 4          # USE\n              break\n\n      # If nothing to pick up nearby, move randomly.\n      if chosen_action is None:\n          chosen_action = np.random.choice([0, 1, 2, 3])   # DOWN, UP, LEFT, RIGHT\n\n      # Execute the action and record it.\n      reward, done, _ = env.step(int(chosen_action))\n      actions.append(int(chosen_action))\n\n      if done:\n          break\n\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-10-21T17:20:43.221570", "function_name": "make_stick", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  # goal index for stick\n  try:\n      goal_idx = cookbook.index[\"stick\"]\n  except Exception:\n      return []\n\n  # primitives needed\n  prim_req = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n  if not prim_req:\n      # stick might be primitive itself\n      return []\n\n  # action indices\n  act_map = env.action_specs()\n  DOWN = act_map.get('DOWN', 0)\n  UP = act_map.get('UP', 1)\n  LEFT = act_map.get('LEFT', 2)\n  RIGHT = act_map.get('RIGHT', 3)\n  USE = act_map.get('USE', 4)\n\n  def moves_to(start, target):\n      cx, cy = start\n      tx, ty = target\n      actions = []\n      while cx < tx:\n          actions.append(DOWN); cx += 1\n      while cx > tx:\n          actions.append(UP); cx -= 1\n      while cy < ty:\n          actions.append(RIGHT); cy += 1\n      while cy > ty:\n          actions.append(LEFT); cy -= 1\n      return actions\n\n  grid = state.grid\n  # locate all primitives\n  prim_locations = {}\n  for p_idx in prim_req:\n      locs = np.argwhere(grid[:, :, p_idx] > 0)\n      prim_locations[p_idx] = [tuple(pos) for pos in locs]\n\n  # locate a workshop (any type)\n  workshop_pos = None\n  for wk_idx in world.workshop_indices:\n      cells = np.argwhere(grid[:, :, wk_idx] > 0)\n      if cells.size:\n          workshop_pos = tuple(cells[0])\n          break\n\n  if workshop_pos is None:\n      # no workshop, cannot craft\n      return []\n\n  cur_pos = state.pos\n  plan = []\n\n  # collect each required primitive\n  for p_idx, needed in prim_req.items():\n      collected = 0\n      available = prim_locations.get(p_idx, []).copy()\n      while collected < needed and available:\n          # choose nearest\n          dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in available]\n          nearest = int(np.argmin(dists))\n          target = available.pop(nearest)\n\n          plan.extend(moves_to(cur_pos, target))\n          cur_pos = target\n          plan.append(USE)   # pick up\n          collected += 1\n\n      if collected < needed:\n          # not enough primitives found\n          return []\n\n  # move to workshop and craft\n  plan.extend(moves_to(cur_pos, workshop_pos))\n  plan.append(USE)   # craft action\n  return plan", "env_interactions": 4, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T17:20:44.334331", "function_name": "make_stick", "function_body": "  env.reset()\n  state = env._current_state            # CraftState\n  world = env.world                      # CraftWorld\n  cookbook = world.cookbook\n\n  # Goal index for \"stick\"\n  try:\n      goal_idx = cookbook.index[\"stick\"]\n  except Exception:\n      return []  # stick not defined in this world\n\n  # Primitive requirements for one stick\n  prim_req = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n  if not prim_req:\n      # No recipe \u2013 stick is likely a primitive already present\n      return []\n\n  # Action mapping\n  act_map = env.action_specs()\n  DOWN = act_map.get('DOWN', 0)\n  UP = act_map.get('UP', 1)\n  LEFT = act_map.get('LEFT', 2)\n  RIGHT = act_map.get('RIGHT', 3)\n  USE = act_map.get('USE', 4)\n\n  # Helper to generate Manhattan moves (ignores obstacles)\n  def moves_to(start, target):\n      cx, cy = start\n      tx, ty = target\n      actions = []\n      while cx < tx:\n          actions.append(DOWN); cx += 1\n      while cx > tx:\n          actions.append(UP); cx -= 1\n      while cy < ty:\n          actions.append(RIGHT); cy += 1\n      while cy > ty:\n          actions.append(LEFT); cy -= 1\n      return actions\n\n  grid = state.grid\n\n  # Find locations of each required primitive on the grid\n  prim_locs = {}\n  for p_idx in prim_req:\n      locs = np.argwhere(grid[:, :, p_idx] > 0)\n      prim_locs[p_idx] = [tuple(pos) for pos in locs]\n\n  # Find any workshop cell (first one encountered)\n  workshop_pos = None\n  for wk_idx in world.workshop_indices:\n      cells = np.argwhere(grid[:, :, wk_idx] > 0)\n      if cells.size:\n          workshop_pos = tuple(cells[0])\n          break\n\n  cur_pos = state.pos\n  plan = []\n\n  # Collect each required primitive\n  for p_idx, needed in prim_req.items():\n      collected = 0\n      available = prim_locs.get(p_idx, []).copy()\n      while collected < needed and available:\n          # Choose the nearest primitive (Manhattan distance)\n          dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in available]\n          nearest = int(np.argmin(dists))\n          target = available.pop(nearest)\n\n          plan.extend(moves_to(cur_pos, target))\n          cur_pos = target\n          plan.append(USE)          # pick up the primitive\n          collected += 1\n\n  # Move to a workshop (if any) and craft the stick\n  if workshop_pos is not None:\n      plan.extend(moves_to(cur_pos, workshop_pos))\n      cur_pos = workshop_pos\n  plan.append(USE)  # trigger crafting at the workshop\n\n  return plan", "env_interactions": 4, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T17:21:07.380859", "function_name": "make_stick", "function_body": "  actions = []\n  world = env.world\n  state = env._current_state\n\n  # Index of the goal item (\"stick\")\n  stick_idx = world.cookbook.index[\"stick\"]\n  if state.inventory[stick_idx] > 0:\n      return actions\n\n  # ------------------------------------------------------------------\n  # Helper functions\n  # ------------------------------------------------------------------\n  def move_action(cur, nxt):\n      \"\"\"Return the integer action that moves from cur -> nxt.\"\"\"\n      dx = nxt[0] - cur[0]\n      dy = nxt[1] - cur[1]\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise ValueError(\"Invalid step\")\n\n  import collections\n\n  def bfs_adjacent(start, targets, grid):\n      \"\"\"Find shortest path from start to any empty cell adjacent to a target.\"\"\"\n      W, H, _ = grid.shape\n      visited = np.full((W, H), False, dtype=bool)\n      q = collections.deque()\n      q.append((start, []))\n      visited[start] = True\n      target_set = {tuple(t) for t in targets}\n      while q:\n          (x, y), path = q.popleft()\n          # Stop if adjacent to a target\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path + [(x, y)]\n          # Explore neighbours (only through empty cells)\n          for dx, dy in [(0, 1), (0, -1), (-1, 0), (1, 0)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if grid[nx, ny, :].sum() == 0:  # empty cell\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [(x, y)]))\n      raise RuntimeError(\"No reachable target\")\n\n  # ------------------------------------------------------------------\n  # 1) Gather all primitive resources required for a stick.\n  # ------------------------------------------------------------------\n  primitive_requirements = world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n  cur_pos = tuple(state.pos)\n\n  for prim_idx, needed in primitive_requirements.items():\n      for _ in range(needed):\n          if state.inventory[prim_idx] > 0:\n              continue\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(\"Required primitive not present in the world\")\n          path = bfs_adjacent(cur_pos, prim_cells, state.grid)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n          actions.append(4)   # USE to pick up the primitive\n\n  # ------------------------------------------------------------------\n  # 2) Move to the proper workshop and craft the stick.\n  # ------------------------------------------------------------------\n  recipe_dict = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe_dict.get(\"_at\")\n  if workshop_name is None:\n      raise RuntimeError(\"No workshop specified for stick\")\n  workshop_idx = world.cookbook.index[workshop_name]\n\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      raise RuntimeError(\"Workshop for stick not found in the world\")\n\n  path = bfs_adjacent(cur_pos, workshop_cells, state.grid)\n  for step in path[1:]:\n      actions.append(move_action(cur_pos, step))\n      cur_pos = step\n\n  actions.append(4)   # USE to craft the stick\n\n  return actions", "env_interactions": 5, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T17:21:08.478525", "function_name": "make_stick", "function_body": "  actions = []\n  world = env.world\n  state = env._current_state\n\n  # ------------------------------------------------------------------\n  # Helper functions\n  # ------------------------------------------------------------------\n  def move_action(cur, nxt):\n      \"\"\"Return action index that moves from cur to nxt (orthogonal).\"\"\"\n      dx = nxt[0] - cur[0]\n      dy = nxt[1] - cur[1]\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise ValueError(\"Invalid move step\")\n\n  def bfs_adjacent(start, targets, grid):\n      \"\"\"\n      Bread\u2011first search for the shortest path from start to any empty cell\n      that is orthogonally adjacent to a target cell.\n      Returns a list of positions (including start) describing the path.\n      \"\"\"\n      W, H, _ = grid.shape\n      visited = np.full((W, H), False, dtype=bool)\n      q = collections.deque()\n      q.append((start, [start]))\n      visited[start] = True\n      target_set = {tuple(t) for t in targets}\n\n      while q:\n          (x, y), path = q.popleft()\n\n          # Check adjacency to any target\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n\n          # Explore neighbours (only through empty cells)\n          for dx, dy in [(0, 1), (0, -1), (-1, 0), (1, 0)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  # Cell is free if no kind occupies it\n                  if grid[nx, ny, :].sum() == 0:\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [(nx, ny)]))\n      raise RuntimeError(\"No reachable adjacent cell found\")\n\n  # ------------------------------------------------------------------\n  # Identify goal index (stick)\n  # ------------------------------------------------------------------\n  stick_idx = world.cookbook.index.get(\"stick\")\n  if stick_idx is None:\n      raise RuntimeError(\"Stick item not defined in cookbook\")\n\n  # If we already have a stick, nothing to do\n  if state.inventory[stick_idx] > 0:\n      return actions\n\n  # ------------------------------------------------------------------\n  # 1) Gather required primitives\n  # ------------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n  cur_pos = tuple(state.pos)\n\n  for prim_idx, count_needed in primitive_needs.items():\n      for _ in range(count_needed):\n          # Skip if already have this primitive in inventory\n          if state.inventory[prim_idx] > 0:\n              continue\n\n          # Locate cells that currently contain the primitive\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(f\"Required primitive {world.cookbook.index.get(prim_idx)} not present\")\n\n          # Find path to a cell adjacent to any of those primitive cells\n          path = bfs_adjacent(cur_pos, prim_cells, state.grid)\n\n          # Convert path steps to actions (skip the first position which is current)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n\n          # Pick up the primitive\n          actions.append(4)   # USE\n\n  # ------------------------------------------------------------------\n  # 2) Move to workshop and craft the stick\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      raise RuntimeError(\"Stick recipe does not specify a workshop\")\n\n  workshop_idx = world.cookbook.index[workshop_name]\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      raise RuntimeError(f\"Workshop cell for {workshop_name} not found\")\n\n  # Navigate to a cell adjacent to the workshop\n  path = bfs_adjacent(cur_pos, workshop_cells, state.grid)\n  for step in path[1:]:\n      actions.append(move_action(cur_pos, step))\n      cur_pos = step\n\n  # Final USE to craft the stick\n  actions.append(4)   # USE\n\n  return actions", "env_interactions": 0, "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-10-21T17:21:41.896857", "function_name": "make_stick", "function_body": "  env.reset()\n  world = env.world\n  idx = world.cookbook.index\n\n  # Action indices\n  action_map = env.action_specs()\n  DOWN = action_map[\"DOWN\"]\n  UP = action_map[\"UP\"]\n  LEFT = action_map[\"LEFT\"]\n  RIGHT = action_map[\"RIGHT\"]\n  USE = action_map[\"USE\"]\n\n  # Identify stick index (case\u2011insensitive fallback)\n  try:\n      stick_idx = idx[\"stick\"]\n  except Exception:\n      stick_idx = next(i for i, n in enumerate(idx.ordered_contents) if n.lower() == \"stick\")\n\n  # Determine required primitives/items for a stick\n  needed = world.cookbook.primitives_for(stick_idx)\n  if not needed:\n      needed = {stick_idx: 1}  # stick itself is a primitive\n\n  # Current state snapshot\n  state = env._current_state\n  cur_pos = tuple(state.pos)\n  grid = state.grid.copy()  # (W, H, K)\n\n  # Cells occupied by non\u2011grabbable entities are blocked\n  non_grabbable = list(world.non_grabbable_indices)\n  if non_grabbable:\n      blocked = np.any(grid[:, :, non_grabbable] > 0, axis=2)\n  else:\n      blocked = np.zeros(grid.shape[:2], dtype=bool)\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper: BFS path that avoids blocked cells\n  # ------------------------------------------------------------------\n  import collections\n\n  def bfs_path(start, targets, blocked_mask):\n      if start in targets:\n          return []\n      q = collections.deque([start])\n      visited = {start: (None, None)}  # node -> (parent, action)\n      while q:\n          cur = q.popleft()\n          for act, (dx, dy) in [(DOWN, (0, 1)), (UP, (0, -1)),\n                                (LEFT, (-1, 0)), (RIGHT, (1, 0))]:\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if not (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]):\n                  continue\n              if blocked_mask[nx, ny]:\n                  continue\n              nxt = (nx, ny)\n              if nxt in visited:\n                  continue\n              visited[nxt] = (cur, act)\n              if nxt in targets:\n                  # Reconstruct path\n                  path = []\n                  node = nxt\n                  while visited[node][0] is not None:\n                      parent, a = visited[node]\n                      path.append(a)\n                      node = parent\n                  return list(reversed(path))\n              q.append(nxt)\n\n      # Fallback: simple Manhattan moves (ignores obstacles)\n      def manhattan_moves(s, g):\n          x, y = s\n          gx, gy = g\n          moves = []\n          while x < gx:\n              moves.append(RIGHT); x += 1\n          while x > gx:\n              moves.append(LEFT); x -= 1\n          while y < gy:\n              moves.append(DOWN); y += 1\n          while y > gy:\n              moves.append(UP); y -= 1\n          return moves\n      return manhattan_moves(start, next(iter(targets)))\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives / items\n  # ------------------------------------------------------------------\n  for item_idx, need_cnt in needed.items():\n      need_cnt = int(need_cnt)\n      while need_cnt > 0:\n          locations = np.argwhere(grid[:, :, item_idx] > 0)\n          if locations.size == 0:\n              break  # No more of this item on the map\n          # Choose closest location (Manhattan distance heuristic)\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          target = tuple(locations[dists.argmin()])\n\n          # Move to the target avoiding blocked cells\n          path = bfs_path(cur_pos, {target}, blocked)\n          actions.extend(path)\n          cur_pos = target\n\n          # Pick up the item\n          actions.append(USE)\n          need_cnt -= 1\n\n          # Update simulated grid and blocked mask\n          grid[target[0], target[1], item_idx] -= 1\n          if grid[target[0], target[1], item_idx] == 0:\n              if non_grabbable:\n                  blocked[target[0], target[1]] = np.any(\n                      grid[target[0], target[1], non_grabbable] > 0\n                  )\n              else:\n                  blocked[target[0], target[1]] = False\n\n  # ------------------------------------------------------------------\n  # 2. Move to the workshop (if required) and craft the stick\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = idx[workshop_name]\n      ws_locations = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_locations.size:\n          ws_target = tuple(ws_locations[0])\n          path = bfs_path(cur_pos, {ws_target}, blocked)\n          actions.extend(path)\n          cur_pos = ws_target\n          actions.append(USE)  # craft at the workshop\n\n  return actions", "env_interactions": 4, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T17:21:43.016892", "function_name": "make_stick", "function_body": "  # Reset environment to start a fresh episode\n  env.reset()\n\n  # Shortcut references to world structures and the index mapping\n  world = env.world\n  idx = world.cookbook.index\n\n  # Identify the index for the goal item \"stick\"\n  stick_idx = idx[\"stick\"]\n\n  # Determine which primitive resources are needed to craft a stick\n  needed = world.cookbook.primitives_for(stick_idx)\n  if not needed:\n      # If stick itself is a primitive, just need to pick up one\n      needed = {stick_idx: 1}\n\n  # Action mapping from the environment\n  action_map = env.action_specs()\n  DOWN = action_map[\"DOWN\"]\n  UP = action_map[\"UP\"]\n  LEFT = action_map[\"LEFT\"]\n  RIGHT = action_map[\"RIGHT\"]\n  USE = action_map[\"USE\"]\n\n  # ------------------------------------------------------------------\n  # Helper functions\n  # ------------------------------------------------------------------\n  def manhattan_moves(start, goal):\n      \"\"\"Generate a simple Manhattan path ignoring obstacles.\"\"\"\n      x, y = start\n      gx, gy = goal\n      moves = []\n      while x < gx:\n          moves.append(RIGHT)\n          x += 1\n      while x > gx:\n          moves.append(LEFT)\n          x -= 1\n      while y < gy:\n          moves.append(DOWN)\n          y += 1\n      while y > gy:\n          moves.append(UP)\n          y -= 1\n      return moves\n\n  import collections\n\n  def bfs_path(start, targets, blocked):\n      \"\"\"\n      Breadth\u2011first search returning a list of actions that reaches any\n      cell in *targets* while avoiding cells marked in *blocked*.\n      \"\"\"\n      if start in targets:\n          return []\n      q = collections.deque([start])\n      visited = {start: (None, None)}  # cell -> (parent, action)\n      while q:\n          cur = q.popleft()\n          for act, (dx, dy) in [(DOWN, (0, 1)), (UP, (0, -1)),\n                                (LEFT, (-1, 0)), (RIGHT, (1, 0))]:\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if not (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]):\n                  continue\n              if blocked[nx, ny]:\n                  continue\n              nxt = (nx, ny)\n              if nxt in visited:\n                  continue\n              visited[nxt] = (cur, act)\n              if nxt in targets:\n                  # Reconstruct path\n                  path = []\n                  node = nxt\n                  while visited[node][0] is not None:\n                      parent, a = visited[node]\n                      path.append(a)\n                      node = parent\n                  return list(reversed(path))\n              q.append(nxt)\n      # Fallback to Manhattan moves if BFS fails\n      return manhattan_moves(start, next(iter(targets)))\n\n  # ------------------------------------------------------------------\n  # Current state information\n  # ------------------------------------------------------------------\n  state = env._current_state\n  cur_pos = tuple(state.pos)          # (x, y) coordinates\n  grid = state.grid.copy()            # Local copy for bookkeeping\n\n  # Mask of cells blocked by non\u2011grabbable entities\n  non_grabbable = list(world.non_grabbable_indices)\n  if non_grabbable:\n      blocked_mask = np.any(grid[:, :, non_grabbable] > 0, axis=2)\n  else:\n      blocked_mask = np.zeros(grid.shape[:2], dtype=bool)\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives / items\n  # ------------------------------------------------------------------\n  for item_idx, need_cnt in needed.items():\n      need_cnt = int(need_cnt)\n      while need_cnt > 0:\n          # Locate cells containing the required item\n          locations = np.argwhere(grid[:, :, item_idx] > 0)\n          if locations.size == 0:\n              # No more of this item on the map \u2013 break to avoid infinite loop\n              break\n\n          # Choose the closest location (Manhattan distance heuristic)\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          target = tuple(locations[dists.argmin()])\n\n          # Compute a path avoiding blocked cells\n          path = bfs_path(cur_pos, {target}, blocked_mask)\n          actions.extend(path)\n          cur_pos = target\n\n          # Pick up the item\n          actions.append(USE)\n          need_cnt -= 1\n\n          # Update simulated grid and blocked mask\n          grid[target[0], target[1], item_idx] -= 1\n          if non_grabbable:\n              blocked_mask[target[0], target[1]] = np.any(\n                  grid[target[0], target[1], non_grabbable] > 0\n              )\n\n  # ------------------------------------------------------------------\n  # 2. Move to workshop (if required) and craft the stick\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = idx[workshop_name]\n      ws_locations = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_locations.size > 0:\n          ws_target = tuple(ws_locations[0])\n          path = bfs_path(cur_pos, {ws_target}, blocked_mask)\n          actions.extend(path)\n          cur_pos = ws_target\n          # Use the workshop to craft the stick\n          actions.append(USE)\n\n  return actions", "env_interactions": 4, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T17:22:14.042057", "function_name": "make_stick", "function_body": "  # Helper data\n  DIR_VECT = {0: (0, 1), 1: (0, -1), 2: (-1, 0), 3: (1, 0)}  # DOWN,UP,LEFT,RIGHT\n  OPPOSITE = {0: 1, 1: 0, 2: 3, 3: 2}\n  USE = 4\n\n  world = env.world\n  state = env._current_state\n  grid = state.grid\n  idx = world.cookbook.index\n\n  # ----- identify goal (stick) and its recipe -----\n  stick_idx = idx[\"stick\"]\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  # ingredients (primitive indices) and counts\n  prim_counts = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  # workshop where stick must be crafted\n  workshop_name = recipe.get(\"_at\")\n  workshop_idx = idx[workshop_name] if workshop_name is not None else None\n\n  # ----- utility functions -----\n  def is_traversable(x, y):\n      \"\"\"Return True if cell (x,y) is empty (no entities).\"\"\"\n      if x < 0 or y < 0 or x >= grid.shape[0] or y >= grid.shape[1]:\n          return False\n      return grid[x, y].sum() == 0\n\n  def bfs(start, goal):\n      \"\"\"Return list of actions (0\u20113) to move from start to goal using 4\u2011connected moves.\"\"\"\n      from collections import deque\n      q = deque()\n      q.append((start, []))\n      visited = set()\n      visited.add(start)\n      while q:\n          (cx, cy), path = q.popleft()\n          if (cx, cy) == goal:\n              return path\n          for a, (dx, dy) in DIR_VECT.items():\n              nx, ny = cx + dx, cy + dy\n              if (nx, ny) not in visited and is_traversable(nx, ny):\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [a]))\n      raise RuntimeError(\"No path found\")\n\n  def move_to_adjacent(target_x, target_y):\n      \"\"\"\n      Produce actions to reach a traversable cell adjacent to (target_x,target_y).\n      After the returned actions, the agent will be on a neighbour cell and\n      facing the target (ready to USE).\n      \"\"\"\n      # find a traversable neighbour\n      for a, (dx, dy) in DIR_VECT.items():\n          nbx, nby = target_x + dx, target_y + dy\n          if is_traversable(nbx, nby):\n              # we will end up on (nbx,nby) and need to face the target.\n              # direction from neighbour to target is opposite of a\n              dir_to_target = OPPOSITE[a]  # because a moves from target to neighbour\n              # path to neighbour\n              path = bfs(state.pos, (nbx, nby))\n              # ensure correct facing: if last move of path != dir_to_target,\n              # we add a small turn (step away and back)\n              if not path or path[-1] != dir_to_target:\n                  # step one cell opposite to dir_to_target if possible\n                  ox, oy = DIR_VECT[OPPOSITE[dir_to_target]]\n                  back_x, back_y = nbx + ox, nby + oy\n                  if is_traversable(back_x, back_y):\n                      path += [OPPOSITE[dir_to_target], dir_to_target]\n                  else:\n                      # fallback: just add the required direction (may be wrong facing)\n                      path += [dir_to_target]\n              else:\n                  # already facing target after last move\n                  pass\n              return path\n      raise RuntimeError(\"No traversable neighbour for target ({},{})\".format(target_x, target_y))\n\n  # ----- collect primitives -----\n  actions = []\n  for prim_idx, need_cnt in prim_counts.items():\n      # locate all cells containing this primitive\n      locations = np.argwhere(grid[:, :, prim_idx] > 0)\n      if locations.size == 0:\n          raise RuntimeError(\"Primitive not found in grid\")\n      # pick first occurrence\n      tx, ty = locations[0]\n      # move adjacent and use\n      actions += move_to_adjacent(tx, ty)\n      actions += [USE] * need_cnt\n      # update internal state position/orientation for subsequent planning\n      # (simulate moves to keep state.pos correct)\n      for a in actions[-(len(move_to_adjacent(tx, ty)) + need_cnt):]:\n          if a == USE:\n              continue\n          dx, dy = DIR_VECT[a]\n          state.pos = (state.pos[0] + dx, state.pos[1] + dy)\n          state.dir = a\n\n  # ----- go to workshop and craft -----\n  if workshop_idx is not None:\n      wk_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if wk_locs.size == 0:\n          raise RuntimeError(\"Workshop not found\")\n      wx, wy = wk_locs[0]\n      actions += move_to_adjacent(wx, wy)\n      actions += [USE]  # craft stick\n\n  return actions", "env_interactions": 11, "island_id": 3, "scores": {"3": 0.0}}
