{"timestamp": "2025-10-21T16:30:57.730459", "function_name": "make_stick", "function_body": "  import numpy as np\n  from collections import deque\n\n  # reset environment to a fresh state and obtain the initial observation\n  env.reset()\n  state = env._current_state          # type: CraftState\n  world = env.world                    # CraftWorld instance\n  cookbook = world.cookbook\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  WIDTH, HEIGHT = state.grid.shape[:2]\n\n  # movement/action mapping (as defined in the environment)\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n  DIR2ACTION = {\n      (0, 1): ACTION_DOWN,\n      (0, -1): ACTION_UP,\n      (-1, 0): ACTION_LEFT,\n      (1, 0): ACTION_RIGHT,\n  }\n\n  def in_bounds(x, y):\n      return 0 <= x < WIDTH and 0 <= y < HEIGHT\n\n  def is_empty(x, y):\n      \"\"\"A cell is empty if no entity occupies any layer.\"\"\"\n      return in_bounds(x, y) and state.grid[x, y].sum() == 0\n\n  def bfs(start, goals):\n      \"\"\"Bread\u2011first search from start to the nearest cell in *goals*.\n      Returns a list of positions (including start) describing the path,\n      or None if no path exists.\"\"\"\n      q = deque()\n      q.append(start)\n      visited = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur in goals:\n              # reconstruct path\n              path = []\n              while cur is not None:\n                  path.append(cur)\n                  cur = visited[cur]\n              path.reverse()\n              return path\n          for dx, dy in [(0, 1), (0, -1), (1, 0), (-1, 0)]:\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if in_bounds(nx, ny) and (nx, ny) not in visited and is_empty(nx, ny):\n                  visited[(nx, ny)] = cur\n                  q.append((nx, ny))\n      return None\n\n  def move_along(path):\n      \"\"\"Convert a list of grid cells into actions and execute them.\n      *path* must start with the current position.\"\"\"\n      for (x0, y0), (x1, y1) in zip(path, path[1:]):\n          action = DIR2ACTION[(x1 - x0, y1 - y0)]\n          actions.append(action)\n          _, _, _ = env.step(action)          # update env/state\n      # after the loop the state reference is up\u2011to\u2011date\n      return\n\n  # ------------------------------------------------------------------\n  # Identify the goal item (stick) and its recipe\n  # ------------------------------------------------------------------\n  stick_name = \"stick\"\n  if stick_name not in cookbook.index.contents:\n      raise ValueError(\"Stick not defined in the recipe file.\")\n  stick_idx = cookbook.index[stick_name]\n\n  # Primitive requirements for ONE stick\n  primitive_needs = cookbook.primitives_for(stick_idx)   # dict {prim_idx: count}\n  # Workshop required for crafting the stick\n  stick_recipe = cookbook.recipes[stick_idx]\n  workshop_name = stick_recipe.get(\"_at\")\n  if workshop_name is None:\n      raise ValueError(\"Stick recipe does not specify a workshop.\")\n  workshop_idx = cookbook.index[workshop_name]\n\n  actions = []          # will hold the final sequence of action integers\n\n  # ------------------------------------------------------------------\n  # Helper to locate the nearest instance of a given kind\n  # ------------------------------------------------------------------\n  def locate_nearest(kind_idx):\n      \"\"\"Return (target_pos, adjacent_pos) where target_pos holds the entity\n      and adjacent_pos is an empty neighbour from which the agent can interact.\"\"\"\n      # all positions containing the entity\n      targets = [(x, y) for x in range(WIDTH) for y in range(HEIGHT)\n                 if state.grid[x, y, kind_idx] > 0]\n      if not targets:\n          raise RuntimeError(f\"No instance of kind {kind_idx} found on the map.\")\n      # for each target, collect its empty neighbours\n      adjacents = {}\n      for tx, ty in targets:\n          for dx, dy in [(0, 1), (0, -1), (1, 0), (-1, 0)]:\n              ax, ay = tx + dx, ty + dy\n              if is_empty(ax, ay):\n                  adjacents.setdefault((tx, ty), []).append((ax, ay))\n      # search for the closest reachable adjacent cell\n      start = state.pos\n      reachable_goals = {adj for adj_list in adjacents.values() for adj in adj_list}\n      path = bfs(start, reachable_goals)\n      if path is None:\n          raise RuntimeError(\"Cannot reach any instance of the required kind.\")\n      # the final cell in the path is the chosen adjacent position\n      chosen_adj = path[-1]\n      # find which target it is adjacent to\n      for tgt, adj_list in adjacents.items():\n          if chosen_adj in adj_list:\n              return tgt, chosen_adj\n      raise RuntimeError(\"Logic error while matching adjacent cell to target.\")\n\n  # ------------------------------------------------------------------\n  # Collect all needed primitives\n  # ------------------------------------------------------------------\n  for prim_idx, required_cnt in primitive_needs.items():\n      while state.inventory[prim_idx] < required_cnt:\n          # locate nearest primitive and move next to it\n          prim_pos, adj_pos = locate_nearest(prim_idx)\n          # move to the adjacent cell\n          path_to_adj = bfs(state.pos, {adj_pos})\n          if path_to_adj is None:\n              raise RuntimeError(\"Failed to plan path to primitive.\")\n          move_along(path_to_adj)\n\n          # face the primitive (issue a move action towards it; the agent will stay\n          # because the cell is occupied but direction will be set)\n          dx, dy = prim_pos[0] - state.pos[0], prim_pos[1] - state.pos[1]\n          face_action = DIR2ACTION[(dx, dy)]\n          actions.append(face_action)\n          _, _, _ = env.step(face_action)   # direction update only\n\n          # use / collect the primitive\n          actions.append(ACTION_USE)\n          _, _, _ = env.step(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # Move to the appropriate workshop and craft the stick\n  # ------------------------------------------------------------------\n  # locate nearest workshop cell\n  workshop_pos, workshop_adj = locate_nearest(workshop_idx)\n  path_to_workshop_adj = bfs(state.pos, {workshop_adj})\n  if path_to_workshop_adj is None:\n      raise RuntimeError(\"Cannot reach the workshop.\")\n  move_along(path_to_workshop_adj)\n\n  # face the workshop\n  dx, dy = workshop_pos[0] - state.pos[0], workshop_pos[1] - state.pos[1]\n  face_action = DIR2ACTION[(dx, dy)]\n  actions.append(face_action)\n  _, _, _ = env.step(face_action)\n\n  # use to craft\n  actions.append(ACTION_USE)\n  _, _, _ = env.step(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # Return the assembled action list\n  # ------------------------------------------------------------------\n  return actions", "env_interactions": 0, "island_id": 4, "scores": {"3": -1}}
