{"timestamp": "2025-10-21T21:06:04.071532", "function_name": "make_stick", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # -------------------------------------------------------------------------\n  # Basic references\n  # -------------------------------------------------------------------------\n  state = env._current_state          # current CraftState\n  world = env.world                    # CraftWorld instance\n  goal_idx = env.task.goal             # integer index of the desired item\n\n  # grid dimensions\n  H, W = state.grid.shape[0], state.grid.shape[1]\n\n  # mutable agent position\n  pos = tuple(state.pos)\n\n  actions = []                         # will hold the final action sequence\n\n  # map a movement delta to the corresponding action index\n  delta_to_action = {\n      (1, 0): RIGHT,\n      (-1, 0): LEFT,\n      (0, 1): DOWN,\n      (0, -1): UP,\n  }\n\n  # -------------------------------------------------------------------------\n  # Helper utilities\n  # -------------------------------------------------------------------------\n  def is_walkable(x, y):\n      \"\"\"A cell is walkable if it lies inside the map and contains no entities.\"\"\"\n      return 0 <= x < H and 0 <= y < W and state.grid[x, y].sum() == 0\n\n  def neighbours(x, y):\n      \"\"\"Yield walkable neighbour coordinates.\"\"\"\n      for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n          nx, ny = x + dx, y + dy\n          if is_walkable(nx, ny):\n              yield (nx, ny)\n\n  from collections import deque\n  def bfs(start, goals):\n      \"\"\"\n      Bread\u2011first search from `start` to the nearest cell in `goals`.\n      Returns a list of positions (excluding `start`, including the goal)\n      describing the path, or an empty list if no path exists.\n      \"\"\"\n      q = deque([start])\n      came_from = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur in goals:\n              # reconstruct path\n              path = []\n              while cur != start:\n                  path.append(cur)\n                  cur = came_from[cur]\n              path.reverse()\n              return path\n          for nb in neighbours(*cur):\n              if nb not in came_from:\n                  came_from[nb] = cur\n                  q.append(nb)\n      return []   # no path found\n\n  def move_along(path):\n      \"\"\"Convert a list of positions into actions and update `pos`.\"\"\"\n      nonlocal pos, actions\n      for nxt in path:\n          dx = nxt[0] - pos[0]\n          dy = nxt[1] - pos[1]\n          act = delta_to_action[(dx, dy)]\n          actions.append(act)\n          pos = nxt\n\n  def move_to_adjacent(target_cells):\n      \"\"\"\n      Given world coordinates of one or more target cells (e.g. a primitive or a\n      workshop), move to a walkable cell adjacent to the *nearest* target.\n      Returns the exact target cell we end up adjacent to (or None if unreachable).\n      \"\"\"\n      adj_set = set()\n      target_lookup = {}\n      for tx, ty in target_cells:\n          for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              ax, ay = tx + dx, ty + dy\n              if is_walkable(ax, ay):\n                  adj_set.add((ax, ay))\n                  target_lookup[(ax, ay)] = (tx, ty)\n      if not adj_set:\n          return None\n      path = bfs(pos, adj_set)\n      if not path:\n          return None\n      move_along(path)\n      return target_lookup[pos]\n\n  def collect_primitive(kind_idx, count):\n      \"\"\"Collect `count` units of the primitive identified by `kind_idx`.\"\"\"\n      for _ in range(count):\n          prim_cells = np.argwhere(state.grid[:, :, kind_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(\"Required primitive not present on the map\")\n          dists = np.abs(prim_cells[:, 0] - pos[0]) + np.abs(prim_cells[:, 1] - pos[1])\n          target = prim_cells[dists.argmin()]\n          target_coord = tuple(target)\n          adj_target = move_to_adjacent([target_coord])\n          if adj_target is None:\n              raise RuntimeError(\"Cannot reach required primitive\")\n          actions.append(USE)\n          state.grid[target[0], target[1], kind_idx] = 0\n\n  # -------------------------------------------------------------------------\n  # 1. Gather all primitives required for the goal\n  # -------------------------------------------------------------------------\n  primitives_needed = world.cookbook.primitives_for(goal_idx)\n  for kind_idx, needed_cnt in primitives_needed.items():\n      collect_primitive(kind_idx, needed_cnt)\n\n  # -------------------------------------------------------------------------\n  # 2. Go to the appropriate workshop (if any) and craft the item\n  # -------------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          raise RuntimeError(\"Required workshop not found in the world\")\n      move_to_adjacent([tuple(workshop_cells[0])])\n\n  # perform the crafting action\n  actions.append(USE)\n\n  return actions", "env_interactions": 1, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:06:05.193617", "function_name": "make_stick", "function_body": "  # action indices\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # basic references\n  state = env._current_state          # current CraftState\n  world = env.world                    # CraftWorld instance\n  goal_idx = env.task.goal             # integer index of the desired item\n\n  # grid dimensions\n  H, W = state.grid.shape[0], state.grid.shape[1]\n\n  # mutable position\n  pos = tuple(state.pos)\n\n  actions = []                         # final action list\n\n  # delta \u2192 action mapping (dx,dy) where first coord is row index\n  delta_to_action = {\n      (1, 0): RIGHT,\n      (-1, 0): LEFT,\n      (0, 1): DOWN,\n      (0, -1): UP,\n  }\n\n  # -------------------------------------------------------------------------\n  # Helper utilities\n  # -------------------------------------------------------------------------\n  def is_walkable(x, y):\n      \"\"\"Cell is walkable if inside bounds and contains no entities.\"\"\"\n      return 0 <= x < H and 0 <= y < W and state.grid[x, y].sum() == 0\n\n  def neighbours(x, y):\n      \"\"\"Yield walkable neighbour coordinates.\"\"\"\n      for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n          nx, ny = x + dx, y + dy\n          if is_walkable(nx, ny):\n              yield (nx, ny)\n\n  from collections import deque\n  def bfs(start, goals):\n      \"\"\"Shortest path from start to any cell in goals (BFS).\"\"\"\n      q = deque([start])\n      came = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur in goals:\n              # reconstruct path (excluding start, including goal)\n              path = []\n              while cur != start:\n                  path.append(cur)\n                  cur = came[cur]\n              path.reverse()\n              return path\n          for nb in neighbours(*cur):\n              if nb not in came:\n                  came[nb] = cur\n                  q.append(nb)\n      return []  # no path\n\n  def move_along(path):\n      \"\"\"Translate a list of positions into actions, updating pos.\"\"\"\n      nonlocal pos, actions\n      for nxt in path:\n          dx = nxt[0] - pos[0]\n          dy = nxt[1] - pos[1]\n          act = delta_to_action[(dx, dy)]\n          actions.append(act)\n          pos = nxt\n\n  def move_to_adjacent(target_cells):\n      \"\"\"\n      Move to a walkable cell adjacent to the nearest target cell.\n      Returns the target cell we end up adjacent to, or None if unreachable.\n      \"\"\"\n      adj_set = set()\n      lookup = {}\n      for tx, ty in target_cells:\n          for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              ax, ay = tx + dx, ty + dy\n              if is_walkable(ax, ay):\n                  adj_set.add((ax, ay))\n                  lookup[(ax, ay)] = (tx, ty)\n      if not adj_set:\n          return None\n      path = bfs(pos, adj_set)\n      if not path:\n          return None\n      move_along(path)\n      return lookup[pos]\n\n  def collect_primitive(kind_idx, count):\n      \"\"\"Collect `count` units of primitive `kind_idx`.\"\"\"\n      for _ in range(count):\n          # locate all cells containing the primitive\n          cells = np.argwhere(state.grid[:, :, kind_idx] > 0)\n          if cells.size == 0:\n              raise RuntimeError(\"Primitive not found on map\")\n          # choose closest by Manhattan distance\n          dists = np.abs(cells[:, 0] - pos[0]) + np.abs(cells[:, 1] - pos[1])\n          target = tuple(cells[dists.argmin()])\n          # move adjacent and use\n          adj = move_to_adjacent([target])\n          if adj is None:\n              raise RuntimeError(\"Cannot reach primitive\")\n          actions.append(USE)\n          # update internal grid copy (primitive disappears after pickup)\n          state.grid[target[0], target[1], kind_idx] = 0\n\n  # -------------------------------------------------------------------------\n  # 1. Gather required primitives for the goal\n  # -------------------------------------------------------------------------\n  needed = world.cookbook.primitives_for(goal_idx)\n  for kind_idx, cnt in needed.items():\n      collect_primitive(kind_idx, cnt)\n\n  # -------------------------------------------------------------------------\n  # 2. Go to workshop (if any) and craft the item\n  # -------------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      workshop_cells = [tuple(c) for c in np.argwhere(state.grid[:, :, workshop_idx] > 0)]\n      if not workshop_cells:\n          raise RuntimeError(\"Workshop not present in world\")\n      move_to_adjacent(workshop_cells)\n  # perform crafting action\n  actions.append(USE)\n\n  return actions", "env_interactions": 1, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:06:34.461944", "function_name": "make_stick", "function_body": "  # action constants (as defined in CraftLab)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # -------------------------------------------------------------------------\n  # Basic references\n  # -------------------------------------------------------------------------\n  state = env._current_state          # current CraftState\n  world = env.world                    # CraftWorld instance\n  goal_idx = env.task.goal             # integer index of the desired item\n\n  # grid dimensions\n  H, W = state.grid.shape[0], state.grid.shape[1]\n\n  # mutable copy of the agent position (row, col)\n  pos = tuple(state.pos)\n\n  actions = []                         # final action sequence\n\n  # map a movement delta to the corresponding action index\n  delta_to_action = {\n      (0, 1): RIGHT,\n      (0, -1): LEFT,\n      (1, 0): DOWN,\n      (-1, 0): UP,\n  }\n\n  # -------------------------------------------------------------------------\n  # Helper utilities\n  # -------------------------------------------------------------------------\n  def is_walkable(x, y):\n      \"\"\"A cell is walkable if it is inside the map and contains no entities.\"\"\"\n      return 0 <= x < H and 0 <= y < W and state.grid[x, y].sum() == 0\n\n  def neighbours(x, y):\n      \"\"\"Yield walkable neighbour coordinates.\"\"\"\n      for dx, dy in [(0, 1), (0, -1), (1, 0), (-1, 0)]:\n          nx, ny = x + dx, y + dy\n          if is_walkable(nx, ny):\n              yield (nx, ny)\n\n  def bfs(start, goals):\n      \"\"\"Bread\u2011first search from `start` to the nearest cell in `goals`.\"\"\"\n      from collections import deque\n      q = deque([start])\n      came_from = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur in goals:\n              # reconstruct path (excluding start, including goal)\n              path = []\n              while cur != start:\n                  path.append(cur)\n                  cur = came_from[cur]\n              path.reverse()\n              return path\n          for nb in neighbours(*cur):\n              if nb not in came_from:\n                  came_from[nb] = cur\n                  q.append(nb)\n      return []   # no path found\n\n  def move_along(path):\n      \"\"\"Convert a list of positions into actions and update `pos`.\"\"\"\n      nonlocal pos, actions\n      for nxt in path:\n          dx = nxt[0] - pos[0]\n          dy = nxt[1] - pos[1]\n          act = delta_to_action[(dx, dy)]\n          actions.append(act)\n          pos = nxt\n\n  def move_to_adjacent(target_cells):\n      \"\"\"\n      Move to a walkable cell adjacent to the nearest target cell.\n      Returns the exact target cell we end up next to (or None if unreachable).\n      \"\"\"\n      adj_set = set()\n      lookup = {}\n      for tx, ty in target_cells:\n          for dx, dy in [(0, 1), (0, -1), (1, 0), (-1, 0)]:\n              ax, ay = tx + dx, ty + dy\n              if is_walkable(ax, ay):\n                  adj_set.add((ax, ay))\n                  lookup[(ax, ay)] = (tx, ty)\n      if not adj_set:\n          return None\n      path = bfs(pos, adj_set)\n      if not path:\n          return None\n      move_along(path)\n      return lookup[pos]\n\n  def collect_primitive(kind_idx, count):\n      \"\"\"Collect `count` units of the primitive identified by `kind_idx`.\"\"\"\n      for _ in range(count):\n          # locate all cells currently containing the primitive\n          prim_cells = np.argwhere(state.grid[:, :, kind_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(\"Required primitive not present on the map\")\n          # choose the closest primitive (Manhattan distance)\n          dists = np.abs(prim_cells[:, 0] - pos[0]) + np.abs(prim_cells[:, 1] - pos[1])\n          target = tuple(prim_cells[dists.argmin()])\n          # move adjacent and pick up\n          adj_target = move_to_adjacent([target])\n          if adj_target is None:\n              raise RuntimeError(\"Cannot reach required primitive\")\n          actions.append(USE)\n          # update internal grid copy: primitive disappears after pickup\n          state.grid[target[0], target[1], kind_idx] = 0\n\n  # -------------------------------------------------------------------------\n  # 1. Gather all primitives required for the goal\n  # -------------------------------------------------------------------------\n  primitives_needed = world.cookbook.primitives_for(goal_idx)\n  for kind_idx, needed_cnt in primitives_needed.items():\n      collect_primitive(kind_idx, needed_cnt)\n\n  # -------------------------------------------------------------------------\n  # 2. Craft at the appropriate workshop (if any)\n  # -------------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          raise RuntimeError(\"Required workshop not found in the world\")\n      # move adjacent to the first workshop cell we encounter\n      move_to_adjacent([tuple(workshop_cells[0])])\n      actions.append(USE)   # perform crafting\n\n  # Return the complete action list\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:06:35.596668", "function_name": "make_stick", "function_body": "  # -------------------------------------------------------------------------\n  # Basic references\n  # -------------------------------------------------------------------------\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  state = env._current_state               # current CraftState\n  world = env.world                         # CraftWorld instance\n  cookbook = world.cookbook\n\n  # Goal index (the item we want to craft)\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      return []\n\n  # Grid dimensions (rows, cols)\n  rows, cols = state.grid.shape[0], state.grid.shape[1]\n\n  # -------------------------------------------------------------------------\n  # Helper utilities\n  # -------------------------------------------------------------------------\n  # Current mutable position of the agent (row, col)\n  cur_pos = tuple(state.pos)\n\n  # Mapping from movement delta to action index\n  delta_to_action = {\n      (1, 0): RIGHT,\n      (-1, 0): LEFT,\n      (0, 1): DOWN,\n      (0, -1): UP,\n  }\n\n  def in_bounds(r, c):\n      return 0 <= r < rows and 0 <= c < cols\n\n  def is_walkable(r, c):\n      \"\"\"A cell is walkable if it is inside the map and contains no entities.\"\"\"\n      return in_bounds(r, c) and state.grid[r, c].sum() == 0\n\n  def neighbours(r, c):\n      \"\"\"Yield walkable neighbour coordinates.\"\"\"\n      for dr, dc in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n          nr, nc = r + dr, c + dc\n          if is_walkable(nr, nc):\n              yield (nr, nc)\n\n  def bfs(start, targets):\n      \"\"\"Bread\u2011first search from start to the nearest cell in targets.\"\"\"\n      from collections import deque\n      q = deque([start])\n      came_from = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur in targets:\n              # reconstruct path (excluding start, including goal)\n              path = []\n              while cur != start:\n                  path.append(cur)\n                  cur = came_from[cur]\n              path.reverse()\n              return path\n          for nb in neighbours(*cur):\n              if nb not in came_from:\n                  came_from[nb] = cur\n                  q.append(nb)\n      return []  # no path found\n\n  actions = []  # final action list to return\n\n  def move_along(path):\n      \"\"\"Convert a list of positions into actions and update cur_pos.\"\"\"\n      nonlocal cur_pos, actions\n      for nxt in path:\n          dr = nxt[0] - cur_pos[0]\n          dc = nxt[1] - cur_pos[1]\n          act = delta_to_action[(dr, dc)]\n          actions.append(act)\n          cur_pos = nxt\n\n  def move_to_adjacent(target_cells):\n      \"\"\"\n      Move to a walkable cell adjacent to the nearest target cell.\n      Returns the exact target cell we ended up next to (or None if unreachable).\n      \"\"\"\n      # Build set of walkable cells that are adjacent to any target cell\n      adjacent_walkable = set()\n      target_lookup = {}\n      for tr, tc in target_cells:\n          for dr, dc in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              ar, ac = tr + dr, tc + dc\n              if is_walkable(ar, ac):\n                  adjacent_walkable.add((ar, ac))\n                  target_lookup[(ar, ac)] = (tr, tc)\n      if not adjacent_walkable:\n          return None\n      path = bfs(cur_pos, adjacent_walkable)\n      if not path:\n          return None\n      move_along(path)\n      # after moving, cur_pos is now an adjacent walkable cell\n      return target_lookup[cur_pos]\n\n  # -------------------------------------------------------------------------\n  # 1. Gather required primitives\n  # -------------------------------------------------------------------------\n  primitives_needed = cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  collected_cells = set()  # keep track of primitives already taken\n\n  for kind_idx, needed_cnt in primitives_needed.items():\n      for _ in range(needed_cnt):\n          # locate all cells that currently contain this primitive and are not yet collected\n          prim_cells = np.argwhere(state.grid[:, :, kind_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(\"Required primitive not present on the map\")\n          # filter out already collected cells\n          prim_cells = [tuple(cell) for cell in prim_cells if tuple(cell) not in collected_cells]\n          if not prim_cells:\n              raise RuntimeError(\"Not enough instances of required primitive\")\n          # choose the nearest primitive (Manhattan distance)\n          dists = [abs(r - cur_pos[0]) + abs(c - cur_pos[1]) for r, c in prim_cells]\n          target = prim_cells[int(np.argmin(dists))]\n          # move adjacent to it and pick it up\n          adj_target = move_to_adjacent([target])\n          if adj_target is None:\n              raise RuntimeError(\"Cannot reach required primitive\")\n          actions.append(USE)  # pick up\n          # mark as collected and remove from internal grid copy\n          collected_cells.add(target)\n          state.grid[target[0], target[1], kind_idx] = 0\n\n  # -------------------------------------------------------------------------\n  # 2. Go to workshop (if any) and craft the goal item\n  # -------------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = cookbook.index[workshop_name]\n      workshop_cells = [tuple(cell) for cell in np.argwhere(state.grid[:, :, workshop_idx] > 0)]\n      if not workshop_cells:\n          raise RuntimeError(\"Required workshop not found in the world\")\n      # move adjacent to the nearest workshop cell\n      move_to_adjacent(workshop_cells)\n      actions.append(USE)   # craft the item\n\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:07:23.760961", "function_name": "make_stick", "function_body": "  # Retrieve current state and world configuration\n  state = env._current_state\n  world = env.world\n\n  # Determine the goal index (the item we need to craft)\n  goal_idx = getattr(env, \"task\", None)\n  if goal_idx is not None:\n      goal_idx = getattr(goal_idx, \"goal\", None)\n  if goal_idx is None:\n      goal_idx = getattr(env, \"goal\", None)\n  if goal_idx is None:\n      return []\n\n  # Primitive requirements for the goal (e.g., stick)\n  primitives_needed = world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n\n  actions = []\n  cur_pos = tuple(state.pos)   # (x, y)\n\n  # Grid dimensions\n  width, height = state.grid.shape[0], state.grid.shape[1]\n\n  # Pre\u2011compute cells that cannot be walked through (non\u2011grabbable entities)\n  blocked = np.zeros((width, height), dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= state.grid[:, :, idx] > 0\n\n  # -------------------------------------------------------------------------\n  # Helper: BFS to obtain a shortest sequence of movement actions from start\n  # to target while avoiding blocked cells.\n  # Returns a list of actions (0:DOWN, 1:UP, 2:LEFT, 3:RIGHT).\n  # -------------------------------------------------------------------------\n  from collections import deque\n\n  def bfs(start, target):\n      if start == target:\n          return []\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          for act, (dx, dy) in ((0, (0, 1)),   # DOWN\n                                 (1, (0, -1)),  # UP\n                                 (2, (-1, 0)),  # LEFT\n                                 (3, (1, 0))):  # RIGHT\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height and not blocked[nx, ny]:\n                  if (nx, ny) not in visited:\n                      new_path = path + [act]\n                      if (nx, ny) == target:\n                          return new_path\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), new_path))\n      # Fallback: simple Manhattan moves ignoring obstacles\n      fallback = []\n      cx, cy = start\n      tx, ty = target\n      while cx < tx:\n          fallback.append(3)   # RIGHT\n          cx += 1\n      while cx > tx:\n          fallback.append(2)   # LEFT\n          cx -= 1\n      while cy < ty:\n          fallback.append(0)   # DOWN\n          cy += 1\n      while cy > ty:\n          fallback.append(1)   # UP\n          cy -= 1\n      return fallback\n\n  # -------------------------------------------------------------------------\n  # Collect all required primitives (respecting the needed counts)\n  # -------------------------------------------------------------------------\n  for kind_idx, count in primitives_needed.items():\n      for _ in range(count):\n          # Find remaining instances of this primitive on the grid\n          positions = np.argwhere(state.grid[:, :, kind_idx] > 0)\n          if positions.size == 0:\n              break\n          # Choose the nearest instance (Manhattan distance)\n          dists = np.abs(positions[:, 0] - cur_pos[0]) + np.abs(positions[:, 1] - cur_pos[1])\n          target = tuple(positions[dists.argmin()].tolist())\n          # Move to the primitive's cell\n          actions.extend(bfs(cur_pos, target))\n          cur_pos = target\n          # Pick it up\n          actions.append(4)   # USE\n\n  # -------------------------------------------------------------------------\n  # If the recipe specifies a workshop, move there and craft the item\n  # -------------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = recipe.get(\"_at\")\n  if workshop_idx is not None:\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          dists = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])\n          ws_target = tuple(workshop_cells[dists.argmin()].tolist())\n          actions.extend(bfs(cur_pos, ws_target))\n          cur_pos = ws_target\n          actions.append(4)   # USE to craft\n\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:07:24.882632", "function_name": "make_stick", "function_body": "  import numpy as np\n  from collections import deque\n\n  # action indices (as defined in CraftWorld)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  # Determine goal index (the item we need to craft)\n  goal_idx = None\n  if hasattr(env, \"task\") and hasattr(env.task, \"goal\"):\n      goal_idx = env.task.goal\n  elif hasattr(env, \"goal\"):\n      goal_idx = env.goal\n  if goal_idx is None:\n      return []\n\n  # Primitive requirements for the goal\n  needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # Helper: check if a cell is free to stand on (no blocking entity)\n  def is_free(pos, ignore_idx=None):\n      x, y = pos\n      # out of bounds\n      if x < 0 or y < 0 or x >= state.grid.shape[0] or y >= state.grid.shape[1]:\n          return False\n      cell = state.grid[x, y, :]\n      # if ignore_idx is given, treat that kind as empty (useful for target workshop)\n      if ignore_idx is not None:\n          cell = cell.copy()\n          cell[ignore_idx] = 0\n      return np.all(cell == 0)\n\n  # Helper: BFS to find shortest path from start to any of the goal positions\n  def bfs(start, goal_positions, allow_target_idx=None):\n      \"\"\"Return list of positions (including start) to reach a goal.\"\"\"\n      visited = set()\n      q = deque()\n      q.append((start, [start]))\n      visited.add(start)\n      goal_set = set(goal_positions)\n      while q:\n          pos, path = q.popleft()\n          if pos in goal_set:\n              return path\n          x, y = pos\n          for dx, dy, act in [(0, 1, DOWN), (0, -1, UP), (-1, 0, LEFT), (1, 0, RIGHT)]:\n              nx, ny = x + dx, y + dy\n              npos = (nx, ny)\n              if npos in visited:\n                  continue\n              if nx < 0 or ny < 0 or nx >= state.grid.shape[0] or ny >= state.grid.shape[1]:\n                  continue\n              if is_free(npos, ignore_idx=allow_target_idx):\n                  visited.add(npos)\n                  q.append((npos, path + [npos]))\n      return None  # no path found\n\n  # Helper: convert step between two adjacent cells into action index\n  def step_to_action(p1, p2):\n      x1, y1 = p1\n      x2, y2 = p2\n      if x2 > x1:\n          return RIGHT\n      if x2 < x1:\n          return LEFT\n      if y2 > y1:\n          return DOWN\n      if y2 < y1:\n          return UP\n      raise ValueError(\"Non\u2011adjacent step\")\n\n  # Collect required primitives\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          # locate all remaining instances of this primitive\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              continue\n          # choose the nearest one (Manhattan)\n          dists = np.abs(prim_cells[:, 0] - cur_pos[0]) + np.abs(prim_cells[:, 1] - cur_pos[1])\n          target_cell = tuple(prim_cells[dists.argmin()])\n\n          # find reachable adjacent free cell\n          adj_candidates = []\n          tx, ty = target_cell\n          for dx, dy in [(-1,0),(1,0),(0,-1),(0,1)]:\n              adj = (tx+dx, ty+dy)\n              if is_free(adj):\n                  adj_candidates.append(adj)\n\n          if not adj_candidates:\n              # cannot stand adjacent; skip this primitive\n              continue\n\n          # choose the adjacent cell with shortest path from current position\n          path = bfs(cur_pos, adj_candidates)\n          if path is None:\n              continue\n          # translate path into actions\n          for a, b in zip(path[:-1], path[1:]):\n              actions.append(step_to_action(a, b))\n          cur_pos = path[-1]\n\n          # now we are next to the primitive; use to pick it up\n          actions.append(USE)\n\n  # After gathering primitives, move to workshop (if required) and craft\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          # pick the nearest workshop\n          dists = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])\n          target_ws = tuple(workshop_cells[dists.argmin()])\n\n          # try to stand directly on the workshop cell if it is free (some workshops are traversable)\n          if is_free(target_ws, ignore_idx=workshop_idx):\n              path = bfs(cur_pos, [target_ws], allow_target_idx=workshop_idx)\n              if path:\n                  for a, b in zip(path[:-1], path[1:]):\n                      actions.append(step_to_action(a, b))\n                  cur_pos = path[-1]\n                  actions.append(USE)\n          else:\n              # otherwise find a free adjacent cell\n              adj_candidates = []\n              wx, wy = target_ws\n              for dx, dy in [(-1,0),(1,0),(0,-1),(0,1)]:\n                  adj = (wx+dx, wy+dy)\n                  if is_free(adj):\n                      adj_candidates.append(adj)\n              if adj_candidates:\n                  path = bfs(cur_pos, adj_candidates)\n                  if path:\n                      for a, b in zip(path[:-1], path[1:]):\n                          actions.append(step_to_action(a, b))\n                      cur_pos = path[-1]\n                      actions.append(USE)\n\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:07:54.788273", "function_name": "make_stick", "function_body": "  # Reset environment and fetch world information\n  env.reset()\n  world = env.world\n  idx = world.cookbook.index\n\n  # Identify the index for the goal item \"stick\"\n  try:\n      stick_idx = idx[\"stick\"]\n  except Exception:\n      # Fallback: case\u2011insensitive search\n      stick_idx = next(i for n, i in idx.contents.items() if n.lower() == \"stick\")\n\n  # Determine which primitive resources are required\n  needed = world.cookbook.primitives_for(stick_idx)\n  if not needed:\n      needed = {stick_idx: 1}\n\n  # Action indices for this environment\n  act_map = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act_map[\"DOWN\"],\n      act_map[\"UP\"],\n      act_map[\"LEFT\"],\n      act_map[\"RIGHT\"],\n      act_map[\"USE\"],\n  )\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def delta_to_action(dx, dy):\n      if dx == 1:\n          return RIGHT\n      if dx == -1:\n          return LEFT\n      if dy == 1:\n          return DOWN\n      if dy == -1:\n          return UP\n      raise ValueError(\"Invalid movement delta\")\n\n  from collections import deque\n\n  def compute_blocked(grid):\n      \"\"\"Return a boolean mask where non\u2011grabbable entities occupy cells.\"\"\"\n      if world.non_grabbable_indices:\n          mask = np.any(\n              grid[:, :, list(world.non_grabbable_indices)] > 0, axis=2\n          )\n          return mask\n      else:\n          return np.zeros(grid.shape[:2], dtype=bool)\n\n  def bfs(start, goal, blocked):\n      \"\"\"Bread\u2011first search returning a list of actions from start to goal.\"\"\"\n      if start == goal:\n          return []\n\n      w, h = blocked.shape\n      q = deque([start])\n      came_from = {start: None}\n\n      while q:\n          x, y = q.popleft()\n          for dx, dy, act in ((1, 0, RIGHT), (-1, 0, LEFT), (0, 1, DOWN), (0, -1, UP)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and not blocked[nx, ny]:\n                  nxt = (nx, ny)\n                  if nxt not in came_from:\n                      came_from[nxt] = ((x, y), act)\n                      if nxt == goal:\n                          # reconstruct actions\n                          actions = []\n                          cur = nxt\n                          while came_from[cur] is not None:\n                              prev, a = came_from[cur]\n                              actions.append(a)\n                              cur = prev\n                          actions.reverse()\n                          return actions\n                      q.append(nxt)\n\n      # No path found \u2013 fall back to Manhattan moves (ignores obstacles)\n      actions = []\n      x, y = start\n      tx, ty = goal\n      while x < tx:\n          actions.append(RIGHT)\n          x += 1\n      while x > tx:\n          actions.append(LEFT)\n          x -= 1\n      while y < ty:\n          actions.append(DOWN)\n          y += 1\n      while y > ty:\n          actions.append(UP)\n          y -= 1\n      return actions\n\n  # ------------------------------------------------------------------\n  # Simulated state for planning\n  # ------------------------------------------------------------------\n  state = env._current_state\n  cur_pos = tuple(state.pos)          # (x, y)\n  grid = state.grid.copy()            # mutable copy of the grid\n  blocked = compute_blocked(grid)\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives / items\n  # ------------------------------------------------------------------\n  for kind_idx, qty in needed.items():\n      for _ in range(int(qty)):\n          # Locate remaining instances of the required kind\n          locations = np.argwhere(grid[:, :, kind_idx] > 0)\n          if locations.size == 0:\n              # No more of this kind on the map \u2013 stop trying\n              break\n\n          # Choose the nearest occurrence (Manhattan distance)\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(\n              locations[:, 1] - cur_pos[1]\n          )\n          target = tuple(locations[dists.argmin()])\n\n          # Plan a path to the target and execute it\n          actions.extend(bfs(cur_pos, target, blocked))\n          cur_pos = target\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update simulated grid and blocked mask\n          grid[target[0], target[1], kind_idx] -= 1\n          blocked = compute_blocked(grid)\n\n  # ------------------------------------------------------------------\n  # 2. Move to the appropriate workshop (if required) and craft the stick\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      ws_idx = idx[workshop_name]\n      ws_cells = np.argwhere(grid[:, :, ws_idx] > 0)\n      if ws_cells.size:\n          ws_target = tuple(ws_cells[0])\n          actions.extend(bfs(cur_pos, ws_target, blocked))\n          cur_pos = ws_target\n          actions.append(USE)   # craft at the workshop\n\n  return actions", "env_interactions": 4, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:07:55.924280", "function_name": "make_stick", "function_body": "  # Reset environment to start fresh\n  env.reset()\n  world = env.world\n  idx = world.cookbook.index\n\n  # Identify the index for the goal item \"stick\"\n  try:\n      stick_idx = idx[\"stick\"]\n  except Exception:\n      # fallback case\u2011insensitive search\n      stick_idx = next(i for i, n in enumerate(idx.ordered_contents) if n.lower() == \"stick\")\n\n  # Determine which primitives need to be collected.\n  needed = world.cookbook.primitives_for(stick_idx)\n  if not needed:\n      needed = {stick_idx: 1}\n\n  # Action indices from the environment spec\n  act_map = env.action_specs()\n  DOWN = act_map[\"DOWN\"]\n  UP = act_map[\"UP\"]\n  LEFT = act_map[\"LEFT\"]\n  RIGHT = act_map[\"RIGHT\"]\n  USE = act_map[\"USE\"]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def delta_to_action(dx, dy):\n      \"\"\"Translate a grid delta into the corresponding action index.\"\"\"\n      if dx == 1:\n          return RIGHT\n      if dx == -1:\n          return LEFT\n      if dy == 1:\n          return DOWN\n      if dy == -1:\n          return UP\n      raise ValueError(\"Invalid movement delta\")\n\n  def bfs(start, goal, grid):\n      \"\"\"\n      Bread\u2011first search returning a list of actions from start to goal,\n      avoiding cells that contain any non\u2011grabbable entity.\n      \"\"\"\n      w, h, _ = grid.shape\n\n      # Compute blocked mask: any non\u2011grabbable kind present in a cell blocks it\n      blocked = np.zeros((w, h), dtype=bool)\n      for k in world.non_grabbable_indices:\n          blocked |= grid[:, :, k] > 0\n\n      from collections import deque\n      q = deque([tuple(start)])\n      came_from = {tuple(start): None}\n\n      while q:\n          x, y = q.popleft()\n          if (x, y) == tuple(goal):\n              # reconstruct actions\n              actions = []\n              cur = (x, y)\n              while came_from[cur] is not None:\n                  prev, act = came_from[cur]\n                  actions.append(act)\n                  cur = prev\n              actions.reverse()\n              return actions\n\n          for dx, dy, act in ((1, 0, RIGHT), (-1, 0, LEFT), (0, 1, DOWN), (0, -1, UP)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and not blocked[nx, ny]:\n                  nxt = (nx, ny)\n                  if nxt not in came_from:\n                      came_from[nxt] = ((x, y), act)\n                      q.append(nxt)\n\n      # No walkable path found \u2013 fall back to Manhattan moves (ignore obstacles)\n      fallback = []\n      x, y = start\n      tx, ty = goal\n      while x < tx:\n          fallback.append(RIGHT)\n          x += 1\n      while x > tx:\n          fallback.append(LEFT)\n          x -= 1\n      while y < ty:\n          fallback.append(DOWN)\n          y += 1\n      while y > ty:\n          fallback.append(UP)\n          y -= 1\n      return fallback\n\n  # ------------------------------------------------------------------\n  # Simulated current state (position and mutable grid copy)\n  # ------------------------------------------------------------------\n  state = env._current_state\n  cur_pos = tuple(state.pos)\n  grid = state.grid.copy()\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives / items\n  # ------------------------------------------------------------------\n  for kind_idx, qty in needed.items():\n      for _ in range(int(qty)):\n          # Find all cells that currently contain this kind\n          locations = np.argwhere(grid[:, :, kind_idx] > 0)\n          if locations.size == 0:\n              # No more of this primitive on the map \u2013 stop trying\n              break\n\n          # Choose the nearest location (Manhattan distance)\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          target = tuple(locations[dists.argmin()])\n\n          # Move to the target cell\n          actions.extend(bfs(cur_pos, target, grid))\n          cur_pos = target\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update our simulated grid copy\n          grid[target[0], target[1], kind_idx] -= 1\n\n  # ------------------------------------------------------------------\n  # 2. If a workshop is required, move there and craft the stick\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      ws_idx = idx[workshop_name]\n      ws_cells = np.argwhere(grid[:, :, ws_idx] > 0)\n      if ws_cells.size:\n          ws_target = tuple(ws_cells[0])\n          actions.extend(bfs(cur_pos, ws_target, grid))\n          cur_pos = ws_target\n          actions.append(USE)  # craft at the workshop\n\n  return actions", "env_interactions": 4, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:08:18.739741", "function_name": "make_stick", "function_body": "  # Reset the environment and obtain the initial state\n  env.reset()\n  state = env._current_state\n\n  # Index of the goal item (e.g., \"stick\")\n  goal_idx = env.task.goal\n\n  # Primitive requirements for the goal (primitive index \u2192 count)\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)\n\n  # Action identifiers (match CraftLab ordering)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  def _move_to(target):\n      \"\"\"Generate actions that move the agent from its current position to *target*.\n      The function also updates the local ``state`` variable after each step.\"\"\"\n      nonlocal state\n      actions = []\n      while tuple(state.pos) != tuple(target):\n          r, c = state.pos\n          tr, tc = target\n          if r < tr:\n              act = DOWN\n          elif r > tr:\n              act = UP\n          elif c < tc:\n              act = RIGHT\n          else:\n              act = LEFT\n          actions.append(act)\n          _, state = env.step(act)\n      return actions\n\n  plan = []\n\n  # ----------------------------------------------------------------------\n  # 1. Collect all required primitive items.\n  # ----------------------------------------------------------------------\n  for prim_idx, cnt in primitives_needed.items():\n      for _ in range(cnt):\n          # Find any cell that currently holds the primitive.\n          locs = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if locs.size == 0:\n              # Primitive not found \u2013 abort early (should not happen in a valid scenario).\n              return plan\n          target = tuple(locs[0])          # pick the first occurrence\n          plan.extend(_move_to(target))    # move next to it\n          plan.append(USE)                 # pick it up\n          _, state = env.step(USE)\n\n  # ----------------------------------------------------------------------\n  # 2. Go to the appropriate workshop (if required) and craft.\n  # ----------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = recipe.get('_at')\n  if workshop_idx is not None:\n      w_locs = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if w_locs.size > 0:\n          target = tuple(w_locs[0])\n          plan.extend(_move_to(target))\n          plan.append(USE)                 # trigger crafting\n          _, state = env.step(USE)\n\n  return plan", "env_interactions": 0, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:08:19.858339", "function_name": "make_stick", "function_body": "  # Reset the environment and get the initial state.\n  env.reset()\n  state = env._current_state\n\n  # Index of the goal item (e.g., \u201cstick\u201d).\n  goal_idx = env.task.goal\n\n  # Primitive resources required to craft the goal.\n  needed = env.world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # Action IDs used by CraftLab (DOWN, UP, LEFT, RIGHT, USE).\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  def _move_to(target):\n      \"\"\"Generate actions that move the agent from its current position to *target*,\n      updating the local ``state`` after each step.\"\"\"\n      nonlocal state\n      actions = []\n      while tuple(state.pos) != tuple(target):\n          r, c = state.pos\n          tr, tc = target\n          if r < tr:\n              act = DOWN\n          elif r > tr:\n              act = UP\n          elif c < tc:\n              act = RIGHT\n          else:\n              act = LEFT\n          actions.append(act)\n          _, state = env.step(act)\n      return actions\n\n  plan = []\n\n  # ----------------------------------------------------------------------\n  # 1. Collect all required primitive items.\n  # ----------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          # Locate all cells that currently hold the primitive.\n          locs = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if locs.size == 0:\n              # Primitive not found \u2013 abort early (should not happen in a valid scenario).\n              return plan\n          # Choose the nearest occurrence (Manhattan distance).\n          cur_r, cur_c = state.pos\n          dists = np.abs(locs[:, 0] - cur_r) + np.abs(locs[:, 1] - cur_c)\n          nearest = locs[dists.argmin()]\n          target = tuple(nearest)\n          plan.extend(_move_to(target))    # move next to it\n          plan.append(USE)                 # pick it up\n          _, state = env.step(USE)\n\n  # ----------------------------------------------------------------------\n  # 2. Go to the appropriate workshop (if the recipe specifies one) and craft.\n  # ----------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = recipe.get('_at')\n  if workshop_idx is not None:\n      w_locs = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if w_locs.size > 0:\n          cur_r, cur_c = state.pos\n          dists = np.abs(w_locs[:, 0] - cur_r) + np.abs(w_locs[:, 1] - cur_c)\n          nearest = w_locs[dists.argmin()]\n          target = tuple(nearest)\n          plan.extend(_move_to(target))\n          plan.append(USE)                 # trigger the crafting action\n          _, state = env.step(USE)\n\n  # Return the complete action sequence.\n  return plan", "env_interactions": 0, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:08:52.491116", "function_name": "make_stick", "function_body": "  # Reset environment and get initial state\n  env.reset()\n  state = env._current_state\n\n  # Identify the goal item and its primitive requirements\n  goal_idx = env.task.goal\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n\n  actions = []\n\n  # Grid dimensions\n  width, height, _ = state.grid.shape\n\n  # Mapping from movement delta to action index (DOWN, UP, LEFT, RIGHT)\n  DIR2ACT = {(1, 0): 0, (-1, 0): 1, (0, -1): 2, (0, 1): 3}\n\n  from collections import deque\n\n  def bfs(start, kind_idx):\n      \"\"\"Breadth\u2011first search for the nearest cell containing `kind_idx`.\n      Returns a list of positions from start to target (inclusive) or None.\"\"\"\n      visited = np.zeros((width, height), dtype=bool)\n      prev = np.empty((width, height, 2), dtype=int)\n\n      q = deque()\n      sr, sc = start\n      q.append((sr, sc))\n      visited[sr, sc] = True\n\n      while q:\n          r, c = q.popleft()\n          if state.grid[r, c, kind_idx] > 0:\n              # Reconstruct path\n              path = [(r, c)]\n              while (r, c) != (sr, sc):\n                  r, c = tuple(prev[r, c])\n                  path.append((r, c))\n              path.reverse()\n              return path\n\n          for dr, dc in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              nr, nc = r + dr, c + dc\n              if 0 <= nr < width and 0 <= nc < height and not visited[nr, nc]:\n                  cell = state.grid[nr, nc, :]\n                  # Passable if empty or contains the target kind\n                  if cell.sum() == 0 or cell[kind_idx] > 0:\n                      visited[nr, nc] = True\n                      prev[nr, nc] = (r, c)\n                      q.append((nr, nc))\n      return None\n\n  def follow_path(path):\n      \"\"\"Execute actions along `path`, updating the global `state`.\"\"\"\n      nonlocal state\n      for (r0, c0), (r1, c1) in zip(path, path[1:]):\n          dr, dc = r1 - r0, c1 - c0\n          act = DIR2ACT[(dr, dc)]\n          actions.append(act)\n          _, new_state = env.step(act)\n          state = new_state\n\n  # --------------------------------------------------------------\n  # 1. Collect all required primitives.\n  # --------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      for _ in range(needed_cnt):\n          path = bfs(state.pos, prim_idx)\n          if path is None:\n              # Primitive unreachable \u2013 abort early\n              return actions\n          follow_path(path)\n\n          # Pick up the primitive\n          actions.append(4)          # USE\n          _, new_state = env.step(4)\n          state = new_state\n\n  # --------------------------------------------------------------\n  # 2. Craft at the appropriate workshop (if any).\n  # --------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = recipe.get('_at')\n  if workshop_idx is not None:\n      path = bfs(state.pos, workshop_idx)\n      if path is not None:\n          follow_path(path)\n          actions.append(4)          # USE to craft\n          _, new_state = env.step(4)\n          state = new_state\n\n  return actions", "env_interactions": 0, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:08:53.590476", "function_name": "make_stick", "function_body": "", "env_interactions": 0, "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-10-21T21:09:21.026577", "function_name": "make_stick", "function_body": "  actions = []\n  env.reset()\n  state = env._current_state\n  world = env.world\n\n  stick_idx = world.cookbook.index[\"stick\"]\n  if state.inventory[stick_idx] > 0:\n      return actions\n\n  def move_action(cur, nxt):\n      \"\"\"Convert a step from cur \u2192 nxt into a DMLab action index.\"\"\"\n      dx = nxt[0] - cur[0]\n      dy = nxt[1] - cur[1]\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise ValueError(\"Invalid move\")\n\n  def bfs_to_adjacent(start, targets, grid):\n      \"\"\"\n      Bread\u2011first search for the shortest path from start to any empty cell\n      orthogonally adjacent to one of the target cells.\n      Returns a list of positions (including start and the final cell).\n      \"\"\"\n      W, H, _ = grid.shape\n      visited = np.zeros((W, H), dtype=bool)\n      q = collections.deque()\n      q.append((start, [start]))\n      visited[start] = True\n      target_set = {tuple(t) for t in targets}\n      while q:\n          pos, path = q.popleft()\n          # Check adjacency to any target cell\n          for tx, ty in target_set:\n              if abs(pos[0] - tx) + abs(pos[1] - ty) == 1:\n                  return path\n          # Expand neighbours (only through empty cells)\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if grid[nx, ny, :].sum() == 0:      # empty cell\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [(nx, ny)]))\n      raise RuntimeError(\"No reachable target\")\n\n  # ------------------------------------------------------------------\n  # 1) Collect required primitives for a stick.\n  # ------------------------------------------------------------------\n  primitive_reqs = world.cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n  cur_pos = tuple(state.pos)\n\n  for prim_idx, needed in primitive_reqs.items():\n      for _ in range(needed):\n          if state.inventory[prim_idx] > 0:\n              continue\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(\"Required primitive not present in world\")\n          path = bfs_to_adjacent(cur_pos, prim_cells, state.grid)\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n          actions.append(4)   # USE to pick up\n          # Update temporary copies so later planning sees the item removed\n          state.grid[cur_pos[0], cur_pos[1], prim_idx] = 0\n          state.inventory[prim_idx] += 1\n\n  # ------------------------------------------------------------------\n  # 2) Go to the appropriate workshop and craft the stick.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      raise RuntimeError(\"Stick recipe does not specify a workshop\")\n  workshop_idx = world.cookbook.index[workshop_name]\n\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      raise RuntimeError(\"Workshop for stick not found in the world\")\n  path = bfs_to_adjacent(cur_pos, workshop_cells, state.grid)\n  for step in path[1:]:\n      actions.append(move_action(cur_pos, step))\n      cur_pos = step\n\n  actions.append(4)   # USE to craft the stick\n\n  return actions", "env_interactions": 5, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-21T21:09:22.138721", "function_name": "make_stick", "function_body": "  actions = []\n  # reset environment to initial state\n  env.reset()\n  state = env._current_state\n  world = env.world\n\n  # target item index\n  stick_idx = world.cookbook.index[\"stick\"]\n  if state.inventory[stick_idx] > 0:\n      return actions\n\n  # --------------------------------------------------------------\n  # helper utilities\n  # --------------------------------------------------------------\n  import collections\n\n  def move_action(cur, nxt):\n      \"\"\"Convert a step (cur \u2192 nxt) into a DMLab action index.\"\"\"\n      dx = nxt[0] - cur[0]\n      dy = nxt[1] - cur[1]\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise ValueError(\"Invalid move step\")\n\n  def bfs_to_adjacent(start, targets, grid):\n      \"\"\"\n      Bread\u2011first search for the shortest path from `start` to any empty cell\n      that is orthogonally adjacent to one of the `targets` cells.\n      Returns a list of positions (including the start).\n      \"\"\"\n      W, H, _ = grid.shape\n      visited = np.zeros((W, H), dtype=bool)\n      q = collections.deque()\n      q.append((start, [start]))\n      visited[start] = True\n      target_set = {tuple(t) for t in targets}\n      while q:\n          pos, path = q.popleft()\n          # check adjacency to any target\n          for tx, ty in target_set:\n              if abs(pos[0] - tx) + abs(pos[1] - ty) == 1:\n                  return path\n          # expand neighbours (only through empty cells)\n          for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if grid[nx, ny, :].sum() == 0:      # empty\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [(nx, ny)]))\n      raise RuntimeError(\"No reachable target adjacent cell found\")\n\n  # --------------------------------------------------------------\n  # 1) Gather required primitives for a stick\n  # --------------------------------------------------------------\n  primitive_reqs = world.cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n  cur_pos = tuple(state.pos)\n\n  for prim_idx, needed in primitive_reqs.items():\n      for _ in range(needed):\n          # skip if already have this primitive\n          if state.inventory[prim_idx] > 0:\n              continue\n          # locate cells containing the primitive\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(\"Required primitive not present in the world\")\n          # plan path to an empty cell adjacent to a primitive cell\n          path = bfs_to_adjacent(cur_pos, prim_cells, state.grid)\n          # translate path steps into actions\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n          # pick up the primitive\n          actions.append(4)   # USE\n          # update temporary state to reflect the pickup\n          state.grid[cur_pos[0], cur_pos[1], prim_idx] = 0\n          state.inventory[prim_idx] += 1\n\n  # --------------------------------------------------------------\n  # 2) Move to the workshop and craft the stick\n  # --------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      raise RuntimeError(\"Stick recipe does not specify a workshop\")\n  workshop_idx = world.cookbook.index[workshop_name]\n\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      raise RuntimeError(\"Workshop for stick not found in the world\")\n  path = bfs_to_adjacent(cur_pos, workshop_cells, state.grid)\n  for step in path[1:]:\n      actions.append(move_action(cur_pos, step))\n      cur_pos = step\n\n  # craft the stick\n  actions.append(4)   # USE\n\n  return actions", "env_interactions": 5, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-21T21:09:35.880832", "function_name": "make_stick", "function_body": "  # Determine the action IDs used by the environment.\n  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      # Fallback to the default ordering (DOWN, UP, LEFT, RIGHT, USE).\n      action_ids = [0, 1, 2, 3, 4]\n\n  # Resolve the integer index that corresponds to the \"stick\" item.\n  try:\n      goal_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      # Alternate attribute paths if the above fails.\n      world = getattr(env, \"world\", None)\n      if world is not None:\n          cookbook = getattr(world, \"cookbook\", None)\n          if cookbook is not None:\n              goal_idx = cookbook.index.get(\"stick\")\n          else:\n              goal_idx = None\n      else:\n          goal_idx = None\n      if goal_idx is None:\n          return []  # Cannot locate the stick index; abort.\n\n  # Obtain the current CraftState from the environment.\n  start_state = getattr(env, \"_current_state\", None)\n  if start_state is None:\n      start_state = getattr(env, \"current_state\", None)\n      if start_state is None:\n          return []  # No accessible state; abort.\n\n  # Helper to produce a compact, hashable representation of a state.\n  def state_key(st):\n      return (st.pos, st.dir, st.inventory.tobytes())\n\n  # Bread\u2011first search over deterministic state transitions.\n  from collections import deque\n  frontier = deque()\n  frontier.append((start_state, []))\n  visited = {state_key(start_state)}\n  max_plan_len = 250  # safety limit to keep the search tractable.\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      # Goal test \u2013 inventory contains at least one stick.\n      if cur_state.satisfies(\"\", goal_idx):\n          return cur_plan\n\n      # Prune overly long plans.\n      if len(cur_plan) >= max_plan_len:\n          continue\n\n      # Expand all possible actions.\n      for a in action_ids:\n          _, nxt_state = cur_state.step(a)\n          key = state_key(nxt_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((nxt_state, cur_plan + [a]))\n\n  # No feasible plan found within the limits.\n  return []", "env_interactions": 4, "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T21:09:36.987236", "function_name": "make_stick", "function_body": "  # ----------------------------------------------------------------------\n  # Gather action IDs from the environment (order may vary)\n  # ----------------------------------------------------------------------\n  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:  # pragma: no cover\n      # Default ordering used by CraftWorld: DOWN, UP, LEFT, RIGHT, USE\n      action_ids = [0, 1, 2, 3, 4]\n\n  # ----------------------------------------------------------------------\n  # Resolve the integer index of the goal item \"stick\"\n  # ----------------------------------------------------------------------\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      # Try alternative attribute paths if the above fails\n      world = getattr(env, \"world\", None)\n      if world is not None:\n          stick_idx = getattr(world, \"cookbook\", None)\n          if stick_idx is not None:\n              stick_idx = stick_idx.index.get(\"stick\")\n      else:\n          stick_idx = None\n  if stick_idx is None:\n      return []  # cannot locate the stick index\n\n  # ----------------------------------------------------------------------\n  # Helper to test if a state already satisfies the goal\n  # ----------------------------------------------------------------------\n  def goal_reached(state):\n      return state.satisfies(\"\", stick_idx)\n\n  # ----------------------------------------------------------------------\n  # Obtain the current CraftState from the environment\n  # ----------------------------------------------------------------------\n  try:\n      start_state = env._current_state\n  except AttributeError:  # pragma: no cover\n      start_state = getattr(env, \"current_state\", None)\n      if start_state is None:\n          return []  # cannot access underlying state\n\n  # ----------------------------------------------------------------------\n  # Bread\u2011first search planner over deterministic state transitions\n  # ----------------------------------------------------------------------\n  from collections import deque\n\n  def state_key(st):\n      \"\"\"Compact, hashable representation of a CraftState.\"\"\"\n      return (st.pos, st.dir, st.inventory.tobytes())\n\n  frontier = deque()\n  frontier.append((start_state, []))\n  visited = {state_key(start_state)}\n  MAX_PLAN_LEN = 250  # safety ceiling\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      # Goal test\n      if goal_reached(cur_state):\n          return cur_plan\n\n      # Prune overly long plans\n      if len(cur_plan) >= MAX_PLAN_LEN:\n          continue\n\n      # Expand all possible actions\n      for a in action_ids:\n          _, nxt_state = cur_state.step(a)\n          key = state_key(nxt_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((nxt_state, cur_plan + [a]))\n\n  # No plan found within limits\n  return []", "env_interactions": 4, "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T21:10:00.153012", "function_name": "make_stick", "function_body": "  # ----- helper functions -------------------------------------------------\n  def bfs(start, targets, blocked):\n      \"\"\"Return list of actions (direction ints) to reach any target cell.\n      start, targets: (x, y) tuples.\n      blocked: 2\u2011D bool array where True means cell cannot be entered.\n      \"\"\"\n      from collections import deque\n\n      H, W = blocked.shape\n      dirs = [(0, 1), (0, -1), (-1, 0), (1, 0)]        # (dx, dy) for DOWN,UP,LEFT,RIGHT\n      # mapping from (dx,dy) to action index according to env.action_specs()\n      dir_to_action = {\n          (0, 1): action_map[\"DOWN\"],\n          (0, -1): action_map[\"UP\"],\n          (-1, 0): action_map[\"LEFT\"],\n          (1, 0): action_map[\"RIGHT\"],\n      }\n\n      q = deque()\n      q.append((start, []))\n      visited = set()\n      visited.add(start)\n\n      target_set = set(targets)\n\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in target_set:\n              return path\n          for dx, dy in dirs:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < H and 0 <= ny < W and not blocked[nx, ny] and (nx, ny) not in visited:\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [dir_to_action[(dx, dy)]]))\n      return []  # no path found\n\n  # ----- initialise -------------------------------------------------------\n  # reset environment to get a fresh state\n  env.reset()\n  state = env._current_state\n\n  # map action names to indices\n  action_map = env.action_specs()\n  use_action = action_map[\"USE\"]\n\n  # goal information\n  goal_name = \"stick\"\n  goal_idx = env.world.cookbook.index[goal_name]\n\n  # primitive requirements for the goal\n  prim_req = env.world.cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n  # workshop (if any) needed for crafting\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\", None)\n  workshop_idx = env.world.cookbook.index[workshop_name] if workshop_name else None\n\n  actions = []\n\n  # ----- collect each required primitive ----------------------------------\n  for prim_idx, needed_cnt in prim_req.items():\n      while state.inventory[prim_idx] < needed_cnt:\n          # locate all cells that currently contain the needed primitive\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # nothing left on the map \u2013 break to avoid infinite loop\n              break\n\n          # choose the first occurrence (could be improved with nearest search)\n          target_cell = tuple(prim_cells[0])  # (x, y)\n\n          # compute blocked cells (non\u2011grabbable entities)\n          # a cell is blocked if any non\u2011grabbable kind is present there\n          non_grabbable = list(env.world.non_grabbable_indices)\n          blocked_mask = np.any(state.grid[:, :, non_grabbable] > 0, axis=2)\n\n          # we need to get *adjacent* (including diagonal) to the primitive.\n          # generate all cells that are within a 3\u00d73 neighbourhood of the target.\n          adj_cells = []\n          H, W = blocked_mask.shape\n          tx, ty = target_cell\n          for dx in (-1, 0, 1):\n              for dy in (-1, 0, 1):\n                  nx, ny = tx + dx, ty + dy\n                  if 0 <= nx < H and 0 <= ny < W and not blocked_mask[nx, ny]:\n                      adj_cells.append((nx, ny))\n\n          # plan path from current position to any admissible adjacent cell\n          path = bfs(state.pos, adj_cells, blocked_mask)\n          for a in path:\n              reward, new_state = env.step(a)\n              actions.append(a)\n              state = new_state\n\n          # now we should be adjacent \u2013 use the primitive\n          reward, new_state = env.step(use_action)\n          actions.append(use_action)\n          state = new_state\n\n  # ----- move to workshop and craft (if a workshop is required) ----------\n  if workshop_idx is not None:\n      # locate a workshop cell\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          wcell = tuple(workshop_cells[0])\n\n          # recompute blocked mask (workshops are not blocked)\n          non_grabbable = list(env.world.non_grabbable_indices)\n          blocked_mask = np.any(state.grid[:, :, non_grabbable] > 0, axis=2)\n\n          # admissible adjacent cells around the workshop\n          adj_cells = []\n          H, W = blocked_mask.shape\n          wx, wy = wcell\n          for dx in (-1, 0, 1):\n              for dy in (-1, 0, 1):\n                  nx, ny = wx + dx, wy + dy\n                  if 0 <= nx < H and 0 <= ny < W and not blocked_mask[nx, ny]:\n                      adj_cells.append((nx, ny))\n\n          path = bfs(state.pos, adj_cells, blocked_mask)\n          for a in path:\n              reward, new_state = env.step(a)\n              actions.append(a)\n              state = new_state\n\n          # craft at the workshop\n          reward, new_state = env.step(use_action)\n          actions.append(use_action)\n          state = new_state\n\n  # return the complete action list\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-10-21T21:10:01.401459", "function_name": "make_stick", "function_body": "  # Simple random\u2011policy planner: keep taking random actions until a stick appears\n  # in the agent's inventory (or until a safety limit is reached).\n  actions = []\n  # Upper bound on number of steps to avoid infinite loops.\n  MAX_STEPS = 2000\n\n  # Resolve the integer index that corresponds to the \"stick\" item.\n  # The index object maps names to integer IDs via the .index() method.\n  try:\n      stick_idx = env.world.cookbook.index.index(\"stick\")\n  except Exception:\n      # Fallback: try to obtain the world from the scenario if the wrapper differs.\n      stick_idx = env.scenario.world.cookbook.index.index(\"stick\")\n\n  # Helper to read the current inventory from the underlying CraftState.\n  def _inventory():\n      try:\n          return env._current_state.inventory\n      except AttributeError:\n          # In some wrappers the state may be stored under a different name.\n          return env.current_state.inventory\n\n  # Main loop: act randomly until we have at least one stick.\n  for _ in range(MAX_STEPS):\n      if _inventory()[stick_idx] > 0:\n          break\n      # Choose a random valid action.\n      try:\n          # CraftWorld stores the number of possible actions.\n          n_actions = env.world.n_actions\n      except Exception:\n          n_actions = env.scenario.world.n_actions\n      action = np.random.randint(n_actions)\n      actions.append(action)\n      # Apply the action to the environment.\n      # Most environments follow the Gym API: step returns (obs, reward, done, info).\n      # We ignore the returned values because we only need the side\u2011effects.\n      env.step(action)\n\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-10-21T21:10:36.176165", "function_name": "make_stick", "function_body": "  # reset env and get references\n  env.reset()\n  world = env.world\n  scenario = env.scenario\n  # copy mutable grid\n  grid = scenario.init_grid.copy()\n  goal_idx = env.task.goal\n  # map action names to indices\n  action_map = env.action_specs()\n  # primitives needed dict\n  primitives_needed = world.cookbook.primitives_for(goal_idx)\n\n  # agent position mutable list\n  pos = list(scenario.init_pos)\n  actions = []\n\n  # BFS shortest path\n  from collections import deque\n  def _shortest_path(src, tgt):\n      src_t = tuple(src)\n      tgt_t = tuple(tgt)\n      if src_t == tgt_t:\n          return []\n      visited = {src_t}\n      q = deque()\n      q.append((src_t, []))\n      # moves: (dx, dy, action_name)\n      move_defs = [\n          (0, 1, \"DOWN\"),\n          (0, -1, \"UP\"),\n          (-1, 0, \"LEFT\"),\n          (1, 0, \"RIGHT\")\n      ]\n      while q:\n          (x, y), path = q.popleft()\n          for dx, dy, act_name in move_defs:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]):\n                  continue\n              npos = (nx, ny)\n              if npos in visited:\n                  continue\n              # allow stepping onto target even if occupied\n              if npos != tgt_t and grid[nx, ny, :].any():\n                  continue\n              new_path = path + [action_map[act_name]]\n              if npos == tgt_t:\n                  return new_path\n              visited.add(npos)\n              q.append((npos, new_path))\n      # fallback Manhattan\n      fallback = []\n      cx, cy = src_t\n      tx, ty = tgt_t\n      while cx < tx:\n          fallback.append(action_map[\"RIGHT\"]); cx += 1\n      while cx > tx:\n          fallback.append(action_map[\"LEFT\"]); cx -= 1\n      while cy < ty:\n          fallback.append(action_map[\"DOWN\"]); cy += 1\n      while cy > ty:\n          fallback.append(action_map[\"UP\"]); cy -= 1\n      return fallback\n\n  def _move_to(target):\n      nonlocal pos, actions\n      steps = _shortest_path(pos, target)\n      actions.extend(steps)\n      pos[0], pos[1] = target[0], target[1]\n\n  # collect primitives\n  for kind_idx, needed_cnt in primitives_needed.items():\n      for _ in range(needed_cnt):\n          # locate remaining cells with this primitive\n          locations = np.argwhere(grid[:, :, kind_idx] == 1)\n          if locations.shape[0] == 0:\n              # no more; break\n              break\n          # choose nearest by Manhattan distance\n          dists = np.abs(locations - pos).sum(axis=1)\n          nearest_idx = int(np.argmin(dists))\n          target_cell = locations[nearest_idx].tolist()\n          _move_to(target_cell)\n          # pick up\n          actions.append(action_map[\"USE\"])\n          # update grid copy\n          grid[target_cell[0], target_cell[1], kind_idx] = 0\n\n  # go to workshop and craft if needed\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get('_at')\n  if workshop_kind is not None:\n      workshop_cells = np.argwhere(grid[:, :, workshop_kind] == 1)\n      if workshop_cells.shape[0] > 0:\n          dists = np.abs(workshop_cells - pos).sum(axis=1)\n          nearest_ws = int(np.argmin(dists))\n          ws_target = workshop_cells[nearest_ws].tolist()\n          _move_to(ws_target)\n          actions.append(action_map[\"USE\"])\n\n  return actions", "env_interactions": 0, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:10:37.296219", "function_name": "make_stick", "function_body": "  # Reset the environment to a clean start\n  env.reset()\n  world = env.world\n  scenario = env.scenario\n\n  # Mutable copy of the initial grid and agent position\n  grid = scenario.init_grid.copy()\n  pos = list(scenario.init_pos)          # [x, y]\n  actions = []\n\n  # Goal information\n  goal_idx = env.task.goal\n  needed_primitives = world.cookbook.primitives_for(goal_idx)\n\n  # ------------------------------------------------------------------\n  # Helper: shortest path (BFS) that avoids any occupied cell except the\n  # target cell itself. Returns a list of action indices.\n  # ------------------------------------------------------------------\n  def _shortest_path(src, tgt):\n      src_t = tuple(src)\n      tgt_t = tuple(tgt)\n      if src_t == tgt_t:\n          return []\n\n      from collections import deque\n      q = deque()\n      q.append((src_t, []))\n      visited = {src_t}\n\n      # (dx, dy, action) \u2013 action indices follow the environment ordering:\n      # 0=DOWN, 1=UP, 2=LEFT, 3=RIGHT, 4=USE\n      moves = [(1, 0, 3),   # RIGHT\n               (-1, 0, 2),  # LEFT\n               (0, 1, 0),   # DOWN\n               (0, -1, 1)]  # UP\n\n      w, h = grid.shape[0], grid.shape[1]\n\n      while q:\n          (x, y), path = q.popleft()\n          for dx, dy, act in moves:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < w and 0 <= ny < h):\n                  continue\n              npos = (nx, ny)\n              if npos in visited:\n                  continue\n\n              # Allow stepping onto the target even if occupied;\n              # otherwise the cell must be empty.\n              if npos != tgt_t and grid[nx, ny, :].any():\n                  continue\n\n              if npos == tgt_t:\n                  return path + [act]\n\n              visited.add(npos)\n              q.append((npos, path + [act]))\n\n      # Fallback: simple Manhattan walk (should rarely be used)\n      fallback = []\n      cx, cy = src_t\n      tx, ty = tgt_t\n      while cx < tx:\n          fallback.append(3); cx += 1\n      while cx > tx:\n          fallback.append(2); cx -= 1\n      while cy < ty:\n          fallback.append(0); cy += 1\n      while cy > ty:\n          fallback.append(1); cy -= 1\n      return fallback\n\n  # ------------------------------------------------------------------\n  # Helper: move the agent to a target cell using the shortest path.\n  # ------------------------------------------------------------------\n  def _move_to(target):\n      nonlocal pos, actions\n      steps = _shortest_path(pos, target)\n      actions.extend(steps)\n      pos[0], pos[1] = target[0], target[1]\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitive resources.\n  # ------------------------------------------------------------------\n  for kind_idx, count in needed_primitives.items():\n      for _ in range(count):\n          # Find all remaining cells containing this primitive.\n          locations = np.argwhere(grid[:, :, kind_idx] == 1)\n          if locations.shape[0] == 0:\n              # No more instances; break out (cannot craft).\n              break\n\n          # Choose the nearest instance (Manhattan distance).\n          dists = np.abs(locations - np.array(pos)).sum(axis=1)\n          nearest = int(np.argmin(dists))\n          target_cell = locations[nearest].tolist()\n\n          # Travel to the primitive and pick it up.\n          _move_to(target_cell)\n          actions.append(4)                     # USE action to collect\n\n          # Update internal grid copy so we don't revisit the same cell.\n          grid[target_cell[0], target_cell[1], kind_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 2) If the recipe specifies a workshop, travel there and craft.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get('_at')\n  if workshop_kind is not None:\n      workshop_cells = np.argwhere(grid[:, :, workshop_kind] == 1)\n      if workshop_cells.shape[0] > 0:\n          dists = np.abs(workshop_cells - np.array(pos)).sum(axis=1)\n          nearest_ws = int(np.argmin(dists))\n          ws_target = workshop_cells[nearest_ws].tolist()\n          _move_to(ws_target)\n          actions.append(4)                     # USE action to craft\n\n  # Return the planned sequence of actions.\n  return actions", "env_interactions": 0, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:11:00.362033", "function_name": "make_stick", "function_body": "  ACTION = env.action_specs()\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def get_action(dx, dy):\n      \"\"\"Map a step delta to an action index.\"\"\"\n      if dx == 1:\n          return ACTION[\"RIGHT\"]\n      if dx == -1:\n          return ACTION[\"LEFT\"]\n      if dy == 1:\n          return ACTION[\"DOWN\"]\n      if dy == -1:\n          return ACTION[\"UP\"]\n      raise ValueError(\"Invalid delta for action\")\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of (x, y) positions from start (exclusive) to goal (inclusive).\"\"\"\n      width, height = state.grid.shape[0], state.grid.shape[1]\n      q = deque([start])\n      visited = {start: None}\n      while q:\n          x, y = q.popleft()\n          if (x, y) == goal:\n              break\n          for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n                  # Allow stepping onto the goal even if it contains something\n                  if (nx, ny) != goal:\n                      # cell must be empty (no entities)\n                      if state.grid[nx, ny].sum() != 0:\n                          continue\n                  visited[(nx, ny)] = (x, y)\n                  q.append((nx, ny))\n      # Reconstruct path\n      if goal not in visited:\n          return []  # unreachable\n      path = []\n      cur = goal\n      while visited[cur] is not None:\n          path.append(cur)\n          cur = visited[cur]\n      path.reverse()\n      return path\n\n  def moves_to(cur, target):\n      \"\"\"Convert a path of positions into a list of movement actions.\"\"\"\n      actions = []\n      x, y = cur\n      for nx, ny in bfs_path((x, y), target):\n          dx, dy = nx - x, ny - y\n          actions.append(get_action(dx, dy))\n          x, y = nx, ny\n      return actions\n\n  def find_nearest_kind(start_pos, kind):\n      \"\"\"Find the closest reachable cell containing the specified kind.\"\"\"\n      layer = state.grid[:, :, kind]\n      ys, xs = np.where(layer > 0)\n      if len(xs) == 0:\n          return None\n      # Compute Manhattan distance as heuristic\n      dists = np.abs(xs - start_pos[0]) + np.abs(ys - start_pos[1])\n      order = np.argsort(dists)\n      for i in order:\n          candidate = (int(xs[i]), int(ys[i]))\n          if bfs_path(start_pos, candidate):\n              return candidate\n      return None\n\n  # ------------------------------------------------------------------\n  # Determine primitives required for a stick\n  # ------------------------------------------------------------------\n  stick_idx = idx[\"stick\"]\n  needed = world.cookbook.primitives_for(stick_idx)  # {primitive_idx: count}\n  plan = []\n  cur_pos = state.pos\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = find_nearest_kind(cur_pos, prim_idx)\n          if target is None:\n              # Primitive not reachable \u2013 skip (should not happen)\n              continue\n          plan.extend(moves_to(cur_pos, target))\n          plan.append(ACTION[\"USE\"])  # pick up the primitive\n          cur_pos = target\n\n  # ------------------------------------------------------------------\n  # Move to the appropriate workshop (if any) and craft the stick\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      wk_idx = idx[workshop_name] if isinstance(workshop_name, str) else workshop_name\n      wk_pos = find_nearest_kind(cur_pos, wk_idx)\n      if wk_pos is not None:\n          plan.extend(moves_to(cur_pos, wk_pos))\n          cur_pos = wk_pos\n\n  # Final USE to perform the crafting action\n  plan.append(ACTION[\"USE\"])\n\n  return plan", "env_interactions": 0, "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-10-21T21:11:01.485248", "function_name": "make_stick", "function_body": "  ACTION = env.action_specs()\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def find_nearest(start_pos, kind):\n      \"\"\"Return the coordinates (x, y) of the nearest cell containing `kind`.\"\"\"\n      layer = state.grid[:, :, kind]\n      ys, xs = np.where(layer > 0)\n      if len(xs) == 0:\n          return None\n      dists = np.abs(xs - start_pos[0]) + np.abs(ys - start_pos[1])\n      i = int(np.argmin(dists))\n      return (int(xs[i]), int(ys[i]))\n\n  def moves_to(cur, target):\n      \"\"\"Generate a list of movement actions (Manhattan) from cur \u2192 target.\"\"\"\n      seq = []\n      x, y = cur\n      tx, ty = target\n      while x != tx:\n          if tx > x:\n              seq.append(ACTION[\"RIGHT\"])\n              x += 1\n          else:\n              seq.append(ACTION[\"LEFT\"])\n              x -= 1\n      while y != ty:\n          if ty > y:\n              seq.append(ACTION[\"DOWN\"])\n              y += 1\n          else:\n              seq.append(ACTION[\"UP\"])\n              y -= 1\n      return seq\n\n  # ------------------------------------------------------------------\n  # Determine primitives required for a stick\n  # ------------------------------------------------------------------\n  stick_idx = idx[\"stick\"]\n  needed = world.cookbook.primitives_for(stick_idx)  # {primitive_idx: count}\n  plan = []\n  cur_pos = state.pos\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = find_nearest(cur_pos, prim_idx)\n          if target is None:\n              # Primitive not found \u2013 skip (should not happen in valid scenarios)\n              continue\n          plan.extend(moves_to(cur_pos, target))\n          plan.append(ACTION[\"USE\"])          # pick up the primitive\n          cur_pos = target\n\n  # ------------------------------------------------------------------\n  # Move to the appropriate workshop (if any) and craft the stick\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      wk_idx = idx[workshop_name] if isinstance(workshop_name, str) else workshop_name\n      wk_pos = find_nearest(cur_pos, wk_idx)\n      if wk_pos is not None:\n          plan.extend(moves_to(cur_pos, wk_pos))\n          cur_pos = wk_pos\n\n  # Final USE to perform the crafting action\n  plan.append(ACTION[\"USE\"])\n\n  return plan", "env_interactions": 4, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:11:31.825689", "function_name": "make_stick", "function_body": "  env.reset()\n  world = env.world\n  idx = world.cookbook.index\n  stick_idx = idx[\"stick\"]\n  needed = world.cookbook.primitives_for(stick_idx)\n  if not needed:\n      needed = {stick_idx: 1}\n\n  act_map = env.action_specs()\n  DOWN = act_map[\"DOWN\"]\n  UP = act_map[\"UP\"]\n  LEFT = act_map[\"LEFT\"]\n  RIGHT = act_map[\"RIGHT\"]\n  USE = act_map[\"USE\"]\n\n  state = env._current_state\n  cur_pos = tuple(state.pos)\n  grid = state.grid.copy()\n\n  # cells occupied by non\u2011grabbable entities are considered blocked\n  non_grabbable = list(world.non_grabbable_indices)\n  if non_grabbable:\n      blocked = np.any(grid[:, :, non_grabbable] > 0, axis=2)\n  else:\n      blocked = np.zeros(grid.shape[:2], dtype=bool)\n\n  from collections import deque\n\n  def manhattan_moves(start, goal):\n      x, y = start\n      gx, gy = goal\n      moves = []\n      while x < gx:\n          moves.append(RIGHT); x += 1\n      while x > gx:\n          moves.append(LEFT); x -= 1\n      while y < gy:\n          moves.append(DOWN); y += 1\n      while y > gy:\n          moves.append(UP); y -= 1\n      return moves\n\n  def bfs(start, goals):\n      \"\"\"Shortest path (as action list) from start to any cell in goals.\"\"\"\n      if start in goals:\n          return []\n      q = deque([start])\n      parent = {start: (None, None)}\n      while q:\n          x, y = q.popleft()\n          for a, (dx, dy) in ((DOWN, (0, 1)),\n                              (UP, (0, -1)),\n                              (LEFT, (-1, 0)),\n                              (RIGHT, (1, 0))):\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < blocked.shape[0] and 0 <= ny < blocked.shape[1]):\n                  continue\n              if blocked[nx, ny]:\n                  continue\n              nxt = (nx, ny)\n              if nxt in parent:\n                  continue\n              parent[nxt] = ((x, y), a)\n              if nxt in goals:\n                  # reconstruct actions\n                  actions = []\n                  node = nxt\n                  while parent[node][0] is not None:\n                      node, act = parent[node]\n                      actions.append(act)\n                  actions.reverse()\n                  return actions\n              q.append(nxt)\n      # fallback to Manhattan if BFS fails\n      gx, gy = next(iter(goals))\n      return manhattan_moves(start, (gx, gy))\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # 1) Gather all required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      remaining = int(cnt)\n      while remaining > 0:\n          locations = np.argwhere(grid[:, :, prim_idx] > 0)\n          if locations.size == 0:\n              # no more of this primitive on the map \u2013 break to avoid infinite loop\n              break\n          targets = {tuple(p) for p in locations.tolist()}\n          path = bfs(cur_pos, targets)\n          actions.extend(path)\n\n          # update current position according to the path taken\n          for a in path:\n              if a == DOWN:\n                  cur_pos = (cur_pos[0], cur_pos[1] + 1)\n              elif a == UP:\n                  cur_pos = (cur_pos[0], cur_pos[1] - 1)\n              elif a == LEFT:\n                  cur_pos = (cur_pos[0] - 1, cur_pos[1])\n              elif a == RIGHT:\n                  cur_pos = (cur_pos[0] + 1, cur_pos[1])\n\n          # pick up the primitive\n          actions.append(USE)\n          grid[cur_pos[0], cur_pos[1], prim_idx] = max(\n              0, grid[cur_pos[0], cur_pos[1], prim_idx] - 1\n          )\n          remaining -= 1\n\n  # ------------------------------------------------------------------\n  # 2) Move to the workshop (if the recipe requires one) and craft\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      ws_idx = idx[workshop_name]\n      ws_locs = np.argwhere(grid[:, :, ws_idx] > 0)\n      if ws_locs.size:\n          ws_target = tuple(ws_locs[0])\n          path = bfs(cur_pos, {ws_target})\n          actions.extend(path)\n          for a in path:\n              if a == DOWN:\n                  cur_pos = (cur_pos[0], cur_pos[1] + 1)\n              elif a == UP:\n                  cur_pos = (cur_pos[0], cur_pos[1] - 1)\n              elif a == LEFT:\n                  cur_pos = (cur_pos[0] - 1, cur_pos[1])\n              elif a == RIGHT:\n                  cur_pos = (cur_pos[0] + 1, cur_pos[1])\n          actions.append(USE)\n\n  return actions", "env_interactions": 4, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:11:32.937970", "function_name": "make_stick", "function_body": "  # reset environment and fetch world information\n  env.reset()\n  world = env.world\n  idx = world.cookbook.index\n\n  # action indices\n  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act[\"DOWN\"], act[\"UP\"], act[\"LEFT\"], act[\"RIGHT\"], act[\"USE\"]\n  )\n\n  # target item and its recipe\n  stick_idx = idx[\"stick\"]\n  needed = world.cookbook.primitives_for(stick_idx)\n  if not needed:\n      # stick itself is a primitive to be collected\n      needed = {stick_idx: 1}\n\n  # current state snapshot\n  state = env._current_state\n  cur_pos = tuple(state.pos)          # (x, y)\n  grid = state.grid.copy()            # keep local copy to track removals\n\n  # cells that are blocked (non\u2011grabbable entities)\n  non_grabbable = list(world.non_grabbable_indices)\n  if non_grabbable:\n      blocked = np.any(grid[:, :, non_grabbable] > 0, axis=2)\n  else:\n      blocked = np.zeros(grid.shape[:2], dtype=bool)\n\n  from collections import deque\n\n  # BFS returning list of actions to reach any cell in goal_set\n  def bfs(start, goal_set):\n      if start in goal_set:\n          return []\n      q = deque([start])\n      parent = {start: (None, None)}  # node -> (prev_node, action_used)\n      while q:\n          x, y = q.popleft()\n          for a, (dx, dy) in (\n              (DOWN, (0, 1)),\n              (UP, (0, -1)),\n              (LEFT, (-1, 0)),\n              (RIGHT, (1, 0)),\n          ):\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < blocked.shape[0] and 0 <= ny < blocked.shape[1]):\n                  continue\n              if blocked[nx, ny]:\n                  continue\n              nxt = (nx, ny)\n              if nxt in parent:\n                  continue\n              parent[nxt] = ((x, y), a)\n              if nxt in goal_set:\n                  # reconstruct path\n                  actions_rev = []\n                  node = nxt\n                  while parent[node][0] is not None:\n                      node, act_used = parent[node]\n                      actions_rev.append(act_used)\n                  actions_rev.reverse()\n                  return actions_rev\n              q.append(nxt)\n      # fallback: straight Manhattan moves (should rarely be used)\n      tx, ty = next(iter(goal_set))\n      moves = []\n      x, y = start\n      while x < tx:\n          moves.append(RIGHT); x += 1\n      while x > tx:\n          moves.append(LEFT);  x -= 1\n      while y < ty:\n          moves.append(DOWN);  y += 1\n      while y > ty:\n          moves.append(UP);    y -= 1\n      return moves\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      remaining = int(cnt)\n      while remaining > 0:\n          # locate all cells that still contain this primitive\n          locs = np.argwhere(grid[:, :, prim_idx] > 0)\n          if locs.size == 0:\n              # no more of this primitive on the map \u2013 break to avoid infinite loop\n              break\n          targets = {tuple(p) for p in locs.tolist()}\n          path = bfs(cur_pos, targets)\n          actions.extend(path)\n\n          # update current position according to the path taken\n          for a in path:\n              if a == DOWN:\n                  cur_pos = (cur_pos[0], cur_pos[1] + 1)\n              elif a == UP:\n                  cur_pos = (cur_pos[0], cur_pos[1] - 1)\n              elif a == LEFT:\n                  cur_pos = (cur_pos[0] - 1, cur_pos[1])\n              elif a == RIGHT:\n                  cur_pos = (cur_pos[0] + 1, cur_pos[1])\n\n          # pick up the primitive\n          actions.append(USE)\n          grid[cur_pos[0], cur_pos[1], prim_idx] = max(\n              0, grid[cur_pos[0], cur_pos[1], prim_idx] - 1\n          )\n          remaining -= 1\n\n  # ------------------------------------------------------------------\n  # 2) Go to the appropriate workshop (if the recipe requires one) and craft\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      ws_idx = idx[workshop_name]\n      ws_locs = np.argwhere(grid[:, :, ws_idx] > 0)\n      if ws_locs.size:\n          ws_target = tuple(ws_locs[0])\n          path = bfs(cur_pos, {ws_target})\n          actions.extend(path)\n\n          # update position after moving to workshop\n          for a in path:\n              if a == DOWN:\n                  cur_pos = (cur_pos[0], cur_pos[1] + 1)\n              elif a == UP:\n                  cur_pos = (cur_pos[0], cur_pos[1] - 1)\n              elif a == LEFT:\n                  cur_pos = (cur_pos[0] - 1, cur_pos[1])\n              elif a == RIGHT:\n                  cur_pos = (cur_pos[0] + 1, cur_pos[1])\n\n          # craft the stick\n          actions.append(USE)\n\n  return actions", "env_interactions": 4, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:12:15.983396", "function_name": "make_stick", "function_body": "  env.reset()\n  world = env.world\n  scenario = env.scenario\n  grid = scenario.init_grid.copy()\n  pos = list(scenario.init_pos)\n  action_map = env.action_specs()\n  actions = []\n\n  def _move_to(target):\n      nonlocal pos, actions\n      # Move horizontally (x direction)\n      while pos[0] < target[0]:\n          actions.append(action_map[\"RIGHT\"])\n          pos[0] += 1\n      while pos[0] > target[0]:\n          actions.append(action_map[\"LEFT\"])\n          pos[0] -= 1\n      # Move vertically (y direction)\n      while pos[1] < target[1]:\n          actions.append(action_map[\"DOWN\"])\n          pos[1] += 1\n      while pos[1] > target[1]:\n          actions.append(action_map[\"UP\"])\n          pos[1] -= 1\n\n  # 1. Collect required primitives for the goal item\n  goal_idx = env.task.goal\n  primitive_needs = world.cookbook.primitives_for(goal_idx)\n  for kind_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          locations = np.argwhere(grid[:, :, kind_idx] > 0)\n          if locations.shape[0] == 0:\n              # No more of this primitive on the map\n              break\n          # Choose the nearest instance (Manhattan distance)\n          dists = np.abs(locations - pos).sum(axis=1)\n          nearest = int(np.argmin(dists))\n          target_cell = locations[nearest].tolist()\n          _move_to(target_cell)\n          actions.append(action_map[\"USE\"])\n          # Remove the primitive from our simulated grid\n          grid[target_cell[0], target_cell[1], kind_idx] = 0\n\n  # 2. Go to the appropriate workshop (if any) and craft the goal item\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      workshop_cells = np.argwhere(grid[:, :, workshop_kind] > 0)\n      if workshop_cells.shape[0] > 0:\n          dists = np.abs(workshop_cells - pos).sum(axis=1)\n          nearest_ws = int(np.argmin(dists))\n          ws_target = workshop_cells[nearest_ws].tolist()\n          _move_to(ws_target)\n          actions.append(action_map[\"USE\"])\n\n  return actions", "env_interactions": 0, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:12:17.107461", "function_name": "make_stick", "function_body": "  state = env._current_state\n  world = env.world\n  goal_idx = env.task.goal\n  action_map = env.action_specs()\n\n  # Mapping from direction vectors to action names\n  dir_to_action = {\n      (0, 1): \"DOWN\",\n      (0, -1): \"UP\",\n      (-1, 0): \"LEFT\",\n      (1, 0): \"RIGHT\",\n  }\n\n  # Work on a copy of the grid and keep track of the agent's position\n  grid = state.grid.copy()\n  pos = state.pos\n  actions = []\n\n  def bfs(start, target):\n      \"\"\"Return a list of positions from start to target (inclusive) using BFS.\"\"\"\n      from collections import deque\n\n      width, height = grid.shape[0], grid.shape[1]\n      visited = set()\n      prev = {}\n      q = deque([start])\n      visited.add(start)\n\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              # reconstruct path\n              path = []\n              while cur != start:\n                  path.append(cur)\n                  cur = prev[cur]\n              path.append(start)\n              path.reverse()\n              return path\n\n          x, y = cur\n          for dx, dy in [(0, 1), (0, -1), (-1, 0), (1, 0)]:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n\n              # Determine if the cell is traversable\n              blocked = False\n              for kind in world.non_grabbable_indices:\n                  if grid[nx, ny, kind] > 0:\n                      blocked = True\n                      break\n              # Allow stepping onto the target cell even if it contains a primitive we intend to pick up\n              if blocked and (nx, ny) != target:\n                  continue\n\n              nxt = (nx, ny)\n              if nxt not in visited:\n                  visited.add(nxt)\n                  prev[nxt] = cur\n                  q.append(nxt)\n      return None\n\n  def add_path(path):\n      \"\"\"Convert a position path to actions and update the current position.\"\"\"\n      nonlocal pos\n      for a, b in zip(path, path[1:]):\n          dx = b[0] - a[0]\n          dy = b[1] - a[1]\n          act_name = dir_to_action[(dx, dy)]\n          actions.append(action_map[act_name])\n      pos = path[-1]\n\n  # ------------------------------------------------------------------\n  # 1. Collect all primitive resources required for the goal item\n  # ------------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  for prim_kind, needed_cnt in primitive_needs.items():\n      collected = 0\n      while collected < needed_cnt:\n          prim_positions = list(zip(*np.where(grid[:, :, prim_kind] > 0)))\n          if not prim_positions:\n              # No more primitives of this kind available\n              break\n\n          # Choose the nearest primitive (Manhattan distance)\n          dists = [abs(px - pos[0]) + abs(py - pos[1]) for (px, py) in prim_positions]\n          target = prim_positions[int(np.argmin(dists))]\n\n          path = bfs(pos, target)\n          if path is None:\n              # Cannot reach this primitive; abort collecting further of this kind\n              break\n\n          add_path(path)\n\n          # Pick up the primitive\n          actions.append(action_map[\"USE\"])\n          # Update the simulated grid (primitive disappears after being taken)\n          grid[pos[0], pos[1], prim_kind] = 0\n          collected += 1\n\n  # ------------------------------------------------------------------\n  # 2. Move to the appropriate workshop (if any) and craft the goal\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      workshop_positions = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n      if workshop_positions:\n          dists = [abs(px - pos[0]) + abs(py - pos[1]) for (px, py) in workshop_positions]\n          target_ws = workshop_positions[int(np.argmin(dists))]\n          path = bfs(pos, target_ws)\n          if path is not None:\n              add_path(path)\n              actions.append(action_map[\"USE\"])\n\n  return actions", "env_interactions": 0, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:12:30.253677", "function_name": "make_stick", "function_body": "  # Determine the action IDs (fallback to common ordering if needed)\n  try:\n      actions = list(env.action_specs().values())\n  except Exception:\n      actions = [0, 1, 2, 3, 4]  # DOWN, UP, LEFT, RIGHT, USE\n\n  # Resolve the integer index for the target item \"stick\"\n  try:\n      goal_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      goal_idx = env.world.cookbook.index.get(\"stick\")\n\n  # Obtain the current state (use the lab's internal state if available)\n  start_state = getattr(env, \"_current_state\", None)\n  if start_state is None:\n      start_state = env.scenario.init()\n\n  # Helper to create a hashable representation of a state for visited checks\n  def _state_key(st):\n      return (st.pos, st.dir, st.inventory.tobytes())\n\n  # Bread\u2011first search over deterministic transitions\n  from collections import deque\n  frontier = deque()\n  frontier.append((start_state, []))\n  visited = {_state_key(start_state)}\n  MAX_PLAN_LEN = 500  # safety bound on plan length\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      # Goal test: inventory already contains a stick\n      if goal_idx is not None and cur_state.satisfies(\"\", goal_idx):\n          return cur_plan\n\n      # Prune overly long plans\n      if len(cur_plan) >= MAX_PLAN_LEN:\n          continue\n\n      # Expand all possible actions\n      for a in actions:\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((next_state, cur_plan + [a]))\n\n  # No plan found within limits\n  return []", "env_interactions": 4, "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T21:12:31.383174", "function_name": "make_stick", "function_body": "  import collections\n\n  # Determine action identifiers (fallback to typical ordering if needed)\n  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      action_ids = [0, 1, 2, 3, 4]  # DOWN, UP, LEFT, RIGHT, USE\n\n  # Resolve the integer index for the target item \"stick\"\n  try:\n      goal_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      goal_idx = env.world.cookbook.index.get(\"stick\")\n\n  if goal_idx is None:\n      return []\n\n  # Obtain the starting state (use current lab state if available)\n  start_state = getattr(env, \"_current_state\", None)\n  if start_state is None:\n      start_state = env.scenario.init()\n\n  # Helper to create a hashable representation of a state for visited checks\n  def _state_key(st):\n      return (st.pos, st.dir, st.inventory.tobytes())\n\n  # Bread\u2011first search over deterministic transitions\n  frontier = collections.deque()\n  frontier.append((start_state, []))\n  visited = {_state_key(start_state)}\n  max_plan_len = 500  # safety bound\n\n  while frontier:\n      cur_state, cur_actions = frontier.popleft()\n\n      # Goal test: inventory already contains a stick\n      if cur_state.satisfies(\"\", goal_idx):\n          return cur_actions\n\n      # Prune overly long plans\n      if len(cur_actions) >= max_plan_len:\n          continue\n\n      # Expand all possible actions\n      for a in action_ids:\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((next_state, cur_actions + [a]))\n\n  # No plan found within limits\n  return []", "env_interactions": 4, "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T21:12:50.123037", "function_name": "make_stick", "function_body": "  state = env._current_state\n  world = env.world\n  goal_idx = env.task.goal\n  action_map = env.action_specs()\n\n  # direction vector \u2192 action name\n  dir_to_action = {\n      (0, 1): \"DOWN\",\n      (0, -1): \"UP\",\n      (-1, 0): \"LEFT\",\n      (1, 0): \"RIGHT\",\n  }\n\n  # work on a copy of the grid and keep track of agent position\n  grid = state.grid.copy()\n  pos = state.pos\n  actions = []\n\n  from collections import deque\n\n  def is_blocked(x, y):\n      \"\"\"Return True if cell (x,y) contains any non\u2011grabbable entity.\"\"\"\n      for kind in world.non_grabbable_indices:\n          if grid[x, y, kind] > 0:\n              return True\n      return False\n\n  def bfs(start, target):\n      \"\"\"Shortest path (list of positions) from start to target avoiding blocked cells.\"\"\"\n      w, h = grid.shape[0], grid.shape[1]\n      q = deque([start])\n      visited = {start}\n      prev = {}\n\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              # reconstruct path\n              path = []\n              while cur != start:\n                  path.append(cur)\n                  cur = prev[cur]\n              path.append(start)\n              path.reverse()\n              return path\n\n          x, y = cur\n          for dx, dy in [(0, 1), (0, -1), (-1, 0), (1, 0)]:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < w and 0 <= ny < h):\n                  continue\n              if (nx, ny) not in visited:\n                  # allow stepping onto the target even if it is blocked (e.g., a workshop)\n                  if is_blocked(nx, ny) and (nx, ny) != target:\n                      continue\n                  visited.add((nx, ny))\n                  prev[(nx, ny)] = cur\n                  q.append((nx, ny))\n      return None\n\n  def add_path(path):\n      \"\"\"Convert a list of positions to actions and update current position.\"\"\"\n      nonlocal pos\n      for a, b in zip(path, path[1:]):\n          dx, dy = b[0] - a[0], b[1] - a[1]\n          act_name = dir_to_action[(dx, dy)]\n          actions.append(action_map[act_name])\n      pos = path[-1]\n\n  # ------------------------------------------------------------------\n  # 1. Gather required primitive resources\n  # ------------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(goal_idx)\n  if not primitive_needs:\n      # goal itself is a primitive\n      primitive_needs = {goal_idx: 1}\n\n  for prim_kind, needed_cnt in primitive_needs.items():\n      collected = 0\n      while collected < needed_cnt:\n          prim_positions = list(zip(*np.where(grid[:, :, prim_kind] > 0)))\n          if not prim_positions:\n              break  # no more of this primitive available\n\n          # choose nearest primitive (Manhattan distance)\n          dists = [abs(px - pos[0]) + abs(py - pos[1]) for (px, py) in prim_positions]\n          target = prim_positions[int(np.argmin(dists))]\n\n          path = bfs(pos, target)\n          if path is None:\n              break  # cannot reach this primitive\n\n          add_path(path)\n          actions.append(action_map[\"USE\"])          # pick up\n          grid[pos[0], pos[1], prim_kind] = 0        # remove from simulated grid\n          collected += 1\n\n  # ------------------------------------------------------------------\n  # 2. Move to workshop (if required) and craft the goal item\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      workshop_positions = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n      if workshop_positions:\n          dists = [abs(px - pos[0]) + abs(py - pos[1]) for (px, py) in workshop_positions]\n          target_ws = workshop_positions[int(np.argmin(dists))]\n          path = bfs(pos, target_ws)\n          if path is not None:\n              add_path(path)\n              actions.append(action_map[\"USE\"])      # craft at workshop\n\n  return actions", "env_interactions": 0, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:12:51.238793", "function_name": "make_stick", "function_body": "  state = env._current_state\n  world = env.world\n  goal_idx = env.task.goal\n  action_map = env.action_specs()\n\n  # Mapping from direction delta to action name\n  delta_to_action = {\n      (1, 0): \"RIGHT\",\n      (-1, 0): \"LEFT\",\n      (0, 1): \"DOWN\",\n      (0, -1): \"UP\",\n  }\n\n  # Work on a copy of the grid to keep track of taken items\n  grid = state.grid.copy()\n  pos = state.pos\n  actions = []\n\n  def bfs(start, target):\n      \"\"\"Return a list of positions from start to target (inclusive) using BFS.\n      Returns None if target is unreachable.\"\"\"\n      from collections import deque\n\n      width, height = grid.shape[0], grid.shape[1]\n      visited = set([start])\n      prev = {}\n      q = deque([start])\n\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              # reconstruct path\n              path = []\n              while cur != start:\n                  path.append(cur)\n                  cur = prev[cur]\n              path.append(start)\n              path.reverse()\n              return path\n\n          x, y = cur\n          for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n\n              # cell traversability: blocked if any non\u2011grabbable entity present,\n              # except when the cell is the final target (we may need to step onto it)\n              blocked = False\n              for kind in world.non_grabbable_indices:\n                  if grid[nx, ny, kind] > 0:\n                      blocked = True\n                      break\n              if blocked and (nx, ny) != target:\n                  continue\n\n              nxt = (nx, ny)\n              if nxt not in visited:\n                  visited.add(nxt)\n                  prev[nxt] = cur\n                  q.append(nxt)\n      return None\n\n  def add_path(path):\n      \"\"\"Convert a position path to actions and update current position.\"\"\"\n      nonlocal pos\n      for a, b in zip(path, path[1:]):\n          dx, dy = b[0] - a[0], b[1] - a[1]\n          act_name = delta_to_action[(dx, dy)]\n          actions.append(action_map[act_name])\n      pos = path[-1]\n\n  # ------------------------------------------------------------------\n  # 1. Gather required primitives (or the goal itself if it is primitive)\n  # ------------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(goal_idx)\n  if not primitive_needs:\n      primitive_needs = {goal_idx: 1}\n\n  for prim_kind, needed_cnt in primitive_needs.items():\n      collected = 0\n      while collected < needed_cnt:\n          # locate all remaining cells containing this primitive\n          prim_cells = list(zip(*np.where(grid[:, :, prim_kind] > 0)))\n          if not prim_cells:\n              # cannot obtain required amount; abort planning\n              return actions\n\n          # choose nearest reachable primitive\n          best_path = None\n          best_target = None\n          best_len = None\n          for cell in prim_cells:\n              path = bfs(pos, cell)\n              if path is None:\n                  continue\n              if best_len is None or len(path) < best_len:\n                  best_len = len(path)\n                  best_path = path\n                  best_target = cell\n\n          if best_path is None:\n              # no reachable primitive left\n              return actions\n\n          add_path(best_path)\n          # pick up the primitive\n          actions.append(action_map[\"USE\"])\n          # remove it from simulated grid\n          grid[pos[0], pos[1], prim_kind] = 0\n          collected += 1\n\n  # ------------------------------------------------------------------\n  # 2. If a workshop is required, move there and craft the item\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n      if workshop_cells:\n          # find nearest reachable workshop\n          best_path = None\n          best_len = None\n          for cell in workshop_cells:\n              path = bfs(pos, cell)\n              if path is None:\n                  continue\n              if best_len is None or len(path) < best_len:\n                  best_len = len(path)\n                  best_path = path\n          if best_path is not None:\n              add_path(best_path)\n              actions.append(action_map[\"USE\"])\n\n  return actions", "env_interactions": 0, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:13:15.255281", "function_name": "make_stick", "function_body": "  state = env._current_state\n  world = env.world\n  goal_idx = env.task.goal\n\n  # Mapping from action name to integer code\n  action_map = env.action_specs()\n\n  def _moves(start, target):\n      \"\"\"Return a list of actions moving from start to target (Manhattan).\"\"\"\n      actions = []\n      x, y = start\n      tx, ty = target\n      while x < tx:\n          actions.append(action_map[\"RIGHT\"])\n          x += 1\n      while x > tx:\n          actions.append(action_map[\"LEFT\"])\n          x -= 1\n      while y < ty:\n          actions.append(action_map[\"DOWN\"])\n          y += 1\n      while y > ty:\n          actions.append(action_map[\"UP\"])\n          y -= 1\n      return actions\n\n  def _nearest(cur, positions):\n      \"\"\"Choose the position with smallest Manhattan distance to cur.\"\"\"\n      cx, cy = cur\n      best = None\n      best_dist = None\n      for pos in positions:\n          px, py = pos\n          dist = abs(cx - px) + abs(cy - py)\n          if best_dist is None or dist < best_dist:\n              best = pos\n              best_dist = dist\n      return best\n\n  actions = []\n  cur_pos = state.pos\n\n  # ------------------------------------------------------------------\n  # 1. Collect required primitives for the goal (or the goal itself if primitive)\n  # ------------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  if not primitive_needs:\n      # Goal is a primitive that must be collected directly\n      primitive_needs = {goal_idx: 1}\n\n  for prim_kind, needed_cnt in primitive_needs.items():\n      # Find all cells that contain this primitive kind\n      prim_grid = state.grid[:, :, prim_kind]\n      positions = list(zip(*np.where(prim_grid > 0)))\n      if not positions:\n          # Primitive not present; cannot satisfy task \u2013 skip\n          continue\n      for _ in range(needed_cnt):\n          target = _nearest(cur_pos, positions)\n          actions.extend(_moves(cur_pos, target))\n          cur_pos = target\n          actions.append(action_map[\"USE\"])   # pick up the primitive\n\n  # ------------------------------------------------------------------\n  # 2. Move to the workshop (if any) and craft the goal item\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      workshop_grid = state.grid[:, :, workshop_kind]\n      workshop_positions = list(zip(*np.where(workshop_grid > 0)))\n      if workshop_positions:\n          target = _nearest(cur_pos, workshop_positions)\n          actions.extend(_moves(cur_pos, target))\n          cur_pos = target\n          actions.append(action_map[\"USE\"])   # craft at the workshop\n\n  return actions", "env_interactions": 0, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:13:16.512422", "function_name": "make_stick", "function_body": "  state = env._current_state\n  world = env.world\n  goal_idx = env.task.goal\n  action_map = env.action_specs()\n  # helper move etc...\n  # compute primitives etc.\n  return actions", "env_interactions": 0, "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-10-21T21:13:47.050340", "function_name": "make_stick", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ----------------------------------------------------------------------\n  # Basic handles\n  # ----------------------------------------------------------------------\n  ACTION = env.action_specs()                     # name \u2192 int\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  # ----------------------------------------------------------------------\n  # Helper utilities\n  # ----------------------------------------------------------------------\n  def find_nearest(pos, kind, grid):\n      \"\"\"Return (x, y) of the closest cell containing *kind* (Manhattan).\"\"\"\n      layer = grid[:, :, kind]\n      ys, xs = np.where(layer > 0)\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - pos[0]) + np.abs(ys - pos[1])\n      i = int(np.argmin(dists))\n      return (int(xs[i]), int(ys[i]))\n\n  def bfs_path(start, goal, grid):\n      \"\"\"Shortest 4\u2011connected path from *start* to *goal* avoiding occupied cells.\"\"\"\n      if start == goal:\n          return [start]\n      W, H, _ = grid.shape\n      visited = np.full((W, H), False, dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start[0], start[1]] = True\n\n      while q:\n          x, y = q.popleft()\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < W and 0 <= ny < H):\n                  continue\n              if visited[nx, ny]:\n                  continue\n              # allow stepping onto the goal even if occupied\n              if (nx, ny) != goal and grid[nx, ny].any():\n                  continue\n              visited[nx, ny] = True\n              prev[(nx, ny)] = (x, y)\n              if (nx, ny) == goal:\n                  # reconstruct path\n                  path = [(nx, ny)]\n                  while path[-1] != start:\n                      path.append(prev[path[-1]])\n                  path.reverse()\n                  return path\n              q.append((nx, ny))\n      return None\n\n  def actions_from_path(path):\n      \"\"\"Translate a sequence of positions into action indices.\"\"\"\n      seq = []\n      for (x0, y0), (x1, y1) in zip(path, path[1:]):\n          if x1 > x0:\n              seq.append(ACTION[\"RIGHT\"])\n          elif x1 < x0:\n              seq.append(ACTION[\"LEFT\"])\n          elif y1 > y0:\n              seq.append(ACTION[\"DOWN\"])\n          elif y1 < y0:\n              seq.append(ACTION[\"UP\"])\n      return seq\n\n  # ----------------------------------------------------------------------\n  # Identify indices for stick and its recipe\n  # ----------------------------------------------------------------------\n  stick_idx = idx.get(\"stick\")\n  if stick_idx is None:\n      return []  # cannot find stick definition\n\n  # Primitives required to craft a stick (empty if stick itself is primitive)\n  needed = world.cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n\n  # ----------------------------------------------------------------------\n  # Planning\n  # ----------------------------------------------------------------------\n  grid = state.grid.copy()          # mutable copy to simulate pickups\n  plan = []\n  cur_pos = state.pos\n\n  # ----------------------------------------------------------------------\n  # Case 1: stick is a primitive (no recipe)\n  # ----------------------------------------------------------------------\n  if not needed:\n      target = find_nearest(cur_pos, stick_idx, grid)\n      if target is None:\n          return []  # stick not present in world\n      path = bfs_path(cur_pos, target, grid)\n      if path is None:\n          return []  # unreachable\n      plan.extend(actions_from_path(path))\n      plan.append(ACTION[\"USE\"])\n      return plan\n\n  # ----------------------------------------------------------------------\n  # Case 2: need to collect required primitives first\n  # ----------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          target = find_nearest(cur_pos, prim_idx, grid)\n          if target is None:\n              return []  # missing primitive\n          path = bfs_path(cur_pos, target, grid)\n          if path is None:\n              return []  # cannot reach primitive\n          plan.extend(actions_from_path(path))\n          plan.append(ACTION[\"USE\"])        # pick up primitive\n          # simulate removal of the primitive from the grid\n          grid[target[0], target[1], prim_idx] = 0\n          cur_pos = target\n\n  # ----------------------------------------------------------------------\n  # Move to required workshop (if any) before crafting\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      wk_idx = idx[workshop_name] if isinstance(workshop_name, str) else workshop_name\n      wk_pos = find_nearest(cur_pos, wk_idx, grid)\n      if wk_pos is not None:\n          path = bfs_path(cur_pos, wk_pos, grid)\n          if path is not None:\n              plan.extend(actions_from_path(path))\n              cur_pos = wk_pos\n\n  # ----------------------------------------------------------------------\n  # Final USE to craft the stick\n  # ----------------------------------------------------------------------\n  plan.append(ACTION[\"USE\"])\n\n  return plan", "env_interactions": 0, "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-10-21T21:13:48.192789", "function_name": "make_stick", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action mapping\n  ACTION = env.action_specs()\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  # ------------------------------------------------------------------\n  # Helper functions\n  # ------------------------------------------------------------------\n  def find_nearest(pos, kind, grid):\n      \"\"\"Return (x, y) of the closest cell containing *kind*.\"\"\"\n      layer = grid[:, :, kind]\n      ys, xs = np.where(layer > 0)\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - pos[0]) + np.abs(ys - pos[1])\n      i = int(np.argmin(dists))\n      return (int(xs[i]), int(ys[i]))\n\n  def bfs_path(start, goal, grid):\n      \"\"\"Shortest 4\u2011connected path from *start* to *goal* avoiding occupied cells.\"\"\"\n      if start == goal:\n          return [start]\n      W, H, _ = grid.shape\n      visited = np.full((W, H), False, dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start[0], start[1]] = True\n\n      while q:\n          x, y = q.popleft()\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < W and 0 <= ny < H):\n                  continue\n              if visited[nx, ny]:\n                  continue\n              # allow stepping onto the goal even if occupied\n              if (nx, ny) != goal and grid[nx, ny].any():\n                  continue\n              visited[nx, ny] = True\n              prev[(nx, ny)] = (x, y)\n              if (nx, ny) == goal:\n                  # reconstruct path\n                  path = [(nx, ny)]\n                  while path[-1] != start:\n                      path.append(prev[path[-1]])\n                  path.reverse()\n                  return path\n              q.append((nx, ny))\n      return None\n\n  def actions_from_path(path):\n      \"\"\"Translate a sequence of positions into action indices.\"\"\"\n      seq = []\n      for (x0, y0), (x1, y1) in zip(path, path[1:]):\n          if x1 > x0:\n              seq.append(ACTION[\"RIGHT\"])\n          elif x1 < x0:\n              seq.append(ACTION[\"LEFT\"])\n          elif y1 > y0:\n              seq.append(ACTION[\"DOWN\"])\n          elif y1 < y0:\n              seq.append(ACTION[\"UP\"])\n      return seq\n\n  # ------------------------------------------------------------------\n  # Identify stick and its recipe\n  # ------------------------------------------------------------------\n  try:\n      stick_idx = idx[\"stick\"]\n  except Exception:\n      return []\n\n  needed = world.cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Planning\n  # ------------------------------------------------------------------\n  grid = state.grid.copy()          # mutable copy to simulate pickups\n  plan = []\n  cur_pos = state.pos\n\n  # Collect required primitives\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          target = find_nearest(cur_pos, prim_idx, grid)\n          if target is None:\n              return []                     # primitive missing\n          path = bfs_path(cur_pos, target, grid)\n          if path is None:\n              return []                     # no reachable path\n          plan.extend(actions_from_path(path))\n          plan.append(ACTION[\"USE\"])        # pick up primitive\n          grid[target[0], target[1], prim_idx] = 0   # remove from grid\n          cur_pos = target\n\n  # Move to workshop if required\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      wk_idx = idx[workshop_name] if isinstance(workshop_name, str) else workshop_name\n      wk_pos = find_nearest(cur_pos, wk_idx, grid)\n      if wk_pos is not None:\n          path = bfs_path(cur_pos, wk_pos, grid)\n          if path is not None:\n              plan.extend(actions_from_path(path))\n              cur_pos = wk_pos\n\n  # Final USE to craft (or simply pick up) the stick\n  plan.append(ACTION[\"USE\"])\n  return plan", "env_interactions": 4, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:14:14.996455", "function_name": "make_stick", "function_body": "  # Reset environment to get a fresh scenario\n  env.reset()\n  world = env.world\n  scenario = env.scenario\n\n  # Action indices according to CraftLab.action_specs()\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  # Index of the target item (stick)\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # Determine which primitive resources are required to craft a stick.\n  # If the recipe dict is empty the stick itself is a primitive.\n  primitives_needed = world.cookbook.primitives_for(stick_idx)\n  if not primitives_needed:\n      primitives_needed = {stick_idx: 1}\n\n  # Local mutable copies of the grid and the agent position.\n  grid = scenario.init_grid.copy()          # shape (W, H, n_kinds)\n  pos = scenario.init_pos                    # (x, y) tuple\n  actions = []                               # list of action ints to return\n\n  # ----------------------------------------------------------------------\n  # Helper utilities\n  # ----------------------------------------------------------------------\n  from collections import deque\n\n  def bfs(start, goal):\n      \"\"\"Return a list of movement actions from start to goal avoiding occupied cells.\"\"\"\n      W, H = grid.shape[:2]\n      visited = set()\n      q = deque()\n      q.append((start, []))\n      visited.add(start)\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for act, (dx, dy) in (\n              (ACTION_DOWN, (0, 1)),\n              (ACTION_UP, (0, -1)),\n              (ACTION_LEFT, (-1, 0)),\n              (ACTION_RIGHT, (1, 0)),\n          ):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H:\n                  # A cell is walkable iff it contains no entities of any kind\n                  if np.any(grid[nx, ny, :] != 0):\n                      continue\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [act]))\n      return None  # unreachable\n\n  def free_adjacent(cell):\n      \"\"\"Return all free (unoccupied) cells adjacent to `cell`.\"\"\"\n      adj = []\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          ax, ay = cell[0] + dx, cell[1] + dy\n          if 0 <= ax < grid.shape[0] and 0 <= ay < grid.shape[1]:\n              if not np.any(grid[ax, ay, :] != 0):\n                  adj.append((ax, ay))\n      return adj\n\n  def direction_action(dx, dy):\n      \"\"\"Map a delta (dx, dy) to the corresponding movement action.\"\"\"\n      if dx == -1 and dy == 0:\n          return ACTION_LEFT\n      if dx == 1 and dy == 0:\n          return ACTION_RIGHT\n      if dx == 0 and dy == -1:\n          return ACTION_UP\n      if dx == 0 and dy == 1:\n          return ACTION_DOWN\n      return None\n\n  # ----------------------------------------------------------------------\n  # 1. Collect all required primitive items\n  # ----------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      for _ in range(needed_cnt):\n          # Find any remaining instance of the primitive on the map\n          locations = np.argwhere(grid[:, :, prim_idx] > 0)\n          if len(locations) == 0:\n              # No more of this primitive \u2013 should not happen in a valid scenario\n              continue\n          target = tuple(locations[0])  # (x, y)\n\n          # Choose a free adjacent cell from which we can USE the primitive\n          adj_cells = free_adjacent(target)\n          chosen_adj = None\n          path_to_adj = None\n          for adj in adj_cells:\n              p = bfs(pos, adj)\n              if p is not None:\n                  chosen_adj = adj\n                  path_to_adj = p\n                  break\n\n          if path_to_adj is None:\n              # Could not reach a usable position; skip this primitive\n              continue\n\n          # Move to the chosen adjacent cell\n          actions.extend(path_to_adj)\n          pos = chosen_adj\n\n          # Face the primitive (set direction by moving one step towards it)\n          dx, dy = target[0] - pos[0], target[1] - pos[1]\n          dir_act = direction_action(dx, dy)\n          if dir_act is not None:\n              actions.append(dir_act)\n\n          # Use the primitive (collect it)\n          actions.append(ACTION_USE)\n\n          # Update local grid copy to reflect that the primitive was taken\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # ----------------------------------------------------------------------\n  # 2. Craft the stick at its required workshop (if any)\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if len(workshop_cells) > 0:\n          workshop_pos = tuple(workshop_cells[0])\n\n          # Find a free adjacent cell next to the workshop\n          adj_cells = free_adjacent(workshop_pos)\n          chosen_adj = None\n          path_to_adj = None\n          for adj in adj_cells:\n              p = bfs(pos, adj)\n              if p is not None:\n                  chosen_adj = adj\n                  path_to_adj = p\n                  break\n\n          if path_to_adj is not None:\n              # Move next to the workshop\n              actions.extend(path_to_adj)\n              pos = chosen_adj\n\n              # Face the workshop\n              dx, dy = workshop_pos[0] - pos[0], workshop_pos[1] - pos[1]\n              dir_act = direction_action(dx, dy)\n              if dir_act is not None:\n                  actions.append(dir_act)\n\n              # Use to craft the stick\n              actions.append(ACTION_USE)\n\n  # Return the compiled sequence of actions\n  return actions", "env_interactions": 7, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:14:16.118312", "function_name": "make_stick", "function_body": "  # reset environment to obtain fresh scenario\n  env.reset()\n  world = env.world\n  scenario = env.scenario\n\n  # action indices (use the mapping provided by the environment)\n  act_map = env.action_specs()\n  ACTION_DOWN = act_map[\"DOWN\"]\n  ACTION_UP = act_map[\"UP\"]\n  ACTION_LEFT = act_map[\"LEFT\"]\n  ACTION_RIGHT = act_map[\"RIGHT\"]\n  ACTION_USE = act_map[\"USE\"]\n\n  # index of the target item (stick)\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # primitive requirements for a stick (empty dict means stick is primitive)\n  primitives_needed = world.cookbook.primitives_for(stick_idx)\n  if not primitives_needed:\n      primitives_needed = {stick_idx: 1}\n\n  # local mutable copies of grid and agent position\n  grid = scenario.init_grid.copy()\n  pos = scenario.init_pos  # (x, y)\n  actions = []\n\n  # --------------------------------------------------------------------- #\n  # Helper utilities\n  # --------------------------------------------------------------------- #\n  from collections import deque\n\n  def bfs(start, goal):\n      \"\"\"Bread\u2011first search on the current grid, returning a list of movement\n      actions that leads from *start* to *goal*.  Cells containing any entity\n      are considered blocked.\"\"\"\n      W, H = grid.shape[:2]\n      visited = set()\n      q = deque()\n      q.append((start, []))\n      visited.add(start)\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for act, (dx, dy) in (\n              (ACTION_DOWN, (0, 1)),\n              (ACTION_UP, (0, -1)),\n              (ACTION_LEFT, (-1, 0)),\n              (ACTION_RIGHT, (1, 0)),\n          ):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H:\n                  # walkable iff no kind occupies the cell\n                  if np.any(grid[nx, ny, :] != 0):\n                      continue\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [act]))\n      return None  # unreachable\n\n  def free_adjacent(cell):\n      \"\"\"Return all orthogonal neighbours of *cell* that are empty.\"\"\"\n      adj = []\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          ax, ay = cell[0] + dx, cell[1] + dy\n          if 0 <= ax < grid.shape[0] and 0 <= ay < grid.shape[1]:\n              if not np.any(grid[ax, ay, :] != 0):\n                  adj.append((ax, ay))\n      return adj\n\n  def direction_action(dx, dy):\n      \"\"\"Map a unit delta to the corresponding movement action (used only\n      for turning \u2013 the move will be blocked if the target cell is occupied).\"\"\"\n      if dx == -1 and dy == 0:\n          return ACTION_LEFT\n      if dx == 1 and dy == 0:\n          return ACTION_RIGHT\n      if dx == 0 and dy == -1:\n          return ACTION_UP\n      if dx == 0 and dy == 1:\n          return ACTION_DOWN\n      return None\n\n  # --------------------------------------------------------------------- #\n  # 1. Collect all required primitive items\n  # --------------------------------------------------------------------- #\n  for prim_idx, count in primitives_needed.items():\n      for _ in range(count):\n          # locate any remaining instance of the primitive on the map\n          locations = np.argwhere(grid[:, :, prim_idx] > 0)\n          if len(locations) == 0:\n              # no more of this primitive \u2013 give up on this item\n              continue\n          target = tuple(locations[0])  # (x, y)\n\n          # find a free cell adjacent to the primitive from which we can USE it\n          adj_cells = free_adjacent(target)\n          chosen_adj = None\n          path_to_adj = None\n          for adj in adj_cells:\n              p = bfs(pos, adj)\n              if p is not None:\n                  chosen_adj = adj\n                  path_to_adj = p\n                  break\n\n          if path_to_adj is None:\n              # cannot reach any usable position; skip this primitive\n              continue\n\n          # move to the chosen adjacent cell\n          actions.extend(path_to_adj)\n          pos = chosen_adj\n\n          # turn towards the primitive (add a movement action that will be\n          # blocked but will set the direction correctly)\n          dx = target[0] - pos[0]\n          dy = target[1] - pos[1]\n          turn_act = direction_action(dx, dy)\n          if turn_act is not None:\n              actions.append(turn_act)\n\n          # collect the primitive\n          actions.append(ACTION_USE)\n\n          # update local grid copy to reflect collection\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # --------------------------------------------------------------------- #\n  # 2. Craft the stick at its required workshop (if any)\n  # --------------------------------------------------------------------- #\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if len(workshop_cells) > 0:\n          workshop_pos = tuple(workshop_cells[0])\n\n          # pick a free adjacent cell next to the workshop\n          adj_cells = free_adjacent(workshop_pos)\n          chosen_adj = None\n          path_to_adj = None\n          for adj in adj_cells:\n              p = bfs(pos, adj)\n              if p is not None:\n                  chosen_adj = adj\n                  path_to_adj = p\n                  break\n\n          if path_to_adj is not None:\n              actions.extend(path_to_adj)\n              pos = chosen_adj\n\n              # face the workshop\n              dx = workshop_pos[0] - pos[0]\n              dy = workshop_pos[1] - pos[1]\n              turn_act = direction_action(dx, dy)\n              if turn_act is not None:\n                  actions.append(turn_act)\n\n              # craft the stick\n              actions.append(ACTION_USE)\n\n  # return the complete action list\n  return actions", "env_interactions": 7, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:14:31.956912", "function_name": "make_stick", "function_body": "  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      action_ids = [0, 1, 2, 3, 4]\n\n  # Resolve the index for the target item \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n  if stick_idx is None:\n      return []\n\n  # Ensure we have a current state\n  if not hasattr(env, \"_current_state\") or env._current_state is None:\n      env.reset()\n  start_state = env._current_state\n\n  # If we already possess a stick, no actions are needed\n  if start_state.inventory[stick_idx] > 0:\n      return []\n\n  from collections import deque\n\n  frontier = deque()\n  frontier.append((start_state, []))\n  visited = set()\n\n  def state_key(st):\n      return (st.pos, st.dir, st.inventory.tobytes())\n\n  visited.add(state_key(start_state))\n  max_plan_len = 300  # safety bound\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n      if cur_state.inventory[stick_idx] > 0:\n          return cur_plan\n      if len(cur_plan) >= max_plan_len:\n          continue\n      for a in action_ids:\n          _, nxt_state = cur_state.step(a)\n          key = state_key(nxt_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((nxt_state, cur_plan + [a]))\n\n  # No plan found within the bound\n  return []", "env_interactions": 4, "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T21:14:33.077026", "function_name": "make_stick", "function_body": "  # Obtain the list of possible action ids (fallback to default ordering if needed)\n  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      action_ids = [0, 1, 2, 3, 4]  # DOWN, UP, LEFT, RIGHT, USE\n\n  # Resolve the index of the target item \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n  if stick_idx is None:\n      return []\n\n  # Ensure the environment has a current state (reset if necessary)\n  if not hasattr(env, \"_current_state\") or env._current_state is None:\n      env.reset()\n  start_state = env._current_state\n\n  # If we already possess a stick, no actions are required\n  if start_state.inventory[stick_idx] > 0:\n      return []\n\n  from collections import deque\n\n  # Bread\u2011first search over deterministic state transitions\n  frontier = deque()\n  frontier.append((start_state, []))\n  visited = set()\n\n  # Unique identifier for a state (position, direction, inventory contents)\n  def state_key(st):\n      return (st.pos, st.dir, st.inventory.tobytes())\n\n  visited.add(state_key(start_state))\n  max_plan_len = 300  # safety bound to keep the search tractable\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n      if cur_state.inventory[stick_idx] > 0:\n          return cur_plan\n      if len(cur_plan) >= max_plan_len:\n          continue\n      for a in action_ids:\n          _, nxt_state = cur_state.step(a)\n          key = state_key(nxt_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((nxt_state, cur_plan + [a]))\n\n  # No plan found within limits \u2013 return empty list\n  return []", "env_interactions": 4, "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T21:14:57.640288", "function_name": "make_stick", "function_body": "  # Reset environment to start fresh and obtain the initial state\n  env.reset()\n  state = env._current_state          # current CraftState\n  world = env.world\n  scenario = env.scenario\n\n  # Goal item index (stick)\n  goal_idx = env.task.goal\n\n  # Mapping from action name to integer code\n  action_map = env.action_specs()     # e.g. {\"DOWN\":0, \"UP\":1, ...}\n\n  # ------------------------------------------------------------------\n  # Helper: shortest path (BFS) avoiding any occupied cell except the\n  # target cell itself. Returns a list of action indices.\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  grid = scenario.init_grid.copy()    # mutable copy for planning\n\n  def _shortest_path(src, tgt):\n      src_t = tuple(src)\n      tgt_t = tuple(tgt)\n      if src_t == tgt_t:\n          return []\n\n      visited = {src_t}\n      q = deque([(src_t, [])])\n\n      moves = [\n          (0, 1, \"DOWN\"),\n          (0, -1, \"UP\"),\n          (-1, 0, \"LEFT\"),\n          (1, 0, \"RIGHT\")\n      ]\n\n      while q:\n          (x, y), path = q.popleft()\n          for dx, dy, name in moves:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]):\n                  continue\n              npos = (nx, ny)\n              if npos in visited:\n                  continue\n              # allow stepping onto the target even if occupied\n              if npos != tgt_t and grid[nx, ny, :].any():\n                  continue\n              new_path = path + [action_map[name]]\n              if npos == tgt_t:\n                  return new_path\n              visited.add(npos)\n              q.append((npos, new_path))\n\n      # Fallback to Manhattan moves if BFS fails\n      fallback = []\n      cx, cy = src_t\n      tx, ty = tgt_t\n      while cx < tx:\n          fallback.append(action_map[\"RIGHT\"]); cx += 1\n      while cx > tx:\n          fallback.append(action_map[\"LEFT\"]); cx -= 1\n      while cy < ty:\n          fallback.append(action_map[\"DOWN\"]); cy += 1\n      while cy > ty:\n          fallback.append(action_map[\"UP\"]); cy -= 1\n      return fallback\n\n  # ------------------------------------------------------------------\n  # Helper to move agent (updates current position and action list)\n  # ------------------------------------------------------------------\n  cur_pos = list(state.pos)\n  actions = []\n\n  def _move_to(target):\n      nonlocal cur_pos, actions\n      steps = _shortest_path(cur_pos, target)\n      actions.extend(steps)\n      cur_pos[0], cur_pos[1] = target[0], target[1]\n\n  # ------------------------------------------------------------------\n  # 1. Determine which primitive resources are needed for the stick\n  # ------------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n\n  for prim_kind, count_needed in primitive_needs.items():\n      for _ in range(count_needed):\n          # Find all remaining cells that still contain this primitive\n          locations = np.argwhere(grid[:, :, prim_kind] > 0)\n          if locations.shape[0] == 0:\n              # No more of this primitive on the map \u2013 cannot collect further\n              break\n          # Choose the nearest one (Manhattan distance)\n          dists = np.abs(locations - cur_pos).sum(axis=1)\n          nearest_idx = int(np.argmin(dists))\n          target_cell = locations[nearest_idx].tolist()\n\n          # Move to the cell and pick up the primitive\n          _move_to(target_cell)\n          actions.append(action_map[\"USE\"])\n\n          # Update planning grid: primitive is now removed\n          grid[target_cell[0], target_cell[1], prim_kind] = 0\n\n  # ------------------------------------------------------------------\n  # 2. Go to the required workshop (if any) and craft the stick\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      workshop_cells = np.argwhere(grid[:, :, workshop_kind] > 0)\n      if workshop_cells.shape[0] > 0:\n          # Choose nearest workshop\n          dists = np.abs(workshop_cells - cur_pos).sum(axis=1)\n          nearest_ws = int(np.argmin(dists))\n          ws_target = workshop_cells[nearest_ws].tolist()\n          _move_to(ws_target)\n          actions.append(action_map[\"USE\"])\n\n  # Return the complete action sequence\n  return actions", "env_interactions": 0, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:14:58.769846", "function_name": "make_stick", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Ensure a fresh episode and obtain the current state.\n  env.reset()\n  state = env._current_state\n  world = env.world\n\n  # Goal item index (e.g., stick)\n  goal_idx = env.task.goal\n\n  # Mapping from action name to integer code\n  action_map = env.action_specs()          # e.g. {\"DOWN\":0, \"UP\":1, ...}\n  # Inverse mapping for readability (optional)\n  # act_name_to_idx = {k: v for k, v in action_map.items()}\n\n  # Copy of the mutable grid so we can update it as we pick items up.\n  scenario = env.scenario\n  grid = scenario.init_grid.copy()\n  width, height = grid.shape[0], grid.shape[1]\n\n  # Current mutable agent position\n  cur_pos = list(scenario.init_pos)   # [x, y]\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper: shortest path (BFS) from src to tgt on the current grid.\n  # Cells with any entity are treated as blocked, except the target cell.\n  # ------------------------------------------------------------------\n  move_defs = [\n      (0, 1, \"DOWN\"),\n      (0, -1, \"UP\"),\n      (-1, 0, \"LEFT\"),\n      (1, 0, \"RIGHT\")\n  ]\n\n  def _shortest_path(src, tgt):\n      \"\"\"Return a list of action indices moving from src to tgt.\"\"\"\n      if tuple(src) == tuple(tgt):\n          return []\n\n      visited = {tuple(src)}\n      q = deque()\n      q.append((tuple(src), []))\n\n      while q:\n          (x, y), path = q.popleft()\n          for dx, dy, act_name in move_defs:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              npos = (nx, ny)\n              if npos in visited:\n                  continue\n              # Allow stepping onto the target even if occupied.\n              if npos != tuple(tgt) and grid[nx, ny, :].any():\n                  continue\n              new_path = path + [action_map[act_name]]\n              if npos == tuple(tgt):\n                  return new_path\n              visited.add(npos)\n              q.append((npos, new_path))\n\n      # Fallback \u2013 simple Manhattan moves (should rarely be needed)\n      fallback = []\n      cx, cy = src\n      tx, ty = tgt\n      while cx < tx:\n          fallback.append(action_map[\"RIGHT\"])\n          cx += 1\n      while cx > tx:\n          fallback.append(action_map[\"LEFT\"])\n          cx -= 1\n      while cy < ty:\n          fallback.append(action_map[\"DOWN\"])\n          cy += 1\n      while cy > ty:\n          fallback.append(action_map[\"UP\"])\n          cy -= 1\n      return fallback\n\n  def _move_to(target):\n      \"\"\"Move the agent from its current position to target (list/tuple).\"\"\"\n      nonlocal cur_pos, actions\n      steps = _shortest_path(cur_pos, target)\n      actions.extend(steps)\n      cur_pos[0], cur_pos[1] = target[0], target[1]\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitive resources.\n  # ------------------------------------------------------------------\n  primitives_needed = world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n  for kind_idx, needed_cnt in primitives_needed.items():\n      for _ in range(needed_cnt):\n          # Find all remaining cells that still contain this primitive.\n          locations = np.argwhere(grid[:, :, kind_idx] > 0)\n          if locations.shape[0] == 0:\n              # No more of this primitive on the map \u2013 break early.\n              break\n          # Choose the nearest one (Manhattan distance) to reduce path length.\n          dists = np.abs(locations - cur_pos).sum(axis=1)\n          nearest_idx = int(np.argmin(dists))\n          target_cell = locations[nearest_idx].tolist()   # [x, y]\n\n          # Move to the cell and pick it up.\n          _move_to(target_cell)\n          actions.append(action_map[\"USE\"])\n\n          # Update our internal grid copy to reflect that the primitive is gone.\n          grid[target_cell[0], target_cell[1], kind_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 2. If the recipe requires a workshop, move there and craft.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      # Locate workshop cells (there may be several; pick the nearest).\n      ws_cells = np.argwhere(grid[:, :, workshop_kind] > 0)\n      if ws_cells.shape[0] > 0:\n          dists = np.abs(ws_cells - cur_pos).sum(axis=1)\n          nearest_ws = int(np.argmin(dists))\n          ws_target = ws_cells[nearest_ws].tolist()\n          _move_to(ws_target)\n          actions.append(action_map[\"USE\"])\n\n  # Return the compiled action sequence.\n  return actions", "env_interactions": 0, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:15:41.002367", "function_name": "make_stick", "function_body": "  # reset environment to obtain fresh world/scenario objects\n  env.reset()\n  world = env.world\n  scenario = env.scenario\n\n  # -------------------------------------------------------------------------\n  #  Action constants (derived from the env's action specification)\n  # -------------------------------------------------------------------------\n  act_map = env.action_specs()\n  ACTION_DOWN = act_map[\"DOWN\"]\n  ACTION_UP = act_map[\"UP\"]\n  ACTION_LEFT = act_map[\"LEFT\"]\n  ACTION_RIGHT = act_map[\"RIGHT\"]\n  ACTION_USE = act_map[\"USE\"]\n\n  # -------------------------------------------------------------------------\n  #  Helper: simple BFS that returns a list of movement actions from `start`\n  #  to `goal` while staying on empty cells (all zero in the kind dimension)\n  # -------------------------------------------------------------------------\n  from collections import deque\n\n  W, H = scenario.init_grid.shape[:2]\n\n  def bfs(start, goal, grid):\n      \"\"\"Return movement\u2011action list from start\u2192goal (or [] if unreachable).\"\"\"\n      visited = set()\n      q = deque()\n      q.append((start, []))\n      visited.add(start)\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for act, (dx, dy) in [\n              (ACTION_DOWN, (0, 1)),\n              (ACTION_UP, (0, -1)),\n              (ACTION_LEFT, (-1, 0)),\n              (ACTION_RIGHT, (1, 0)),\n          ]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H:\n                  # cell is walkable iff it contains no entities\n                  if np.any(grid[nx, ny, :] != 0):\n                      continue\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [act]))\n      return []  # unreachable\n\n  # -------------------------------------------------------------------------\n  #  Helper: given a target cell, find a reachable free adjacent cell.\n  #  Returns (path, adj_cell) where `path` moves the agent from its current\n  #  position to `adj_cell`.  If none is reachable, returns (None, None).\n  # -------------------------------------------------------------------------\n  def find_adjacent(target, cur_pos, grid):\n      tx, ty = target\n      candidates = []\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          ax, ay = tx + dx, ty + dy\n          if 0 <= ax < W and 0 <= ay < H:\n              if not np.any(grid[ax, ay, :] != 0):\n                  candidates.append((ax, ay))\n      for adj in candidates:\n          path = bfs(cur_pos, adj, grid)\n          if path:\n              return path, adj\n      return None, None\n\n  # -------------------------------------------------------------------------\n  #  Helper: after arriving at an adjacent cell, perform a tiny \u201cturn\u201d\n  #  manoeuvre so that the agent ends up facing the target cell.\n  #  We move to a free neighbour of `adj` (if any) and immediately step back.\n  # -------------------------------------------------------------------------\n  def face_target(adj, target, grid):\n      ax, ay = adj\n      tx, ty = target\n      # find a free neighbour of `adj` that is NOT the target cell\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          nx, ny = ax + dx, ay + dy\n          if (nx, ny) == (tx, ty):\n              continue\n          if 0 <= nx < W and 0 <= ny < H and not np.any(grid[nx, ny, :] != 0):\n              # move to (nx,ny) then back to adj\n              # determine actions for the two steps\n              if nx == ax + 1:\n                  out = [ACTION_RIGHT, ACTION_LEFT]\n              elif nx == ax - 1:\n                  out = [ACTION_LEFT, ACTION_RIGHT]\n              elif ny == ay + 1:\n                  out = [ACTION_DOWN, ACTION_UP]\n              else:  # ny == ay - 1\n                  out = [ACTION_UP, ACTION_DOWN]\n              return out\n      # no free neighbour \u2013 return empty list (we hope direction is already ok)\n      return []\n\n  # -------------------------------------------------------------------------\n  #  Gather required primitives for a stick\n  # -------------------------------------------------------------------------\n  stick_idx = world.cookbook.index[\"stick\"]\n  needed = world.cookbook.primitives_for(stick_idx)\n  if not needed:                 # stick itself is a primitive\n      needed = {stick_idx: 1}\n\n  # local mutable copy of the grid and agent position\n  grid = scenario.init_grid.copy()\n  pos = scenario.init_pos\n  plan = []\n\n  # -------------------------------------------------------------------------\n  #  1) Collect each primitive the required number of times\n  # -------------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          # locate a cell still containing the primitive\n          locations = np.argwhere(grid[:, :, prim_idx] > 0)\n          if len(locations) == 0:\n              continue  # should not happen in well\u2011formed scenarios\n          target = tuple(locations[0])\n\n          # move to a free adjacent cell\n          path, adj = find_adjacent(target, pos, grid)\n          if path is None:\n              continue  # cannot reach \u2013 skip (unlikely)\n          plan.extend(path)\n          pos = adj\n\n          # tiny manoeuvre to ensure we face the target, then USE\n          plan.extend(face_target(adj, target, grid))\n          plan.append(ACTION_USE)\n\n          # update our static view of the grid\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # -------------------------------------------------------------------------\n  #  2) Go to the required workshop (if any) and craft the stick\n  # -------------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if len(ws_cells) > 0:\n          ws_pos = tuple(ws_cells[0])\n          path, adj = find_adjacent(ws_pos, pos, grid)\n          if path is not None:\n              plan.extend(path)\n              pos = adj\n              plan.extend(face_target(adj, ws_pos, grid))\n              plan.append(ACTION_USE)\n\n  # -------------------------------------------------------------------------\n  #  Return the computed action list\n  # -------------------------------------------------------------------------\n  return plan", "env_interactions": 9, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:15:42.122214", "function_name": "make_stick", "function_body": "  # Reset the environment and obtain references to the world and scenario.\n  env.reset()\n  world = env.world\n  scenario = env.scenario\n\n  # Action indices as defined in CraftLab.action_specs.\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  # Index of the target item \u201cstick\u201d.\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # Determine primitive ingredients required to craft a stick.\n  # If the recipe has no ingredients, the stick itself is a primitive.\n  primitives_needed = world.cookbook.primitives_for(stick_idx)\n  if not primitives_needed:\n      primitives_needed = {stick_idx: 1}\n\n  # Work on a mutable copy of the initial grid for planning.\n  grid = scenario.init_grid.copy()\n  pos = scenario.init_pos  # current agent position (x, y)\n  actions = []\n\n  # -------------------------------------------------------------------------\n  # Helper: Bread\u2011first search returning a list of movement actions that\n  # leads from start to a target walkable cell.\n  # -------------------------------------------------------------------------\n  from collections import deque\n\n  def bfs(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) from start to goal.\n      Cells containing any entity are considered blocked.\n      \"\"\"\n      W, H = grid.shape[:2]\n      visited = set()\n      q = deque()\n      q.append((start, []))\n      visited.add(start)\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for act, (dx, dy) in [\n              (ACTION_DOWN, (0, 1)),\n              (ACTION_UP, (0, -1)),\n              (ACTION_LEFT, (-1, 0)),\n              (ACTION_RIGHT, (1, 0)),\n          ]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H:\n                  # walkable iff no entity occupies the cell\n                  if np.any(grid[nx, ny, :] != 0):\n                      continue\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [act]))\n      # No path found \u2013 return empty list (should not happen on valid maps)\n      return []\n\n  # -------------------------------------------------------------------------\n  # 1. Collect all required primitive items.\n  # -------------------------------------------------------------------------\n  for prim_idx, count in primitives_needed.items():\n      for _ in range(count):\n          # Find any remaining cell that still holds this primitive.\n          locations = np.argwhere(grid[:, :, prim_idx] > 0)\n          if len(locations) == 0:\n              # Nothing left \u2013 break (should not happen for well\u2011formed scenarios)\n              break\n          target = tuple(locations[0])  # (x, y) of the primitive\n\n          # Find free adjacent cells from which we can USE the primitive.\n          adj_candidates = []\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              ax, ay = target[0] + dx, target[1] + dy\n              if 0 <= ax < grid.shape[0] and 0 <= ay < grid.shape[1]:\n                  if not np.any(grid[ax, ay, :] != 0):\n                      adj_candidates.append((ax, ay))\n\n          # Choose the first reachable adjacent cell.\n          path_to_adj = None\n          chosen_adj = None\n          for adj in adj_candidates:\n              path = bfs(pos, adj)\n              if path:\n                  path_to_adj = path\n                  chosen_adj = adj\n                  break\n\n          if path_to_adj is None:\n              # No reachable adjacent cell \u2013 give up on this primitive.\n              continue\n\n          # Move to the adjacent cell.\n          actions.extend(path_to_adj)\n          pos = chosen_adj\n\n          # Face the primitive (direction action without moving).\n          dx = target[0] - pos[0]\n          dy = target[1] - pos[1]\n          if dx == -1:\n              actions.append(ACTION_UP)\n          elif dx == 1:\n              actions.append(ACTION_DOWN)\n          elif dy == -1:\n              actions.append(ACTION_LEFT)\n          elif dy == 1:\n              actions.append(ACTION_RIGHT)\n\n          # Use to pick up the primitive.\n          actions.append(ACTION_USE)\n\n          # Update the local grid copy (remove the collected primitive).\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # -------------------------------------------------------------------------\n  # 2. Craft the stick at the required workshop (if any).\n  # -------------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n\n      # Locate any workshop of the required type.\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if len(workshop_cells) > 0:\n          workshop_pos = tuple(workshop_cells[0])\n\n          # Find a free adjacent cell next to the workshop.\n          adj_candidates = []\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              ax, ay = workshop_pos[0] + dx, workshop_pos[1] + dy\n              if 0 <= ax < grid.shape[0] and 0 <= ay < grid.shape[1]:\n                  if not np.any(grid[ax, ay, :] != 0):\n                      adj_candidates.append((ax, ay))\n\n          path_to_adj = None\n          chosen_adj = None\n          for adj in adj_candidates:\n              path = bfs(pos, adj)\n              if path:\n                  path_to_adj = path\n                  chosen_adj = adj\n                  break\n\n          if path_to_adj is not None:\n              # Move next to the workshop.\n              actions.extend(path_to_adj)\n              pos = chosen_adj\n\n              # Face the workshop.\n              dx = workshop_pos[0] - pos[0]\n              dy = workshop_pos[1] - pos[1]\n              if dx == -1:\n                  actions.append(ACTION_UP)\n              elif dx == 1:\n                  actions.append(ACTION_DOWN)\n              elif dy == -1:\n                  actions.append(ACTION_LEFT)\n              elif dy == 1:\n                  actions.append(ACTION_RIGHT)\n\n              # Use to craft the stick.\n              actions.append(ACTION_USE)\n\n  # Return the complete action sequence.\n  return actions", "env_interactions": 7, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:15:56.210446", "function_name": "make_stick", "function_body": "  # Determine action IDs (fallback to default ordering if not provided)\n  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      action_ids = [0, 1, 2, 3, 4]  # DOWN, UP, LEFT, RIGHT, USE\n\n  # Resolve the integer index for the goal item \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = getattr(env.world.cookbook, \"index\", {}).get(\"stick\")\n\n  if stick_idx is None:\n      return []  # cannot locate the stick index\n\n  # Helper to test if a state already satisfies the goal\n  def goal_reached(state):\n      return state.satisfies(\"\", stick_idx)\n\n  # Obtain the current CraftState from the environment\n  start_state = getattr(env, \"_current_state\", None)\n  if start_state is None:\n      start_state = getattr(env, \"current_state\", None)\n  if start_state is None:\n      return []  # cannot access underlying state\n\n  # Bread\u2011first search planner over deterministic state transitions\n  from collections import deque\n\n  def state_key(st):\n      \"\"\"Compact, hashable representation of a CraftState.\"\"\"\n      return (st.pos, st.dir, st.inventory.tobytes())\n\n  frontier = deque()\n  frontier.append((start_state, []))\n  visited = {state_key(start_state)}\n  MAX_PLAN_LEN = 300  # safety ceiling for plan length\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      # Goal test\n      if goal_reached(cur_state):\n          return cur_plan\n\n      # Prune overly long plans\n      if len(cur_plan) >= MAX_PLAN_LEN:\n          continue\n\n      # Expand all possible actions\n      for a in action_ids:\n          _, nxt_state = cur_state.step(a)\n          key = state_key(nxt_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((nxt_state, cur_plan + [a]))\n\n  # No plan found within limits\n  return []", "env_interactions": 4, "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T21:15:57.320143", "function_name": "make_stick", "function_body": "  # Determine the action IDs used by the environment.\n  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      # Default ordering in CraftWorld: DOWN, UP, LEFT, RIGHT, USE\n      action_ids = [0, 1, 2, 3, 4]\n\n  # Resolve the integer index for the target item \"stick\".\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = getattr(env.world.cookbook, \"index\", {}).get(\"stick\")\n  if stick_idx is None:\n      return []  # cannot locate the stick index\n\n  # Helper that checks whether a state already satisfies the goal.\n  def goal_reached(state):\n      return state.satisfies(\"\", stick_idx)\n\n  # Get the current CraftState from the environment.\n  start_state = getattr(env, \"_current_state\", None)\n  if start_state is None:\n      start_state = getattr(env, \"current_state\", None)\n      if start_state is None:\n          return []  # cannot access underlying state\n\n  # Bread\u2011first search planner over deterministic transitions.\n  from collections import deque\n\n  def state_key(st):\n      \"\"\"Compact hashable representation of a CraftState.\"\"\"\n      return (st.pos, st.dir, st.inventory.tobytes())\n\n  frontier = deque()\n  frontier.append((start_state, []))\n  visited = {state_key(start_state)}\n  MAX_PLAN_LENGTH = 250  # safety cap to keep the search tractable.\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      if goal_reached(cur_state):\n          return cur_plan\n\n      if len(cur_plan) >= MAX_PLAN_LENGTH:\n          continue\n\n      for a in action_ids:\n          _, nxt_state = cur_state.step(a)\n          key = state_key(nxt_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((nxt_state, cur_plan + [a]))\n\n  # No plan found within the limits.\n  return []", "env_interactions": 4, "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T21:16:24.753184", "function_name": "make_stick", "function_body": "  # Reset environment to ensure fresh state\n  env.reset()\n  state = env._current_state\n  world = env.world\n  scenario = env.scenario\n\n  goal_idx = env.task.goal\n  action_map = env.action_specs()\n\n  # Planning copy of the initial grid; we will modify it as we pick items\n  grid = scenario.init_grid.copy()\n\n  cur_pos = list(state.pos)\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper: BFS shortest path that can walk through empty cells only.\n  # The target cell may be occupied (e.g., a primitive or workshop) \u2013 we\n  # allow stepping onto it.\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  def _shortest_path(src, tgt):\n      src_t = tuple(src)\n      tgt_t = tuple(tgt)\n      if src_t == tgt_t:\n          return []\n\n      visited = {src_t}\n      q = deque([(src_t, [])])\n\n      moves = [\n          (0, 1, \"DOWN\"),\n          (0, -1, \"UP\"),\n          (-1, 0, \"LEFT\"),\n          (1, 0, \"RIGHT\")\n      ]\n\n      while q:\n          (x, y), path = q.popleft()\n          for dx, dy, name in moves:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]):\n                  continue\n              npos = (nx, ny)\n              if npos in visited:\n                  continue\n              # If the cell is occupied (any kind present) and it is not the target,\n              # we cannot step into it.\n              if npos != tgt_t and grid[nx, ny, :].any():\n                  continue\n              new_path = path + [action_map[name]]\n              if npos == tgt_t:\n                  return new_path\n              visited.add(npos)\n              q.append((npos, new_path))\n\n      # If BFS fails (should not happen in normal maps), fall back to Manhattan moves\n      fallback = []\n      cx, cy = src_t\n      tx, ty = tgt_t\n      while cx < tx:\n          fallback.append(action_map[\"RIGHT\"])\n          cx += 1\n      while cx > tx:\n          fallback.append(action_map[\"LEFT\"])\n          cx -= 1\n      while cy < ty:\n          fallback.append(action_map[\"DOWN\"])\n          cy += 1\n      while cy > ty:\n          fallback.append(action_map[\"UP\"])\n          cy -= 1\n      return fallback\n\n  def _move_to(target):\n      nonlocal cur_pos, actions\n      steps = _shortest_path(cur_pos, target)\n      actions.extend(steps)\n      cur_pos[0], cur_pos[1] = target[0], target[1]\n\n  # ------------------------------------------------------------------\n  # 1. Collect required primitive resources\n  # ------------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n  for prim_kind, needed in primitive_needs.items():\n      for _ in range(needed):\n          # Locate remaining cells that still contain this primitive\n          locations = np.argwhere(grid[:, :, prim_kind] > 0)\n          if locations.size == 0:\n              # No more of this primitive on the map; give up early\n              break\n          # Choose the nearest one (Manhattan distance)\n          dists = np.abs(locations - cur_pos).sum(axis=1)\n          nearest_idx = int(np.argmin(dists))\n          target_cell = locations[nearest_idx].tolist()\n\n          # Move to the cell and pick up the primitive\n          _move_to(target_cell)\n          actions.append(action_map[\"USE\"])\n\n          # Update planning grid \u2013 the primitive is now gone\n          grid[target_cell[0], target_cell[1], prim_kind] = 0\n\n  # ------------------------------------------------------------------\n  # 2. Go to the required workshop (if any) and craft the goal item\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      workshop_cells = np.argwhere(grid[:, :, workshop_kind] > 0)\n      if workshop_cells.size > 0:\n          dists = np.abs(workshop_cells - cur_pos).sum(axis=1)\n          nearest_ws = int(np.argmin(dists))\n          ws_target = workshop_cells[nearest_ws].tolist()\n          _move_to(ws_target)\n          actions.append(action_map[\"USE\"])\n\n  return actions", "env_interactions": 0, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:16:25.868732", "function_name": "make_stick", "function_body": "  # Reset to ensure a fresh start (optional, but safe)\n  env.reset()\n  state = env._current_state          # Current CraftState\n  world = env.world\n  goal_idx = env.task.goal            # Index of the desired item (stick)\n\n  # Mapping from action names to integer codes\n  action_map = env.action_specs()     # e.g., {\"DOWN\":0, \"UP\":1, \"LEFT\":2, \"RIGHT\":3, \"USE\":4}\n\n  # ------------------------------------------------------------------\n  # Helper: BFS shortest path avoiding any occupied cell (except the target)\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  # Use a mutable copy of the initial grid for planning purposes\n  planning_grid = state.grid.copy()\n\n  def _shortest_path(src, tgt):\n      \"\"\"Return list of action indices to move from src to tgt.\"\"\"\n      src = tuple(src)\n      tgt = tuple(tgt)\n      if src == tgt:\n          return []\n\n      moves = [\n          ((0, 1), \"DOWN\"),\n          ((0, -1), \"UP\"),\n          ((-1, 0), \"LEFT\"),\n          ((1, 0), \"RIGHT\"),\n      ]\n\n      visited = {src}\n      q = deque([(src, [])])\n\n      while q:\n          (x, y), path = q.popleft()\n          for (dx, dy), name in moves:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < planning_grid.shape[0] and 0 <= ny < planning_grid.shape[1]):\n                  continue\n              npos = (nx, ny)\n              if npos in visited:\n                  continue\n              # Allow stepping onto the target even if it is occupied\n              if npos != tgt and planning_grid[nx, ny, :].any():\n                  continue\n              new_path = path + [action_map[name]]\n              if npos == tgt:\n                  return new_path\n              visited.add(npos)\n              q.append((npos, new_path))\n\n      # Fallback: simple Manhattan moves\n      fallback = []\n      cx, cy = src\n      tx, ty = tgt\n      while cx < tx:\n          fallback.append(action_map[\"RIGHT\"]); cx += 1\n      while cx > tx:\n          fallback.append(action_map[\"LEFT\"]); cx -= 1\n      while cy < ty:\n          fallback.append(action_map[\"DOWN\"]); cy += 1\n      while cy > ty:\n          fallback.append(action_map[\"UP\"]); cy -= 1\n      return fallback\n\n  # ------------------------------------------------------------------\n  # Helper to move the agent and update current position\n  # ------------------------------------------------------------------\n  cur_pos = list(state.pos)\n  actions = []\n\n  def _move_to(target):\n      nonlocal cur_pos, actions\n      steps = _shortest_path(cur_pos, target)\n      actions.extend(steps)\n      cur_pos[0], cur_pos[1] = target[0], target[1]\n\n  # ------------------------------------------------------------------\n  # 1. Collect required primitive resources for the goal item\n  # ------------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n\n  for prim_kind, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          # Find all remaining cells that still contain this primitive\n          locations = np.argwhere(planning_grid[:, :, prim_kind] > 0)\n          if locations.size == 0:\n              # No more of this primitive available; abort collection loop\n              break\n          # Choose the nearest primitive (Manhattan distance)\n          dists = np.abs(locations - cur_pos).sum(axis=1)\n          nearest_idx = int(np.argmin(dists))\n          target_cell = locations[nearest_idx].tolist()\n\n          # Move to the primitive cell and pick it up\n          _move_to(target_cell)\n          actions.append(action_map[\"USE\"])\n\n          # Update planning grid: primitive is now removed from the map\n          planning_grid[target_cell[0], target_cell[1], prim_kind] = 0\n\n  # ------------------------------------------------------------------\n  # 2. Go to the required workshop (if any) and craft the goal item\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n\n  if workshop_kind is not None:\n      # Locate a workshop of the required type\n      workshop_cells = np.argwhere(planning_grid[:, :, workshop_kind] > 0)\n      if workshop_cells.size > 0:\n          dists = np.abs(workshop_cells - cur_pos).sum(axis=1)\n          nearest_ws = int(np.argmin(dists))\n          ws_target = workshop_cells[nearest_ws].tolist()\n          _move_to(ws_target)\n          actions.append(action_map[\"USE\"])\n  else:\n      # No specific workshop required; just use the current location to craft\n      actions.append(action_map[\"USE\"])\n\n  return actions", "env_interactions": 1, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:16:44.106638", "function_name": "make_stick", "function_body": "  # Obtain the action identifiers; fall back to the default ordering if unavailable.\n  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      action_ids = [0, 1, 2, 3, 4]  # DOWN, UP, LEFT, RIGHT, USE\n\n  # Resolve the internal index for the target item \"stick\".\n  try:\n      target_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      target_idx = env.world.cookbook.index.get(\"stick\")\n  if target_idx is None:\n      # No stick recipe in this world \u2013 nothing to do.\n      return []\n\n  # Ensure we have a fresh state to start planning from.\n  if not hasattr(env, \"_current_state\") or env._current_state is None:\n      env.reset()\n  start_state = env._current_state\n\n  # If we already possess a stick, no actions are required.\n  if start_state.inventory[target_idx] > 0:\n      return []\n\n  from collections import deque\n\n  # Create a hashable representation of a state for the visited set.\n  def _state_key(st):\n      # Position, direction, inventory, and grid together uniquely identify a state.\n      return (st.pos, st.dir, st.inventory.tobytes(), st.grid.tobytes())\n\n  visited = {_state_key(start_state)}\n  frontier = deque()\n  frontier.append((start_state, []))\n\n  # Upper bound on plan length to keep the search tractable.\n  MAX_PLAN_LENGTH = 500\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      # Goal test: have at least one stick in the inventory.\n      if cur_state.inventory[target_idx] > 0:\n          return cur_plan\n\n      # Do not expand beyond the maximum allowed depth.\n      if len(cur_plan) >= MAX_PLAN_LENGTH:\n          continue\n\n      # Explore all possible actions from the current state.\n      for a in action_ids:\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((next_state, cur_plan + [a]))\n\n  # No feasible plan found within limits.\n  return []", "env_interactions": 4, "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T21:16:45.225701", "function_name": "make_stick", "function_body": "  # Retrieve the list of action IDs from the environment (fallback to default ordering).\n  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      action_ids = [0, 1, 2, 3, 4]  # DOWN, UP, LEFT, RIGHT, USE\n\n  # Resolve the internal index for the target item \"stick\".\n  try:\n      target_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      target_idx = env.world.cookbook.index.get(\"stick\")\n  if target_idx is None:\n      # No stick recipe in this world \u2013 nothing to do.\n      return []\n\n  # Ensure the environment has a current state (reset if necessary).\n  if not hasattr(env, \"_current_state\") or env._current_state is None:\n      env.reset()\n  start_state = env._current_state\n\n  # If we already have a stick, no actions are required.\n  if start_state.inventory[target_idx] > 0:\n      return []\n\n  from collections import deque\n\n  # Helper to create a hashable representation of a state for the visited set.\n  def _state_key(st):\n      # Position, direction, inventory snapshot, and grid snapshot uniquely identify a state.\n      return (st.pos, st.dir, st.inventory.tobytes(), st.grid.tobytes())\n\n  visited = {_state_key(start_state)}\n  frontier = deque()\n  frontier.append((start_state, []))\n\n  # Upper bound on plan length to keep the search tractable.\n  MAX_PLAN_LENGTH = 300\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      # Goal test: have at least one stick in the inventory.\n      if cur_state.inventory[target_idx] > 0:\n          return cur_plan\n\n      # Do not expand beyond the maximum allowed depth.\n      if len(cur_plan) >= MAX_PLAN_LENGTH:\n          continue\n\n      # Explore all possible actions from the current state.\n      for a in action_ids:\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((next_state, cur_plan + [a]))\n\n  # No feasible plan was found within the limits.\n  return []", "env_interactions": 4, "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T21:16:56.256309", "function_name": "make_stick", "function_body": "  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      action_ids = [0, 1, 2, 3, 4]\n\n  # Resolve the index for the target item \"stick\"\n  try:\n      target_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      target_idx = env.world.cookbook.index.get(\"stick\")\n  if target_idx is None:\n      return []\n\n  # Ensure the environment has an initialized state\n  if not hasattr(env, \"_current_state\") or env._current_state is None:\n      env.reset()\n  start_state = env._current_state\n\n  # Goal already satisfied?\n  if start_state.inventory[target_idx] > 0:\n      return []\n\n  from collections import deque\n\n  # Unique identifier for a state (position, direction, inventory, grid)\n  def _state_key(st):\n      return (st.pos, st.dir, st.inventory.tobytes(), st.grid.tobytes())\n\n  visited = {_state_key(start_state)}\n  frontier = deque([(start_state, [])])\n  MAX_PLAN_LEN = 500\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      if cur_state.inventory[target_idx] > 0:\n          return cur_plan\n\n      if len(cur_plan) >= MAX_PLAN_LEN:\n          continue\n\n      for a in action_ids:\n          _, nxt_state = cur_state.step(a)\n          key = _state_key(nxt_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((nxt_state, cur_plan + [a]))\n\n  # No feasible plan found within limits\n  return []", "env_interactions": 4, "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T21:16:57.374228", "function_name": "make_stick", "function_body": "  # Determine action IDs (order may vary across environments)\n  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      # Fallback to default ordering used in CraftWorld\n      action_ids = [0, 1, 2, 3, 4]  # DOWN, UP, LEFT, RIGHT, USE\n\n  # Resolve the index for the target item \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n  if stick_idx is None:\n      return []  # No stick defined in this world\n\n  # Ensure the environment has been reset and a current state is available\n  if not hasattr(env, \"_current_state\") or env._current_state is None:\n      env.reset()\n  start_state = env._current_state\n\n  # If we already possess a stick, no actions are needed\n  if start_state.inventory[stick_idx] > 0:\n      return []\n\n  from collections import deque\n\n  # Helper to create a hashable key for a state (position, direction, inventory, grid)\n  def _state_key(st):\n      return (st.pos, st.dir, st.inventory.tobytes(), st.grid.tobytes())\n\n  visited = {_state_key(start_state)}\n  frontier = deque()\n  frontier.append((start_state, []))\n\n  # Upper bound on plan length to keep search tractable\n  MAX_PLAN_LEN = 500\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      # Goal test: have at least one stick in inventory\n      if cur_state.inventory[stick_idx] > 0:\n          return cur_plan\n\n      if len(cur_plan) >= MAX_PLAN_LEN:\n          continue\n\n      # Expand all possible actions\n      for a in action_ids:\n          _, nxt_state = cur_state.step(a)\n          key = _state_key(nxt_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((nxt_state, cur_plan + [a]))\n\n  # No feasible plan found within limits\n  return []", "env_interactions": 4, "island_id": 7, "scores": {"3": 1.5}}
