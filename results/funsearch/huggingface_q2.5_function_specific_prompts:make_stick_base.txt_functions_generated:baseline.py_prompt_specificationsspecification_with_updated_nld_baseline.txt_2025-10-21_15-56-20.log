{"timestamp": "2025-10-21T16:19:56.853882", "function_name": "make_stick", "function_body": "  # Reset the environment and obtain the initial state.\n  env.reset()\n  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n  idx = cookbook.index\n\n  # Identify the index for the target item \"stick\".\n  stick_idx = idx[\"stick\"]\n\n  # Determine which primitive items are required to craft a stick.\n  prim_counts = cookbook.primitives_for(stick_idx)\n  # If there is no recipe, treat the stick itself as a primitive to collect.\n  needed = dict(prim_counts) if prim_counts else {stick_idx: 1}\n\n  # Action specifications (maps names like \"DOWN\" to integer codes).\n  action_spec = env.action_specs()\n  USE = action_spec[\"USE\"]\n  # Movement actions and their (dx, dy) offsets.\n  moves = {\n      action_spec.get(\"DOWN\"):  (0, 1),\n      action_spec.get(\"UP\"):    (0, -1),\n      action_spec.get(\"LEFT\"):  (-1, 0),\n      action_spec.get(\"RIGHT\"): (1, 0),\n  }\n  move_actions = [a for a in moves if a is not None]\n\n  actions = []\n  max_steps = 2000\n  steps = 0\n\n  # Helper: breadth\u2011first search for a path to the nearest cell containing `target_kind`.\n  from collections import deque\n\n  def bfs(start_pos, target_kind):\n      w, h = state.grid.shape[0], state.grid.shape[1]\n      visited = set()\n      q = deque()\n      q.append((start_pos, []))\n      visited.add(start_pos)\n\n      while q:\n          (x, y), path = q.popleft()\n          # If this cell already holds the desired kind, we are done.\n          if state.grid[x, y, target_kind] > 0:\n              return path\n          for act in move_actions:\n              dx, dy = moves[act]\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < w and 0 <= ny < h):\n                  continue\n              npos = (nx, ny)\n              if npos in visited:\n                  continue\n              # A cell is traversable if it is empty or contains the target kind.\n              cell = state.grid[nx, ny, :]\n              if cell.sum() > 0 and cell[target_kind] == 0:\n                  continue\n              visited.add(npos)\n              q.append((npos, path + [act]))\n      return None\n\n  # Main planning loop.\n  while steps < max_steps:\n      # Success condition: we already hold a stick.\n      if state.inventory[stick_idx] > 0:\n          break\n\n      # Determine which primitive (or the stick itself) we still need to collect.\n      target_kind = None\n      for kind, needed_cnt in needed.items():\n          if state.inventory[kind] < needed_cnt:\n              target_kind = kind\n              break\n\n      if target_kind is not None:\n          # Find a path to the nearest instance of the required primitive.\n          path = bfs(state.pos, target_kind)\n          if path is None:\n              # Unable to locate the required item; abort.\n              break\n          for act in path:\n              actions.append(act)\n              reward, done, _ = env.step(act)\n              state = env._current_state\n              steps += 1\n              if steps >= max_steps:\n                  break\n          if steps >= max_steps:\n              break\n          # Use the item (collect it).\n          actions.append(USE)\n          reward, done, _ = env.step(USE)\n          state = env._current_state\n          steps += 1\n          continue\n\n      # All required primitives have been gathered; now craft the stick.\n      recipe = cookbook.recipes.get(stick_idx, {})\n      workshop_kind = recipe.get(\"_at\")\n      if workshop_kind is None:\n          # No specific workshop \u2013 just try to use (may auto\u2011craft).\n          actions.append(USE)\n          reward, done, _ = env.step(USE)\n          state = env._current_state\n          steps += 1\n          continue\n\n      # Navigate to a workshop of the appropriate type.\n      path = bfs(state.pos, workshop_kind)\n      if path is None:\n          break\n      for act in path:\n          actions.append(act)\n          reward, done, _ = env.step(act)\n          state = env._current_state\n          steps += 1\n          if steps >= max_steps:\n              break\n      if steps >= max_steps:\n          break\n      # Craft at the workshop.\n      actions.append(USE)\n      reward, done, _ = env.step(USE)\n      state = env._current_state\n      steps += 1\n\n  return actions", "env_interactions": 0, "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-10-21T16:25:28.473150", "function_name": "make_stick", "function_body": "  # constants for actions\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  def _move_actions(start, target):\n      \"\"\"Return a list of movement actions to go from start to target.\"\"\"\n      sx, sy = start\n      tx, ty = target\n      actions = []\n      # move in x direction\n      while sx < tx:\n          actions.append(RIGHT)\n          sx += 1\n      while sx > tx:\n          actions.append(LEFT)\n          sx -= 1\n      # move in y direction\n      while sy < ty:\n          actions.append(DOWN)\n          sy += 1\n      while sy > ty:\n          actions.append(UP)\n          sy -= 1\n      return actions\n\n  # get index for the goal item \"stick\"\n  goal_name = \"stick\"\n  goal_idx = env.world.cookbook.index[goal_name]\n\n  # primitive requirements for one stick\n  primitive_req = env.world.cookbook.primitives_for(goal_idx)\n\n  # workshop requirement (if any) from the recipe\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  workshop_idx = None\n  if workshop_name is not None:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n\n  action_seq = []\n\n  # main planning loop\n  while not env._current_state.satisfies(goal_name, goal_idx):\n      # ----- collect missing primitives -----\n      inv = env._current_state.inventory\n      missing = {}\n      for prim_idx, need_cnt in primitive_req.items():\n          have = inv[prim_idx]\n          if have < need_cnt:\n              missing[prim_idx] = need_cnt - have\n\n      if missing:\n          # pick one missing primitive (arbitrary choice)\n          prim_idx, _ = next(iter(missing.items()))\n          grid_layer = env._current_state.grid[:, :, prim_idx]\n          positions = np.argwhere(grid_layer > 0)\n          if positions.size == 0:\n              raise RuntimeError(\"Required primitive not present on the map.\")\n          cur_pos = env._current_state.pos\n          # choose nearest occurrence (Manhattan distance)\n          dists = np.abs(positions - np.array(cur_pos)).sum(axis=1)\n          target_pos = tuple(positions[dists.argmin()])\n          # move to the primitive cell\n          moves = _move_actions(cur_pos, target_pos)\n          for a in moves:\n              env.step(a)\n              action_seq.append(a)\n          # collect it\n          env.step(USE)\n          action_seq.append(USE)\n          continue  # re-evaluate missing primitives\n\n      # ----- all primitives are available, go to workshop (if needed) -----\n      if workshop_idx is not None:\n          # find any workshop cell\n          workshop_layer = env._current_state.grid[:, :, workshop_idx]\n          ws_positions = np.argwhere(workshop_layer > 0)\n          if ws_positions.size == 0:\n              raise RuntimeError(\"Required workshop not present on the map.\")\n          cur_pos = env._current_state.pos\n          dists = np.abs(ws_positions - np.array(cur_pos)).sum(axis=1)\n          ws_target = tuple(ws_positions[dists.argmin()])\n          moves = _move_actions(cur_pos, ws_target)\n          for a in moves:\n              env.step(a)\n              action_seq.append(a)\n\n      # ----- attempt to craft the stick -----\n      env.step(USE)\n      action_seq.append(USE)\n\n  return action_seq", "env_interactions": 0, "island_id": 1, "scores": {"3": -1}}
