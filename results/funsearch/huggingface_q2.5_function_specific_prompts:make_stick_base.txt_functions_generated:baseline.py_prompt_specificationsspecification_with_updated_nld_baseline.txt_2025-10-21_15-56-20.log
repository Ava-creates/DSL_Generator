{"timestamp": "2025-10-21T21:23:26.623226", "function_name": "make_stick", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ----------------------------------------------------------------------\n  # Helper utilities\n  # ----------------------------------------------------------------------\n  try:\n      ACTION = env.action_specs()\n  except Exception:\n      ACTION = {\"DOWN\": 0, \"UP\": 1, \"LEFT\": 2, \"RIGHT\": 3, \"USE\": 4}\n\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  width, height = state.grid.shape[0], state.grid.shape[1]\n\n  def in_bounds(x, y):\n      return 0 <= x < width and 0 <= y < height\n\n  def nearest_cell(start, kind):\n      \"\"\"Return coordinates (x, y) of the closest cell containing `kind`.\"\"\"\n      layer = state.grid[:, :, kind]\n      ys, xs = np.where(layer > 0)\n      if len(xs) == 0:\n          return None\n      dists = np.abs(xs - start[0]) + np.abs(ys - start[1])\n      i = int(np.argmin(dists))\n      return (int(xs[i]), int(ys[i]))\n\n  def bfs_path(start, goal, target_kind=None):\n      \"\"\"\n      Shortest\u2011path actions from `start` to `goal` avoiding occupied cells.\n      `target_kind` \u2013 if given, the goal cell may be occupied by that kind.\n      \"\"\"\n      moves = [\n          (1, 0, ACTION[\"RIGHT\"]),\n          (-1, 0, ACTION[\"LEFT\"]),\n          (0, 1, ACTION[\"DOWN\"]),\n          (0, -1, ACTION[\"UP\"]),\n      ]\n      queue = deque()\n      queue.append((start, []))\n      visited = {start}\n\n      while queue:\n          (x, y), path = queue.popleft()\n          if (x, y) == goal:\n              return path\n          for dx, dy, act in moves:\n              nx, ny = x + dx, y + dy\n              if not in_bounds(nx, ny):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              occupied = state.grid[nx, ny, :].sum()\n              if occupied == 0 or (target_kind is not None and state.grid[nx, ny, target_kind] > 0):\n                  visited.add((nx, ny))\n                  queue.append(((nx, ny), path + [act]))\n      # Fallback: simple Manhattan moves (ignores obstacles)\n      seq = []\n      x, y = start\n      tx, ty = goal\n      while x != tx:\n          if tx > x:\n              seq.append(ACTION[\"RIGHT\"])\n              x += 1\n          else:\n              seq.append(ACTION[\"LEFT\"])\n              x -= 1\n      while y != ty:\n          if ty > y:\n              seq.append(ACTION[\"DOWN\"])\n              y += 1\n          else:\n              seq.append(ACTION[\"UP\"])\n              y -= 1\n      return seq\n\n  # ----------------------------------------------------------------------\n  # Planning\n  # ----------------------------------------------------------------------\n  plan = []\n  cur_pos = state.pos\n\n  # 1. Determine primitives needed for a stick\n  stick_idx = idx[\"stick\"]\n  needed = world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n\n  # 2. Collect each required primitive\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = nearest_cell(cur_pos, prim_idx)\n          if target is None:\n              # Primitive not present \u2013 should not happen in a valid scenario\n              continue\n          plan.extend(bfs_path(cur_pos, target, target_kind=prim_idx))\n          plan.append(ACTION[\"USE\"])          # pick up the primitive\n          cur_pos = target\n\n  # 3. Move to the workshop (if the recipe specifies one) and craft\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop = recipe.get(\"_at\")\n  if workshop is not None:\n      wk_idx = idx[workshop] if isinstance(workshop, str) else workshop\n      wk_pos = nearest_cell(cur_pos, wk_idx)\n      if wk_pos is not None:\n          plan.extend(bfs_path(cur_pos, wk_pos, target_kind=wk_idx))\n          cur_pos = wk_pos\n\n  # 4. Final USE performs the crafting action\n  plan.append(ACTION[\"USE\"])\n\n  return plan", "env_interactions": 4, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:23:54.855532", "function_name": "make_stick", "function_body": "  ACTION = env.action_specs()\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  # ------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------\n  def find_nearest(pos, kind, grid):\n      \"\"\"Return (x, y) of the closest cell containing the given kind.\"\"\"\n      layer = grid[:, :, kind]\n      ys, xs = np.where(layer > 0)\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - pos[0]) + np.abs(ys - pos[1])\n      i = int(np.argmin(dists))\n      return (int(xs[i]), int(ys[i]))\n\n  def bfs_path(start, goal, grid):\n      \"\"\"Shortest Manhattan path from start to goal avoiding occupied cells (except goal).\"\"\"\n      if start == goal:\n          return [start]\n      W, H, _ = grid.shape\n      visited = np.full((W, H), False, dtype=bool)\n      prev = {}\n      q = collections.deque([start])\n      visited[start[0], start[1]] = True\n\n      while q:\n          x, y = q.popleft()\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < W and 0 <= ny < H):\n                  continue\n              if visited[nx, ny]:\n                  continue\n              # allow stepping onto the goal even if occupied\n              if (nx, ny) != goal and grid[nx, ny].any():\n                  continue\n              visited[nx, ny] = True\n              prev[(nx, ny)] = (x, y)\n              if (nx, ny) == goal:\n                  # reconstruct path\n                  path = [(nx, ny)]\n                  while path[-1] != start:\n                      path.append(prev[path[-1]])\n                  path.reverse()\n                  return path\n              q.append((nx, ny))\n      return None  # no path found\n\n  def actions_from_path(path):\n      \"\"\"Translate a list of positions into a list of action indices.\"\"\"\n      seq = []\n      for (x0, y0), (x1, y1) in zip(path, path[1:]):\n          if x1 > x0:\n              seq.append(ACTION[\"RIGHT\"])\n          elif x1 < x0:\n              seq.append(ACTION[\"LEFT\"])\n          elif y1 > y0:\n              seq.append(ACTION[\"DOWN\"])\n          elif y1 < y0:\n              seq.append(ACTION[\"UP\"])\n      return seq\n\n  # ------------------------------------------------------------\n  # Determine what is needed to craft a stick\n  # ------------------------------------------------------------\n  stick_idx = idx[\"stick\"]\n  needed = world.cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n\n  # Work on a copy of the grid to simulate pickups\n  grid = state.grid.copy()\n  cur_pos = tuple(state.pos)\n  plan = []\n\n  # ------------------------------------------------------------\n  # Collect each required primitive\n  # ------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = find_nearest(cur_pos, prim_idx, grid)\n          if target is None:\n              # Primitive missing \u2013 abort planning\n              return []\n          path = bfs_path(cur_pos, target, grid)\n          if path is None:\n              # Unreachable \u2013 abort planning\n              return []\n          plan.extend(actions_from_path(path))\n          plan.append(ACTION[\"USE\"])        # pick up the primitive\n          # simulate removal of the primitive from the world\n          grid[target[0], target[1], prim_idx] = 0\n          cur_pos = target\n\n  # ------------------------------------------------------------\n  # Move to workshop (if recipe specifies one) and craft the stick\n  # ------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      wk_idx = idx[workshop_name] if isinstance(workshop_name, str) else workshop_name\n      wk_pos = find_nearest(cur_pos, wk_idx, grid)\n      if wk_pos is not None:\n          path = bfs_path(cur_pos, wk_pos, grid)\n          if path is not None:\n              plan.extend(actions_from_path(path))\n              cur_pos = wk_pos\n\n  # Final USE to actually craft the stick\n  plan.append(ACTION[\"USE\"])\n\n  return plan", "env_interactions": 4, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:23:55.972935", "function_name": "make_stick", "function_body": "  ACTION = env.action_specs()\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  # ------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------\n  def find_nearest(pos, kind, grid):\n      \"\"\"Return (x, y) of the closest cell containing the given kind.\"\"\"\n      layer = grid[:, :, kind]\n      ys, xs = np.where(layer > 0)\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - pos[0]) + np.abs(ys - pos[1])\n      i = int(np.argmin(dists))\n      return (int(xs[i]), int(ys[i]))\n\n  def bfs_path(start, goal, grid):\n      \"\"\"Shortest Manhattan path from start to goal avoiding occupied cells (except goal).\"\"\"\n      if start == goal:\n          return [start]\n      W, H, _ = grid.shape\n      visited = np.full((W, H), False, dtype=bool)\n      prev = {}\n      q = collections.deque([start])\n      visited[start[0], start[1]] = True\n\n      while q:\n          x, y = q.popleft()\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < W and 0 <= ny < H):\n                  continue\n              if visited[nx, ny]:\n                  continue\n              # allow moving onto the goal even if occupied\n              if (nx, ny) != goal and grid[nx, ny].any():\n                  continue\n              visited[nx, ny] = True\n              prev[(nx, ny)] = (x, y)\n              if (nx, ny) == goal:\n                  # reconstruct path\n                  path = [(nx, ny)]\n                  while path[-1] != start:\n                      path.append(prev[path[-1]])\n                  path.reverse()\n                  return path\n              q.append((nx, ny))\n      return None  # no path found\n\n  def actions_from_path(path):\n      \"\"\"Translate a list of positions into a list of action indices.\"\"\"\n      seq = []\n      for (x0, y0), (x1, y1) in zip(path, path[1:]):\n          if x1 > x0:\n              seq.append(ACTION[\"RIGHT\"])\n          elif x1 < x0:\n              seq.append(ACTION[\"LEFT\"])\n          elif y1 > y0:\n              seq.append(ACTION[\"DOWN\"])\n          elif y1 < y0:\n              seq.append(ACTION[\"UP\"])\n      return seq\n\n  # ------------------------------------------------------------\n  # Determine what is needed to craft a stick\n  # ------------------------------------------------------------\n  stick_idx = idx[\"stick\"]\n  needed = world.cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n\n  # Work on a copy of the grid to simulate pickups\n  grid = state.grid.copy()\n  cur_pos = tuple(state.pos)\n  plan = []\n\n  # ------------------------------------------------------------\n  # Collect each required primitive\n  # ------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = find_nearest(cur_pos, prim_idx, grid)\n          if target is None:\n              # primitive missing \u2013 abort planning\n              return []\n          path = bfs_path(cur_pos, target, grid)\n          if path is None:\n              # unreachable \u2013 abort planning\n              return []\n          plan.extend(actions_from_path(path))\n          plan.append(ACTION[\"USE\"])        # pick up the primitive\n          # simulate removal of the primitive from the world\n          grid[target[0], target[1], prim_idx] = 0\n          cur_pos = target\n\n  # ------------------------------------------------------------\n  # Move to workshop (if recipe specifies one) and craft the stick\n  # ------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      wk_idx = idx[workshop_name] if isinstance(workshop_name, str) else workshop_name\n      wk_pos = find_nearest(cur_pos, wk_idx, grid)\n      if wk_pos is not None:\n          path = bfs_path(cur_pos, wk_pos, grid)\n          if path is not None:\n              plan.extend(actions_from_path(path))\n              cur_pos = wk_pos\n\n  # Final USE to actually craft the stick\n  plan.append(ACTION[\"USE\"])\n\n  return plan", "env_interactions": 4, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:24:14.332310", "function_name": "make_stick", "function_body": "  actions = []\n  # Reset environment to start fresh and fetch current state/world\n  env.reset()\n  state = env._current_state\n  world = env.world\n\n  # Index of the target item \"stick\"\n  stick_idx = world.cookbook.index[\"stick\"]\n  if state.inventory[stick_idx] > 0:\n      return actions\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def move_action(cur, nxt):\n      \"\"\"Translate a step (cur \u2192 nxt) into a DMLab action index.\"\"\"\n      dx = nxt[0] - cur[0]\n      dy = nxt[1] - cur[1]\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise ValueError(\"Invalid move step\")\n\n  def bfs_to_adjacent(start, targets, grid):\n      \"\"\"\n      Bread\u2011first search for the shortest path from ``start`` to any empty\n      cell orthogonally adjacent to one of the ``targets`` cells.\n      Returns a list of positions (including ``start``).\n      \"\"\"\n      W, H, _ = grid.shape\n      visited = np.zeros((W, H), dtype=bool)\n      q = collections.deque()\n      q.append((start, [start]))\n      visited[start] = True\n      target_set = {tuple(t) for t in targets}\n      while q:\n          pos, path = q.popleft()\n          # Stop if adjacent to any target cell\n          for tx, ty in target_set:\n              if abs(pos[0] - tx) + abs(pos[1] - ty) == 1:\n                  return path\n          # Expand neighbours (only through empty cells)\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if grid[nx, ny, :].sum() == 0:   # empty cell\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [(nx, ny)]))\n      raise RuntimeError(\"No reachable adjacent cell found\")\n\n  # ------------------------------------------------------------------\n  # 1) Collect all primitives required for a stick.\n  # ------------------------------------------------------------------\n  primitive_reqs = world.cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n  cur_pos = tuple(state.pos)\n\n  for prim_idx, needed in primitive_reqs.items():\n      for _ in range(needed):\n          # If we already have the primitive, skip.\n          if state.inventory[prim_idx] > 0:\n              continue\n          # Locate all cells that currently contain this primitive.\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(f\"Primitive {prim_idx} not found in world\")\n          # Plan a path to a free cell adjacent to any of those locations.\n          path = bfs_to_adjacent(cur_pos, prim_cells, state.grid)\n          # Convert the path into actions.\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n          # Pick up the primitive.\n          actions.append(4)   # USE\n          # Update the temporary planning state.\n          state.grid[cur_pos[0], cur_pos[1], prim_idx] = 0\n          state.inventory[prim_idx] += 1\n\n  # ------------------------------------------------------------------\n  # 2) Move to the workshop and craft the stick.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      raise RuntimeError(\"Stick recipe missing workshop specification\")\n  workshop_idx = world.cookbook.index[workshop_name]\n\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      raise RuntimeError(\"Workshop cell for stick not present in world\")\n  path = bfs_to_adjacent(cur_pos, workshop_cells, state.grid)\n  for step in path[1:]:\n      actions.append(move_action(cur_pos, step))\n      cur_pos = step\n\n  # Final USE to craft the stick at the workshop.\n  actions.append(4)   # USE\n\n  return actions", "env_interactions": 5, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-21T21:24:15.445904", "function_name": "make_stick", "function_body": "  actions = []\n  env.reset()\n  state = env._current_state\n  world = env.world\n\n  stick_idx = world.cookbook.index[\"stick\"]\n  if state.inventory[stick_idx] > 0:\n      return actions\n\n  # --------------------------------------------------------------\n  # Helper utilities\n  # --------------------------------------------------------------\n  def move_action(cur, nxt):\n      \"\"\"Convert a step (cur \u2192 nxt) into a DMLab action index.\"\"\"\n      dx = nxt[0] - cur[0]\n      dy = nxt[1] - cur[1]\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise ValueError(\"Invalid move step\")\n\n  def bfs_to_adjacent(start, targets, grid):\n      \"\"\"\n      Bread\u2011first search for the shortest path from `start` to any empty cell\n      orthogonally adjacent to one of the `targets` cells.\n      Returns a list of positions (including the start).\n      \"\"\"\n      W, H, _ = grid.shape\n      visited = np.zeros((W, H), dtype=bool)\n      q = collections.deque()\n      q.append((start, [start]))\n      visited[start] = True\n      target_set = {tuple(t) for t in targets}\n      while q:\n          pos, path = q.popleft()\n          # If adjacent to any target, stop\n          for tx, ty in target_set:\n              if abs(pos[0] - tx) + abs(pos[1] - ty) == 1:\n                  return path\n          # Expand neighbours (only through empty cells)\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if grid[nx, ny, :].sum() == 0:      # empty cell\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [(nx, ny)]))\n      raise RuntimeError(\"No reachable adjacent cell found\")\n\n  # --------------------------------------------------------------\n  # 1) Gather required primitives for a stick\n  # --------------------------------------------------------------\n  primitive_reqs = world.cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n  cur_pos = tuple(state.pos)\n\n  for prim_idx, needed in primitive_reqs.items():\n      for _ in range(needed):\n          # Skip if already have this primitive\n          if state.inventory[prim_idx] > 0:\n              continue\n          # Locate cells containing the primitive\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(f\"Primitive {prim_idx} not found in world\")\n          # Plan path to an empty cell adjacent to a primitive cell\n          path = bfs_to_adjacent(cur_pos, prim_cells, state.grid)\n          # Translate path into actions\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n          # Pick up the primitive\n          actions.append(4)   # USE\n          # Update temporary planning state\n          state.grid[cur_pos[0], cur_pos[1], prim_idx] = 0\n          state.inventory[prim_idx] += 1\n\n  # --------------------------------------------------------------\n  # 2) Move to the workshop and craft the stick\n  # --------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      raise RuntimeError(\"Stick recipe does not specify a workshop\")\n  workshop_idx = world.cookbook.index[workshop_name]\n\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      raise RuntimeError(\"Workshop for stick not found in the world\")\n  path = bfs_to_adjacent(cur_pos, workshop_cells, state.grid)\n  for step in path[1:]:\n      actions.append(move_action(cur_pos, step))\n      cur_pos = step\n\n  # Final USE to craft the stick at the workshop\n  actions.append(4)   # USE\n\n  return actions", "env_interactions": 5, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-21T21:24:55.518444", "function_name": "make_stick", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ----------------------------------------------------------------------\n  # Environment utilities\n  # ----------------------------------------------------------------------\n  ACTION = env.action_specs()                     # name \u2192 int\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  # ----------------------------------------------------------------------\n  # Helper functions\n  # ----------------------------------------------------------------------\n  def find_nearest(pos, kind, grid):\n      \"\"\"Return (x, y) of the closest cell containing the given kind.\"\"\"\n      layer = grid[:, :, kind]\n      ys, xs = np.where(layer > 0)\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - pos[0]) + np.abs(ys - pos[1])\n      i = int(np.argmin(dists))\n      return (int(xs[i]), int(ys[i]))\n\n  def bfs_path(start, goal, grid):\n      \"\"\"\n      Shortest path from start to goal avoiding occupied cells.\n      Allows stepping onto the goal even if it is occupied.\n      Returns list of positions (including start and goal) or None.\n      \"\"\"\n      if start == goal:\n          return [start]\n      W, H, _ = grid.shape\n      visited = np.full((W, H), False, dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start[0], start[1]] = True\n\n      while q:\n          x, y = q.popleft()\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < W and 0 <= ny < H):\n                  continue\n              if visited[nx, ny]:\n                  continue\n              # Disallow stepping onto occupied cells, except the goal\n              if (nx, ny) != goal and grid[nx, ny].any():\n                  continue\n              visited[nx, ny] = True\n              prev[(nx, ny)] = (x, y)\n              if (nx, ny) == goal:\n                  # reconstruct path\n                  path = [(nx, ny)]\n                  while path[-1] != start:\n                      path.append(prev[path[-1]])\n                  path.reverse()\n                  return path\n              q.append((nx, ny))\n      return None\n\n  def actions_from_path(path):\n      \"\"\"Translate a list of positions into a list of action indices.\"\"\"\n      seq = []\n      for (x0, y0), (x1, y1) in zip(path, path[1:]):\n          if x1 > x0:\n              seq.append(ACTION[\"RIGHT\"])\n          elif x1 < x0:\n              seq.append(ACTION[\"LEFT\"])\n          elif y1 > y0:\n              seq.append(ACTION[\"DOWN\"])\n          elif y1 < y0:\n              seq.append(ACTION[\"UP\"])\n      return seq\n\n  # ----------------------------------------------------------------------\n  # Determine the goal (stick) and its recipe\n  # ----------------------------------------------------------------------\n  try:\n      goal_idx = env.task.goal\n      if not isinstance(goal_idx, int):\n          goal_idx = idx[goal_idx]\n  except Exception:\n      goal_idx = idx[\"stick\"]\n\n  # ----------------------------------------------------------------------\n  # Determine primitives required to craft the stick\n  # ----------------------------------------------------------------------\n  needed = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # Working copy of the grid to simulate pickups\n  grid = state.grid.copy()\n  plan = []\n  cur_pos = tuple(state.pos)\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive\n  # ----------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = find_nearest(cur_pos, prim_idx, grid)\n          if target is None:\n              # Primitive missing \u2013 abort plan\n              return []\n          path = bfs_path(cur_pos, target, grid)\n          if path is None:\n              # Unreachable \u2013 abort plan\n              return []\n          plan.extend(actions_from_path(path))\n          plan.append(ACTION[\"USE\"])        # pick up the primitive\n          # Simulate removal of the primitive from the world\n          grid[target[0], target[1], prim_idx] = 0\n          cur_pos = target\n\n  # ----------------------------------------------------------------------\n  # Move to workshop (if recipe specifies one) and craft the stick\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      # workshop may be given as a string name or directly as an index\n      wk_idx = idx[workshop_name] if isinstance(workshop_name, str) else workshop_name\n      wk_pos = find_nearest(cur_pos, wk_idx, grid)\n      if wk_pos is not None:\n          path = bfs_path(cur_pos, wk_pos, grid)\n          if path is not None:\n              plan.extend(actions_from_path(path))\n              cur_pos = wk_pos\n\n  # Final USE to actually craft the stick\n  plan.append(ACTION[\"USE\"])\n\n  return plan", "env_interactions": 1, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:24:56.630513", "function_name": "make_stick", "function_body": "  # Get action indices from the environment\n  action_map = env.action_specs()\n  DOWN = action_map[\"DOWN\"]\n  UP = action_map[\"UP\"]\n  LEFT = action_map[\"LEFT\"]\n  RIGHT = action_map[\"RIGHT\"]\n  USE = action_map[\"USE\"]\n  ACTION_DELTAS = {\n      DOWN:  (0, 1),\n      UP:    (0, -1),\n      LEFT:  (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  # Current state and world information\n  state = env._current_state            # CraftState\n  world = env.world                     # CraftWorld\n  grid = state.grid.copy()              # (W, H, n_kinds)\n  pos = tuple(state.pos)                # (x, y)\n  direction = int(state.dir)            # 0\u20113 (same as action indices)\n\n  # Identify the goal index for \"stick\"\n  try:\n      goal_idx = env.task.goal\n      if not isinstance(goal_idx, int):\n          goal_idx = world.cookbook.index[goal_idx]\n  except Exception:\n      goal_idx = world.cookbook.index[\"stick\"]\n\n  # Recipe information (may contain a workshop requirement)\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n\n  # Primitive requirements for the stick\n  required_primitives = world.cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n\n  # Helper: locate all cells containing a given kind\n  def find_all(kind):\n      coords = np.argwhere(grid[:, :, kind] > 0)\n      return [(int(x), int(y)) for x, y in coords]\n\n  # Helper: BFS to a cell adjacent to any target cell\n  def bfs_to_adjacent(start, targets):\n      W, H, _ = grid.shape\n      visited = np.full((W, H), False, dtype=bool)\n      q = deque()\n      q.append((start, []))\n      visited[start] = True\n      occupied = (grid.sum(axis=2) > 0)\n      while q:\n          (x, y), path = q.popleft()\n          for tx, ty in targets:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path, (tx, ty)\n          for act, (dx, dy) in ACTION_DELTAS.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if not occupied[nx, ny]:\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [act]))\n      return None, None\n\n  plan_actions = []\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive\n  # ------------------------------------------------------------------\n  for prim_kind, needed_cnt in required_primitives.items():\n      collected = 0\n      while collected < needed_cnt:\n          locations = find_all(prim_kind)\n          if not locations:\n              break\n          locations.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          target = locations[0]\n\n          path, _ = bfs_to_adjacent(pos, [target])\n          if path is None:\n              break\n\n          # Follow the path, updating position and direction\n          for a in path:\n              plan_actions.append(a)\n              dx, dy = ACTION_DELTAS[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n              direction = a\n\n          # Determine which direction faces the primitive\n          tx, ty = target\n          if pos[0] == tx and pos[1] + 1 == ty:\n              face_dir = DOWN\n          elif pos[0] == tx and pos[1] - 1 == ty:\n              face_dir = UP\n          elif pos[0] + 1 == tx and pos[1] == ty:\n              face_dir = RIGHT\n          elif pos[0] - 1 == tx and pos[1] == ty:\n              face_dir = LEFT\n          else:\n              face_dir = direction\n\n          # Turn (by attempting to move into the blocked cell) if needed\n          if face_dir != direction:\n              plan_actions.append(face_dir)\n              direction = face_dir\n\n          # Pick up the primitive\n          plan_actions.append(USE)\n          grid[tx, ty, prim_kind] = 0\n          collected += 1\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if required) and craft the stick\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      workshop_cells = find_all(workshop_kind)\n      if workshop_cells:\n          workshop_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          wk_target = workshop_cells[0]\n\n          path, _ = bfs_to_adjacent(pos, [wk_target])\n          if path is not None:\n              for a in path:\n                  plan_actions.append(a)\n                  dx, dy = ACTION_DELTAS[a]\n                  pos = (pos[0] + dx, pos[1] + dy)\n                  direction = a\n\n              wx, wy = wk_target\n              if pos[0] == wx and pos[1] + 1 == wy:\n                  face_dir = DOWN\n              elif pos[0] == wx and pos[1] - 1 == wy:\n                  face_dir = UP\n              elif pos[0] + 1 == wx and pos[1] == wy:\n                  face_dir = RIGHT\n              elif pos[0] - 1 == wx and pos[1] == wy:\n                  face_dir = LEFT\n              else:\n                  face_dir = direction\n\n              if face_dir != direction:\n                  plan_actions.append(face_dir)\n                  direction = face_dir\n\n              plan_actions.append(USE)\n  else:\n      # No workshop needed; final USE crafts the stick\n      plan_actions.append(USE)\n\n  return plan_actions", "env_interactions": 1, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:25:11.265662", "function_name": "make_stick", "function_body": "  # Determine the action indices available in the environment\n  try:\n      actions = list(env.action_specs().values())\n  except Exception:\n      # Fallback to the default ordering (DOWN, UP, LEFT, RIGHT, USE)\n      actions = [0, 1, 2, 3, 4]\n\n  # Resolve the internal index for the target item \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n\n  # Obtain the initial CraftState (lab wrapper may expose it)\n  start_state = getattr(env, \"_current_state\", None)\n  if start_state is None:\n      start_state = env.scenario.init()\n\n  # Helper to create a hashable representation of a state for visited checks\n  def _state_key(st):\n      # Position, direction and inventory uniquely identify the agent's\n      # observable configuration for deterministic dynamics.\n      return (st.pos, st.dir, st.inventory.tobytes())\n\n  from collections import deque\n  frontier = deque()\n  frontier.append((start_state, []))\n  visited = {_state_key(start_state)}\n  MAX_PLAN_LEN = 800  # safety bound on plan length\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      # Goal test: inventory already contains a stick\n      if stick_idx is not None and cur_state.satisfies(\"\", stick_idx):\n          return cur_plan\n\n      # Prune overly long plans\n      if len(cur_plan) >= MAX_PLAN_LEN:\n          continue\n\n      # Expand all possible actions\n      for a in actions:\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((next_state, cur_plan + [a]))\n\n  # No plan found within limits \u2013 return empty list\n  return []", "env_interactions": 4, "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T21:25:12.396082", "function_name": "make_stick", "function_body": "  # Determine the set of possible actions (fallback to default ordering if needed)\n  try:\n      actions = list(env.action_specs().values())\n  except Exception:\n      # Default action order: DOWN, UP, LEFT, RIGHT, USE\n      actions = [0, 1, 2, 3, 4]\n\n  # Resolve the internal index for the target item \"stick\"\n  try:\n      goal_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      goal_idx = env.world.cookbook.index.get(\"stick\")\n\n  # Obtain the starting state (use the lab's internal state if available)\n  start_state = getattr(env, \"_current_state\", None)\n  if start_state is None:\n      start_state = env.scenario.init()\n\n  # Helper to create a hashable representation of a state for visited checks\n  def _state_key(st):\n      # Include position, direction, inventory and full grid layout\n      return (st.pos, st.dir, st.inventory.tobytes(), st.grid.tobytes())\n\n  from collections import deque\n  frontier = deque()\n  frontier.append((start_state, []))\n  visited = {_state_key(start_state)}\n  MAX_PLAN_LEN = 500  # safety bound on plan length\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      # Goal test: inventory already contains a stick\n      if goal_idx is not None and cur_state.satisfies(\"\", goal_idx):\n          return cur_plan\n\n      # Prune overly long plans\n      if len(cur_plan) >= MAX_PLAN_LEN:\n          continue\n\n      # Expand all possible actions\n      for a in actions:\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((next_state, cur_plan + [a]))\n\n  # No plan found within limits \u2013 return empty list\n  return []", "env_interactions": 4, "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T21:25:31.502196", "function_name": "make_stick", "function_body": "  # reset environment and get initial state\n  env.reset()\n  state = env._current_state\n\n  # goal index from the task definition\n  goal_idx = env.task.goal\n\n  # mutable container so inner functions can modify the reference\n  cur_state = [state]\n\n  # ------------------------------------------------------------------\n  # Helper: move from current position to a target cell (Manhattan moves)\n  # ------------------------------------------------------------------\n  def _move_to(target):\n      \"\"\"Return actions that move the agent to *target*.\n      Updates ``cur_state[0]`` as steps are taken.\"\"\"\n      actions = []\n      while tuple(cur_state[0].pos) != tuple(target):\n          r, c = cur_state[0].pos\n          tr, tc = target\n          if r < tr:\n              act = 0          # DOWN\n          elif r > tr:\n              act = 1          # UP\n          elif c < tc:\n              act = 3          # RIGHT\n          else:\n              act = 2          # LEFT\n          actions.append(act)\n          _, new_state = env.step(act)\n          cur_state[0] = new_state\n      return actions\n\n  plan = []\n\n  # --------------------------------------------------------------\n  # 1. Gather all primitive resources required for the goal.\n  # --------------------------------------------------------------\n  required_prims = env.world.cookbook.primitives_for(goal_idx)\n  for prim_idx, cnt in required_prims.items():\n      for _ in range(cnt):\n          # locate all cells containing this primitive\n          locations = np.argwhere(cur_state[0].grid[:, :, prim_idx] > 0)\n          if locations.size == 0:\n              # primitive not present \u2013 abort planning\n              return plan\n          # choose the closest instance (Manhattan distance)\n          cur_pos = np.array(cur_state[0].pos)\n          dists = np.abs(locations - cur_pos).sum(axis=1)\n          target = tuple(locations[dists.argmin()])\n\n          # move to the primitive and pick it up\n          plan.extend(_move_to(target))\n          plan.append(4)          # USE action to collect\n          _, new_state = env.step(4)\n          cur_state[0] = new_state\n\n  # --------------------------------------------------------------\n  # 2. If the recipe requires a workshop, go there and craft.\n  # --------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = recipe.get(\"_at\", None)\n  if workshop_idx is not None:\n      w_locs = np.argwhere(cur_state[0].grid[:, :, workshop_idx] > 0)\n      if w_locs.size > 0:\n          cur_pos = np.array(cur_state[0].pos)\n          dists = np.abs(w_locs - cur_pos).sum(axis=1)\n          target = tuple(w_locs[dists.argmin()])\n\n          plan.extend(_move_to(target))\n          plan.append(4)          # USE to craft at workshop\n          _, new_state = env.step(4)\n          cur_state[0] = new_state\n\n  # return the complete action sequence\n  return plan", "env_interactions": 0, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:25:32.630552", "function_name": "make_stick", "function_body": "  # Reset the environment and get the initial state\n  env.reset()\n  state = env._current_state\n\n  # Index of the goal item (stick)\n  goal_idx = env.task.goal\n\n  # Determine the primitive requirements for the goal (expanded to primitives only)\n  required_prims = env.world.cookbook.primitives_for(goal_idx)\n\n  # List to store the planned actions\n  plan = []\n\n  # Helper to move the agent from its current position to a target cell\n  def _move_to(target):\n      nonlocal state\n      while tuple(state.pos) != target:\n          r, c = state.pos\n          tr, tc = target\n          if r < tr:\n              act = 0  # DOWN\n          elif r > tr:\n              act = 1  # UP\n          elif c < tc:\n              act = 3  # RIGHT\n          else:\n              act = 2  # LEFT\n          plan.append(act)\n          _, new_state = env.step(act)\n          state = new_state\n\n  # --------------------------------------------------------------\n  # 1. Collect each required primitive the necessary number of times.\n  # --------------------------------------------------------------\n  for prim_idx, cnt in required_prims.items():\n      for _ in range(cnt):\n          # Find all cells currently containing this primitive.\n          locations = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if locations.size == 0:\n              # Primitive not present \u2013 abort planning.\n              return plan\n          # Choose the closest instance (Manhattan distance).\n          cur_pos = np.array(state.pos)\n          dists = np.abs(locations - cur_pos).sum(axis=1)\n          target = tuple(locations[dists.argmin()])\n\n          # Move to the primitive and pick it up.\n          _move_to(target)\n          plan.append(4)  # USE action to pick up\n          _, new_state = env.step(4)\n          state = new_state\n\n  # --------------------------------------------------------------\n  # 2. If the recipe specifies a workshop, go there and craft.\n  # --------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = recipe.get('_at')\n  if workshop_idx is not None:\n      # Find workshop locations on the current grid.\n      w_locs = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if w_locs.size > 0:\n          cur_pos = np.array(state.pos)\n          dists = np.abs(w_locs - cur_pos).sum(axis=1)\n          target = tuple(w_locs[dists.argmin()])\n\n          # Move to the workshop and use it to craft the item.\n          _move_to(target)\n          plan.append(4)  # USE to craft\n          _, new_state = env.step(4)\n          state = new_state\n\n  # Return the complete sequence of action indices.\n  return plan", "env_interactions": 0, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:25:49.962787", "function_name": "make_stick", "function_body": "  # Determine action IDs (fallback to default ordering if needed)\n  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      # Default ordering used by CraftWorld: DOWN, UP, LEFT, RIGHT, USE\n      action_ids = [0, 1, 2, 3, 4]\n\n  # Resolve the internal index for the target item \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n  if stick_idx is None:\n      # No stick item in this world \u2013 nothing to do.\n      return []\n\n  # Ensure we have a current state (reset environment if necessary)\n  if not hasattr(env, \"_current_state\") or env._current_state is None:\n      env.reset()\n  start_state = env._current_state\n\n  # If we already possess a stick, return empty plan.\n  if start_state.inventory[stick_idx] > 0:\n      return []\n\n  from collections import deque\n\n  # Helper to uniquely identify a state for visited\u2011set bookkeeping.\n  def _state_key(st):\n      # Position, direction and inventory fully determine future possibilities\n      # (grid is static apart from items we pick up, which is reflected in inventory).\n      return (st.pos, st.dir, st.inventory.tobytes())\n\n  visited = {_state_key(start_state)}\n  frontier = deque()\n  frontier.append((start_state, []))\n\n  MAX_PLAN_LENGTH = 300  # safety bound to keep search tractable\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      # Goal test: have at least one stick in inventory.\n      if cur_state.inventory[stick_idx] > 0:\n          return cur_plan\n\n      # Prune overly long plans.\n      if len(cur_plan) >= MAX_PLAN_LENGTH:\n          continue\n\n      # Expand all possible actions.\n      for a in action_ids:\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((next_state, cur_plan + [a]))\n\n  # No feasible plan found within the limits.\n  return []", "env_interactions": 4, "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T21:25:51.085805", "function_name": "make_stick", "function_body": "  # Determine the list of action IDs (fallback to default ordering if needed)\n  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      # Default ordering used by CraftWorld: DOWN, UP, LEFT, RIGHT, USE\n      action_ids = [0, 1, 2, 3, 4]\n\n  # Resolve the internal index for the target item \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n  if stick_idx is None:\n      # No stick recipe/item in this world \u2013 nothing to do.\n      return []\n\n  # Ensure the environment is reset and obtain the initial state\n  if not hasattr(env, \"_current_state\") or env._current_state is None:\n      env.reset()\n  start_state = env._current_state\n\n  # If we already have a stick, no actions are needed.\n  if start_state.inventory[stick_idx] > 0:\n      return []\n\n  from collections import deque\n\n  # Helper to create a hashable representation of a state.\n  def _state_key(st):\n      # Include position, direction, inventory and full grid layout.\n      # Using bytes representation for fast hashing.\n      return (st.pos, st.dir, st.inventory.tobytes(), st.grid.tobytes())\n\n  visited = {_state_key(start_state)}\n  frontier = deque()\n  frontier.append((start_state, []))\n\n  MAX_PLAN_LENGTH = 500  # safety bound to keep search tractable\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      # Goal test: have at least one stick in inventory.\n      if cur_state.inventory[stick_idx] > 0:\n          return cur_plan\n\n      # Do not expand beyond the maximum allowed depth.\n      if len(cur_plan) >= MAX_PLAN_LENGTH:\n          continue\n\n      # Explore all possible actions from the current state.\n      for a in action_ids:\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((next_state, cur_plan + [a]))\n\n  # No feasible plan found within limits.\n  return []", "env_interactions": 4, "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T21:26:05.627968", "function_name": "make_stick", "function_body": "  # Determine the integer IDs for the actions in the environment.\n  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      # Default ordering used by CraftWorld: DOWN, UP, LEFT, RIGHT, USE\n      action_ids = [0, 1, 2, 3, 4]\n\n  # Resolve the internal index for the target item \"stick\".\n  stick_idx = getattr(env.world.cookbook, \"index\", None)\n  if stick_idx is not None:\n      stick_idx = stick_idx.get(\"stick\")\n  if stick_idx is None:\n      # No stick defined \u2013 nothing to do.\n      return []\n\n  # Ensure the environment has been reset and we have a current state.\n  if not hasattr(env, \"_current_state\") or env._current_state is None:\n      env.reset()\n  start_state = env._current_state\n\n  # If we already have a stick, the plan is empty.\n  if start_state.inventory[stick_idx] > 0:\n      return []\n\n  from collections import deque\n\n  # Helper to create a hashable representation of a state for visited tracking.\n  def _state_key(st):\n      # Include position, direction, inventory and full grid layout.\n      return (st.pos, st.dir, st.inventory.tobytes(), st.grid.tobytes())\n\n  visited = {_state_key(start_state)}\n  frontier = deque()\n  frontier.append((start_state, []))\n\n  # Upper bound on plan length to keep the search tractable.\n  MAX_PLAN_LEN = 400\n\n  # Prefer the USE action when expanding nodes (it is the only one that\n  # changes the inventory), then fall back to movement actions.\n  use_action = env.action_specs().get(\"USE\", 4)\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      # Goal test: have at least one stick in inventory.\n      if cur_state.inventory[stick_idx] > 0:\n          return cur_plan\n\n      # Prune overly long plans.\n      if len(cur_plan) >= MAX_PLAN_LEN:\n          continue\n\n      # Order actions: USE first, then the rest.\n      ordered_actions = sorted(action_ids, key=lambda a: 0 if a == use_action else 1)\n\n      for a in ordered_actions:\n          _, nxt_state = cur_state.step(a)\n          key = _state_key(nxt_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((nxt_state, cur_plan + [a]))\n\n  # No feasible plan found within the limits.\n  return []", "env_interactions": 0, "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-10-21T21:26:06.755750", "function_name": "make_stick", "function_body": "  # Get the mapping of action names to IDs; fall back to the default ordering.\n  try:\n      action_map = env.action_specs()\n      action_ids = list(action_map.values())\n  except Exception:\n      action_ids = [0, 1, 2, 3, 4]          # DOWN, UP, LEFT, RIGHT, USE (default)\n\n  # Resolve the internal index for the target item \u201cstick\u201d.\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n  if stick_idx is None:\n      # Stick not defined \u2013 nothing to do.\n      return []\n\n  # Ensure the environment is reset and we have a current state.\n  if not hasattr(env, \"_current_state\") or env._current_state is None:\n      env.reset()\n  start_state = env._current_state\n\n  # If we already possess a stick, no actions are required.\n  if start_state.inventory[stick_idx] > 0:\n      return []\n\n  from collections import deque\n\n  # Helper to create a hashable representation of a state for visited tracking.\n  def _state_key(st):\n      # Position, direction, inventory contents and full grid layout.\n      return (st.pos, st.dir, st.inventory.tobytes(), st.grid.tobytes())\n\n  visited = {_state_key(start_state)}\n  frontier = deque()\n  frontier.append((start_state, []))\n\n  MAX_PLAN_LEN = 500  # safety bound to keep the search tractable.\n\n  # Prefer the USE action when expanding (it changes inventory).\n  use_id = action_map.get(\"USE\", 4) if 'action_map' in locals() else 4\n  def _action_sort_key(a):\n      return 0 if a == use_id else 1\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      # Goal test: have at least one stick in inventory.\n      if cur_state.inventory[stick_idx] > 0:\n          return cur_plan\n\n      # Prune overly long plans.\n      if len(cur_plan) >= MAX_PLAN_LEN:\n          continue\n\n      # Expand all possible actions (USE first).\n      for a in sorted(action_ids, key=_action_sort_key):\n          _, nxt_state = cur_state.step(a)\n          key = _state_key(nxt_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((nxt_state, cur_plan + [a]))\n\n  # No feasible plan found within the limits.\n  return []", "env_interactions": 4, "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T21:26:39.279355", "function_name": "make_stick", "function_body": "  env.reset()\n  world = env.world\n  scenario = env.scenario\n  grid = scenario.init_grid.copy()\n  goal_idx = env.task.goal\n  action_map = env.action_specs()\n  primitives_needed = world.cookbook.primitives_for(goal_idx)\n  pos = list(scenario.init_pos)\n  actions = []\n\n  from collections import deque\n\n  def _shortest_path(src, tgt):\n      src_t = tuple(src)\n      tgt_t = tuple(tgt)\n      if src_t == tgt_t:\n          return []\n      visited = {src_t}\n      q = deque([(src_t, [])])\n      moves = [\n          (0, 1, \"DOWN\"),\n          (0, -1, \"UP\"),\n          (-1, 0, \"LEFT\"),\n          (1, 0, \"RIGHT\")\n      ]\n      while q:\n          (x, y), path = q.popleft()\n          for dx, dy, name in moves:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]):\n                  continue\n              npos = (nx, ny)\n              if npos in visited:\n                  continue\n              # allow stepping onto target even if occupied\n              if npos != tgt_t and grid[nx, ny, :].any():\n                  continue\n              new_path = path + [action_map[name]]\n              if npos == tgt_t:\n                  return new_path\n              visited.add(npos)\n              q.append((npos, new_path))\n      # fallback Manhattan if no path found\n      fallback = []\n      cx, cy = src_t\n      tx, ty = tgt_t\n      while cx < tx:\n          fallback.append(action_map[\"RIGHT\"]); cx += 1\n      while cx > tx:\n          fallback.append(action_map[\"LEFT\"]); cx -= 1\n      while cy < ty:\n          fallback.append(action_map[\"DOWN\"]); cy += 1\n      while cy > ty:\n          fallback.append(action_map[\"UP\"]); cy -= 1\n      return fallback\n\n  def _move_to(target):\n      nonlocal pos, actions\n      steps = _shortest_path(pos, target)\n      actions.extend(steps)\n      pos[0], pos[1] = target[0], target[1]\n\n  # Collect all required primitives\n  for kind_idx, cnt in primitives_needed.items():\n      for _ in range(cnt):\n          locations = np.argwhere(grid[:, :, kind_idx] == 1)\n          if locations.shape[0] == 0:\n              break\n          dists = np.abs(locations - pos).sum(axis=1)\n          nearest = int(np.argmin(dists))\n          target = locations[nearest].tolist()\n          _move_to(target)\n          actions.append(action_map[\"USE\"])\n          grid[target[0], target[1], kind_idx] = 0\n\n  # If the recipe requires a workshop, go there and craft\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get('_at')\n  if workshop_kind is not None:\n      ws_cells = np.argwhere(grid[:, :, workshop_kind] == 1)\n      if ws_cells.shape[0] > 0:\n          dists = np.abs(ws_cells - pos).sum(axis=1)\n          nearest_ws = int(np.argmin(dists))\n          ws_target = ws_cells[nearest_ws].tolist()\n          _move_to(ws_target)\n          actions.append(action_map[\"USE\"])\n\n  return actions", "env_interactions": 0, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:26:40.407667", "function_name": "make_stick", "function_body": "  env.reset()\n  world = env.world\n  scenario = env.scenario\n  grid = scenario.init_grid.copy()\n  pos = list(scenario.init_pos)\n  goal_idx = env.task.goal\n  action_map = env.action_specs()\n  primitives_needed = world.cookbook.primitives_for(goal_idx)\n  actions = []\n\n  from collections import deque\n\n  def _bfs(start, target):\n      sx, sy = start\n      tx, ty = target\n      if (sx, sy) == (tx, ty):\n          return []\n      visited = {(sx, sy)}\n      q = deque()\n      q.append(((sx, sy), []))\n      moves = [\n          (1, 0, \"RIGHT\"),\n          (-1, 0, \"LEFT\"),\n          (0, 1, \"DOWN\"),\n          (0, -1, \"UP\")\n      ]\n      while q:\n          (x, y), path = q.popleft()\n          for dx, dy, name in moves:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              # allow stepping onto the target even if occupied\n              if (nx, ny) != (tx, ty) and grid[nx, ny, :].any():\n                  continue\n              new_path = path + [action_map[name]]\n              if (nx, ny) == (tx, ty):\n                  return new_path\n              visited.add((nx, ny))\n              q.append(((nx, ny), new_path))\n      # fallback to Manhattan moves if BFS fails\n      fallback = []\n      cx, cy = sx, sy\n      while cx < tx:\n          fallback.append(action_map[\"RIGHT\"])\n          cx += 1\n      while cx > tx:\n          fallback.append(action_map[\"LEFT\"])\n          cx -= 1\n      while cy < ty:\n          fallback.append(action_map[\"DOWN\"])\n          cy += 1\n      while cy > ty:\n          fallback.append(action_map[\"UP\"])\n          cy -= 1\n      return fallback\n\n  def _move_to(target):\n      nonlocal pos, actions\n      steps = _bfs(pos, target)\n      actions.extend(steps)\n      pos[0], pos[1] = target[0], target[1]\n\n  # collect required primitives\n  for kind_idx, needed_cnt in primitives_needed.items():\n      for _ in range(needed_cnt):\n          locations = np.argwhere(grid[:, :, kind_idx] == 1)\n          if locations.shape[0] == 0:\n              break\n          dists = np.abs(locations - pos).sum(axis=1)\n          nearest = int(np.argmin(dists))\n          target_cell = locations[nearest].tolist()\n          _move_to(target_cell)\n          actions.append(action_map[\"USE\"])\n          grid[target_cell[0], target_cell[1], kind_idx] = 0\n\n  # go to workshop and craft if needed\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get('_at')\n  if workshop_kind is not None:\n      ws_cells = np.argwhere(grid[:, :, workshop_kind] == 1)\n      if ws_cells.shape[0] > 0:\n          dists = np.abs(ws_cells - pos).sum(axis=1)\n          nearest_ws = int(np.argmin(dists))\n          ws_target = ws_cells[nearest_ws].tolist()\n          _move_to(ws_target)\n          actions.append(action_map[\"USE\"])\n\n  return actions", "env_interactions": 0, "island_id": 5, "scores": {"3": 0.0}}
