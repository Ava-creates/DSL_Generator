{"timestamp": "2025-10-21T16:48:00.275457", "function_name": "make_stick", "function_body": "  import numpy as np\n\n  # Action indices (as defined in CraftWorld)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  actions = []\n\n  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  # Index of the target item (stick)\n  stick_idx = cookbook.index[\"stick\"]\n\n  # Recipe for a stick (primitives + workshop)\n  recipe = cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  workshop_idx = None\n  if workshop_name is not None:\n      workshop_idx = cookbook.index[workshop_name]\n\n  # Primitive requirements (ignore the special \"_at\" key)\n  primitive_reqs = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  max_steps = 2000          # safety guard\n  steps_taken = 0\n\n  # Helper: move toward a target cell using a greedy Manhattan strategy.\n  def move_towards(target):\n      nonlocal steps_taken, actions, state\n      while tuple(state.pos) != target and steps_taken < max_steps:\n          # order actions that reduce Manhattan distance\n          dx = target[0] - state.pos[0]\n          dy = target[1] - state.pos[1]\n          order = []\n          if dx > 0:\n              order.append(DOWN)\n          elif dx < 0:\n              order.append(UP)\n          if dy > 0:\n              order.append(RIGHT)\n          elif dy < 0:\n              order.append(LEFT)\n          for a in (DOWN, UP, LEFT, RIGHT):\n              if a not in order:\n                  order.append(a)\n\n          moved = False\n          for a in order:\n              prev_pos = tuple(state.pos)\n              _, _, _ = env.step(a)\n              actions.append(a)\n              steps_taken += 1\n              state = env._current_state\n              if tuple(state.pos) != prev_pos:\n                  moved = True\n                  break\n          if not moved:\n              # blocked and cannot move \u2013 abort this leg\n              break\n\n  # Main loop: collect needed primitives, then go to workshop and craft.\n  while state.inventory[stick_idx] == 0 and steps_taken < max_steps:\n      # Determine which primitives are still missing\n      missing = {p: cnt - state.inventory[p] for p, cnt in primitive_reqs.items()\n                 if state.inventory[p] < cnt}\n      if missing:\n          # Pick any missing primitive (deterministic order)\n          prim_idx = sorted(missing.keys())[0]\n\n          # Find all cells that currently contain this primitive\n          prim_cells = np.argwhere(state.grid[..., prim_idx] > 0)\n          if prim_cells.size == 0:\n              # primitive not present on the map \u2013 cannot continue\n              break\n\n          # Choose the closest occurrence (Manhattan distance)\n          cur = np.array(state.pos)\n          dists = np.sum(np.abs(prim_cells - cur), axis=1)\n          target_cell = tuple(prim_cells[dists.argmin()])\n\n          # Move to that cell\n          move_towards(target_cell)\n\n          # Once on/next to the primitive, use the USE action to pick it up\n          _, _, _ = env.step(USE)\n          actions.append(USE)\n          steps_taken += 1\n          state = env._current_state\n          continue\n\n      # All primitives gathered \u2013 head to the required workshop (if any)\n      if workshop_idx is not None:\n          workshop_cells = np.argwhere(state.grid[..., workshop_idx] > 0)\n          if workshop_cells.size == 0:\n              break\n          cur = np.array(state.pos)\n          dists = np.sum(np.abs(workshop_cells - cur), axis=1)\n          target_ws = tuple(workshop_cells[dists.argmin()])\n          move_towards(target_ws)\n\n      # Perform the crafting action\n      _, _, _ = env.step(USE)\n      actions.append(USE)\n      steps_taken += 1\n      state = env._current_state\n\n  return actions", "env_interactions": 0, "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-10-21T16:48:35.513963", "function_name": "make_stick", "function_body": "  import numpy as np\n\n  # Reset the environment to start a new episode\n  env.reset()\n  actions = []\n\n  # Helper to fetch the current state\n  def get_state():\n      return env._current_state  # pylint: disable=protected-access\n\n  # Index of the USE action (standard mapping in CraftLab)\n  USE_ACTION = 4\n\n  # Main loop \u2013 keep acting until the task is completed or a safety limit is hit\n  max_steps = 2000\n  while not env._is_done() and len(actions) < max_steps:  # pylint: disable=protected-access\n      state = get_state()\n      goal_idx = env.task.goal  # index of the desired item (stick)\n\n      # If we already have the goal in inventory, we are done\n      if state.inventory[goal_idx] > 0:\n          break\n\n      # Determine which primitive resources are still missing\n      needed = state.world.cookbook.primitives_for(goal_idx)\n      missing = {}\n      for prim_idx, required_cnt in needed.items():\n          have = state.inventory[prim_idx]\n          if have < required_cnt:\n              missing[prim_idx] = required_cnt - have\n\n      # If we are still missing some primitives, try to collect them\n      if missing:\n          # Pick an arbitrary missing primitive to chase\n          target_prim = next(iter(missing))\n\n          # If the primitive is within the 3\u00d73 neighbourhood, attempt to pick it up\n          if state.next_to(target_prim):\n              actions.append(USE_ACTION)\n              _, _ = env.step(USE_ACTION)\n              continue\n\n          # Otherwise move in a random direction (simple exploration)\n          move_action = np.random.choice([0, 1, 2, 3])  # DOWN, UP, LEFT, RIGHT\n          actions.append(move_action)\n          _, _ = env.step(move_action)\n          continue\n\n      # All required primitives are in inventory \u2013 attempt to craft the goal\n      actions.append(USE_ACTION)\n      _, _ = env.step(USE_ACTION)\n\n  # Return the accumulated action list\n  return actions", "env_interactions": 0, "island_id": 9, "scores": {"3": -1}}
