{"timestamp": "2025-10-21T21:31:06.276736", "function_name": "make_stick", "function_body": "  env.reset()\n  world = env.world\n  scenario = env.scenario\n\n  # action constants (as defined in CraftLab.action_specs())\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  # target item index\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # primitives required to craft a stick (empty if stick itself is primitive)\n  primitives_needed = world.cookbook.primitives_for(stick_idx)\n  if not primitives_needed:\n      primitives_needed = {stick_idx: 1}\n\n  # mutable copies of the grid and agent position\n  grid = scenario.init_grid.copy()\n  pos = scenario.init_pos          # (x, y)\n  actions = []                     # list of action indices to return\n\n  # ----------------------------------------------------------------------\n  # Helper utilities\n  # ----------------------------------------------------------------------\n  from collections import deque\n\n  def bfs(start, goal):\n      \"\"\"Return a list of movement actions from start to goal avoiding occupied cells.\"\"\"\n      W, H = grid.shape[:2]\n      visited = set()\n      q = deque()\n      q.append((start, []))\n      visited.add(start)\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for act, (dx, dy) in (\n              (ACTION_DOWN, (0, 1)),\n              (ACTION_UP, (0, -1)),\n              (ACTION_LEFT, (-1, 0)),\n              (ACTION_RIGHT, (1, 0)),\n          ):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in visited:\n                  if not np.any(grid[nx, ny, :] != 0):\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [act]))\n      return None  # unreachable\n\n  def free_adjacent(cell):\n      \"\"\"Return a list of free (unoccupied) cells adjacent to `cell`.\"\"\"\n      adj = []\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          ax, ay = cell[0] + dx, cell[1] + dy\n          if 0 <= ax < grid.shape[0] and 0 <= ay < grid.shape[1]:\n              if not np.any(grid[ax, ay, :] != 0):\n                  adj.append((ax, ay))\n      return adj\n\n  def direction_action(dx, dy):\n      \"\"\"Map a delta (dx, dy) to the corresponding movement action.\"\"\"\n      if dx == -1 and dy == 0:\n          return ACTION_LEFT\n      if dx == 1 and dy == 0:\n          return ACTION_RIGHT\n      if dx == 0 and dy == -1:\n          return ACTION_UP\n      if dx == 0 and dy == 1:\n          return ACTION_DOWN\n      return None\n\n  # ----------------------------------------------------------------------\n  # 1. Collect all required primitive items\n  # ----------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      for _ in range(needed_cnt):\n          # locate any remaining instance of this primitive\n          locations = np.argwhere(grid[:, :, prim_idx] > 0)\n          if len(locations) == 0:\n              continue\n          target = tuple(locations[0])  # (x, y)\n\n          # find a free adjacent cell from which we can USE the primitive\n          adj_cells = free_adjacent(target)\n          chosen_adj = None\n          path_to_adj = None\n          for adj in adj_cells:\n              p = bfs(pos, adj)\n              if p is not None:\n                  chosen_adj = adj\n                  path_to_adj = p\n                  break\n\n          if path_to_adj is None:\n              continue  # could not reach a usable position\n\n          # move to the chosen adjacent cell\n          actions.extend(path_to_adj)\n          pos = chosen_adj\n\n          # step onto the primitive, USE, then step back\n          dx, dy = target[0] - pos[0], target[1] - pos[1]\n          step_act = direction_action(dx, dy)\n          if step_act is None:\n              actions.append(ACTION_USE)\n          else:\n              actions.append(step_act)          # onto primitive\n              actions.append(ACTION_USE)       # collect\n              back_act = direction_action(-dx, -dy)\n              if back_act is not None:\n                  actions.append(back_act)      # return to original cell\n              # update position back to the adjacent cell (unchanged)\n\n          # update local grid copy\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # ----------------------------------------------------------------------\n  # 2. Craft the stick at its required workshop (if any)\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if len(workshop_cells) > 0:\n          workshop_pos = tuple(workshop_cells[0])\n\n          # find a free adjacent cell next to the workshop\n          adj_cells = free_adjacent(workshop_pos)\n          chosen_adj = None\n          path_to_adj = None\n          for adj in adj_cells:\n              p = bfs(pos, adj)\n              if p is not None:\n                  chosen_adj = adj\n                  path_to_adj = p\n                  break\n\n          if path_to_adj is not None:\n              # move next to the workshop\n              actions.extend(path_to_adj)\n              pos = chosen_adj\n\n              # step onto the workshop, USE to craft, then step back\n              dx, dy = workshop_pos[0] - pos[0], workshop_pos[1] - pos[1]\n              step_act = direction_action(dx, dy)\n              if step_act is None:\n                  actions.append(ACTION_USE)\n              else:\n                  actions.append(step_act)          # onto workshop\n                  actions.append(ACTION_USE)       # craft stick\n                  back_act = direction_action(-dx, -dy)\n                  if back_act is not None:\n                      actions.append(back_act)\n  else:\n      # no workshop required \u2013 just use in place\n      actions.append(ACTION_USE)\n\n  # ----------------------------------------------------------------------\n  # Return the compiled sequence of actions\n  # ----------------------------------------------------------------------\n  return actions", "env_interactions": 9, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:31:07.400554", "function_name": "make_stick", "function_body": "  # reset environment and get references\n  env.reset()\n  world = env.world\n  scenario = env.scenario\n\n  # action indices (consistent with CraftLab.action_specs())\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  # index of the target item \"stick\"\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # primitive requirements for a stick (empty dict means stick itself is primitive)\n  primitives_needed = world.cookbook.primitives_for(stick_idx)\n  if not primitives_needed:\n      primitives_needed = {stick_idx: 1}\n\n  # local mutable copies of the grid and agent position\n  grid = scenario.init_grid.copy()          # shape (W, H, n_kinds)\n  pos = scenario.init_pos                    # (x, y) tuple\n  actions = []                               # list of action ints to return\n\n  # ----------------------------------------------------------------------\n  # Helper utilities\n  # ----------------------------------------------------------------------\n  from collections import deque\n\n  def bfs(start, goal):\n      \"\"\"Return a list of movement actions from start to goal avoiding occupied cells.\"\"\"\n      W, H = grid.shape[:2]\n      visited = set()\n      q = deque()\n      q.append((start, []))\n      visited.add(start)\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for act, (dx, dy) in (\n              (ACTION_DOWN, (0, 1)),\n              (ACTION_UP, (0, -1)),\n              (ACTION_LEFT, (-1, 0)),\n              (ACTION_RIGHT, (1, 0)),\n          ):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in visited:\n                  # walkable iff the cell is empty (no entity of any kind)\n                  if np.any(grid[nx, ny, :] != 0):\n                      continue\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [act]))\n      return None  # unreachable\n\n  def free_adjacent(cell):\n      \"\"\"Return list of free (unoccupied) cells adjacent to `cell`.\"\"\"\n      adj = []\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          ax, ay = cell[0] + dx, cell[1] + dy\n          if 0 <= ax < grid.shape[0] and 0 <= ay < grid.shape[1]:\n              if not np.any(grid[ax, ay, :] != 0):\n                  adj.append((ax, ay))\n      return adj\n\n  def direction_action(dx, dy):\n      \"\"\"Map a delta (dx, dy) to the corresponding movement action.\"\"\"\n      if dx == -1 and dy == 0:\n          return ACTION_LEFT\n      if dx == 1 and dy == 0:\n          return ACTION_RIGHT\n      if dx == 0 and dy == -1:\n          return ACTION_UP\n      if dx == 0 and dy == 1:\n          return ACTION_DOWN\n      return None\n\n  # ----------------------------------------------------------------------\n  # 1. Collect all required primitive items\n  # ----------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      for _ in range(needed_cnt):\n          # locate any remaining instance of this primitive on the map\n          locations = np.argwhere(grid[:, :, prim_idx] > 0)\n          if len(locations) == 0:\n              continue  # shouldn't happen in a valid scenario\n          target = tuple(locations[0])  # (x, y)\n\n          # find a free adjacent cell from which we can USE the primitive\n          adj_cells = free_adjacent(target)\n          chosen_adj = None\n          path_to_adj = None\n          for adj in adj_cells:\n              p = bfs(pos, adj)\n              if p is not None:\n                  chosen_adj = adj\n                  path_to_adj = p\n                  break\n\n          if path_to_adj is None:\n              continue  # cannot reach any usable position\n\n          # move to the chosen adjacent cell\n          actions.extend(path_to_adj)\n          pos = chosen_adj\n\n          # step onto the primitive cell, USE to collect, then step back\n          dx, dy = target[0] - pos[0], target[1] - pos[1]\n          step_act = direction_action(dx, dy)\n          if step_act is None:\n              # fallback: just USE (may work if already facing)\n              actions.append(ACTION_USE)\n          else:\n              actions.append(step_act)          # move onto primitive\n              actions.append(ACTION_USE)       # collect\n              back_act = direction_action(-dx, -dy)\n              if back_act is not None:\n                  actions.append(back_act)      # step back\n              # update position back to adjacent cell\n              pos = chosen_adj\n              # update local grid copy\n              grid[target[0], target[1], prim_idx] -= 1\n\n  # ----------------------------------------------------------------------\n  # 2. Craft the stick at its required workshop (if any)\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if len(workshop_cells) > 0:\n          workshop_pos = tuple(workshop_cells[0])\n\n          # find a free adjacent cell next to the workshop\n          adj_cells = free_adjacent(workshop_pos)\n          chosen_adj = None\n          path_to_adj = None\n          for adj in adj_cells:\n              p = bfs(pos, adj)\n              if p is not None:\n                  chosen_adj = adj\n                  path_to_adj = p\n                  break\n\n          if path_to_adj is not None:\n              actions.extend(path_to_adj)\n              pos = chosen_adj\n\n              # step onto workshop, USE to craft, step back\n              dx, dy = workshop_pos[0] - pos[0], workshop_pos[1] - pos[1]\n              step_act = direction_action(dx, dy)\n              if step_act is not None:\n                  actions.append(step_act)          # move onto workshop\n                  actions.append(ACTION_USE)       # craft stick\n                  back_act = direction_action(-dx, -dy)\n                  if back_act is not None:\n                      actions.append(back_act)      # step back\n              else:\n                  actions.append(ACTION_USE)\n\n  # return the compiled sequence of actions\n  return actions", "env_interactions": 9, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:31:26.978448", "function_name": "make_stick", "function_body": "  # Determine the action IDs; fall back to the default ordering if needed.\n  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      action_ids = [0, 1, 2, 3, 4]  # DOWN, UP, LEFT, RIGHT, USE\n\n  # Resolve the integer index for the target item \u201cstick\u201d.\n  try:\n      goal_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      goal_idx = env.world.cookbook.index.get(\"stick\")\n  if goal_idx is None:\n      return []\n\n  # Obtain the initial state (use the current state if the lab wrapper exposes it).\n  start_state = getattr(env, \"_current_state\", None)\n  if start_state is None:\n      start_state = env.scenario.init()\n\n  # Helper to create a hashable representation of a state for visited\u2011set tracking.\n  def _state_key(st):\n      # Position, direction and inventory uniquely identify the reachable state\n      # for the deterministic dynamics of CraftWorld.\n      return (st.pos, st.dir, st.inventory.tobytes())\n\n  # Bread\u2011first search over deterministic transitions.\n  frontier = collections.deque()\n  frontier.append((start_state, []))\n  visited = {_state_key(start_state)}\n  MAX_PLAN_LEN = 800  # safety bound to avoid infinite search\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      # Goal test: inventory already contains a stick.\n      if cur_state.satisfies(\"\", goal_idx):\n          return cur_plan\n\n      # Prune overly long plans.\n      if len(cur_plan) >= MAX_PLAN_LEN:\n          continue\n\n      # Expand all possible actions.\n      for a in action_ids:\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((next_state, cur_plan + [a]))\n\n  # No plan found within the limits \u2013 return empty list.\n  return []", "env_interactions": 4, "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T21:31:28.103113", "function_name": "make_stick", "function_body": "  import collections\n\n  # Determine the action IDs; fall back to the default ordering if needed.\n  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      action_ids = [0, 1, 2, 3, 4]  # DOWN, UP, LEFT, RIGHT, USE\n\n  # Resolve the integer index for the target item \u201cstick\u201d.\n  try:\n      goal_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      goal_idx = env.world.cookbook.index.get(\"stick\")\n  if goal_idx is None:\n      return []\n\n  # Obtain the initial state (use the current state if the lab wrapper exposes it).\n  start_state = getattr(env, \"_current_state\", None)\n  if start_state is None:\n      start_state = env.scenario.init()\n\n  # Helper to create a hashable representation of a state for visited\u2011set tracking.\n  def _state_key(st):\n      # Position, direction and inventory uniquely identify the reachable state\n      # for the deterministic dynamics of CraftWorld.\n      return (st.pos, st.dir, st.inventory.tobytes())\n\n  # Bread\u2011first search over deterministic transitions.\n  frontier = collections.deque()\n  frontier.append((start_state, []))\n  visited = {_state_key(start_state)}\n  MAX_PLAN_LEN = 800  # safety bound to avoid infinite search\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      # Goal test: inventory already contains a stick.\n      if cur_state.satisfies(\"\", goal_idx):\n          return cur_plan\n\n      # Prune overly long plans.\n      if len(cur_plan) >= MAX_PLAN_LEN:\n          continue\n\n      # Expand all possible actions.\n      for a in action_ids:\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((next_state, cur_plan + [a]))\n\n  # No plan found within the limits \u2013 return empty list.\n  return []", "env_interactions": 4, "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T21:31:51.411261", "function_name": "make_stick", "function_body": "  env.reset()\n  state = env._current_state\n\n  goal_idx = env.task.goal\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)\n\n  # BFS path planner that avoids non\u2011grabbable entities\n  def _bfs_path(start, target):\n      if tuple(start) == tuple(target):\n          return []\n      width, height = state.grid.shape[:2]\n      non_grabbable = env.world.non_grabbable_indices\n      # action order: 0=DOWN, 1=UP, 2=LEFT, 3=RIGHT\n      dirs = [(1, 0), (-1, 0), (0, -1), (0, 1)]\n      from collections import deque\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = {(start[0], start[1])}\n      while q:\n          r, c, path = q.popleft()\n          for act, (dr, dc) in enumerate(dirs):\n              nr, nc = r + dr, c + dc\n              if not (0 <= nr < width and 0 <= nc < height):\n                  continue\n              if (nr, nc) in visited:\n                  continue\n              cell = state.grid[nr, nc, :]\n              if any(cell[idx] > 0 for idx in non_grabbable):\n                  continue\n              visited.add((nr, nc))\n              new_path = path + [act]\n              if (nr, nc) == tuple(target):\n                  return new_path\n              q.append((nr, nc, new_path))\n      return []  # Should not happen in solvable scenarios\n\n  def _move_to(target):\n      nonlocal state\n      actions = _bfs_path(state.pos, target)\n      for a in actions:\n          _, new_state = env.step(a)\n          state = new_state\n      return actions\n\n  plan = []\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives (respecting needed quantities)\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      for _ in range(needed_cnt):\n          locations = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if locations.shape[0] == 0:\n              break  # No more instances; should not happen in a valid scenario\n          cur = np.array(state.pos)\n          dists = np.abs(locations - cur).sum(axis=1)\n          target = tuple(locations[dists.argmin()])\n          plan.extend(_move_to(target))\n          plan.append(4)  # USE to pick up\n          _, new_state = env.step(4)\n          state = new_state\n\n  # ------------------------------------------------------------------\n  # 2. Go to the required workshop (if any) and craft the stick\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = recipe.get('_at')\n  if workshop_idx is not None:\n      workshop_locs = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_locs.shape[0] > 0:\n          cur = np.array(state.pos)\n          dists = np.abs(workshop_locs - cur).sum(axis=1)\n          target = tuple(workshop_locs[dists.argmin()])\n          plan.extend(_move_to(target))\n          plan.append(4)  # USE to craft\n          _, new_state = env.step(4)\n          state = new_state\n\n  return plan", "env_interactions": 0, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:31:52.530966", "function_name": "make_stick", "function_body": "  env.reset()\n  state = env._current_state\n\n  goal_idx = env.task.goal\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)\n\n  # ------------------------------------------------------------------\n  # Helper: BFS path finder that avoids non\u2011grabbable cells\n  # ------------------------------------------------------------------\n  def _bfs_path(start, target):\n      if tuple(start) == tuple(target):\n          return []\n      width, height = state.grid.shape[:2]\n      non_grabbable = env.world.non_grabbable_indices\n      dirs = [(1, 0), (-1, 0), (0, -1), (0, 1)]   # DOWN, UP, LEFT, RIGHT\n      from collections import deque\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = {(start[0], start[1])}\n      while q:\n          r, c, path = q.popleft()\n          for act, (dr, dc) in enumerate(dirs):\n              nr, nc = r + dr, c + dc\n              if not (0 <= nr < width and 0 <= nc < height):\n                  continue\n              if (nr, nc) in visited:\n                  continue\n              cell = state.grid[nr, nc, :]\n              if any(cell[idx] > 0 for idx in non_grabbable):\n                  continue\n              visited.add((nr, nc))\n              new_path = path + [act]\n              if (nr, nc) == tuple(target):\n                  return new_path\n              q.append((nr, nc, new_path))\n      return []   # no path found (should not happen in solvable tasks)\n\n  def _move_to(target):\n      nonlocal state\n      actions = _bfs_path(state.pos, target)\n      for a in actions:\n          _, new_state = env.step(a)\n          state = new_state\n      return actions\n\n  plan = []\n\n  # ------------------------------------------------------------------\n  # 1. Collect required primitives (respecting needed counts)\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in primitives_needed.items():\n      for _ in range(cnt):\n          locations = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if locations.shape[0] == 0:\n              break   # should not happen in a valid scenario\n          cur = np.array(state.pos)\n          dists = np.abs(locations - cur).sum(axis=1)\n          target = tuple(locations[dists.argmin()])\n          plan.extend(_move_to(target))\n          plan.append(4)                     # USE to pick up\n          _, new_state = env.step(4)\n          state = new_state\n\n  # ------------------------------------------------------------------\n  # 2. Go to the required workshop (if any) and craft the goal item\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = recipe.get(\"_at\")\n  if workshop_idx is not None:\n      workshop_locs = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_locs.shape[0] > 0:\n          cur = np.array(state.pos)\n          dists = np.abs(workshop_locs - cur).sum(axis=1)\n          target = tuple(workshop_locs[dists.argmin()])\n          plan.extend(_move_to(target))\n          plan.append(4)                     # USE to craft\n          _, new_state = env.step(4)\n          state = new_state\n\n  return plan", "env_interactions": 0, "island_id": 9, "scores": {"3": 0.0}}
