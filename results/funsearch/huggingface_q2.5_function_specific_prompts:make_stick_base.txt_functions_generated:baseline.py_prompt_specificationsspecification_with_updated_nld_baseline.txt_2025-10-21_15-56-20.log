{"timestamp": "2025-10-21T19:31:36.507707", "function_name": "make_stick", "function_body": "  import numpy as np\n\n  actions = []\n  max_steps = 5000\n  steps = 0\n\n  # ------------------------------------------------------------------\n  # Helpers\n  # ------------------------------------------------------------------\n  def move_to(target):\n      \"\"\"Move (naively) towards target coordinate using Manhattan steps.\"\"\"\n      nonlocal steps\n      while env._current_state.pos != target and steps < max_steps:\n          x, y = env._current_state.pos\n          tx, ty = target\n          if x < tx:\n              act = 3          # RIGHT\n          elif x > tx:\n              act = 2          # LEFT\n          elif y < ty:\n              act = 0          # DOWN\n          elif y > ty:\n              act = 1          # UP\n          else:\n              break\n          actions.append(act)\n          env.step(act)\n          steps += 1\n\n  def nearest(cell_coords, pos):\n      \"\"\"Return coordinate from cell_coords nearest (Manhattan) to pos.\"\"\"\n      if len(cell_coords) == 0:\n          return None\n      dists = np.abs(cell_coords[:, 0] - pos[0]) + np.abs(cell_coords[:, 1] - pos[1])\n      return tuple(cell_coords[np.argmin(dists)])\n\n  # ------------------------------------------------------------------\n  # Identify goal\n  # ------------------------------------------------------------------\n  if not hasattr(env, \"task\") or not hasattr(env.task, \"goal\"):\n      return actions\n  goal_idx = env.task.goal\n\n  world = env.world\n  cookbook = world.cookbook\n\n  # ------------------------------------------------------------------\n  # 1) Gather required primitives\n  # ------------------------------------------------------------------\n  needed = cookbook.primitives_for(goal_idx)          # {prim_idx: count}\n  for prim_idx, cnt_needed in needed.items():\n      while env._current_state.inventory[prim_idx] < cnt_needed and steps < max_steps:\n          # locate any remaining primitive on the map\n          prim_grid = env._current_state.grid[:, :, prim_idx]\n          candidates = np.argwhere(prim_grid > 0)\n          if candidates.size == 0:\n              break\n          # pick the nearest one\n          target = nearest(candidates, env._current_state.pos)\n          if target is None:\n              break\n          move_to(target)\n\n          # try to pick it up\n          actions.append(4)          # USE\n          env.step(4)\n          steps += 1\n\n  # ------------------------------------------------------------------\n  # 2) Craft at required workshop (if any)\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  for k, v in recipe.items():\n      if isinstance(k, str):        # e.g. \"_at\"\n          workshop_kind = v\n          break\n\n  if workshop_kind is not None and steps < max_steps:\n      wk_grid = env._current_state.grid[:, :, workshop_kind]\n      wk_cells = np.argwhere(wk_grid > 0)\n      if wk_cells.size > 0:\n          wk_target = nearest(wk_cells, env._current_state.pos)\n          move_to(wk_target)\n\n          # attempt crafting\n          actions.append(4)          # USE\n          env.step(4)\n          steps += 1\n\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": 0.0}}
