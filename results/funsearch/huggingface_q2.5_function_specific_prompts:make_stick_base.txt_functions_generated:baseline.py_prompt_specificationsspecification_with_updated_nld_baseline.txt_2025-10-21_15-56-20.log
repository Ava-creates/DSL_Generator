{"timestamp": "2025-10-21T21:46:52.498485", "function_name": "make_stick", "function_body": "  from collections import deque\n\n  # ----------------------------------------------------------------------\n  # Helper utilities\n  # ----------------------------------------------------------------------\n  def _action_ids():\n      \"\"\"Return the list of action indices supported by the environment.\"\"\"\n      try:\n          # env.action_specs() returns a dict mapping action names to indices\n          return list(env.action_specs().values())\n      except Exception:\n          # Fallback ordering: DOWN, UP, LEFT, RIGHT, USE\n          return [0, 1, 2, 3, 4]\n\n  def _goal_index():\n      \"\"\"Return the integer index of the primitive/item \\\"stick\\\".\"\"\"\n      try:\n          return env.world.cookbook.index[\"stick\"]\n      except Exception:\n          return env.world.cookbook.index.get(\"stick\")\n\n  def _is_goal(state, goal_idx):\n      \"\"\"Check whether the current state already satisfies the goal.\"\"\"\n      return goal_idx is not None and state.satisfies(\"\", goal_idx)\n\n  def _state_key(state):\n      \"\"\"Compact hashable representation of a state for visited tracking.\"\"\"\n      # Include position, direction, inventory bytes and grid bytes to avoid cycles\n      return (state.pos, state.dir, state.inventory.tobytes(), state.grid.tobytes())\n\n  # ----------------------------------------------------------------------\n  # Initialise search\n  # ----------------------------------------------------------------------\n  actions = _action_ids()\n  goal_idx = _goal_index()\n\n  # Obtain the current state; if the lab does not expose it, initialise a fresh one\n  start_state = getattr(env, \"_current_state\", None)\n  if start_state is None:\n      start_state = env.scenario.init()\n\n  # Bread\u2011first search over (state, action_sequence) pairs\n  frontier = deque()\n  frontier.append((start_state, []))\n  visited = {_state_key(start_state)}\n  MAX_PLAN_LENGTH = 400  # safety bound to avoid infinite loops\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      if _is_goal(cur_state, goal_idx):\n          return cur_plan\n\n      if len(cur_plan) >= MAX_PLAN_LENGTH:\n          continue\n\n      for a in actions:\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((next_state, cur_plan + [a]))\n\n  # No feasible plan found within the limits.\n  return []", "env_interactions": 4, "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T21:46:53.612954", "function_name": "make_stick", "function_body": "  import collections\n\n  # ----- helper utilities -----\n  def _action_ids():\n      \"\"\"Return list of action indices supported by the environment.\"\"\"\n      try:\n          return list(env.action_specs().values())\n      except Exception:\n          # default ordering: DOWN, UP, LEFT, RIGHT, USE\n          return [0, 1, 2, 3, 4]\n\n  def _goal_index():\n      \"\"\"Return the integer index of the item \\\"stick\\\".\"\"\"\n      try:\n          return env.world.cookbook.index[\"stick\"]\n      except Exception:\n          return env.world.cookbook.index.get(\"stick\")\n\n  def _is_goal(state, idx):\n      \"\"\"Check whether the current state already satisfies the goal.\"\"\"\n      return idx is not None and state.satisfies(\"\", idx)\n\n  def _state_key(state):\n      \"\"\"Compact hashable representation of a state for visited tracking.\"\"\"\n      # Position, direction, inventory bytes and grid bytes (to capture collected items)\n      return (state.pos, state.dir, state.inventory.tobytes(), state.grid.tobytes())\n\n  # ----- initialise search -----\n  actions = _action_ids()\n  goal_idx = _goal_index()\n\n  # Get the starting state; if the wrapper does not expose it, initialise a fresh one\n  start_state = getattr(env, \"_current_state\", None)\n  if start_state is None:\n      start_state = env.scenario.init()\n\n  # Breadth\u2011first search over (state, action_sequence) pairs\n  frontier = collections.deque()\n  frontier.append((start_state, []))\n  visited = {_state_key(start_state)}\n  MAX_PLAN_LENGTH = 400  # safety bound\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      if _is_goal(cur_state, goal_idx):\n          return cur_plan\n\n      if len(cur_plan) >= MAX_PLAN_LENGTH:\n          continue\n\n      for a in actions:\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((next_state, cur_plan + [a]))\n\n  # No feasible plan found within the limits.\n  return []", "env_interactions": 4, "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T21:47:19.969749", "function_name": "make_stick", "function_body": "  actions = []\n  # Reset environment to initial state\n  env.reset()\n  state = env._current_state\n  world = env.world\n\n  # Index of the target item \"stick\"\n  stick_idx = world.cookbook.index[\"stick\"]\n  if state.inventory[stick_idx] > 0:\n      return actions\n\n  # --------------------------------------------------------------\n  # Helper utilities\n  # --------------------------------------------------------------\n  import collections\n\n  def move_action(cur, nxt):\n      \"\"\"Convert a step (cur \u2192 nxt) into a DMLab action index.\"\"\"\n      dx = nxt[0] - cur[0]\n      dy = nxt[1] - cur[1]\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise ValueError(\"Invalid move step\")\n\n  def bfs_to_adjacent(start, targets, grid):\n      \"\"\"\n      Bread\u2011first search for the shortest path from `start` to any empty\n      cell orthogonally adjacent to one of the `targets` cells.\n      Returns a list of positions (including the start).\n      \"\"\"\n      W, H, _ = grid.shape\n      visited = np.zeros((W, H), dtype=bool)\n      q = collections.deque()\n      q.append((tuple(start), [tuple(start)]))\n      visited[start] = True\n      target_set = {tuple(t) for t in targets}\n      while q:\n          pos, path = q.popleft()\n          # Check adjacency to any target\n          for tx, ty in target_set:\n              if abs(pos[0] - tx) + abs(pos[1] - ty) == 1:\n                  return path\n          # Expand neighbours (only through empty cells)\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if grid[nx, ny, :].sum() == 0:      # empty cell\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [(nx, ny)]))\n      raise RuntimeError(\"No reachable adjacent cell found\")\n\n  # --------------------------------------------------------------\n  # 1) Collect required primitives for a stick\n  # --------------------------------------------------------------\n  primitive_reqs = world.cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n  cur_pos = tuple(state.pos)\n\n  for prim_idx, needed in primitive_reqs.items():\n      for _ in range(needed):\n          # Skip if we already have this primitive in inventory\n          if state.inventory[prim_idx] > 0:\n              continue\n          # Locate all cells containing this primitive\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(f\"Primitive {prim_idx} not found in the world\")\n          # Plan path to an empty cell adjacent to a primitive cell\n          path = bfs_to_adjacent(cur_pos, prim_cells, state.grid)\n          # Translate path into actions\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n          # Use action to pick up the primitive\n          actions.append(4)   # USE\n          # Update temporary planning copies\n          state.grid[cur_pos[0], cur_pos[1], prim_idx] = 0\n          state.inventory[prim_idx] += 1\n\n  # --------------------------------------------------------------\n  # 2) Move to the appropriate workshop and craft the stick\n  # --------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      raise RuntimeError(\"Stick recipe does not specify a workshop\")\n  workshop_idx = world.cookbook.index[workshop_name]\n\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      raise RuntimeError(\"Workshop for stick not found in the world\")\n  path = bfs_to_adjacent(cur_pos, workshop_cells, state.grid)\n  for step in path[1:]:\n      actions.append(move_action(cur_pos, step))\n      cur_pos = step\n\n  # Final USE to craft the stick at the workshop\n  actions.append(4)   # USE\n\n  return actions", "env_interactions": 5, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-21T21:47:21.090247", "function_name": "make_stick", "function_body": "  actions = []\n  # Reset environment to initial state\n  env.reset()\n  state = env._current_state\n  world = env.world\n\n  # Index of the target item \"stick\"\n  stick_idx = world.cookbook.index[\"stick\"]\n  if state.inventory[stick_idx] > 0:\n      return actions\n\n  # ------------------------------------------------------------------\n  # Helper functions\n  # ------------------------------------------------------------------\n  import collections\n\n  def move_action(cur, nxt):\n      \"\"\"Convert a step (cur -> nxt) into a DMLab action index.\"\"\"\n      dx = nxt[0] - cur[0]\n      dy = nxt[1] - cur[1]\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise ValueError(\"Invalid move step\")\n\n  def bfs_to_adjacent(start, targets, grid):\n      \"\"\"\n      Bread\u2011first search for the shortest path from `start` to any empty cell\n      orthogonally adjacent to one of the `targets` cells.\n      Returns a list of positions (including the start).\n      \"\"\"\n      W, H, _ = grid.shape\n      visited = np.zeros((W, H), dtype=bool)\n      q = collections.deque()\n      q.append((tuple(start), [tuple(start)]))\n      visited[start] = True\n      target_set = {tuple(t) for t in targets}\n      while q:\n          pos, path = q.popleft()\n          # If adjacent to any target, stop\n          for tx, ty in target_set:\n              if abs(pos[0] - tx) + abs(pos[1] - ty) == 1:\n                  return path\n          # Expand neighbours (only through empty cells)\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if grid[nx, ny, :].sum() == 0:      # empty cell\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [(nx, ny)]))\n      raise RuntimeError(\"No reachable adjacent cell found\")\n\n  # ------------------------------------------------------------------\n  # 1) Gather required primitives for a stick\n  # ------------------------------------------------------------------\n  primitive_reqs = world.cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n  cur_pos = tuple(state.pos)\n\n  for prim_idx, needed in primitive_reqs.items():\n      for _ in range(needed):\n          # Skip if we already have this primitive\n          if state.inventory[prim_idx] > 0:\n              continue\n          # Locate cells containing the primitive\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(f\"Primitive {prim_idx} not found in the world\")\n          # Plan path to an empty cell adjacent to a primitive cell\n          path = bfs_to_adjacent(cur_pos, prim_cells, state.grid)\n          # Convert path steps into actions\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n          # Pick up the primitive\n          actions.append(4)   # USE\n          # Update temporary planning state\n          state.grid[cur_pos[0], cur_pos[1], prim_idx] = 0\n          state.inventory[prim_idx] += 1\n\n  # ------------------------------------------------------------------\n  # 2) Move to the workshop and craft the stick\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      raise RuntimeError(\"Stick recipe does not specify a workshop\")\n  workshop_idx = world.cookbook.index[workshop_name]\n\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      raise RuntimeError(\"Workshop for stick not found in the world\")\n  path = bfs_to_adjacent(cur_pos, workshop_cells, state.grid)\n  for step in path[1:]:\n      actions.append(move_action(cur_pos, step))\n      cur_pos = step\n\n  # Final USE to craft the stick at the workshop\n  actions.append(4)   # USE\n\n  return actions", "env_interactions": 5, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-21T21:47:45.430758", "function_name": "make_stick", "function_body": "  env.reset()\n  world = env.world\n  scenario = env.scenario\n\n  # action indices as defined by CraftLab.action_specs()\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  # index of the target item\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # primitives required to craft a stick (empty dict means stick is primitive)\n  primitives_needed = world.cookbook.primitives_for(stick_idx)\n  if not primitives_needed:\n      primitives_needed = {stick_idx: 1}\n\n  # mutable copies of the grid and agent position\n  grid = scenario.init_grid.copy()\n  pos = scenario.init_pos          # (x, y)\n  actions = []\n\n  # --------------------------------------------------------------\n  # helper utilities\n  # --------------------------------------------------------------\n  from collections import deque\n\n  def bfs(start, goal):\n      \"\"\"Return a list of movement actions from start to goal avoiding occupied cells.\"\"\"\n      W, H = grid.shape[:2]\n      visited = set([start])\n      q = deque([(start, [])])\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for act, (dx, dy) in (\n              (ACTION_DOWN, (0, 1)),\n              (ACTION_UP, (0, -1)),\n              (ACTION_LEFT, (-1, 0)),\n              (ACTION_RIGHT, (1, 0)),\n          ):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H:\n                  # a cell is walkable iff it contains no entities of any kind\n                  if np.any(grid[nx, ny, :] != 0):\n                      continue\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [act]))\n      return None\n\n  def free_adjacent(cell):\n      \"\"\"Return a list of free (unoccupied) cells adjacent to `cell`.\"\"\"\n      adj = []\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          ax, ay = cell[0] + dx, cell[1] + dy\n          if 0 <= ax < grid.shape[0] and 0 <= ay < grid.shape[1]:\n              if not np.any(grid[ax, ay, :] != 0):\n                  adj.append((ax, ay))\n      return adj\n\n  def direction_action(dx, dy):\n      \"\"\"Map a delta to the corresponding movement action (used to set facing direction).\"\"\"\n      if dx == -1 and dy == 0:\n          return ACTION_LEFT\n      if dx == 1 and dy == 0:\n          return ACTION_RIGHT\n      if dx == 0 and dy == -1:\n          return ACTION_UP\n      if dx == 0 and dy == 1:\n          return ACTION_DOWN\n      return None\n\n  # --------------------------------------------------------------\n  # 1. Collect all required primitives\n  # --------------------------------------------------------------\n  for prim_idx, cnt in primitives_needed.items():\n      for _ in range(cnt):\n          # locate any remaining instance of the primitive\n          locs = np.argwhere(grid[:, :, prim_idx] > 0)\n          if len(locs) == 0:\n              continue  # should not happen in a solvable scenario\n          target = tuple(locs[0])  # (x, y)\n\n          # find a free adjacent cell from which we can USE the primitive\n          adj_cells = free_adjacent(target)\n          chosen_adj = None\n          path = None\n          for adj in adj_cells:\n              p = bfs(pos, adj)\n              if p is not None:\n                  chosen_adj, path = adj, p\n                  break\n          if path is None:\n              continue  # cannot reach, skip\n\n          # move to the chosen adjacent cell\n          actions.extend(path)\n          pos = chosen_adj\n\n          # face the primitive (by moving one step towards it, which also sets direction)\n          dx, dy = target[0] - pos[0], target[1] - pos[1]\n          dir_act = direction_action(dx, dy)\n          if dir_act is not None:\n              actions.append(dir_act)\n\n          # use (collect) the primitive\n          actions.append(ACTION_USE)\n\n          # update local grid copy\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # --------------------------------------------------------------\n  # 2. Craft the stick at its workshop (if required)\n  # --------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if len(workshop_cells) > 0:\n          workshop_pos = tuple(workshop_cells[0])\n\n          # find a free adjacent cell next to the workshop\n          adj_cells = free_adjacent(workshop_pos)\n          chosen_adj = None\n          path = None\n          for adj in adj_cells:\n              p = bfs(pos, adj)\n              if p is not None:\n                  chosen_adj, path = adj, p\n                  break\n          if path is not None:\n              actions.extend(path)\n              pos = chosen_adj\n\n              # face the workshop\n              dx, dy = workshop_pos[0] - pos[0], workshop_pos[1] - pos[1]\n              dir_act = direction_action(dx, dy)\n              if dir_act is not None:\n                  actions.append(dir_act)\n\n              # use to craft the stick\n              actions.append(ACTION_USE)\n\n  return actions", "env_interactions": 7, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:47:46.560649", "function_name": "make_stick", "function_body": "  # reset environment to start fresh\n  env.reset()\n  world = env.world\n  scenario = env.scenario\n\n  # action indices as defined by CraftLab.action_specs()\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  # index of the target item (stick)\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # primitives required to craft a stick (empty dict means stick itself is primitive)\n  primitives_needed = world.cookbook.primitives_for(stick_idx)\n  if not primitives_needed:\n      primitives_needed = {stick_idx: 1}\n\n  # mutable copies of the grid and agent position\n  grid = scenario.init_grid.copy()            # (W, H, n_kinds)\n  pos = scenario.init_pos                      # (x, y)\n  actions = []                                 # list of action ints to return\n\n  # ----------------------------------------------------------------------\n  # Helper utilities\n  # ----------------------------------------------------------------------\n  from collections import deque\n\n  def bfs(start, goal):\n      \"\"\"Return a list of movement actions from start to goal avoiding occupied cells.\"\"\"\n      W, H = grid.shape[:2]\n      visited = set()\n      q = deque()\n      q.append((start, []))\n      visited.add(start)\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for act, (dx, dy) in (\n              (ACTION_DOWN, (0, 1)),\n              (ACTION_UP, (0, -1)),\n              (ACTION_LEFT, (-1, 0)),\n              (ACTION_RIGHT, (1, 0)),\n          ):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H:\n                  # a cell is walkable iff it contains no entities of any kind\n                  if np.any(grid[nx, ny, :] != 0):\n                      continue\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [act]))\n      return None  # unreachable\n\n  def free_adjacent(cell):\n      \"\"\"Return a list of free (unoccupied) cells adjacent to `cell`.\"\"\"\n      adj = []\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          ax, ay = cell[0] + dx, cell[1] + dy\n          if 0 <= ax < grid.shape[0] and 0 <= ay < grid.shape[1]:\n              if not np.any(grid[ax, ay, :] != 0):\n                  adj.append((ax, ay))\n      return adj\n\n  def direction_action(dx, dy):\n      \"\"\"Map a delta (dx, dy) to the corresponding movement action (used to set facing direction).\"\"\"\n      if dx == -1 and dy == 0:\n          return ACTION_LEFT\n      if dx == 1 and dy == 0:\n          return ACTION_RIGHT\n      if dx == 0 and dy == -1:\n          return ACTION_UP\n      if dx == 0 and dy == 1:\n          return ACTION_DOWN\n      return None\n\n  def nearest_instance(item_idx):\n      \"\"\"\n      Find the nearest instance of `item_idx` on the map.\n      Returns (path_to_adjacent, adjacent_cell, target_cell) or (None, None, None) if unreachable.\n      \"\"\"\n      best = None\n      best_len = float('inf')\n      # iterate over all locations that contain the item\n      for tx, ty in np.argwhere(grid[:, :, item_idx] > 0):\n          target = (int(tx), int(ty))\n          for adj in free_adjacent(target):\n              path = bfs(pos, adj)\n              if path is not None and len(path) < best_len:\n                  best = (path, adj, target)\n                  best_len = len(path)\n      if best is None:\n          return None, None, None\n      return best\n\n  # ----------------------------------------------------------------------\n  # 1. Collect all required primitive items\n  # ----------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      for _ in range(needed_cnt):\n          path, adj_cell, target_cell = nearest_instance(prim_idx)\n          if path is None:\n              # cannot reach any remaining instance; give up on this primitive\n              continue\n\n          # move to the adjacent cell\n          actions.extend(path)\n          pos = adj_cell\n\n          # face the primitive (by moving one step towards it, which also sets direction)\n          dx, dy = target_cell[0] - pos[0], target_cell[1] - pos[1]\n          dir_act = direction_action(dx, dy)\n          if dir_act is not None:\n              actions.append(dir_act)\n\n          # use (collect) the primitive\n          actions.append(ACTION_USE)\n\n          # update local grid copy\n          grid[target_cell[0], target_cell[1], prim_idx] -= 1\n\n  # ----------------------------------------------------------------------\n  # 2. Craft the stick at its required workshop (if any)\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      # there should be at least one workshop cell of this type\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          wx, wy = workshop_cells[0]\n          workshop_pos = (int(wx), int(wy))\n\n          # find nearest free adjacent cell to the workshop\n          best_path = None\n          best_adj = None\n          for adj in free_adjacent(workshop_pos):\n              p = bfs(pos, adj)\n              if p is not None:\n                  best_path = p\n                  best_adj = adj\n                  break\n\n          if best_path is not None:\n              actions.extend(best_path)\n              pos = best_adj\n\n              # face the workshop\n              dx, dy = workshop_pos[0] - pos[0], workshop_pos[1] - pos[1]\n              dir_act = direction_action(dx, dy)\n              if dir_act is not None:\n                  actions.append(dir_act)\n\n              # use to craft the stick\n              actions.append(ACTION_USE)\n\n  # return the compiled action sequence\n  return actions", "env_interactions": 7, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:48:01.169856", "function_name": "make_stick", "function_body": "  # Get the list of possible action IDs (fallback to default ordering if needed)\n  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      action_ids = [0, 1, 2, 3, 4]  # DOWN, UP, LEFT, RIGHT, USE\n\n  # Resolve the numeric index of the target item \"stick\"\n  try:\n      target_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      target_idx = env.world.cookbook.index.get(\"stick\")\n  if target_idx is None:\n      return []  # stick not defined in this world\n\n  # Ensure the environment is reset and obtain the current internal state\n  if not hasattr(env, \"_current_state\") or env._current_state is None:\n      env.reset()\n  start_state = env._current_state\n\n  # Goal test shortcut: already have a stick\n  if start_state.inventory[target_idx] > 0:\n      return []\n\n  from collections import deque\n\n  # Helper: check if a state satisfies the goal\n  def is_goal(state):\n      return state.satisfies(\"\", target_idx)\n\n  # Encode a state uniquely for visited\u2011set tracking\n  def state_key(st):\n      # Include position, direction, inventory, and grid occupancy (which changes when items are collected)\n      return (st.pos, st.dir, st.inventory.tobytes(), st.grid.tobytes())\n\n  # Bread\u2011first search over deterministic transitions\n  frontier = deque()\n  frontier.append((start_state, []))\n  visited = {state_key(start_state)}\n  max_plan_len = 400  # safety bound to keep search tractable\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      if is_goal(cur_state):\n          return cur_plan\n\n      if len(cur_plan) >= max_plan_len:\n          continue\n\n      for a in action_ids:\n          _, nxt_state = cur_state.step(a)\n          key = state_key(nxt_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((nxt_state, cur_plan + [a]))\n\n  # No plan found within the limits \u2013 return empty list\n  return []", "env_interactions": 4, "island_id": 7, "scores": {"3": 1.5}}
