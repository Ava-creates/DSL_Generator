2. Go to the appropriate workshop and craft the stick\n  # --------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      # locate a workshop of the required type\n      workshop_grid = state.grid[:, :, workshop_kind]\n      workshop_positions = list(zip(*np.where(workshop_grid > 0)))\n      if workshop_positions:\n          _move_to(workshop_positions[0])\n          actions.append(action_map[\"USE\"])\n          env.step(action_map[\"USE\"])\n          state = env._current_state\n\n  # return the recorded action sequence\n  return actions", "env_interactions": 0, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T20:42:55.462796", "function_name": "make_stick", "function_body": "  state = env._current_state\n  world = env.world\n  goal_idx = env.task.goal\n  action_map = env.action_specs()\n  actions = []\n\n  def _move_to(target):\n      \"\"\"Move step\u2011by\u2011step toward target, recording actions.\"\"\"\n      nonlocal state\n      while state.pos != target:\n          x, y = state.pos\n          tx, ty = target\n          if x < tx:\n              act = action_map[\"RIGHT\"]\n          elif x > tx:\n              act = action_map[\"LEFT\"]\n          elif y < ty:\n              act = action_map[\"DOWN\"]\n          else:  # y > ty\n              act = action_map[\"UP\"]\n          actions.append(act)\n          env.step(act)\n          state = env._current_state\n\n  # --------------------------------------------------------------\n  # 1. Gather required primitives for the stick\n  # --------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n  for prim_kind, need_cnt in primitive_needs.items():\n      collected = 0\n      while collected < need_cnt:\n          # locate any remaining instance of this primitive\n          prim_grid = state.grid[:, :, prim_kind]\n          positions = list(zip(*np.where(prim_grid > 0)))\n          if not positions:\n              # primitive missing \u2013 cannot continue\n              break\n          _move_to(positions[0])\n\n          # pick it up\n          actions.append(action_map[\"USE\"])\n          env.step(action_map[\"USE\"])\n          state = env._current_state\n          collected += 1\n\n  # --------------------------------------------------------------\n  # 2. Go to the appropriate workshop and craft the stick\n  # --------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      workshop_grid = state.grid[:, :, workshop_kind]\n      workshop_positions = list(zip(*np.where(workshop_grid > 0)))\n      if workshop_positions:\n          _move_to(workshop_positions[0])\n          actions.append(action_map[\"USE\"])\n          env.step(action_map[\"USE\"])\n          state = env._current_state\n\n  # return the recorded action sequence\n  return actions", "env_interactions": 0, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T20:43:14.450666", "function_name": "make_stick", "function_body": "  # Get the list of possible action IDs.\n  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      # Default ordering used by CraftWorld: DOWN, UP, LEFT, RIGHT, USE\n      action_ids = [0, 1, 2, 3, 4]\n\n  # Resolve the internal index for the target item \"stick\".\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n  if stick_idx is None:\n      # No stick recipe in this world \u2013 nothing to do.\n      return []\n\n  # Make sure the environment has been reset and we have a current state.\n  if not hasattr(env, \"_current_state\") or env._current_state is None:\n      env.reset()\n  start_state = env._current_state\n\n  # If we already hold a stick, no actions are required.\n  if start_state.inventory[stick_idx] > 0:\n      return []\n\n  from collections import deque\n\n  # Encode a state for the visited set (position, direction, inventory, grid).\n  def _state_key(st):\n      return (\n          st.pos,\n          st.dir,\n          st.inventory.tobytes(),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_key(start_state)}\n  frontier = deque()\n  frontier.append((start_state, []))\n\n  MAX_PLAN_LENGTH = 500   # safety limit to keep the search tractable\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      # Goal test.\n      if cur_state.inventory[stick_idx] > 0:\n          return cur_plan\n\n      if len(cur_plan) >= MAX_PLAN_LENGTH:\n          continue\n\n      for a in action_ids:\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((next_state, cur_plan + [a]))\n\n  # No feasible plan found within the limits.\n  return []", "env_interactions": 4, "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T20:43:15.573309", "function_name": "make_stick", "function_body": "  # Determine the list of action IDs the environment understands.\n  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      # Default ordering used by CraftWorld: DOWN, UP, LEFT, RIGHT, USE\n      action_ids = [0, 1, 2, 3, 4]\n\n  # Resolve the internal index for the target item \"stick\".\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n  if stick_idx is None:\n      # No stick recipe in this world \u2013 nothing to do.\n      return []\n\n  # Ensure the environment has been reset and we have a starting state.\n  if not hasattr(env, \"_current_state\") or env._current_state is None:\n      env.reset()\n  start_state = env._current_state\n\n  # If we already possess a stick, no actions are required.\n  if start_state.inventory[stick_idx] > 0:\n      return []\n\n  from collections import deque\n\n  # Helper to create a hashable representation of a state for the visited set.\n  def _state_key(st):\n      # Include position, direction, inventory snapshot, and grid snapshot.\n      return (st.pos, st.dir, st.inventory.tobytes(), st.grid.tobytes())\n\n  visited = {_state_key(start_state)}\n  frontier = deque()\n  frontier.append((start_state, []))\n\n  # Upper bound on plan length to keep the search tractable.\n  MAX_PLAN_LENGTH = 500\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      # Goal test: have at least one stick in the inventory.\n      if cur_state.inventory[stick_idx] > 0:\n          return cur_plan\n\n      # Do not expand beyond the maximum allowed depth.\n      if len(cur_plan) >= MAX_PLAN_LENGTH:\n          continue\n\n      # Explore all possible actions from the current state.\n      for a in action_ids:\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((next_state, cur_plan + [a]))\n\n  # If we exit the loop without returning, no feasible plan was found.\n  return []", "env_interactions": 4, "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T20:43:27.751329", "function_name": "make_stick", "function_body": "  import collections\n\n  # ----- helpers ---------------------------------------------------------\n  def _action_ids():\n      \"\"\"Return list of action integer IDs available in the environment.\"\"\"\n      try:\n          return list(env.action_specs().values())\n      except Exception:\n          # fallback ordering: DOWN, UP, LEFT, RIGHT, USE\n          return [0, 1, 2, 3, 4]\n\n  def _stick_index():\n      \"\"\"Return the internal index for the item \\\"stick\\\".\"\"\"\n      try:\n          return env.world.cookbook.index[\"stick\"]\n      except Exception:\n          return env.world.cookbook.index.get(\"stick\")\n\n  def _state_key(st):\n      \"\"\"Compact hashable representation of a CraftState.\"\"\"\n      # Include position, direction, inventory and grid layout.\n      return (st.pos, st.dir, st.inventory.tobytes(), st.grid.tobytes())\n\n  # ----- initialisation --------------------------------------------------\n  actions = _action_ids()\n  stick_idx = _stick_index()\n\n  # obtain the starting CraftState (lab wrapper may expose it)\n  start_state = getattr(env, \"_current_state\", None)\n  if start_state is None:\n      start_state = env.scenario.init()\n\n  # ----- BFS search -------------------------------------------------------\n  frontier = collections.deque()\n  frontier.append((start_state, []))\n  visited = {_state_key(start_state)}\n\n  MAX_LEN = 500  # safety limit\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      # Goal test: have at least one stick in inventory\n      if stick_idx is not None and cur_state.satisfies(\"\", stick_idx):\n          return cur_plan\n\n      if len(cur_plan) >= MAX_LEN:\n          continue\n\n      for a in actions:\n          _, nxt_state = cur_state.step(a)\n          key = _state_key(nxt_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((nxt_state, cur_plan + [a]))\n\n  # No plan found within limits \u2013 return empty plan\n  return []", "env_interactions": 4, "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T20:43:28.867920", "function_name": "make_stick", "function_body": "  import collections\n\n  # ----- obtain action IDs -----\n  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      # fallback ordering: DOWN, UP, LEFT, RIGHT, USE\n      action_ids = [0, 1, 2, 3, 4]\n\n  # ----- index of the target item (\"stick\") -----\n  try:\n      goal_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      goal_idx = env.world.cookbook.index.get(\"stick\")\n\n  # ----- initial state -----\n  start_state = getattr(env, \"_current_state\", None)\n  if start_state is None:\n      start_state = env.scenario.init()\n\n  # ----- state hashing for visited set -----\n  def _state_key(st):\n      # include position, direction, inventory and full grid to capture changes\n      return (st.pos, st.dir, st.inventory.tobytes(), st.grid.tobytes())\n\n  # ----- BFS planning -----\n  frontier = collections.deque()\n  frontier.append((start_state, []))\n  visited = {_state_key(start_state)}\n  MAX_PLAN_LEN = 500  # safety limit\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      # Goal test: have at least one stick in inventory\n      if goal_idx is not None and cur_state.satisfies(\"\", goal_idx):\n          return cur_plan\n\n      # prune overly long plans\n      if len(cur_plan) >= MAX_PLAN_LEN:\n          continue\n\n      # expand all possible actions\n      for a in action_ids:\n          _, nxt_state = cur_state.step(a)\n          key = _state_key(nxt_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((nxt_state, cur_plan + [a]))\n\n  # No plan found within limits \u2013 return empty list\n  return []", "env_interactions": 4, "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T20:43:43.272556", "function_name": "make_stick", "function_body": "  import collections\n\n  # ----- obtain action IDs -------------------------------------------------\n  try:\n      action_map = env.action_specs()\n      action_ids = list(action_map.values())\n  except Exception:  # fallback to standard ordering (DOWN,UP,LEFT,RIGHT,USE)\n      action_ids = [0, 1, 2, 3, 4]\n\n  # ----- resolve goal index for \"stick\" ------------------------------------\n  try:\n      goal_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      # try alternative attribute names\n      goal_idx = getattr(env, \"world\", None)\n      if goal_idx is not None:\n          goal_idx = getattr(goal_idx, \"cookbook\", None)\n          if goal_idx is not None:\n              goal_idx = goal_idx.index.get(\"stick\")\n      if goal_idx is None:\n          return []  # cannot locate stick index\n\n  # ----- helper to test goal satisfaction ---------------------------------\n  def is_goal(state):\n      return state.satisfies(\"\", goal_idx)\n\n  # ----- obtain starting state --------------------------------------------\n  try:\n      start_state = env._current_state\n  except AttributeError:\n      start_state = getattr(env, \"current_state\", None)\n      if start_state is None:\n          return []  # cannot access state\n\n  # ----- BFS planner -------------------------------------------------------\n  frontier = collections.deque()\n  frontier.append((start_state, []))\n\n  def state_key(st):\n      return (st.pos, st.dir, st.inventory.tobytes())\n\n  visited = {state_key(start_state)}\n  max_plan_len = 200  # safety ceiling\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      if is_goal(cur_state):\n          return cur_plan\n\n      if len(cur_plan) >= max_plan_len:\n          continue\n\n      for a in action_ids:\n          _, nxt_state = cur_state.step(a)\n          key = state_key(nxt_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((nxt_state, cur_plan + [a]))\n\n  # No plan found within limits\n  return []", "env_interactions": 4, "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T20:43:44.386233", "function_name": "make_stick", "function_body": "  # ----------------------------------------------------------------------\n  # Determine the mapping from action names to their integer IDs.\n  # If the environment does not expose this mapping, fall back to the\n  # standard ordering used by CraftWorld: DOWN, UP, LEFT, RIGHT, USE.\n  # ----------------------------------------------------------------------\n  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:  # pragma: no cover\n      action_ids = [0, 1, 2, 3, 4]\n\n  # ----------------------------------------------------------------------\n  # Resolve the integer index of the goal item \"stick\".\n  # ----------------------------------------------------------------------\n  try:\n      goal_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:  # pragma: no cover\n      # Some wrappers expose the world under a different attribute name.\n      world = getattr(env, \"world\", None)\n      if world is not None:\n          goal_idx = world.cookbook.index.get(\"stick\")\n      else:\n          goal_idx = None\n\n  # If we cannot locate the goal index, abort early.\n  if goal_idx is None:\n      return []\n\n  # ----------------------------------------------------------------------\n  # Obtain the current CraftState from the environment.\n  # CraftState.step returns a *new* immutable state, so we can safely\n  # reuse the reference for simulation without affecting the live env.\n  # ----------------------------------------------------------------------\n  try:\n      start_state = env._current_state\n  except AttributeError:  # pragma: no cover\n      start_state = getattr(env, \"current_state\", None)\n      if start_state is None:\n          return []\n\n  # ----------------------------------------------------------------------\n  # Breadth\u2011first search planner.\n  # The visited set encodes position, direction and a compact snapshot of\n  # the inventory (bytes).  The grid itself is static apart from items that\n  # are picked up/placed, which are fully captured by the inventory.\n  # ----------------------------------------------------------------------\n  from collections import deque\n\n  def state_key(st):\n      \"\"\"Compact hashable representation of a CraftState.\"\"\"\n      return (st.pos, st.dir, st.inventory.tobytes())\n\n  frontier = deque()\n  frontier.append((start_state, []))\n  visited = {state_key(start_state)}\n\n  max_plan_len = 300  # safety ceiling to keep the search tractable\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      # Goal test \u2013 inventory contains at least one stick.\n      if cur_state.satisfies(\"\", goal_idx):\n          return cur_plan\n\n      # Prune plans that are already too long.\n      if len(cur_plan) >= max_plan_len:\n          continue\n\n      # Expand all possible actions.\n      for a in action_ids:\n          _, nxt_state = cur_state.step(a)\n\n          key = state_key(nxt_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((nxt_state, cur_plan + [a]))\n\n  # No plan found within the limits \u2013 return an empty list.\n  return []", "env_interactions": 4, "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T20:44:04.323972", "function_name": "make_stick", "function_body": "  ACTION = env.action_specs()\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  # Work on a mutable copy of the grid so we can \"remove\" collected items.\n  grid = state.grid.copy()\n\n  def find_nearest(start_pos, kind):\n      \"\"\"Return coordinates of the closest cell containing `kind` (or None).\"\"\"\n      layer = grid[:, :, kind]\n      ys, xs = np.where(layer > 0)\n      if len(xs) == 0:\n          return None\n      dists = np.abs(xs - start_pos[0]) + np.abs(ys - start_pos[1])\n      i = int(np.argmin(dists))\n      return (int(xs[i]), int(ys[i]))\n\n  def moves_to(cur, target):\n      \"\"\"Generate Manhattan movement actions from cur \u2192 target.\"\"\"\n      seq = []\n      x, y = cur\n      tx, ty = target\n      while x != tx:\n          if tx > x:\n              seq.append(ACTION[\"RIGHT\"])\n              x += 1\n          else:\n              seq.append(ACTION[\"LEFT\"])\n              x -= 1\n      while y != ty:\n          if ty > y:\n              seq.append(ACTION[\"DOWN\"])\n              y += 1\n          else:\n              seq.append(ACTION[\"UP\"])\n              y -= 1\n      return seq\n\n  # ------------------------------------------------------------------\n  # Determine what is needed to obtain a stick\n  # ------------------------------------------------------------------\n  stick_idx = idx[\"stick\"]\n  needed = world.cookbook.primitives_for(stick_idx)  # {primitive_idx: count}\n  plan = []\n  cur_pos = state.pos\n\n  # ------------------------------------------------------------------\n  # Case 1: stick is a primitive (no recipe). Just pick it up.\n  # ------------------------------------------------------------------\n  if not needed:\n      target = find_nearest(cur_pos, stick_idx)\n      if target is not None:\n          plan.extend(moves_to(cur_pos, target))\n          plan.append(ACTION[\"USE\"])\n      return plan\n\n  # ------------------------------------------------------------------\n  # Case 2: stick must be crafted from primitives.\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = find_nearest(cur_pos, prim_idx)\n          if target is None:\n              # Primitive missing \u2013 cannot complete plan; break early.\n              break\n          plan.extend(moves_to(cur_pos, target))\n          plan.append(ACTION[\"USE\"])\n          # Remove the collected primitive from our mutable grid copy.\n          grid[target[1], target[0], prim_idx] = 0\n          cur_pos = target\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the stick.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      wk_idx = idx[workshop_name] if isinstance(workshop_name, str) else workshop_name\n      wk_pos = find_nearest(cur_pos, wk_idx)\n      if wk_pos is not None:\n          plan.extend(moves_to(cur_pos, wk_pos))\n          cur_pos = wk_pos\n\n  # Final USE to perform the crafting action.\n  plan.append(ACTION[\"USE\"])\n  return plan", "env_interactions": 4, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T20:44:05.430540", "function_name": "make_stick", "function_body": "  import numpy as np\n\n  ACTION = env.action_specs()\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def find_nearest_kind(start_pos, kind, grid):\n      \"\"\"Return the coordinates (x, y) of the closest cell containing `kind`\n      in the provided grid. If none found, return None.\"\"\"\n      layer = grid[:, :, kind]\n      ys, xs = np.where(layer > 0)\n      if len(xs) == 0:\n          return None\n      dists = np.abs(xs - start_pos[0]) + np.abs(ys - start_pos[1])\n      i = int(np.argmin(dists))\n      return int(xs[i]), int(ys[i])\n\n  def moves_to(cur, target):\n      \"\"\"Generate a list of movement actions (Manhattan) from cur \u2192 target.\"\"\"\n      seq = []\n      x, y = cur\n      tx, ty = target\n      while x != tx:\n          if tx > x:\n              seq.append(ACTION[\"RIGHT\"])\n              x += 1\n          else:\n              seq.append(ACTION[\"LEFT\"])\n              x -= 1\n      while y != ty:\n          if ty > y:\n              seq.append(ACTION[\"DOWN\"])\n              y += 1\n          else:\n              seq.append(ACTION[\"UP\"])\n              y -= 1\n      return seq\n\n  # ------------------------------------------------------------------\n  # Determine primitives required for a stick\n  # ------------------------------------------------------------------\n  stick_idx = idx[\"stick\"]\n  needed = world.cookbook.primitives_for(stick_idx)   # {primitive_idx: count}\n  plan = []\n  cur_pos = state.pos\n  grid = state.grid.copy()   # mutable copy to mark collected items\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = find_nearest_kind(cur_pos, prim_idx, grid)\n          if target is None:\n              # No more of this primitive on the map; give up\n              continue\n          plan.extend(moves_to(cur_pos, target))\n          plan.append(ACTION[\"USE\"])          # pick up the primitive\n          # mark the primitive as taken\n          grid[target[0], target[1], prim_idx] = 0\n          cur_pos = target\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if required) and craft the stick\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      wk_idx = idx[workshop_name] if isinstance(workshop_name, str) else workshop_name\n      wk_pos = find_nearest_kind(cur_pos, wk_idx, grid)\n      if wk_pos is not None:\n          plan.extend(moves_to(cur_pos, wk_pos))\n          cur_pos = wk_pos\n\n  # Final USE to perform the crafting action\n  plan.append(ACTION[\"USE\"])\n\n  return plan", "env_interactions": 4, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T20:44:25.977551", "function_name": "make_stick", "function_body": "  # Reset the environment to a fresh start.\n  env.reset()\n\n  # Shortcut references to world components.\n  world = env.world\n  scenario = env.scenario\n  grid = scenario.init_grid.copy()          # mutable copy of the world layout\n  pos = list(scenario.init_pos)              # current agent position [x, y]\n\n  # Index of the goal item (stick) for this task.\n  goal_idx = env.task.goal\n\n  # Primitive requirements for the goal (kind \u2192 count). Empty if no recipe.\n  primitive_needs = world.cookbook.primitives_for(goal_idx)\n\n  actions = []   # list of action indices to be returned\n\n  # ------------------------------------------------------------------\n  # Helper: move from current position to target cell using Manhattan moves.\n  # ------------------------------------------------------------------\n  def _move_to(target):\n      nonlocal pos, actions\n      # Horizontal moves (x axis).\n      while pos[0] < target[0]:\n          actions.append(3)   # RIGHT\n          pos[0] += 1\n      while pos[0] > target[0]:\n          actions.append(2)   # LEFT\n          pos[0] -= 1\n      # Vertical moves (y axis).\n      while pos[1] < target[1]:\n          actions.append(0)   # DOWN\n          pos[1] += 1\n      while pos[1] > target[1]:\n          actions.append(1)   # UP\n          pos[1] -= 1\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitive resources.\n  # ------------------------------------------------------------------\n  for kind_idx, needed_cnt in primitive_needs.items():\n      # Find all cells currently containing this primitive.\n      locations = np.argwhere(grid[:, :, kind_idx] == 1)\n\n      for _ in range(needed_cnt):\n          if locations.shape[0] == 0:\n              # No more instances left; break (environment should guarantee enough).\n              break\n\n          # Choose the nearest instance to minimise travel.\n          dists = np.abs(locations - pos).sum(axis=1)\n          nearest = int(np.argmin(dists))\n          target = locations[nearest].tolist()\n\n          # Travel to the primitive and pick it up.\n          _move_to(target)\n          actions.append(4)   # USE (pick up)\n\n          # Update internal grid copy so we don't revisit the same cell.\n          grid[target[0], target[1], kind_idx] = 0\n          locations = np.delete(locations, nearest, axis=0)\n\n  # ------------------------------------------------------------------\n  # 2) If the recipe requires a specific workshop, go there and craft.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get('_at')\n  if workshop_kind is not None:\n      # Locate all workshop cells of the required type.\n      ws_cells = np.argwhere(grid[:, :, workshop_kind] == 1)\n      if ws_cells.shape[0] > 0:\n          dists = np.abs(ws_cells - pos).sum(axis=1)\n          nearest_ws = int(np.argmin(dists))\n          ws_target = ws_cells[nearest_ws].tolist()\n          _move_to(ws_target)\n          actions.append(4)   # USE (craft at workshop)\n\n  # Return the planned sequence of actions.\n  return actions", "env_interactions": 0, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T20:44:27.080223", "function_name": "make_stick", "function_body": "", "env_interactions": 0, "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-10-21T20:45:06.572822", "function_name": "make_stick", "function_body": "  env.reset()\n  world = env.world\n  idx = world.cookbook.index\n\n  # identify stick index\n  try:\n      stick_idx = idx[\"stick\"]\n  except Exception:  # pragma: no cover\n      stick_idx = next(i for i, n in enumerate(idx.ordered_contents) if n.lower() == \"stick\")\n  stick_recipe = world.cookbook.recipes.get(stick_idx, {})\n\n  # primitives needed (raw resources)\n  needed = world.cookbook.primitives_for(stick_idx)\n  if not needed:\n      needed = {stick_idx: 1}\n\n  # action mapping\n  act_map = env.action_specs()\n  DOWN = act_map[\"DOWN\"]\n  UP = act_map[\"UP\"]\n  LEFT = act_map[\"LEFT\"]\n  RIGHT = act_map[\"RIGHT\"]\n  USE = act_map[\"USE\"]\n\n  # snapshot of current state for planning\n  state = env._current_state\n  cur_pos = tuple(state.pos)               # (x, y)\n  grid = state.grid.copy()                 # mutable copy of world grid\n\n  # cells occupied by non\u2011grabbable entities block movement\n  non_grabbable = list(world.non_grabbable_indices)\n  if non_grabbable:\n      blocked = np.any(grid[:, :, non_grabbable] > 0, axis=2)\n  else:\n      blocked = np.zeros(grid.shape[:2], dtype=bool)\n\n  # ------------------------------------------------------------------\n  # helper functions\n  # ------------------------------------------------------------------\n  import collections\n\n  def manhattan_moves(start, goal):\n      \"\"\"Return a list of actions moving Manhattan\u2011style from start to goal.\"\"\"\n      x, y = start\n      gx, gy = goal\n      moves = []\n      while x < gx:\n          moves.append(RIGHT)\n          x += 1\n      while x > gx:\n          moves.append(LEFT)\n          x -= 1\n      while y < gy:\n          moves.append(DOWN)\n          y += 1\n      while y > gy:\n          moves.append(UP)\n          y -= 1\n      return moves\n\n  def bfs_path(start, targets, blocked_mask):\n      \"\"\"Shortest path (BFS) from start to any cell in targets.\"\"\"\n      if start in targets:\n          return []\n      q = collections.deque([start])\n      visited = {start: (None, None)}   # node -> (parent, action)\n      while q:\n          cur = q.popleft()\n          for act, (dx, dy) in ((DOWN, (0, 1)), (UP, (0, -1)),\n                                (LEFT, (-1, 0)), (RIGHT, (1, 0))):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if not (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]):\n                  continue\n              if blocked_mask[nx, ny]:\n                  continue\n              nxt = (nx, ny)\n              if nxt in visited:\n                  continue\n              visited[nxt] = (cur, act)\n              if nxt in targets:\n                  # reconstruct path\n                  path = []\n                  node = nxt\n                  while visited[node][0] is not None:\n                      parent, a = visited[node]\n                      path.append(a)\n                      node = parent\n                  return list(reversed(path))\n              q.append(nxt)\n      # fallback: Manhattan moves ignoring obstacles\n      tx, ty = next(iter(targets))\n      return manhattan_moves(start, (tx, ty))\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      cnt = int(cnt)\n      while cnt > 0:\n          # locate cells that still contain this primitive\n          locations = np.argwhere(grid[:, :, prim_idx] > 0)\n          if locations.size == 0:\n              # nothing left on the map \u2013 abort to avoid infinite loop\n              break\n          # choose the nearest location (Manhattan distance)\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          target = tuple(locations[dists.argmin()])\n\n          # move to the target respecting obstacles\n          path = bfs_path(cur_pos, {target}, blocked)\n          actions.extend(path)\n          cur_pos = target\n\n          # pick up the primitive\n          actions.append(USE)\n          cnt -= 1\n\n          # update simulated grid (remove one instance)\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # ------------------------------------------------------------------\n  # 2. Go to the workshop (if required) and craft the stick\n  # ------------------------------------------------------------------\n  workshop_name = stick_recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = idx[workshop_name]\n      ws_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_locs.size > 0:\n          ws_target = tuple(ws_locs[0])\n          path = bfs_path(cur_pos, {ws_target}, blocked)\n          actions.extend(path)\n          cur_pos = ws_target\n          actions.append(USE)   # craft at the workshop\n\n  return actions", "env_interactions": 4, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T20:45:07.681403", "function_name": "make_stick", "function_body": "", "env_interactions": 0, "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-10-21T20:45:37.951674", "function_name": "make_stick", "function_body": "  # Reset the environment to obtain the initial state.\n  _ = env.reset()\n  state = env._current_state          # type: CraftState\n  world = env.world                    # type: CraftWorld\n  grid = state.grid.copy()             # work on a copy for simulation\n\n  # ------------------------------------------------------------------\n  # Helper functions\n  # ------------------------------------------------------------------\n  # Action indices (as defined in CraftLab.action_specs())\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  def _move_path(src, dst):\n      \"\"\"Return a list of actions that moves from src (x,y) to dst (x,y)\n      using Manhattan moves only.\"\"\"\n      sx, sy = src\n      dx, dy = dst\n      moves = []\n      # vertical movement (y axis)\n      while sy < dy:\n          moves.append(DOWN)\n          sy += 1\n      while sy > dy:\n          moves.append(UP)\n          sy -= 1\n      # horizontal movement (x axis)\n      while sx < dx:\n          moves.append(RIGHT)\n          sx += 1\n      while sx > dx:\n          moves.append(LEFT)\n          sx -= 1\n      return moves\n\n  # ------------------------------------------------------------------\n  # Identify the goal (stick) and its recipe.\n  # ------------------------------------------------------------------\n  stick_idx = world.cookbook.index[\"stick\"]\n  # primitive requirements for one stick\n  prim_req = world.cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n  # workshop where stick must be crafted (if any)\n  workshop_type = world.cookbook.recipes[stick_idx].get(\"_at\")\n  workshop_idx = world.cookbook.index[workshop_type] if workshop_type else None\n\n  actions = []\n  cur_pos = list(state.pos)   # mutable copy of current (x, y)\n\n  # ------------------------------------------------------------------\n  # Collect all required primitives.\n  # ------------------------------------------------------------------\n  # Work on a mutable copy of the requirement dictionary.\n  remaining = dict(prim_req)\n\n  while any(cnt > 0 for cnt in remaining.values()):\n      # pick a primitive that we still need\n      prim_idx, need = next(((k, v) for k, v in remaining.items() if v > 0))\n      # locate all cells that currently contain this primitive\n      locations = np.argwhere(grid[:, :, prim_idx] > 0)\n      if locations.size == 0:\n          # No more of this primitive on the map \u2013 give up.\n          break\n      # choose the nearest one (Manhattan distance)\n      dists = np.sum(np.abs(locations[:, :2] - cur_pos), axis=1)\n      nearest = locations[np.argmin(dists)]\n      target = nearest[:2].tolist()\n\n      # move to the primitive cell\n      actions.extend(_move_path(cur_pos, target))\n      cur_pos = target\n\n      # pick it up\n      actions.append(USE)\n      # simulate the pickup in our local copy of the grid\n      grid[tuple(target) + (prim_idx,)] -= 1\n      remaining[prim_idx] -= 1\n\n  # ------------------------------------------------------------------\n  # Craft the stick at its workshop (if a workshop is required).\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      # find any workshop cell of the required type\n      ws_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_locs.size > 0:\n          ws_target = ws_locs[0][:2].tolist()\n          actions.extend(_move_path(cur_pos, ws_target))\n          cur_pos = ws_target\n          actions.append(USE)   # craft the stick\n\n  return actions", "env_interactions": 4, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T20:45:39.058468", "function_name": "make_stick", "function_body": "  # ----------------------------------------------------------------------\n  # Helper functions -------------------------------------------------------\n  # ----------------------------------------------------------------------\n  def _move_actions(cur_pos, target):\n      \"\"\"Generate movement actions (DOWN,UP,LEFT,RIGHT) to go from cur_pos to target.\"\"\"\n      x, y = cur_pos\n      tx, ty = target\n      acts = []\n      while x < tx:\n          acts.append(3)          # RIGHT\n          x += 1\n      while x > tx:\n          acts.append(2)          # LEFT\n          x -= 1\n      while y < ty:\n          acts.append(0)          # DOWN\n          y += 1\n      while y > ty:\n          acts.append(1)          # UP\n          y -= 1\n      return acts, (x, y)\n\n  def _find_any(grid, kind):\n      \"\"\"Return the (x, y) of any cell that contains the given kind (>0).\"\"\"\n      locs = np.argwhere(grid[:, :, kind] > 0)\n      if locs.size == 0:\n          return None\n      # pick the first occurrence\n      y, x = locs[0]\n      return (int(x), int(y))\n\n  # ----------------------------------------------------------------------\n  # Initialise environment and retrieve world information -----------------\n  # ----------------------------------------------------------------------\n  # reset environment to obtain the initial state\n  env.reset()\n  state = env._current_state          # current CraftState\n  world = env.scenario.world\n  cookbook = world.cookbook\n\n  # index of the target item (stick)\n  stick_idx = cookbook.index[\"stick\"]\n\n  # primitives required to craft a stick (dict {primitive_idx: count})\n  needed = cookbook.primitives_for(stick_idx)\n\n  # workshop where the stick must be crafted\n  workshop_idx = None\n  recipe = cookbook.recipes.get(stick_idx, {})\n  if \"_at\" in recipe:\n      workshop_idx = recipe[\"_at\"]\n\n  # ----------------------------------------------------------------------\n  # Plan actions -----------------------------------------------------------\n  # ----------------------------------------------------------------------\n  actions = []\n  cur_pos = tuple(state.pos)          # mutable copy of the agent position\n\n  # 1) Collect each required primitive\n  for prim_idx, qty in needed.items():\n      for _ in range(qty):\n          target = _find_any(state.grid, prim_idx)\n          if target is None:\n              # primitive not found \u2013 abort planning\n              continue\n          move_acts, cur_pos = _move_actions(cur_pos, target)\n          actions.extend(move_acts)\n          # pick up the primitive\n          actions.append(4)            # USE\n          # after USE we are still on the same cell\n          # (grid changes inside the environment, not needed here)\n\n  # 2) Move to the appropriate workshop and craft the stick\n  if workshop_idx is not None:\n      target = _find_any(state.grid, workshop_idx)\n      if target is not None:\n          move_acts, cur_pos = _move_actions(cur_pos, target)\n          actions.extend(move_acts)\n          actions.append(4)            # USE to craft\n\n  # Return the complete action list\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-10-21T20:46:00.791865", "function_name": "make_stick", "function_body": "  actions = []\n  world = env.world\n  state = env._current_state\n\n  # Helper to convert a move between two adjacent positions into an action index.\n  def move_action(cur, nxt):\n      dx = nxt[0] - cur[0]\n      dy = nxt[1] - cur[1]\n      if dx == 1:\n          return 3  # RIGHT\n      if dx == -1:\n          return 2  # LEFT\n      if dy == 1:\n          return 0  # DOWN\n      if dy == -1:\n          return 1  # UP\n      raise ValueError(\"Invalid move step\")\n\n  # Bread\u2011first search that returns a path (list of positions) from start to any empty\n  # cell orthogonally adjacent to one of the target_cells.\n  def bfs_adjacent(start, target_cells, grid):\n      W, H, _ = grid.shape\n      visited = np.full((W, H), False, dtype=bool)\n      q = collections.deque()\n      q.append((start, [start]))\n      visited[start] = True\n      target_set = {tuple(t) for t in target_cells}\n\n      while q:\n          (x, y), path = q.popleft()\n          # Stop if next to a target.\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n          # Expand neighbours.\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if grid[nx, ny, :].sum() == 0:   # free cell\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [(nx, ny)]))\n      raise RuntimeError(\"No reachable adjacent cell found\")\n\n  # Identify the index of the stick item.\n  stick_idx = world.cookbook.index[\"stick\"]\n  if state.inventory[stick_idx] > 0:\n      return actions  # Already have a stick.\n\n  # Determine which primitive resources are required to craft a stick.\n  primitive_req = world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n  cur_pos = tuple(state.pos)\n\n  # Collect each required primitive.\n  for prim_idx, needed in primitive_req.items():\n      for _ in range(needed):\n          if state.inventory[prim_idx] > 0:\n              continue  # Already holding this primitive.\n\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(\"Required primitive not present on the map\")\n\n          # Find a path to a free cell adjacent to the primitive.\n          path = bfs_adjacent(cur_pos, prim_cells, state.grid)\n\n          # Convert the path into actions.\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n\n          # Pick up the primitive.\n          actions.append(4)  # USE\n\n  # Move to the workshop (if the recipe specifies one) and craft the stick.\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          raise RuntimeError(\"Workshop for stick not found in the world\")\n      path = bfs_adjacent(cur_pos, workshop_cells, state.grid)\n      for step in path[1:]:\n          actions.append(move_action(cur_pos, step))\n          cur_pos = step\n\n  # Use the workshop (or current cell) to perform the crafting action.\n  actions.append(4)  # USE\n\n  return actions", "env_interactions": 5, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T20:46:01.913548", "function_name": "make_stick", "function_body": "  actions = []\n  world = env.world\n  state = env._current_state\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def move_action(cur, nxt):\n      \"\"\"Convert a step from cur to nxt into an action index.\"\"\"\n      dx = nxt[0] - cur[0]\n      dy = nxt[1] - cur[1]\n      if dx == 1:\n          return 3  # RIGHT\n      if dx == -1:\n          return 2  # LEFT\n      if dy == 1:\n          return 0  # DOWN\n      if dy == -1:\n          return 1  # UP\n      raise ValueError(\"Invalid move step\")\n\n  def bfs_adjacent(start, target_cells, grid):\n      \"\"\"\n      Bread\u2011first search for the shortest path from start to any empty cell\n      that is orthogonally adjacent to one of the target_cells.\n      Returns a list of positions including start and the destination.\n      \"\"\"\n      W, H, _ = grid.shape\n      visited = np.full((W, H), False, dtype=bool)\n      q = collections.deque()\n      q.append((start, [start]))\n      visited[start] = True\n      target_set = {tuple(t) for t in target_cells}\n\n      while q:\n          (x, y), path = q.popleft()\n          # If we are next to any target, stop.\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n          # Expand neighbours.\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  # Can step only on empty cells.\n                  if grid[nx, ny, :].sum() == 0:\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [(nx, ny)]))\n      raise RuntimeError(\"No reachable adjacent cell found\")\n\n  # ------------------------------------------------------------------\n  # 1) Identify stick and its recipe.\n  # ------------------------------------------------------------------\n  stick_idx = world.cookbook.index[\"stick\"]\n  if state.inventory[stick_idx] > 0:\n      return actions  # already have a stick\n\n  primitive_req = world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n  cur_pos = tuple(state.pos)\n\n  # ------------------------------------------------------------------\n  # 2) Collect each required primitive.\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitive_req.items():\n      for _ in range(needed):\n          # Skip if we already hold the primitive.\n          if state.inventory[prim_idx] > 0:\n              continue\n\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(\"Required primitive not present on the map\")\n\n          # Find path to an empty cell adjacent to the primitive.\n          path = bfs_adjacent(cur_pos, prim_cells, state.grid)\n\n          # Translate path into actions.\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n\n          # Pick up the primitive.\n          actions.append(4)  # USE\n\n          # Simulate removal of the primitive so we don't target it again.\n          # Find which primitive cell is adjacent to our final position.\n          final_x, final_y = cur_pos\n          for cell in prim_cells:\n              cx, cy = cell\n              if abs(final_x - cx) + abs(final_y - cy) == 1:\n                  state.grid[cx, cy, prim_idx] = 0\n                  break\n\n  # ------------------------------------------------------------------\n  # 3) Move to the appropriate workshop (if any) and craft the stick.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          raise RuntimeError(\"Workshop for stick not found in the world\")\n      path = bfs_adjacent(cur_pos, workshop_cells, state.grid)\n      for step in path[1:]:\n          actions.append(move_action(cur_pos, step))\n          cur_pos = step\n\n  # Finally, use the workshop (or current cell) to craft the stick.\n  actions.append(4)  # USE\n\n  return actions", "env_interactions": 3, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T20:46:23.312513", "function_name": "make_stick", "function_body": "  import numpy as np\n\n  actions = []\n  max_steps = 2000  # safety limit\n  # Continue until the environment signals that the goal is achieved or we hit the step limit.\n  for _ in range(max_steps):\n      # Try to interact with the cell in front of the agent.  In the Craft\n      # environment the ``USE`` action (index 4) attempts to collect or\n      # craft whatever is directly ahead.  If the goal (a stick) has been\n      # obtained the environment will report ``done``.\n      obs, reward, done, info = env.step(4)\n      actions.append(4)\n      if done:\n          break\n\n      # If the goal is not yet reached we move randomly.  The action\n      # indices for movement are 0\u20113 (DOWN, UP, LEFT, RIGHT) as defined by\n      # ``CraftLab.action_specs``.\n      move = np.random.choice([0, 1, 2, 3])\n      obs, reward, done, info = env.step(move)\n      actions.append(move)\n      if done:\n          break\n\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-10-21T20:46:24.429134", "function_name": "make_stick", "function_body": "  # The function receives a CraftLab environment instance.\n  # It builds a short plan consisting of movement (0\u20113) and USE (4) actions\n  # that gathers all primitive ingredients for the current goal and then\n  # crafts the item at the required workshop.\n  # --------------------------------------------------------------------\n  import collections\n  import numpy as np\n\n  # --------------------------------------------------------------------\n  # Helper: translate a step between two adjacent cells into an action.\n  # --------------------------------------------------------------------\n  def _delta_to_action(dx, dy):\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise ValueError(\"Non\u2011adjacent move\")\n\n  # --------------------------------------------------------------------\n  # Helper: BFS that returns a list of positions from start to a goal\n  # position that is *adjacent* (4\u2011connected) to a target cell.\n  # The agent may walk only on empty cells (no kind present).\n  # --------------------------------------------------------------------\n  def _bfs_to_adjacent(start, target, grid, walkable_mask):\n      W, H, _ = grid.shape\n      # all cells that are empty (walkable)\n      empty = (grid.sum(axis=2) == 0) & walkable_mask\n      # set of candidate cells that are adjacent to the target\n      tx, ty = target\n      candidates = []\n      for dx, dy in [(1,0), (-1,0), (0,1), (0,-1)]:\n          cx, cy = tx + dx, ty + dy\n          if 0 <= cx < W and 0 <= cy < H and empty[cx, cy]:\n              candidates.append((cx, cy))\n      if not candidates:\n          return None\n\n      # BFS\n      q = collections.deque()\n      q.append(start)\n      prev = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur in candidates:\n              # reconstruct path\n              path = []\n              while cur is not None:\n                  path.append(cur)\n                  cur = prev[cur]\n              path.reverse()\n              return path\n          x, y = cur\n          for dx, dy in [(1,0), (-1,0), (0,1), (0,-1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and empty[nx, ny]:\n                  nxt = (nx, ny)\n                  if nxt not in prev:\n                      prev[nxt] = cur\n                      q.append(nxt)\n      return None\n\n  # --------------------------------------------------------------------\n  # Gather information about the current task.\n  # --------------------------------------------------------------------\n  state = env._current_state                     # current CraftState\n  world = env.world\n  goal_idx = env.task.goal                       # integer index of desired item\n\n  # recipe for the goal (ingredients + workshop)\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n\n  # primitive requirements (kind \u2192 count)\n  prim_req = world.cookbook.primitives_for(goal_idx)\n\n  actions = []\n\n  # --------------------------------------------------------------------\n  # Walk to each required primitive, pick it up (USE), repeat until all\n  # needed counts are satisfied.\n  # --------------------------------------------------------------------\n  for prim_kind, needed in prim_req.items():\n      for _ in range(needed):\n          # locate a cell that currently contains this primitive\n          grid = state.grid\n          positions = np.argwhere(grid[:, :, prim_kind] > 0)\n          if positions.size == 0:\n              # no more of this primitive on the map \u2013 give up\n              return actions\n          # pick the nearest one (Manhattan distance)\n          cur_x, cur_y = state.pos\n          dists = np.abs(positions[:, 0] - cur_x) + np.abs(positions[:, 1] - cur_y)\n          target_idx = dists.argmin()\n          target_pos = tuple(positions[target_idx])\n\n          # find a walkable path to a cell adjacent to the primitive\n          walkable_mask = np.ones(grid.shape[:2], dtype=bool)\n          # cells occupied by any entity are not walkable\n          occupied = grid.sum(axis=2) > 0\n          walkable_mask[occupied] = False\n          path = _bfs_to_adjacent(state.pos, target_pos, grid, walkable_mask)\n          if path is None:\n              # cannot reach this primitive \u2013 skip it\n              continue\n\n          # convert the path (list of positions) into actions\n          for (x0, y0), (x1, y1) in zip(path, path[1:]):\n              actions.append(_delta_to_action(x1 - x0, y1 - y0))\n              # update internal notion of position\n              state = CraftState(state.scenario, state.grid, (x1, y1), state.dir, state.inventory)\n\n          # now we are adjacent; use action to pick up the primitive\n          actions.append(4)   # USE\n          # simulate the use step to keep our internal state consistent\n          reward, new_state = state.step(4)\n          state = new_state\n\n  # --------------------------------------------------------------------\n  # After collecting primitives, go to the required workshop and craft.\n  # --------------------------------------------------------------------\n  if workshop_kind is not None:\n      # locate the workshop cell\n      grid = state.grid\n      workshop_pos = np.argwhere(grid[:, :, workshop_kind] > 0)\n      if workshop_pos.shape[0] > 0:\n          wx, wy = tuple(workshop_pos[0])\n          # path to a cell adjacent to the workshop\n          walkable_mask = np.ones(grid.shape[:2], dtype=bool)\n          occupied = grid.sum(axis=2) > 0\n          walkable_mask[occupied] = False\n          path = _bfs_to_adjacent(state.pos, (wx, wy), grid, walkable_mask)\n          if path is not None:\n              for (x0, y0), (x1, y1) in zip(path, path[1:]):\n                  actions.append(_delta_to_action(x1 - x0, y1 - y0))\n                  state = CraftState(state.scenario, state.grid, (x1, y1), state.dir, state.inventory)\n              # use the workshop to craft the goal item\n              actions.append(4)   # USE\n              # final step (optional \u2013 not needed for the plan)\n              # reward, state = state.step(4)\n\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T20:46:46.155121", "function_name": "make_stick", "function_body": "  # Reset environment and fetch current state/world\n  env.reset()\n  state = env._current_state\n  world = env.world\n\n  # Action mapping (DOWN,UP,LEFT,RIGHT,USE)\n  DIR_ACTION = {\n      (0, 1): 0,   # DOWN  (y+)\n      (0, -1): 1,  # UP    (y-)\n      (-1, 0): 2,  # LEFT  (x-)\n      (1, 0): 3,   # RIGHT (x+)\n  }\n  USE_ACTION = 4\n\n  # Mutable position of the agent\n  cur_x, cur_y = state.pos\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # 1. Determine which primitives are required to craft a stick\n  # ------------------------------------------------------------------\n  stick_idx = world.cookbook.index.index('stick')\n  needed = world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # 2. Collect each required primitive\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          # Find all remaining locations of this primitive\n          locs = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if locs.size == 0:\n              # No more of this primitive on the map \u2013 give up\n              break\n\n          # Choose the nearest location (Manhattan distance)\n          target = min(locs, key=lambda p: abs(p[0] - cur_x) + abs(p[1] - cur_y))\n          tx, ty = target\n\n          # Move horizontally towards target\n          while cur_x < tx:\n              actions.append(DIR_ACTION[(1, 0)])\n              cur_x += 1\n          while cur_x > tx:\n              actions.append(DIR_ACTION[(-1, 0)])\n              cur_x -= 1\n\n          # Move vertically towards target\n          while cur_y < ty:\n              actions.append(DIR_ACTION[(0, 1)])\n              cur_y += 1\n          while cur_y > ty:\n              actions.append(DIR_ACTION[(0, -1)])\n              cur_y -= 1\n\n          # Pick up the primitive\n          actions.append(USE_ACTION)\n\n          # Mark the primitive as taken in our local copy to avoid revisiting\n          state.grid[tx, ty, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 3. Go to a workshop and craft the stick\n  # ------------------------------------------------------------------\n  workshop_pos = None\n  for wk_idx in world.workshop_indices:\n      locs = np.argwhere(state.grid[:, :, wk_idx] > 0)\n      if locs.size:\n          # Choose the nearest workshop cell\n          workshop_pos = min(locs, key=lambda p: abs(p[0] - cur_x) + abs(p[1] - cur_y))\n          break\n\n  if workshop_pos is not None:\n      wx, wy = workshop_pos\n\n      # Move horizontally to workshop\n      while cur_x < wx:\n          actions.append(DIR_ACTION[(1, 0)])\n          cur_x += 1\n      while cur_x > wx:\n          actions.append(DIR_ACTION[(-1, 0)])\n          cur_x -= 1\n\n      # Move vertically to workshop\n      while cur_y < wy:\n          actions.append(DIR_ACTION[(0, 1)])\n          cur_y += 1\n      while cur_y > wy:\n          actions.append(DIR_ACTION[(0, -1)])\n          cur_y -= 1\n\n      # Craft the stick\n      actions.append(USE_ACTION)\n\n  # Return the full action sequence\n  return actions", "env_interactions": 4, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T20:46:47.283327", "function_name": "make_stick", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n\n  # action mapping\n  DIR_ACTION = {(1, 0): 3, (-1, 0): 2, (0, 1): 0, (0, -1): 1}\n  USE = 4\n\n  # mutable position\n  cur_x, cur_y = state.pos\n\n  actions = []\n\n  # find stick index and needed primitives\n  stick_idx = world.cookbook.index.index('stick')\n  needed = world.cookbook.primitives_for(stick_idx)  # dict {prim_idx: count}\n\n  # make a mutable copy of grid to track collected items\n  grid = state.grid.copy()\n\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          # locate all remaining instances of this primitive\n          locs = np.argwhere(grid[:, :, prim_idx] > 0)\n          if locs.size == 0:\n              # nothing left, break\n              break\n          # choose nearest\n          target = min(locs, key=lambda p: abs(p[0] - cur_x) + abs(p[1] - cur_y))\n          tx, ty = target\n\n          # move horizontally\n          while cur_x < tx:\n              actions.append(DIR_ACTION[(1, 0)])\n              cur_x += 1\n          while cur_x > tx:\n              actions.append(DIR_ACTION[(-1, 0)])\n              cur_x -= 1\n          # move vertically\n          while cur_y < ty:\n              actions.append(DIR_ACTION[(0, 1)])\n              cur_y += 1\n          while cur_y > ty:\n              actions.append(DIR_ACTION[(0, -1)])\n              cur_y -= 1\n\n          # pick up\n          actions.append(USE)\n\n          # remove from copy\n          grid[tx, ty, prim_idx] = 0\n\n  # find a workshop cell\n  workshop_pos = None\n  for wk_idx in world.workshop_indices:\n      locs = np.argwhere(grid[:, :, wk_idx] > 0)\n      if locs.size:\n          workshop_pos = min(locs, key=lambda p: abs(p[0] - cur_x) + abs(p[1] - cur_y))\n          break\n\n  if workshop_pos is not None:\n      wx, wy = workshop_pos\n      while cur_x < wx:\n          actions.append(DIR_ACTION[(1, 0)])\n          cur_x += 1\n      while cur_x > wx:\n          actions.append(DIR_ACTION[(-1, 0)])\n          cur_x -= 1\n      while cur_y < wy:\n          actions.append(DIR_ACTION[(0, 1)])\n          cur_y += 1\n      while cur_y > wy:\n          actions.append(DIR_ACTION[(0, -1)])\n          cur_y -= 1\n      actions.append(USE)\n\n  return actions", "env_interactions": 4, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T20:47:20.231773", "function_name": "make_stick", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # -------------------------------------------------------------------------\n  # Basic references\n  # -------------------------------------------------------------------------\n  state = env._current_state          # current CraftState\n  world = env.world                    # CraftWorld instance\n  goal_idx = env.task.goal             # integer index of the desired item\n\n  # grid dimensions\n  H, W = state.grid.shape[0], state.grid.shape[1]\n\n  # mutable agent position\n  pos = tuple(state.pos)\n\n  actions = []                         # will hold the final action sequence\n\n  # map a movement delta to the corresponding action index\n  delta_to_action = {\n      (1, 0): RIGHT,\n      (-1, 0): LEFT,\n      (0, 1): DOWN,\n      (0, -1): UP,\n  }\n\n  # -------------------------------------------------------------------------\n  # Helper utilities\n  # -------------------------------------------------------------------------\n  def is_walkable(x, y):\n      \"\"\"A cell is walkable if it lies inside the map and contains no entities.\"\"\"\n      return 0 <= x < H and 0 <= y < W and state.grid[x, y].sum() == 0\n\n  def neighbours(x, y):\n      \"\"\"Yield walkable neighbour coordinates.\"\"\"\n      for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n          nx, ny = x + dx, y + dy\n          if is_walkable(nx, ny):\n              yield (nx, ny)\n\n  from collections import deque\n  def bfs(start, goals):\n      \"\"\"\n      Bread\u2011first search from `start` to the nearest cell in `goals`.\n      Returns a list of positions (excluding `start`, including the goal)\n      describing the path, or an empty list if no path exists.\n      \"\"\"\n      q = deque([start])\n      came_from = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur in goals:\n              # reconstruct path\n              path = []\n              while cur != start:\n                  path.append(cur)\n                  cur = came_from[cur]\n              path.reverse()\n              return path\n          for nb in neighbours(*cur):\n              if nb not in came_from:\n                  came_from[nb] = cur\n                  q.append(nb)\n      return []   # no path found\n\n  def move_along(path):\n      \"\"\"Convert a list of positions into actions and update `pos`.\"\"\"\n      nonlocal pos, actions\n      for nxt in path:\n          dx = nxt[0] - pos[0]\n          dy = nxt[1] - pos[1]\n          act = delta_to_action[(dx, dy)]\n          actions.append(act)\n          pos = nxt\n\n  def move_to_adjacent(target_cells):\n      \"\"\"\n      Given world coordinates of one or more target cells (e.g. a primitive or a\n      workshop), move to a walkable cell adjacent to the *nearest* target.\n      Returns the exact target cell we end up adjacent to (or None if unreachable).\n      \"\"\"\n      # all walkable cells that are directly next to any target cell\n      adj_set = set()\n      target_lookup = {}\n      for tx, ty in target_cells:\n          for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              ax, ay = tx + dx, ty + dy\n              if is_walkable(ax, ay):\n                  adj_set.add((ax, ay))\n                  target_lookup[(ax, ay)] = (tx, ty)\n      if not adj_set:\n          return None\n      path = bfs(pos, adj_set)\n      if not path:\n          return None\n      move_along(path)\n      # after moving, `pos` is an adjacent cell\n      return target_lookup[pos]\n\n  def collect_primitive(kind_idx, count):\n      \"\"\"Collect `count` units of the primitive identified by `kind_idx`.\"\"\"\n      for _ in range(count):\n          # locate all cells that currently contain the primitive\n          prim_cells = np.argwhere(state.grid[:, :, kind_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(\"Required primitive not present on the map\")\n          # choose the closest primitive (Manhattan distance heuristic)\n          dists = np.abs(prim_cells[:, 0] - pos[0]) + np.abs(prim_cells[:, 1] - pos[1])\n          target = prim_cells[dists.argmin()]\n          target_coord = tuple(target)\n          # move adjacent to it and use\n          adj_target = move_to_adjacent([target_coord])\n          if adj_target is None:\n              raise RuntimeError(\"Cannot reach required primitive\")\n          actions.append(USE)\n          # update our internal copy of the grid: the primitive disappears after pickup\n          state.grid[target[0], target[1], kind_idx] = 0\n\n  # -------------------------------------------------------------------------\n  # 1. Gather all primitives required for the goal\n  # -------------------------------------------------------------------------\n  primitives_needed = world.cookbook.primitives_for(goal_idx)\n  for kind_idx, needed_cnt in primitives_needed.items():\n      collect_primitive(kind_idx, needed_cnt)\n\n  # -------------------------------------------------------------------------\n  # 2. Go to the appropriate workshop (if any) and craft the item\n  # -------------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          raise RuntimeError(\"Required workshop not found in the world\")\n      # move adjacent to the first workshop cell we encounter\n      move_to_adjacent([tuple(workshop_cells[0])])\n  # perform the crafting action\n  actions.append(USE)\n\n  # Return the complete action list\n  return actions", "env_interactions": 1, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T20:47:21.355943", "function_name": "make_stick", "function_body": "  # action identifiers (consistent with CraftLab)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # -------------------------------------------------------------------------\n  # Basic references\n  # -------------------------------------------------------------------------\n  state = env._current_state          # current CraftState\n  world = env.world                    # CraftWorld instance\n  goal_idx = env.task.goal             # integer index of the desired item\n\n  # grid dimensions\n  H, W = state.grid.shape[0], state.grid.shape[1]\n\n  # mutable agent position (row, col)\n  pos = tuple(state.pos)\n\n  actions = []                         # final action sequence\n\n  # map movement delta to action index\n  delta_to_action = {\n      (1, 0): RIGHT,\n      (-1, 0): LEFT,\n      (0, 1): DOWN,\n      (0, -1): UP,\n  }\n\n  # -------------------------------------------------------------------------\n  # Helper utilities\n  # -------------------------------------------------------------------------\n  def is_walkable(x, y):\n      \"\"\"A cell is walkable if inside the map and contains no entities.\"\"\"\n      return 0 <= x < H and 0 <= y < W and state.grid[x, y].sum() == 0\n\n  def neighbours(x, y):\n      \"\"\"Yield walkable neighbour coordinates.\"\"\"\n      for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n          nx, ny = x + dx, y + dy\n          if is_walkable(nx, ny):\n              yield (nx, ny)\n\n  def bfs(start, goals):\n      \"\"\"Bread\u2011first search from `start` to the nearest cell in `goals`.\"\"\"\n      from collections import deque\n      q = deque([start])\n      came_from = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur in goals:\n              # reconstruct path (excluding start, including cur)\n              path = []\n              while cur != start:\n                  path.append(cur)\n                  cur = came_from[cur]\n              path.reverse()\n              return path\n          for nb in neighbours(*cur):\n              if nb not in came_from:\n                  came_from[nb] = cur\n                  q.append(nb)\n      return []   # no path found\n\n  def move_along(path):\n      \"\"\"Convert a list of positions into actions and update `pos`.\"\"\"\n      nonlocal pos, actions\n      for nxt in path:\n          dx = nxt[0] - pos[0]\n          dy = nxt[1] - pos[1]\n          act = delta_to_action[(dx, dy)]\n          actions.append(act)\n          pos = nxt\n\n  def move_to_adjacent(target_cells):\n      \"\"\"\n      Move to a walkable cell adjacent to the *nearest* target cell.\n      Returns the exact target cell we end up adjacent to (or None).\n      \"\"\"\n      adj_set = set()\n      lookup = {}\n      for tx, ty in target_cells:\n          for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              ax, ay = tx + dx, ty + dy\n              if is_walkable(ax, ay):\n                  adj_set.add((ax, ay))\n                  lookup[(ax, ay)] = (tx, ty)\n      if not adj_set:\n          return None\n      path = bfs(pos, adj_set)\n      if not path:\n          return None\n      move_along(path)\n      return lookup[pos]\n\n  def collect_primitive(kind_idx, count):\n      \"\"\"Collect `count` units of primitive `kind_idx`.\"\"\"\n      for _ in range(count):\n          # locate all cells currently holding the primitive\n          prim_cells = np.argwhere(state.grid[:, :, kind_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(\"Primitive not found on the map\")\n          # choose the closest one (Manhattan distance)\n          dists = np.abs(prim_cells[:, 0] - pos[0]) + np.abs(prim_cells[:, 1] - pos[1])\n          target = tuple(prim_cells[dists.argmin()])\n          # move adjacent and pick up\n          adj_target = move_to_adjacent([target])\n          if adj_target is None:\n              raise RuntimeError(\"Cannot reach primitive\")\n          actions.append(USE)\n          # update our internal copy of the grid so subsequent searches ignore it\n          state.grid[target[0], target[1], kind_idx] = 0\n\n  # -------------------------------------------------------------------------\n  # 1. Gather required primitives for the goal\n  # -------------------------------------------------------------------------\n  primitives_needed = world.cookbook.primitives_for(goal_idx)\n  for kind_idx, needed_cnt in primitives_needed.items():\n      collect_primitive(kind_idx, needed_cnt)\n\n  # -------------------------------------------------------------------------\n  # 2. Move to the appropriate workshop (if any) and craft\n  # -------------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          raise RuntimeError(\"Workshop not present in the world\")\n      move_to_adjacent([tuple(workshop_cells[0])])\n      actions.append(USE)   # perform crafting\n\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T20:47:39.665678", "function_name": "make_stick", "function_body": "  import numpy as np\n\n  # basic handles\n  ACTION = env.action_specs()                     # action name \u2192 int\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  # target item index (stick)\n  stick_idx = idx[\"stick\"]\n  # primitives required to craft a stick (dict {prim_idx: count})\n  needed = world.cookbook.primitives_for(stick_idx)\n\n  actions = []\n  cur_pos = tuple(state.pos)\n  # work on a mutable copy of the grid so we can \u201cremove\u201d collected items\n  grid = state.grid.copy()\n\n  def find_nearest(start, kind):\n      \"\"\"Return coordinates of the nearest cell that currently contains `kind`,\n      or None if none exist.\"\"\"\n      layer = grid[:, :, kind]\n      ys, xs = np.where(layer > 0)\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - start[0]) + np.abs(ys - start[1])\n      i = int(np.argmin(dists))\n      return (int(xs[i]), int(ys[i]))\n\n  def moves_to(cur, target):\n      \"\"\"Generate a list of movement actions (Manhattan path) from cur to target.\"\"\"\n      seq = []\n      x, y = cur\n      tx, ty = target\n      while x != tx:\n          if tx > x:\n              seq.append(ACTION[\"RIGHT\"])\n              x += 1\n          else:\n              seq.append(ACTION[\"LEFT\"])\n              x -= 1\n      while y != ty:\n          if ty > y:\n              seq.append(ACTION[\"DOWN\"])\n              y += 1\n          else:\n              seq.append(ACTION[\"UP\"])\n              y -= 1\n      return seq\n\n  # --- 1. collect all required primitives ---------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          tgt = find_nearest(cur_pos, prim_idx)\n          if tgt is None:\n              # No more of this primitive on the map \u2013 abort collection.\n              break\n          # move next to the primitive\n          actions.extend(moves_to(cur_pos, tgt))\n          # pick it up\n          actions.append(ACTION[\"USE\"])\n          # update our internal grid representation\n          grid[tgt[1], tgt[0], prim_idx] = 0\n          cur_pos = tgt\n\n  # --- 2. go to the workshop (if the recipe specifies one) ----------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      # workshop may be given as a string name or directly as an index\n      wk_idx = idx[workshop_name] if isinstance(workshop_name, str) else workshop_name\n      wk_pos = find_nearest(cur_pos, wk_idx)\n      if wk_pos is not None:\n          actions.extend(moves_to(cur_pos, wk_pos))\n          cur_pos = wk_pos\n\n  # --- 3. finally craft the stick -----------------------------------------\n  actions.append(ACTION[\"USE\"])\n\n  return actions", "env_interactions": 4, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T20:47:40.785768", "function_name": "make_stick", "function_body": "  import numpy as np\n\n  ACTION = env.action_specs()\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  # index of the target item\n  stick_idx = idx[\"stick\"]\n  # primitives required to craft the stick\n  needed = world.cookbook.primitives_for(stick_idx)\n\n  actions = []\n  cur_pos = tuple(state.pos)\n  grid = state.grid\n\n  def find_nearest(start, kind):\n      \"\"\"Return coordinates of the nearest cell containing `kind`.\"\"\"\n      layer = grid[:, :, kind]\n      ys, xs = np.where(layer > 0)\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - start[0]) + np.abs(ys - start[1])\n      i = int(np.argmin(dists))\n      return (int(xs[i]), int(ys[i]))\n\n  def moves_to(cur, target):\n      \"\"\"Generate Manhattan movement actions from cur to target.\"\"\"\n      seq = []\n      x, y = cur\n      tx, ty = target\n      while x != tx:\n          if tx > x:\n              seq.append(ACTION[\"RIGHT\"])\n              x += 1\n          else:\n              seq.append(ACTION[\"LEFT\"])\n              x -= 1\n      while y != ty:\n          if ty > y:\n              seq.append(ACTION[\"DOWN\"])\n              y += 1\n          else:\n              seq.append(ACTION[\"UP\"])\n              y -= 1\n      return seq\n\n  # Collect each required primitive\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          tgt = find_nearest(cur_pos, prim_idx)\n          if tgt is None:\n              continue  # primitive not present; skip\n          actions.extend(moves_to(cur_pos, tgt))\n          actions.append(ACTION[\"USE\"])  # pick up\n          cur_pos = tgt\n\n  # Move to the required workshop, if any\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      wk_idx = idx[workshop_name] if isinstance(workshop_name, str) else workshop_name\n      wk_pos = find_nearest(cur_pos, wk_idx)\n      if wk_pos is not None:\n          actions.extend(moves_to(cur_pos, wk_pos))\n          cur_pos = wk_pos\n\n  # Final use action to craft the stick (or pick it up if primitive)\n  actions.append(ACTION[\"USE\"])\n\n  return actions", "env_interactions": 4, "island_id": 4, "scores": {"3": 0.0}}
