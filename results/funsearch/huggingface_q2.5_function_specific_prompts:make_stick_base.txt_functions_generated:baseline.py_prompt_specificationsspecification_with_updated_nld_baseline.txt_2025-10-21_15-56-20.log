{"timestamp": "2025-10-21T21:28:13.799423", "function_name": "make_stick", "function_body": "  # Reset the environment and obtain the initial state\n  env.reset()\n  state = env._current_state\n\n  # Goal item index and required primitive resources\n  goal_idx = env.task.goal\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n\n  # Action mapping (fallback to default indices if not provided)\n  action_map = env.action_specs()\n  if not isinstance(action_map, dict):\n      action_map = {'DOWN': 0, 'UP': 1, 'LEFT': 2, 'RIGHT': 3, 'USE': 4}\n\n  # Mapping from movement delta to action index\n  delta_to_action = {\n      (1, 0): action_map['DOWN'],\n      (-1, 0): action_map['UP'],\n      (0, 1): action_map['RIGHT'],\n      (0, -1): action_map['LEFT'],\n  }\n\n  # Bread\u2011first search returning a list of positions (excluding the start,\n  # including the target) that leads to the nearest cell containing `target_idx`.\n  from collections import deque\n\n  def bfs_to_target(start, target_idx):\n      W, H, _ = state.grid.shape\n      occupied = np.any(state.grid, axis=2)          # any non\u2011empty cell blocks movement\n      visited = np.zeros((W, H), dtype=bool)\n      prev = np.empty((W, H, 2), dtype=int)\n\n      q = deque([start])\n      visited[start[0], start[1]] = True\n\n      while q:\n          x, y = q.popleft()\n          if state.grid[x, y, target_idx] > 0:\n              # Reconstruct path from start (exclusive) to target (inclusive)\n              path = []\n              cx, cy = x, y\n              while (cx, cy) != start:\n                  path.append((cx, cy))\n                  cx, cy = tuple(prev[cx, cy])\n              path.reverse()\n              return path\n\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  # Can step onto empty cells or directly onto the target cell\n                  if not occupied[nx, ny] or state.grid[nx, ny, target_idx] > 0:\n                      visited[nx, ny] = True\n                      prev[nx, ny] = (x, y)\n                      q.append((nx, ny))\n      # Target unreachable\n      return []\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # ----------------------------------------------------------------------\n  # 1. Collect all required primitive resources.\n  # ----------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      for _ in range(needed_cnt):\n          path = bfs_to_target(cur_pos, prim_idx)\n\n          # Follow the path, updating the environment after each move\n          for nxt in path:\n              dx, dy = nxt[0] - cur_pos[0], nxt[1] - cur_pos[1]\n              act = delta_to_action[(dx, dy)]\n              actions.append(act)\n              _, state = env.step(act)          # apply movement\n              cur_pos = tuple(state.pos)\n\n          # Pick up the primitive at the target cell\n          actions.append(action_map['USE'])\n          _, state = env.step(action_map['USE'])\n          cur_pos = tuple(state.pos)\n\n  # ----------------------------------------------------------------------\n  # 2. Move to the appropriate workshop (if any) and craft the goal.\n  # ----------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop = recipe.get('_at')\n  if workshop is not None:\n      # Resolve workshop index if a name string is provided\n      if isinstance(workshop, str):\n          workshop_idx = env.world.cookbook.index.index(workshop)\n      else:\n          workshop_idx = workshop\n\n      path = bfs_to_target(cur_pos, workshop_idx)\n      for nxt in path:\n          dx, dy = nxt[0] - cur_pos[0], nxt[1] - cur_pos[1]\n          act = delta_to_action[(dx, dy)]\n          actions.append(act)\n          _, state = env.step(act)\n          cur_pos = tuple(state.pos)\n\n      # Use the workshop to craft the item\n      actions.append(action_map['USE'])\n      _, state = env.step(action_map['USE'])\n\n  # Return the complete action sequence\n  return actions", "env_interactions": 0, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:28:47.930177", "function_name": "make_stick", "function_body": "  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  # determine goal index\n  goal_idx = None\n  if hasattr(env, \"task\") and hasattr(env.task, \"goal\"):\n      goal_idx = env.task.goal\n  elif hasattr(env, \"goal\"):\n      goal_idx = env.goal\n  if goal_idx is None:\n      return []\n\n  # primitives needed\n  needed = cookbook.primitives_for(goal_idx)  # dict {prim_idx: count}\n  actions = []\n  cur = list(state.pos)  # [row, col]\n\n  def move_to(target):\n      nonlocal cur, actions\n      while cur[0] != target[0] or cur[1] != target[1]:\n          if cur[0] < target[0]:\n              actions.append(0); cur[0] += 1\n          elif cur[0] > target[0]:\n              actions.append(1); cur[0] -= 1\n          elif cur[1] < target[1]:\n              actions.append(3); cur[1] += 1\n          elif cur[1] > target[1]:\n              actions.append(2); cur[1] -= 1\n\n  # collect each primitive\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          positions = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if positions.size == 0:\n              break\n          dists = np.abs(positions[:, 0] - cur[0]) + np.abs(positions[:, 1] - cur[1])\n          nearest = positions[dists.argmin()]\n          move_to([int(nearest[0]), int(nearest[1])])\n          actions.append(4)   # USE\n\n  # go to workshop if required\n  recipe = cookbook.recipes.get(goal_idx, {})\n  ws_idx = recipe.get(\"_at\")\n  if ws_idx is not None:\n      ws_cells = np.argwhere(state.grid[:, :, ws_idx] > 0)\n      if ws_cells.size:\n          dists = np.abs(ws_cells[:, 0] - cur[0]) + np.abs(ws_cells[:, 1] - cur[1])\n          nearest = ws_cells[dists.argmin()]\n          move_to([int(nearest[0]), int(nearest[1])])\n          actions.append(4)\n\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:28:49.041563", "function_name": "make_stick", "function_body": "  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  # Determine the goal item index\n  goal_idx = None\n  if hasattr(env, \"task\") and hasattr(env.task, \"goal\"):\n      goal_idx = env.task.goal\n  elif hasattr(env, \"goal\"):\n      goal_idx = env.goal\n  if goal_idx is None:\n      return []\n\n  # Primitive requirements for the goal (may be empty)\n  required_prims = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n  actions = []\n  cur_pos = list(state.pos)  # mutable copy of current (row, col)\n\n  # Pre\u2011compute blocked cells (non\u2011grabbable entities)\n  height, width = state.grid.shape[:2]\n  blocked = np.zeros((height, width), dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= state.grid[:, :, idx] > 0\n\n  # Helper: BFS to the nearest target cell while avoiding blocked cells\n  from collections import deque\n\n  def bfs_to_target(start, target_set):\n      \"\"\"Return (action_list, target_cell) for the nearest cell in target_set.\"\"\"\n      sr, sc = start\n      if (sr, sc) in target_set:\n          return [], (sr, sc)\n      visited = np.full((height, width), False, dtype=bool)\n      q = deque()\n      q.append((sr, sc, []))\n      visited[sr, sc] = True\n      while q:\n          r, c, path = q.popleft()\n          for dr, dc, act in ((1, 0, 0), (-1, 0, 1), (0, -1, 2), (0, 1, 3)):\n              nr, nc = r + dr, c + dc\n              if 0 <= nr < height and 0 <= nc < width and not visited[nr, nc] and not blocked[nr, nc]:\n                  if (nr, nc) in target_set:\n                      return path + [act], (nr, nc)\n                  visited[nr, nc] = True\n                  q.append((nr, nc, path + [act]))\n      return None, None  # no reachable target\n\n  # Keep track of already collected primitive positions\n  collected = {}\n\n  # Collect each required primitive the necessary number of times\n  for prim_idx, needed in required_prims.items():\n      collected.setdefault(prim_idx, set())\n      for _ in range(needed):\n          # Locate all remaining instances of this primitive on the grid\n          positions = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if positions.size == 0:\n              break\n          # Filter out positions already collected\n          target_set = {\n              (int(r), int(c))\n              for r, c in positions\n              if (int(r), int(c)) not in collected[prim_idx]\n          }\n          if not target_set:\n              break\n\n          # Find shortest path to the nearest instance\n          path, target = bfs_to_target(tuple(cur_pos), target_set)\n          if path is None:\n              # Fallback: simple Manhattan moves ignoring obstacles\n              tr, tc = target\n              while cur_pos[0] < tr:\n                  actions.append(0); cur_pos[0] += 1\n              while cur_pos[0] > tr:\n                  actions.append(1); cur_pos[0] -= 1\n              while cur_pos[1] < tc:\n                  actions.append(3); cur_pos[1] += 1\n              while cur_pos[1] > tc:\n                  actions.append(2); cur_pos[1] -= 1\n          else:\n              actions.extend(path)\n              cur_pos[0], cur_pos[1] = target\n\n          # Pick up the primitive\n          actions.append(4)  # USE\n          collected[prim_idx].add(target)\n\n  # After gathering primitives, go to the appropriate workshop (if any) to craft\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_idx = recipe.get(\"_at\")\n  if workshop_idx is not None:\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          target_set = {(int(r), int(c)) for r, c in workshop_cells}\n          path, target = bfs_to_target(tuple(cur_pos), target_set)\n          if path is None:\n              tr, tc = target\n              while cur_pos[0] < tr:\n                  actions.append(0); cur_pos[0] += 1\n              while cur_pos[0] > tr:\n                  actions.append(1); cur_pos[0] -= 1\n              while cur_pos[1] < tc:\n                  actions.append(3); cur_pos[1] += 1\n              while cur_pos[1] > tc:\n                  actions.append(2); cur_pos[1] -= 1\n          else:\n              actions.extend(path)\n              cur_pos[0], cur_pos[1] = target\n          actions.append(4)  # USE to craft the final item\n\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:29:21.758177", "function_name": "make_stick", "function_body": "  actions = []\n  # Reset environment and get initial observation\n  obs = env.reset()\n  # Access world and cookbook\n  world = env.world\n  cookbook = world.cookbook\n  # Goal item index\n  goal_idx = env.task.goal\n  # Required primitives for the goal (may be empty if goal is primitive)\n  required = cookbook.primitives_for(goal_idx)  # dict {prim_idx: count}\n  # Recipe for the goal (may contain workshop info)\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  if \"_at\" in recipe:\n      workshop_name = recipe[\"_at\"]\n      workshop_idx = cookbook.index[workshop_name]\n  # Helper: extract integer position from normalized observation\n  def get_pos(ob):\n      pos_norm = ob[\"features_dict\"][\"pos\"]\n      grid = ob[\"features_dict\"][\"features_global\"]\n      w, h = grid.shape[0], grid.shape[1]\n      return (int(round(pos_norm[0] * (w - 1))),\n              int(round(pos_norm[1] * (h - 1))))\n  # Helper: current inventory vector\n  def get_inventory(ob):\n      return ob[\"features_dict\"][\"inventory\"]\n  # Helper: locate all cells containing a given kind index\n  def find_cells(ob, kind):\n      grid = ob[\"features_dict\"][\"features_global\"]\n      xs, ys = np.where(grid[:, :, kind] > 0)\n      return list(zip(xs.tolist(), ys.tolist()))\n  # Helper: choose a move action that reduces Manhattan distance to target\n  def move_towards(cur, tgt):\n      cx, cy = cur\n      tx, ty = tgt\n      if cx < tx:\n          return 3  # RIGHT\n      if cx > tx:\n          return 2  # LEFT\n      if cy < ty:\n          return 0  # DOWN\n      if cy > ty:\n          return 1  # UP\n      return None\n  # Helper: face a neighboring cell and use\n  def face_and_use(cur, neigh):\n      # Determine direction needed to face neigh from cur\n      cx, cy = cur\n      nx, ny = neigh\n      if nx > cx:\n          dir_act = 3  # RIGHT\n      elif nx < cx:\n          dir_act = 2  # LEFT\n      elif ny > cy:\n          dir_act = 0  # DOWN\n      else:\n          dir_act = 1  # UP\n      # Move one step towards neigh (this also sets direction)\n      actions.append(dir_act)\n      _, _, ob = env.step(dir_act)\n      # Use action\n      actions.append(4)  # USE\n      _, _, ob = env.step(4)\n      return ob\n  # ----------------------------------------------------------------------\n  # Collect all required primitives\n  inventory = get_inventory(obs)\n  for prim_idx, needed_cnt in required.items():\n      while inventory[prim_idx] < needed_cnt:\n          # Find all cells containing this primitive\n          cells = find_cells(obs, prim_idx)\n          if not cells:\n              # No more primitives left on the map; break to avoid infinite loop\n              break\n          # Choose the closest cell (Manhattan distance)\n          cur_pos = get_pos(obs)\n          distances = [(abs(px - cur_pos[0]) + abs(py - cur_pos[1]), (px, py))\n                       for (px, py) in cells]\n          _, target = min(distances, key=lambda x: x[0])\n          # Navigate to a neighboring cell of the target\n          while True:\n              cur_pos = get_pos(obs)\n              manhattan = abs(cur_pos[0] - target[0]) + abs(cur_pos[1] - target[1])\n              if manhattan == 1:\n                  # Adjacent: face the target and use\n                  obs = face_and_use(cur_pos, target)\n                  inventory = get_inventory(obs)\n                  break\n              # Move one step towards the target\n              act = move_towards(cur_pos, target)\n              if act is None:\n                  break\n              actions.append(act)\n              _, _, obs = env.step(act)\n              if obs[\"features_dict\"][\"pos\"] is None:  # safety\n                  break\n  # ----------------------------------------------------------------------\n  # If the recipe requires a workshop, go there and craft\n  if workshop_idx is not None:\n      # Locate workshop cells\n      workshop_cells = find_cells(obs, workshop_idx)\n      if workshop_cells:\n          cur_pos = get_pos(obs)\n          distances = [(abs(px - cur_pos[0]) + abs(py - cur_pos[1]), (px, py))\n                       for (px, py) in workshop_cells]\n          _, target_ws = min(distances, key=lambda x: x[0])\n          # Navigate to a neighboring cell of the workshop\n          while True:\n              cur_pos = get_pos(obs)\n              manhattan = abs(cur_pos[0] - target_ws[0]) + abs(cur_pos[1] - target_ws[1])\n              if manhattan == 1:\n                  # Adjacent: face the workshop and use to craft\n                  _, _, obs = env.step(move_towards(cur_pos, target_ws))\n                  actions.append(move_towards(cur_pos, target_ws))\n                  actions.append(4)  # USE to craft\n                  _, _, obs = env.step(4)\n                  break\n              act = move_towards(cur_pos, target_ws)\n              if act is None:\n                  break\n              actions.append(act)\n              _, _, obs = env.step(act)\n  # Return the compiled list of actions\n  return actions", "env_interactions": 0, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:29:22.885804", "function_name": "make_stick", "function_body": "  # Reset the environment and obtain the initial observation.\n  obs = env.reset()\n  actions = []\n\n  # Retrieve the integer index that corresponds to the item \"stick\"\n  # (the Index class implements __getitem__ for name \u2192 int mapping).\n  stick_idx = env.world.cookbook.index[\"stick\"]\n\n  # Helper to check whether we already have a stick in the inventory.\n  def have_stick(observation):\n      inv = observation.get(\"features_dict\", {}).get(\"inventory\")\n      if inv is None:\n          return False\n      # inventory is a numpy array indexed by kind IDs.\n      return int(inv[stick_idx]) > 0\n\n  # Simple random\u2011action exploration until the stick appears or a step limit is hit.\n  max_steps = 1000\n  for _ in range(max_steps):\n      if have_stick(obs):\n          break\n\n      # Choose a random action from the five possible actions (0\u20134).\n      act = int(np.random.randint(0, 5))\n      actions.append(act)\n\n      # Apply the action; CraftLab's step returns (reward, done, observation).\n      _, done, obs = env.step(act)\n\n      # If the environment signals termination, stop early.\n      if done:\n          break\n\n  return actions", "env_interactions": 0, "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-10-21T21:29:50.764259", "function_name": "make_stick", "function_body": "  # Ensure the environment is reset to obtain the initial state.\n  _ = env.reset()\n  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  # ------------------------------------------------------------------\n  # Determine the goal item index.\n  # ------------------------------------------------------------------\n  goal_idx = None\n  if hasattr(env, \"task\") and hasattr(env.task, \"goal\"):\n      goal_idx = env.task.goal\n  if goal_idx is None and hasattr(env, \"goal\"):\n      goal_idx = env.goal\n  if goal_idx is None:\n      # Fallback to the \"stick\" item if the goal cannot be inferred.\n      goal_idx = cookbook.index.get(\"stick\")\n  if goal_idx is None:\n      return []\n\n  # ------------------------------------------------------------------\n  # Primitive requirements for the goal (including counts).\n  # ------------------------------------------------------------------\n  prim_req = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Action mapping (DOWN, UP, LEFT, RIGHT, USE).\n  # ------------------------------------------------------------------\n  action_map = env.action_specs()\n  DOWN = action_map[\"DOWN\"]\n  UP = action_map[\"UP\"]\n  LEFT = action_map[\"LEFT\"]\n  RIGHT = action_map[\"RIGHT\"]\n  USE = action_map[\"USE\"]\n\n  # ------------------------------------------------------------------\n  # Helper to generate Manhattan moves from cur to target.\n  # ------------------------------------------------------------------\n  def _move_to(cur, target):\n      moves = []\n      x, y = cur\n      tx, ty = target\n      while x != tx:\n          if x < tx:\n              moves.append(DOWN)\n              x += 1\n          else:\n              moves.append(UP)\n              x -= 1\n      while y != ty:\n          if y < ty:\n              moves.append(RIGHT)\n              y += 1\n          else:\n              moves.append(LEFT)\n              y -= 1\n      return moves\n\n  actions = []\n  cur_pos = list(state.pos)          # mutable current position\n  grid = state.grid.copy()           # local copy to track collected items\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the necessary number of times.\n  # ------------------------------------------------------------------\n  for prim_idx, needed in prim_req.items():\n      for _ in range(needed):\n          # Locate remaining instances of this primitive on the grid.\n          locations = np.argwhere(grid[:, :, prim_idx] > 0)\n          if locations.size == 0:\n              # No more instances available; abort early.\n              break\n          # Choose the nearest instance (Manhattan distance).\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          nearest = locations[dists.argmin()]\n          target = nearest[:2].tolist()\n\n          # Move to the primitive cell.\n          actions.extend(_move_to(cur_pos, target))\n          cur_pos = target\n\n          # Pick up the primitive.\n          actions.append(USE)\n          grid[tuple(target) + (prim_idx,)] -= 1   # update local copy\n\n  # ------------------------------------------------------------------\n  # If the recipe requires a specific workshop, go there and craft.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_type = recipe.get(\"_at\")\n  if workshop_type is not None:\n      # Resolve workshop index (may be a string name or already an index).\n      if isinstance(workshop_type, str):\n          workshop_idx = cookbook.index[workshop_type]\n      else:\n          workshop_idx = workshop_type\n      ws_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_locs.size > 0:\n          dists = np.abs(ws_locs[:, 0] - cur_pos[0]) + np.abs(ws_locs[:, 1] - cur_pos[1])\n          ws_target = ws_locs[dists.argmin()][:2].tolist()\n          actions.extend(_move_to(cur_pos, ws_target))\n          cur_pos = ws_target\n          actions.append(USE)   # craft at the workshop\n\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:29:51.872124", "function_name": "make_stick", "function_body": "  # Reset environment to ensure a fresh state (ignore returned observation)\n  _ = env.reset()\n  state = env._current_state          # type: CraftState\n  world = env.world                    # type: CraftWorld\n  cookbook = world.cookbook\n\n  # Action indices from the environment's action specifications\n  act_spec = env.action_specs()\n  DOWN = act_spec[\"DOWN\"]\n  UP = act_spec[\"UP\"]\n  LEFT = act_spec[\"LEFT\"]\n  RIGHT = act_spec[\"RIGHT\"]\n  USE = act_spec[\"USE\"]\n\n  # Index of the target item (\"stick\")\n  stick_idx = cookbook.index[\"stick\"]\n\n  # Primitive requirements for one stick\n  prim_req = cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n\n  # Workshop (if any) where the stick must be crafted\n  workshop_type = cookbook.recipes.get(stick_idx, {}).get(\"_at\")\n  workshop_idx = cookbook.index[workshop_type] if workshop_type else None\n\n  # Work on a mutable copy of the grid to simulate pickups\n  grid = state.grid.copy()\n  cur_pos = list(state.pos)   # mutable (row, col)\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper: generate Manhattan moves from current position to a target\n  # ------------------------------------------------------------------\n  def _move_path(src, dst):\n      sx, sy = src\n      dx, dy = dst\n      moves = []\n      # vertical moves (row axis)\n      while sx < dx:\n          moves.append(DOWN)\n          sx += 1\n      while sx > dx:\n          moves.append(UP)\n          sx -= 1\n      # horizontal moves (col axis)\n      while sy < dy:\n          moves.append(RIGHT)\n          sy += 1\n      while sy > dy:\n          moves.append(LEFT)\n          sy -= 1\n      return moves\n\n  # ------------------------------------------------------------------\n  # Collect required primitives\n  # ------------------------------------------------------------------\n  remaining = dict(prim_req)  # mutable copy of needed counts\n\n  while any(cnt > 0 for cnt in remaining.values()):\n      # pick a primitive we still need\n      prim_idx, need = next(((k, v) for k, v in remaining.items() if v > 0))\n      # locate all cells containing this primitive\n      locations = np.argwhere(grid[:, :, prim_idx] > 0)\n      if locations.size == 0:\n          # No more of this primitive on the map \u2013 abort collection\n          break\n      # choose the nearest one (Manhattan distance)\n      dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n      nearest = locations[dists.argmin()]\n      target = nearest[:2].tolist()\n\n      # move to the primitive cell\n      actions.extend(_move_path(cur_pos, target))\n      cur_pos = target\n\n      # pick it up\n      actions.append(USE)\n      # simulate removal from the grid copy\n      grid[target[0], target[1], prim_idx] -= 1\n      remaining[prim_idx] -= 1\n\n  # ------------------------------------------------------------------\n  # Craft at the required workshop (if any)\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_locs.size > 0:\n          ws_target = ws_locs[0][:2].tolist()\n          actions.extend(_move_path(cur_pos, ws_target))\n          cur_pos = ws_target\n          actions.append(USE)   # craft the stick\n\n  return actions", "env_interactions": 4, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:30:03.452624", "function_name": "make_stick", "function_body": "  from collections import deque\n\n  # ------------------------------------------------------------------\n  # Action identifiers (order may vary across environments)\n  # ------------------------------------------------------------------\n  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      # default ordering used by CraftWorld: DOWN, UP, LEFT, RIGHT, USE\n      action_ids = [0, 1, 2, 3, 4]\n\n  # ------------------------------------------------------------------\n  # Index of the target item \"stick\" in the cookbook\n  # ------------------------------------------------------------------\n  try:\n      target_idx = env.world.cookbook.index.get(\"stick\")\n  except Exception:\n      try:\n          target_idx = env.world.cookbook.index[\"stick\"]\n      except Exception:\n          target_idx = None\n\n  if target_idx is None:\n      # No recipe / unknown item \u2013 nothing to do.\n      return []\n\n  # ------------------------------------------------------------------\n  # Starting state (use the current lab state if it exists)\n  # ------------------------------------------------------------------\n  start_state = getattr(env, \"_current_state\", None)\n  if start_state is None:\n      start_state = env.scenario.init()\n\n  # ------------------------------------------------------------------\n  # Helper to create a hashable representation of a state\n  # ------------------------------------------------------------------\n  def _state_key(st):\n      return (st.pos, st.dir, st.inventory.tobytes())\n\n  # ------------------------------------------------------------------\n  # Bread\u2011first search over deterministic transitions\n  # ------------------------------------------------------------------\n  frontier = deque()\n  frontier.append((start_state, []))\n  visited = {_state_key(start_state)}\n  max_plan_len = 1000  # safety bound\n\n  while frontier:\n      cur_state, cur_actions = frontier.popleft()\n\n      # Goal test: inventory already contains a stick\n      if cur_state.satisfies(\"\", target_idx):\n          return cur_actions\n\n      if len(cur_actions) >= max_plan_len:\n          continue\n\n      # Expand all possible actions\n      for a in action_ids:\n          _, nxt_state = cur_state.step(a)\n          key = _state_key(nxt_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((nxt_state, cur_actions + [a]))\n\n  # No plan found within the limits\n  return []", "env_interactions": 4, "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T21:30:04.570415", "function_name": "make_stick", "function_body": "  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      # Default ordering used by CraftWorld: DOWN, UP, LEFT, RIGHT, USE\n      action_ids = [0, 1, 2, 3, 4]\n\n  # Resolve the index of the target item \"stick\".\n  goal_idx = None\n  try:\n      goal_idx = env.world.cookbook.index.get(\"stick\")\n  except Exception:\n      try:\n          goal_idx = env.world.cookbook.index[\"stick\"]\n      except Exception:\n          goal_idx = None\n\n  if goal_idx is None:\n      # No known recipe for a stick \u2013 nothing to do.\n      return []\n\n  # Helper to test whether a state already satisfies the goal.\n  def is_goal(state):\n      return state.satisfies(\"\", goal_idx)\n\n  # Determine the starting state.\n  start_state = getattr(env, \"_current_state\", None)\n  if start_state is None:\n      # Fallback to creating a fresh state from the scenario.\n      start_state = env.scenario.init()\n\n  # Bread\u2011first search over deterministic transitions.\n  from collections import deque\n  frontier = deque()\n  frontier.append((start_state, []))\n  visited = set()\n\n  def state_key(st):\n      \"\"\"Compact representation for the visited\u2011set.\"\"\"\n      return (st.pos, st.dir, st.inventory.tobytes())\n\n  visited.add(state_key(start_state))\n  max_steps = 500  # safety bound on plan length\n\n  while frontier:\n      cur_state, cur_actions = frontier.popleft()\n      if is_goal(cur_state):\n          return cur_actions\n      if len(cur_actions) >= max_steps:\n          continue\n      for a in action_ids:\n          _, next_state = cur_state.step(a)\n          key = state_key(next_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((next_state, cur_actions + [a]))\n\n  # No plan found within the limits.\n  return []", "env_interactions": 4, "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T21:30:29.602574", "function_name": "make_stick", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ------------------------------------------------------------------\n  # Helpers\n  # ------------------------------------------------------------------\n  ACTION = env.action_specs()                     # mapping name \u2192 int\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  width, height = state.grid.shape[0], state.grid.shape[1]\n\n  def in_bounds(x, y):\n      return 0 <= x < width and 0 <= y < height\n\n  def nearest_cell(start, kind):\n      \"\"\"Return coordinates (x, y) of the closest cell that contains `kind`.\"\"\"\n      layer = state.grid[:, :, kind]\n      ys, xs = np.where(layer > 0)\n      if len(xs) == 0:\n          return None\n      dists = np.abs(xs - start[0]) + np.abs(ys - start[1])\n      i = int(np.argmin(dists))\n      return int(xs[i]), int(ys[i])\n\n  def bfs_path(start, goal, target_kind=None):\n      \"\"\"\n      Return the shortest sequence of action ints that moves the agent from\n      `start` to `goal`. Cells that are occupied are avoided, except that the\n      goal cell may be occupied by `target_kind` (so we can step onto it).\n      \"\"\"\n      moves = [\n          (1, 0, ACTION[\"RIGHT\"]),\n          (-1, 0, ACTION[\"LEFT\"]),\n          (0, 1, ACTION[\"DOWN\"]),\n          (0, -1, ACTION[\"UP\"]),\n      ]\n      queue = deque()\n      queue.append((start, []))\n      visited = {start}\n      while queue:\n          (x, y), path = queue.popleft()\n          if (x, y) == goal:\n              return path\n          for dx, dy, act in moves:\n              nx, ny = x + dx, y + dy\n              if not in_bounds(nx, ny):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              # a cell is free if it has no entities, or if it is the goal\n              # and contains the target kind we are allowed to step on.\n              occupied = state.grid[nx, ny, :].sum()\n              if occupied == 0 or (\n                  target_kind is not None\n                  and nx == goal[0]\n                  and ny == goal[1]\n                  and state.grid[nx, ny, target_kind] > 0\n              ):\n                  visited.add((nx, ny))\n                  queue.append(((nx, ny), path + [act]))\n      # No path found \u2013 return empty list (should not happen in valid maps)\n      return []\n\n  # ------------------------------------------------------------------\n  # Planning\n  # ------------------------------------------------------------------\n  plan = []\n  cur_pos = state.pos\n\n  # 1. Determine which primitives are needed to craft a stick.\n  stick_idx = idx[\"stick\"]\n  needed = world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n\n  # 2. Collect each required primitive.\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          target = nearest_cell(cur_pos, prim_idx)\n          if target is None:\n              # Primitive not present \u2013 cannot finish the task.\n              continue\n          plan.extend(bfs_path(cur_pos, target, target_kind=prim_idx))\n          plan.append(ACTION[\"USE\"])          # pick up the primitive\n          cur_pos = target\n\n  # 3. Move to the workshop (if the recipe specifies one) and craft.\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop = recipe.get(\"_at\")\n  if workshop is not None:\n      wk_idx = idx[workshop] if isinstance(workshop, str) else workshop\n      wk_pos = nearest_cell(cur_pos, wk_idx)\n      if wk_pos is not None:\n          plan.extend(bfs_path(cur_pos, wk_pos, target_kind=wk_idx))\n          cur_pos = wk_pos\n\n  # 4. Final USE performs the crafting action.\n  plan.append(ACTION[\"USE\"])\n\n  return plan", "env_interactions": 4, "island_id": 4, "scores": {"3": 0.0}}
