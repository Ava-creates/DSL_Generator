{"timestamp": "2025-10-21T16:34:15.218469", "function_name": "make_stick", "function_body": "  # Helper: map action names to movement deltas\n  action_to_delta = {\n      \"UP\":    (-1, 0),\n      \"DOWN\":  ( 1, 0),\n      \"LEFT\":  ( 0,-1),\n      \"RIGHT\": ( 0, 1),\n  }\n  # Reverse map from delta to action name (for quick lookup)\n  delta_to_action = {v: k for k, v in action_to_delta.items()}\n\n  # Get the integer index for the target item (\"stick\")\n  stick_idx = env.world.cookbook.index[\"stick\"]\n\n  # Retrieve the recipe for a stick (primitives needed and workshop)\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  # primitives needed (ignore the special \"_at\" key)\n  primitive_reqs = {k: v for k, v in recipe.items() if k != \"_at\"}\n  # workshop kind (if any)\n  workshop_name = recipe.get(\"_at\", None)\n  workshop_idx = None\n  if workshop_name is not None:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n\n  # Shortcut to obtain the current CraftState object\n  def cur_state():\n      return env._current_state\n\n  # Returns a set of positions (r,c) that are occupied (any non\u2011zero channel)\n  def occupied_positions(grid):\n      occ = np.any(grid, axis=2)\n      return set(zip(*np.where(occ)))\n\n  # Simple BFS returning a list of positions from start (excluded) to a goal cell\n  def bfs_path(start, goal_set, blocked):\n      W, H = start_grid.shape[:2]\n      q = collections.deque()\n      q.append(start)\n      visited = {start}\n      parent = {}\n      while q:\n          cur = q.popleft()\n          if cur in goal_set:\n              # reconstruct path\n              path = []\n              while cur != start:\n                  path.append(cur)\n                  cur = parent[cur]\n              path.reverse()\n              return path\n          r, c = cur\n          for dr, dc in action_to_delta.values():\n              nr, nc = r + dr, c + dc\n              if 0 <= nr < W and 0 <= nc < H and (nr, nc) not in blocked and (nr, nc) not in visited:\n                  visited.add((nr, nc))\n                  parent[(nr, nc)] = cur\n                  q.append((nr, nc))\n      return None  # no path\n\n  # Convert a movement from cur->next into an action index\n  def move_action(cur, nxt):\n      dr = nxt[0] - cur[0]\n      dc = nxt[1] - cur[1]\n      act_name = delta_to_action[(dr, dc)]\n      return env.action_specs()[act_name]\n\n  # Main action list we will return\n  actions = []\n\n  # Helper to move the agent to a cell adjacent to a target cell (any side)\n  def go_adjacent_to(target_pos):\n      state = cur_state()\n      start = state.pos\n      grid = state.grid\n      occ = occupied_positions(grid)\n      # cells that are free to stand on\n      blocked = occ.copy()\n      # also block the target cell itself (cannot step on it)\n      blocked.add(target_pos)\n\n      # compute all admissible adjacent cells\n      adj_cells = []\n      tr, tc = target_pos\n      for dr, dc in action_to_delta.values():\n          ar, ac = tr + dr, tc + dc\n          if 0 <= ar < grid.shape[0] and 0 <= ac < grid.shape[1]:\n              if (ar, ac) not in blocked:\n                  adj_cells.append((ar, ac))\n\n      # pick the closest reachable adjacent cell\n      path = bfs_path(start, set(adj_cells), blocked)\n      if path is None:\n          raise RuntimeError(\"No path to adjacent cell\")\n      # follow the path, appending actions\n      cur = start\n      for nxt in path:\n          actions.append(move_action(cur, nxt))\n          cur = nxt\n      # after movement the environment state is updated by the caller\n      return cur  # position after reaching the adjacent cell\n\n  # Helper to collect a primitive of given kind (index) a required number of times\n  def collect_primitive(kind_idx, needed):\n      while needed > 0:\n          state = cur_state()\n          grid = state.grid\n          # locate all cells containing the primitive\n          positions = list(zip(*np.where(grid[:, :, kind_idx] > 0)))\n          if not positions:\n              raise RuntimeError(\"Required primitive not found in the world\")\n          # choose the nearest one (Manhattan)\n          cur_r, cur_c = state.pos\n          positions.sort(key=lambda p: abs(p[0] - cur_r) + abs(p[1] - cur_c))\n          target = positions[0]\n\n          # move adjacent to it\n          go_adjacent_to(target)\n\n          # perform USE action to pick it up\n          actions.append(env.action_specs()[\"USE\"])\n          # step the environment so state updates\n          env.step(env.action_specs()[\"USE\"])\n\n          needed -= 1\n\n  # Helper to move to a workshop and craft the item (USE)\n  def go_to_workshop_and_craft():\n      # locate any workshop of the required type\n      state = cur_state()\n      grid = state.grid\n      ws_positions = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))\n      if not ws_positions:\n          raise RuntimeError(\"Workshop not found\")\n      ws_positions.sort(key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))\n      target_ws = ws_positions[0]\n      go_adjacent_to(target_ws)\n      # Craft with USE\n      actions.append(env.action_specs()[\"USE\"])\n      env.step(env.action_specs()[\"USE\"])\n\n  # Main loop: collect required primitives, then craft\n  # First ensure we have enough of each primitive\n  for prim_idx, count in primitive_reqs.items():\n      # current inventory may already contain some\n      cur_inv = cur_state().inventory[prim_idx]\n      needed = max(0, count - int(cur_inv))\n      if needed > 0:\n          collect_primitive(prim_idx, needed)\n\n  # Finally move to workshop (if any) and craft the stick\n  if workshop_idx is not None:\n      go_to_workshop_and_craft()\n  else:\n      # If no specific workshop, just USE at current location\n      actions.append(env.action_specs()[\"USE\"])\n      env.step(env.action_specs()[\"USE\"])\n\n  return actions", "env_interactions": 0, "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-10-21T16:34:16.497597", "function_name": "make_stick", "function_body": "  import numpy as np\n\n  # Reset the environment to start a fresh episode\n  env.reset()\n\n  # Identify the index corresponding to the \"stick\" item\n  stick_idx = env.world.cookbook.index.index('stick')\n\n  # Action space (integers) \u2013 use the mapping provided by the environment\n  possible_actions = list(env.action_specs().values())\n\n  actions_taken = []\n  max_steps = 2000  # safety bound to avoid infinite loops\n\n  for _ in range(max_steps):\n      # Stop as soon as the inventory contains a stick\n      if env._current_state.satisfies('stick', stick_idx):\n          break\n\n      # Choose a random action from the available set\n      act = np.random.choice(possible_actions)\n      actions_taken.append(act)\n\n      # Execute the action; we ignore reward and done flag here\n      _, _, _ = env.step(act)\n\n      # If the environment reports termination, exit early\n      if env._is_done():\n          break\n\n  return actions_taken", "env_interactions": 0, "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-10-21T16:34:46.873013", "function_name": "make_stick", "function_body": "  # Helper: map direction vectors to action indices\n  DIR2ACT = {(0, 1): 0,   # DOWN  (y+1)\n             (0, -1): 1,  # UP    (y-1)\n             (-1, 0): 2,  # LEFT  (x-1)\n             (1, 0): 3}   # RIGHT (x+1)\n\n  # ------------------------------------------------------------------\n  # Access current state and world information\n  # ------------------------------------------------------------------\n  # CraftLab keeps the current CraftState in a protected attribute.\n  # If the attribute is not present we fall back to creating a fresh state.\n  try:\n      state = env._current_state          # type: CraftState\n  except AttributeError:\n      # env.reset() returns an observation dict; after reset the state is stored.\n      obs = env.reset()\n      state = env._current_state\n\n  world = env.world                       # CraftWorld instance\n  grid = state.grid                        # (W, H, n_kinds) uint8 array\n  pos = tuple(state.pos)                   # (x, y)\n\n  # ------------------------------------------------------------------\n  # Identify indices for the goal item (stick) and its recipe\n  # ------------------------------------------------------------------\n  stick_idx = world.cookbook.index[\"stick\"]\n  # primitive requirements for one stick\n  primitive_req = world.cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n  # full recipe to know the required workshop\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n\n  # find workshop index (key \"_at\" in the raw yaml, preserved as a string)\n  workshop_idx = None\n  for k, v in recipe.items():\n      if isinstance(k, str) and k == \"_at\":\n          workshop_name = v\n          workshop_idx = world.cookbook.index[workshop_name]\n          break\n\n  # ------------------------------------------------------------------\n  # Utility functions\n  # ------------------------------------------------------------------\n  def find_positions(kind_idx):\n      \"\"\"Return a list of (x, y) positions where the given kind is present.\"\"\"\n      ys, xs = np.where(grid[:, :, kind_idx] > 0)\n      return list(zip(xs.tolist(), ys.tolist()))\n\n  def manhattan(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def move_towards(src, dst):\n      \"\"\"\n      Generate a list of movement actions that walk from src to dst\n      using simple Manhattan moves (horizontal then vertical).\n      \"\"\"\n      actions = []\n      x, y = src\n      tx, ty = dst\n      # horizontal moves\n      while x != tx:\n          step = 1 if tx > x else -1\n          act = DIR2ACT[(step, 0)]\n          actions.append(act)\n          x += step\n      # vertical moves\n      while y != ty:\n          step = 1 if ty > y else -1\n          act = DIR2ACT[(0, step)]\n          actions.append(act)\n          y += step\n      return actions\n\n  def approach_and_use(target_pos):\n      \"\"\"\n      Move close enough to `target_pos` (adjacent or same cell) and then\n      issue a USE action while facing the target.  The function assumes\n      that a movement in the direction of the target will set the agent's\n      facing direction appropriately.\n      \"\"\"\n      actions = []\n\n      # If we are already on the target cell, just set direction by a dummy move\n      if pos[0] == target_pos[0] and pos[1] == target_pos[1]:\n          # move in any direction and step back to keep position but set direction\n          actions.append(DIR2ACT[(0, 1)])   # DOWN\n          actions.append(DIR2ACT[(0, -1)])  # UP (back)\n      else:\n          # Compute a cell adjacent to the target (Manhattan distance == 1)\n          # Prefer the cell that is reachable via simple moves.\n          adj = None\n          for dx, dy in [(0, 1), (0, -1), (1, 0), (-1, 0)]:\n              cand = (target_pos[0] + dx, target_pos[1] + dy)\n              if 0 <= cand[0] < grid.shape[0] and 0 <= cand[1] < grid.shape[1]:\n                  # check that the cell is empty (no entities)\n                  if not grid[cand[0], cand[1]].any():\n                      adj = cand\n                      break\n          if adj is None:\n              # fallback: just head straight to the target (may be blocked)\n              adj = target_pos\n\n          # Move from current position to the adjacent cell\n          actions.extend(move_towards(pos, adj))\n\n          # After reaching adj, set direction towards the target\n          dir_vec = (target_pos[0] - adj[0], target_pos[1] - adj[1])\n          if dir_vec != (0, 0):\n              # a single step in that direction (may be blocked)\n              actions.append(DIR2ACT[dir_vec])\n\n      # Finally issue USE to collect / craft\n      actions.append(4)   # USE\n      return actions\n\n  # ------------------------------------------------------------------\n  # Build the action sequence\n  # ------------------------------------------------------------------\n  plan = []\n\n  # 1) Collect required primitives (handle multiplicities)\n  for prim_idx, count in primitive_req.items():\n      prim_positions = find_positions(prim_idx)\n      if not prim_positions:\n          raise ValueError(f\"Primitive required for stick not found in grid: {prim_idx}\")\n\n      for _ in range(count):\n          # choose the closest primitive currently available\n          distances = [manhattan(pos, p) for p in prim_positions]\n          nearest = prim_positions[int(np.argmin(distances))]\n          plan.extend(approach_and_use(nearest))\n          # after using, remove that primitive from list (it is collected)\n          prim_positions.remove(nearest)\n\n  # 2) Move to the workshop and craft the stick\n  if workshop_idx is not None:\n      workshop_positions = find_positions(workshop_idx)\n      if not workshop_positions:\n          raise ValueError(\"Workshop for stick not found in grid.\")\n      # pick the nearest workshop\n      distances = [manhattan(pos, w) for w in workshop_positions]\n      nearest_ws = workshop_positions[int(np.argmin(distances))]\n      plan.extend(approach_and_use(nearest_ws))\n\n  # Return the compiled list of action indices\n  return plan", "env_interactions": 9, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T16:34:47.988458", "function_name": "make_stick", "function_body": "  # Simple random-walk planner: keep taking random actions until a stick is obtained\n  # or a safety limit is reached. This works for any environment that follows the\n  # CraftLab interface described in the prompt.\n\n  # Reset the environment to start a fresh episode and obtain the initial observation.\n  env.reset()\n  actions = []\n\n  # Determine the integer index that corresponds to the \"stick\" item.\n  # The cookbook index maps item names to unique integer IDs.\n  stick_name = \"stick\"\n  if not hasattr(env.world.cookbook, \"index\"):\n      raise AttributeError(\"Environment world does not expose a cookbook with an index.\")\n  stick_idx = env.world.cookbook.index.index(stick_name)\n\n  # Grab the list of possible action integers from the environment's action spec.\n  # The spec is a dict mapping action names (e.g., \"DOWN\") to integer codes.\n  action_codes = list(env.action_specs().values())\n\n  # Safety cap to avoid infinite loops in pathological maps.\n  MAX_STEPS = 2000\n\n  for _ in range(MAX_STEPS):\n      # Access the underlying CraftState (private attribute) to query goal satisfaction.\n      state = getattr(env, \"_current_state\", None)\n      if state is not None:\n          if state.satisfies(stick_name, stick_idx):\n              break\n\n      # Choose a random action from the allowed set.\n      act = int(np.random.choice(action_codes))\n      actions.append(act)\n\n      # Step the environment.  The step method returns (reward, done, observation).\n      # We ignore reward and observation here; we only need to continue the loop.\n      _, done, _ = env.step(act)\n\n      if done:\n          # Episode terminated before obtaining a stick \u2013 exit early.\n          break\n\n  return actions", "env_interactions": 0, "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-10-21T16:35:38.902870", "function_name": "make_stick", "function_body": "  import numpy as np\n  from collections import deque\n\n  # direction indices as used by CraftLab\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # DOWN, UP, LEFT, RIGHT\n  OPP = [1, 0, 3, 2]                         # opposite directions\n\n  # ------------------------------------------------------------------\n  # helper: check whether a cell is free (no entity occupies it)\n  # ------------------------------------------------------------------\n  def _free(x, y, grid):\n      if x < 0 or y < 0 or x >= grid.shape[0] or y >= grid.shape[1]:\n          return False\n      return not grid[x, y].any()\n\n  # ------------------------------------------------------------------\n  # helper: BFS that returns a list of direction indices to move from\n  # start (sx, sy) to goal (gx, gy).  Returns [] if unreachable.\n  # ------------------------------------------------------------------\n  def _bfs(sx, sy, gx, gy, grid):\n      if (sx, sy) == (gx, gy):\n          return []\n      q = deque()\n      q.append((sx, sy))\n      visited = np.full(grid.shape[:2], False, dtype=bool)\n      visited[sx, sy] = True\n      prev = dict()          # (x, y) -> (prev_x, prev_y, action)\n\n      while q:\n          x, y = q.popleft()\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n                  if not visited[nx, ny] and _free(nx, ny, grid):\n                      visited[nx, ny] = True\n                      prev[(nx, ny)] = (x, y, a)\n                      if (nx, ny) == (gx, gy):\n                          # reconstruct path\n                          path = []\n                          cx, cy = gx, gy\n                          while (cx, cy) != (sx, sy):\n                              px, py, act = prev[(cx, cy)]\n                              path.append(act)\n                              cx, cy = px, py\n                          return list(reversed(path))\n                      q.append((nx, ny))\n      return []   # unreachable\n\n  # ------------------------------------------------------------------\n  # obtain scenario / world information\n  # ------------------------------------------------------------------\n  # reset (or just use the existing scenario) to get a fresh observation\n  _ = env.reset()\n  scenario = env.scenario if hasattr(env, \"scenario\") else env._current_state.scenario\n  grid = scenario.init_grid.copy()          # mutable copy\n  pos = list(scenario.init_pos)             # [x, y]\n\n  world = scenario.world\n  cookbook = world.cookbook\n\n  # ------------------------------------------------------------------\n  # identify goal (stick) and its recipe\n  # ------------------------------------------------------------------\n  goal_name = \"stick\"\n  goal_idx = cookbook.index[goal_name]          # Index __getitem__\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_idx = recipe.get(\"_at\")               # workshop where stick is crafted\n  # primitives needed (exclude the \"_at\" entry)\n  needed = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # function to move to a neighbour of a target cell, face it and USE\n  # ------------------------------------------------------------------\n  def _go_collect(target_kind, amount):\n      nonlocal pos, actions, grid\n      # locate all cells containing the required primitive\n      locations = np.argwhere(grid[:, :, target_kind] > 0)\n      loc_ptr = 0\n\n      for _ in range(amount):\n          # find the next still\u2011available location\n          while loc_ptr < len(locations):\n              tx, ty = locations[loc_ptr]\n              if grid[tx, ty, target_kind] == 0:\n                  loc_ptr += 1\n                  continue\n              # choose a free neighbour of (tx, ty)\n              neighbour = None\n              for d, (dx, dy) in enumerate(DIRS):\n                  nx, ny = tx + dx, ty + dy\n                  if _free(nx, ny, grid):\n                      neighbour = (nx, ny, d)   # d = direction from neighbour -> target\n                      break\n              if neighbour is None:\n                  loc_ptr += 1\n                  continue\n\n              # plan path to the neighbour cell\n              path = _bfs(pos[0], pos[1], neighbour[0], neighbour[1], grid)\n              for a in path:\n                  actions.append(a)\n                  pos[0] += DIRS[a][0]\n                  pos[1] += DIRS[a][1]\n\n              # ensure we are facing the target cell\n              dir_to_target = neighbour[2]\n              opp_dir = OPP[dir_to_target]\n              ox, oy = pos[0] + DIRS[opp_dir][0], pos[1] + DIRS[opp_dir][1]\n              if _free(ox, oy, grid):\n                  actions.append(opp_dir)\n                  pos[0], pos[1] = ox, oy\n                  actions.append(dir_to_target)\n                  pos[0] += DIRS[dir_to_target][0]\n                  pos[1] += DIRS[dir_to_target][1]\n              else:\n                  # fallback: just issue the USE; the environment treats the current\n                  # facing direction as whatever it was after the last move.\n                  pass\n\n              # collect the primitive\n              actions.append(4)                     # USE\n              grid[tx, ty, target_kind] = 0        # remove from grid\n              break\n          else:\n              # no more locations \u2013 stop early\n              break\n\n  # ------------------------------------------------------------------\n  # collect every required primitive\n  # ------------------------------------------------------------------\n  for kind, cnt in needed.items():\n      _go_collect(kind, cnt)\n\n  # ------------------------------------------------------------------\n  # move to workshop and craft the stick\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_cells.size:\n          wx, wy = ws_cells[0]\n          # pick a free neighbour\n          ws_nei = None\n          for d, (dx, dy) in enumerate(DIRS):\n              nx, ny = wx + dx, wy + dy\n              if _free(nx, ny, grid):\n                  ws_nei = (nx, ny, d)   # d = direction from neighbour -> workshop\n                  break\n          if ws_nei is not None:\n              path = _bfs(pos[0], pos[1], ws_nei[0], ws_nei[1], grid)\n              for a in path:\n                  actions.append(a)\n                  pos[0] += DIRS[a][0]\n                  pos[1] += DIRS[a][1]\n\n              # face the workshop\n              dir_to_ws = ws_nei[2]\n              opp_dir = OPP[dir_to_ws]\n              ox, oy = pos[0] + DIRS[opp_dir][0], pos[1] + DIRS[opp_dir][1]\n              if _free(ox, oy, grid):\n                  actions.append(opp_dir)\n                  pos[0], pos[1] = ox, oy\n                  actions.append(dir_to_ws)\n                  pos[0] += DIRS[dir_to_ws][0]\n                  pos[1] += DIRS[dir_to_ws][1]\n\n              # craft\n              actions.append(4)   # USE\n\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-10-21T16:35:40.010875", "function_name": "make_stick", "function_body": "  # Try to obtain the current state from the environment.\n  # The function works with a ``CraftLab`` instance (which stores the\n  # current ``CraftState`` in the private attribute ``_current_state``)\n  # or directly with a ``CraftState`` object.\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      # ``env`` might itself be a ``CraftState``.\n      if hasattr(env, \"grid\"):\n          state = env\n      else:\n          # Nothing we can work with \u2013 return an empty plan.\n          return []\n\n  world = state.world\n  cookbook = world.cookbook\n\n  # Index of the target item (``stick``).  If the name is not present we\n  # simply return an empty plan.\n  stick_idx = cookbook.index.get(\"stick\")\n  if stick_idx is None:\n      return []\n\n  # Primitive requirements for one ``stick``.\n  primitive_needs = cookbook.primitives_for(stick_idx)\n\n  # ------------------------------------------------------------------\n  # Helper to translate a Manhattan displacement into a list of actions.\n  # Action encoding follows the convention used by ``CraftLab``:\n  #   0 \u2013 DOWN, 1 \u2013 UP, 2 \u2013 LEFT, 3 \u2013 RIGHT, 4 \u2013 USE\n  # ------------------------------------------------------------------\n  def _move(dx: int, dy: int) -> list[int]:\n      act = []\n      # X\u2011axis moves (horizontal)\n      if dx > 0:\n          act.extend([3] * dx)   # RIGHT\n      elif dx < 0:\n          act.extend([2] * (-dx))  # LEFT\n      # Y\u2011axis moves (vertical)\n      if dy > 0:\n          act.extend([0] * dy)   # DOWN\n      elif dy < 0:\n          act.extend([1] * (-dy))  # UP\n      return act\n\n  # ------------------------------------------------------------------\n  # Locate all cells that contain a given kind.\n  # ------------------------------------------------------------------\n  grid = state.grid\n  def _cells_of(kind: int):\n      return [tuple(p) for p in np.argwhere(grid[:, :, kind] > 0)]\n\n  # ------------------------------------------------------------------\n  # Build the plan.\n  # ------------------------------------------------------------------\n  plan: list[int] = []\n  cur_pos = list(state.pos)   # mutable copy\n\n  # Collect each required primitive.\n  for kind, needed in primitive_needs.items():\n      if needed <= 0:\n          continue\n      locations = _cells_of(kind)\n      # Sort by Manhattan distance from the current position.\n      locations.sort(key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))\n\n      collected = 0\n      for loc in locations:\n          if collected >= needed:\n              break\n          # Move to the cell.\n          dx = loc[0] - cur_pos[0]\n          dy = loc[1] - cur_pos[1]\n          plan.extend(_move(dx, dy))\n          cur_pos[0], cur_pos[1] = loc\n\n          # Pick the item up.  ``USE`` works on the cell the agent is\n          # standing on (the environment treats the current cell as the\n          # interaction target when the agent faces any direction).\n          plan.append(4)   # USE\n          collected += 1\n\n  # ------------------------------------------------------------------\n  # Finally, go to the appropriate workshop and craft the stick.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(stick_idx, {})\n  workshop_kind = None\n  for k, v in recipe.items():\n      if k == \"_at\":\n          workshop_kind = v\n          break\n\n  if workshop_kind is not None:\n      ws_cells = _cells_of(workshop_kind)\n      if ws_cells:\n          ws = ws_cells[0]                      # pick the first workshop\n          dx = ws[0] - cur_pos[0]\n          dy = ws[1] - cur_pos[1]\n          plan.extend(_move(dx, dy))\n          cur_pos[0], cur_pos[1] = ws\n          plan.append(4)                         # USE \u2192 craft\n\n  return plan", "env_interactions": 0, "island_id": 1, "scores": {"3": -1}}
