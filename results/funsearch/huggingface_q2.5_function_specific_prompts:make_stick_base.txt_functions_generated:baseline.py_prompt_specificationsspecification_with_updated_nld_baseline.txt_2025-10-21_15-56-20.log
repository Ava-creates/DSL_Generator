{"timestamp": "2025-10-21T16:41:00.421199", "function_name": "make_stick", "function_body": "  # Get reference to the underlying world and index mapping\n  world = env.world\n  idx = world.cookbook.index\n\n  # Index of the target item (\"stick\")\n  stick_idx = idx.get(\"stick\")\n  if stick_idx is None:\n      return []\n\n  # Retrieve the recipe for a stick (may be empty if primitive)\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n\n  # Primitives required for the stick (ignore the workshop key)\n  required = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  # Helper: find the nearest cell containing a given kind (primitive or workshop)\n  def find_nearest(grid, pos, kind):\n      locations = np.argwhere(grid[:, :, kind] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.sum(np.abs(locations - np.array(pos)), axis=1)\n      return locations[dists.argmin()]\n\n  # Helper: translate a delta (dx, dy) into a list of movement actions\n  # Action mapping (as used by CraftWorld):\n  #   0 = DOWN  (+x), 1 = UP    (-x), 2 = LEFT (-y), 3 = RIGHT (+y), 4 = USE\n  def moves_for_delta(dx, dy):\n      actions = []\n      while dx > 0:\n          actions.append(0)   # DOWN\n          dx -= 1\n      while dx < 0:\n          actions.append(1)   # UP\n          dx += 1\n      while dy > 0:\n          actions.append(3)   # RIGHT\n          dy -= 1\n      while dy < 0:\n          actions.append(2)   # LEFT\n          dy += 1\n      return actions\n\n  # Helper: plan a path from current position to a target cell (Manhattan only)\n  def plan_path(start, target):\n      dx = target[0] - start[0]\n      dy = target[1] - start[1]\n      return moves_for_delta(dx, dy)\n\n  # Start from the current state of the environment\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      # Fallback for environments that expose the state differently\n      try:\n          state = env.current_state\n      except Exception:\n          return []\n\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # 1. Collect each required primitive the needed number of times\n  # ----------------------------------------------------------------------\n  for prim_kind, count in required.items():\n      for _ in range(count):\n          # locate the nearest instance of this primitive\n          pos = tuple(state.pos)\n          target = find_nearest(state.grid, pos, prim_kind)\n          if target is None:\n              # primitive not present \u2013 cannot continue\n              return actions\n          # move to the primitive\n          actions.extend(plan_path(pos, target))\n          # use the cell to pick it up\n          actions.append(4)   # USE\n          # simulate the move locally so that subsequent searches start from the new location\n          # (this mirrors what will happen when the actions are actually executed)\n          pos = tuple(target)\n          # after USE the agent stays on the same cell; we keep pos unchanged for next iteration\n          # update the temporary state reference for path planning\n          # (we do not modify the actual grid here \u2013 the real environment will handle it)\n\n  # ----------------------------------------------------------------------\n  # 2. Move to the appropriate workshop and craft the stick\n  # ----------------------------------------------------------------------\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = idx.get(workshop_name)\n      if workshop_idx is not None:\n          pos = tuple(state.pos) if not actions else target  # approximate last known position\n          target_ws = find_nearest(state.grid, pos, workshop_idx)\n          if target_ws is not None:\n              actions.extend(plan_path(pos, target_ws))\n              actions.append(4)   # USE to craft at the workshop\n\n  return actions", "env_interactions": 0, "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-10-21T16:41:27.259316", "function_name": "make_stick", "function_body": "  # Helper: map action names to indices\n  act_map = env.action_specs()\n\n  # Ensure environment is reset\n  env.reset()\n  state = env._current_state\n\n  # Goal index for the current task\n  goal_idx = env.task.goal\n\n  # Primitive requirements for the goal\n  prim_req = env.world.cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Function to move the agent to a target (tx, ty) using simple Manhattan\n  # steps.  It updates the environment and the local `state` reference.\n  # ------------------------------------------------------------------\n  def move_to(target):\n      nonlocal state\n      tx, ty = target\n      while (state.pos[0], state.pos[1]) != (tx, ty):\n          cx, cy = state.pos\n          if cx < tx:\n              act = act_map[\"RIGHT\"]\n          elif cx > tx:\n              act = act_map[\"LEFT\"]\n          elif cy < ty:\n              act = act_map[\"DOWN\"]\n          else:  # cy > ty\n              act = act_map[\"UP\"]\n          actions.append(act)\n          _, _, _ = env.step(act)\n          state = env._current_state\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive\n  # ------------------------------------------------------------------\n  actions = []\n  for prim_idx, needed in prim_req.items():\n      while state.inventory[prim_idx] < needed:\n          # locate all cells containing the primitive\n          cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if cells.size == 0:\n              raise RuntimeError(\"Required primitive not present in the world.\")\n          # choose the closest cell (Manhattan distance)\n          cur = np.array(state.pos)\n          dists = np.abs(cells - cur).sum(axis=1)\n          target = tuple(cells[dists.argmin()])\n          # move to that cell\n          move_to(target)\n          # pick it up\n          actions.append(act_map[\"USE\"])\n          _, _, _ = env.step(act_map[\"USE\"])\n          state = env._current_state\n\n  # ------------------------------------------------------------------\n  # After gathering primitives, go to the appropriate workshop and craft\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  for key, val in recipe.items():\n      if isinstance(key, str) and key.startswith(\"_\"):\n          # key is something like \"_at\"\n          if isinstance(val, str):\n              workshop_idx = env.world.cookbook.index[val]\n          else:\n              workshop_idx = int(val)\n          break\n\n  if workshop_idx is not None:\n      # locate a workshop cell\n      cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if cells.size == 0:\n          raise RuntimeError(\"Workshop for crafting not found.\")\n      cur = np.array(state.pos)\n      dists = np.abs(cells - cur).sum(axis=1)\n      target = tuple(cells[dists.argmin()])\n      # move to workshop\n      move_to(target)\n      # craft the item\n      actions.append(act_map[\"USE\"])\n      env.step(act_map[\"USE\"])\n      state = env._current_state\n\n  # Return the complete action sequence\n  return actions", "env_interactions": 0, "island_id": 5, "scores": {"3": 0.0}}
