{"timestamp": "2025-10-21T18:33:29.457206", "function_name": "make_stick", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ------------------------------------------------------------------\n  # Action indices (environment provides mapping)\n  # ------------------------------------------------------------------\n  action_map = env.action_specs()\n  DOWN = action_map[\"DOWN\"]\n  UP = action_map[\"UP\"]\n  LEFT = action_map[\"LEFT\"]\n  RIGHT = action_map[\"RIGHT\"]\n  USE = action_map[\"USE\"]\n  ACTION_DELTAS = {\n      DOWN:  (0, 1),\n      UP:    (0, -1),\n      LEFT:  (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  # ------------------------------------------------------------------\n  # Access current state and world information\n  # ------------------------------------------------------------------\n  state = env._current_state            # CraftState\n  world = env.world                     # CraftWorld\n  grid = state.grid.copy()              # (W, H, n_kinds)\n  pos = tuple(state.pos)                # (x, y)\n  direction = int(state.dir)            # 0\u20113 (same as action indices)\n\n  # ------------------------------------------------------------------\n  # Identify goal (stick) and its recipe\n  # ------------------------------------------------------------------\n  try:\n      goal_idx = env.task.goal\n      if not isinstance(goal_idx, int):\n          goal_idx = world.cookbook.index[goal_idx]\n  except Exception:\n      goal_idx = world.cookbook.index[\"stick\"]\n\n  # recipe may contain \"_at\" entry specifying workshop kind\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n\n  # ------------------------------------------------------------------\n  # Determine primitive requirements for the goal\n  # ------------------------------------------------------------------\n  required_primitives = world.cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def find_all(kind):\n      \"\"\"Return list of (x, y) where grid[..., kind] > 0.\"\"\"\n      coords = np.argwhere(grid[:, :, kind] > 0)\n      return [(int(x), int(y)) for x, y in coords]\n\n  def bfs_to_adjacent(start, targets):\n      \"\"\"\n      BFS from start to any cell adjacent (Manhattan distance 1) to a target.\n      Returns (path_actions, target_cell) where path_actions is a list of\n      action indices moving the agent to the adjacent cell.\n      \"\"\"\n      W, H, _ = grid.shape\n      visited = np.full((W, H), False, dtype=bool)\n      q = deque()\n      q.append((start, []))\n      visited[start] = True\n\n      # occupied cells (cannot step onto)\n      occupied = (grid.sum(axis=2) > 0)\n\n      while q:\n          (x, y), path = q.popleft()\n          # Check adjacency to any target\n          for tx, ty in targets:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path, (tx, ty)\n\n          for act, (dx, dy) in ACTION_DELTAS.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if not occupied[nx, ny]:\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [act]))\n      return None, None  # no path found\n\n  def turn_to(target_dir):\n      \"\"\"Return a list (possibly empty) containing a single action to face target_dir.\"\"\"\n      return [] if direction == target_dir else [target_dir]\n\n  # ------------------------------------------------------------------\n  # Planning: collect required primitives\n  # ------------------------------------------------------------------\n  plan_actions = []\n\n  for prim_kind, needed_cnt in required_primitives.items():\n      collected = 0\n      while collected < needed_cnt:\n          locations = find_all(prim_kind)\n          if not locations:\n              break  # cannot find more of this primitive\n\n          # Choose nearest primitive (Manhattan distance)\n          locations.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          target = locations[0]\n\n          # Move to a cell adjacent to the primitive\n          path, _ = bfs_to_adjacent(pos, [target])\n          if path is None:\n              break  # unreachable\n\n          # Execute movement actions, updating simulated pos & direction\n          for a in path:\n              plan_actions.append(a)\n              dx, dy = ACTION_DELTAS[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n              direction = a\n\n          # Determine which direction we need to face to use the primitive\n          tx, ty = target\n          if pos[0] == tx and pos[1] + 1 == ty:\n              face_dir = DOWN\n          elif pos[0] == tx and pos[1] - 1 == ty:\n              face_dir = UP\n          elif pos[0] + 1 == tx and pos[1] == ty:\n              face_dir = RIGHT\n          elif pos[0] - 1 == tx and pos[1] == ty:\n              face_dir = LEFT\n          else:\n              face_dir = direction  # fallback (should not happen)\n\n          # Turn if needed\n          if face_dir != direction:\n              plan_actions.append(face_dir)\n              direction = face_dir\n\n          # Use to pick up primitive\n          plan_actions.append(USE)\n\n          # Simulate pickup: remove primitive from grid\n          grid[tx, ty, prim_kind] = 0\n\n          collected += 1\n          # Position stays the same after USE\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if required) and craft the stick\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      workshop_cells = find_all(workshop_kind)\n      if workshop_cells:\n          workshop_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          wk_target = workshop_cells[0]\n\n          path, _ = bfs_to_adjacent(pos, [wk_target])\n          if path is not None:\n              for a in path:\n                  plan_actions.append(a)\n                  dx, dy = ACTION_DELTAS[a]\n                  pos = (pos[0] + dx, pos[1] + dy)\n                  direction = a\n\n              # Face the workshop cell\n              wx, wy = wk_target\n              if pos[0] == wx and pos[1] + 1 == wy:\n                  face_dir = DOWN\n              elif pos[0] == wx and pos[1] - 1 == wy:\n                  face_dir = UP\n              elif pos[0] + 1 == wx and pos[1] == wy:\n                  face_dir = RIGHT\n              elif pos[0] - 1 == wx and pos[1] == wy:\n                  face_dir = LEFT\n              else:\n                  face_dir = direction\n\n              if face_dir != direction:\n                  plan_actions.append(face_dir)\n                  direction = face_dir\n\n              # Craft using the workshop\n              plan_actions.append(USE)\n\n  else:\n      # No specific workshop \u2013 a final USE at current location crafts the item\n      plan_actions.append(USE)\n\n  return plan_actions", "env_interactions": 1, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:33:30.590823", "function_name": "make_stick", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ------------------------------------------------------------------\n  # Action constants (as defined in CraftLab)\n  # ------------------------------------------------------------------\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  ACTION_DELTAS = {\n      DOWN:  (0, 1),\n      UP:    (0, -1),\n      LEFT:  (-1, 0),\n      RIGHT: (1, 0),\n  }\n  OPPOSITE = {DOWN: UP, UP: DOWN, LEFT: RIGHT, RIGHT: LEFT}\n  # ------------------------------------------------------------------\n  # Access current state / world information\n  # ------------------------------------------------------------------\n  state = env._current_state          # CraftState\n  world = env.world                   # CraftWorld\n  grid = state.grid.copy()            # mutable copy for planning\n  pos = tuple(state.pos)              # (x, y)\n  direction = int(state.dir)          # current facing direction\n\n  # ------------------------------------------------------------------\n  # Identify the goal index (stick) \u2013 fall back to name if needed\n  # ------------------------------------------------------------------\n  try:\n      goal_idx = env.task.goal\n      if not isinstance(goal_idx, int):\n          goal_idx = world.cookbook.index[goal_idx]\n  except Exception:\n      goal_idx = world.cookbook.index.get(\"stick\")\n      if goal_idx is None:\n          raise ValueError(\"Stick item not found in cookbook.\")\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  W, H, K = grid.shape\n\n  def in_bounds(x, y):\n      return 0 <= x < W and 0 <= y < H\n\n  def occupied_mask():\n      \"\"\"Boolean array where True means blocked (any non\u2011zero kind).\"\"\"\n      return grid.sum(axis=2) > 0\n\n  def find_all(kind):\n      \"\"\"Return list of (x, y) where grid[..., kind] > 0.\"\"\"\n      coords = np.argwhere(grid[:, :, kind] > 0)\n      return [(int(x), int(y)) for x, y in coords]\n\n  def bfs(start, goal_cells, avoid_kind=None):\n      \"\"\"\n      BFS from start to any cell in goal_cells.\n      Returns (path_actions, reached_cell) where path_actions brings the agent\n      to the goal cell and reached_cell is the goal cell reached.\n      Cells occupied by any entity are avoided; if avoid_kind is given,\n      cells containing that kind are considered passable.\n      \"\"\"\n      occupied = occupied_mask()\n      if avoid_kind is not None:\n          occupied = occupied & (grid[:, :, avoid_kind] == 0)\n\n      visited = np.zeros((W, H), dtype=bool)\n      q = deque()\n      q.append((start, []))\n      visited[start] = True\n      goal_set = set(goal_cells)\n\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in goal_set:\n              return path, (x, y)\n          for act, (dx, dy) in ACTION_DELTAS.items():\n              nx, ny = x + dx, y + dy\n              if not in_bounds(nx, ny):\n                  continue\n              if visited[nx, ny]:\n                  continue\n              if occupied[nx, ny]:\n                  continue\n              visited[nx, ny] = True\n              q.append(((nx, ny), path + [act]))\n      return None, None\n\n  def move_to(target_pos):\n      \"\"\"\n      Move from current simulated position to target_pos using BFS.\n      Updates global pos and direction.\n      Returns list of actions required.\n      \"\"\"\n      nonlocal pos, direction\n      path, _ = bfs(pos, [target_pos])\n      if path is None:\n          return []  # unreachable\n      for a in path:\n          dx, dy = ACTION_DELTAS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n          direction = a\n      return path\n\n  def approach_and_use(target_xy, kind):\n      \"\"\"\n      Plan to stand adjacent to target_xy, face it, and USE to collect.\n      Updates global pos, direction, and grid.\n      Returns list of actions.\n      \"\"\"\n      nonlocal grid\n      tx, ty = target_xy\n      # Candidate neighbor cells that are empty and allow correct facing\n      candidates = []\n      for act, (dx, dy) in ACTION_DELTAS.items():\n          nx, ny = tx - dx, ty - dy   # cell we would stand on\n          if not in_bounds(nx, ny):\n              continue\n          if grid[nx, ny, :].sum() != 0:\n              continue\n          candidates.append((nx, ny, act))  # act is direction we need to face\n\n      # Choose reachable candidate with shortest path\n      best_path = None\n      best_dir = None\n      best_cell = None\n      for nx, ny, needed_dir in candidates:\n          path, _ = bfs(pos, [(nx, ny)])\n          if path is None:\n              continue\n          if best_path is None or len(path) < len(best_path):\n              best_path = path\n              best_dir = needed_dir\n              best_cell = (nx, ny)\n\n      if best_path is None:\n          return []  # cannot reach\n\n      actions = []\n      # move to chosen neighbor\n      for a in best_path:\n          dx, dy = ACTION_DELTAS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n          direction = a\n      actions.extend(best_path)\n\n      # Ensure we are facing the target; if not, perform a turn maneuver\n      if direction != best_dir:\n          # try simple turn: step back and forward if possible\n          back_dir = OPPOSITE[best_dir]\n          bdx, bdy = ACTION_DELTAS[back_dir]\n          back_pos = (pos[0] + bdx, pos[1] + bdy)\n          if in_bounds(*back_pos) and grid[back_pos[0], back_pos[1], :].sum() == 0:\n              actions.append(back_dir)\n              pos = back_pos\n              direction = back_dir\n              actions.append(best_dir)\n              pos = (pos[0] + ACTION_DELTAS[best_dir][0],\n                     pos[1] + ACTION_DELTAS[best_dir][1])\n              direction = best_dir\n          else:\n              # fallback: just add a fake turn by moving sideways then back\n              for side in (LEFT, RIGHT):\n                  sdx, sdy = ACTION_DELTAS[side]\n                  side_pos = (pos[0] + sdx, pos[1] + sdy)\n                  if in_bounds(*side_pos) and grid[side_pos[0], side_pos[1], :].sum() == 0:\n                      actions.append(side)\n                      pos = side_pos\n                      direction = side\n                      actions.append(OPPOSITE[side])\n                      pos = (pos[0] + ACTION_DELTAS[OPPOSITE[side]][0],\n                             pos[1] + ACTION_DELTAS[OPPOSITE[side]][1])\n                      direction = OPPOSITE[side]\n                      break\n              # after maneuver we hope direction is now correct; if not, we just proceed\n\n      # Use to collect\n      actions.append(USE)\n      # Update simulated grid (remove the primitive)\n      grid[tx, ty, kind] = 0\n      return actions\n\n  # ------------------------------------------------------------------\n  # Determine required primitives for the stick using cookbook helper\n  # ------------------------------------------------------------------\n  required = world.cookbook.primitives_for(goal_idx)   # dict {prim_idx: count}\n\n  plan = []\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive\n  # ------------------------------------------------------------------\n  for prim_kind, count in required.items():\n      for _ in range(count):\n          locations = find_all(prim_kind)\n          if not locations:\n              # primitive not present \u2013 abort planning\n              continue\n          # choose the nearest (Manhattan) location for simplicity\n          locations.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          target = locations[0]\n          plan.extend(approach_and_use(target, prim_kind))\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if recipe specifies one) and craft\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      workshop_cells = find_all(workshop_kind)\n      if workshop_cells:\n          # pick nearest workshop cell\n          workshop_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          wk_target = workshop_cells[0]\n\n          # similar logic: approach adjacent and face\n          plan.extend(approach_and_use(wk_target, workshop_kind))\n\n  # final USE to craft the stick (or to interact with workshop if not already used)\n  plan.append(USE)\n\n  return plan", "env_interactions": 1, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:34:11.064166", "function_name": "make_stick", "function_body": "  # Reset environment and obtain initial state\n  obs = env.reset()\n  state = env._current_state\n\n  # Action mapping (e.g., {\"UP\":0, \"DOWN\":1, ...})\n  act_map = env.action_specs()\n  # Inverse mapping for convenience\n  inv_act = {v: k for k, v in act_map.items()}\n\n  # Indices of entities we cannot walk through\n  blocked_kinds = env.world.non_grabbable_indices\n\n  # Index of the target item \"stick\"\n  stick_idx = env.world.cookbook.index[\"stick\"]\n\n  # Recipe information for stick (may contain \"_at\" specifying workshop)\n  stick_recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  workshop_idx = stick_recipe.get(\"_at\", None)\n\n  # Primitive requirements for one stick\n  needed_prims = env.world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n  # Track how many of each primitive we still need\n  need = dict(needed_prims)\n\n  # --------------------------------------------------------------------- #\n  # Helper functions\n  # --------------------------------------------------------------------- #\n  def walkable(pos):\n      \"\"\"True if the cell at `pos` contains no blocking entity.\"\"\"\n      x, y = pos\n      return not any(state.grid[x, y, k] > 0 for k in blocked_kinds)\n\n  def bfs(start, targets):\n      \"\"\"Bread\u2011first search from `start` to any cell in `targets`.\n      Returns a list of positions from start to the goal (inclusive) or None.\"\"\"\n      from collections import deque\n      q = deque([start])\n      prev = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur in targets:\n              # reconstruct path\n              path = []\n              while cur is not None:\n                  path.append(cur)\n                  cur = prev[cur]\n              path.reverse()\n              return path\n          for dx, dy in ((-1, 0), (1, 0), (0, -1), (0, 1)):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                  nxt = (nx, ny)\n                  if nxt not in prev and walkable(nxt):\n                      prev[nxt] = cur\n                      q.append(nxt)\n      return None\n\n  def move_action(p, q):\n      \"\"\"Convert a step from p \u2192 q into an action index.\"\"\"\n      dx, dy = q[0] - p[0], q[1] - p[1]\n      if (dx, dy) == (-1, 0):\n          return act_map[\"UP\"]\n      if (dx, dy) == (1, 0):\n          return act_map[\"DOWN\"]\n      if (dx, dy) == (0, -1):\n          return act_map[\"LEFT\"]\n      if (dx, dy) == (0, 1):\n          return act_map[\"RIGHT\"]\n      raise ValueError(\"Non\u2011adjacent move\")\n\n  def adjacent_cells(pos):\n      \"\"\"Return walkable cells adjacent to `pos`.\"\"\"\n      adj = []\n      for dx, dy in ((-1, 0), (1, 0), (0, -1), (0, 1)):\n          ax, ay = pos[0] + dx, pos[1] + dy\n          if 0 <= ax < state.grid.shape[0] and 0 <= ay < state.grid.shape[1]:\n              if walkable((ax, ay)):\n                  adj.append((ax, ay))\n      return adj\n\n  def face_and_use(target):\n      \"\"\"Assume we are on a walkable cell adjacent to `target`.\n      Move opposite then back to set correct facing direction,\n      then issue USE.\"\"\"\n      dx, dy = target[0] - state.pos[0], target[1] - state.pos[1]\n      # Desired facing direction\n      if (dx, dy) == (-1, 0):\n          desired = \"UP\"\n      elif (dx, dy) == (1, 0):\n          desired = \"DOWN\"\n      elif (dx, dy) == (0, -1):\n          desired = \"LEFT\"\n      elif (dx, dy) == (0, 1):\n          desired = \"RIGHT\"\n      else:\n          return []  # shouldn't happen\n\n      # Opposite direction name\n      opposite = {\"UP\": \"DOWN\", \"DOWN\": \"UP\", \"LEFT\": \"RIGHT\", \"RIGHT\": \"LEFT\"}[desired]\n\n      actions_local = []\n      opp_pos = (state.pos[0] - dx, state.pos[1] - dy)\n      if (0 <= opp_pos[0] < state.grid.shape[0] and\n          0 <= opp_pos[1] < state.grid.shape[1] and\n          walkable(opp_pos)):\n          # Step opposite then back\n          actions_local.append(act_map[opposite])\n          _, new_state = env.step(act_map[opposite])\n          actions_local.append(act_map[desired])\n          _, new_state = env.step(act_map[desired])\n      else:\n          # Fallback dummy move (LEFT then desired)\n          dummy = \"LEFT\"\n          actions_local.append(act_map[dummy])\n          _, new_state = env.step(act_map[dummy])\n          actions_local.append(act_map[desired])\n          _, new_state = env.step(act_map[desired])\n\n      # Finally use\n      actions_local.append(act_map[\"USE\"])\n      _, new_state = env.step(act_map[\"USE\"])\n\n      return actions_local, new_state\n\n  # --------------------------------------------------------------------- #\n  # Main plan: collect needed primitives, then craft at workshop (if any)\n  # --------------------------------------------------------------------- #\n  actions = []\n\n  # Helper to locate all cells containing a given kind\n  def locate(kind):\n      xs, ys = np.where(state.grid[:, :, kind] > 0)\n      return list(zip(xs.tolist(), ys.tolist()))\n\n  # ----------------------------------------------------------------- #\n  # 1) Gather required primitives\n  # ----------------------------------------------------------------- #\n  while any(need[k] > 0 for k in need):\n      # Find the nearest primitive we still need\n      candidates = []\n      for prim_idx, cnt in need.items():\n          if cnt <= 0:\n              continue\n          positions = locate(prim_idx)\n          if positions:\n              candidates.append((prim_idx, positions))\n      if not candidates:\n          # No more needed primitives on the map; give up\n          break\n\n      # Choose primitive with minimal Manhattan distance to current position\n      cur = state.pos\n      best = None\n      best_dist = None\n      for prim_idx, positions in candidates:\n          for pos in positions:\n              dist = abs(pos[0] - cur[0]) + abs(pos[1] - cur[1])\n              if best_dist is None or dist < best_dist:\n                  best_dist = dist\n                  best = (prim_idx, pos)\n\n      prim_idx, prim_pos = best\n\n      # Move to a walkable cell adjacent to the primitive\n      adj = adjacent_cells(prim_pos)\n      if not adj:\n          # Cannot reach this primitive; remove it from consideration\n          need[prim_idx] = 0\n          continue\n      path = bfs(state.pos, set(adj))\n      if path is None:\n          # Unreachable; skip\n          need[prim_idx] = 0\n          continue\n\n      # Follow the path\n      for i in range(1, len(path)):\n          a = move_action(path[i - 1], path[i])\n          actions.append(a)\n          _, state = env.step(a)\n          env._current_state = state\n\n      # We are now adjacent; pick up the primitive\n      extra_actions, state = face_and_use(prim_pos)\n      actions.extend(extra_actions)\n      env._current_state = state\n\n      # Update need count (might have picked up more than one if multiple in cell)\n      need[prim_idx] = max(0, need[prim_idx] - 1)\n\n  # ----------------------------------------------------------------- #\n  # 2) Craft the stick at its workshop (if a workshop is required)\n  # ----------------------------------------------------------------- #\n  if workshop_idx is not None:\n      # Locate any workshop of the required type\n      workshop_cells = locate(workshop_idx)\n      if workshop_cells:\n          # Choose the closest workshop\n          cur = state.pos\n          target_ws = min(workshop_cells,\n                          key=lambda p: abs(p[0] - cur[0]) + abs(p[1] - cur[1]))\n          # Move to an adjacent cell of the workshop\n          adj_ws = adjacent_cells(target_ws)\n          if adj_ws:\n              path = bfs(state.pos, set(adj_ws))\n              if path:\n                  for i in range(1, len(path)):\n                      a = move_action(path[i - 1], path[i])\n                      actions.append(a)\n                      _, state = env.step(a)\n                      env._current_state = state\n                  # Use to craft\n                  extra_actions, state = face_and_use(target_ws)\n                  actions.extend(extra_actions)\n                  env._current_state = state\n\n  # Return the accumulated action sequence\n  return actions", "env_interactions": 0, "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-10-21T18:34:12.190735", "function_name": "make_stick", "function_body": "  # reset environment and get initial state\n  obs = env.reset()\n  state = env._current_state\n\n  # mapping from action name to integer index\n  act_map = env.action_specs()          # e.g. {\"UP\":0, \"DOWN\":1, ...}\n  # reverse mapping (int -> name)\n  inv_act = {v: k for k, v in act_map.items()}\n\n  # indices of interest\n  stick_idx = env.world.cookbook.index[\"stick\"]\n  blocked = set(env.world.non_grabbable_indices)\n\n  # ----------------------------------------------------------------------\n  # Helper utilities\n  # ----------------------------------------------------------------------\n  def walkable(pos):\n      \"\"\"Cell is walkable if none of the blocked kinds occupy it.\"\"\"\n      x, y = pos\n      return not any(state.grid[x, y, k] > 0 for k in blocked)\n\n  def bfs(start, targets):\n      \"\"\"Bread\u2011first search from start to any cell in *targets*.\n      Returns a list of positions from start to the chosen target (inclusive)\n      or ``None`` if no path exists.\"\"\"\n      from collections import deque\n      q = deque([start])\n      prev = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur in targets:\n              # reconstruct path\n              path = []\n              while cur is not None:\n                  path.append(cur)\n                  cur = prev[cur]\n              path.reverse()\n              return path\n          for dx, dy in ((-1, 0), (1, 0), (0, -1), (0, 1)):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                  nxt = (nx, ny)\n                  if nxt not in prev and walkable(nxt):\n                      prev[nxt] = cur\n                      q.append(nxt)\n      return None\n\n  def move_action(p, q):\n      \"\"\"Convert a step from p \u2192 q into the corresponding action index.\"\"\"\n      dx, dy = q[0] - p[0], q[1] - p[1]\n      if (dx, dy) == (-1, 0):\n          return act_map[\"UP\"]\n      if (dx, dy) == (1, 0):\n          return act_map[\"DOWN\"]\n      if (dx, dy) == (0, -1):\n          return act_map[\"LEFT\"]\n      if (dx, dy) == (0, 1):\n          return act_map[\"RIGHT\"]\n      raise ValueError(\"non\u2011adjacent move\")\n\n  def face_towards(src, dst):\n      \"\"\"Return the action that would move from src towards dst.\"\"\"\n      dx, dy = dst[0] - src[0], dst[1] - src[1]\n      if (dx, dy) == (-1, 0):\n          return act_map[\"UP\"]\n      if (dx, dy) == (1, 0):\n          return act_map[\"DOWN\"]\n      if (dx, dy) == (0, -1):\n          return act_map[\"LEFT\"]\n      if (dx, dy) == (0, 1):\n          return act_map[\"RIGHT\"]\n      raise ValueError(\"non\u2011adjacent cells\")\n\n  def ensure_facing(src, dst):\n      \"\"\"Perform a minimal movement pair so that the agent ends up facing dst.\"\"\"\n      # direction we need to look at\n      desired = face_towards(src, dst)\n      # opposite direction name\n      opp_name = {\"UP\": \"DOWN\", \"DOWN\": \"UP\", \"LEFT\": \"RIGHT\", \"RIGHT\": \"LEFT\"}[inv_act[desired]]\n      opp_act = act_map[opp_name]\n      # try to step one cell opposite then back\n      ox, oy = src[0] - (dst[0] - src[0]), src[1] - (dst[1] - src[1])\n      if 0 <= ox < state.grid.shape[0] and 0 <= oy < state.grid.shape[1] and walkable((ox, oy)):\n          # step opposite\n          actions.append(opp_act)\n          _, new_state = env.step(opp_act)\n          env._current_state = new_state\n          # step forward (now facing correctly)\n          actions.append(desired)\n          _, new_state = env.step(desired)\n          env._current_state = new_state\n          return new_state.pos, new_state.dir\n      else:\n          # fallback: dummy left\u2011right pair\n          dummy = act_map[\"LEFT\"]\n          actions.append(dummy)\n          _, new_state = env.step(dummy)\n          env._current_state = new_state\n          actions.append(desired)\n          _, new_state = env.step(desired)\n          env._current_state = new_state\n          return new_state.pos, new_state.dir\n\n  # ----------------------------------------------------------------------\n  # Determine whether we need to craft or simply collect\n  # ----------------------------------------------------------------------\n  actions = []\n\n  # If stick is a primitive (i.e. appears on the map), just collect it.\n  if stick_idx in env.world.cookbook.primitives:\n      # Simple collection loop (identical to earlier versions)\n      while state.inventory[stick_idx] == 0:\n          xs, ys = np.where(state.grid[:, :, stick_idx] > 0)\n          sticks = list(zip(xs.tolist(), ys.tolist()))\n          if not sticks:\n              break\n          cur = state.pos\n          target = min(sticks, key=lambda p: abs(p[0] - cur[0]) + abs(p[1] - cur[1]))\n          # adjacent walkable cells\n          adj = []\n          for dx, dy in ((-1, 0), (1, 0), (0, -1), (0, 1)):\n              ax, ay = target[0] + dx, target[1] + dy\n              if 0 <= ax < state.grid.shape[0] and 0 <= ay < state.grid.shape[1] and walkable((ax, ay)):\n                  adj.append((ax, ay))\n          path = bfs(cur, set(adj))\n          if path is None:\n              break\n          for i in range(1, len(path)):\n              a = move_action(path[i - 1], path[i])\n              actions.append(a)\n              _, state = env.step(a)\n              env._current_state = state\n          # face the stick and use\n          state.pos, state.dir = ensure_facing(state.pos, target)\n          actions.append(act_map[\"USE\"])\n          _, state = env.step(act_map[\"USE\"])\n          env._current_state = state\n      return actions\n\n  # ----------------------------------------------------------------------\n  # Stick must be crafted \u2013 retrieve recipe information\n  # ----------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes[stick_idx]\n  workshop_name = recipe.get(\"_at\", None)\n  workshop_idx = env.world.cookbook.index[workshop_name] if workshop_name else None\n\n  # primitives needed for one stick\n  needed = env.world.cookbook.primitives_for(stick_idx)  # dict {prim_idx: count}\n  # ----------------------------------------------------------------------\n  # Collect required primitives\n  # ----------------------------------------------------------------------\n  while any(state.inventory[pid] < cnt for pid, cnt in needed.items()):\n      # pick a primitive that is still lacking\n      lacking = [(pid, cnt - state.inventory[pid]) for pid, cnt in needed.items()\n                 if state.inventory[pid] < cnt]\n      pid, _ = lacking[0]  # just take the first\n      # locate all instances of this primitive on the map\n      xs, ys = np.where(state.grid[:, :, pid] > 0)\n      positions = list(zip(xs.tolist(), ys.tolist()))\n      if not positions:\n          # cannot find required primitive \u2013 abort\n          break\n      cur = state.pos\n      target = min(positions,\n                   key=lambda p: abs(p[0] - cur[0]) + abs(p[1] - cur[1]))\n      # adjacent walkable cells\n      adj = []\n      for dx, dy in ((-1, 0), (1, 0), (0, -1), (0, 1)):\n          ax, ay = target[0] + dx, target[1] + dy\n          if 0 <= ax < state.grid.shape[0] and 0 <= ay < state.grid.shape[1] and walkable((ax, ay)):\n              adj.append((ax, ay))\n      path = bfs(cur, set(adj))\n      if path is None:\n          break\n      for i in range(1, len(path)):\n          a = move_action(path[i - 1], path[i])\n          actions.append(a)\n          _, state = env.step(a)\n          env._current_state = state\n      # face the primitive and collect it\n      state.pos, state.dir = ensure_facing(state.pos, target)\n      actions.append(act_map[\"USE\"])\n      _, state = env.step(act_map[\"USE\"])\n      env._current_state = state\n\n  # ----------------------------------------------------------------------\n  # If we have all primitives, go to the workshop (if any) and craft\n  # ----------------------------------------------------------------------\n  if workshop_idx is not None:\n      # locate workshop cells\n      xs, ys = np.where(state.grid[:, :, workshop_idx] > 0)\n      workshop_cells = list(zip(xs.tolist(), ys.tolist()))\n      if workshop_cells:\n          cur = state.pos\n          # choose nearest workshop cell\n          target = min(workshop_cells,\n                       key=lambda p: abs(p[0] - cur[0]) + abs(p[1] - cur[1]))\n          # adjacent walkable cells around workshop\n          adj = []\n          for dx, dy in ((-1, 0), (1, 0), (0, -1), (0, 1)):\n              ax, ay = target[0] + dx, target[1] + dy\n              if 0 <= ax < state.grid.shape[0] and 0 <= ay < state.grid.shape[1] and walkable((ax, ay)):\n                  adj.append((ax, ay))\n          path = bfs(cur, set(adj))\n          if path is not None:\n              for i in range(1, len(path)):\n                  a = move_action(path[i - 1], path[i])\n                  actions.append(a)\n                  _, state = env.step(a)\n                  env._current_state = state\n              # face the workshop and craft\n              state.pos, state.dir = ensure_facing(state.pos, target)\n              actions.append(act_map[\"USE\"])\n              _, state = env.step(act_map[\"USE\"])\n              env._current_state = state\n\n  return actions", "env_interactions": 0, "island_id": 6, "scores": {"3": -1}}
