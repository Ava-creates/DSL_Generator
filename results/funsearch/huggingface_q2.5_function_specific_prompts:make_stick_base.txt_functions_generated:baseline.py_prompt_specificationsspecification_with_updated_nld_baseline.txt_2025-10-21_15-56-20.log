{"timestamp": "2025-10-21T17:58:56.238892", "function_name": "make_stick", "function_body": "  env.reset()\n  state = env._current_state\n  act_spec = env.action_specs()\n  ACTION_USE = act_spec[\"USE\"]\n  ACTIONS_MOVE = {k: act_spec[k] for k in (\"UP\", \"DOWN\", \"LEFT\", \"RIGHT\")}\n  DIR_VECT = {\"UP\": (-1, 0), \"DOWN\": (1, 0), \"LEFT\": (0, -1), \"RIGHT\": (0, 1)}\n  from collections import deque\n\n  def bfs_path(start, targets):\n      h, w = state.grid.shape[:2]\n      visited = set()\n      q = deque([(start, [])])\n      while q:\n          pos, path = q.popleft()\n          if pos in visited:\n              continue\n          visited.add(pos)\n          if pos in targets:\n              return path\n          x, y = pos\n          for name, (dx, dy) in DIR_VECT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < h and 0 <= ny < w:\n                  if not state.grid[nx, ny].any():\n                      q.append(((nx, ny), path + [ACTIONS_MOVE[name]]))\n      return None\n\n  idx = state.world.cookbook.index\n  stick_idx = idx.index(\"stick\")\n  primitive_needs = state.world.cookbook.primitives_for(stick_idx)\n  actions = []\n\n  for prim_idx, needed_cnt in primitive_needs.items():\n      while state.inventory[prim_idx] < needed_cnt:\n          h, w = state.grid.shape[:2]\n          prim_locs = [(i, j) for i in range(h) for j in range(w) if state.grid[i, j, prim_idx] > 0]\n          if not prim_locs:\n              break\n          path = bfs_path(state.pos, set(prim_locs))\n          if path is None:\n              break\n          for a in path:\n              _, state = state.step(a)\n              actions.append(a)\n          _, state = state.step(ACTION_USE)\n          actions.append(ACTION_USE)\n\n  recipe = state.world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\") if isinstance(recipe, dict) else None\n  if workshop_name:\n      workshop_idx = idx.index(workshop_name)\n      h, w = state.grid.shape[:2]\n      workshop_cells = [(i, j) for i in range(h) for j in range(w) if state.grid[i, j, workshop_idx] > 0]\n      if workshop_cells:\n          path = bfs_path(state.pos, set(workshop_cells))\n          if path:\n              for a in path:\n                  _, state = state.step(a)\n                  actions.append(a)\n              _, state = state.step(ACTION_USE)\n              actions.append(ACTION_USE)\n\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T17:58:57.368497", "function_name": "make_stick", "function_body": "  # Reset environment and get initial state\n  env.reset()\n  state = env._current_state  # type: CraftState\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  act_spec = env.action_specs()\n  ACTION_USE = act_spec[\"USE\"]\n  ACTIONS_MOVE = {k: act_spec[k] for k in (\"UP\", \"DOWN\", \"LEFT\", \"RIGHT\")}\n  DIR_VECT = {\n      \"UP\": (-1, 0),\n      \"DOWN\": (1, 0),\n      \"LEFT\": (0, -1),\n      \"RIGHT\": (0, 1),\n  }\n\n  from collections import deque\n\n  # Breadth\u2011first search returning a list of action IDs that move the\n  # agent from ``start`` to the nearest cell contained in ``targets``.\n  def bfs_path(start, targets):\n      h, w = state.grid.shape[:2]\n      visited = set()\n      q = deque([(start, [])])\n\n      while q:\n          pos, path = q.popleft()\n          if pos in visited:\n              continue\n          visited.add(pos)\n\n          if pos in targets:\n              return path\n\n          x, y = pos\n          for name, (dx, dy) in DIR_VECT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < h and 0 <= ny < w:\n                  # Walkable iff the cell is completely empty (no entity).\n                  if not state.grid[nx, ny].any():\n                      q.append(((nx, ny), path + [ACTIONS_MOVE[name]]))\n      return None\n\n  # ------------------------------------------------------------------\n  # Identify the index for \u201cstick\u201d and its primitive requirements.\n  # ------------------------------------------------------------------\n  idx = state.world.cookbook.index\n  stick_idx = idx.index(\"stick\")\n  primitive_needs = state.world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive.\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      while state.inventory[prim_idx] < needed_cnt:\n          # Locate all cells that currently hold the primitive.\n          h, w = state.grid.shape[:2]\n          prim_locs = [\n              (i, j)\n              for i in range(h)\n              for j in range(w)\n              if state.grid[i, j, prim_idx] > 0\n          ]\n\n          if not prim_locs:\n              # No more instances on the map \u2013 abort.\n              break\n\n          # Move to the nearest reachable instance.\n          path = bfs_path(state.pos, set(prim_locs))\n          if path is None:\n              # Unreachable \u2013 abort.\n              break\n\n          # Execute movement actions.\n          for a in path:\n              _, state = state.step(a)\n              actions.append(a)\n\n          # Use (collect) the primitive.\n          _, state = state.step(ACTION_USE)\n          actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # If the recipe requires a workshop, travel there and craft the stick.\n  # ------------------------------------------------------------------\n  recipe_dict = state.world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe_dict.get(\"_at\") if isinstance(recipe_dict, dict) else None\n\n  if workshop_name:\n      workshop_idx = idx.index(workshop_name)\n\n      h, w = state.grid.shape[:2]\n      workshop_cells = [\n          (i, j)\n          for i in range(h)\n          for j in range(w)\n          if state.grid[i, j, workshop_idx] > 0\n      ]\n\n      if workshop_cells:\n          path = bfs_path(state.pos, set(workshop_cells))\n          if path:\n              for a in path:\n                  _, state = state.step(a)\n                  actions.append(a)\n\n              # Craft at the workshop.\n              _, state = state.step(ACTION_USE)\n              actions.append(ACTION_USE)\n\n  # Return the accumulated action sequence.\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T17:59:16.697710", "function_name": "make_stick", "function_body": "  # Reset environment to start fresh\n  env.reset()\n\n  # Shortcut references\n  world = env.world\n  idx = world.cookbook.index\n\n  # Index of the goal item \"stick\"\n  try:\n      stick_idx = idx[\"stick\"]\n  except Exception:  # pragma: no cover\n      # case\u2011insensitive fallback\n      stick_idx = next(i for i, n in enumerate(idx.ordered_contents) if n.lower() == \"stick\")\n\n  # Primitive requirements for one stick (empty dict if stick itself is primitive)\n  needed = world.cookbook.primitives_for(stick_idx)\n  if not needed:\n      needed = {stick_idx: 1}\n\n  # Action IDs\n  action_map = env.action_specs()\n  DOWN = action_map[\"DOWN\"]\n  UP = action_map[\"UP\"]\n  LEFT = action_map[\"LEFT\"]\n  RIGHT = action_map[\"RIGHT\"]\n  USE = action_map[\"USE\"]\n  ACTIONS = {(-1, 0): LEFT, (1, 0): RIGHT, (0, -1): UP, (0, 1): DOWN}\n\n  # Current state information\n  state = env._current_state\n  cur_pos = tuple(state.pos)               # (x, y)\n  grid = state.grid.copy()                  # local copy for bookkeeping\n\n  # ------------------------------------------------------------------\n  # Helper: BFS pathfinder that avoids any occupied cell except the\n  #         target kind (or the workshop kind when we are heading there).\n  # ------------------------------------------------------------------\n  def bfs_path(start, goal, ignore_kind=None):\n      \"\"\"Return list of actions (int) to move from start to goal.\"\"\"\n      W, H = grid.shape[:2]\n      visited = np.full((W, H), False, dtype=bool)\n      prev = dict()\n      q = collections.deque()\n      q.append(start)\n      visited[start] = True\n\n      while q:\n          x, y = q.popleft()\n          if (x, y) == goal:\n              break\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  # A cell is blocked if any kind is present, unless we are\n                  # allowed to step onto the goal cell (ignore_kind)\n                  blocked = grid[nx, ny].sum() > 0\n                  if (nx, ny) == goal and ignore_kind is not None:\n                      # allow stepping onto a cell that only contains the ignored kind\n                      blocked = grid[nx, ny].sum() > grid[nx, ny, ignore_kind]\n                  if not blocked:\n                      visited[nx, ny] = True\n                      prev[(nx, ny)] = (x, y)\n                      q.append((nx, ny))\n\n      # Reconstruct path\n      if goal not in prev and start != goal:\n          return []  # no path found\n      path = []\n      cur = goal\n      while cur != start:\n          path.append(cur)\n          cur = prev[cur]\n      path.reverse()\n\n      # Translate coordinates to actions\n      actions = []\n      x, y = start\n      for nx, ny in path:\n          dx, dy = nx - x, ny - y\n          actions.append(ACTIONS[(dx, dy)])\n          x, y = nx, ny\n      return actions\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # 1. Collect required primitives (respecting quantity)\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(int(cnt)):\n          # Locate any remaining instance of this primitive\n          locs = np.argwhere(grid[:, :, prim_idx] > 0)\n          if locs.size == 0:\n              # No more of this primitive on the map \u2013 give up\n              break\n          # Choose the closest one (Manhattan distance) for efficiency\n          dists = np.abs(locs[:, 0] - cur_pos[0]) + np.abs(locs[:, 1] - cur_pos[1])\n          target = tuple(locs[dists.argmin()])\n\n          # Move to the primitive (avoid obstacles)\n          actions.extend(bfs_path(cur_pos, target, ignore_kind=prim_idx))\n          cur_pos = target\n\n          # Pick it up\n          actions.append(USE)\n\n          # Update local grid copy\n          grid[target[0], target[1], prim_idx] = max(\n              0, grid[target[0], target[1], prim_idx] - 1\n          )\n\n  # ------------------------------------------------------------------\n  # 2. Go to the required workshop (if any) and craft the stick\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      ws_idx = idx[workshop_name]\n      ws_locs = np.argwhere(grid[:, :, ws_idx] > 0)\n      if ws_locs.size:\n          # Choose the nearest workshop\n          dists = np.abs(ws_locs[:, 0] - cur_pos[0]) + np.abs(ws_locs[:, 1] - cur_pos[1])\n          ws_target = tuple(ws_locs[dists.argmin()])\n          actions.extend(bfs_path(cur_pos, ws_target, ignore_kind=ws_idx))\n          cur_pos = ws_target\n          actions.append(USE)   # use workshop to craft\n\n  return actions", "env_interactions": 4, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T17:59:17.826787", "function_name": "make_stick", "function_body": "  # Reset environment to start a fresh episode\n  env.reset()\n\n  # Shortcut references to world and index mappings\n  world = env.world\n  idx = world.cookbook.index\n\n  # Identify the index for the goal item \"stick\"\n  stick_idx = idx[\"stick\"]\n\n  # Determine required primitives for crafting a stick\n  needed_prims = world.cookbook.primitives_for(stick_idx)\n  if not needed_prims:\n      # If stick is itself primitive, just need one\n      needed_prims = {stick_idx: 1}\n\n  # Action mapping (DOWN, UP, LEFT, RIGHT, USE)\n  action_map = env.action_specs()\n  DOWN = action_map[\"DOWN\"]\n  UP = action_map[\"UP\"]\n  LEFT = action_map[\"LEFT\"]\n  RIGHT = action_map[\"RIGHT\"]\n  USE = action_map[\"USE\"]\n\n  # Current state information\n  state = env._current_state\n  cur_pos = tuple(state.pos)          # (x, y)\n  grid = state.grid.copy()            # local copy for bookkeeping\n\n  # Helper: simple Manhattan move sequence (ignores obstacles)\n  def manhattan_moves(start, goal):\n      x, y = start\n      gx, gy = goal\n      moves = []\n      while x < gx:\n          moves.append(RIGHT)\n          x += 1\n      while x > gx:\n          moves.append(LEFT)\n          x -= 1\n      while y < gy:\n          moves.append(DOWN)\n          y += 1\n      while y > gy:\n          moves.append(UP)\n          y -= 1\n      return moves\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # 1. Collect each required primitive (respecting quantity)\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed_prims.items():\n      for _ in range(int(count)):\n          # Find any cell that still contains this primitive\n          locations = np.argwhere(grid[:, :, prim_idx] > 0)\n          if locations.size == 0:\n              # No more of this primitive on the map \u2013 skip\n              continue\n          target = tuple(locations[0])   # (x, y)\n\n          # Move to the primitive's location\n          actions.extend(manhattan_moves(cur_pos, target))\n          cur_pos = target\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update local grid copy to reflect the pickup\n          grid[target[0], target[1], prim_idx] = max(\n              0, grid[target[0], target[1], prim_idx] - 1\n          )\n\n  # ------------------------------------------------------------------\n  # 2. Go to the appropriate workshop (if required) and craft the stick\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = idx[workshop_name]\n      ws_locations = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_locations.size:\n          ws_target = tuple(ws_locations[0])\n          actions.extend(manhattan_moves(cur_pos, ws_target))\n          cur_pos = ws_target\n          actions.append(USE)   # use workshop to craft\n\n  return actions", "env_interactions": 4, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T17:59:37.567171", "function_name": "make_stick", "function_body": "  import numpy as np\n\n  # Action mapping from the environment\n  ACTION = env.action_specs()\n\n  # Current state and world objects\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def find_nearest(pos, kind):\n      \"\"\"Return (x, y) of the nearest cell containing `kind`.\"\"\"\n      layer = state.grid[:, :, kind]\n      ys, xs = np.where(layer > 0)\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - pos[0]) + np.abs(ys - pos[1])\n      i = int(np.argmin(dists))\n      return (int(xs[i]), int(ys[i]))\n\n  def moves_to(cur, target):\n      \"\"\"Return a list of movement actions from cur \u2192 target (Manhattan).\"\"\"\n      seq = []\n      x, y = cur\n      tx, ty = target\n      while x != tx:\n          if tx > x:\n              seq.append(ACTION[\"RIGHT\"])\n              x += 1\n          else:\n              seq.append(ACTION[\"LEFT\"])\n              x -= 1\n      while y != ty:\n          if ty > y:\n              seq.append(ACTION[\"DOWN\"])\n              y += 1\n          else:\n              seq.append(ACTION[\"UP\"])\n              y -= 1\n      return seq\n\n  # ------------------------------------------------------------------\n  # Determine primitives required for a stick\n  # ------------------------------------------------------------------\n  stick_idx = idx[\"stick\"]\n  needed = world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n  plan = []\n  cur_pos = state.pos\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          target = find_nearest(cur_pos, prim_idx)\n          if target is None:\n              continue  # safety: should not happen in a valid scenario\n          plan.extend(moves_to(cur_pos, target))\n          plan.append(ACTION[\"USE\"])   # pick up the primitive\n          cur_pos = target\n\n  # ------------------------------------------------------------------\n  # Move to the appropriate workshop (if any) and craft the stick\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      wk_idx = idx[workshop_name] if isinstance(workshop_name, str) else workshop_name\n      wk_pos = find_nearest(cur_pos, wk_idx)\n      if wk_pos is not None:\n          plan.extend(moves_to(cur_pos, wk_pos))\n          cur_pos = wk_pos\n\n  # Final USE to perform the crafting action\n  plan.append(ACTION[\"USE\"])\n\n  return plan", "env_interactions": 4, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T17:59:38.704596", "function_name": "make_stick", "function_body": "  import numpy as np\n\n  # Mapping from action names to integer codes\n  ACTION = env.action_specs()\n\n  # Current state and world objects\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def find_nearest(pos, kind, grid):\n      \"\"\"Return coordinates (x, y) of the nearest cell that contains `kind` in `grid`.\"\"\"\n      layer = grid[:, :, kind]\n      ys, xs = np.where(layer > 0)\n      if len(xs) == 0:\n          return None\n      dists = np.abs(xs - pos[0]) + np.abs(ys - pos[1])\n      i = int(np.argmin(dists))\n      return (int(xs[i]), int(ys[i]))\n\n  def moves_to(cur, target):\n      \"\"\"Return a list of movement actions to go from cur \u2192 target (Manhattan).\"\"\"\n      seq = []\n      x, y = cur\n      tx, ty = target\n      while x != tx:\n          if tx > x:\n              seq.append(ACTION[\"RIGHT\"])\n              x += 1\n          else:\n              seq.append(ACTION[\"LEFT\"])\n              x -= 1\n      while y != ty:\n          if ty > y:\n              seq.append(ACTION[\"DOWN\"])\n              y += 1\n          else:\n              seq.append(ACTION[\"UP\"])\n              y -= 1\n      return seq\n\n  # ------------------------------------------------------------------\n  # Identify the stick index and its primitive requirements\n  # ------------------------------------------------------------------\n  stick_idx = idx[\"stick\"]\n  needed_prims = world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n\n  # Working copy of the grid to keep track of collected items\n  grid = state.grid.copy()\n  plan = []\n  cur_pos = state.pos\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed_prims.items():\n      for _ in range(cnt):\n          target = find_nearest(cur_pos, prim_idx, grid)\n          if target is None:\n              # Primitive not present \u2013 abort planning\n              return []\n          plan.extend(moves_to(cur_pos, target))\n          plan.append(ACTION[\"USE\"])          # pick up the primitive\n          # Update simulated grid and current position\n          grid[target[1], target[0], prim_idx] = 0\n          cur_pos = target\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the stick\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\", None)\n\n  if workshop_name is not None:\n      # Resolve workshop index (might be string name or already an int)\n      wk_idx = idx[workshop_name] if isinstance(workshop_name, str) else workshop_name\n      wk_pos = find_nearest(cur_pos, wk_idx, grid)\n      if wk_pos is not None:\n          plan.extend(moves_to(cur_pos, wk_pos))\n          cur_pos = wk_pos\n\n  # Final USE to perform the crafting action\n  plan.append(ACTION[\"USE\"])\n\n  return plan", "env_interactions": 4, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:00:04.138468", "function_name": "make_stick", "function_body": "  import numpy as np\n\n  # Determine the index of the target item \"stick\" using the world's cookbook.\n  # If the name is not present, we cannot detect success; in that case we simply\n  # run a bounded random exploration.\n  try:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n  except Exception:\n      stick_idx = None\n\n  actions = []\n  max_steps = 2000  # generous upper bound to avoid infinite loops\n\n  for _ in range(max_steps):\n      # Check if we already have a stick in the inventory.\n      if stick_idx is not None:\n          try:\n              if env._current_state.inventory[stick_idx] > 0:\n                  break\n          except Exception:\n              pass  # fallback to random exploration if inventory access fails\n\n      # Simple exploration policy:\n      #   - If there is something directly in front that can be interacted with,\n      #     try the USE action (index 4).\n      #   - Otherwise, move randomly (DOWN=0, UP=1, LEFT=2, RIGHT=3).\n      # The environment does not expose a direct \"can_use\" query, so we just\n      # probabilistically choose USE with a small chance.\n      if np.random.rand() < 0.2:\n          action = 4  # USE\n      else:\n          action = np.random.choice([0, 1, 2, 3])  # movement actions\n\n      # Apply the action.  CraftLab follows the OpenAI\u2011Gym API:\n      #   observation, reward, done, info = env.step(action)\n      # We ignore the returned values except for the termination flag.\n      try:\n          _, _, done, _ = env.step(action)\n      except Exception:\n          # If the environment does not follow the Gym signature (e.g., returns\n          # only observation), just call it and ignore the result.\n          env.step(action)\n          done = False\n\n      actions.append(int(action))\n\n      if done:\n          # Episode finished (perhaps due to max steps or an error).  Stop early.\n          break\n\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-10-21T18:00:05.264090", "function_name": "make_stick", "function_body": "  # Reset the environment to obtain a fresh state.\n  obs = env.reset()\n  # The CraftLab wrapper stores the underlying CraftState in a private attribute.\n  # It is safe to access it for planning purposes.\n  state = env._current_state          # type: CraftState\n  world = env.scenario.world          # type: CraftWorld\n\n  # The goal is stored in the task tuple (goal index, max steps).\n  goal_idx = env.task.goal\n\n  # Determine which primitive resources are needed for the goal.\n  # This returns a dict {primitive_kind_index: count}.\n  primitives_needed = world.cookbook.primitives_for(goal_idx)\n\n  # Action mapping (DOWN, UP, LEFT, RIGHT, USE) provided by the environment.\n  act_map = env.action_specs()\n  # Directions for movement actions (dx, dy) in grid coordinates.\n  move_dirs = {\n      act_map[\"UP\"]:    (0, -1),\n      act_map[\"DOWN\"]:  (0, 1),\n      act_map[\"LEFT\"]:  (-1, 0),\n      act_map[\"RIGHT\"]: (1, 0),\n  }\n\n  # ----------------------------------------------------------------------\n  # Helper: breadth\u2011first search on the current grid to obtain a sequence\n  # of movement actions from a start cell to a target cell.\n  # ----------------------------------------------------------------------\n  from collections import deque\n\n  def bfs_path(start, target, grid):\n      \"\"\"Return a list of movement actions that reaches `target` from `start`.\n      Cells containing any kind are considered blocked; the agent may walk\n      only on empty cells (all\u2011zero one\u2011hot vector).\"\"\"\n      if start == target:\n          return []\n\n      width, height, _ = grid.shape\n      visited = set()\n      q = deque([(start, [])])\n      visited.add(start)\n\n      while q:\n          (x, y), path = q.popleft()\n          for act, (dx, dy) in move_dirs.items():\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              # a cell is free if the sum over all kinds is zero\n              if grid[nx, ny].sum() != 0:\n                  continue\n              new_path = path + [act]\n              if (nx, ny) == target:\n                  return new_path\n              visited.add((nx, ny))\n              q.append(((nx, ny), new_path))\n      # No path found \u2013 return empty list (the caller will simply ignore).\n      return []\n\n  # ----------------------------------------------------------------------\n  # Collect all required primitive items.\n  # ----------------------------------------------------------------------\n  plan_actions = []\n\n  for prim_idx, needed_cnt in primitives_needed.items():\n      for _ in range(needed_cnt):\n          # Locate the nearest occurrence of the primitive on the grid.\n          prim_positions = [\n              (i, j)\n              for i in range(state.grid.shape[0])\n              for j in range(state.grid.shape[1])\n              if state.grid[i, j, prim_idx] > 0\n          ]\n          if not prim_positions:\n              # No such primitive left on the map \u2013 abort planning.\n              return plan_actions\n\n          # Choose the first (could be improved with distance heuristic).\n          target_pos = prim_positions[0]\n\n          # Compute a path to the target cell.\n          path = bfs_path(state.pos, target_pos, state.grid)\n          plan_actions.extend(path)\n\n          # After moving onto the primitive cell we need to issue a USE\n          # action to pick it up.\n          plan_actions.append(act_map[\"USE\"])\n\n          # Execute the just\u2011added actions to keep `state` up\u2011to\u2011date.\n          for a in path + [act_map[\"USE\"]]:\n              _, done, _ = env.step(a)\n              if done:\n                  return plan_actions\n              state = env._current_state\n\n  # ----------------------------------------------------------------------\n  # Move to the appropriate workshop (if any) and craft the goal item.\n  # ----------------------------------------------------------------------\n  # The recipe dict may contain a special key \"_at\" that indicates the\n  # workshop kind required for crafting.\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  for k, v in recipe.items():\n      if k == \"_at\":\n          workshop_kind = v\n          break\n\n  if workshop_kind is not None:\n      wk_idx = workshop_kind\n      workshop_positions = [\n          (i, j)\n          for i in range(state.grid.shape[0])\n          for j in range(state.grid.shape[1])\n          if state.grid[i, j, wk_idx] > 0\n      ]\n      if workshop_positions:\n          target_wk = workshop_positions[0]\n          path = bfs_path(state.pos, target_wk, state.grid)\n          plan_actions.extend(path)\n          plan_actions.append(act_map[\"USE\"])\n\n          for a in path + [act_map[\"USE\"]]:\n              _, done, _ = env.step(a)\n              if done:\n                  return plan_actions\n              state = env._current_state\n\n  # Return the complete list of actions that should achieve the goal.\n  return plan_actions", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:00:28.680481", "function_name": "make_stick", "function_body": "  try:\n      # Reset environment to start a fresh episode.\n      env.reset()\n      # Obtain the current CraftState from the wrapper or scenario.\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          scenario = getattr(env, \"scenario\", None)\n          if scenario is not None:\n              state = scenario.init()\n      if state is None:\n          return []\n\n      world = state.world\n      grid = state.grid.copy()\n      h, w, _ = grid.shape\n      cur_pos = state.pos\n      actions = []\n\n      # ------------------------------------------------------------------\n      # Helper utilities.\n      # ------------------------------------------------------------------\n      def find_cells(kind_idx):\n          \"\"\"Return list of (x, y) positions where `kind_idx` is present.\"\"\"\n          pts = np.argwhere(grid[:, :, kind_idx] > 0)\n          return [tuple(p) for p in pts]\n\n      # (dx, dy, action_index) for DOWN, UP, LEFT, RIGHT.\n      dirs = [(1, 0, 0), (-1, 0, 1), (0, -1, 2), (0, 1, 3)]\n\n      def is_blocked(x, y):\n          \"\"\"True if a non\u2011grabbable entity occupies cell (x, y).\"\"\"\n          for idx in world.non_grabbable_indices:\n              if grid[x, y, idx] > 0:\n                  return True\n          return False\n\n      from collections import deque\n\n      def bfs(start, goal):\n          \"\"\"Bread\u2011first search returning a list of actions from start to goal.\"\"\"\n          if start == goal:\n              return []\n          q = deque()\n          q.append((start, []))\n          visited = {start}\n          while q:\n              (cx, cy), path = q.popleft()\n              for dx, dy, act in dirs:\n                  nx, ny = cx + dx, cy + dy\n                  if 0 <= nx < h and 0 <= ny < w and not is_blocked(nx, ny):\n                      if (nx, ny) not in visited:\n                          if (nx, ny) == goal:\n                              return path + [act]\n                          visited.add((nx, ny))\n                          q.append(((nx, ny), path + [act]))\n          return []  # no path found (should not happen in valid maps)\n\n      # ------------------------------------------------------------------\n      # Identify the stick item and its recipe.\n      # ------------------------------------------------------------------\n      stick_idx = world.cookbook.index.get(\"stick\")\n      if stick_idx is None:\n          return []\n\n      primitive_req = world.cookbook.primitives_for(stick_idx)\n\n      # ------------------------------------------------------------------\n      # If stick itself is a primitive, just collect one.\n      # ------------------------------------------------------------------\n      if not primitive_req:\n          cells = find_cells(stick_idx)\n          if not cells:\n              return []\n          # Choose nearest occurrence.\n          dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in cells]\n          target = cells[int(np.argmin(dists))]\n          actions.extend(bfs(cur_pos, target))\n          actions.append(4)  # USE to pick up the stick\n          return actions\n\n      # ------------------------------------------------------------------\n      # Collect required primitives.\n      # ------------------------------------------------------------------\n      for prim_idx, needed in primitive_req.items():\n          for _ in range(needed):\n              cells = find_cells(prim_idx)\n              if not cells:\n                  return []  # required primitive missing\n              dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in cells]\n              target = cells[int(np.argmin(dists))]\n              actions.extend(bfs(cur_pos, target))\n              actions.append(4)  # USE to pick up primitive\n              cur_pos = target\n              grid[target[0], target[1], prim_idx] = 0  # remove from our copy\n\n      # ------------------------------------------------------------------\n      # Move to workshop (if any) and craft the stick.\n      # ------------------------------------------------------------------\n      recipe = world.cookbook.recipes.get(stick_idx, {})\n      workshop_kind = recipe.get(\"_at\")\n      if workshop_kind is not None:\n          ws_cells = find_cells(workshop_kind)\n          if not ws_cells:\n              return []  # workshop not present\n          dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in ws_cells]\n          ws_target = ws_cells[int(np.argmin(dists))]\n          actions.extend(bfs(cur_pos, ws_target))\n          actions.append(4)  # USE to craft at workshop\n      else:\n          # No specific workshop; craft at current location.\n          actions.append(4)  # USE to craft\n\n      return actions\n  except Exception:\n      return []", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
