{"timestamp": "2025-10-21T21:20:50.631219", "function_name": "make_stick", "function_body": "  import collections\n\n  # Determine action IDs (fallback to default ordering if unavailable)\n  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      action_ids = [0, 1, 2, 3, 4]  # DOWN, UP, LEFT, RIGHT, USE\n\n  # Resolve the integer index for the target item \"stick\"\n  try:\n      goal_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      goal_idx = env.world.cookbook.index.get(\"stick\")\n\n  # Obtain the initial state (use the lab's current state if present)\n  start_state = getattr(env, \"_current_state\", None)\n  if start_state is None:\n      start_state = env.scenario.init()\n\n  # Helper to create a hashable representation of a state for visited checks\n  def _state_key(st):\n      # Include position, direction, inventory, and grid layout\n      return (st.pos, st.dir, st.inventory.tobytes(), st.grid.tobytes())\n\n  # Bread\u2011first search over deterministic transitions\n  frontier = collections.deque()\n  frontier.append((start_state, []))\n  visited = {_state_key(start_state)}\n\n  MAX_PLAN_LEN = 500  # safety bound to avoid infinite search\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      # Goal test: inventory already contains a stick\n      if goal_idx is not None and cur_state.satisfies(\"\", goal_idx):\n          return cur_plan\n\n      # Prune overly long plans\n      if len(cur_plan) >= MAX_PLAN_LEN:\n          continue\n\n      # Prioritize USE action (typically index 4) to favour interactions\n      if 4 in action_ids:\n          ordered_actions = [4] + [a for a in action_ids if a != 4]\n      else:\n          ordered_actions = action_ids\n\n      # Expand all possible actions\n      for a in ordered_actions:\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((next_state, cur_plan + [a]))\n\n  # No plan found within limits \u2013 return empty list\n  return []", "env_interactions": 4, "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T21:20:51.754523", "function_name": "make_stick", "function_body": "  import collections\n\n  # Resolve action IDs; fall back to the default ordering if the env does not expose specs.\n  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      action_ids = [0, 1, 2, 3, 4]  # DOWN, UP, LEFT, RIGHT, USE\n\n  # Resolve the integer index of the target item \"stick\".\n  try:\n      goal_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      goal_idx = env.world.cookbook.index.get(\"stick\")\n\n  # If the goal cannot be identified, give up early.\n  if goal_idx is None:\n      return []\n\n  # Obtain the initial state (use the Lab's current state if already available).\n  start_state = getattr(env, \"_current_state\", None)\n  if start_state is None:\n      start_state = env.scenario.init()\n\n  # Quick exit if we already have a stick.\n  if start_state.satisfies(\"\", goal_idx):\n      return []\n\n  # Helper to create a hashable representation of a state for the visited set.\n  def _state_key(st):\n      # Include position, direction, inventory and the full grid layout.\n      return (st.pos, st.dir, st.inventory.tobytes(), st.grid.tobytes())\n\n  # Bread\u2011first search over deterministic transitions.\n  frontier = collections.deque()\n  frontier.append((start_state, []))\n  visited = {_state_key(start_state)}\n\n  MAX_PLAN_LEN = 500  # safety bound to avoid infinite search\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      # Goal test: inventory already contains a stick.\n      if cur_state.satisfies(\"\", goal_idx):\n          return cur_plan\n\n      # Prune overly long plans.\n      if len(cur_plan) >= MAX_PLAN_LEN:\n          continue\n\n      # Expand all possible actions.\n      for a in action_ids:\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((next_state, cur_plan + [a]))\n\n  # No plan found within limits \u2013 return empty list.\n  return []", "env_interactions": 4, "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T21:21:01.736971", "function_name": "make_stick", "function_body": "  import collections\n\n  # Determine action IDs (fallback to default ordering if env.action_specs missing)\n  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      action_ids = [0, 1, 2, 3, 4]  # DOWN, UP, LEFT, RIGHT, USE\n\n  # Resolve the integer index for the target item \"stick\"\n  try:\n      target_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      target_idx = env.world.cookbook.index.get(\"stick\")\n  if target_idx is None:\n      return []\n\n  # Obtain the initial state (use current state if available)\n  start_state = getattr(env, \"_current_state\", None)\n  if start_state is None:\n      start_state = env.scenario.init()\n\n  # Helper to produce a hashable representation of a state for visited\u2011set tracking\n  def _state_key(st):\n      # Position, direction, and inventory uniquely identify a deterministic state\n      return (st.pos, st.dir, st.inventory.tobytes())\n\n  # Bread\u2011first search over deterministic transitions\n  frontier = collections.deque()\n  frontier.append((start_state, []))\n  visited = {_state_key(start_state)}\n  MAX_PLAN_LEN = 800  # safety bound to avoid infinite search\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      # Goal test: inventory already contains a stick\n      if cur_state.satisfies(\"\", target_idx):\n          return cur_plan\n\n      # Prune overly long plans\n      if len(cur_plan) >= MAX_PLAN_LEN:\n          continue\n\n      # Expand all possible actions\n      for a in action_ids:\n          _, nxt_state = cur_state.step(a)\n          key = _state_key(nxt_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((nxt_state, cur_plan + [a]))\n\n  # No plan found within limits \u2013 return empty list\n  return []", "env_interactions": 4, "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T21:21:02.849391", "function_name": "make_stick", "function_body": "  # Determine action IDs; fallback to default ordering if needed.\n  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      action_ids = [0, 1, 2, 3, 4]  # DOWN, UP, LEFT, RIGHT, USE\n\n  # Resolve the integer index for the target item \"stick\".\n  try:\n      goal_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      goal_idx = env.world.cookbook.index.get(\"stick\")\n  if goal_idx is None:\n      return []\n\n  # Obtain the initial state (use the current state if available).\n  start_state = getattr(env, \"_current_state\", None)\n  if start_state is None:\n      start_state = env.scenario.init()\n\n  # Helper: hashable representation of a state for visited\u2011set tracking.\n  def _state_key(st):\n      # Position, direction, and inventory uniquely identify a deterministic state.\n      return (st.pos, st.dir, st.inventory.tobytes())\n\n  # Bread\u2011first search over deterministic transitions.\n  from collections import deque\n  frontier = deque()\n  frontier.append((start_state, []))\n  visited = {_state_key(start_state)}\n  MAX_PLAN_LEN = 800  # safety bound to avoid infinite search\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      # Goal test: inventory already contains a stick.\n      if cur_state.satisfies(\"\", goal_idx):\n          return cur_plan\n\n      # Prune overly long plans.\n      if len(cur_plan) >= MAX_PLAN_LEN:\n          continue\n\n      # Expand all possible actions.\n      for a in action_ids:\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((next_state, cur_plan + [a]))\n\n  # No plan found within limits \u2013 return empty list.\n  return []", "env_interactions": 4, "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T21:21:14.919568", "function_name": "make_stick", "function_body": "  import collections\n\n  # ----- helper functions -----\n  def _action_ids():\n      \"\"\"Return list of all action IDs available in the environment.\"\"\"\n      try:\n          return list(env.action_specs().values())\n      except Exception:\n          # fallback ordering: DOWN, UP, LEFT, RIGHT, USE\n          return [0, 1, 2, 3, 4]\n\n  def _stick_index():\n      \"\"\"Return the integer index for the primitive/item \\\"stick\\\".\"\"\"\n      try:\n          return env.world.cookbook.index[\"stick\"]\n      except Exception:\n          return env.world.cookbook.index.get(\"stick\")\n\n  def _state_key(state):\n      \"\"\"Compact hashable representation of a CraftState for visited tracking.\"\"\"\n      # Position, direction and inventory uniquely identify reachable states\n      return (state.pos, state.dir, state.inventory.tobytes())\n\n  # ----- initialise search -----\n  actions = _action_ids()\n  stick_idx = _stick_index()\n\n  # starting state: use the lab's current state if already created,\n  # otherwise initialise a fresh one from the scenario.\n  start_state = getattr(env, \"_current_state\", None)\n  if start_state is None:\n      start_state = env.scenario.init()\n\n  # BFS frontier holds tuples (state, plan_so_far)\n  frontier = collections.deque()\n  frontier.append((start_state, []))\n  visited = {_state_key(start_state)}\n\n  MAX_PLAN_LENGTH = 800  # safety limit to prevent infinite search\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      # Goal test: inventory already contains at least one stick\n      if stick_idx is not None and cur_state.satisfies(\"\", stick_idx):\n          return cur_plan\n\n      # Prune overly long plans\n      if len(cur_plan) >= MAX_PLAN_LENGTH:\n          continue\n\n      # Expand all possible actions\n      for a in actions:\n          _, nxt_state = cur_state.step(a)\n          key = _state_key(nxt_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((nxt_state, cur_plan + [a]))\n\n  # No plan found within limits \u2013 return empty list\n  return []", "env_interactions": 4, "island_id": 2, "scores": {"3": 1.5}}
