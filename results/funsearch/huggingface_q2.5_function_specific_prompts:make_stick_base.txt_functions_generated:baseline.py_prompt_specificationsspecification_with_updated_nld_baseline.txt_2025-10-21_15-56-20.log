{"timestamp": "2025-10-21T19:32:13.882987", "function_name": "make_stick", "function_body": "  env.reset()\n  state = env._current_state\n\n  # Goal item index (e.g., stick)\n  goal_idx = env.task.goal\n\n  # Primitive resources required for the goal according to the recipe\n  needed = env.world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n\n  def _move_to(target):\n      \"\"\"Return a list of actions moving the agent to `target` (row, col).\"\"\"\n      nonlocal state\n      actions = []\n      while tuple(state.pos) != tuple(target):\n          r, c = state.pos\n          tr, tc = target\n          if r < tr:\n              act = 0          # DOWN\n          elif r > tr:\n              act = 1          # UP\n          elif c < tc:\n              act = 3          # RIGHT\n          else:\n              act = 2          # LEFT\n          actions.append(act)\n          _, state = env.step(act)   # apply action, update state\n      return actions\n\n  plan = []   # final action list to be returned\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitive items.\n  # ------------------------------------------------------------------\n  for kind_idx, cnt in needed.items():\n      for _ in range(cnt):\n          # Locate any instance of this primitive on the grid.\n          locations = np.argwhere(state.grid[:, :, kind_idx] > 0)\n          if locations.shape[0] == 0:\n              # No more of this primitive on the map \u2013 skip.\n              continue\n          target = tuple(locations[0])\n          # Move to the primitive and pick it up.\n          plan.extend(_move_to(target))\n          plan.append(4)                # USE to collect\n          _, state = env.step(4)\n\n  # ------------------------------------------------------------------\n  # 2. Go to the required workshop (if any) and craft the goal.\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = recipe.get('_at')\n  if workshop_idx is not None:\n      w_locs = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if w_locs.shape[0] > 0:\n          w_target = tuple(w_locs[0])\n          plan.extend(_move_to(w_target))\n          plan.append(4)                # USE to craft at the workshop\n          _, state = env.step(4)\n\n  return plan", "env_interactions": 0, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T19:32:28.367907", "function_name": "make_stick", "function_body": "  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      action_ids = [0, 1, 2, 3, 4]  # default: DOWN, UP, LEFT, RIGHT, USE\n\n  # Locate the index for the target item \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n  if stick_idx is None:\n      return []  # stick not defined in this world\n\n  # Ensure the environment is reset and obtain the current state\n  if not hasattr(env, \"_current_state\") or env._current_state is None:\n      env.reset()\n  start_state = env._current_state\n\n  # Goal already satisfied?\n  if start_state.inventory[stick_idx] > 0:\n      return []\n\n  from collections import deque\n\n  # Helper to uniquely identify a state for the visited set\n  def _state_key(st):\n      return (st.pos, st.dir, st.inventory.tobytes(), st.grid.tobytes())\n\n  visited = {_state_key(start_state)}\n  frontier = deque([(start_state, [])])\n  MAX_PLAN_LEN = 400  # safety bound to keep search tractable\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      # Goal test\n      if cur_state.inventory[stick_idx] > 0:\n          return cur_plan\n\n      if len(cur_plan) >= MAX_PLAN_LEN:\n          continue\n\n      # Expand all possible actions\n      for a in action_ids:\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((next_state, cur_plan + [a]))\n\n  # No plan found within limits\n  return []", "env_interactions": 4, "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T19:32:29.486340", "function_name": "make_stick", "function_body": "  # Retrieve the list of action IDs; fall back to the default ordering if needed.\n  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      # Default ordering used by CraftWorld: DOWN, UP, LEFT, RIGHT, USE\n      action_ids = [0, 1, 2, 3, 4]\n\n  # Locate the index of the target item \"stick\" in the cookbook.\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n  if stick_idx is None:\n      # No stick defined for this world \u2013 nothing to do.\n      return []\n\n  # Make sure the environment has been reset so that `_current_state` is valid.\n  if not hasattr(env, \"_current_state\") or env._current_state is None:\n      env.reset()\n  start_state = env._current_state\n\n  # If we already possess a stick, no actions are required.\n  if start_state.inventory[stick_idx] > 0:\n      return []\n\n  from collections import deque\n\n  # Helper to create a hashable representation of a state for the visited set.\n  def _state_key(st):\n      # Position, direction, inventory contents, and grid layout uniquely identify a state.\n      return (st.pos, st.dir, st.inventory.tobytes(), st.grid.tobytes())\n\n  visited = {_state_key(start_state)}\n  frontier = deque()\n  frontier.append((start_state, []))\n\n  # Upper bound on plan length to keep the search tractable.\n  MAX_PLAN_LEN = 500\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      # Goal test: have at least one stick in inventory.\n      if cur_state.inventory[stick_idx] > 0:\n          return cur_plan\n\n      if len(cur_plan) >= MAX_PLAN_LEN:\n          continue\n\n      # Expand all possible actions.\n      for a in action_ids:\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((next_state, cur_plan + [a]))\n\n  # If no plan found within the limits, return an empty list.\n  return []", "env_interactions": 4, "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T19:32:52.644444", "function_name": "make_stick", "function_body": "  import numpy as np\n\n  # Reset environment to start a fresh episode\n  env.reset()\n  # Get world and recipe information\n  world = env.world\n  # Index of the target item (stick)\n  stick_idx = world.cookbook.index.index('stick')\n  # Primitive requirements for one stick\n  needed_prims = world.cookbook.primitives_for(stick_idx).copy()\n\n  # Action name \u2192 integer mapping\n  action_map = env.action_specs()\n  # Inverse mapping for convenience (optional)\n  # name_from_idx = {v: k for k, v in action_map.items()}\n\n  actions = []\n  max_steps = 500  # safety cap\n\n  for _ in range(max_steps):\n      state = env._current_state\n\n      # Goal reached?\n      if state.satisfies('stick', stick_idx):\n          break\n\n      inventory = state.inventory\n\n      # Determine which primitive we still need\n      target_prim = None\n      for prim_idx, req_cnt in needed_prims.items():\n          if inventory[prim_idx] < req_cnt:\n              target_prim = prim_idx\n              break\n\n      # If we have all required primitives, try to craft (USE)\n      if target_prim is None:\n          act = action_map['USE']\n          actions.append(act)\n          env.step(act)\n          continue\n\n      # If we are adjacent to the needed primitive, collect it\n      if state.next_to(target_prim):\n          act = action_map['USE']\n          actions.append(act)\n          env.step(act)\n          continue\n\n      # Otherwise, move towards the nearest cell that contains the primitive\n      grid_layer = state.grid[:, :, target_prim]\n      positions = np.argwhere(grid_layer > 0)\n\n      if positions.size == 0:\n          # Primitive not present on the map \u2013 wander randomly\n          act = np.random.choice(list(action_map.values()))\n          actions.append(act)\n          env.step(act)\n          continue\n\n      # Find the closest instance (Manhattan distance)\n      cur_pos = np.array(state.pos)\n      dists = np.abs(positions - cur_pos).sum(axis=1)\n      nearest = positions[dists.argmin()]\n\n      dy = int(nearest[0] - cur_pos[0])\n      dx = int(nearest[1] - cur_pos[1])\n\n      # Choose a movement that reduces the Manhattan distance\n      if abs(dy) >= abs(dx):\n          if dy > 0:\n              act = action_map['DOWN']\n          else:\n              act = action_map['UP']\n      else:\n          if dx > 0:\n              act = action_map['RIGHT']\n          else:\n              act = action_map['LEFT']\n\n      actions.append(act)\n      env.step(act)\n\n  return actions", "env_interactions": 0, "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-10-21T19:37:52.670529", "function_name": "make_stick", "function_body": "  # Helper constants for actions\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ----------------------------------------------------------------------\n  # Utility functions (local to this function)\n  # ----------------------------------------------------------------------\n  def get_obs():\n      \"\"\"Return the latest observation dict.\"\"\"\n      return env.observations()\n\n  def get_features():\n      \"\"\"Convenient shortcut to the features_dict inside an observation.\"\"\"\n      return get_obs()[\"features_dict\"]\n\n  def get_grid():\n      \"\"\"Full allocentric one\u2011hot grid (WIDTH, HEIGHT, n_kinds).\"\"\"\n      return get_features()[\"features_global\"]\n\n  def get_inventory():\n      \"\"\"Current inventory vector (length = n_kinds).\"\"\"\n      return get_features()[\"inventory\"]\n\n  def get_pos():\n      \"\"\"Return integer (x, y) position of the agent.\"\"\"\n      pos_norm = get_features()[\"pos\"]          # normalized [0,1]\n      grid_shape = get_grid().shape[:2]         # (WIDTH, HEIGHT)\n      x = int(round(pos_norm[0] * (grid_shape[0] - 1)))\n      y = int(round(pos_norm[1] * (grid_shape[1] - 1)))\n      return (x, y)\n\n  def manhattan(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def move_towards(target):\n      \"\"\"Yield actions that move the agent one step closer to target.\"\"\"\n      while True:\n          cur = get_pos()\n          if cur == target:\n              break\n          dx = target[0] - cur[0]\n          dy = target[1] - cur[1]\n          if dx > 0:\n              act = RIGHT\n          elif dx < 0:\n              act = LEFT\n          elif dy > 0:\n              act = DOWN\n          else:\n              act = UP\n          actions.append(act)\n          env.step(act)\n\n  def find_all(kind_idx):\n      \"\"\"Return list of (x, y) where grid has the given kind.\"\"\"\n      g = get_grid()\n      pts = np.argwhere(g[:, :, kind_idx] > 0)\n      return [tuple(p) for p in pts]\n\n  def nearest(kind_idx, from_pos):\n      \"\"\"Find the nearest cell containing *kind_idx* from *from_pos*.\"\"\"\n      candidates = find_all(kind_idx)\n      if not candidates:\n          return None\n      return min(candidates, key=lambda p: manhattan(p, from_pos))\n\n  # ----------------------------------------------------------------------\n  # Access world data (cookbook, indices, recipes)\n  # ----------------------------------------------------------------------\n  world = env.world                     # CraftWorld instance\n  cookbook = world.cookbook\n  idx = cookbook.index                  # Index object mapping names->ids\n  stick_idx = idx[\"stick\"]              # target item index\n\n  # Recipe for stick (may be empty if stick is primitive)\n  stick_recipe = cookbook.recipes.get(stick_idx, {})\n\n  # ----------------------------------------------------------------------\n  # Main planning loop\n  # ----------------------------------------------------------------------\n  actions = []\n  max_total_steps = 2000   # safety guard\n\n  # Reset environment to a fresh start\n  env.reset()\n\n  while len(actions) < max_total_steps:\n      inv = get_inventory()\n      # Goal reached?\n      if inv[stick_idx] > 0:\n          break\n\n      # ------------------------------------------------------------------\n      # 1) Do we already have all ingredients for the stick?\n      # ------------------------------------------------------------------\n      need_ingredients = {}\n      for ing_idx, cnt in stick_recipe.items():\n          if ing_idx == \"_at\":\n              continue\n          have = inv[ing_idx]\n          if have < cnt:\n              need_ingredients[ing_idx] = cnt - have\n\n      if not need_ingredients:\n          # --------------------------------------------------------------\n          # All ingredients are present \u2192 go to workshop and craft.\n          # --------------------------------------------------------------\n          workshop_idx = stick_recipe.get(\"_at\", None)\n          if workshop_idx is None:\n              # No workshop needed (stick is primitive). Should never happen.\n              break\n          cur_pos = get_pos()\n          wp_pos = nearest(workshop_idx, cur_pos)\n          if wp_pos is None:\n              # No workshop found \u2013 abort.\n              break\n          # Move to workshop\n          move_towards(wp_pos)\n          # Use (craft)\n          actions.append(USE)\n          env.step(USE)\n          continue\n\n      # ------------------------------------------------------------------\n      # 2) Collect missing primitive(s)\n      # ------------------------------------------------------------------\n      # Choose any needed ingredient (preferring primitives)\n      # In CraftWorld, all recipe inputs are primitives (no sub\u2011crafting\n      # needed for the simple \"stick\" recipe). If sub\u2011crafting were needed,\n      # a recursive planner would be required.\n      missing_kind = next(iter(need_ingredients))\n      cur_pos = get_pos()\n      src_pos = nearest(missing_kind, cur_pos)\n      if src_pos is None:\n          # Primitive not present on map \u2013 cannot solve.\n          break\n      # Move to the primitive cell\n      move_towards(src_pos)\n      # Pick it up\n      actions.append(USE)\n      env.step(USE)\n\n  # Return the accumulated action list\n  return actions", "env_interactions": 0, "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-10-21T19:43:15.969796", "function_name": "make_stick", "function_body": "  # Reset environment and obtain initial state.\n  env.reset()\n  state = env._current_state  # type: CraftState\n\n  # ------------------------------------------------------------------\n  # Action / direction utilities.\n  # ------------------------------------------------------------------\n  act_spec = env.action_specs()\n  ACTION_USE = act_spec[\"USE\"]\n  ACTIONS_MOVE = {\n      \"UP\": act_spec[\"UP\"],\n      \"DOWN\": act_spec[\"DOWN\"],\n      \"LEFT\": act_spec[\"LEFT\"],\n      \"RIGHT\": act_spec[\"RIGHT\"],\n  }\n  DIR_VECT = {\n      \"UP\": (-1, 0),\n      \"DOWN\": (1, 0),\n      \"LEFT\": (0, -1),\n      \"RIGHT\": (0, 1),\n  }\n\n  # ------------------------------------------------------------------\n  # Helper: check if a cell is empty (i.e., walkable).\n  # ------------------------------------------------------------------\n  def is_empty(pos):\n      x, y = pos\n      return not state.grid[x, y].any()\n\n  # ------------------------------------------------------------------\n  # BFS that returns a list of movement actions that brings the agent\n  # from ``start`` to the nearest cell in ``targets`` (targets must be\n  # walkable cells).  Returns None if no target is reachable.\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  def bfs_path(start, targets):\n      h, w = state.grid.shape[:2]\n      visited = set()\n      q = deque([(start, [])])\n\n      while q:\n          pos, path = q.popleft()\n          if pos in visited:\n              continue\n          visited.add(pos)\n\n          if pos in targets:\n              return path\n\n          x, y = pos\n          for name, (dx, dy) in DIR_VECT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < h and 0 <= ny < w and is_empty((nx, ny)):\n                  q.append(((nx, ny), path + [ACTIONS_MOVE[name]]))\n      return None\n\n  # ------------------------------------------------------------------\n  # Identify the index of \u201cstick\u201d and its primitive requirements.\n  # ------------------------------------------------------------------\n  idx = state.world.cookbook.index\n  stick_idx = idx.index(\"stick\")\n  primitive_needs = state.world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive.\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      while state.inventory[prim_idx] < needed_cnt:\n          # Locate all primitive instances currently on the map.\n          h, w = state.grid.shape[:2]\n          prim_positions = [\n              (i, j)\n              for i in range(h)\n              for j in range(w)\n              if state.grid[i, j, prim_idx] > 0\n          ]\n          if not prim_positions:\n              # No more primitives left \u2013 break out (should not happen on valid maps).\n              break\n\n          # Build a set of walkable cells that are directly facing a primitive.\n          target_cells = set()\n          # Mapping from target cell to the direction we must be facing (implicit via last move).\n          for (px, py) in prim_positions:\n              for dir_name, (dx, dy) in DIR_VECT.items():\n                  adj_x, adj_y = px - dx, py - dy  # cell from which we can look at the primitive\n                  if 0 <= adj_x < h and 0 <= adj_y < w and is_empty((adj_x, adj_y)):\n                      target_cells.add((adj_x, adj_y))\n\n          # Find shortest path to any such cell.\n          path = bfs_path(state.pos, target_cells)\n          if path is None:\n              # No reachable primitive \u2013 abort.\n              break\n\n          # Execute movement actions.\n          for a in path:\n              _, state = state.step(a)\n              actions.append(a)\n\n          # At this point we are on a cell that faces the primitive.\n          _, state = state.step(ACTION_USE)\n          actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # If a workshop is required for the recipe, go there and craft.\n  # ------------------------------------------------------------------\n  recipe_dict = state.world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe_dict.get(\"_at\") if isinstance(recipe_dict, dict) else None\n\n  if workshop_name:\n      workshop_idx = idx.index(workshop_name)\n\n      # Locate all workshop cells.\n      h, w = state.grid.shape[:2]\n      workshop_cells = [\n          (i, j) for i in range(h) for j in range(w) if state.grid[i, j, workshop_idx] > 0\n      ]\n      if workshop_cells:\n          # Determine walkable cells that can face a workshop.\n          workshop_targets = set()\n          for (wx, wy) in workshop_cells:\n              for dir_name, (dx, dy) in DIR_VECT.items():\n                  adj_x, adj_y = wx - dx, wy - dy\n                  if 0 <= adj_x < h and 0 <= adj_y < w and is_empty((adj_x, adj_y)):\n                      workshop_targets.add((adj_x, adj_y))\n\n          path = bfs_path(state.pos, workshop_targets)\n          if path:\n              for a in path:\n                  _, state = state.step(a)\n                  actions.append(a)\n\n              # Craft at the workshop.\n              _, state = state.step(ACTION_USE)\n              actions.append(ACTION_USE)\n\n  # Return the complete sequence of actions.\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-10-21T19:43:17.284915", "function_name": "make_stick", "function_body": "  env.reset()\n  state = env._current_state  # current CraftState\n\n  # ------------------------------------------------------------------\n  # Action utilities\n  # ------------------------------------------------------------------\n  act_spec = env.action_specs()\n  ACTION_USE = act_spec[\"USE\"]\n  ACTIONS_MOVE = {k: act_spec[k] for k in (\"UP\", \"DOWN\", \"LEFT\", \"RIGHT\")}\n  DIR_VECT = {\"UP\": (-1, 0), \"DOWN\": (1, 0), \"LEFT\": (0, -1), \"RIGHT\": (0, 1)}\n\n  from collections import deque\n\n  # BFS returning a list of movement actions that brings the agent to the\n  # nearest reachable cell contained in ``targets``.\n  def bfs_path(start, targets):\n      h, w = state.grid.shape[:2]\n      visited = set()\n      q = deque([(start, [])])\n      while q:\n          pos, path = q.popleft()\n          if pos in visited:\n              continue\n          visited.add(pos)\n          if pos in targets:\n              return path\n          x, y = pos\n          for name, (dx, dy) in DIR_VECT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < h and 0 <= ny < w:\n                  # walkable if the cell is completely empty\n                  if not state.grid[nx, ny].any():\n                      q.append(((nx, ny), path + [ACTIONS_MOVE[name]]))\n      return None\n\n  # ------------------------------------------------------------------\n  # Identify the stick item and its primitive requirements.\n  # ------------------------------------------------------------------\n  idx = state.world.cookbook.index\n  stick_idx = idx.index(\"stick\")\n  primitive_needs = state.world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive.\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      while state.inventory[prim_idx] < needed_cnt:\n          h, w = state.grid.shape[:2]\n          prim_locs = [\n              (i, j)\n              for i in range(h)\n              for j in range(w)\n              if state.grid[i, j, prim_idx] > 0\n          ]\n          if not prim_locs:\n              break  # nothing left on map\n\n          path = bfs_path(state.pos, set(prim_locs))\n          if path is None:\n              break  # unreachable\n\n          for a in path:\n              _, state = state.step(a)\n              actions.append(a)\n\n          # pick up the primitive (USE on the cell directly ahead)\n          _, state = state.step(ACTION_USE)\n          actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # If the recipe requires a workshop, go there and craft the stick.\n  # ------------------------------------------------------------------\n  recipe = state.world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\") if isinstance(recipe, dict) else None\n  if workshop_name:\n      workshop_idx = idx.index(workshop_name)\n      h, w = state.grid.shape[:2]\n      workshop_cells = [\n          (i, j)\n          for i in range(h)\n          for j in range(w)\n          if state.grid[i, j, workshop_idx] > 0\n      ]\n      if workshop_cells:\n          path = bfs_path(state.pos, set(workshop_cells))\n          if path:\n              for a in path:\n                  _, state = state.step(a)\n                  actions.append(a)\n              _, state = state.step(ACTION_USE)\n              actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # Return the full action sequence.\n  # ------------------------------------------------------------------\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": 0.0}}
