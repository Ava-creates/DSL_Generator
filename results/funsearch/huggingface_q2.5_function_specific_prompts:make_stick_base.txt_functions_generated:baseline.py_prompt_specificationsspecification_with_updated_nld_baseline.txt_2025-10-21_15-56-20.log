{"timestamp": "2025-10-21T20:37:51.600270", "function_name": "make_stick", "function_body": "  env.reset()\n  world = env.world\n  scenario = env.scenario\n  grid = scenario.init_grid.copy()\n  goal_idx = env.task.goal\n  primitive_needs = world.cookbook.primitives_for(goal_idx)\n  pos = list(scenario.init_pos)\n  actions = []\n\n  def _move_to(target):\n      nonlocal pos, actions\n      while pos[0] < target[0]:\n          actions.append(3)  # RIGHT\n          pos[0] += 1\n      while pos[0] > target[0]:\n          actions.append(2)  # LEFT\n          pos[0] -= 1\n      while pos[1] < target[1]:\n          actions.append(0)  # DOWN\n          pos[1] += 1\n      while pos[1] > target[1]:\n          actions.append(1)  # UP\n          pos[1] -= 1\n\n  for kind_idx, needed_cnt in primitive_needs.items():\n      locations = np.argwhere(grid[:, :, kind_idx] == 1)\n      for _ in range(needed_cnt):\n          if locations.shape[0] == 0:\n              break\n          dists = np.sum(np.abs(locations - pos), axis=1)\n          nearest_idx = int(np.argmin(dists))\n          target_cell = locations[nearest_idx].tolist()\n          _move_to(target_cell)\n          actions.append(4)  # USE to pick up\n          grid[target_cell[0], target_cell[1], kind_idx] = 0\n          locations = np.delete(locations, nearest_idx, axis=0)\n\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get('_at')\n  if workshop_kind is not None:\n      workshop_cells = np.argwhere(grid[:, :, workshop_kind] == 1)\n      if workshop_cells.shape[0] > 0:\n          dists = np.sum(np.abs(workshop_cells - pos), axis=1)\n          nearest_ws = int(np.argmin(dists))\n          ws_target = workshop_cells[nearest_ws].tolist()\n          _move_to(ws_target)\n          actions.append(4)  # USE to craft\n\n  return actions", "env_interactions": 0, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T20:37:52.704439", "function_name": "make_stick", "function_body": "  # Reset environment to start a fresh episode.\n  env.reset()\n\n  # Shortcut references.\n  world = env.world\n  scenario = env.scenario\n  grid = scenario.init_grid.copy()          # mutable copy of the world layout\n  pos = list(scenario.init_pos)              # current agent position [x, y]\n\n  # Goal item index (the stick we want to obtain).\n  goal_idx = env.task.goal\n\n  # Primitive requirements for the goal (kind \u2192 count). Empty if no recipe.\n  primitive_needs = world.cookbook.primitives_for(goal_idx)\n\n  actions = []   # list of action indices to be returned\n\n  # ------------------------------------------------------------------\n  # Helper: move from current position to target cell using Manhattan moves.\n  # ------------------------------------------------------------------\n  def _move_to(target):\n      nonlocal pos, actions\n      # Horizontal moves (x axis).\n      while pos[0] < target[0]:\n          actions.append(3)   # RIGHT\n          pos[0] += 1\n      while pos[0] > target[0]:\n          actions.append(2)   # LEFT\n          pos[0] -= 1\n      # Vertical moves (y axis).\n      while pos[1] < target[1]:\n          actions.append(0)   # DOWN\n          pos[1] += 1\n      while pos[1] > target[1]:\n          actions.append(1)   # UP\n          pos[1] -= 1\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitive resources.\n  # ------------------------------------------------------------------\n  for kind_idx, needed_cnt in primitive_needs.items():\n      # Find all cells currently containing this primitive.\n      locations = np.argwhere(grid[:, :, kind_idx] == 1)\n\n      for _ in range(needed_cnt):\n          if locations.shape[0] == 0:\n              # No more instances left; break (environment should guarantee enough).\n              break\n\n          # Choose the nearest instance to minimise travel.\n          dists = np.sum(np.abs(locations - pos), axis=1)\n          nearest = int(np.argmin(dists))\n          target = locations[nearest].tolist()\n\n          # Travel to the primitive and pick it up.\n          _move_to(target)\n          actions.append(4)   # USE (pick up)\n\n          # Update internal grid copy so we don't revisit the same cell.\n          grid[target[0], target[1], kind_idx] = 0\n          locations = np.delete(locations, nearest, axis=0)\n\n  # ------------------------------------------------------------------\n  # 2) If the recipe requires a specific workshop, go there and craft.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get('_at')\n  if workshop_kind is not None:\n      # Locate all workshop cells of the required type.\n      ws_cells = np.argwhere(grid[:, :, workshop_kind] == 1)\n      if ws_cells.shape[0] > 0:\n          dists = np.sum(np.abs(ws_cells - pos), axis=1)\n          nearest_ws = int(np.argmin(dists))\n          ws_target = ws_cells[nearest_ws].tolist()\n          _move_to(ws_target)\n          actions.append(4)   # USE (craft at workshop)\n\n  # Return the planned sequence of actions.\n  return actions", "env_interactions": 0, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T20:38:20.684576", "function_name": "make_stick", "function_body": "  ACTION = env.action_specs()\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  # ----------------------------------------------------------------------\n  # Helper functions\n  # ----------------------------------------------------------------------\n  def locate_nearest(pos, kind, grid):\n      \"\"\"Return (x, y) of the closest cell containing `kind`.\"\"\"\n      layer = grid[:, :, kind]\n      ys, xs = np.where(layer > 0)\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - pos[0]) + np.abs(ys - pos[1])\n      i = int(np.argmin(dists))\n      return (int(xs[i]), int(ys[i]))\n\n  from collections import deque\n\n  def bfs(start, goal, grid):\n      \"\"\"Shortest Manhattan path from start to goal avoiding occupied cells.\"\"\"\n      if start == goal:\n          return [start]\n      W, H, _ = grid.shape\n      visited = np.zeros((W, H), dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start[0], start[1]] = True\n\n      while q:\n          x, y = q.popleft()\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < W and 0 <= ny < H):\n                  continue\n              if visited[nx, ny]:\n                  continue\n              # allow stepping onto the goal even if it is occupied\n              if (nx, ny) != goal and grid[nx, ny].any():\n                  continue\n              visited[nx, ny] = True\n              prev[(nx, ny)] = (x, y)\n              if (nx, ny) == goal:\n                  # reconstruct path\n                  path = [(nx, ny)]\n                  while path[-1] != start:\n                      path.append(prev[path[-1]])\n                  path.reverse()\n                  return path\n              q.append((nx, ny))\n      return None\n\n  def actions_from_path(path):\n      \"\"\"Translate a list of coordinates into a list of action indices.\"\"\"\n      seq = []\n      for (x0, y0), (x1, y1) in zip(path, path[1:]):\n          if x1 > x0:\n              seq.append(ACTION[\"RIGHT\"])\n          elif x1 < x0:\n              seq.append(ACTION[\"LEFT\"])\n          elif y1 > y0:\n              seq.append(ACTION[\"DOWN\"])\n          elif y1 < y0:\n              seq.append(ACTION[\"UP\"])\n      return seq\n\n  # ----------------------------------------------------------------------\n  # Determine what we need to craft a stick\n  # ----------------------------------------------------------------------\n  stick_idx = idx[\"stick\"]\n  needed = world.cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n  plan = []\n  cur_pos = state.pos\n  grid = state.grid.copy()   # simulate removals after pickups\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive\n  # ----------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          target = locate_nearest(cur_pos, prim_idx, grid)\n          if target is None:\n              # primitive missing \u2013 cannot finish the task\n              return []\n          path = bfs(cur_pos, target, grid)\n          if path is None:\n              return []   # unreachable\n          plan.extend(actions_from_path(path))\n          plan.append(ACTION[\"USE\"])          # pick up the primitive\n          # simulate removal of the primitive from the world\n          grid[target[0], target[1], prim_idx] = 0\n          cur_pos = target\n\n  # ----------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the stick\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      wk_idx = idx[workshop_name] if isinstance(workshop_name, str) else workshop_name\n      wk_pos = locate_nearest(cur_pos, wk_idx, grid)\n      if wk_pos is not None:\n          path = bfs(cur_pos, wk_pos, grid)\n          if path is not None:\n              plan.extend(actions_from_path(path))\n              cur_pos = wk_pos\n\n  # Final USE to actually craft the stick\n  plan.append(ACTION[\"USE\"])\n  return plan", "env_interactions": 4, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T20:38:21.809126", "function_name": "make_stick", "function_body": "  import numpy as np\n  from collections import deque\n\n  ACTION = env.action_specs()\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  def find_nearest(pos, kind, grid):\n      \"\"\"Return coordinates of the closest cell containing `kind`.\"\"\"\n      layer = grid[:, :, kind]\n      ys, xs = np.where(layer > 0)\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - pos[0]) + np.abs(ys - pos[1])\n      i = int(np.argmin(dists))\n      return (int(xs[i]), int(ys[i]))\n\n  def bfs_path(start, goal, grid):\n      \"\"\"Shortest Manhattan path avoiding occupied cells (except the goal).\"\"\"\n      if start == goal:\n          return [start]\n      W, H, _ = grid.shape\n      visited = np.full((W, H), False, dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start[0], start[1]] = True\n\n      while q:\n          x, y = q.popleft()\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < W and 0 <= ny < H):\n                  continue\n              if visited[nx, ny]:\n                  continue\n              # allow stepping onto the goal even if occupied\n              if (nx, ny) != goal and grid[nx, ny].any():\n                  continue\n              visited[nx, ny] = True\n              prev[(nx, ny)] = (x, y)\n              if (nx, ny) == goal:\n                  # reconstruct path\n                  path = [(nx, ny)]\n                  while path[-1] != start:\n                      path.append(prev[path[-1]])\n                  path.reverse()\n                  return path\n              q.append((nx, ny))\n      return None\n\n  def actions_from_path(path):\n      \"\"\"Translate a list of positions into environment action indices.\"\"\"\n      seq = []\n      for (x0, y0), (x1, y1) in zip(path, path[1:]):\n          if x1 > x0:\n              seq.append(ACTION[\"RIGHT\"])\n          elif x1 < x0:\n              seq.append(ACTION[\"LEFT\"])\n          elif y1 > y0:\n              seq.append(ACTION[\"DOWN\"])\n          elif y1 < y0:\n              seq.append(ACTION[\"UP\"])\n      return seq\n\n  # ----------------------------------------------------------------------\n  # Determine the primitives required for a stick\n  # ----------------------------------------------------------------------\n  stick_idx = idx[\"stick\"]\n  needed = world.cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n\n  # Working copy of the grid to simulate pickups\n  grid = state.grid.copy()\n  plan = []\n  cur_pos = state.pos\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive\n  # ----------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = find_nearest(cur_pos, prim_idx, grid)\n          if target is None:\n              # Primitive not present \u2013 cannot finish the task\n              return []\n          path = bfs_path(cur_pos, target, grid)\n          if path is None:\n              return []   # unreachable\n          plan.extend(actions_from_path(path))\n          plan.append(ACTION[\"USE\"])          # pick up the primitive\n          # Simulate removal of the primitive from the world\n          grid[target[0], target[1], prim_idx] = 0\n          cur_pos = target\n\n  # ----------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the stick\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      wk_idx = idx[workshop_name] if isinstance(workshop_name, str) else workshop_name\n      wk_pos = find_nearest(cur_pos, wk_idx, grid)\n      if wk_pos is not None:\n          path = bfs_path(cur_pos, wk_pos, grid)\n          if path is not None:\n              plan.extend(actions_from_path(path))\n              cur_pos = wk_pos\n\n  # Final USE to actually craft the stick\n  plan.append(ACTION[\"USE\"])\n  return plan", "env_interactions": 4, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T20:38:38.825403", "function_name": "make_stick", "function_body": "  from collections import deque\n\n  # ----- helper functions -----\n  def _action_ids():\n      try:\n          spec = env.action_specs()\n          return list(spec.values())\n      except Exception:\n          # default ordering: DOWN, UP, LEFT, RIGHT, USE\n          return [0, 1, 2, 3, 4]\n\n  def _goal_idx():\n      try:\n          return env.world.cookbook.index[\"stick\"]\n      except Exception:\n          # fallback: try lower\u2011case key\n          return env.world.cookbook.index.get(\"stick\")\n\n  def _is_goal(state, idx):\n      return idx is not None and state.satisfies(\"\", idx)\n\n  def _state_key(state):\n      # position, direction, and raw inventory bytes\n      return (state.pos, state.dir, state.inventory.tobytes())\n\n  # ----- initialise -----\n  actions = _action_ids()\n  goal = _goal_idx()\n  start_state = getattr(env, \"_current_state\", None)\n  if start_state is None:\n      # If the lab does not expose a current state, initialise from the scenario\n      start_state = env.scenario.init()\n\n  # ----- breadth\u2011first search -----\n  frontier = deque()\n  frontier.append((start_state, []))\n  visited = {_state_key(start_state)}\n  MAX_STEPS = 400  # safety bound to avoid infinite search\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      if _is_goal(cur_state, goal):\n          return cur_plan\n\n      if len(cur_plan) >= MAX_STEPS:\n          continue\n\n      for a in actions:\n          _, nxt_state = cur_state.step(a)\n          key = _state_key(nxt_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((nxt_state, cur_plan + [a]))\n\n  # No plan found within limits\n  return []", "env_interactions": 4, "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T20:38:39.938314", "function_name": "make_stick", "function_body": "  from collections import deque\n\n  # ----- helpers -----\n  def _action_ids():\n      \"\"\"Return a list of action IDs from the environment.\"\"\"\n      try:\n          spec = env.action_specs()\n          return list(spec.values())\n      except Exception:\n          # default ordering: DOWN, UP, LEFT, RIGHT, USE\n          return [0, 1, 2, 3, 4]\n\n  def _goal_index():\n      \"\"\"Return the integer index of the item \\\"stick\\\".\"\"\"\n      try:\n          return env.world.cookbook.index[\"stick\"]\n      except Exception:\n          return env.world.cookbook.index.get(\"stick\")\n\n  def _state_key(st):\n      \"\"\"Compact hashable representation of a state for the visited set.\"\"\"\n      return (st.pos, st.dir, st.inventory.tobytes())\n\n  # ----- main planning -----\n  goal_idx = _goal_index()\n  if goal_idx is None:\n      return []\n\n  # starting state: use the lab's current state if available,\n  # otherwise initialise a fresh one from the scenario.\n  start_state = getattr(env, \"_current_state\", None)\n  if start_state is None:\n      start_state = env.scenario.init()\n\n  # quick exit if the goal is already satisfied\n  if start_state.satisfies(\"\", goal_idx):\n      return []\n\n  action_ids = _action_ids()\n  # put USE (typically index 4) first to favour interaction actions\n  if 4 in action_ids:\n      action_ids.remove(4)\n      action_ids = [4] + action_ids\n\n  frontier = deque()\n  frontier.append((start_state, []))\n  visited = {_state_key(start_state)}\n\n  max_steps = 300  # safety bound to avoid endless search\n\n  while frontier:\n      cur_state, cur_actions = frontier.popleft()\n\n      if cur_state.satisfies(\"\", goal_idx):\n          return cur_actions\n\n      if len(cur_actions) >= max_steps:\n          continue\n\n      for a in action_ids:\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((next_state, cur_actions + [a]))\n\n  # No plan found within the limits.\n  return []", "env_interactions": 4, "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T20:39:04.329223", "function_name": "make_stick", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # -------------------------------------------------------------------------\n  # Basic references\n  # -------------------------------------------------------------------------\n  state = env._current_state          # current CraftState\n  world = env.world                    # CraftWorld instance\n  goal_idx = env.task.goal             # integer index of the desired item\n\n  # grid dimensions\n  H, W = state.grid.shape[0], state.grid.shape[1]\n\n  # mutable agent position\n  pos = tuple(state.pos)\n\n  actions = []                         # will hold the final action sequence\n\n  # map a movement delta to the corresponding action index\n  delta_to_action = {\n      (1, 0): RIGHT,\n      (-1, 0): LEFT,\n      (0, 1): DOWN,\n      (0, -1): UP,\n  }\n\n  # -------------------------------------------------------------------------\n  # Helper utilities\n  # -------------------------------------------------------------------------\n  def is_walkable(x, y):\n      \"\"\"A cell is walkable if it lies inside the map and contains no entities.\"\"\"\n      return 0 <= x < H and 0 <= y < W and state.grid[x, y].sum() == 0\n\n  def neighbours(x, y):\n      \"\"\"Yield walkable neighbour coordinates.\"\"\"\n      for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n          nx, ny = x + dx, y + dy\n          if is_walkable(nx, ny):\n              yield (nx, ny)\n\n  def bfs(start, goals):\n      \"\"\"\n      Bread\u2011first search from `start` to the nearest cell in `goals`.\n      Returns a list of positions (excluding `start`, including the goal)\n      describing the path, or an empty list if no path exists.\n      \"\"\"\n      from collections import deque\n      q = deque([start])\n      came_from = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur in goals:\n              # reconstruct path\n              path = []\n              while cur != start:\n                  path.append(cur)\n                  cur = came_from[cur]\n              path.reverse()\n              return path\n          for nb in neighbours(*cur):\n              if nb not in came_from:\n                  came_from[nb] = cur\n                  q.append(nb)\n      return []   # no path found\n\n  def move_along(path):\n      \"\"\"Convert a list of positions into actions and update `pos`.\"\"\"\n      nonlocal pos, actions\n      for nxt in path:\n          dx = nxt[0] - pos[0]\n          dy = nxt[1] - pos[1]\n          act = delta_to_action[(dx, dy)]\n          actions.append(act)\n          pos = nxt\n\n  def move_to_adjacent(target_cells):\n      \"\"\"\n      Given world coordinates of one or more target cells (e.g. a primitive or a\n      workshop), move to a walkable cell adjacent to the *nearest* target.\n      Returns the exact target cell we end up adjacent to (or None if unreachable).\n      \"\"\"\n      # all walkable cells that are directly next to any target cell\n      adj_set = set()\n      target_lookup = {}\n      for tx, ty in target_cells:\n          for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              ax, ay = tx + dx, ty + dy\n              if is_walkable(ax, ay):\n                  adj_set.add((ax, ay))\n                  target_lookup[(ax, ay)] = (tx, ty)\n      if not adj_set:\n          return None\n      path = bfs(pos, adj_set)\n      if not path:\n          return None\n      move_along(path)\n      # after moving, `pos` is an adjacent cell\n      return target_lookup[pos]\n\n  def collect_primitive(kind_idx, count):\n      \"\"\"Collect `count` units of the primitive identified by `kind_idx`.\"\"\"\n      for _ in range(count):\n          # locate all cells that currently contain the primitive\n          prim_cells = np.argwhere(state.grid[:, :, kind_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(\"Required primitive not present on the map\")\n          # choose the closest primitive (Manhattan distance heuristic)\n          dists = np.abs(prim_cells[:, 0] - pos[0]) + np.abs(prim_cells[:, 1] - pos[1])\n          target = prim_cells[dists.argmin()]\n          target_coord = tuple(target)\n          # move adjacent to it and use\n          adj_target = move_to_adjacent([target_coord])\n          if adj_target is None:\n              raise RuntimeError(\"Cannot reach required primitive\")\n          actions.append(USE)\n          # update our internal copy of the grid: the primitive disappears after pickup\n          state.grid[target[0], target[1], kind_idx] = 0\n\n  # -------------------------------------------------------------------------\n  # 1. Gather all primitives required for the goal\n  # -------------------------------------------------------------------------\n  primitives_needed = world.cookbook.primitives_for(goal_idx)\n  for kind_idx, needed_cnt in primitives_needed.items():\n      collect_primitive(kind_idx, needed_cnt)\n\n  # -------------------------------------------------------------------------\n  # 2. Go to the appropriate workshop (if any) and craft the item\n  # -------------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          raise RuntimeError(\"Required workshop not found in the world\")\n      # move adjacent to the first workshop cell we encounter\n      move_to_adjacent([tuple(workshop_cells[0])])\n      actions.append(USE)   # perform the crafting action\n\n  # Return the complete action list\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T20:39:05.445827", "function_name": "make_stick", "function_body": "  # -------------------------------------------------------------------------\n  # Setup\n  # -------------------------------------------------------------------------\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  state = env._current_state          # current CraftState\n  world = env.world                    # CraftWorld instance\n  goal_idx = env.task.goal             # integer index of the desired item\n  grid = state.grid.copy()             # mutable copy of the grid\n  H, W = grid.shape[0], grid.shape[1]\n\n  # mutable agent position (starts at the state's position)\n  pos = tuple(state.pos)\n\n  # -------------------------------------------------------------------------\n  # Helper utilities\n  # -------------------------------------------------------------------------\n  delta_to_action = {\n      (1, 0): RIGHT,\n      (-1, 0): LEFT,\n      (0, 1): DOWN,\n      (0, -1): UP,\n  }\n\n  def is_walkable(x, y):\n      \"\"\"Cell is walkable if inside bounds and contains no entities.\"\"\"\n      return 0 <= x < H and 0 <= y < W and grid[x, y].sum() == 0\n\n  def neighbours(x, y):\n      \"\"\"Yield walkable neighbour coordinates.\"\"\"\n      for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n          nx, ny = x + dx, y + dy\n          if is_walkable(nx, ny):\n              yield (nx, ny)\n\n  def bfs(start, goals):\n      \"\"\"Bread\u2011first search from start to any cell in *goals*.\"\"\"\n      from collections import deque\n      q = deque([start])\n      came_from = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur in goals:\n              # reconstruct path (excluding start, including goal)\n              path = []\n              while cur != start:\n                  path.append(cur)\n                  cur = came_from[cur]\n              path.reverse()\n              return path\n          for nb in neighbours(*cur):\n              if nb not in came_from:\n                  came_from[nb] = cur\n                  q.append(nb)\n      return []  # not reachable\n\n  def move_along(path, actions):\n      \"\"\"Convert a list of positions into actions and update *pos*.\"\"\"\n      nonlocal pos\n      for nxt in path:\n          dx = nxt[0] - pos[0]\n          dy = nxt[1] - pos[1]\n          act = delta_to_action[(dx, dy)]\n          actions.append(act)\n          pos = nxt\n\n  def move_to_adjacent(target_cells, actions):\n      \"\"\"\n      Move to a walkable cell that is orthogonally adjacent to any of the\n      *target_cells*. Returns the exact target cell we will interact with.\n      \"\"\"\n      # all admissible adjacent positions\n      adj_set = set()\n      lookup = {}\n      for tx, ty in target_cells:\n          for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              ax, ay = tx + dx, ty + dy\n              if is_walkable(ax, ay):\n                  adj_set.add((ax, ay))\n                  lookup[(ax, ay)] = (tx, ty)\n      if not adj_set:\n          raise RuntimeError(\"No reachable adjacent cell\")\n      path = bfs(pos, adj_set)\n      if not path:\n          raise RuntimeError(\"Failed to reach adjacent cell\")\n      move_along(path, actions)\n      # now *pos* is adjacent to the chosen target\n      return lookup[pos]\n\n  def collect_primitive(kind_idx, amount, actions):\n      \"\"\"Collect *amount* units of the primitive with index *kind_idx*.\"\"\"\n      for _ in range(amount):\n          # locate all cells that still contain the primitive\n          cells = np.argwhere(grid[:, :, kind_idx] > 0)\n          if cells.size == 0:\n              raise RuntimeError(\"Required primitive not present on map\")\n          # pick the closest by Manhattan distance (cheap heuristic)\n          dists = np.abs(cells[:, 0] - pos[0]) + np.abs(cells[:, 1] - pos[1])\n          target = tuple(cells[dists.argmin()])\n          # move next to it and USE\n          move_to_adjacent([target], actions)\n          actions.append(USE)\n          # update our copy of the grid: the primitive disappears after USE\n          grid[target[0], target[1], kind_idx] = 0\n\n  # -------------------------------------------------------------------------\n  # 1. Gather all primitive ingredients required for the goal\n  # -------------------------------------------------------------------------\n  actions = []\n  primitives_needed = world.cookbook.primitives_for(goal_idx)\n  for kind_idx, cnt in primitives_needed.items():\n      collect_primitive(kind_idx, cnt, actions)\n\n  # -------------------------------------------------------------------------\n  # 2. Craft the item (move to workshop if required)\n  # -------------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')          # may be None\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          raise RuntimeError(\"Required workshop not found on map\")\n      # move adjacent to the nearest workshop cell\n      move_to_adjacent([tuple(workshop_cells[0])], actions)\n\n  # Use action to actually craft the item\n  actions.append(USE)\n\n  return actions", "env_interactions": 1, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T20:39:17.000476", "function_name": "make_stick", "function_body": "  import collections\n\n  # ----- helpers ---------------------------------------------------------\n  def _action_ids():\n      \"\"\"Return list of all action IDs available in the environment.\"\"\"\n      try:\n          return list(env.action_specs().values())\n      except Exception:\n          # default ordering: DOWN, UP, LEFT, RIGHT, USE\n          return [0, 1, 2, 3, 4]\n\n  def _goal_index():\n      \"\"\"Return integer index for the item \\\"stick\\\".\"\"\"\n      try:\n          return env.world.cookbook.index[\"stick\"]\n      except Exception:\n          return env.world.cookbook.index.get(\"stick\")\n\n  def _state_key(st):\n      \"\"\"Compact hashable representation of a CraftState.\"\"\"\n      # Position, direction and inventory uniquely identify reachable states for planning\n      return (st.pos, st.dir, st.inventory.tobytes())\n\n  # ----- initialisation --------------------------------------------------\n  action_ids = _action_ids()\n  goal_idx = _goal_index()\n\n  # obtain the starting state (lab wrapper may expose it)\n  start_state = getattr(env, \"_current_state\", None)\n  if start_state is None:\n      start_state = env.scenario.init()\n\n  # ----- breadth\u2011first search --------------------------------------------\n  frontier = collections.deque()\n  frontier.append((start_state, []))\n  visited = {_state_key(start_state)}\n\n  MAX_PLAN_LEN = 800  # safety guard\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      # Goal test: we have at least one stick in inventory\n      if goal_idx is not None and cur_state.satisfies(\"\", goal_idx):\n          return cur_plan\n\n      # Prune overly long plans\n      if len(cur_plan) >= MAX_PLAN_LEN:\n          continue\n\n      # Expand all possible actions\n      for a in action_ids:\n          _, nxt_state = cur_state.step(a)\n          key = _state_key(nxt_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((nxt_state, cur_plan + [a]))\n\n  # No plan found within limits \u2013 return empty list\n  return []", "env_interactions": 4, "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T20:39:18.115905", "function_name": "make_stick", "function_body": "  import collections\n\n  # Determine the available action IDs (fallback to default order if needed)\n  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      action_ids = [0, 1, 2, 3, 4]  # DOWN, UP, LEFT, RIGHT, USE\n\n  # Resolve the integer index for the target item \"stick\"\n  try:\n      goal_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      goal_idx = env.world.cookbook.index.get(\"stick\")\n\n  # Obtain the initial state (use the current state if the lab wrapper exposes it)\n  start_state = getattr(env, \"_current_state\", None)\n  if start_state is None:\n      start_state = env.scenario.init()\n\n  # Helper to create a hashable representation of a state for visited checks\n  def _state_key(st):\n      # Include position, direction, inventory, and grid layout to capture all changes\n      return (st.pos, st.dir, st.inventory.tobytes(), st.grid.tobytes())\n\n  # Bread\u2011first search over deterministic transitions\n  frontier = collections.deque()\n  frontier.append((start_state, []))\n  visited = {_state_key(start_state)}\n\n  MAX_PLAN_LEN = 500  # safety bound to avoid infinite search\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      # Goal test: inventory already contains a stick\n      if goal_idx is not None and cur_state.satisfies(\"\", goal_idx):\n          return cur_plan\n\n      # Prune overly long plans\n      if len(cur_plan) >= MAX_PLAN_LEN:\n          continue\n\n      # Expand all possible actions\n      for a in action_ids:\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((next_state, cur_plan + [a]))\n\n  # No plan found within limits \u2013 return empty list\n  return []", "env_interactions": 4, "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T20:39:47.917272", "function_name": "make_stick", "function_body": "  actions = []\n  world = env.world\n  state = env._current_state\n  # ...\n  return actions", "env_interactions": 0, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T20:39:49.040693", "function_name": "make_stick", "function_body": "  actions = []\n  world = env.world\n  state = env._current_state\n\n  # helper to translate a move between two adjacent cells into an action index\n  def move_action(cur, nxt):\n      dx, dy = nxt[0] - cur[0], nxt[1] - cur[1]\n      if dx == 1:\n          return 3  # RIGHT\n      if dx == -1:\n          return 2  # LEFT\n      if dy == 1:\n          return 0  # DOWN\n      if dy == -1:\n          return 1  # UP\n      raise ValueError(\"invalid move\")\n\n  # BFS that returns a path (list of positions) from start to a cell\n  # that is orthogonally adjacent to any target cell.\n  def bfs_to_adjacent(start, target_cells, grid):\n      W, H, _ = grid.shape\n      visited = np.full((W, H), False, dtype=bool)\n      q = collections.deque()\n      q.append((start, [start]))\n      visited[start] = True\n      target_set = {tuple(t) for t in target_cells}\n      while q:\n          pos, path = q.popleft()\n          # check adjacency to any target\n          for tx, ty in target_set:\n              if abs(pos[0] - tx) + abs(pos[1] - ty) == 1:\n                  return path\n          # expand neighbours\n          for dx, dy in [(0, 1), (0, -1), (-1, 0), (1, 0)]:\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  # can step only on empty cells\n                  if grid[nx, ny, :].sum() == 0:\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [(nx, ny)]))\n      raise RuntimeError(\"No reachable adjacent cell found\")\n\n  stick_idx = world.cookbook.index[\"stick\"]\n  # if we already have a stick, nothing to do\n  if state.inventory[stick_idx] > 0:\n      return actions\n\n  # primitive requirements (recursive) for one stick\n  prim_req = world.cookbook.primitives_for(stick_idx)\n\n  # copy of the grid that we will update as we \"pick up\" primitives\n  planning_grid = state.grid.copy()\n  cur_pos = tuple(state.pos)\n  collected = collections.defaultdict(int)\n\n  # collect each required primitive\n  for prim_idx, needed_cnt in prim_req.items():\n      while collected[prim_idx] < needed_cnt:\n          prim_cells = np.argwhere(planning_grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(\"Required primitive not found on the map\")\n          path = bfs_to_adjacent(cur_pos, prim_cells, planning_grid)\n          # follow the path\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n          # use action to pick up the primitive\n          actions.append(4)  # USE\n          # locate the primitive cell adjacent to our current position and remove it\n          removed = False\n          for dx, dy in [(0, 1), (0, -1), (-1, 0), (1, 0)]:\n              nx, ny = cur_pos[0] + dx, cur_pos[1] + dy\n              if 0 <= nx < planning_grid.shape[0] and 0 <= ny < planning_grid.shape[1]:\n                  if planning_grid[nx, ny, prim_idx] > 0:\n                      planning_grid[nx, ny, prim_idx] = 0\n                      removed = True\n                      break\n          if not removed:\n              raise RuntimeError(\"Failed to locate adjacent primitive after moving\")\n          collected[prim_idx] += 1\n\n  # move to the workshop for stick crafting\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      raise RuntimeError(\"No workshop specified for stick\")\n  workshop_idx = world.cookbook.index[workshop_name]\n  workshop_cells = np.argwhere(planning_grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      raise RuntimeError(\"Workshop cell not found in the map\")\n  path = bfs_to_adjacent(cur_pos, workshop_cells, planning_grid)\n  for step in path[1:]:\n      actions.append(move_action(cur_pos, step))\n      cur_pos = step\n  # use action to craft the stick\n  actions.append(4)  # USE\n\n  return actions", "env_interactions": 3, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T20:40:25.838805", "function_name": "make_stick", "function_body": "  ACTION = env.action_specs()\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  stick_idx = idx[\"stick\"]\n  needed = world.cookbook.primitives_for(stick_idx)  # {primitive_idx: count}\n\n  # Work on a copy of the grid so we can simulate pickups\n  grid = state.grid.copy()\n  cur_pos = state.pos\n  plan = []\n\n  from collections import deque\n\n  def bfs_path(start, goal):\n      \"\"\"Shortest path (Manhattan) avoiding occupied cells, but allowing the goal.\"\"\"\n      if start == goal:\n          return [start]\n      W, H, _ = grid.shape\n      visited = np.full((W, H), False, dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start[0], start[1]] = True\n\n      while q:\n          x, y = q.popleft()\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < W and 0 <= ny < H):\n                  continue\n              if visited[nx, ny]:\n                  continue\n              # can step onto the goal even if occupied\n              if (nx, ny) != goal and grid[nx, ny].any():\n                  continue\n              visited[nx, ny] = True\n              prev[(nx, ny)] = (x, y)\n              if (nx, ny) == goal:\n                  # reconstruct path\n                  path = [(nx, ny)]\n                  while path[-1] != start:\n                      path.append(prev[path[-1]])\n                  path.reverse()\n                  return path\n              q.append((nx, ny))\n      return None\n\n  def actions_from_path(path):\n      \"\"\"Translate a list of positions into action indices.\"\"\"\n      seq = []\n      for (x0, y0), (x1, y1) in zip(path, path[1:]):\n          if x1 > x0:\n              seq.append(ACTION[\"RIGHT\"])\n          elif x1 < x0:\n              seq.append(ACTION[\"LEFT\"])\n          elif y1 > y0:\n              seq.append(ACTION[\"DOWN\"])\n          else:\n              seq.append(ACTION[\"UP\"])\n      return seq\n\n  def nearest_of_kind(pos, kind):\n      \"\"\"Find the nearest cell containing `kind`.\"\"\"\n      layer = grid[:, :, kind]\n      ys, xs = np.where(layer > 0)\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - pos[0]) + np.abs(ys - pos[1])\n      i = int(np.argmin(dists))\n      return (int(xs[i]), int(ys[i]))\n\n  # --------------------------------------------------------------\n  # Collect required primitives\n  # --------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = nearest_of_kind(cur_pos, prim_idx)\n          if target is None:\n              return []  # primitive missing \u2013 cannot finish\n          path = bfs_path(cur_pos, target)\n          if path is None:\n              return []  # unreachable primitive\n          plan.extend(actions_from_path(path))\n          plan.append(ACTION[\"USE\"])          # pick up primitive\n          # simulate removal of the primitive from the world\n          grid[target[0], target[1], prim_idx] = 0\n          cur_pos = target\n\n  # --------------------------------------------------------------\n  # Move to workshop (if required) and craft the stick\n  # --------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      wk_idx = idx[workshop_name] if isinstance(workshop_name, str) else workshop_name\n      wk_pos = nearest_of_kind(cur_pos, wk_idx)\n      if wk_pos is not None:\n          path = bfs_path(cur_pos, wk_pos)\n          if path is not None:\n              plan.extend(actions_from_path(path))\n              cur_pos = wk_pos\n\n  # Final USE to actually craft the stick\n  plan.append(ACTION[\"USE\"])\n  return plan", "env_interactions": 4, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T20:40:26.956277", "function_name": "make_stick", "function_body": "  import numpy as np\n  from collections import deque\n\n  ACTION = env.action_specs()\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def find_nearest(pos, kind, grid):\n      \"\"\"Return (x, y) of the closest cell containing `kind`.\"\"\"\n      layer = grid[:, :, kind]\n      ys, xs = np.where(layer > 0)\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - pos[0]) + np.abs(ys - pos[1])\n      i = int(np.argmin(dists))\n      return (int(xs[i]), int(ys[i]))\n\n  def bfs_path(start, goal, grid):\n      \"\"\"Shortest path (list of positions) from start to goal avoiding obstacles.\"\"\"\n      if start == goal:\n          return [start]\n\n      W, H, _ = grid.shape\n      visited = np.full((W, H), False, dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start[0], start[1]] = True\n\n      while q:\n          x, y = q.popleft()\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < W and 0 <= ny < H):\n                  continue\n              if visited[nx, ny]:\n                  continue\n              # allow stepping onto the goal even if occupied\n              if (nx, ny) != goal and grid[nx, ny].any():\n                  continue\n              visited[nx, ny] = True\n              prev[(nx, ny)] = (x, y)\n              if (nx, ny) == goal:\n                  # reconstruct path\n                  path = [(nx, ny)]\n                  while path[-1] != start:\n                      path.append(prev[path[-1]])\n                  path.reverse()\n                  return path\n              q.append((nx, ny))\n      return None\n\n  def actions_from_path(path):\n      \"\"\"Convert a list of positions into a list of action indices.\"\"\"\n      seq = []\n      for (x0, y0), (x1, y1) in zip(path, path[1:]):\n          if x1 > x0:\n              seq.append(ACTION[\"RIGHT\"])\n          elif x1 < x0:\n              seq.append(ACTION[\"LEFT\"])\n          elif y1 > y0:\n              seq.append(ACTION[\"DOWN\"])\n          elif y1 < y0:\n              seq.append(ACTION[\"UP\"])\n      return seq\n\n  # ------------------------------------------------------------------\n  # Determine goal indices and required primitives\n  # ------------------------------------------------------------------\n  stick_idx = idx[\"stick\"]\n  needed = world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n\n  grid = state.grid.copy()\n  cur_pos = state.pos\n  plan = []\n\n  # ------------------------------------------------------------------\n  # If the stick itself is a primitive (no recipe), just collect it.\n  # ------------------------------------------------------------------\n  if not needed:\n      target = find_nearest(cur_pos, stick_idx, grid)\n      if target is not None:\n          path = bfs_path(cur_pos, target, grid)\n          if path:\n              plan.extend(actions_from_path(path))\n              plan.append(ACTION[\"USE\"])\n      return plan\n\n  # ------------------------------------------------------------------\n  # Collect required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          target = find_nearest(cur_pos, prim_idx, grid)\n          if target is None:\n              return []  # cannot find required primitive\n          path = bfs_path(cur_pos, target, grid)\n          if path is None:\n              return []  # unreachable\n          plan.extend(actions_from_path(path))\n          plan.append(ACTION[\"USE\"])\n          # simulate picking up the primitive\n          grid[target[0], target[1], prim_idx] = 0\n          cur_pos = target\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if recipe specifies one) and craft\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      wk_idx = idx[workshop_name] if isinstance(workshop_name, str) else workshop_name\n      wk_pos = find_nearest(cur_pos, wk_idx, grid)\n      if wk_pos is not None:\n          path = bfs_path(cur_pos, wk_pos, grid)\n          if path:\n              plan.extend(actions_from_path(path))\n              cur_pos = wk_pos\n\n  # Final USE to craft the stick\n  plan.append(ACTION[\"USE\"])\n\n  return plan", "env_interactions": 4, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T20:40:39.454989", "function_name": "make_stick", "function_body": "  # Determine the action IDs (fallback to default ordering if unavailable)\n  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      action_ids = [0, 1, 2, 3, 4]  # DOWN, UP, LEFT, RIGHT, USE (standard order)\n\n  # Resolve the integer index for the target item \"stick\" in the cookbook\n  try:\n      target_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      target_idx = env.world.cookbook.index.get(\"stick\")\n\n  # Obtain the starting state \u2013 use the current lab state if present, otherwise initialise a fresh one\n  start_state = getattr(env, \"_current_state\", None)\n  if start_state is None:\n      start_state = env.scenario.init()\n\n  from collections import deque\n\n  def _state_key(st):\n      \"\"\"Compact hashable representation of a state for visited\u2011state tracking.\"\"\"\n      return (st.pos, st.dir, st.inventory.tobytes())\n\n  # Bread\u2011first search over deterministic transitions\n  frontier = deque()\n  frontier.append((start_state, []))\n  visited = {_state_key(start_state)}\n  max_plan_len = 1000  # safety bound to avoid infinite search\n\n  while frontier:\n      cur_state, cur_actions = frontier.popleft()\n\n      # Goal test: inventory already contains a stick\n      if target_idx is not None and cur_state.satisfies(\"\", target_idx):\n          return cur_actions\n\n      # Prune overly long plans\n      if len(cur_actions) >= max_plan_len:\n          continue\n\n      # Expand all possible actions\n      for a in action_ids:\n          _, nxt_state = cur_state.step(a)\n          key = _state_key(nxt_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((nxt_state, cur_actions + [a]))\n\n  # No plan found within limits\n  return []", "env_interactions": 4, "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T20:40:40.572445", "function_name": "make_stick", "function_body": "  # Determine the integer ID for the target item \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n  if stick_idx is None:\n      return []\n\n  # Obtain the list of possible action IDs (fallback to default ordering)\n  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      # Default ordering: DOWN, UP, LEFT, RIGHT, USE\n      action_ids = [0, 1, 2, 3, 4]\n\n  # Acquire the starting state (use the current Lab state if available)\n  start_state = getattr(env, \"_current_state\", None)\n  if start_state is None:\n      start_state = env.scenario.init()\n\n  from collections import deque\n\n  def _state_key(st):\n      \"\"\"Compact hashable representation of a state for visited\u2011state tracking.\"\"\"\n      # Position (tuple), direction (int), inventory (bytes)\n      return (st.pos, st.dir, st.inventory.tobytes())\n\n  # Bread\u2011first search over deterministic transitions\n  frontier = deque()\n  frontier.append((start_state, []))\n  visited = {_state_key(start_state)}\n  max_plan_len = 800  # safety bound to avoid infinite search\n\n  while frontier:\n      cur_state, cur_actions = frontier.popleft()\n\n      # Goal test: inventory already contains at least one stick\n      if cur_state.inventory[stick_idx] > 0:\n          return cur_actions\n\n      # Prune overly long plans\n      if len(cur_actions) >= max_plan_len:\n          continue\n\n      # Expand all possible actions\n      for a in action_ids:\n          _, nxt_state = cur_state.step(a)\n          key = _state_key(nxt_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((nxt_state, cur_actions + [a]))\n\n  # No plan found within the limits\n  return []", "env_interactions": 4, "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T20:41:06.858796", "function_name": "make_stick", "function_body": "  env.reset()\n  world = env.world\n  idx = world.cookbook.index\n\n  # goal index for \"stick\"\n  try:\n      stick_idx = idx[\"stick\"]\n  except Exception:  # pragma: no cover\n      stick_idx = next(i for i, n in enumerate(idx.ordered_contents) if n.lower() == \"stick\")\n\n  # primitive requirements (fallback to primitive itself)\n  needed = world.cookbook.primitives_for(stick_idx)\n  if not needed:\n      needed = {stick_idx: 1}\n\n  # action ids\n  action_map = env.action_specs()\n  DOWN = action_map[\"DOWN\"]\n  UP = action_map[\"UP\"]\n  LEFT = action_map[\"LEFT\"]\n  RIGHT = action_map[\"RIGHT\"]\n  USE = action_map[\"USE\"]\n\n  # current simulated state (for bookkeeping)\n  state = env._current_state\n  cur_pos = tuple(state.pos)\n  grid = state.grid.copy()\n\n  # mask for non\u2011grabbable obstacles\n  non_grabbable = list(world.non_grabbable_indices)\n  blocked = (\n      np.any(grid[:, :, non_grabbable] > 0, axis=2)\n      if non_grabbable\n      else np.zeros(grid.shape[:2], dtype=bool)\n  )\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # helper: BFS that returns a list of actions to move from start to goal\n  # ------------------------------------------------------------------\n  def bfs_path(start, goal, blocked_mask):\n      if start == goal:\n          return []\n      from collections import deque\n\n      q = deque([start])\n      came = {start: (None, None)}  # cell -> (parent, action)\n\n      while q:\n          cur = q.popleft()\n          for act, (dx, dy) in [\n              (RIGHT, (1, 0)),\n              (LEFT, (-1, 0)),\n              (DOWN, (0, 1)),\n              (UP, (0, -1)),\n          ]:\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if not (0 <= nx < blocked_mask.shape[0] and 0 <= ny < blocked_mask.shape[1]):\n                  continue\n              if blocked_mask[nx, ny]:\n                  continue\n              nxt = (nx, ny)\n              if nxt in came:\n                  continue\n              came[nxt] = (cur, act)\n              if nxt == goal:\n                  # reconstruct actions\n                  seq = []\n                  node = nxt\n                  while came[node][0] is not None:\n                      parent, a = came[node]\n                      seq.append(a)\n                      node = parent\n                  seq.reverse()\n                  return seq\n              q.append(nxt)\n\n      # fallback: simple Manhattan moves (may hit obstacles)\n      seq = []\n      x, y = start\n      gx, gy = goal\n      while x < gx:\n          seq.append(RIGHT)\n          x += 1\n      while x > gx:\n          seq.append(LEFT)\n          x -= 1\n      while y < gy:\n          seq.append(DOWN)\n          y += 1\n      while y > gy:\n          seq.append(UP)\n          y -= 1\n      return seq\n\n  # --------------------------------------------------------------\n  # 1. collect required primitives\n  # --------------------------------------------------------------\n  for item_idx, cnt in needed.items():\n      cnt = int(cnt)\n      while cnt > 0:\n          locations = np.argwhere(grid[:, :, item_idx] > 0)\n          if locations.size == 0:\n              break  # no more of this primitive on the map\n          # choose the nearest occurrence (Manhattan distance)\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          target = tuple(locations[dists.argmin()])\n\n          # move to the primitive\n          path = bfs_path(cur_pos, target, blocked)\n          actions.extend(path)\n          cur_pos = target\n\n          # pick it up\n          actions.append(USE)\n          cnt -= 1\n\n          # update local grid copy\n          grid[target[0], target[1], item_idx] -= 1\n          if non_grabbable:\n              blocked[target[0], target[1]] = np.any(\n                  grid[target[0], target[1], non_grabbable] > 0\n              )\n\n  # --------------------------------------------------------------\n  # 2. go to workshop (if required) and craft\n  # --------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = idx[workshop_name]\n      ws_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_locs.size:\n          ws_target = tuple(ws_locs[0])\n          path = bfs_path(cur_pos, ws_target, blocked)\n          actions.extend(path)\n          cur_pos = ws_target\n          actions.append(USE)  # craft at workshop\n\n  return actions", "env_interactions": 4, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T20:41:07.986656", "function_name": "make_stick", "function_body": "  env.reset()\n\n  # shortcuts\n  world = env.world\n  idx = world.cookbook.index\n\n  # identify goal index for \"stick\"\n  try:\n      stick_idx = idx[\"stick\"]\n  except Exception:  # pragma: no cover\n      stick_idx = next(i for i, n in enumerate(idx.ordered_contents) if n.lower() == \"stick\")\n\n  # primitive requirements (fallback to the stick itself if it has no recipe)\n  needed = world.cookbook.primitives_for(stick_idx)\n  if not needed:\n      needed = {stick_idx: 1}\n\n  # action indices\n  action_map = env.action_specs()\n  DOWN = action_map[\"DOWN\"]\n  UP = action_map[\"UP\"]\n  LEFT = action_map[\"LEFT\"]\n  RIGHT = action_map[\"RIGHT\"]\n  USE = action_map[\"USE\"]\n  delta_to_action = {\n      (1, 0): RIGHT,\n      (-1, 0): LEFT,\n      (0, 1): DOWN,\n      (0, -1): UP,\n  }\n\n  # ----------------------------------------------------------------------\n  # helper: BFS returning a list of actions to move from start to goal\n  # ----------------------------------------------------------------------\n  def bfs_path(start, goal, blocked):\n      \"\"\"Return a list of actions that moves from start to goal while avoiding blocked cells.\"\"\"\n      if start == goal:\n          return []\n      from collections import deque\n\n      q = deque([start])\n      came = {start: (None, None)}  # cell -> (parent, action)\n\n      while q:\n          cur = q.popleft()\n          for act, (dx, dy) in [\n              (RIGHT, (1, 0)),\n              (LEFT, (-1, 0)),\n              (DOWN, (0, 1)),\n              (UP, (0, -1)),\n          ]:\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if not (0 <= nx < blocked.shape[0] and 0 <= ny < blocked.shape[1]):\n                  continue\n              if blocked[nx, ny]:\n                  continue\n              nxt = (nx, ny)\n              if nxt in came:\n                  continue\n              came[nxt] = (cur, act)\n              if nxt == goal:\n                  # reconstruct actions\n                  actions = []\n                  node = nxt\n                  while came[node][0] is not None:\n                      parent, a = came[node]\n                      actions.append(a)\n                      node = parent\n                  actions.reverse()\n                  return actions\n              q.append(nxt)\n\n      # fallback: Manhattan moves (may hit obstacles)\n      moves = []\n      x, y = start\n      gx, gy = goal\n      while x < gx:\n          moves.append(RIGHT)\n          x += 1\n      while x > gx:\n          moves.append(LEFT)\n          x -= 1\n      while y < gy:\n          moves.append(DOWN)\n          y += 1\n      while y > gy:\n          moves.append(UP)\n          y -= 1\n      return moves\n\n  # ----------------------------------------------------------------------\n  # initialise local copies of state for planning\n  # ----------------------------------------------------------------------\n  state = env._current_state\n  cur_pos = tuple(state.pos)\n  grid = state.grid.copy()\n\n  # blocked cells: any non\u2011grabbable entity present\n  non_grabbable = list(world.non_grabbable_indices)\n  blocked_mask = (\n      np.any(grid[:, :, non_grabbable] > 0, axis=2)\n      if non_grabbable\n      else np.zeros(grid.shape[:2], dtype=bool)\n  )\n\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # 1. collect required primitives\n  # ----------------------------------------------------------------------\n  for item_idx, count in needed.items():\n      count = int(count)\n      while count > 0:\n          locations = np.argwhere(grid[:, :, item_idx] > 0)\n          if locations.size == 0:\n              break  # no more of this primitive on the map\n          # choose the nearest by Manhattan distance\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          target = tuple(locations[dists.argmin()])\n\n          # move to the target\n          actions.extend(bfs_path(cur_pos, target, blocked_mask))\n          cur_pos = target\n\n          # pick up\n          actions.append(USE)\n          count -= 1\n\n          # update local grid and blocked mask\n          grid[target[0], target[1], item_idx] -= 1\n          if non_grabbable:\n              blocked_mask[target[0], target[1]] = np.any(\n                  grid[target[0], target[1], non_grabbable] > 0\n              )\n          else:\n              blocked_mask[target[0], target[1]] = False\n\n  # ----------------------------------------------------------------------\n  # 2. go to workshop (if required) and craft the stick\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = idx[workshop_name]\n      ws_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_locs.size:\n          ws_target = tuple(ws_locs[0])\n          actions.extend(bfs_path(cur_pos, ws_target, blocked_mask))\n          cur_pos = ws_target\n          actions.append(USE)  # craft at the workshop\n\n  return actions", "env_interactions": 4, "island_id": 0, "scores": {"3": 0.0}}
