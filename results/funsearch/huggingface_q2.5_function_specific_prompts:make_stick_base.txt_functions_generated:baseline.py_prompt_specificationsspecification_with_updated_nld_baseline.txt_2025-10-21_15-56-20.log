{"timestamp": "2025-10-21T16:02:41.299515", "function_name": "make_stick", "function_body": "  # Helper to translate direction deltas into action ids\n  act_map = env.action_specs()               # e.g. {\"DOWN\":0,\"UP\":1,\"LEFT\":2,\"RIGHT\":3,\"USE\":4}\n  dirs = {\n      (0, -1): act_map[\"UP\"],\n      (0,  1): act_map[\"DOWN\"],\n      (-1, 0): act_map[\"LEFT\"],\n      (1,  0): act_map[\"RIGHT\"],\n  }\n\n  # shortcut to current state\n  state = env._current_state\n\n  # index of the goal item (\"stick\")\n  goal_idx = env.world.cookbook.index[\"stick\"]\n  # primitive requirements for one stick\n  prim_req = env.world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  actions = []\n\n  def move_one_step(dx, dy):\n      \"\"\"execute a single movement step and update local state reference.\"\"\"\n      act = dirs[(dx, dy)]\n      actions.append(act)\n      _, new_state = env.step(act)\n      # update local reference\n      nonlocal state\n      state = new_state\n\n  def move_to(target):\n      \"\"\"Manhattan moves from current pos to target (empty cell).\"\"\"\n      while state.pos[0] != target[0] or state.pos[1] != target[1]:\n          cx, cy = state.pos\n          tx, ty = target\n          if cx < tx:\n              move_one_step(1, 0)\n          elif cx > tx:\n              move_one_step(-1, 0)\n          elif cy < ty:\n              move_one_step(0, 1)\n          elif cy > ty:\n              move_one_step(0, -1)\n\n  def nearest_kind(kind_idx):\n      \"\"\"return (x,y) of the closest cell containing kind_idx (Manhattan distance).\"\"\"\n      grid = state.grid\n      positions = np.argwhere(grid[:, :, kind_idx] > 0)\n      if len(positions) == 0:\n          return None\n      # compute distances\n      cur = np.array(state.pos)\n      dists = np.abs(positions - cur).sum(axis=1)\n      return tuple(positions[dists.argmin()])\n\n  def empty_neighbor(pos):\n      \"\"\"return an empty neighboring cell (4\u2011connected) if any.\"\"\"\n      x, y = pos\n      h, w = state.grid.shape[:2]\n      for dx, dy in [(1,0), (-1,0), (0,1), (0,-1)]:\n          nx, ny = x+dx, y+dy\n          if 0 <= nx < h and 0 <= ny < w:\n              if state.grid[nx, ny, :].sum() == 0:   # empty\n                  return (nx, ny)\n      return None\n\n  # ----------------------------------------------------------------------\n  # Main loop: collect primitives until we have enough, then craft.\n  # ----------------------------------------------------------------------\n  while state.inventory[goal_idx] == 0:\n      # --------------------------------------------------------------\n      # 1) Check which primitive we still need\n      # --------------------------------------------------------------\n      need = {}\n      for p_idx, cnt in prim_req.items():\n          have = state.inventory[p_idx]\n          if have < cnt:\n              need[p_idx] = cnt - have\n\n      if need:\n          # pick any needed primitive (deterministic: smallest index)\n          p_idx = min(need.keys())\n          # locate nearest instance of that primitive\n          prim_pos = nearest_kind(p_idx)\n          if prim_pos is None:\n              raise RuntimeError(\"Required primitive not found in the world.\")\n          # move to an empty neighbor of the primitive\n          neigh = empty_neighbor(prim_pos)\n          if neigh is None:\n              raise RuntimeError(\"No empty cell adjacent to required primitive.\")\n          move_to(neigh)\n\n          # face the primitive: attempt a move into its cell (will be blocked)\n          dx = prim_pos[0] - state.pos[0]\n          dy = prim_pos[1] - state.pos[1]\n          if (dx, dy) in dirs:\n              # this move is blocked but will set direction\n              actions.append(dirs[(dx, dy)])\n              _, state = env.step(dirs[(dx, dy)])\n          else:\n              # should never happen (they are adjacent)\n              pass\n\n          # use action to pick it up\n          actions.append(act_map[\"USE\"])\n          _, state = env.step(act_map[\"USE\"])\n          continue   # re\u2011evaluate need after pickup\n\n      # --------------------------------------------------------------\n      # 2) All primitives gathered \u2013 craft at the appropriate workshop\n      # --------------------------------------------------------------\n      # workshop kind is stored under key \"_at\" in the recipe dict\n      workshop_idx = env.world.cookbook.recipes[goal_idx][\"_at\"]\n      workshop_pos = nearest_kind(workshop_idx)\n      if workshop_pos is None:\n          raise RuntimeError(\"Workshop for stick not found.\")\n      neigh = empty_neighbor(workshop_pos)\n      if neigh is None:\n          raise RuntimeError(\"No empty cell adjacent to workshop.\")\n      move_to(neigh)\n\n      # face workshop (same blocked\u2011move trick)\n      dx = workshop_pos[0] - state.pos[0]\n      dy = workshop_pos[1] - state.pos[1]\n      if (dx, dy) in dirs:\n          actions.append(dirs[(dx, dy)])\n          _, state = env.step(dirs[(dx, dy)])\n      # craft\n      actions.append(act_map[\"USE\"])\n      _, state = env.step(act_map[\"USE\"])\n      # loop will exit when inventory[goal_idx] > 0\n\n  # Return the full list of action ids\n  return actions", "env_interactions": 0, "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-10-21T16:08:08.918931", "function_name": "make_stick", "function_body": "  # Action indices (as defined in CraftLab.action_specs)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  actions = []\n\n  # Current state and world reference\n  state = env._current_state\n  world = env.world\n\n  # Index of the target item (\"stick\")\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # Primitive requirements for one stick\n  primitive_needs = world.cookbook.primitives_for(stick_idx)\n\n  # Helper: locate the nearest cell containing a given kind\n  def _nearest(pos, kind):\n      # positions where the kind is present (count > 0)\n      cells = np.argwhere(state.grid[:, :, kind] > 0)\n      if cells.size == 0:\n          return None\n      # Manhattan distance to each candidate\n      dists = np.sum(np.abs(cells - np.array(pos)), axis=1)\n      return cells[dists.argmin()]\n\n  # Helper: move the agent step\u2011by\u2011step towards a target coordinate\n  def _move_to(target):\n      nonlocal state\n      while tuple(state.pos) != tuple(target):\n          x, y = state.pos\n          tx, ty = target\n          if x < tx:\n              act = RIGHT\n          elif x > tx:\n              act = LEFT\n          elif y < ty:\n              act = DOWN\n          else:  # y > ty\n              act = UP\n          actions.append(act)\n          env.step(act)          # state inside env is updated internally\n          state = env._current_state\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives\n  # ------------------------------------------------------------------\n  for kind, count in primitive_needs.items():\n      for _ in range(count):\n          loc = _nearest(state.pos, kind)\n          if loc is None:\n              # Primitive not found \u2013 give up early\n              return actions\n          _move_to(loc)\n          actions.append(USE)      # pick up / harvest\n          env.step(USE)\n          state = env._current_state\n\n  # ------------------------------------------------------------------\n  # 2. Go to the appropriate workshop and craft the stick\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\", None)\n  if workshop_name is not None:\n      workshop_kind = world.cookbook.index[workshop_name]\n      workshop_loc = _nearest(state.pos, workshop_kind)\n      if workshop_loc is not None:\n          _move_to(workshop_loc)\n          actions.append(USE)      # craft at the workshop\n          env.step(USE)\n          state = env._current_state\n\n  return actions", "env_interactions": 0, "island_id": 7, "scores": {"3": -1}}
