{"timestamp": "2025-10-21T16:19:00.639645", "function_name": "make_stick", "function_body": "  # Reset environment to a known state and obtain handles to core objects\n  env.reset()\n  state = env._current_state            # type: CraftState\n  world = env.world                      # type: CraftWorld\n  cookbook = world.cookbook\n\n  # ------------------------------------------------------------\n  # Identify the goal (\"stick\") and its primitive requirements.\n  # ------------------------------------------------------------\n  goal_name = \"stick\"\n  try:\n      goal_idx = cookbook.index[goal_name]\n  except Exception:\n      # If the goal name is not present, abort with empty plan.\n      return []\n  primitive_requirements = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n\n  # ------------------------------------------------------------\n  # Helper: map directions to action indices.\n  # ------------------------------------------------------------\n  action_map = env.action_specs()\n  DOWN = action_map.get('DOWN', 0)\n  UP   = action_map.get('UP', 1)\n  LEFT = action_map.get('LEFT', 2)\n  RIGHT= action_map.get('RIGHT', 3)\n  USE  = action_map.get('USE', 4)\n\n  def moves_to(start, target):\n      \"\"\"Return a list of actions that move from start (x,y) to target (x,y).\"\"\"\n      cx, cy = start\n      tx, ty = target\n      actions = []\n      while cx < tx:\n          actions.append(DOWN); cx += 1\n      while cx > tx:\n          actions.append(UP);   cx -= 1\n      while cy < ty:\n          actions.append(RIGHT); cy += 1\n      while cy > ty:\n          actions.append(LEFT);  cy -= 1\n      return actions\n\n  # ------------------------------------------------------------\n  # Locate all primitives currently present on the grid.\n  # ------------------------------------------------------------\n  grid = state.grid                       # (W, H, n_kinds)\n  prim_locations = {}                     # prim_idx -> list of (x, y)\n  for prim_idx in primitive_requirements.keys():\n      locs = np.argwhere(grid[:, :, prim_idx] > 0)\n      prim_locations[prim_idx] = [tuple(p) for p in locs]\n\n  # ------------------------------------------------------------\n  # Locate a workshop (any workshop kind).\n  # ------------------------------------------------------------\n  workshop_pos = None\n  for wk_idx in world.workshop_indices:\n      cells = np.argwhere(grid[:, :, wk_idx] > 0)\n      if cells.size > 0:\n          workshop_pos = tuple(cells[0])\n          break\n\n  # ------------------------------------------------------------\n  # Build the action plan:\n  #   1) Collect required primitives (moving, then USE to pick up).\n  #   2) Move to a workshop and USE to craft the stick.\n  # ------------------------------------------------------------\n  cur_pos = state.pos\n  plan = []\n\n  # Collect each primitive type\n  for prim_idx, needed in primitive_requirements.items():\n      collected = 0\n      # Keep a mutable copy of locations for this primitive\n      available = prim_locations.get(prim_idx, []).copy()\n      while collected < needed and available:\n          # Choose the nearest available primitive\n          distances = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in available]\n          nearest_idx = int(np.argmin(distances))\n          target = available.pop(nearest_idx)\n\n          plan.extend(moves_to(cur_pos, target))\n          cur_pos = target\n          plan.append(USE)                # pick up the primitive\n          collected += 1\n\n      # If we could not find enough instances, we simply stop;\n      # the environment may later spawn them, but a static planner\n      # cannot handle dynamic respawns.\n\n  # Move to workshop (if found) and craft\n  if workshop_pos is not None:\n      plan.extend(moves_to(cur_pos, workshop_pos))\n      cur_pos = workshop_pos\n  # Final USE to trigger crafting at the workshop\n  plan.append(USE)\n\n  return plan", "env_interactions": 4, "island_id": 5, "scores": {"3": 0.0}}
