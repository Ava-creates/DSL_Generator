{"timestamp": "2025-10-21T20:06:45.891531", "function_name": "make_stick", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Current state, world configuration and goal index\n  state = env._current_state\n  world = env.world\n  goal_idx = env.task.goal\n\n  # Primitives required to craft the goal (e.g., stick)\n  primitives_needed = world.cookbook.primitives_for(goal_idx)\n\n  # Track current position and accumulated actions\n  pos = tuple(state.pos)\n  actions = []\n\n  # -------------------------------------------------------------------------\n  # Helper: move to a target cell using simple Manhattan moves (ignores obstacles)\n  # -------------------------------------------------------------------------\n  def move_to(target):\n      nonlocal pos, actions\n      tx, ty = target\n      while pos[0] < tx:\n          actions.append(RIGHT)\n          pos = (pos[0] + 1, pos[1])\n      while pos[0] > tx:\n          actions.append(LEFT)\n          pos = (pos[0] - 1, pos[1])\n      while pos[1] < ty:\n          actions.append(DOWN)\n          pos = (pos[0], pos[1] + 1)\n      while pos[1] > ty:\n          actions.append(UP)\n          pos = (pos[0], pos[1] - 1)\n\n  # -------------------------------------------------------------------------\n  # Helper: collect a single unit of a given primitive kind\n  # -------------------------------------------------------------------------\n  def collect(kind):\n      nonlocal pos, actions, state\n      locations = np.argwhere(state.grid[:, :, kind] > 0)\n      if len(locations) == 0:\n          return  # Nothing to collect; should not happen in a valid scenario\n\n      # Choose the nearest primitive (Manhattan distance)\n      dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n      nearest = locations[dists.argmin()]\n      tx, ty = nearest.tolist()\n\n      # Determine an adjacent cell from which we can face the primitive\n      if tx > pos[0]:\n          adj = (tx - 1, ty)          # stand left, face RIGHT\n      elif tx < pos[0]:\n          adj = (tx + 1, ty)          # stand right, face LEFT\n      elif ty > pos[1]:\n          adj = (tx, ty - 1)          # stand above, face DOWN\n      else:\n          adj = (tx, ty + 1)          # stand below, face UP\n\n      move_to(adj)\n      actions.append(USE)\n\n  # -------------------------------------------------------------------------\n  # Collect all required primitives (respecting counts)\n  # -------------------------------------------------------------------------\n  for kind, count in primitives_needed.items():\n      for _ in range(count):\n          collect(kind)\n\n  # -------------------------------------------------------------------------\n  # If the recipe specifies a workshop, move there and craft the item\n  # -------------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if len(workshop_cells) > 0:\n          wx, wy = workshop_cells[0].tolist()\n          if wx > pos[0]:\n              adj = (wx - 1, wy)\n          elif wx < pos[0]:\n              adj = (wx + 1, wy)\n          elif wy > pos[1]:\n              adj = (wx, wy - 1)\n          else:\n              adj = (wx, wy + 1)\n          move_to(adj)\n          actions.append(USE)\n\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T20:06:47.031794", "function_name": "make_stick", "function_body": "  # action indices (consistent with CraftWorld)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # -------------------------------------------------------------------------\n  # Helper utilities\n  # -------------------------------------------------------------------------\n  state = env._current_state          # current CraftState\n  world = env.world                    # CraftWorld instance\n  goal_idx = env.task.goal             # integer index of the desired item\n\n  # grid dimensions\n  H, W = state.grid.shape[0], state.grid.shape[1]\n\n  # current agent position (mutable)\n  pos = tuple(state.pos)\n\n  actions = []                         # list we will fill and return\n\n  # map a delta to the corresponding action index\n  delta_to_action = {\n      (1, 0): RIGHT,\n      (-1, 0): LEFT,\n      (0, 1): DOWN,\n      (0, -1): UP,\n  }\n\n  def is_walkable(x, y):\n      \"\"\"A cell is walkable if it is inside the map and contains no entities.\"\"\"\n      return 0 <= x < H and 0 <= y < W and state.grid[x, y].sum() == 0\n\n  def neighbours(x, y):\n      \"\"\"Yield walkable neighbour coordinates.\"\"\"\n      for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n          nx, ny = x + dx, y + dy\n          if is_walkable(nx, ny):\n              yield (nx, ny)\n\n  def bfs(start, goals):\n      \"\"\"\n      Bread\u2011first search from start to any cell in goals.\n      Returns a list of positions from start (excluded) to the goal (included),\n      or an empty list if no path exists.\n      \"\"\"\n      from collections import deque\n      q = deque()\n      q.append(start)\n      came_from = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur in goals:\n              # reconstruct path\n              path = []\n              while cur != start:\n                  path.append(cur)\n                  cur = came_from[cur]\n              path.reverse()\n              return path\n          for nb in neighbours(*cur):\n              if nb not in came_from:\n                  came_from[nb] = cur\n                  q.append(nb)\n      return []   # no path found\n\n  def move_along(path):\n      \"\"\"Convert a list of positions into actions and update pos.\"\"\"\n      nonlocal pos, actions\n      for nxt in path:\n          dx = nxt[0] - pos[0]\n          dy = nxt[1] - pos[1]\n          act = delta_to_action[(dx, dy)]\n          actions.append(act)\n          pos = nxt\n\n  def move_to_adjacent(target_cells):\n      \"\"\"\n      Given a list of target cells (where the desired entity resides),\n      find the nearest walkable cell adjacent to any of them and move there.\n      Returns the exact target cell we are going to interact with.\n      \"\"\"\n      # build set of all admissible adjacent positions\n      adj_set = set()\n      target_lookup = {}\n      for tx, ty in target_cells:\n          for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              ax, ay = tx + dx, ty + dy\n              if is_walkable(ax, ay):\n                  adj_set.add((ax, ay))\n                  target_lookup[(ax, ay)] = (tx, ty)   # remember which target we are next to\n      if not adj_set:\n          return None  # cannot reach\n      path = bfs(pos, adj_set)\n      if not path:\n          return None\n      move_along(path)\n      # after moving, pos is now an adjacent cell\n      return target_lookup[pos]\n\n  def collect_primitive(kind_idx, count):\n      \"\"\"Collect `count` units of the primitive identified by kind_idx.\"\"\"\n      for _ in range(count):\n          # locate all cells containing the primitive\n          prim_cells = np.argwhere(state.grid[:, :, kind_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(\"Required primitive not present on the map\")\n          # choose the closest by Manhattan distance (rough heuristic)\n          dists = np.abs(prim_cells[:, 0] - pos[0]) + np.abs(prim_cells[:, 1] - pos[1])\n          target = prim_cells[dists.argmin()]\n          # move adjacent and USE\n          target_cell = move_to_adjacent([tuple(target)])\n          if target_cell is None:\n              raise RuntimeError(\"Cannot reach primitive\")\n          actions.append(USE)\n          # after a successful USE the primitive disappears from the grid;\n          # we update the internal grid copy to keep future searches accurate.\n          state.grid[target[0], target[1], kind_idx] = 0\n\n  # -------------------------------------------------------------------------\n  # 1. Gather required primitives for the goal\n  # -------------------------------------------------------------------------\n  primitives_needed = world.cookbook.primitives_for(goal_idx)\n  for kind_idx, needed_cnt in primitives_needed.items():\n      collect_primitive(kind_idx, needed_cnt)\n\n  # -------------------------------------------------------------------------\n  # 2. Move to the appropriate workshop (if any) and craft\n  # -------------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          raise RuntimeError(\"Workshop required for crafting not found\")\n      # move adjacent to the first workshop cell we encounter\n      move_to_adjacent([tuple(workshop_cells[0])])\n      actions.append(USE)   # craft the item\n\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
