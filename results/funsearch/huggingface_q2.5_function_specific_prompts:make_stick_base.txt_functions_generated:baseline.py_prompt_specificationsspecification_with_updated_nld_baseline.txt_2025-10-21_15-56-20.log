{"timestamp": "2025-10-21T18:41:25.136988", "function_name": "make_stick", "function_body": "  actions = []\n  world = env.world\n  state = env._current_state\n\n  # Target item index\n  stick_idx = world.cookbook.index[\"stick\"]\n  if state.inventory[stick_idx] > 0:\n      return actions\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def move_action(cur, nxt):\n      \"\"\"Return action index that moves from cur -> nxt.\"\"\"\n      dx = nxt[0] - cur[0]\n      dy = nxt[1] - cur[1]\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise ValueError(\"invalid move step\")\n\n  def bfs_adjacent(start, targets, grid):\n      \"\"\"\n      Find a shortest path (list of positions) from start to an empty cell\n      that is orthogonally adjacent to any of the target cells.\n      Returns the path including the start cell.\n      \"\"\"\n      W, H, _ = grid.shape\n      visited = np.full((W, H), False, dtype=bool)\n      q = collections.deque()\n      q.append((start, [start]))\n      visited[start] = True\n      target_set = {tuple(t) for t in targets}\n      while q:\n          (x, y), path = q.popleft()\n          # Check adjacency\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n          # Expand neighbours (only through empty cells)\n          for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if grid[nx, ny, :].sum() == 0:   # empty\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [(nx, ny)]))\n      raise RuntimeError(\"No reachable adjacent cell to target\")\n\n  # ------------------------------------------------------------------\n  # 1) Collect required primitives for a stick\n  # ------------------------------------------------------------------\n  primitive_requirements = world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n  cur_pos = tuple(state.pos)\n\n  for prim_idx, needed in primitive_requirements.items():\n      while state.inventory[prim_idx] < needed:\n          # Find remaining cells that contain the primitive\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(\"Required primitive not present in the world\")\n          # Choose the first (any) cell; BFS will find the nearest reachable adjacent cell\n          path = bfs_adjacent(cur_pos, prim_cells, state.grid)\n          # Convert path to movement actions\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n          # Pick up the primitive\n          actions.append(4)   # USE\n          # Update local grid copy so we don't target the same cell again\n          target = prim_cells[0]\n          state.grid[target[0], target[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 2) Move to workshop (if required) and craft the stick\n  # ------------------------------------------------------------------\n  recipe_dict = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe_dict.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          raise RuntimeError(\"Workshop for stick not found in the world\")\n      path = bfs_adjacent(cur_pos, workshop_cells, state.grid)\n      for step in path[1:]:\n          actions.append(move_action(cur_pos, step))\n          cur_pos = step\n\n  # Craft the stick\n  actions.append(4)   # USE\n  return actions", "env_interactions": 0, "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-10-21T18:41:39.331400", "function_name": "make_stick", "function_body": "  # Reset environment and get the initial state\n  env.reset()\n  state = env._current_state  # type: CraftState\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  act_spec = env.action_specs()\n  ACTION_USE = act_spec[\"USE\"]\n  ACTIONS_MOVE = {k: act_spec[k] for k in (\"UP\", \"DOWN\", \"LEFT\", \"RIGHT\")}\n  DIR_VECT = {\n      \"UP\": (-1, 0),\n      \"DOWN\": (1, 0),\n      \"LEFT\": (0, -1),\n      \"RIGHT\": (0, 1),\n  }\n\n  from collections import deque\n\n  def bfs_path(start, targets):\n      \"\"\"Return a list of action IDs moving from start to the nearest target.\"\"\"\n      h, w = state.grid.shape[:2]\n      visited = set()\n      q = deque([(start, [])])\n      while q:\n          pos, path = q.popleft()\n          if pos in visited:\n              continue\n          visited.add(pos)\n          if pos in targets:\n              return path\n          x, y = pos\n          for name, (dx, dy) in DIR_VECT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < h and 0 <= ny < w:\n                  # walkable if cell has no entities (all zeros)\n                  if not state.grid[nx, ny].any():\n                      q.append(((nx, ny), path + [ACTIONS_MOVE[name]]))\n      return None\n\n  # ------------------------------------------------------------------\n  # Identify stick and its primitive requirements.\n  # ------------------------------------------------------------------\n  idx = state.world.cookbook.index\n  stick_idx = idx.index(\"stick\")\n  primitive_needs = state.world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive.\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      while state.inventory[prim_idx] < needed_cnt:\n          # Find all cells currently holding this primitive.\n          h, w = state.grid.shape[:2]\n          prim_cells = [\n              (i, j)\n              for i in range(h)\n              for j in range(w)\n              if state.grid[i, j, prim_idx] > 0\n          ]\n          if not prim_cells:\n              # No more primitives on the map \u2013 cannot satisfy requirement.\n              break\n\n          # Compute shortest path to any such cell.\n          path = bfs_path(state.pos, set(prim_cells))\n          if path is None:\n              # Unreachable primitive \u2013 abort loop.\n              break\n\n          # Execute movement actions.\n          for a in path:\n              _, state = state.step(a)\n              actions.append(a)\n\n          # Use (collect) the primitive.\n          _, state = state.step(ACTION_USE)\n          actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # Move to the workshop (if recipe specifies one) and craft.\n  # ------------------------------------------------------------------\n  recipe = state.world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\") if isinstance(recipe, dict) else None\n  if workshop_name:\n      workshop_idx = idx.index(workshop_name)\n      h, w = state.grid.shape[:2]\n      workshop_cells = [\n          (i, j)\n          for i in range(h)\n          for j in range(w)\n          if state.grid[i, j, workshop_idx] > 0\n      ]\n      if workshop_cells:\n          path = bfs_path(state.pos, set(workshop_cells))\n          if path:\n              for a in path:\n                  _, state = state.step(a)\n                  actions.append(a)\n              # Use (craft) at the workshop.\n              _, state = state.step(ACTION_USE)\n              actions.append(ACTION_USE)\n\n  # Return the complete action sequence.\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:41:40.452325", "function_name": "make_stick", "function_body": "  env.reset()\n  state = env._current_state  # type: CraftState\n\n  act_spec = env.action_specs()\n  ACTION_USE = act_spec[\"USE\"]\n  ACTIONS_MOVE = {k: act_spec[k] for k in (\"UP\", \"DOWN\", \"LEFT\", \"RIGHT\")}\n  DIR_VECT = {\n      \"UP\": (-1, 0),\n      \"DOWN\": (1, 0),\n      \"LEFT\": (0, -1),\n      \"RIGHT\": (0, 1),\n  }\n\n  from collections import deque\n\n  def bfs_path(start, targets):\n      h, w = state.grid.shape[:2]\n      visited = set()\n      q = deque([(start, [])])\n      while q:\n          pos, path = q.popleft()\n          if pos in visited:\n              continue\n          visited.add(pos)\n          if pos in targets:\n              return path\n          x, y = pos\n          for name, (dx, dy) in DIR_VECT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < h and 0 <= ny < w:\n                  if not state.grid[nx, ny].any():\n                      q.append(((nx, ny), path + [ACTIONS_MOVE[name]]))\n      return None\n\n  idx = state.world.cookbook.index\n  stick_idx = idx.index(\"stick\")\n  primitive_needs = state.world.cookbook.primitives_for(stick_idx)\n\n  actions = []\n\n  # Collect required primitives\n  for prim_idx, need_cnt in primitive_needs.items():\n      while state.inventory[prim_idx] < need_cnt:\n          h, w = state.grid.shape[:2]\n          prim_cells = [(i, j) for i in range(h) for j in range(w)\n                        if state.grid[i, j, prim_idx] > 0]\n          if not prim_cells:\n              break\n          path = bfs_path(state.pos, set(prim_cells))\n          if path is None:\n              break\n          for a in path:\n              _, state = state.step(a)\n              actions.append(a)\n          _, state = state.step(ACTION_USE)\n          actions.append(ACTION_USE)\n\n  # Move to workshop if recipe specifies one\n  recipe = state.world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\") if isinstance(recipe, dict) else None\n  if workshop_name:\n      workshop_idx = idx.index(workshop_name)\n      h, w = state.grid.shape[:2]\n      workshop_cells = [(i, j) for i in range(h) for j in range(w)\n                        if state.grid[i, j, workshop_idx] > 0]\n      if workshop_cells:\n          path = bfs_path(state.pos, set(workshop_cells))\n          if path:\n              for a in path:\n                  _, state = state.step(a)\n                  actions.append(a)\n              _, state = state.step(ACTION_USE)\n              actions.append(ACTION_USE)\n\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:42:04.710876", "function_name": "make_stick", "function_body": "  actions = []\n  world = env.world\n  state = env._current_state\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def move_action(cur, nxt):\n      dx = nxt[0] - cur[0]\n      dy = nxt[1] - cur[1]\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise ValueError(\"Invalid move step\")\n\n  def bfs_adjacent(start, targets, grid):\n      \"\"\"Shortest path to any empty cell orthogonally adjacent to a target.\"\"\"\n      W, H, _ = grid.shape\n      visited = np.full((W, H), False, dtype=bool)\n      q = collections.deque()\n      q.append((start, [start]))\n      visited[start] = True\n      target_set = {tuple(t) for t in targets}\n\n      while q:\n          (x, y), path = q.popleft()\n          # Check adjacency\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path, (tx, ty)   # also return which target we are adjacent to\n          # Expand\n          for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if grid[nx, ny, :].sum() == 0:   # empty cell\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [(nx, ny)]))\n      raise RuntimeError(\"No reachable adjacent cell to any target\")\n\n  def face_target_and_use(cur, target):\n      \"\"\"\n      Ensure the agent ends up facing `target` from `cur`.\n      Returns a list of actions (may include extra moves) that\n      end with the correct direction, followed by a USE (4).\n      \"\"\"\n      tx, ty = target\n      cx, cy = cur\n      dx, dy = tx - cx, ty - cy\n      # Desired direction vector (must be orthogonal)\n      if abs(dx) + abs(dy) != 1:\n          raise ValueError(\"Target not orthogonal adjacent\")\n      # Direction we need to face\n      need_dir = (dx, dy)\n\n      # Cell opposite to needed direction\n      opp = (cx - dx, cy - dy)\n      W, H, _ = state.grid.shape\n      # Helper to check emptiness\n      def empty(cell):\n          x, y = cell\n          return 0 <= x < W and 0 <= y < H and state.grid[x, y, :].sum() == 0\n\n      extra_moves = []\n      if empty(opp):\n          # Move to opposite cell and back\n          extra_moves.append(move_action((cx, cy), opp))\n          extra_moves.append(move_action(opp, (cx, cy)))\n      else:\n          # Find any neighbouring empty cell to step away and back\n          for d in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              nb = (cx + d[0], cy + d[1])\n              if empty(nb):\n                  extra_moves.append(move_action((cx, cy), nb))\n                  extra_moves.append(move_action(nb, (cx, cy)))\n                  break\n      extra_moves.append(4)   # USE\n      return extra_moves\n\n  # ------------------------------------------------------------------\n  # 1) Gather required primitives for a stick\n  # ------------------------------------------------------------------\n  stick_idx = world.cookbook.index[\"stick\"]\n  if state.inventory[stick_idx] > 0:\n      return actions\n\n  primitive_requirements = world.cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n  cur_pos = tuple(state.pos)\n\n  for prim_idx, needed in primitive_requirements.items():\n      for _ in range(needed):\n          # If we already have this primitive, skip\n          if state.inventory[prim_idx] > 0:\n              continue\n\n          # Locate cells containing the primitive\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(\"Required primitive not present in the world\")\n\n          # Find path to an empty cell adjacent to any of the primitive cells\n          path, target_cell = bfs_adjacent(cur_pos, prim_cells, state.grid)\n\n          # Convert path to movement actions\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n\n          # Face the primitive correctly and pick it up\n          actions.extend(face_target_and_use(cur_pos, target_cell))\n\n          # Simulate pickup: remove primitive from grid and add to inventory\n          state.grid[target_cell[0], target_cell[1], prim_idx] = 0\n          state.inventory[prim_idx] += 1\n\n  # ------------------------------------------------------------------\n  # 2) Move to workshop (if any) and craft the stick\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          raise RuntimeError(\"Workshop for stick not found in the world\")\n      path, target_cell = bfs_adjacent(cur_pos, workshop_cells, state.grid)\n      for step in path[1:]:\n          actions.append(move_action(cur_pos, step))\n          cur_pos = step\n      # Face workshop and use to craft\n      actions.extend(face_target_and_use(cur_pos, target_cell))\n  else:\n      # No specific workshop \u2013 just use at current location\n      actions.append(4)   # USE\n\n  return actions", "env_interactions": 7, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:42:05.821018", "function_name": "make_stick", "function_body": "  actions = []\n  world = env.world\n  state = env._current_state\n\n  # Index of the target item\n  stick_idx = world.cookbook.index[\"stick\"]\n  if state.inventory[stick_idx] > 0:\n      return actions\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def move_action(cur, nxt):\n      dx = nxt[0] - cur[0]\n      dy = nxt[1] - cur[1]\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise ValueError(\"Invalid move step\")\n\n  def bfs_adjacent(start, targets, grid):\n      \"\"\"Shortest path from start to any empty cell orthogonal to a target.\"\"\"\n      W, H, _ = grid.shape\n      visited = np.full((W, H), False, dtype=bool)\n      q = collections.deque()\n      q.append((start, [start]))\n      visited[start] = True\n      target_set = {tuple(t) for t in targets}\n      while q:\n          (x, y), path = q.popleft()\n          # Check adjacency\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n          # Expand neighbours through empty cells only\n          for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if grid[nx, ny, :].sum() == 0:   # empty cell\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [(nx, ny)]))\n      raise RuntimeError(\"No reachable adjacent cell to any target\")\n\n  # ------------------------------------------------------------------\n  # 1) Gather required primitives for a stick\n  # ------------------------------------------------------------------\n  # Copy grid for planning so we can mark primitives as \u201ctaken\u201d\n  planning_grid = state.grid.copy()\n  cur_pos = tuple(state.pos)\n\n  primitive_requirements = world.cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n  for prim_idx, needed in primitive_requirements.items():\n      for _ in range(needed):\n          # If we already have this primitive in inventory, skip collection\n          if state.inventory[prim_idx] > 0:\n              continue\n\n          # Locate cells that still contain this primitive\n          prim_cells = np.argwhere(planning_grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(\"Required primitive not present in the world\")\n\n          # Plan a path to an empty cell adjacent to the nearest primitive\n          path = bfs_adjacent(cur_pos, prim_cells, planning_grid)\n\n          # Convert path to actions\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n\n          # Use action to pick up the primitive\n          actions.append(4)   # USE\n\n          # Mark the primitive as removed in the planning grid\n          cell = prim_cells[0]\n          planning_grid[cell[0], cell[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 2) Go to the workshop (if required) and craft the stick\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(planning_grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          raise RuntimeError(\"Workshop for stick not found in the world\")\n      path = bfs_adjacent(cur_pos, workshop_cells, planning_grid)\n      for step in path[1:]:\n          actions.append(move_action(cur_pos, step))\n          cur_pos = step\n\n  # Final USE to actually craft the stick\n  actions.append(4)   # USE\n\n  return actions", "env_interactions": 3, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:42:31.763494", "function_name": "make_stick", "function_body": "  actions = []\n  try:\n      # Reset environment and obtain the current CraftState.\n      env.reset()\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          scenario = getattr(env, \"scenario\", None)\n          if scenario is not None:\n              state = scenario.init()\n      if state is None:\n          return actions\n\n      world = state.world\n      # Work on a copy of the grid so we can \"remove\" items once taken.\n      grid = state.grid.copy()\n      height, width, _ = grid.shape\n      cur_pos = state.pos\n\n      # ------------------------------------------------------------------\n      # Helper utilities.\n      # ------------------------------------------------------------------\n      def find_cells(kind):\n          \"\"\"Return a list of (x, y) positions where `kind` is present.\"\"\"\n          pts = np.argwhere(grid[:, :, kind] > 0)\n          return [tuple(p) for p in pts]\n\n      # (dx, dy, action_index) \u2013 matches CraftWorld ordering:\n      # 0 = DOWN, 1 = UP, 2 = LEFT, 3 = RIGHT, 4 = USE\n      dirs = [\n          (1, 0, 0),   # DOWN\n          (-1, 0, 1),  # UP\n          (0, -1, 2),  # LEFT\n          (0, 1, 3),   # RIGHT\n      ]\n\n      def is_blocked(x, y):\n          \"\"\"True if cell (x, y) contains any non\u2011grabbable entity.\"\"\"\n          for idx in world.non_grabbable_indices:\n              if grid[x, y, idx] > 0:\n                  return True\n          return False\n\n      from collections import deque\n\n      def bfs(start, goal):\n          \"\"\"Bread\u2011first search returning a list of movement actions.\"\"\"\n          q = deque()\n          q.append((start, []))\n          visited = {start}\n          while q:\n              (cx, cy), path = q.popleft()\n              if (cx, cy) == goal:\n                  return path\n              for dx, dy, act in dirs:\n                  nx, ny = cx + dx, cy + dy\n                  if 0 <= nx < height and 0 <= ny < width and not is_blocked(nx, ny):\n                      if (nx, ny) not in visited:\n                          visited.add((nx, ny))\n                          q.append(((nx, ny), path + [act]))\n          # No path found \u2013 return empty list (will likely fail later).\n          return []\n\n      # ------------------------------------------------------------------\n      # Identify the stick item.\n      # ------------------------------------------------------------------\n      stick_idx = world.cookbook.index.index(\"stick\")\n      recipe = world.cookbook.recipes.get(stick_idx)\n\n      # If there is no recipe, stick is a primitive \u2013 just pick one up.\n      if recipe is None:\n          cells = find_cells(stick_idx)\n          if cells:\n              dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in cells]\n              target = cells[int(np.argmin(dists))]\n              actions.extend(bfs(cur_pos, target))\n              actions.append(4)  # USE to collect the stick\n          return actions\n\n      # ------------------------------------------------------------------\n      # Gather required primitive ingredients.\n      # ------------------------------------------------------------------\n      prim_requirements = world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n      for prim_idx, needed in prim_requirements.items():\n          for _ in range(needed):\n              cells = find_cells(prim_idx)\n              if not cells:\n                  # Required primitive not present \u2013 abort planning.\n                  return actions\n              # Choose the nearest occurrence (Manhattan distance).\n              dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in cells]\n              target = cells[int(np.argmin(dists))]\n              # Move to the primitive and pick it up.\n              actions.extend(bfs(cur_pos, target))\n              actions.append(4)  # USE\n              # Update local state.\n              cur_pos = target\n              grid[target[0], target[1], prim_idx] = 0\n\n      # ------------------------------------------------------------------\n      # Craft the stick at the appropriate workshop (if required).\n      # ------------------------------------------------------------------\n      workshop_kind = recipe.get(\"_at\")\n      if workshop_kind is not None:\n          ws_cells = find_cells(workshop_kind)\n          if ws_cells:\n              dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in ws_cells]\n              ws_target = ws_cells[int(np.argmin(dists))]\n              actions.extend(bfs(cur_pos, ws_target))\n              actions.append(4)  # USE to craft at the workshop\n      else:\n          # No specific workshop \u2013 craft at current location.\n          actions.append(4)\n\n      return actions\n  except Exception:\n      # In case of any unexpected error, return an empty plan.\n      return []", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:42:32.884382", "function_name": "make_stick", "function_body": "  try:\n      # Reset and obtain a fresh CraftState.\n      env.reset()\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          scenario = getattr(env, \"scenario\", None)\n          if scenario is not None:\n              state = scenario.init()\n      if state is None:\n          return []\n\n      world = state.world\n      grid = state.grid.copy()\n      h, w, _ = grid.shape\n\n      # ------------------------------------------------------------------\n      # Helpers.\n      # ------------------------------------------------------------------\n      def find_cells(kind):\n          \"\"\"Return list of (x, y) where `kind` is present in the current grid.\"\"\"\n          pts = np.argwhere(grid[:, :, kind] > 0)\n          return [tuple(p) for p in pts]\n\n      # (dx, dy, action) \u2013 matches CraftWorld ordering: DOWN=0, UP=1, LEFT=2, RIGHT=3\n      dirs = [(1, 0, 0), (-1, 0, 1), (0, -1, 2), (0, 1, 3)]\n\n      def blocked(x, y):\n          \"\"\"True if cell contains any non\u2011grabbable entity.\"\"\"\n          for idx in world.non_grabbable_indices:\n              if grid[x, y, idx] > 0:\n                  return True\n          return False\n\n      def bfs(start, goal):\n          \"\"\"Bread\u2011first search returning a list of movement actions from start to goal.\"\"\"\n          from collections import deque\n          q = deque([(start, [])])\n          visited = {start}\n          while q:\n              (cx, cy), path = q.popleft()\n              if (cx, cy) == goal:\n                  return path\n              for dx, dy, act in dirs:\n                  nx, ny = cx + dx, cy + dy\n                  if 0 <= nx < h and 0 <= ny < w and not blocked(nx, ny):\n                      if (nx, ny) not in visited:\n                          visited.add((nx, ny))\n                          q.append(((nx, ny), path + [act]))\n          return []  # no path found\n\n      actions = []\n      cur_pos = state.pos\n\n      # ------------------------------------------------------------------\n      # Identify stick recipe.\n      # ------------------------------------------------------------------\n      stick_idx = world.cookbook.index[\"stick\"]\n      prim_req = world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n\n      # ------------------------------------------------------------------\n      # Collect required primitives.\n      # ------------------------------------------------------------------\n      for prim_idx, cnt in prim_req.items():\n          for _ in range(cnt):\n              cells = find_cells(prim_idx)\n              if not cells:\n                  return []  # missing primitive \u2013 cannot continue\n              # choose nearest cell (Manhattan)\n              dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in cells]\n              target = cells[int(np.argmin(dists))]\n              actions.extend(bfs(cur_pos, target))\n              actions.append(4)  # USE to pick up\n              cur_pos = target\n              grid[target[0], target[1], prim_idx] = 0  # remove from local view\n\n      # ------------------------------------------------------------------\n      # Move to appropriate workshop (if recipe specifies one).\n      # ------------------------------------------------------------------\n      recipe = world.cookbook.recipes.get(stick_idx, {})\n      workshop_kind = recipe.get(\"_at\")\n      if workshop_kind is not None:\n          ws_cells = find_cells(workshop_kind)\n          if not ws_cells:\n              return []  # no workshop reachable\n          dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in ws_cells]\n          ws_target = ws_cells[int(np.argmin(dists))]\n          actions.extend(bfs(cur_pos, ws_target))\n          actions.append(4)  # USE to craft\n      else:\n          # No specific workshop \u2013 crafting can be done in place.\n          actions.append(4)\n\n      return actions\n  except Exception:\n      # Fallback: empty plan on any unexpected error.\n      return []", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:42:57.423579", "function_name": "make_stick", "function_body": "  # Reset environment and obtain the initial state.\n  env.reset()\n  state = env._current_state\n\n  # Action indices according to the environment spec.\n  act_spec = env.action_specs()\n  ACTION_USE = act_spec[\"USE\"]\n  ACTIONS_MOVE = {\n      \"UP\": act_spec[\"UP\"],\n      \"DOWN\": act_spec[\"DOWN\"],\n      \"LEFT\": act_spec[\"LEFT\"],\n      \"RIGHT\": act_spec[\"RIGHT\"],\n  }\n  DIR_VECT = {\n      \"UP\": (-1, 0),\n      \"DOWN\": (1, 0),\n      \"LEFT\": (0, -1),\n      \"RIGHT\": (0, 1),\n  }\n\n  # -----------------------------------------------------------------\n  # Helper: breadth\u2011first search returning a list of actions that moves\n  # from `start` to any cell in `targets`. Only empty cells are traversable.\n  # -----------------------------------------------------------------\n  from collections import deque\n\n  def bfs_path(start, targets):\n      h, w = state.grid.shape[:2]\n      visited = set()\n      q = deque([(start, [])])\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in visited:\n              continue\n          visited.add((x, y))\n          if (x, y) in targets:\n              return path\n          for name, (dx, dy) in DIR_VECT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < h and 0 <= ny < w:\n                  # Traversable iff no entity occupies the cell.\n                  if not state.grid[nx, ny].any():\n                      q.append(((nx, ny), path + [ACTIONS_MOVE[name]]))\n      return None\n\n  # -----------------------------------------------------------------\n  # 1. Determine the primitives required to craft a stick.\n  # -----------------------------------------------------------------\n  idx = state.world.cookbook.index\n  stick_idx = idx.index(\"stick\")\n  primitive_needs = state.world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n  actions = []\n\n  # -----------------------------------------------------------------\n  # 2. Collect each required primitive.\n  # -----------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      while state.inventory[prim_idx] < needed_cnt:\n          # Locate all cells that currently hold this primitive.\n          h, w = state.grid.shape[:2]\n          prim_cells = [(i, j)\n                        for i in range(h)\n                        for j in range(w)\n                        if state.grid[i, j, prim_idx] > 0]\n          if not prim_cells:\n              # No more of this primitive on the map \u2013 abort early.\n              return actions\n          # Find shortest path to any of them.\n          path = bfs_path(state.pos, set(prim_cells))\n          if path is None:\n              return actions\n          # Execute the moves.\n          for a in path:\n              _, state = state.step(a)\n              actions.append(a)\n          # Pick up the primitive.\n          _, state = state.step(ACTION_USE)\n          actions.append(ACTION_USE)\n\n  # -----------------------------------------------------------------\n  # 3. If the recipe requires a workshop, go there and craft.\n  # -----------------------------------------------------------------\n  recipe = state.world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\") if isinstance(recipe, dict) else None\n  if workshop_name:\n      workshop_idx = idx.index(workshop_name)\n      h, w = state.grid.shape[:2]\n      workshop_cells = [(i, j)\n                        for i in range(h)\n                        for j in range(w)\n                        if state.grid[i, j, workshop_idx] > 0]\n      if workshop_cells:\n          path = bfs_path(state.pos, set(workshop_cells))\n          if path:\n              for a in path:\n                  _, state = state.step(a)\n                  actions.append(a)\n              # Craft at the workshop.\n              _, state = state.step(ACTION_USE)\n              actions.append(ACTION_USE)\n\n  # -----------------------------------------------------------------\n  # 4. Return the accumulated list of actions.\n  # -----------------------------------------------------------------\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:42:58.522140", "function_name": "make_stick", "function_body": "", "env_interactions": 0, "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-10-21T18:43:25.025458", "function_name": "make_stick", "function_body": "  # Reset environment to a fresh episode\n  env.reset()\n\n  # Shortcut references\n  world = env.world\n  idx = world.cookbook.index\n\n  # ------------------------------------------------------------------\n  # Identify the goal item (stick) and its recipe\n  # ------------------------------------------------------------------\n  try:\n      stick_idx = idx[\"stick\"]\n  except Exception:  # pragma: no cover\n      # case\u2011insensitive fallback\n      stick_idx = next(i for i, n in enumerate(idx.ordered_contents) if n.lower() == \"stick\")\n\n  # Primitives required to craft a stick (empty if stick itself is primitive)\n  needed = world.cookbook.primitives_for(stick_idx)\n  if not needed:\n      needed = {stick_idx: 1}\n\n  # ------------------------------------------------------------------\n  # Action indices\n  # ------------------------------------------------------------------\n  action_map = env.action_specs()\n  DOWN = action_map[\"DOWN\"]\n  UP = action_map[\"UP\"]\n  LEFT = action_map[\"LEFT\"]\n  RIGHT = action_map[\"RIGHT\"]\n  USE = action_map[\"USE\"]\n\n  # ------------------------------------------------------------------\n  # Current state information\n  # ------------------------------------------------------------------\n  state = env._current_state\n  cur_pos = tuple(state.pos)          # (x, y)\n  grid = state.grid.copy()            # local copy for bookkeeping\n\n  # Cells blocked by non\u2011grabbable entities\n  non_grabbable = list(world.non_grabbable_indices)\n  if non_grabbable:\n      blocked_mask = np.any(grid[:, :, non_grabbable] > 0, axis=2)\n  else:\n      blocked_mask = np.zeros(grid.shape[:2], dtype=bool)\n\n  # ------------------------------------------------------------------\n  # Helper: BFS returning a list of actions to reach any cell in *targets*\n  # ------------------------------------------------------------------\n  def bfs_path(start, targets, blocked):\n      \"\"\"Breadth\u2011first search returning actions to the nearest target.\"\"\"\n      if start in targets:\n          return []\n      q = collections.deque([start])\n      visited = {start: (None, None)}          # cell -> (parent, action)\n      moves = [(DOWN, (0, 1)), (UP, (0, -1)),\n               (LEFT, (-1, 0)), (RIGHT, (1, 0))]\n      while q:\n          cur = q.popleft()\n          for act, (dx, dy) in moves:\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if not (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]):\n                  continue\n              if blocked[nx, ny]:\n                  continue\n              nxt = (nx, ny)\n              if nxt in visited:\n                  continue\n              visited[nxt] = (cur, act)\n              if nxt in targets:\n                  # reconstruct path\n                  path = []\n                  node = nxt\n                  while visited[node][0] is not None:\n                      parent, a = visited[node]\n                      path.append(a)\n                      node = parent\n                  return list(reversed(path))\n              q.append(nxt)\n      # Fallback to Manhattan moves if BFS fails\n      tx, ty = next(iter(targets))\n      return manhattan_moves(start, (tx, ty))\n\n  # ------------------------------------------------------------------\n  # Helper: Manhattan moves (used as fallback)\n  # ------------------------------------------------------------------\n  def manhattan_moves(start, goal):\n      x, y = start\n      gx, gy = goal\n      moves = []\n      while x < gx:\n          moves.append(RIGHT); x += 1\n      while x > gx:\n          moves.append(LEFT); x -= 1\n      while y < gy:\n          moves.append(DOWN); y += 1\n      while y > gy:\n          moves.append(UP); y -= 1\n      return moves\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives / items\n  # ------------------------------------------------------------------\n  for item_idx, required_cnt in needed.items():\n      required_cnt = int(required_cnt)\n      while required_cnt > 0:\n          # locate cells containing the required item\n          locs = np.argwhere(grid[:, :, item_idx] > 0)\n          if locs.size == 0:\n              # no more of this item on the map \u2013 break to avoid infinite loop\n              break\n          # choose the closest location (Manhattan distance)\n          dists = np.abs(locs[:, 0] - cur_pos[0]) + np.abs(locs[:, 1] - cur_pos[1])\n          target = tuple(locs[dists.argmin()])\n\n          # compute path avoiding blocked cells\n          path = bfs_path(cur_pos, {target}, blocked_mask)\n          actions.extend(path)\n          cur_pos = target\n\n          # pick up the item\n          actions.append(USE)\n          required_cnt -= 1\n\n          # update simulated grid and blocked mask\n          grid[target[0], target[1], item_idx] -= 1\n          if non_grabbable:\n              blocked_mask[target[0], target[1]] = np.any(\n                  grid[target[0], target[1], non_grabbable] > 0\n              )\n          else:\n              blocked_mask[target[0], target[1]] = False\n\n  # ------------------------------------------------------------------\n  # 2. Move to workshop (if required) and craft the stick\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = idx[workshop_name]\n      ws_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_locs.size:\n          ws_target = tuple(ws_locs[0])\n          path = bfs_path(cur_pos, {ws_target}, blocked_mask)\n          actions.extend(path)\n          cur_pos = ws_target\n          actions.append(USE)   # craft at the workshop\n\n  return actions", "env_interactions": 4, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:43:26.147667", "function_name": "make_stick", "function_body": "  # Reset the environment to start a fresh episode\n  env.reset()\n  world = env.world\n  idx = world.cookbook.index\n\n  # ------------------------------------------------------------------\n  # Identify the goal (stick) and its recipe\n  # ------------------------------------------------------------------\n  try:\n      stick_idx = idx[\"stick\"]\n  except Exception:  # pragma: no cover\n      # case\u2011insensitive fallback\n      stick_idx = next(i for i, n in enumerate(idx.ordered_contents) if n.lower() == \"stick\")\n  stick_recipe = world.cookbook.recipes.get(stick_idx, {})\n\n  # ------------------------------------------------------------------\n  # Determine which primitives (or items) are required to obtain a stick\n  # ------------------------------------------------------------------\n  needed = world.cookbook.primitives_for(stick_idx)\n  if not needed:\n      # stick itself is a primitive; just need to pick up one\n      needed = {stick_idx: 1}\n\n  # ------------------------------------------------------------------\n  # Action indices\n  # ------------------------------------------------------------------\n  action_map = env.action_specs()\n  DOWN = action_map[\"DOWN\"]\n  UP = action_map[\"UP\"]\n  LEFT = action_map[\"LEFT\"]\n  RIGHT = action_map[\"RIGHT\"]\n  USE = action_map[\"USE\"]\n\n  # ------------------------------------------------------------------\n  # Current state information\n  # ------------------------------------------------------------------\n  state = env._current_state\n  cur_pos = tuple(state.pos)                # (x, y)\n  grid = state.grid.copy()                  # local copy for bookkeeping\n\n  # Mask of cells blocked by non\u2011grabbable entities\n  non_grabbable = list(world.non_grabbable_indices)\n  if non_grabbable:\n      blocked_mask = np.any(grid[:, :, non_grabbable] > 0, axis=2)\n  else:\n      blocked_mask = np.zeros(grid.shape[:2], dtype=bool)\n\n  # ------------------------------------------------------------------\n  # Helper functions\n  # ------------------------------------------------------------------\n  import collections\n\n  def bfs_path(start, targets, blocked):\n      \"\"\"Breadth\u2011first search returning a list of actions from *start* to any cell in *targets*.\"\"\"\n      if start in targets:\n          return []\n      q = collections.deque([start])\n      visited = {start: (None, None)}  # cell -> (parent, action)\n      while q:\n          cur = q.popleft()\n          for act, (dx, dy) in [(DOWN, (0, 1)), (UP, (0, -1)),\n                                (LEFT, (-1, 0)), (RIGHT, (1, 0))]:\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if not (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]):\n                  continue\n              if blocked[nx, ny]:\n                  continue\n              nxt = (nx, ny)\n              if nxt in visited:\n                  continue\n              visited[nxt] = (cur, act)\n              if nxt in targets:\n                  # reconstruct path\n                  path = []\n                  node = nxt\n                  while visited[node][0] is not None:\n                      parent, a = visited[node]\n                      path.append(a)\n                      node = parent\n                  return list(reversed(path))\n              q.append(nxt)\n      # Fallback to Manhattan moves if BFS fails\n      tx, ty = next(iter(targets))\n      return manhattan_moves(start, (tx, ty))\n\n  def manhattan_moves(start, goal):\n      \"\"\"Simple Manhattan move sequence (ignores obstacles).\"\"\"\n      x, y = start\n      gx, gy = goal\n      moves = []\n      while x < gx:\n          moves.append(RIGHT)\n          x += 1\n      while x > gx:\n          moves.append(LEFT)\n          x -= 1\n      while y < gy:\n          moves.append(DOWN)\n          y += 1\n      while y > gy:\n          moves.append(UP)\n          y -= 1\n      return moves\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives / items\n  # ------------------------------------------------------------------\n  for item_idx, need_cnt in needed.items():\n      need_cnt = int(need_cnt)\n      while need_cnt > 0:\n          locations = np.argwhere(grid[:, :, item_idx] > 0)\n          if locations.size == 0:\n              # No more of this item on the map \u2013 break to avoid infinite loop\n              break\n          # Choose the closest location (Manhattan distance heuristic)\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          target = tuple(locations[dists.argmin()])\n\n          # Move to the target avoiding blocked cells\n          path = bfs_path(cur_pos, {target}, blocked_mask)\n          actions.extend(path)\n          cur_pos = target\n\n          # Pick up the item\n          actions.append(USE)\n          need_cnt -= 1\n\n          # Update simulated grid and blocked mask\n          grid[target[0], target[1], item_idx] -= 1\n          if grid[target[0], target[1], item_idx] == 0:\n              if non_grabbable:\n                  blocked_mask[target[0], target[1]] = np.any(\n                      grid[target[0], target[1], non_grabbable] > 0\n                  )\n              else:\n                  blocked_mask[target[0], target[1]] = False\n\n  # ------------------------------------------------------------------\n  # 2. Move to workshop (if required) and craft the stick\n  # ------------------------------------------------------------------\n  workshop_name = stick_recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = idx[workshop_name]\n      ws_locations = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_locations.size > 0:\n          ws_target = tuple(ws_locations[0])\n          path = bfs_path(cur_pos, {ws_target}, blocked_mask)\n          actions.extend(path)\n          cur_pos = ws_target\n          actions.append(USE)   # craft at the workshop\n\n  return actions", "env_interactions": 4, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:43:56.764359", "function_name": "make_stick", "function_body": "  actions = []\n  world = env.world\n  state = env._current_state\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def move_action(cur, nxt):\n      \"\"\"Return action index that moves from cur to nxt (one step).\"\"\"\n      dx = nxt[0] - cur[0]\n      dy = nxt[1] - cur[1]\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise ValueError(\"Invalid move step\")\n\n  import collections\n\n  def bfs_to_adjacent(start, targets, grid):\n      \"\"\"\n      Bread\u2011first search for the shortest path from start to any empty cell\n      that is orthogonally adjacent to one of the target cells.\n      Returns (path, target_cell) where path is a list of positions\n      (including start) and target_cell is the specific target we ended up\n      adjacent to.\n      \"\"\"\n      W, H, _ = grid.shape\n      visited = np.full((W, H), False, dtype=bool)\n      q = collections.deque()\n      q.append((start, [start]))\n      visited[start] = True\n      target_set = {tuple(t) for t in targets}\n\n      while q:\n          (x, y), path = q.popleft()\n          # Is current cell adjacent to any target?\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path, (tx, ty)\n\n          # Expand neighbours\n          for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  # walk only through empty cells\n                  if grid[nx, ny, :].sum() == 0:\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [(nx, ny)]))\n\n      raise RuntimeError(\"No reachable adjacent cell\")\n\n  # ------------------------------------------------------------------\n  # 1) Determine what primitives are needed for a stick\n  # ------------------------------------------------------------------\n  stick_idx = world.cookbook.index[\"stick\"]\n  if state.inventory[stick_idx] > 0:\n      return actions\n\n  primitive_requirements = world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n  cur_pos = tuple(state.pos)\n\n  # ------------------------------------------------------------------\n  # 2) Collect each required primitive\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_requirements.items():\n      for _ in range(needed_cnt):\n          # locate remaining instances of this primitive\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(\"Required primitive not found on the map\")\n\n          # find path to an empty cell adjacent to one of the primitives\n          path, target = bfs_to_adjacent(cur_pos, prim_cells, state.grid)\n\n          # follow the path\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n\n          # set facing direction towards the primitive (a move into the blocked cell\n          # updates direction without changing position)\n          actions.append(move_action(cur_pos, target))\n\n          # pick it up\n          actions.append(4)  # USE\n\n          # remove it from the simulated grid so we don't target it again\n          state.grid[target[0], target[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 3) Move to the appropriate workshop and craft the stick\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      wk_idx = world.cookbook.index[workshop_name]\n      wk_cells = np.argwhere(state.grid[:, :, wk_idx] > 0)\n      if wk_cells.size == 0:\n          raise RuntimeError(\"Workshop for stick not found\")\n      path, _ = bfs_to_adjacent(cur_pos, wk_cells, state.grid)\n      for step in path[1:]:\n          actions.append(move_action(cur_pos, step))\n          cur_pos = step\n\n  # final USE to craft\n  actions.append(4)\n\n  return actions", "env_interactions": 4, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:43:58.049535", "function_name": "make_stick", "function_body": "  actions = []\n  world = env.world\n  state = env._current_state\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def move_action(cur, nxt):\n      \"\"\"Convert a step from cur to nxt into an action index.\"\"\"\n      dx = nxt[0] - cur[0]\n      dy = nxt[1] - cur[1]\n      if dx == 1:\n          return 3  # RIGHT\n      if dx == -1:\n          return 2  # LEFT\n      if dy == 1:\n          return 0  # DOWN\n      if dy == -1:\n          return 1  # UP\n      raise ValueError(\"Invalid move step\")\n\n  def bfs_adjacent(start, target_cells, grid):\n      \"\"\"\n      Bread\u2011first search for the shortest path from start to any empty cell\n      that is orthogonally adjacent to one of the target_cells.\n      Returns a list of positions including start and the destination.\n      \"\"\"\n      W, H, _ = grid.shape\n      visited = np.full((W, H), False, dtype=bool)\n      q = collections.deque()\n      q.append((start, [start]))\n      visited[start] = True\n      target_set = {tuple(t) for t in target_cells}\n\n      while q:\n          (x, y), path = q.popleft()\n          # If we are next to any target, stop.\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n          # Expand neighbours.\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  # Can step only on empty cells.\n                  if grid[nx, ny, :].sum() == 0:\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [(nx, ny)]))\n      raise RuntimeError(\"No reachable adjacent cell found\")\n\n  # ------------------------------------------------------------------\n  # 1) Identify stick and its recipe.\n  # ------------------------------------------------------------------\n  stick_idx = world.cookbook.index[\"stick\"]\n  if state.inventory[stick_idx] > 0:\n      return actions  # already have a stick\n\n  primitive_req = world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n  cur_pos = tuple(state.pos)\n\n  # ------------------------------------------------------------------\n  # 2) Collect each required primitive.\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitive_req.items():\n      for _ in range(needed):\n          # Skip if we already hold the primitive.\n          if state.inventory[prim_idx] > 0:\n              continue\n\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(\"Required primitive not present on the map\")\n\n          # Find path to an empty cell adjacent to the primitive.\n          path = bfs_adjacent(cur_pos, prim_cells, state.grid)\n\n          # Translate path into actions.\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n\n          # Pick up the primitive.\n          actions.append(4)  # USE\n          # Simulate removal so we don't target it again.\n          cell = prim_cells[0]\n          state.grid[cell[0], cell[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 3) Move to the appropriate workshop (if any) and craft the stick.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          raise RuntimeError(\"Workshop for stick not found in the world\")\n      path = bfs_adjacent(cur_pos, workshop_cells, state.grid)\n      for step in path[1:]:\n          actions.append(move_action(cur_pos, step))\n          cur_pos = step\n\n  # Finally, use the workshop (or current cell) to craft.\n  actions.append(4)  # USE\n\n  return actions", "env_interactions": 3, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:44:24.311093", "function_name": "make_stick", "function_body": "  actions = []\n  try:\n      # Reset the environment to start a fresh episode.\n      env.reset()\n      # Obtain the current CraftState (different wrappers expose it differently).\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          scenario = getattr(env, \"scenario\", None)\n          if scenario is not None:\n              state = scenario.init()\n      if state is None:\n          return actions\n\n      world = state.world\n      grid = state.grid\n      height, width, _ = grid.shape\n\n      # ------------------------------------------------------------------\n      # Helper utilities.\n      # ------------------------------------------------------------------\n      # Action indices for movement (order matches CraftWorld convention).\n      dirs = [(1, 0, 0),   # DOWN\n              (-1, 0, 1),  # UP\n              (0, -1, 2),  # LEFT\n              (0, 1, 3)]   # RIGHT\n\n      def is_blocked(x, y):\n          \"\"\"Return True if cell (x, y) contains a non\u2011grabbable entity.\"\"\"\n          for idx in world.non_grabbable_indices:\n              if grid[x, y, idx] > 0:\n                  return True\n          return False\n\n      def bfs(start, goal):\n          \"\"\"Bread\u2011first search returning a list of movement actions from start to goal.\"\"\"\n          from collections import deque\n          q = deque()\n          q.append((start, []))\n          visited = {start}\n          while q:\n              (cx, cy), path = q.popleft()\n              if (cx, cy) == goal:\n                  return path\n              for dx, dy, act in dirs:\n                  nx, ny = cx + dx, cy + dy\n                  if 0 <= nx < height and 0 <= ny < width and not is_blocked(nx, ny):\n                      if (nx, ny) not in visited:\n                          visited.add((nx, ny))\n                          q.append(((nx, ny), path + [act]))\n          return []  # should not happen on a valid map\n\n      def find_cells(kind):\n          \"\"\"Return a list of (x, y) positions where `kind` is present.\"\"\"\n          pos = np.argwhere(grid[:, :, kind] > 0)\n          return [tuple(p) for p in pos]\n\n      # ------------------------------------------------------------------\n      # Identify the stick item and its recipe.\n      # ------------------------------------------------------------------\n      stick_idx = world.cookbook.index.index(\"stick\")\n      primitive_reqs = world.cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n      stick_recipe = world.cookbook.recipes.get(stick_idx, {})\n      workshop_idx = stick_recipe.get(\"_at\", None)\n\n      cur_pos = state.pos\n\n      # ------------------------------------------------------------------\n      # Collect all required primitive resources.\n      # ------------------------------------------------------------------\n      for prim_idx, needed in primitive_reqs.items():\n          for _ in range(needed):\n              cells = find_cells(prim_idx)\n              if not cells:\n                  continue  # primitive not on map; skip\n              # Choose the nearest occurrence (Manhattan distance).\n              dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in cells]\n              target = cells[int(np.argmin(dists))]\n              actions.extend(bfs(cur_pos, target))\n              actions.append(4)  # USE to pick up the primitive\n              cur_pos = target\n\n      # ------------------------------------------------------------------\n      # If stick itself is a primitive and we don't already have it, pick it up.\n      # ------------------------------------------------------------------\n      if not primitive_reqs and state.inventory[stick_idx] == 0:\n          stick_cells = find_cells(stick_idx)\n          if stick_cells:\n              dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in stick_cells]\n              target = stick_cells[int(np.argmin(dists))]\n              actions.extend(bfs(cur_pos, target))\n              actions.append(4)  # USE to pick up the stick\n              cur_pos = target\n\n      # ------------------------------------------------------------------\n      # If a workshop is required, go there and craft the stick.\n      # ------------------------------------------------------------------\n      if workshop_idx is not None:\n          workshop_cells = find_cells(workshop_idx)\n          if workshop_cells:\n              dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in workshop_cells]\n              target_ws = workshop_cells[int(np.argmin(dists))]\n              actions.extend(bfs(cur_pos, target_ws))\n              actions.append(4)  # USE to craft the stick at the workshop\n\n      return actions\n  except Exception:\n      # On any unexpected error, return an empty plan.\n      return []", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:44:25.425473", "function_name": "make_stick", "function_body": "  actions = []\n  try:\n      # Reset the environment and obtain the current CraftState.\n      env.reset()\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          scenario = getattr(env, \"scenario\", None)\n          if scenario is not None:\n              state = scenario.init()\n      if state is None:\n          return actions\n\n      world = state.world\n      grid = state.grid\n      height, width, _ = grid.shape\n\n      # ------------------------------------------------------------------\n      # Helper utilities.\n      # ------------------------------------------------------------------\n      # (dx, dy, action_index) \u2013 order matches CraftWorld convention.\n      dirs = [(1, 0, 0),   # DOWN\n              (-1, 0, 1),  # UP\n              (0, -1, 2),  # LEFT\n              (0, 1, 3)]   # RIGHT\n\n      def is_blocked(x, y):\n          \"\"\"Return True if (x, y) contains a non\u2011grabbable entity.\"\"\"\n          for idx in world.non_grabbable_indices:\n              if grid[x, y, idx] > 0:\n                  return True\n          return False\n\n      from collections import deque\n      def bfs(start, goal):\n          \"\"\"Bread\u2011first search returning a list of movement actions.\"\"\"\n          q = deque()\n          q.append((start, []))\n          visited = {start}\n          while q:\n              (cx, cy), path = q.popleft()\n              if (cx, cy) == goal:\n                  return path\n              for dx, dy, act in dirs:\n                  nx, ny = cx + dx, cy + dy\n                  if 0 <= nx < height and 0 <= ny < width and not is_blocked(nx, ny):\n                      if (nx, ny) not in visited:\n                          visited.add((nx, ny))\n                          q.append(((nx, ny), path + [act]))\n          return []  # should not happen on a valid map\n\n      def find_cells(kind):\n          \"\"\"Return list of (x, y) where `kind` is present in the grid.\"\"\"\n          positions = np.argwhere(grid[:, :, kind] > 0)\n          return [tuple(p) for p in positions]\n\n      # ------------------------------------------------------------------\n      # Determine the recipe for a stick.\n      # ------------------------------------------------------------------\n      stick_idx = world.cookbook.index.index(\"stick\")\n      primitive_reqs = world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n      stick_recipe = world.cookbook.recipes.get(stick_idx, {})\n      workshop_idx = stick_recipe.get(\"_at\", None)\n\n      cur_pos = state.pos\n\n      # ------------------------------------------------------------------\n      # Collect all required primitives.\n      # ------------------------------------------------------------------\n      for prim_idx, needed in primitive_reqs.items():\n          for _ in range(needed):\n              cells = find_cells(prim_idx)\n              if not cells:\n                  # Primitive missing \u2013 abort planning.\n                  return actions\n              # Choose the nearest occurrence (Manhattan distance).\n              dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in cells]\n              target = cells[int(np.argmin(dists))]\n              actions.extend(bfs(cur_pos, target))\n              actions.append(4)  # USE to pick up the primitive\n              cur_pos = target\n              # Update local copy so we don't try to pick the same cell again.\n              grid[target[0], target[1], prim_idx] = 0\n\n      # ------------------------------------------------------------------\n      # If the stick itself is a primitive and we don't already have it,\n      # pick it up now.\n      # ------------------------------------------------------------------\n      if not primitive_reqs and state.inventory[stick_idx] == 0:\n          stick_cells = find_cells(stick_idx)\n          if stick_cells:\n              dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in stick_cells]\n              target = stick_cells[int(np.argmin(dists))]\n              actions.extend(bfs(cur_pos, target))\n              actions.append(4)  # USE to pick up the stick\n              cur_pos = target\n\n      # ------------------------------------------------------------------\n      # Go to the required workshop (if any) and craft the stick.\n      # ------------------------------------------------------------------\n      if workshop_idx is not None:\n          ws_cells = find_cells(workshop_idx)\n          if ws_cells:\n              dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in ws_cells]\n              target_ws = ws_cells[int(np.argmin(dists))]\n              actions.extend(bfs(cur_pos, target_ws))\n              actions.append(4)  # USE to perform the crafting action\n\n      return actions\n  except Exception:\n      # In case of any unexpected issue, return an empty plan.\n      return []", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:45:04.124111", "function_name": "make_stick", "function_body": "", "env_interactions": 0, "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-10-21T18:45:05.238982", "function_name": "make_stick", "function_body": "  # reset environment and get initial state\n  obs = env.reset()\n  state = env._current_state\n\n  # mappings for actions\n  act_map = env.action_specs()          # e.g., {\"DOWN\":0, \"UP\":1, ...}\n  inv_act = {v: k for k, v in act_map.items()}\n\n  # indices for items\n  idx = env.world.cookbook.index\n  stick_idx = idx[\"stick\"]\n  non_grabbable = env.world.non_grabbable_indices\n\n  # utility: check if a cell is traversable (no non\u2011grabbable entity)\n  def traversable(pos):\n      x, y = pos\n      return not any(state.grid[x, y, k] > 0 for k in non_grabbable)\n\n  # BFS to the nearest target (or any target in a set)\n  from collections import deque\n\n  def bfs(start, target_set):\n      q = deque([start])\n      prev = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur in target_set:\n              # reconstruct path\n              path = []\n              while cur is not None:\n                  path.append(cur)\n                  cur = prev[cur]\n              path.reverse()\n              return path\n          for dx, dy in ((-1, 0), (1, 0), (0, -1), (0, 1)):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                  nxt = (nx, ny)\n                  if nxt not in prev and traversable(nxt):\n                      prev[nxt] = cur\n                      q.append(nxt)\n      return None\n\n  # translate a move between two adjacent cells into an action index\n  def move_action(p, q):\n      dx, dy = q[0] - p[0], q[1] - p[1]\n      if (dx, dy) == (-1, 0):\n          return act_map[\"UP\"]\n      if (dx, dy) == (1, 0):\n          return act_map[\"DOWN\"]\n      if (dx, dy) == (0, -1):\n          return act_map[\"LEFT\"]\n      if (dx, dy) == (0, 1):\n          return act_map[\"RIGHT\"]\n      raise ValueError(\"non\u2011adjacent cells\")\n\n  # helper: face a target cell from current position (by a little back\u2011and\u2011forth)\n  def face_target(cur_pos, target_pos):\n      dx, dy = target_pos[0] - cur_pos[0], target_pos[1] - cur_pos[1]\n      if (dx, dy) == (-1, 0):\n          needed = act_map[\"UP\"]\n      elif (dx, dy) == (1, 0):\n          needed = act_map[\"DOWN\"]\n      elif (dx, dy) == (0, -1):\n          needed = act_map[\"LEFT\"]\n      elif (dx, dy) == (0, 1):\n          needed = act_map[\"RIGHT\"]\n      else:\n          return []  # already facing or same cell\n\n      # to change direction we step one cell opposite then back\n      opp = {\"UP\": \"DOWN\", \"DOWN\": \"UP\", \"LEFT\": \"RIGHT\", \"RIGHT\": \"LEFT\"}\n      opp_dir = opp[inv_act[needed]]\n      opp_act = act_map[opp_dir]\n\n      actions = []\n      # try moving opposite if possible\n      ox, oy = cur_pos[0] - dx, cur_pos[1] - dy\n      if 0 <= ox < state.grid.shape[0] and 0 <= oy < state.grid.shape[1] and traversable((ox, oy)):\n          actions.append(opp_act)\n      else:\n          # dummy turn: any move that stays in place (e.g., LEFT then RIGHT)\n          dummy = act_map[\"LEFT\"]\n          actions.append(dummy)\n      actions.append(needed)\n      return actions\n\n  # gather required primitives for a stick (if any)\n  needed = env.world.cookbook.primitives_for(stick_idx)  # dict {prim_idx: count}\n  # if no recipe (stick is primitive) just look for stick itself\n  if not needed:\n      needed = {stick_idx: 1}\n\n  actions = []\n\n  # main loop: collect required primitives\n  while any(state.inventory.get(k, 0) < v for k, v in needed.items()):\n      # pick a primitive we still need\n      for prim_idx, req_cnt in needed.items():\n          have = state.inventory[prim_idx] if hasattr(state.inventory, \"__getitem__\") else 0\n          if have >= req_cnt:\n              continue\n          # locate all cells containing this primitive\n          xs, ys = np.where(state.grid[:, :, prim_idx] > 0)\n          positions = list(zip(xs.tolist(), ys.tolist()))\n          if not positions:\n              continue  # cannot find, skip\n          # choose nearest\n          cur = state.pos\n          target = min(positions,\n                       key=lambda p: abs(p[0] - cur[0]) + abs(p[1] - cur[1]))\n          # compute reachable adjacent cells to target\n          adj = []\n          for dx, dy in ((-1, 0), (1, 0), (0, -1), (0, 1)):\n              ax, ay = target[0] + dx, target[1] + dy\n              if 0 <= ax < state.grid.shape[0] and 0 <= ay < state.grid.shape[1]:\n                  if traversable((ax, ay)):\n                      adj.append((ax, ay))\n          path = bfs(cur, set(adj))\n          if path is None:\n              continue  # cannot reach, skip\n\n          # follow path\n          for i in range(1, len(path)):\n              a = move_action(path[i - 1], path[i])\n              actions.append(a)\n              _, state = env.step(a)\n              env._current_state = state\n\n          # now adjacent; adjust facing\n          actions.extend(face_target(state.pos, target))\n          for a in actions[-2:]:  # apply the facing moves to update state\n              _, state = env.step(a)\n              env._current_state = state\n\n          # use to pick up\n          actions.append(act_map[\"USE\"])\n          _, state = env.step(act_map[\"USE\"])\n          env._current_state = state\n          break  # re\u2011evaluate inventory\n\n  # after we have all primitives, craft the stick if needed\n  if state.inventory[stick_idx] == 0:\n      # find workshop required for stick (if any)\n      recipe = env.world.cookbook.recipes.get(stick_idx, {})\n      workshop_idx = None\n      for k, v in recipe.items():\n          if k == \"_at\":\n              workshop_idx = v\n              break\n      if workshop_idx is None:\n          # try to infer workshop by looking for any workshop entity on map\n          # (any non\u2011grabbable that is not water/stone)\n          possible = list(env.world.workshop_indices)\n          if possible:\n              workshop_idx = possible[0]\n      if workshop_idx is not None:\n          xs, ys = np.where(state.grid[:, :, workshop_idx] > 0)\n          ws = list(zip(xs.tolist(), ys.tolist()))\n          if ws:\n              cur = state.pos\n              target = min(ws,\n                           key=lambda p: abs(p[0] - cur[0]) + abs(p[1] - cur[1]))\n              # adjacent cells\n              adj = []\n              for dx, dy in ((-1, 0), (1, 0), (0, -1), (0, 1)):\n                  ax, ay = target[0] + dx, target[1] + dy\n                  if 0 <= ax < state.grid.shape[0] and 0 <= ay < state.grid.shape[1]:\n                      if traversable((ax, ay)):\n                          adj.append((ax, ay))\n              path = bfs(cur, set(adj))\n              if path:\n                  for i in range(1, len(path)):\n                      a = move_action(path[i - 1], path[i])\n                      actions.append(a)\n                      _, state = env.step(a)\n                      env._current_state = state\n                  # face workshop\n                  actions.extend(face_target(state.pos, target))\n                  for a in actions[-2:]:\n                      _, state = env.step(a)\n                      env._current_state = state\n                  # use to craft\n                  actions.append(act_map[\"USE\"])\n                  _, state = env.step(act_map[\"USE\"])\n                  env._current_state = state\n\n  return actions", "env_interactions": 0, "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-10-21T18:45:22.964000", "function_name": "make_stick", "function_body": "  # Reset environment and obtain initial state\n  env.reset()\n  state = env._current_state\n\n  # Index of the goal item we need to craft\n  goal_idx = env.task.goal\n\n  # Primitive requirements for the goal (expanded to primitive-only counts)\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)\n\n  # ----------------------------------------------------------------------\n  # Helper: move the agent from its current position to a target cell using\n  # Manhattan moves (DOWN=0, UP=1, LEFT=2, RIGHT=3).  The function returns the\n  # list of actions taken and updates the external `state` variable.\n  # ----------------------------------------------------------------------\n  def _move_to(target):\n      nonlocal state\n      actions = []\n      while tuple(state.pos) != tuple(target):\n          r, c = state.pos\n          tr, tc = target\n          if r < tr:\n              act = 0          # DOWN\n          elif r > tr:\n              act = 1          # UP\n          elif c < tc:\n              act = 3          # RIGHT\n          else:\n              act = 2          # LEFT\n          actions.append(act)\n          _, state = env.step(act)\n      return actions\n\n  plan = []\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive the necessary number of times.\n  # ----------------------------------------------------------------------\n  for prim_idx, count in primitives_needed.items():\n      for _ in range(count):\n          # Locate all cells that currently contain the primitive.\n          locs = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if locs.size == 0:\n              # No instance found \u2013 give up (should not happen in well\u2011formed\n              # scenarios).  Break out of loops.\n              return plan\n          # Choose the closest instance (Manhattan distance).\n          cur = np.array(state.pos)\n          dists = np.abs(locs - cur).sum(axis=1)\n          target = tuple(locs[dists.argmin()])\n\n          # Move to the primitive and pick it up.\n          plan.extend(_move_to(target))\n          plan.append(4)                     # USE to collect\n          _, state = env.step(4)\n\n  # ----------------------------------------------------------------------\n  # After gathering primitives, go to the appropriate workshop (if any) and\n  # perform the crafting action.\n  # ----------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = recipe.get(\"_at\", None)\n  if workshop_idx is not None:\n      # Find workshop locations on the grid.\n      w_locs = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if w_locs.size > 0:\n          cur = np.array(state.pos)\n          dists = np.abs(w_locs - cur).sum(axis=1)\n          target = tuple(w_locs[dists.argmin()])\n          plan.extend(_move_to(target))\n          plan.append(4)                     # USE to craft at workshop\n          _, state = env.step(4)\n\n  # Return the complete action sequence.\n  return plan", "env_interactions": 0, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:45:24.074388", "function_name": "make_stick", "function_body": "  # Reset the environment and get the initial state\n  env.reset()\n  state = env._current_state\n\n  # Index of the goal item (stick)\n  goal_idx = env.task.goal\n\n  # Mapping from primitive kind index to how many are needed for one stick\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)\n\n  # ----------------------------------------------------------------------\n  # Helper: move the agent to a target cell using Manhattan moves.\n  # It updates the outer `state` variable after each step.\n  # ----------------------------------------------------------------------\n  def _move_to(target):\n      actions = []\n      nonlocal state\n      while tuple(state.pos) != tuple(target):\n          r, c = state.pos\n          tr, tc = target\n          if r < tr:\n              act = 0          # DOWN\n          elif r > tr:\n              act = 1          # UP\n          elif c < tc:\n              act = 3          # RIGHT\n          else:\n              act = 2          # LEFT\n          actions.append(act)\n          _, new_state = env.step(act)\n          state = new_state\n      return actions\n\n  plan = []\n\n  # --------------------------------------------------------------\n  # 1. Collect all required primitives (in the quantities needed)\n  # --------------------------------------------------------------\n  for prim_idx, count in primitives_needed.items():\n      for _ in range(count):\n          # Find all cells that currently contain this primitive\n          locations = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if locations.shape[0] == 0:\n              # No more instances left \u2013 this should not happen in a solvable scenario\n              continue\n\n          # Choose the closest instance (Manhattan distance)\n          cur_pos = np.array(state.pos)\n          dists = np.abs(locations - cur_pos).sum(axis=1)\n          target = tuple(locations[dists.argmin()])\n\n          # Move to the primitive and pick it up (USE)\n          plan.extend(_move_to(target))\n          plan.append(4)                     # USE action\n          _, new_state = env.step(4)\n          state = new_state\n\n  # --------------------------------------------------------------\n  # 2. Go to the required workshop (if any) and craft the stick\n  # --------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = recipe.get(\"_at\", None)\n\n  if workshop_idx is not None:\n      # Locate all workshop cells of the required type\n      workshop_locs = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_locs.shape[0] > 0:\n          cur_pos = np.array(state.pos)\n          dists = np.abs(workshop_locs - cur_pos).sum(axis=1)\n          target = tuple(workshop_locs[dists.argmin()])\n\n          # Move to the workshop and use the crafting action\n          plan.extend(_move_to(target))\n          plan.append(4)                     # USE to craft\n          _, new_state = env.step(4)\n          state = new_state\n\n  # Return the complete list of action indices that will make a stick\n  return plan", "env_interactions": 0, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:45:48.685082", "function_name": "make_stick", "function_body": "  # reset environment and obtain world information\n  env.reset()\n  world = env.world\n  idx = world.cookbook.index\n\n  # --------------------------------------------------------------\n  # Identify the goal item (stick) and its recipe\n  # --------------------------------------------------------------\n  try:\n      stick_idx = idx[\"stick\"]\n  except Exception:  # pragma: no cover\n      stick_idx = next(i for i, n in enumerate(idx.ordered_contents) if n.lower() == \"stick\")\n  stick_recipe = world.cookbook.recipes.get(stick_idx, {})\n\n  # --------------------------------------------------------------\n  # Determine which primitives / items are required to craft a stick\n  # --------------------------------------------------------------\n  needed = world.cookbook.primitives_for(stick_idx)\n  if not needed:                     # stick itself is a primitive\n      needed = {stick_idx: 1}\n\n  # --------------------------------------------------------------\n  # Action indices\n  # --------------------------------------------------------------\n  action_map = env.action_specs()\n  DOWN = action_map[\"DOWN\"]\n  UP = action_map[\"UP\"]\n  LEFT = action_map[\"LEFT\"]\n  RIGHT = action_map[\"RIGHT\"]\n  USE = action_map[\"USE\"]\n\n  # --------------------------------------------------------------\n  # Helper utilities\n  # --------------------------------------------------------------\n  import collections\n\n  def manhattan_path(start, goal):\n      \"\"\"Simple Manhattan moves ignoring obstacles.\"\"\"\n      x, y = start\n      gx, gy = goal\n      moves = []\n      while x < gx:\n          moves.append(RIGHT); x += 1\n      while x > gx:\n          moves.append(LEFT); x -= 1\n      while y < gy:\n          moves.append(DOWN); y += 1\n      while y > gy:\n          moves.append(UP); y -= 1\n      return moves\n\n  def bfs_path(start, target, blocked):\n      \"\"\"Breadth\u2011first search returning a list of actions from start to target.\n      If no path exists, fall back to Manhattan moves.\"\"\"\n      if start == target:\n          return []\n      q = collections.deque([start])\n      parent = {start: (None, None)}   # node -> (prev_node, action_to_reach)\n      width, height = blocked.shape\n      while q:\n          cur = q.popleft()\n          for act, (dx, dy) in [(RIGHT, (1, 0)), (LEFT, (-1, 0)),\n                                (DOWN, (0, 1)), (UP, (0, -1))]:\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              if blocked[nx, ny]:\n                  continue\n              nxt = (nx, ny)\n              if nxt in parent:\n                  continue\n              parent[nxt] = (cur, act)\n              if nxt == target:\n                  # reconstruct path\n                  path = []\n                  node = nxt\n                  while parent[node][0] is not None:\n                      node, act = parent[node]\n                      path.append(act)\n                  path.reverse()\n                  return path\n              q.append(nxt)\n      # no path found \u2013 use Manhattan fallback\n      return manhattan_path(start, target)\n\n  # --------------------------------------------------------------\n  # Current state snapshot (used for planning only)\n  # --------------------------------------------------------------\n  state = env._current_state\n  cur_pos = tuple(state.pos)                     # (x, y)\n  grid = state.grid.copy()                       # (W, H, K)\n\n  # cells occupied by non\u2011grabbable entities block movement\n  non_grabbable = list(world.non_grabbable_indices)\n  if non_grabbable:\n      blocked = np.any(grid[:, :, non_grabbable] > 0, axis=2)\n  else:\n      blocked = np.zeros(grid.shape[:2], dtype=bool)\n\n  actions = []\n\n  # --------------------------------------------------------------\n  # 1. Collect all required primitives / items\n  # --------------------------------------------------------------\n  for item_idx, need_cnt in needed.items():\n      need_cnt = int(need_cnt)\n      while need_cnt > 0:\n          # locate remaining instances of the required item\n          locs = np.argwhere(grid[:, :, item_idx] > 0)\n          if locs.size == 0:\n              # nothing left on the map \u2013 break to avoid infinite loop\n              break\n          # choose the nearest instance (Manhattan distance heuristic)\n          dists = np.abs(locs[:, 0] - cur_pos[0]) + np.abs(locs[:, 1] - cur_pos[1])\n          target = tuple(locs[dists.argmin()])\n\n          # move to the target\n          actions.extend(bfs_path(cur_pos, target, blocked))\n          cur_pos = target\n\n          # pick it up\n          actions.append(USE)\n          need_cnt -= 1\n\n          # update simulated grid and blocked mask\n          grid[target[0], target[1], item_idx] = max(0,\n                                                     grid[target[0], target[1], item_idx] - 1)\n          if non_grabbable:\n              blocked[target[0], target[1]] = np.any(\n                  grid[target[0], target[1], non_grabbable] > 0\n              )\n          else:\n              blocked[target[0], target[1]] = False\n\n  # --------------------------------------------------------------\n  # 2. Move to the required workshop (if any) and craft the stick\n  # --------------------------------------------------------------\n  workshop_name = stick_recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = idx[workshop_name]\n      ws_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_locs.size:\n          ws_target = tuple(ws_locs[0])\n          actions.extend(bfs_path(cur_pos, ws_target, blocked))\n          cur_pos = ws_target\n          actions.append(USE)   # craft at the workshop\n\n  return actions", "env_interactions": 4, "island_id": 0, "scores": {"3": 0.0}}
