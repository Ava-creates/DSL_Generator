{"timestamp": "2025-10-21T21:54:22.961992", "function_name": "make_stick", "function_body": "  env.reset()\n  world = env.world\n  idx = world.cookbook.index\n  action_map = env.action_specs()\n  DOWN = action_map[\"DOWN\"]\n  UP = action_map[\"UP\"]\n  LEFT = action_map[\"LEFT\"]\n  RIGHT = action_map[\"RIGHT\"]\n  USE = action_map[\"USE\"]\n\n  # index of the target item\n  stick_idx = idx[\"stick\"]\n\n  # primitives needed to craft a stick (empty dict \u2192 stick is primitive)\n  needed = world.cookbook.primitives_for(stick_idx)\n  if not needed:\n      needed = {stick_idx: 1}\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def delta_to_action(dx, dy):\n      if dx == 1:\n          return RIGHT\n      if dx == -1:\n          return LEFT\n      if dy == 1:\n          return DOWN\n      if dy == -1:\n          return UP\n      raise ValueError(\"Invalid move delta\")\n\n  def bfs(start, goal, blocked):\n      \"\"\"Bread\u2011first search avoiding blocked cells.\"\"\"\n      if start == goal:\n          return [start]\n      w, h = blocked.shape\n      q = collections.deque([start])\n      parent = {start: None}\n      while q:\n          x, y = q.popleft()\n          for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):\n              if 0 <= nx < w and 0 <= ny < h and not blocked[nx, ny]:\n                  if (nx, ny) not in parent:\n                      parent[(nx, ny)] = (x, y)\n                      if (nx, ny) == goal:\n                          # reconstruct path\n                          path = [goal]\n                          while path[-1] != start:\n                              path.append(parent[path[-1]])\n                          path.reverse()\n                          return path\n                      q.append((nx, ny))\n      return None\n\n  def path_to_actions(path):\n      \"\"\"Convert a list of positions to a list of actions.\"\"\"\n      acts = []\n      for (x0, y0), (x1, y1) in zip(path, path[1:]):\n          acts.append(delta_to_action(x1 - x0, y1 - y0))\n      return acts\n\n  # ------------------------------------------------------------------\n  # Snapshot of the current state (used only for planning)\n  # ------------------------------------------------------------------\n  state = env._current_state\n  cur_pos = tuple(state.pos)\n  grid = state.grid.copy()\n\n  # cells that cannot be traversed (non\u2011grabbable entities)\n  non_grabbable = list(world.non_grabbable_indices)\n  if non_grabbable:\n      blocked_mask = np.any(grid[:, :, non_grabbable] > 0, axis=2)\n  else:\n      blocked_mask = np.zeros(grid.shape[:2], dtype=bool)\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives / items\n  # ------------------------------------------------------------------\n  for kind_idx, qty in needed.items():\n      for _ in range(int(qty)):\n          locations = np.argwhere(grid[:, :, kind_idx] > 0)\n          if locations.size == 0:\n              continue  # should not happen in a valid scenario\n          # pick the Manhattan\u2011closest instance\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          target = tuple(locations[dists.argmin()])\n\n          # plan a path respecting obstacles\n          path = bfs(cur_pos, target, blocked_mask)\n          if path is None:\n              # fallback: direct Manhattan moves (ignores obstacles)\n              tmp = []\n              x, y = cur_pos\n              tx, ty = target\n              while x < tx:\n                  tmp.append(RIGHT); x += 1\n              while x > tx:\n                  tmp.append(LEFT);  x -= 1\n              while y < ty:\n                  tmp.append(DOWN);  y += 1\n              while y > ty:\n                  tmp.append(UP);    y -= 1\n              actions.extend(tmp)\n          else:\n              actions.extend(path_to_actions(path))\n\n          cur_pos = target\n          actions.append(USE)\n\n          # update local copy of the grid and blocked mask\n          grid[target[0], target[1], kind_idx] -= 1\n          if non_grabbable:\n              blocked_mask[target[0], target[1]] = np.any(\n                  grid[target[0], target[1], non_grabbable] > 0\n              )\n\n  # ------------------------------------------------------------------\n  # 2. Move to the workshop (if required) and craft the stick\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = idx[workshop_name]\n      ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_cells.size:\n          ws_target = tuple(ws_cells[0])\n          path = bfs(cur_pos, ws_target, blocked_mask)\n          if path is None:\n              tmp = []\n              x, y = cur_pos\n              tx, ty = ws_target\n              while x < tx:\n                  tmp.append(RIGHT); x += 1\n              while x > tx:\n                  tmp.append(LEFT);  x -= 1\n              while y < ty:\n                  tmp.append(DOWN);  y += 1\n              while y > ty:\n                  tmp.append(UP);    y -= 1\n              actions.extend(tmp)\n          else:\n              actions.extend(path_to_actions(path))\n\n          cur_pos = ws_target\n          actions.append(USE)\n\n  return actions", "env_interactions": 4, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:54:36.289001", "function_name": "make_stick", "function_body": "  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      action_ids = [0, 1, 2, 3, 4]  # DOWN, UP, LEFT, RIGHT, USE\n\n  # Locate the integer index for the goal item \"stick\".\n  try:\n      goal_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      goal_idx = None\n      try:\n          goal_idx = env.world.cookbook.index.get(\"stick\")\n      except Exception:\n          pass\n  if goal_idx is None:\n      return []\n\n  # Retrieve the current CraftState from the environment.\n  start_state = getattr(env, \"_current_state\", None) or getattr(env, \"current_state\", None)\n  if start_state is None:\n      return []\n\n  from collections import deque\n\n  def _state_key(st):\n      \"\"\"Hashable representation of a CraftState.\"\"\"\n      return (st.pos, st.dir, st.inventory.tobytes())\n\n  frontier = deque()\n  frontier.append((start_state, []))\n  visited = {_state_key(start_state)}\n  max_plan_len = 400  # safety cutoff\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      # Goal test: we have at least one stick.\n      if cur_state.satisfies(\"\", goal_idx):\n          return cur_plan\n\n      if len(cur_plan) >= max_plan_len:\n          continue\n\n      # Expand all possible actions.\n      for a in action_ids:\n          _, nxt_state = cur_state.step(a)\n          key = _state_key(nxt_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((nxt_state, cur_plan + [a]))\n\n  # No plan found within limits.\n  return []", "env_interactions": 4, "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T21:54:37.384514", "function_name": "make_stick", "function_body": "  # ------------------------------------------------------------------\n  # Determine the action IDs used by the environment.\n  # ------------------------------------------------------------------\n  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      # Default ordering used by CraftWorld: DOWN, UP, LEFT, RIGHT, USE\n      action_ids = [0, 1, 2, 3, 4]\n\n  # ------------------------------------------------------------------\n  # Locate the integer index that corresponds to the goal item \"stick\".\n  # ------------------------------------------------------------------\n  goal_idx = None\n  try:\n      goal_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      try:\n          goal_idx = env.world.cookbook.index.get(\"stick\")\n      except Exception:\n          pass\n  if goal_idx is None:\n      # Cannot find the goal in the cookbook \u2013 give up.\n      return []\n\n  # ------------------------------------------------------------------\n  # Obtain the current CraftState from the environment.\n  # ------------------------------------------------------------------\n  start_state = getattr(env, \"_current_state\", None)\n  if start_state is None:\n      start_state = getattr(env, \"current_state\", None)\n  if start_state is None:\n      # No accessible state \u2013 give up.\n      return []\n\n  # ------------------------------------------------------------------\n  # Bread\u2011first search over deterministic state transitions.\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  def _state_key(st):\n      \"\"\"\n      Produce a hashable representation of a CraftState.\n      Uses position, direction and a bytes view of the inventory.\n      \"\"\"\n      return (st.pos, st.dir, st.inventory.tobytes())\n\n  frontier = deque()\n  frontier.append((start_state, []))\n  visited = {_state_key(start_state)}\n  max_plan_len = 300  # safety ceiling for plan length\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      # Goal test: we have at least one stick in inventory.\n      if cur_state.satisfies(\"\", goal_idx):\n          return cur_plan\n\n      # Prune overly long plans.\n      if len(cur_plan) >= max_plan_len:\n          continue\n\n      # Expand all possible actions.\n      for a in action_ids:\n          _, nxt_state = cur_state.step(a)\n          key = _state_key(nxt_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((nxt_state, cur_plan + [a]))\n\n  # No plan found within the search limits.\n  return []", "env_interactions": 4, "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T21:54:52.878687", "function_name": "make_stick", "function_body": "  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      action_ids = [0, 1, 2, 3, 4]\n  try:\n      target_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      target_idx = env.world.cookbook.index.get(\"stick\")\n  if target_idx is None:\n      return []\n  if not hasattr(env, \"_current_state\") or env._current_state is None:\n      env.reset()\n  start_state = env._current_state\n  if start_state.inventory[target_idx] > 0:\n      return []\n  from collections import deque\n  def state_key(st):\n      return (st.pos, st.dir, st.inventory.tobytes(), st.grid.tobytes())\n  visited = {state_key(start_state)}\n  frontier = deque([(start_state, [])])\n  MAX_PLAN_LEN = 500\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n      if cur_state.inventory[target_idx] > 0:\n          return cur_plan\n      if len(cur_plan) >= MAX_PLAN_LEN:\n          continue\n      for a in action_ids:\n          _, nxt_state = cur_state.step(a)\n          key = state_key(nxt_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((nxt_state, cur_plan + [a]))\n  return []", "env_interactions": 4, "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T21:54:53.989032", "function_name": "make_stick", "function_body": "  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      # Default ordering used by CraftWorld: DOWN, UP, LEFT, RIGHT, USE\n      action_ids = [0, 1, 2, 3, 4]\n\n  # Resolve the internal index for the target item \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.get(\"stick\")\n  if stick_idx is None:\n      # No stick recipe/item in this world \u2013 nothing to do.\n      return []\n\n  # Ensure the environment is reset and obtain the initial state\n  if not hasattr(env, \"_current_state\") or env._current_state is None:\n      env.reset()\n  start_state = env._current_state\n\n  # If we already have a stick, no actions are needed.\n  if start_state.inventory[stick_idx] > 0:\n      return []\n\n  from collections import deque\n\n  # Helper to create a hashable representation of a state.\n  def _state_key(st):\n      # Include position, direction, inventory and grid layout.\n      return (st.pos, st.dir, st.inventory.tobytes(), st.grid.tobytes())\n\n  visited = {_state_key(start_state)}\n  frontier = deque()\n  frontier.append((start_state, []))\n\n  MAX_PLAN_LENGTH = 400  # safety bound to keep search tractable\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      # Goal test: have at least one stick in inventory.\n      if cur_state.inventory[stick_idx] > 0:\n          return cur_plan\n\n      # Do not expand beyond the maximum allowed depth.\n      if len(cur_plan) >= MAX_PLAN_LENGTH:\n          continue\n\n      # Explore all possible actions from the current state.\n      for a in action_ids:\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((next_state, cur_plan + [a]))\n\n  # No feasible plan found within limits.\n  return []", "env_interactions": 4, "island_id": 7, "scores": {"3": 1.5}}
