{"timestamp": "2025-10-21T21:41:02.974841", "function_name": "make_stick", "function_body": "  # Resolve the set of action IDs (DOWN, UP, LEFT, RIGHT, USE)\n  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      action_ids = [0, 1, 2, 3, 4]  # default ordering used by CraftWorld\n\n  # Locate the integer index that represents the primitive \u201cstick\u201d\n  try:\n      goal_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      goal_idx = getattr(env.world.cookbook, \"index\", {}).get(\"stick\")\n  if goal_idx is None:\n      return []  # cannot identify the goal item\n\n  # Grab the current CraftState without mutating the environment\n  start_state = getattr(env, \"_current_state\", None)\n  if start_state is None:\n      start_state = getattr(env, \"current_state\", None)\n  if start_state is None:\n      return []  # no accessible state to plan from\n\n  from collections import deque\n\n  def _state_key(st):\n      \"\"\"\n      Produce a hashable representation of a CraftState.\n      Position, direction and the raw bytes of the inventory are sufficient.\n      \"\"\"\n      return (st.pos, st.dir, st.inventory.tobytes())\n\n  # Bread\u2011first search over deterministic state transitions\n  frontier = deque()\n  frontier.append((start_state, []))\n  visited = {_state_key(start_state)}\n  max_plan_len = 300  # safety cap to keep search tractable\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      # Goal test: have at least one stick in inventory\n      if cur_state.satisfies(\"\", goal_idx):\n          return cur_plan\n\n      # Prune overly long prefixes\n      if len(cur_plan) >= max_plan_len:\n          continue\n\n      # Expand all possible actions\n      for a in action_ids:\n          _, nxt_state = cur_state.step(a)\n          key = _state_key(nxt_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((nxt_state, cur_plan + [a]))\n\n  # No plan found within the allotted budget\n  return []", "env_interactions": 4, "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T21:41:31.247781", "function_name": "make_stick", "function_body": "  # -------------------------------------------------------------------------\n  # Basic references\n  # -------------------------------------------------------------------------\n  state = env._current_state          # current CraftState\n  world = env.world                    # CraftWorld instance\n  goal_idx = env.task.goal             # integer index of the desired item\n\n  # Grid dimensions (WIDTH, HEIGHT)\n  WIDTH, HEIGHT = state.grid.shape[0], state.grid.shape[1]\n\n  # Action indices (as defined in the environment)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]          # (dx, dy) matching action order\n  delta_to_action = {\n      (0, 1): DOWN,\n      (0, -1): UP,\n      (-1, 0): LEFT,\n      (1, 0): RIGHT,\n  }\n\n  # -------------------------------------------------------------------------\n  # Helper utilities\n  # -------------------------------------------------------------------------\n  def in_bounds(x, y):\n      return 0 <= x < WIDTH and 0 <= y < HEIGHT\n\n  def is_walkable(x, y, grid):\n      \"\"\"A cell is walkable if inside the map and contains no entities.\"\"\"\n      return in_bounds(x, y) and not grid[x, y].any()\n\n  def bfs(start, goals, grid):\n      \"\"\"Bread\u2011first search from `start` to the nearest cell in `goals`.\"\"\"\n      from collections import deque\n      q = deque([start])\n      came_from = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur in goals:\n              # reconstruct path (list of positions, excluding start)\n              path = []\n              while cur != start:\n                  path.append(cur)\n                  cur = came_from[cur]\n              path.reverse()\n              return path\n          x, y = cur\n          for d, (dx, dy) in enumerate(DIRS):\n              nx, ny = x + dx, y + dy\n              if is_walkable(nx, ny, grid) and (nx, ny) not in came_from:\n                  came_from[(nx, ny)] = cur\n                  q.append((nx, ny))\n      return None\n\n  def move_along(path, pos, actions):\n      \"\"\"Convert a list of positions into actions and update `pos`.\"\"\"\n      for nxt in path:\n          dx = nxt[0] - pos[0]\n          dy = nxt[1] - pos[1]\n          act = delta_to_action[(dx, dy)]\n          actions.append(act)\n          pos = nxt\n      return pos\n\n  def move_to_adjacent(target_cells, pos, grid, actions):\n      \"\"\"\n      Move to a walkable cell adjacent to the nearest target cell.\n      Returns the new position and the exact target cell we ended up adjacent to.\n      \"\"\"\n      # build set of walkable neighbours of all target cells\n      adj_set = set()\n      lookup = {}\n      for tx, ty in target_cells:\n          for dx, dy in DIRS:\n              ax, ay = tx + dx, ty + dy\n              if is_walkable(ax, ay, grid):\n                  adj_set.add((ax, ay))\n                  lookup[(ax, ay)] = (tx, ty)\n      if not adj_set:\n          return None, None\n      path = bfs(pos, adj_set, grid)\n      if path is None:\n          return None, None\n      pos = move_along(path, pos, actions)\n      return pos, lookup[pos]\n\n  def collect_primitive(kind_idx, count, pos, grid, actions):\n      \"\"\"Collect `count` units of primitive `kind_idx`.\"\"\"\n      for _ in range(count):\n          # locate all cells currently holding the primitive\n          prim_cells = np.argwhere(grid[:, :, kind_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(\"Required primitive not found on the map\")\n          # choose the cell with the shortest BFS distance to an adjacent walkable tile\n          best_path = None\n          best_cell = None\n          for cell in prim_cells:\n              cell = tuple(cell.tolist())\n              # find path to any walkable neighbour of this cell\n              adj_path, _ = move_to_adjacent([cell], pos, grid, [])\n              if adj_path is None:\n                  continue\n              # compute actual movement actions length\n              path_len = len(bfs(pos, {adj_path}, grid) or [])\n              if best_path is None or path_len < len(best_path):\n                  best_path = bfs(pos, {adj_path}, grid)\n                  best_cell = cell\n          if best_path is None:\n              raise RuntimeError(\"Cannot reach required primitive\")\n          # move to the adjacent cell\n          pos = move_along(best_path, pos, actions)\n          # perform USE to pick up\n          actions.append(USE)\n          # update internal grid copy (primitive is now removed)\n          grid[best_cell[0], best_cell[1], kind_idx] = 0\n      return pos\n\n  # -------------------------------------------------------------------------\n  # Main plan: gather primitives then craft at workshop (if any)\n  # -------------------------------------------------------------------------\n  actions = []\n  cur_pos = tuple(state.pos)\n  # make a mutable copy of the grid to keep track of removed items\n  grid_copy = state.grid.copy()\n\n  # 1. Gather required primitives for the goal\n  primitives_needed = world.cookbook.primitives_for(goal_idx)\n  for kind_idx, needed_cnt in primitives_needed.items():\n      cur_pos = collect_primitive(kind_idx, needed_cnt, cur_pos, grid_copy, actions)\n\n  # 2. Move to the appropriate workshop (if any) and craft\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(grid_copy[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          raise RuntimeError(\"Workshop required for crafting not present\")\n      # move adjacent to the first workshop cell found\n      cur_pos, _ = move_to_adjacent([tuple(ws) for ws in workshop_cells], cur_pos, grid_copy, actions)\n      actions.append(USE)   # craft the item\n\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:41:32.377438", "function_name": "make_stick", "function_body": "  import collections\n  import numpy as np\n\n  # Action indices (as defined in the environment)\n  # 0: DOWN, 1: UP, 2: LEFT, 3: RIGHT, 4: USE\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]  # (dx, dy) matching the order above\n\n  # Reset environment to a fresh state and fetch core objects\n  _ = env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  cookbook = world.cookbook\n\n  # Goal index (the item we need to produce)\n  goal_idx = env.task.goal\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  grid = state.grid.copy()                     # (WIDTH, HEIGHT, n_kinds)\n  width, height = grid.shape[0], grid.shape[1]\n\n  def in_bounds(x, y):\n      return 0 <= x < width and 0 <= y < height\n\n  # Occupancy map: True where any entity occupies the cell\n  occ = np.any(grid, axis=2)\n\n  def bfs_to_adjacent(start, target):\n      \"\"\"\n      Finds a shortest path (as a list of direction indices) from `start`\n      to any free cell that is orthogonally adjacent to `target`.\n      Returns None if no such path exists.\n      \"\"\"\n      tx, ty = target\n      # All free neighbours of the target cell\n      free_neighbours = [\n          (tx + dx, ty + dy)\n          for dx, dy in DIRS\n          if in_bounds(tx + dx, ty + dy) and not occ[tx + dx, ty + dy]\n      ]\n      if not free_neighbours:\n          return None\n\n      q = collections.deque()\n      q.append((start[0], start[1], []))          # (x, y, path_so_far)\n      visited = {(start[0], start[1])}\n\n      while q:\n          x, y, path = q.popleft()\n          if (x, y) in free_neighbours:\n              return path\n          for d, (dx, dy) in enumerate(DIRS):\n              nx, ny = x + dx, y + dy\n              if in_bounds(nx, ny) and not occ[nx, ny] and (nx, ny) not in visited:\n                  visited.add((nx, ny))\n                  q.append((nx, ny, path + [d]))\n      return None\n\n  # ------------------------------------------------------------------\n  # Determine recipe information for the goal item\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = cookbook.index[workshop_name] if workshop_name is not None else None\n  primitive_requirements = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  actions = []\n  cur_pos = (state.pos[0], state.pos[1])   # (x, y)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitive_requirements.items():\n      for _ in range(needed):\n          # Locate all cells currently holding this primitive\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)   # (x, y) positions\n          if prim_cells.size == 0:\n              raise RuntimeError(\"Required primitive not found on the map\")\n\n          # Choose the reachable primitive with the shortest path\n          best_path = None\n          best_cell = None\n          for cell in prim_cells:\n              px, py = int(cell[0]), int(cell[1])\n              path = bfs_to_adjacent(cur_pos, (px, py))\n              if path is not None and (best_path is None or len(path) < len(best_path)):\n                  best_path = path\n                  best_cell = (px, py)\n\n          if best_path is None:\n              raise RuntimeError(\"No reachable primitive remaining\")\n\n          # Move to the adjacent cell\n          actions.extend(best_path)\n          for d in best_path:\n              dx, dy = DIRS[d]\n              cur_pos = (cur_pos[0] + dx, cur_pos[1] + dy)\n\n          # Pick up the primitive\n          actions.append(4)   # USE\n          # Update internal grid/occupancy to reflect that the primitive is gone\n          grid[best_cell[0], best_cell[1], prim_idx] = 0\n          occ[best_cell[0], best_cell[1]] = False\n\n  # ------------------------------------------------------------------\n  # Move to the workshop (if required) and craft the item\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          raise RuntimeError(\"Workshop required for crafting not present\")\n      best_path = None\n      best_ws = None\n      for cell in workshop_cells:\n          wx, wy = int(cell[0]), int(cell[1])\n          path = bfs_to_adjacent(cur_pos, (wx, wy))\n          if path is not None and (best_path is None or len(path) < len(best_path)):\n              best_path = path\n              best_ws = (wx, wy)\n      if best_path is None:\n          raise RuntimeError(\"Cannot reach workshop\")\n      actions.extend(best_path)\n      cur_pos = cur_pos  # position already updated inside the loop\n      actions.append(4)   # USE to craft\n\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:42:01.552994", "function_name": "make_stick", "function_body": "  env.reset()\n  world = env.world\n  scenario = env.scenario\n\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  stick_idx = world.cookbook.index[\"stick\"]\n  primitives_needed = world.cookbook.primitives_for(stick_idx)\n  if not primitives_needed:\n      primitives_needed = {stick_idx: 1}\n\n  grid = scenario.init_grid.copy()\n  pos = scenario.init_pos\n  actions = []\n\n  from collections import deque\n\n  def bfs(start, goal):\n      \"\"\"Return a list of movement actions from start to goal.\"\"\"\n      W, H = grid.shape[:2]\n      visited = set()\n      q = deque()\n      q.append((start, []))\n      visited.add(start)\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for act, (dx, dy) in [\n              (ACTION_DOWN, (0, 1)),\n              (ACTION_UP, (0, -1)),\n              (ACTION_LEFT, (-1, 0)),\n              (ACTION_RIGHT, (1, 0)),\n          ]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H:\n                  if np.any(grid[nx, ny, :] != 0):\n                      continue\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [act]))\n      return []\n\n  # Collect required primitives\n  for prim_idx, count in primitives_needed.items():\n      for _ in range(count):\n          locations = np.argwhere(grid[:, :, prim_idx] > 0)\n          if len(locations) == 0:\n              continue\n          target = tuple(locations[0])\n\n          # Find a free adjacent cell to interact with the primitive\n          adj_candidates = []\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              ax, ay = target[0] + dx, target[1] + dy\n              if 0 <= ax < grid.shape[0] and 0 <= ay < grid.shape[1]:\n                  if not np.any(grid[ax, ay, :] != 0):\n                      adj_candidates.append((ax, ay))\n\n          path_to_adj = None\n          chosen_adj = None\n          for adj in adj_candidates:\n              path = bfs(pos, adj)\n              if path:\n                  path_to_adj = path\n                  chosen_adj = adj\n                  break\n          if path_to_adj is None:\n              continue\n\n          actions.extend(path_to_adj)\n          pos = chosen_adj\n\n          # Face the primitive\n          dx = target[0] - pos[0]\n          dy = target[1] - pos[1]\n          if dx == -1:\n              actions.append(ACTION_UP)\n          elif dx == 1:\n              actions.append(ACTION_DOWN)\n          elif dy == -1:\n              actions.append(ACTION_LEFT)\n          elif dy == 1:\n              actions.append(ACTION_RIGHT)\n\n          actions.append(ACTION_USE)\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # Craft the stick at its workshop (if required)\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if len(workshop_cells) > 0:\n          workshop_pos = tuple(workshop_cells[0])\n\n          adj_candidates = []\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              ax, ay = workshop_pos[0] + dx, workshop_pos[1] + dy\n              if 0 <= ax < grid.shape[0] and 0 <= ay < grid.shape[1]:\n                  if not np.any(grid[ax, ay, :] != 0):\n                      adj_candidates.append((ax, ay))\n\n          path_to_adj = None\n          chosen_adj = None\n          for adj in adj_candidates:\n              path = bfs(pos, adj)\n              if path:\n                  path_to_adj = path\n                  chosen_adj = adj\n                  break\n\n          if path_to_adj is not None:\n              actions.extend(path_to_adj)\n              pos = chosen_adj\n\n              dx = workshop_pos[0] - pos[0]\n              dy = workshop_pos[1] - pos[1]\n              if dx == -1:\n                  actions.append(ACTION_UP)\n              elif dx == 1:\n                  actions.append(ACTION_DOWN)\n              elif dy == -1:\n                  actions.append(ACTION_LEFT)\n              elif dy == 1:\n                  actions.append(ACTION_RIGHT)\n\n              actions.append(ACTION_USE)\n\n  return actions", "env_interactions": 7, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:42:02.685394", "function_name": "make_stick", "function_body": "  env.reset()\n  world = env.world\n  scenario = env.scenario\n\n  # action indices (as defined in CraftLab.action_specs)\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  # index of the target item\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # primitive requirements for a stick (fallback to primitive stick itself)\n  primitives_needed = world.cookbook.primitives_for(stick_idx)\n  if not primitives_needed:\n      primitives_needed = {stick_idx: 1}\n\n  # local mutable copies of grid and agent position\n  grid = scenario.init_grid.copy()\n  pos = scenario.init_pos  # (x, y)\n  actions = []\n\n  # -----------------------------------------------------------------\n  # helper: BFS that returns a list of movement actions from start to goal\n  # -----------------------------------------------------------------\n  from collections import deque\n\n  def bfs(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) to reach goal.\"\"\"\n      W, H = grid.shape[:2]\n      visited = set([start])\n      q = deque([(start, [])])\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for act, (dx, dy) in [\n              (ACTION_DOWN, (0, 1)),\n              (ACTION_UP, (0, -1)),\n              (ACTION_LEFT, (-1, 0)),\n              (ACTION_RIGHT, (1, 0)),\n          ]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H:\n                  # walkable if the cell is empty (all zeros across kinds)\n                  if np.any(grid[nx, ny, :] != 0):\n                      continue\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [act]))\n      return []  # no path found (should not happen)\n\n  # -----------------------------------------------------------------\n  # 1. Collect required primitive items\n  # -----------------------------------------------------------------\n  for prim_idx, count in primitives_needed.items():\n      for _ in range(count):\n          # locate a cell still containing the primitive\n          locs = np.argwhere(grid[:, :, prim_idx] > 0)\n          if locs.size == 0:\n              continue  # nothing left, should not happen\n          target = tuple(locs[0])  # (x, y)\n\n          # find free adjacent cells around the target\n          adj_cells = []\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              ax, ay = target[0] + dx, target[1] + dy\n              if 0 <= ax < grid.shape[0] and 0 <= ay < grid.shape[1]:\n                  if not np.any(grid[ax, ay, :] != 0):\n                      adj_cells.append((ax, ay))\n\n          # pick the first reachable adjacent cell\n          path_to_adj = None\n          chosen_adj = None\n          for adj in adj_cells:\n              p = bfs(pos, adj)\n              if p:\n                  path_to_adj = p\n                  chosen_adj = adj\n                  break\n          if path_to_adj is None:\n              continue  # cannot reach this primitive\n\n          # move to the adjacent cell\n          actions.extend(path_to_adj)\n          pos = chosen_adj\n\n          # face the primitive (add a directional action before USE)\n          dx = target[0] - pos[0]\n          dy = target[1] - pos[1]\n          if dx == -1:\n              actions.append(ACTION_UP)\n          elif dx == 1:\n              actions.append(ACTION_DOWN)\n          elif dy == -1:\n              actions.append(ACTION_LEFT)\n          elif dy == 1:\n              actions.append(ACTION_RIGHT)\n\n          # pick it up\n          actions.append(ACTION_USE)\n\n          # update local grid copy\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # -----------------------------------------------------------------\n  # 2. Craft the stick at its required workshop (if any)\n  # -----------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n\n      # locate any workshop of this type\n      ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_cells.size > 0:\n          ws_pos = tuple(ws_cells[0])\n\n          # free adjacent cells around the workshop\n          adj_cells = []\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              ax, ay = ws_pos[0] + dx, ws_pos[1] + dy\n              if 0 <= ax < grid.shape[0] and 0 <= ay < grid.shape[1]:\n                  if not np.any(grid[ax, ay, :] != 0):\n                      adj_cells.append((ax, ay))\n\n          # move to a reachable adjacent cell\n          path_to_adj = None\n          chosen_adj = None\n          for adj in adj_cells:\n              p = bfs(pos, adj)\n              if p:\n                  path_to_adj = p\n                  chosen_adj = adj\n                  break\n          if path_to_adj is not None:\n              actions.extend(path_to_adj)\n              pos = chosen_adj\n\n              # face the workshop\n              dx = ws_pos[0] - pos[0]\n              dy = ws_pos[1] - pos[1]\n              if dx == -1:\n                  actions.append(ACTION_UP)\n              elif dx == 1:\n                  actions.append(ACTION_DOWN)\n              elif dy == -1:\n                  actions.append(ACTION_LEFT)\n              elif dy == 1:\n                  actions.append(ACTION_RIGHT)\n\n              # craft the stick\n              actions.append(ACTION_USE)\n\n  return actions", "env_interactions": 7, "island_id": 1, "scores": {"3": 0.0}}
