{"timestamp": "2025-10-21T18:46:14.442688", "function_name": "make_stick", "function_body": "  actions = []\n  world = env.world\n  state = env._current_state\n\n  # Index of the stick item\n  stick_idx = world.cookbook.index[\"stick\"]\n  if state.inventory[stick_idx] > 0:\n      return actions\n\n  # ------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------\n  def move_action(cur, nxt):\n      \"\"\"Return action index that moves from cur -> nxt.\"\"\"\n      dx = nxt[0] - cur[0]\n      dy = nxt[1] - cur[1]\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise ValueError(\"Invalid move step\")\n\n  def bfs_adjacent(start, targets, grid):\n      \"\"\"\n      Find shortest path (list of positions) from start to any empty cell\n      that is orthogonally adjacent to one of the target cells.\n      Returns the path including the start cell.\n      \"\"\"\n      W, H, _ = grid.shape\n      visited = np.full((W, H), False, dtype=bool)\n      q = collections.deque()\n      q.append((start, [start]))\n      visited[start] = True\n      target_set = {tuple(t) for t in targets}\n      while q:\n          (x, y), path = q.popleft()\n          # Check adjacency to any target\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n          # Explore four neighbours through empty cells only\n          for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if grid[nx, ny, :].sum() == 0:  # empty cell\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [(nx, ny)]))\n      raise RuntimeError(\"No reachable adjacent cell to target\")\n\n  # ------------------------------------------------------------\n  # 1) Collect required primitive resources for a stick\n  # ------------------------------------------------------------\n  primitive_requirements = world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n  cur_pos = tuple(state.pos)\n\n  for prim_idx, needed in primitive_requirements.items():\n      for _ in range(needed):\n          # Skip if we already have the primitive in inventory\n          if state.inventory[prim_idx] > 0:\n              continue\n          # Locate cells containing the primitive\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(\"Required primitive not present in the world\")\n          # Find path to an empty cell adjacent to the primitive\n          path = bfs_adjacent(cur_pos, prim_cells, state.grid)\n          # Convert path to movement actions\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n          # Pick up the primitive\n          actions.append(4)   # USE\n          # Mark the cell as empty so we don't target it again\n          target = prim_cells[0]\n          state.grid[target[0], target[1], prim_idx] = 0\n\n  # ------------------------------------------------------------\n  # 2) Move to the appropriate workshop (if any) and craft the stick\n  # ------------------------------------------------------------\n  recipe_dict = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe_dict.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          raise RuntimeError(\"Workshop for stick not found in the world\")\n      path = bfs_adjacent(cur_pos, workshop_cells, state.grid)\n      for step in path[1:]:\n          actions.append(move_action(cur_pos, step))\n          cur_pos = step\n\n  # Craft the stick\n  actions.append(4)   # USE\n  return actions", "env_interactions": 3, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:46:15.571056", "function_name": "make_stick", "function_body": "  actions = []\n  world = env.world\n  state = env._current_state\n\n  # Index of the target item \"stick\"\n  stick_idx = world.cookbook.index[\"stick\"]\n  if state.inventory[stick_idx] > 0:\n      return actions\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def move_action(cur, nxt):\n      \"\"\"Return the action index that moves from cur -> nxt.\"\"\"\n      dx = nxt[0] - cur[0]\n      dy = nxt[1] - cur[1]\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise ValueError(\"Invalid move step\")\n\n  def bfs_adjacent(start, targets, grid):\n      \"\"\"\n      Find the shortest path (list of positions) from start to any empty cell\n      that is orthogonally adjacent to one of the target cells.\n      Returns the path including the start cell.\n      \"\"\"\n      W, H, _ = grid.shape\n      visited = np.full((W, H), False, dtype=bool)\n      q = collections.deque()\n      q.append((start, [start]))\n      visited[start] = True\n      target_set = {tuple(t) for t in targets}\n      while q:\n          (x, y), path = q.popleft()\n          # Check adjacency to any target\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n          # Explore neighbours through empty cells only\n          for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if grid[nx, ny, :].sum() == 0:   # empty cell\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [(nx, ny)]))\n      raise RuntimeError(\"No reachable adjacent cell to target\")\n\n  # ------------------------------------------------------------------\n  # 1) Collect all primitive resources needed for a stick\n  # ------------------------------------------------------------------\n  primitive_requirements = world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n  cur_pos = tuple(state.pos)\n  # Work on a temporary copy of the grid for planning purposes\n  planning_grid = state.grid.copy()\n\n  for prim_idx, needed in primitive_requirements.items():\n      for _ in range(needed):\n          # If we already have the primitive in inventory, skip collection\n          if state.inventory[prim_idx] > 0:\n              continue\n          # Locate all cells that currently contain this primitive\n          prim_cells = np.argwhere(planning_grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(\"Required primitive not present in the world\")\n          # Find a path to a cell adjacent to one of the primitive cells\n          path = bfs_adjacent(cur_pos, prim_cells, planning_grid)\n          # Translate the path into movement actions\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n          # Use the primitive (pick it up)\n          actions.append(4)   # USE\n          # Update the planning grid to reflect that the primitive has been taken\n          target = prim_cells[0]\n          planning_grid[target[0], target[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 2) Move to the appropriate workshop (if any) and craft the stick\n  # ------------------------------------------------------------------\n  recipe_dict = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe_dict.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(planning_grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          raise RuntimeError(\"Workshop for stick not found in the world\")\n      path = bfs_adjacent(cur_pos, workshop_cells, planning_grid)\n      for step in path[1:]:\n          actions.append(move_action(cur_pos, step))\n          cur_pos = step\n\n  # Finally, craft the stick\n  actions.append(4)   # USE\n  return actions", "env_interactions": 3, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:46:46.756911", "function_name": "make_stick", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  # ------------------------------------------------------------------\n  # Action mapping\n  act_map = env.action_specs()\n  DOWN = act_map.get('DOWN', 0)\n  UP = act_map.get('UP', 1)\n  LEFT = act_map.get('LEFT', 2)\n  RIGHT = act_map.get('RIGHT', 3)\n  USE = act_map.get('USE', 4)\n\n  # ------------------------------------------------------------------\n  # Helper: convert a movement delta to an action index\n  def delta_to_action(dx, dy):\n      if dx == 1 and dy == 0:\n          return DOWN\n      if dx == -1 and dy == 0:\n          return UP\n      if dx == 0 and dy == -1:\n          return LEFT\n      if dx == 0 and dy == 1:\n          return RIGHT\n      raise ValueError(\"Invalid delta\")\n\n  # ------------------------------------------------------------------\n  # Helper: BFS pathfinding (ignores entities except the goal cell)\n  def bfs_path(start, goal, grid):\n      from collections import deque\n      h, w = grid.shape[:2]\n      blocked = (grid.sum(axis=2) > 0).astype(np.uint8)\n      blocked[goal[0], goal[1]] = 0          # allow stepping onto goal\n      visited = np.zeros((h, w), dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start[0], start[1]] = True\n      while q:\n          x, y = q.popleft()\n          if (x, y) == goal:\n              break\n          for dx, dy in [(1,0), (-1,0), (0,1), (0,-1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < h and 0 <= ny < w and not visited[nx, ny] and blocked[nx, ny] == 0:\n                  visited[nx, ny] = True\n                  prev[(nx, ny)] = (x, y)\n                  q.append((nx, ny))\n      else:\n          return None  # unreachable\n\n      # reconstruct path\n      path = [goal]\n      while path[-1] != start:\n          path.append(prev[path[-1]])\n      path.reverse()\n      return path\n\n  # ------------------------------------------------------------------\n  # Helper: turn a path into action list\n  def path_to_actions(path):\n      actions = []\n      for (x0, y0), (x1, y1) in zip(path, path[1:]):\n          actions.append(delta_to_action(x1 - x0, y1 - y0))\n      return actions\n\n  # ------------------------------------------------------------------\n  # Helper: move from cur_pos to target using BFS (fallback to Manhattan)\n  def move_actions(cur_pos, target, grid):\n      if cur_pos == target:\n          return [], target\n      path = bfs_path(cur_pos, target, grid)\n      if path is None:\n          # fallback: simple Manhattan moves (may collide with obstacles)\n          cx, cy = cur_pos\n          tx, ty = target\n          acts = []\n          while cx < tx:\n              acts.append(DOWN); cx += 1\n          while cx > tx:\n              acts.append(UP); cx -= 1\n          while cy < ty:\n              acts.append(RIGHT); cy += 1\n          while cy > ty:\n              acts.append(LEFT); cy -= 1\n          return acts, (cx, cy)\n      return path_to_actions(path), target\n\n  # ------------------------------------------------------------------\n  # Identify the index for \"stick\"\n  try:\n      stick_idx = cookbook.index[\"stick\"]\n  except Exception:\n      return []  # stick not defined in this world\n\n  # If stick itself is a primitive, just collect one\n  if stick_idx in cookbook.primitives:\n      if state.inventory[stick_idx] > 0:\n          return []  # already have it\n      cells = np.argwhere(state.grid[:, :, stick_idx] > 0)\n      if cells.size == 0:\n          return []  # no stick on map\n      target = tuple(cells[0])\n      actions, _ = move_actions(state.pos, target, state.grid)\n      actions.append(USE)\n      return actions\n\n  # ------------------------------------------------------------------\n  # Get primitive requirements for one stick\n  prim_req = cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n  if not prim_req:\n      return []  # no recipe and not primitive\n\n  # Locate all primitives on the map\n  primitive_locations = {}\n  for p_idx in prim_req:\n      locs = np.argwhere(state.grid[:, :, p_idx] > 0)\n      primitive_locations[p_idx] = [tuple(pos) for pos in locs]\n\n  # Locate any workshop\n  workshop_pos = None\n  for wk_idx in world.workshop_indices:\n      cells = np.argwhere(state.grid[:, :, wk_idx] > 0)\n      if cells.size:\n          workshop_pos = tuple(cells[0])\n          break\n  if workshop_pos is None:\n      return []  # cannot craft without a workshop\n\n  cur_pos = state.pos\n  plan = []\n\n  # ------------------------------------------------------------------\n  # Collect required primitives (respecting needed counts)\n  for p_idx, needed in prim_req.items():\n      collected = 0\n      available = primitive_locations.get(p_idx, []).copy()\n      while collected < needed:\n          if not available:\n              return []  # not enough primitives on the map\n          # choose nearest primitive (Manhattan distance)\n          dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in available]\n          nearest_i = int(np.argmin(dists))\n          target = available.pop(nearest_i)\n\n          actions, cur_pos = move_actions(cur_pos, target, state.grid)\n          plan.extend(actions)\n          plan.append(USE)          # pick up primitive\n          collected += 1\n\n  # ------------------------------------------------------------------\n  # Move to workshop and craft the stick\n  actions, cur_pos = move_actions(cur_pos, workshop_pos, state.grid)\n  plan.extend(actions)\n  plan.append(USE)  # trigger crafting at workshop\n\n  return plan", "env_interactions": 4, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:46:47.891867", "function_name": "make_stick", "function_body": "  # Reset environment and fetch current state and world information\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  cookbook = world.cookbook\n\n  # Action index mapping\n  act_map = env.action_specs()\n  DOWN = act_map.get('DOWN', 0)\n  UP = act_map.get('UP', 1)\n  LEFT = act_map.get('LEFT', 2)\n  RIGHT = act_map.get('RIGHT', 3)\n  USE = act_map.get('USE', 4)\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  def delta_to_action(dx, dy):\n      \"\"\"Convert a grid delta into the corresponding action index.\"\"\"\n      if dx == 1 and dy == 0:\n          return DOWN\n      if dx == -1 and dy == 0:\n          return UP\n      if dx == 0 and dy == -1:\n          return LEFT\n      if dx == 0 and dy == 1:\n          return RIGHT\n      raise ValueError(\"Invalid movement delta\")\n\n  def bfs_path(start, goal, grid):\n      \"\"\"\n      Bread\u2011first search returning a list of positions from start to goal\n      (inclusive). Cells that contain any entity are treated as blocked,\n      except the goal cell itself which is always considered traversable.\n      Returns None if the goal cannot be reached.\n      \"\"\"\n      from collections import deque\n      h, w = grid.shape[:2]\n      blocked = (grid.sum(axis=2) > 0).astype(np.uint8)\n      blocked[goal[0], goal[1]] = 0          # allow stepping onto the goal\n      visited = np.zeros((h, w), dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start[0], start[1]] = True\n\n      while q:\n          x, y = q.popleft()\n          if (x, y) == goal:\n              break\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < h and 0 <= ny < w and not visited[nx, ny] and blocked[nx, ny] == 0:\n                  visited[nx, ny] = True\n                  prev[(nx, ny)] = (x, y)\n                  q.append((nx, ny))\n      else:\n          return None  # unreachable\n\n      # reconstruct path\n      path = [goal]\n      while path[-1] != start:\n          path.append(prev[path[-1]])\n      path.reverse()\n      return path\n\n  # ------------------------------------------------------------------\n  # Identify the index for the target item \"stick\"\n  try:\n      goal_idx = cookbook.index[\"stick\"]\n  except Exception:\n      return []  # stick not defined in this world\n\n  # If stick is a primitive (no recipe), just collect it if needed\n  if goal_idx in cookbook.primitives:\n      if state.inventory[goal_idx] > 0:\n          return []  # already have a stick\n      stick_cells = np.argwhere(state.grid[:, :, goal_idx] > 0)\n      if stick_cells.size == 0:\n          return []  # no stick present on the map\n      target = tuple(stick_cells[0])\n      path = bfs_path(state.pos, target, state.grid)\n      if path is None:\n          return []  # cannot reach the stick\n      actions = [delta_to_action(x1 - x0, y1 - y0) for (x0, y0), (x1, y1) in zip(path, path[1:])]\n      actions.append(USE)  # pick up\n      return actions\n\n  # ------------------------------------------------------------------\n  # Otherwise we need to craft the stick from its primitive ingredients\n  prim_req = cookbook.primitives_for(goal_idx)   # dict {prim_idx: count}\n  if not prim_req:\n      return []  # no recipe and not a primitive \u2192 cannot craft\n\n  # Work with a mutable copy of the grid to reflect collected items\n  grid = np.copy(state.grid)\n\n  # Locate any workshop cells (use the first reachable one later)\n  workshop_cells = []\n  for wk_idx in world.workshop_indices:\n      cells = np.argwhere(grid[:, :, wk_idx] > 0)\n      for c in cells:\n          workshop_cells.append(tuple(c))\n  if not workshop_cells:\n      return []  # no workshop available for crafting\n\n  cur_pos = state.pos\n  plan = []\n\n  # --------------------------------------------------------------\n  # Collect each required primitive (handling multiple copies)\n  for prim_idx, needed in prim_req.items():\n      for _ in range(needed):\n          # Find all remaining locations of this primitive\n          locations = np.argwhere(grid[:, :, prim_idx] > 0)\n          if locations.size == 0:\n              return []  # not enough primitives on the map\n\n          # Choose the reachable location with the shortest BFS path\n          best_path = None\n          best_target = None\n          best_len = None\n          for loc in locations:\n              target = tuple(loc)\n              path = bfs_path(cur_pos, target, grid)\n              if path is None:\n                  continue\n              if best_len is None or len(path) < best_len:\n                  best_len = len(path)\n                  best_path = path\n                  best_target = target\n\n          if best_path is None:\n              return []  # none of the remaining primitives are reachable\n\n          # Convert the path into actions\n          actions = [delta_to_action(x1 - x0, y1 - y0) for (x0, y0), (x1, y1) in zip(best_path, best_path[1:])]\n          plan.extend(actions)\n          plan.append(USE)          # pick up the primitive\n          cur_pos = best_target\n\n          # Remove the collected primitive from the grid copy\n          grid[cur_pos[0], cur_pos[1], prim_idx] = 0\n\n  # --------------------------------------------------------------\n  # After gathering all ingredients, move to the nearest workshop and craft\n  best_path = None\n  best_len = None\n  best_ws = None\n  for ws in workshop_cells:\n      path = bfs_path(cur_pos, ws, grid)\n      if path is None:\n          continue\n      if best_len is None or len(path) < best_len:\n          best_len = len(path)\n          best_path = path\n          best_ws = ws\n\n  if best_path is None:\n      return []  # cannot reach any workshop\n\n  actions = [delta_to_action(x1 - x0, y1 - y0) for (x0, y0), (x1, y1) in zip(best_path, best_path[1:])]\n  plan.extend(actions)\n  plan.append(USE)  # trigger crafting of the stick at the workshop\n\n  return plan", "env_interactions": 4, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:47:11.563814", "function_name": "make_stick", "function_body": "", "env_interactions": 0, "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-10-21T18:47:12.688292", "function_name": "make_stick", "function_body": "  # reset environment to get fresh state\n  env.reset()\n  state = env._current_state            # type: CraftState\n  world = env.world                     # type: CraftWorld\n  cookbook = world.cookbook\n\n  # ------------------------------------------------------------------\n  # 1. Locate the index of the goal item \"stick\"\n  # ------------------------------------------------------------------\n  try:\n      goal_idx = cookbook.index[\"stick\"]\n  except Exception:\n      # fallback: case\u2011insensitive search\n      goal_idx = None\n      for name, idx in cookbook.index.contents.items():\n          if name.lower() == \"stick\":\n              goal_idx = idx\n              break\n      if goal_idx is None:\n          raise ValueError(\"Stick not found in cookbook\")\n\n  # ------------------------------------------------------------------\n  # 2. Determine which primitive resources are required for one stick\n  # ------------------------------------------------------------------\n  prim_req = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n  grid = state.grid                               # (W, H, n_kinds)\n\n  # ------------------------------------------------------------------\n  # 3. Find the current locations of each required primitive on the map\n  # ------------------------------------------------------------------\n  prim_locations = {}\n  for prim_idx in prim_req:\n      locs = np.argwhere(grid[:, :, prim_idx] > 0)\n      prim_locations[prim_idx] = [tuple(p) for p in locs]\n\n  # ------------------------------------------------------------------\n  # 4. Helper: translate Manhattan moves into action ids\n  # ------------------------------------------------------------------\n  act_ids = env.action_specs()          # e.g. {'DOWN':0, 'UP':1, ...}\n  DOWN = act_ids.get('DOWN', 0)\n  UP   = act_ids.get('UP', 1)\n  LEFT = act_ids.get('LEFT', 2)\n  RIGHT= act_ids.get('RIGHT', 3)\n  USE  = act_ids.get('USE', 4)\n\n  def moves_to(cur, target):\n      \"\"\"Return a list of actions that move from cur \u2192 target (Manhattan).\"\"\"\n      cx, cy = cur\n      tx, ty = target\n      actions = []\n      while cx < tx:\n          actions.append(DOWN); cx += 1\n      while cx > tx:\n          actions.append(UP);   cx -= 1\n      while cy < ty:\n          actions.append(RIGHT); cy += 1\n      while cy > ty:\n          actions.append(LEFT);  cy -= 1\n      return actions\n\n  # ------------------------------------------------------------------\n  # 5. Build the plan:\n  #    a) walk to each needed primitive and pick it up (USE)\n  #    b) go to any workshop cell and craft the stick (USE)\n  # ------------------------------------------------------------------\n  cur_pos = state.pos\n  plan = []\n\n  # a) Collect primitives\n  for prim_idx, needed in prim_req.items():\n      collected = 0\n      for loc in prim_locations.get(prim_idx, []):\n          if collected >= needed:\n              break\n          plan.extend(moves_to(cur_pos, loc))\n          cur_pos = loc\n          plan.append(USE)                # pick up the primitive\n          collected += 1\n      # If we still need more after exhausting known spots we simply\n      # continue \u2013 the environment may spawn them later.\n\n  # b) Locate a workshop (any workshop type)\n  workshop_pos = None\n  for wk_idx in world.workshop_indices:\n      cells = np.argwhere(grid[:, :, wk_idx] > 0)\n      if cells.size:\n          workshop_pos = tuple(cells[0])\n          break\n\n  if workshop_pos is not None:\n      plan.extend(moves_to(cur_pos, workshop_pos))\n      cur_pos = workshop_pos\n\n  # Finally, use the workshop to craft the stick.\n  plan.append(USE)\n\n  return plan", "env_interactions": 4, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:47:33.335415", "function_name": "make_stick", "function_body": "  # Retrieve action mapping and current state/world objects\n  ACTION = env.action_specs()\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def find_nearest_kind(start_pos, kind):\n      \"\"\"Return the coordinates (x, y) of the closest cell containing `kind`.\"\"\"\n      layer = state.grid[:, :, kind]\n      ys, xs = np.where(layer > 0)\n      if len(xs) == 0:\n          return None\n      dists = np.abs(xs - start_pos[0]) + np.abs(ys - start_pos[1])\n      i = int(np.argmin(dists))\n      return (int(xs[i]), int(ys[i]))\n\n  def moves_to(cur, target):\n      \"\"\"Generate a list of movement actions (Manhattan) from cur \u2192 target.\"\"\"\n      seq = []\n      x, y = cur\n      tx, ty = target\n      while x != tx:\n          if tx > x:\n              seq.append(ACTION[\"RIGHT\"])\n              x += 1\n          else:\n              seq.append(ACTION[\"LEFT\"])\n              x -= 1\n      while y != ty:\n          if ty > y:\n              seq.append(ACTION[\"DOWN\"])\n              y += 1\n          else:\n              seq.append(ACTION[\"UP\"])\n              y -= 1\n      return seq\n\n  # ------------------------------------------------------------------\n  # Determine primitives required for a stick\n  # ------------------------------------------------------------------\n  stick_idx = idx[\"stick\"]\n  needed = world.cookbook.primitives_for(stick_idx)  # {primitive_idx: count}\n  plan = []\n  cur_pos = state.pos\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = find_nearest_kind(cur_pos, prim_idx)\n          if target is None:\n              # Primitive not found \u2013 skip (should not happen in valid scenarios)\n              continue\n          plan.extend(moves_to(cur_pos, target))\n          plan.append(ACTION[\"USE\"])          # pick up the primitive\n          cur_pos = target\n\n  # ------------------------------------------------------------------\n  # Move to the appropriate workshop (if any) and craft the stick\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      wk_idx = idx[workshop_name] if isinstance(workshop_name, str) else workshop_name\n      wk_pos = find_nearest_kind(cur_pos, wk_idx)\n      if wk_pos is not None:\n          plan.extend(moves_to(cur_pos, wk_pos))\n          cur_pos = wk_pos\n\n  # Final USE to perform the crafting action\n  plan.append(ACTION[\"USE\"])\n\n  return plan", "env_interactions": 4, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:47:34.438697", "function_name": "make_stick", "function_body": "  import numpy as np\n\n  # Action mapping and world information\n  ACTION = env.action_specs()\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def find_nearest(start_pos, kind):\n      \"\"\"Return (x, y) of the closest cell containing `kind`.\"\"\"\n      layer = state.grid[:, :, kind]\n      ys, xs = np.where(layer > 0)\n      if len(xs) == 0:\n          return None\n      dists = np.abs(xs - start_pos[0]) + np.abs(ys - start_pos[1])\n      i = int(np.argmin(dists))\n      return (int(xs[i]), int(ys[i]))\n\n  def moves_to(cur, target):\n      \"\"\"Generate movement actions (Manhattan) from cur \u2192 target.\"\"\"\n      seq = []\n      x, y = cur\n      tx, ty = target\n      while x != tx:\n          if tx > x:\n              seq.append(ACTION[\"RIGHT\"])\n              x += 1\n          else:\n              seq.append(ACTION[\"LEFT\"])\n              x -= 1\n      while y != ty:\n          if ty > y:\n              seq.append(ACTION[\"DOWN\"])\n              y += 1\n          else:\n              seq.append(ACTION[\"UP\"])\n              y -= 1\n      return seq\n\n  # ------------------------------------------------------------------\n  # Determine the stick recipe and required primitives\n  # ------------------------------------------------------------------\n  stick_idx = idx.get(\"stick\")\n  if stick_idx is None:\n      # No stick defined \u2013 nothing to do\n      return []\n\n  needed = world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n  plan = []\n  cur_pos = state.pos\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = find_nearest(cur_pos, prim_idx)\n          if target is None:\n              # Primitive not present; skip (should not happen in valid tasks)\n              continue\n          plan.extend(moves_to(cur_pos, target))\n          plan.append(ACTION[\"USE\"])          # pick up the primitive\n          cur_pos = target\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if required) and craft the stick\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      wk_idx = idx[workshop_name] if isinstance(workshop_name, str) else workshop_name\n      wk_pos = find_nearest(cur_pos, wk_idx)\n      if wk_pos is not None:\n          plan.extend(moves_to(cur_pos, wk_pos))\n          cur_pos = wk_pos\n\n  # Final USE to perform the crafting action\n  plan.append(ACTION[\"USE\"])\n\n  return plan", "env_interactions": 0, "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-10-21T18:47:56.581564", "function_name": "make_stick", "function_body": "  actions = []\n  try:\n      # Reset environment to start a new episode.\n      env.reset()\n\n      # Retrieve the current CraftState from the wrapper.\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          # Some wrappers expose the scenario directly.\n          scenario = getattr(env, \"scenario\", None)\n          if scenario is not None:\n              state = scenario.init()\n      if state is None:\n          return actions\n\n      world = state.world\n      grid = state.grid\n      height, width, _ = grid.shape\n\n      # ------------------------------------------------------------------\n      # Helper utilities.\n      # ------------------------------------------------------------------\n      # Action indices (DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4)\n      dirs = [(1, 0, 0), (-1, 0, 1), (0, -1, 2), (0, 1, 3)]\n\n      def is_blocked(x, y):\n          \"\"\"Return True if cell (x,y) contains a non\u2011grabbable entity.\"\"\"\n          for idx in world.non_grabbable_indices:\n              if grid[x, y, idx] > 0:\n                  return True\n          return False\n\n      def bfs(start, goal):\n          \"\"\"Bread\u2011first search returning a list of actions from start\u2192goal.\"\"\"\n          from collections import deque\n\n          q = deque()\n          q.append((start, []))\n          visited = {start}\n          while q:\n              (cx, cy), path = q.popleft()\n              if (cx, cy) == goal:\n                  return path\n              for dx, dy, act in dirs:\n                  nx, ny = cx + dx, cy + dy\n                  if 0 <= nx < height and 0 <= ny < width and not is_blocked(nx, ny):\n                      if (nx, ny) not in visited:\n                          visited.add((nx, ny))\n                          q.append(((nx, ny), path + [act]))\n          return []  # No path found (should not happen in valid maps)\n\n      def find_cells(kind):\n          \"\"\"Return list of (x, y) coordinates where `kind` appears in the grid.\"\"\"\n          positions = np.argwhere(grid[:, :, kind] > 0)\n          return [tuple(p) for p in positions]\n\n      # ------------------------------------------------------------------\n      # Determine the recipe for a stick.\n      # ------------------------------------------------------------------\n      stick_idx = world.cookbook.index.index(\"stick\")\n      primitive_reqs = world.cookbook.primitives_for(stick_idx)  # dict {prim_idx: count}\n      stick_recipe = world.cookbook.recipes.get(stick_idx, {})\n      workshop_idx = stick_recipe.get(\"_at\", None)\n\n      cur_pos = state.pos\n\n      # ------------------------------------------------------------------\n      # Collect required primitives.\n      # ------------------------------------------------------------------\n      for prim_idx, needed in primitive_reqs.items():\n          for _ in range(needed):\n              # Locate the nearest cell containing this primitive.\n              cells = find_cells(prim_idx)\n              if not cells:\n                  # Primitive not present on the map \u2013 skip (cannot collect).\n                  continue\n              # Choose the cell with minimal Manhattan distance.\n              dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in cells]\n              target = cells[int(np.argmin(dists))]\n              # Move to the target cell.\n              actions.extend(bfs(cur_pos, target))\n              # Pick up the primitive.\n              actions.append(4)  # USE\n              cur_pos = target\n\n      # ------------------------------------------------------------------\n      # If a workshop is required, go there and craft the stick.\n      # ------------------------------------------------------------------\n      if workshop_idx is not None:\n          workshop_cells = find_cells(workshop_idx)\n          if workshop_cells:\n              dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in workshop_cells]\n              target_ws = workshop_cells[int(np.argmin(dists))]\n              actions.extend(bfs(cur_pos, target_ws))\n              actions.append(4)  # USE to craft the stick\n      else:\n          # Stick is a primitive; if we already collected it, nothing else to do.\n          pass\n\n      return actions\n  except Exception:\n      # In case of any unexpected error, return an empty plan.\n      return []", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:47:57.705994", "function_name": "make_stick", "function_body": "  actions = []\n  try:\n      # Reset environment and obtain the current state.\n      env.reset()\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          scenario = getattr(env, \"scenario\", None)\n          if scenario is not None:\n              state = scenario.init()\n      if state is None:\n          return actions\n\n      world = state.world\n      grid = state.grid\n      height, width, _ = grid.shape\n\n      # ------------------------------------------------------------------\n      # Helper utilities.\n      # ------------------------------------------------------------------\n      # Directions: (dx, dy, action_index)\n      dirs = [(1, 0, 0),   # DOWN\n              (-1, 0, 1),  # UP\n              (0, -1, 2),  # LEFT\n              (0, 1, 3)]   # RIGHT\n\n      def is_blocked(x, y):\n          \"\"\"Return True if cell (x, y) contains any non\u2011grabbable entity.\"\"\"\n          for idx in world.non_grabbable_indices:\n              if grid[x, y, idx] > 0:\n                  return True\n          return False\n\n      def bfs(start, goal):\n          \"\"\"Bread\u2011first search returning a list of actions from start \u2192 goal.\"\"\"\n          from collections import deque\n          q = deque()\n          q.append((start, []))\n          visited = {start}\n          while q:\n              (cx, cy), path = q.popleft()\n              if (cx, cy) == goal:\n                  return path\n              for dx, dy, act in dirs:\n                  nx, ny = cx + dx, cy + dy\n                  if 0 <= nx < height and 0 <= ny < width and not is_blocked(nx, ny):\n                      if (nx, ny) not in visited:\n                          visited.add((nx, ny))\n                          q.append(((nx, ny), path + [act]))\n          # If we cannot reach the goal, return empty list.\n          return []\n\n      def find_cells(kind):\n          \"\"\"Return list of (x, y) positions where `kind` is present on the grid.\"\"\"\n          pos = np.argwhere(grid[:, :, kind] > 0)\n          return [tuple(p) for p in pos]\n\n      # ------------------------------------------------------------------\n      # Identify the recipe for a stick.\n      # ------------------------------------------------------------------\n      stick_idx = world.cookbook.index.index(\"stick\")\n      primitive_reqs = world.cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n      recipe = world.cookbook.recipes.get(stick_idx, {})\n      workshop_idx = recipe.get(\"_at\", None)\n\n      cur_pos = state.pos\n\n      # ------------------------------------------------------------------\n      # Collect required primitive resources.\n      # ------------------------------------------------------------------\n      for prim_idx, needed in primitive_reqs.items():\n          for _ in range(needed):\n              cells = find_cells(prim_idx)\n              if not cells:\n                  # Primitive not present; skip (should not happen in a valid scenario)\n                  continue\n              # Choose the nearest occurrence (Manhattan distance).\n              dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in cells]\n              target = cells[int(np.argmin(dists))]\n              actions.extend(bfs(cur_pos, target))\n              actions.append(4)                     # USE to pick up the primitive\n              cur_pos = target\n\n      # ------------------------------------------------------------------\n      # If the stick is itself a primitive and no workshop is required,\n      # simply pick it up.\n      # ------------------------------------------------------------------\n      if not primitive_reqs and workshop_idx is None:\n          stick_cells = find_cells(stick_idx)\n          if stick_cells:\n              dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in stick_cells]\n              target = stick_cells[int(np.argmin(dists))]\n              actions.extend(bfs(cur_pos, target))\n              actions.append(4)                     # USE to pick up the stick\n              cur_pos = target\n          return actions\n\n      # ------------------------------------------------------------------\n      # Move to the appropriate workshop (if any) and craft the stick.\n      # ------------------------------------------------------------------\n      if workshop_idx is not None:\n          ws_cells = find_cells(workshop_idx)\n          if ws_cells:\n              dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in ws_cells]\n              target_ws = ws_cells[int(np.argmin(dists))]\n              actions.extend(bfs(cur_pos, target_ws))\n              actions.append(4)                     # USE to craft the stick\n      # If no workshop is required (should not happen here), we are done.\n\n      return actions\n  except Exception:\n      # In case of any unexpected error, return an empty plan.\n      return []", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:48:44.634297", "function_name": "make_stick", "function_body": "  actions = []\n  world = env.world\n  state = env._current_state\n\n  stick_idx = world.cookbook.index[\"stick\"]\n  if state.inventory[stick_idx] > 0:\n      return actions\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def move_action(cur, nxt):\n      dx = nxt[0] - cur[0]\n      dy = nxt[1] - cur[1]\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise ValueError(\"invalid move\")\n\n  def bfs_adjacent(start, targets, grid):\n      \"\"\"Return (path, target) where path is a list of positions from start\n      to an empty cell adjacent to one of the target cells, and target is the\n      chosen target cell.\"\"\"\n      W, H, _ = grid.shape\n      visited = np.full((W, H), False, dtype=bool)\n      q = collections.deque()\n      q.append((start, []))\n      visited[start] = True\n      target_set = {tuple(t) for t in targets}\n      while q:\n          (x, y), path = q.popleft()\n          # Check if adjacent to any target\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path + [(x, y)], (tx, ty)\n          # Expand neighbours\n          for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if grid[nx, ny, :].sum() == 0:   # empty cell\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [(x, y)]))\n      raise RuntimeError(\"No reachable adjacent cell to any target\")\n\n  def face_and_use(cur, target):\n      \"\"\"Move away and back if needed so that the final direction faces target,\n      then append USE action.\"\"\"\n      tx, ty = target\n      cx, cy = cur\n      dx, dy = tx - cx, ty - cy\n      if abs(dx) + abs(dy) != 1:\n          raise ValueError(\"target not orthogonal adjacent\")\n      opp = (cx - dx, cy - dy)          # cell opposite to the target\n      W, H, _ = state.grid.shape\n\n      def empty(cell):\n          x, y = cell\n          return 0 <= x < W and 0 <= y < H and state.grid[x, y, :].sum() == 0\n\n      extra = []\n      if empty(opp):\n          extra.append(move_action((cx, cy), opp))\n          extra.append(move_action(opp, (cx, cy)))\n      else:\n          # Find any neighbouring empty cell to step away and back\n          for ndx, ndy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              nb = (cx + ndx, cy + ndy)\n              if empty(nb):\n                  extra.append(move_action((cx, cy), nb))\n                  extra.append(move_action(nb, (cx, cy)))\n                  break\n      extra.append(4)   # USE\n      return extra\n\n  # ------------------------------------------------------------------\n  # 1) Gather required primitives for a stick\n  # ------------------------------------------------------------------\n  primitive_requirements = world.cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n  cur_pos = tuple(state.pos)\n  used_cells = set()   # remember which primitive cells have been taken\n\n  for prim_idx, needed in primitive_requirements.items():\n      for _ in range(needed):\n          # If we already have this primitive, skip\n          if state.inventory[prim_idx] > 0:\n              continue\n\n          # Locate cells containing the primitive that are not yet used\n          prim_cells = [tuple(c) for c in np.argwhere(state.grid[:, :, prim_idx] > 0)\n                       if tuple(c) not in used_cells]\n          if not prim_cells:\n              raise RuntimeError(\"Required primitive not present in the world\")\n\n          # Find path to an empty cell adjacent to any of the primitive cells\n          path, target_cell = bfs_adjacent(cur_pos, prim_cells, state.grid)\n\n          # Convert path to movement actions\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n\n          # Face the primitive correctly and pick it up\n          actions.extend(face_and_use(cur_pos, target_cell))\n\n          # Mark this primitive cell as taken\n          used_cells.add(target_cell)\n\n  # ------------------------------------------------------------------\n  # 2) Move to workshop (if any) and craft the stick\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      workshop_cells = [tuple(c) for c in np.argwhere(state.grid[:, :, workshop_idx] > 0)]\n      if not workshop_cells:\n          raise RuntimeError(\"Workshop for stick not found in the world\")\n      path, target_cell = bfs_adjacent(cur_pos, workshop_cells, state.grid)\n      for step in path[1:]:\n          actions.append(move_action(cur_pos, step))\n          cur_pos = step\n      actions.extend(face_and_use(cur_pos, target_cell))\n  else:\n      # No specific workshop \u2013 just use at current location\n      actions.append(4)   # USE\n\n  return actions", "env_interactions": 9, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:48:45.758843", "function_name": "make_stick", "function_body": "  actions = []\n  world = env.world\n  state = env._current_state\n\n  # Helper to translate a move between adjacent cells into an action index\n  def move_action(frm, to):\n      dx = to[0] - frm[0]\n      dy = to[1] - frm[1]\n      if dx == 1:\n          return 3   # RIGHT\n      if dx == -1:\n          return 2   # LEFT\n      if dy == 1:\n          return 0   # DOWN\n      if dy == -1:\n          return 1   # UP\n      raise ValueError(\"non\u2011adjacent move\")\n\n  # BFS that finds the shortest path to an empty cell orthogonal to any target cell\n  def bfs_to_adjacent(start, target_cells, grid):\n      W, H, _ = grid.shape\n      visited = np.full((W, H), False, dtype=bool)\n      q = collections.deque()\n      q.append((start, [start]))\n      visited[start] = True\n      targets = {tuple(t) for t in target_cells}\n      while q:\n          (x, y), path = q.popleft()\n          # Check adjacency to any target\n          for tx, ty in targets:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path, (tx, ty)\n          # Expand neighbours\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if grid[nx, ny, :].sum() == 0:   # empty cell\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [(nx, ny)]))\n      raise RuntimeError(\"cannot reach any target\")\n\n  # Produce actions that end with the agent facing `target` from `cur` and then USE\n  def face_and_use(cur, target):\n      cx, cy = cur\n      tx, ty = target\n      dx, dy = tx - cx, ty - cy\n      if abs(dx) + abs(dy) != 1:\n          raise ValueError(\"target not orthogonal to current position\")\n      opp = (cx - dx, cy - dy)                     # cell opposite the target\n      W, H, _ = state.grid.shape\n\n      def is_empty(cell):\n          x, y = cell\n          return 0 <= x < W and 0 <= y < H and state.grid[x, y, :].sum() == 0\n\n      extra = []\n      if is_empty(opp):\n          extra.append(move_action((cx, cy), opp))\n          extra.append(move_action(opp, (cx, cy)))\n      else:\n          # Find any neighbouring empty cell to step away and back\n          for ndx, ndy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nb = (cx + ndx, cy + ndy)\n              if is_empty(nb):\n                  extra.append(move_action((cx, cy), nb))\n                  extra.append(move_action(nb, (cx, cy)))\n                  break\n      extra.append(4)   # USE\n      return extra\n\n  # -----------------------------------------------------------------\n  # 1) Gather required primitives for a stick\n  # -----------------------------------------------------------------\n  stick_idx = world.cookbook.index[\"stick\"]\n  if state.inventory[stick_idx] > 0:\n      return actions\n\n  primitives_needed = world.cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n  cur_pos = tuple(state.pos)\n\n  for prim_idx, needed in primitives_needed.items():\n      for _ in range(needed):\n          if state.inventory[prim_idx] > 0:\n              continue\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(f\"primitive index {prim_idx} not found\")\n          path, target = bfs_to_adjacent(cur_pos, prim_cells, state.grid)\n          for nxt in path[1:]:\n              actions.append(move_action(cur_pos, nxt))\n              cur_pos = nxt\n          actions.extend(face_and_use(cur_pos, target))\n          # Simulate pickup so later searches see the updated world\n          state.grid[target[0], target[1], prim_idx] = 0\n          state.inventory[prim_idx] += 1\n\n  # -----------------------------------------------------------------\n  # 2) Move to workshop (if any) and craft the stick\n  # -----------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          raise RuntimeError(\"workshop for stick not present\")\n      path, target = bfs_to_adjacent(cur_pos, workshop_cells, state.grid)\n      for nxt in path[1:]:\n          actions.append(move_action(cur_pos, nxt))\n          cur_pos = nxt\n      actions.extend(face_and_use(cur_pos, target))\n  else:\n      # No specific workshop \u2013 just use at current location\n      actions.append(4)   # USE\n\n  return actions", "env_interactions": 7, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:49:05.117548", "function_name": "make_stick", "function_body": "  # Reset the environment and get the initial state\n  env.reset()\n  state = env._current_state\n\n  # Goal item index (stick)\n  goal_idx = env.task.goal\n\n  # Determine which primitive resources are required for this goal\n  needed = env.world.cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n\n  # Action plan to be returned\n  plan = []\n\n  # ----------------------------------------------------------------------\n  # Helper to move the agent from its current position to a target cell.\n  # This simple Manhattan approach assumes the target is reachable without\n  # needing to navigate around obstacles.\n  # ----------------------------------------------------------------------\n  def _move_to(target):\n      \"\"\"Return a list of actions that moves the agent to `target`.\"\"\"\n      nonlocal state\n      actions = []\n      while tuple(state.pos) != tuple(target):\n          r, c = state.pos\n          tr, tc = target\n          if r < tr:\n              act = 0          # DOWN\n          elif r > tr:\n              act = 1          # UP\n          elif c < tc:\n              act = 3          # RIGHT\n          else:\n              act = 2          # LEFT\n          actions.append(act)\n          _, state = env.step(act)   # apply movement, update state\n      return actions\n\n  # ----------------------------------------------------------------------\n  # 1. Collect all required primitive items.\n  # ----------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          # Locate the first occurrence of the primitive on the grid.\n          locations = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if locations.shape[0] == 0:\n              # Primitive not found \u2013 abort early.\n              return plan\n          target = tuple(locations[0])\n\n          # Move to the primitive and pick it up.\n          plan.extend(_move_to(target))\n          plan.append(4)                # USE to pick up\n          _, state = env.step(4)\n\n  # ----------------------------------------------------------------------\n  # 2. Go to the appropriate workshop (if any) and craft the goal item.\n  # ----------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = recipe.get(\"_at\")\n  if workshop_idx is not None:\n      # Find a workshop of the required type.\n      w_locs = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if w_locs.shape[0] > 0:\n          w_target = tuple(w_locs[0])\n          plan.extend(_move_to(w_target))\n\n  # Craft (or use) at the current location.\n  plan.append(4)                # USE to craft\n  _, state = env.step(4)\n\n  return plan", "env_interactions": 0, "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-10-21T18:49:06.226886", "function_name": "make_stick", "function_body": "  env.reset()\n  state = env._current_state\n\n  # Index of the goal item (e.g., stick)\n  goal_idx = env.task.goal\n\n  # Primitives required for the goal according to the recipe\n  needed = env.world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  def _move_to(target):\n      \"\"\"Return a list of actions moving the agent to `target`.\"\"\"\n      nonlocal state\n      actions = []\n      while tuple(state.pos) != tuple(target):\n          r, c = state.pos\n          tr, tc = target\n          if r < tr:\n              act = 0          # DOWN\n          elif r > tr:\n              act = 1          # UP\n          elif c < tc:\n              act = 3          # RIGHT\n          else:\n              act = 2          # LEFT\n          actions.append(act)\n          _, state = env.step(act)   # apply action, update state\n      return actions\n\n  plan = []   # final action list to be returned\n\n  # ----------------------------------------------------------------------\n  # 1. Collect all required primitive items.\n  # ----------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          # Find a location of the primitive on the grid.\n          locations = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if locations.shape[0] == 0:\n              # Primitive not present \u2013 skip (should not happen in a valid scenario)\n              continue\n          target = tuple(locations[0])\n          # Move to the primitive and pick it up.\n          plan.extend(_move_to(target))\n          plan.append(4)                # USE to collect\n          _, state = env.step(4)\n\n  # ----------------------------------------------------------------------\n  # 2. Go to the appropriate workshop (if required) and craft the goal.\n  # ----------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = recipe.get('_at')\n  if workshop_idx is not None:\n      w_locs = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if w_locs.shape[0] > 0:\n          w_target = tuple(w_locs[0])\n          plan.extend(_move_to(w_target))\n          plan.append(4)                # USE to craft at the workshop\n          _, state = env.step(4)\n\n  return plan", "env_interactions": 0, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:49:25.702960", "function_name": "make_stick", "function_body": "  env.reset()\n  state = env._current_state\n\n  goal_idx = env.task.goal\n  # Primitive counts needed for the goal (expanded to primitives only)\n  required = env.world.cookbook.primitives_for(goal_idx)\n\n  # Helper to move from the current position to a target cell using Manhattan moves\n  def _move_to(target):\n      nonlocal state\n      actions = []\n      while tuple(state.pos) != tuple(target):\n          r, c = state.pos\n          tr, tc = target\n          if r < tr:\n              act = 0   # DOWN\n          elif r > tr:\n              act = 1   # UP\n          elif c < tc:\n              act = 3   # RIGHT\n          else:\n              act = 2   # LEFT\n          actions.append(act)\n          _, state = env.step(act)\n      return actions\n\n  plan = []\n\n  # --------------------------------------------------------------\n  # 1. Collect all required primitives.\n  # --------------------------------------------------------------\n  for prim_idx, cnt in required.items():\n      for _ in range(cnt):\n          # Locate cells that currently contain the primitive.\n          locs = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if locs.size == 0:\n              # Primitive missing \u2013 abort early.\n              return plan\n          # Choose the closest instance (Manhattan distance).\n          cur = np.array(state.pos)\n          dists = np.abs(locs - cur).sum(axis=1)\n          target = tuple(locs[dists.argmin()])\n          plan.extend(_move_to(target))\n          plan.append(4)                # USE to pick up\n          _, state = env.step(4)\n\n  # --------------------------------------------------------------\n  # 2. If the recipe requires a workshop, go there and craft.\n  # --------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = recipe.get(\"_at\", None)\n  if workshop_idx is not None:\n      w_locs = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if w_locs.size > 0:\n          cur = np.array(state.pos)\n          dists = np.abs(w_locs - cur).sum(axis=1)\n          target = tuple(w_locs[dists.argmin()])\n          plan.extend(_move_to(target))\n          plan.append(4)                # USE to craft\n          _, state = env.step(4)\n\n  return plan", "env_interactions": 0, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:49:26.801684", "function_name": "make_stick", "function_body": "  env.reset()\n  state = env._current_state\n\n  goal_idx = env.task.goal\n  # primitive requirements (primitive index -> count)\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)\n\n  def _move_to(target):\n      \"\"\"Move from current state.pos to target using simple Manhattan moves.\n      Returns list of actions and updates the external `state` variable.\"\"\"\n      nonlocal state\n      actions = []\n      while tuple(state.pos) != tuple(target):\n          r, c = state.pos\n          tr, tc = target\n          if r < tr:\n              act = 0   # DOWN\n          elif r > tr:\n              act = 1   # UP\n          elif c < tc:\n              act = 3   # RIGHT\n          else:\n              act = 2   # LEFT\n          actions.append(act)\n          _, state = env.step(act)\n      return actions\n\n  plan = []\n\n  # 1. Gather all required primitives.\n  for prim_idx, count in primitives_needed.items():\n      for _ in range(count):\n          # locate any cell containing this primitive\n          locs = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if locs.size == 0:\n              # primitive not present \u2013 cannot continue\n              return plan\n          # choose the closest one (Manhattan distance)\n          cur = np.array(state.pos)\n          dists = np.abs(locs - cur).sum(axis=1)\n          target = tuple(locs[dists.argmin()])\n          plan.extend(_move_to(target))\n          # pick up the primitive\n          plan.append(4)   # USE\n          _, state = env.step(4)\n\n  # 2. If the recipe requires a workshop, go there and craft.\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = recipe.get('_at', None)\n  if workshop_idx is not None:\n      w_locs = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if w_locs.size > 0:\n          cur = np.array(state.pos)\n          dists = np.abs(w_locs - cur).sum(axis=1)\n          target = tuple(w_locs[dists.argmin()])\n          plan.extend(_move_to(target))\n          plan.append(4)   # USE to craft\n          _, state = env.step(4)\n\n  return plan", "env_interactions": 0, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:49:59.416347", "function_name": "make_stick", "function_body": "  # reset environment and get initial state\n  env.reset()\n  state = env._current_state\n\n  # action mappings\n  act_map = env.action_specs()                # e.g. {\"UP\":0, \"DOWN\":1, ...}\n  inv_act = {v: k for k, v in act_map.items()}\n\n  # non\u2011traversable kinds (cannot step on)\n  blocked_kinds = env.world.non_grabbable_indices\n\n  # indices of target item and its recipe ingredients\n  stick_idx = env.world.cookbook.index[\"stick\"]\n  needed = env.world.cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n\n  # -----------------------------------------------------------------\n  # Helper utilities\n  # -----------------------------------------------------------------\n  def walkable(pos):\n      \"\"\"True if *pos* does not contain any non\u2011grabbable entity.\"\"\"\n      x, y = pos\n      return not any(state.grid[x, y, k] > 0 for k in blocked_kinds)\n\n  def manhattan(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def bfs(start, targets):\n      \"\"\"Bread\u2011first search from *start* to any cell in *targets*.\n      Returns a list of positions (including start and goal) or None.\"\"\"\n      from collections import deque\n      q = deque([start])\n      prev = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur in targets:\n              # reconstruct path\n              path = []\n              while cur is not None:\n                  path.append(cur)\n                  cur = prev[cur]\n              path.reverse()\n              return path\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                  nxt = (nx, ny)\n                  if nxt not in prev and walkable(nxt):\n                      prev[nxt] = cur\n                      q.append(nxt)\n      return None\n\n  def move_to_action(p, q):\n      \"\"\"Convert a step from *p* \u2192 *q* into an action index.\"\"\"\n      dx, dy = q[0] - p[0], q[1] - p[1]\n      if (dx, dy) == (-1, 0):\n          return act_map[\"UP\"]\n      if (dx, dy) == (1, 0):\n          return act_map[\"DOWN\"]\n      if (dx, dy) == (0, -1):\n          return act_map[\"LEFT\"]\n      if (dx, dy) == (0, 1):\n          return act_map[\"RIGHT\"]\n      raise ValueError(\"Invalid move\")\n\n  def face_direction(vec):\n      \"\"\"Return the action index that makes the agent face *vec* (target - agent).\"\"\"\n      dx, dy = vec\n      if (dx, dy) == (-1, 0):\n          return act_map[\"UP\"]\n      if (dx, dy) == (1, 0):\n          return act_map[\"DOWN\"]\n      if (dx, dy) == (0, -1):\n          return act_map[\"LEFT\"]\n      if (dx, dy) == (0, 1):\n          return act_map[\"RIGHT\"]\n      raise ValueError(\"Cannot face non\u2011adjacent direction\")\n\n  # -----------------------------------------------------------------\n  actions = []\n\n  # -----------------------------------------------------------------\n  # Collect all required primitives\n  # -----------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          # locate any remaining instance of the primitive\n          locs = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if locs.shape[0] == 0:\n              raise RuntimeError(f\"Required primitive {prim_idx} not found on the map.\")\n          target = tuple(locs[0])          # (x, y) of the primitive\n\n          # compute walkable cells adjacent to the primitive\n          adj = []\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              ax, ay = target[0] + dx, target[1] + dy\n              if 0 <= ax < state.grid.shape[0] and 0 <= ay < state.grid.shape[1]:\n                  if walkable((ax, ay)):\n                      adj.append((ax, ay))\n\n          # find shortest path to any adjacent cell\n          path = bfs(state.pos, set(adj))\n          if path is None:\n              raise RuntimeError(\"Primitive is unreachable.\")\n\n          # follow the path (skip the first node which is the current position)\n          for i in range(1, len(path)):\n              a = move_to_action(path[i - 1], path[i])\n              actions.append(a)\n              _, state = env.step(a)\n              env._current_state = state\n\n          # now we are adjacent; determine facing direction towards the primitive\n          facing = face_direction((target[0] - state.pos[0], target[1] - state.pos[1]))\n\n          # ensure the agent is actually facing the primitive.\n          # We turn by stepping one cell back then forward if possible,\n          # otherwise we perform a dummy left\u2011right turn.\n          opp_dir = {\"UP\": \"DOWN\", \"DOWN\": \"UP\", \"LEFT\": \"RIGHT\", \"RIGHT\": \"LEFT\"}[inv_act[facing]]\n          opp_act = act_map[opp_dir]\n          back_pos = (state.pos[0] - (target[0] - state.pos[0]),\n                      state.pos[1] - (target[1] - state.pos[1]))\n          if (0 <= back_pos[0] < state.grid.shape[0] and\n              0 <= back_pos[1] < state.grid.shape[1] and\n              walkable(back_pos)):\n              # step back\n              actions.append(opp_act)\n              _, state = env.step(opp_act)\n              env._current_state = state\n              # step forward (now facing target)\n              actions.append(facing)\n              _, state = env.step(facing)\n              env._current_state = state\n          else:\n              # fallback dummy turn\n              dummy = act_map[\"LEFT\"]\n              actions.append(dummy)\n              _, state = env.step(dummy)\n              env._current_state = state\n              actions.append(facing)\n              _, state = env.step(facing)\n              env._current_state = state\n\n          # use the primitive\n          actions.append(act_map[\"USE\"])\n          _, state = env.step(act_map[\"USE\"])\n          env._current_state = state\n\n  # -----------------------------------------------------------------\n  # Craft the stick (USE when inventory has required items)\n  # -----------------------------------------------------------------\n  actions.append(act_map[\"USE\"])\n  _, state = env.step(act_map[\"USE\"])\n  env._current_state = state\n\n  return actions", "env_interactions": 0, "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-10-21T18:50:00.545064", "function_name": "make_stick", "function_body": "  # Reset environment and get initial state\n  env.reset()\n  state = env._current_state\n\n  # Action mappings\n  act_map = env.action_specs()               # e.g. {\"UP\":0, \"DOWN\":1, ...}\n  inv_act = {v: k for k, v in act_map.items()}\n\n  # Indices of entities that block movement\n  blocked_kinds = env.world.non_grabbable_indices\n\n  # Index of the target item \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      stick_idx = env.world.cookbook.index.index(\"stick\")\n\n  # If we already have a stick, nothing to do\n  if state.inventory[stick_idx] > 0:\n      return []\n\n  # -----------------------------------------------------------------\n  # Helper utilities\n  # -----------------------------------------------------------------\n  def walkable(pos):\n      \"\"\"Return True if *pos* does not contain any blocking entity.\"\"\"\n      x, y = pos\n      return not any(state.grid[x, y, k] > 0 for k in blocked_kinds)\n\n  def bfs(start, targets):\n      \"\"\"Bread\u2011first search from *start* to any cell in *targets*.\n      Returns a list of positions (including start and goal) or None.\"\"\"\n      from collections import deque\n      q = deque([start])\n      prev = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur in targets:\n              # reconstruct path\n              path = []\n              while cur is not None:\n                  path.append(cur)\n                  cur = prev[cur]\n              path.reverse()\n              return path\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                  nxt = (nx, ny)\n                  if nxt not in prev and walkable(nxt):\n                      prev[nxt] = cur\n                      q.append(nxt)\n      return None\n\n  def move_to_action(p, q):\n      \"\"\"Convert a step from *p* \u2192 *q* into an action index.\"\"\"\n      dx, dy = q[0] - p[0], q[1] - p[1]\n      if (dx, dy) == (-1, 0):\n          return act_map[\"UP\"]\n      if (dx, dy) == (1, 0):\n          return act_map[\"DOWN\"]\n      if (dx, dy) == (0, -1):\n          return act_map[\"LEFT\"]\n      if (dx, dy) == (0, 1):\n          return act_map[\"RIGHT\"]\n      raise ValueError(\"Invalid move\")\n\n  def adjacent_cells(pos):\n      \"\"\"Return list of walkable cells adjacent to *pos*.\"\"\"\n      adj = []\n      x, y = pos\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n              if walkable((nx, ny)):\n                  adj.append((nx, ny))\n      return adj\n\n  def face_direction(target):\n      \"\"\"Return action index that makes the agent face *target* (must be adjacent).\"\"\"\n      dx, dy = target[0] - state.pos[0], target[1] - state.pos[1]\n      if (dx, dy) == (-1, 0):\n          return act_map[\"UP\"]\n      if (dx, dy) == (1, 0):\n          return act_map[\"DOWN\"]\n      if (dx, dy) == (0, -1):\n          return act_map[\"LEFT\"]\n      if (dx, dy) == (0, 1):\n          return act_map[\"RIGHT\"]\n      return None\n\n  def set_facing(desired_action):\n      \"\"\"Rotate agent to face direction encoded by *desired_action*.\"\"\"\n      # The environment only changes facing when moving;\n      # we achieve the desired facing by stepping one cell opposite\n      # and stepping back (if possible). If not possible, we perform a dummy\n      # left\u2011right move to reset facing.\n      current_facing = state.dir\n      if current_facing == desired_action:\n          return []  # already facing\n      # Find opposite direction name\n      opp_name = {\"UP\": \"DOWN\", \"DOWN\": \"UP\", \"LEFT\": \"RIGHT\", \"RIGHT\": \"LEFT\"}[inv_act[desired_action]]\n      opp_act = act_map[opp_name]\n      # Compute position after moving opposite\n      dx, dy = {\n          act_map[\"UP\"]: (-1, 0), act_map[\"DOWN\"]: (1, 0),\n          act_map[\"LEFT\"]: (0, -1), act_map[\"RIGHT\"]: (0, 1)\n      }[opp_act]\n      opp_pos = (state.pos[0] + dx, state.pos[1] + dy)\n      seq = []\n      if 0 <= opp_pos[0] < state.grid.shape[0] and 0 <= opp_pos[1] < state.grid.shape[1] and walkable(opp_pos):\n          seq.append(opp_act)\n          _, new_state = env.step(opp_act)\n          state = new_state\n          env._current_state = state\n          seq.append(desired_action)\n          _, new_state = env.step(desired_action)\n          state = new_state\n          env._current_state = state\n      else:\n          # fallback dummy move left then right (or any two moves) to reset facing\n          dummy = act_map[\"LEFT\"]\n          seq.append(dummy)\n          _, new_state = env.step(dummy)\n          state = new_state\n          env._current_state = state\n          seq.append(desired_action)\n          _, new_state = env.step(desired_action)\n          state = new_state\n          env._current_state = state\n      return seq\n\n  # -----------------------------------------------------------------\n  actions = []\n\n  # -----------------------------------------------------------------\n  # 1. Collect required primitive resources\n  # -----------------------------------------------------------------\n  needed = env.world.cookbook.primitives_for(stick_idx)  # dict {prim_idx: count}\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          # Locate any cell containing the primitive\n          locations = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if locations.size == 0:\n              raise RuntimeError(f\"Required primitive index {prim_idx} not found on the map.\")\n          prim_pos = tuple(locations[0])\n\n          # Find walkable adjacent cell to the primitive\n          adj = set(adjacent_cells(prim_pos))\n          path = bfs(state.pos, adj)\n          if path is None:\n              raise RuntimeError(\"Cannot reach required primitive.\")\n\n          # Follow the path (skip starting cell)\n          for i in range(1, len(path)):\n              a = move_to_action(path[i - 1], path[i])\n              actions.append(a)\n              _, new_state = env.step(a)\n              state = new_state\n              env._current_state = state\n\n          # Now we are on a cell adjacent to the primitive.\n          # Face the primitive.\n          face_act = face_direction(prim_pos)\n          if face_act is not None:\n              actions.extend(set_facing(face_act))\n\n          # Use to pick up the primitive\n          actions.append(act_map[\"USE\"])\n          _, new_state = env.step(act_map[\"USE\"])\n          state = new_state\n          env._current_state = state\n\n  # -----------------------------------------------------------------\n  # 2. Move to workshop (if required) and craft the stick\n  # -----------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  workshop_idx = recipe.get(\"_at\")\n  if workshop_idx is not None:\n      # Locate any workshop of this type\n      ws_locs = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if ws_locs.size == 0:\n          raise RuntimeError(\"Required workshop not found on the map.\")\n      ws_pos = tuple(ws_locs[0])\n      # Find adjacent walkable cell\n      adj_ws = set(adjacent_cells(ws_pos))\n      path = bfs(state.pos, adj_ws)\n      if path is None:\n          raise RuntimeError(\"Cannot reach required workshop.\")\n      for i in range(1, len(path)):\n          a = move_to_action(path[i - 1], path[i])\n          actions.append(a)\n          _, new_state = env.step(a)\n          state = new_state\n          env._current_state = state\n      # Face the workshop\n      face_act = face_direction(ws_pos)\n      if face_act is not None:\n          actions.extend(set_facing(face_act))\n\n  # Final USE to craft the stick\n  actions.append(act_map[\"USE\"])\n  _, new_state = env.step(act_map[\"USE\"])\n  state = new_state\n  env._current_state = state\n\n  return actions", "env_interactions": 0, "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-10-21T18:50:13.963254", "function_name": "make_stick", "function_body": "  import numpy as np\n\n  # ------------------------------------------------------------------\n  # Basic environment interfaces\n  # ------------------------------------------------------------------\n  ACTION = env.action_specs()                     # mapping name \u2192 int\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def find_nearest(start_pos, kind):\n      \"\"\"Find the nearest cell (Manhattan) containing the given kind.\n      Returns (x, y) coordinates or None if not found.\"\"\"\n      layer = state.grid[:, :, kind]\n      ys, xs = np.where(layer > 0)\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - start_pos[0]) + np.abs(ys - start_pos[1])\n      i = int(np.argmin(dists))\n      return (int(xs[i]), int(ys[i]))\n\n  def moves_to(cur, target):\n      \"\"\"Generate a list of movement actions from cur \u2192 target (Manhattan).\"\"\"\n      seq = []\n      x, y = cur\n      tx, ty = target\n      while x != tx:\n          if tx > x:\n              seq.append(ACTION[\"RIGHT\"])\n              x += 1\n          else:\n              seq.append(ACTION[\"LEFT\"])\n              x -= 1\n      while y != ty:\n          if ty > y:\n              seq.append(ACTION[\"DOWN\"])\n              y += 1\n          else:\n              seq.append(ACTION[\"UP\"])\n              y -= 1\n      return seq\n\n  # ------------------------------------------------------------------\n  # Determine the recipe for a stick and the required primitives\n  # ------------------------------------------------------------------\n  stick_idx = idx[\"stick\"]\n  required = world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n  plan = []\n  cur_pos = state.pos\n\n  # ------------------------------------------------------------------\n  # Collect all required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, count in required.items():\n      for _ in range(count):\n          target = find_nearest(cur_pos, prim_idx)\n          if target is None:\n              # No reachable primitive \u2013 abort early\n              continue\n          plan.extend(moves_to(cur_pos, target))\n          plan.append(ACTION[\"USE\"])          # pick up the primitive\n          cur_pos = target\n\n  # ------------------------------------------------------------------\n  # If the recipe specifies a workshop, move there before crafting\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      wk_idx = idx[workshop_name] if isinstance(workshop_name, str) else workshop_name\n      wk_pos = find_nearest(cur_pos, wk_idx)\n      if wk_pos is not None:\n          plan.extend(moves_to(cur_pos, wk_pos))\n          cur_pos = wk_pos\n\n  # ------------------------------------------------------------------\n  # Final USE action to craft the stick (or simply pick it up if primitive)\n  # ------------------------------------------------------------------\n  plan.append(ACTION[\"USE\"])\n\n  return plan", "env_interactions": 4, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:50:15.079300", "function_name": "make_stick", "function_body": "  import numpy as np\n\n  # Mapping from action names to indices\n  ACTION = env.action_specs()\n\n  # Current state and world objects\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  # --------------------------------------------------------------\n  # Helper functions\n  # --------------------------------------------------------------\n  def find_nearest(position, kind):\n      \"\"\"Return (x, y) of the nearest cell that contains the given kind.\"\"\"\n      layer = state.grid[:, :, kind]\n      ys, xs = np.where(layer > 0)\n      if xs.size == 0:\n          return None\n      # Manhattan distance\n      dists = np.abs(xs - position[0]) + np.abs(ys - position[1])\n      i = int(np.argmin(dists))\n      return (int(xs[i]), int(ys[i]))\n\n  def moves_to(start, target):\n      \"\"\"Generate a sequence of movement actions (Manhattan) from start to target.\"\"\"\n      seq = []\n      x, y = start\n      tx, ty = target\n      while x != tx:\n          if tx > x:\n              seq.append(ACTION[\"RIGHT\"])\n              x += 1\n          else:\n              seq.append(ACTION[\"LEFT\"])\n              x -= 1\n      while y != ty:\n          if ty > y:\n              seq.append(ACTION[\"DOWN\"])\n              y += 1\n          else:\n              seq.append(ACTION[\"UP\"])\n              y -= 1\n      return seq\n\n  # --------------------------------------------------------------\n  # Determine what primitives are needed for a stick\n  # --------------------------------------------------------------\n  stick_idx = idx[\"stick\"]\n  required = world.cookbook.primitives_for(stick_idx)   # {primitive_idx: count}\n  plan = []\n  cur_pos = state.pos\n\n  # --------------------------------------------------------------\n  # Collect each required primitive\n  # --------------------------------------------------------------\n  for prim_idx, cnt in required.items():\n      for _ in range(cnt):\n          target = find_nearest(cur_pos, prim_idx)\n          if target is None:\n              # No such primitive on the map \u2013 cannot complete the task\n              continue\n          plan.extend(moves_to(cur_pos, target))\n          plan.append(ACTION[\"USE\"])          # pick up the primitive\n          cur_pos = target\n\n  # --------------------------------------------------------------\n  # Move to the appropriate workshop (if the recipe specifies one)\n  # --------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      # workshop may be stored as a string name or directly as an index\n      wk_idx = idx[workshop_name] if isinstance(workshop_name, str) else workshop_name\n      wk_pos = find_nearest(cur_pos, wk_idx)\n      if wk_pos is not None:\n          plan.extend(moves_to(cur_pos, wk_pos))\n          cur_pos = wk_pos\n\n  # --------------------------------------------------------------\n  # Final USE to craft the stick\n  # --------------------------------------------------------------\n  plan.append(ACTION[\"USE\"])\n\n  return plan", "env_interactions": 4, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:50:37.371967", "function_name": "make_stick", "function_body": "  # Reset environment and get initial state\n  env.reset()\n  state = env._current_state\n\n  # Action indices from the environment spec\n  act_spec = env.action_specs()\n  ACTION_USE = act_spec[\"USE\"]\n  ACTIONS_MOVE = {\n      \"UP\": act_spec[\"UP\"],\n      \"DOWN\": act_spec[\"DOWN\"],\n      \"LEFT\": act_spec[\"LEFT\"],\n      \"RIGHT\": act_spec[\"RIGHT\"],\n  }\n  DIR_VECT = {\n      \"UP\": (-1, 0),\n      \"DOWN\": (1, 0),\n      \"LEFT\": (0, -1),\n      \"RIGHT\": (0, 1),\n  }\n\n  # -----------------------------------------------------------------\n  # Helper: BFS that returns a list of movement actions from `start`\n  # to any cell in `targets`. Traversable cells are those with no\n  # entities (i.e., all-zero slice along the kind dimension).\n  # -----------------------------------------------------------------\n  from collections import deque\n\n  def bfs_path(start, targets):\n      h, w = state.grid.shape[:2]\n      visited = set()\n      q = deque([(start, [])])\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in visited:\n              continue\n          visited.add((x, y))\n          if (x, y) in targets:\n              return path\n          for name, (dx, dy) in DIR_VECT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < h and 0 <= ny < w:\n                  # Cell is free if no kind occupies it.\n                  if not state.grid[nx, ny].any():\n                      q.append(((nx, ny), path + [ACTIONS_MOVE[name]]))\n      return None\n\n  # -----------------------------------------------------------------\n  # Determine which primitives are required to craft a stick.\n  # -----------------------------------------------------------------\n  idx = state.world.cookbook.index\n  stick_idx = idx.index(\"stick\")\n  primitive_needs = state.world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n  actions = []\n\n  # -----------------------------------------------------------------\n  # Collect each required primitive.\n  # -----------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      while state.inventory[prim_idx] < needed_cnt:\n          # Locate all cells currently holding this primitive.\n          h, w = state.grid.shape[:2]\n          prim_cells = [(i, j) for i in range(h)\n                               for j in range(w)\n                               if state.grid[i, j, prim_idx] > 0]\n          if not prim_cells:\n              # No more of this primitive on the map; abort early.\n              return actions\n          # Find shortest path to any such cell.\n          path = bfs_path(state.pos, set(prim_cells))\n          if path is None:\n              return actions\n          # Execute the movement actions.\n          for a in path:\n              _, state = state.step(a)\n              actions.append(a)\n          # Use (pick up) the primitive.\n          _, state = state.step(ACTION_USE)\n          actions.append(ACTION_USE)\n\n  # -----------------------------------------------------------------\n  # If the recipe specifies a workshop, go there and craft.\n  # -----------------------------------------------------------------\n  recipe = state.world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\") if isinstance(recipe, dict) else None\n  if workshop_name:\n      workshop_idx = idx.index(workshop_name)\n      h, w = state.grid.shape[:2]\n      workshop_cells = [(i, j) for i in range(h)\n                                 for j in range(w)\n                                 if state.grid[i, j, workshop_idx] > 0]\n      if workshop_cells:\n          path = bfs_path(state.pos, set(workshop_cells))\n          if path:\n              for a in path:\n                  _, state = state.step(a)\n                  actions.append(a)\n              # Use at the workshop to craft the stick.\n              _, state = state.step(ACTION_USE)\n              actions.append(ACTION_USE)\n\n  # Return the complete action sequence.\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:50:38.483157", "function_name": "make_stick", "function_body": "  env.reset()\n  state = env._current_state\n\n  # Action indices.\n  act_spec = env.action_specs()\n  ACTION_USE = act_spec[\"USE\"]\n  ACTIONS_MOVE = {\n      \"UP\": act_spec[\"UP\"],\n      \"DOWN\": act_spec[\"DOWN\"],\n      \"LEFT\": act_spec[\"LEFT\"],\n      \"RIGHT\": act_spec[\"RIGHT\"],\n  }\n  DIR_VECT = {\n      \"UP\": (-1, 0),\n      \"DOWN\": (1, 0),\n      \"LEFT\": (0, -1),\n      \"RIGHT\": (0, 1),\n  }\n\n  # -----------------------------------------------------------------\n  # Helper: breadth\u2011first search returning a list of move actions that\n  # brings the agent from `start` to any cell in `targets`.\n  # Only empty cells are traversable.\n  # -----------------------------------------------------------------\n  from collections import deque\n\n  def bfs_path(start, targets):\n      h, w = state.grid.shape[:2]\n      visited = set()\n      q = deque([(start, [])])\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in visited:\n              continue\n          visited.add((x, y))\n          if (x, y) in targets:\n              return path\n          for name, (dx, dy) in DIR_VECT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < h and 0 <= ny < w:\n                  # Traversable iff no entity occupies the cell.\n                  if not state.grid[nx, ny].any():\n                      q.append(((nx, ny), path + [ACTIONS_MOVE[name]]))\n      return None\n\n  # -----------------------------------------------------------------\n  # 1. Determine the primitives required to craft a stick.\n  # -----------------------------------------------------------------\n  idx = state.world.cookbook.index\n  stick_idx = idx.index(\"stick\")\n  primitive_needs = state.world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n  actions = []\n\n  # -----------------------------------------------------------------\n  # 2. Collect each required primitive.\n  # -----------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      while state.inventory[prim_idx] < needed_cnt:\n          # Locate all cells that currently hold this primitive.\n          h, w = state.grid.shape[:2]\n          prim_cells = [(i, j)\n                        for i in range(h)\n                        for j in range(w)\n                        if state.grid[i, j, prim_idx] > 0]\n          if not prim_cells:\n              # No more of this primitive on the map \u2013 abort early.\n              return actions\n          # Find shortest path to any of them.\n          path = bfs_path(state.pos, set(prim_cells))\n          if path is None:\n              return actions\n          # Execute the moves.\n          for a in path:\n              _, state = state.step(a)\n              actions.append(a)\n          # Pick up the primitive.\n          _, state = state.step(ACTION_USE)\n          actions.append(ACTION_USE)\n\n  # -----------------------------------------------------------------\n  # 3. If the recipe requires a workshop, go there and craft.\n  # -----------------------------------------------------------------\n  recipe = state.world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\") if isinstance(recipe, dict) else None\n  if workshop_name:\n      workshop_idx = idx.index(workshop_name)\n      h, w = state.grid.shape[:2]\n      workshop_cells = [(i, j)\n                        for i in range(h)\n                        for j in range(w)\n                        if state.grid[i, j, workshop_idx] > 0]\n      if workshop_cells:\n          path = bfs_path(state.pos, set(workshop_cells))\n          if path:\n              for a in path:\n                  _, state = state.step(a)\n                  actions.append(a)\n              # Craft at the workshop.\n              _, state = state.step(ACTION_USE)\n              actions.append(ACTION_USE)\n\n  # -----------------------------------------------------------------\n  # 4. Return the accumulated list of actions.\n  # -----------------------------------------------------------------\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:51:00.683758", "function_name": "make_stick", "function_body": "  obs = env.reset()\n  state = env._current_state\n\n  # Action mappings\n  act_map = env.action_specs()          # e.g., {\"DOWN\":0,...}\n\n  # Indices\n  stick_idx = env.world.cookbook.index[\"stick\"]\n  blocked = set(env.world.non_grabbable_indices)\n\n  # Helper: check if a cell is walkable (no blocked entities)\n  def walkable(pos):\n      x, y = pos\n      return not any(state.grid[x, y, k] > 0 for k in blocked)\n\n  # BFS to find shortest path to any of the target cells\n  def bfs(start, targets):\n      from collections import deque\n      q = deque([start])\n      prev = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur in targets:\n              # reconstruct path\n              path = []\n              while cur is not None:\n                  path.append(cur)\n                  cur = prev[cur]\n              path.reverse()\n              return path\n          for dx, dy in ((-1, 0), (1, 0), (0, -1), (0, 1)):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                  nxt = (nx, ny)\n                  if nxt not in prev and walkable(nxt):\n                      prev[nxt] = cur\n                      q.append(nxt)\n      return None\n\n  # Convert movement between two adjacent cells into an action index\n  def move_action(p, q):\n      dx, dy = q[0] - p[0], q[1] - p[1]\n      if (dx, dy) == (-1, 0):\n          return act_map[\"UP\"]\n      if (dx, dy) == (1, 0):\n          return act_map[\"DOWN\"]\n      if (dx, dy) == (0, -1):\n          return act_map[\"LEFT\"]\n      if (dx, dy) == (0, 1):\n          return act_map[\"RIGHT\"]\n      raise ValueError(\"Non\u2011adjacent move\")\n\n  actions = []\n\n  # Main loop: keep collecting sticks until we have one\n  while state.inventory[stick_idx] == 0:\n      # Locate all sticks on the map\n      xs, ys = np.where(state.grid[:, :, stick_idx] > 0)\n      stick_positions = list(zip(xs.tolist(), ys.tolist()))\n      if not stick_positions:\n          # No sticks left; abort\n          break\n\n      # Choose the closest stick by Manhattan distance\n      cur_pos = state.pos\n      target = min(stick_positions,\n                   key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))\n\n      # Find walkable adjacent cells to the target stick\n      adj_cells = []\n      for dx, dy in ((-1, 0), (1, 0), (0, -1), (0, 1)):\n          ax, ay = target[0] + dx, target[1] + dy\n          if 0 <= ax < state.grid.shape[0] and 0 <= ay < state.grid.shape[1]:\n              if walkable((ax, ay)):\n                  adj_cells.append((ax, ay))\n\n      # Compute shortest path to any adjacent cell\n      path = bfs(cur_pos, set(adj_cells))\n      if path is None:\n          # Cannot reach this stick; give up\n          break\n\n      # Follow the path step by step\n      for i in range(1, len(path)):\n          a = move_action(path[i - 1], path[i])\n          actions.append(a)\n          _, state = env.step(a)\n          env._current_state = state\n\n      # We are now adjacent to the stick. Determine direction towards it.\n      dx, dy = target[0] - state.pos[0], target[1] - state.pos[1]\n      if (dx, dy) == (-1, 0):\n          desired_dir = \"UP\"\n      elif (dx, dy) == (1, 0):\n          desired_dir = \"DOWN\"\n      elif (dx, dy) == (0, -1):\n          desired_dir = \"LEFT\"\n      elif (dx, dy) == (0, 1):\n          desired_dir = \"RIGHT\"\n      else:\n          desired_dir = None\n\n      if desired_dir is not None:\n          # Turn to face the stick by moving one step away and back if possible\n          opposite = {\"UP\": \"DOWN\", \"DOWN\": \"UP\", \"LEFT\": \"RIGHT\", \"RIGHT\": \"LEFT\"}[desired_dir]\n          ox, oy = state.pos[0] - dx, state.pos[1] - dy\n          if 0 <= ox < state.grid.shape[0] and 0 <= oy < state.grid.shape[1] and walkable((ox, oy)):\n              actions.append(act_map[opposite])\n              _, state = env.step(act_map[opposite])\n              env._current_state = state\n              actions.append(act_map[desired_dir])\n              _, state = env.step(act_map[desired_dir])\n              env._current_state = state\n          else:\n              # Fallback: a dummy left/right move to change facing\n              dummy = \"LEFT\"\n              actions.append(act_map[dummy])\n              _, state = env.step(act_map[dummy])\n              env._current_state = state\n              actions.append(act_map[desired_dir])\n              _, state = env.step(act_map[desired_dir])\n              env._current_state = state\n\n          # Use the stick in front of us\n          actions.append(act_map[\"USE\"])\n          _, state = env.step(act_map[\"USE\"])\n          env._current_state = state\n      else:\n          # Unexpected situation; abort loop\n          break\n\n  return actions", "env_interactions": 0, "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:51:01.810718", "function_name": "make_stick", "function_body": "  # Reset environment and get initial state\n  obs = env.reset()\n  state = env._current_state\n\n  # Action mapping (e.g., {\"UP\": 0, \"DOWN\": 1, ...})\n  act_map = env.action_specs()\n  # Reverse mapping (optional)\n  inv_act = {v: k for k, v in act_map.items()}\n\n  # Index of the target item (stick) and blocked entity indices\n  stick_idx = env.world.cookbook.index[\"stick\"]\n  blocked = set(env.world.non_grabbable_indices)\n\n  # ----------------------------------------------------------------------\n  # Helper functions\n  # ----------------------------------------------------------------------\n  def walkable(pos):\n      \"\"\"Return True if the cell at `pos` does not contain any non\u2011grabbable entity.\"\"\"\n      x, y = pos\n      return not any(state.grid[x, y, k] > 0 for k in blocked)\n\n  def bfs(start, targets):\n      \"\"\"Bread\u2011first search from `start` to the nearest cell in `targets`.\"\"\"\n      from collections import deque\n      q = deque([start])\n      prev = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur in targets:\n              # Reconstruct path (including start and target)\n              path = []\n              while cur is not None:\n                  path.append(cur)\n                  cur = prev[cur]\n              path.reverse()\n              return path\n          for dx, dy in ((-1, 0), (1, 0), (0, -1), (0, 1)):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                  nxt = (nx, ny)\n                  if nxt not in prev and walkable(nxt):\n                      prev[nxt] = cur\n                      q.append(nxt)\n      return None\n\n  def move_action(p, q):\n      \"\"\"Convert a step from `p` to adjacent `q` into an action index.\"\"\"\n      dx, dy = q[0] - p[0], q[1] - p[1]\n      if (dx, dy) == (-1, 0):\n          return act_map[\"UP\"]\n      if (dx, dy) == (1, 0):\n          return act_map[\"DOWN\"]\n      if (dx, dy) == (0, -1):\n          return act_map[\"LEFT\"]\n      if (dx, dy) == (0, 1):\n          return act_map[\"RIGHT\"]\n      raise ValueError(\"Attempted to move between non\u2011adjacent cells\")\n\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # Main loop \u2013 keep moving until we have a stick in the inventory\n  # ----------------------------------------------------------------------\n  while state.inventory[stick_idx] == 0:\n      # Locate all sticks currently placed on the grid\n      xs, ys = np.where(state.grid[:, :, stick_idx] > 0)\n      stick_positions = list(zip(xs.tolist(), ys.tolist()))\n      if not stick_positions:\n          # No sticks left on the map \u2013 abort\n          break\n\n      # Choose the closest stick (Manhattan distance)\n      cur_pos = state.pos\n      target = min(\n          stick_positions,\n          key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]),\n      )\n\n      # Determine walkable cells adjacent to the target stick\n      adj_cells = []\n      for dx, dy in ((-1, 0), (1, 0), (0, -1), (0, 1)):\n          ax, ay = target[0] + dx, target[1] + dy\n          if 0 <= ax < state.grid.shape[0] and 0 <= ay < state.grid.shape[1]:\n              if walkable((ax, ay)):\n                  adj_cells.append((ax, ay))\n\n      # Find shortest path to any of the adjacent cells\n      path = bfs(cur_pos, set(adj_cells))\n      if path is None:\n          # Cannot reach this stick \u2013 remove it from consideration and retry\n          # (simple heuristic: break to avoid infinite loops)\n          break\n\n      # Execute the path step\u2011by\u2011step\n      for i in range(1, len(path)):\n          a = move_action(path[i - 1], path[i])\n          actions.append(a)\n          _, state = env.step(a)\n          env._current_state = state\n\n      # ------------------------------------------------------------------\n      # We are now adjacent to the stick.  Turn to face it and USE.\n      # ------------------------------------------------------------------\n      dx, dy = target[0] - state.pos[0], target[1] - state.pos[1]\n\n      if (dx, dy) == (-1, 0):\n          desired_dir = \"UP\"\n      elif (dx, dy) == (1, 0):\n          desired_dir = \"DOWN\"\n      elif (dx, dy) == (0, -1):\n          desired_dir = \"LEFT\"\n      elif (dx, dy) == (0, 1):\n          desired_dir = \"RIGHT\"\n      else:\n          desired_dir = None\n\n      if desired_dir is None:\n          # Something went wrong \u2013 abort to avoid infinite loop\n          break\n\n      # To correctly set the facing direction we may need to move one step\n      # away and then step back (this changes the internal direction state).\n      opposite = {\"UP\": \"DOWN\", \"DOWN\": \"UP\", \"LEFT\": \"RIGHT\", \"RIGHT\": \"LEFT\"}[\n          desired_dir\n      ]\n      ox, oy = state.pos[0] - dx, state.pos[1] - dy  # cell opposite the stick\n      if (\n          0 <= ox < state.grid.shape[0]\n          and 0 <= oy < state.grid.shape[1]\n          and walkable((ox, oy))\n      ):\n          # Step away\n          actions.append(act_map[opposite])\n          _, state = env.step(act_map[opposite])\n          env._current_state = state\n          # Step back \u2013 now we face the stick\n          actions.append(act_map[desired_dir])\n          _, state = env.step(act_map[desired_dir])\n          env._current_state = state\n      else:\n          # If we cannot step away, perform a dummy turn (move left then right)\n          dummy = \"LEFT\"\n          actions.append(act_map[dummy])\n          _, state = env.step(act_map[dummy])\n          env._current_state = state\n          actions.append(act_map[desired_dir])\n          _, state = env.step(act_map[desired_dir])\n          env._current_state = state\n\n      # Finally, USE the stick in front of us\n      actions.append(act_map[\"USE\"])\n      _, state = env.step(act_map[\"USE\"])\n      env._current_state = state\n\n  # Return the compiled action list\n  return actions", "env_interactions": 0, "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T18:51:34.154408", "function_name": "make_stick", "function_body": "  # ----------------------------------------------------------------------\n  # Retrieve environment information\n  # ----------------------------------------------------------------------\n  action_map = env.action_specs()\n  DOWN = action_map.get(\"DOWN\", 0)\n  UP = action_map.get(\"UP\", 1)\n  LEFT = action_map.get(\"LEFT\", 2)\n  RIGHT = action_map.get(\"RIGHT\", 3)\n  USE = action_map.get(\"USE\", 4)\n\n  # direction vectors aligned with action indices\n  DIRS = [\n      (1, 0, DOWN),   # down  (row +1)\n      (-1, 0, UP),    # up    (row -1)\n      (0, -1, LEFT),  # left  (col -1)\n      (0, 1, RIGHT),  # right (col +1)\n  ]\n\n  # goal index (the item we want to obtain)\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      return []\n\n  # world and cookbook objects\n  world = getattr(env, \"world\", None)\n  if world is None:\n      return []\n  cookbook = getattr(world, \"cookbook\", None)\n  if cookbook is None:\n      return []\n\n  # current state information\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []\n  grid = getattr(state, \"grid\", None)\n  cur_pos = getattr(state, \"pos\", None)\n  if grid is None or cur_pos is None:\n      return []\n\n  H, W = grid.shape[0], grid.shape[1]\n\n  # ----------------------------------------------------------------------\n  # Helper utilities\n  # ----------------------------------------------------------------------\n  def in_bounds(p):\n      return 0 <= p[0] < H and 0 <= p[1] < W\n\n  # cells containing any non\u2011grabbable entity are blocked\n  non_grabbable = set(world.non_grabbable_indices)\n\n  def walkable(p):\n      if not in_bounds(p):\n          return False\n      for idx in non_grabbable:\n          if grid[p[0], p[1], idx] > 0:\n              return False\n      return True\n\n  from collections import deque\n\n  def bfs_path(start, targets):\n      \"\"\"\n      Return a list of actions that moves the agent from `start` to the\n      nearest cell in `targets`.  If no target is reachable, returns None.\n      \"\"\"\n      target_set = set(targets)\n      if start in target_set:\n          return []\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          cur, path = q.popleft()\n          for dx, dy, act in DIRS:\n              nxt = (cur[0] + dx, cur[1] + dy)\n              if not walkable(nxt):\n                  continue\n              if nxt in visited:\n                  continue\n              new_path = path + [act]\n              if nxt in target_set:\n                  return new_path\n              visited.add(nxt)\n              q.append((nxt, new_path))\n      return None  # unreachable\n\n  # ----------------------------------------------------------------------\n  # Determine which primitives are required for the goal\n  # ----------------------------------------------------------------------\n  primitives_needed = cookbook.primitives_for(goal_idx)\n  need_crafting = True\n  if not primitives_needed:\n      # Goal itself is a primitive; we just need to pick it up\n      primitives_needed = {goal_idx: 1}\n      need_crafting = False\n\n  actions = []\n  # ----------------------------------------------------------------------\n  # Collect each required primitive\n  # ----------------------------------------------------------------------\n  for prim_idx, qty in primitives_needed.items():\n      # locate all cells that currently contain this primitive\n      locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n      if not locations:\n          # primitive not present \u2013 cannot solve the task\n          return []\n      collected = 0\n      while collected < qty:\n          # choose the nearest location (Manhattan heuristic)\n          nearest = min(locations,\n                        key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))\n          # path to that cell\n          path = bfs_path(cur_pos, [nearest])\n          if path is None:\n              return []  # unreachable\n          actions.extend(path)\n          cur_pos = nearest\n          # pick up the primitive\n          actions.append(USE)\n          collected += 1\n          # we do not modify the grid; simply continue (other copies may exist)\n\n  # ----------------------------------------------------------------------\n  # If a workshop is required, move there and craft\n  # ----------------------------------------------------------------------\n  if need_crafting:\n      recipe = cookbook.recipes.get(goal_idx, {})\n      workshop_kind = recipe.get(\"_at\", None)\n      if workshop_kind is not None:\n          workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n          if not workshop_cells:\n              return []\n          target_ws = min(workshop_cells,\n                          key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))\n          path = bfs_path(cur_pos, [target_ws])\n          if path is None:\n              return []\n          actions.extend(path)\n          cur_pos = target_ws\n      # perform the crafting action\n      actions.append(USE)\n\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
