{"timestamp": "2025-10-21T17:31:03.901930", "function_name": "make_stick", "function_body": "  # reset environment and fetch initial state\n  env.reset()\n  state = env._current_state  # type: CraftState\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  act_spec = env.action_specs()\n  ACTION_USE = act_spec[\"USE\"]\n  ACTIONS_MOVE = {\n      \"UP\": act_spec[\"UP\"],\n      \"DOWN\": act_spec[\"DOWN\"],\n      \"LEFT\": act_spec[\"LEFT\"],\n      \"RIGHT\": act_spec[\"RIGHT\"],\n  }\n  DIR_VECT = {\n      \"UP\": (-1, 0),\n      \"DOWN\": (1, 0),\n      \"LEFT\": (0, -1),\n      \"RIGHT\": (0, 1),\n  }\n\n  # BFS that returns a list of action IDs moving the agent from ``start``\n  # to the closest cell in ``targets`` that is reachable through empty cells.\n  def bfs_path(start, targets):\n      from collections import deque\n\n      h, w = state.grid.shape[:2]\n      visited = set()\n      q = deque([(start, [])])\n\n      while q:\n          pos, path = q.popleft()\n          if pos in visited:\n              continue\n          visited.add(pos)\n\n          if pos in targets:\n              return path\n\n          x, y = pos\n          for name, (dx, dy) in DIR_VECT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < h and 0 <= ny < w:\n                  # walkable iff the cell is completely empty (no kind present)\n                  if not state.grid[nx, ny].any():\n                      q.append(((nx, ny), path + [ACTIONS_MOVE[name]]))\n      return None\n\n  # ------------------------------------------------------------------\n  # Identify goal index for \u201cstick\u201d and its primitive requirements.\n  # ------------------------------------------------------------------\n  idx = state.world.cookbook.index\n  stick_idx = idx.index(\"stick\")\n  primitive_needs = state.world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper to compute empty cells adjacent to any cell containing ``kind_idx``.\n  # ------------------------------------------------------------------\n  def adjacent_empty_cells(kind_idx):\n      h, w = state.grid.shape[:2]\n      adj = set()\n      for i in range(h):\n          for j in range(w):\n              if state.grid[i, j, kind_idx] > 0:\n                  for dx, dy in DIR_VECT.values():\n                      ni, nj = i + dx, j + dy\n                      if 0 <= ni < h and 0 <= nj < w:\n                          if not state.grid[ni, nj].any():\n                              adj.add((ni, nj))\n      return adj\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive.\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      while state.inventory[prim_idx] < needed_cnt:\n          # Determine reachable empty cells adjacent to any remaining primitive.\n          targets = adjacent_empty_cells(prim_idx)\n          if not targets:\n              # No reachable primitive left \u2013 break to avoid infinite loop.\n              break\n\n          path = bfs_path(state.pos, targets)\n          if path is None:\n              # No path to any target \u2013 break.\n              break\n\n          # Execute movement actions.\n          for a in path:\n              _, state = state.step(a)\n              actions.append(a)\n\n          # Use the primitive (collect).\n          _, state = state.step(ACTION_USE)\n          actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # If the recipe specifies a workshop, go there and craft the stick.\n  # ------------------------------------------------------------------\n  recipe_dict = state.world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = None\n  if isinstance(recipe_dict, dict):\n      workshop_name = recipe_dict.get(\"_at\")\n\n  if workshop_name:\n      workshop_idx = idx.index(workshop_name)\n\n      # Find empty cells adjacent to any workshop location.\n      workshop_targets = adjacent_empty_cells(workshop_idx)\n      if workshop_targets:\n          path = bfs_path(state.pos, workshop_targets)\n          if path:\n              for a in path:\n                  _, state = state.step(a)\n                  actions.append(a)\n\n              # Craft at the workshop.\n              _, state = state.step(ACTION_USE)\n              actions.append(ACTION_USE)\n\n  # Return the complete list of actions.\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-10-21T17:36:04.028426", "function_name": "make_stick", "function_body": "  # Reset environment and get initial state\n  env.reset()\n  state = env._current_state  # type: CraftState\n\n  # ------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------\n  act_spec = env.action_specs()\n  ACTION_USE = act_spec[\"USE\"]\n  ACTIONS_MOVE = {\n      \"UP\": act_spec[\"UP\"],\n      \"DOWN\": act_spec[\"DOWN\"],\n      \"LEFT\": act_spec[\"LEFT\"],\n      \"RIGHT\": act_spec[\"RIGHT\"],\n  }\n  DIR_VECT = {\n      \"UP\": (-1, 0),\n      \"DOWN\": (1, 0),\n      \"LEFT\": (0, -1),\n      \"RIGHT\": (0, 1),\n  }\n\n  def bfs_path(start, targets):\n      \"\"\"Bread\u2011first search from start to the nearest position in targets.\n      Only moves through completely empty cells (no kind channels set).\"\"\"\n      from collections import deque\n\n      h, w = state.grid.shape[:2]\n      visited = set()\n      q = deque([(start, [])])\n\n      while q:\n          pos, path = q.popleft()\n          if pos in visited:\n              continue\n          visited.add(pos)\n\n          if pos in targets:\n              return path\n\n          x, y = pos\n          for name, (dx, dy) in DIR_VECT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < h and 0 <= ny < w:\n                  # walkable iff the cell is completely empty\n                  if not state.grid[nx, ny].any():\n                      q.append(((nx, ny), path + [ACTIONS_MOVE[name]]))\n      return None\n\n  # ------------------------------------------------------------\n  # Identify the goal index for \u201cstick\u201d and its primitive requirements\n  # ------------------------------------------------------------\n  idx = state.world.cookbook.index\n  stick_idx = idx.index(\"stick\")\n  primitive_needs = state.world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n  actions = []\n\n  # ------------------------------------------------------------\n  # Collect each required primitive\n  # ------------------------------------------------------------\n  for prim_idx, need_cnt in primitive_needs.items():\n      while state.inventory[prim_idx] < need_cnt:\n          # Locate all primitive cells currently on the map\n          h, w = state.grid.shape[:2]\n          prim_cells = [\n              (i, j)\n              for i in range(h)\n              for j in range(w)\n              if state.grid[i, j, prim_idx] > 0\n          ]\n          if not prim_cells:\n              # No more instances left; break out of the loop\n              break\n\n          # Determine all empty cells that are orthogonally adjacent to any primitive cell\n          adj_empty = set()\n          for (px, py) in prim_cells:\n              for dx, dy in DIR_VECT.values():\n                  ax, ay = px + dx, py + dy\n                  if 0 <= ax < h and 0 <= ay < w and not state.grid[ax, ay].any():\n                      adj_empty.add((ax, ay))\n\n          # Find path to the nearest reachable adjacent empty cell\n          path = bfs_path(state.pos, adj_empty)\n          if path is None:\n              # Cannot reach any primitive; abort\n              break\n\n          # Execute movement actions\n          for a in path:\n              _, state = state.step(a)\n              actions.append(a)\n\n          # Perform USE to pick up the primitive (agent should now be adjacent)\n          _, state = state.step(ACTION_USE)\n          actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the stick\n  # ------------------------------------------------------------\n  recipe_dict = state.world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = None\n  if isinstance(recipe_dict, dict):\n      workshop_name = recipe_dict.get(\"_at\")\n\n  if workshop_name:\n      workshop_idx = idx.index(workshop_name)\n\n      # Find all workshop cells on the map\n      h, w = state.grid.shape[:2]\n      workshop_cells = [\n          (i, j)\n          for i in range(h)\n          for j in range(w)\n          if state.grid[i, j, workshop_idx] > 0\n      ]\n\n      if workshop_cells:\n          # Compute empty cells adjacent to any workshop cell\n          adj_empty = set()\n          for (wx, wy) in workshop_cells:\n              for dx, dy in DIR_VECT.values():\n                  ax, ay = wx + dx, wy + dy\n                  if 0 <= ax < h and 0 <= ay < w and not state.grid[ax, ay].any():\n                      adj_empty.add((ax, ay))\n\n          path = bfs_path(state.pos, adj_empty)\n          if path:\n              for a in path:\n                  _, state = state.step(a)\n                  actions.append(a)\n\n              # Use the workshop to craft the stick\n              _, state = state.step(ACTION_USE)\n              actions.append(ACTION_USE)\n\n  # Return the compiled action sequence\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-10-21T17:36:33.797372", "function_name": "make_stick", "function_body": "  actions = []\n  world = env.world\n  state = env._current_state\n\n  # Index of the goal item \"stick\"\n  stick_idx = world.cookbook.index[\"stick\"]\n  if state.inventory[stick_idx] > 0:\n      return actions\n\n  # ------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------\n  import numpy as np\n  import collections\n\n  def move_action(cur, nxt):\n      \"\"\"Return action index that moves from cur -> nxt.\"\"\"\n      dx = nxt[0] - cur[0]\n      dy = nxt[1] - cur[1]\n      if dx == 1:\n          return 3          # RIGHT\n      if dx == -1:\n          return 2          # LEFT\n      if dy == 1:\n          return 0          # DOWN\n      if dy == -1:\n          return 1          # UP\n      raise ValueError(\"Invalid move step\")\n\n  def bfs_adjacent(start, targets, grid):\n      \"\"\"\n      Find shortest path (as list of positions) from start to any empty cell\n      that is orthogonally adjacent to one of the target cells.\n      Returns the path including the start cell.\n      \"\"\"\n      W, H, _ = grid.shape\n      visited = np.full((W, H), False, dtype=bool)\n      q = collections.deque()\n      q.append((start, [start]))\n      visited[start] = True\n      target_set = {tuple(t) for t in targets}\n      while q:\n          (x, y), path = q.popleft()\n          # Check adjacency to any target\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n          # Explore four neighbours through empty cells only\n          for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if grid[nx, ny, :].sum() == 0:  # empty cell\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [(nx, ny)]))\n      raise RuntimeError(\"No reachable adjacent cell to target\")\n\n  # ------------------------------------------------------------\n  # 1) Collect required primitive resources for a stick\n  # ------------------------------------------------------------\n  primitive_requirements = world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n  cur_pos = tuple(state.pos)\n\n  for prim_idx, needed in primitive_requirements.items():\n      for _ in range(needed):\n          # If we already have this primitive in inventory, skip\n          if state.inventory[prim_idx] > 0:\n              continue\n          # Locate all cells containing the primitive\n          prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(\"Required primitive not present in the world\")\n          # Find path to an empty cell adjacent to the primitive\n          path = bfs_adjacent(cur_pos, prim_cells, state.grid)\n          # Translate path into movement actions\n          for step in path[1:]:\n              actions.append(move_action(cur_pos, step))\n              cur_pos = step\n          # Pick up the primitive\n          actions.append(4)   # USE\n          # Update simulated grid so we don't target the same cell again\n          target_cell = prim_cells[0]  # any of the candidates; we are adjacent to it\n          state.grid[target_cell[0], target_cell[1], prim_idx] = 0\n\n  # ------------------------------------------------------------\n  # 2) Move to the workshop and craft the stick\n  # ------------------------------------------------------------\n  recipe_dict = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe_dict.get(\"_at\")\n  if workshop_name is None:\n      raise RuntimeError(\"No workshop specified for stick\")\n  workshop_idx = world.cookbook.index[workshop_name]\n\n  workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      raise RuntimeError(\"Workshop for stick not found in the world\")\n  path = bfs_adjacent(cur_pos, workshop_cells, state.grid)\n  for step in path[1:]:\n      actions.append(move_action(cur_pos, step))\n      cur_pos = step\n  actions.append(4)   # USE to craft the stick\n\n  return actions", "env_interactions": 3, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T17:36:34.914334", "function_name": "make_stick", "function_body": "  actions = []\n  state = env._current_state\n  world = env.world\n\n  # index of the goal item\n  stick_idx = world.cookbook.index[\"stick\"]\n  if state.inventory[stick_idx] > 0:\n      return actions\n\n  # mutable copy of the grid for planning\n  grid = state.grid.copy()\n  cur = tuple(state.pos)\n\n  # ------------------------------------------------------------\n  # helper utilities\n  # ------------------------------------------------------------\n  def move_action(a, b):\n      \"\"\"Return action index that moves from a -> b (Manhattan step).\"\"\"\n      dx = b[0] - a[0]\n      dy = b[1] - a[1]\n      if dx == 1:\n          return 3                      # RIGHT\n      if dx == -1:\n          return 2                      # LEFT\n      if dy == 1:\n          return 0                      # DOWN\n      if dy == -1:\n          return 1                      # UP\n      raise ValueError(\"non\u2011adjacent step\")\n\n  from collections import deque\n\n  W, H, _ = grid.shape\n\n  def bfs_to_adjacent(start, targets):\n      \"\"\"\n      Shortest path (as a list of positions, including start) from start\n      to any empty cell that is Manhattan\u2011adjacent to one of the target cells.\n      \"\"\"\n      target_set = {tuple(t) for t in targets}\n      visited = np.full((W, H), False, dtype=bool)\n      q = deque()\n      q.append((start, [start]))\n      visited[start] = True\n\n      while q:\n          pos, path = q.popleft()\n          # adjacent to a target?\n          for tx, ty in target_set:\n              if abs(pos[0] - tx) + abs(pos[1] - ty) == 1:\n                  return path\n          # explore neighbours (only through empty cells)\n          for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if grid[nx, ny].sum() == 0:          # empty\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [(nx, ny)]))\n      raise RuntimeError(\"No reachable target\")\n\n  # ------------------------------------------------------------\n  # 1) Gather required primitives\n  # ------------------------------------------------------------\n  primitive_requirements = world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n  for prim_idx, needed in primitive_requirements.items():\n      for _ in range(needed):\n          # locate remaining instances of this primitive\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(\"Required primitive not present in the world\")\n          # pick the nearest one (Manhattan distance)\n          target = min(prim_cells,\n                       key=lambda p: abs(p[0] - cur[0]) + abs(p[1] - cur[1]))\n          # path to a cell adjacent to the primitive\n          path = bfs_to_adjacent(cur, [tuple(target)])\n          for step in path[1:]:\n              actions.append(move_action(cur, step))\n              cur = step\n          # pick it up\n          actions.append(4)          # USE\n          # update planning grid\n          grid[target[0], target[1], prim_idx] = 0\n\n  # ------------------------------------------------------------\n  # 2) Go to the workshop and craft the stick\n  # ------------------------------------------------------------\n  recipe_dict = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe_dict.get(\"_at\")\n  if workshop_name is None:\n      raise RuntimeError(\"No workshop specified for stick\")\n  workshop_idx = world.cookbook.index[workshop_name]\n\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      raise RuntimeError(\"Workshop for stick not found in the world\")\n  # choose nearest workshop cell\n  workshop_target = min(workshop_cells,\n                        key=lambda p: abs(p[0] - cur[0]) + abs(p[1] - cur[1]))\n  path = bfs_to_adjacent(cur, [tuple(workshop_target)])\n  for step in path[1:]:\n      actions.append(move_action(cur, step))\n      cur = step\n  actions.append(4)   # USE to craft the stick\n\n  return actions", "env_interactions": 3, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T17:36:52.595764", "function_name": "make_stick", "function_body": "  import numpy as np\n\n  # Action mapping from the environment\n  ACTION = env.action_specs()\n\n  # Current state and world objects\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def find_nearest(pos, kind):\n      \"\"\"Return coordinates (x, y) of the nearest cell that contains `kind`.\"\"\"\n      layer = state.grid[:, :, kind]\n      ys, xs = np.where(layer > 0)\n      if len(xs) == 0:\n          return None\n      dists = np.abs(xs - pos[0]) + np.abs(ys - pos[1])\n      i = int(np.argmin(dists))\n      return (int(xs[i]), int(ys[i]))\n\n  def moves_to(cur, target):\n      \"\"\"Return a list of movement actions to go from cur \u2192 target (Manhattan).\"\"\"\n      seq = []\n      x, y = cur\n      tx, ty = target\n      while x != tx:\n          if tx > x:\n              seq.append(ACTION[\"RIGHT\"])\n              x += 1\n          else:\n              seq.append(ACTION[\"LEFT\"])\n              x -= 1\n      while y != ty:\n          if ty > y:\n              seq.append(ACTION[\"DOWN\"])\n              y += 1\n          else:\n              seq.append(ACTION[\"UP\"])\n              y -= 1\n      return seq\n\n  # ------------------------------------------------------------------\n  # Determine primitives needed for a stick\n  # ------------------------------------------------------------------\n  stick_idx = idx[\"stick\"]\n  needed = world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n  plan = []\n  cur_pos = state.pos\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          target = find_nearest(cur_pos, prim_idx)\n          if target is None:\n              continue  # Should not happen in a valid scenario\n          plan.extend(moves_to(cur_pos, target))\n          plan.append(ACTION[\"USE\"])          # pick up the primitive\n          cur_pos = target\n\n  # ------------------------------------------------------------------\n  # Move to the appropriate workshop (if any) and craft the stick\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\", None)\n  if workshop_name is not None:\n      wk_idx = idx[workshop_name] if isinstance(workshop_name, str) else workshop_name\n      wk_pos = find_nearest(cur_pos, wk_idx)\n      if wk_pos is not None:\n          plan.extend(moves_to(cur_pos, wk_pos))\n          cur_pos = wk_pos\n\n  # Final USE to perform the crafting action\n  plan.append(ACTION[\"USE\"])\n\n  return plan", "env_interactions": 4, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T17:36:53.704772", "function_name": "make_stick", "function_body": "  import numpy as np\n\n  # Action mapping, current state and world objects\n  ACTION = env.action_specs()\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def find_nearest(start_pos, kind):\n      \"\"\"Return coordinates (x, y) of the closest cell containing `kind`.\"\"\"\n      layer = state.grid[:, :, kind]\n      ys, xs = np.where(layer > 0)\n      if len(xs) == 0:\n          return None\n      dists = np.abs(xs - start_pos[0]) + np.abs(ys - start_pos[1])\n      i = int(np.argmin(dists))\n      return (int(xs[i]), int(ys[i]))\n\n  def moves_to(cur, target):\n      \"\"\"Generate a list of movement actions (Manhattan) from cur \u2192 target.\"\"\"\n      seq = []\n      x, y = cur\n      tx, ty = target\n      while x != tx:\n          if tx > x:\n              seq.append(ACTION[\"RIGHT\"])\n              x += 1\n          else:\n              seq.append(ACTION[\"LEFT\"])\n              x -= 1\n      while y != ty:\n          if ty > y:\n              seq.append(ACTION[\"DOWN\"])\n              y += 1\n          else:\n              seq.append(ACTION[\"UP\"])\n              y -= 1\n      return seq\n\n  # ------------------------------------------------------------------\n  # Determine primitives required for a stick\n  # ------------------------------------------------------------------\n  stick_idx = idx[\"stick\"]\n  needed = world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n  plan = []\n  cur_pos = state.pos\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = find_nearest(cur_pos, prim_idx)\n          if target is None:\n              # No reachable primitive \u2013 skip (should not happen in valid scenarios)\n              continue\n          plan.extend(moves_to(cur_pos, target))\n          plan.append(ACTION[\"USE\"])          # pick up the primitive\n          cur_pos = target\n\n  # ------------------------------------------------------------------\n  # Move to the appropriate workshop (if any) and craft the stick\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      wk_idx = idx[workshop_name] if isinstance(workshop_name, str) else workshop_name\n      wk_pos = find_nearest(cur_pos, wk_idx)\n      if wk_pos is not None:\n          plan.extend(moves_to(cur_pos, wk_pos))\n          cur_pos = wk_pos\n\n  # Final USE to perform the crafting action\n  plan.append(ACTION[\"USE\"])\n\n  return plan", "env_interactions": 4, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T17:37:14.863145", "function_name": "make_stick", "function_body": "  env.reset()\n  state = env._current_state\n  act_spec = env.action_specs()\n  ACTION_USE = act_spec[\"USE\"]\n  ACTIONS_MOVE = {k: act_spec[k] for k in (\"UP\", \"DOWN\", \"LEFT\", \"RIGHT\")}\n  DIR_VECT = {\"UP\": (-1, 0), \"DOWN\": (1, 0), \"LEFT\": (0, -1), \"RIGHT\": (0, 1)}\n  from collections import deque\n\n  def bfs_path(start, targets):\n      h, w = state.grid.shape[:2]\n      visited = set()\n      q = deque([(start, [])])\n      while q:\n          pos, path = q.popleft()\n          if pos in visited:\n              continue\n          visited.add(pos)\n          if pos in targets:\n              return path\n          x, y = pos\n          for name, (dx, dy) in DIR_VECT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < h and 0 <= ny < w:\n                  if not state.grid[nx, ny].any():\n                      q.append(((nx, ny), path + [ACTIONS_MOVE[name]]))\n      return None\n\n  idx = state.world.cookbook.index\n  stick_idx = idx.index(\"stick\")\n  primitive_needs = state.world.cookbook.primitives_for(stick_idx)\n  actions = []\n\n  for prim_idx, needed_cnt in primitive_needs.items():\n      while state.inventory[prim_idx] < needed_cnt:\n          h, w = state.grid.shape[:2]\n          prim_locs = [(i, j) for i in range(h) for j in range(w) if state.grid[i, j, prim_idx] > 0]\n          if not prim_locs:\n              break\n          path = bfs_path(state.pos, set(prim_locs))\n          if path is None:\n              break\n          for a in path:\n              _, state = state.step(a)\n              actions.append(a)\n          _, state = state.step(ACTION_USE)\n          actions.append(ACTION_USE)\n\n  recipe = state.world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\") if isinstance(recipe, dict) else None\n  if workshop_name:\n      workshop_idx = idx.index(workshop_name)\n      h, w = state.grid.shape[:2]\n      workshop_cells = [(i, j) for i in range(h) for j in range(w) if state.grid[i, j, workshop_idx] > 0]\n      if workshop_cells:\n          path = bfs_path(state.pos, set(workshop_cells))\n          if path:\n              for a in path:\n                  _, state = state.step(a)\n                  actions.append(a)\n              _, state = state.step(ACTION_USE)\n              actions.append(ACTION_USE)\n\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T17:42:14.984690", "function_name": "make_stick", "function_body": "  # reset environment and get initial state\n  env.reset()\n  state = env._current_state  # type: CraftState\n\n  # ------------------------------------------------------------------\n  # Helpers\n  # ------------------------------------------------------------------\n  act_spec = env.action_specs()\n  ACTION_USE = act_spec[\"USE\"]\n  MOVE_ACTIONS = {\n      \"UP\": act_spec[\"UP\"],\n      \"DOWN\": act_spec[\"DOWN\"],\n      \"LEFT\": act_spec[\"LEFT\"],\n      \"RIGHT\": act_spec[\"RIGHT\"],\n  }\n  DIR_VECT = {\n      \"UP\": (-1, 0),\n      \"DOWN\": (1, 0),\n      \"LEFT\": (0, -1),\n      \"RIGHT\": (0, 1),\n  }\n\n  def bfs_to_adjacent(start, targets):\n      \"\"\"Return a list of move actions that brings the agent to a cell\n      adjacent (Manhattan distance 1) to any position in ``targets``.\n      Cells are traversable only if they are completely empty.\"\"\"\n      from collections import deque\n\n      h, w = state.grid.shape[:2]\n      visited = set()\n      q = deque([(start, [])])\n\n      while q:\n          pos, path = q.popleft()\n          if pos in visited:\n              continue\n          visited.add(pos)\n\n          # check adjacency\n          for tx, ty in targets:\n              if abs(pos[0] - tx) + abs(pos[1] - ty) == 1:\n                  return path\n\n          x, y = pos\n          for name, (dx, dy) in DIR_VECT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < h and 0 <= ny < w:\n                  # walkable iff the cell is empty (no kind channel set)\n                  if not state.grid[nx, ny].any() and (nx, ny) not in visited:\n                      q.append(((nx, ny), path + [MOVE_ACTIONS[name]]))\n      return None\n\n  # ------------------------------------------------------------------\n  # Identify stick index and its primitive requirements\n  # ------------------------------------------------------------------\n  idx = state.world.cookbook.index\n  stick_idx = idx.index(\"stick\")\n  primitive_needs = state.world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Collect required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitive_needs.items():\n      while state.inventory[prim_idx] < needed:\n          # locate all current instances of this primitive on the map\n          h, w = state.grid.shape[:2]\n          prim_locs = [\n              (i, j)\n              for i in range(h)\n              for j in range(w)\n              if state.grid[i, j, prim_idx] > 0\n          ]\n          if not prim_locs:\n              # nothing left to collect \u2013 break to avoid infinite loop\n              break\n\n          path = bfs_to_adjacent(state.pos, set(prim_locs))\n          if path is None:\n              # unreachable \u2013 break\n              break\n\n          # execute movement actions\n          for a in path:\n              _, state = state.step(a)\n              actions.append(a)\n\n          # use (collect) the primitive\n          _, state = state.step(ACTION_USE)\n          actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if required) and craft the stick\n  # ------------------------------------------------------------------\n  recipe = state.world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\") if isinstance(recipe, dict) else None\n\n  if workshop_name:\n      workshop_idx = idx.index(workshop_name)\n      h, w = state.grid.shape[:2]\n      workshop_cells = [\n          (i, j)\n          for i in range(h)\n          for j in range(w)\n          if state.grid[i, j, workshop_idx] > 0\n      ]\n      if workshop_cells:\n          path = bfs_to_adjacent(state.pos, set(workshop_cells))\n          if path:\n              for a in path:\n                  _, state = state.step(a)\n                  actions.append(a)\n              # craft at the workshop\n              _, state = state.step(ACTION_USE)\n              actions.append(ACTION_USE)\n\n  # return the compiled action sequence\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-10-21T17:42:40.692414", "function_name": "make_stick", "function_body": "  # Helper to convert a Manhattan move into action indices.\n  def _move_actions(cur_pos, target_pos):\n      actions = []\n      dx = target_pos[0] - cur_pos[0]   # row difference\n      dy = target_pos[1] - cur_pos[1]   # column difference\n      # DOWN (0) increases row index, UP (1) decreases it.\n      while dx > 0:\n          actions.append(0)   # DOWN\n          dx -= 1\n      while dx < 0:\n          actions.append(1)   # UP\n          dx += 1\n      # RIGHT (3) increases column index, LEFT (2) decreases it.\n      while dy > 0:\n          actions.append(3)   # RIGHT\n          dy -= 1\n      while dy < 0:\n          actions.append(2)   # LEFT\n          dy += 1\n      return actions\n\n  # Reset environment to obtain a fresh state.\n  _ = env.reset()\n  state = env._current_state\n  world = env.world\n  goal_idx = env.task.goal\n\n  # Determine which primitive resources are required for the goal.\n  required = world.cookbook.primitives_for(goal_idx)  # {primitive_idx: count}\n  actions = []\n  cur_pos = tuple(state.pos)\n  grid = state.grid\n\n  # Helper to find an empty neighbor (or the cell itself if no empty neighbor).\n  def _adjacent_empty(cell):\n      x, y = cell\n      for dx, dy in [(0, 1), (0, -1), (1, 0), (-1, 0)]:\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n              if grid[nx, ny, :].sum() == 0:\n                  return (nx, ny)\n      return cell  # fallback (should rarely happen)\n\n  # Collect each required primitive.\n  for prim_idx, needed in required.items():\n      # Locate all cells that currently contain this primitive.\n      locations = np.argwhere(grid[:, :, prim_idx] > 0)\n      while needed > 0 and len(locations) > 0:\n          # Choose the nearest location.\n          dists = np.sum(np.abs(locations - np.array(cur_pos)), axis=1)\n          nearest = int(np.argmin(dists))\n          prim_cell = tuple(locations[nearest])\n\n          # Move to an adjacent empty cell next to the primitive.\n          target_adj = _adjacent_empty(prim_cell)\n          actions.extend(_move_actions(cur_pos, target_adj))\n          cur_pos = target_adj\n\n          # Use the primitive (pick it up).\n          actions.append(4)   # USE\n          needed -= 1\n\n          # Update our local view of the grid: remove the taken primitive.\n          grid[prim_cell[0], prim_cell[1], prim_idx] = 0\n          locations = np.delete(locations, nearest, axis=0)\n\n  # If the recipe requires a specific workshop, go there and craft.\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if len(workshop_cells) > 0:\n          ws_cell = tuple(workshop_cells[0])\n          ws_adj = _adjacent_empty(ws_cell)\n          actions.extend(_move_actions(cur_pos, ws_adj))\n          cur_pos = ws_adj\n          actions.append(4)   # USE to craft at the workshop\n\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": 0.0}}
