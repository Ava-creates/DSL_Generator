{"timestamp": "2025-10-21T17:43:38.313168", "function_name": "make_stick", "function_body": "  env.reset()\n  state = env._current_state\n\n  goal_idx = env.task.goal\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)\n\n  actions = []\n\n  width, height, _ = state.grid.shape\n  DIR2ACT = {(1, 0): 0, (-1, 0): 1, (0, -1): 2, (0, 1): 3}\n  from collections import deque\n\n  def bfs(start, target_idx):\n      \"\"\"Return a list of positions from start to the first cell that\n      contains `target_idx`.  Returns None if unreachable.\"\"\"\n      visited = np.zeros((width, height), dtype=bool)\n      prev = np.empty((width, height, 2), dtype=int)\n\n      q = deque([start])\n      visited[start] = True\n\n      while q:\n          r, c = q.popleft()\n          if state.grid[r, c, target_idx] > 0:\n              # reconstruct path\n              path = [(r, c)]\n              while (r, c) != start:\n                  r, c = tuple(prev[r, c])\n                  path.append((r, c))\n              path.reverse()\n              return path\n\n          for dr, dc in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              nr, nc = r + dr, c + dc\n              if 0 <= nr < width and 0 <= nc < height and not visited[nr, nc]:\n                  cell = state.grid[nr, nc, :]\n                  # can walk through empty cells or the target cell itself\n                  if cell.sum() == 0 or cell[target_idx] > 0:\n                      visited[nr, nc] = True\n                      prev[nr, nc] = (r, c)\n                      q.append((nr, nc))\n      return None\n\n  def follow_path(path):\n      \"\"\"Execute the moves along `path`, updating `state` and `actions`.\"\"\"\n      nonlocal state\n      for (r0, c0), (r1, c1) in zip(path, path[1:]):\n          dr, dc = r1 - r0, c1 - c0\n          act = DIR2ACT[(dr, dc)]\n          actions.append(act)\n          _, new_state = env.step(act)\n          state = new_state\n\n  # ------------------------------------------------------------------\n  # Collect all required primitive resources\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      for _ in range(needed_cnt):\n          path = bfs(state.pos, prim_idx)\n          if path is None:\n              # primitive unreachable \u2013 abort early\n              return actions\n          follow_path(path)\n\n          # pick up the primitive\n          actions.append(4)          # USE\n          _, new_state = env.step(4)\n          state = new_state\n\n  # ------------------------------------------------------------------\n  # Craft the goal item at its workshop (if any)\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = recipe.get('_at')\n  if workshop_idx is not None:\n      path = bfs(state.pos, workshop_idx)\n      if path is not None:\n          follow_path(path)\n          actions.append(4)          # USE to craft\n          _, new_state = env.step(4)\n          state = new_state\n\n  return actions", "env_interactions": 0, "island_id": 9, "scores": {"3": 0.0}}
