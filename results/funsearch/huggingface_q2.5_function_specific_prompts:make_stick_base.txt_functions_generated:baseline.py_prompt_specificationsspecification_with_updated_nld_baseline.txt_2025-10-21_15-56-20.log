{"timestamp": "2025-10-21T20:55:40.538887", "function_name": "make_stick", "function_body": "  import collections\n  import numpy as np\n\n  # Action indices (as defined in the environment)\n  # 0: DOWN, 1: UP, 2: LEFT, 3: RIGHT, 4: USE\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]  # (dx, dy) matching the action order\n\n  # Ensure the environment is in a fresh state\n  _ = env.reset()\n  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  # ------------------------------------------------------------------\n  # Helper functions\n  # ------------------------------------------------------------------\n  grid = state.grid.copy()                     # (WIDTH, HEIGHT, n_kinds)\n  width, height = grid.shape[0], grid.shape[1]\n\n  def in_bounds(x, y):\n      return 0 <= x < width and 0 <= y < height\n\n  # Boolean occupancy map: True if any entity occupies the cell\n  occ = np.any(grid, axis=2)\n\n  def bfs_to_adjacent(start, target):\n      \"\"\"\n      Return a list of direction indices (0\u20114 as above) that moves the agent\n      from `start` (x, y) to a free cell adjacent to `target` (x, y).\n      If no path exists, return None.\n      \"\"\"\n      tx, ty = target\n      # All free neighbours of the target cell\n      free_neighbours = [\n          (tx + dx, ty + dy)\n          for dx, dy in DIRS\n          if in_bounds(tx + dx, ty + dy) and not occ[tx + dx, ty + dy]\n      ]\n      if not free_neighbours:\n          return None\n\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {(start[0], start[1])}\n\n      while q:\n          x, y, path = q.popleft()\n          if (x, y) in free_neighbours:\n              return path\n          for d, (dx, dy) in enumerate(DIRS):\n              nx, ny = x + dx, y + dy\n              if in_bounds(nx, ny) and not occ[nx, ny] and (nx, ny) not in visited:\n                  visited.add((nx, ny))\n                  q.append((nx, ny, path + [d]))\n      return None\n\n  # ------------------------------------------------------------------\n  # Determine the recipe for a stick\n  # ------------------------------------------------------------------\n  stick_idx = cookbook.index[\"stick\"]\n  stick_recipe = cookbook.recipes.get(stick_idx, {})\n  workshop_name = stick_recipe.get(\"_at\")\n  workshop_idx = cookbook.index[workshop_name] if workshop_name is not None else None\n  primitive_requirements = cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n\n  actions = []\n  cur_pos = (state.pos[0], state.pos[1])   # (x, y)\n\n  # ------------------------------------------------------------------\n  # Collect required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitive_requirements.items():\n      # Locate all cells that currently contain this primitive\n      prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)   # list of (x, y)\n      for _ in range(needed):\n          # Find the reachable primitive with the shortest path\n          best_path = None\n          best_cell = None\n          for cell in prim_cells:\n              px, py = int(cell[0]), int(cell[1])\n              path = bfs_to_adjacent(cur_pos, (px, py))\n              if path is not None and (best_path is None or len(path) < len(best_path)):\n                  best_path = path\n                  best_cell = (px, py)\n          if best_path is None:   # no reachable primitive left\n              break\n\n          # Move to the adjacent cell\n          actions.extend(best_path)\n          for d in best_path:\n              dx, dy = DIRS[d]\n              cur_pos = (cur_pos[0] + dx, cur_pos[1] + dy)\n\n          # Pick up the primitive\n          actions.append(4)   # USE\n          # Update internal map to reflect that the primitive is gone\n          grid[best_cell[0], best_cell[1], prim_idx] = 0\n          occ[best_cell[0], best_cell[1]] = False\n\n          # Remove this cell from future consideration\n          prim_cells = np.delete(\n              prim_cells,\n              np.where((prim_cells[:, 0] == best_cell[0]) & (prim_cells[:, 1] == best_cell[1])),\n              axis=0,\n          )\n\n  # ------------------------------------------------------------------\n  # Move to the workshop and craft the stick\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          # Choose the closest workshop cell\n          best_path = None\n          best_ws = None\n          for cell in workshop_cells:\n              wx, wy = int(cell[0]), int(cell[1])\n              path = bfs_to_adjacent(cur_pos, (wx, wy))\n              if path is not None and (best_path is None or len(path) < len(best_path)):\n                  best_path = path\n                  best_ws = (wx, wy)\n          if best_path is not None:\n              actions.extend(best_path)\n              cur_pos = cur_pos  # position will be updated by the loop if needed\n              # Finally, use the workshop to craft the stick\n              actions.append(4)   # USE\n\n  return actions", "env_interactions": 3, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T20:55:41.661706", "function_name": "make_stick", "function_body": "  import numpy as np\n  import collections\n\n  # Action constants (match CraftLab mapping)\n  # 0: DOWN, 1: UP, 2: LEFT, 3: RIGHT, 4: USE\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n\n  # ------------------------------------------------------------------\n  # Helper functions\n  # ------------------------------------------------------------------\n  def in_bounds(x, y, w, h):\n      return 0 <= x < w and 0 <= y < h\n\n  def bfs_to_adjacent(start, target, occupied, w, h):\n      \"\"\"\n      Return a list of action indices that moves from `start` to any\n      free cell adjacent to `target`. If already adjacent, returns [].\n      If unreachable, returns None.\n      \"\"\"\n      tx, ty = target\n      # All free neighbours of the target\n      neighbours = [\n          (tx + dx, ty + dy)\n          for dx, dy in DIRS\n          if in_bounds(tx + dx, ty + dy, w, h) and not occupied[ty + dy, tx + dx]\n      ]\n      if not neighbours:\n          return None\n      # BFS over free cells\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      while q:\n          x, y, path = q.popleft()\n          if (x, y) in neighbours:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = x + dx, y + dy\n              if (\n                  in_bounds(nx, ny, w, h)\n                  and not occupied[ny, nx]\n                  and (nx, ny) not in visited\n              ):\n                  visited.add((nx, ny))\n                  q.append((nx, ny, path + [a]))\n      return None\n\n  # ------------------------------------------------------------------\n  # Extract world information\n  # ------------------------------------------------------------------\n  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  # Goal is the primitive \"stick\"\n  stick_idx = cookbook.index[\"stick\"]\n  recipe = cookbook.recipes[stick_idx]\n  workshop_name = recipe[\"_at\"]\n  workshop_idx = cookbook.index[workshop_name]\n\n  # Primitive requirements for a stick\n  prim_reqs = cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n\n  # Current grid and position\n  grid = state.grid.copy()\n  cur_pos = tuple(state.pos)  # (x, y)\n\n  # Occupancy map (True = blocked)\n  occupied = np.any(grid, axis=2)\n\n  height, width = occupied.shape\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Collect required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, needed in prim_reqs.items():\n      for _ in range(needed):\n          # Locate all cells containing this primitive\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # nothing left \u2013 abort early\n              return actions\n\n          best_path = None\n          best_cell = None\n\n          for cell in prim_cells:\n              py, px = cell  # row, col\n              path = bfs_to_adjacent(cur_pos, (px, py), occupied, width, height)\n              if path is not None and (best_path is None or len(path) < len(best_path)):\n                  best_path = path\n                  best_cell = (px, py)\n\n          if best_path is None:\n              # unreachable primitive\n              return actions\n\n          # Move to the neighbour cell\n          actions.extend(best_path)\n          for a in best_path:\n              dx, dy = DIRS[a]\n              cur_pos = (cur_pos[0] + dx, cur_pos[1] + dy)\n\n          # Pick up the primitive\n          actions.append(4)  # USE\n          # Update grid / occupancy\n          grid[best_cell[1], best_cell[0], prim_idx] = 0\n          occupied[best_cell[1], best_cell[0]] = False\n\n  # ------------------------------------------------------------------\n  # Go to a workshop and craft the stick\n  # ------------------------------------------------------------------\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      return actions  # no workshop found\n\n  wy, wx = workshop_cells[0]  # take first workshop\n  path_to_ws = bfs_to_adjacent(cur_pos, (wx, wy), occupied, width, height)\n  if path_to_ws is not None:\n      actions.extend(path_to_ws)\n      for a in path_to_ws:\n          dx, dy = DIRS[a]\n          cur_pos = (cur_pos[0] + dx, cur_pos[1] + dy)\n\n  # Use the workshop to craft the stick\n  actions.append(4)  # USE\n\n  return actions", "env_interactions": 3, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T20:55:54.974641", "function_name": "make_stick", "function_body": "  # ----- Resolve action indices -----\n  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      # Fallback order: DOWN, UP, LEFT, RIGHT, USE (common ordering)\n      action_ids = [0, 1, 2, 3, 4]\n\n  # ----- Resolve index of the target item \"stick\" -----\n  try:\n      target_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      target_idx = env.world.cookbook.index.get(\"stick\")\n  if target_idx is None:\n      # No recipe for stick \u2013 cannot plan\n      return []\n\n  # ----- Ensure we have a current state -----\n  if not hasattr(env, \"_current_state\") or env._current_state is None:\n      env.reset()\n  start_state = env._current_state\n\n  # ----- Quick check: already have a stick -----\n  if start_state.inventory[target_idx] > 0:\n      return []\n\n  # ----- Bread\u2011first search for a sequence of actions -----\n  from collections import deque\n\n  frontier = deque()\n  frontier.append((start_state, []))\n\n  # Include position, direction, inventory and grid layout in the key.\n  def state_key(st):\n      # Use bytes representation for fast hashing/comparison.\n      return (st.pos, st.dir, st.inventory.tobytes(), st.grid.tobytes())\n\n  visited = {state_key(start_state)}\n  max_plan_len = 400  # safety limit to keep search tractable\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      # Goal test: stick present in inventory\n      if cur_state.inventory[target_idx] > 0:\n          return cur_plan\n\n      if len(cur_plan) >= max_plan_len:\n          continue\n\n      # Expand all possible actions\n      for a in action_ids:\n          _, nxt_state = cur_state.step(a)\n          key = state_key(nxt_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((nxt_state, cur_plan + [a]))\n\n  # If we exit the loop, no plan was found within the limits.\n  return []", "env_interactions": 4, "island_id": 7, "scores": {"3": 1.5}}
