{"timestamp": "2025-10-21T20:49:58.315018", "function_name": "make_stick", "function_body": "  from collections import deque\n\n  # ----- helper utilities -----\n  def _action_ids():\n      \"\"\"Return list of action IDs supported by the env.\"\"\"\n      try:\n          return list(env.action_specs().values())\n      except Exception:\n          # fallback to typical ordering: DOWN, UP, LEFT, RIGHT, USE\n          return [0, 1, 2, 3, 4]\n\n  def _goal_index():\n      \"\"\"Integer index of the 'stick' item in the world cookbook.\"\"\"\n      try:\n          return env.world.cookbook.index[\"stick\"]\n      except Exception:\n          # safe fallback if key missing\n          return env.world.cookbook.index.get(\"stick\", None)\n\n  def _is_goal(state, goal_idx):\n      \"\"\"True if the state's inventory already contains the goal.\"\"\"\n      return goal_idx is not None and state.satisfies(\"\", goal_idx)\n\n  def _state_key(state):\n      \"\"\"Compact hashable representation of a state for visited tracking.\"\"\"\n      # includes position, direction and raw inventory bytes\n      return (state.pos, state.dir, state.inventory.tobytes())\n\n  # ----- initialise search -----\n  actions = _action_ids()\n  goal_idx = _goal_index()\n\n  # obtain the current state; if not exposed, initialise a fresh one\n  start_state = getattr(env, \"_current_state\", None)\n  if start_state is None:\n      start_state = env.scenario.init()\n\n  frontier = deque()\n  frontier.append((start_state, []))\n  visited = {_state_key(start_state)}\n  MAX_DEPTH = 300  # safety bound to keep search tractable\n\n  # ----- breadth\u2011first search for a plan -----\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      if _is_goal(cur_state, goal_idx):\n          return cur_plan\n\n      if len(cur_plan) >= MAX_DEPTH:\n          continue\n\n      for a in actions:\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((next_state, cur_plan + [a]))\n\n  # If no plan found within limits, return an empty action list.\n  return []", "env_interactions": 4, "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T20:49:59.576426", "function_name": "make_stick", "function_body": "  from collections import deque\n\n  # ----- helper utilities -----\n  def _action_ids():\n      \"\"\"Return list of action indices supported by the environment.\"\"\"\n      try:\n          return list(env.action_specs().values())\n      except Exception:\n          # default ordering: DOWN, UP, LEFT, RIGHT, USE\n          return [0, 1, 2, 3, 4]\n\n  def _goal_index():\n      \"\"\"Return the integer index of the primitive/item \\\"stick\\\".\"\"\"\n      try:\n          return env.world.cookbook.index[\"stick\"]\n      except Exception:\n          # fallback for missing key\n          return env.world.cookbook.index.get(\"stick\")\n\n  def _is_goal(state, idx):\n      \"\"\"Check whether the current state already satisfies the goal.\"\"\"\n      return idx is not None and state.satisfies(\"\", idx)\n\n  def _state_key(state):\n      \"\"\"Compact hashable representation of a state for visited tracking.\"\"\"\n      # position (x, y), direction, and raw inventory bytes\n      return (state.pos, state.dir, state.inventory.tobytes())\n\n  # ----- initialise search -----\n  actions = _action_ids()\n  goal_idx = _goal_index()\n\n  # obtain the current state; if the lab does not expose it, initialise a fresh one\n  start_state = getattr(env, \"_current_state\", None)\n  if start_state is None:\n      start_state = env.scenario.init()\n\n  # breadth\u2011first search over (state, action_sequence) pairs\n  frontier = deque()\n  frontier.append((start_state, []))\n  visited = {_state_key(start_state)}\n  MAX_PLAN_LENGTH = 300  # safety bound to avoid infinite loops\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      if _is_goal(cur_state, goal_idx):\n          return cur_plan\n\n      if len(cur_plan) >= MAX_PLAN_LENGTH:\n          continue\n\n      for a in actions:\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((next_state, cur_plan + [a]))\n\n  # No feasible plan found within the limits.\n  return []", "env_interactions": 4, "island_id": 2, "scores": {"3": 1.5}}
