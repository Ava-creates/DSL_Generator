{"timestamp": "2025-10-21T21:57:18.483867", "function_name": "make_stick", "function_body": "  env.reset()\n  world = env.world\n  scenario = env.scenario\n  grid = scenario.init_grid.copy()\n  pos = list(scenario.init_pos)          # [x, y]\n  action_map = env.action_specs()\n  actions = []\n\n  def _move_to(target):\n      \"\"\"Append actions that move the agent from current pos to target cell.\"\"\"\n      nonlocal pos, actions\n      # horizontal movement (x axis)\n      while pos[0] < target[0]:\n          actions.append(action_map[\"RIGHT\"])\n          pos[0] += 1\n      while pos[0] > target[0]:\n          actions.append(action_map[\"LEFT\"])\n          pos[0] -= 1\n      # vertical movement (y axis)\n      while pos[1] < target[1]:\n          actions.append(action_map[\"DOWN\"])\n          pos[1] += 1\n      while pos[1] > target[1]:\n          actions.append(action_map[\"UP\"])\n          pos[1] -= 1\n\n  # ----------------------------------------------------------------------\n  # 1. Gather all primitive items required for the goal (stick)\n  # ----------------------------------------------------------------------\n  goal_idx = env.task.goal\n  primitive_needs = world.cookbook.primitives_for(goal_idx)\n\n  for kind_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          # locate all cells that currently contain this primitive\n          locations = np.argwhere(grid[:, :, kind_idx] > 0)\n          if locations.shape[0] == 0:\n              # no more of this primitive left on the map \u2013 abort early\n              break\n          # choose the nearest one (Manhattan distance)\n          dists = np.abs(locations - pos).sum(axis=1)\n          nearest = int(np.argmin(dists))\n          target = locations[nearest].tolist()\n          _move_to(target)\n          actions.append(action_map[\"USE\"])\n          # update simulated grid: the primitive is now removed\n          grid[target[0], target[1], kind_idx] = 0\n\n  # ----------------------------------------------------------------------\n  # 2. Go to the required workshop (if any) and craft the goal item\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      # find a workshop of the correct type\n      workshop_cells = np.argwhere(grid[:, :, workshop_kind] > 0)\n      if workshop_cells.shape[0] > 0:\n          dists = np.abs(workshop_cells - pos).sum(axis=1)\n          nearest_ws = int(np.argmin(dists))\n          ws_target = workshop_cells[nearest_ws].tolist()\n          _move_to(ws_target)\n          actions.append(action_map[\"USE\"])\n\n  return actions", "env_interactions": 0, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:57:19.572969", "function_name": "make_stick", "function_body": "  env.reset()\n  world = env.world\n  scenario = env.scenario\n  grid = scenario.init_grid.copy()\n  pos = list(scenario.init_pos)\n  action_map = env.action_specs()\n  actions = []\n\n  def _move_to(target):\n      nonlocal pos, actions\n      # Horizontal movement (x-axis)\n      while pos[0] < target[0]:\n          actions.append(action_map[\"RIGHT\"])\n          pos[0] += 1\n      while pos[0] > target[0]:\n          actions.append(action_map[\"LEFT\"])\n          pos[0] -= 1\n      # Vertical movement (y-axis)\n      while pos[1] < target[1]:\n          actions.append(action_map[\"DOWN\"])\n          pos[1] += 1\n      while pos[1] > target[1]:\n          actions.append(action_map[\"UP\"])\n          pos[1] -= 1\n\n  # ------------------------------------------------------------------\n  # 1. Gather all primitive resources required for the goal item.\n  # ------------------------------------------------------------------\n  goal_idx = env.task.goal\n  primitive_needs = world.cookbook.primitives_for(goal_idx)\n\n  for kind_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          # Find all cells containing the required primitive.\n          locations = np.argwhere(grid[:, :, kind_idx] > 0)\n          if locations.shape[0] == 0:\n              # No more instances of this primitive on the map.\n              break\n          # Choose the nearest instance (Manhattan distance).\n          dists = np.abs(locations - pos).sum(axis=1)\n          nearest = int(np.argmin(dists))\n          target_cell = locations[nearest].tolist()\n          _move_to(target_cell)\n          actions.append(action_map[\"USE\"])\n          # Simulate removal of the primitive from the grid.\n          grid[target_cell[0], target_cell[1], kind_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 2. Move to the appropriate workshop (if any) and craft the goal.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      workshop_cells = np.argwhere(grid[:, :, workshop_kind] > 0)\n      if workshop_cells.shape[0] > 0:\n          dists = np.abs(workshop_cells - pos).sum(axis=1)\n          nearest_ws = int(np.argmin(dists))\n          ws_target = workshop_cells[nearest_ws].tolist()\n          _move_to(ws_target)\n          actions.append(action_map[\"USE\"])\n\n  return actions", "env_interactions": 0, "island_id": 5, "scores": {"3": 0.0}}
