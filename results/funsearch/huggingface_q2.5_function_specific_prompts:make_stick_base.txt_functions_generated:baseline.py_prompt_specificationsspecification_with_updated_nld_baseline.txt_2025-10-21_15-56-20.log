{"timestamp": "2025-10-21T17:16:51.245930", "function_name": "make_stick", "function_body": "  # Reset environment to obtain the initial state\n  env.reset()\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  # Identify the index for the target item \"stick\"\n  stick_idx = idx.index('stick')\n\n  # Determine primitive ingredients required to craft a stick\n  needed = world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n\n  # Action mapping (name \u2192 int)\n  act_map = env.action_specs()\n  DOWN = act_map[\"DOWN\"]\n  UP = act_map[\"UP\"]\n  LEFT = act_map[\"LEFT\"]\n  RIGHT = act_map[\"RIGHT\"]\n  USE = act_map[\"USE\"]\n\n  actions = []\n  cur_pos = tuple(state.pos)  # current (x, y) position of the agent\n  grid = state.grid\n\n  # Helper to move from start to target using Manhattan moves\n  def move_to(start, target):\n      seq = []\n      x, y = start\n      tx, ty = target\n      while x < tx:\n          seq.append(RIGHT)\n          x += 1\n      while x > tx:\n          seq.append(LEFT)\n          x -= 1\n      while y < ty:\n          seq.append(DOWN)\n          y += 1\n      while y > ty:\n          seq.append(UP)\n          y -= 1\n      return seq\n\n  # Collect each required primitive\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          # Find any cell that contains the needed primitive\n          locations = np.argwhere(grid[:, :, prim_idx] > 0)\n          if locations.size == 0:\n              raise RuntimeError(f\"Primitive with index {prim_idx} not found on the grid.\")\n          tx, ty = locations[0]  # take the first occurrence\n\n          # Move to the primitive and pick it up\n          actions.extend(move_to(cur_pos, (tx, ty)))\n          actions.append(USE)          # collect the primitive\n          cur_pos = (tx, ty)\n\n  # Finally, craft the stick (triggered by a USE action when ingredients are in inventory)\n  actions.append(USE)\n\n  return actions", "env_interactions": 3, "island_id": 6, "scores": {"3": 0.0}}
