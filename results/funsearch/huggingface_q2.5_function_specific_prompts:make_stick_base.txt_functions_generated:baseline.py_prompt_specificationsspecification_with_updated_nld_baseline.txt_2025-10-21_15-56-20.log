{"timestamp": "2025-10-21T16:36:50.609842", "function_name": "make_stick", "function_body": "  # Reset the environment to obtain the initial state.\n  env.reset()\n  state = env._current_state  # type: CraftState\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  act_spec = env.action_specs()\n  ACTION_USE = act_spec[\"USE\"]\n  ACTIONS_MOVE = {\n      \"UP\": act_spec[\"UP\"],\n      \"DOWN\": act_spec[\"DOWN\"],\n      \"LEFT\": act_spec[\"LEFT\"],\n      \"RIGHT\": act_spec[\"RIGHT\"],\n  }\n  DIR_VECT = {\n      \"UP\": (-1, 0),\n      \"DOWN\": (1, 0),\n      \"LEFT\": (0, -1),\n      \"RIGHT\": (0, 1),\n  }\n\n  # BFS that returns a list of action IDs moving the agent from start\n  # to the closest cell in ``targets`` that is reachable through empty\n  # cells (i.e. cells where all kind channels are zero).\n  def bfs_path(start, targets):\n      from collections import deque\n\n      h, w = state.grid.shape[:2]\n      visited = set()\n      q = deque([(start, [])])\n\n      while q:\n          pos, path = q.popleft()\n          if pos in visited:\n              continue\n          visited.add(pos)\n\n          if pos in targets:\n              return path\n\n          x, y = pos\n          for name, (dx, dy) in DIR_VECT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < h and 0 <= ny < w:\n                  # walkable iff the cell is completely empty\n                  if not state.grid[nx, ny].any():\n                      q.append(((nx, ny), path + [ACTIONS_MOVE[name]]))\n      return None\n\n  # ------------------------------------------------------------------\n  # Identify the goal index for a \u201cstick\u201d and the primitive requirements.\n  # ------------------------------------------------------------------\n  idx = state.world.cookbook.index\n  stick_idx = idx.index(\"stick\")\n  primitive_needs = state.world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive.\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      while state.inventory[prim_idx] < needed_cnt:\n          # Locate all cells that currently contain the primitive.\n          h, w = state.grid.shape[:2]\n          prim_locs = [\n              (i, j)\n              for i in range(h)\n              for j in range(w)\n              if state.grid[i, j, prim_idx] > 0\n          ]\n          if not prim_locs:\n              # No more instances on the map \u2013 break (unlikely in well\u2011formed maps).\n              break\n\n          # Move to the nearest instance.\n          path = bfs_path(state.pos, set(prim_locs))\n          if path is None:\n              # No reachable instance \u2013 break.\n              break\n\n          for a in path:\n              _, state = state.step(a)\n              actions.append(a)\n\n          # Use the primitive (the USE action works when the target cell is\n          # directly in front of the agent; we simply issue a USE command).\n          _, state = state.step(ACTION_USE)\n          actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # If the recipe specifies a workshop, go there and craft the stick.\n  # ------------------------------------------------------------------\n  recipe_dict = state.world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = None\n  if isinstance(recipe_dict, dict):\n      workshop_name = recipe_dict.get(\"_at\")\n\n  if workshop_name:\n      workshop_idx = idx.index(workshop_name)\n\n      h, w = state.grid.shape[:2]\n      workshop_cells = [\n          (i, j)\n          for i in range(h)\n          for j in range(w)\n          if state.grid[i, j, workshop_idx] > 0\n      ]\n\n      if workshop_cells:\n          path = bfs_path(state.pos, set(workshop_cells))\n          if path:\n              for a in path:\n                  _, state = state.step(a)\n                  actions.append(a)\n\n              # Craft at the workshop.\n              _, state = state.step(ACTION_USE)\n              actions.append(ACTION_USE)\n\n  # Return the complete action sequence.\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T16:37:27.480226", "function_name": "make_stick", "function_body": "  # ------------------------------------------------------------------\n  # Simple planner to obtain a stick in the given CraftLab environment.\n  # It extracts the stick recipe, walks to required primitives,\n  # picks them up, walks to the appropriate workshop and uses it.\n  # The action space is assumed to be:\n  #   0: DOWN, 1: UP, 2: LEFT, 3: RIGHT, 4: USE\n  # ------------------------------------------------------------------\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper: move from (x0,y0) to (x1,y1) using Manhattan steps.\n  # ------------------------------------------------------------------\n  def _move_path(cur, target):\n      cx, cy = cur\n      tx, ty = target\n      path = []\n      # horizontal moves\n      while cx < tx:\n          path.append(3)          # RIGHT\n          cx += 1\n      while cx > tx:\n          path.append(2)          # LEFT\n          cx -= 1\n      # vertical moves\n      while cy < ty:\n          path.append(0)          # DOWN\n          cy += 1\n      while cy > ty:\n          path.append(1)          # UP\n          cy -= 1\n      return path, (cx, cy)\n\n  # ------------------------------------------------------------------\n  # Retrieve stick recipe information from the world cookbook.\n  # ------------------------------------------------------------------\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      # If the world has no stick, we cannot craft it.\n      return actions\n\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  # Separate primitive requirements from the workshop spec.\n  workshop_kind = recipe.get(\"_at\", None)\n  primitive_reqs = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  # Current state information.\n  state = env._current_state          # type: CraftState\n  cur_pos = tuple(state.pos)          # (x, y)\n\n  # ------------------------------------------------------------------\n  # Collect each primitive required for the stick.\n  # ------------------------------------------------------------------\n  grid = state.grid\n  for prim_kind, needed in primitive_reqs.items():\n      # Find all cells that currently contain this primitive.\n      prim_cells = list(map(tuple, np.argwhere(grid[:, :, prim_kind] > 0)))\n      if not prim_cells:\n          # Primitive not present \u2013 abort planning.\n          return actions\n      # Take the first `needed` cells (na\u00efve selection).\n      for target in prim_cells[:needed]:\n          # Move to the primitive.\n          move_seq, cur_pos = _move_path(cur_pos, target)\n          actions.extend(move_seq)\n          # Pick it up.\n          actions.append(4)            # USE\n          # Update internal grid view to reflect the pickup (optional).\n          grid[target[0], target[1], prim_kind] = 0\n\n  # ------------------------------------------------------------------\n  # Move to the appropriate workshop (if any) and craft.\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      # Locate a workshop of the required kind.\n      workshop_cells = list(map(tuple, np.argwhere(grid[:, :, workshop_kind] > 0)))\n      if workshop_cells:\n          workshop_target = workshop_cells[0]\n          move_seq, cur_pos = _move_path(cur_pos, workshop_target)\n          actions.extend(move_seq)\n          # Craft the stick.\n          actions.append(4)            # USE\n      else:\n          # No workshop found \u2013 cannot craft.\n          return actions\n  else:\n      # No specific workshop required; just use at current location.\n      actions.append(4)                # USE\n\n  return actions", "env_interactions": 0, "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-10-21T16:37:28.576856", "function_name": "make_stick", "function_body": "  # --- Helper: BFS path finder -----------------------------------------\n  def _bfs(start, goal, blocked):\n      \"\"\"\n      Returns a list of action indices (DOWN,UP,LEFT,RIGHT) that moves\n      from start to goal avoiding blocked cells.\n      \"\"\"\n      from collections import deque\n\n      w, h = blocked.shape\n      visited = np.zeros((w, h), dtype=bool)\n      prev = {}                     # (x,y) -> (px,py,action)\n      q = deque([start])\n      visited[start] = True\n\n      # direction vectors aligned with action indices\n      dirs = [(1, 0), (-1, 0), (0, -1), (0, 1)]   # DOWN,UP,LEFT,RIGHT\n\n      while q:\n          x, y = q.popleft()\n          if (x, y) == goal:\n              # reconstruct path\n              actions = []\n              cur = (x, y)\n              while cur != start:\n                  px, py, act = prev[cur]\n                  actions.append(act)\n                  cur = (px, py)\n              actions.reverse()\n              return actions\n          for act, (dx, dy) in enumerate(dirs):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and not blocked[nx, ny] and not visited[nx, ny]:\n                  visited[nx, ny] = True\n                  prev[(nx, ny)] = (x, y, act)\n                  q.append((nx, ny))\n      # no path found \u2013 return empty list\n      return []\n\n  # ----------------------------------------------------------------------\n  state = env._current_state\n  world = env.world\n  idx = world.cookbook.index\n\n  # index of the target item \"stick\"\n  try:\n      stick_idx = idx[\"stick\"]\n  except Exception:\n      # if the name is not present we cannot craft; return empty plan\n      return []\n\n  # early exit if we already have a stick\n  if state.inventory[stick_idx] > 0:\n      return []\n\n  # local copies for planning (do not modify the real environment state)\n  grid = state.grid.copy()\n  inventory = state.inventory.copy()\n  pos = state.pos\n\n  # cells that cannot be walked through (water, stone, etc.)\n  non_grabbable = list(world.non_grabbable_indices)\n  blocked = np.any(grid[:, :, non_grabbable] > 0, axis=2)\n\n  plan = []\n\n  # ------------------------------------------------------------------\n  # 1) Gather required primitive resources for a stick\n  # ------------------------------------------------------------------\n  required = world.cookbook.primitives_for(stick_idx)      # {prim_idx: count}\n  for prim_idx, need_cnt in required.items():\n      while inventory[prim_idx] < need_cnt:\n          # locate the nearest instance of this primitive\n          locations = np.argwhere(grid[:, :, prim_idx] > 0)\n          if locations.size == 0:\n              # no more primitives of this type on the map \u2013 abort planning\n              return plan\n          # choose the first (could be improved with nearest search)\n          target = tuple(locations[0])\n\n          # move to the primitive cell\n          moves = _bfs(pos, target, blocked)\n          plan.extend(moves)\n          # update simulated position\n          for a in moves:\n              dx, dy = [(1, 0), (-1, 0), (0, -1), (0, 1)][a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # pick it up (USE)\n          plan.append(4)          # 4 == USE\n          # simulate the effect of picking up\n          inventory[prim_idx] += 1\n          grid[target[0], target[1], prim_idx] = 0\n          # the cell is now empty \u2192 not blocked any more\n          blocked[target[0], target[1]] = False\n\n  # ------------------------------------------------------------------\n  # 2) Craft the stick at its required workshop (if any)\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_idx = recipe.get(\"_at\")\n  if workshop_idx is not None:\n      # locate a workshop of the appropriate type\n      locations = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if locations.size > 0:\n          target = tuple(locations[0])\n          moves = _bfs(pos, target, blocked)\n          plan.extend(moves)\n          for a in moves:\n              dx, dy = [(1, 0), (-1, 0), (0, -1), (0, 1)][a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          # use the workshop to craft the stick\n          plan.append(4)          # USE\n\n  return plan", "env_interactions": 0, "island_id": 4, "scores": {"3": -1}}
