{"timestamp": "2025-10-21T20:57:10.708209", "function_name": "make_stick", "function_body": "  # Reset environment and fetch useful references\n  env.reset()\n  world = env.world\n  idx = world.cookbook.index\n\n  # ------------------------------------------------------------------\n  # Identify the index for the target item \u201cstick\u201d\n  # ------------------------------------------------------------------\n  try:\n      stick_idx = idx[\"stick\"]\n  except Exception:  # pragma: no cover\n      # fallback: search case\u2011insensitively\n      stick_idx = next(i for i, n in enumerate(idx.ordered_contents) if n.lower() == \"stick\")\n\n  # ------------------------------------------------------------------\n  # Determine which primitives are required to craft a stick.\n  # If the stick itself is a primitive, treat it as the only requirement.\n  # ------------------------------------------------------------------\n  needed = world.cookbook.primitives_for(stick_idx)\n  if not needed:\n      needed = {stick_idx: 1}\n\n  # ------------------------------------------------------------------\n  # Action identifiers and movement deltas\n  # ------------------------------------------------------------------\n  act_map = env.action_specs()\n  DOWN = act_map[\"DOWN\"]\n  UP = act_map[\"UP\"]\n  LEFT = act_map[\"LEFT\"]\n  RIGHT = act_map[\"RIGHT\"]\n  USE = act_map[\"USE\"]\n\n  delta = {\n      DOWN:  (0, 1),\n      UP:    (0, -1),\n      LEFT:  (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  # ------------------------------------------------------------------\n  # Simulated current state (used only for planning)\n  # ------------------------------------------------------------------\n  state = env._current_state\n  cur_pos = tuple(state.pos)               # (x, y)\n  grid = state.grid.copy()                 # mutable copy for bookkeeping\n\n  # ------------------------------------------------------------------\n  # Cells that block movement = any non\u2011grabbable entity present\n  # ------------------------------------------------------------------\n  non_grabbable = list(world.non_grabbable_indices)\n  if non_grabbable:\n      blocked = np.any(grid[:, :, non_grabbable] > 0, axis=2)\n  else:\n      blocked = np.zeros(grid.shape[:2], dtype=bool)\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions to reach the nearest\n  # cell belonging to *targets* while avoiding *blocked* cells.\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  def bfs_path(start, targets, blocked_mask):\n      \"\"\"Return shortest\u2011path actions from *start* to any cell in *targets*.\"\"\"\n      if start in targets:\n          return []\n      q = deque([start])\n      # visited: pos -> (parent_pos, action_taken_to_reach_pos)\n      visited = {start: (None, None)}\n      while q:\n          x, y = q.popleft()\n          for a, (dx, dy) in delta.items():\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < blocked_mask.shape[0] and 0 <= ny < blocked_mask.shape[1]):\n                  continue\n              if blocked_mask[nx, ny]:\n                  continue\n              nxt = (nx, ny)\n              if nxt in visited:\n                  continue\n              visited[nxt] = ((x, y), a)\n              if nxt in targets:\n                  # reconstruct actions\n                  actions_rev = []\n                  node = nxt\n                  while visited[node][0] is not None:\n                      parent, act = visited[node]\n                      actions_rev.append(act)\n                      node = parent\n                  return list(reversed(actions_rev))\n              q.append(nxt)\n      # No reachable target \u2013 fall back to Manhattan moves toward an arbitrary one\n      tx, ty = next(iter(targets))\n      man_actions = []\n      cx, cy = start\n      while cx < tx:\n          man_actions.append(RIGHT); cx += 1\n      while cx > tx:\n          man_actions.append(LEFT);  cx -= 1\n      while cy < ty:\n          man_actions.append(DOWN);  cy += 1\n      while cy > ty:\n          man_actions.append(UP);    cy -= 1\n      return man_actions\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives (or the stick itself if primitive)\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      remaining = int(cnt)\n      while remaining > 0:\n          # locate all cells that currently contain this primitive\n          locations = np.argwhere(grid[:, :, prim_idx] > 0)\n          if locations.size == 0:\n              # nothing left on the map \u2013 abort collection loop\n              break\n          # pick the nearest location (Manhattan distance)\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          target = tuple(locations[dists.argmin()])\n          # move to the target cell\n          path = bfs_path(cur_pos, {target}, blocked)\n          actions.extend(path)\n          # update simulated position\n          for a in path:\n              dx, dy = delta[a]\n              cur_pos = (cur_pos[0] + dx, cur_pos[1] + dy)\n          # pick up the primitive\n          actions.append(USE)\n          # update simulated grid and blocked mask\n          grid[target[0], target[1], prim_idx] -= 1\n          if non_grabbable:\n              blocked[target[0], target[1]] = np.any(\n                  grid[target[0], target[1], non_grabbable] > 0\n              )\n          cur_pos = target\n          remaining -= 1\n\n  # ------------------------------------------------------------------\n  # 2. If the recipe specifies a workshop, go there and craft the stick\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = idx[workshop_name]\n      ws_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_locs.size:\n          ws_target = tuple(ws_locs[0])\n          path = bfs_path(cur_pos, {ws_target}, blocked)\n          actions.extend(path)\n          for a in path:\n              dx, dy = delta[a]\n              cur_pos = (cur_pos[0] + dx, cur_pos[1] + dy)\n          actions.append(USE)   # use the workshop to craft\n\n  return actions", "env_interactions": 4, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T20:57:11.829569", "function_name": "make_stick", "function_body": "  env.reset()\n  world = env.world\n  idx = world.cookbook.index\n  # action mapping\n  act = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = act[\"DOWN\"], act[\"UP\"], act[\"LEFT\"], act[\"RIGHT\"], act[\"USE\"]\n  stick_idx = idx[\"stick\"]\n  needed = world.cookbook.primitives_for(stick_idx)\n  if not needed:\n      needed = {stick_idx: 1}\n  state = env._current_state\n  cur_pos = tuple(state.pos)\n  grid = state.grid.copy()\n  non_grabbable = list(world.non_grabbable_indices)\n  if non_grabbable:\n      blocked = np.any(grid[:, :, non_grabbable] > 0, axis=2)\n  else:\n      blocked = np.zeros(grid.shape[:2], dtype=bool)\n\n  from collections import deque\n\n  def bfs(start, goal_set):\n      if start in goal_set:\n          return []\n      q = deque([start])\n      parent = {start: (None, None)}\n      while q:\n          x, y = q.popleft()\n          for act_code, (dx, dy) in ((DOWN, (0, 1)), (UP, (0, -1)),\n                                     (LEFT, (-1, 0)), (RIGHT, (1, 0))):\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < blocked.shape[0] and 0 <= ny < blocked.shape[1]):\n                  continue\n              if blocked[nx, ny]:\n                  continue\n              nxt = (nx, ny)\n              if nxt in parent:\n                  continue\n              parent[nxt] = ((x, y), act_code)\n              if nxt in goal_set:\n                  # reconstruct\n                  actions = []\n                  node = nxt\n                  while parent[node][0] is not None:\n                      node, a = parent[node]\n                      actions.append(a)\n                  actions.reverse()\n                  return actions\n              q.append(nxt)\n      # fallback Manhattan\n      tx, ty = next(iter(goal_set))\n      moves = []\n      x, y = start\n      while x < tx:\n          moves.append(RIGHT); x += 1\n      while x > tx:\n          moves.append(LEFT);  x -= 1\n      while y < ty:\n          moves.append(DOWN);  y += 1\n      while y > ty:\n          moves.append(UP);    y -= 1\n      return moves\n\n  actions = []\n\n  # collect primitives\n  for prim_idx, cnt in needed.items():\n      remaining = int(cnt)\n      while remaining > 0:\n          locs = np.argwhere(grid[:, :, prim_idx] > 0)\n          if locs.size == 0:\n              break\n          targets = {tuple(p) for p in locs.tolist()}\n          path = bfs(cur_pos, targets)\n          actions.extend(path)\n          if path:\n              # update cur_pos by applying moves\n              for a in path:\n                  if a == DOWN:\n                      cur_pos = (cur_pos[0], cur_pos[1] + 1)\n                  elif a == UP:\n                      cur_pos = (cur_pos[0], cur_pos[1] - 1)\n                  elif a == LEFT:\n                      cur_pos = (cur_pos[0] - 1, cur_pos[1])\n                  elif a == RIGHT:\n                      cur_pos = (cur_pos[0] + 1, cur_pos[1])\n          # use to pick up\n          actions.append(USE)\n          # update grid\n          grid[cur_pos[0], cur_pos[1], prim_idx] -= 1\n          remaining -= 1\n\n  # go to workshop if needed\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      ws_idx = idx[workshop_name]\n      ws_locs = np.argwhere(grid[:, :, ws_idx] > 0)\n      if ws_locs.size:\n          ws_target = tuple(ws_locs[0])\n          path = bfs(cur_pos, {ws_target})\n          actions.extend(path)\n          # update cur_pos\n          for a in path:\n              if a == DOWN:\n                  cur_pos = (cur_pos[0], cur_pos[1] + 1)\n              elif a == UP:\n                  cur_pos = (cur_pos[0], cur_pos[1] - 1)\n              elif a == LEFT:\n                  cur_pos = (cur_pos[0] - 1, cur_pos[1])\n              elif a == RIGHT:\n                  cur_pos = (cur_pos[0] + 1, cur_pos[1])\n          actions.append(USE)\n\n  return actions", "env_interactions": 4, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T20:57:23.735359", "function_name": "make_stick", "function_body": "  # Determine action IDs (order may vary per environment)\n  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      action_ids = [0, 1, 2, 3, 4]  # fallback: DOWN, UP, LEFT, RIGHT, USE\n\n  # Index of the target item \"stick\" in the cookbook\n  try:\n      target_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      target_idx = env.world.cookbook.index.get(\"stick\")\n\n  # Starting state: use current lab state if present, otherwise initialise a fresh one\n  start_state = getattr(env, \"_current_state\", None)\n  if start_state is None:\n      start_state = env.scenario.init()\n\n  from collections import deque\n\n  def _state_key(st):\n      \"\"\"Hashable representation of a state for the visited set.\"\"\"\n      return (st.pos, st.dir, st.inventory.tobytes())\n\n  # Bread\u2011first search over deterministic transitions\n  frontier = deque()\n  frontier.append((start_state, []))\n  visited = {_state_key(start_state)}\n  max_plan_len = 1000  # safety limit to avoid infinite loops\n\n  while frontier:\n      cur_state, cur_actions = frontier.popleft()\n\n      # Goal test: inventory already contains a stick\n      if target_idx is not None and cur_state.satisfies(\"\", target_idx):\n          return cur_actions\n\n      if len(cur_actions) >= max_plan_len:\n          continue\n\n      # Expand all possible actions\n      for a in action_ids:\n          _, nxt_state = cur_state.step(a)\n          key = _state_key(nxt_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((nxt_state, cur_actions + [a]))\n\n  # No plan found within limits\n  return []", "env_interactions": 4, "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T20:57:24.850124", "function_name": "make_stick", "function_body": "  from collections import deque\n\n  # ----- helpers -----\n  def _get_action_ids():\n      \"\"\"Return a list of action IDs from the environment.\"\"\"\n      try:\n          return list(env.action_specs().values())\n      except Exception:\n          # default ordering: DOWN, UP, LEFT, RIGHT, USE\n          return [0, 1, 2, 3, 4]\n\n  def _goal_index():\n      \"\"\"Return the integer index of the item 'stick'.\"\"\"\n      try:\n          return env.world.cookbook.index[\"stick\"]\n      except Exception:\n          return env.world.cookbook.index.get(\"stick\")\n\n  def _state_key(state):\n      \"\"\"Compact hashable representation of a state for visited set.\"\"\"\n      # position (x,y), direction, and raw inventory bytes\n      return (state.pos, state.dir, state.inventory.tobytes())\n\n  # ----- main planning -----\n  action_ids = _get_action_ids()\n  goal_idx = _goal_index()\n\n  # starting state: use the lab's current state if available,\n  # otherwise initialise a fresh one from the scenario.\n  start_state = getattr(env, \"_current_state\", None)\n  if start_state is None:\n      start_state = env.scenario.init()\n\n  # BFS queue holds tuples (state, action_list)\n  frontier = deque()\n  frontier.append((start_state, []))\n  visited = {_state_key(start_state)}\n\n  max_steps = 500  # safety bound to avoid endless search\n\n  while frontier:\n      cur_state, cur_actions = frontier.popleft()\n\n      # Goal test: inventory already contains a stick\n      if goal_idx is not None and cur_state.satisfies(\"\", goal_idx):\n          return cur_actions\n\n      if len(cur_actions) >= max_steps:\n          continue\n\n      for a in action_ids:\n          _, nxt_state = cur_state.step(a)\n          key = _state_key(nxt_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((nxt_state, cur_actions + [a]))\n\n  # No plan found within limits\n  return []", "env_interactions": 4, "island_id": 2, "scores": {"3": 1.5}}
