{"timestamp": "2025-10-21T17:44:16.934196", "function_name": "make_stick", "function_body": "  # Retrieve essential objects; if any are missing, return empty plan\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      return []\n  world = getattr(env, \"world\", None)\n  if world is None:\n      return []\n  cookbook = getattr(world, \"cookbook\", None)\n  if cookbook is None:\n      return []\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []\n  grid = getattr(state, \"grid\", None)\n  pos = getattr(state, \"pos\", None)\n  if grid is None or pos is None:\n      return []\n\n  # Action indices\n  action_map = env.action_specs()\n  DOWN = action_map.get(\"DOWN\", 0)\n  UP = action_map.get(\"UP\", 1)\n  LEFT = action_map.get(\"LEFT\", 2)\n  RIGHT = action_map.get(\"RIGHT\", 3)\n  USE = action_map.get(\"USE\", 4)\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def manhattan(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def nearest_target(targets, src):\n      \"\"\"Return the target with minimal Manhattan distance to src.\"\"\"\n      if not targets:\n          return None\n      return min(targets, key=lambda t: manhattan(t, src))\n\n  def move_to(target):\n      \"\"\"Append actions that move the agent from current pos to target.\"\"\"\n      nonlocal pos\n      # Move vertically (row index) first\n      while pos[0] < target[0]:\n          actions.append(DOWN)\n          pos = (pos[0] + 1, pos[1])\n      while pos[0] > target[0]:\n          actions.append(UP)\n          pos = (pos[0] - 1, pos[1])\n      # Then move horizontally (column index)\n      while pos[1] < target[1]:\n          actions.append(RIGHT)\n          pos = (pos[0], pos[1] + 1)\n      while pos[1] > target[1]:\n          actions.append(LEFT)\n          pos = (pos[0], pos[1] - 1)\n\n  # ------------------------------------------------------------------\n  # Determine what needs to be collected for the goal\n  # ------------------------------------------------------------------\n  primitives_needed = cookbook.primitives_for(goal_idx)\n\n  # If the goal itself is a primitive (no recipe), we just need to pick it up\n  if not primitives_needed:\n      primitives_needed = {goal_idx: 1}\n      need_crafting = False\n  else:\n      need_crafting = True\n\n  # ------------------------------------------------------------------\n  # Collect required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, needed_qty in primitives_needed.items():\n      # Locate all cells currently containing this primitive\n      locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n      if not locations:\n          # Primitive not present in the world \u2013 cannot solve\n          return []\n      collected = 0\n      while collected < needed_qty:\n          target = nearest_target(locations, pos)\n          if target is None:\n              return []\n          move_to(target)\n          actions.append(USE)   # pick up the primitive\n          collected += 1\n          # Remove this location so we don't target it again\n          if target in locations:\n              locations.remove(target)\n\n  # ------------------------------------------------------------------\n  # If crafting is required, go to the appropriate workshop and craft\n  # ------------------------------------------------------------------\n  if need_crafting:\n      recipe = cookbook.recipes.get(goal_idx, {})\n      workshop_kind = recipe.get(\"_at\", None)\n      if workshop_kind is not None:\n          workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n          if not workshop_cells:\n              return []\n          ws_target = nearest_target(workshop_cells, pos)\n          move_to(ws_target)\n      # Perform the crafting action\n      actions.append(USE)\n\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T17:44:18.051202", "function_name": "make_stick", "function_body": "  # ----------------------------------------------------------------------\n  # Retrieve essential objects from the environment\n  # ----------------------------------------------------------------------\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      return []\n  world = getattr(env, \"world\", None)\n  if world is None:\n      return []\n  cookbook = getattr(world, \"cookbook\", None)\n  if cookbook is None:\n      return []\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []\n  grid = getattr(state, \"grid\", None)\n  pos = getattr(state, \"pos\", None)\n  if grid is None or pos is None:\n      return []\n\n  # ----------------------------------------------------------------------\n  # Action mapping\n  # ----------------------------------------------------------------------\n  action_map = env.action_specs()\n  DOWN = action_map.get(\"DOWN\", 0)\n  UP = action_map.get(\"UP\", 1)\n  LEFT = action_map.get(\"LEFT\", 2)\n  RIGHT = action_map.get(\"RIGHT\", 3)\n  USE = action_map.get(\"USE\", 4)\n\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # Helper utilities\n  # ----------------------------------------------------------------------\n  from collections import deque\n\n  width, height = grid.shape[0], grid.shape[1]\n  blocked_kinds = set(getattr(world, \"non_grabbable_indices\", []))\n\n  def bfs(start, goal, allow_kinds=()):\n      \"\"\"Return the shortest path (list of positions) from start to goal,\n      allowing stepping on cells that contain any kind in ``allow_kinds``.\n      Returns None if no path exists.\"\"\"\n      if start == goal:\n          return [start]\n      q = deque([start])\n      visited = {start: None}\n      while q:\n          cur = q.popleft()\n          for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              nxt = (nx, ny)\n              if nxt in visited:\n                  continue\n              # Determine if the cell is blocked\n              blocked = False\n              for k in blocked_kinds:\n                  if grid[nx, ny, k] > 0 and k not in allow_kinds:\n                      blocked = True\n                      break\n              if blocked:\n                  continue\n              visited[nxt] = cur\n              if nxt == goal:\n                  # Reconstruct path\n                  path = [goal]\n                  while path[-1] != start:\n                      path.append(visited[path[-1]])\n                  path.reverse()\n                  return path\n              q.append(nxt)\n      return None\n\n  def move_along(path):\n      \"\"\"Append movement actions to follow ``path`` (list of positions).\"\"\"\n      nonlocal pos\n      for nxt in path[1:]:\n          dx = nxt[0] - pos[0]\n          dy = nxt[1] - pos[1]\n          if dx == 1:\n              actions.append(DOWN)\n          elif dx == -1:\n              actions.append(UP)\n          elif dy == 1:\n              actions.append(RIGHT)\n          elif dy == -1:\n              actions.append(LEFT)\n          pos = nxt\n\n  # ----------------------------------------------------------------------\n  # Determine primitive resources required for the goal\n  # ----------------------------------------------------------------------\n  primitives_needed = cookbook.primitives_for(goal_idx)\n  if not primitives_needed:\n      # Goal itself may be a primitive that just needs to be collected\n      primitives_needed = {goal_idx: 1}\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive\n  # ----------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      for _ in range(needed):\n          # Locate all remaining instances of this primitive\n          locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not locations:\n              return []  # required primitive not present\n          best_path = None\n          best_loc = None\n          for loc in locations:\n              path = bfs(pos, loc, allow_kinds=(prim_idx,))\n              if path is not None and (best_path is None or len(path) < len(best_path)):\n                  best_path = path\n                  best_loc = loc\n          if best_path is None:\n              return []  # unreachable primitive\n          move_along(best_path)\n          actions.append(USE)          # pick up the primitive\n          # Update internal grid representation\n          grid[best_loc[0], best_loc[1], prim_idx] = 0\n          pos = best_loc\n\n  # ----------------------------------------------------------------------\n  # Move to the workshop required for crafting (if any)\n  # ----------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n  if workshop_kind is not None:\n      ws_locations = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n      if not ws_locations:\n          return []  # workshop missing\n      best_path = None\n      best_ws = None\n      for ws in ws_locations:\n          path = bfs(pos, ws, allow_kinds=(workshop_kind,))\n          if path is not None and (best_path is None or len(path) < len(best_path)):\n              best_path = path\n              best_ws = ws\n      if best_path is None:\n          return []  # cannot reach workshop\n      move_along(best_path)\n      pos = best_ws\n\n  # ----------------------------------------------------------------------\n  # Final crafting action\n  # ----------------------------------------------------------------------\n  actions.append(USE)\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T17:49:42.193297", "function_name": "make_stick", "function_body": "  actions = []\n  world = env.world\n  # index of the target item \"stick\"\n  stick_idx = world.cookbook.index[\"stick\"]\n  # primitive requirements for one stick\n  prim_req = world.cookbook.primitives_for(stick_idx)\n\n  # helper to compute Manhattan distance\n  def manhattan(a, b):\n      return abs(int(a[0]) - int(b[0])) + abs(int(a[1]) - int(b[1]))\n\n  # current state (will be updated after each step)\n  state = env._current_state\n\n  # ------------------------------------------------------------------\n  # 1) collect all required primitive resources\n  # ------------------------------------------------------------------\n  for prim_idx, needed in prim_req.items():\n      while state.inventory[prim_idx] < needed:\n          # locate the nearest cell that still holds this primitive\n          prim_positions = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if prim_positions.size == 0:\n              raise RuntimeError(\"Required primitive not present in the world.\")\n          dists = np.sum(np.abs(prim_positions - np.array(state.pos)), axis=1)\n          target = prim_positions[dists.argmin()]\n\n          # move until we are in a 3\u00d73 neighbourhood (Manhattan distance \u2264 1)\n          while manhattan(state.pos, target) > 1:\n              cur_x, cur_y = state.pos\n              tar_x, tar_y = target\n              # decide a move that reduces Manhattan distance\n              if cur_x < tar_x:\n                  act = 0          # DOWN\n              elif cur_x > tar_x:\n                  act = 1          # UP\n              elif cur_y < tar_y:\n                  act = 3          # RIGHT\n              else:\n                  act = 2          # LEFT\n              _, state = state.step(act)\n              actions.append(act)\n\n          # now we are adjacent; face the primitive (last move already points to it)\n          # perform USE to pick it up\n          _, state = state.step(4)   # USE\n          actions.append(4)\n\n  # ------------------------------------------------------------------\n  # 2) craft the stick at its required workshop (if any)\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = world.cookbook.index[workshop_name]\n\n      # locate any workshop cell (there will be at least one)\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          raise RuntimeError(\"Workshop for stick not found.\")\n      workshop_target = workshop_cells[0]\n\n      # move adjacent to the workshop\n      while manhattan(state.pos, workshop_target) > 1:\n          cur_x, cur_y = state.pos\n          tar_x, tar_y = workshop_target\n          if cur_x < tar_x:\n              act = 0          # DOWN\n          elif cur_x > tar_x:\n              act = 1          # UP\n          elif cur_y < tar_y:\n              act = 3          # RIGHT\n          else:\n              act = 2          # LEFT\n          _, state = state.step(act)\n          actions.append(act)\n\n      # use the workshop to craft the stick\n      _, state = state.step(4)   # USE\n      actions.append(4)\n\n  # return the complete action list\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-10-21T17:49:43.502369", "function_name": "make_stick", "function_body": "  import numpy as np\n\n  # Reset the environment to obtain a fresh state.\n  env.reset()\n\n  # Access the world and retrieve the integer index for the \"stick\" item.\n  world = env.world\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  actions = []\n  max_steps = 500  # safety cap to avoid infinite loops\n\n  for _ in range(max_steps):\n      # Current internal state maintained by the CraftLab wrapper.\n      state = env._current_state\n\n      # Goal test: we have at least one stick in the inventory.\n      if state.inventory[stick_idx] > 0:\n          break\n\n      # If a stick (or the required primitive) is within the 3\u00d73 neighbourhood,\n      # use the USE action (index 4) to pick it up or craft it.\n      if state.next_to(stick_idx):\n          act = 4  # USE\n      else:\n          # Otherwise move randomly (actions 0\u20113 correspond to DOWN, UP, LEFT, RIGHT).\n          act = int(np.random.randint(0, 4))\n\n      actions.append(act)\n\n      # Apply the action to obtain the next state.\n      _, new_state = state.step(act)\n      env._current_state = new_state\n\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-10-21T17:50:08.853307", "function_name": "make_stick", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  # identify stick goal\n  try:\n      goal_idx = cookbook.index[\"stick\"]\n  except Exception:\n      return []\n\n  # primitive requirements\n  prim_needed = cookbook.primitives_for(goal_idx)\n  if not prim_needed:\n      return []\n\n  # action ids\n  act_map = env.action_specs()\n  DOWN = act_map.get(\"DOWN\", 0)\n  UP = act_map.get(\"UP\", 1)\n  LEFT = act_map.get(\"LEFT\", 2)\n  RIGHT = act_map.get(\"RIGHT\", 3)\n  USE = act_map.get(\"USE\", 4)\n\n  def _moves(start, target):\n      cx, cy = start\n      tx, ty = target\n      moves = []\n      while cx < tx:\n          moves.append(DOWN); cx += 1\n      while cx > tx:\n          moves.append(UP); cx -= 1\n      while cy < ty:\n          moves.append(RIGHT); cy += 1\n      while cy > ty:\n          moves.append(LEFT); cy -= 1\n      return moves\n\n  grid = state.grid\n  # locate primitives\n  prim_locations = {}\n  for p_idx in prim_needed:\n      locs = np.argwhere(grid[:, :, p_idx] > 0)\n      prim_locations[p_idx] = [tuple(pos) for pos in locs]\n\n  # locate workshop\n  workshop_idx = None\n  recipe = cookbook.recipes.get(goal_idx, {})\n  wk_name = recipe.get(\"_at\")\n  if wk_name is not None:\n      try:\n          workshop_idx = cookbook.index[wk_name]\n      except Exception:\n          workshop_idx = None\n\n  workshop_pos = None\n  if workshop_idx is not None:\n      cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if cells.size:\n          workshop_pos = tuple(cells[0])\n\n  if workshop_pos is None:\n      for wk_idx in world.workshop_indices:\n          cells = np.argwhere(grid[:, :, wk_idx] > 0)\n          if cells.size:\n              workshop_pos = tuple(cells[0])\n              break\n\n  cur_pos = state.pos\n  plan = []\n\n  # collect primitives\n  for p_idx, needed in prim_needed.items():\n      collected = 0\n      available = prim_locations.get(p_idx, []).copy()\n      while collected < needed and available:\n          # nearest primitive\n          dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in available]\n          nearest = int(np.argmin(dists))\n          target = available.pop(nearest)\n\n          plan.extend(_moves(cur_pos, target))\n          cur_pos = target\n          plan.append(USE)      # pick up\n          collected += 1\n\n      if collected < needed:\n          # not enough primitives on map \u2013 stop planning\n          break\n\n  # go to workshop and craft\n  if workshop_pos is not None:\n      plan.extend(_moves(cur_pos, workshop_pos))\n      cur_pos = workshop_pos\n  plan.append(USE)\n\n  return plan", "env_interactions": 4, "island_id": 5, "scores": {"3": 0.0}}
