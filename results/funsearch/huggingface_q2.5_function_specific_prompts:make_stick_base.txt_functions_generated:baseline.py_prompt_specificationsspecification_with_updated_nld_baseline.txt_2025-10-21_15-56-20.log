{"timestamp": "2025-10-21T21:27:07.878096", "function_name": "make_stick", "function_body": "  import collections\n\n  # ----- helper functions -----\n  def _action_ids():\n      \"\"\"Return list of action integer IDs available in the environment.\"\"\"\n      try:\n          # env.action_specs() returns a dict mapping action names to IDs\n          return list(env.action_specs().values())\n      except Exception:\n          # Default ordering used in CraftWorld\n          return [0, 1, 2, 3, 4]  # DOWN, UP, LEFT, RIGHT, USE\n\n  def _goal_index():\n      \"\"\"Return integer index of the target item \\\"stick\\\".\"\"\"\n      try:\n          return env.world.cookbook.index[\"stick\"]\n      except Exception:\n          return env.world.cookbook.index.get(\"stick\")\n\n  def _state_key(st):\n      \"\"\"Create a hashable representation of a CraftState for visited checks.\"\"\"\n      # Include position, direction, inventory and grid layout.\n      return (st.pos, st.dir, st.inventory.tobytes(), st.grid.tobytes())\n\n  # ----- initialise -----\n  action_ids = _action_ids()\n  goal_idx = _goal_index()\n\n  # Obtain the starting state.  The lab wrapper may expose it via\n  # ``_current_state``; otherwise we initialise a fresh state from the scenario.\n  start_state = getattr(env, \"_current_state\", None)\n  if start_state is None:\n      start_state = env.scenario.init()\n\n  # ----- breadth\u2011first search over deterministic dynamics -----\n  frontier = collections.deque()\n  frontier.append((start_state, []))\n  visited = {_state_key(start_state)}\n\n  MAX_PLAN_LEN = 500  # safety bound to prevent infinite search\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      # Goal test: inventory already contains at least one stick.\n      if goal_idx is not None and cur_state.satisfies(\"\", goal_idx):\n          return cur_plan\n\n      # Prune overly long plans.\n      if len(cur_plan) >= MAX_PLAN_LEN:\n          continue\n\n      # Prefer the USE action (typically index 4) to interact before moving.\n      if 4 in action_ids:\n          ordered = [4] + [a for a in action_ids if a != 4]\n      else:\n          ordered = action_ids\n\n      # Expand all possible actions.\n      for a in ordered:\n          _, nxt_state = cur_state.step(a)\n          key = _state_key(nxt_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((nxt_state, cur_plan + [a]))\n\n  # If no plan found within the limits, return an empty plan.\n  return []", "env_interactions": 4, "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T21:27:38.091179", "function_name": "make_stick", "function_body": "  env.reset()\n  world = env.world\n  scenario = env.scenario\n\n  # Action indices as defined by CraftLab.action_specs()\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  # Index of the target item (stick)\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # Determine primitive requirements for a stick\n  primitives_needed = world.cookbook.primitives_for(stick_idx)\n  if not primitives_needed:\n      # If the recipe is empty, the stick itself is a primitive\n      primitives_needed = {stick_idx: 1}\n\n  # Local mutable copy of the grid and agent position\n  grid = scenario.init_grid.copy()\n  pos = scenario.init_pos  # (x, y)\n  actions = []\n\n  from collections import deque\n\n  def bfs(start, goal):\n      \"\"\"Return a list of movement actions from start to goal, avoiding occupied cells.\"\"\"\n      W, H = grid.shape[:2]\n      visited = set()\n      q = deque()\n      q.append((start, []))\n      visited.add(start)\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for act, (dx, dy) in (\n              (ACTION_DOWN, (0, 1)),\n              (ACTION_UP, (0, -1)),\n              (ACTION_LEFT, (-1, 0)),\n              (ACTION_RIGHT, (1, 0)),\n          ):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H:\n                  # A cell is walkable iff it contains no entities of any kind\n                  if np.any(grid[nx, ny, :] != 0):\n                      continue\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [act]))\n      return None  # unreachable\n\n  def free_adjacent(cell):\n      \"\"\"Return a list of free (unoccupied) cells adjacent to `cell`.\"\"\"\n      adj = []\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          ax, ay = cell[0] + dx, cell[1] + dy\n          if 0 <= ax < grid.shape[0] and 0 <= ay < grid.shape[1]:\n              if not np.any(grid[ax, ay, :] != 0):\n                  adj.append((ax, ay))\n      return adj\n\n  def direction_action(dx, dy):\n      \"\"\"Map a delta (dx, dy) to the corresponding movement action.\"\"\"\n      if dx == -1 and dy == 0:\n          return ACTION_LEFT\n      if dx == 1 and dy == 0:\n          return ACTION_RIGHT\n      if dx == 0 and dy == -1:\n          return ACTION_UP\n      if dx == 0 and dy == 1:\n          return ACTION_DOWN\n      return None\n\n  # -------------------------------------------------------------------------\n  # 1. Collect all required primitive items\n  # -------------------------------------------------------------------------\n  for prim_idx, count in primitives_needed.items():\n      for _ in range(count):\n          # Locate any remaining instance of the primitive\n          locations = np.argwhere(grid[:, :, prim_idx] > 0)\n          if len(locations) == 0:\n              # No more of this primitive on the map \u2013 skip (should not happen)\n              continue\n          target = tuple(locations[0])  # (x, y)\n\n          # Find a free adjacent cell from which we can USE the primitive\n          adj_cells = free_adjacent(target)\n          chosen_adj = None\n          path_to_adj = None\n          for adj in adj_cells:\n              p = bfs(pos, adj)\n              if p is not None:\n                  chosen_adj = adj\n                  path_to_adj = p\n                  break\n\n          if path_to_adj is None:\n              # Unable to reach a usable position; abort this primitive\n              continue\n\n          # Move to the chosen adjacent cell\n          actions.extend(path_to_adj)\n          pos = chosen_adj\n\n          # Face the primitive (set direction via a movement action toward it)\n          dx = target[0] - pos[0]\n          dy = target[1] - pos[1]\n          dir_act = direction_action(dx, dy)\n          if dir_act is not None:\n              actions.append(dir_act)\n\n          # Use the primitive (collect it)\n          actions.append(ACTION_USE)\n\n          # Update local grid copy to reflect the collected primitive\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # -------------------------------------------------------------------------\n  # 2. Craft the stick at its required workshop (if any)\n  # -------------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      # Locate a workshop cell of the required type\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if len(workshop_cells) > 0:\n          workshop_pos = tuple(workshop_cells[0])\n\n          # Find a free adjacent cell next to the workshop\n          adj_cells = free_adjacent(workshop_pos)\n          chosen_adj = None\n          path_to_adj = None\n          for adj in adj_cells:\n              p = bfs(pos, adj)\n              if p is not None:\n                  chosen_adj = adj\n                  path_to_adj = p\n                  break\n\n          if path_to_adj is not None:\n              # Move next to the workshop\n              actions.extend(path_to_adj)\n              pos = chosen_adj\n\n              # Face the workshop\n              dx = workshop_pos[0] - pos[0]\n              dy = workshop_pos[1] - pos[1]\n              dir_act = direction_action(dx, dy)\n              if dir_act is not None:\n                  actions.append(dir_act)\n\n              # Use to craft the stick\n              actions.append(ACTION_USE)\n\n  # Return the compiled action sequence\n  return actions", "env_interactions": 7, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T21:27:39.366061", "function_name": "make_stick", "function_body": "  # Reset environment to ensure we start from a clean state\n  env.reset()\n  world = env.world\n  scenario = env.scenario\n\n  # Action indices (as defined by CraftLab.action_specs())\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  # Index of the target item (stick)\n  stick_idx = world.cookbook.index[\"stick\"]\n\n  # Determine which primitives are needed to craft a stick\n  primitives_needed = world.cookbook.primitives_for(stick_idx)\n  if not primitives_needed:\n      # If the recipe is empty, the stick itself is a primitive\n      primitives_needed = {stick_idx: 1}\n\n  # Local mutable copies of the grid and the agent's position\n  grid = scenario.init_grid.copy()\n  pos = scenario.init_pos  # (x, y)\n  actions = []\n\n  # -------------------------------------------------------------------------\n  # Helper utilities\n  # -------------------------------------------------------------------------\n  from collections import deque\n\n  def bfs(start, goal):\n      \"\"\"Return a list of movement actions from start to goal, avoiding occupied cells.\"\"\"\n      W, H = grid.shape[:2]\n      visited = set()\n      q = deque()\n      q.append((start, []))\n      visited.add(start)\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for act, (dx, dy) in (\n              (ACTION_DOWN, (0, 1)),\n              (ACTION_UP, (0, -1)),\n              (ACTION_LEFT, (-1, 0)),\n              (ACTION_RIGHT, (1, 0)),\n          ):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H:\n                  # Walkable iff the cell contains no entities of any kind\n                  if np.any(grid[nx, ny, :] != 0):\n                      continue\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [act]))\n      return None  # unreachable\n\n  def free_adjacent(cell):\n      \"\"\"Return a list of free (unoccupied) cells adjacent to `cell`.\"\"\"\n      adj = []\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          ax, ay = cell[0] + dx, cell[1] + dy\n          if 0 <= ax < grid.shape[0] and 0 <= ay < grid.shape[1]:\n              if not np.any(grid[ax, ay, :] != 0):\n                  adj.append((ax, ay))\n      return adj\n\n  def direction_action(dx, dy):\n      \"\"\"Map a delta (dx, dy) to the corresponding movement action (used to set facing direction).\"\"\"\n      if dx == -1 and dy == 0:\n          return ACTION_LEFT\n      if dx == 1 and dy == 0:\n          return ACTION_RIGHT\n      if dx == 0 and dy == -1:\n          return ACTION_UP\n      if dx == 0 and dy == 1:\n          return ACTION_DOWN\n      return None\n\n  # -------------------------------------------------------------------------\n  # 1. Collect all required primitive items\n  # -------------------------------------------------------------------------\n  for prim_idx, count in primitives_needed.items():\n      for _ in range(count):\n          # Locate any remaining instance of the primitive on the map\n          locations = np.argwhere(grid[:, :, prim_idx] > 0)\n          if len(locations) == 0:\n              # No more of this primitive left \u2013 this should not happen in a solvable scenario\n              continue\n          target = tuple(locations[0])  # (x, y)\n\n          # Find a free adjacent cell from which we can USE the primitive\n          adj_cells = free_adjacent(target)\n          chosen_adj = None\n          path_to_adj = None\n          for adj in adj_cells:\n              p = bfs(pos, adj)\n              if p is not None:\n                  chosen_adj = adj\n                  path_to_adj = p\n                  break\n\n          if path_to_adj is None:\n              # Unable to reach a usable position; skip this primitive\n              continue\n\n          # Move to the chosen adjacent cell\n          actions.extend(path_to_adj)\n          pos = chosen_adj\n\n          # Face the primitive (by moving one step towards it, which also sets direction)\n          dx = target[0] - pos[0]\n          dy = target[1] - pos[1]\n          dir_act = direction_action(dx, dy)\n          if dir_act is not None:\n              actions.append(dir_act)\n\n          # Use the primitive (collect it)\n          actions.append(ACTION_USE)\n\n          # Update local grid copy to reflect the collected primitive\n          grid[target[0], target[1], prim_idx] -= 1\n\n  # -------------------------------------------------------------------------\n  # 2. Craft the stick at its required workshop (if any)\n  # -------------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if len(workshop_cells) > 0:\n          workshop_pos = tuple(workshop_cells[0])\n\n          # Find a free adjacent cell next to the workshop\n          adj_cells = free_adjacent(workshop_pos)\n          chosen_adj = None\n          path_to_adj = None\n          for adj in adj_cells:\n              p = bfs(pos, adj)\n              if p is not None:\n                  chosen_adj = adj\n                  path_to_adj = p\n                  break\n\n          if path_to_adj is not None:\n              # Move next to the workshop\n              actions.extend(path_to_adj)\n              pos = chosen_adj\n\n              # Face the workshop\n              dx = workshop_pos[0] - pos[0]\n              dy = workshop_pos[1] - pos[1]\n              dir_act = direction_action(dx, dy)\n              if dir_act is not None:\n                  actions.append(dir_act)\n\n              # Use to craft the stick\n              actions.append(ACTION_USE)\n\n  # Return the compiled list of actions\n  return actions", "env_interactions": 7, "island_id": 1, "scores": {"3": 0.0}}
