{"timestamp": "2025-10-21T16:37:49.000397", "function_name": "make_stick", "function_body": "  # Generic planner to create a stick (or any goal) in a CraftWorld environment.\n  # The function inspects the environment's task goal, determines the required\n  # primitives via the cookbook, locates those primitives and the required\n  # workshop on the grid, and returns a list of action indices that will\n  # (1) move to each primitive, (2) pick it up, (3) move to the workshop,\n  # and (4) craft the target item.\n  #\n  # This implementation makes a number of simplifying assumptions:\n  #   * The environment passed is a `CraftLab` instance.\n  #   * The grid is static (primitives do not move) and the agent can walk\n  #     through any empty cell.\n  #   * The action space follows the standard DMLab mapping:\n  #         DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n  #   * Using `USE` while adjacent to a primitive picks it up, and using it\n  #     while adjacent to the correct workshop crafts the desired item.\n  #\n  # The planner does not simulate state changes; it simply computes a\n  # feasible action sequence based on the initial layout.  The environment\n  # will execute the actions in order, and the sequence should be sufficient\n  # to satisfy the goal.\n  #\n  # If anything goes wrong (e.g., a required primitive or workshop cannot be\n  # found), the function falls back to returning an empty list.\n  #\n  # Returns:\n  #   List[int]: Action indices that achieve the goal.\n  # -------------------------------------------------------------------------\n\n  # -------------------------------------------------------------------------\n  # Helper utilities\n  # -------------------------------------------------------------------------\n  def _manhattan(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def _nearest(targets, src):\n      \"\"\"Return the target position with minimal Manhattan distance to src.\"\"\"\n      if not targets:\n          return None\n      return min(targets, key=lambda t: _manhattan(t, src))\n\n  # -------------------------------------------------------------------------\n  # Extract core objects from the environment\n  # -------------------------------------------------------------------------\n  # The task goal is stored in env.task.goal (an integer index)\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      return []\n\n  # Access the world and its cookbook for recipe information\n  world = getattr(env, \"world\", None)\n  if world is None:\n      return []\n  cookbook = getattr(world, \"cookbook\", None)\n  if cookbook is None:\n      return []\n\n  # Current state provides the grid and the agent's position\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []\n  grid = getattr(state, \"grid\", None)\n  pos = getattr(state, \"pos\", None)\n  if grid is None or pos is None:\n      return []\n\n  # Action mapping (DOWN, UP, LEFT, RIGHT, USE)\n  action_map = env.action_specs()\n  DOWN = action_map.get(\"DOWN\", 0)\n  UP = action_map.get(\"UP\", 1)\n  LEFT = action_map.get(\"LEFT\", 2)\n  RIGHT = action_map.get(\"RIGHT\", 3)\n  USE = action_map.get(\"USE\", 4)\n\n  actions = []\n\n  # -------------------------------------------------------------------------\n  # Determine which primitives are required for the goal\n  # -------------------------------------------------------------------------\n  # primitives_for returns a dict {primitive_idx: count}\n  primitives_needed = cookbook.primitives_for(goal_idx)\n\n  # If the goal has no recipe, treat it as a primitive that must be collected\n  if not primitives_needed:\n      primitives_needed = {goal_idx: 1}\n\n  # -------------------------------------------------------------------------\n  # Helper to move from current position to a target cell\n  # -------------------------------------------------------------------------\n  def move_to(target):\n      nonlocal pos\n      # Simple greedy Manhattan movement\n      while pos[0] < target[0]:\n          actions.append(DOWN)\n          pos = (pos[0] + 1, pos[1])\n      while pos[0] > target[0]:\n          actions.append(UP)\n          pos = (pos[0] - 1, pos[1])\n      while pos[1] < target[1]:\n          actions.append(RIGHT)\n          pos = (pos[0], pos[1] + 1)\n      while pos[1] > target[1]:\n          actions.append(LEFT)\n          pos = (pos[0], pos[1] - 1)\n\n  # -------------------------------------------------------------------------\n  # Collect each required primitive\n  # -------------------------------------------------------------------------\n  for prim_idx, count_needed in primitives_needed.items():\n      # Find all cells containing this primitive (grid[:,:,prim_idx] > 0)\n      locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n      if not locations:\n          # Primitive not present \u2013 cannot solve; abort\n          return []\n      # Repeatedly collect until we have enough\n      collected = 0\n      while collected < count_needed:\n          # Choose nearest location from current position\n          target = _nearest(locations, pos)\n          if target is None:\n              return []\n          # Move adjacent to the target (we need to be next to it)\n          # Aim for a cell that is orthogonally adjacent and walkable.\n          # Simplify by moving directly onto the target cell if it is empty;\n          # otherwise move to any orthogonal neighbor that is within bounds.\n          # Here we assume the target cell itself is walkable (primitives occupy\n          # the cell but are not blocking for movement). If that assumption\n          # fails, the environment will handle the collision.\n          move_to(target)\n          # Use the primitive\n          actions.append(USE)\n          collected += 1\n          # No state simulation; we just assume the primitive is now in inventory.\n          # Continue to next needed count.\n\n  # -------------------------------------------------------------------------\n  # Locate the required workshop (if any) for crafting the goal\n  # -------------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  for key, val in recipe.items():\n      if key == \"_at\":\n          workshop_kind = val\n          break\n  if workshop_kind is not None:\n      # Find workshop cells of this kind\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n      if not workshop_cells:\n          return []\n      # Move to the nearest workshop\n      target_ws = _nearest(workshop_cells, pos)\n      if target_ws is None:\n          return []\n      move_to(target_ws)\n\n  # -------------------------------------------------------------------------\n  # Craft the goal item\n  # -------------------------------------------------------------------------\n  actions.append(USE)  # Assuming USE at the workshop crafts the item\n\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T16:38:18.844664", "function_name": "make_stick", "function_body": "  # Extract goal and world information\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      return []\n  world = getattr(env, \"world\", None)\n  if world is None:\n      return []\n  cookbook = getattr(world, \"cookbook\", None)\n  if cookbook is None:\n      return []\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []\n  grid = getattr(state, \"grid\", None)\n  pos = getattr(state, \"pos\", None)\n  if grid is None or pos is None:\n      return []\n\n  # Action indices\n  action_map = env.action_specs()\n  DOWN = action_map.get(\"DOWN\", 0)\n  UP = action_map.get(\"UP\", 1)\n  LEFT = action_map.get(\"LEFT\", 2)\n  RIGHT = action_map.get(\"RIGHT\", 3)\n  USE = action_map.get(\"USE\", 4)\n\n  actions = []\n\n  # Helper functions\n  def manhattan(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def nearest_target(targets, src):\n      if not targets:\n          return None\n      return min(targets, key=lambda t: manhattan(t, src))\n\n  def move_to(target):\n      nonlocal pos\n      # Move in x direction\n      while pos[0] < target[0]:\n          actions.append(DOWN)\n          pos = (pos[0] + 1, pos[1])\n      while pos[0] > target[0]:\n          actions.append(UP)\n          pos = (pos[0] - 1, pos[1])\n      # Move in y direction\n      while pos[1] < target[1]:\n          actions.append(RIGHT)\n          pos = (pos[0], pos[1] + 1)\n      while pos[1] > target[1]:\n          actions.append(LEFT)\n          pos = (pos[0], pos[1] - 1)\n\n  # Determine primitives needed for the goal\n  primitives_needed = cookbook.primitives_for(goal_idx)\n  if not primitives_needed:\n      # Goal itself might be a primitive that must be collected\n      primitives_needed = {goal_idx: 1}\n\n  # Collect each required primitive\n  for prim_idx, needed in primitives_needed.items():\n      # Find all cells that currently contain this primitive\n      locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n      if not locations:\n          return []  # required primitive not present in the world\n      collected = 0\n      while collected < needed:\n          target = nearest_target(locations, pos)\n          if target is None:\n              return []  # no reachable instance left\n          move_to(target)\n          actions.append(USE)  # pick up / collect the primitive\n          collected += 1\n          # Assume the primitive disappears after collection\n          if target in locations:\n              locations.remove(target)\n\n  # Locate the workshop (if any) required for crafting the goal\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n  if workshop_kind is not None:\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n      if not workshop_cells:\n          return []  # workshop not present\n      target_ws = nearest_target(workshop_cells, pos)\n      if target_ws is None:\n          return []\n      move_to(target_ws)\n\n  # Perform the final crafting action\n  actions.append(USE)\n\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T16:38:19.964020", "function_name": "make_stick", "function_body": "  # -------------------------------------------------------------------------\n  # Basic helpers\n  # -------------------------------------------------------------------------\n  # Action mapping\n  action_map = env.action_specs()\n  DOWN = action_map.get(\"DOWN\", 0)\n  UP = action_map.get(\"UP\", 1)\n  LEFT = action_map.get(\"LEFT\", 2)\n  RIGHT = action_map.get(\"RIGHT\", 3)\n  USE = action_map.get(\"USE\", 4)\n\n  # Directions for movement (dx, dy, action)\n  DIRS = [\n      (1, 0, DOWN),   # down\n      (-1, 0, UP),    # up\n      (0, -1, LEFT),  # left\n      (0, 1, RIGHT),  # right\n  ]\n\n  # -------------------------------------------------------------------------\n  # Extract environment objects\n  # -------------------------------------------------------------------------\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      return []\n\n  world = getattr(env, \"world\", None)\n  if world is None:\n      return []\n  cookbook = getattr(world, \"cookbook\", None)\n  if cookbook is None:\n      return []\n\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      return []\n  grid = getattr(state, \"grid\", None)\n  pos = getattr(state, \"pos\", None)\n  if grid is None or pos is None:\n      return []\n\n  # -------------------------------------------------------------------------\n  # Utility functions\n  # -------------------------------------------------------------------------\n  H, W = grid.shape[0], grid.shape[1]\n\n  def in_bounds(p):\n      return 0 <= p[0] < H and 0 <= p[1] < W\n\n  # Cells containing any non\u2011grabbable entity are not walkable\n  non_grabbable = set(world.non_grabbable_indices)\n\n  def walkable(p):\n      if not in_bounds(p):\n          return False\n      for idx in non_grabbable:\n          if grid[p[0], p[1], idx] > 0:\n              return False\n      return True\n\n  # Simple BFS returning a list of actions from start to any target cell\n  from collections import deque\n\n  def bfs_path(start, targets):\n      \"\"\"Return list of actions to reach the nearest target cell.\"\"\"\n      target_set = set(targets)\n      if start in target_set:\n          return []\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          cur, path = q.popleft()\n          for dx, dy, act in DIRS:\n              nxt = (cur[0] + dx, cur[1] + dy)\n              if not in_bounds(nxt) or not walkable(nxt):\n                  continue\n              if nxt in visited:\n                  continue\n              new_path = path + [act]\n              if nxt in target_set:\n                  return new_path\n              visited.add(nxt)\n              q.append((nxt, new_path))\n      return None  # unreachable\n\n  # -------------------------------------------------------------------------\n  # Determine required primitives for the goal\n  # -------------------------------------------------------------------------\n  primitives_needed = cookbook.primitives_for(goal_idx)\n  if not primitives_needed:\n      # Goal itself is a primitive that must be collected\n      primitives_needed = {goal_idx: 1}\n\n  actions = []\n  cur_pos = pos\n\n  # -------------------------------------------------------------------------\n  # Collect primitives\n  # -------------------------------------------------------------------------\n  for prim_idx, need_cnt in primitives_needed.items():\n      # Locate all cells that currently contain this primitive\n      locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n      if not locations:\n          return []  # cannot satisfy task\n\n      collected = 0\n      while collected < need_cnt:\n          # Choose the nearest location (Manhattan) as heuristic\n          nearest = min(locations, key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))\n          # Move to that cell (or an adjacent walkable cell)\n          path = bfs_path(cur_pos, [nearest])\n          if path is None:\n              return []  # unreachable\n          actions.extend(path)\n          cur_pos = nearest\n          # Use / pick up the primitive\n          actions.append(USE)\n          collected += 1\n          # Assume the primitive is now removed; we keep the location list unchanged\n          # because we do not simulate the grid \u2013 the next iteration will simply\n          # target another occurrence if needed.\n\n  # -------------------------------------------------------------------------\n  # Move to workshop (if required) and craft\n  # -------------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n\n  if workshop_kind is not None:\n      # Locate workshop cells\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n      if not workshop_cells:\n          return []\n      target_ws = min(workshop_cells, key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))\n      path = bfs_path(cur_pos, [target_ws])\n      if path is None:\n          return []\n      actions.extend(path)\n      cur_pos = target_ws\n      # Craft at the workshop\n      actions.append(USE)\n  else:\n      # No specific workshop \u2013 simply use at current location\n      actions.append(USE)\n\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T16:38:37.822224", "function_name": "make_stick", "function_body": "  env.reset()\n  state = env._current_state            # CraftState\n  world = env.world                      # CraftWorld\n  cookbook = world.cookbook\n\n  # Identify goal index for \"stick\"\n  try:\n      goal_idx = cookbook.index[\"stick\"]\n  except Exception:\n      return []  # stick not defined\n\n  # Primitive requirements for one stick\n  prim_req = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n\n  # Action mapping\n  act_map = env.action_specs()\n  DOWN = act_map.get('DOWN', 0)\n  UP = act_map.get('UP', 1)\n  LEFT = act_map.get('LEFT', 2)\n  RIGHT = act_map.get('RIGHT', 3)\n  USE = act_map.get('USE', 4)\n\n  def moves_to(start, target):\n      \"\"\"Return list of actions moving from start (x,y) to target (x,y).\"\"\"\n      cx, cy = start\n      tx, ty = target\n      actions = []\n      while cx < tx:\n          actions.append(DOWN); cx += 1\n      while cx > tx:\n          actions.append(UP); cx -= 1\n      while cy < ty:\n          actions.append(RIGHT); cy += 1\n      while cy > ty:\n          actions.append(LEFT); cy -= 1\n      return actions\n\n  grid = state.grid\n  # Locate primitives on the grid\n  prim_locs = {}\n  for p_idx in prim_req:\n      locs = np.argwhere(grid[:, :, p_idx] > 0)\n      prim_locs[p_idx] = [tuple(pos) for pos in locs]\n\n  # Locate any workshop (needed for crafting)\n  workshop_pos = None\n  for wk_idx in world.workshop_indices:\n      cells = np.argwhere(grid[:, :, wk_idx] > 0)\n      if cells.size:\n          workshop_pos = tuple(cells[0])\n          break\n\n  cur_pos = state.pos\n  plan = []\n\n  # Collect required primitives\n  for p_idx, needed in prim_req.items():\n      collected = 0\n      available = prim_locs.get(p_idx, []).copy()\n      while collected < needed and available:\n          # choose nearest primitive\n          dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in available]\n          nearest = int(np.argmin(dists))\n          target = available.pop(nearest)\n\n          plan.extend(moves_to(cur_pos, target))\n          cur_pos = target\n          plan.append(USE)          # pick up\n          collected += 1\n\n  # Move to workshop and craft\n  if workshop_pos is not None:\n      plan.extend(moves_to(cur_pos, workshop_pos))\n      cur_pos = workshop_pos\n  plan.append(USE)  # trigger crafting at workshop\n\n  return plan", "env_interactions": 4, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T16:38:38.940899", "function_name": "make_stick", "function_body": "  # Reset environment to a fresh state and fetch useful objects\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  cookbook = world.cookbook\n\n  # ------------------------------------------------------------------\n  # Identify the goal index for a \"stick\"\n  # ------------------------------------------------------------------\n  try:\n      goal_idx = cookbook.index[\"stick\"]\n  except Exception:\n      # Stick not defined in this world \u2013 nothing to do\n      return []\n\n  # Primitive requirements for one stick (recursive expansion)\n  prim_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n  if not prim_needed:\n      # No recipe \u2013 cannot craft\n      return []\n\n  # ------------------------------------------------------------------\n  # Action mapping (integer codes for each primitive action)\n  # ------------------------------------------------------------------\n  act_map = env.action_specs()\n  DOWN = act_map.get(\"DOWN\", 0)\n  UP = act_map.get(\"UP\", 1)\n  LEFT = act_map.get(\"LEFT\", 2)\n  RIGHT = act_map.get(\"RIGHT\", 3)\n  USE = act_map.get(\"USE\", 4)\n\n  # Helper: generate a Manhattan move sequence from start \u2192 target\n  def _moves(start, target):\n      cx, cy = start\n      tx, ty = target\n      moves = []\n      while cx < tx:\n          moves.append(DOWN)\n          cx += 1\n      while cx > tx:\n          moves.append(UP)\n          cx -= 1\n      while cy < ty:\n          moves.append(RIGHT)\n          cy += 1\n      while cy > ty:\n          moves.append(LEFT)\n          cy -= 1\n      return moves\n\n  # ------------------------------------------------------------------\n  # Locate all primitives on the current grid\n  # ------------------------------------------------------------------\n  grid = state.grid\n  prim_locations = {}\n  for p_idx in prim_needed:\n      locs = np.argwhere(grid[:, :, p_idx] > 0)\n      prim_locations[p_idx] = [tuple(pos) for pos in locs]\n\n  # ------------------------------------------------------------------\n  # Determine which workshop is needed for the stick recipe\n  # ------------------------------------------------------------------\n  workshop_idx = None\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      try:\n          workshop_idx = cookbook.index[workshop_name]\n      except Exception:\n          workshop_idx = None\n\n  workshop_pos = None\n  if workshop_idx is not None:\n      cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if cells.size:\n          workshop_pos = tuple(cells[0])\n\n  # If we could not find a dedicated workshop, fall back to any workshop cell\n  if workshop_pos is None:\n      for wk_idx in world.workshop_indices:\n          cells = np.argwhere(grid[:, :, wk_idx] > 0)\n          if cells.size:\n              workshop_pos = tuple(cells[0])\n              break\n\n  # ------------------------------------------------------------------\n  # Build the action plan\n  # ------------------------------------------------------------------\n  cur_pos = state.pos\n  plan = []\n\n  # Collect each required primitive (may need multiple copies)\n  for p_idx, count in prim_needed.items():\n      collected = 0\n      available = prim_locations.get(p_idx, []).copy()\n      while collected < count and available:\n          # Choose the nearest available primitive\n          dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in available]\n          nearest_i = int(np.argmin(dists))\n          target = available.pop(nearest_i)\n\n          # Move to the primitive and pick it up\n          plan.extend(_moves(cur_pos, target))\n          cur_pos = target\n          plan.append(USE)          # pickup action\n          collected += 1\n\n      # If we ran out of primitives before satisfying the count,\n      # the plan will be incomplete \u2013 just break.\n      if collected < count:\n          break\n\n  # After collecting, go to the workshop (if known) and craft\n  if workshop_pos is not None:\n      plan.extend(_moves(cur_pos, workshop_pos))\n      cur_pos = workshop_pos\n  plan.append(USE)   # trigger crafting at the workshop (or current cell)\n\n  return plan", "env_interactions": 4, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T16:38:58.531889", "function_name": "make_stick", "function_body": "  try:\n      # Reset environment to a fresh start.\n      env.reset()\n      # Try to obtain the current CraftState.\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          # Some wrappers expose the scenario directly.\n          scenario = getattr(env, \"scenario\", None)\n          if scenario is not None:\n              state = scenario.init()\n      if state is None:\n          return []\n\n      world = state.world\n      grid = state.grid\n      height, width, _ = grid.shape\n\n      # ------------------------------------------------------------------\n      # Helper utilities.\n      # ------------------------------------------------------------------\n      def find_cells(kind):\n          \"\"\"Return list of (x, y) positions where `kind` is present.\"\"\"\n          pts = np.argwhere(grid[:, :, kind] > 0)\n          return [tuple(p) for p in pts]\n\n      # Directions: (dx, dy, action_index) \u2013 order matches CraftWorld actions.\n      dirs = [\n          (1, 0, 0),   # DOWN\n          (-1, 0, 1),  # UP\n          (0, -1, 2),  # LEFT\n          (0, 1, 3),   # RIGHT\n      ]\n\n      def is_blocked(x, y):\n          \"\"\"True if cell (x, y) contains any non\u2011grabbable entity.\"\"\"\n          for idx in world.non_grabbable_indices:\n              if grid[x, y, idx] > 0:\n                  return True\n          return False\n\n      def bfs(start, goal):\n          \"\"\"Bread\u2011first search returning a list of actions from start to goal.\"\"\"\n          from collections import deque\n          q = deque()\n          q.append((start, []))\n          visited = {start}\n          while q:\n              (cx, cy), path = q.popleft()\n              if (cx, cy) == goal:\n                  return path\n              for dx, dy, act in dirs:\n                  nx, ny = cx + dx, cy + dy\n                  if 0 <= nx < height and 0 <= ny < width and not is_blocked(nx, ny):\n                      if (nx, ny) not in visited:\n                          visited.add((nx, ny))\n                          q.append(((nx, ny), path + [act]))\n          return []  # No path found (should not happen in valid maps)\n\n      actions = []\n      cur_pos = state.pos\n\n      # ------------------------------------------------------------------\n      # Determine what is needed to craft a stick.\n      # ------------------------------------------------------------------\n      stick_idx = world.cookbook.index.index(\"stick\")\n      # Primitive requirements for one stick (empty if stick is primitive).\n      prim_requirements = world.cookbook.primitives_for(stick_idx)\n\n      # ------------------------------------------------------------------\n      # Collect each required primitive.\n      # ------------------------------------------------------------------\n      for prim_idx, needed in prim_requirements.items():\n          for _ in range(needed):\n              cells = find_cells(prim_idx)\n              if not cells:\n                  continue  # primitive not present on the map\n              # Choose nearest occurrence.\n              distances = [\n                  abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in cells\n              ]\n              target = cells[int(np.argmin(distances))]\n              # Move to the primitive.\n              actions.extend(bfs(cur_pos, target))\n              # Pick it up.\n              actions.append(4)  # USE\n              cur_pos = target\n              # After picking up the primitive it disappears from the grid.\n              grid[target[0], target[1], prim_idx] = 0\n\n      # ------------------------------------------------------------------\n      # If the stick requires a workshop, move there and craft.\n      # ------------------------------------------------------------------\n      recipe = world.cookbook.recipes.get(stick_idx, {})\n      workshop_kind = recipe.get(\"_at\")\n      if workshop_kind is not None:\n          # Locate a workshop cell of the required type.\n          workshop_cells = find_cells(workshop_kind)\n          if workshop_cells:\n              distances = [\n                  abs(cur_pos[0] - x) + abs(cur_pos[1] - y)\n                  for (x, y) in workshop_cells\n              ]\n              target_ws = workshop_cells[int(np.argmin(distances))]\n              actions.extend(bfs(cur_pos, target_ws))\n              actions.append(4)  # USE to craft the stick\n\n      return actions\n  except Exception:\n      # Any unexpected situation \u2013 return an empty plan.\n      return []", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T16:38:59.657333", "function_name": "make_stick", "function_body": "  actions = []\n  try:\n      # Initialise the environment.\n      env.reset()\n      # Try to obtain the current CraftState.\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          # Some wrappers expose the scenario directly.\n          scenario = getattr(env, \"scenario\", None)\n          if scenario is not None:\n              state = scenario.init()\n      if state is None:\n          return actions\n\n      world = state.world\n      grid = state.grid\n      height, width, _ = grid.shape\n\n      # ------------------------------------------------------------------\n      # Helper utilities.\n      # ------------------------------------------------------------------\n      # Directions and corresponding action indices (DOWN,UP,LEFT,RIGHT).\n      dirs = [(1, 0, 0), (-1, 0, 1), (0, -1, 2), (0, 1, 3)]\n\n      def is_blocked(x, y):\n          \"\"\"Return True if cell (x,y) contains a non\u2011grabbable entity.\"\"\"\n          for idx in world.non_grabbable_indices:\n              if grid[x, y, idx] > 0:\n                  return True\n          return False\n\n      def bfs(start, goal):\n          \"\"\"Bread\u2011first search returning a list of actions from start\u2192goal.\"\"\"\n          from collections import deque\n\n          q = deque()\n          q.append((start, []))\n          visited = {start}\n          while q:\n              (cx, cy), path = q.popleft()\n              if (cx, cy) == goal:\n                  return path\n              for dx, dy, act in dirs:\n                  nx, ny = cx + dx, cy + dy\n                  if 0 <= nx < height and 0 <= ny < width and not is_blocked(nx, ny):\n                      if (nx, ny) not in visited:\n                          visited.add((nx, ny))\n                          q.append(((nx, ny), path + [act]))\n          return []  # should not happen in a valid map\n\n      def find_cells(kind):\n          \"\"\"Return list of (x,y) where `kind` is present in the grid.\"\"\"\n          positions = np.argwhere(grid[:, :, kind] > 0)\n          return [tuple(p) for p in positions]\n\n      # ------------------------------------------------------------------\n      # Determine what is needed to make a stick.\n      # ------------------------------------------------------------------\n      stick_idx = world.cookbook.index.index(\"stick\")\n      # Primitive requirements (may be empty if stick is primitive).\n      primitive_reqs = world.cookbook.primitives_for(stick_idx)\n\n      # Recipe for stick (may be None if stick is primitive).\n      stick_recipe = world.cookbook.recipes.get(stick_idx, {})\n      workshop_idx = stick_recipe.get(\"_at\", None)\n\n      cur_pos = state.pos\n\n      # ------------------------------------------------------------------\n      # Collect all required primitives.\n      # ------------------------------------------------------------------\n      for prim_idx, needed in primitive_reqs.items():\n          for _ in range(needed):\n              # Locate nearest cell containing the primitive.\n              cells = find_cells(prim_idx)\n              if not cells:\n                  continue  # primitive not on map; skip\n              # Choose the cell with minimal Manhattan distance.\n              dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in cells]\n              target = cells[int(np.argmin(dists))]\n              # Move to the target.\n              actions.extend(bfs(cur_pos, target))\n              # Pick it up.\n              actions.append(4)  # USE\n              cur_pos = target\n\n      # ------------------------------------------------------------------\n      # If a workshop is required, go there and craft.\n      # ------------------------------------------------------------------\n      if workshop_idx is not None:\n          workshop_cells = find_cells(workshop_idx)\n          if workshop_cells:\n              dists = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in workshop_cells]\n              target_ws = workshop_cells[int(np.argmin(dists))]\n              actions.extend(bfs(cur_pos, target_ws))\n              actions.append(4)  # USE to craft the stick\n      else:\n          # Stick is primitive; if we have already collected it, nothing else to do.\n          pass\n\n      return actions\n  except Exception:\n      # On any unexpected situation return an empty plan.\n      return []", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-21T16:39:19.900909", "function_name": "make_stick", "function_body": "  import copy\n  from collections import deque\n\n  # Get action mapping from the environment\n  try:\n      action_map = env.action_specs()\n      action_ids = list(action_map.values())\n  except Exception:\n      # fallback to common action IDs if the env does not expose specs\n      action_ids = [0, 1, 2, 3, 4]  # DOWN,UP,LEFT,RIGHT,USE (standard order)\n\n  # Determine the index of the goal item \"stick\"\n  try:\n      goal_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      # If the name is not directly accessible, try lower\u2011case lookup\n      goal_idx = env.world.cookbook.index.get(\"stick\", None)\n\n  # Helper to test if a state already satisfies the goal\n  def is_goal(state):\n      if goal_idx is None:\n          return False\n      return state.satisfies(\"\", goal_idx)\n\n  # Starting state (do not mutate the environment's current state)\n  start_state = env._current_state  # type: ignore[attr-defined]\n\n  # Breadth\u2011first search over the deterministic transition graph\n  frontier = deque()\n  frontier.append((start_state, []))\n  visited = set()\n\n  # Encode a state for the visited set (position, direction, inventory snapshot)\n  def state_key(st):\n      pos = st.pos\n      direction = st.dir\n      inv_bytes = st.inventory.tobytes()\n      return (pos, direction, inv_bytes)\n\n  visited.add(state_key(start_state))\n\n  max_steps = 200  # safety limit to avoid infinite search\n\n  while frontier:\n      cur_state, cur_actions = frontier.popleft()\n      if is_goal(cur_state):\n          return cur_actions\n\n      if len(cur_actions) >= max_steps:\n          continue\n\n      for a in action_ids:\n          # Simulate the action on a copy of the current state\n          _, next_state = cur_state.step(a)\n\n          key = state_key(next_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((next_state, cur_actions + [a]))\n\n  # If no plan found within the limits, return an empty list\n  return []", "env_interactions": 4, "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T16:39:21.178556", "function_name": "make_stick", "function_body": "  # Get the mapping from action names to integer ids.\n  action_map = env.action_specs()\n  # Basic movement and use actions.\n  MOVE_ACTIONS = [\n      action_map.get(\"UP\"),\n      action_map.get(\"DOWN\"),\n      action_map.get(\"LEFT\"),\n      action_map.get(\"RIGHT\"),\n  ]\n  USE_ACTION = action_map.get(\"USE\")\n\n  # Identify the integer index that corresponds to the desired goal item\n  # (\u201cstick\u201d) inside the world\u2019s cookbook.\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:  # fallback if the index mapping is accessed differently\n      stick_idx = env.world.cookbook.index.index(\"stick\")\n\n  # Store the sequence of actions that will be returned.\n  plan = []\n\n  # Safety limit \u2013 we never want an infinite loop.\n  MAX_STEPS = 2000\n\n  for _ in range(MAX_STEPS):\n      # Pull the latest observation and extract the inventory.\n      obs = env.observations()\n      inventory = obs[\"features_dict\"][\"inventory\"]\n\n      # If we already have a stick, we are done.\n      if inventory[stick_idx] > 0:\n          break\n\n      # Try to collect / craft by using the USE action.\n      # With probability 0.3 we just use the current cell,\n      # otherwise we move in a random direction.\n      if np.random.rand() < 0.3:\n          chosen_action = USE_ACTION\n      else:\n          chosen_action = np.random.choice(MOVE_ACTIONS)\n\n      # Execute the action in the environment and record it.\n      env.step(chosen_action)\n      plan.append(int(chosen_action))\n\n  # Return the collected list of action indices.\n  return plan", "env_interactions": 0, "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-10-21T16:40:07.444089", "function_name": "make_stick", "function_body": "  # Helper BFS to compute movement actions from start to goal avoiding blocked cells.\n  def _bfs_path(start, goal, blocked):\n      W, H = blocked.shape\n      from collections import deque\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      # movement deltas corresponding to action indices: 0 DOWN, 1 UP, 2 LEFT, 3 RIGHT\n      deltas = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for act, (dx, dy) in enumerate(deltas):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not blocked[nx, ny] and (nx, ny) not in visited:\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [act]))\n      return None\n\n  actions = []\n  state = env._current_state\n\n  # Identify the index for the goal item \u201cstick\u201d.\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      # If \u201cstick\u201d is not in the index, just return empty action list.\n      return actions\n\n  # Determine required primitive resources (recursively) for a stick.\n  primitives_needed = env.world.cookbook.primitives_for(stick_idx)\n\n  # Gather each required primitive.\n  for prim_idx, count in primitives_needed.items():\n      for _ in range(count):\n          # Locate a remaining instance of this primitive on the grid.\n          grid = state.grid\n          locations = np.argwhere(grid[:, :, prim_idx] > 0)\n          if locations.size == 0:\n              # No more primitives of this type; abort collection.\n              break\n          tx, ty = locations[0]  # pick the first available instance\n\n          # Compute a path to the primitive cell (allow stepping onto the target).\n          blocked = np.any(grid > 0, axis=2)\n          blocked[tx, ty] = False\n          path = _bfs_path(state.pos, (tx, ty), blocked)\n          if path is None:\n              # Unable to reach; skip this primitive.\n              continue\n\n          # Execute movement actions.\n          for act in path:\n              reward, done, obs = env.step(act)\n              actions.append(act)\n              state = env._current_state\n\n          # Use the primitive (pick up / harvest).\n          reward, done, obs = env.step(4)  # USE action\n          actions.append(4)\n          state = env._current_state\n\n  # After collecting primitives, craft the stick at its designated workshop (if any).\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  workshop_idx = recipe.get(\"_at\")\n  if workshop_idx is not None:\n      grid = state.grid\n      locations = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if locations.size > 0:\n          tx, ty = locations[0]\n          blocked = np.any(grid > 0, axis=2)\n          blocked[tx, ty] = False\n          path = _bfs_path(state.pos, (tx, ty), blocked)\n          if path:\n              for act in path:\n                  reward, done, obs = env.step(act)\n                  actions.append(act)\n                  state = env._current_state\n          # Perform the crafting action.\n          reward, done, obs = env.step(4)  # USE at workshop\n          actions.append(4)\n          state = env._current_state\n\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": -1}}
