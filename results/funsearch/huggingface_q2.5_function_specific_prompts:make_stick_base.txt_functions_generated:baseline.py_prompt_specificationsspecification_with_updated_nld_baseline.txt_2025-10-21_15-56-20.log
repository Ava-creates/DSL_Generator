{"timestamp": "2025-10-21T21:23:02.817712", "function_name": "make_stick", "function_body": "  # ----------------------------------------------------------------------\n  # Determine the action indices supported by the environment.\n  # ----------------------------------------------------------------------\n  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      # Fallback to the default ordering used by CraftWorld.\n      action_ids = [0, 1, 2, 3, 4]  # DOWN, UP, LEFT, RIGHT, USE\n\n  # ----------------------------------------------------------------------\n  # Locate the integer index that corresponds to the goal item \"stick\".\n  # ----------------------------------------------------------------------\n  goal_idx = None\n  try:\n      goal_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      try:\n          goal_idx = env.world.cookbook.index.get(\"stick\")\n      except Exception:\n          pass\n  if goal_idx is None:\n      # Cannot find the goal in the cookbook \u2013 return an empty plan.\n      return []\n\n  # ----------------------------------------------------------------------\n  # Obtain the current CraftState from the environment.\n  # ----------------------------------------------------------------------\n  start_state = getattr(env, \"_current_state\", None)\n  if start_state is None:\n      start_state = getattr(env, \"current_state\", None)\n  if start_state is None:\n      # No accessible state \u2013 give up.\n      return []\n\n  # ----------------------------------------------------------------------\n  # Bread\u2011first search over deterministic state transitions.\n  # ----------------------------------------------------------------------\n  from collections import deque\n\n  def _state_key(st):\n      \"\"\"\n      Produce a hashable representation of a CraftState.\n      Uses position, direction and a bytes view of the inventory.\n      \"\"\"\n      return (st.pos, st.dir, st.inventory.tobytes())\n\n  frontier = deque()\n  frontier.append((start_state, []))\n  visited = {_state_key(start_state)}\n  max_plan_len = 500  # safety cutoff to keep search tractable\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      # Goal test: we have at least one stick in inventory.\n      if cur_state.satisfies(\"\", goal_idx):\n          return cur_plan\n\n      # Prune overly long plans.\n      if len(cur_plan) >= max_plan_len:\n          continue\n\n      # Expand all possible primitive actions.\n      for a in action_ids:\n          _, nxt_state = cur_state.step(a)\n          key = _state_key(nxt_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((nxt_state, cur_plan + [a]))\n\n  # No plan found within the search limits.\n  return []", "env_interactions": 4, "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-10-21T21:23:04.116525", "function_name": "make_stick", "function_body": "  # ----- obtain action ids -------------------------------------------------\n  try:\n      action_ids = list(env.action_specs().values())\n  except Exception:\n      # Default order: DOWN, UP, LEFT, RIGHT, USE\n      action_ids = [0, 1, 2, 3, 4]\n\n  # ----- locate the index of the target item \"stick\" -----------------------\n  try:\n      goal_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      # Fallback in case of different attribute names\n      world = getattr(env, \"world\", None)\n      goal_idx = None\n      if world is not None:\n          goal_idx = world.cookbook.index.get(\"stick\")\n  if goal_idx is None:\n      return []  # cannot determine stick index\n\n  # ----- obtain the current CraftState ------------------------------------\n  try:\n      start_state = env._current_state\n  except AttributeError:\n      start_state = getattr(env, \"current_state\", None)\n      if start_state is None:\n          return []  # cannot access the underlying state\n\n  # ----- helper to hash a state for visited set ---------------------------\n  def _state_key(st):\n      \"\"\"Compact hashable representation of a CraftState.\"\"\"\n      return (st.pos, st.dir, st.inventory.tobytes())\n\n  # ----- breadth\u2011first search planner --------------------------------------\n  from collections import deque\n\n  frontier = deque()\n  frontier.append((start_state, []))\n  visited = {_state_key(start_state)}\n  max_plan_len = 300  # safety ceiling to avoid infinite search\n\n  while frontier:\n      cur_state, cur_plan = frontier.popleft()\n\n      # Goal test: inventory contains at least one stick\n      if cur_state.satisfies(\"\", goal_idx):\n          return cur_plan\n\n      if len(cur_plan) >= max_plan_len:\n          continue\n\n      # Expand all possible actions\n      for a in action_ids:\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          frontier.append((next_state, cur_plan + [a]))\n\n  # No plan found within limits\n  return []", "env_interactions": 4, "island_id": 6, "scores": {"3": 1.5}}
