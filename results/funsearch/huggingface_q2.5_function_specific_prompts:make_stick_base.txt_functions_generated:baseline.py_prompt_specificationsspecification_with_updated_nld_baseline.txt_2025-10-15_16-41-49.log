{"timestamp": "2025-10-15T20:05:40.950425", "function_name": "make_stick", "function_body": "  \"\"\"\n  Generate a sequence of actions that (in principle) collects the\n  primitives required to craft a ``stick`` and then performs the craft\n  at the appropriate workshop.\n\n  The implementation is deliberately simple: it assumes a clear\n  Manhattan\u2011grid path to the needed items and does not account for\n  obstacles.  It is sufficient for environments where the required\n  resources are reachable without complex navigation.\n\n  Parameters\n  ----------\n  env : object\n      A CraftWorld (or CraftLab) environment instance.  The object must\n      expose ``world.cookbook`` and, after a call to ``reset()``, a\n      ``_current_state`` attribute of type :class:`CraftState`.\n\n  Returns\n  -------\n  list[int]\n      List of action IDs (DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4) that,\n      when executed sequentially, should result in a ``stick`` being\n      present in the agent's inventory.\n  \"\"\"\n  import numpy as np\n\n  # ------------------------------------------------------------------\n  # Helper: move the agent from its current position to a target cell.\n  # ------------------------------------------------------------------\n  def _append_moves(cur, target, act_list):\n      \"\"\"Append moves to ``act_list`` that walk from ``cur`` to ``target``.\"\"\"\n      x, y = cur\n      tx, ty = target\n      # RIGHT (3) / LEFT (2)\n      while x < tx:\n          act_list.append(3)   # RIGHT\n          x += 1\n      while x > tx:\n          act_list.append(2)   # LEFT\n          x -= 1\n      # DOWN (0) / UP (1)\n      while y < ty:\n          act_list.append(0)   # DOWN\n          y += 1\n      while y > ty:\n          act_list.append(1)   # UP\n          y -= 1\n      return (x, y)\n\n  # ------------------------------------------------------------------\n  # Initialise environment and obtain the current state.\n  # ------------------------------------------------------------------\n  try:\n      env.reset()\n  except Exception:\n      # Some wrappers may not require an explicit reset.\n      pass\n\n  # ``CraftLab`` stores the underlying state in a private attribute.\n  try:\n      state = env._current_state\n  except AttributeError:\n      # If the object itself is already a ``CraftState``.\n      state = env\n\n  # ------------------------------------------------------------------\n  # Identify the index of the target item (``stick``) and its recipe.\n  # ------------------------------------------------------------------\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      # ``stick`` not defined in this world \u2013 nothing to plan.\n      return []\n\n  # Primitive requirements for a single ``stick``.\n  primitive_needs = env.world.cookbook.primitives_for(stick_idx)\n\n  # The workshop (if any) where the stick must be crafted.\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  workshop_idx = None\n  if \"_at\" in recipe:\n      workshop_name = recipe[\"_at\"]\n      workshop_idx = env.world.cookbook.index.get(workshop_name, None)\n\n  actions = []\n  cur_pos = tuple(state.pos)   # current (x, y) location of the agent\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the necessary number of times.\n  # ------------------------------------------------------------------\n  for prim_idx, needed_qty in primitive_needs.items():\n      for _ in range(needed_qty):\n          # Locate all cells that currently contain this primitive.\n          locations = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if locations.size == 0:\n              # Primitive not present \u2013 cannot continue planning.\n              continue\n          # Choose the closest occurrence (Manhattan distance).\n          dists = np.sum(np.abs(locations - np.array(cur_pos)), axis=1)\n          target_cell = tuple(locations[np.argmin(dists)])\n\n          # Move to the cell and pick up the primitive.\n          cur_pos = _append_moves(cur_pos, target_cell, actions)\n          actions.append(4)   # USE to collect\n\n  # ------------------------------------------------------------------\n  # If a workshop is required, move to it and perform the craft.\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      locations = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if locations.size > 0:\n          dists = np.sum(np.abs(locations - np.array(cur_pos)), axis=1)\n          target_cell = tuple(locations[np.argmin(dists)])\n          cur_pos = _append_moves(cur_pos, target_cell, actions)\n          actions.append(4)   # USE to craft\n\n  return actions", "env_interactions": 0, "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-10-15T20:06:07.537651", "function_name": "make_stick", "function_body": "  \"\"\"Return an empty action list after verifying stick exists.\"\"\"\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      return []\n  _ = env.world.cookbook.primitives_for(stick_idx)\n  return []", "env_interactions": 0, "island_id": 6, "scores": {"3": 0.0}}
