{"timestamp": "2025-10-15T19:52:26.870247", "function_name": "make_stick", "function_body": "  \"\"\"\n  Generate a list of actions that makes a ``stick`` in a CraftWorld environment.\n\n  The function works for a generic ``CraftLab`` instance (the DMLab\u2011style\n  wrapper used in the repository).  It follows a very simple planner:\n\n  1.  Query the world for the recipe of ``stick`` and obtain the required\n      primitive items.\n  2.  For each required primitive, move the agent to the nearest cell that\n      contains the primitive and execute a ``USE`` action to pick it up.\n  3.  Move to the workshop required by the recipe (if any) and ``USE`` again\n      to craft the stick.\n\n  The planner ignores obstacles (it assumes a clear path) and therefore\n  works for the standard test scenarios that come with the repository.\n  \"\"\"\n  import numpy as np\n\n  # ------------------------------------------------------------------ #\n  # Helper utilities\n  # ------------------------------------------------------------------ #\n  def manhattan_move_actions(start, goal):\n      \"\"\"Return a list of actions (0\u20114) that moves from *start* to *goal*.\n\n      Action mapping (as defined in the environment):\n          0: DOWN  (increase x)\n          1: UP    (decrease x)\n          2: LEFT  (decrease y)\n          3: RIGHT (increase y)\n      \"\"\"\n      actions = []\n      sx, sy = start\n      gx, gy = goal\n\n      # vertical moves\n      while sx < gx:\n          actions.append(0)   # DOWN\n          sx += 1\n      while sx > gx:\n          actions.append(1)   # UP\n          sx -= 1\n\n      # horizontal moves\n      while sy < gy:\n          actions.append(3)   # RIGHT\n          sy += 1\n      while sy > gy:\n          actions.append(2)   # LEFT\n          sy -= 1\n\n      return actions\n\n  def nearest_position(pos, mask):\n      \"\"\"Find the nearest ``True`` cell in *mask* to *pos* (Manhattan distance).\"\"\"\n      coords = np.argwhere(mask)\n      if coords.size == 0:\n          raise RuntimeError(\"Required item not found in the grid.\")\n      dists = np.abs(coords[:, 0] - pos[0]) + np.abs(coords[:, 1] - pos[1])\n      nearest_idx = np.argmin(dists)\n      return tuple(coords[nearest_idx])\n\n  # ------------------------------------------------------------------ #\n  # Begin planning\n  # ------------------------------------------------------------------ #\n  # Reset the environment to obtain the initial state.\n  # ``env`` is expected to be a ``CraftLab`` instance.\n  env.reset()\n  state = env._current_state          # type: CraftState\n  world = env.world                    # type: CraftWorld\n\n  # ------------------------------------------------------------------ #\n  # 1.  Determine the recipe for ``stick``.\n  # ------------------------------------------------------------------ #\n  stick_name = \"stick\"\n  stick_idx = world.cookbook.index[stick_name]\n\n  # ``primitives_for`` returns a dict {primitive_idx: count}\n  needed_primitives = world.cookbook.primitives_for(stick_idx)\n\n  actions_plan = []\n  cur_pos = tuple(state.pos)  # keep a local copy that we update as we \"move\"\n\n  # ------------------------------------------------------------------ #\n  # 2.  Collect each primitive the required number of times.\n  # ------------------------------------------------------------------ #\n  for prim_idx, count in needed_primitives.items():\n      for _ in range(count):\n          # locate the nearest cell that currently holds the primitive\n          prim_mask = state.grid[..., prim_idx] > 0\n          target_pos = nearest_position(cur_pos, prim_mask)\n\n          # move to that cell\n          actions_plan.extend(manhattan_move_actions(cur_pos, target_pos))\n          cur_pos = target_pos\n\n          # pick it up\n          actions_plan.append(4)   # USE\n\n          # update the simulated state (so subsequent searches see the item\n          # removed).  This is a lightweight update; we only clear the cell\n          # for the collected primitive.\n          state.grid[..., prim_idx][target_pos] = 0\n\n  # ------------------------------------------------------------------ #\n  # 3.  Go to the required workshop (if any) and craft the stick.\n  # ------------------------------------------------------------------ #\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n      workshop_mask = state.grid[..., workshop_idx] > 0\n      workshop_pos = nearest_position(cur_pos, workshop_mask)\n\n      actions_plan.extend(manhattan_move_actions(cur_pos, workshop_pos))\n      cur_pos = workshop_pos\n\n      # craft at the workshop\n      actions_plan.append(4)   # USE\n\n  return actions_plan", "env_interactions": 4, "island_id": 5, "scores": {"3": 0.0}}
