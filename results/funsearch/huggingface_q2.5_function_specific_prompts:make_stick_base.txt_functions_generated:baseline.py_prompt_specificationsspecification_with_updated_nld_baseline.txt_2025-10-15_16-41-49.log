{"timestamp": "2025-10-15T17:49:48.573844", "function_name": "make_stick", "function_body": "  \"\"\"\n  Generates a list of actions that will (in principle) collect the required\n  primitives for a ``stick`` and then craft it at the appropriate workshop.\n  The implementation works with the standard CraftWorld / CraftLab objects\n  used in the repository.\n\n  The returned list only contains integer action IDs:\n      0 \u2013 DOWN\n      1 \u2013 UP\n      2 \u2013 LEFT\n      3 \u2013 RIGHT\n      4 \u2013 USE\n  \"\"\"\n  import numpy as np\n\n  # ----------------------------------------------------------------------\n  # Helper functions\n  # ----------------------------------------------------------------------\n  # map a unit delta to the corresponding action id\n  _delta_to_action = {\n      ( 1,  0): 0,   # DOWN\n      (-1,  0): 1,   # UP\n      ( 0, -1): 2,   # LEFT\n      ( 0,  1): 3,   # RIGHT\n  }\n\n  def move_actions(cur, target):\n      \"\"\"Greedy Manhattan moves from cur -> target (both (x,y) tuples).\"\"\"\n      actions = []\n      cx, cy = cur\n      tx, ty = target\n      while cx != tx:\n          step = 1 if cx < tx else -1\n          act = _delta_to_action[(step, 0)]\n          actions.append(act)\n          cx += step\n      while cy != ty:\n          step = 1 if cy < ty else -1\n          act = _delta_to_action[(0, step)]\n          actions.append(act)\n          cy += step\n      return actions\n\n  def find_adjacent_empty(pos, grid):\n      \"\"\"Return an empty neighbour (x,y) of ``pos`` or None.\"\"\"\n      x, y = pos\n      h, w = grid.shape[0], grid.shape[1]\n      for dx, dy in [( -1, 0), (1, 0), (0, -1), (0, 1)]:\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < h and 0 <= ny < w:\n              if not grid[nx, ny].any():          # no entity in the cell\n                  return (nx, ny)\n      return None\n\n  # ----------------------------------------------------------------------\n  # 1. Identify the stick recipe\n  # ----------------------------------------------------------------------\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      # No stick defined \u2013 return empty plan.\n      return []\n\n  # primitives needed for one stick (dict {prim_idx: count})\n  prim_req = env.world.cookbook.primitives_for(stick_idx)\n\n  # ----------------------------------------------------------------------\n  # 2. Gather primitives\n  # ----------------------------------------------------------------------\n  actions = []\n  # we will keep track of the agent's simulated position\n  cur_pos = tuple(env._current_state.pos)\n\n  # copy of the grid so we can mark primitives as \u201ctaken\u201d (avoid re\u2011using)\n  grid = env._current_state.grid.copy()\n\n  for prim_idx, needed in prim_req.items():\n      # locate all cells that contain this primitive\n      prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n      if prim_cells.size == 0:\n          # primitive not present \u2013 we cannot complete the plan\n          return actions\n      # simple greedy: take the first ``needed`` cells (could be improved)\n      taken = 0\n      used_cells = set()\n      for cell in prim_cells:\n          if taken >= needed:\n              break\n          tx, ty = int(cell[0]), int(cell[1])\n          if (tx, ty) in used_cells:\n              continue\n          # find an empty neighbour to stand on\n          stand = find_adjacent_empty((tx, ty), grid)\n          if stand is None:\n              # cannot reach this primitive \u2013 skip it\n              continue\n          # move to the standing position\n          actions.extend(move_actions(cur_pos, stand))\n          cur_pos = stand\n          # set direction towards the primitive (by issuing a move in that\n          # direction \u2013 it will fail because the cell is occupied but will\n          # set the facing direction)\n          dx, dy = tx - cur_pos[0], ty - cur_pos[1]\n          dir_action = _delta_to_action.get((dx, dy))\n          if dir_action is None:\n              # something went wrong; skip this primitive\n              continue\n          actions.append(dir_action)   # face the primitive\n          actions.append(4)            # USE to pick it up\n          # mark the primitive as removed from the grid (so we don't pick it\n          # again later)\n          grid[tx, ty, prim_idx] = 0\n          taken += 1\n          used_cells.add((tx, ty))\n\n  # ----------------------------------------------------------------------\n  # 3. Go to the appropriate workshop and craft the stick\n  # ----------------------------------------------------------------------\n  # Determine which workshop the recipe requires.\n  workshop_name = None\n  try:\n      workshop_entry = env.world.cookbook.recipes[stick_idx].get(\"_at\")\n      if isinstance(workshop_entry, str):\n          workshop_name = workshop_entry\n      elif isinstance(workshop_entry, int):\n          # already an index\n          workshop_name = env.world.cookbook.index.get(workshop_entry)\n  except Exception:\n      pass\n\n  if workshop_name is None:\n      # No workshop information \u2013 cannot craft.\n      return actions\n\n  try:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n  except Exception:\n      return actions\n\n  # locate a workshop cell\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      return actions\n  wx, wy = map(int, workshop_cells[0])\n\n  # stand on an empty neighbour of the workshop\n  stand = find_adjacent_empty((wx, wy), grid)\n  if stand is None:\n      # fallback: try to stand on the workshop itself (some worlds allow it)\n      stand = (wx, wy)\n\n  actions.extend(move_actions(cur_pos, stand))\n  cur_pos = stand\n\n  # face the workshop and USE to craft\n  dx, dy = wx - cur_pos[0], wy - cur_pos[1]\n  dir_action = _delta_to_action.get((dx, dy))\n  if dir_action is not None:\n      actions.append(dir_action)\n      actions.append(4)   # USE -> craft the stick\n\n  return actions", "env_interactions": 7, "island_id": 6, "scores": {"3": 0.0}}
