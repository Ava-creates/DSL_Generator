{"timestamp": "2025-10-15T18:45:14.070931", "function_name": "make_stick", "function_body": "  \"\"\"Return a list of actions that makes a stick in the given CraftWorld env.\"\"\"\n  # try using the highest version if exists\n  try:\n      return make_stick_v2(env)\n  except NameError:\n      return make_stick_v1(env)", "env_interactions": 0, "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-10-15T18:45:15.242319", "function_name": "make_stick", "function_body": "  \"\"\"\n  Generate a deterministic sequence of actions that will obtain a ``stick`` in the\n  provided CraftWorld environment.\n\n  The implementation follows these steps:\n\n  1.  Reset the environment to obtain the initial state.\n  2.  Retrieve the index for the item ``stick`` and the primitive(s) required to\n      craft it from the ``Cookbook``.\n  3.  Locate one instance of each required primitive on the grid.\n  4.  Plan a shortest path (BFS) from the agent\u2019s current position to a free cell\n      adjacent to the primitive, move there, turn back towards the primitive and\n      execute the ``USE`` action to pick it up.\n  5.  After all required primitives have been collected, locate the workshop where\n      ``stick`` can be crafted, move adjacent to it, turn back towards the workshop\n      and ``USE`` again to craft the stick.\n  6.  Return the concatenated list of action indices.\n\n  The function only uses the public API of the environment (``reset`` and ``step``)\n  and the data stored in ``env._current_state`` after a reset.  It does **not**\n  modify the environment; it merely returns a list of actions that a caller can\n  feed back to the environment.\n\n  Parameters\n  ----------\n  env : CraftLab\n      An instance of the CraftLab environment (see ``craft.env``).\n\n  Returns\n  -------\n  List[int]\n      A list of action indices that, when executed sequentially, will result in\n      the agent possessing a ``stick`` in its inventory.\n  \"\"\"\n  import collections\n  import numpy as np\n\n  # --------------------------------------------------------------------- #\n  # Helper utilities\n  # --------------------------------------------------------------------- #\n  # Action constants \u2013 they are defined in the ``craft.env`` module.\n  DOWN = env.DOWN\n  UP = env.UP\n  LEFT = env.LEFT\n  RIGHT = env.RIGHT\n  USE = env.USE\n\n  # Mapping from action index to (dx, dy) movement.\n  ACTION_DELTAS = {\n      DOWN: (0, 1),\n      UP: (0, -1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  def bfs(start, targets, blocked):\n      \"\"\"\n      Bread\u2011first\u2011search returning a list of actions that moves the agent from\n      ``start`` to any cell in ``targets`` while avoiding ``blocked`` cells.\n\n      Parameters\n      ----------\n      start : tuple[int, int]\n          (x, y) start position.\n      targets : set[tuple[int, int]]\n          Set of goal positions.\n      blocked : np.ndarray of shape (W, H) \u2013 bool\n          ``True`` where the cell cannot be entered.\n\n      Returns\n      -------\n      List[int] or None\n          List of actions (indices) to reach a target, or ``None`` if unreachable.\n      \"\"\"\n      W, H = blocked.shape\n      q = collections.deque()\n      q.append(start)\n      came_from = {start: (None, None)}  # pos -> (prev_pos, action)\n\n      while q:\n          cur = q.popleft()\n          if cur in targets:\n              # reconstruct path\n              path_actions = []\n              while came_from[cur][0] is not None:\n                  prev, act = came_from[cur]\n                  path_actions.append(act)\n                  cur = prev\n              path_actions.reverse()\n              return path_actions\n\n          x, y = cur\n          for act, (dx, dy) in ACTION_DELTAS.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not blocked[nx, ny]:\n                  nxt = (nx, ny)\n                  if nxt not in came_from:\n                      came_from[nxt] = (cur, act)\n                      q.append(nxt)\n      return None\n\n  # --------------------------------------------------------------------- #\n  # 1. Reset environment and fetch the initial state.\n  # --------------------------------------------------------------------- #\n  env.reset()\n  state = env._current_state          # type: CraftState\n  grid = state.grid                    # (W, H, K)\n  pos = state.pos                      # (x, y)\n  inventory = state.inventory.copy()   # (K,)\n\n  W, H, K = grid.shape\n\n  # --------------------------------------------------------------------- #\n  # 2. Identify the stick item and its recipe.\n  # --------------------------------------------------------------------- #\n  cookbook = env.world.cookbook\n  try:\n      stick_idx = cookbook.index['stick']\n  except KeyError:\n      # No stick defined \u2013 nothing to do.\n      return []\n\n  # Primitive requirements for a single stick.\n  primitive_req = cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n  if not primitive_req:\n      # Stick is a primitive itself \u2013 just need to pick it up.\n      primitive_req = {stick_idx: 1}\n\n  # --------------------------------------------------------------------- #\n  # 3. Helper to find a free neighbour of a given cell.\n  # --------------------------------------------------------------------- #\n  def free_neighbours(cell):\n      \"\"\"Return a set of empty neighbour positions next to ``cell``.\"\"\"\n      x, y = cell\n      neigh = set()\n      for dx, dy in ACTION_DELTAS.values():\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < W and 0 <= ny < H:\n              if grid[nx, ny].sum() == 0:  # empty\n                  neigh.add((nx, ny))\n      return neigh\n\n  # --------------------------------------------------------------------- #\n  # 4. Collect each required primitive.\n  # --------------------------------------------------------------------- #\n  actions_plan = []\n\n  # Pre\u2011compute a static blocked map (cells that are never traversable).\n  # Cells containing any entity are blocked for movement.\n  static_blocked = grid.sum(axis=2) > 0\n\n  for prim_idx, needed in primitive_req.items():\n      while needed > 0:\n          # Locate any cell that still contains the primitive.\n          prim_locations = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_locations.size == 0:\n              # No more primitives of this type \u2013 cannot finish.\n              return actions_plan\n          # Choose the closest one (Manhattan distance) to current pos.\n          distances = np.abs(prim_locations[:, 0] - pos[0]) + \\\n                      np.abs(prim_locations[:, 1] - pos[1])\n          closest_idx = distances.argmin()\n          prim_cell = tuple(prim_locations[closest_idx])\n\n          # Find empty neighbour cells of the primitive.\n          candidate_neigh = free_neighbours(prim_cell)\n          if not candidate_neigh:\n              # Primitive is completely surrounded \u2013 skip it.\n              # (Very unlikely in standard maps.)\n              needed -= 1\n              continue\n\n          # Compute path to the nearest reachable neighbour.\n          path = bfs(pos, candidate_neigh, static_blocked)\n          if path is None:\n              # Unreachable \u2013 abort this primitive.\n              needed -= 1\n              continue\n\n          # Append movement actions.\n          actions_plan.extend(path)\n\n          # After moving, update our simulated position.\n          for act in path:\n              dx, dy = ACTION_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # We are now on a neighbour cell.  Turn back towards the primitive\n          # by moving one step away (which sets the facing direction correctly)\n          # and then use the USE action.\n          # Determine direction from neighbour to primitive.\n          px, py = prim_cell\n          nx, ny = pos\n          if px == nx + 1 and py == ny:\n              back_act = LEFT   # we need to face RIGHT \u2192 move left then USE\n          elif px == nx - 1 and py == ny:\n              back_act = RIGHT\n          elif py == ny + 1 and px == nx:\n              back_act = UP\n          else:  # py == ny - 1\n              back_act = DOWN\n\n          # Move back one step (if possible) \u2013 the cell we came from is\n          # guaranteed to be empty because we just entered it.\n          actions_plan.append(back_act)\n          dx, dy = ACTION_DELTAS[back_act]\n          pos = (pos[0] + dx, pos[1] + dy)\n\n          # Now we are facing the primitive; pick it up.\n          actions_plan.append(USE)\n\n          # Simulate the collection in our local copies.\n          grid[prim_cell[0], prim_cell[1], prim_idx] -= 1\n          inventory[prim_idx] += 1\n          needed -= 1\n\n  # --------------------------------------------------------------------- #\n  # 5. Move to the workshop for the stick and craft it.\n  # --------------------------------------------------------------------- #\n  # Determine which workshop is required.\n  recipe = cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is None:\n      # No workshop needed \u2013 stick is already in inventory.\n      return actions_plan\n  workshop_idx = cookbook.index[workshop_name]\n\n  # Locate any workshop cell.\n  ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if ws_cells.size == 0:\n      # No workshop on the map \u2013 cannot craft.\n      return actions_plan\n\n  # Choose the closest workshop cell.\n  distances = np.abs(ws_cells[:, 0] - pos[0]) + np.abs(ws_cells[:, 1] - pos[1])\n  closest_ws = tuple(ws_cells[distances.argmin()])\n\n  # Find empty neighbour of the workshop.\n  ws_neigh = free_neighbours(closest_ws)\n  if not ws_neigh:\n      # Workshop is surrounded \u2013 skip crafting.\n      return actions_plan\n\n  # Path to neighbour.\n  path = bfs(pos, ws_neigh, static_blocked)\n  if path is not None:\n      actions_plan.extend(path)\n      for act in path:\n          dx, dy = ACTION_DELTAS[act]\n          pos = (pos[0] + dx, pos[1] + dy)\n\n  # Turn back towards the workshop (same logic as for primitives).\n  wx, wy = closest_ws\n  nx, ny = pos\n  if wx == nx + 1 and wy == ny:\n      back_act = LEFT\n  elif wx == nx - 1 and wy == ny:\n      back_act = RIGHT\n  elif wy == ny + 1 and wx == nx:\n      back_act = UP\n  else:\n      back_act = DOWN\n\n  actions_plan.append(back_act)\n  dx, dy = ACTION_DELTAS[back_act]\n  pos = (pos[0] + dx, pos[1] + dy)\n\n  # Use the workshop to craft the stick.\n  actions_plan.append(USE)\n\n  return actions_plan", "env_interactions": 0, "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-10-15T18:45:48.238448", "function_name": "make_stick", "function_body": "  \"\"\"\n  Generate a list of actions that makes a stick in the given CraftWorld environment.\n\n  The implementation works by:\n  1. Querying the cookbook for the recipe of ``stick``.\n  2. Collecting all required primitive resources.\n  3. Moving to the appropriate workshop and using it to craft the stick.\n\n  The function directly interacts with the environment (calls ``env.step``) to\n  keep the internal state up\u2011to\u2011date while it builds the action list.\n\n  Parameters\n  ----------\n  env : CraftLab (or compatible) environment\n      An instantiated CraftWorld environment.  It must expose the attributes\n      ``world`` (the ``CraftWorld`` instance) and ``_current_state`` (the\n      ``CraftState`` instance).\n\n  Returns\n  -------\n  List[int]\n      A list of action indices (DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4) that,\n      when executed sequentially in the environment, result in a stick\n      appearing in the agent's inventory.\n  \"\"\"\n  import collections\n\n  # ----------------------------------------------------------------------\n  # Helper utilities\n  # ----------------------------------------------------------------------\n  # Action constants \u2013 match the mapping used in CraftLab.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  ACTIONS = {(1, 0): DOWN, (-1, 0): UP, (0, -1): LEFT, (0, 1): RIGHT}\n\n  def bfs(start, targets, passable):\n      \"\"\"Bread\u2011first search returning a list of positions from start to the\n      nearest cell in ``targets``.  ``passable`` is a boolean 2\u2011D array where\n      True indicates the cell can be entered.\"\"\"\n      W, H = passable.shape\n      q = collections.deque()\n      q.append((start, []))\n      visited = set([start])\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in targets:\n              return path + [(x, y)]\n          for dx, dy in [(1, 0), (-1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in visited:\n                  if passable[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [(x, y)]))\n      raise RuntimeError(\"No path found\")\n\n  def positions_of_kind(grid, kind):\n      \"\"\"Return a set of (x, y) positions where ``kind`` is present.\"\"\"\n      xs, ys = (grid[:, :, kind] > 0).nonzero()\n      return set(zip(xs.tolist(), ys.tolist()))\n\n  # ----------------------------------------------------------------------\n  # 1. Identify the recipe for a stick\n  # ----------------------------------------------------------------------\n  # Index of the target item\n  stick_idx = env.world.cookbook.index[\"stick\"]\n  # Primitive requirements (kind index -> count)\n  primitive_needs = dict(env.world.cookbook.primitives_for(stick_idx))\n\n  # ----------------------------------------------------------------------\n  # 2. Collect each required primitive\n  # ----------------------------------------------------------------------\n  actions = []\n  state = env._current_state\n  grid = state.grid\n  W, H, _ = grid.shape\n\n  # Passable cells are those that are completely empty (no entity)\n  # We also allow stepping onto a cell that contains the primitive we are\n  # about to collect \u2013 it will be treated as passable for the purpose of\n  # navigation.\n  base_passable = (grid.sum(axis=2) == 0)\n\n  for prim_kind, needed_cnt in primitive_needs.items():\n      while needed_cnt > 0:\n          # Locate all cells that currently contain this primitive\n          prim_cells = positions_of_kind(grid, prim_kind)\n          if not prim_cells:\n              raise RuntimeError(f\"Cannot find required primitive {prim_kind}\")\n\n          # Allow the target cell itself to be considered passable for the\n          # final step (so we can step onto it)\n          passable = base_passable.copy()\n          for (x, y) in prim_cells:\n              passable[x, y] = True\n\n          # Compute a path from the agent's current position to the nearest\n          # primitive cell.\n          path = bfs(state.pos, prim_cells, passable)\n\n          # Convert the path (list of positions) into movement actions.\n          for (x0, y0), (x1, y1) in zip(path, path[1:]):\n              dx, dy = x1 - x0, y1 - y0\n              act = ACTIONS[(dx, dy)]\n              actions.append(act)\n              # Step the environment so that internal state stays in sync.\n              env.step(act)\n              state = env._current_state\n              grid = state.grid\n\n          # We are now on the primitive cell.  Use the USE action to pick it\n          # up.  (If the environment automatically picks up on entry, the USE\n          # will be a harmless no\u2011op.)\n          actions.append(USE)\n          env.step(USE)\n          state = env._current_state\n          grid = state.grid\n\n          needed_cnt -= 1\n\n  # ----------------------------------------------------------------------\n  # 3. Move to the workshop and craft the stick\n  # ----------------------------------------------------------------------\n  # The workshop kind is stored under the special key \"_at\" in the recipe.\n  workshop_kind = env.world.cookbook.recipes[stick_idx][\"_at\"]\n  workshop_cells = positions_of_kind(grid, workshop_kind)\n  if not workshop_cells:\n      raise RuntimeError(\"No workshop of the required type found in the map\")\n\n  # Re\u2011compute passable map (now that primitives have been removed)\n  base_passable = (grid.sum(axis=2) == 0)\n  passable = base_passable.copy()\n  for (x, y) in workshop_cells:\n      passable[x, y] = True\n\n  path = bfs(state.pos, workshop_cells, passable)\n\n  for (x0, y0), (x1, y1) in zip(path, path[1:]):\n      dx, dy = x1 - x0, y1 - y0\n      act = ACTIONS[(dx, dy)]\n      actions.append(act)\n      env.step(act)\n      state = env._current_state\n      grid = state.grid\n\n  # Finally, use the workshop to craft the stick.\n  actions.append(USE)\n  env.step(USE)\n\n  # Return the complete action list.\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": -1}}
