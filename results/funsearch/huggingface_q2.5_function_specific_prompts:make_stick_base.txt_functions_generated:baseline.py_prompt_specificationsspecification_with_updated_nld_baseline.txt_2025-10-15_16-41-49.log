{"timestamp": "2025-10-15T17:06:46.231435", "function_name": "make_stick", "function_body": "  \"\"\"\n  Generate a sequence of actions that makes a ``stick`` in the given CraftWorld\n  environment.\n\n  The function works generically:\n    1.  Looks up the recipe for ``stick`` to obtain the required primitive\n        items.\n    2.  Finds the positions of those primitives in the current grid.\n    3.  Plans a Manhattan\u2011style path (ignoring dynamic obstacles) from the\n        agent\u2019s current location to a free cell adjacent to each primitive,\n        uses the ``USE`` action to pick it up, and updates the simulated\n        agent position.\n    4.  Finds any workshop cell, moves next to it and issues a final ``USE``\n        to craft the stick.\n\n  The returned list contains integer action IDs compatible with the\n  ``CraftLab`` interface:\n\n      0 \u2013 DOWN   (y + 1)\n      1 \u2013 UP     (y - 1)\n      2 \u2013 LEFT   (x - 1)\n      3 \u2013 RIGHT  (x + 1)\n      4 \u2013 USE    (interact / craft)\n\n  Parameters\n  ----------\n  env : CraftLab\n      An already\u2011initialised environment (has been reset).  The internal\n      state can be accessed via ``env._current_state`` and the world\n      configuration via ``env.world``.\n\n  Returns\n  -------\n  List[int]\n      A list of actions that, when executed sequentially, should result in\n      the agent possessing at least one ``stick``.\n  \"\"\"\n  import collections\n\n  # --------------------------------------------------------------------- #\n  # Helper utilities\n  # --------------------------------------------------------------------- #\n  # direction \u2192 (dx, dy) and reverse mapping to action indices\n  DIR2DELTA = {\n      0: (0, 1),   # DOWN\n      1: (0, -1),  # UP\n      2: (-1, 0),  # LEFT\n      3: (1, 0),   # RIGHT\n  }\n  DELTA2DIR = {v: k for k, v in DIR2DELTA.items()}\n\n  def in_bounds(x, y, w, h):\n      return 0 <= x < w and 0 <= y < h\n\n  def bfs(start, targets, blocked):\n      \"\"\"\n      Bread\u2011first search from ``start`` to the nearest cell in ``targets``.\n      ``blocked`` is a set of (x, y) tuples that cannot be traversed.\n      Returns a list of positions (including start and the target) or\n      ``None`` if no path exists.\n      \"\"\"\n      w, h = blocked.shape\n      q = collections.deque()\n      q.append(start)\n      came_from = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur in targets:\n              # reconstruct path\n              path = []\n              while cur is not None:\n                  path.append(cur)\n                  cur = came_from[cur]\n              path.reverse()\n              return path\n          x, y = cur\n          for dx, dy in DIR2DELTA.values():\n              nx, ny = x + dx, y + dy\n              if not in_bounds(nx, ny, w, h):\n                  continue\n              if blocked[nx, ny]:\n                  continue\n              nxt = (nx, ny)\n              if nxt not in came_from:\n                  came_from[nxt] = cur\n                  q.append(nxt)\n      return None\n\n  def path_to_actions(path):\n      \"\"\"Convert a list of (x, y) positions to a list of action IDs.\"\"\"\n      actions = []\n      for (x0, y0), (x1, y1) in zip(path, path[1:]):\n          dx, dy = x1 - x0, y1 - y0\n          actions.append(DELTA2DIR[(dx, dy)])\n      return actions\n\n  # --------------------------------------------------------------------- #\n  # Extract world / recipe information\n  # --------------------------------------------------------------------- #\n  world = env.world\n  state = env._current_state          # CraftState instance\n  grid = state.grid                    # (W, H, n_kinds)\n  pos = tuple(state.pos)               # (x, y)\n\n  # Index object maps names \u2194 integer IDs\n  idx = world.cookbook.index\n\n  # --------------------------------------------------------------------- #\n  # 1.  Determine the primitive requirements for a stick\n  # --------------------------------------------------------------------- #\n  try:\n      stick_idx = idx[\"stick\"]\n  except Exception:  # pragma: no cover\n      raise ValueError(\"The recipe does not contain an item named 'stick'.\")\n\n  # primitives_for returns a dict {primitive_idx: count}\n  primitive_needs = world.cookbook.primitives_for(stick_idx)\n\n  # --------------------------------------------------------------------- #\n  # 2.  Build a blocked\u2011cell mask (any occupied cell is an obstacle)\n  # --------------------------------------------------------------------- #\n  # Any cell with at least one non\u2011zero kind is considered blocked.\n  blocked_mask = grid.any(axis=2)\n\n  # --------------------------------------------------------------------- #\n  # 3.  Plan collection of each required primitive\n  # --------------------------------------------------------------------- #\n  actions = []\n\n  # Keep track of the agent's simulated position as we generate actions\n  cur_pos = pos\n\n  # For each primitive type we need to collect ``count`` copies\n  for prim_idx, needed_cnt in primitive_needs.items():\n      # Locate all cells that currently contain this primitive\n      prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n      if not prim_cells:\n          raise RuntimeError(f\"Primitive with index {prim_idx} not found on the grid.\")\n\n      # Simple greedy: repeatedly take the nearest still\u2011available primitive\n      remaining = needed_cnt\n      taken = set()  # cells already used for this primitive\n      while remaining > 0:\n          # Find the nearest primitive cell (Manhattan distance)\n          best_cell = None\n          best_dist = None\n          for cell in prim_cells:\n              if cell in taken:\n                  continue\n              dist = abs(cell[0] - cur_pos[0]) + abs(cell[1] - cur_pos[1])\n              if best_dist is None or dist < best_dist:\n                  best_dist = dist\n                  best_cell = cell\n          if best_cell is None:\n              raise RuntimeError(\"Not enough instances of a required primitive.\")\n\n          # Determine a free neighbour of the primitive cell to stand on\n          neigh = []\n          for dx, dy in DIR2DELTA.values():\n              nx, ny = best_cell[0] + dx, best_cell[1] + dy\n              if in_bounds(nx, ny, *blocked_mask.shape) and not blocked_mask[nx, ny]:\n                  neigh.append((nx, ny))\n          if not neigh:\n              raise RuntimeError(\"No free neighbour to collect the primitive.\")\n\n          # Choose the neighbour that is closest to the current position\n          target = min(neigh, key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))\n\n          # Plan path to the chosen neighbour\n          path = bfs(cur_pos, {target}, blocked_mask)\n          if path is None:\n              raise RuntimeError(\"Failed to find a path to the primitive.\")\n\n          actions.extend(path_to_actions(path))\n          # After moving we are on ``target`` \u2013 now face the primitive and USE\n          # Determine which direction we must face to interact with the primitive\n          dx = best_cell[0] - target[0]\n          dy = best_cell[1] - target[1]\n          face_dir = DELTA2DIR[(dx, dy)]\n          # Turn to the correct direction (if not already)\n          # The environment does not have an explicit TURN action; the agent\n          # simply faces the direction of the last movement, so we move a\n          # zero\u2011length step by moving away and back if needed.\n          # For simplicity we assume the last movement already faces correctly.\n          actions.append(4)  # USE to pick up the primitive\n\n          # Update simulated position and blocked mask (the primitive cell becomes empty)\n          cur_pos = target\n          blocked_mask[best_cell] = False\n          taken.add(best_cell)\n          remaining -= 1\n\n  # --------------------------------------------------------------------- #\n  # 4.  Move to a workshop and craft the stick\n  # --------------------------------------------------------------------- #\n  # Workshop kinds are stored in world.workshop_indices (list of indices)\n  workshop_idxs = world.workshop_indices\n  if not workshop_idxs:\n      raise RuntimeError(\"No workshop defined in the world.\")\n\n  # Find any cell that contains a workshop\n  workshop_cells = []\n  for w_idx in workshop_idxs:\n      cells = list(zip(*np.where(grid[:, :, w_idx] > 0)))\n      workshop_cells.extend(cells)\n\n  if not workshop_cells:\n      raise RuntimeError(\"No workshop cell found on the grid.\")\n\n  # Choose the nearest workshop cell\n  workshop_target = min(workshop_cells,\n                       key=lambda c: abs(c[0] - cur_pos[0]) + abs(c[1] - cur_pos[1]))\n\n  # Find a free neighbour of the workshop cell\n  neigh = []\n  for dx, dy in DIR2DELTA.values():\n      nx, ny = workshop_target[0] + dx, workshop_target[1] + dy\n      if in_bounds(nx, ny, *blocked_mask.shape) and not blocked_mask[nx, ny]:\n          neigh.append((nx, ny))\n  if not neigh:\n      raise RuntimeError(\"No free neighbour adjacent to a workshop.\")\n\n  workshop_adj = min(neigh,\n                     key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))\n\n  # Path to the adjacent cell\n  path = bfs(cur_pos, {workshop_adj}, blocked_mask)\n  if path is None:\n      raise RuntimeError(\"Failed to reach the workshop.\")\n\n  actions.extend(path_to_actions(path))\n  # Finally, USE to craft the stick\n  actions.append(4)  # USE\n\n  return actions", "env_interactions": 3, "island_id": 4, "scores": {"3": 0.0}}
