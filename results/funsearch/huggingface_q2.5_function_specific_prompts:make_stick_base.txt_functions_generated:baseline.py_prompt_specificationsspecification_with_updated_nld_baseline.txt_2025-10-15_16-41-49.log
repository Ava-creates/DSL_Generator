{"timestamp": "2025-10-15T20:24:08.254383", "function_name": "make_stick", "function_body": "  \"\"\"\n  Returns a list of actions that will make a ``stick`` in the supplied\n  CraftLab environment.\n\n  The function works by:\n    1.  Querying the world\u2019s recipe for the current goal (the goal is\n        assumed to be a ``stick``).\n    2.  Gathering all required primitive items by moving to the nearest\n        cell that contains each primitive and using the ``USE`` action.\n    3.  Moving to the required workshop (if the recipe specifies one) and\n        using the ``USE`` action to craft the stick.\n\n  The returned list can be fed back to the environment via\n  ``env.step(action)`` to reproduce the same behaviour.\n\n  Parameters\n  ----------\n  env : CraftLab\n      An instantiated CraftLab environment (already reset).\n\n  Returns\n  -------\n  List[int]\n      Sequence of action indices that will result in the stick being in\n      the agent\u2019s inventory.\n  \"\"\"\n  import numpy as np\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  # Mapping from action names to integer codes used by the environment\n  action_map = env.action_specs()          # e.g. {'DOWN':0, 'UP':1, ...}\n  use_action = action_map[\"USE\"]\n\n  # Simple step wrapper that also updates the local ``state`` reference\n  def _step(a):\n      nonlocal state\n      _, _, _ = env.step(a)                # reward / done / info are ignored\n      state = env._current_state\n\n  # Move greedily towards a target cell (tx, ty) using Manhattan distance\n  def _move_to(tx, ty):\n      while state.pos != (tx, ty):\n          x, y = state.pos\n          dx, dy = tx - x, ty - y\n          # Prefer the larger component of the distance\n          if abs(dx) >= abs(dy):\n              a = action_map[\"RIGHT\"] if dx > 0 else action_map[\"LEFT\"]\n          else:\n              a = action_map[\"DOWN\"] if dy > 0 else action_map[\"UP\"]\n          actions.append(a)\n          _step(a)\n\n  # ------------------------------------------------------------------\n  # Gather information about the goal (stick)\n  # ------------------------------------------------------------------\n  state = env._current_state\n  goal_idx = env.task.goal                                   # index of the stick\n  cookbook = env.world.cookbook\n\n  # Primitive requirements for the goal\n  primitive_needs = cookbook.primitives_for(goal_idx)       # {kind_idx: count}\n  # Workshop required for crafting (if any)\n  workshop_kind = None\n  recipe = cookbook.recipes.get(goal_idx, {})\n  if \"_at\" in recipe:\n      workshop_kind = recipe[\"_at\"]\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive\n  # ------------------------------------------------------------------\n  for kind, needed in primitive_needs.items():\n      for _ in range(needed):\n          # Locate all cells that currently contain this primitive\n          locs = np.argwhere(state.grid[:, :, kind] > 0)\n          if len(locs) == 0:\n              # No more primitives of this kind on the map \u2013 abort early\n              return actions\n          # Choose the nearest one (Manhattan distance)\n          dists = np.sum(np.abs(locs - np.array(state.pos)), axis=1)\n          nearest = locs[np.argmin(dists)]\n          tx, ty = int(nearest[0]), int(nearest[1])\n\n          # Move to the primitive and pick it up\n          _move_to(tx, ty)\n          actions.append(use_action)\n          _step(use_action)\n\n  # ------------------------------------------------------------------\n  # Move to the workshop (if required) and craft the stick\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      locs = np.argwhere(state.grid[:, :, workshop_kind] > 0)\n      if len(locs) > 0:\n          dists = np.sum(np.abs(locs - np.array(state.pos)), axis=1)\n          nearest = locs[np.argmin(dists)]\n          wx, wy = int(nearest[0]), int(nearest[1])\n          _move_to(wx, wy)\n          actions.append(use_action)\n          _step(use_action)\n\n  return actions", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
