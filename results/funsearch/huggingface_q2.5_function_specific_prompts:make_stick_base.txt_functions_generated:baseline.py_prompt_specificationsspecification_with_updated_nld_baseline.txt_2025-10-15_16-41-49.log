{"timestamp": "2025-10-15T20:25:13.702065", "function_name": "make_stick", "function_body": "  \"\"\"\n  Return a list of actions that will make a ``stick`` in the given\n  CraftLab environment.\n\n  The algorithm:\n    1. Look up the stick recipe.\n    2. Collect each required primitive by moving to a cell that\n       contains it and using the ``USE`` action.\n    3. Move to the required workshop (if the recipe specifies one)\n       and ``USE`` to craft the stick.\n\n  The function does **not** execute the actions \u2013 it only returns the\n  sequence of integer action indices that can later be fed to\n  ``env.step``.\n  \"\"\"\n  # ------------------------------------------------------------------\n  # Helpers\n  # ------------------------------------------------------------------\n  ACTIONS = env.action_specs()          # e.g. {'DOWN':0, 'UP':1, ...}\n  ACTION_USE = ACTIONS[\"USE\"]\n  ACTION_DOWN = ACTIONS[\"DOWN\"]\n  ACTION_UP = ACTIONS[\"UP\"]\n  ACTION_LEFT = ACTIONS[\"LEFT\"]\n  ACTION_RIGHT = ACTIONS[\"RIGHT\"]\n\n  def manhattan_move(cur, target):\n      \"\"\"Return a list of actions moving from ``cur`` to ``target``.\"\"\"\n      x, y = cur\n      tx, ty = target\n      moves = []\n      while x < tx:\n          moves.append(ACTION_RIGHT); x += 1\n      while x > tx:\n          moves.append(ACTION_LEFT);  x -= 1\n      while y < ty:\n          moves.append(ACTION_DOWN); y += 1\n      while y > ty:\n          moves.append(ACTION_UP);   y -= 1\n      return moves\n\n  def locate_kind(grid, kind):\n      \"\"\"Return coordinates (x, y) of any cell that currently holds ``kind``.\"\"\"\n      locs = np.argwhere(grid[:, :, kind] > 0)\n      if len(locs) == 0:\n          raise RuntimeError(f\"Cannot find required kind {kind} on the map.\")\n      return tuple(locs[0][:2])\n\n  # ------------------------------------------------------------------\n  # Access world / recipe information\n  # ------------------------------------------------------------------\n  world = env.world\n  cookbook = world.cookbook\n  stick_idx = cookbook.index[\"stick\"]\n  recipe = cookbook.recipes[stick_idx]\n\n  # Primitive requirements (exclude the special key \"_at\")\n  primitive_req = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  # Workshop (if any)\n  workshop_name = recipe.get(\"_at\")\n  workshop_idx = cookbook.index[workshop_name] if workshop_name else None\n\n  # ------------------------------------------------------------------\n  # Current state snapshot (used only for planning)\n  # ------------------------------------------------------------------\n  state = env._current_state\n  pos = tuple(state.pos)                 # (x, y)\n  grid = state.grid.copy()               # we will update it locally\n  inventory = state.inventory.copy()\n\n  action_plan = []\n\n  # ------------------------------------------------------------------\n  # Collect required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitive_req.items():\n      while inventory[prim_idx] < needed:\n          # Find a cell containing the primitive\n          src = locate_kind(grid, prim_idx)\n\n          # Move to that cell\n          action_plan.extend(manhattan_move(pos, src))\n          pos = src\n\n          # Pick it up\n          action_plan.append(ACTION_USE)\n\n          # Simulate the effect locally\n          inventory[prim_idx] += 1\n          grid[src[0], src[1], prim_idx] = 0   # primitive consumed\n\n  # ------------------------------------------------------------------\n  # Move to workshop and craft (if a workshop is required)\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws = locate_kind(grid, workshop_idx)\n\n      action_plan.extend(manhattan_move(pos, ws))\n      pos = ws\n\n      # Craft the stick\n      action_plan.append(ACTION_USE)\n\n  return action_plan", "env_interactions": 4, "island_id": 2, "scores": {"3": 0.0}}
