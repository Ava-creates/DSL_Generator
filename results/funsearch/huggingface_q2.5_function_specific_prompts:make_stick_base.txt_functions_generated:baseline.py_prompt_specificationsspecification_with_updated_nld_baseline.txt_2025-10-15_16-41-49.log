{"timestamp": "2025-10-15T17:44:46.552590", "function_name": "make_stick", "function_body": "  \"\"\"\n  Generate a list of actions that will obtain a ``stick`` in the given\n  CraftWorld environment.\n\n  The implementation works for any environment that follows the\n  ``craft`` code\u2011base conventions:\n\n  * ``env`` is a :class:`CraftLab` instance.\n  * The underlying world can be accessed via ``env.world``.\n  * The current mutable state is stored in ``env._current_state``.\n  * Actions are encoded as integers:\n      0 \u2013 DOWN, 1 \u2013 UP, 2 \u2013 LEFT, 3 \u2013 RIGHT, 4 \u2013 USE.\n  * The goal item can be obtained from the task description\n    (``env.task.goal``) or, if that attribute is missing, by looking up\n    the name ``\"stick\"`` in the cookbook index.\n  * The recipe for an item is available through\n    ``env.world.cookbook.recipes[goal_idx]``.  Primitive requirements are\n    the entries whose key is an integer (kind index); the optional\n    ``\"_at\"`` entry tells at which workshop the item must be crafted.\n\n  The planner is deliberately simple: it walks the agent with Manhattan\n  moves on empty cells, picks up the required primitives, then moves to\n  the appropriate workshop (if any) and issues a ``USE`` action to craft\n  the final item.\n\n  Parameters\n  ----------\n  env : CraftLab\n      The environment instance.\n\n  Returns\n  -------\n  List[int]\n      A list of action indices that, when executed sequentially, will\n      result in at least one ``stick`` in the agent's inventory.\n  \"\"\"\n  import numpy as np\n\n  # ------------------------------------------------------------------\n  # Helper functions\n  # ------------------------------------------------------------------\n  def manhattan(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  # Move one step towards ``target`` using Manhattan moves.\n  # Returns the action taken.\n  def step_towards(pos, target):\n      x, y = pos\n      tx, ty = target\n      if x < tx:\n          return 3, (x + 1, y)          # RIGHT\n      if x > tx:\n          return 2, (x - 1, y)          # LEFT\n      if y < ty:\n          return 0, (x, y + 1)          # DOWN\n      if y > ty:\n          return 1, (x, y - 1)          # UP\n      # already there (should not happen)\n      return None, pos\n\n  # ------------------------------------------------------------------\n  # Initialise environment (reset) and obtain the current state.\n  # ------------------------------------------------------------------\n  env.reset()\n  state = env._current_state          # type: CraftState\n\n  # ------------------------------------------------------------------\n  # Determine the goal index for a ``stick``.\n  # ------------------------------------------------------------------\n  try:\n      # Newer versions expose the goal directly.\n      goal_idx = env.task.goal\n  except Exception:  # pragma: no cover\n      # Fallback: look up the name in the cookbook index.\n      goal_idx = env.world.cookbook.index[\"stick\"]\n\n  # ------------------------------------------------------------------\n  # Extract the primitive requirements for the goal.\n  # ------------------------------------------------------------------\n  # ``primitives_for`` returns a dict {kind_idx: count}\n  needed = dict(env.world.cookbook.primitives_for(goal_idx))\n\n  # ------------------------------------------------------------------\n  # Main action list that will be returned.\n  # ------------------------------------------------------------------\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive.\n  # ------------------------------------------------------------------\n  for kind, count in needed.items():\n      while count > 0:\n          # Scan the current grid for cells that still contain the primitive.\n          grid = state.grid\n          # ``grid[:,:,kind] > 0`` gives a boolean map of cells with the item.\n          primitive_cells = np.argwhere(grid[:, :, kind] > 0)\n          if primitive_cells.size == 0:\n              raise RuntimeError(f\"Primitive of kind {kind} not found on the map.\")\n\n          # Choose the closest primitive (Manhattan distance).\n          distances = [manhattan(state.pos, tuple(cell)) for cell in primitive_cells]\n          target = tuple(primitive_cells[int(np.argmin(distances))])\n\n          # Walk to a *adjacent* empty cell next to the target.\n          # First, find any empty neighbour of the target.\n          neighbours = [\n              (target[0] + dx, target[1] + dy)\n              for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]\n              if 0 <= target[0] + dx < grid.shape[0] and\n                 0 <= target[1] + dy < grid.shape[1]\n          ]\n\n          # Filter neighbours that are free (no entity occupies them).\n          empty_neighbours = [\n              n for n in neighbours if not grid[n[0], n[1]].any()\n          ]\n\n          if not empty_neighbours:\n              raise RuntimeError(\"No free neighbour to approach the primitive.\")\n\n          # Pick the empty neighbour that is closest to the agent.\n          neighbour = min(\n              empty_neighbours,\n              key=lambda n: manhattan(state.pos, n)\n          )\n\n          # Move step\u2011by\u2011step until we stand on the chosen neighbour.\n          while state.pos != neighbour:\n              act, new_pos = step_towards(state.pos, neighbour)\n              actions.append(act)\n              _, _ = env.step(act)          # execute the step\n              state = env._current_state\n\n          # We are now adjacent to the primitive \u2013 pick it up.\n          actions.append(4)                  # USE\n          _, _ = env.step(4)\n          state = env._current_state\n          count -= 1\n\n  # ------------------------------------------------------------------\n  # All primitives are collected \u2013 now craft the stick at its workshop\n  # (if the recipe specifies one).\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n\n  if workshop_kind is not None:\n      # Locate the workshop cell (workshops are non\u2011grabbable, i.e. they\n      # occupy a cell but the agent can stand next to them).\n      grid = state.grid\n      workshop_cells = np.argwhere(grid[:, :, workshop_kind] > 0)\n      if workshop_cells.size == 0:\n          raise RuntimeError(\"Required workshop not found on the map.\")\n      # Choose the closest workshop.\n      distances = [manhattan(state.pos, tuple(cell)) for cell in workshop_cells]\n      target_ws = tuple(workshop_cells[int(np.argmin(distances))])\n\n      # As before, move to an empty neighbour of the workshop.\n      neighbours = [\n          (target_ws[0] + dx, target_ws[1] + dy)\n          for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]\n          if 0 <= target_ws[0] + dx < grid.shape[0] and\n             0 <= target_ws[1] + dy < grid.shape[1]\n      ]\n      empty_neighbours = [\n          n for n in neighbours if not grid[n[0], n[1]].any()\n      ]\n      if not empty_neighbours:\n          raise RuntimeError(\"No free neighbour to approach the workshop.\")\n      neighbour = min(\n          empty_neighbours,\n          key=lambda n: manhattan(state.pos, n)\n      )\n      while state.pos != neighbour:\n          act, new_pos = step_towards(state.pos, neighbour)\n          actions.append(act)\n          _, _ = env.step(act)\n          state = env._current_state\n\n      # Finally, issue a USE to craft the stick.\n      actions.append(4)          # USE at the workshop\n      _, _ = env.step(4)\n      state = env._current_state\n  else:\n      # No workshop required \u2013 a final USE anywhere will attempt to craft.\n      actions.append(4)\n      _, _ = env.step(4)\n      state = env._current_state\n\n  # ------------------------------------------------------------------\n  # Return the complete action sequence.\n  # ------------------------------------------------------------------\n  return actions", "env_interactions": 0, "island_id": 9, "scores": {"3": -1}}
