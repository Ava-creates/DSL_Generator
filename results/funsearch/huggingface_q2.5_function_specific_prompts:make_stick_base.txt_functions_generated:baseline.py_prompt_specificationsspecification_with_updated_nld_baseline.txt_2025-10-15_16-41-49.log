{"timestamp": "2025-10-15T18:23:56.577368", "function_name": "make_stick", "function_body": "  import numpy as np\n  actions = []\n  # action mapping (as used by CraftWorld)\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  world = env.world\n  # index of the goal item \"stick\"\n  stick_idx = world.cookbook.index.get(\"stick\")\n  if stick_idx is None:\n      # unknown goal\n      return actions\n\n  # primitive requirements for one stick\n  required = world.cookbook.primitives_for(stick_idx)\n\n  # get current state (might be stored in env._current_state)\n  if hasattr(env, \"_current_state\"):\n      state = env._current_state\n  else:\n      # create a fresh state from the scenario\n      state = env.scenario.init()\n  grid = state.grid\n  pos = list(state.pos)   # mutable copy [x, y]\n\n  def nearest_location(kind):\n      \"\"\"Return the (x, y) of the nearest cell that contains `kind`.\"\"\"\n      locations = np.argwhere(grid[:, :, kind] > 0)\n      if locations.shape[0] == 0:\n          return None\n      # Manhattan distance\n      dists = np.sum(np.abs(locations - pos), axis=1)\n      return locations[np.argmin(dists)]\n\n  def move_to(target):\n      \"\"\"Append actions that move the agent from current pos to target (x, y).\"\"\"\n      nonlocal pos\n      tx, ty = target\n      # move in x direction (width axis)\n      while pos[0] < tx:\n          actions.append(ACTION_RIGHT)\n          pos[0] += 1\n      while pos[0] > tx:\n          actions.append(ACTION_LEFT)\n          pos[0] -= 1\n      # move in y direction (height axis)\n      while pos[1] < ty:\n          actions.append(ACTION_DOWN)\n          pos[1] += 1\n      while pos[1] > ty:\n          actions.append(ACTION_UP)\n          pos[1] -= 1\n\n  # collect each required primitive the required number of times\n  for kind, cnt in required.items():\n      for _ in range(cnt):\n          loc = nearest_location(kind)\n          if loc is None:\n              # primitive not present \u2013 give up\n              continue\n          move_to(loc.tolist())\n          actions.append(ACTION_USE)   # pick up the primitive\n\n  # finally go to a workshop that can craft a stick and use it\n  # the workshop type is stored in the recipe under the key \"_at\"\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      # workshop_kind may be a name; translate to index if needed\n      if isinstance(workshop_kind, str):\n          workshop_idx = world.cookbook.index.get(workshop_kind)\n      else:\n          workshop_idx = workshop_kind\n      if workshop_idx is not None:\n          ws_loc = nearest_location(workshop_idx)\n          if ws_loc is not None:\n              move_to(ws_loc.tolist())\n              actions.append(ACTION_USE)   # craft the stick\n\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": -1}}
