{"timestamp": "2025-10-15T19:34:47.751658", "function_name": "make_stick", "function_body": "  \"\"\"\n  Returns a list of actions that will collect the required primitives\n  for a ``stick`` and then craft it at the appropriate workshop.\n  The function works for any CraftWorld environment that follows the\n  standard API (CraftLab / CraftWorld).\n\n  Parameters\n  ----------\n  env : object\n      The CraftLab / CraftWorld environment instance.\n\n  Returns\n  -------\n  List[int]\n      A sequence of action indices (DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4)\n      that will produce a stick.\n  \"\"\"\n  # ------------------------------------------------------------------\n  # Helper: move from current position to a target (x, y) using Manhattan\n  # steps.  The action ordering follows the convention used in CraftWorld:\n  #   0: DOWN  (y + 1)\n  #   1: UP    (y - 1)\n  #   2: LEFT  (x - 1)\n  #   3: RIGHT (x + 1)\n  #   4: USE   (interact / craft)\n  # ------------------------------------------------------------------\n  def _move_to(cur, target, actions):\n      cx, cy = cur\n      tx, ty = target\n      while cx < tx:\n          actions.append(3)   # RIGHT\n          cx += 1\n      while cx > tx:\n          actions.append(2)   # LEFT\n          cx -= 1\n      while cy < ty:\n          actions.append(0)   # DOWN\n          cy += 1\n      while cy > ty:\n          actions.append(1)   # UP\n          cy -= 1\n      return [cx, cy]\n\n  # ------------------------------------------------------------------\n  # Initialise environment and obtain the starting state.\n  # ------------------------------------------------------------------\n  env.reset()\n  state = env._current_state          # current CraftState\n  world = env.world                    # CraftWorld instance\n\n  # ------------------------------------------------------------------\n  # Identify the index of the goal item (\"stick\").\n  # ------------------------------------------------------------------\n  stick_idx = world.cookbook.index.get(\"stick\")\n  if stick_idx is None:\n      # If the world does not contain a stick item, return empty list.\n      return []\n\n  # ------------------------------------------------------------------\n  # Determine which primitive resources are required to craft a stick.\n  # ------------------------------------------------------------------\n  primitives_needed = world.cookbook.primitives_for(stick_idx)  # {kind_idx: count}\n  actions = []\n  cur_pos = list(state.pos)   # [x, y]\n\n  # ------------------------------------------------------------------\n  # For each required primitive, locate a cell containing it,\n  # move there, and use the \"USE\" action to pick it up.\n  # ------------------------------------------------------------------\n  for kind_idx, needed_cnt in primitives_needed.items():\n      for _ in range(needed_cnt):\n          # Find any cell that currently holds the primitive.\n          # The grid is (W, H, n_kinds); we look at the slice for kind_idx.\n          locations = np.argwhere(state.grid[:, :, kind_idx] > 0)\n          if locations.size == 0:\n              # No such primitive is present \u2013 cannot continue.\n              continue\n          # Choose the first location (could be improved with nearest search).\n          ty, tx = locations[0]   # note: argwhere returns (y, x)\n          cur_pos = _move_to(cur_pos, (tx, ty), actions)\n          actions.append(4)      # USE to collect the primitive\n\n  # ------------------------------------------------------------------\n  # After gathering all primitives, move to the appropriate workshop and\n  # craft the stick.  The workshop name is stored in the recipe under\n  # the special key \"_at\".\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = world.cookbook.index.get(workshop_name)\n      if workshop_idx is not None:\n          # Locate any workshop cell of this type.\n          ws_locs = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n          if ws_locs.size > 0:\n              wy, wx = ws_locs[0]\n              cur_pos = _move_to(cur_pos, (wx, wy), actions)\n              actions.append(4)  # USE to craft the stick\n\n  return actions", "env_interactions": 0, "island_id": 5, "scores": {"3": -1}}
