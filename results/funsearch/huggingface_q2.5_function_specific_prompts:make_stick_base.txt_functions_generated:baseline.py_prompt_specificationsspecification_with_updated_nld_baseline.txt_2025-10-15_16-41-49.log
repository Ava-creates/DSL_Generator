{"timestamp": "2025-10-15T19:50:09.954173", "function_name": "make_stick", "function_body": "  \"\"\"\n  Generate a list of actions that will collect the required primitives for a\n  ``stick`` and then craft it at the appropriate workshop.\n\n  The implementation uses the environment's public API (reset, step, and the\n  ``CraftWorld``/``Cookbook`` objects) to locate needed items, move the agent,\n  and invoke ``USE`` actions.  It does not attempt any sophisticated planning;\n  it simply moves greedily (Manhattan distance) towards the nearest required\n  object and picks it up.\n\n  Returns\n  -------\n  list[int]\n      Sequence of action indices (0=DOWN, 1=UP, 2=LEFT, 3=RIGHT, 4=USE)\n      that can be executed in the given environment to obtain a stick.\n  \"\"\"\n  # --------------------------------------------------------------------- #\n  # Helper constants \u2013 these match the action mapping used by CraftLab.\n  # --------------------------------------------------------------------- #\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # --------------------------------------------------------------------- #\n  # Reset the environment to obtain a fresh state.\n  # --------------------------------------------------------------------- #\n  env.reset()\n  state = env._current_state          # type: CraftState\n  world = env.world                    # type: CraftWorld\n  cookbook = world.cookbook\n\n  # --------------------------------------------------------------------- #\n  # Identify the goal index for ``stick`` and the primitive requirements.\n  # --------------------------------------------------------------------- #\n  try:\n      stick_idx = cookbook.index[\"stick\"]\n  except Exception as exc:\n      raise ValueError(\"The recipe database does not contain a 'stick' entry.\") from exc\n\n  # primitives_for returns a dict {primitive_index: count} needed for one stick.\n  needed_primitives = cookbook.primitives_for(stick_idx)\n\n  # --------------------------------------------------------------------- #\n  # Locate the workshop where a stick must be crafted.\n  # --------------------------------------------------------------------- #\n  try:\n      workshop_name = cookbook.recipes[stick_idx][\"_at\"]\n      workshop_idx = cookbook.index[workshop_name]\n  except Exception as exc:\n      raise ValueError(\"Unable to determine the workshop for 'stick'.\") from exc\n\n  actions = []\n\n  # --------------------------------------------------------------------- #\n  # Utility: find the nearest cell that contains a given kind (primitive or\n  # workshop).  Returns a tuple (x, y) in grid coordinates or None.\n  # --------------------------------------------------------------------- #\n  def find_nearest(kind_idx):\n      grid_layer = state.grid[:, :, kind_idx]          # shape (W, H)\n      positions = np.argwhere(grid_layer > 0)          # list of (x, y)\n      if positions.size == 0:\n          return None\n      # Manhattan distance from current position\n      cur = np.array(state.pos)                        # (x, y)\n      dists = np.abs(positions - cur).sum(axis=1)\n      return tuple(positions[np.argmin(dists)])\n\n  # --------------------------------------------------------------------- #\n  # Utility: move greedily (Manhattan) from the current position to a target.\n  # The function updates ``state`` and records each movement action.\n  # --------------------------------------------------------------------- #\n  def move_to(target):\n      nonlocal state\n      while state.pos != target:\n          px, py = state.pos\n          tx, ty = target\n          if px < tx:\n              act = DOWN\n          elif px > tx:\n              act = UP\n          elif py < ty:\n              act = RIGHT\n          else:  # py > ty\n              act = LEFT\n          actions.append(act)\n          _, new_state = env.step(act)\n          state = new_state\n\n  # --------------------------------------------------------------------- #\n  # Collect each required primitive the necessary number of times.\n  # --------------------------------------------------------------------- #\n  for prim_idx, count in needed_primitives.items():\n      for _ in range(count):\n          loc = find_nearest(prim_idx)\n          if loc is None:\n              # Primitive not present \u2013 give up early.\n              return actions\n          move_to(loc)\n          # Use the item (the cell we are on contains the primitive; a USE\n          # action on the cell in front works even if we are on the same cell\n          # because the environment treats it as a pick\u2011up).\n          actions.append(USE)\n          _, new_state = env.step(USE)\n          state = new_state\n\n  # --------------------------------------------------------------------- #\n  # Finally, go to the workshop and craft the stick.\n  # --------------------------------------------------------------------- #\n  workshop_loc = find_nearest(workshop_idx)\n  if workshop_loc is not None:\n      move_to(workshop_loc)\n      actions.append(USE)          # craft at the workshop\n      _, new_state = env.step(USE)\n      state = new_state\n\n  return actions", "env_interactions": 0, "island_id": 9, "scores": {"3": -1}}
