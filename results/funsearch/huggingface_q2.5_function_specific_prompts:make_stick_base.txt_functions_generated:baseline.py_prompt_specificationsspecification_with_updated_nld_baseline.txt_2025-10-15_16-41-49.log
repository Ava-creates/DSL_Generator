{"timestamp": "2025-10-15T18:34:38.189257", "function_name": "make_stick", "function_body": "  \"\"\"\n  Returns a list of actions that will make a ``stick`` in the given\n  CraftWorld environment.\n\n  The implementation follows a very simple planner:\n\n  1.  Reset the environment to obtain the initial state and the goal\n      index (the index of the item that has to be crafted \u2013 ``stick``).\n  2.  Query the world\u2019s ``Cookbook`` for the primitive resources required\n      to craft the goal.\n  3.  For each required primitive, move the agent to the nearest cell that\n      contains that primitive and execute the ``USE`` action to pick it up.\n  4.  After all primitives are collected, move the agent to a workshop that\n      can craft the goal (the workshop type is stored in the recipe under the\n      ``_at`` key) and execute ``USE`` once more to craft the ``stick``.\n  5.  Return the accumulated list of actions.\n\n  The planner uses a breadth\u2011first search (BFS) on the static occupancy map\n  to compute a shortest path between two cells.  It assumes the standard\n  action ordering used by ``CraftLab``:\n\n  * 0 \u2013 DOWN  (y + 1)\n  * 1 \u2013 UP    (y \u2013 1)\n  * 2 \u2013 LEFT  (x \u2013 1)\n  * 3 \u2013 RIGHT (x + 1)\n  * 4 \u2013 USE   (interact with the cell in front)\n\n  The function does **not** attempt any sophisticated obstacle handling\n  (e.g. using tools to clear trees) \u2013 it works for environments where the\n  required primitives are reachable through empty cells.\n\n  Parameters\n  ----------\n  env : CraftLab\n      An instantiated CraftLab environment (already created but not yet\n      reset).\n\n  Returns\n  -------\n  List[int]\n      A list of action indices that, when applied sequentially with\n      ``env.step``, will result in the agent possessing at least one ``stick``.\n  \"\"\"\n  import numpy as np\n  from collections import deque\n\n  # --------------------------------------------------------------------- #\n  # Helper functions\n  # --------------------------------------------------------------------- #\n  def occupancy(grid):\n      \"\"\"Boolean array: True where any entity occupies the cell.\"\"\"\n      return grid.sum(axis=2) > 0\n\n  def bfs(start, targets, occ):\n      \"\"\"\n      Bread\u2011first search on the grid.\n\n      Parameters\n      ----------\n      start : tuple (x, y)\n      targets : set of (x, y) tuples \u2013 any of these is an acceptable goal.\n      occ : 2\u2011D boolean array \u2013 True for blocked cells.\n\n      Returns\n      -------\n      List[tuple] \u2013 list of positions from start (excluded) to the goal\n      (included).  Empty list if no path is found.\n      \"\"\"\n      W, H = occ.shape\n      q = deque()\n      q.append((start, []))\n      visited = set()\n      visited.add(start)\n\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in targets:\n              return path  # path leads to the target, not including start\n\n          for dx, dy, act in [ (0, -1, 1),   # UP\n                               (0,  1, 0),   # DOWN\n                               (-1, 0, 2),   # LEFT\n                               (1,  0, 3) ]: # RIGHT\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not occ[nx, ny] and (nx, ny) not in visited:\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [act]))\n      return []  # no path found\n\n  # --------------------------------------------------------------------- #\n  # Begin planning\n  # --------------------------------------------------------------------- #\n  # Reset the environment \u2013 this also creates the initial CraftState.\n  obs = env.reset()\n  state = env._current_state          # type: CraftState\n  grid = state.grid.copy()            # (W, H, n_kinds)\n  pos = state.pos                      # (x, y)\n\n  # Goal index (the item we need to craft)\n  goal_idx = env.task.goal\n\n  # --------------------------------------------------------------------- #\n  # Determine which primitives are needed and where to craft\n  # --------------------------------------------------------------------- #\n  # Mapping primitive_kind_idx -> required count\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)\n\n  # Workshop kind for this recipe (stored under the special key \"_at\")\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n\n  # --------------------------------------------------------------------- #\n  # Action list that will be returned\n  # --------------------------------------------------------------------- #\n  actions = []\n\n  # --------------------------------------------------------------------- #\n  # Helper to move to a target cell and update internal bookkeeping\n  # --------------------------------------------------------------------- #\n  def move_to(target):\n      \"\"\"Append actions that move the agent from its current position to target.\"\"\"\n      nonlocal pos, grid\n      occ = occupancy(grid)\n      path = bfs(pos, {target}, occ)\n      actions.extend(path)\n      # Simulate the moves locally so that subsequent planning uses the new position.\n      for act in path:\n          if act == 0:   # DOWN\n              pos = (pos[0], pos[1] + 1)\n          elif act == 1: # UP\n              pos = (pos[0], pos[1] - 1)\n          elif act == 2: # LEFT\n              pos = (pos[0] - 1, pos[1])\n          elif act == 3: # RIGHT\n              pos = (pos[0] + 1, pos[1])\n\n  # --------------------------------------------------------------------- #\n  # Collect each required primitive\n  # --------------------------------------------------------------------- #\n  for prim_idx, needed_cnt in primitives_needed.items():\n      while state.inventory[prim_idx] < needed_cnt:\n          # Find all cells that currently contain the primitive\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # No more of this primitive on the map \u2013 abort planning.\n              break\n          # Choose the closest one (Manhattan distance)\n          distances = np.abs(prim_cells[:, 0] - pos[0]) + np.abs(prim_cells[:, 1] - pos[1])\n          closest = prim_cells[distances.argmin()]\n          target = (int(closest[0]), int(closest[1]))\n\n          # Move to the primitive cell\n          move_to(target)\n\n          # Use the primitive (action 4)\n          actions.append(4)               # USE\n          # Update local grid/inventory to reflect the pickup\n          grid[target[0], target[1], prim_idx] = 0\n          state.inventory[prim_idx] += 1\n\n  # --------------------------------------------------------------------- #\n  # Move to the appropriate workshop and craft the goal\n  # --------------------------------------------------------------------- #\n  if workshop_kind is not None:\n      # Find any workshop cell (they are static)\n      workshop_cells = np.argwhere(grid[:, :, workshop_kind] > 0)\n      if workshop_cells.size > 0:\n          # Choose the closest workshop\n          distances = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])\n          closest_ws = workshop_cells[distances.argmin()]\n          ws_target = (int(closest_ws[0]), int(closest_ws[1]))\n          move_to(ws_target)\n\n          # Craft the item\n          actions.append(4)   # USE at the workshop\n\n  # Return the compiled action list\n  return actions", "env_interactions": 0, "island_id": 9, "scores": {"3": 0.0}}
