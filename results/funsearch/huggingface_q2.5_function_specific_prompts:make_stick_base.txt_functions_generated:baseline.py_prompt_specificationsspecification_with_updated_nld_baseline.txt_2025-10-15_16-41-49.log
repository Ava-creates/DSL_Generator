{"timestamp": "2025-10-15T19:18:53.592848", "function_name": "make_stick", "function_body": "  \"\"\"Return a list of actions that will result in a stick.\"\"\"\n  if hasattr(env, \"craft\"):\n      try:\n          return env.craft(\"stick\")\n      except Exception:\n          pass\n  # fallback: try to use env.world.cookbook.primitives_for etc. But we cannot compute actions without map.\n  return []", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-15T19:19:15.114245", "function_name": "make_stick", "function_body": "  \"\"\"\n  Generate a sequence of actions that makes a ``stick`` in the given\n  CraftLab environment.\n\n  The function works with the standard CraftWorld action encoding:\n      0 \u2013 DOWN, 1 \u2013 UP, 2 \u2013 LEFT, 3 \u2013 RIGHT, 4 \u2013 USE\n\n  It:\n    1. Reads the recipe for ``stick`` to know which primitive(s) are needed.\n    2. For each required primitive it finds the nearest instance on the map,\n       walks to it (BFS) and uses the ``USE`` action to pick it up.\n    3. Walks to the workshop where a ``stick`` can be crafted and issues a\n       final ``USE`` to craft the item.\n\n  The returned list can be fed directly to ``env.step(action)`` in a loop.\n  \"\"\"\n  import collections\n  import numpy as np\n\n  # ------------------------------------------------------------------ #\n  # Action constants (match CraftWorld ordering)\n  # ------------------------------------------------------------------ #\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = range(5)\n\n  # Mapping from (dr, dc) to action index\n  DELTA_TO_ACT = {\n      ( 1,  0): ACTION_DOWN,\n      (-1,  0): ACTION_UP,\n      ( 0, -1): ACTION_LEFT,\n      ( 0,  1): ACTION_RIGHT,\n  }\n\n  # ------------------------------------------------------------------ #\n  # Helper: BFS that returns a list of movement actions reaching the nearest\n  # cell where ``goal_mask`` is True while avoiding blocked cells.\n  # ------------------------------------------------------------------ #\n  def bfs(start, goal_mask, blocked_mask):\n      if goal_mask[start]:\n          return []\n\n      H, W = goal_mask.shape\n      q = collections.deque([start])\n      visited = np.full((H, W), False, dtype=bool)\n      visited[start] = True\n      parent = {}\n\n      while q:\n          r, c = q.popleft()\n          for (dr, dc), act in DELTA_TO_ACT.items():\n              nr, nc = r + dr, c + dc\n              if 0 <= nr < H and 0 <= nc < W and not visited[nr, nc] and not blocked_mask[nr, nc]:\n                  visited[nr, nc] = True\n                  parent[(nr, nc)] = (r, c, act)\n                  if goal_mask[nr, nc]:\n                      # reconstruct path\n                      path = []\n                      cur = (nr, nc)\n                      while cur != start:\n                          pr, pc, a = parent[cur]\n                          path.append(a)\n                          cur = (pr, pc)\n                      path.reverse()\n                      return path\n                  q.append((nr, nc))\n      # No reachable goal\n      return []\n\n  # ------------------------------------------------------------------ #\n  # Extract world information\n  # ------------------------------------------------------------------ #\n  world = env.world                     # CraftWorld instance\n  cookbook = world.cookbook\n  scenario = env.scenario                # CraftScenario instance\n\n  # Initial grid and agent position\n  grid = scenario.init_grid.copy()\n  pos = scenario.init_pos                # (row, col)\n\n  # ------------------------------------------------------------------ #\n  # Identify the stick goal and its recipe\n  # ------------------------------------------------------------------ #\n  stick_idx = cookbook.index[\"stick\"]\n  primitive_req = cookbook.primitives_for(stick_idx)   # {kind_idx: count}\n  workshop_name = cookbook.recipes[stick_idx][\"_at\"]\n  workshop_idx = cookbook.index[workshop_name]\n\n  # ------------------------------------------------------------------ #\n  # Mask of cells that block movement (any non\u2011zero entity)\n  # ------------------------------------------------------------------ #\n  blocked_mask = grid.sum(axis=2) > 0\n\n  actions = []\n\n  # ------------------------------------------------------------------ #\n  # 1. Collect all required primitives\n  # ------------------------------------------------------------------ #\n  for kind_idx, needed in primitive_req.items():\n      for _ in range(needed):\n          goal_mask = grid[:, :, kind_idx] > 0\n          path = bfs(pos, goal_mask, blocked_mask)\n          actions.extend(path)\n\n          # update position after moving\n          for a in path:\n              dr, dc = {ACTION_DOWN: (1, 0), ACTION_UP: (-1, 0),\n                        ACTION_LEFT: (0, -1), ACTION_RIGHT: (0, 1)}[a]\n              pos = (pos[0] + dr, pos[1] + dc)\n\n          # pick up the primitive\n          actions.append(ACTION_USE)\n\n          # simulate pickup in our local copy\n          grid[pos[0], pos[1], kind_idx] = max(0, grid[pos[0], pos[1], kind_idx] - 1)\n          blocked_mask = grid.sum(axis=2) > 0\n\n  # ------------------------------------------------------------------ #\n  # 2. Move to the workshop that can craft a stick\n  # ------------------------------------------------------------------ #\n  workshop_mask = grid[:, :, workshop_idx] > 0\n  path_ws = bfs(pos, workshop_mask, blocked_mask)\n  actions.extend(path_ws)\n\n  for a in path_ws:\n      dr, dc = {ACTION_DOWN: (1, 0), ACTION_UP: (-1, 0),\n                ACTION_LEFT: (0, -1), ACTION_RIGHT: (0, 1)}[a]\n      pos = (pos[0] + dr, pos[1] + dc)\n\n  # ------------------------------------------------------------------ #\n  # 3. Craft the stick\n  # ------------------------------------------------------------------ #\n  actions.append(ACTION_USE)\n\n  return actions", "env_interactions": 2, "island_id": 4, "scores": {"3": 0.0}}
