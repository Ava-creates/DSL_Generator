{"timestamp": "2025-10-15T18:33:01.144769", "function_name": "make_stick", "function_body": "  \"\"\"\n  Returns a list of actions that makes a ``stick`` in the given CraftWorld\n  environment.  The implementation works for any environment that follows\n  the API described in the prompt (CraftLab / CraftWorld).\n\n  The algorithm:\n      1.  Look up the recipe for ``stick`` in the world cookbook.\n      2.  For each required primitive, repeatedly\n          * locate the nearest instance of that primitive on the grid,\n          * move to a free cell adjacent to it,\n          * use the ``USE`` action to pick it up.\n      3.  After all primitives are collected, move to the required workshop\n          (as indicated by the ``_at`` field of the recipe) and ``USE`` to\n          craft the stick.\n\n  The function keeps the environment up\u2011to\u2011date by stepping through the\n  actions as they are generated, so that subsequent planning steps see the\n  correct agent position, direction and inventory.\n  \"\"\"\n  import numpy as np\n  from collections import deque\n\n  # ----------------------------------------------------------------------\n  # Helper: convert a delta (dx,dy) into the corresponding action constant\n  # ----------------------------------------------------------------------\n  def delta_to_action(dx, dy):\n      if dx == 1:\n          return env.RIGHT\n      if dx == -1:\n          return env.LEFT\n      if dy == 1:\n          return env.DOWN\n      if dy == -1:\n          return env.UP\n      raise ValueError(\"Invalid delta for movement\")\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS that returns a list of movement actions taking the agent\n  # from ``start`` to any free cell adjacent to ``target``.\n  # ----------------------------------------------------------------------\n  def bfs_to_adjacent(start, target, grid):\n      H, W = grid.shape[:2]\n      # cells that are blocked (any non\u2011zero entry)\n      blocked = np.any(grid > 0, axis=2)\n\n      # all possible adjacent positions (4\u2011neighbourhood)\n      adjacents = []\n      for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n          ax, ay = target[0] + dx, target[1] + dy\n          if 0 <= ax < H and 0 <= ay < W and not blocked[ax, ay]:\n              adjacents.append((ax, ay))\n\n      # If the agent is already on a valid adjacent cell, no movement needed\n      if start in adjacents:\n          return []\n\n      # BFS\n      q = deque([start])\n      prev = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur in adjacents:\n              # reconstruct path\n              path = []\n              while prev[cur] is not None:\n                  p = prev[cur]\n                  dx = cur[0] - p[0]\n                  dy = cur[1] - p[1]\n                  path.append(delta_to_action(dx, dy))\n                  cur = p\n              path.reverse()\n              return path\n          for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              nx, ny = cur[0] + dx, cur[1] + dy\n              if 0 <= nx < H and 0 <= ny < W and not blocked[nx, ny]:\n                  nxt = (nx, ny)\n                  if nxt not in prev:\n                      prev[nxt] = cur\n                      q.append(nxt)\n      raise RuntimeError(\"No path to target found\")\n\n  # ----------------------------------------------------------------------\n  # Begin main planning\n  # ----------------------------------------------------------------------\n  actions = []\n\n  # current state object (CraftLab keeps the latest state in _current_state)\n  state = env._current_state\n\n  # goal index for \"stick\"\n  stick_idx = env.world.cookbook.index[\"stick\"]\n  # recipe dict for stick\n  recipe = env.world.cookbook.recipes[stick_idx]\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives\n  # ------------------------------------------------------------------\n  # primitives_for returns a dict {primitive_idx: count}\n  needed = env.world.cookbook.primitives_for(stick_idx)\n\n  for prim_idx, required_cnt in needed.items():\n      # keep collecting until we have enough of this primitive\n      while state.inventory[prim_idx] < required_cnt:\n          # locate any cell that currently contains the primitive\n          locations = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if locations.size == 0:\n              raise RuntimeError(\n                  f\"Required primitive (index {prim_idx}) not present on grid\"\n              )\n          # pick the closest one (Manhattan distance)\n          cur_pos = np.array(state.pos)\n          dists = np.sum(np.abs(locations - cur_pos), axis=1)\n          target_cell = tuple(locations[dists.argmin()])\n\n          # move to a free adjacent cell\n          move_actions = bfs_to_adjacent(state.pos, target_cell, state.grid)\n          for a in move_actions:\n              actions.append(a)\n              _, _, _ = env.step(a)          # update env/state\n              state = env._current_state\n\n          # now we are adjacent \u2013 use the primitive\n          actions.append(env.USE)\n          _, _, _ = env.step(env.USE)\n          state = env._current_state\n\n  # ------------------------------------------------------------------\n  # 2. Go to the required workshop and craft the stick\n  # ------------------------------------------------------------------\n  workshop_name = recipe[\"_at\"]\n  workshop_idx = env.world.cookbook.index[workshop_name]\n\n  # locate the workshop cell (there should be exactly one)\n  wk_locations = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if wk_locations.size == 0:\n      raise RuntimeError(f\"Workshop '{workshop_name}' not found on grid\")\n  workshop_cell = tuple(wk_locations[0])\n\n  # move adjacent to workshop\n  move_actions = bfs_to_adjacent(state.pos, workshop_cell, state.grid)\n  for a in move_actions:\n      actions.append(a)\n      _, _, _ = env.step(a)\n      state = env._current_state\n\n  # use to craft the stick\n  actions.append(env.USE)\n  _, _, _ = env.step(env.USE)\n  state = env._current_state\n\n  # Return the complete action sequence\n  return actions", "env_interactions": 0, "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-10-15T18:33:02.273825", "function_name": "make_stick", "function_body": "  \"\"\"\n  Return a list of actions that will collect the necessary primitives and craft a\n  ``stick`` in the given CraftLab environment.\n\n  The implementation is generic \u2013 it does not rely on a particular map layout.\n  It queries the world\u2019s ``Cookbook`` for the recipe, locates the required\n  primitive items and the appropriate workshop, and then generates a simple\n  Manhattan\u2011style plan (move horizontally, then vertically) to fetch the items\n  and finally craft the stick.\n\n  Parameters\n  ----------\n  env : CraftLab\n      An instantiated CraftLab environment (already reset).\n\n  Returns\n  -------\n  List[int]\n      Sequence of action indices that can be fed to ``env.step`` to complete\n      the task.\n  \"\"\"\n  # --------------------------------------------------------------------- #\n  # Helper utilities\n  # --------------------------------------------------------------------- #\n  import numpy as np\n\n  # Mapping from action name to integer index (the env provides this dict)\n  ACTIONS = env.action_specs()\n  DOWN = ACTIONS[\"DOWN\"]\n  UP   = ACTIONS[\"UP\"]\n  LEFT = ACTIONS[\"LEFT\"]\n  RIGHT= ACTIONS[\"RIGHT\"]\n  USE  = ACTIONS[\"USE\"]\n\n  # --------------------------------------------------------------------- #\n  # 1. Identify the goal (stick) and its recipe\n  # --------------------------------------------------------------------- #\n  # The name used in the recipe file is assumed to be ``stick``.\n  goal_name = \"stick\"\n  try:\n      goal_idx = env.world.cookbook.index[goal_name]\n  except Exception as exc:                     # pragma: no cover\n      raise ValueError(f\"Goal '{goal_name}' not found in cookbook.\") from exc\n\n  # ``primitives_for`` returns a dict {primitive_idx: count}\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)\n\n  # The workshop where the stick must be crafted is stored under the\n  # ``_at`` key of the recipe.\n  workshop_kind = None\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  if \"_at\" in recipe:\n      workshop_kind = recipe[\"_at\"]\n  else:                                        # pragma: no cover\n      raise ValueError(f\"Recipe for '{goal_name}' does not specify a workshop.\")\n\n  # --------------------------------------------------------------------- #\n  # 2. Locate entities on the current grid\n  # --------------------------------------------------------------------- #\n  def find_nearest(grid, kind):\n      \"\"\"Return the Manhattan\u2011closest cell that contains ``kind`` (or None).\"\"\"\n      positions = np.argwhere(grid[:, :, kind] > 0)\n      if positions.size == 0:\n          return None\n      cur_pos = np.array(env._current_state.pos)\n      # Manhattan distance\n      dists = np.abs(positions - cur_pos).sum(axis=1)\n      return tuple(positions[dists.argmin()])\n\n  # --------------------------------------------------------------------- #\n  # 3. Generate a movement plan to a target cell (simple horiz\u2011then\u2011vert)\n  # --------------------------------------------------------------------- #\n  def plan_path(start, target):\n      \"\"\"Yield actions to move from ``start`` to ``target``.\"\"\"\n      y, x = start          # grid is (row, col) == (y, x)\n      ty, tx = target\n      # Horizontal moves (left/right)\n      while x < tx:\n          yield RIGHT\n          x += 1\n      while x > tx:\n          yield LEFT\n          x -= 1\n      # Vertical moves (down/up)\n      while y < ty:\n          yield DOWN\n          y += 1\n      while y > ty:\n          yield UP\n          y -= 1\n\n  # --------------------------------------------------------------------- #\n  # 4. Assemble the full action list\n  # --------------------------------------------------------------------- #\n  actions = []\n\n  # Helper to move to a location and optionally USE\n  def go_and_use(pos, use=False):\n      nonlocal actions\n      actions.extend(plan_path(env._current_state.pos, pos))\n      if use:\n          actions.append(USE)\n\n  # --------------------------------------------------------------------- #\n  # 5. Collect each required primitive\n  # --------------------------------------------------------------------- #\n  for prim_idx, count in primitives_needed.items():\n      for _ in range(count):\n          # Find the nearest instance of the primitive\n          target = find_nearest(env._current_state.grid, prim_idx)\n          if target is None:                     # pragma: no cover\n              raise RuntimeError(f\"Cannot find required primitive (idx={prim_idx}).\")\n          go_and_use(target, use=True)\n          # Simulate the steps so that subsequent calls see the updated state\n          for a in actions[-(len(list(plan_path(env._current_state.pos, target)))+1):]:\n              _, _ = env.step(a)\n\n  # --------------------------------------------------------------------- #\n  # 6. Move to the workshop and craft the stick\n  # --------------------------------------------------------------------- #\n  workshop_pos = find_nearest(env._current_state.grid, workshop_kind)\n  if workshop_pos is None:                     # pragma: no cover\n      raise RuntimeError(\"Workshop for stick not found on the map.\")\n  go_and_use(workshop_pos, use=True)\n\n  # The actions list now contains a full plan; we return it without executing\n  # the final USE (the caller may wish to execute it step\u2011by\u2011step).\n  return actions", "env_interactions": 0, "island_id": 7, "scores": {"3": -1}}
