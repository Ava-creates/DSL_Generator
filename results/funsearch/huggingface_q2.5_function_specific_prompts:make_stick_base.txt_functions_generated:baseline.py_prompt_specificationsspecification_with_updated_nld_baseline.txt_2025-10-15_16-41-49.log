{"timestamp": "2025-10-15T16:58:43.108318", "function_name": "make_stick", "function_body": "  \"\"\"\n  Generate a list of actions that makes a ``stick`` in the given CraftWorld\n  environment.\n\n  The function works for any ``CraftLab`` / ``CraftWorld`` environment that\n  follows the API described in the prompt.  It performs a very simple\n  \u201cgo\u2011to\u2011resource \u2192 collect \u2192 go\u2011to\u2011workshop \u2192 craft\u201d loop:\n\n  1.  Look up the index of the goal item (``stick``) in the world\u2019s\n      ``Cookbook``.\n  2.  Determine which primitive kinds are required to craft one stick using\n      ``Cookbook.primitives_for``.\n  3.  Repeatedly move the agent until it has collected all required primitives.\n  4.  Move the agent to the workshop required for the ``stick`` recipe and\n      perform the ``USE`` action to craft the item.\n  5.  Stop as soon as the inventory contains at least one ``stick`` or a\n      safety step limit is reached.\n\n  The returned list contains integer action IDs that can be fed directly to\n  ``env.step(action)``.\n  \"\"\"\n  # --------------------------------------------------------------------- #\n  # Helper utilities\n  # --------------------------------------------------------------------- #\n  def _action_id(name):\n      \"\"\"Translate action name (e.g. 'UP') to the integer ID used by the env.\"\"\"\n      return env.action_specs()[name]\n\n  ACTION_UP = _action_id(\"UP\")\n  ACTION_DOWN = _action_id(\"DOWN\")\n  ACTION_LEFT = _action_id(\"LEFT\")\n  ACTION_RIGHT = _action_id(\"RIGHT\")\n  ACTION_USE = _action_id(\"USE\")\n\n  # Mapping from a direction delta to the corresponding action ID\n  DIR_TO_ACTION = {\n      (0, -1): ACTION_UP,\n      (0, 1): ACTION_DOWN,\n      (-1, 0): ACTION_LEFT,\n      (1, 0): ACTION_RIGHT,\n  }\n\n  # --------------------------------------------------------------------- #\n  # Initialise the environment and obtain static information\n  # --------------------------------------------------------------------- #\n  # Reset the environment to obtain the initial state\n  obs = env.reset()\n  state = env._current_state                     # type: CraftState\n  world = env.world                               # type: CraftWorld\n  cookbook = world.cookbook\n\n  # Index of the goal item (stick)\n  stick_idx = cookbook.index[\"stick\"]\n\n  # Primitive requirements for a single stick (dict {kind_idx: count})\n  primitive_reqs = cookbook.primitives_for(stick_idx)\n\n  # Identify the workshop required for the stick recipe.\n  # The recipe dict contains a special key \"_at\" that stores the workshop name.\n  workshop_name = cookbook.recipes[stick_idx].get(\"_at\")\n  if workshop_name is None:\n      # Fallback \u2013 if the recipe does not specify a workshop, we assume the\n      # workshop is the same as the goal name (many recipes follow that\n      # convention).\n      workshop_name = \"workshop\"\n  workshop_idx = cookbook.index[workshop_name]\n\n  # --------------------------------------------------------------------- #\n  # Simple path\u2011finding utilities\n  # --------------------------------------------------------------------- #\n  def _find_nearest(kind_idx):\n      \"\"\"\n      Return the (x, y) coordinate of the closest cell that contains an\n      entity of ``kind_idx``.  If none are present, return ``None``.\n      \"\"\"\n      positions = np.argwhere(state.grid[:, :, kind_idx] > 0)\n      if positions.size == 0:\n          return None\n      # Manhattan distance to the agent\n      dists = np.abs(positions[:, 0] - state.pos[0]) + np.abs(positions[:, 1] - state.pos[1])\n      nearest = positions[np.argmin(dists)]\n      return tuple(nearest.tolist())\n\n  def _move_towards(target):\n      \"\"\"\n      Produce a single movement action that brings the agent one step closer\n      to ``target`` (a tuple ``(x, y)``).  If the agent is already on the target\n      cell, ``None`` is returned.\n      \"\"\"\n      if target is None or state.pos == target:\n          return None\n      dx = target[0] - state.pos[0]\n      dy = target[1] - state.pos[1]\n\n      # Prefer horizontal movement if both axes differ\n      if dx != 0:\n          step = (np.sign(dx), 0)\n      else:\n          step = (0, np.sign(dy))\n\n      return DIR_TO_ACTION[step]\n\n  # --------------------------------------------------------------------- #\n  # Main planning loop\n  # --------------------------------------------------------------------- #\n  actions = []\n  MAX_STEPS = 1000                     # safety guard to avoid infinite loops\n\n  while len(actions) < MAX_STEPS:\n      # 1. Check if we already have a stick \u2192 finish\n      if state.inventory[stick_idx] > 0:\n          break\n\n      # 2. Determine which primitive we still need\n      needed = {}\n      for kind_idx, cnt in primitive_reqs.items():\n          have = state.inventory[kind_idx]\n          if have < cnt:\n              needed[kind_idx] = cnt - have\n\n      # 3. If we still need primitives, head towards the nearest missing one\n      if needed:\n          # Pick the primitive with the smallest Manhattan distance\n          nearest_kind = min(needed.keys(),\n                             key=lambda k: np.min(\n                                 np.abs(np.argwhere(state.grid[:, :, k] > 0) -\n                                        np.array(state.pos)).sum(axis=1)\n                                 if np.argwhere(state.grid[:, :, k] > 0).size else 1e9))\n          target_pos = _find_nearest(nearest_kind)\n\n          # If we are already adjacent (including the same cell) to the primitive,\n          # use the USE action to collect it.\n          if target_pos is not None and state.next_to(nearest_kind):\n              actions.append(ACTION_USE)\n              reward, new_state = state.step(ACTION_USE)\n              state = new_state\n              continue\n\n          # Otherwise, move one step towards it.\n          move_action = _move_towards(target_pos)\n          if move_action is not None:\n              actions.append(move_action)\n              reward, new_state = state.step(move_action)\n              state = new_state\n              continue\n          else:\n              # No reachable primitive \u2013 break to avoid deadlock.\n              break\n      else:\n          # 4. All primitives collected \u2013 go to the workshop and craft.\n          workshop_pos = _find_nearest(workshop_idx)\n\n          # If we are next to the workshop, craft the stick.\n          if workshop_pos is not None and state.next_to(workshop_idx):\n              actions.append(ACTION_USE)\n              reward, new_state = state.step(ACTION_USE)\n              state = new_state\n              continue\n\n          # Otherwise, move towards the workshop.\n          move_action = _move_towards(workshop_pos)\n          if move_action is not None:\n              actions.append(move_action)\n              reward, new_state = state.step(move_action)\n              state = new_state\n              continue\n          else:\n              # No workshop found \u2013 abort.\n              break\n\n  return actions", "env_interactions": 0, "island_id": 5, "scores": {"3": -1}}
