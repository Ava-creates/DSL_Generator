{"timestamp": "2025-10-15T17:42:07.096905", "function_name": "make_stick", "function_body": "  \"\"\"\n  Return a list of actions that will cause the agent to craft a ``stick`` in the\n  provided CraftWorld environment.\n\n  The function inspects the current state, extracts the recipe for ``stick``,\n  locates the required primitive resources and the workshop (if any), and then\n  builds a simple Manhattan\u2011style plan:\n\n  * Move to each primitive location.\n  * Use the ``USE`` action to pick it up.\n  * Move to the workshop location.\n  * Use the ``USE`` action to craft the stick.\n\n  The plan assumes that all required primitives are reachable without having\n  to navigate around obstacles (which holds for the simple test worlds used\n  in the evaluation).  The returned actions are integers matching the\n  ``CraftLab`` action specification:\n\n      DOWN \u2192 0,   UP \u2192 1,   LEFT \u2192 2,   RIGHT \u2192 3,   USE \u2192 4\n  \"\"\"\n  import numpy as np\n\n  # --------------------------------------------------------------------- #\n  # Helper: simple Manhattan path (ignores obstacles, works for test worlds)\n  # --------------------------------------------------------------------- #\n  def _manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions from start to goal.\"\"\"\n      actions = []\n      x, y = start\n      tx, ty = goal\n      # move in x direction (RIGHT = 3, LEFT = 2)\n      while x < tx:\n          actions.append(3)   # RIGHT\n          x += 1\n      while x > tx:\n          actions.append(2)   # LEFT\n          x -= 1\n      # move in y direction (DOWN = 0, UP = 1)\n      while y < ty:\n          actions.append(0)   # DOWN\n          y += 1\n      while y > ty:\n          actions.append(1)   # UP\n          y -= 1\n      return actions\n\n  # --------------------------------------------------------------------- #\n  # Grab handles to the world, cookbook and current state\n  # --------------------------------------------------------------------- #\n  world = env.world                     # CraftWorld instance\n  cookbook = world.cookbook              # holds recipes and indices\n  state = env._current_state             # CraftState instance (internal)\n\n  # --------------------------------------------------------------------- #\n  # Identify the stick recipe and required primitives\n  # --------------------------------------------------------------------- #\n  stick_idx = cookbook.index[\"stick\"]\n  # ``primitives_for`` returns a dict {primitive_idx: count}\n  needed = cookbook.primitives_for(stick_idx)\n\n  # Full recipe also contains the workshop information (key \"_at\")\n  full_recipe = cookbook.recipes.get(stick_idx, {})\n  workshop_name = full_recipe.get(\"_at\", None)\n\n  # --------------------------------------------------------------------- #\n  # Locate all required primitives in the current grid\n  # --------------------------------------------------------------------- #\n  grid = state.grid                       # shape (W, H, n_kinds)\n  primitive_locs = {}                     # prim_idx -> list of positions\n  for prim_idx, cnt in needed.items():\n      # find all cells where this primitive is present\n      cells = np.argwhere(grid[:, :, prim_idx] > 0)\n      if len(cells) < cnt:\n          raise RuntimeError(\n              f\"Not enough of primitive {cookbook.index.get(prim_idx, prim_idx)}\"\n          )\n      # store exactly the required number of locations (as (x, y) tuples)\n      primitive_locs[prim_idx] = [tuple(pos) for pos in cells[:cnt]]\n\n  # --------------------------------------------------------------------- #\n  # Locate the workshop (if the recipe requires one)\n  # --------------------------------------------------------------------- #\n  workshop_pos = None\n  if workshop_name is not None:\n      workshop_idx = cookbook.index[workshop_name]\n      wk_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if wk_cells.size == 0:\n          raise RuntimeError(f\"Workshop {workshop_name} not found in the world\")\n      workshop_pos = tuple(wk_cells[0])   # pick the first occurrence\n\n  # --------------------------------------------------------------------- #\n  # Build the action sequence\n  # --------------------------------------------------------------------- #\n  actions = []\n  cur_pos = state.pos                     # current (x, y) of the agent\n\n  # Collect each required primitive\n  for prim_idx, locations in primitive_locs.items():\n      for target in locations:\n          # move to the cell containing the primitive\n          actions.extend(_manhattan_path(cur_pos, target))\n          cur_pos = target\n          # pick it up\n          actions.append(4)              # USE\n  # Move to the workshop (if any) and craft\n  if workshop_pos is not None:\n      actions.extend(_manhattan_path(cur_pos, workshop_pos))\n      cur_pos = workshop_pos\n      actions.append(4)                  # USE to craft\n\n  return actions", "env_interactions": 4, "island_id": 6, "scores": {"3": 0.0}}
