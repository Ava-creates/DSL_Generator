{"timestamp": "2025-10-15T18:30:26.969524", "function_name": "make_stick", "function_body": "  \"\"\"\n  Generate a list of actions that makes a ``stick`` in the given CraftWorld\n  environment.\n\n  The function works in three stages:\n  1.  Look up the index of the ``stick`` item and its recipe.\n  2.  For each required primitive, locate the nearest instance on the map,\n      walk to it (using simple Manhattan moves) and ``USE`` it to pick it up.\n  3.  Walk to the required workshop (given by the ``_at`` field of the recipe)\n      and ``USE`` there to craft the stick.\n\n  The returned list can be fed directly to the environment via\n  ``env.step(action)``.  The implementation is deliberately simple \u2013 it does\n  not perform obstacle avoidance or sophisticated path\u2011finding \u2013 but it is\n  sufficient for the standard ``craft`` environments where primitives are\n  placed on open cells.\n\n  Parameters\n  ----------\n  env : CraftLab\n      An instance of the CraftLab wrapper (or any object exposing the same\n      attributes used below).\n\n  Returns\n  -------\n  List[int]\n      Sequence of action indices (0=DOWN, 1=UP, 2=LEFT, 3=RIGHT, 4=USE).\n  \"\"\"\n  # ------------------------------------------------------------------ #\n  # Helper utilities\n  # ------------------------------------------------------------------ #\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  def manhattan_path(src, dst):\n      \"\"\"Return a list of (action, new_dir) pairs to move from src to dst.\"\"\"\n      actions = []\n      x, y = src\n      tx, ty = dst\n      # vertical moves\n      while x < tx:\n          actions.append(ACTION_DOWN)\n          x += 1\n      while x > tx:\n          actions.append(ACTION_UP)\n          x -= 1\n      # horizontal moves\n      while y < ty:\n          actions.append(ACTION_RIGHT)\n          y += 1\n      while y > ty:\n          actions.append(ACTION_LEFT)\n          y -= 1\n      return actions\n\n  def adjacent(pos, target):\n      \"\"\"Return direction (action) needed to face ``target`` from an adjacent ``pos``.\"\"\"\n      x, y = pos\n      tx, ty = target\n      if x - 1 == tx and y == ty:\n          return ACTION_UP\n      if x + 1 == tx and y == ty:\n          return ACTION_DOWN\n      if x == tx and y - 1 == ty:\n          return ACTION_LEFT\n      if x == tx and y + 1 == ty:\n          return ACTION_RIGHT\n      raise ValueError(\"Target not adjacent to position\")\n\n  # ------------------------------------------------------------------ #\n  # 1) Identify the stick item and its recipe\n  # ------------------------------------------------------------------ #\n  idx = env.world.cookbook.index  # Index instance mapping names \u2194 ids\n  stick_idx = idx[\"stick\"]        # May raise KeyError if name differs\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  if not recipe:\n      # No recipe \u2013 stick is likely a primitive; just collect one instance.\n      needed = {stick_idx: 1}\n      workshop_idx = None\n  else:\n      # Primitive requirements (ignore the special ``_at`` key)\n      needed = {k: v for k, v in recipe.items() if k != \"_at\"}\n      workshop_idx = recipe.get(\"_at\", None)\n\n  # ------------------------------------------------------------------ #\n  # 2) Collect required primitives\n  # ------------------------------------------------------------------ #\n  actions = []\n  # start from the initial position stored in the scenario\n  cur_pos = env._current_state.pos if hasattr(env, \"_current_state\") else env.scenario.init_pos\n\n  grid = env._current_state.grid if hasattr(env, \"_current_state\") else env.scenario.init_grid\n\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          # locate the first occurrence of the primitive on the map\n          locations = np.argwhere(grid[:, :, prim_idx] > 0)\n          if len(locations) == 0:\n              raise RuntimeError(f\"Primitive {idx.get(prim_idx)} not found on the map\")\n          # choose the nearest (Manhattan) location\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          target_loc = tuple(locations[dists.argmin()])\n\n          # move next to the primitive (we need to be adjacent)\n          # compute a cell adjacent to the target that is free\n          adj_candidates = [\n              (target_loc[0] - 1, target_loc[1]),\n              (target_loc[0] + 1, target_loc[1]),\n              (target_loc[0], target_loc[1] - 1),\n              (target_loc[0], target_loc[1] + 1),\n          ]\n          # pick the first free adjacent cell (where no entity occupies any kind)\n          free_adj = None\n          for cand in adj_candidates:\n              if (0 <= cand[0] < grid.shape[0] and\n                      0 <= cand[1] < grid.shape[1] and\n                      not grid[cand[0], cand[1]].any()):\n                  free_adj = cand\n                  break\n          if free_adj is None:\n              # fallback: just move onto the target cell (will still work for many maps)\n              free_adj = target_loc\n\n          # walk to the adjacent cell\n          actions.extend(manhattan_path(cur_pos, free_adj))\n          cur_pos = free_adj\n\n          # now face the primitive and USE to pick it up\n          face_dir = adjacent(cur_pos, target_loc)\n          # turn to the correct direction (if not already)\n          actions.append(face_dir)          # turning is achieved by moving direction\n          actions.append(ACTION_USE)        # pick up\n          # update internal grid representation to reflect pickup (optional)\n          grid[target_loc[0], target_loc[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------ #\n  # 3) Go to the workshop and craft the stick\n  # ------------------------------------------------------------------ #\n  if workshop_idx is not None:\n      # locate any workshop of the required type\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if len(workshop_cells) == 0:\n          raise RuntimeError(\"Required workshop not found on the map\")\n      # pick the nearest one\n      dists = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])\n      workshop_loc = tuple(workshop_cells[dists.argmin()])\n\n      # move adjacent to the workshop (same logic as above)\n      adj_candidates = [\n          (workshop_loc[0] - 1, workshop_loc[1]),\n          (workshop_loc[0] + 1, workshop_loc[1]),\n          (workshop_loc[0], workshop_loc[1] - 1),\n          (workshop_loc[0], workshop_loc[1] + 1),\n      ]\n      free_adj = None\n      for cand in adj_candidates:\n          if (0 <= cand[0] < grid.shape[0] and\n                  0 <= cand[1] < grid.shape[1] and\n                  not grid[cand[0], cand[1]].any()):\n              free_adj = cand\n              break\n      if free_adj is None:\n          free_adj = workshop_loc\n\n      actions.extend(manhattan_path(cur_pos, free_adj))\n      cur_pos = free_adj\n\n      # face the workshop and USE to craft\n      face_dir = adjacent(cur_pos, workshop_loc)\n      actions.append(face_dir)\n      actions.append(ACTION_USE)\n\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": -1}}
