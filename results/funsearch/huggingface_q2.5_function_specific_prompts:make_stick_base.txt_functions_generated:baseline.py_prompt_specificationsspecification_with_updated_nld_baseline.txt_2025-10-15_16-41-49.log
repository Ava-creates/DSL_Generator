{"timestamp": "2025-10-15T17:56:11.307846", "function_name": "make_stick", "function_body": "  \"\"\"\n  Generate a list of actions that makes a ``stick`` in the given Craft\n  environment.\n\n  The function works for any recipe that uses only primitive resources and\n  a single workshop (the usual case for the ``stick`` recipe).  It follows\n  these steps:\n\n  1.  Reset the environment and obtain the current ``CraftState``.\n  2.  Determine the index of the goal item (``stick``) and the set of\n      primitive resources required to craft it.\n  3.  For each required primitive, locate a cell that contains the resource,\n      navigate to a neighbouring cell that faces the resource and ``USE`` it\n      to pick it up.\n  4.  Locate the appropriate workshop, navigate to it (facing the workshop)\n      and ``USE`` to craft the stick.\n  5.  Return the concatenated list of actions.\n\n  The implementation is deliberately generic \u2013 it does not rely on any\n  hard\u2011coded coordinates or on the exact names of the primitives.  It only\n  uses the public API of ``CraftWorld``, ``Cookbook`` and ``CraftState``.\n  \"\"\"\n  import collections\n\n  # --------------------------------------------------------------------- #\n  # Helper utilities\n  # --------------------------------------------------------------------- #\n  # Directions as (dx, dy) in grid coordinates (row, col)\n  DIRS = {\n      \"UP\":    (-1, 0),\n      \"DOWN\":  (1, 0),\n      \"LEFT\":  (0, -1),\n      \"RIGHT\": (0, 1),\n  }\n  # Map direction name to the integer action id used by the environment\n  ACTIONS = env.action_specs()          # e.g. {\"UP\":0, \"DOWN\":1, ...}\n  USE = ACTIONS[\"USE\"]\n\n  # --------------------------------------------------------------------- #\n  # Breadth\u2011first search that returns a list of actions to move from ``src``\n  # to ``dst`` (both are (row, col) tuples).  The path does **not** include a\n  # final USE action.\n  # --------------------------------------------------------------------- #\n  def bfs_path(src, dst, occ_grid):\n      \"\"\"Return a list of movement actions (no USE) from src to dst.\"\"\"\n      if src == dst:\n          return []\n\n      H, W = occ_grid.shape\n      q = collections.deque([src])\n      visited = {src: None}\n      move_dir = {}\n\n      while q:\n          cur = q.popleft()\n          if cur == dst:\n              break\n          for name, (dx, dy) in DIRS.items():\n              nxt = (cur[0] + dx, cur[1] + dy)\n              if not (0 <= nxt[0] < H and 0 <= nxt[1] < W):\n                  continue\n              if occ_grid[nxt] != 0:          # blocked cell\n                  continue\n              if nxt not in visited:\n                  visited[nxt] = cur\n                  move_dir[nxt] = name\n                  q.append(nxt)\n\n      # reconstruct path\n      if dst not in visited:\n          raise RuntimeError(\"No path found\")\n      path = []\n      cur = dst\n      while cur != src:\n          name = move_dir[cur]\n          path.append(ACTIONS[name])\n          cur = visited[cur]\n      path.reverse()\n      return path\n\n  # --------------------------------------------------------------------- #\n  # Find a cell that contains ``kind_idx`` (primitive or workshop).  If there\n  # are several, pick the first one found.\n  # --------------------------------------------------------------------- #\n  def locate_kind(grid, kind_idx):\n      \"\"\"Return (row, col) of a cell that contains the given kind, or None.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if len(locations) == 0:\n          return None\n      return tuple(locations[0])\n\n  # --------------------------------------------------------------------- #\n  # Given a target cell, compute a neighbour cell from which the agent can\n  # ``USE`` it and also return the direction that the agent must be facing\n  # when standing on that neighbour.\n  # --------------------------------------------------------------------- #\n  def neighbour_facing(target, occ_grid):\n      \"\"\"Return (neighbour_pos, needed_dir_name) suitable for a USE.\"\"\"\n      H, W = occ_grid.shape\n      for name, (dx, dy) in DIRS.items():\n          nb = (target[0] - dx, target[1] - dy)   # cell from which we look *to* target\n          if 0 <= nb[0] < H and 0 <= nb[1] < W and occ_grid[nb] == 0:\n              # needed_dir is the direction from neighbour to target\n              needed_dir = name\n              return nb, needed_dir\n      raise RuntimeError(\"No free neighbour to interact with %s\" % (target,))\n\n  # --------------------------------------------------------------------- #\n  # Ensure that after moving to ``pos`` the agent is facing ``desired_dir``.\n  # If the last move already gives the correct direction we are done.\n  # Otherwise we perform a small \u201cturn\u201d by stepping to an adjacent free cell\n  # and stepping back.\n  # --------------------------------------------------------------------- #\n  def ensure_facing(state_pos, state_dir, target_pos, desired_dir, occ_grid):\n      \"\"\"\n      Return a list of actions that ends with the agent at ``target_pos``\n      facing ``desired_dir``.\n      \"\"\"\n      # ``state_dir`` is the direction the agent is currently facing.\n      # It is stored as an int (action id) \u2013 we translate it back to a name.\n      rev_action = {v: k for k, v in ACTIONS.items()}\n      cur_dir_name = rev_action.get(state_dir, None)\n\n      if cur_dir_name == desired_dir:\n          return []          # already correct\n\n      # Find a free adjacent cell (different from target_pos) to step to.\n      for name, (dx, dy) in DIRS.items():\n          tmp = (target_pos[0] + dx, target_pos[1] + dy)\n          if (0 <= tmp[0] < occ_grid.shape[0] and\n              0 <= tmp[1] < occ_grid.shape[1] and\n              occ_grid[tmp] == 0 and tmp != state_pos):\n              # step to tmp, then back; the second move will set the direction\n              # to the opposite of the first move, which is exactly what we need.\n              first = ACTIONS[name]\n              # direction opposite to ``name``\n              opposite = {\n                  \"UP\": \"DOWN\", \"DOWN\": \"UP\",\n                  \"LEFT\": \"RIGHT\", \"RIGHT\": \"LEFT\"\n              }[name]\n              second = ACTIONS[opposite]\n              return [first, second]\n      # If we cannot find a turning spot we just return an empty list \u2013 the\n      # environment will simply attempt the USE; in most maps this case does\n      # not happen.\n      return []\n\n  # --------------------------------------------------------------------- #\n  # Main logic starts here\n  # --------------------------------------------------------------------- #\n  # 1. reset environment\n  obs = env.reset()\n  state = env._current_state          # type: CraftState\n\n  # 2. identify goal index for \"stick\"\n  stick_idx = state.world.cookbook.index[\"stick\"]\n\n  # 3. determine required primitives and the workshop\n  recipe = state.world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      raise RuntimeError(\"Stick recipe does not specify a workshop\")\n  workshop_idx = state.world.cookbook.index[workshop_name]\n\n  # primitive requirements (exclude the special keys)\n  primitive_reqs = {\n      k: v for k, v in recipe.items()\n      if k != \"_at\"\n  }\n\n  actions = []\n\n  # ----------------------------------------------------------------- #\n  # Helper to keep track of the mutable state (position, direction,\n  # inventory, and occupancy grid) while we plan.\n  # ----------------------------------------------------------------- #\n  pos = state.pos\n  dir_facing = state.dir\n  inventory = state.inventory.copy()\n  occ_grid = (state.grid.sum(axis=2) > 0).astype(np.int8)   # 1 = blocked, 0 = free\n\n  # ----------------------------------------------------------------- #\n  # 4. collect each required primitive\n  # ----------------------------------------------------------------- #\n  for prim_idx, count_needed in primitive_reqs.items():\n      while inventory[prim_idx] < count_needed:\n          # locate a cell that still has the primitive\n          prim_loc = locate_kind(state.grid, prim_idx)\n          if prim_loc is None:\n              raise RuntimeError(\"Required primitive not present in the world\")\n\n          # find a free neighbour from which we can pick it up\n          neigh, needed_dir = neighbour_facing(prim_loc, occ_grid)\n\n          # plan path to neighbour\n          path = bfs_path(pos, neigh, occ_grid)\n          actions.extend(path)\n\n          # update mutable state according to the path\n          for a in path:\n              # translate action back to direction name\n              a_name = rev_action[a]\n              dx, dy = DIRS[a_name]\n              pos = (pos[0] + dx, pos[1] + dy)\n              dir_facing = a\n\n          # ensure we are facing the primitive\n          turn_actions = ensure_facing(pos, dir_facing, neigh, needed_dir, occ_grid)\n          actions.extend(turn_actions)\n          for a in turn_actions:\n              a_name = rev_action[a]\n              dx, dy = DIRS[a_name]\n              pos = (pos[0] + dx, pos[1] + dy)\n              dir_facing = a\n\n          # finally USE to pick it up\n          actions.append(USE)\n          # simulate the effect on inventory and grid\n          inventory[prim_idx] += int(state.grid[prim_loc[0], prim_loc[1], prim_idx])\n          state.grid[prim_loc[0], prim_loc[1], prim_idx] = 0\n          occ_grid[prim_loc] = 0   # now the cell is free\n\n  # ----------------------------------------------------------------- #\n  # 5. go to the workshop and craft the stick\n  # ----------------------------------------------------------------- #\n  workshop_loc = locate_kind(state.grid, workshop_idx)\n  if workshop_loc is None:\n      raise RuntimeError(\"Workshop for stick not found\")\n\n  neigh, needed_dir = neighbour_facing(workshop_loc, occ_grid)\n  path = bfs_path(pos, neigh, occ_grid)\n  actions.extend(path)\n  for a in path:\n      a_name = rev_action[a]\n      dx, dy = DIRS[a_name]\n      pos = (pos[0] + dx, pos[1] + dy)\n      dir_facing = a\n\n  turn_actions = ensure_facing(pos, dir_facing, neigh, needed_dir, occ_grid)\n  actions.extend(turn_actions)\n  for a in turn_actions:\n      a_name = rev_action[a]\n      dx, dy = DIRS[a_name]\n      pos = (pos[0] + dx, pos[1] + dy)\n      dir_facing = a\n\n  # USE to craft\n  actions.append(USE)\n\n  # ----------------------------------------------------------------- #\n  # Return the complete action list\n  # ----------------------------------------------------------------- #\n  return actions", "env_interactions": 0, "island_id": 7, "scores": {"3": -1}}
