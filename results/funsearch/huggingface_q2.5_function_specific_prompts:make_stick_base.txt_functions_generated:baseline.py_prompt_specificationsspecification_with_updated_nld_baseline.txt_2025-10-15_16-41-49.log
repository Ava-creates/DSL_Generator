{"timestamp": "2025-10-15T20:07:54.913484", "function_name": "make_stick", "function_body": "  \"\"\"\n  Generate a sequence of low\u2011level actions that makes a ``stick`` in the\n  provided CraftWorld environment.\n\n  The function works for any environment that follows the specification\n  described in the prompt.  It:\n    1. Resets the environment and obtains the internal ``CraftState``.\n    2. Looks up the recipe for ``stick`` (including required primitives\n       and the workshop where crafting must occur).\n    3. Walks to each needed primitive, picks it up, and updates a local\n       copy of the grid so that the same instance is not collected twice.\n    4. Walks to the required workshop (if any) and performs the craft\n       action.\n\n  Action indices (as used by the environment):\n      0 \u2013 DOWN   (increase row index)\n      1 \u2013 UP     (decrease row index)\n      2 \u2013 LEFT   (decrease column index)\n      3 \u2013 RIGHT  (increase column index)\n      4 \u2013 USE    (interact with the cell in front of the agent)\n\n  Parameters\n  ----------\n  env : object\n      An instance of ``CraftLab`` (or any wrapper exposing the same API).\n\n  Returns\n  -------\n  list[int]\n      A list of actions that, when executed sequentially in the environment,\n      will result in a ``stick`` appearing in the agent's inventory.\n  \"\"\"\n  import numpy as np\n\n  # ------------------------------------------------------------------\n  # Helper: produce Manhattan\u2011distance actions from src -> tgt.\n  # ------------------------------------------------------------------\n  def _move(src, tgt):\n      \"\"\"Return a list of actions moving from src (row, col) to tgt.\"\"\"\n      actions = []\n      r, c = src\n      tr, tc = tgt\n      while r < tr:\n          actions.append(0)  # DOWN\n          r += 1\n      while r > tr:\n          actions.append(1)  # UP\n          r -= 1\n      while c < tc:\n          actions.append(3)  # RIGHT\n          c += 1\n      while c > tc:\n          actions.append(2)  # LEFT\n          c -= 1\n      return actions\n\n  # ------------------------------------------------------------------\n  # 1. Reset environment and fetch the current state.\n  # ------------------------------------------------------------------\n  _ = env.reset()                     # returns observation dict (ignored)\n  state = env._current_state          # CraftState instance\n\n  # ------------------------------------------------------------------\n  # 2. Look up the stick recipe.\n  # ------------------------------------------------------------------\n  cookbook = env.world.cookbook\n  stick_idx = cookbook.index[\"stick\"]                 # goal kind index\n  primitive_needs = cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n  recipe = cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")                    # workshop kind name\n  workshop_idx = cookbook.index[workshop_name] if workshop_name else None\n\n  # ------------------------------------------------------------------\n  # 3. Collect required primitives.\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = tuple(state.pos)          # (row, col)\n  grid = state.grid.copy()            # mutable copy for planning\n\n  for prim_idx, qty in primitive_needs.items():\n      for _ in range(qty):\n          # locate all cells currently holding this primitive\n          locations = np.argwhere(grid[:, :, prim_idx] > 0)\n          if locations.size == 0:\n              raise RuntimeError(f\"Cannot find primitive index {prim_idx} on map.\")\n          # pick the nearest one (Manhattan distance)\n          dists = np.abs(locations - cur_pos).sum(axis=1)\n          target = tuple(locations[dists.argmin()])\n\n          # move to the primitive cell and pick it up\n          actions.extend(_move(cur_pos, target))\n          actions.append(4)                     # USE to collect\n          cur_pos = target\n\n          # update our planning grid \u2013 the primitive is now in inventory\n          grid[target[0], target[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 4. Go to the workshop (if required) and craft the stick.\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      locations = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if locations.size == 0:\n          raise RuntimeError(\"Required workshop not found on the map.\")\n      dists = np.abs(locations - cur_pos).sum(axis=1)\n      target = tuple(locations[dists.argmin()])\n\n      actions.extend(_move(cur_pos, target))\n      actions.append(4)                     # USE to craft\n      cur_pos = target\n\n  return actions", "env_interactions": 4, "island_id": 5, "scores": {"3": 0.0}}
