{"timestamp": "2025-10-15T17:34:53.865639", "function_name": "make_stick", "function_body": "  \"\"\"\n  Generate a list of actions that makes a ``stick`` in the given CraftLab\n  environment.\n\n  The function works generically:\n  1.  Looks up the recipe for ``stick`` in the world's ``Cookbook``.\n  2.  Collects all required primitive items by moving to the closest cell\n      that contains each primitive and using the ``USE`` action.\n  3.  Moves to the required workshop (specified by ``_at`` in the recipe)\n      and performs ``USE`` again to craft the stick.\n\n  The returned list contains integer action ids defined by the environment:\n      0 \u2013 DOWN, 1 \u2013 UP, 2 \u2013 LEFT, 3 \u2013 RIGHT, 4 \u2013 USE\n  \"\"\"\n  import numpy as np\n\n  # ------------------------------------------------------------------ #\n  # Helper: Manhattan\u2011move from current position to a target position.\n  # ------------------------------------------------------------------ #\n  def move_actions(cur, target):\n      \"\"\"Return a list of movement actions to go from cur -> target.\"\"\"\n      actions = []\n      x, y = cur\n      tx, ty = target\n      # move in x direction\n      while x != tx:\n          if x < tx:\n              actions.append(3)          # RIGHT\n              x += 1\n          else:\n              actions.append(2)          # LEFT\n              x -= 1\n      # move in y direction\n      while y != ty:\n          if y < ty:\n              actions.append(0)          # DOWN\n              y += 1\n          else:\n              actions.append(1)          # UP\n              y -= 1\n      return actions, (x, y)\n\n  # ------------------------------------------------------------------ #\n  # Helper: Find the nearest cell (Manhattan distance) that contains a\n  #         given kind index. Returns (x, y) or None if not present.\n  # ------------------------------------------------------------------ #\n  def nearest_of_kind(state_grid, kind_idx, start_pos):\n      \"\"\"Locate the closest cell containing `kind_idx`.\"\"\"\n      layer = state_grid[:, :, kind_idx]\n      ys, xs = np.where(layer > 0)\n      if len(xs) == 0:\n          return None\n      dists = np.abs(xs - start_pos[0]) + np.abs(ys - start_pos[1])\n      best = np.argmin(dists)\n      return (int(xs[best]), int(ys[best]))\n\n  # ------------------------------------------------------------------ #\n  # Main logic\n  # ------------------------------------------------------------------ #\n  world = env.world\n  cookbook = world.cookbook\n\n  # index of the goal item ``stick``\n  stick_idx = cookbook.index[\"stick\"]\n\n  # recipe dictionary for the stick (ingredients + \"_at\")\n  recipe = cookbook.recipes[stick_idx]\n\n  # ------------------------------------------------------------------ #\n  # 1. Gather required primitives.\n  # ------------------------------------------------------------------ #\n  # primitives are all entries except the special key \"_at\"\n  primitive_requirements = {\n      ing_idx: cnt\n      for ing_idx, cnt in recipe.items()\n      if ing_idx != \"_at\"\n  }\n\n  # current state information\n  state = env._current_state\n  grid = state.grid\n  pos = state.pos                     # (x, y) tuple\n  action_plan = []\n\n  for kind_idx, needed_cnt in primitive_requirements.items():\n      for _ in range(needed_cnt):\n          target = nearest_of_kind(grid, kind_idx, pos)\n          if target is None:\n              # primitive not present \u2013 cannot continue; return what we have.\n              return action_plan\n          moves, pos = move_actions(pos, target)\n          action_plan.extend(moves)\n          # pick up the primitive\n          action_plan.append(4)       # USE\n          # after a successful USE the primitive disappears from the grid;\n          # we do not need to update `grid` here because the environment\n          # will handle it when the actions are executed.\n\n  # ------------------------------------------------------------------ #\n  # 2. Go to the workshop and craft the stick.\n  # ------------------------------------------------------------------ #\n  workshop_name = recipe[\"_at\"]\n  workshop_idx = cookbook.index[workshop_name]\n\n  target = nearest_of_kind(grid, workshop_idx, pos)\n  if target is not None:\n      moves, pos = move_actions(pos, target)\n      action_plan.extend(moves)\n      action_plan.append(4)           # USE to craft the stick\n\n  return action_plan", "env_interactions": 4, "island_id": 8, "scores": {"3": 0.0}}
