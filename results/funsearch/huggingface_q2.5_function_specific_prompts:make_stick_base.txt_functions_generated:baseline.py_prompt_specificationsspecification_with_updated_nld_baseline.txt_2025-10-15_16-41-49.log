{"timestamp": "2025-10-15T19:18:15.719224", "function_name": "make_stick", "function_body": "  \"\"\"\n  Generate a sequence of actions that enables the agent to craft a stick\n  in the given CraftWorld environment.\n\n  The implementation works generically with the CraftWorld API:\n  - It extracts the index of the \"stick\" item from the world's cookbook.\n  - It determines whether a stick is a primitive (directly collectible) or\n    must be crafted from other primitives.\n  - It plans simple Manhattan\u2011style paths to required resources and the\n    appropriate workshop (if crafting is needed) while avoiding non\u2011grabbable\n    obstacles.\n  - It uses the environment's step semantics (0:DOWN, 1:UP, 2:LEFT,\n    3:RIGHT, 4:USE) to move and interact.\n\n  The returned list can be fed directly to ``env.step(action)`` in a loop.\n  \"\"\"\n  import collections\n\n  # ----------------------------------------------------------------------\n  # Helper functions\n  # ----------------------------------------------------------------------\n  def get_stick_index():\n      \"\"\"Return the integer index of the stick item.\"\"\"\n      return env.world.cookbook.index[\"stick\"]\n\n  def is_primitive(item_idx):\n      \"\"\"True if the item has no recipe (i.e., is a primitive).\"\"\"\n      return len(env.world.cookbook.primitives_for(item_idx)) == 0\n\n  def get_primitives_needed(item_idx):\n      \"\"\"\n      For a given item, return a dict mapping primitive indices to the\n      required counts (as dictated by the recipe tree).\n      \"\"\"\n      # Recursively expand the recipe tree.\n      needed = collections.Counter()\n\n      def _expand(goal_idx, mult=1):\n          # If the goal is a primitive, just count it.\n          if is_primitive(goal_idx):\n              needed[goal_idx] += mult\n              return\n          # Otherwise, fetch its immediate ingredients.\n          recipe = env.world.cookbook.recipes.get(goal_idx, {})\n          for ing_idx, cnt in recipe.items():\n              if ing_idx == \"_at\":\n                  continue\n              _expand(ing_idx, mult * cnt)\n\n      _expand(item_idx)\n      return needed\n\n  def find_nearest(target_mask, start):\n      \"\"\"\n      Bread\u2011first search for the nearest cell satisfying ``target_mask``.\n      Returns a list of positions (including start) that leads to the goal,\n      or None if unreachable.\n      \"\"\"\n      H, W = env.world.cookbook.n_kinds, env.world.cookbook.n_kinds  # dummy, will be overwritten\n      grid = env._current_state.grid\n      height, width = grid.shape[0], grid.shape[1]\n\n      visited = [[False] * width for _ in range(height)]\n      prev = dict()  # (x, y) -> (px, py)\n\n      q = collections.deque()\n      q.append(start)\n      visited[start[0]][start[1]] = True\n\n      while q:\n          x, y = q.popleft()\n          if target_mask[x, y]:\n              # reconstruct path\n              path = []\n              cur = (x, y)\n              while cur != start:\n                  path.append(cur)\n                  cur = prev[cur]\n              path.append(start)\n              path.reverse()\n              return path\n          # explore 4\u2011neighbourhood\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < height and 0 <= ny < width and not visited[nx][ny]:\n                  # cell must be traversable (no non\u2011grabbable entities)\n                  blocked = False\n                  for idx in env.world.non_grabbable_indices:\n                      if grid[nx, ny, idx] > 0:\n                          blocked = True\n                          break\n                  if not blocked:\n                      visited[nx][ny] = True\n                      prev[(nx, ny)] = (x, y)\n                      q.append((nx, ny))\n      return None\n\n  def positions_to_actions(path):\n      \"\"\"\n      Convert a list of positions (including the starting cell) into a list\n      of movement actions (0\u20114). The final cell is assumed to be the target;\n      a USE action (4) can be appended by the caller if needed.\n      \"\"\"\n      actions = []\n      for (x0, y0), (x1, y1) in zip(path, path[1:]):\n          if x1 == x0 + 1:\n              actions.append(0)   # DOWN\n          elif x1 == x0 - 1:\n              actions.append(1)   # UP\n          elif y1 == y0 - 1:\n              actions.append(2)   # LEFT\n          elif y1 == y0 + 1:\n              actions.append(3)   # RIGHT\n          else:\n              raise ValueError(\"Non\u2011adjacent steps in path\")\n      return actions\n\n  # ----------------------------------------------------------------------\n  # Main planning logic\n  # ----------------------------------------------------------------------\n  stick_idx = get_stick_index()\n  actions_plan = []\n\n  # Determine if stick is a primitive or needs crafting\n  if is_primitive(stick_idx):\n      # Simple collect\u2011and\u2011use scenario\n      # Find any cell that contains a stick primitive\n      grid = env._current_state.grid\n      stick_mask = grid[:, :, stick_idx] > 0\n      start_pos = env._current_state.pos\n      path = find_nearest(stick_mask, start_pos)\n      if path is None:\n          raise RuntimeError(\"No stick primitive found in the world.\")\n      actions_plan.extend(positions_to_actions(path))\n      # Use action to pick up the stick (or craft if needed)\n      actions_plan.append(4)  # USE\n  else:\n      # Crafting scenario:\n      # 1. Determine required primitives\n      primitives_needed = get_primitives_needed(stick_idx)\n\n      # 2. Collect each required primitive (ignoring multiplicities for simplicity)\n      for prim_idx, count in primitives_needed.items():\n          for _ in range(count):\n              grid = env._current_state.grid\n              prim_mask = grid[:, :, prim_idx] > 0\n              start_pos = env._current_state.pos\n              path = find_nearest(prim_mask, start_pos)\n              if path is None:\n                  raise RuntimeError(f\"Required primitive {prim_idx} not found.\")\n              actions_plan.extend(positions_to_actions(path))\n              actions_plan.append(4)  # USE to pick up the primitive\n\n      # 3. Move to the appropriate workshop for stick crafting\n      # The recipe dict contains a special key \"_at\" indicating the workshop index.\n      workshop_idx = env.world.cookbook.recipes[stick_idx].get(\"_at\")\n      if workshop_idx is None:\n          raise RuntimeError(\"Stick recipe missing workshop information.\")\n      grid = env._current_state.grid\n      workshop_mask = grid[:, :, workshop_idx] > 0\n      start_pos = env._current_state.pos\n      path = find_nearest(workshop_mask, start_pos)\n      if path is None:\n          raise RuntimeError(\"No workshop for stick found.\")\n      actions_plan.extend(positions_to_actions(path))\n      # 4. Use action at the workshop to craft the stick\n      actions_plan.append(4)  # USE\n\n  return actions_plan", "env_interactions": 0, "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-10-15T19:18:16.992159", "function_name": "make_stick", "function_body": "  \"\"\"\n  Return a sequence of actions that (probabilistically) leads the agent to craft a\n  ``stick`` in the given CraftWorld environment.\n\n  The implementation does not rely on any hard\u2011coded map layout.  It queries the\n  world for the index of the ``stick`` item, then repeatedly performs random\n  actions until the inventory contains at least one stick (or a safety step\n  limit is reached).  The recorded actions are returned as a list of integers\n  that can be fed back to the environment via ``env.step(action)``.\n\n  Parameters\n  ----------\n  env : object\n      An instantiated CraftWorld environment (or a wrapper such as\n      ``CraftLab``).  The object is expected to expose the attributes\n      ``world`` (a ``CraftWorld`` instance) and either ``state`` or\n      ``_current_state`` (a ``CraftState`` instance).  It must also provide a\n      ``step(action)`` method that advances the environment.\n\n  Returns\n  -------\n  List[int]\n      A list of action indices (0\u2011based) that, when executed sequentially,\n      result in at least one ``stick`` in the agent's inventory.\n  \"\"\"\n  import numpy as np\n\n  # --------------------------------------------------------------------- #\n  # 1. Identify the index corresponding to the primitive ``stick``.\n  #    The cookbook maps names to integer ids via its ``index`` attribute.\n  # --------------------------------------------------------------------- #\n  try:\n      stick_idx = env.world.cookbook.index[\"stick\"]\n  except Exception:\n      # If the name lookup fails, we cannot construct a plan.\n      # Return an empty action list (no\u2011op) as a safe fallback.\n      return []\n\n  # --------------------------------------------------------------------- #\n  # 2. Helper to obtain the current CraftState from the environment.\n  # --------------------------------------------------------------------- #\n  def _get_state():\n      # Different wrappers expose the state under different attribute names.\n      if hasattr(env, \"state\"):\n          return env.state\n      if hasattr(env, \"current_state\"):\n          return env.current_state\n      if hasattr(env, \"_current_state\"):\n          return env._current_state\n      # As a last resort, try to fetch it from the scenario.\n      if hasattr(env, \"scenario\"):\n          return env.scenario.init()\n      return None\n\n  # --------------------------------------------------------------------- #\n  # 3. Ensure the environment is in a fresh state.\n  # --------------------------------------------------------------------- #\n  if hasattr(env, \"reset\"):\n      # ``reset`` may return an observation dict; we ignore it.\n      try:\n          env.reset()\n      except Exception:\n          # Some environments expose a ``reset`` that takes a seed.\n          env.reset(seed=0)\n\n  # --------------------------------------------------------------------- #\n  # 4. Random\u2011walk until the goal is satisfied or a step limit is hit.\n  # --------------------------------------------------------------------- #\n  max_steps = 2000                # safety cap to avoid infinite loops\n  actions = []\n  n_actions = int(env.world.n_actions)\n\n  for _ in range(max_steps):\n      state = _get_state()\n      if state is None:\n          break  # cannot inspect state; abort\n\n      # Goal test: inventory contains at least one stick.\n      if state.satisfies(\"\", stick_idx):\n          break\n\n      # Choose a random valid action.\n      act = int(np.random.randint(n_actions))\n      actions.append(act)\n\n      # Apply the action.  Different wrappers may return different\n      # signatures; we ignore the return values.\n      try:\n          env.step(act)\n      except Exception:\n          # Some wrappers return a tuple (reward, done, obs)\n          env.step(act)\n\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": -1}}
