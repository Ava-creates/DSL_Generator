{"timestamp": "2025-10-15T19:05:53.145304", "function_name": "make_stick", "function_body": "  \"\"\"\n  Returns a list of actions that will obtain a ``stick`` in the given\n  :class:`CraftWorld` / :class:`CraftLab` environment.\n\n  The implementation works for any world configuration that follows the\n  recipe format used by ``CraftWorld``:\n\n  * It queries the ``Cookbook`` for the primitive ingredients required to\n    craft a stick.\n  * It navigates to the nearest cell that contains each required primitive,\n    picks it up (``USE``), and repeats until all ingredients are collected.\n  * It then navigates to a workshop that can craft a stick and executes\n    ``USE`` to perform the crafting action.\n\n  The returned list can be fed directly to ``env.step(action)`` (or the\n  higher\u2011level ``env`` wrappers) to complete the task.\n\n  Note\n  ----\n  The function does **not** execute the actions; it only plans them based\n  on the current state returned by ``env.reset()``.  It therefore updates a\n  local copy of the grid and inventory to keep the plan consistent.\n  \"\"\"\n  # ----------------------------------------------------------------------\n  # Helper utilities\n  # ----------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN,UP,LEFT,RIGHT) that moves\n      from ``start`` to ``goal`` using a simple Manhattan walk.\"\"\"\n      ax, ay = start\n      bx, by = goal\n      actions = []\n      # move in x direction\n      while ax < bx:\n          actions.append(RIGHT)\n          ax += 1\n      while ax > bx:\n          actions.append(LEFT)\n          ax -= 1\n      # move in y direction (y grows downwards in the grid)\n      while ay < by:\n          actions.append(DOWN)\n          ay += 1\n      while ay > by:\n          actions.append(UP)\n          ay -= 1\n      return actions\n\n  def adjacent_position(target, avoid=None):\n      \"\"\"Return a position adjacent to ``target`` that is inside the grid\n      and (optionally) not blocked by ``avoid`` (a set of coordinates).\"\"\"\n      tx, ty = target\n      candidates = [(tx - 1, ty), (tx + 1, ty), (tx, ty - 1), (tx, ty + 1)]\n      for cx, cy in candidates:\n          if 0 <= cx < WIDTH and 0 <= cy < HEIGHT:\n              if avoid is None or (cx, cy) not in avoid:\n                  return (cx, cy)\n      # fallback \u2013 just return the target itself (will be handled later)\n      return target\n\n  # ----------------------------------------------------------------------\n  # Initialise environment and retrieve useful constants\n  # ----------------------------------------------------------------------\n  # Reset to obtain a fresh state and the underlying objects\n  env.reset()\n  state = env._current_state          # CraftState instance\n  world = env.world                    # CraftWorld instance\n  cw = world.cookbook                  # Cookbook instance\n\n  # Grid dimensions\n  WIDTH, HEIGHT, _ = state.grid.shape\n\n  # Action indices (the env knows the mapping)\n  action_map = env.action_specs()\n  DOWN = action_map[\"DOWN\"]\n  UP = action_map[\"UP\"]\n  LEFT = action_map[\"LEFT\"]\n  RIGHT = action_map[\"RIGHT\"]\n  USE = action_map[\"USE\"]\n\n  # ----------------------------------------------------------------------\n  # Determine the recipe for a stick\n  # ----------------------------------------------------------------------\n  stick_idx = cw.index[\"stick\"]\n  # primitives needed (dict: primitive_kind_idx -> count)\n  primitives_needed = cw.primitives_for(stick_idx).copy()\n  # workshop where a stick can be crafted\n  recipe = cw.recipes.get(stick_idx, {})\n  workshop_idx = recipe.get(\"_at\", None)\n\n  # ----------------------------------------------------------------------\n  # Local mutable copies of grid, position and inventory for planning\n  # ----------------------------------------------------------------------\n  grid = state.grid.copy()\n  pos = tuple(state.pos)          # (x, y)\n  inventory = state.inventory.copy()\n\n  plan_actions = []\n\n  # ----------------------------------------------------------------------\n  # Helper to update the local copies after a USE action\n  # ----------------------------------------------------------------------\n  def perform_use(agent_pos, direction):\n      \"\"\"Simulate a USE action from ``agent_pos`` looking ``direction``.\n      Updates ``grid`` and ``inventory`` accordingly.\"\"\"\n      dx, dy = {\n          RIGHT: (1, 0),\n          LEFT: (-1, 0),\n          DOWN: (0, 1),\n          UP: (0, -1)\n      }[direction]\n      tx, ty = agent_pos[0] + dx, agent_pos[1] + dy\n      if not (0 <= tx < WIDTH and 0 <= ty < HEIGHT):\n          return  # nothing to use\n\n      cell = grid[tx, ty, :]\n      # If there is a primitive item, pick it up\n      prim_kinds = [k for k in world.grabbable_indices if cell[k] > 0]\n      if prim_kinds:\n          pk = prim_kinds[0]\n          inventory[pk] += 1\n          grid[tx, ty, pk] = 0\n          return\n\n      # If there is a workshop and we have the required ingredients,\n      # craft the output (which is the item we are currently planning for)\n      if cell[workshop_idx] > 0:\n          # Verify we have enough primitives\n          ok = True\n          for p_idx, cnt in primitives_needed_original.items():\n              if inventory[p_idx] < cnt:\n                  ok = False\n                  break\n          if ok:\n              # Consume ingredients\n              for p_idx, cnt in primitives_needed_original.items():\n                  inventory[p_idx] -= cnt\n              # Add the crafted stick\n              inventory[stick_idx] += 1\n\n  # Keep a copy of the original primitive requirements for crafting check\n  primitives_needed_original = primitives_needed.copy()\n\n  # ----------------------------------------------------------------------\n  # Collect all required primitives\n  # ----------------------------------------------------------------------\n  for prim_idx, needed_cnt in list(primitives_needed.items()):\n      while needed_cnt > 0:\n          # Locate the closest cell that still contains this primitive\n          locations = np.argwhere(grid[:, :, prim_idx] > 0)\n          if locations.size == 0:\n              raise RuntimeError(\n                  f\"Could not find required primitive {cw.index.get(prim_idx, prim_idx)}\"\n              )\n          # Manhattan distance to current position\n          dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])\n          nearest = locations[dists.argmin()]\n          target_cell = tuple(nearest.tolist())\n\n          # Choose an adjacent cell from which we can USE\n          adj = adjacent_position(target_cell, avoid={pos})\n          # Move to the adjacent cell\n          plan_actions.extend(manhattan_path(pos, adj))\n          pos = adj\n\n          # Determine direction we need to face to look at the primitive\n          if target_cell[0] > pos[0]:\n              facing = RIGHT\n          elif target_cell[0] < pos[0]:\n              facing = LEFT\n          elif target_cell[1] > pos[1]:\n              facing = DOWN\n          else:\n              facing = UP\n\n          # Use to pick up the primitive\n          plan_actions.append(USE)\n          perform_use(pos, facing)\n\n          # Update bookkeeping\n          needed_cnt -= 1\n          primitives_needed[prim_idx] = needed_cnt\n\n  # ----------------------------------------------------------------------\n  # Move to a workshop that can craft a stick and craft it\n  # ----------------------------------------------------------------------\n  if workshop_idx is None:\n      raise RuntimeError(\"No workshop specified for crafting a stick.\")\n\n  # Find any workshop cell\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      raise RuntimeError(\"No workshop cell found in the current grid.\")\n  workshop_cell = tuple(workshop_cells[0].tolist())\n\n  # Move adjacent to the workshop\n  adj_ws = adjacent_position(workshop_cell, avoid={pos})\n  plan_actions.extend(manhattan_path(pos, adj_ws))\n  pos = adj_ws\n\n  # Face the workshop\n  if workshop_cell[0] > pos[0]:\n      facing_ws = RIGHT\n  elif workshop_cell[0] < pos[0]:\n      facing_ws = LEFT\n  elif workshop_cell[1] > pos[1]:\n      facing_ws = DOWN\n  else:\n      facing_ws = UP\n\n  # Use to craft the stick\n  plan_actions.append(USE)\n  perform_use(pos, facing_ws)\n\n  # ----------------------------------------------------------------------\n  # Return the planned action list\n  # ----------------------------------------------------------------------\n  return plan_actions", "env_interactions": 0, "island_id": 9, "scores": {"3": -1}}
