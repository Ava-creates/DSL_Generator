{"timestamp": "2025-10-15T20:42:37.934468", "function_name": "make_stick", "function_body": "  \"\"\"\n  Returns a sequence of actions to complete the task of making a stick\n  in the given CraftWorld environment. The function gathers the required\n  primitives from the recipe for 'stick' and then crafts the stick.\n\n  Args:\n      env: The CraftLab environment instance.\n\n  Returns:\n      List[int]: A list of action indices the agent can execute to complete the task.\n  \"\"\"\n  # Helper functions\n  def find_nearest(item_idx, grid, pos):\n      \"\"\"Find the nearest cell containing the given item index.\"\"\"\n      h, w, _ = grid.shape\n      best = None\n      best_dist = float('inf')\n      for y in range(h):\n          for x in range(w):\n              if grid[y, x, item_idx] > 0:\n                  dist = abs(x - pos[0]) + abs(y - pos[1])\n                  if dist < best_dist:\n                      best_dist = dist\n                      best = (x, y)\n      return best\n\n  def move_towards(target, pos, direction):\n      \"\"\"Generate actions to move towards target from pos.\"\"\"\n      actions = []\n      x, y = pos\n      tx, ty = target\n      # simple Manhattan path: horizontal then vertical\n      while x != tx:\n          if tx > x:\n              # face right\n              if direction != 0:\n                  actions.append(4)  # USE to turn (simplified)\n                  direction = 0\n              actions.append(0)  # DOWN (right)\n              x += 1\n          else:\n              if direction != 2:\n                  actions.append(4)\n                  direction = 2\n              actions.append(2)  # LEFT\n              x -= 1\n      while y != ty:\n          if ty > y:\n              if direction != 1:\n                  actions.append(4)\n                  direction = 1\n              actions.append(1)  # UP\n              y += 1\n          else:\n              if direction != 3:\n                  actions.append(4)\n                  direction = 3\n              actions.append(3)  # DOWN (left)\n              y -= 1\n      return actions, direction\n\n  # Main logic\n  # Get the world and scenario\n  state = env._current_state\n  grid = state.grid\n  pos = state.pos\n  direction = state.dir\n\n  # Identify stick index\n  stick_name = \"stick\"\n  stick_idx = state.world.cookbook.index(stick_name)\n\n  # Get required primitives for stick\n  recipe = state.world.cookbook.recipes.get(stick_idx, {})\n  # recipe format includes \"_key\": workshop; we only need ingredients\n  primitives_needed = {k: v for k, v in recipe.items() if isinstance(k, int)}\n\n  actions_plan = []\n\n  # Collect each required primitive\n  for prim_idx, count in primitives_needed.items():\n      for _ in range(count):\n          # Find nearest primitive location\n          target = find_nearest(prim_idx, grid, pos)\n          if target is None:\n              raise ValueError(\"Required primitive not found in grid\")\n          # Move to the primitive\n          move_actions, direction = move_towards(target, pos, direction)\n          actions_plan.extend(move_actions)\n          pos = target\n          # Use action to pick up (USE)\n          actions_plan.append(4)  # USE to collect\n          # Update internal state simulation (optional)\n          # For simplicity we don't update grid here; env will handle it\n\n  # After collecting, move to workshop for crafting stick\n  workshop_idx = recipe.get(\"_key\")\n  if workshop_idx is not None:\n      workshop_target = find_nearest(workshop_idx, grid, pos)\n      if workshop_target is not None:\n          move_actions, direction = move_towards(workshop_target, pos, direction)\n          actions_plan.extend(move_actions)\n          pos = workshop_target\n\n  # Finally, use action to craft the stick\n  actions_plan.append(4)  # USE to craft\n\n  return actions_plan", "env_interactions": 0, "island_id": 8, "scores": {"3": -1}}
