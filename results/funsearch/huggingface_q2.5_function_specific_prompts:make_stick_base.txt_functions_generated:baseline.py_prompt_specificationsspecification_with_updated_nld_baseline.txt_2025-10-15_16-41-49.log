{"timestamp": "2025-10-15T18:27:53.892268", "function_name": "make_stick", "function_body": "  # reset\n  obs = env.reset()\n  # get goal index for stick\n  stick_idx = env.world.cookbook.index['stick']\n  # get required primitives\n  req = env.world.cookbook.primitives_for(stick_idx)\n  # collect each primitive\n  actions = []\n  state = env._current_state if hasattr(env, \"_current_state\") else None\n  # helper to find nearest cell with given kind\n  def find_nearest(kind):\n      grid = state.grid\n      pos = state.pos\n      # compute Manhattan distances\n      best = None\n      best_dist = 1e9\n      for x in range(grid.shape[0]):\n          for y in range(grid.shape[1]):\n              if grid[x,y,kind] > 0:\n                  d = abs(x-pos[0]) + abs(y-pos[1])\n                  if d < best_dist:\n                      best_dist = d\n                      best = (x,y)\n      return best\n  # movement actions mapping\n  ACTIONS = {\"UP\":0,\"DOWN\":1,\"LEFT\":2,\"RIGHT\":3,\"USE\":4}\n  # simple path: move horizontally then vertically\n  def path_to(target):\n      cur = state.pos\n      seq = []\n      dx = target[0] - cur[0]\n      dy = target[1] - cur[1]\n      if dx > 0:\n          seq += [ACTIONS[\"DOWN\"]]*dx\n      elif dx < 0:\n          seq += [ACTIONS[\"UP\"]]*(-dx)\n      if dy > 0:\n          seq += [ACTIONS[\"RIGHT\"]]*dy\n      elif dy < 0:\n          seq += [ACTIONS[\"LEFT\"]]*(-dy)\n      return seq\n  # collect primitives\n  for prim_idx, cnt in req.items():\n      for _ in range(cnt):\n          target = find_nearest(prim_idx)\n          if target is None:\n              continue\n          actions += path_to(target)\n          actions.append(ACTIONS[\"USE\"])\n          # step env to update state\n          for a in actions[-(len(path_to(target))+1):]:\n              _, done, _ = env.step(a)\n              if done:\n                  break\n          state = env._current_state\n  # craft stick at its workshop\n  # find workshop cell for stick\n  workshop_kind = env.world.workshop_indices[stick_idx] if isinstance(env.world.workshop_indices, dict) else None\n  # but recipes have _at field; we can locate any cell with that kind\n  workshop_kind = None\n  # iterate recipes to get _at\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  at_kind = None\n  for k,v in recipe.items():\n      if k == \"_at\":\n          at_kind = v\n          break\n  if at_kind is not None:\n      workshop_kind = at_kind\n  if workshop_kind is not None:\n      target = find_nearest(workshop_kind)\n      if target:\n          actions += path_to(target)\n          actions.append(ACTIONS[\"USE\"])\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": -1}}
