{"timestamp": "2025-10-15T17:17:08.611619", "function_name": "make_stick", "function_body": "  \"\"\"\n  Generate a list of actions that will collect the required primitives and then\n  craft a ``stick`` in the given CraftWorld environment.\n\n  The implementation works for the standard CraftLab interface used in the\n  code base described above.  It assumes the following action encoding\n  (the same convention used by `CraftWorld`):\n\n      0 \u2013 DOWN\n      1 \u2013 UP\n      2 \u2013 LEFT\n      3 \u2013 RIGHT\n      4 \u2013 USE   (collect / craft)\n\n  The function performs three high\u2011level steps:\n\n  1.  Determine which primitive items are needed to craft a ``stick``.\n  2.  For each required primitive, locate the nearest instance on the map,\n      navigate to it and ``USE`` to pick it up.\n  3.  Locate the workshop where a ``stick`` can be crafted, move there and\n      ``USE`` to craft the item.\n\n  The returned list can be fed directly to ``env.step(action)`` in a loop.\n  \"\"\"\n  import collections\n  import numpy as np\n\n  # --------------------------------------------------------------------- #\n  # Helper utilities\n  # --------------------------------------------------------------------- #\n  # Action constants \u2013 match the ordering used by CraftWorld\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = range(5)\n\n  # Mapping from delta (row, col) to action index\n  _DELTA_TO_ACTION = {\n      ( 1,  0): ACTION_DOWN,\n      (-1,  0): ACTION_UP,\n      ( 0, -1): ACTION_LEFT,\n      ( 0,  1): ACTION_RIGHT,\n  }\n\n  def bfs(start, goal_mask, blocked_mask):\n      \"\"\"\n      Bread\u2011first\u2011search returning a list of actions that moves the agent from\n      ``start`` to the nearest cell satisfying ``goal_mask`` while avoiding\n      cells where ``blocked_mask`` is True.\n\n      Parameters\n      ----------\n      start : tuple[int, int]\n          (row, col) of the agent.\n      goal_mask : np.ndarray (H, W) of bool\n          True where the goal item is present.\n      blocked_mask : np.ndarray (H, W) of bool\n          True where the cell cannot be entered.\n\n      Returns\n      -------\n      list[int]\n          Sequence of actions (DOWN/UP/LEFT/RIGHT) that reaches the goal.\n          Empty list if start already satisfies the goal.\n      \"\"\"\n      if goal_mask[start]:\n          return []\n\n      H, W = goal_mask.shape\n      q = collections.deque()\n      q.append(start)\n      visited = np.full((H, W), False, dtype=bool)\n      visited[start] = True\n      # parent stores (prev_row, prev_col, action_to_current)\n      parent = dict()\n\n      while q:\n          r, c = q.popleft()\n          for drc, act in _DELTA_TO_ACTION.items():\n              dr, dc = drc\n              nr, nc = r + dr, c + dc\n              if 0 <= nr < H and 0 <= nc < W and not visited[nr, nc] and not blocked_mask[nr, nc]:\n                  visited[nr, nc] = True\n                  parent[(nr, nc)] = (r, c, act)\n                  if goal_mask[nr, nc]:\n                      # reconstruct path\n                      path = []\n                      cur = (nr, nc)\n                      while cur != start:\n                          pr, pc, a = parent[cur]\n                          path.append(a)\n                          cur = (pr, pc)\n                      path.reverse()\n                      return path\n                  q.append((nr, nc))\n      # No reachable goal \u2013 return empty list (caller will treat as failure)\n      return []\n\n  # --------------------------------------------------------------------- #\n  # Extract world information\n  # --------------------------------------------------------------------- #\n  world = env.world                     # CraftWorld instance\n  cookbook = world.cookbook              # Cookbook with recipes\n  scenario = env.scenario                # CraftScenario instance\n\n  # Initial grid and position (the grid is a (H, W, n_kinds) array)\n  grid = scenario.init_grid.copy()\n  pos = scenario.init_pos                # (row, col)\n\n  # --------------------------------------------------------------------- #\n  # Identify the goal (stick) and its recipe\n  # --------------------------------------------------------------------- #\n  stick_idx = cookbook.index[\"stick\"]\n  # Primitive requirements for a single stick (dict {kind_idx: count})\n  primitive_req = cookbook.primitives_for(stick_idx)\n\n  # The workshop where a stick can be crafted is stored under the special key\n  # \"_at\" in the recipe dictionary.\n  workshop_name = cookbook.recipes[stick_idx][\"_at\"]\n  workshop_idx = cookbook.index[workshop_name]\n\n  # --------------------------------------------------------------------- #\n  # Pre\u2011compute a mask of blocked cells (any non\u2011zero entity blocks movement)\n  # --------------------------------------------------------------------- #\n  # A cell is blocked if any kind other than the agent occupies it.\n  blocked_mask = grid.sum(axis=2) > 0\n\n  # --------------------------------------------------------------------- #\n  # Action sequence construction\n  # --------------------------------------------------------------------- #\n  actions = []\n\n  # --------------------------------------------------------------------- #\n  # 1. Collect each required primitive\n  # --------------------------------------------------------------------- #\n  for kind_idx, needed in primitive_req.items():\n      for _ in range(needed):\n          # Locate the nearest cell that currently contains the primitive.\n          # The grid may contain multiple copies; we simply look for any.\n          goal_mask = grid[:, :, kind_idx] > 0\n\n          # Compute path to the primitive, avoiding blocked cells.\n          path = bfs(pos, goal_mask, blocked_mask)\n          actions.extend(path)                # move actions\n          # Update position after moving\n          for a in path:\n              dr, dc = {ACTION_DOWN: (1, 0), ACTION_UP: (-1, 0),\n                        ACTION_LEFT: (0, -1), ACTION_RIGHT: (0, 1)}[a]\n              pos = (pos[0] + dr, pos[1] + dc)\n\n          # Once we are on the primitive cell, use the USE action to pick it up.\n          actions.append(ACTION_USE)\n\n          # Simulate the effect of picking up the item:\n          #   - Decrease the count in the grid\n          #   - Mark the cell as empty (may become traversable)\n          grid[pos[0], pos[1], kind_idx] = max(0, grid[pos[0], pos[1], kind_idx] - 1)\n          blocked_mask = grid.sum(axis=2) > 0   # recompute blocked mask\n\n  # --------------------------------------------------------------------- #\n  # 2. Move to the workshop that can craft a stick\n  # --------------------------------------------------------------------- #\n  workshop_mask = grid[:, :, workshop_idx] > 0\n  path_to_ws = bfs(pos, workshop_mask, blocked_mask)\n  actions.extend(path_to_ws)\n\n  # Update position after the move\n  for a in path_to_ws:\n      dr, dc = {ACTION_DOWN: (1, 0), ACTION_UP: (-1, 0),\n                ACTION_LEFT: (0, -1), ACTION_RIGHT: (0, 1)}[a]\n      pos = (pos[0] + dr, pos[1] + dc)\n\n  # --------------------------------------------------------------------- #\n  # 3. Craft the stick at the workshop\n  # --------------------------------------------------------------------- #\n  actions.append(ACTION_USE)   # USE while facing the workshop cell\n\n  # The returned list of actions can now be executed in the environment.\n  return actions", "env_interactions": 2, "island_id": 4, "scores": {"3": 0.0}}
