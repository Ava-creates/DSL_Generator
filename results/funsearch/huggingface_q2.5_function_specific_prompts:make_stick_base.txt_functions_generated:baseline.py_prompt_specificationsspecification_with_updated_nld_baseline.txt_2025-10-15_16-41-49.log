{"timestamp": "2025-10-15T19:41:32.834139", "function_name": "make_stick", "function_body": "  \"\"\"\n  Generate a list of action indices that will obtain a ``stick`` in the given\n  CraftWorld environment.\n\n  The implementation:\n    1. Reads the recipe for ``stick`` from the world's cookbook.\n    2. For each required primitive, finds a (currently) reachable cell that\n       contains the primitive, moves to it with Manhattan moves, and issues a\n       ``USE`` action to pick it up.\n    3. Moves to the workshop (if the recipe specifies one) and issues a final\n       ``USE`` to craft the stick.\n\n  The returned list can be fed directly to ``env.step(action)``.\n  \"\"\"\n  import numpy as np\n\n  # ------------------------------------------------------------------ #\n  # Helper: Manhattan movement actions (ignores obstacles for simplicity)\n  # ------------------------------------------------------------------ #\n  def _move_actions(cur, target, move_map):\n      \"\"\"Return a list of movement actions that brings ``cur`` to ``target``.\"\"\"\n      cx, cy = cur\n      tx, ty = target\n      actions = []\n\n      while cx < tx:\n          actions.append(move_map[\"RIGHT\"])\n          cx += 1\n      while cx > tx:\n          actions.append(move_map[\"LEFT\"])\n          cx -= 1\n      while cy < ty:\n          actions.append(move_map[\"DOWN\"])\n          cy += 1\n      while cy > ty:\n          actions.append(move_map[\"UP\"])\n          cy -= 1\n      return actions, (cx, cy)\n\n  # ------------------------------------------------------------------ #\n  # Retrieve recipe information\n  # ------------------------------------------------------------------ #\n  world = env.world                     # CraftWorld instance\n  cookbook = world.cookbook\n  stick_idx = cookbook.index[\"stick\"]   # integer index of the goal item\n\n  recipe = cookbook.recipes.get(stick_idx, {})\n  if not recipe:\n      raise ValueError(\"No recipe found for 'stick'.\")\n\n  # Workshop location (may be None)\n  workshop_name = recipe.get(\"_at\")\n\n  # Primitive requirements: keep only integer keys (kind indices)\n  primitive_requirements = {\n      k: v for k, v in recipe.items()\n      if isinstance(k, int) and k != \"_key\"\n  }\n\n  # ------------------------------------------------------------------ #\n  # Action mapping\n  # ------------------------------------------------------------------ #\n  action_spec = env.action_specs()      # e.g. {\"DOWN\":0, \"UP\":1, ...}\n  move_map = {\n      \"RIGHT\": action_spec[\"RIGHT\"],\n      \"LEFT\":  action_spec[\"LEFT\"],\n      \"DOWN\":  action_spec[\"DOWN\"],\n      \"UP\":    action_spec[\"UP\"],\n  }\n  USE = action_spec[\"USE\"]\n\n  # ------------------------------------------------------------------ #\n  # Planning \u2013 collect primitives\n  # ------------------------------------------------------------------ #\n  cur_pos = env._current_state.pos      # (x, y)\n  grid = env._current_state.grid.copy()  # copy so we can modify it locally\n\n  plan = []\n\n  for kind_idx, needed in primitive_requirements.items():\n      for _ in range(needed):\n          # locate all cells holding this primitive\n          locations = np.argwhere(grid[:, :, kind_idx] > 0)\n          if locations.size == 0:\n              raise RuntimeError(\n                  f\"Required primitive (kind {kind_idx}) not present in the grid.\"\n              )\n          # pick the location with minimal Manhattan distance to current pos\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          nearest_idx = np.argmin(dists)\n          target = tuple(locations[nearest_idx])  # (x, y)\n\n          # move to the primitive and pick it up\n          moves, cur_pos = _move_actions(cur_pos, target, move_map)\n          plan.extend(moves)\n          plan.append(USE)               # collect\n\n          # simulate removal of the primitive from the grid copy\n          grid[target[0], target[1], kind_idx] = 0\n\n  # ------------------------------------------------------------------ #\n  # Planning \u2013 go to workshop and craft the stick\n  # ------------------------------------------------------------------ #\n  if workshop_name is not None:\n      workshop_idx = cookbook.index[workshop_name]\n      workshop_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_locs.size == 0:\n          raise RuntimeError(f\"Workshop '{workshop_name}' not found in the grid.\")\n      # choose the first workshop location (any works)\n      workshop_pos = tuple(workshop_locs[0])\n\n      moves, cur_pos = _move_actions(cur_pos, workshop_pos, move_map)\n      plan.extend(moves)\n      plan.append(USE)                   # craft the stick\n\n  return plan", "env_interactions": 4, "island_id": 9, "scores": {"3": 0.0}}
