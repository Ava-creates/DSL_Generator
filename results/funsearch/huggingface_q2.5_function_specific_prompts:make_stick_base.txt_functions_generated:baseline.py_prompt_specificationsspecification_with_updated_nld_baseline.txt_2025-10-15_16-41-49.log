{"timestamp": "2025-10-15T17:28:42.743691", "function_name": "make_stick", "function_body": "  \"\"\"\n  Generate a sequence of actions that will allow the agent to craft a\n  ``stick`` in the provided CraftWorld environment.\n\n  The function inspects the environment's recipe for a stick, collects\n  the required primitive resources, and then moves to the appropriate\n  workshop to craft the final item.\n\n  Parameters\n  ----------\n  env : object\n      An instance of the CraftWorld environment (or a wrapper such as\n      ``CraftLab``).  The function expects the object to expose the\n      attributes ``world`` (a ``CraftWorld`` instance) and\n      ``_current_state`` (a ``CraftState`` instance) \u2013 which is the case\n      for the standard DMLab\u2011style wrapper.\n\n  Returns\n  -------\n  List[int]\n      A list of action indices (DOWN, UP, LEFT, RIGHT, USE) that, when\n      executed sequentially, will result in the agent possessing a\n      ``stick`` in its inventory.\n  \"\"\"\n  # ------------------------------------------------------------------\n  # Helper to move from one grid coordinate to another using Manhattan\n  # moves.  This does NOT account for obstacles; it assumes a clear path.\n  # ------------------------------------------------------------------\n  def _move_actions(start, goal):\n      sx, sy = start\n      gx, gy = goal\n      actions = []\n\n      # horizontal moves (x axis)\n      while sx < gx:\n          actions.append(RIGHT)\n          sx += 1\n      while sx > gx:\n          actions.append(LEFT)\n          sx -= 1\n\n      # vertical moves (y axis)\n      while sy < gy:\n          actions.append(DOWN)\n          sy += 1\n      while sy > gy:\n          actions.append(UP)\n          sy -= 1\n\n      return actions\n\n  # ------------------------------------------------------------------\n  # 1. Identify the index of the goal item (``stick``) and its recipe.\n  # ------------------------------------------------------------------\n  cookbook = env.world.cookbook\n  try:\n      stick_idx = cookbook.index[\"stick\"]\n  except KeyError:\n      raise ValueError(\"The environment does not contain a recipe for 'stick'.\")\n\n  # Primitive requirements for one stick (e.g. ``{'log': 1}``).\n  primitive_requirements = cookbook.primitives_for(stick_idx)\n\n  # Full recipe (contains the ``_at`` key that tells us where to craft).\n  recipe = cookbook.recipes.get(stick_idx, {})\n\n  # ------------------------------------------------------------------\n  # 2. Get the current state of the world.\n  # ------------------------------------------------------------------\n  # ``CraftLab`` stores the active state in ``_current_state``.\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      # Fallback for a raw ``CraftScenario``/``CraftState`` usage.\n      state = env.scenario.init()\n\n  grid = state.grid\n  pos = tuple(state.pos)  # (x, y)\n\n  action_plan = []\n\n  # ------------------------------------------------------------------\n  # 3. Collect each required primitive the required number of times.\n  # ------------------------------------------------------------------\n  for prim_idx, count in primitive_requirements.items():\n      for _ in range(count):\n          # Locate any cell that currently contains the primitive.\n          locations = np.argwhere(grid[:, :, prim_idx] > 0)\n          if locations.size == 0:\n              # Primitive not present \u2013 in a fully generated scenario this\n              # should not happen, but we break to avoid an infinite loop.\n              raise RuntimeError(\n                  f\"Required primitive (index {prim_idx}) not found on the grid.\"\n              )\n          # Choose the first found location.\n          target = tuple(locations[0][:2])\n\n          # Move to the primitive.\n          action_plan.extend(_move_actions(pos, target))\n          # Pick it up / collect.\n          action_plan.append(USE)\n\n          # Update our simulated position (the environment will update the\n          # grid after the step, but we keep a local copy for planning).\n          pos = target\n          # Remove the primitive from our local copy to avoid re\u2011picking it.\n          grid[target[0], target[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 4. Move to the appropriate workshop and craft the stick.\n  # ------------------------------------------------------------------\n  workshop_kind = None\n  # The workshop is stored under the special key ``\"_at\"`` in the recipe.\n  for key, value in recipe.items():\n      if key == \"_at\":\n          workshop_kind = value\n          break\n\n  if workshop_kind is not None:\n      # Locate a workshop of the required type.\n      workshop_locs = np.argwhere(grid[:, :, workshop_kind] > 0)\n      if workshop_locs.size == 0:\n          raise RuntimeError(\n              f\"Required workshop (index {workshop_kind}) not found on the grid.\"\n          )\n      workshop_pos = tuple(workshop_locs[0][:2])\n\n      # Move to the workshop.\n      action_plan.extend(_move_actions(pos, workshop_pos))\n      # Use the workshop to craft the stick.\n      action_plan.append(USE)\n\n  return action_plan", "env_interactions": 0, "island_id": 1, "scores": {"3": -1}}
