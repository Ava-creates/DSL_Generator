{"timestamp": "2025-10-15T17:14:24.850136", "function_name": "make_stick", "function_body": "  \"\"\"\n  Generate a list of actions that allows the agent to craft a ``stick`` in the\n  given CraftWorld environment.\n\n  The implementation follows a simple greedy plan:\n    1.  Retrieve the recipe for ``stick`` from the world's cookbook.\n    2.  For each required primitive, move to the nearest cell that contains the\n        primitive, ``USE`` (pick it up) the needed amount and repeat.\n    3.  After all primitives are collected, move to the workshop where a stick\n        can be crafted (the workshop is stored in the recipe under the ``_at``\n        key) and ``USE`` to craft the item.\n\n  The returned list consists of action indices as defined by\n  :class:`CraftLab` (DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4).\n\n  Parameters\n  ----------\n  env : object\n      An instance of :class:`CraftLab` (or any object that exposes the same\n      attributes used below).  It must provide access to the underlying\n      :class:`CraftWorld` via ``env.world`` and the current state via\n      ``env._current_state`` (as used by the official DMLab wrapper).\n\n  Returns\n  -------\n  list[int]\n      A sequence of actions that, when executed in the environment, results\n      in the agent possessing at least one ``stick``.\n  \"\"\"\n  import numpy as np\n\n  # --------------------------------------------------------------------- #\n  # Helper to translate a movement from (x, y) to a list of actions.\n  # --------------------------------------------------------------------- #\n  def _move_actions(src, dst):\n      \"\"\"Return actions to move from src to dst using Manhattan steps.\"\"\"\n      sx, sy = src\n      tx, ty = dst\n      acts = []\n      # X\u2011axis (RIGHT / LEFT)\n      while sx < tx:\n          acts.append(3)   # RIGHT\n          sx += 1\n      while sx > tx:\n          acts.append(2)   # LEFT\n          sx -= 1\n      # Y\u2011axis (DOWN / UP)\n      while sy < ty:\n          acts.append(0)   # DOWN\n          sy += 1\n      while sy > ty:\n          acts.append(1)   # UP\n          sy -= 1\n      return acts\n\n  # --------------------------------------------------------------------- #\n  # 1.  Identify the ``stick`` item and its recipe.\n  # --------------------------------------------------------------------- #\n  # ``index`` maps names \u2192 integer IDs.\n  stick_name = \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[stick_name]\n  except Exception as exc:\n      raise RuntimeError(f\"Could not find index for {stick_name!r}: {exc}\")\n\n  # Primitive requirements for one stick.\n  primitive_needs = env.world.cookbook.primitives_for(stick_idx)\n\n  # --------------------------------------------------------------------- #\n  # 2.  Gather required primitives.\n  # --------------------------------------------------------------------- #\n  state = env._current_state          # the current CraftState\n  grid = state.grid                    # (W, H, n_kinds) one\u2011hot occupancy\n  cur_pos = state.pos                  # (x, y)\n\n  actions = []\n\n  for prim_idx, needed_cnt in primitive_needs.items():\n      # Locate all cells that currently contain this primitive.\n      prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n      # Convert to list of (x, y) tuples.\n      prim_locs = [(int(x), int(y)) for x, y in prim_cells]\n\n      if not prim_locs:\n          # No source of this primitive \u2013 we cannot continue.\n          raise RuntimeError(f\"No cells contain required primitive index {prim_idx}\")\n\n      # Sort locations by Manhattan distance from the current position.\n      prim_locs.sort(key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))\n\n      # Greedily pick the closest cells until we have enough of the primitive.\n      collected = 0\n      for loc in prim_locs:\n          if collected >= needed_cnt:\n              break\n          # Move to the primitive.\n          actions.extend(_move_actions(cur_pos, loc))\n          cur_pos = loc\n          # Pick it up.\n          actions.append(4)          # USE\n          collected += 1\n\n      if collected < needed_cnt:\n          raise RuntimeError(\n              f\"Could not collect enough of primitive {prim_idx} \"\n              f\"(needed {needed_cnt}, got {collected})\"\n          )\n\n  # --------------------------------------------------------------------- #\n  # 3.  Move to the appropriate workshop and craft the stick.\n  # --------------------------------------------------------------------- #\n  # The workshop name is stored under the special ``_at`` key of the recipe.\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if not workshop_name:\n      raise RuntimeError(\"Stick recipe does not specify a workshop (missing '_at')\")\n\n  # Resolve the workshop's integer ID.\n  try:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n  except Exception as exc:\n      raise RuntimeError(f\"Could not resolve workshop name {workshop_name!r}: {exc}\")\n\n  # Find workshop locations on the map.\n  ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  ws_locs = [(int(x), int(y)) for x, y in ws_cells]\n\n  if not ws_locs:\n      raise RuntimeError(f\"No workshop of type {workshop_name!r} found on the map\")\n\n  # Choose the nearest workshop.\n  ws_locs.sort(key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))\n  target_ws = ws_locs[0]\n\n  # Move to the workshop and use it to craft the stick.\n  actions.extend(_move_actions(cur_pos, target_ws))\n  actions.append(4)   # USE (craft)\n\n  return actions", "env_interactions": 4, "island_id": 0, "scores": {"3": 0.0}}
