{"timestamp": "2025-10-15T20:19:40.864528", "function_name": "make_stick", "function_body": "  \"\"\"\n  Generate a list of actions that will make a ``stick`` in the given\n  CraftWorld environment.\n\n  The function follows the recipe for ``stick``:\n  1.  Determine which primitive items are required.\n  2.  Locate each required primitive on the grid, move next to it and\n      ``USE`` it to collect it.\n  3.  Locate the workshop required for the final crafting step,\n      move next to it and ``USE`` to craft the stick.\n\n  The returned list can be fed directly to ``env.step(action)`` (or\n  ``env.step(action, num_steps=1)``) to execute the plan.\n\n  Parameters\n  ----------\n  env : CraftLab (or compatible) instance\n      The environment that already contains a generated scenario.\n\n  Returns\n  -------\n  list[int]\n      Ordered action indices that, when executed, produce a stick.\n  \"\"\"\n  import numpy as np\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def _action_map():\n      \"\"\"Map action name \u2192 integer index using the env's spec.\"\"\"\n      specs = env.action_specs()\n      return {name: idx for name, idx in specs.items()}\n\n  ACTIONS = _action_map()\n  # Basic movement directions (assumed ordering from the spec)\n  MOVE_DOWN = ACTIONS[\"DOWN\"]\n  MOVE_UP = ACTIONS[\"UP\"]\n  MOVE_LEFT = ACTIONS[\"LEFT\"]\n  MOVE_RIGHT = ACTIONS[\"RIGHT\"]\n  ACTION_USE = ACTIONS[\"USE\"]\n\n  def _move_actions(cur, dest):\n      \"\"\"Greedy Manhattan moves from ``cur`` to ``dest``.\"\"\"\n      actions = []\n      x, y = cur\n      tx, ty = dest\n      while x != tx:\n          if tx > x:\n              actions.append(MOVE_DOWN)\n              x += 1\n          else:\n              actions.append(MOVE_UP)\n              x -= 1\n      while y != ty:\n          if ty > y:\n              actions.append(MOVE_RIGHT)\n              y += 1\n          else:\n              actions.append(MOVE_LEFT)\n              y -= 1\n      return actions\n\n  def _adjacent_free(cell, grid):\n      \"\"\"\n      Return a free (non\u2011blocked) adjacent cell to ``cell``.\n      Preference order: up, down, left, right.\n      \"\"\"\n      x, y = cell\n      w, h, _ = grid.shape\n      candidates = [\n          (x - 1, y),  # up\n          (x + 1, y),  # down\n          (x, y - 1),  # left\n          (x, y + 1),  # right\n      ]\n      for nx, ny in candidates:\n          if 0 <= nx < w and 0 <= ny < h:\n              if grid[nx, ny].sum() == 0:          # empty cell\n                  return (nx, ny)\n      # If no empty neighbour, just return the original cell (the\n      # planner will still try to move as close as possible).\n      return cell\n\n  # ------------------------------------------------------------------\n  # 1. Identify the goal (stick) and its recipe.\n  # ------------------------------------------------------------------\n  cookbook = env.world.cookbook\n  stick_idx = cookbook.index[\"stick\"]\n  # Primitive requirements for ONE stick (dict {primitive_idx: count})\n  primitive_needs = cookbook.primitives_for(stick_idx)\n\n  # ------------------------------------------------------------------\n  # 2. Collect required primitives.\n  # ------------------------------------------------------------------\n  actions_plan = []\n  state = env._current_state                # current CraftState\n  grid = state.grid.copy()                  # (W, H, n_kinds)\n\n  for prim_idx, needed_cnt in primitive_needs.items():\n      while state.inventory[prim_idx] < needed_cnt:\n          # locate a cell that still contains the primitive\n          prim_locations = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_locations.size == 0:\n              raise RuntimeError(\n                  f\"Unable to find required primitive {cookbook.get(prim_idx, prim_idx)}\"\n              )\n          # pick the first available location\n          target_cell = tuple(prim_locations[0])\n\n          # find a free adjacent cell to stand on\n          stand_cell = _adjacent_free(target_cell, grid)\n\n          # move from current position to the standing cell\n          actions_plan.extend(_move_actions(state.pos, stand_cell))\n\n          # after movement the agent will be facing the direction of the\n          # last move; ensure we are facing the primitive before using.\n          # Simple trick: move one step away (if possible) and step back.\n          # This guarantees the facing direction points to the primitive.\n          # We try to step away in any free direction.\n          ax, ay = stand_cell\n          # try to step away\n          away = None\n          for dx, dy, act in [(-1, 0, MOVE_UP), (1, 0, MOVE_DOWN),\n                              (0, -1, MOVE_LEFT), (0, 1, MOVE_RIGHT)]:\n              nx, ny = ax + dx, ay + dy\n              if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n                  if grid[nx, ny].sum() == 0:\n                      away = (nx, ny, act)\n                      break\n          if away is not None:\n              # step away\n              actions_plan.append(away[2])\n              # step back (now facing the primitive)\n              back_action = {\n                  MOVE_UP: MOVE_DOWN,\n                  MOVE_DOWN: MOVE_UP,\n                  MOVE_LEFT: MOVE_RIGHT,\n                  MOVE_RIGHT: MOVE_LEFT,\n              }[away[2]]\n              actions_plan.append(back_action)\n          # finally use the primitive\n          actions_plan.append(ACTION_USE)\n\n          # ---------------------------------------------------------\n          # Simulate the actions to keep ``state`` and ``grid`` in sync.\n          # ---------------------------------------------------------\n          for a in actions_plan[-(1 + (2 if away else 0) + 1):]:  # only the newly added ones\n              reward, new_state = state.step(a)\n              state = new_state\n              grid = state.grid\n\n  # ------------------------------------------------------------------\n  # 3. Craft the stick at its required workshop.\n  # ------------------------------------------------------------------\n  # The recipe dict contains a special key \"_at\" that tells us the\n  # workshop name.\n  workshop_name = cookbook.recipes[stick_idx].get(\"_at\")\n  if workshop_name is None:\n      raise RuntimeError(\"Stick recipe does not specify a workshop.\")\n  workshop_idx = cookbook.index[workshop_name]\n\n  # locate any workshop cell\n  ws_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if ws_locs.size == 0:\n      raise RuntimeError(f\"No workshop of type {workshop_name} found.\")\n  ws_cell = tuple(ws_locs[0])\n\n  # stand next to the workshop\n  stand_ws = _adjacent_free(ws_cell, grid)\n  actions_plan.extend(_move_actions(state.pos, stand_ws))\n\n  # ensure we are facing the workshop (same trick as above)\n  ax, ay = stand_ws\n  away = None\n  for dx, dy, act in [(-1, 0, MOVE_UP), (1, 0, MOVE_DOWN),\n                      (0, -1, MOVE_LEFT), (0, 1, MOVE_RIGHT)]:\n      nx, ny = ax + dx, ay + dy\n      if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n          if grid[nx, ny].sum() == 0:\n              away = (nx, ny, act)\n              break\n  if away is not None:\n      actions_plan.append(away[2])\n      back_action = {\n          MOVE_UP: MOVE_DOWN,\n          MOVE_DOWN: MOVE_UP,\n          MOVE_LEFT: MOVE_RIGHT,\n          MOVE_RIGHT: MOVE_LEFT,\n      }[away[2]]\n      actions_plan.append(back_action)\n\n  # use workshop to craft the stick\n  actions_plan.append(ACTION_USE)\n\n  return actions_plan", "env_interactions": 0, "island_id": 6, "scores": {"3": -1}}
