{"timestamp": "2025-10-15T16:54:11.897200", "function_name": "make_stick", "function_body": "  \"\"\"\n  Return a list of actions that will make the agent obtain a stick.\n  This simple implementation uses the environment's API to locate the\n  primitive(s) required for a stick, move the agent to them and collect\n  them, then (if necessary) craft the stick at the appropriate workshop.\n  The function works for any standard CraftWorld environment that follows\n  the specification in the provided code base.\n  \"\"\"", "env_interactions": 0, "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-10-15T16:54:32.367662", "function_name": "make_stick", "function_body": "  \"\"\"\n  Returns a list of low\u2011level actions that, when executed in the given\n  CraftWorld environment, will collect the required primitives and craft a\n  ``stick``.  The implementation works for any version of the environment\n  that follows the API described in the specification.\n\n  The action space is assumed to be:\n      0 \u2013 DOWN  (increase row index)\n      1 \u2013 UP    (decrease row index)\n      2 \u2013 LEFT  (decrease column index)\n      3 \u2013 RIGHT (increase column index)\n      4 \u2013 USE   (interact with the cell in front of the agent)\n  \"\"\"\n  import numpy as np\n\n  # ------------------------------------------------------------------\n  # Helper: move from ``src`` to ``tgt`` using Manhattan steps.\n  # ------------------------------------------------------------------\n  def _move_to(src, tgt):\n      \"\"\"Return a list of actions that moves from src -> tgt.\"\"\"\n      actions = []\n      x, y = src\n      tx, ty = tgt\n      while x < tx:      # move down\n          actions.append(0)\n          x += 1\n      while x > tx:      # move up\n          actions.append(1)\n          x -= 1\n      while y < ty:      # move right\n          actions.append(3)\n          y += 1\n      while y > ty:      # move left\n          actions.append(2)\n          y -= 1\n      return actions\n\n  # ------------------------------------------------------------------\n  # 1. Initialise the environment and obtain the current state object.\n  # ------------------------------------------------------------------\n  _ = env.reset()                     # reset returns an observation dict\n  state = env._current_state          # internal state (CraftState)\n\n  # ------------------------------------------------------------------\n  # 2. Identify the index of the goal item (``stick``) and fetch its\n  #    recipe information from the Cookbook.\n  # ------------------------------------------------------------------\n  cookbook = env.world.cookbook\n  stick_idx = cookbook.index[\"stick\"]                     # goal index\n  primitive_needs = cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n  recipe = cookbook.recipes[stick_idx]                    # full recipe dict\n  workshop_name = recipe.get(\"_at\")                       # workshop type name\n  workshop_idx = cookbook.index[workshop_name] if workshop_name else None\n\n  # ------------------------------------------------------------------\n  # 3. Collect the required primitives.\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = tuple(state.pos)  # keep a local copy of the agent position\n\n  # grid holds a one\u2011hot per\u2011kind occupancy map: grid[x, y, kind] > 0\n  grid = state.grid\n\n  for prim_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          # locate all cells that currently contain the primitive\n          locations = np.argwhere(grid[:, :, prim_idx] > 0)\n          if locations.size == 0:\n              raise RuntimeError(f\"Primitive {prim_idx} not found on the map.\")\n          # choose the closest one (Manhattan distance)\n          dists = np.abs(locations - cur_pos).sum(axis=1)\n          target = tuple(locations[dists.argmin()])\n\n          # move to the primitive cell\n          actions += _move_to(cur_pos, target)\n          cur_pos = target\n\n          # pick it up\n          actions.append(4)          # USE\n          # pretend the primitive is removed from the grid for subsequent\n          # planning (so we don't try to collect the same instance again)\n          grid[target[0], target[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 4. Go to the appropriate workshop and craft the stick.\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      # find any workshop cell of the required type\n      locations = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if locations.size == 0:\n          raise RuntimeError(\"Required workshop not present in the map.\")\n      dists = np.abs(locations - cur_pos).sum(axis=1)\n      target = tuple(locations[dists.argmin()])\n\n      # move to the workshop\n      actions += _move_to(cur_pos, target)\n      cur_pos = target\n\n      # craft the stick\n      actions.append(4)   # USE on the workshop cell\n\n  return actions", "env_interactions": 4, "island_id": 5, "scores": {"3": 0.0}}
