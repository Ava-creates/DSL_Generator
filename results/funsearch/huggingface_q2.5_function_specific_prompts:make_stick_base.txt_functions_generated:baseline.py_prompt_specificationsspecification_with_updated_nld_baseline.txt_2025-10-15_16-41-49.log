{"timestamp": "2025-10-15T19:53:53.383938", "function_name": "make_stick", "function_body": "  \"\"\"\n  Generate a simple plan (as a list of action indices) that collects the\n  required primitives for a ``stick`` and then crafts it at the appropriate\n  workshop.\n\n  The implementation is deliberately straightforward:\n  * It queries the world\u2019s ``Cookbook`` for the recipe of ``stick``.\n  * For each required primitive it finds the first occurrence of that primitive\n    on the current grid, moves the agent there with Manhattan moves (ignoring\n    obstacles) and performs a ``USE`` action to pick it up.\n  * After all primitives are collected it moves to the workshop specified in\n    the recipe and performs a ``USE`` action to craft the stick.\n\n  The function works with the standard CraftWorld / CraftLab API where\n  actions are indexed as:\n      0 \u2013 DOWN, 1 \u2013 UP, 2 \u2013 LEFT, 3 \u2013 RIGHT, 4 \u2013 USE\n\n  Args:\n      env: An instance of ``CraftLab`` (or any compatible wrapper) that\n           provides access to the underlying ``CraftWorld`` via ``env.world``\n           and the current state via ``env._current_state``.\n\n  Returns:\n      List[int]: A list of action indices that, when executed sequentially,\n                 will (attempt to) produce a stick.\n  \"\"\"\n  # --------------------------------------------------------------------- #\n  # Helper functions for movement and action generation.\n  # --------------------------------------------------------------------- #\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions (no USE) that walk from start to goal.\"\"\"\n      sx, sy = start\n      gx, gy = goal\n      actions = []\n      # Move in x direction first\n      while sx < gx:\n          actions.append(ACTION_RIGHT)\n          sx += 1\n      while sx > gx:\n          actions.append(ACTION_LEFT)\n          sx -= 1\n      # Then move in y direction\n      while sy < gy:\n          actions.append(ACTION_DOWN)\n          sy += 1\n      while sy > gy:\n          actions.append(ACTION_UP)\n          sy -= 1\n      return actions\n\n  # --------------------------------------------------------------------- #\n  # Retrieve world and indexing information.\n  # --------------------------------------------------------------------- #\n  world = env.world                     # CraftWorld instance\n  state = env._current_state            # CraftState instance\n  grid = state.grid                      # (W, H, n_kinds) occupancy array\n  pos = tuple(state.pos)                 # (x, y) current agent position\n  idx = world.cookbook.index             # Index mapping names \u2194 integers\n\n  # --------------------------------------------------------------------- #\n  # Identify the goal item (stick) and its recipe.\n  # --------------------------------------------------------------------- #\n  try:\n      stick_name = \"stick\"\n      stick_idx = idx[stick_name]\n  except Exception as e:\n      raise ValueError(f\"Cannot find index for item '{stick_name}': {e}\")\n\n  # Primitive requirements for one stick.\n  primitives_needed = world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}\n  if not primitives_needed:\n      # No recipe \u2013 nothing to do.\n      return []\n\n  # --------------------------------------------------------------------- #\n  # Collect each required primitive.\n  # --------------------------------------------------------------------- #\n  plan = []\n  for prim_idx, count in primitives_needed.items():\n      # Locate the primitive on the grid (first occurrence).\n      locations = np.argwhere(grid[:, :, prim_idx] > 0)\n      if locations.size == 0:\n          # Primitive not present \u2013 cannot continue; skip.\n          continue\n      # Choose the first location.\n      target_x, target_y = locations[0]\n      # Move to the primitive location.\n      plan.extend(manhattan_path(pos, (target_x, target_y)))\n      pos = (target_x, target_y)\n      # Pick up the required number of times (USE action).\n      for _ in range(count):\n          plan.append(ACTION_USE)\n      # After picking up, the primitive cell is now empty; we keep the\n      # current position for the next iteration.\n\n  # --------------------------------------------------------------------- #\n  # Move to the workshop specified in the recipe and craft the stick.\n  # --------------------------------------------------------------------- #\n  # The recipe dictionary contains a special key \"_at\" indicating the workshop.\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = idx[workshop_name]\n      # Find a workshop cell.\n      ws_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_locs.size > 0:\n          wx, wy = ws_locs[0]\n          plan.extend(manhattan_path(pos, (wx, wy)))\n          pos = (wx, wy)\n          # Use the workshop to craft.\n          plan.append(ACTION_USE)\n\n  return plan", "env_interactions": 4, "island_id": 8, "scores": {"3": 0.0}}
