{"timestamp": "2025-10-15T19:45:31.767976", "function_name": "make_stick", "function_body": "  \"\"\"\n  Generate a list of actions that will collect the required primitives for a\n  ``stick`` and then craft it at the appropriate workshop.\n\n  The function works with a *reset* ``CraftLab`` environment (i.e. the\n  environment already has an initial state).  It inspects the world\n  description (``env.world``) and the current state (``env._current_state``)\n  to plan a sequence of moves and ``USE`` actions.\n\n  The action space is assumed to be:\n      0 \u2013 DOWN   (dx = 0, dy = +1)\n      1 \u2013 UP     (dx = 0, dy = -1)\n      2 \u2013 LEFT   (dx = -1, dy = 0)\n      3 \u2013 RIGHT  (dx = +1, dy = 0)\n      4 \u2013 USE    (interact with the cell the agent is facing)\n\n  The returned list can be fed directly to ``env.step`` in a loop.\n  \"\"\"\n  import collections\n\n  # ----------------------------------------------------------------------\n  # Helper utilities\n  # ----------------------------------------------------------------------\n  ACTIONS = {\n      0: (0, 1),   # DOWN\n      1: (0, -1),  # UP\n      2: (-1, 0),  # LEFT\n      3: (1, 0)    # RIGHT\n  }\n\n  def in_bounds(x, y, w, h):\n      return 0 <= x < w and 0 <= y < h\n\n  def cell_has_kind(grid, x, y, kind):\n      \"\"\"True if the cell at (x, y) contains at least one entity of `kind`.\"\"\"\n      return grid[x, y, kind] > 0\n\n  def cell_is_empty(grid, x, y):\n      \"\"\"A cell is empty when *all* kind\u2011layers are zero.\"\"\"\n      return not grid[x, y].any()\n\n  def bfs_to_adjacent(start, target, grid):\n      \"\"\"\n      Breadth\u2011first search for the shortest path from ``start`` to any empty\n      cell that is orthogonally adjacent to ``target``.  Returns a tuple\n      ``(path, facing)`` where ``path`` is a list of movement actions (0\u20113)\n      and ``facing`` is the direction (0\u20113) the agent must have to be looking\n      at ``target`` when it reaches the final cell.\n      \"\"\"\n      w, h = grid.shape[0], grid.shape[1]\n      q = collections.deque()\n      q.append((start, []))\n      visited = {start}\n\n      while q:\n          (x, y), actions = q.popleft()\n\n          # are we adjacent to the target?\n          if abs(x - target[0]) + abs(y - target[1]) == 1:\n              # determine which direction we need to be facing\n              dx, dy = target[0] - x, target[1] - y\n              for act, (mx, my) in ACTIONS.items():\n                  if (mx, my) == (dx, dy):\n                      return actions, act\n          # expand neighbours\n          for act, (mx, my) in ACTIONS.items():\n              nx, ny = x + mx, y + my\n              if not in_bounds(nx, ny, w, h):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              if not cell_is_empty(grid, nx, ny):\n                  continue\n              visited.add((nx, ny))\n              q.append(((nx, ny), actions + [act]))\n      raise RuntimeError(\"No reachable adjacent cell found.\")\n\n  # ----------------------------------------------------------------------\n  # Start planning\n  # ----------------------------------------------------------------------\n  state = env._current_state          # type: CraftState\n  world = env.world                    # type: CraftWorld\n  grid = state.grid.copy()             # current grid (will be updated locally)\n\n  # ----------------------------------------------------------------------\n  # Identify indices for stick, its recipe and required primitives\n  # ----------------------------------------------------------------------\n  stick_name = \"stick\"\n  stick_idx = world.cookbook.index[stick_name]\n\n  # recipe dict for the stick (ingredients + optional \"_at\")\n  stick_recipe = world.cookbook.recipes[stick_idx]\n\n  # workshop where the stick must be crafted\n  workshop_idx = None\n  if \"_at\" in stick_recipe:\n      workshop_idx = stick_recipe[\"_at\"]\n      # If the stored value is a string name, resolve it to an index\n      if isinstance(workshop_idx, str):\n          workshop_idx = world.cookbook.index[workshop_idx]\n\n  # primitive requirements (ignore the special \"_at\" key)\n  primitive_reqs = {\n      k: v for k, v in stick_recipe.items() if k != \"_at\"\n  }\n\n  actions_plan = []\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive the needed number of times\n  # ----------------------------------------------------------------------\n  for prim_idx, count in primitive_reqs.items():\n      for _ in range(count):\n          # locate the *nearest* primitive of this kind\n          w, h = grid.shape[0], grid.shape[1]\n          prim_positions = [\n              (x, y) for x in range(w) for y in range(h)\n              if cell_has_kind(grid, x, y, prim_idx)\n          ]\n          if not prim_positions:\n              raise RuntimeError(f\"Primitive {prim_idx} not found on the map.\")\n\n          # pick the closest one (Manhattan distance)\n          px, py = min(\n              prim_positions,\n              key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1])\n          )\n\n          # plan path to an adjacent cell\n          path, facing = bfs_to_adjacent(state.pos, (px, py), grid)\n          actions_plan.extend(path)\n\n          # after the moves the agent's direction is the direction of the last\n          # move; we must turn to ``facing`` before using.  The only way to\n          # change direction without a dedicated turn action is to move one\n          # step away and back.\n          if path:\n              last_move = path[-1]\n              if last_move != facing:\n                  # move one step opposite to the desired facing direction\n                  opposite = {0: 1, 1: 0, 2: 3, 3: 2}[facing]\n                  dx, dy = ACTIONS[opposite]\n                  back_x, back_y = state.pos[0] + dx, state.pos[1] + dy\n                  if in_bounds(back_x, back_y, w, h) and cell_is_empty(grid, back_x, back_y):\n                      actions_plan.append(opposite)          # step away\n                      actions_plan.append(facing)            # step forward (back to original)\n                  else:\n                      # If we cannot step away, just add a dummy move that\n                      # keeps us inside the map (e.g., a left\u2011right pair)\n                      actions_plan.append(opposite)\n                      actions_plan.append(facing)\n\n          # finally, USE to pick up the primitive\n          actions_plan.append(4)  # USE\n          # update local state to keep planning consistent\n          # (remove the primitive from the grid and add to inventory)\n          grid[px, py, prim_idx] = 0\n          state.inventory[prim_idx] += 1\n          # agent stays on the same cell after USE; position unchanged\n\n  # ----------------------------------------------------------------------\n  # Move to the workshop and craft the stick\n  # ----------------------------------------------------------------------\n  if workshop_idx is not None:\n      # locate nearest workshop cell\n      w, h = grid.shape[0], grid.shape[1]\n      workshop_positions = [\n          (x, y) for x in range(w) for y in range(h)\n          if cell_has_kind(grid, x, y, workshop_idx)\n      ]\n      if not workshop_positions:\n          raise RuntimeError(\"Required workshop not found on the map.\")\n\n      wx, wy = min(\n          workshop_positions,\n          key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1])\n      )\n      # path to adjacent cell of the workshop\n      path, facing = bfs_to_adjacent(state.pos, (wx, wy), grid)\n      actions_plan.extend(path)\n\n      # ensure correct facing as before\n      if path and path[-1] != facing:\n          opposite = {0: 1, 1: 0, 2: 3, 3: 2}[facing]\n          dx, dy = ACTIONS[opposite]\n          back_x, back_y = state.pos[0] + dx, state.pos[1] + dy\n          if in_bounds(back_x, back_y, w, h) and cell_is_empty(grid, back_x, back_y):\n              actions_plan.append(opposite)\n              actions_plan.append(facing)\n          else:\n              actions_plan.append(opposite)\n              actions_plan.append(facing)\n\n      # USE to craft the stick\n      actions_plan.append(4)  # USE\n\n  return actions_plan", "env_interactions": 3, "island_id": 1, "scores": {"3": 0.0}}
