{"timestamp": "2025-10-15T17:10:07.470935", "function_name": "make_stick", "function_body": "  \"\"\"\n  Generate a sequence of actions that allows the agent to craft a ``stick`` in the\n  given ``CraftLab``/``CraftWorld`` environment.\n\n  The implementation is generic: it reads the recipe for ``stick`` from the\n  world's ``Cookbook``, locates the required primitive resources on the grid,\n  moves the agent to each of them and performs a ``USE`` action to pick them up,\n  then moves to the appropriate workshop (as indicated by the ``_at`` field of\n  the recipe) and uses ``USE`` once more to craft the stick.\n\n  The action encoding follows the convention used by ``CraftLab``:\n\n      0 \u2013 DOWN\n      1 \u2013 UP\n      2 \u2013 LEFT\n      3 \u2013 RIGHT\n      4 \u2013 USE (collect / craft)\n\n  Parameters\n  ----------\n  env : CraftLab\n      An instantiated CraftLab environment (already reset).\n\n  Returns\n  -------\n  List[int]\n      A list of action indices that, when executed sequentially, will result in\n      the agent possessing at least one ``stick`` in its inventory.\n  \"\"\"\n  import numpy as np\n\n  # --------------------------------------------------------------------- #\n  # Helper: simple Manhattan movement from (x0, y0) to (x1, y1)\n  # --------------------------------------------------------------------- #\n  def _move_actions(cur, target):\n      \"\"\"Return a list of actions moving from cur to target (Manhattan).\"\"\"\n      actions = []\n      x, y = cur\n      tx, ty = target\n      # vertical moves\n      while x < tx:\n          actions.append(0)   # DOWN\n          x += 1\n      while x > tx:\n          actions.append(1)   # UP\n          x -= 1\n      # horizontal moves\n      while y < ty:\n          actions.append(3)   # RIGHT\n          y += 1\n      while y > ty:\n          actions.append(2)   # LEFT\n          y -= 1\n      return actions\n\n  # --------------------------------------------------------------------- #\n  # Access the underlying state and world objects\n  # --------------------------------------------------------------------- #\n  state = env._current_state               # CraftState\n  world = env.world                         # CraftWorld\n  cookbook = world.cookbook                 # Cookbook\n\n  # --------------------------------------------------------------------- #\n  # Identify the goal index for \"stick\"\n  # --------------------------------------------------------------------- #\n  try:\n      stick_idx = cookbook.index[\"stick\"]\n  except KeyError:                         # pragma: no cover\n      # If the world does not contain a stick, we cannot craft it.\n      return []\n\n  # --------------------------------------------------------------------- #\n  # Determine which primitives (and how many of each) are needed.\n  # --------------------------------------------------------------------- #\n  needed = cookbook.primitives_for(stick_idx)   # {prim_idx: count}\n  actions = []\n  cur_pos = tuple(state.pos)                     # mutable copy\n\n  # --------------------------------------------------------------------- #\n  # Work on a temporary copy of the grid so we can \u201cremove\u201d items once they\n  # are collected (this avoids picking the same primitive twice).\n  # --------------------------------------------------------------------- #\n  grid = np.copy(state.grid)\n\n  # --------------------------------------------------------------------- #\n  # Collect each required primitive.\n  # --------------------------------------------------------------------- #\n  for prim_idx, qty in needed.items():\n      # Locate all cells that currently contain this primitive\n      locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n      # Take as many as needed (the recipe guarantees enough exist)\n      for loc in locations[:qty]:\n          # Move to the primitive\n          actions.extend(_move_actions(cur_pos, loc))\n          cur_pos = loc\n          # Pick it up\n          actions.append(4)                     # USE\n          # Update the temporary grid to reflect the item being taken\n          grid[loc[0], loc[1], prim_idx] = 0\n\n  # --------------------------------------------------------------------- #\n  # Move to the workshop where a stick can be crafted.\n  # --------------------------------------------------------------------- #\n  recipe = cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      # Resolve the workshop index and find a cell that hosts it\n      ws_idx = cookbook.index.get(workshop_name)\n      if ws_idx is not None:\n          ws_locs = list(zip(*np.where(grid[:, :, ws_idx] > 0)))\n          if ws_locs:\n              ws_target = ws_locs[0]            # any workshop cell works\n              actions.extend(_move_actions(cur_pos, ws_target))\n              cur_pos = ws_target\n              # Craft the stick\n              actions.append(4)                 # USE\n\n  return actions", "env_interactions": 0, "island_id": 9, "scores": {"3": -1}}
