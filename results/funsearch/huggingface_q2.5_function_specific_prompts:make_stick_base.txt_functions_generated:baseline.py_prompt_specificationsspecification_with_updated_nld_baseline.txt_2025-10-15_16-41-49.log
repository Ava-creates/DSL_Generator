{"timestamp": "2025-10-15T18:13:04.844892", "function_name": "make_stick", "function_body": "  \"\"\"\n  Generate a list of actions that lets the agent craft a ``stick`` in the\n  provided :class:`CraftWorld` environment.\n\n  The implementation works generically:\n  1.  Look up the recipe for ``stick``.\n  2.  Locate the required primitive items in the initial grid.\n  3.  Move the agent to each primitive, ``USE`` to pick it up.\n  4.  Move to the appropriate workshop (``_at`` field of the recipe) and\n      ``USE`` to craft the stick.\n\n  Actions follow the CraftWorld convention:\n      0 \u2013 DOWN, 1 \u2013 UP, 2 \u2013 LEFT, 3 \u2013 RIGHT, 4 \u2013 USE\n  \"\"\"\n  # --------------------------------------------------------------------- #\n  # 1.  Resolve indices for the goal (stick) and its recipe.\n  # --------------------------------------------------------------------- #\n  world = env                     # ``env`` is a CraftWorld instance\n  idx = world.cookbook.index\n  stick_idx = idx[\"stick\"]        # index of the goal item\n\n  # recipe for the stick (may be empty if stick is a primitive)\n  recipe = world.cookbook.recipes.get(stick_idx, {})\n\n  # workshop where the stick must be crafted (if any)\n  workshop_kind = recipe.get(\"_at\")\n\n  # primitive ingredients (exclude the special ``_at`` key)\n  needed = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  # --------------------------------------------------------------------- #\n  # 2.  Build a scenario that contains the goal \u2013 this gives us the grid\n  #     layout and the agent's starting position.\n  # --------------------------------------------------------------------- #\n  scenario = world.sample_scenario_with_goal(stick_idx)\n  grid = scenario.init_grid\n  pos = scenario.init_pos          # (row, col)\n\n  # --------------------------------------------------------------------- #\n  # 3.  Helper to convert a Manhattan move into action indices.\n  # --------------------------------------------------------------------- #\n  def _move_actions(src, dst):\n      \"\"\"Return a list of actions that moves from src to dst (Manhattan).\"\"\"\n      sx, sy = src\n      dx, dy = dst\n      acts = []\n\n      # vertical movement\n      while sx < dx:\n          acts.append(0)   # DOWN\n          sx += 1\n      while sx > dx:\n          acts.append(1)   # UP\n          sx -= 1\n\n      # horizontal movement\n      while sy < dy:\n          acts.append(3)   # RIGHT\n          sy += 1\n      while sy > dy:\n          acts.append(2)   # LEFT\n          sy -= 1\n      return acts\n\n  # --------------------------------------------------------------------- #\n  # 4.  Pre\u2011compute locations of every primitive kind we need.\n  # --------------------------------------------------------------------- #\n  primitive_locs = {}\n  for kind_idx in needed:\n      locs = np.argwhere(grid[:, :, kind_idx] == 1)\n      primitive_locs[kind_idx] = [tuple(p) for p in locs]\n\n  # workshop locations (if required)\n  workshop_locs = []\n  if workshop_kind is not None:\n      ws = np.argwhere(grid[:, :, workshop_kind] == 1)\n      workshop_locs = [tuple(p) for p in ws]\n\n  # --------------------------------------------------------------------- #\n  # 5.  Collect all required primitives.\n  # --------------------------------------------------------------------- #\n  actions = []\n  for kind_idx, count in needed.items():\n      for _ in range(count):\n          # If we run out of known locations we simply abort \u2013 the\n          # environment will handle the failure.\n          if not primitive_locs[kind_idx]:\n              continue\n\n          # Choose the nearest available instance.\n          distances = [\n              abs(pos[0] - p[0]) + abs(pos[1] - p[1])\n              for p in primitive_locs[kind_idx]\n          ]\n          nearest_i = int(np.argmin(distances))\n          target = primitive_locs[kind_idx][nearest_i]\n\n          # Move to the primitive and pick it up.\n          actions.extend(_move_actions(pos, target))\n          pos = target\n          actions.append(4)               # USE \u2192 pick up\n\n          # Remove this instance so we don't try to collect it again.\n          primitive_locs[kind_idx].pop(nearest_i)\n\n  # --------------------------------------------------------------------- #\n  # 6.  Go to the workshop (if one exists) and craft the stick.\n  # --------------------------------------------------------------------- #\n  if workshop_locs:\n      distances = [\n          abs(pos[0] - p[0]) + abs(pos[1] - p[1])\n          for p in workshop_locs\n      ]\n      nearest_i = int(np.argmin(distances))\n      target = workshop_locs[nearest_i]\n\n      actions.extend(_move_actions(pos, target))\n      pos = target\n      actions.append(4)   # USE \u2192 craft the stick\n\n  return actions", "env_interactions": 0, "island_id": 9, "scores": {"3": -1}}
