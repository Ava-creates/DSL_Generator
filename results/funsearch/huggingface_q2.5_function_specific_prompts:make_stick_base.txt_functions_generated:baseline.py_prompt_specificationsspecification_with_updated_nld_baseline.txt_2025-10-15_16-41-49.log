{"timestamp": "2025-10-15T20:02:06.105164", "function_name": "make_stick", "function_body": "  \"\"\"\n  Returns a list of actions that will make a stick in the given CraftLab\n  environment. The planner works generically:\n    1. Reset the environment.\n    2. Determine the primitive resources required for a stick.\n    3. Walk to each required primitive, pick it up.\n    4. Walk to the appropriate workshop (if any) and craft the stick.\n\n  Action indices follow the environment's specification:\n      0 \u2013 DOWN, 1 \u2013 UP, 2 \u2013 LEFT, 3 \u2013 RIGHT, 4 \u2013 USE\n  \"\"\"\n  # ------------------------------------------------------------------\n  # Helper: simple Manhattan\u2011distance greedy movement\n  # ------------------------------------------------------------------\n  def move_towards(state, target):\n      \"\"\"Yield actions that move the agent from its current position\n      to *target* (row, col) using a greedy Manhattan walk.\"\"\"\n      while tuple(state.pos) != tuple(target):\n          dy = target[0] - state.pos[0]\n          dx = target[1] - state.pos[1]\n          if dy > 0:\n              act = 0          # DOWN\n          elif dy < 0:\n              act = 1          # UP\n          elif dx > 0:\n              act = 3          # RIGHT\n          elif dx < 0:\n              act = 2          # LEFT\n          else:\n              break\n          yield act\n          _, new_state = state.step(act)\n          state = new_state\n      return state\n\n  # ------------------------------------------------------------------\n  # 1. Reset the environment and obtain the initial state\n  # ------------------------------------------------------------------\n  env.reset()\n  state = env._current_state               # CraftState instance\n\n  # ------------------------------------------------------------------\n  # 2. Look up the index for the item \"stick\"\n  # ------------------------------------------------------------------\n  idx = env.world.cookbook.index\n  stick_idx = idx[\"stick\"]\n\n  # ------------------------------------------------------------------\n  # 3. Determine required primitives for one stick\n  # ------------------------------------------------------------------\n  # primitives_for returns a dict {primitive_idx: count}\n  primitives_needed = env.world.cookbook.primitives_for(stick_idx)\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # 4. Collect each required primitive\n  # ------------------------------------------------------------------\n  for prim_idx, count in primitives_needed.items():\n      for _ in range(count):\n          # locate all cells that currently contain the primitive\n          locations = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if len(locations) == 0:\n              # No more primitives of this type \u2013 give up early\n              return actions\n\n          # choose the nearest one (Manhattan distance)\n          dists = np.sum(np.abs(locations - np.array(state.pos)), axis=1)\n          target = tuple(locations[dists.argmin()])\n\n          # move to the primitive\n          for act in move_towards(state, target):\n              actions.append(act)\n              _, new_state = state.step(act)\n              state = new_state\n\n          # pick it up (USE)\n          actions.append(4)                  # USE\n          _, new_state = state.step(4)\n          state = new_state\n\n  # ------------------------------------------------------------------\n  # 5. Craft the stick at the required workshop (if any)\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(stick_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = idx[workshop_name]\n\n      # locate the nearest workshop cell\n      locations = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if len(locations) > 0:\n          dists = np.sum(np.abs(locations - np.array(state.pos)), axis=1)\n          target = tuple(locations[dists.argmin()])\n\n          # move to the workshop\n          for act in move_towards(state, target):\n              actions.append(act)\n              _, new_state = state.step(act)\n              state = new_state\n\n          # craft (USE)\n          actions.append(4)                  # USE\n          _, new_state = state.step(4)\n          state = new_state\n\n  # ------------------------------------------------------------------\n  # Return the compiled action list\n  # ------------------------------------------------------------------\n  return actions", "env_interactions": 0, "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-10-15T20:02:07.487671", "function_name": "make_stick", "function_body": "  \"\"\"\n  Return a list of action indices that will cause the agent to craft a ``stick``.\n  The helper function ``craft`` (imported from the ``craft`` package) contains a\n  generic planner that, given an environment instance and a target item name,\n  returns a viable action sequence based on the world\u2019s recipes.\n\n  Parameters\n  ----------\n  env : object\n      An instantiated CraftWorld (or CraftLab) environment.\n\n  Returns\n  -------\n  list[int]\n      Ordered actions that, when executed in the environment, result in at\n      least one ``stick`` in the agent\u2019s inventory.\n  \"\"\"\n  # Use the generic planner to obtain the action sequence for the target item.\n  actions = craft(env, \"stick\")\n\n  # ``craft`` may return a tuple or other iterable; ensure we return a list.\n  if not isinstance(actions, list):\n      actions = list(actions)\n\n  return actions", "env_interactions": 0, "island_id": 2, "scores": {"3": -1}}
