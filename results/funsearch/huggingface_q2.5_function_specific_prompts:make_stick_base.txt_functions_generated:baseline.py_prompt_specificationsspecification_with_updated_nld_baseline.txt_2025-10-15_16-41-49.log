{"timestamp": "2025-10-15T18:52:07.888322", "function_name": "make_stick", "function_body": "  \"\"\"\n  Generate a list of actions that will collect the required primitives\n  and craft a ``stick`` in the provided CraftLab environment.\n\n  The implementation works with the public API exposed by the\n  ``CraftLab`` / ``CraftWorld`` classes:\n    * ``env.world`` \u2013 the underlying ``CraftWorld`` instance.\n    * ``env._current_state`` \u2013 the active ``CraftState``.\n    * ``env.action_specs()`` \u2013 mapping from action names to integer ids.\n    * ``env.world.cookbook`` \u2013 recipe information.\n\n  The strategy is a simple greedy planner:\n    1. Determine which primitive items are needed for a stick.\n    2. Repeatedly move to the nearest cell that contains a missing primitive,\n       use the ``USE`` action to pick it up, and update the inventory.\n    3. Once all required primitives are in the inventory, move to the nearest\n       workshop cell and ``USE`` to craft the stick.\n\n  The function returns the complete action list but does **not** execute\n  the actions; the caller may feed the list to ``env.step`` sequentially.\n  \"\"\"\n  # ----------------------------------------------------------------------\n  # Helper utilities\n  # ----------------------------------------------------------------------\n  action_ids = env.action_specs()\n  DIR2ACT = {\n      (1, 0): action_ids[\"RIGHT\"],\n      (-1, 0): action_ids[\"LEFT\"],\n      (0, 1): action_ids[\"DOWN\"],\n      (0, -1): action_ids[\"UP\"],\n  }\n  USE_ACT = action_ids[\"USE\"]\n\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of (dx, dy) moves from start to goal using Manhattan steps.\"\"\"\n      sx, sy = start\n      gx, gy = goal\n      moves = []\n      # first move in x, then in y (any order works for an empty grid)\n      while sx != gx:\n          step = 1 if gx > sx else -1\n          moves.append((step, 0))\n          sx += step\n      while sy != gy:\n          step = 1 if gy > sy else -1\n          moves.append((0, step))\n          sy += step\n      return moves\n\n  def bfs_to_target(state, target_kind):\n      \"\"\"\n      Bread\u2011first search to the *nearest* cell that contains ``target_kind``.\n      Returns a list of positions (including the start cell) that leads to the\n      target.  The search may step onto the target cell even if it is occupied.\n      \"\"\"\n      grid = state.grid\n      w, h = grid.shape[:2]\n      start = state.pos\n      visited = np.full((w, h), False, dtype=bool)\n      q = deque()\n      q.append((start, [start]))\n      visited[start] = True\n\n      # a cell is walkable if it is empty (no entities) OR it is the target cell\n      while q:\n          (x, y), path = q.popleft()\n          # check if this cell holds the desired kind\n          if grid[x, y, target_kind] > 0:\n              return path\n          # explore 4\u2011neighbourhood\n          for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:\n                  # walkable if empty\n                  if grid[nx, ny].sum() == 0:\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [(nx, ny)]))\n      # no reachable target found\n      return None\n\n  def moves_from_path(path):\n      \"\"\"Convert a list of positions to the corresponding action ids.\"\"\"\n      acts = []\n      for (x0, y0), (x1, y1) in zip(path, path[1:]):\n          delta = (x1 - x0, y1 - y0)\n          acts.append(DIR2ACT[delta])\n      return acts\n\n  # ----------------------------------------------------------------------\n  # 1. Identify the stick recipe\n  # ----------------------------------------------------------------------\n  idx = env.world.cookbook.index\n  stick_idx = idx[\"stick\"]\n  # primitive requirements for a single stick (dict {prim_idx: count})\n  prim_req = env.world.cookbook.primitives_for(stick_idx)\n\n  # ----------------------------------------------------------------------\n  # 2. Greedy collection of missing primitives\n  # ----------------------------------------------------------------------\n  actions = []\n  state = env._current_state\n\n  # Helper to query current inventory\n  def have_enough(kind, needed):\n      return state.inventory[kind] >= needed\n\n  # Collect each primitive until the required amount is satisfied\n  for prim_idx, needed_cnt in prim_req.items():\n      while not have_enough(prim_idx, needed_cnt):\n          # locate nearest cell that still contains the primitive\n          path = bfs_to_target(state, prim_idx)\n          if path is None:\n              # cannot find the primitive \u2013 give up\n              return actions\n          # move along the path (excluding the start cell)\n          actions += moves_from_path(path)\n          # after moving, update the internal state reference\n          # (the caller will actually execute the actions later)\n          # For planning we simulate the movement locally:\n          for a in actions[-len(path)+1:]:\n              # simulate movement to keep `state.pos` consistent for the next iteration\n              # This lightweight simulation mirrors the real step logic for\n              # cardinal moves only.\n              if a == DIR2ACT[(1, 0)]:\n                  state.pos = (state.pos[0] + 1, state.pos[1])\n              elif a == DIR2ACT[(-1, 0)]:\n                  state.pos = (state.pos[0] - 1, state.pos[1])\n              elif a == DIR2ACT[(0, 1)]:\n                  state.pos = (state.pos[0], state.pos[1] + 1)\n              elif a == DIR2ACT[(0, -1)]:\n                  state.pos = (state.pos[0], state.pos[1] - 1)\n              # direction is set to the last movement direction\n              state.dir = list(DIR2ACT.values()).index(a)\n\n          # now we are adjacent (or on) the primitive cell; use the item\n          actions.append(USE_ACT)\n          # simulate the pickup (increment inventory)\n          state.inventory[prim_idx] += 1\n          # remove the primitive from the grid (so we don't target the same cell again)\n          # we simply clear the first occurrence we know about\n          gx, gy = path[-1]\n          state.grid[gx, gy, prim_idx] = 0\n\n  # ----------------------------------------------------------------------\n  # 3. Craft the stick at the nearest workshop\n  # ----------------------------------------------------------------------\n  # Any workshop is suitable \u2013 we pick the first kind listed.\n  workshop_kind = env.world.workshop_indices[0]\n\n  path = bfs_to_target(state, workshop_kind)\n  if path is not None:\n      actions += moves_from_path(path)\n      actions.append(USE_ACT)   # craft at the workshop\n\n  return actions", "env_interactions": 0, "island_id": 5, "scores": {"3": -1}}
