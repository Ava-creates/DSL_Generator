{"timestamp": "2025-10-15T18:40:57.729740", "function_name": "make_stick", "function_body": "  \"\"\"\n  Generate a sequence of actions that makes a ``stick`` in the given CraftWorld\n  environment.\n\n  The implementation is generic:\n  1. Look up the index of the ``stick`` item in the recipe book.\n  2. Query the recipe for the required primitive resources and the workshop\n     where the item must be crafted.\n  3. For each required primitive, locate the nearest instance on the grid,\n     move the agent to that cell and ``USE`` it to pick it up.\n  4. After all primitives are collected, move to a workshop of the appropriate\n     type and ``USE`` again to craft the stick.\n\n  The function works with the *CraftLab* wrapper (the object returned by\n  ``env_factory``).  It uses the public ``reset`` and ``step`` methods of the\n  wrapper and inspects the underlying ``CraftState`` through the private\n  ``_current_state`` attribute (this is the standard way the library exposes\n  the state for planning).\n\n  Parameters\n  ----------\n  env :\n      An instance of :class:`CraftLab` (or any compatible wrapper) that has\n      the attributes ``world`` (a :class:`CraftWorld`) and the methods\n      ``reset`` and ``step``.\n\n  Returns\n  -------\n  List[int]\n      A list of action indices that, when fed sequentially to ``env.step``,\n      will result in the agent possessing at least one ``stick``.\n  \"\"\"\n  # --------------------------------------------------------------------- #\n  # Helper utilities\n  # --------------------------------------------------------------------- #\n  # Action mapping used by CraftLab (see ``action_specs`` in the docs)\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  def manhattan_move(src, dst):\n      \"\"\"Yield a sequence of actions that moves from src to dst using Manhattan\n      steps (no obstacle avoidance \u2013 the environment will block illegal moves,\n      but the planner will simply try again).\"\"\"\n      x, y = src\n      tx, ty = dst\n      while (x, y) != (tx, ty):\n          if x < tx:\n              yield ACTION_RIGHT\n              x += 1\n          elif x > tx:\n              yield ACTION_LEFT\n              x -= 1\n          elif y < ty:\n              yield ACTION_DOWN\n              y += 1\n          elif y > ty:\n              yield ACTION_UP\n              y -= 1\n\n  def locate_entities(grid, kind_idx):\n      \"\"\"Return a list of (x, y) positions where ``kind_idx`` is present.\"\"\"\n      # grid shape: (WIDTH, HEIGHT, n_kinds)\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      # ``np.argwhere`` returns (x, y) pairs; convert to list of tuples\n      return [tuple(pos) for pos in locations]\n\n  # --------------------------------------------------------------------- #\n  # 1. Initialise the environment and obtain the current state\n  # --------------------------------------------------------------------- #\n  obs = env.reset()                     # reset returns the initial observation\n  state = env._current_state            # internal CraftState after reset\n  grid = state.grid.copy()              # current occupancy grid\n  pos = state.pos                       # agent's (x, y) position\n\n  # --------------------------------------------------------------------- #\n  # 2. Identify the recipe for ``stick``\n  # --------------------------------------------------------------------- #\n  # The cookbook holds a bidirectional ``Index`` mapping names\u2194ids.\n  stick_name = \"stick\"\n  try:\n      stick_idx = env.world.cookbook.index[stick_name]\n  except Exception as exc:\n      raise ValueError(f\"Stick not found in the recipe index: {exc}\")\n\n  # Primitive requirements (e.g. {wood_idx: 2, stone_idx: 1})\n  primitive_requirements = env.world.cookbook.primitives_for(stick_idx)\n\n  # Workshop where the stick must be crafted (the recipe dict contains a\n  # special ``_at`` key pointing to a workshop kind).\n  recipe_dict = env.world.cookbook.recipes.get(stick_idx, {})\n  workshop_kind = recipe_dict.get(\"_at\")\n  if workshop_kind is None:\n      raise ValueError(\"The stick recipe does not specify a workshop ('_at').\")\n\n  # --------------------------------------------------------------------- #\n  # 3. Collect each required primitive\n  # --------------------------------------------------------------------- #\n  actions = []\n\n  for prim_idx, needed_qty in primitive_requirements.items():\n      # Collect the primitive ``needed_qty`` times.\n      for _ in range(needed_qty):\n          # Locate all cells that currently contain the primitive.\n          prim_locations = locate_entities(grid, prim_idx)\n          if not prim_locations:\n              raise RuntimeError(\n                  f\"Unable to locate primitive with index {prim_idx} on the grid.\"\n              )\n          # Choose the *closest* location (Manhattan distance).\n          target = min(prim_locations,\n                       key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n\n          # Move to the target cell.\n          for act in manhattan_move(pos, target):\n              actions.append(act)\n              reward, done, info = env.step(act)\n              state = env._current_state\n              grid = state.grid\n              pos = state.pos\n\n          # Pick up the primitive (USE).  The environment will automatically\n          # decrement the count on the grid and increment the inventory.\n          actions.append(ACTION_USE)\n          reward, done, info = env.step(ACTION_USE)\n          state = env._current_state\n          grid = state.grid\n          pos = state.pos  # position does not change on USE\n\n  # --------------------------------------------------------------------- #\n  # 4. Move to a workshop of the required type and craft the stick\n  # --------------------------------------------------------------------- #\n  workshop_locations = locate_entities(grid, workshop_kind)\n  if not workshop_locations:\n      raise RuntimeError(\"No workshop of the required type found on the grid.\")\n\n  # Choose the nearest workshop.\n  target_ws = min(workshop_locations,\n                  key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n\n  # Move to the workshop cell.\n  for act in manhattan_move(pos, target_ws):\n      actions.append(act)\n      reward, done, info = env.step(act)\n      state = env._current_state\n      grid = state.grid\n      pos = state.pos\n\n  # Craft the stick (USE while standing on/adjacent to the workshop).\n  actions.append(ACTION_USE)\n  env.step(ACTION_USE)  # final step; we do not need the returned values\n\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": -1}}
